        ],
        "canMessage": ["ex:CompletionPersona1", "ex:ConsistencyPersona1", "ex:ConsistencyPersona2", "ex:SpecificationFormalizationPersona1", "ex:SpecificationFormalizationPersona2", "user"],
        "canReceiveFrom": ["user", "ex:CompletionPersona1", "ex:ConsistencyPersona1", "ex:ConsistencyPersona2", "ex:SpecificationFormalizationPersona1", "ex:SpecificationFormalizationPersona2"]
