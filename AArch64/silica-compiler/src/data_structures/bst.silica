// Binary search tree for string keys with int64 payload (index)
// Node: value (string), index (int64), next_left, next_right

export BstNode/0;
export empty_node/0;
export is_nil_node/1;
export bst_insert/4;
export bst_lookup/2;

// BST node: value (key), index (payload), left and right children
struct BstNode {
    value: string,
    index: int64,
    next_left: BstNode,
    next_right: BstNode
}

fn empty_node() -> BstNode {
    nil_placeholder: BstNode <- BstNode { value: "", index: 0 - 1, next_left: nil_placeholder, next_right: nil_placeholder };
    nil_placeholder
}

fn is_nil_node(node: BstNode) -> bool {
    node.value == "" and node.index < 0
}

// Lexicographic string comparison: 0 if a < b, 1 if a == b, 2 if a > b (avoids -1 in case patterns)
fn string_compare(a: string, b: string) -> int64 {
    case a == b of {
        true -> 1;
        false -> string_compare_at(a, b, 0)
    }
}

fn string_compare_at(a: string, b: string, pos: int64) -> int64 {
    len_a: int64 <- len(a);
    len_b: int64 <- len(b);
    case pos >= len_a of {
        true -> case pos >= len_b of {
            true -> 1;
            false -> 0
        };
        false -> case pos >= len_b of {
            true -> 2;
            false -> do
                ca: string <- substring(a, pos, pos + 1);
                cb: string <- substring(b, pos, pos + 1);
                case ca == cb of {
                    true -> string_compare_at(a, b, pos + 1);
                    false -> case ca < cb of {
                        true -> 0;
                        false -> 2
                    }
                }
            end
        }
    }
}

// Insert or find: returns (updated_root, index). Index is assigned on first insert.
// string_compare: 0=less, 1=equal, 2=greater
fn bst_insert(node: BstNode, lexeme: string, next_index: int64) -> (BstNode, int64) {
    case is_nil_node(node) of {
        true -> (BstNode { value: lexeme, index: next_index, next_left: empty_node(), next_right: empty_node() }, next_index);
        false -> case string_compare(lexeme, node.value) of {
            1 -> (node, node.index);
            0 -> do
                (new_left: BstNode, idx: int64) <- bst_insert(node.next_left, lexeme, next_index);
                (BstNode { value: node.value, index: node.index, next_left: new_left, next_right: node.next_right }, idx)
            end;
            _: int64 -> do
                (new_right: BstNode, idx: int64) <- bst_insert(node.next_right, lexeme, next_index);
                (BstNode { value: node.value, index: node.index, next_left: node.next_left, next_right: new_right }, idx)
            end
        }
    }
}

// Lookup index by lexeme. Returns -1 if not found.
fn bst_lookup(node: BstNode, lexeme: string) -> int64 {
    case is_nil_node(node) of {
        true -> 0 - 1;
        false -> case string_compare(lexeme, node.value) of {
            1 -> node.index;
            0 -> bst_lookup(node.next_left, lexeme);
            _: int64 -> bst_lookup(node.next_right, lexeme)
        }
    }
}
