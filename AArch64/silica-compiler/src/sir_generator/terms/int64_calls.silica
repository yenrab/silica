// Function call expression to SIR term (Expr kind 4, extension)
// Built-in: print_int64(int64:x) -> call(bool, main.print_int64, [arg], [])

use sir_ast;

export build_call_from_sir/2;

fn qual_name(name: string) -> string {
    concat("main.", name)
}

// Build SIR call term from call name and already-converted arg SIR term
fn build_call_from_sir(call_name: string, arg: SIRTerm) -> SIRTerm {
    case call_name == "print_int64" of {
        true -> do
            callee: string <- qual_name(call_name);
            SIRTerm { kind: 4, type_name: "bool", value: "[]", name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
        end;
        false -> sir_ast@dummy_sir_term()
    }
}
