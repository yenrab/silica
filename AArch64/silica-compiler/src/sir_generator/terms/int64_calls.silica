// Function call expression to SIR term (Expr kind 4, extension)
// Built-in I/O: print_int64(int64:x) -> call(bool, main.print_int64, [arg], [device_io])
// Effect set carried on SIRTerm.value per sir_design_spec §5.2.5

use sir_ast;

export build_call_from_sir/2;

fn qual_name(name: string) -> string {
    concat("main.", name)
}

// Effect sets for built-in functions (spec §9.1.1, §9.3.1)
fn builtin_call_effects(call_name: string) -> string {
    case call_name of {
        "print_int64" -> "[device_io]";
        "print_bool" -> "[device_io]";
        "println" -> "[device_io]";
        "print" -> "[device_io]";
        "read_lines" -> "[device_io]";
        "file_exists" -> "[device_io]";
        _: string -> "[]"
    }
}

// Build SIR call term from call name and already-converted arg SIR term
fn build_call_from_sir(call_name: string, arg: SIRTerm) -> SIRTerm {
    case call_name == "print_int64" of {
        true -> do
            callee: string <- qual_name(call_name);
            eff: string <- builtin_call_effects(call_name);
            SIRTerm { kind: 4, type_name: "bool", value: eff, name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
        end;
        false -> case call_name == "print_bool" of {
            true -> do
                callee: string <- qual_name(call_name);
                eff: string <- builtin_call_effects(call_name);
                SIRTerm { kind: 4, type_name: "bool", value: eff, name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
            end;
            false -> sir_ast@dummy_sir_term()
        }
    }
}
