// Literal expression to SIR term (Expr kind 0, extension)

use parser_ast;
use type_checker_core;
use sir_ast;
use types;

export expr_to_sir/2;

// Build SIR const term for integer literal (Expr kind 0)
fn expr_to_sir(context: TypeContext, expr: Expr) -> SIRTerm {
    SIRTerm { kind: 0, type_name: types@type_name_to_sir("int64"), value: expr.value, name: "", inner: sir_ast@dummy_sir_term() }
}
