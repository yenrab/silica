// Binary operator expression to SIR term (Expr kind 3, extension)
// int16 arithmetic: +, -, *, /, % -> prim(add, sub, mul, div, rem)
// Comparison: <, >, <=, >=, ==, != -> prim(lt, gt, le, ge, eq, ne)

use sir_ast;
use types;

export build_prim_from_sir/3;

fn op_to_prim_and_type(op: string) -> (string, string) {
    case op of {
        "+" -> ("add", "int16");
        "-" -> ("sub", "int16");
        "*" -> ("mul", "int16");
        "/" -> ("div", "int16");
        "%" -> ("rem", "int16");
        "<" -> ("lt", "bool");
        ">" -> ("gt", "bool");
        "<=" -> ("le", "bool");
        ">=" -> ("ge", "bool");
        "==" -> ("eq", "bool");
        "!=" -> ("ne", "bool");
        "and" -> ("and", "bool");
        "or" -> ("or", "bool");
        _: string -> ("", "int16")
    }
}

// Build SIR prim term from op lexeme and already-converted left/right SIR terms
fn build_prim_from_sir(op_lexeme: string, left: SIRTerm, right: SIRTerm) -> SIRTerm {
    (prim_op: string, result_type: string) <- op_to_prim_and_type(op_lexeme);
    sir_type: string <- types@type_name_to_sir(result_type);
    SIRTerm { kind: 6, type_name: sir_type, value: "", name: prim_op, inner: left, right_expr: right }
}
