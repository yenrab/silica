// Function call expression to SIR term (Expr kind 4, extension)
// Built-in I/O: print_int16(int16:x), print_uint16(uint16:x) -> call(atom, main.print_*, [arg], [device_io])
// Effect set carried on SIRTerm.value per sir_design_spec §5.2.5

use sir_ast;

export build_print_int16_from_sir/2;

fn qual_name(name: string) -> string {
    concat("main.", name)
}

// Effect sets for built-in functions (spec §9.1.1, §9.3.1)
fn builtin_call_effects(call_name: string) -> string {
    case call_name of {
        "print_int16" -> "[device_io]";
        "print_uint16" -> "[device_io]";
        _: string -> "[]"
    }
}

// Build SIR call term from call name and already-converted arg SIR term
fn build_print_int16_from_sir(call_name: string, arg: SIRTerm) -> SIRTerm {
    case call_name == "print_int16" of {
        true -> do
            callee: string <- qual_name(call_name);
            eff: string <- builtin_call_effects(call_name);
            SIRTerm { kind: 4, type_name: "atom", value: eff, name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
        end;
        false -> case call_name == "print_uint16" of {
            true -> do
                callee: string <- qual_name(call_name);
                eff: string <- builtin_call_effects(call_name);
                SIRTerm { kind: 4, type_name: "atom", value: eff, name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
            end;
            false -> sir_ast@dummy_sir_term()
        }
    }
}
