// Identifier expression to SIR term (Expr kind 1, extension)

use parser_ast;
use type_checker_core;
use sir_ast;
use types;

export expr_to_sir/2;
export expr_to_sir_with_bound/4;

// Build SIR var term for identifier (Expr kind 1)
// name uses % prefix per sir_design_spec §5.2.2
// Match type checker pattern: lookup_symbol_found at top level, branch on result.
fn expr_to_sir(context: TypeContext, expr: Expr) -> SIRTerm {
    prefixed: string <- concat("%", expr.name);
    (found: bool, resolved: string) <- type_checker_core@lookup_symbol_found(context.env, expr.name);
    type_name: string <- case found of { true -> resolved; false -> "int64" };
    sir_type: string <- types@type_name_to_sir(type_name);
    SIRTerm { kind: 1, type_name: sir_type, value: "", name: prefixed, inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}

// Same as expr_to_sir but when identifier matches bound_name, use bound_type (avoids lookup for let-bound var).
// Match type checker pattern: call lookup_symbol_found at top level, then branch on result (avoids bootstrap codegen issues with nested tuple destructuring).
fn expr_to_sir_with_bound(context: TypeContext, expr: Expr, bound_name: string, bound_type: string) -> SIRTerm {
    prefixed: string <- concat("%", expr.name);
    (found: bool, resolved: string) <- type_checker_core@lookup_symbol_found(context.env, expr.name);
    type_name: string <- case expr.name == bound_name of {
        true -> bound_type;
        false -> case found of { true -> resolved; false -> "int64" }
    };
    sir_type: string <- types@type_name_to_sir(type_name);
    SIRTerm { kind: 1, type_name: sir_type, value: "", name: prefixed, inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}
