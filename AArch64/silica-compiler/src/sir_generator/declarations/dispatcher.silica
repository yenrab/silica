// Declaration dispatcher: Declaration.tag -> SIRFunction
// Delegates to functions per Declaration.tag (registry with one case branch per declaration capability)
// Core+extensions pattern: add capability = add file + one line in this case

use parser_ast;
use type_checker_core;
use sir_ast;
use functions;

export emit_declaration/2;

// Convert Declaration to SIRFunction. Dispatches on tag.
// Tag 0: function -> SIRFunction (name, return_type, body)
// Other tags: return dummy (caller skips when name == "")
fn emit_declaration(decl: Declaration, context: TypeContext) -> SIRFunction proc[mem(normal)] {
    case decl.tag of {
        0 -> functions@emit_function(decl, context);
        _: int64 -> sir_ast@dummy_sir_function()
    }
}
