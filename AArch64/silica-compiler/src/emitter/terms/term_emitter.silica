// Term dispatcher: SIRTerm.kind -> emit function
// Delegates to const, var per sir_emitter_pattern_spec §4.3

use sir_ast;
use const;
use var;

export term_to_asm/2;

// Emit AArch64 assembly for a SIR term. dest is the virtual register for the result.
// Kind 0: const -> MOV dest, #value (or literal pool)
// Kind 1: var -> MOV dest, name (variable already in register)
fn term_to_asm(term: SIRTerm, dest: string) -> string {
    case term.kind of {
        0 -> const@emit_const(term, dest);
        1 -> var@emit_var(term, dest);
        _: int64 -> concat("; unsupported term kind ", "?")
    }
}
