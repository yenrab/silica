// Term dispatcher: SIRTerm.kind -> emit function
// Delegates to const, var, call, prims per sir_emitter_pattern_spec §4.3

use sir_ast;
use atom_table;
use const;
use var;
use call;
use prims;
use print_atom_inline;
use print_bool_inline;
use print_int64_inline;
use print_int32_inline;
use print_int16_inline;
use print_int8_inline;
use print_float64_inline;
use int_rodata;
use int64_literal_pool;
use float64_literal_pool;
use string_literal_pool;

export term_to_asm/10;

// Emit ADRP+ADD for string const (kept here to avoid 6-param emit_const bootstrap issue).
fn emit_string_const(term: SIRTerm, dest: string, string_literal_table: StringLiteralTable) -> string {
    idx: int64 <- string_literal_pool@string_literal_value_to_index(string_literal_table, term.value);
    label: string <- concat("L_str_", atom_table@int64_to_decimal_string(idx));
    adrp: string <- concat(concat(concat(concat("    ADRP ", dest), ", "), concat(label, "@PAGE")), "\n");
    add: string <- concat(concat(concat(concat("    ADD ", dest), ", "), concat(concat(dest, ", "), concat(label, "@PAGEOFF"))), "");
    concat(adrp, add)
}

// Emit AArch64 assembly for a SIR term. dest is the virtual register for the result.
// Tables: int64, int32, int16, int8 for print_X const label lookup; literal_table for large int64 const; float64_literal_table for float64 const; string_literal_table for string const
fn term_to_asm(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, string_literal_table: StringLiteralTable) -> string {
    term_to_asm_opt_bound(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, "", "", "")
}

fn term_to_asm_opt_bound(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string) -> string {
    case term.kind of {
        0 -> case term.type_name == "string" of {
            true -> emit_string_const(term, dest, string_literal_table);
            false -> const@emit_const(term, dest, table, literal_table, float64_literal_table)
        };
        1 -> case term.name == bound_name of {
            true -> var@emit_var_reg(term, dest, bound_reg);
            false -> case len(outer_reg) > 0 of {
                true -> var@emit_var_reg(term, dest, outer_reg);
                false -> var@emit_var(term, dest)
            }
        };
        2 -> case len(bound_name) > 0 of {
            true -> do
                is_float64: bool <- term.inner.type_name == "float64";
                is_narrow: bool <- term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8";
                reg_prefix: string <- case is_float64 of {
                    true -> "D";
                    false -> case is_narrow of {
                        true -> "W";
                        false -> "X"
                    }
                };
                rhs_reg: string <- case term.inner.kind != 0 and (term.right_expr.kind == 4 or (term.right_expr.kind == 1 and term.right_expr.name == term.name)) of {
                    true -> dest;
                    false -> case is_float64 of {
                        true -> case bound_reg == "D0" of {
                            true -> "D1";
                            false -> case bound_reg == "D1" of {
                                true -> "D2";
                                false -> "D0"
                            }
                        };
                        false -> case bound_reg == "X0" of {
                            true -> case term.name == "%_" of {
                                true -> concat(reg_prefix, "0");
                                false -> concat(reg_prefix, "1")
                            };
                            false -> case bound_reg == concat("X", "1") of {
                                true -> concat(reg_prefix, "2");
                                false -> case bound_reg == "W0" of {
                                    true -> case term.name == "%_" of {
                                        true -> concat(reg_prefix, "0");
                                        false -> concat(reg_prefix, "1")
                                    };
                                    false -> case bound_reg == concat("W", "1") of {
                                        true -> concat(reg_prefix, "2");
                                        false -> concat(reg_prefix, "0")
                                    }
                                }
                            }
                        }
                    }
                };
                rhs_asm: string <- term_to_asm_opt_bound(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                body_asm: string <- term_to_asm_opt_bound(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, term.name, rhs_reg, bound_reg);
                concat(concat(rhs_asm, "\n"), body_asm)
            end;
            false -> do
                rhs_reg: string <- case term.inner.type_name == "float64" of {
                    true -> "D0";
                    false -> case term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8" of {
                        true -> case bound_reg == "" of {
                            true -> concat("W", "1");
                            false -> concat("W", "0")
                        };
                        false -> case term.inner.kind == 0 of {
                            true -> "X1";
                            false -> dest
                        }
                    }
                };
                rhs_asm: string <- term_to_asm_opt_bound(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                body_asm: string <- term_to_asm_opt_bound(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, term.name, rhs_reg, "");
                concat(concat(rhs_asm, "\n"), body_asm)
            end
        };
        4 -> case term.name == "main.print_atom" of {
            true -> case print_atom_inline@is_print_atom_const_arg(term, table) of {
                true -> print_atom_inline@emit_print_atom_inline(term, dest, table);
                false -> do
                    arg_asm: string <- term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                    inline_asm: string <- print_atom_inline@emit_print_atom_by_index(term, dest, table);
                    concat(concat(arg_asm, "\n"), inline_asm)
                end
            };
            false -> case term.name == "main.print_bool" of {
                true -> case print_bool_inline@is_print_bool_const_arg(term, table) of {
                    true -> print_bool_inline@emit_print_bool_inline(term, dest, table);
                    false -> do
                        arg_asm: string <- term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                        inline_asm: string <- print_bool_inline@emit_print_bool_var(term, dest, table);
                        concat(concat(arg_asm, "\n"), inline_asm)
                    end
                };
                false -> case term.name == "main.print_float64" of {
                    true -> do
                        arg_asm: string <- term_to_asm_opt_bound(term.inner, "D0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                        inline_asm: string <- print_float64_inline@emit_print_float64_var(term, dest, table);
                        concat(concat(arg_asm, "\n"), inline_asm)
                    end;
                    false -> case term.name == "main.print_int64" of {
                    true -> case print_int64_inline@is_print_int64_const_arg(term, table) of {
                        true -> print_int64_inline@emit_print_int64_inline(term, dest, table, int64_table);
                        false -> do
                            arg_asm: string <- term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                            inline_asm: string <- print_int64_inline@emit_print_int64_var(term, dest, table);
                            concat(concat(arg_asm, "\n"), inline_asm)
                        end
                    };
                    false -> case term.name == "main.print_uint64" of {
                        true -> case print_int64_inline@is_print_uint64_const_arg(term, table) of {
                            true -> print_int64_inline@emit_print_int64_inline(term, dest, table, int64_table);
                            false -> do
                                arg_asm: string <- term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                inline_asm: string <- print_int64_inline@emit_print_uint64_var(term, dest, table);
                                concat(concat(arg_asm, "\n"), inline_asm)
                            end
                        };
                        false -> case term.name == "main.print_int32" of {
                            true -> case print_int32_inline@is_print_int32_const_arg(term, table) of {
                                true -> print_int32_inline@emit_print_int32_inline(term, dest, table, int32_table);
                                false -> do
                                    arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "uint32" of {
                                        true -> concat("W", "0");
                                        false -> "X0"
                                    };
                                    arg_asm: string <- term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                    inline_asm: string <- print_int32_inline@emit_print_int32_var(term, dest, table);
                                    concat(concat(arg_asm, "\n"), inline_asm)
                                end
                            };
                            false -> case term.name == "main.print_uint32" of {
                                true -> case print_int32_inline@is_print_uint32_const_arg(term, table) of {
                                    true -> print_int32_inline@emit_print_int32_inline(term, dest, table, int32_table);
                                    false -> do
                                        arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "uint32" of {
                                            true -> concat("W", "0");
                                            false -> "X0"
                                        };
                                        arg_asm: string <- term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                        inline_asm: string <- print_int32_inline@emit_print_uint32_var(term, dest, table);
                                        concat(concat(arg_asm, "\n"), inline_asm)
                                    end
                                };
                                false -> case term.name == "main.print_int16" of {
                                    true -> case print_int16_inline@is_print_int16_const_arg(term, table) of {
                                        true -> print_int16_inline@emit_print_int16_inline(term, dest, table, int16_table);
                                        false -> do
                                            arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8" of {
                                                true -> concat("W", "0");
                                                false -> "X0"
                                            };
                                            arg_asm: string <- term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                            inline_asm: string <- print_int16_inline@emit_print_int16_var(term, dest, table);
                                            concat(concat(arg_asm, "\n"), inline_asm)
                                        end
                                    };
                                    false -> case term.name == "main.print_uint16" of {
                                        true -> case print_int16_inline@is_print_uint16_const_arg(term, table) of {
                                            true -> print_int16_inline@emit_print_int16_inline(term, dest, table, int16_table);
                                            false -> do
                                                arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8" of {
                                                    true -> concat("W", "0");
                                                    false -> "X0"
                                                };
                                                arg_asm: string <- term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                                inline_asm: string <- print_int16_inline@emit_print_uint16_var(term, dest, table);
                                                concat(concat(arg_asm, "\n"), inline_asm)
                                            end
                                        };
                                        false -> case term.name == "main.print_int8" of {
                                            true -> case print_int8_inline@is_print_int8_const_arg(term, table) of {
                                                true -> print_int8_inline@emit_print_int8_inline(term, dest, table, int8_table);
                                                false -> do
                                                    arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8" of {
                                                        true -> concat("W", "0");
                                                        false -> "X0"
                                                    };
                                                    arg_asm: string <- term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                                    inline_asm: string <- print_int8_inline@emit_print_int8_var(term, dest, table);
                                                    concat(concat(arg_asm, "\n"), inline_asm)
                                                end
                                            };
                                            false -> case term.name == "main.print_uint8" of {
                                                true -> case print_int8_inline@is_print_uint8_const_arg(term, table) of {
                                                    true -> print_int8_inline@emit_print_int8_inline(term, dest, table, int8_table);
                                                    false -> do
                                                        arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8" of {
                                                            true -> concat("W", "0");
                                                            false -> "X0"
                                                        };
                                                        arg_asm: string <- term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                                        inline_asm: string <- print_int8_inline@emit_print_uint8_var(term, dest, table);
                                                        concat(concat(arg_asm, "\n"), inline_asm)
                                                    end
                                                };
                                                false -> do
                                                    arg_asm: string <- term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                                    call_asm: string <- call@emit_call_body(term, dest);
                                                    concat(concat(arg_asm, "\n"), call_asm)
                                                end
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
        };
        6 -> do
            is_float64: bool <- term.type_name == "float64";
            is_narrow: bool <- term.type_name == "int32" or term.type_name == "int16" or term.type_name == "int8" or term.type_name == "uint32" or term.type_name == "uint16" or term.type_name == "uint8";
            reg_prefix: string <- case is_float64 of {
                true -> "D";
                false -> case is_narrow of {
                    true -> "W";
                    false -> "X"
                }
            };
            left_reg: string <- concat(reg_prefix, "1");
            right_reg: string <- concat(reg_prefix, "2");
            case bound_name == "" of {
                true -> case term.inner.kind == 6 and term.right_expr.kind == 6 of {
                    true -> do
                        left_asm: string <- term_to_asm_opt_bound(term.inner, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                        right_asm: string <- term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                        mov_asm: string <- case is_float64 of {
                            true -> concat(concat(concat("    FMOV ", left_reg), ", "), concat(dest, "\n"));
                            false -> concat(concat(concat("    MOV ", left_reg), ", "), concat(dest, "\n"))
                        };
                        op_asm: string <- prims@emit_prim_op(term, dest);
                        concat(concat(concat(concat(left_asm, "\n"), concat(right_asm, "\n")), mov_asm), op_asm)
                    end;
                    false -> do
                        left_is_prim: bool <- term.inner.kind == 6;
                        right_is_prim: bool <- term.right_expr.kind == 6;
                        (first_asm: string, second_asm: string) <- case left_is_prim of {
                            true -> do
                                l: string <- term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                r: string <- term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                (l, r)
                            end;
                            false -> case right_is_prim of {
                                true -> do
                                    r: string <- term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                    l: string <- term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                    (r, l)
                                end;
                                false -> case term.inner.kind == 6 and term.right_expr.kind == 6 of {
                                    true -> do
                                        l: string <- term_to_asm_opt_bound(term.inner, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                        r: string <- term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                        mov_asm: string <- case is_float64 of {
                                            true -> concat(concat(concat("    FMOV ", left_reg), ", "), concat(dest, "\n"));
                                            false -> concat(concat(concat("    MOV ", left_reg), ", "), concat(dest, "\n"))
                                        };
                                        (concat(concat(concat(l, "\n"), r), "\n"), mov_asm)
                                    end;
                                    false -> do
                                        l: string <- term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                        r: string <- term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                                        identity_moves: string <- case term.inner.kind == 0 and term.right_expr.kind == 0 and (term.name == "and" or term.name == "or") of {
                                            true -> case is_float64 of {
                                                true -> concat(concat(concat(concat("    FMOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    FMOV ", left_reg), ", "), left_reg), ""));
                                                false -> concat(concat(concat(concat("    MOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    MOV ", left_reg), ", "), left_reg), ""))
                                            };
                                            false -> ""
                                        };
                                        second_with_id: string <- case len(identity_moves) > 0 of {
                                            true -> concat(concat(r, "\n"), identity_moves);
                                            false -> r
                                        };
                                        (l, second_with_id)
                                    end
                                }
                            }
                        };
                        op_asm: string <- prims@emit_prim_op(term, dest);
                        concat(concat(concat(first_asm, "\n"), concat(second_asm, "\n")), op_asm)
                    end
                };
                false -> do
                    right_asm: string <- term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                    left_asm: string <- term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, string_literal_table, bound_name, bound_reg, outer_reg);
                    op_asm: string <- prims@emit_prim_op(term, dest);
                    concat(concat(concat(right_asm, "\n"), concat(left_asm, "\n")), op_asm)
                end
            }
        end;
        _: int64 -> concat("    ; unsupported term kind ", "?")
    }
}
