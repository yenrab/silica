// call term emission (SIRTerm kind 4)
// sir_emitter_pattern_spec §7.4: call -> BLR callee; result in X0
// term_emitter emits arg to X0 before calling; this emits BLR only

use sir_ast;

export emit_call_body/2;

// Emit BLR callee. Caller has already emitted arg to X0.
fn emit_call_body(term: SIRTerm, dest: string) -> string {
    blr_line: string <- concat(concat("    BLR ", term.name), "");
    result_line: string <- case dest == "X0" of {
        true -> blr_line;
        false -> concat(blr_line, concat("\n", concat(concat(concat("    MOV ", dest), ", X0"), "")))
    };
    result_line
}
