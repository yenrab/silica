// const term emission (SIRTerm kind 0)
// sir_emitter_pattern_spec §7.4: const -> MOV dest, #value (or load from literal pool)

use sir_ast;
use atom_table;
use const_atoms;
use constraints;
use int64_literal_pool;
use float64_literal_pool;
use string_literal_pool;
use string_parse;

export emit_const/6;

// Workaround: extract value via helper to avoid bootstrap concat bug with struct fields in case branches.
fn const_value(t: SIRTerm) -> string {
    t.value
}

// Emit MOV dest, #value for const term, or LDR from literal pool for large values.
// For int64/uint64: if fits_mov_imm, use MOV; else ADRP+LDR from literal pool.
// For float64: ADRP+LDR D from float64 literal pool.
// For atom: value is lexeme (e.g. :ok); uses atom table to emit index.
// For string: ADRP+LDR from string literal pool (pointer to null-terminated bytes).
fn emit_const(term: SIRTerm, dest: string, table: AtomTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, string_literal_table: StringLiteralTable) -> string {
    val: string <- const_value(term);
    case term.type_name of {
        "string" -> do
            idx: int64 <- string_literal_pool@string_literal_value_to_index(string_literal_table, term.value);
            label: string <- concat("L_str_", atom_table@int64_to_decimal_string(idx));
            adrp: string <- concat(concat(concat(concat("    ADRP ", dest), ", "), concat(label, "@PAGE")), "\n");
            add: string <- concat(concat(concat(concat("    ADD ", dest), ", "), concat(concat(dest, ", "), concat(label, "@PAGEOFF"))), "");
            concat(adrp, add)
        end;
        "int64" -> case constraints@fits_mov_imm(string_parse@string_to_int64(term.value)) of {
            true -> do
                prefix: string <- concat(concat("    MOV ", dest), ", ");
                imm_part: string <- concat("#", val);
                concat(prefix, imm_part)
            end;
            false -> do
                idx: int64 <- int64_literal_pool@int64_literal_value_to_index(literal_table, term.value);
                label: string <- concat("L_i64_", atom_table@int64_to_decimal_string(idx));
                adrp: string <- concat(concat(concat(concat("    ADRP ", dest), ", "), concat(label, "@PAGE")), "\n");
                ldr: string <- concat(concat(concat(concat(concat("    LDR ", dest), ", ["), concat(dest, ", ")), concat(label, "@PAGEOFF")), "]");
                concat(adrp, ldr)
            end
        };
        "uint64" -> case constraints@fits_mov_imm(string_parse@string_to_int64(term.value)) of {
            true -> do
                prefix: string <- concat(concat("    MOV ", dest), ", ");
                imm_part: string <- concat("#", val);
                concat(prefix, imm_part)
            end;
            false -> do
                idx: int64 <- int64_literal_pool@int64_literal_value_to_index(literal_table, term.value);
                label: string <- concat("L_i64_", atom_table@int64_to_decimal_string(idx));
                adrp: string <- concat(concat(concat(concat("    ADRP ", dest), ", "), concat(label, "@PAGE")), "\n");
                ldr: string <- concat(concat(concat(concat(concat("    LDR ", dest), ", ["), concat(dest, ", ")), concat(label, "@PAGEOFF")), "]");
                concat(adrp, ldr)
            end
        };
        "unit" -> "    ; unit: no-op";
        "atom" -> const_atoms@emit_atom_const(term, dest, table);
        "bool" -> do
            operand: string <- case term.value of {
                "true" -> concat(dest, ", #1");
                "false" -> concat(dest, ", #0");
                _: string -> do
                    prefix: string <- concat(dest, ", ");
                    imm_part: string <- concat("#", val);
                    concat(prefix, imm_part)
                end
            };
            concat("    MOV ", operand)
        end;
        "float64" -> do
            idx: int64 <- float64_literal_pool@float64_literal_value_to_index(float64_literal_table, term.value);
            label: string <- concat("L_f64_", atom_table@int64_to_decimal_string(idx));
            ptr_reg: string <- "X0";
            adrp: string <- concat(concat(concat(concat("    ADRP ", ptr_reg), ", "), concat(label, "@PAGE")), "\n");
            ldr: string <- concat(concat(concat(concat(concat("    LDR ", dest), ", ["), concat(ptr_reg, ", ")), concat(label, "@PAGEOFF")), "]");
            concat(adrp, ldr)
        end;
        _: string -> do
            prefix: string <- concat(concat("    MOV ", dest), ", ");
            imm_part: string <- concat("#", val);
            concat(prefix, imm_part)
        end
    }
}
