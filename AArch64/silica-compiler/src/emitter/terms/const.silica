// const term emission (SIRTerm kind 0)
// sir_emitter_pattern_spec §7.4: const -> MOV dest, #value (or load from literal pool)

use sir_ast;

export emit_const/2;

// Emit MOV dest, #value for const term.
// For int64: value is decimal string. For unit/bool: emit placeholder.
// Build operand as "dest, #value" to avoid concat ordering issues.
fn emit_const(term: SIRTerm, dest: string) -> string {
    case term.type_name of {
        "int64" -> do
            operand: string <- concat(concat(dest, ", #"), term.value);
            concat("    MOV ", operand)
        end;
        "unit" -> "    ; unit: no-op";
        "bool" -> do
            operand: string <- case term.value of {
                "true" -> concat(dest, ", #1");
                "false" -> concat(dest, ", #0");
                _: string -> concat(concat(dest, ", #"), term.value)
            };
            concat("    MOV ", operand)
        end;
        _: string -> do
            operand: string <- concat(concat(dest, ", #"), term.value);
            concat("    MOV ", operand)
        end
    }
}
