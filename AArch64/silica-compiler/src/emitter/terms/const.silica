// const term emission (SIRTerm kind 0)
// sir_emitter_pattern_spec §7.4: const -> MOV dest, #value (or load from literal pool)

use sir_ast;

export emit_const/2;

// Emit MOV dest, #value for const term.
// For int64: value is decimal string. For unit/bool: emit placeholder.
fn emit_const(term: SIRTerm, dest: string) -> string {
    case term.type_name of {
        "int64" -> concat(concat(concat("    MOV ", dest), ", #"), term.value);
        "unit" -> "    ; unit: no-op";
        "bool" -> do
            case term.value of {
                "true" -> concat(concat("    MOV ", dest), ", #1");
                "false" -> concat(concat("    MOV ", dest), ", #0");
                _: string -> concat(concat(concat("    MOV ", dest), ", #"), term.value)
            }
        end;
        _: string -> concat(concat(concat("    MOV ", dest), ", #"), term.value)
    }
}
