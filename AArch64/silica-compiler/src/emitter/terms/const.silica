// const term emission (SIRTerm kind 0)
// sir_emitter_pattern_spec §7.4: const -> MOV dest, #value (or load from literal pool)

use sir_ast;
use atom_table;
use const_atoms;
use constraints;
use int64_literal_pool;

export emit_const/4;

// Emit MOV dest, #value for const term, or LDR from literal pool for large values.
// For int64/uint64: if fits_mov_imm, use MOV; else ADRP+LDR from literal pool.
// For atom: value is lexeme (e.g. :ok); uses atom table to emit index.
fn emit_const(term: SIRTerm, dest: string, table: AtomTable, literal_table: Int64LiteralTable) -> string {
    case term.type_name of {
        "int64" -> case constraints@fits_mov_imm(string_to_int64(term.value)) of {
            true -> do
                operand: string <- concat(concat(dest, ", #"), term.value);
                concat("    MOV ", operand)
            end;
            false -> do
                idx: int64 <- int64_literal_pool@int64_literal_value_to_index(literal_table, term.value);
                label: string <- concat("L_i64_", atom_table@int64_to_decimal_string(idx));
                adrp: string <- concat(concat(concat(concat("    ADRP ", dest), ", "), concat(label, "@PAGE")), "\n");
                ldr: string <- concat(concat(concat(concat(concat("    LDR ", dest), ", ["), concat(dest, ", ")), concat(label, "@PAGEOFF")), "]");
                concat(adrp, ldr)
            end
        };
        "uint64" -> case constraints@fits_mov_imm(string_to_int64(term.value)) of {
            true -> do
                operand: string <- concat(concat(dest, ", #"), term.value);
                concat("    MOV ", operand)
            end;
            false -> do
                idx: int64 <- int64_literal_pool@int64_literal_value_to_index(literal_table, term.value);
                label: string <- concat("L_i64_", atom_table@int64_to_decimal_string(idx));
                adrp: string <- concat(concat(concat(concat("    ADRP ", dest), ", "), concat(label, "@PAGE")), "\n");
                ldr: string <- concat(concat(concat(concat(concat("    LDR ", dest), ", ["), concat(dest, ", ")), concat(label, "@PAGEOFF")), "]");
                concat(adrp, ldr)
            end
        };
        "unit" -> "    ; unit: no-op";
        "atom" -> const_atoms@emit_atom_const(term, dest, table);
        "bool" -> do
            operand: string <- case term.value of {
                "true" -> concat(dest, ", #1");
                "false" -> concat(dest, ", #0");
                _: string -> concat(concat(dest, ", #"), term.value)
            };
            concat("    MOV ", operand)
        end;
        _: string -> do
            operand: string <- concat(concat(dest, ", #"), term.value);
            concat("    MOV ", operand)
        end
    }
}
