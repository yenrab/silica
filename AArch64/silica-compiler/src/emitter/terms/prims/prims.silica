// Prim dispatcher: SIRTerm.kind 6 -> emit op line only (operands in X1, X2)
// term_emitter emits subterms to X1/X2 before calling this; avoids circular dep

use sir_ast;
use arithmetic;
use comparison;

export emit_prim_op/2;

// Emit just the op line for a prim. Caller has already emitted left->X1, right->X2.
fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    case term.name of {
        "add" -> arithmetic@emit_add_op(dest);
        "sub" -> arithmetic@emit_sub_op(dest);
        "mul" -> arithmetic@emit_mul_op(dest);
        "div" -> arithmetic@emit_div_op(dest);
        "rem" -> arithmetic@emit_rem_op(dest);
        "lt" -> comparison@emit_lt_op(dest);
        "gt" -> comparison@emit_gt_op(dest);
        "le" -> comparison@emit_le_op(dest);
        "ge" -> comparison@emit_ge_op(dest);
        "eq" -> comparison@emit_eq_op(dest);
        "ne" -> comparison@emit_ne_op(dest);
        _: string -> concat("    ; unsupported prim: ", term.name)
    }
}
