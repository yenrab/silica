// Prim dispatcher: SIRTerm.kind 6 -> emit op line only (operands in r1, r2)
// term_emitter emits subterms to r1/r2 before calling this; avoids circular dep
// int32 uses W registers, int64 uses X registers

use sir_ast;
use arithmetic;
use comparison;
use logical;

export emit_prim_op/2;

// Emit just the op line for a prim. Caller has already emitted left->r1, right->r2.
// reg_prefix: "W" for int32, "X" for int64. dest_reg: W0/W1/W2 or X0/X1/X2.
fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    reg_prefix: string <- case term.type_name == "int32" of {
        true -> "W";
        false -> "X"
    };
    dest_reg: string <- case term.type_name == "int32" of {
        true -> concat(reg_prefix, substring(dest, 1, len(dest)));
        false -> dest
    };
    case term.name of {
        "add" -> arithmetic@emit_add_op(dest_reg, reg_prefix);
        "sub" -> arithmetic@emit_sub_op(dest_reg, reg_prefix);
        "mul" -> arithmetic@emit_mul_op(dest_reg, reg_prefix);
        "div" -> arithmetic@emit_div_op(dest_reg, reg_prefix);
        "rem" -> arithmetic@emit_rem_op(dest_reg, reg_prefix);
        "lt" -> comparison@emit_lt_op(dest_reg, reg_prefix);
        "gt" -> comparison@emit_gt_op(dest_reg, reg_prefix);
        "le" -> comparison@emit_le_op(dest_reg, reg_prefix);
        "ge" -> comparison@emit_ge_op(dest_reg, reg_prefix);
        "eq" -> comparison@emit_eq_op(dest_reg, reg_prefix);
        "ne" -> comparison@emit_ne_op(dest_reg, reg_prefix);
        "and" -> logical@emit_and_op(dest_reg, reg_prefix);
        "or" -> logical@emit_or_op(dest_reg, reg_prefix);
        _: string -> concat("    ; unsupported prim: ", term.name)
    }
}
