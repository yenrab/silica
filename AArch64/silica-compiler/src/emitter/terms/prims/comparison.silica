// int64 comparison prim emission: lt, gt, le, ge, eq, ne
// sir_emitter_pattern_spec §7.2: CMP X1, X2; CSET dest, cond
// Operands in X1, X2 (term_emitter emits subterms before calling)

use sir_ast;

export emit_lt_op/1;
export emit_gt_op/1;
export emit_le_op/1;
export emit_ge_op/1;
export emit_eq_op/1;
export emit_ne_op/1;

fn emit_compare_op(dest: string, cond: string) -> string {
    cmp_line: string <- "    CMP X1, X2";
    cset_line: string <- concat(concat(concat(concat("    CSET ", dest), ", "), cond), "");
    concat(concat(cmp_line, "\n"), cset_line)
}

fn emit_lt_op(dest: string) -> string {
    emit_compare_op(dest, "LT")
}

fn emit_gt_op(dest: string) -> string {
    emit_compare_op(dest, "GT")
}

fn emit_le_op(dest: string) -> string {
    emit_compare_op(dest, "LE")
}

fn emit_ge_op(dest: string) -> string {
    emit_compare_op(dest, "GE")
}

fn emit_eq_op(dest: string) -> string {
    emit_compare_op(dest, "EQ")
}

fn emit_ne_op(dest: string) -> string {
    emit_compare_op(dest, "NE")
}
