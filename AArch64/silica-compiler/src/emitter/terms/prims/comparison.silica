// int64/int32/uint64/uint32 comparison prim emission: lt, gt, le, ge, eq, ne
// sir_emitter_pattern_spec §7.2: CMP r1, r2; CSET dest, cond
// Signed: LT, GT, LE, GE. Unsigned: LO, HI, LS, HS. eq/ne same for both.
// Operands in r1, r2. reg_prefix: "X" (int64/uint64) or "W" (int32/uint32/etc).

use sir_ast;

export emit_lt_op/2;
export emit_gt_op/2;
export emit_le_op/2;
export emit_ge_op/2;
export emit_eq_op/2;
export emit_ne_op/2;
export emit_ult_op/2;
export emit_ugt_op/2;
export emit_ule_op/2;
export emit_uge_op/2;

fn emit_compare_op(dest: string, cond: string, reg_prefix: string) -> string {
    r1: string <- concat(reg_prefix, "1");
    r2: string <- concat(reg_prefix, "2");
    cmp_line: string <- concat(concat(concat(concat("    CMP ", r1), ", "), r2), "");
    cset_line: string <- concat(concat(concat(concat("    CSET ", dest), ", "), cond), "");
    concat(concat(cmp_line, "\n"), cset_line)
}

fn emit_lt_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "LT", reg_prefix)
}

fn emit_gt_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "GT", reg_prefix)
}

fn emit_le_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "LE", reg_prefix)
}

fn emit_ge_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "GE", reg_prefix)
}

fn emit_eq_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "EQ", reg_prefix)
}

fn emit_ne_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "NE", reg_prefix)
}

fn emit_ult_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "LO", reg_prefix)
}

fn emit_ugt_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "HI", reg_prefix)
}

fn emit_ule_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "LS", reg_prefix)
}

fn emit_uge_op(dest: string, reg_prefix: string) -> string {
    emit_compare_op(dest, "HS", reg_prefix)
}
