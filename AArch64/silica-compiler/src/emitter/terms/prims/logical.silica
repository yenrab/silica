// Boolean logical prim emission: and, or
// Operands in X1, X2 (term_emitter emits subterms before calling)
// For 0/1 booleans: AND/ORR then CMP #0; CSET dest, ne

use sir_ast;

export emit_and_op/1;
export emit_or_op/1;

fn emit_and_op(dest: string) -> string {
    and_line: string <- concat(concat(concat("    AND ", dest), ", X1, X2\n"), "");
    cmp_line: string <- concat(concat("    CMP ", dest), ", #0\n");
    cset_line: string <- concat(concat("    CSET ", dest), ", NE\n");
    concat(concat(and_line, cmp_line), cset_line)
}

fn emit_or_op(dest: string) -> string {
    orr_line: string <- concat(concat(concat("    ORR ", dest), ", X1, X2\n"), "");
    cmp_line: string <- concat(concat("    CMP ", dest), ", #0\n");
    cset_line: string <- concat(concat("    CSET ", dest), ", NE\n");
    concat(concat(orr_line, cmp_line), cset_line)
}
