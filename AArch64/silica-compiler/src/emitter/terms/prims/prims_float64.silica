// float64 prim emission: add, sub, mul, div, lt, gt, le, ge, eq, ne
// D registers, FADD/FSUB/FMUL/FDIV, FCMP+CSET for comparison

use sir_ast;
use arithmetic;
use comparison;

export emit_prim_op/2;

fn dest_to_d_reg(dest: string) -> string {
    case dest of {
        "X0" -> "D0";
        "X1" -> "D1";
        "X2" -> "D2";
        "D0" -> "D0";
        "D1" -> "D1";
        "D2" -> "D2";
        _: string -> dest
    }
}

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    dest_reg: string <- dest_to_d_reg(dest);
    case term.name of {
        "add" -> arithmetic@emit_fadd_op(dest_reg);
        "sub" -> arithmetic@emit_fsub_op(dest_reg);
        "mul" -> arithmetic@emit_fmul_op(dest_reg);
        "div" -> arithmetic@emit_fdiv_op(dest_reg);
        "lt" -> comparison@emit_fcmp_lt_op(dest_reg, "D");
        "gt" -> comparison@emit_fcmp_gt_op(dest_reg, "D");
        "le" -> comparison@emit_fcmp_le_op(dest_reg, "D");
        "ge" -> comparison@emit_fcmp_ge_op(dest_reg, "D");
        "eq" -> comparison@emit_fcmp_eq_op(dest_reg, "D");
        "nq" -> comparison@emit_fcmp_ne_op(dest_reg, "D");
        _: string -> concat("    ; unsupported float64 prim: ", term.name)
    }
}
