// Inline emission for print_float32 built-in.
// Always uses L_pf32_helper: const loads from L_f32_N, var has arg in S0.

use sir_ast;
use atom_table;
use emitter_effects;

export emit_print_float32_var/3;
export emit_print_float32_helper/0;

fn emit_print_float32_var(term: SIRTerm, dest: string, _table: AtomTable) -> string {
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- "    BL L_pf32_helper\n";
    mov_ret: string <- concat(concat("    MOV ", dest), ", #0\n");
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// L_pf32_helper: S0 = float32 to print. Converts to string on stack, write(2).
// Integer part: FCVTZS, digit loop. Fractional part: frac*=10 loop (up to 7 digits for float32).
fn emit_print_float32_helper() -> string {
    "L_pf32_helper:\n    SUB SP, SP, #64\n    STR S0, [SP, #0]\n    FCMP S0, #0.0\n    B.ge L_pf32_pos\n    MOV X0, #1\n    ADRP X1, L_pf32_minus@PAGE\n    ADD X1, X1, L_pf32_minus@PAGEOFF\n    MOV X2, #1\n    MOV X16, #4\n    SVC #0\n    LDR S0, [SP, #0]\n    FNEG S0, S0\n    STR S0, [SP, #0]\nL_pf32_pos:\n    FCVTZS W0, S0\n    MOV X10, SP\n    ADD X10, X10, #48\n    MOV X11, #0\n    CMP X0, #0\n    B.ge L_pf32_ipos\n    MOV X11, #1\n    NEG X0, X0\nL_pf32_ipos:\n    MOV X8, X10\n    CMP X0, #0\n    B.eq L_pf32_izero\n    MOV X9, #10\nL_pf32_iloop:\n    UDIV X1, X0, X9\n    MSUB X2, X1, X9, X0\n    ADD X2, X2, #48\n    SUB X8, X8, #1\n    STRB W2, [X8]\n    MOV X0, X1\n    CBNZ X0, L_pf32_iloop\n    B L_pf32_imaybe_neg\nL_pf32_izero:\n    SUB X8, X8, #1\n    MOV X1, #48\n    STRB W1, [X8]\nL_pf32_imaybe_neg:\n    CBNZ X11, L_pf32_iprepend_minus\n    B L_pf32_ido_int\nL_pf32_iprepend_minus:\n    SUB X8, X8, #1\n    MOV X1, #45\n    STRB W1, [X8]\nL_pf32_ido_int:\n    SUB X2, X10, X8\n    MOV X0, #1\n    MOV X1, X8\n    MOV X16, #4\n    SVC #0\n    LDR S0, [SP, #0]\n    FRINTZ S1, S0\n    FSUB S2, S0, S1\n    ADRP X8, L_pf32_10@PAGE\n    LDR S3, [X8, L_pf32_10@PAGEOFF]\n    MOV X12, #7\n    MOV X9, X10\n    SUB X9, X9, #7\n    MOV X8, X9\nL_pf32_frac_loop:\n    CBZ X12, L_pf32_frac_done\n    FMUL S2, S2, S3\n    FCVTZS W0, S2\n    ADD X2, X0, #48\n    STRB W2, [X8]\n    ADD X8, X8, #1\n    SCVTF S4, W0\n    FSUB S2, S2, S4\n    SUB X12, X12, #1\n    FCMP S2, #0.0\n    B.eq L_pf32_frac_done\n    B L_pf32_frac_loop\nL_pf32_frac_done:\n    SUB X9, X9, #1\n    MOV X1, #46\n    STRB W1, [X9]\n    SUB X2, X8, X9\n    MOV X0, #1\n    MOV X1, X9\n    MOV X16, #4\n    SVC #0\n    ADD SP, SP, #64\n    RET"
}
