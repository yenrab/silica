// unit const emission (SIRTerm kind 0, type unit)
// No-op: unit has no value

use sir_ast;
use atom_table;
use int64_literal_pool;
use float64_literal_pool;
use float32_literal_pool;

export emit_const/6;

fn emit_const(term: SIRTerm, dest: string, table: AtomTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable) -> string {
    "    ; unit: no-op"
}
