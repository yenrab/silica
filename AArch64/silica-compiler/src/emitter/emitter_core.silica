// Emitter core: SIRModule -> AArch64 assembly
// Entry point: orchestrates emission of SIR to assembly text

use sir_ast;
use term_emitter;
use control;
use emitter_effects;
use atom_table;
use atom_rodata;
use boolean_rodata;
use int_rodata;
use print_int64_inline;

export emit_module/1;

// Emit AArch64 assembly for a SIR module.
// Input: SIRModule (from sir_generator, post-optimization)
// Output: Assembly text as string
fn emit_module(sir_module: SIRModule) -> string proc[DeviceIO] {
    do
    header: string <- asm_header(sir_module.module_name);
    table: AtomTable <- atom_table@build_atom_table(sir_module);
    int64_table: Int64PrintTable <- int_rodata@build_int64_print_table(sir_module);
    int32_table: Int32PrintTable <- int_rodata@build_int32_print_table(sir_module);
    int16_table: Int16PrintTable <- int_rodata@build_int16_print_table(sir_module);
    int8_table: Int8PrintTable <- int_rodata@build_int8_print_table(sir_module);
    funcs: string <- emit_functions(sir_module.functions, table, int64_table, int32_table, int16_table, int8_table);
    needs_pi_helper: bool <- int_rodata@module_uses_signed_print_var(sir_module);
    needs_pu_helper: bool <- case int_rodata@module_uses_uint64_print_var(sir_module) of {
        true -> true;
        false -> case int_rodata@module_uses_uint32_print_var(sir_module) of {
            true -> true;
            false -> case int_rodata@module_uses_uint16_print_var(sir_module) of {
                true -> true;
                false -> int_rodata@module_uses_uint8_print_var(sir_module)
            }
        }
    };
    pi_helper: string <- case needs_pi_helper of {
        true -> concat("\n", print_int64_inline@emit_print_int64_helper());
        false -> ""
    };
    pu_helper: string <- case needs_pu_helper of {
        true -> concat("\n", print_int64_inline@emit_print_uint64_helper());
        false -> ""
    };
    funcs_with_helper: string <- concat(concat(funcs, pi_helper), pu_helper);
    atom_rodata_str: string <- atom_rodata@emit_atom_rodata_section(table);
    bool_rodata: string <- boolean_rodata@emit_boolean_rodata_section();
    int64_rodata_str: string <- int_rodata@emit_int64_rodata_section(int64_table);
    int32_rodata_str: string <- int_rodata@emit_int32_rodata_section(int32_table);
    int16_rodata_str: string <- int_rodata@emit_int16_rodata_section(int16_table);
    int8_rodata_str: string <- int_rodata@emit_int8_rodata_section(int8_table);
    code_part: string <- concat(concat(header, "\n"), funcs_with_helper);
    with_atom: string <- case len(atom_rodata_str) > 0 of {
        true -> concat(concat(code_part, "\n"), atom_rodata_str);
        false -> code_part
    };
    with_bool: string <- case boolean_rodata@module_uses_booleans(sir_module) of {
        true -> concat(concat(with_atom, "\n"), bool_rodata);
        false -> with_atom
    };
    with_int64: string <- case int_rodata@module_uses_int64_print(sir_module) of {
        true -> concat(concat(with_bool, "\n"), int64_rodata_str);
        false -> with_bool
    };
    with_int32: string <- case int_rodata@module_uses_int32_print(sir_module) of {
        true -> concat(concat(with_int64, "\n"), int32_rodata_str);
        false -> with_int64
    };
    with_int16: string <- case int_rodata@module_uses_int16_print(sir_module) of {
        true -> concat(concat(with_int32, "\n"), int16_rodata_str);
        false -> with_int32
    };
    with_int8: string <- case int_rodata@module_uses_int8_print(sir_module) of {
        true -> concat(concat(with_int16, "\n"), int8_rodata_str);
        false -> with_int16
    };
    with_int8
    end
}

fn asm_header(name: string) -> string {
    concat(".text\n", concat(concat(".global ", name), "\n"))
}

fn emit_functions(fns: ListSIRFunction, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable) -> string proc[DeviceIO] {
    do
    case fns.is_nil of {
        true -> "";
        false -> do
            fn_asm: string <- emit_sir_function(fns.head, table, int64_table, int32_table, int16_table, int8_table);
            rest_asm: string <- emit_functions(fns.tail, table, int64_table, int32_table, int16_table, int8_table);
            case rest_asm == "" of {
                true -> fn_asm;
                false -> concat(concat(fn_asm, "\n"), rest_asm)
            }
        end
    }
    end
}

fn emit_sir_function(fn_val: SIRFunction, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable) -> string proc[DeviceIO] {
    do
    entry_label: string <- entry_point_label(fn_val.name);
    eff_comment: string <- emitter_effects@fn_effect_annotation(fn_val.effects);
    prologue: string <- control@function_prologue_with_effects(entry_label, fn_val.effects);
    dest_reg: string <- case fn_val.return_type == "int32" or fn_val.return_type == "int16" or fn_val.return_type == "int8" or fn_val.return_type == "uint32" or fn_val.return_type == "uint16" or fn_val.return_type == "uint8" of {
        true -> concat("W", "0");
        false -> "X0"
    };
    body: string <- term_emitter@term_to_asm(fn_val.body, dest_reg, table, int64_table, int32_table, int16_table, int8_table);
    epilogue: string <- control@function_epilogue_with_effects(fn_val.effects);
    concat(concat(concat(eff_comment, "\n"), concat(prologue, "\n")), concat(concat(body, "\n"), epilogue))
    end
}

// Use "main" as label for main entry point; never emit main.main or main.m
fn entry_point_label(name: string) -> string {
    case name of {
        "main.main" -> "main";
        "main.m" -> "main";
        "main" -> "main";
        _: string -> name
    }
}
