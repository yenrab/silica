// Capability: check function declaration (Declaration tag 0)
// Adds function to symbol table, checks body expression

use parser_ast;
use type_checker_core;
use type_checker_expressions;

export add_function/2;
export check_body/2;

// Add function name, return type, and declared effects to context. Used for first pass (all decls).
fn add_function(decl: Declaration, context: TypeContext) -> TypeContext {
    new_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, decl.name, decl.return_type_name, decl.declared_effects);
    TypeContext { env: new_env }
}

// Check function body. Context must already include all declarations (for mutual recursion).
// For proc return types (T proc[E]), the body's expected type is T. The parser stores return_type_name as T.
fn check_body(decl: Declaration, context: TypeContext) -> TypeCheckResult {
    type_checker_expressions@check_expr(decl.body, decl.return_type_name, context)
}
