// Function declaration type checking
// Validates function declarations (Declaration tag 0)

use parser_ast;
use type_checker_core;

export check_function_declaration/2;

// Check type of a function declaration (Declaration tag 0)
// Resolves return_type_name, adds to symbol table. Returns Ok(true) on success, Err on failure.
fn check_function_declaration(context: TypeContext, decl: Declaration) -> (ResultBoolTypeError, TypeContext) proc[mem(normal)] {
    case decl.tag of {
        0 -> do
            // Resolve return type name
            resolved: ResultStringTypeError <- resolve_type_name(decl.return_type_name, decl.return_type_location);
            case resolved.is_ok of {
                true -> (result_bool_ok(true), add_symbol_to_context(context, decl.name, resolved.value));
                false -> (result_bool_err(resolved.error), context)
            }
        end;
        _: int64 -> (result_bool_err(TypeError { message: "expected function declaration (tag 0)", location: decl.location }), context)
    }
}
