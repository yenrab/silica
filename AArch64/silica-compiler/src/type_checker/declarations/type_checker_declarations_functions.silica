// Capability: check function declaration (Declaration tag 0)
// Adds function to symbol table, checks body expression

use parser_ast;
use type_checker_core;
use type_checker_expressions_literals;
use type_checker_expressions_identifiers;

export add_function/2;
export check_body/2;

// Add function name->return_type to context. Used for first pass (all decls).
fn add_function(decl: Declaration, context: TypeContext) -> TypeContext {
    new_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, decl.name, decl.return_type_name);
    TypeContext { env: new_env }
}

// Check function body. Context must already include all declarations (for mutual recursion).
fn check_body(decl: Declaration, context: TypeContext) -> TypeCheckResult {
    check_expr(decl.body, decl.return_type_name, context)
}

// Dispatch on Expr kind: 0=literal, 1=identifier, 2=parenthesized (recurse)
fn check_expr(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult {
    case expr.kind of {
        0 -> type_checker_expressions_literals@check_expr(expr, expected_type, context);
        1 -> type_checker_expressions_identifiers@check_expr(expr, expected_type, context);
        2 -> check_expr(expr.inner, expected_type, context);
        _: int64 -> type_checker_core@type_check_ok()
    }
}
