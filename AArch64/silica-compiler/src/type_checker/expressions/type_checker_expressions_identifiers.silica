// Identifier expression type checking (Expr kind 1)

use parser_ast;
use type_checker_core;

export check_identifier_expr/2;

// Check type of identifier expression (Expr kind 1); lookup in symbol table
fn check_identifier_expr(context: TypeContext, expr: Expr) -> ResultStringTypeError proc[mem(normal)] {
    found: string <- lookup_symbol(context.env, expr.name);
    case found == "" of {
        true -> result_string_err(TypeError { message: concat("undeclared identifier: ", expr.name), location: expr.location });
        false -> result_string_ok(found)
    }
}
