// Boolean literal expression type checking (Expr kind 7)
// Verifies boolean literal (true/false) matches expected return type

use parser_ast;
use type_checker_core;

export check_expr/3;

// Check Expr kind 7 (boolean literal). Expected type is function return type (e.g. "boolean").
fn check_expr(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult {
    case expected_type of {
        "boolean" -> type_checker_core@type_check_ok();
        "discard" -> type_checker_core@type_check_ok();
        _: string -> type_checker_core@type_check_err("E2001", expr.location, concat("boolean literal requires boolean return type, got ", case expected_type of { "" -> "[EMPTY]"; _: string -> expected_type }), "sect6")
    }
}
