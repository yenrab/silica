// Expression type checking dispatcher
// Validates expressions using parser AST: Expr (kind 0=literal, 1=identifier, 2=parenthesized)

use parser_ast;
use type_checker_core;
use type_checker_expressions_literals;
use type_checker_expressions_identifiers;

export check_expr/2;

// Check type of an expression. Dispatches on Expr.kind.
// Kind 0: integer literal -> int64
// Kind 1: identifier -> lookup in symbol table
// Kind 2: parenthesized -> recurse on inner
fn check_expr(context: TypeContext, expr: Expr) -> ResultStringTypeError proc[mem(normal)] {
    case expr.kind of {
        0 -> type_checker_expressions_literals@check_literal_expr(expr);
        1 -> type_checker_expressions_identifiers@check_identifier_expr(context, expr);
        2 -> check_expr(context, expr.inner);
        _: int64 -> result_string_err(TypeError { message: "invalid expression kind", location: expr.location })
    }
}
