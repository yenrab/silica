{-
- Minimal parse: consume tokens until eof (validates stream is usable)
- Used by the parser to consume tokens until eof (validates stream is usable): parse_from_tokens, is_eof, and other predicates check the current token without consuming it. Fits into the design as the minimal parse that consumes tokens until eof.
- Example: parse_until_eof(stream) uses current_token to get the current token without advancing.
- Time: O(n), Ω(n), Θ(n) where n is the number of tokens in the list. Space: O(n), Ω(1), Θ(n) for the ListToken chain (n tokens) plus recursion depth.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn parse_until_eof(stream: ListToken) -> bool {
    case is_eof(stream) of {
        true -> true;
        false -> parse_until_eof(advance_by_one(stream))
    }
}

{-
- Builds a parse-order stream from the lexer output and runs a minimal parse: consumes tokens until eof (validates stream is usable).
- Used by the parser to build a parse-order stream from the lexer output and run a minimal parse: parse_from_tokens, is_eof, and other predicates check the current token without consuming it. Fits into the design as the function that builds a parse-order stream from the lexer output and runs a minimal parse.
- Example: parse_from_tokens(tokens) uses reverse_token_list to build a parse-order stream from the lexer output and then uses parse_until_eof to run a minimal parse.
- Time: O(n), Ω(n), Θ(n) where n is the number of tokens in the list. Space: O(n), Ω(1), Θ(n) for the ListToken chain (n tokens) plus recursion depth.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn parse_from_tokens(tokens: ListToken) -> bool {
    stream: ListToken <- reverse_token_list(tokens);
    parse_until_eof(stream)
}


