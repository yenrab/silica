// Parser core - token stream and support for all lexer token variations
// First implementation: sufficient to consume and classify every token kind
// produced by the lexer in src/lexer (identifier, type keywords, fn, literals, operators, eof).

use lexer_core;
use lexer_token_kind;
use lexer_runner;


export reverse_token_list/1;
export current_token/1;
export advance_by_one/1;
export peek_kind/1;
export expect_kind/2;
export parse_from_tokens/1;
export parse_until_eof/1;
export is_eof/1;
export is_identifier/1;
export is_int8_keyword/1;
export is_int16_keyword/1;
export is_int32_keyword/1;
export is_int64_keyword/1;
export is_float16_keyword/1;
export is_float32_keyword/1;
export is_float64_keyword/1;
export is_bool_keyword/1;
export is_char_keyword/1;
export is_string_keyword/1;
export is_unit_keyword/1;
export peek_is_fn_keyword/1;
export is_integer_literal/1;
export is_right_arrow/1;
export is_left_paren/1;
export is_right_paren/1;
export is_left_brace/1;
export is_right_brace/1;

{-
- Returns a sentinel ListToken with is_nil true, head an eof token, and tail pointing to itself; used when a ListToken is required but parsing failed.
- Used by the parser on failure: return (false, parser_core@empty_list(), stream, "expected token", tok.location) so callers receive a valid ListToken shape. The head is an eof token so downstream phases can treat it as "no tokens yet." Fits into the design as the canonical "empty token list."
- Example: parse_from_tokens returns (false, parser_core@empty_list(), stream, "expected token", tok.location) when the first token fails to parse.
- Example: Callers check the parse ok flag; when false, they may ignore the ListToken or use it only to avoid a missing value — empty_list() ensures the type is valid.
- Example: Traversing ListToken: if dummy, is_nil is true so the list is effectively empty.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One ListToken node plus one eof token; self-referential list, no unbounded allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn empty_list() -> ListToken {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    eof_token: Token <- lexer_core@make_token(kinds.eof, "", SourceLocation { file: "", line: 0, column: 0, offset: 0 });
    placeholder: ListToken <- ListToken { is_nil: true, head: eof_token, tail: placeholder };
    placeholder
}

{-
- Reverses a ListToken so the first token is at the head (parse order): conses each token from the tail onto the accumulator, then returns the accumulated ListToken.
- Used by reverse_token_list to build the ListToken in parse order: start with empty_list() and cons each token as it is read until EOF. Callers that traverse the list should treat is_nil true as end-of-list and not follow tail. Fits into the design as the reverse-accumulator function for ListToken.
- Example: initial_tokens <- empty_list(); tokenize(lexer, initial_tokens) — tokenize builds the list by consing onto this nil.
- Example: checking list emptiness by testing the result’s is_nil field; when true, the list has no tokens.
- Example: building a list manually by consing a token onto empty_list() to get a single-element list.
- Time: O(n), Ω(n), Θ(n) where n is the number of tokens in the list. Space: O(n), Ω(1), Θ(n) for the ListToken chain (n tokens) plus recursion depth.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn reverse_acc(acc: ListToken, list: ListToken) -> ListToken {
    case list.is_nil of {
        true -> acc;
        false -> do
            new_acc: ListToken <- ListToken { is_nil: false, head: list.head, tail: acc };
            reverse_acc(new_acc, list.tail)
        end
    }
}

{-
- Reverses a ListToken so the first token is at the head (parse order): conses each token from the tail onto the accumulator, then returns the accumulated ListToken.
- Used by parse_from_tokens to build the ListToken in parse order: start with empty_list() and cons each token as it is read until EOF. Callers that traverse the list should treat is_nil true as end-of-list and not follow tail. Fits into the design as the main reverse function for ListToken.
- Example: initial_tokens <- empty_list(); parse_from_tokens(initial_tokens) — parse_from_tokens builds the list by consing onto this nil.
- Example: checking list emptiness by testing the result’s is_nil field; when true, the list has no tokens.
- Example: building a list manually by consing a token onto empty_list() to get a single-element list.
- Time: O(n), Ω(n), Θ(n) where n is the number of tokens in the list. Space: O(n), Ω(1), Θ(n) for the ListToken chain (n tokens) plus recursion depth.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn reverse_token_list(list: ListToken) -> ListToken {
    empty: ListToken <- empty_list();
    reverse_acc(empty, list)
}

{-
- Returns the current token from the ListToken stream: if the stream is empty (is_nil true), returns the eof token; otherwise returns the head token.
- Used by the parser to get the current token without advancing the stream: peek_kind, expect_kind, and other predicates check the current token without consuming it. Fits into the design as the single function to get the current token from a ListToken.
- Example: tok: Token <- parser_core@current_token(stream) — tok is the first token in the stream (or eof if empty).
- Example: peek_kind(stream) uses current_token to get the current token without advancing.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One token access; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn current_token(stream: ListToken) -> Token {
    case stream.is_nil of {
        true -> stream.head;
        false -> stream.head
    }
}

{-
- Advances the ListToken stream by one token: if the stream is empty (is_nil true), returns it unchanged; otherwise returns the stream with the tail (rest) as the new head.
- Used by the parser to consume the current token without returning it: expect_kind, is_eof, and other predicates check the current token without consuming it. Fits into the design as the single function to advance the stream by one token.
- Example: rest: ListToken <- parser_core@advance_by_one(stream) — rest is the stream after the current token (or unchanged if empty).
- Example: peek_kind(advance_by_one(stream)) uses the new stream to peek the next token.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One token access; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn advance_by_one(stream: ListToken) -> ListToken {
    case stream.is_nil of {
        true -> stream;
        false -> stream.tail
    }
}

{-
- Returns the kind of the current token from the ListToken stream: if the stream is empty (is_nil true), returns the kind of the eof token; otherwise returns the kind of the head token.
- Used by the parser to get the kind of the current token without advancing the stream: peek_kind, expect_kind, and other predicates check the current token without consuming it. Fits into the design as the single function to get the kind of the current token from a ListToken.
- Example: kind: int64 <- parser_core@peek_kind(stream) — kind is the kind of the first token in the stream (or eof if empty).
- Example: peek_kind(stream) uses current_token to get the current token without advancing.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One token access; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn peek_kind(stream: ListToken) -> int64 {
    current_token(stream).kind
}

{-
- Expects the current token of the ListToken stream to have a given kind: if the current token’s kind matches the expected kind, advances the stream by one token and returns true; otherwise returns false and the original stream unchanged.
- Used by the parser to verify the current token before consuming it: expect_kind, is_eof, and other predicates check the current token without consuming it. Fits into the design as the single function to expect the current token to have a given kind.
- Example: ok: bool <- parser_core@expect_kind(stream, expected_kind) — ok is true if the current token’s kind matches expected_kind, otherwise false.
- Example: peek_kind(expect_kind(stream, expected_kind)) uses the new stream to peek the next token.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One token access; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn expect_kind(stream: ListToken, expected_kind: int64) -> (bool, ListToken) {
    k: int64 <- peek_kind(stream);
    case k == expected_kind of {
        true -> (true, advance_by_one(stream));
        false -> (false, stream)
    }
}

{-
- Returns true if the current token of the ListToken stream is an eof token: kind is eof.
- Used by the parser to check if the stream is at the end of the file: parse_until_eof, is_eof, and other predicates check the current token without consuming it. Fits into the design as the predicate that checks for EOF.
- Example: is_eof(stream) uses current_token to get the current token without advancing.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One token access; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_eof(stream: ListToken) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    peek_kind(stream) == kinds.identifier
}

{-
- Returns true if the current token of the ListToken stream is an identifier token: kind is identifier.
- Used by the parser to check if the current token is an identifier: is_identifier, is_eof, and other predicates check the current token without consuming it. Fits into the design as the predicate that checks for identifiers.
- Example: is_identifier(stream) uses current_token to get the current token without advancing.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One token access; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_identifier(stream: ListToken) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    peek_kind(stream) == kinds.identifier
}

