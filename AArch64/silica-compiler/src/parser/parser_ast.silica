// AST node types for the parser - all nodes carry source location for error reporting.
// Uses SourceLocation from lexer_core.

use lexer_core;

// --- Parse error and result ---

// Parse error with location so type checker / compiler can report accurate errors
struct ParseError {
    message: string,
    location: SourceLocation
}

// --- Program and declarations ---

// Declaration: tag 0 = function. For minimal parser only function declarations.
struct Declaration {
    tag: int64,
    name: string,
    return_type_name: string,
    return_type_location: SourceLocation,
    location: SourceLocation
}

// List of top-level declarations (linked list, same shape as ListToken)
struct ListDeclaration {
    is_nil: bool,
    head: Declaration,
    tail: ListDeclaration
}



// --- Type names (keyword or identifier) ---

struct TypeName {
    name: string,
    location: SourceLocation
}

// --- Expressions: kind 0 = LiteralInt, 1 = Identifier, 2 = Paren. inner used when kind = 2. ---

struct Expr {
    kind: int64,
    value: string,
    name: string,
    location: SourceLocation,
    inner: Expr
}

// --- Program (top-level) ---

struct Program {
    declarations: ListDeclaration,
    location: SourceLocation
}

// Shared zero source location for parse results when no error location is needed.
fn zero_location() -> SourceLocation {
    SourceLocation { file: "", line: 0, column: 0, offset: 0 }
}

// Dummy Expr for "no inner" (e.g. when kind is 0 or 1). kind = -1. Self-referential for inner.
fn dummy_expr() -> Expr {
    placeholder: Expr <- Expr { kind: -1, value: "", name: "", location: SourceLocation { file: "", line: 0, column: 0, offset: 0 }, inner: placeholder };
    placeholder
}



fn dummy_declaration() -> Declaration {
    Declaration {
        tag: -1,
        name: "",
        return_type_name: "",
        return_type_location: SourceLocation { file: "", line: 0, column: 0, offset: 0 },
        location: SourceLocation { file: "", line: 0, column: 0, offset: 0 }
    }
}

// Dummy Program for parse result when is_ok is false
fn dummy_program() -> Program {
    decl_placeholder: ListDeclaration <- ListDeclaration { is_nil: true, head: dummy_declaration(), tail: decl_placeholder };
    Program {
        declarations: decl_placeholder,
        location: SourceLocation { file: "", line: 0, column: 0, offset: 0 }
    }
}

// Empty list of declarations (for parse_program accumulator).
fn empty_list_declaration() -> ListDeclaration {
    decl_placeholder: ListDeclaration <- ListDeclaration { is_nil: true, head: dummy_declaration(), tail: decl_placeholder };
    decl_placeholder
}

export zero_location/0;
export dummy_expr/0;
export dummy_program/0;
export dummy_declaration/0;
export empty_list_declaration/0;
