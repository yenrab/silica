// Primitive type names - parse a type keyword or identifier as TypeName.
// Returns (ok, type_name, rest_stream, error_message, error_location).

use lexer_core;
use parser_core;
use parser_ast;

// True if current token is a type keyword or identifier (can start a type name).
fn is_type_name(stream: ListToken) -> bool {
    parser_core@is_identifier(stream) or parser_core@is_int8_keyword(stream) or parser_core@is_int16_keyword(stream) or parser_core@is_int32_keyword(stream) or parser_core@is_int64_keyword(stream) or parser_core@is_float16_keyword(stream) or parser_core@is_float32_keyword(stream) or parser_core@is_float64_keyword(stream) or parser_core@is_bool_keyword(stream) or parser_core@is_char_keyword(stream) or parser_core@is_string_keyword(stream) or parser_core@is_unit_keyword(stream)
}

// Parse type name: one token that is type keyword or identifier -> TypeName.
fn parse_type_name(stream: ListToken) -> (bool, TypeName, ListToken, string, SourceLocation) {
    case is_type_name(stream) of {
        false -> do
            tok: Token <- parser_core@current_token(stream);
            (false, TypeName { name: "", location: tok.location }, stream, "expected type name", tok.location)
        end;
        true -> do
            tok: Token <- parser_core@current_token(stream);
            rest: ListToken <- parser_core@advance_by_one(stream);
            tn: TypeName <- TypeName { name: tok.lexeme, location: tok.location };
            (true, tn, rest, "", parser_ast@zero_location())
        end
    }
}

export parse_type_name/1;
export is_type_name/1;
