// Capability: int64 operators and print_int64
// Arithmetic: +, -, *, /, %
// Comparison: <, >, <=, >=, ==, !=
// Function call: print_int64(expr)

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes (12-16, fn_decl uses 1-8, expr_literal uses 9-11)
fn role_operand() -> int64 { 12 }
fn role_op() -> int64 { 13 }
fn role_call_name() -> int64 { 14 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> ListInt {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn operand_next() -> ListInt {
    three_roles(role_op(), role_right_brace(), role_call_rparen())
}

fn operand_prev() -> ListInt {
    three_roles(role_left_brace(), role_op(), role_call_lparen())
}

fn constraints() -> ListConstraint {
    // left_brace can be followed by operand or call_name (extends fn_decl)
    c1: Constraint <- Constraint { trigger_role: role_left_brace(), next_token_roles: two_roles(role_operand(), role_call_name()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 20 };
    // right_brace can be preceded by operand or call_rparen (extends fn_decl)
    c2: Constraint <- Constraint { trigger_role: role_right_brace(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: two_roles(role_operand(), role_call_rparen()), constraint_id: 21 };
    // operand: in binary expr or call arg
    c3: Constraint <- Constraint { trigger_role: role_operand(), next_token_roles: operand_next(), prev_token_roles: operand_prev(), constraint_id: 22 };
    // op: between two operands
    c4: Constraint <- Constraint { trigger_role: role_op(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_operand()), constraint_id: 23 };
    // call_name: identifier in body, followed by left_paren
    c5: Constraint <- Constraint { trigger_role: role_call_name(), next_token_roles: single_role(role_call_lparen()), prev_token_roles: single_role(role_left_brace()), constraint_id: 24 };
    // call_lparen: after call_name, before operand
    c6: Constraint <- Constraint { trigger_role: role_call_lparen(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_call_name()), constraint_id: 25 };
    // call_rparen: after operand, before right_brace
    c7: Constraint <- Constraint { trigger_role: role_call_rparen(), next_token_roles: single_role(role_right_brace()), prev_token_roles: single_role(role_operand()), constraint_id: 26 };
    constraint_core@cons_constraint(c1, constraint_core@cons_constraint(c2, constraint_core@cons_constraint(c3, constraint_core@cons_constraint(c4, constraint_core@cons_constraint(c5, constraint_core@cons_constraint(c6, constraint_core@cons_constraint(c7, constraint_core@empty_list_constraint())))))))
}

fn is_arithmetic_op(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.plus or token_kind == kinds.minus or token_kind == kinds.star or token_kind == kinds.slash or token_kind == kinds.percent
}

fn is_comparison_op(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.less_than or token_kind == kinds.greater_than or token_kind == kinds.less_equal or token_kind == kinds.greater_equal or token_kind == kinds.equal_equal or token_kind == kinds.bang_equal
}

fn is_op_token(kinds: TokenKinds, token_kind: int64) -> bool {
    is_arithmetic_op(kinds, token_kind) or is_comparison_op(kinds, token_kind)
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.integer_literal of {
        true -> single_role(role_operand());
        false -> case token_kind == kinds.identifier of {
            true -> two_roles(role_call_name(), role_operand());
            false -> case is_op_token(kinds, token_kind) of {
                true -> single_role(role_op());
                false -> case token_kind == kinds.left_paren of {
                    true -> single_role(role_call_lparen());
                    false -> case token_kind == kinds.right_paren of {
                        true -> single_role(role_call_rparen());
                        false -> constraint_core@empty_list_int()
                    }
                }
            }
        }
    }
}
