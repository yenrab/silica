// Capability: effect name = [effect_list]
// Supports simple and parameterized effects in declarations.

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes for effect declarations
fn role_effect_decl_keyword() -> int64 { 30 }
fn role_effect_decl_name() -> int64 { 31 }
fn role_effect_decl_equal() -> int64 { 32 }
fn role_effect_decl_lbracket() -> int64 { 33 }
fn role_effect_item_name() -> int64 { 34 }
fn role_effect_item_comma() -> int64 { 35 }
fn role_effect_decl_rbracket() -> int64 { 36 }
fn role_effect_item_lparen() -> int64 { 37 }
fn role_effect_item_param_name() -> int64 { 38 }
fn role_effect_item_rparen() -> int64 { 39 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> ListInt {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> ListInt {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn constraints() -> ListConstraint {
    c1: Constraint <- Constraint { trigger_role: role_effect_decl_keyword(), next_token_roles: single_role(role_effect_decl_name()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 30 };
    c2: Constraint <- Constraint { trigger_role: role_effect_decl_name(), next_token_roles: single_role(role_effect_decl_equal()), prev_token_roles: single_role(role_effect_decl_keyword()), constraint_id: 31 };
    c3: Constraint <- Constraint { trigger_role: role_effect_decl_equal(), next_token_roles: single_role(role_effect_decl_lbracket()), prev_token_roles: single_role(role_effect_decl_name()), constraint_id: 32 };
    c4: Constraint <- Constraint { trigger_role: role_effect_decl_lbracket(), next_token_roles: single_role(role_effect_item_name()), prev_token_roles: single_role(role_effect_decl_equal()), constraint_id: 33 };
    c5: Constraint <- Constraint { trigger_role: role_effect_item_name(), next_token_roles: three_roles(role_effect_item_comma(), role_effect_decl_rbracket(), role_effect_item_lparen()), prev_token_roles: two_roles(role_effect_decl_lbracket(), role_effect_item_comma()), constraint_id: 34 };
    c6: Constraint <- Constraint { trigger_role: role_effect_item_comma(), next_token_roles: single_role(role_effect_item_name()), prev_token_roles: two_roles(role_effect_item_name(), role_effect_item_rparen()), constraint_id: 35 };
    c7: Constraint <- Constraint { trigger_role: role_effect_decl_rbracket(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: two_roles(role_effect_item_name(), role_effect_item_rparen()), constraint_id: 36 };
    c8: Constraint <- Constraint { trigger_role: role_effect_item_lparen(), next_token_roles: single_role(role_effect_item_param_name()), prev_token_roles: single_role(role_effect_item_name()), constraint_id: 37 };
    c9: Constraint <- Constraint { trigger_role: role_effect_item_param_name(), next_token_roles: single_role(role_effect_item_rparen()), prev_token_roles: single_role(role_effect_item_lparen()), constraint_id: 38 };
    c10: Constraint <- Constraint { trigger_role: role_effect_item_rparen(), next_token_roles: two_roles(role_effect_item_comma(), role_effect_decl_rbracket()), prev_token_roles: single_role(role_effect_item_param_name()), constraint_id: 39 };
    constraint_core@cons_constraint(c1, constraint_core@cons_constraint(c2, constraint_core@cons_constraint(c3, constraint_core@cons_constraint(c4, constraint_core@cons_constraint(c5, constraint_core@cons_constraint(c6, constraint_core@cons_constraint(c7, constraint_core@cons_constraint(c8, constraint_core@cons_constraint(c9, constraint_core@cons_constraint(c10, constraint_core@empty_list_constraint()))))))))))
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.identifier of {
        true -> four_roles(role_effect_decl_keyword(), role_effect_decl_name(), role_effect_item_name(), role_effect_item_param_name());
        false -> case token_kind == kinds.equal of {
            true -> single_role(role_effect_decl_equal());
            false -> case token_kind == kinds.left_bracket of {
                true -> single_role(role_effect_decl_lbracket());
                false -> case token_kind == kinds.right_bracket of {
                    true -> single_role(role_effect_decl_rbracket());
                    false -> case token_kind == kinds.comma of {
                        true -> single_role(role_effect_item_comma());
                        false -> case token_kind == kinds.left_paren of {
                            true -> single_role(role_effect_item_lparen());
                            false -> case token_kind == kinds.right_paren of {
                                true -> single_role(role_effect_item_rparen());
                                false -> constraint_core@empty_list_int()
                            }
                        }
                    }
                }
            }
        }
    }
}
