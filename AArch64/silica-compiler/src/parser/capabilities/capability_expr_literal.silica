// Capability: integer literal, identifier as expression
// Minimal: fn main(){ 42 } - body is integer literal or identifier

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes: 9 body_expr (shared), 10 integer_literal, 11 identifier
fn role_body_expr() -> int64 { 9 }
fn role_integer_literal() -> int64 { 10 }
fn role_identifier() -> int64 { 11 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn constraints() -> ListConstraint {
    // integer_literal (as body_expr) -> next must be right_brace
    // identifier (as body_expr) -> next must be right_brace
    c1: Constraint <- Constraint { trigger_role: role_integer_literal(), next_token_roles: single_role(8), constraint_id: 10 };
    c2: Constraint <- Constraint { trigger_role: role_identifier(), next_token_roles: single_role(8), constraint_id: 11 };
    constraint_core@cons_constraint(c1, constraint_core@cons_constraint(c2, constraint_core@empty_list_constraint()))
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.integer_literal of {
        true -> two_roles(role_integer_literal(), role_body_expr());
        false -> case token_kind == kinds.identifier of {
            true -> single_role(role_body_expr());
            false -> constraint_core@empty_list_int()
        }
    }
}
