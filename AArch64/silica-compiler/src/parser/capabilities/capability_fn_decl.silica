// Capability: fn name ( ) -> type { body }
// Function declaration with empty params, return type, braces

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes for fn_decl (parser design §6)
// 1 fn_keyword, 2 fn_name, 3 left_paren, 4 right_paren, 5 right_arrow
// 6 type_name, 7 left_brace, 8 right_brace, 9 body_expr (shared with expr_literal)
// 17 proc_keyword, 18 left_bracket, 19 effect_name, 20 right_bracket, 21 effect_comma
// 22 effect_param_lparen, 23 effect_param_rparen, 24 effect_param_name

fn role_fn_keyword() -> int64 { 1 }
fn role_fn_name() -> int64 { 2 }
fn role_left_paren() -> int64 { 3 }
fn role_right_paren() -> int64 { 4 }
fn role_right_arrow() -> int64 { 5 }
fn role_type_name() -> int64 { 6 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_body_expr() -> int64 { 9 }
fn role_proc_keyword() -> int64 { 17 }
fn role_left_bracket() -> int64 { 18 }
fn role_effect_name() -> int64 { 19 }
fn role_right_bracket() -> int64 { 20 }
fn role_effect_comma() -> int64 { 21 }
fn role_effect_param_lparen() -> int64 { 22 }
fn role_effect_param_rparen() -> int64 { 23 }
fn role_effect_param_name() -> int64 { 24 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> ListInt {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> ListInt {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn no_prev() -> ListInt {
    constraint_core@empty_list_int()
}

fn constraints() -> ListConstraint {
    c1: Constraint <- Constraint { trigger_role: role_fn_keyword(), next_token_roles: single_role(role_fn_name()), prev_token_roles: no_prev(), constraint_id: 1 };
    c2: Constraint <- Constraint { trigger_role: role_fn_name(), next_token_roles: single_role(role_left_paren()), prev_token_roles: single_role(role_fn_keyword()), constraint_id: 2 };
    c3: Constraint <- Constraint { trigger_role: role_left_paren(), next_token_roles: single_role(role_right_paren()), prev_token_roles: single_role(role_fn_name()), constraint_id: 3 };
    c4: Constraint <- Constraint { trigger_role: role_right_paren(), next_token_roles: single_role(role_right_arrow()), prev_token_roles: single_role(role_left_paren()), constraint_id: 4 };
    c5: Constraint <- Constraint { trigger_role: role_right_arrow(), next_token_roles: single_role(role_type_name()), prev_token_roles: single_role(role_right_paren()), constraint_id: 5 };
    c6: Constraint <- Constraint { trigger_role: role_type_name(), next_token_roles: two_roles(role_left_brace(), role_proc_keyword()), prev_token_roles: single_role(role_right_arrow()), constraint_id: 6 };
    c7: Constraint <- Constraint { trigger_role: role_left_brace(), next_token_roles: two_roles(role_body_expr(), role_right_brace()), prev_token_roles: two_roles(role_type_name(), role_right_bracket()), constraint_id: 7 };
    c8: Constraint <- Constraint { trigger_role: role_body_expr(), next_token_roles: single_role(role_right_brace()), prev_token_roles: single_role(role_left_brace()), constraint_id: 8 };
    c9: Constraint <- Constraint { trigger_role: role_right_brace(), next_token_roles: no_prev(), prev_token_roles: two_roles(role_body_expr(), role_left_brace()), constraint_id: 9 };
    c10: Constraint <- Constraint { trigger_role: role_proc_keyword(), next_token_roles: single_role(role_left_bracket()), prev_token_roles: single_role(role_type_name()), constraint_id: 17 };
    c11: Constraint <- Constraint { trigger_role: role_left_bracket(), next_token_roles: single_role(role_effect_name()), prev_token_roles: single_role(role_proc_keyword()), constraint_id: 18 };
    c12: Constraint <- Constraint { trigger_role: role_effect_name(), next_token_roles: three_roles(role_right_bracket(), role_effect_comma(), role_effect_param_lparen()), prev_token_roles: two_roles(role_left_bracket(), role_effect_comma()), constraint_id: 19 };
    c13: Constraint <- Constraint { trigger_role: role_right_bracket(), next_token_roles: single_role(role_left_brace()), prev_token_roles: two_roles(role_effect_name(), role_effect_param_rparen()), constraint_id: 20 };
    c14: Constraint <- Constraint { trigger_role: role_effect_comma(), next_token_roles: single_role(role_effect_name()), prev_token_roles: two_roles(role_effect_name(), role_effect_param_rparen()), constraint_id: 21 };
    c15: Constraint <- Constraint { trigger_role: role_effect_param_lparen(), next_token_roles: single_role(role_effect_param_name()), prev_token_roles: single_role(role_effect_name()), constraint_id: 22 };
    c16: Constraint <- Constraint { trigger_role: role_effect_param_name(), next_token_roles: single_role(role_effect_param_rparen()), prev_token_roles: single_role(role_effect_param_lparen()), constraint_id: 23 };
    c17: Constraint <- Constraint { trigger_role: role_effect_param_rparen(), next_token_roles: two_roles(role_right_bracket(), role_effect_comma()), prev_token_roles: single_role(role_effect_param_name()), constraint_id: 24 };
    constraint_core@cons_constraint(c1, constraint_core@cons_constraint(c2, constraint_core@cons_constraint(c3, constraint_core@cons_constraint(c4, constraint_core@cons_constraint(c5, constraint_core@cons_constraint(c6, constraint_core@cons_constraint(c7, constraint_core@cons_constraint(c8, constraint_core@cons_constraint(c9, constraint_core@cons_constraint(c10, constraint_core@cons_constraint(c11, constraint_core@cons_constraint(c12, constraint_core@cons_constraint(c13, constraint_core@cons_constraint(c14, constraint_core@cons_constraint(c15, constraint_core@cons_constraint(c16, constraint_core@cons_constraint(c17, constraint_core@empty_list_constraint())))))))))))))))))
}

fn is_type_keyword(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.int8_keyword or token_kind == kinds.int16_keyword or token_kind == kinds.int32_keyword or token_kind == kinds.int64_keyword or token_kind == kinds.uint8_keyword or token_kind == kinds.uint16_keyword or token_kind == kinds.uint32_keyword or token_kind == kinds.uint64_keyword or token_kind == kinds.float16_keyword or token_kind == kinds.float32_keyword or token_kind == kinds.float64_keyword or token_kind == kinds.bool_keyword or token_kind == kinds.char_keyword or token_kind == kinds.string_keyword or token_kind == kinds.unit_keyword or token_kind == kinds.atom_keyword
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.fn_keyword of {
        true -> single_role(role_fn_keyword());
        false -> case token_kind == kinds.identifier of {
            true -> four_roles(role_fn_name(), role_type_name(), role_effect_name(), role_effect_param_name());
            false -> case is_type_keyword(kinds, token_kind) of {
                true -> single_role(role_type_name());
                false -> case token_kind == kinds.left_paren of {
                    true -> two_roles(role_left_paren(), role_effect_param_lparen());
                    false -> case token_kind == kinds.right_paren of {
                        true -> two_roles(role_right_paren(), role_effect_param_rparen());
                        false -> case token_kind == kinds.right_arrow of {
                            true -> single_role(role_right_arrow());
                            false -> case token_kind == kinds.proc_keyword of {
                                true -> single_role(role_proc_keyword());
                                false -> case token_kind == kinds.left_bracket of {
                                    true -> single_role(role_left_bracket());
                                    false -> case token_kind == kinds.right_bracket of {
                                        true -> single_role(role_right_bracket());
                                        false -> case token_kind == kinds.comma of {
                                            true -> single_role(role_effect_comma());
                                            false -> case token_kind == kinds.left_brace of {
                                                true -> single_role(role_left_brace());
                                                false -> case token_kind == kinds.right_brace of {
                                                    true -> single_role(role_right_brace());
                                                    false -> constraint_core@empty_list_int()
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
