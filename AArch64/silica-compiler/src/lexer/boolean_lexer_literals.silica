// Boolean literal recognition for Silica lexer
// Recognizes true and false as boolean literals per language specification Section 2.2
// Supports expressions like: x == y, x != y, print_bool(b), case b of { true -> ...; false -> ... }

use lexer_token_kind;

export is_boolean_literal/1;
export boolean_literal_token_kind/1;


{-
- Returns true if the string is a boolean literal ("true" or "false"), and false otherwise.
- Used after reading an identifier so the lexer can decide whether to emit a boolean literal token or delegate to keyword/identifier handling. Per spec Section 2.2: boolean_literal ::= "true" | "false".
- Example: is_boolean_literal("true") returns true.
- Example: is_boolean_literal("false") returns true.
- Example: is_boolean_literal("foo") and is_boolean_literal("bool") return false.
-}
fn is_boolean_literal(s: string) -> bool {
    case s of {
        "true" -> true;
        "false" -> true;
        _: string -> false
    }
}


{-
- Returns the token kind code for the given boolean literal string.
- Used when is_boolean_literal(lexeme) is true; returns kinds.true_literal or kinds.false_literal.
- Caller must ensure s is "true" or "false"; otherwise behavior is unspecified.
-}
fn boolean_literal_token_kind(s: string) -> int64 {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case s of {
        "true" -> kinds.true_literal;
        "false" -> kinds.false_literal;
        _: string -> kinds.identifier
    }
}
