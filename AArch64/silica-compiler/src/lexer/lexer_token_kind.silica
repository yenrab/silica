

// Export token_kinds function
export token_kinds/0;

// TokenKind type aliases - all token kinds are represented as int64 values
// Each token kind has a unique integer code

// Type alias for token kind
type TokenKind = int64;


{-
- Holds the unique integer codes for every token kind the lexer can produce: identifier, type keywords, fn_keyword, integer_literal, right_arrow, grouping (left/right paren and brace), and eof.
- Used by lexer modules that build tokens: call token_kinds() to get a TokenKinds instance, then use e.g. kinds.identifier or kinds.integer_literal as the kind argument to make_token. Centralizes all kind codes so the lexer and parser share the same numbering. Fits into the design as the single record of token kind constants.
- Example: make_token(kinds.identifier, "foo", loc) uses kinds.identifier as the token kind for identifiers.
- Example: make_token(kinds.integer_literal, "42", loc) uses kinds.integer_literal for number tokens.
- Example: make_token(kinds.eof, "", loc) uses kinds.eof for the end-of-file sentinel token.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
struct TokenKinds {
    identifier: int64,
    int8_keyword: int64,
    int16_keyword: int64,
    int32_keyword: int64,
    int64_keyword: int64,
    uint8_keyword: int64,
    uint16_keyword: int64,
    uint32_keyword: int64,
    uint64_keyword: int64,
    float16_keyword: int64,
    float32_keyword: int64,
    float64_keyword: int64,
    bool_keyword: int64,
    char_keyword: int64,
    string_keyword: int64,
    unit_keyword: int64,
    atom_keyword: int64,
    fn_keyword: int64,
    proc_keyword: int64,
    effect_keyword: int64,
    integer_literal: int64,
    float_literal: int64,
    atom_literal: int64,
    right_arrow: int64,
    left_paren: int64,
    right_paren: int64,
    left_brace: int64,
    right_brace: int64,
    left_bracket: int64,
    right_bracket: int64,
    comma: int64,
    plus: int64,
    minus: int64,
    star: int64,
    slash: int64,
    percent: int64,
    less_than: int64,
    greater_than: int64,
    less_equal: int64,
    greater_equal: int64,
    equal_equal: int64,
    bang_equal: int64,
    equal: int64,
    left_arrow: int64,
    colon: int64,
    unknown_char: int64,
    eof: int64,
    true_literal: int64,
    false_literal: int64
}


{-
- Returns a TokenKinds instance with every token kind field set to its unique integer code (e.g. identifier 1, type keywords 10–20, fn_keyword 21, integer_literal 30, arrow and grouping 40–44, operators 45–57, eof 60).
- Used by the lexer (and parser) whenever a token is built: call token_kinds() once per token or once per scope, then use kinds.identifier, kinds.eof, etc. as the kind for make_token. Single source of truth for kind codes so all modules stay in sync. Fits into the design as the factory for TokenKinds.
- Example: kinds: TokenKinds <- token_kinds(); make_token(kinds.identifier, lexeme, loc) — builds an identifier token using the standard code.
- Example: token_kinds().integer_literal is 30; use it when emitting an integer literal token.
- Example: token_kinds().eof is 60; use it for the end-of-file token at the end of the token list.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single struct construction with literal fields; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn token_kinds() -> TokenKinds {
    TokenKinds {
        identifier: 1,
        int8_keyword: 10,
        int16_keyword: 11,
        int32_keyword: 12,
        int64_keyword: 13,
        uint8_keyword: 67,
        uint16_keyword: 68,
        uint32_keyword: 69,
        uint64_keyword: 70,
        float16_keyword: 14,
        float32_keyword: 15,
        float64_keyword: 16,
        bool_keyword: 17,
        char_keyword: 18,
        string_keyword: 19,
        unit_keyword: 20,
        atom_keyword: 24,
        fn_keyword: 21,
        proc_keyword: 22,
        effect_keyword: 23,
        integer_literal: 30,
        float_literal: 71,
        atom_literal: 31,
        right_arrow: 40,
        left_paren: 41,
        right_paren: 42,
        left_brace: 43,
        right_brace: 44,
        left_bracket: 61,
        right_bracket: 62,
        comma: 63,
        plus: 45,
        minus: 46,
        star: 47,
        slash: 48,
        percent: 49,
        less_than: 51,
        greater_than: 52,
        less_equal: 53,
        greater_equal: 54,
        equal_equal: 55,
        bang_equal: 56,
        equal: 57,
        left_arrow: 58,
        colon: 64,
        unknown_char: 59,
        eof: 60,
        true_literal: 65,
        false_literal: 66
    }
}
