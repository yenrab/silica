// TokenKind type aliases - all token kinds are represented as int64 values
// Each token kind has a unique integer code

// Type alias for token kind
type TokenKind = int64;

// Struct containing all token kind values
struct TokenKinds {
    identifier: int64,
    int8_keyword: int64,
    int16_keyword: int64,
    int32_keyword: int64,
    int64_keyword: int64,
    float16_keyword: int64,
    float32_keyword: int64,
    float64_keyword: int64,
    bool_keyword: int64,
    char_keyword: int64,
    string_keyword: int64,
    unit_keyword: int64,
    fn_keyword: int64,
    integer_literal: int64,
    right_arrow: int64,
    left_paren: int64,
    right_paren: int64,
    left_brace: int64,
    right_brace: int64,
    eof: int64
}

// Export token_kinds function
export token_kinds/0;

// Function that returns the TokenKinds struct with all values initialized
fn token_kinds() -> TokenKinds {
    TokenKinds {
        identifier: 1,
        int8_keyword: 10,
        int16_keyword: 11,
        int32_keyword: 12,
        int64_keyword: 13,
        float16_keyword: 14,
        float32_keyword: 15,
        float64_keyword: 16,
        bool_keyword: 17,
        char_keyword: 18,
        string_keyword: 19,
        unit_keyword: 20,
        fn_keyword: 21,
        integer_literal: 30,
        right_arrow: 40,
        left_paren: 41,
        right_paren: 42,
        left_brace: 43,
        right_brace: 44,
        eof: 50
    }
}
