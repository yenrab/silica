// Operator recognition for Silica lexer
// Recognizes minimal operators: ->, (, ), {, }

// Import token kind enum
use lexer_token_kind;

// Import lexer core types
use lexer_core;

// Check if a character is an operator character
fn is_operator_char(c: char) -> bool {
    case c of {
        '-' -> true;
        '>' -> true;
        '(' -> true;
        ')' -> true;
        '{' -> true;
        '}' -> true;
        _: char -> false
    }
}

// Check if a character is a grouping operator
fn is_grouping_char(c: char) -> bool {
    case c of {
        '(' -> true;
        ')' -> true;
        '{' -> true;
        '}' -> true;
        _: char -> false
    }
}

// Read the arrow operator (->)
// Reads '-' followed by '>' and returns token with lexeme "->" and updated lexer
fn read_arrow(lexer: Lexer) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    
    // Read '-' character
    first: string <- lexer_core@peek_char(lexer);
    case first of {
        "-" -> do
            after_minus: Lexer <- lexer_core@advance(lexer);
            // Read '>' character
            second: string <- lexer_core@peek_char(after_minus);
            case second of {
                ">" -> do
                    after_arrow: Lexer <- lexer_core@advance(after_minus);
                    lexer_core@make_token(kinds.right_arrow, "->", start_location), after_arrow
                end;
                _: string -> lexer_core@make_token(kinds.eof, "", start_location), lexer
            end
        end;
        _: string -> lexer_core@make_token(lexer_core@EOF, "", start_location), lexer
    }
}

// Read a single character grouping operator
// Returns token with lexeme and updated lexer
fn read_grouping_operator(lexer: Lexer, c: string) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    updated_lexer: Lexer <- lexer_core@advance(lexer);
    
    case c of {
        "(" -> lexer_core@make_token(kinds.left_paren, "(", start_location), updated_lexer;
        ")" -> lexer_core@make_token(kinds.right_paren, ")", start_location), updated_lexer;
        "{" -> lexer_core@make_token(kinds.left_brace, "{", start_location), updated_lexer;
        "}" -> lexer_core@make_token(kinds.right_brace, "}", start_location), updated_lexer;
        _: string -> lexer_core@make_token(kinds.eof, "", start_location), lexer
    }
}
