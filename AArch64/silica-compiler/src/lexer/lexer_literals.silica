// Integer literal parsing for Silica lexer
// Supports decimal, hexadecimal (0x...), and binary (0b...) integer literals

// Import token kind enum
use lexer_token_kind;

// Import lexer core types
use lexer_core;

// Export helper functions
export is_decimal_digit_char/1;

// Check if a character is a decimal digit
fn is_decimal_digit(c: char) -> bool {
    case c of {
        '0' -> true;
        '1' -> true;
        '2' -> true;
        '3' -> true;
        '4' -> true;
        '5' -> true;
        '6' -> true;
        '7' -> true;
        '8' -> true;
        '9' -> true;
        _: char -> false
    }
}

// Check if a character is a hexadecimal digit
fn is_hex_digit(c: char) -> bool {
    case c of {
        '0' -> true;
        '1' -> true;
        '2' -> true;
        '3' -> true;
        '4' -> true;
        '5' -> true;
        '6' -> true;
        '7' -> true;
        '8' -> true;
        '9' -> true;
        'a' -> true;
        'b' -> true;
        'c' -> true;
        'd' -> true;
        'e' -> true;
        'f' -> true;
        'A' -> true;
        'B' -> true;
        'C' -> true;
        'D' -> true;
        'E' -> true;
        'F' -> true;
        _: char -> false
    }
}

// Check if a character is a binary digit
fn is_binary_digit(c: char) -> bool {
    case c of {
        '0' -> true;
        '1' -> true;
        _: char -> false
    }
}

// Read an integer literal from source
// Handles decimal, hex (0x...), and binary (0b...) formats
// Returns token with lexeme string and updated lexer (does not parse the value)
fn read_integer_literal(lexer: Lexer) -> (Token, Lexer) {
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    start_pos: int64 <- lexer.position;
    
    // Check if starts with '0x' for hex or '0b' for binary
    first_char: string <- lexer_core@peek_char(lexer);
    second_char: string <- lexer_core@peek_next_char(lexer);
    
    case first_char of {
        "0" -> case second_char of {
            "x" -> read_hex_literal(lexer, start_location);
            "b" -> read_binary_literal(lexer, start_location);
            _: string -> read_decimal_digits(lexer, start_location, "")
        };
        _: string -> read_decimal_digits(lexer, start_location, "")
    }
}

// Read hex literal
fn read_hex_literal(lexer: Lexer, start_location: SourceLocation) -> (Token, Lexer) {
    // Advance past '0'
    after_zero: Lexer <- lexer_core@advance(lexer);
    // Advance past 'x'
    after_x: Lexer <- lexer_core@advance(after_zero);
    updated_lexeme: string <- "0x";
    
    // Recursively read hex digits
    read_hex_digits(after_x, start_location, updated_lexeme)
}

// Read hex digits recursively
fn read_hex_digits(lexer: Lexer, start_location: SourceLocation, lexeme: string) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    next: string <- lexer_core@peek_char(lexer);
    case next of {
        "" -> (lexer_core@make_token(kinds.integer_literal, lexeme, start_location), lexer);
        _: string -> case is_hex_digit_char(next) of {
            true -> do
                updated_lexer: Lexer <- lexer_core@advance(lexer);
                updated_lexeme: string <- concat(lexeme, next);
                read_hex_digits(updated_lexer, start_location, updated_lexeme)
            end;
            false -> (lexer_core@make_token(kinds.integer_literal, lexeme, start_location), lexer)
        }
    }
}

// Read binary literal
fn read_binary_literal(lexer: Lexer, start_location: SourceLocation) -> (Token, Lexer) {
    // Advance past '0'
    after_zero: Lexer <- lexer_core@advance(lexer);
    // Advance past 'b'
    after_b: Lexer <- lexer_core@advance(after_zero);
    updated_lexeme: string <- "0b";
    
    // Recursively read binary digits
    read_binary_digits(after_b, start_location, updated_lexeme)
}

// Read binary digits recursively
fn read_binary_digits(lexer: Lexer, start_location: SourceLocation, lexeme: string) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    next: string <- lexer_core@peek_char(lexer);
    case next of {
        "" -> (lexer_core@make_token(kinds.integer_literal, lexeme, start_location), lexer);
        _: string -> case is_binary_digit_char(next) of {
            true -> do
                updated_lexer: Lexer <- lexer_core@advance(lexer);
                updated_lexeme: string <- concat(lexeme, next);
                read_binary_digits(updated_lexer, start_location, updated_lexeme)
            end;
            false -> (lexer_core@make_token(kinds.integer_literal, lexeme, start_location), lexer)
        }
    }
}

// Read decimal digits recursively
fn read_decimal_digits(lexer: Lexer, start_location: SourceLocation, lexeme: string) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    next: string <- lexer_core@peek_char(lexer);
    case next of {
        "" -> (lexer_core@make_token(kinds.integer_literal, lexeme, start_location), lexer);
        _: string -> case is_decimal_digit_char(next) of {
            true -> do
                updated_lexer: Lexer <- lexer_core@advance(lexer);
                updated_lexeme: string <- case lexeme of {
                    "" -> next;
                    _: string -> concat(lexeme, next)
                };
                read_decimal_digits(updated_lexer, start_location, updated_lexeme)
            end;
            false -> case lexeme of {
                "" -> lexer_core@make_token(kinds.integer_literal, "0", start_location), lexer;
                _: string -> (lexer_core@make_token(kinds.integer_literal, lexeme, start_location), lexer)
            }
        }
    }
}

// Helper function to check if single-character string is decimal digit
fn is_decimal_digit_char(s: string) -> bool {
    case s of {
        "0" -> true;
        "1" -> true;
        "2" -> true;
        "3" -> true;
        "4" -> true;
        "5" -> true;
        "6" -> true;
        "7" -> true;
        "8" -> true;
        "9" -> true;
        _: string -> false
    }
}

// Helper function to check if single-character string is hex digit
fn is_hex_digit_char(s: string) -> bool {
    case s of {
        "0" -> true;
        "1" -> true;
        "2" -> true;
        "3" -> true;
        "4" -> true;
        "5" -> true;
        "6" -> true;
        "7" -> true;
        "8" -> true;
        "9" -> true;
        "a" -> true;
        "b" -> true;
        "c" -> true;
        "d" -> true;
        "e" -> true;
        "f" -> true;
        "A" -> true;
        "B" -> true;
        "C" -> true;
        "D" -> true;
        "E" -> true;
        "F" -> true;
        _: string -> false
    }
}

// Helper function to check if single-character string is binary digit
fn is_binary_digit_char(s: string) -> bool {
    case s of {
        "0" -> true;
        "1" -> true;
        _: string -> false
    }
}
