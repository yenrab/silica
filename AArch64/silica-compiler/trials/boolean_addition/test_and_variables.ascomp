.text
.global main

    ; effects [device_io]
main:     STP X29, X30, [SP, #-16]!

    MOV X1, #1
    MOV X1, #0
    MOV X2, X1
    MOV X1, X1
    AND X1, X1, X2
    CMP X1, #0
    CSET X1, NE

    MOV X0, X1

    ; effects [device_io]
    CMP X0, #0
    B.eq L_pb_false_branch
    MOV X0, #1
    ADRP X1, L_pb_true@PAGE
    ADD X1, X1, L_pb_true@PAGEOFF
    MOV X2, #4
    MOV X16, #4
    SVC #0
    MOV X0, #0
    B L_pb_after
L_pb_false_branch:
    MOV X0, #1
    ADRP X1, L_pb_false@PAGE
    ADD X1, X1, L_pb_false@PAGEOFF
    MOV X2, #5
    MOV X16, #4
    SVC #0
    MOV X0, #0
L_pb_after:



    LDP X29, X30, [SP], #16
    RET

.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0
