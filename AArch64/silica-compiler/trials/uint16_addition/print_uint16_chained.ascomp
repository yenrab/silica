.text
.global main

    ; effects [device_io]
main:     STP X29, X30, [SP, #-16]!


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi16_0@PAGE
    ADD X1, X1, L_pi16_0@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0
    MOV X0, #0




    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi16_1@PAGE
    ADD X1, X1, L_pi16_1@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0
    MOV X0, #0



    LDP X29, X30, [SP], #16
    RET

.section __TEXT,__rodata
.align	8
L_pi16_0:
    .byte  0x31, 0
L_pi16_1:
    .byte  0x32, 0
