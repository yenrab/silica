.text
.global main

    ; effects [device_io]
main:     STP X29, X30, [SP, #-16]!

    MOV W0, #10
    MOV W1, #20
    MOV W2, W1
    MOV W1, W0
    ADD W0, W1, W2

    ; effects [device_io]
    UXTH X0, W0
    BL L_pu_helper
    MOV X0, #0



    LDP X29, X30, [SP], #16
    RET
L_pu_helper:
    SUB SP, SP, #32
    MOV X10, SP
    ADD X10, X10, #24
    MOV X8, X10
    CMP X0, #0
    B.eq L_pu_zero
    MOV X9, #10
L_pu_loop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pu_loop
    B L_pu_do_write
L_pu_zero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pu_do_write:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    MOV X16, #4
    SVC #0
    ADD SP, SP, #32
    RET


