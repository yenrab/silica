{
  "@context": {
    "@vocab": "https://aalang.dev/silica-dev/error-code/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "spec": "https://aalang.dev/silica-dev/specification/"
  },
  "@graph": [
    {
      "@id": "error-code-allocation",
      "@type": "ErrorCodeAllocation",
      "name": "Silica Compiler Error Code Allocation",
      "description": "Per silica-error-code-scheme.jsonld and silica-specification.md §1.6",
      "phaseAllocations": [
        {
          "phase": "Lexer",
          "range": "E0001-E0999",
          "category": "LexicalErrors",
          "specificationSection": "spec:§2"
        },
        {
          "phase": "Parser",
          "range": "E1000-E1999",
          "category": "ParseErrors",
          "specificationSection": "spec:§3"
        },
        {
          "phase": "Type checker",
          "range": "E2000-E2999",
          "category": "TypeErrors",
          "specificationSection": "spec:§6"
        },
        {
          "phase": "Effect checker",
          "range": "E3000-E3999",
          "category": "EffectErrors",
          "specificationSection": "spec:§8"
        },
        {
          "phase": "SIR generator",
          "range": "E4000-E4049",
          "category": "CodegenErrors (SIR)",
          "specificationSection": null
        },
        {
          "phase": "Emitter",
          "range": "E4050-E4099",
          "category": "CodegenErrors (emit)",
          "specificationSection": null
        },
        {
          "phase": "Module",
          "range": "E5000-E5999",
          "category": "ModuleErrors",
          "specificationSection": "spec:§11"
        },
        {
          "phase": "Internal",
          "range": "E9000-E9999",
          "category": "InternalErrors",
          "specificationSection": null
        }
      ]
    },
    {
      "@id": "E0000",
      "@type": "LexerError",
      "errorCode": "E0000",
      "name": "LexerErrorDefault"
    },
    {
      "@id": "E0001",
      "@type": "LexerError",
      "errorCode": "E0001",
      "name": "UnexpectedCharacter"
    },
    {
      "@id": "E0002",
      "@type": "LexerError",
      "errorCode": "E0002",
      "name": "InvalidEscapeSequence"
    },
    {
      "@id": "E0003",
      "@type": "LexerError",
      "errorCode": "E0003",
      "name": "UnterminatedStringLiteral"
    },
    {
      "@id": "E0004",
      "@type": "LexerError",
      "errorCode": "E0004",
      "name": "UnterminatedCharacterLiteral"
    },
    {
      "@id": "E0005",
      "@type": "LexerError",
      "errorCode": "E0005",
      "name": "InvalidIntegerLiteral"
    },
    {
      "@id": "E0006",
      "@type": "LexerError",
      "errorCode": "E0006",
      "name": "UnterminatedBlockComment"
    },
    {
      "@id": "E1000",
      "@type": "ParseError",
      "errorCode": "E1000",
      "name": "ParseErrorDefault"
    },
    {
      "@id": "E1001",
      "@type": "ParseError",
      "errorCode": "E1001",
      "name": "ExpectedToken"
    },
    {
      "@id": "E1002",
      "@type": "ParseError",
      "errorCode": "E1002",
      "name": "NestedFunctionDeclaration"
    },
    {
      "@id": "E1003",
      "@type": "ParseError",
      "errorCode": "E1003",
      "name": "ExpectedIdentifier"
    },
    {
      "@id": "E1004",
      "@type": "ParseError",
      "errorCode": "E1004",
      "name": "ExpectedType"
    },
    {
      "@id": "E1005",
      "@type": "ParseError",
      "errorCode": "E1005",
      "name": "ExpectedExpression"
    },
    {
      "@id": "E1006",
      "@type": "ParseError",
      "errorCode": "E1006",
      "name": "ExpectedMemorySpace"
    },
    {
      "@id": "E1007",
      "@type": "ParseError",
      "errorCode": "E1007",
      "name": "WildcardRequiresTypeAnnotation"
    },
    {
      "@id": "E1008",
      "@type": "ParseError",
      "errorCode": "E1008",
      "name": "UnsupportedSyntax"
    },
    {
      "@id": "E2000",
      "@type": "TypeError",
      "errorCode": "E2000",
      "name": "TypeErrorDefault"
    },
    {
      "@id": "E2001",
      "@type": "TypeError",
      "errorCode": "E2001",
      "name": "TypeMismatch"
    },
    {
      "@id": "E2002",
      "@type": "TypeError",
      "errorCode": "E2002",
      "name": "UndefinedType"
    },
    {
      "@id": "E2003",
      "@type": "TypeError",
      "errorCode": "E2003",
      "name": "TypeUnificationFailure"
    },
    {
      "@id": "E2004",
      "@type": "TypeError",
      "errorCode": "E2004",
      "name": "VariableShadowing"
    },
    {
      "@id": "E2005",
      "@type": "TypeError",
      "errorCode": "E2005",
      "name": "TupleArityMismatch"
    },
    {
      "@id": "E2006",
      "@type": "TypeError",
      "errorCode": "E2006",
      "name": "RecordFieldCountMismatch"
    },
    {
      "@id": "E2007",
      "@type": "TypeError",
      "errorCode": "E2007",
      "name": "RecordFieldTypeMismatch"
    },
    {
      "@id": "E2008",
      "@type": "TypeError",
      "errorCode": "E2008",
      "name": "FunctionReturnTypeMismatch"
    },
    {
      "@id": "E2009",
      "@type": "TypeError",
      "errorCode": "E2009",
      "name": "MissingTraitImplementation"
    },
    {
      "@id": "E2010",
      "@type": "TypeError",
      "errorCode": "E2010",
      "name": "TypeInferenceNotImplemented"
    },
    {
      "@id": "E2011",
      "@type": "TypeError",
      "errorCode": "E2011",
      "name": "FunctionLiteralMissingEffectDeclaration"
    },
    {
      "@id": "E3000",
      "@type": "EffectError",
      "errorCode": "E3000",
      "name": "EffectErrorDefault"
    },
    {
      "@id": "E3001",
      "@type": "EffectError",
      "errorCode": "E3001",
      "name": "MissingEffectCapability"
    },
    {
      "@id": "E3002",
      "@type": "EffectError",
      "errorCode": "E3002",
      "name": "EffectNotActive"
    },
    {
      "@id": "E3003",
      "@type": "EffectError",
      "errorCode": "E3003",
      "name": "EffectCompatibilityMismatch"
    },
    {
      "@id": "E3004",
      "@type": "EffectError",
      "errorCode": "E3004",
      "name": "EffectPushFailure"
    },
    {
      "@id": "E4000",
      "@type": "CodegenError",
      "errorCode": "E4000",
      "name": "SIR default",
      "note": "E4001-E4049 reserved for SIR-specific errors"
    },
    {
      "@id": "E4050",
      "@type": "CodegenError",
      "errorCode": "E4050",
      "name": "Emitter default",
      "note": "E4051-E4099 reserved for emitter-specific errors"
    }
  ]
}
