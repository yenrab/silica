{
  "@context": {
    "@vocab": "https://aalang.dev/silica/compiler/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "http://schema.org/",
    "silica": "https://aalang.dev/silica/spec/",
    "compiler": "https://aalang.dev/silica/compiler/"
  },
  "@graph": [
    {
      "@id": "compiler:CodeOrganization",
      "@type": "Document",
      "rdfs:label": "Silica Compiler Code Organization",
      "description": "Code organization structure for Phase 2 Silica compiler written in Silica",
      "version": "1.0",
      "principles": [
        "Feature-group modularity: Each language feature has dedicated files in lexer, parser, and codegen",
        "Clear separation: Lexer, parser, and codegen are separate directories",
        "Consistent naming: Files use descriptive names with grouping prefixes to avoid conflicts",
        "Hierarchical organization: Subdirectories group related features",
        "Incremental development: New features can be added without modifying existing files"
      ]
    },
    {
      "@id": "compiler:NamingConvention",
      "@type": "Concept",
      "rdfs:label": "File Naming Convention",
      "pattern": "{phase}_{group}_{feature}.silica",
      "components": {
        "phase": "One of: lexer, parser, codegen, ast",
        "group": "Optional subdirectory grouping (e.g., declarations, expressions, patterns, types, effects, actors, memory)",
        "feature": "Specific feature name (e.g., functions, structs, case, lists)"
      },
      "examples": [
        "lexer_core.silica",
        "parser_declarations_functions.silica",
        "parser_expressions_case.silica",
        "codegen_expressions_lists.silica",
        "ast_declarations.silica"
      ]
    },
    {
      "@id": "compiler:LexerDirectory",
      "@type": "Directory",
      "rdfs:label": "Lexer Directory",
      "path": "lexer/",
      "description": "Lexical analysis components",
      "files": [
        {
          "@id": "compiler:LexerCore",
          "name": "lexer_core.silica",
          "description": "Core token types, source location, basic tokenization"
        },
        {
          "@id": "compiler:LexerKeywords",
          "name": "lexer_keywords.silica",
          "description": "Keyword recognition"
        },
        {
          "@id": "compiler:LexerLiterals",
          "name": "lexer_literals.silica",
          "description": "Integer, float, string, char, boolean, unit literals"
        },
        {
          "@id": "compiler:LexerOperators",
          "name": "lexer_operators.silica",
          "description": "Operator recognition (arithmetic, comparison, logical)"
        },
        {
          "@id": "compiler:LexerComments",
          "name": "lexer_comments.silica",
          "description": "Comment handling"
        }
      ]
    },
    {
      "@id": "compiler:ParserDirectory",
      "@type": "Directory",
      "rdfs:label": "Parser Directory",
      "path": "parser/",
      "description": "Syntax parsing components",
      "subdirectories": [
        {
          "@id": "compiler:ParserDeclarations",
          "path": "parser/declarations/",
          "files": [
            {"name": "parser_declarations_functions.silica", "description": "Function declarations"},
            {"name": "parser_declarations_types.silica", "description": "Type declarations, type aliases"},
            {"name": "parser_declarations_structs.silica", "description": "Struct declarations"},
            {"name": "parser_declarations_enums.silica", "description": "Enum declarations"},
            {"name": "parser_declarations_traits.silica", "description": "Trait declarations"},
            {"name": "parser_declarations_impls.silica", "description": "Impl declarations"},
            {"name": "parser_declarations_modules.silica", "description": "Module, import, export declarations"},
            {"name": "parser_declarations_effects.silica", "description": "Effect declarations"}
          ]
        },
        {
          "@id": "compiler:ParserExpressions",
          "path": "parser/expressions/",
          "files": [
            {"name": "parser_expressions_literals.silica", "description": "Literal expressions"},
            {"name": "parser_expressions_calls.silica", "description": "Function calls, qualified method calls"},
            {"name": "parser_expressions_function_literals.silica", "description": "Function literal expressions"},
            {"name": "parser_expressions_case.silica", "description": "Case expressions"},
            {"name": "parser_expressions_if.silica", "description": "If expressions"},
            {"name": "parser_expressions_do.silica", "description": "Do expressions"},
            {"name": "parser_expressions_structs.silica", "description": "Struct literals, field access"},
            {"name": "parser_expressions_tuples.silica", "description": "Tuple literals"},
            {"name": "parser_expressions_constructors.silica", "description": "Constructor calls"},
            {"name": "parser_expressions_casts.silica", "description": "Cast and as-type expressions"},
            {"name": "parser_expressions_operators.silica", "description": "Binary and unary operators"},
            {"name": "parser_expressions_lists.silica", "description": "List literals and list operations"}
          ]
        },
        {
          "@id": "compiler:ParserPatterns",
          "path": "parser/patterns/",
          "files": [
            {"name": "parser_patterns_basic.silica", "description": "Basic patterns (identifiers, literals, wildcards)"},
            {"name": "parser_patterns_structs.silica", "description": "Struct patterns"},
            {"name": "parser_patterns_tuples.silica", "description": "Tuple patterns"},
            {"name": "parser_patterns_enums.silica", "description": "Enum/constructor patterns"},
            {"name": "parser_patterns_lists.silica", "description": "List patterns (empty, cons)"}
          ]
        },
        {
          "@id": "compiler:ParserTypes",
          "path": "parser/types/",
          "files": [
            {"name": "parser_types_primitives.silica", "description": "Primitive types"},
            {"name": "parser_types_functions.silica", "description": "Function types"},
            {"name": "parser_types_tuples.silica", "description": "Tuple types"},
            {"name": "parser_types_records.silica", "description": "Record types"},
            {"name": "parser_types_variants.silica", "description": "Variant/enum types"},
            {"name": "parser_types_processes.silica", "description": "Process types"},
            {"name": "parser_types_regions.silica", "description": "Region and reference types"},
            {"name": "parser_types_actors.silica", "description": "Actor types"},
            {"name": "parser_types_lists.silica", "description": "List types"}
          ]
        },
        {
          "@id": "compiler:ParserEffects",
          "path": "parser/effects/",
          "files": [
            {"name": "parser_effects_effects.silica", "description": "Effect parsing (device_io, concurrency, mem)"}
          ]
        }
      ],
      "coreFiles": [
        {"name": "parser_core.silica", "description": "Parser state, basic parsing utilities, error types"}
      ]
    },
    {
      "@id": "compiler:CodegenDirectory",
      "@type": "Directory",
      "rdfs:label": "Codegen Directory",
      "path": "codegen/",
      "description": "Code generation components",
      "subdirectories": [
        {
          "@id": "compiler:CodegenDeclarations",
          "path": "codegen/declarations/",
          "files": [
            {"name": "codegen_declarations_functions.silica", "description": "Function code generation"},
            {"name": "codegen_declarations_types.silica", "description": "Type code generation"},
            {"name": "codegen_declarations_structs.silica", "description": "Struct code generation"},
            {"name": "codegen_declarations_enums.silica", "description": "Enum code generation"},
            {"name": "codegen_declarations_traits.silica", "description": "Trait method dispatch code generation"},
            {"name": "codegen_declarations_modules.silica", "description": "Module-level code generation"}
          ]
        },
        {
          "@id": "compiler:CodegenExpressions",
          "path": "codegen/expressions/",
          "files": [
            {"name": "codegen_expressions_literals.silica", "description": "Literal code generation"},
            {"name": "codegen_expressions_calls.silica", "description": "Function call code generation"},
            {"name": "codegen_expressions_function_literals.silica", "description": "Closure code generation"},
            {"name": "codegen_expressions_case.silica", "description": "Case expression code generation"},
            {"name": "codegen_expressions_if.silica", "description": "If expression code generation"},
            {"name": "codegen_expressions_do.silica", "description": "Do expression code generation"},
            {"name": "codegen_expressions_structs.silica", "description": "Struct literal and field access code generation"},
            {"name": "codegen_expressions_tuples.silica", "description": "Tuple code generation"},
            {"name": "codegen_expressions_constructors.silica", "description": "Constructor call code generation"},
            {"name": "codegen_expressions_casts.silica", "description": "Cast code generation"},
            {"name": "codegen_expressions_operators.silica", "description": "Operator code generation"},
            {"name": "codegen_expressions_lists.silica", "description": "List operation code generation"}
          ]
        },
        {
          "@id": "compiler:CodegenPatterns",
          "path": "codegen/patterns/",
          "files": [
            {"name": "codegen_patterns_matching.silica", "description": "Pattern matching code generation"}
          ]
        },
        {
          "@id": "compiler:CodegenEffects",
          "path": "codegen/effects/",
          "files": [
            {"name": "codegen_effects_effects.silica", "description": "Effect handling code generation"}
          ]
        },
        {
          "@id": "compiler:CodegenActors",
          "path": "codegen/actors/",
          "files": [
            {"name": "codegen_actors_spawn.silica", "description": "Actor spawn code generation"},
            {"name": "codegen_actors_messaging.silica", "description": "Send/recv/cast code generation"},
            {"name": "codegen_actors_mailbox.silica", "description": "Mailbox code generation"}
          ]
        },
        {
          "@id": "compiler:CodegenMemory",
          "path": "codegen/memory/",
          "files": [
            {"name": "codegen_memory_regions.silica", "description": "Region allocation code generation"},
            {"name": "codegen_memory_references.silica", "description": "Reference operations code generation"}
          ]
        }
      ],
      "coreFiles": [
        {"name": "codegen_core.silica", "description": "Code generation state, basic utilities"}
      ]
    },
    {
      "@id": "compiler:ASTDirectory",
      "@type": "Directory",
      "rdfs:label": "AST Directory",
      "path": "ast/",
      "description": "Abstract Syntax Tree node definitions",
      "files": [
        {"name": "ast_core.silica", "description": "Core AST types (Program, SourceLocation)"},
        {"name": "ast_declarations.silica", "description": "Declaration AST nodes"},
        {"name": "ast_expressions.silica", "description": "Expression AST nodes"},
        {"name": "ast_patterns.silica", "description": "Pattern AST nodes"},
        {"name": "ast_types.silica", "description": "Type AST nodes"},
        {"name": "ast_effects.silica", "description": "Effect AST nodes"}
      ]
    },
    {
      "@id": "compiler:CompilerMain",
      "@type": "File",
      "rdfs:label": "Compiler Main",
      "name": "compiler.silica",
      "path": "compiler.silica",
      "description": "Main compiler entry point, pipeline orchestration"
    },
    {
      "@id": "compiler:FeatureGroup",
      "@type": "Concept",
      "rdfs:label": "Feature Groups",
      "description": "Logical groupings of related language features",
      "groups": [
        {
          "@id": "compiler:LexerFeatures",
          "name": "Lexer Features",
          "features": [
            "Core token types and tokenization",
            "Keyword recognition",
            "Literal parsing",
            "Operator recognition",
            "Comment handling"
          ]
        },
        {
          "@id": "compiler:ParserDeclarations",
          "name": "Parser Declarations",
          "features": [
            "Function declarations",
            "Type declarations",
            "Struct declarations",
            "Enum declarations",
            "Trait declarations",
            "Impl declarations",
            "Module declarations",
            "Effect declarations"
          ]
        },
        {
          "@id": "compiler:ParserExpressions",
          "name": "Parser Expressions",
          "features": [
            "Literal expressions",
            "Function calls",
            "Function literals",
            "Case expressions",
            "If expressions",
            "Do expressions",
            "Struct literals",
            "Tuple literals",
            "Constructor calls",
            "Cast expressions",
            "Operators",
            "List operations"
          ]
        },
        {
          "@id": "compiler:ParserPatterns",
          "name": "Parser Patterns",
          "features": [
            "Basic patterns",
            "Struct patterns",
            "Tuple patterns",
            "Enum patterns",
            "List patterns"
          ]
        },
        {
          "@id": "compiler:ParserTypes",
          "name": "Parser Types",
          "features": [
            "Primitive types",
            "Function types",
            "Tuple types",
            "Record types",
            "Variant types",
            "Process types",
            "Region types",
            "Actor types",
            "List types"
          ]
        },
        {
          "@id": "compiler:CodegenDeclarations",
          "name": "Codegen Declarations",
          "features": [
            "Function code generation",
            "Type code generation",
            "Struct code generation",
            "Enum code generation",
            "Trait dispatch",
            "Module code generation"
          ]
        },
        {
          "@id": "compiler:CodegenExpressions",
          "name": "Codegen Expressions",
          "features": [
            "Literal code generation",
            "Call code generation",
            "Closure code generation",
            "Case code generation",
            "If code generation",
            "Do code generation",
            "Struct code generation",
            "Tuple code generation",
            "Constructor code generation",
            "Cast code generation",
            "Operator code generation",
            "List code generation"
          ]
        },
        {
          "@id": "compiler:CodegenActors",
          "name": "Codegen Actors",
          "features": [
            "Actor spawn",
            "Message passing",
            "Mailbox operations"
          ]
        },
        {
          "@id": "compiler:CodegenMemory",
          "name": "Codegen Memory",
          "features": [
            "Region allocation",
            "Reference operations"
          ]
        }
      ]
    },
    {
      "@id": "compiler:AddingNewFeature",
      "@type": "Process",
      "rdfs:label": "Adding a New Feature",
      "description": "Process for adding a new language feature to the compiler",
      "steps": [
        {
          "step": 1,
          "action": "Add AST nodes",
          "file": "ast/ast_expressions.silica",
          "description": "Update AST to add new expression/declaration variant"
        },
        {
          "step": 2,
          "action": "Add lexer support",
          "file": "lexer/lexer_{feature}.silica",
          "description": "Create lexer file if new tokens needed",
          "optional": true
        },
        {
          "step": 3,
          "action": "Add parser support",
          "file": "parser/{group}/parser_{group}_{feature}.silica",
          "description": "Create parser file for the feature"
        },
        {
          "step": 4,
          "action": "Add codegen support",
          "file": "codegen/{group}/codegen_{group}_{feature}.silica",
          "description": "Create codegen file for the feature"
        },
        {
          "step": 5,
          "action": "Update core",
          "file": "parser/parser_core.silica",
          "description": "Wire in the new parser function"
        }
      ]
    },
    {
      "@id": "compiler:SpecificationMapping",
      "@type": "Concept",
      "rdfs:label": "Specification Mapping",
      "description": "Mapping from Silica language specification sections to compiler organization",
      "mappings": [
        {
          "specification": "silica:Section2",
          "title": "Lexical Structure",
          "compilerPath": "lexer/",
          "description": "Lexical analysis components"
        },
        {
          "specification": "silica:Section3",
          "title": "Syntax",
          "compilerPath": "parser/",
          "description": "Syntax parsing components"
        },
        {
          "specification": "silica:Section8",
          "title": "Type System",
          "compilerPath": "parser/types/ and ast/ast_types.silica",
          "description": "Type parsing and AST nodes"
        },
        {
          "specification": "silica:Section9",
          "title": "Effect System",
          "compilerPath": "parser/effects/ and codegen/effects/",
          "description": "Effect parsing and code generation"
        },
        {
          "specification": "silica:Section15",
          "title": "Actor Model Semantics",
          "compilerPath": "codegen/actors/",
          "description": "Actor code generation"
        },
        {
          "specification": "silica:Section12",
          "title": "Memory Model",
          "compilerPath": "codegen/memory/",
          "description": "Memory model code generation"
        }
      ]
    },
    {
      "@id": "compiler:Benefits",
      "@type": "Concept",
      "rdfs:label": "Benefits of This Organization",
      "benefits": [
        {
          "name": "Easy Navigation",
          "description": "Developers and LLMs can quickly locate code for any feature"
        },
        {
          "name": "Incremental Development",
          "description": "Features can be added without modifying existing files"
        },
        {
          "name": "LLM-Friendly",
          "description": "Clear file names and structure make code easy to understand"
        },
        {
          "name": "Human-Friendly",
          "description": "Small, focused files are easier to read and maintain"
        },
        {
          "name": "Testable",
          "description": "Each feature can be tested independently"
        },
        {
          "name": "Scalable",
          "description": "New features follow the same pattern, maintaining consistency"
        }
      ]
    }
  ]
}
