.text
.global main

    ; effects [device_io]
main:     STP X29, X30, [SP, #-16]!

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi8_0@PAGE
    ADD X1, X1, L_pi8_0@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0



    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_pi8_0:
    .byte  0x37, 0