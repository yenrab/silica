// Trial 01: Basic Inline Struct Creation and Field Access
//
// Demonstrates:
// - Creating inline struct instances
// - Accessing struct fields
// - Structs as local values within functions

fn create_point() -> { x: int64, y: int64 } {
    point: { x: int64, y: int64 } <- { x: 10, y: 20 };
    point
}

fn access_fields() -> int64 {
    p: { x: int64, y: int64 } <- { x: 5, y: 15 };
    x_val: int64 <- p.x;
    y_val: int64 <- p.y;
    x_val + y_val
}

fn main() -> atom {
    // Create and use inline struct
    point: { x: int64, y: int64 } <- create_point();

    x: int64 <- point.x;
    y: int64 <- point.y;

    sum: int64 <- access_fields();

    :ok
}
