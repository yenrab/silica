.text
.global main


main:     STP X29, X30, [SP, #-16]!

    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF

L_case_o166_br_0:
    ADRP X3, L_str_0@PAGE
    ADD X3, X3, L_str_0@PAGEOFF
    CMP X1, X3
    B.NE L_case_o166_br_1
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #7

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi_0@PAGE
    ADD X1, X1, L_pi_0@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #0
    B L_case_o166_done
L_case_o166_br_1:
    ADRP X3, L_str_3@PAGE
    ADD X3, X3, L_str_3@PAGEOFF
    CMP X1, X3
    B.NE L_case_o166_br_2
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi_1@PAGE
    ADD X1, X1, L_pi_1@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #0
    B L_case_o166_done
L_case_o166_br_2:
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_4@PAGE
    ADD X1, X1, L_str_4@PAGEOFF
    MOV X2, #7

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #0
    B L_case_o166_done
L_case_o166_fb:
    MOV X0, #0
    B L_case_o166_done
L_case_o166_done:

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_pi_0:
    .byte  0x31, 0
L_pi_1:
    .byte  0x30, 0
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "verbose"
    .byte 0
L_str_1:
    .ascii ""
    .byte 0
L_str_2:
    .ascii "\n"
    .byte 0
L_str_3:
    .ascii "quiet"
    .byte 0
L_str_4:
    .ascii "default"
    .byte 0

L_newline:
    .byte 10

