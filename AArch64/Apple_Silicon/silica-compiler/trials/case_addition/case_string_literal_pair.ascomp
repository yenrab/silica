.text
.global main


main:     STP X29, X30, [SP, #-16]!

    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF

L_case_o122_br_0:
    ADRP X3, L_str_0@PAGE
    ADD X3, X3, L_str_0@PAGEOFF
    CMP X1, X3
    B.NE L_case_o122_br_1
    MOV X0, #1
    B L_case_o122_done
L_case_o122_br_1:
    ADRP X3, L_str_1@PAGE
    ADD X3, X3, L_str_1@PAGEOFF
    CMP X1, X3
    B.NE L_case_o122_br_2
    MOV X0, #2
    B L_case_o122_done
L_case_o122_br_2:
    MOV X0, #0
    B L_case_o122_done
L_case_o122_fb:
    MOV X0, #0
    B L_case_o122_done
L_case_o122_done:

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello"
    .byte 0
L_str_1:
    .ascii "world"
    .byte 0

