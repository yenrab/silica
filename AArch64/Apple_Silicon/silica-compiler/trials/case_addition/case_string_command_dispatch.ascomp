.text
.global main


main:     STP X29, X30, [SP, #-16]!

    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, X1
L_case_o138_br_0:
    ADRP X3, L_str_1@PAGE
    ADD X3, X3, L_str_1@PAGEOFF
    CMP X2, X3
    B.NE L_case_o138_br_1
    MOV X0, #10
    B L_case_o138_done
L_case_o138_br_1:
    ADRP X3, L_str_0@PAGE
    ADD X3, X3, L_str_0@PAGEOFF
    CMP X2, X3
    B.NE L_case_o138_br_2
    MOV X0, #42
    B L_case_o138_done
L_case_o138_br_2:
    MOV X0, #-1
    B L_case_o138_done
L_case_o138_fb:
    MOV X0, #0
    B L_case_o138_done
L_case_o138_done:

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "multiply"
    .byte 0
L_str_1:
    .ascii "add"
    .byte 0

