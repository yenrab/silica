.text
.global main


main:     STP X29, X30, [SP, #-16]!

    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #2
    MOV X3, X1
L_case_o194_br_0:
    ADRP X4, L_str_0@PAGE
    ADD X4, X4, L_str_0@PAGEOFF
    CMP X3, X4
    B.NE L_case_o194_br_1
    MOV X9, X2
    MOV X10, #0
    CMP X9, X10
    CSET X3, EQ
L_case_o242_br_0:
    CMP W3, #1
    B.NE L_case_o242_br_1
    MOV X0, #-1
    B L_case_o242_done
L_case_o242_br_1:
    CMP W3, #0
    B.NE L_case_o242_fb
    MOV X9, #100
    MOV X10, X2
    SDIV X0, X9, X10

    B L_case_o242_done
L_case_o242_fb:
    MOV X0, #0
    B L_case_o242_done
L_case_o242_done:

    B L_case_o194_done
L_case_o194_br_1:
    ADRP X4, L_str_1@PAGE
    ADD X4, X4, L_str_1@PAGEOFF
    CMP X3, X4
    B.NE L_case_o194_br_2
    MOV X9, #100
    MOV X10, X2
    MUL X0, X9, X10
    MOV X9, X0
    MOV X10, #1
    ADD X0, X9, X10
    B L_case_o194_done
L_case_o194_br_2:
    MOV X1, #-99
    MOV X0, X1
    B L_case_o194_done
L_case_o194_fb:
    MOV X0, #0
    B L_case_o194_done
L_case_o194_done:

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "divide"
    .byte 0
L_str_1:
    .ascii "multiply"
    .byte 0

