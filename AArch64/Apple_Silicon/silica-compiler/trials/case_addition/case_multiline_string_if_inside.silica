// Spec §3.3.3 / actor example: string literals with multi-line blocks and inner if (safe_calculator shape)
fn main() -> int64 {
    cmd: string <- "divide";
    value: int64 <- 2;
    case cmd of {
        "divide" -> {
            divisor: int64 <- value;
            if divisor == 0 {
                -1
            } else {
                result: int64 <- 100 / divisor;
                result
            }
        }
        "multiply" -> {
            acc: int64 <- 100 * value;
            acc + 1
        }
        _: string -> {
            unknown: int64 <- -99;
            unknown
        }
    }
}
