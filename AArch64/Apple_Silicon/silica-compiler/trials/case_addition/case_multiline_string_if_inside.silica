// Spec §3.3.3 / §3.3.5: string literals with multi-line blocks and nested case on boolean (safe_calculator shape)
fn main() -> int64 {
    cmd: string <- "divide";
    value: int64 <- 2;
    case cmd of {
        "divide" -> {
            case value == 0 of {
                true -> -1;
                false -> {
                    result: int64 <- 100 / value;
                    result
                }
            }
        }
        "multiply" -> {
            acc: int64 <- 100 * value;
            acc + 1
        }
        _: string -> {
            unknown: int64 <- -99;
            unknown
        }
    }
}
