.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X1, #42

L_case_o133_br_0:
    MOV X9, X1
    MOV X10, #0
    CMP X9, X10
    CSET X4, LT
    CBZ X4, L_case_o133_br_1
    MOV X0, #-1
    B L_case_o133_done
L_case_o133_br_1:
    MOV X9, X1
    MOV X10, #0
    CMP X9, X10
    CSET X9, GE
    STR X9, [SP, #-16]!
    MOV X9, X1
    MOV X10, #100
    CMP X9, X10
    CSET X10, LT
    LDR X9, [SP], #16

    AND X4, X9, X10
    CMP X4, #0
    CSET X4, NE

    CBZ X4, L_case_o133_br_2
    MOV X9, X1
    MOV X10, #2
    MUL X0, X9, X10
    B L_case_o133_done
L_case_o133_br_2:
    MOV X9, X1
    MOV X10, #100
    CMP X9, X10
    CSET X4, GE
    CBZ X4, L_case_o133_fb
    MOV X9, X1
    MOV X10, #100
    ADD X0, X9, X10
    B L_case_o133_done
L_case_o133_fb:
    MOV X0, #0
    B L_case_o133_done
L_case_o133_done:

    LDP X29, X30, [SP], #16
    RET
