.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X1, #50
    MOV X2, X1
L_case_o141_br_0:
    MOV X9, X2
    MOV X10, #10
    CMP X9, X10
    CSET X4, LO
    CBZ X4, L_case_o141_br_1
    MOV X0, X2
    B L_case_o141_done
L_case_o141_br_1:
    MOV X9, X2
    MOV X10, #100
    CMP X9, X10
    CSET X4, LO
    CBZ X4, L_case_o141_br_2
    MOV X9, X2
    MOV X10, #1000
    ADD X0, X9, X10
    B L_case_o141_done
L_case_o141_br_2:
    MOV X9, X2
    MOV X10, #10000
    ADD X0, X9, X10
    B L_case_o141_done
L_case_o141_fb:
    MOV X0, #0
    B L_case_o141_done
L_case_o141_done:

    LDP X29, X30, [SP], #16
    RET
