.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV W10, #2
    STR W10, [SP, #-16]!
    MOV W0, #10
    STR X0, [SP, #-16]!
    MOV W9, #20
    MOV W10, #5


    SDIV W10, W9, W10
    LDR W9, [SP], #16


    ADD W9, W9, W10
    LDR W10, [SP], #16


    SUB W0, W9, W10
    LDP X29, X30, [SP], #16
    RET
