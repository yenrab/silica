// Trial: alloc_ref with flat tuple of mixed types (int64, bool, float64)
// silica-specification §9.2.2, §22.2

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        mixed: (int64, bool, float64) <- (42, true, 2.718);
        ref: ref(L1, normal, (int64, bool, float64)) <- alloc_ref(r, mixed);
    produces
        pure 0
    end
}
