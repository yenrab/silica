// Trial: alloc_ref with unit type
// silica-specification §9.2.2, §22.2

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        ref: ref(L1, normal, unit) <- alloc_ref(r, ());
    produces
        pure 0
    end
}
