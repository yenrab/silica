// Trial: alloc_buf with float64 element type
// silica-specification §12.3.2, §22.1, §22.3

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, float64, 8) <- alloc_buf(r, 8);
    produces
        pure 0
    end
}
