// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Same vocabulary as `List[T, S]` in design_documents/list_implementation_design.md (§3.5, §9.8).

// Trial: write_buf with flat tuple element type
// silica-specification §22.3

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, (int64, int64), 4) <- alloc_buf(r, 4);
        _: atom <- write_buf(buf, 0, (7, 11));
        value: (int64, int64) <- read_buf(buf, 0);
    produces
        pure 0
    end
}
