// Trial: write_buf and read_buf at specific index
// silica-specification §12.3.2, §22.3

fn main() -> int64 {
    sequence proc[mem(normal)]
        r: region(R, normal) <- alloc_region(normal);
        buf: buf(R, normal, int64, 10) <- alloc_buf(r, 10);
        _: atom <- write_buf(buf, 5, 99);
        value: int64 <- read_buf(buf, 5);
    produces
        pure value
    end
}
