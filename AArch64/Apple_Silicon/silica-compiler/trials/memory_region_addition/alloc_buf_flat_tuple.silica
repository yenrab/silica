// Trial: alloc_buf with flat tuple element type
// silica-specification §12.3.2, §22.1, §22.3

fn main() -> int64 {
    sequence proc[mem(normal)]
        r: region(R, normal) <- alloc_region(normal);
        buf: buf(R, normal, (int64, int64), 4) <- alloc_buf(r, 4);
    produces
        pure 0
    end
}
