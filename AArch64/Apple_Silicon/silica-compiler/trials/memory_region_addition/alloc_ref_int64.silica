// Trial: alloc_ref with int64 primitive
// silica-specification §9.2.2, §22.2

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        ref: ref(L1, normal, int64) <- alloc_ref(r, 42);
    produces
        pure 0
    end
}
