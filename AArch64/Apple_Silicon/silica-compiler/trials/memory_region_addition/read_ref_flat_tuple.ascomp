.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X0, SP
    MOV X0, #4112
    BL _malloc
    ADD X4, X0, #16
    STR X4, [X0]
    MOV X5, #4112
    ADD X4, X0, X5
    STR X4, [X0, #8]
    MOV X1, X0
    SUB SP, SP, #16
    MOV X9, #10
    STR X9, [SP, #0]
    MOV X9, #20
    STR X9, [SP, #8]
    MOV X2, SP
    MOV X1, X0


    LDR X3, [X1]
    LDR X4, [X1, #8]
    ADD X5, X3, #8
    CMP X5, X4
    B.HI L_region_overflow
    MOV X4, X3
    STR X2, [X3]
    ADD X3, X3, #8
    STR X3, [X1]
    MOV X2, X4
    MOV X1, X2
    LDR X3, [X1]
    MOV X0, #0
    ADD SP, SP, #16

    LDP X29, X30, [SP], #16
    RET
L_region_overflow:
    BL _abort

