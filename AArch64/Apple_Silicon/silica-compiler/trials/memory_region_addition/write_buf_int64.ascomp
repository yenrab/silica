.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X0, SP
    MOV X0, #4112
    BL _malloc
    ADD X4, X0, #16
    STR X4, [X0]
    MOV X5, #4112
    ADD X4, X0, X5
    STR X4, [X0, #8]
    MOV X1, X0

    MOV X2, #10

    LDR X3, [X1]
    LDR X4, [X1, #8]
    ADD X5, X3, X2, LSL #3
    CMP X5, X4
    B.HI L_region_overflow
    MOV X4, X3
    ADD X3, X3, X2, LSL #3
    STR X3, [X1]
    MOV X2, X4
    MOV X1, X2
    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    MOV X9, #42
    STR X9, [SP, #8]
    MOV X2, SP

    LDR X3, [X2, #8]
    LDR X2, [X2]
    STR X3, [X1, X2, LSL #3]
    ADD SP, SP, #16

    MOV X2, X1

    MOV X2, #0

    LDR X0, [X1, X2, LSL #3]

    LDP X29, X30, [SP], #16
    RET
L_region_overflow:
    BL _abort

