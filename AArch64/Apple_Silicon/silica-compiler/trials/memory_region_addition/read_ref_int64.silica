// Trial: read_ref with int64
// silica-specification §9.2.2, §22.2

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        read_reference: ref(L1, normal, int64) <- alloc_ref(r, 42);
        value: int64 <- read_ref(read_reference);
    produces
        pure value
    end
}
