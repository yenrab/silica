// Trial: read_ref with int64
// silica-specification §9.2.2, §22.2

fn main() -> int64 {
    sequence proc[mem(normal)]
        r: region(R, normal) <- alloc_region(normal);
        ref: ref(R, normal, int64) <- alloc_ref(r, 42);
        value: int64 <- read_ref(ref);
    produces
        pure value
    end
}
