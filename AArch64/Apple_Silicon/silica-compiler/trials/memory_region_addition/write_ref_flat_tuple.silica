// Trial: write_ref with flat tuple
// silica-specification §9.2.2, §22.2

fn main() -> int64 {
    sequence proc[mem(normal)]
        r: region(R, normal) <- alloc_region(normal);
        ref: ref(R, normal, (int64, int64)) <- alloc_ref(r, (0, 0));
        _: atom <- write_ref(ref, (5, 10));
        read_back: (int64, int64) <- read_ref(ref);
    produces
        pure 0
    end
}
