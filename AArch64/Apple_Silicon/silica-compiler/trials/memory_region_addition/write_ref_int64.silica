// Trial: write_ref with int64
// silica-specification §9.2.2, §22.2

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        ref: ref(L1, normal, int64) <- alloc_ref(r, 0);
        _: atom <- write_ref(ref, 100);
        value: int64 <- read_ref(ref);
    produces
        pure value
    end
}
