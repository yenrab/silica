// Trial: alloc_ref with flat tuple (int64, int64)
// silica-specification §9.2.2, §22.2

fn main() -> int64 {
    sequence proc[mem(normal)]
        r: region(R, normal) <- alloc_region(normal);
        pair: (int64, int64) <- (1, 2);
        ref: ref(R, normal, (int64, int64)) <- alloc_ref(r, pair);
    produces
        pure 0
    end
}
