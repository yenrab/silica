// Trial: alloc_region(normal_writeback) - explicit write-back (same as normal)
// silica-specification §4.4.1, §22.1

fn main() -> int64 {
    sequence proc[mem(normal_writeback)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal_writeback) <- alloc_region(normal_writeback);
    produces
        pure 0
    end
}
