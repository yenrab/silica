// Trial: write_buf with int64 buffer
// silica-specification §12.3.2, §22.3

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, int64, 10) <- alloc_buf(r, 10);
        _: atom <- write_buf(buf, 0, 42);
        value: int64 <- read_buf(buf, 0);
    produces
        pure value
    end
}
