// silica:Section30_2 — polymorphismMechanism: types implementing the same trait share an interface.
// silica:SubtypingRules / trait-based polymorphism: same trait, different inline shapes.

trait Hashable {
    fn hash_bits(self) -> int64
}

impl Hashable for { w: int64 } {
    fn hash_bits(self) -> int64 {
        self.w
    }
}

impl Hashable for { s: string } {
    fn hash_bits(self) -> int64 {
        0
    }
}

fn wrap_i(n: int64) -> { w: int64 } {
    x: { w: int64 } <- { w: n };
    x
}

fn wrap_s(t: string) -> { s: string } {
    y: { s: string } <- { s: t };
    y
}

fn main() -> atom {
    i: { w: int64 } <- wrap_i(42);
    j: { s: string } <- wrap_s("x");
    _: int64 <- i.hash_bits();
    _: int64 <- j.hash_bits();
    atom
}
