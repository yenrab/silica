// silica:Section30_1_1 — markerTraits: no methods; compile-time checking only (cf. ActorMessage, Collectable definition in jsonld).
// silica:Traits — markerTraits list includes ActorState, ActorMessage (user-defined markers follow the same shape).

trait Scoped {
}

impl Scoped for { done: boolean } {
}

fn flag(b: boolean) -> { done: boolean } {
    f: { done: boolean } <- { done: b };
    f
}

fn main() -> atom {
    _: { done: boolean } <- flag(true);
    atom
}
