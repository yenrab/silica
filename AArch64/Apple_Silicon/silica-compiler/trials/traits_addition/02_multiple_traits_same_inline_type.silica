// silica:Section30_1_2 — "Types implement each trait separately via impl"; traits independent;
// conflictDetection: error if two traits on the same type expose the same method name (not shown here).

trait AsString {
    fn as_text(self) -> string
}

trait Comparable {
    fn same(self, other) -> boolean
}

impl AsString for { key: int64 } {
    fn as_text(self) -> string {
        "key"
    }
}

impl Comparable for { key: int64 } {
    fn same(self, other) -> boolean {
        self.key == other.key
    }
}

fn keyed(k: int64) -> { key: int64 } {
    v: { key: int64 } <- { key: k };
    v
}

fn main() -> atom {
    a: { key: int64 } <- keyed(1);
    b: { key: int64 } <- keyed(1);
    _: string <- a.as_text();
    _: boolean <- a.same(b);
    atom
}
