// Spec §5.6.1, §5.6.3: list literals and empty(); Collectable element type int64
fn main() -> int64 {
    literal_list: List[int64] <- [7, 8, 9]: List[int64];
    empty_list: List[int64] <- empty[int64]();
    n1: int64 <- length[int64](literal_list);
    n2: int64 <- length[int64](empty_list);
    n1 + n2
}
