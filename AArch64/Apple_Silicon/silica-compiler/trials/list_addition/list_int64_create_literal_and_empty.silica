// List trial — silica-compiler / trials/list_addition
// Implementation: design_documents/list_implementation_design.md §4.3 (empty), §6.3–§6.4 (List[T] bundle, length memo),
//   §7, §9.2 (one region per spine), §9.3 (mem type for list allocation), §9.6 (immediate lowering).
// Language surface: silica-specification.md — list literals, empty(), length (Collectable int64).
fn main() -> int64 {
    sequence proc[mem(normal)]
        literal_list: List[int64] <- [7, 8, 9]: List[int64];
        empty_list: List[int64] <- empty[int64]();
        n1: int64 <- length[int64](literal_list);
        n2: int64 <- length[int64](empty_list);
        sum: int64 <- n1 + n2;
    produces
        pure sum
    end
}
