// List trial — silica-compiler / trials/list_addition
// Forces at least two chunk buffers in one region: design_documents/list_implementation_design.md §4.1–§4.2, §9.2, §9.5.
// Vector chunk width is target-dependent (e.g. 128-bit → 4×uint32/chunk; 256-bit → 8×uint32/chunk).
// Nine prepends after empty guarantees a second chunk for both (same mem(normal) region, §9.3).
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[uint32] <- empty[uint32]();
        xs1: List[uint32] <- prepend[uint32](0, xs0);
        xs2: List[uint32] <- prepend[uint32](1, xs1);
        xs3: List[uint32] <- prepend[uint32](2, xs2);
        xs4: List[uint32] <- prepend[uint32](3, xs3);
        xs5: List[uint32] <- prepend[uint32](4, xs4);
        xs6: List[uint32] <- prepend[uint32](5, xs5);
        xs7: List[uint32] <- prepend[uint32](6, xs6);
        xs8: List[uint32] <- prepend[uint32](7, xs7);
        xs9: List[uint32] <- prepend[uint32](8, xs8);
        n: int64 <- length[uint32](xs9);
    produces
        pure n
    end
}
