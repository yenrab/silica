// List trial — silica-compiler / trials/list_addition
// Non-default memory space: mem(normal_writethrough) (see tutorials_and_howtos/memory_region_types.md).
// Implementation: design_documents/list_implementation_design.md §9.3 — same mem(<space>) for list region and all spine buffers.
fn main() -> int64 {
    sequence proc[mem(normal_writethrough)]
        xs: List[int64] <- [1, 2]: List[int64];
        n: int64 <- length[int64](xs);
    produces
        pure n
    end
}
