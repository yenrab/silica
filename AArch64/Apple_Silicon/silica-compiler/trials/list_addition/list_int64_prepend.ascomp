.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X2, #0

    MOV X1, #3

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X2, X0

    MOV X1, #2

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X2, X0
    MOV X1, #1

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X1, X0
    MOV X3, X1
L_case_o691_br_0:
    CMP X3, #0
    B.NE L_case_o691_br_1
    MOV X0, #0
    B L_case_o691_done
L_case_o691_br_1:
    CBZ X3, L_case_o691_br_2
    LDR X3, [X3]
    MOV X0, X3
    B L_case_o691_done
L_case_o691_br_2:
    MOV X0, #0
    B L_case_o691_done
L_case_o691_fb:
    MOV X0, #0
    B L_case_o691_done
L_case_o691_done:

    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X1, X0
    MOV X0, #0
L_list_len_loop:
    CBZ X1, L_list_len_done
    ADD X0, X0, #1
    LDR X1, [X1, #8]
    B L_list_len_loop
L_list_len_done:
    RET

