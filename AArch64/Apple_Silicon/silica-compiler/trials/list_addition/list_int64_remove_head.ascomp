.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X2, #0

    MOV X1, #30

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X2, X0

    MOV X1, #20

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X2, X0

    MOV X1, #10

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X9, X0
    LDR X1, [X9, #8]
    MOV X9, X1
    LDR X0, [X9]

    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X1, X0
    MOV X0, #0
L_list_len_loop:
    CBZ X1, L_list_len_done
    ADD X0, X0, #1
    LDR X1, [X1, #8]
    B L_list_len_loop
L_list_len_done:
    RET

