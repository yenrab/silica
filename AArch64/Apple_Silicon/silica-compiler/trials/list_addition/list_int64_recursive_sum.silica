// List trial — silica-compiler / trials/list_addition
// Recursive function over List[int64]: design_documents/list_implementation_design.md §7, §9.3.
// Effects are declared only on sequence blocks (not on function return types). sum_list wraps case in
// sequence proc[mem(normal)] … produces pure … end; each recursive call runs that sequence again.
// main builds the literal list under sequence proc[mem(normal)] and calls sum_list.
// sum_list [1,2,3] -> 6
fn sum_list(xs: List[int64]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- case xs of {
            []: List[int64] -> 0;
            [h: int64, t: List[int64]] -> h + sum_list(t);
            _: List[int64] -> 0
        };
    produces
        pure n
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64] <- [1, 2, 3]: List[int64];
        total: int64 <- sum_list(xs);
    produces
        pure total
    end
}
