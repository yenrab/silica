// List trial — silica-compiler / trials/list_addition
// Same vocabulary as `List[T, S]` in design_documents/list_implementation_design.md (§3.5, §9.8).
// design_documents/silica-specification.md §4.2.4 — uniform list types: parameters, variables, literals, patterns match.
// design_documents/list_implementation_design.md §7, §9.3 — recursive walk; effects only on sequence blocks.
// sum_list [1,2,3] -> 6
fn sum_list(xs: List[int64, normal]) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- case xs of {
            []: List[int64, normal] -> 0;
            [h: int64, t: List[int64, normal]] -> h + sum_list(t);
            _: List[int64, normal] -> 0
        };
    produces
        pure n
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, normal] <- [1, 2, 3]: List[int64, normal];
        total: int64 <- sum_list(xs);
    produces
        pure total
    end
}
