// List trial — silica-compiler / trials/list_addition
// Implementation: design_documents/list_implementation_design.md §2 (immutable prepend), §5–§6 (bundle),
//   §9.3 (mem type), §9.5 (prepend fills chunk from back toward front), §9.7 (case matches primary cursor only).
// Language surface: silica-specification.md — prepend, list patterns, wildcard _.
fn main() -> int64 {
    sequence proc[mem(normal)]
        base: List[int64] <- [2, 3]: List[int64];
        with_head: List[int64] <- prepend[int64](1, base);
        head_val: int64 <- case with_head of {
            []: List[int64] -> 0;
            [h: int64, _: List[int64]] -> h;
            _: List[int64] -> 0
        };
    produces
        pure head_val
    end
}
