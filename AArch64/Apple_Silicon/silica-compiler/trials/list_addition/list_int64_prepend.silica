// Spec §5.6.2: prepend (structural sharing; new list with element at front)
fn main() -> int64 {
    base: List[int64] <- [2, 3]: List[int64];
    with_head: List[int64] <- prepend[int64](1, base);
    case with_head of {
        []: List[int64] -> 0;
        [h: int64, _: List[int64]] -> h;
        _: List[int64] -> 0
    }
}
