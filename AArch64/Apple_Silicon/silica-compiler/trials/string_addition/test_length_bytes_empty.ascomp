.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    BL L_length_bytes_helper
    LDP X29, X30, [SP], #16
    RET
L_length_bytes_helper:
    MOV X9, X0
    MOV X0, #0
L_lb_loop:
    LDRB W10, [X9]
    CBZ W10, L_lb_done
    ADD X0, X0, #1
    ADD X9, X9, #1
    B L_lb_loop
L_lb_done:
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii ""
    .byte 0

