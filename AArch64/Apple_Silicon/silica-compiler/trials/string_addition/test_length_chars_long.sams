.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    BL L_length_chars_helper
    LDP X29, X30, [SP], #16
    RET
L_length_chars_helper:
    MOV X9, X0
    MOV X0, #0
L_lc_loop:
    LDRB W10, [X9]
    CBZ W10, L_lc_done
    CMP W10, #0x80
    B.LO L_lc_inc
    CMP W10, #0xC0
    B.HS L_lc_inc
    ADD X9, X9, #1
    B L_lc_loop
L_lc_inc:
    ADD X0, X0, #1
    ADD X9, X9, #1
    B L_lc_loop
L_lc_done:
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;:,.<>?"
    .byte 0

