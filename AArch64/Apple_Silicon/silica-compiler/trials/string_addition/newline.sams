.text
.global main

    ; effects [device_io]
main:     STP X29, X30, [SP, #-16]!

    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X0, X1
    ; effects [device_io]
    BL L_ps_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #4

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_3@PAGE
    ADD X1, X1, L_str_3@PAGEOFF
    MOV X2, #5

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_4@PAGE
    ADD X1, X1, L_str_4@PAGEOFF
    MOV X2, #8

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET
L_ps_helper:
    MOV X9, X0
    MOV X2, #0
L_ps_loop:
    LDRB W1, [X0]
    CBZ W1, L_ps_do_write
    ADD X2, X2, #1
    ADD X0, X0, #1
    B L_ps_loop
L_ps_do_write:
    MOV X0, #1
    MOV X1, X9
    MOV X16, #4
    SVC #0x80
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "🙂"
    .byte 0
L_str_1:
    .ascii "🎉"
    .byte 0
L_str_2:
    .ascii "\n"
    .byte 0
L_str_3:
    .ascii "hello"
    .byte 0
L_str_4:
    .ascii " friends"
    .byte 0

L_newline:
    .byte 10

