.text
.global main

    ; effects [device_io]
main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    MOV X1, #0
    ADRP X2, L_i64_0@PAGE
    LDR X2, [X2, L_i64_0@PAGEOFF]
    BL L_substring_until_char_helper

    ; effects [device_io]
    BL L_ps_helper
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET
L_ps_helper:
    MOV X9, X0
    MOV X2, #0
L_ps_loop:
    LDRB W1, [X0]
    CBZ W1, L_ps_do_write
    ADD X2, X2, #1
    ADD X0, X0, #1
    B L_ps_loop
L_ps_do_write:
    MOV X0, #1
    MOV X1, X9
    MOV X16, #4
    SVC #0x80
    RET
L_substring_until_char_helper:
    STP X19, X20, [SP, #-64]!
    STP X21, X22, [SP, #16]
    STP X23, X14, [SP, #32]
    STR X15, [SP, #48]
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2
    LSR X14, X21, #56
    MOV W15, W21
    CMP X14, #0
    CINC X14, X14, EQ
    MOV X9, X19
    MOV X22, #0
L_suc_len:
    LDRB W10, [X9]
    CBZ W10, L_suc_len_done
    ADD X22, X22, #1
    ADD X9, X9, #1
    B L_suc_len
L_suc_len_done:
    CMP X20, #0
    CSEL X20, XZR, X20, LT
    CMP X20, X22
    CSEL X20, X22, X20, GT
    MOV X23, X20
    ADD X9, X19, X20
L_suc_scan:
    CMP X20, X22
    B.GE L_suc_scan_done
    LDRB W10, [X9]
    ADD X17, X20, X14
    CMP X17, X22
    B.GT L_suc_no_match
    CMP X14, #1
    B.EQ L_suc_cmp1
    CMP X14, #2
    B.EQ L_suc_cmp2
    CMP X14, #3
    B.EQ L_suc_cmp3
    LDR W13, [X9]
    CMP W13, W15
    B.EQ L_suc_scan_done
    B L_suc_no_match
L_suc_cmp1:
    LDRB W13, [X9]
    UBFX W16, W15, #0, #8
    CMP W13, W16
    B.EQ L_suc_scan_done
    B L_suc_no_match
L_suc_cmp2:
    LDRH W13, [X9]
    UBFX W16, W15, #0, #16
    CMP W13, W16
    B.EQ L_suc_scan_done
    B L_suc_no_match
L_suc_cmp3:
    LDR W13, [X9]
    UBFX W13, W13, #0, #24
    UBFX W16, W15, #0, #24
    CMP W13, W16
    B.EQ L_suc_scan_done
L_suc_no_match:
    CMP W10, #0x80
    B.LO L_suc_adv1
    CMP W10, #0xC2
    B.LO L_suc_adv1
    CMP W10, #0xE0
    B.LO L_suc_adv2
    CMP W10, #0xF0
    B.LO L_suc_adv3
    CMP W10, #0xF8
    B.LO L_suc_adv4
L_suc_adv1:
    ADD X9, X9, #1
    ADD X20, X20, #1
    B L_suc_scan
L_suc_adv2:
    SUB X18, X22, X20
    MOV X17, #2
    CMP X18, #2
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X20, X20, X17
    B L_suc_scan
L_suc_adv3:
    SUB X18, X22, X20
    MOV X17, #3
    CMP X18, #3
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X20, X20, X17
    B L_suc_scan
L_suc_adv4:
    SUB X18, X22, X20
    MOV X17, #4
    CMP X18, #4
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X20, X20, X17
    B L_suc_scan
L_suc_scan_done:
    SUB X11, X20, X23
    CBZ X11, L_suc_empty
    ADD X10, X19, X23
    ADD X0, X11, #1
    MOV X1, X0
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    MOV X23, X0
    MOV X9, X23
    MOV X12, X11
L_suc_cp:
    CBZ X12, L_suc_cp_done
    LDRB W13, [X10]
    STRB W13, [X9]
    ADD X9, X9, #1
    ADD X10, X10, #1
    SUB X12, X12, #1
    B L_suc_cp
L_suc_cp_done:
    STRB WZR, [X9]
    MOV X0, X23
    B L_suc_ret
L_suc_empty:
    MOV X0, #1
    MOV X1, X0
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    STRB WZR, [X0]
L_suc_ret:
    LDR X15, [SP, #48]
    LDP X23, X14, [SP, #32]
    LDP X21, X22, [SP, #16]
    LDP X19, X20, [SP], #64
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 288230378342817776

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "世界αβγ🙂余"
    .byte 0
L_str_1:
    .ascii ""
    .byte 0
L_str_2:
    .ascii "\n"
    .byte 0

L_newline:
    .byte 10

