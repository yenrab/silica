// Boolean ActorState; reply echoes state without mutation (edge: non-numeric state).

fn id(msg: int64, state: boolean) -> (:reply, boolean, boolean) {
    (:reply, state, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(false, id);
        r: boolean <- call(w, 0 impl ActorMessage {});
        _: atom <- print_bool(r);
        println("");
    produces
        pure :ok
    end
}
