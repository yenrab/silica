// Large int64 message (sanity for mailbox / call path with non-tiny literals).

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, acc);
        r: int64 <- call(w, 1000000 impl ActorMessage {});
        print_int64(r);
        println("");
    produces
        pure :ok
    end
}
