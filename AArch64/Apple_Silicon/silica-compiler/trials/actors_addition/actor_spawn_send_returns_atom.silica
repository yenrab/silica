// Spec §15–§16 / silica:ActorModel: spawn(initial_state, ...); send(actor_ref, message) -> atom
fn main() -> atom {
    sequence proc[concurrency]
        peer: actor_ref(int64) <- spawn(0, fn(msg: int64, state: int64) -> int64 {
            msg + state
        });
        ack: atom <- send(peer, 1);
    produces pure ack end
}
