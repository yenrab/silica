// Spec §16.1.2: cast enqueues asynchronously and returns boolean (actor exists vs terminated).
// §15.1.2: behavior for cast() returns (:no_reply, new_state).
// §16.3.2: message operand must satisfy ActorMessage (postfix or type-level impl).

impl ActorMessage for int64;

fn noop(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io, concurrency]
        println("Received message");
    produces
        pure :ok
    end
    (:no_reply, state)
}

fn main() -> atom {
    sequence proc[concurrency]
        peer: actor_ref <- spawn(0, noop);
        enqueued: boolean <- cast(peer, 42 impl ActorMessage {});
    produces
        pure :ok
    end
}
