	adrp	x8, _silica_rt_fault_handler_installed@PAGE
Lloh_ir1:
	add	x8, x8, _silica_rt_fault_handler_installed@PAGEOFF
	ldr	w9, [x8]
	cbnz	w9, LBBir_skip_handler
	mov	w9, #1
	str	w9, [x8]
	bl	_silica_rt_install_fault_handler
LBBir_skip_handler:
	mov	x0, #0
