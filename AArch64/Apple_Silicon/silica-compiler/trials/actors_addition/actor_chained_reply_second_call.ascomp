	mov	w2, #0
	movz	w3, #0x1002
	mov	w4, #-1
	mov	x5, #0
	bl	_mmap
	cmn	x0, #1
	b.eq	LBBir_fail
	mov	x20, x0
	movz	x1, #0x80, lsl #16
	mov	w2, #3
	bl	_mprotect
	str	x20, [x19, #160]
	movz	x8, #0x80, lsl #16
	str	x8, [x19, #168]
	add	x8, x20, #256
	str	x8, [x19, #176]
	movz	x8, #0x4000, lsl #16
	str	x8, [x19, #184]
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
LBBir_fail:
	str	xzr, [x19, #160]
	str	xzr, [x19, #168]
	str	xzr, [x19, #176]
	str	xzr, [x19, #184]
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
