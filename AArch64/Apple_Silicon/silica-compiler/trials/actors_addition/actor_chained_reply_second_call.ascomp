	.p2align	2
_silica_rt_stack_fault_handler:         ; SIGSEGV handler for growable actor stacks
	.cfi_startproc
; X0=sig X1=siginfo_t* X2=ucontext_t*
; Checks if fault is in current actor's region and maps the page on demand.
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	ldr	x19, [x1, #24]
Lloh_sh0:
	adrp	x0, _tl_current_actor@TLVPPAGE
Lloh_sh1:
	ldr	x0, [x0, _tl_current_actor@TLVPPAGEOFF]
	ldr	x8, [x0]
	blr	x8
	ldr	x20, [x0]
	cbz	x20, LBBfh_crash
	ldr	x21, [x20, #160]
	cbz	x21, LBBfh_crash
	ldr	x22, [x20, #184]
	add	x22, x21, x22
	cmp	x19, x21
	b.lo	LBBfh_crash
	cmp	x19, x22
	b.hs	LBBfh_overflow
	bic	x0, x19, #0xfff
	mov	x1, #0x1000
	mov	w2, #3
	bl	_mprotect
	ldr	x8, [x20, #160]
	bic	x9, x19, #0xfff
	add	x9, x9, #0x1000
	sub	x9, x9, x8
	ldr	x10, [x20, #168]
	cmp	x9, x10
	b.ls	LBBfh_done
	str	x9, [x20, #168]
LBBfh_done:
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
LBBfh_overflow:
	str	wzr, [x20, #152]
	add	x0, x20, #80
	bl	_pthread_cond_signal
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
LBBfh_crash:
