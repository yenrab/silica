// Three cast-only actors tagged X/Y/Z; round-robin casts (single println per delivery).
// Stresses three live actor_ref handles plus concurrent mailbox delivery; output order is observational.
// Trailing println("") delay helps async casts complete; actor output appears before "_sync".
// §16.1.2: cast.

fn tag_x(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("X");
        nx: int64 <- state + msg;
    produces
        pure (:no_reply, nx)
    end
}

fn tag_y(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("Y");
        ny: int64 <- state + msg;
    produces
        pure (:no_reply, ny)
    end
}

fn tag_z(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("Z");
        nz: int64 <- state + msg;
    produces
        pure (:no_reply, nz)
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        x: actor_ref <- spawn(0, tag_x);
        y: actor_ref <- spawn(0, tag_y);
        z: actor_ref <- spawn(0, tag_z);
        _: boolean <- cast(x, 1 impl ActorMessage {});
        _: boolean <- cast(y, 1 impl ActorMessage {});
        _: boolean <- cast(z, 1 impl ActorMessage {});
        _: boolean <- cast(x, 1 impl ActorMessage {});
        _: boolean <- cast(y, 1 impl ActorMessage {});
        _: boolean <- cast(z, 1 impl ActorMessage {});
        _: boolean <- cast(x, 1 impl ActorMessage {});
        _: boolean <- cast(y, 1 impl ActorMessage {});
        _: boolean <- cast(z, 1 impl ActorMessage {});
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("_sync");
    produces
        pure :ok
    end
}
