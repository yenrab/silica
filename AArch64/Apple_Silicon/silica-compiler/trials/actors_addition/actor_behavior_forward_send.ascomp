.text
.global main


main.sink:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.forwarder:     STP X29, X30, [SP, #-16]!

    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET
