// Spec §15: two actor_ref values from spawn; send(actor_ref, message) -> atom for each
fn main() -> atom {
    sequence proc[concurrency]
        left: actor_ref(int64) <- spawn(0);
        right: actor_ref(int64) <- spawn(1);
        send(left, 10);
        send(right, 20);
    produces pure :ok end
}
