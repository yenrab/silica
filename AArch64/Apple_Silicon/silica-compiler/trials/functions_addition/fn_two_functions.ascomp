.text
.global main


main.add:     STP X29, X30, [SP, #-16]!

    MOV X9, X0
    MOV X10, X1


    ADD X0, X9, X10
    LDP X29, X30, [SP], #16
    RET

main.mul:     STP X29, X30, [SP, #-16]!

    MOV X9, X0
    MOV X10, X1


    MUL X0, X9, X10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #4
    MOV X1, #5
    ; unsupported term kind ?
    ADRP X8, main.mul@PAGE
    ADD X8, X8, main.mul@PAGEOFF
    BLR X8
    MOV X10, X0
    STR X10, [SP, #-16]!
    MOV X0, #2
    MOV X1, #3
    ; unsupported term kind ?
    ADRP X8, main.add@PAGE
    ADD X8, X8, main.add@PAGEOFF
    BLR X8
    MOV X9, X0
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X29, X30, [SP], #16
    RET
