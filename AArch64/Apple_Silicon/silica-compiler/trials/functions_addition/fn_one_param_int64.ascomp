.text
.global main


main.double:     STP X29, X30, [SP, #-16]!

    MOV X9, X0
    MOV X10, #2


    MUL X0, X9, X10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #21
    ADRP X8, main.double@PAGE
    ADD X8, X8, main.double@PAGEOFF
    BLR X8
    LDP X29, X30, [SP], #16
    RET
