.text
.global main


main.sum_quad:     STP X29, X30, [SP, #-16]!


    MOV X12, X0
    MOV X11, X0
    LDR X1, [X11, #0]
    LDR X11, [X12, #8]
    LDR X2, [X11, #0]
    LDR X11, [X12, #8]
    LDR X3, [X11, #8]
    LDR X11, [X12, #8]
    LDR X4, [X11, #16]
    MOV X9, X1
    MOV X10, X2
    ADD X9, X9, X10
    MOV X10, X3
    ADD X9, X9, X10
    MOV X10, X4
    ADD X0, X9, X10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    MOV X1, #1
    STR X1, [SP, #0]
    SUB SP, SP, #32
    MOV X1, #2
    STR X1, [SP, #0]
    MOV X1, #3
    STR X1, [SP, #8]
    MOV X1, #4
    STR X1, [SP, #16]
    MOV X1, SP
    STR X1, [SP, #40]
    ADD X0, SP, #32
    ADRP X8, main.sum_quad@PAGE
    ADD X8, X8, main.sum_quad@PAGEOFF
    BLR X8
    ADD SP, SP, #48
    LDP X29, X30, [SP], #16
    RET
