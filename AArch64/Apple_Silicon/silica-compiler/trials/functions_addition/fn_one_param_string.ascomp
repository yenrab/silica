.text
.global main


main.id_string:     STP X29, X30, [SP, #-16]!


    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    ADRP X8, main.id_string@PAGE
    ADD X8, X8, main.id_string@PAGEOFF
    BLR X8
    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello"
    .byte 0

