.text
.global main


main.nullary:     STP X29, X30, [SP, #-16]!

    MOV X0, #42
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    ; unsupported term kind ?
    ADRP X8, main.nullary@PAGE
    ADD X8, X8, main.nullary@PAGEOFF
    BLR X8
    LDP X29, X30, [SP], #16
    RET
