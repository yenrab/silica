.text
.global main


main.sum5:     STP X29, X30, [SP, #-16]!

    MOV X10, X4
    STR X10, [SP, #-16]!
    MOV X10, X3
    STR X10, [SP, #-16]!
    MOV X10, X2
    STR X10, [SP, #-16]!
    MOV X9, X0
    MOV X10, X1


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #1
    MOV X1, #2
    MOV X2, #3
    MOV X3, #4
    MOV X4, #5
    ; unsupported term kind ?
    ADRP X8, main.sum5@PAGE
    ADD X8, X8, main.sum5@PAGEOFF
    BLR X8
    LDP X29, X30, [SP], #16
    RET
