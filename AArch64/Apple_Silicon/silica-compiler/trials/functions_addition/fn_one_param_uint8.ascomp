.text
.global main


main.inc_u8:     STP X29, X30, [SP, #-16]!

    MOV W9, W0
    MOV W10, #1


    ADD W0, W9, W10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #100
    ADRP X8, main.inc_u8@PAGE
    ADD X8, X8, main.inc_u8@PAGEOFF
    BLR X8
    LDP X29, X30, [SP], #16
    RET
