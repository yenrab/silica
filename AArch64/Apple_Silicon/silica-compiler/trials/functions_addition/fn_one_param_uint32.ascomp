.text
.global main


main.inc_u32:     STP X29, X30, [SP, #-16]!

    MOV W9, W0
    MOV W10, #1


    ADD W0, W9, W10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_i64_0@PAGE
    LDR X0, [X0, L_i64_0@PAGEOFF]
    ADRP X8, main.inc_u32@PAGE
    ADD X8, X8, main.inc_u32@PAGEOFF
    BLR X8
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 100000

