.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV W10, #5
    STR W10, [SP, #-16]!
    MOV W10, #4
    STR W10, [SP, #-16]!
    MOV W9, #2
    MOV W10, #3


    MUL W9, W9, W10
    LDR W10, [SP], #16


    ADD W9, W9, W10
    LDR W10, [SP], #16


    MUL W0, W9, W10
    LDP X29, X30, [SP], #16
    RET
