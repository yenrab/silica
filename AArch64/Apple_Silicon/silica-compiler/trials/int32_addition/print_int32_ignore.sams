.text
.global main

    ; effects [device_io]
main:     STP X29, X30, [SP, #-16]!

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi32_0@PAGE
    ADD X1, X1, L_pi32_0@PAGEOFF
    MOV X2, #3

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_pi32_0:
    .byte  0x31, 0x32, 0x33, 0
