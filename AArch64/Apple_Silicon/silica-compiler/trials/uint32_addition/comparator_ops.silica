// Exercise comparison operators for uint32: <, ==, >, !=, >=, <=
// For each operator: one example where result is true, one where result is false.
// Output format per comparison: op_code, left, right, result
// op_code: 1=<, 2==, 3>, 4!=, 5>=, 6<=

fn main() -> atom {
    sequence proc[device_io] // < : true (5 < 10), false (10 < 5)
        _: atom <- print_uint32(1);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(10);
        _: atom <- print_bool(5 < 10);
        _: atom <- print_uint32(1);
        _: atom <- print_uint32(10);
        _: atom <- print_uint32(5);
        _: atom <- print_bool(10 < 5);

        // == : true (7 == 7), false (7 == 3)
        _: atom <- print_uint32(2);
        _: atom <- print_uint32(7);
        _: atom <- print_uint32(7);
        _: atom <- print_bool(7 == 7);
        _: atom <- print_uint32(2);
        _: atom <- print_uint32(7);
        _: atom <- print_uint32(3);
        _: atom <- print_bool(7 == 3);

        // > : true (10 > 5), false (5 > 10)
        _: atom <- print_uint32(3);
        _: atom <- print_uint32(10);
        _: atom <- print_uint32(5);
        _: atom <- print_bool(10 > 5);
        _: atom <- print_uint32(3);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(10);
        _: atom <- print_bool(5 > 10);

        // != : true (5 != 10), false (5 != 5)
        _: atom <- print_uint32(4);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(10);
        _: atom <- print_bool(5 != 10);
        _: atom <- print_uint32(4);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(5);
        _: atom <- print_bool(5 != 5);

        // >= : true (10 >= 5), true (5 >= 5), false (5 >= 10)
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(10);
        _: atom <- print_uint32(5);
        _: atom <- print_bool(10 >= 5);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(5);
        _: atom <- print_bool(5 >= 5);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(10);
        _: atom <- print_bool(5 >= 10);

        // <= : true (5 <= 10), true (5 <= 5), false (10 <= 5)
        _: atom <- print_uint32(6);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(10);
        _: atom <- print_bool(5 <= 10);
        _: atom <- print_uint32(6);
        _: atom <- print_uint32(5);
        _: atom <- print_uint32(5);
        _: atom <- print_bool(5 <= 5);
        _: atom <- print_uint32(6);
        _: atom <- print_uint32(10);
        _: atom <- print_uint32(5);
        result: atom <- print_bool(10 <= 5);
        produces pure result end
}
