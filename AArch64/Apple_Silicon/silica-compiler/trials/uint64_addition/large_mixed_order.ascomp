.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X10, #3
    STR X10, [SP, #-16]!
    ADRP X0, L_i64_0@PAGE
    LDR X0, [X0, L_i64_0@PAGEOFF]
    STR X0, [SP, #-16]!
    ADRP X9, L_i64_1@PAGE
    LDR X9, [X9, L_i64_1@PAGEOFF]
    ADRP X10, L_i64_2@PAGE
    LDR X10, [X10, L_i64_2@PAGEOFF]


    MUL X10, X9, X10
    LDR X9, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 1000000000000000

L_i64_1:
    .quad 1000000000

L_i64_2:
    .quad 1000000

