.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    ADRP X1, L_i64_0@PAGE
    LDR X1, [X1, L_i64_0@PAGEOFF]
    ADRP X2, L_i64_1@PAGE
    LDR X2, [X2, L_i64_1@PAGEOFF]
    ADD X1, X1, X2
    MOV X2, #1
    ADD X0, X1, X2
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 1000000000000000000

L_i64_1:
    .quad 2000000000000000000
