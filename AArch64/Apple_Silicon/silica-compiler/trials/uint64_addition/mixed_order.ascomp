.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X10, #2
    STR X10, [SP, #-16]!
    MOV X0, #10
    STR X0, [SP, #-16]!
    MOV X9, #20
    MOV X10, #5


    UDIV X10, X9, X10
    LDR X9, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    SUB X0, X9, X10
    LDP X29, X30, [SP], #16
    RET
