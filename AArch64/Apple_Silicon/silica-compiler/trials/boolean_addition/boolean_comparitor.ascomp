.text
.global main

    ; effects [device_io]
main:     STP X29, X30, [SP, #-16]!

    MOV X1, #1
    MOV X2, #0
    CMP X1, X2
    CSET X0, EQ
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #0

    LDP X29, X30, [SP], #16
    RET
L_pb_helper:
    CMP X0, #0
    B.eq L_pb_false_branch
    MOV X0, #1
    ADRP X1, L_pb_true@PAGE
    ADD X1, X1, L_pb_true@PAGEOFF
    MOV X2, #4
    MOV X16, #4
    SVC #0x80
    B L_pb_after
L_pb_false_branch:
    MOV X0, #1
    ADRP X1, L_pb_false@PAGE
    ADD X1, X1, L_pb_false@PAGEOFF
    MOV X2, #5
    MOV X16, #4
    SVC #0x80
L_pb_after:
    RET
.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0
