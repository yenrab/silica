.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    ADRP X9, L_i64_0@PAGE
    LDR X9, [X9, L_i64_0@PAGEOFF]
    STR X9, [SP, #8]
    MOV X0, SP
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #24

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, SP
    LDR X0, [SP, #0]
    LDR X1, [SP, #8]
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    MOV X2, #16

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    LDR X0, [SP, #0]
    ; effects [device_io]
    CMP X0, #0
    B.ne L_next_0
    ADRP X1, atom_0@PAGE
    ADD X1, X1, atom_0@PAGEOFF
    MOV X2, #3
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    B L_pa_after
L_next_0:
L_pa_after:
    LDR X0, [SP, #8]
    ; effects [device_io]
    BL L_pu_helper
    MOV X0, #0

    LDR X0, [SP, #0]
    ADD SP, SP, #16

    LDP X29, X30, [SP], #16
    RET
L_pu_helper:
    SUB SP, SP, #32
    MOV X10, SP
    ADD X10, X10, #24
    MOV X8, X10
    CMP X0, #0
    B.eq L_pu_zero
    MOV X9, #10
L_pu_loop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pu_loop
    B L_pu_do_write
L_pu_zero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pu_do_write:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    MOV X16, #4
    SVC #0x80
    ADD SP, SP, #32
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0

.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 12345678901234567890

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "about to decompose tuple"
    .byte 0
L_str_1:
    .ascii "\n"
    .byte 0
L_str_2:
    .ascii "decomposed tuple"
    .byte 0

L_newline:
    .byte 10

