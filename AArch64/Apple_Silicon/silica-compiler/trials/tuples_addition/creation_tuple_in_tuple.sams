.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    MOV W1, #1
    ADRP X2, L_str_0@PAGE
    ADD X2, X2, L_str_0@PAGEOFF
    SUB SP, SP, #16
    STR W1, [SP, #0]
    STR X2, [SP, #8]
    MOV X1, SP
    ADRP X2, L_i64_0@PAGE
    LDR X2, [X2, L_i64_0@PAGEOFF]
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X0, SP
    MOV X1, #1
    MOV X1, #2.0
    ADRP X2, L_str_1@PAGE
    ADD X2, X2, L_str_1@PAGEOFF
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X1, SP
    ADRP X2, L_str_2@PAGE
    ADD X2, X2, L_str_2@PAGEOFF
    SUB SP, SP, #16
    STR W1, [SP, #0]
    STR X2, [SP, #8]
    MOV X1, SP
    MOV X0, #42
    ADD SP, SP, #48

    ADD SP, SP, #32

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 123456789012345

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello 😱"
    .byte 0
L_str_1:
    .ascii "world 😱"
    .byte 0
L_str_2:
    .ascii " fdaewq5432k 😱"
    .byte 0

