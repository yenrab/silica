.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #32
    MOV X9, #75
    STR X9, [SP, #0]
    SUB SP, SP, #16
    ADRP X10, L_f64_0@PAGE
    LDR D9, [X10, L_f64_0@PAGEOFF]
    STR D9, [SP, #0]
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #24]
    ADRP X9, L_str_1@PAGE
    ADD X9, X9, L_str_1@PAGEOFF
    STR X9, [SP, #32]
    ADD X0, SP, #16
    MOV X1, X0
    MOV X12, X1
    LDR X2, [SP, #16]
    LDR X1, [SP, #24]
    LDR X0, [SP, #32]

    ADD SP, SP, #48

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.0

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 2.0

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "world"
    .byte 0
L_str_1:
    .ascii "suffix"
    .byte 0

