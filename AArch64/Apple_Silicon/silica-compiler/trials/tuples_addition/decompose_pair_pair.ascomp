.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #0
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #16]
    SUB SP, SP, #16
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #1
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #40]
    ADD X0, SP, #32
    MOV X1, X0
    LDR X2, [SP, #32]
    LDR X2, [SP, #40]
    MOV X0, #0
    ADD SP, SP, #48

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0

