.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    MOV W9, #1
    STR W9, [SP, #0]
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #8]
    MOV X0, SP
    SUB SP, SP, #16
    ADRP X10, L_f64_0@PAGE
    LDR D9, [X10, L_f64_0@PAGEOFF]
    STR D9, [SP, #0]
    ADRP X9, L_str_1@PAGE
    ADD X9, X9, L_str_1@PAGEOFF
    STR X9, [SP, #8]
    MOV X0, SP
    SUB SP, SP, #16
    MOV X9, SP
    STR X9, [SP, #0]
    ADRP X9, L_i64_0@PAGE
    LDR X9, [X9, L_i64_0@PAGEOFF]
    STR X9, [SP, #8]
    MOV X1, SP
    SUB SP, SP, #16
    MOV X9, SP
    STR X9, [SP, #0]
    ADRP X9, L_str_2@PAGE
    ADD X9, X9, L_str_2@PAGEOFF
    STR X9, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #32
    MOV X9, #75
    STR X9, [SP, #0]
    MOV X9, X2
    STR X9, [SP, #8]
    ADRP X9, L_str_2@PAGE
    ADD X9, X9, L_str_2@PAGEOFF
    STR X9, [SP, #16]
    MOV X2, SP
    MOV X0, #42
    ADD SP, SP, #32

    ADD SP, SP, #16

    ADD SP, SP, #16

    ADD SP, SP, #16

    ADD SP, SP, #16

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 123456789012345

.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.0

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 2.0

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello 😱"
    .byte 0
L_str_1:
    .ascii "world 😱"
    .byte 0
L_str_2:
    .ascii " fdaewq5432k 😱"
    .byte 0

