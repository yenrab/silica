.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    MOV W1, #1
    STR W1, [SP, #0]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    STR X1, [SP, #8]
    MOV X0, SP
    MOV X0, #42
    ADD SP, SP, #16

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello 😱"
    .byte 0

