.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV W1, #7
    STR W1, [SP, #0]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    STR X1, [SP, #8]
    MOV X1, SP
    STR X1, [SP, #16]
    MOV X1, #42
    STR X1, [SP, #24]
    ADD X1, SP, #16
    MOV X2, X1
    LDR X0, [SP, #16]
    LDR X0, [SP, #24]
    LDR W0, [SP, #16]
    LDR W1, [SP, #0]
    LDR X0, [SP, #8]
    LDR W0, [SP, #0]
    ADD SP, SP, #32

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello"
    .byte 0

