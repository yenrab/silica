.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    MOV X1, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X1, #999
    MOV W1, #42
    MOV X1, #0
    MOV W1, #-1
    MOV W1, #100
    MOV W1, #2000
    MOV X1, #30000
    ADRP X0, L_f64_0@PAGE
    LDR D2, [X0, L_f64_0@PAGEOFF]
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR D2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR W1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR W1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR W1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR W1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X1, SP
    MOV W0, #0
    ADD SP, SP, #144

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0

.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 3.14

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hi"
    .byte 0

