.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #80
    MOV X9, #1
    STR X9, [SP, #0]
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #8]
    MOV X9, #999
    STR X9, [SP, #16]
    MOV W9, #42
    STR W9, [SP, #24]
    MOV X9, #0
    STR X9, [SP, #32]
    MOV W9, #-1
    STR W9, [SP, #40]
    MOV W9, #100
    STR W9, [SP, #48]
    MOV W9, #2000
    STR W9, [SP, #56]
    MOV X9, #30000
    STR X9, [SP, #64]
    ADRP X10, L_f64_0@PAGE
    LDR D9, [X10, L_f64_0@PAGEOFF]
    STR D9, [SP, #72]
    MOV X1, SP
    MOV W0, #0
    ADD SP, SP, #80

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0

.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 3.14

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 3.14

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hi"
    .byte 0

