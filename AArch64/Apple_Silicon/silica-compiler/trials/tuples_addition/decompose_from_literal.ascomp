.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    MOV X1, #10
    STR X1, [SP, #0]
    MOV X1, #20
    STR X1, [SP, #8]
    MOV X0, SP
    LDR X0, [SP, #0]
    LDR X1, [SP, #8]
    LDR X9, [SP, #0]
    LDR X10, [SP, #8]
    ADD X0, X9, X10
    ADD SP, SP, #16

    LDP X29, X30, [SP], #16
    RET
