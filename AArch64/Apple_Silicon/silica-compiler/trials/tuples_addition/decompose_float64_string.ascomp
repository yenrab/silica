.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    ADRP X0, L_f64_0@PAGE
    LDR D1, [X0, L_f64_0@PAGEOFF]
    STR D1, [SP, #0]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    STR X1, [SP, #8]
    MOV X0, SP
    MOV X1, X0
    LDR D0, [SP, #0]
    LDR X0, [SP, #8]
    LDR X0, [SP, #8]
    ADD SP, SP, #16

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.0

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "world"
    .byte 0

