.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    ADRP X10, L_f64_0@PAGE
    LDR D9, [X10, L_f64_0@PAGEOFF]
    STR D9, [SP, #0]
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X0, SP
    LDR D0, [SP, #0]
    LDR X0, [SP, #8]

    ADD SP, SP, #16

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.0

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 2.0

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "world"
    .byte 0

