.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV W1, #1
    STR W1, [SP, #0]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    STR X1, [SP, #8]
    MOV X1, SP
    STR X1, [SP, #16]
    ADRP X1, L_i64_0@PAGE
    LDR X1, [X1, L_i64_0@PAGEOFF]
    STR X1, [SP, #24]
    ADD X0, SP, #16
    SUB SP, SP, #32
    SUB SP, SP, #32
    MOV X1, #1
    STR X1, [SP, #0]
    MOV X1, #2.0
    STR X1, [SP, #8]
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    STR X1, [SP, #16]
    MOV X1, SP
    STR X1, [SP, #32]
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    STR X1, [SP, #40]
    ADD X1, SP, #32
    MOV X0, #42
    ADD SP, SP, #64

    ADD SP, SP, #32

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 123456789012345

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello 😱"
    .byte 0
L_str_1:
    .ascii "world 😱"
    .byte 0
L_str_2:
    .ascii " fdaewq5432k 😱"
    .byte 0

