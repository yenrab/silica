.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    MOV X1, #0
    ADRP X2, L_i64_0@PAGE
    LDR X2, [X2, L_i64_0@PAGEOFF]
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X1, SP
    MOV W0, #42
    ADD SP, SP, #16

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 12345678901234567890

