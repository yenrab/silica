.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    MOV X1, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    ADRP X2, L_i64_0@PAGE
    LDR X2, [X2, L_i64_0@PAGEOFF]
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X1, SP
    MOV W0, #42
    ADD SP, SP, #32

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0

.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 123456789012345

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello 😱"
    .byte 0

