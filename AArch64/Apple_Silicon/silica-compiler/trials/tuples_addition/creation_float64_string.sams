.text
.global main

    ; pure
main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f64_0@PAGE
    LDR D1, [X0, L_f64_0@PAGEOFF]
    ADRP X2, L_str_0@PAGE
    ADD X2, X2, L_str_0@PAGEOFF
    SUB SP, SP, #16
    STR D1, [SP, #0]
    STR X2, [SP, #8]
    MOV X0, SP
    MOV X0, #42
    ADD SP, SP, #16

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.0

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "world"
    .byte 0

