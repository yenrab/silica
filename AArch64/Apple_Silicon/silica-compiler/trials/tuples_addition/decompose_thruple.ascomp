.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #32
    MOV X1, #1
    STR X1, [SP, #0]
    MOV X1, #2
    STR X1, [SP, #8]
    MOV X1, #3
    STR X1, [SP, #16]
    MOV X0, SP
    MOV X1, X0
    LDR X2, [SP, #0]
    LDR X0, [SP, #8]
    LDR X0, [SP, #16]
    LDR X2, [SP, #8]
    LDR X1, [SP, #0]
    ADD X1, X1, X2
    LDR X2, [SP, #16]
    ADD X0, X1, X2
    ADD SP, SP, #32

    LDP X29, X30, [SP], #16
    RET
