.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #2
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #16]
    MOV X9, #3
    STR X9, [SP, #24]
    ADD X9, SP, #16
    STR X9, [SP, #32]
    MOV X9, #4
    STR X9, [SP, #40]
    ADD X0, SP, #32
    MOV X1, X0
    LDR X2, [SP, #32]
    LDR X0, [SP, #40]

    ADD SP, SP, #48

    LDP X29, X30, [SP], #16
    RET
