.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV X1, #1
    STR X1, [SP, #0]
    MOV X1, #2
    STR X1, [SP, #8]
    MOV X1, SP
    STR X1, [SP, #16]
    MOV X1, #3
    STR X1, [SP, #24]
    ADD X1, SP, #16
    STR X1, [SP, #32]
    MOV X1, #4
    STR X1, [SP, #40]
    ADD X0, SP, #32
    MOV X1, X0
    LDR X2, [SP, #32]
    LDR X0, [SP, #40]

    ADD SP, SP, #48

    LDP X29, X30, [SP], #16
    RET
