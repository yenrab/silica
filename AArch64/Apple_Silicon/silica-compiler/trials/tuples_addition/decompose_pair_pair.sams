.text
.global main

    ; effects [device_io]
main:     STP X29, X30, [SP, #-16]!

    MOV X1, #1
    MOV X2, #0
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X1, SP
    MOV X1, #1
    MOV X2, #1
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X2, SP
    SUB SP, SP, #16
    STR X1, [SP, #0]
    STR X2, [SP, #8]
    MOV X0, SP
    MOV X1, X0
    LDR X2, [SP, #0]
    LDR X0, [SP, #8]
    MOV X0, #42
    ADD SP, SP, #48

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0

