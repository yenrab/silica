.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X0, #0

    ; effects [device_io]
    CMP X0, #0
    B.ne L_next_blah_9_0
    ADRP X1, atom_0@PAGE
    ADD X1, X1, atom_0@PAGEOFF
    MOV X2, #5
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    B L_pa_blah_9_after
L_next_blah_9_0:
    CMP X0, #1
    B.ne L_next_blah_9_1
    ADRP X1, atom_1@PAGE
    ADD X1, X1, atom_1@PAGEOFF
    MOV X2, #3
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    B L_pa_blah_9_after
L_next_blah_9_1:
L_pa_blah_9_after:
    MOV X0, #1
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x66, 0x61, 0x69, 0x6c, 0
atom_1:
    .byte  0x3a, 0x6f, 0x6b, 0
