// Recursively count Unicode scalars (matches length_chars) using substring; no lists
fn str_len_rec(s: string) -> int64 {
    case length_chars(s) == 0 of {
        true -> 0;
        false -> 1 + str_len_rec(substring(s, 1, length_chars(s)))
    }
}

fn main() -> int64 {
    r: int64 <- str_len_rec("hello");
    r * 1
}
