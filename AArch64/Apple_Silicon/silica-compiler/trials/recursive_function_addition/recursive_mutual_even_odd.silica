// Mutual recursion: even(8) = 1, odd(7) = 0 -> 1
fn even(n: int64) -> int64 {
    case n == 0 of {
        true -> 1;
        false -> odd(n - 1)
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

fn main() -> int64 {
    even(8) + odd(7)
}
