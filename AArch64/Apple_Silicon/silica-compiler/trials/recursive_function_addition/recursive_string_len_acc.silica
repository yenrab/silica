// Tail recursion: string length via accumulator (matches length_chars)
fn str_len_acc(s: string, acc: int64) -> int64 {
    case length_chars(s) == 0 of {
        true -> acc;
        false -> str_len_acc(substring(s, 1, length_chars(s)), acc + 1)
    }
}

fn main() -> int64 {
    r: int64 <- str_len_acc("hello", 0);
    r * 1
}
