.text
.global main


main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f32_1@PAGE
    LDR S1, [X0, L_f32_1@PAGEOFF]
    ADRP X0, L_f32_2@PAGE
    LDR S2, [X0, L_f32_2@PAGEOFF]
    FMUL S2, S1, S2
    ADRP X0, L_f32_0@PAGE
    LDR S1, [X0, L_f32_0@PAGEOFF]
    FADD S0, S1, S2
    FCVTZS W0, S0
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 2.5

L_f32_1:
    .single 3.2

L_f32_2:
    .single 3.9375

