// List AST lowering helpers (list_implementation_design.md §5–§7): SIR prims for lists.
// Backend lowers list_nil / list_cons / list_length / list_head / list_remove_head to region+buffer code.

use sir_ast;
use types;
use type_checker_lists;

export is_list_primitive_name/1;
export build_list_nil/2;
export build_list_cons/3;
export build_list_length_prim/1;
export build_list_head_prim/2;
export build_list_remove_head_prim/2;

fn is_list_primitive_name(n: string) -> bool {
    type_checker_lists@is_list_primitive_name(n)
}

fn elem_type_tag_const(elem_t: string) -> SIRTerm {
    case elem_t of {
        "int8" -> SIRTerm { kind: 0, type_name: "int8", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "int16" -> SIRTerm { kind: 0, type_name: "int16", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "int32" -> SIRTerm { kind: 0, type_name: "int32", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "int64" -> SIRTerm { kind: 0, type_name: "int64", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "uint8" -> SIRTerm { kind: 0, type_name: "uint8", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "uint16" -> SIRTerm { kind: 0, type_name: "uint16", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "uint32" -> SIRTerm { kind: 0, type_name: "uint32", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "uint64" -> SIRTerm { kind: 0, type_name: "uint64", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "float32" -> SIRTerm { kind: 0, type_name: "float32", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "float64" -> SIRTerm { kind: 0, type_name: "float64", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        "boolean" -> SIRTerm { kind: 0, type_name: "bool", value: "false", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
        _: string -> SIRTerm { kind: 0, type_name: "int64", value: "0", name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
    }
}

fn build_list_nil(elem_t: string, list_t: string) -> SIRTerm {
    lt_sir: string <- types@type_name_to_sir(list_t);
    tag: SIRTerm <- elem_type_tag_const(elem_t);
    SIRTerm { kind: 6, type_name: lt_sir, value: "", name: "list_nil", inner: tag, right_expr: sir_ast@dummy_sir_term() }
}

fn build_list_cons(head: SIRTerm, tail: SIRTerm, list_t: string) -> SIRTerm {
    lt_sir: string <- types@type_name_to_sir(list_t);
    SIRTerm { kind: 6, type_name: lt_sir, value: "", name: "list_cons", inner: head, right_expr: tail }
}

fn build_list_length_prim(list_arg: SIRTerm) -> SIRTerm {
    SIRTerm { kind: 6, type_name: "int64", value: "", name: "list_length", inner: list_arg, right_expr: sir_ast@dummy_sir_term() }
}

fn build_list_head_prim(list_arg: SIRTerm, elem_t: string) -> SIRTerm {
    elem_sir: string <- types@type_name_to_sir(elem_t);
    SIRTerm { kind: 6, type_name: elem_sir, value: "", name: "list_head", inner: list_arg, right_expr: sir_ast@dummy_sir_term() }
}

fn build_list_remove_head_prim(list_arg: SIRTerm, list_t: string) -> SIRTerm {
    lt_sir: string <- types@type_name_to_sir(list_t);
    SIRTerm { kind: 6, type_name: lt_sir, value: "", name: "list_remove_head", inner: list_arg, right_expr: sir_ast@dummy_sir_term() }
}
