// User-defined function calls to SIR (Expr kind 4, extension)
// Calls to user-defined functions (fn add(x, y) -> T) become call(callee, args)
// tail_call (kind 5) when the call is in tail position (sir_design_spec §5.2.6).
// effect_value: effect set + optional |sir_rec:... metadata (recursion_terms)

use sir_ast;
use types;

export build_user_call_0/3;
export build_user_call_1/4;
export build_user_call_2/5;
export build_user_call_3/6;
export build_user_call_with_rest/5;
export build_tail_call_0/3;
export build_tail_call_1/4;
export build_tail_call_2/5;
export build_tail_call_3/6;
export build_tail_call_with_rest/5;
export qual_name/1;

fn qual_name(name: string) -> string {
    case name of {
        "main" -> "main";
        "m" -> "main";
        _: string -> concat("main.", name)
    }
}

fn build_user_call_0(callee_name: string, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    SIRTerm { kind: 4, type_name: sir_type, value: effect_value, name: callee, inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}

fn build_user_call_1(callee_name: string, arg1: SIRTerm, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    SIRTerm { kind: 4, type_name: sir_type, value: effect_value, name: callee, inner: arg1, right_expr: sir_ast@dummy_sir_term() }
}

fn build_user_call_2(callee_name: string, arg1: SIRTerm, arg2: SIRTerm, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    SIRTerm { kind: 4, type_name: sir_type, value: effect_value, name: callee, inner: arg1, right_expr: arg2 }
}

fn build_user_call_3(callee_name: string, arg1: SIRTerm, arg2: SIRTerm, arg3: SIRTerm, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    rest: SIRTerm <- SIRTerm { kind: 6, type_name: "unit", value: "", name: "user_call_rest", inner: arg2, right_expr: arg3 };
    SIRTerm { kind: 4, type_name: sir_type, value: effect_value, name: callee, inner: arg1, right_expr: rest }
}

fn build_user_call_with_rest(callee_name: string, arg1: SIRTerm, rest: SIRTerm, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    SIRTerm { kind: 4, type_name: sir_type, value: effect_value, name: callee, inner: arg1, right_expr: rest }
}

fn build_tail_call_0(callee_name: string, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    SIRTerm { kind: 5, type_name: sir_type, value: effect_value, name: callee, inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}

fn build_tail_call_1(callee_name: string, arg1: SIRTerm, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    SIRTerm { kind: 5, type_name: sir_type, value: effect_value, name: callee, inner: arg1, right_expr: sir_ast@dummy_sir_term() }
}

fn build_tail_call_2(callee_name: string, arg1: SIRTerm, arg2: SIRTerm, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    SIRTerm { kind: 5, type_name: sir_type, value: effect_value, name: callee, inner: arg1, right_expr: arg2 }
}

fn build_tail_call_3(callee_name: string, arg1: SIRTerm, arg2: SIRTerm, arg3: SIRTerm, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    rest: SIRTerm <- SIRTerm { kind: 6, type_name: "unit", value: "", name: "user_call_rest", inner: arg2, right_expr: arg3 };
    SIRTerm { kind: 5, type_name: sir_type, value: effect_value, name: callee, inner: arg1, right_expr: rest }
}

fn build_tail_call_with_rest(callee_name: string, arg1: SIRTerm, rest: SIRTerm, expected_type: string, effect_value: string) -> SIRTerm {
    callee: string <- qual_name(callee_name);
    sir_type: string <- types@type_name_to_sir(expected_type);
    SIRTerm { kind: 5, type_name: sir_type, value: effect_value, name: callee, inner: arg1, right_expr: rest }
}
