// Literal expression to SIR term (Expr kind 0, extension)

use parser_ast;
use type_checker_core;
use sir_ast;
use types;

export expr_to_sir/2;
export expr_to_sir_with_type/3;

// Build SIR const term for integer literal (Expr kind 0), default int64
fn expr_to_sir(context: TypeContext, expr: Expr) -> SIRTerm {
    expr_to_sir_with_type(context, expr, "int64")
}

// Char literal lexeme to int64 decimal string (ASCII). Handles common chars for substring_until_char trials.
fn char_lexeme_to_int64_string(lexeme: string) -> string {
    inner: string <- case len(lexeme) >= 3 of { true -> substring(lexeme, 1, 2); false -> "" };
    case inner of {
        " " -> "32";
        "," -> "44";
        "x" -> "120";
        "z" -> "122";
        "\n" -> "10";
        "\t" -> "9";
        _: string -> "0"
    }
}

// Build SIR const term for integer literal (Expr kind 0), default int64. Char literals become int64 (helper uses low byte).
fn expr_to_sir_with_type(context: TypeContext, expr: Expr, type_name: string) -> SIRTerm {
    (sir_type: string, val: string) <- case type_name == "char" of {
        true -> ("int64", char_lexeme_to_int64_string(expr.value));
        false -> (types@type_name_to_sir(type_name), expr.value)
    };
    SIRTerm { kind: 0, type_name: sir_type, value: val, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}
