// Term dispatcher: Expr -> SIRTerm (Expr.kind registry)
// Delegates to literals, identifiers per Expr.kind
// Core+extensions: add capability = add file + one case branch here

use parser_ast;
use type_checker_core;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use sir_ast;
use literals;
use identifiers;
use atoms;
use string_literals;
use boolean_terms;
use int64_binary_ops;
use int32_binary_ops;
use int16_binary_ops;
use int8_binary_ops;
use uint64_binary_ops;
use uint32_binary_ops;
use uint16_binary_ops;
use uint8_binary_ops;
use float64_binary_ops;
use float32_binary_ops;
use int64_calls;
use float32_calls;
use int32_calls;
use int16_calls;
use int8_calls;
use string_calls;
use tuple_decompose;
use types;
use memory_region_calls;
use user_calls;
use recursion_terms;
use negate_builtins;

export expr_to_sir/2;
export expr_to_sir_with_expected/3;
export expr_to_sir_function_body/3;

fn expr_to_sir_tuple_decompose(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    rhs_type_lookup: string <- tuple_decompose@expr_type_of(expr.inner, context);
    rhs_type: string <- case len(rhs_type_lookup) < 2 or substring(rhs_type_lookup, 0, 1) != "(" of {
        true -> type_checker_tuple_decompose_helpers@build_pattern_type_from_bindings(expr.pattern_bindings);
        false -> rhs_type_lookup
    };
    case len(rhs_type) < 2 or substring(rhs_type, 0, 1) != "(" of {
        true -> sir_ast@dummy_sir_term();
        false -> do
            bindings: ListTupleDecomposeBinding <- expr.pattern_bindings;
            rhs_term: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, rhs_type);
            extended_context: TypeContext <- add_bindings_to_context(context, bindings);
            body: SIRTerm <- expr_to_sir_in_let_body(extended_context, expr.right_expr, "", "", expected_type);
            tuple_decompose@build_decompose_lets(rhs_term, bindings, body, context, rhs_type)
        end
    }
}

fn expr_to_sir_tuple_decompose_in_body(context: TypeContext, expr: Expr, bound_name: string, bound_type: string, expected_type: string) -> SIRTerm {
    rhs_type_lookup: string <- tuple_decompose@expr_type_of(expr.inner, context);
    rhs_type: string <- case len(rhs_type_lookup) < 2 or substring(rhs_type_lookup, 0, 1) != "(" of {
        true -> type_checker_tuple_decompose_helpers@build_pattern_type_from_bindings(expr.pattern_bindings);
        false -> rhs_type_lookup
    };
    case len(rhs_type) < 2 or substring(rhs_type, 0, 1) != "(" of {
        true -> sir_ast@dummy_sir_term();
        false -> do
            bindings: ListTupleDecomposeBinding <- expr.pattern_bindings;
            rhs_term: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, rhs_type);
            extended_context: TypeContext <- add_bindings_to_context(context, bindings);
            body: SIRTerm <- expr_to_sir_in_let_body(extended_context, expr.right_expr, "", "", expected_type);
            tuple_decompose@build_decompose_lets(rhs_term, bindings, body, context, rhs_type)
        end
    }
}

fn add_bindings_to_context(context: TypeContext, bindings: ListTupleDecomposeBinding) -> TypeContext {
    case bindings.is_nil of {
        true -> context;
        false -> do
            b: TupleDecomposeBinding <- bindings.head;
            new_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, b.name, b.type_str, parser_ast@empty_effect_name_list());
            new_context: TypeContext <- TypeContext { env: new_env };
            add_bindings_to_context(new_context, bindings.tail)
        end
    }
}

fn expr_to_sir_tuple_inline(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    first_type: string <- tuple_first_element_type(expected_type);
    rest_type: string <- tuple_rest_element_type(expected_type);
    first: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, first_type);
    second: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr, rest_type);
    sir_type: string <- types@type_name_to_sir(expected_type);
    SIRTerm { kind: 6, type_name: sir_type, value: "", name: "tuple_make", inner: first, right_expr: second }
}

fn tuple_first_element_type(tuple_type: string) -> string {
    elements: string <- tuple_inner_str(tuple_type);
    (first: string, _: string) <- tuple_split_first(elements);
    tuple_trim_ws(first)
}

fn tuple_rest_element_type(tuple_type: string) -> string {
    elements: string <- tuple_inner_str(tuple_type);
    (first: string, rest: string) <- tuple_split_first(elements);
    trimmed: string <- tuple_trim_ws(rest);
    case len(trimmed) == 0 of {
        true -> "";
        false -> case tuple_contains_comma(trimmed) of {
            true -> concat("(", concat(trimmed, ")"));
            false -> trimmed
        }
    }
}

fn tuple_inner_str(type_str: string) -> string {
    len_ts: int64 <- len(type_str);
    case len_ts < 2 of {
        true -> "";
        false -> case substring(type_str, 0, 1) == "(" of {
            true -> case substring(type_str, len_ts - 1, len_ts) == ")" of {
                true -> substring(type_str, 1, len_ts - 1);
                false -> ""
            };
            false -> ""
        }
    }
}

fn tuple_split_first(s: string) -> (string, string) {
    idx: int64 <- tuple_find_comma(s, 0);
    first: string <- substring(s, 0, idx);
    rest: string <- case idx < len(s) of {
        true -> substring(s, idx + 1, len(s));
        false -> ""
    };
    (first, rest)
}

fn tuple_find_comma(s: string, i: int64) -> int64 {
    tuple_find_comma_at_depth(s, i, 0)
}

fn tuple_find_comma_at_depth(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) of {
            "(" -> tuple_find_comma_at_depth(s, i + 1, depth + 1);
            ")" -> tuple_find_comma_at_depth(s, i + 1, depth - 1);
            "," -> case depth == 0 of {
                true -> i;
                false -> tuple_find_comma_at_depth(s, i + 1, depth)
            };
            _: string -> tuple_find_comma_at_depth(s, i + 1, depth)
        }
    }
}

fn tuple_contains_comma(s: string) -> bool {
    tuple_contains_comma_at(s, 0)
}

fn tuple_contains_comma_at(s: string, i: int64) -> bool {
    case i >= len(s) of {
        true -> false;
        false -> case substring(s, i, i + 1) == "," of {
            true -> true;
            false -> tuple_contains_comma_at(s, i + 1)
        }
    }
}

fn tuple_trim_ws(s: string) -> string {
    start: int64 <- tuple_trim_start(s, 0);
    len_s: int64 <- len(s);
    one_less: int64 <- len_s - 1;
    end_idx: int64 <- tuple_trim_end(s, one_less);
    case start <= end_idx of {
        true -> substring(s, start, end_idx + 1);
        false -> ""
    }
}

fn tuple_trim_start(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) == " " of {
            true -> tuple_trim_start(s, i + 1);
            false -> i
        }
    }
}

fn tuple_trim_end(s: string, i: int64) -> int64 {
    case i < 0 of {
        true -> -1;
        false -> case substring(s, i, i + 1) == " " of {
            true -> tuple_trim_end(s, i - 1);
            false -> i
        }
    }
}

fn sir_find_arrow_pos(s: string, i: int64) -> int64 {
    case i + 4 > len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 4) == " -> " of {
            true -> i;
            false -> sir_find_arrow_pos(s, i + 1)
        }
    }
}

fn sir_params_inner_from_func_type(func_type: string) -> string {
    arrow_pos: int64 <- sir_find_arrow_pos(func_type, 0);
    case arrow_pos < 0 of {
        true -> "";
        false -> do
            params_part: string <- substring(func_type, 0, arrow_pos);
            case len(params_part) < 2 of {
                true -> "";
                false -> substring(params_part, 1, len(params_part) - 1)
            }
        end
    }
}

fn user_call_expects_single_tuple_param(context: TypeContext, name: string) -> bool {
    (found: bool, func_type: string) <- type_checker_core@lookup_symbol_found(context.env, name);
    case found of {
        false -> false;
        true -> do
            params_inner: string <- sir_params_inner_from_func_type(func_type);
            case len(params_inner) < 2 of {
                true -> false;
                false -> case substring(params_inner, 0, 1) == "(" and substring(params_inner, len(params_inner) - 1, len(params_inner)) == ")" of {
                    true -> tuple_contains_comma(substring(params_inner, 1, len(params_inner) - 1));
                    false -> false
                }
            }
        end
    }
}

fn literal_type_for_expected(expected_type: string) -> string {
    case expected_type of {
        "" -> "int64";
        "int32" -> "int32";
        "int16" -> "int16";
        "int8" -> "int8";
        "uint64" -> "uint64";
        "uint32" -> "uint32";
        "uint16" -> "uint16";
        "uint8" -> "uint8";
        "float64" -> "float64";
        "float32" -> "float32";
        "float16" -> "float16";
        "char" -> "char";
        _: string -> case len(expected_type) >= 2 and substring(expected_type, 0, 1) == "(" of {
            true -> literal_type_for_expected(tuple_first_element_type(expected_type));
            false -> "int64"
        }
    }
}

// Sequence block (kind 11): lower sequence ... produces pure expr end to SIR let chain.
// Body (inner) = chain of let/tuple_decompose or dummy if empty. One let per step, pure expr as innermost.
// Emits only standard SIR terms (let, var, const, call, prim, case); no sequence/produces/pure in SIR.
fn lower_sequence_block_with_expected(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    lower_sequence_body_to_lets(context, expr.inner, expr.right_expr, expected_type, false, "", "")
}

fn lower_sequence_block_in_body(context: TypeContext, expr: Expr, bound_name: string, bound_type: string, expected_type: string) -> SIRTerm {
    lower_sequence_body_to_lets(context, expr.inner, expr.right_expr, expected_type, true, bound_name, bound_type)
}

fn lower_sequence_body_to_lets(context: TypeContext, body_expr: Expr, result_expr: Expr, expected_type: string, in_body: bool, bound_name: string, bound_type: string) -> SIRTerm {
    case body_expr.kind == -1 of {
        true -> case in_body of {
            true -> expr_to_sir_in_let_body(context, result_expr, bound_name, bound_type, expected_type);
            false -> expr_to_sir_with_expected(context, result_expr, expected_type)
        };
        false -> case body_expr.kind == 6 of {
            true -> do
                rhs: SIRTerm <- case in_body of {
                    true -> expr_to_sir_in_let_body(context, body_expr.inner, bound_name, bound_type, body_expr.value);
                    false -> expr_to_sir_with_expected(context, body_expr.inner, body_expr.value)
                };
                bind_type: string <- types@type_name_to_sir(body_expr.value);
                prefixed: string <- concat("%", body_expr.name);
                new_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, body_expr.name, body_expr.value, parser_ast@empty_effect_name_list());
                new_context: TypeContext <- TypeContext { env: new_env };
                inner_body: SIRTerm <- lower_sequence_body_to_lets(new_context, body_expr.right_expr, result_expr, expected_type, true, body_expr.name, body_expr.value);
                SIRTerm { kind: 2, type_name: bind_type, value: "", name: prefixed, inner: rhs, right_expr: inner_body }
            end;
            false -> case body_expr.kind == 10 of {
                true -> do
                    rhs_type_lookup: string <- tuple_decompose@expr_type_of(body_expr.inner, context);
                    rhs_type: string <- case len(rhs_type_lookup) < 2 or substring(rhs_type_lookup, 0, 1) != "(" of {
                        true -> type_checker_tuple_decompose_helpers@build_pattern_type_from_bindings(body_expr.pattern_bindings);
                        false -> rhs_type_lookup
                    };
                    case len(rhs_type) < 2 or substring(rhs_type, 0, 1) != "(" of {
                        true -> sir_ast@dummy_sir_term();
                        false -> do
                            bindings: ListTupleDecomposeBinding <- body_expr.pattern_bindings;
                            rhs_term: SIRTerm <- case in_body of {
                                true -> expr_to_sir_in_let_body(context, body_expr.inner, bound_name, bound_type, rhs_type);
                                false -> expr_to_sir_with_expected(context, body_expr.inner, rhs_type)
                            };
                            extended_context: TypeContext <- add_bindings_to_context(context, bindings);
                            body: SIRTerm <- lower_sequence_body_to_lets(extended_context, body_expr.right_expr, result_expr, expected_type, true, "", "");
                            decompose_lets: SIRTerm <- tuple_decompose@build_decompose_lets(rhs_term, bindings, body, context, rhs_type);
                            decompose_lets
                        end
                    }
                end;
                false -> do
                    rhs: SIRTerm <- case in_body of {
                        true -> expr_to_sir_in_let_body(context, body_expr, bound_name, bound_type, expected_type);
                        false -> expr_to_sir_with_expected(context, body_expr, expected_type)
                    };
                    result: SIRTerm <- case in_body of {
                        true -> expr_to_sir_in_let_body(context, result_expr, bound_name, bound_type, expected_type);
                        false -> expr_to_sir_with_expected(context, result_expr, expected_type)
                    };
                    SIRTerm { kind: 2, type_name: types@type_name_to_sir(expected_type), value: "", name: "%_", inner: rhs, right_expr: result }
                end
            }
        }
    }
}

// Convert Expr to SIRTerm when inside a let body. Uses bound_name/bound_type for identifiers.
// expected_type: function return type for body expressions.
fn expr_to_sir_in_let_body(context: TypeContext, expr: Expr, bound_name: string, bound_type: string, expected_type: string) -> SIRTerm {
    do
    ek_rel: int64 <- expr.kind - 13;
    case ek_rel == 0 of {
        true -> case_expr_to_sir(context, expr, expected_type, bound_name, bound_type, true);
        false -> case expr.kind of {
        0 -> literals@expr_to_sir_with_type(context, expr, literal_type_for_expected(expected_type));
        1 -> identifiers@expr_to_sir_with_bound(context, expr, bound_name, bound_type);
        2 -> expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, expected_type);
        5 -> atoms@expr_to_sir(context, expr);
        7 -> boolean_terms@expr_to_sir(context, expr);
        8 -> string_literals@expr_to_sir(context, expr);
        9 -> expr_to_sir_tuple_inline(context, expr, expected_type);
        10 -> expr_to_sir_tuple_decompose_in_body(context, expr, bound_name, bound_type, expected_type);
        11 -> lower_sequence_block_in_body(context, expr, bound_name, bound_type, expected_type);
        6 -> do
            rhs: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, expr.value);
            bind_type: string <- types@type_name_to_sir(expr.value);
            prefixed: string <- concat("%", expr.name);
            new_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, expr.name, expr.value, parser_ast@empty_effect_name_list());
            new_context: TypeContext <- TypeContext { env: new_env };
            body: SIRTerm <- expr_to_sir_in_let_body(new_context, expr.right_expr, expr.name, expr.value, expected_type);
            SIRTerm { kind: 2, type_name: bind_type, value: "", name: prefixed, inner: rhs, right_expr: body }
        end;
        3 -> do
            left: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, expected_type);
            right: SIRTerm <- expr_to_sir_in_let_body(context, expr.right_expr, bound_name, bound_type, expected_type);
            build_prim_for_type(expr.value, left, right, expected_type)
        end;
        4 -> do
            case memory_region_calls@is_region_builtin(expr.name) of {
                true -> build_region_prim_in_body(context, expr, bound_name, bound_type, expected_type);
                false -> case expr.name == "concatenate" of {
                    true -> do
                        arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, "string");
                        arg2: SIRTerm <- expr_to_sir_in_let_body(context, expr.right_expr.inner, bound_name, bound_type, "string");
                        string_calls@build_concatenate_from_sir(arg1, arg2)
                    end;
                    false -> case expr.name == "substring" of {
                        true -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                        true -> do
                            arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, "string");
                            arg2: SIRTerm <- expr_to_sir_in_let_body(context, expr.right_expr.inner, bound_name, bound_type, "int64");
                            arg3: SIRTerm <- expr_to_sir_in_let_body(context, expr.right_expr.right_expr.inner, bound_name, bound_type, "int64");
                            string_calls@build_substring_from_sir(arg1, arg2, arg3)
                        end;
                            false -> sir_ast@dummy_sir_term();
                        };
                        false -> case expr.name == "substring_until_char" of {
                            true -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                                true -> do
                                    arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, "string");
                                    arg2: SIRTerm <- expr_to_sir_in_let_body(context, expr.right_expr.inner, bound_name, bound_type, "int64");
                                    arg3: SIRTerm <- expr_to_sir_in_let_body(context, expr.right_expr.right_expr.inner, bound_name, bound_type, "char");
                                    string_calls@build_substring_until_char_from_sir(arg1, arg2, arg3)
                                end;
                                false -> sir_ast@dummy_sir_term();
                            };
                            false -> case negate_builtins@is_negate_builtin(expr.name) of {
                                true -> do
                                    arg_t: string <- negate_builtins@negate_arg_type(expr.name);
                                    arg: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, arg_t);
                                    negate_builtins@build_negate_from_sir(expr.name, arg)
                                end;
                                false -> case is_single_arg_builtin(expr.name) of {
                                    true -> do
                                        arg: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, arg_expected_type(expr.name, expected_type));
                                        build_single_arg_call(context, expr, arg);
                                    end;
                                    false -> build_user_call_from_expr_in_body(context, expr, bound_name, bound_type, expected_type)
                                };
                            }
                        }
                    }
                }
            }
        end;
        19 -> if_expr_to_sir(context, expr, expected_type, bound_name, bound_type, true);
        _: int64 -> sir_ast@dummy_sir_term();
        }
    }
    end
}

fn build_single_arg_call(context: TypeContext, expr: Expr, arg: SIRTerm) -> SIRTerm {
    case expr.name == "print_atom" of {
        true -> atoms@build_print_atom_from_sir(expr.name, arg);
        false -> case expr.name == "print_int32" of {
            true -> int32_calls@build_print_int32_from_sir(expr.name, arg);
            false -> case expr.name == "print_uint32" of {
                true -> int32_calls@build_print_int32_from_sir(expr.name, arg);
                false -> case expr.name == "print_int16" of {
                    true -> int16_calls@build_print_int16_from_sir(expr.name, arg);
                    false -> case expr.name == "print_uint16" of {
                        true -> int16_calls@build_print_int16_from_sir(expr.name, arg);
                        false -> case expr.name == "print_int8" of {
                            true -> int8_calls@build_print_int8_from_sir(expr.name, arg);
                            false -> case expr.name == "print_uint8" of {
                                true -> int8_calls@build_print_int8_from_sir(expr.name, arg);
                                false -> case expr.name == "print_float32" of {
                                    true -> float32_calls@build_print_float32_from_sir(expr.name, arg);
                                    false -> case expr.name == "print_string" of {
                                        true -> string_calls@build_print_string_from_sir(expr.name, arg);
                                        false -> case expr.name == "println" of {
                                            true -> string_calls@build_println_from_sir(expr.name, arg);
                                            false -> case expr.name == "length_bytes" of {
                                                true -> string_calls@build_length_bytes_from_sir(arg);
                                                false -> case expr.name == "length_chars" of {
                                                    true -> string_calls@build_length_chars_from_sir(arg);
                                                    false -> int64_calls@build_call_from_sir(expr.name, arg)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn build_region_prim_in_body(context: TypeContext, expr: Expr, bound_name: string, bound_type: string, expected_type: string) -> SIRTerm {
    case expr.name == "fresh_lifetime" of {
        true -> build_region_prim_fresh_lifetime(expr.name, expected_type);
        false -> case expr.name == "alloc_region" or expr.name == "read_ref" of {
            true -> build_region_prim_in_body_1arg(context, expr, bound_name, bound_type, expected_type);
            false -> case expr.name == "alloc_ref" or expr.name == "alloc_rec" or expr.name == "alloc_atomic" or expr.name == "alloc_buf" or expr.name == "buf_load" or expr.name == "read_buf" or expr.name == "write_ref" of {
                true -> build_region_prim_in_body_2arg(context, expr, bound_name, bound_type, expected_type);
                false -> case expr.name == "buf_store" or expr.name == "write_buf" of {
                    true -> build_region_prim_in_body_buf_store(context, expr, bound_name, bound_type, expected_type);
                    false -> sir_ast@dummy_sir_term()
                }
            }
        }
    }
}

fn build_region_prim_fresh_lifetime(call_name: string, expected_type: string) -> SIRTerm {
    memory_region_calls@build_region_prim_from_sir(call_name, sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term(), expected_type)
}

fn build_region_prim_in_body_1arg(context: TypeContext, expr: Expr, bound_name: string, bound_type: string, expected_type: string) -> SIRTerm {
    arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, arg_type_for_region_prim(expr.name, 0, expected_type));
    memory_region_calls@build_region_prim_from_sir(expr.name, arg1, sir_ast@dummy_sir_term(), expected_type)
}

// Parser represents f(a,b) as call(inner=a, right=pair("", inner=b, right=...)); see extract_call_rest.
fn region_call_second_arg(expr: Expr) -> Expr {
    case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
        true -> expr.right_expr.inner;
        false -> expr.right_expr
    }
}

fn build_region_prim_in_body_2arg(context: TypeContext, expr: Expr, bound_name: string, bound_type: string, expected_type: string) -> SIRTerm {
    arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, arg_type_for_region_prim_inferred(expr.name, 0, expected_type, expr, context));
    arg2: SIRTerm <- expr_to_sir_in_let_body(context, region_call_second_arg(expr), bound_name, bound_type, arg_type_for_region_prim_inferred(expr.name, 1, expected_type, expr, context));
    memory_region_calls@build_region_prim_from_sir(expr.name, arg1, arg2, expected_type)
}

// write_buf(buf, idx, val): after first arg, parser builds pair(idx, pair(val, dummy)).
fn buf_store_value_expr(expr: Expr) -> Expr {
    case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
        true -> case expr.right_expr.right_expr.kind == 4 and expr.right_expr.right_expr.name == "" of {
            true -> expr.right_expr.right_expr.inner;
            false -> expr.right_expr.right_expr
        };
        false -> expr.right_expr
    }
}

fn build_region_prim_in_body_buf_store(context: TypeContext, expr: Expr, bound_name: string, bound_type: string, expected_type: string) -> SIRTerm {
    arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, arg_type_for_region_prim_inferred(expr.name, 0, expected_type, expr, context));
    arg2: SIRTerm <- build_buf_store_arg2_in_body(context, expr, bound_name, bound_type, expected_type);
    memory_region_calls@build_region_prim_from_sir(expr.name, arg1, arg2, expected_type)
}

fn build_buf_store_arg2_in_body(context: TypeContext, expr: Expr, bound_name: string, bound_type: string, expected_type: string) -> SIRTerm {
    case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
        true -> do
            idx: SIRTerm <- expr_to_sir_in_let_body(context, expr.right_expr.inner, bound_name, bound_type, "int64");
            val_type: string <- arg_type_for_region_prim_inferred(expr.name, 2, expected_type, expr, context);
            val: SIRTerm <- expr_to_sir_in_let_body(context, buf_store_value_expr(expr), bound_name, bound_type, val_type);
            sir_type: string <- types@type_name_to_sir(val_type);
            SIRTerm { kind: 6, type_name: sir_type, value: "", name: "tuple_make", inner: idx, right_expr: val }
        end;
        false -> sir_ast@dummy_sir_term()
    }
}

fn build_region_prim(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    case expr.name == "fresh_lifetime" of {
        true -> build_region_prim_fresh_lifetime(expr.name, expected_type);
        false -> case expr.name == "alloc_region" or expr.name == "read_ref" of {
            true -> build_region_prim_1arg(context, expr, expected_type);
            false -> case expr.name == "alloc_ref" or expr.name == "alloc_rec" or expr.name == "alloc_atomic" or expr.name == "alloc_buf" or expr.name == "buf_load" or expr.name == "read_buf" or expr.name == "write_ref" of {
                true -> build_region_prim_2arg(context, expr, expected_type);
                false -> case expr.name == "buf_store" or expr.name == "write_buf" of {
                    true -> build_region_prim_buf_store(context, expr, expected_type);
                    false -> sir_ast@dummy_sir_term()
                }
            }
        }
    }
}

fn build_region_prim_1arg(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg_type_for_region_prim(expr.name, 0, expected_type));
    memory_region_calls@build_region_prim_from_sir(expr.name, arg1, sir_ast@dummy_sir_term(), expected_type)
}

fn build_region_prim_2arg(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg_type_for_region_prim_inferred(expr.name, 0, expected_type, expr, context));
    arg2: SIRTerm <- expr_to_sir_with_expected(context, region_call_second_arg(expr), arg_type_for_region_prim_inferred(expr.name, 1, expected_type, expr, context));
    memory_region_calls@build_region_prim_from_sir(expr.name, arg1, arg2, expected_type)
}

fn build_region_prim_buf_store(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg_type_for_region_prim_inferred(expr.name, 0, expected_type, expr, context));
    arg2: SIRTerm <- build_buf_store_arg2(context, expr, expected_type);
    memory_region_calls@build_region_prim_from_sir(expr.name, arg1, arg2, expected_type)
}

fn build_buf_store_arg2(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
        true -> do
            idx: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr.inner, "int64");
            val_type: string <- arg_type_for_region_prim_inferred(expr.name, 2, expected_type, expr, context);
            val: SIRTerm <- expr_to_sir_with_expected(context, buf_store_value_expr(expr), val_type);
            sir_type: string <- types@type_name_to_sir(val_type);
            SIRTerm { kind: 6, type_name: sir_type, value: "", name: "tuple_make", inner: idx, right_expr: val }
        end;
        false -> sir_ast@dummy_sir_term()
    }
}

fn arg_type_for_region_prim(call_name: string, arg_idx: int64, expected_type: string) -> string {
    case call_name of {
        "alloc_region" -> "space";
        "alloc_ref" -> case arg_idx of { 0 -> type_checker_memory_regions@ref_type_to_region_type(expected_type); 1 -> type_checker_memory_regions@extract_element_type_from_ref(expected_type); _: int64 -> expected_type };
        "alloc_rec" -> case arg_idx of { 0 -> type_checker_memory_regions@ref_type_to_region_type(expected_type); 1 -> type_checker_memory_regions@extract_element_type_from_ref(expected_type); _: int64 -> expected_type };
        "read_ref" -> expected_type;
        "write_ref" -> case arg_idx of { 0 -> "ref(R, normal, int64)"; 1 -> expected_type; _: int64 -> "int64" };
        "alloc_buf" -> case arg_idx of { 0 -> type_checker_memory_regions@buf_type_to_region_type(expected_type); 1 -> "int64"; _: int64 -> "int64" };
        "buf_load" -> case arg_idx of { 0 -> expected_type; 1 -> "int64"; _: int64 -> "int64" };
        "read_buf" -> case arg_idx of { 0 -> expected_type; 1 -> "int64"; _: int64 -> "int64" };
        "buf_store" -> case arg_idx of { 0 -> expected_type; 1 -> "int64"; 2 -> expected_type; _: int64 -> "int64" };
        "write_buf" -> case arg_idx of { 0 -> expected_type; 1 -> "int64"; 2 -> expected_type; _: int64 -> "int64" };
        "alloc_atomic" -> case arg_idx of { 0 -> type_checker_memory_regions@atomic_ref_type_to_region_type(expected_type); 1 -> type_checker_memory_regions@extract_element_type_from_atomic_ref(expected_type); _: int64 -> expected_type };
        "fresh_lifetime" -> "lifetime";
        _: string -> expected_type
    }
}

// Arg type when inference from expr is needed (buf_load, read_buf, buf_store, write_buf)
fn arg_type_for_region_prim_inferred(call_name: string, arg_idx: int64, expected_type: string, expr: Expr, context: TypeContext) -> string {
    case call_name == "buf_load" or call_name == "read_buf" of {
        true -> case arg_idx of { 0 -> type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context); 1 -> "int64"; _: int64 -> expected_type };
        false -> case call_name == "buf_store" or call_name == "write_buf" of {
            true -> case arg_idx of {
                0 -> type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                1 -> "int64";
                2 -> type_checker_memory_regions@extract_element_type_from_buf(type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context));
                _: int64 -> expected_type
            };
            false -> arg_type_for_region_prim(call_name, arg_idx, expected_type)
        }
    }
}

fn build_rest_chain_in_body(context: TypeContext, curried: Expr, bound_name: string, bound_type: string) -> SIRTerm {
    case curried.kind == 4 and curried.name == "" of {
        true -> do
            arg_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(curried.inner, context);
            arg: SIRTerm <- expr_to_sir_in_let_body(context, curried.inner, bound_name, bound_type, arg_type);
            rest: SIRTerm <- build_rest_chain_in_body(context, curried.right_expr, bound_name, bound_type);
            SIRTerm { kind: 6, type_name: "unit", value: "", name: "user_call_rest", inner: arg, right_expr: rest }
        end;
        false -> do
            arg_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(curried, context);
            expr_to_sir_in_let_body(context, curried, bound_name, bound_type, arg_type)
        end
    }
}

fn build_user_call_from_expr_in_body(context: TypeContext, expr: Expr, bound_name: string, bound_type: string, expected_type: string) -> SIRTerm {
    case expr.inner.kind < 0 of {
        true -> user_calls@build_user_call_0(expr.name, expected_type, recursion_terms@user_call_effect_value_fn(expr));
        false -> case expr.right_expr.kind < 0 of {
            true -> do
                arg1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, arg1_type);
                user_calls@build_user_call_1(expr.name, arg1, expected_type, recursion_terms@user_call_effect_value_fn(expr))
            end;
            false -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                true -> do
                    arg1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                    arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, arg1_type);
                    rest: SIRTerm <- build_rest_chain_in_body(context, expr.right_expr, bound_name, bound_type);
                    user_calls@build_user_call_with_rest(expr.name, arg1, rest, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                end;
                false -> case user_call_expects_single_tuple_param(context, expr.name) of {
                    true -> do
                        (found: bool, func_type: string) <- type_checker_core@lookup_symbol_found(context.env, expr.name);
                        tuple_param: string <- sir_params_inner_from_func_type(func_type);
                        first_type: string <- tuple_first_element_type(tuple_param);
                        second_type: string <- tuple_rest_element_type(tuple_param);
                        arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, first_type);
                        arg2: SIRTerm <- expr_to_sir_in_let_body(context, expr.right_expr, bound_name, bound_type, second_type);
                        sir_type: string <- types@type_name_to_sir(tuple_param);
                        tuple_arg: SIRTerm <- SIRTerm { kind: 6, type_name: sir_type, value: "", name: "tuple_make", inner: arg1, right_expr: arg2 };
                        user_calls@build_user_call_1(expr.name, tuple_arg, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                    end;
                    false -> do
                        arg1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                        arg2_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.right_expr, context);
                        arg1: SIRTerm <- expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, arg1_type);
                        arg2: SIRTerm <- expr_to_sir_in_let_body(context, expr.right_expr, bound_name, bound_type, arg2_type);
                        user_calls@build_user_call_2(expr.name, arg1, arg2, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                    end
                }
            }
        }
    }
}

fn build_rest_chain(context: TypeContext, curried: Expr) -> SIRTerm {
    case curried.kind == 4 and curried.name == "" of {
        true -> do
            arg_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(curried.inner, context);
            arg: SIRTerm <- expr_to_sir_with_expected(context, curried.inner, arg_type);
            rest: SIRTerm <- build_rest_chain(context, curried.right_expr);
            SIRTerm { kind: 6, type_name: "unit", value: "", name: "user_call_rest", inner: arg, right_expr: rest }
        end;
        false -> do
            arg_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(curried, context);
            expr_to_sir_with_expected(context, curried, arg_type)
        end
    }
}

fn build_user_call_from_expr(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    case expr.inner.kind < 0 of {
        true -> user_calls@build_user_call_0(expr.name, expected_type, recursion_terms@user_call_effect_value_fn(expr));
        false -> case expr.right_expr.kind < 0 of {
            true -> do
                arg1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg1_type);
                user_calls@build_user_call_1(expr.name, arg1, expected_type, recursion_terms@user_call_effect_value_fn(expr))
            end;
            false -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                true -> do
                    arg1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                    arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg1_type);
                    rest: SIRTerm <- build_rest_chain(context, expr.right_expr);
                    user_calls@build_user_call_with_rest(expr.name, arg1, rest, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                end;
                false -> case user_call_expects_single_tuple_param(context, expr.name) of {
                    true -> do
                        (found: bool, func_type: string) <- type_checker_core@lookup_symbol_found(context.env, expr.name);
                        tuple_param: string <- sir_params_inner_from_func_type(func_type);
                        first_type: string <- tuple_first_element_type(tuple_param);
                        second_type: string <- tuple_rest_element_type(tuple_param);
                        arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, first_type);
                        arg2: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr, second_type);
                        sir_type: string <- types@type_name_to_sir(tuple_param);
                        tuple_arg: SIRTerm <- SIRTerm { kind: 6, type_name: sir_type, value: "", name: "tuple_make", inner: arg1, right_expr: arg2 };
                        user_calls@build_user_call_1(expr.name, tuple_arg, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                    end;
                    false -> do
                        arg1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                        arg2_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.right_expr, context);
                        arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg1_type);
                        arg2: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr, arg2_type);
                        user_calls@build_user_call_2(expr.name, arg1, arg2, expected_type, recursion_terms@user_call_effect_value_fn(expr))
                    end
                }
            }
        }
    }
}

// True when the function body is a single Expr (kind 4) that lowers to a user call (not builtin).
// Used to emit tail_call (kind 5) for phase 5 / p3 back-edge metadata on the root body only.
fn root_body_is_tail_user_call(expr: Expr) -> bool {
    case expr.kind == 4 of {
        false -> false;
        true -> case memory_region_calls@is_region_builtin(expr.name) of {
            true -> false;
            false -> case expr.name == "concatenate" of {
                true -> false;
                false -> case expr.name == "substring" of {
                    true -> false;
                    false -> case expr.name == "substring_until_char" of {
                        true -> false;
                        false -> case negate_builtins@is_negate_builtin(expr.name) of {
                            true -> false;
                            false -> case is_single_arg_builtin(expr.name) of {
                                true -> false;
                                false -> true
                            }
                        }
                    }
                }
            }
        }
    }
}

fn build_user_call_from_expr_tail(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    case expr.inner.kind < 0 of {
        true -> user_calls@build_tail_call_0(expr.name, expected_type, recursion_terms@user_call_effect_value_fn_tail(expr));
        false -> case expr.right_expr.kind < 0 of {
            true -> do
                arg1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg1_type);
                user_calls@build_tail_call_1(expr.name, arg1, expected_type, recursion_terms@user_call_effect_value_fn_tail(expr))
            end;
            false -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                true -> do
                    arg1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                    arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg1_type);
                    rest: SIRTerm <- build_rest_chain(context, expr.right_expr);
                    user_calls@build_tail_call_with_rest(expr.name, arg1, rest, expected_type, recursion_terms@user_call_effect_value_fn_tail(expr))
                end;
                false -> case user_call_expects_single_tuple_param(context, expr.name) of {
                    true -> do
                        (found: bool, func_type: string) <- type_checker_core@lookup_symbol_found(context.env, expr.name);
                        tuple_param: string <- sir_params_inner_from_func_type(func_type);
                        first_type: string <- tuple_first_element_type(tuple_param);
                        second_type: string <- tuple_rest_element_type(tuple_param);
                        arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, first_type);
                        arg2: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr, second_type);
                        sir_type: string <- types@type_name_to_sir(tuple_param);
                        tuple_arg: SIRTerm <- SIRTerm { kind: 6, type_name: sir_type, value: "", name: "tuple_make", inner: arg1, right_expr: arg2 };
                        user_calls@build_tail_call_1(expr.name, tuple_arg, expected_type, recursion_terms@user_call_effect_value_fn_tail(expr))
                    end;
                    false -> do
                        arg1_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                        arg2_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.right_expr, context);
                        arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg1_type);
                        arg2: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr, arg2_type);
                        user_calls@build_tail_call_2(expr.name, arg1, arg2, expected_type, recursion_terms@user_call_effect_value_fn_tail(expr))
                    end
                }
            }
        }
    }
}

fn expr_to_sir_function_body(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    case root_body_is_tail_user_call(expr) of {
        true -> build_user_call_from_expr_tail(context, expr, expected_type);
        false -> expr_to_sir_with_expected(context, expr, expected_type)
    }
}

fn is_single_arg_builtin(call_name: string) -> bool {
    call_name == "print_atom" or call_name == "print_int32" or call_name == "print_uint32" or call_name == "print_int16" or call_name == "print_uint16" or call_name == "print_int8" or call_name == "print_uint8" or call_name == "print_float32" or call_name == "print_string" or call_name == "println" or call_name == "length_bytes" or call_name == "length_chars" or call_name == "print_int64" or call_name == "print_uint64" or call_name == "print_bool" or call_name == "print_float64"
}

fn arg_expected_type(call_name: string, expected_type: string) -> string {
    case call_name of {
        "concatenate" -> "string";
        "substring" -> "string";
        "substring_until_char" -> "string";
        "print_string" -> "string";
        "println" -> "string";
        "length_bytes" -> "string";
        "length_chars" -> "string";
        "print_int32" -> "int32";
        "print_uint32" -> "uint32";
        "print_int16" -> "int16";
        "print_uint16" -> "uint16";
        "print_int8" -> "int8";
        "print_uint8" -> "uint8";
        "print_uint64" -> "uint64";
        "print_float64" -> "float64";
        "print_float32" -> "float32";
        _: string -> expected_type
    }
}

fn build_prim_for_type(op_lexeme: string, left: SIRTerm, right: SIRTerm, expected_type: string) -> SIRTerm {
    case expected_type of {
        "int32" -> int32_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "int16" -> int16_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "int8" -> int8_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "uint64" -> uint64_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "uint32" -> uint32_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "uint16" -> uint16_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "uint8" -> uint8_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "float64" -> float64_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "float32" -> float32_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        _: string -> int64_binary_ops@build_prim_from_sir(op_lexeme, left, right)
    }
}

// Convert Expr to SIRTerm with expected type (for function body). Dispatches on kind.
fn expr_to_sir_with_expected(context: TypeContext, expr: Expr, expected_type: string) -> SIRTerm {
    do
    ek_rel: int64 <- expr.kind - 13;
    case ek_rel == 0 of {
        true -> case_expr_to_sir(context, expr, expected_type, "", "", false);
        false -> case expr.kind of {
        0 -> literals@expr_to_sir_with_type(context, expr, literal_type_for_expected(expected_type));
        1 -> identifiers@expr_to_sir(context, expr);
        2 -> expr_to_sir_with_expected(context, expr.inner, expected_type);
        5 -> atoms@expr_to_sir(context, expr);
        7 -> boolean_terms@expr_to_sir(context, expr);
        8 -> string_literals@expr_to_sir(context, expr);
        9 -> expr_to_sir_tuple_inline(context, expr, expected_type);
        10 -> expr_to_sir_tuple_decompose(context, expr, expected_type);
        11 -> lower_sequence_block_with_expected(context, expr, expected_type);
        6 -> do
            rhs: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, expr.value);
            bind_type: string <- types@type_name_to_sir(expr.value);
            prefixed: string <- concat("%", expr.name);
            new_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, expr.name, expr.value, parser_ast@empty_effect_name_list());
            new_context: TypeContext <- TypeContext { env: new_env };
            body: SIRTerm <- expr_to_sir_in_let_body(new_context, expr.right_expr, expr.name, expr.value, expected_type);
            SIRTerm { kind: 2, type_name: bind_type, value: "", name: prefixed, inner: rhs, right_expr: body }
        end;
        3 -> do
            left: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, expected_type);
            right: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr, expected_type);
            build_prim_for_type(expr.value, left, right, expected_type)
        end;
        4 -> do
            case memory_region_calls@is_region_builtin(expr.name) of {
                true -> build_region_prim(context, expr, expected_type);
                false -> case expr.name == "concatenate" of {
                    true -> do
                        arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, "string");
                        arg2: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr.inner, "string");
                        string_calls@build_concatenate_from_sir(arg1, arg2)
                    end;
                    false -> case expr.name == "substring" of {
                        true -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                        true -> do
                            arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, "string");
                            arg2: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr.inner, "int64");
                            arg3: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr.right_expr.inner, "int64");
                            string_calls@build_substring_from_sir(arg1, arg2, arg3)
                        end;
                            false -> sir_ast@dummy_sir_term();
                        };
                        false -> case expr.name == "substring_until_char" of {
                            true -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                                true -> do
                                    arg1: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, "string");
                                    arg2: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr.inner, "int64");
                                    arg3: SIRTerm <- expr_to_sir_with_expected(context, expr.right_expr.right_expr.inner, "char");
                                    string_calls@build_substring_until_char_from_sir(arg1, arg2, arg3)
                                end;
                                false -> sir_ast@dummy_sir_term();
                            };
                            false -> case negate_builtins@is_negate_builtin(expr.name) of {
                                true -> do
                                    arg_t: string <- negate_builtins@negate_arg_type(expr.name);
                                    arg: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg_t);
                                    negate_builtins@build_negate_from_sir(expr.name, arg)
                                end;
                                false -> case is_single_arg_builtin(expr.name) of {
                                    true -> do
                                        arg_type: string <- arg_expected_type(expr.name, expected_type);
                                        arg: SIRTerm <- expr_to_sir_with_expected(context, expr.inner, arg_type);
                                        build_single_arg_call(context, expr, arg);
                                    end;
                                    false -> build_user_call_from_expr(context, expr, expected_type)
                                };
                            }
                        }
                    }
                }
            }
        end;
        19 -> if_expr_to_sir(context, expr, expected_type, "", "", false);
        _: int64 -> sir_ast@dummy_sir_term();
        }
    }
    end
}

// Convert Expr to SIRTerm. Dispatches on kind. Uses int64 as default for literals/binary ops.
// Kind 0: integer literal -> const(type, value)
// Kind 1: identifier -> var(%name)
// Kind 2: parenthesized -> recurse on inner
// Kind 3: binary op -> prim(add/sub/etc)
// Kind 4: call -> call(callee, arg)
// Kind 5: atom literal -> const(atom, value)
// Kind 6: let binding -> let(name, type, rhs, body)
fn expr_to_sir(context: TypeContext, expr: Expr) -> SIRTerm {
    expr_to_sir_with_expected(context, expr, "int64")
}

// --- case expression (Expr kind 13) -> SIR kind 3; branch list kind 7; branch kind 8 ---

fn extend_context_for_bind(ctx: TypeContext, name: string, ast_type: string) -> TypeContext {
    new_env: ListSymbolEntry <- type_checker_core@add_symbol(ctx.env, name, ast_type, parser_ast@empty_effect_name_list());
    TypeContext { env: new_env }
}

fn trim_leading_ws(s: string) -> string {
    case len(s) == 0 of {
        true -> "";
        false -> case substring(s, 0, 1) == " " of {
            true -> trim_leading_ws(substring(s, 1, len(s)));
            false -> s
        }
    }
}

fn trim_trailing_ws(s: string) -> string {
    case len(s) == 0 of {
        true -> "";
        false -> case substring(s, len(s) - 1, len(s)) == " " of {
            true -> trim_trailing_ws(substring(s, 0, len(s) - 1));
            false -> s
        }
    }
}

fn trim_pat(s: string) -> string {
    trim_trailing_ws(trim_leading_ws(s))
}

fn find_colon_from(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == ":" of {
            true -> i;
            false -> find_colon_from(s, i + 1)
        }
    }
}

fn is_digit_char(c: string) -> bool {
    c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or c == "5" or c == "6" or c == "7" or c == "8" or c == "9"
}

fn all_digits_from(s: string, i: int64) -> bool {
    case i >= len(s) of {
        true -> len(s) > 0;
        false -> case is_digit_char(substring(s, i, i + 1)) of {
            true -> all_digits_from(s, i + 1);
            false -> false
        }
    }
}

fn is_int_literal_pat(t: string) -> bool {
    case len(t) == 0 of {
        true -> false;
        false -> case substring(t, 0, 1) == "-" of {
            true -> case len(t) > 1 of { true -> all_digits_from(t, 1); false -> false };
            false -> all_digits_from(t, 0)
        }
    }
}

fn make_case_branch(pkind: string, ptype: string, pname: string, ctx_use: TypeContext, branch: Expr, expected_type: string, bound_name: string, bound_type: string, in_body: bool) -> SIRTerm {
    guard_sir: SIRTerm <- case branch.inner.kind < 0 of {
        true -> sir_ast@dummy_sir_term();
        false -> case in_body of {
            true -> expr_to_sir_in_let_body(ctx_use, branch.inner, bound_name, bound_type, "boolean");
            false -> expr_to_sir_with_expected(ctx_use, branch.inner, "boolean")
        }
    };
    body_sir: SIRTerm <- case in_body of {
        true -> expr_to_sir_in_let_body(ctx_use, branch.right_expr, bound_name, bound_type, expected_type);
        false -> expr_to_sir_with_expected(ctx_use, branch.right_expr, expected_type)
    };
    SIRTerm { kind: 8, type_name: ptype, value: pkind, name: pname, inner: guard_sir, right_expr: body_sir }
}

// Pattern text like "hello" (string literal) — no colon; must not fall through to branch_from_bind_or_wild (dummy).
fn case_close_quote_index(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "\"" of {
            true -> i;
            false -> case_close_quote_index(s, i + 1)
        }
    }
}

fn extract_string_pat_content(s: string) -> string {
    case len(s) < 2 of {
        true -> "";
        false -> case substring(s, 0, 1) == "\"" of {
            true -> do
                cq: int64 <- case_close_quote_index(s, 1);
                case cq < 0 of {
                    true -> "";
                    false -> substring(s, 1, cq)
                }
            end;
            false -> ""
        }
    }
}

fn branch_from_bind_or_wild(raw: string, scrutinee_ast_type: string, branch: Expr, ctx: TypeContext, expected_type: string, bound_name: string, bound_type: string, in_body: bool) -> SIRTerm {
    cp: int64 <- find_colon_from(raw, 0);
    case cp < 1 of {
        true -> sir_ast@dummy_sir_term();
        false -> do
            left: string <- trim_pat(substring(raw, 0, cp));
            right: string <- trim_pat(substring(raw, cp + 1, len(raw)));
            case left == "_" of {
                true -> make_case_branch("wild", types@type_name_to_sir(right), "_", ctx, branch, expected_type, bound_name, bound_type, in_body);
                false -> do
                    ctx_b: TypeContext <- extend_context_for_bind(ctx, left, right);
                    make_case_branch("bind", types@type_name_to_sir(right), concat("%", left), ctx_b, branch, expected_type, bound_name, bound_type, in_body)
                end
            }
        end
    }
}

fn branch_ast_to_sir(branch: Expr, ctx: TypeContext, expected_type: string, scrutinee_ast_type: string, bound_name: string, bound_type: string, in_body: bool) -> SIRTerm {
    raw: string <- trim_pat(branch.value);
    case raw == "true" of {
        true -> make_case_branch("bool", "bool", "true", ctx, branch, expected_type, bound_name, bound_type, in_body);
        false -> case raw == "false" of {
            true -> make_case_branch("bool", "bool", "false", ctx, branch, expected_type, bound_name, bound_type, in_body);
            false -> case substring(raw, 0, 1) == "\"" of {
                true -> do
                    str_content: string <- extract_string_pat_content(raw);
                    make_case_branch("string", "string", str_content, ctx, branch, expected_type, bound_name, bound_type, in_body)
                end;
                false -> case is_int_literal_pat(raw) of {
                    true -> make_case_branch("int", types@type_name_to_sir(scrutinee_ast_type), raw, ctx, branch, expected_type, bound_name, bound_type, in_body);
                    false -> branch_from_bind_or_wild(raw, scrutinee_ast_type, branch, ctx, expected_type, bound_name, bound_type, in_body)
                }
            }
        }
    }
}

fn case_branches_to_sir_list(e: Expr, ctx: TypeContext, expected_type: string, scrutinee_ast_type: string, bound_name: string, bound_type: string, in_body: bool) -> SIRTerm {
    case e.kind < 0 of {
        true -> sir_ast@dummy_sir_term();
        false -> case e.kind - 17 == 0 of {
            true -> do
                one: SIRTerm <- branch_ast_to_sir(e.inner, ctx, expected_type, scrutinee_ast_type, bound_name, bound_type, in_body);
                rest: SIRTerm <- case_branches_to_sir_list(e.right_expr, ctx, expected_type, scrutinee_ast_type, bound_name, bound_type, in_body);
                SIRTerm { kind: 7, type_name: "", value: "", name: "", inner: one, right_expr: rest }
            end;
            false -> sir_ast@dummy_sir_term()
        }
    }
}

fn case_expr_to_sir(context: TypeContext, expr: Expr, expected_type: string, bound_name: string, bound_type: string, in_body: bool) -> SIRTerm {
    scrut_ast_t: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
    scrut_sir_t: string <- types@type_name_to_sir(scrut_ast_t);
    scrut: SIRTerm <- case in_body of {
        true -> expr_to_sir_in_let_body(context, expr.inner, bound_name, bound_type, scrut_ast_t);
        false -> expr_to_sir_with_expected(context, expr.inner, scrut_ast_t);
    };
    branches: SIRTerm <- case_branches_to_sir_list(expr.right_expr, context, expected_type, scrut_ast_t, bound_name, bound_type, in_body);
    case_emit_suffix: string <- concat("o", literals@int64_to_decimal_string(expr.location.offset));
    SIRTerm { kind: 3, type_name: types@type_name_to_sir(expected_type), value: scrut_sir_t, name: case_emit_suffix, inner: scrut, right_expr: branches }
}

// Lower `if` / `else` (AST kind 19) to a boolean `case` on the condition. Placed after `case_expr_to_sir`; callers use forward reference.
fn if_expr_to_sir(context: TypeContext, expr: Expr, expected_type: string, bound_name: string, bound_type: string, in_body: bool) -> SIRTerm {
    dummy_g: Expr <- parser_ast@dummy_expr();
    true_br: Expr <- Expr { kind: 18, value: "true", name: "", location: expr.location, inner: dummy_g, right_expr: expr.right_expr.inner, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
    false_br: Expr <- Expr { kind: 18, value: "false", name: "", location: expr.location, inner: dummy_g, right_expr: expr.right_expr.right_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
    rest_dummy: Expr <- parser_ast@dummy_expr();
    list_inner: Expr <- Expr { kind: 17, value: "", name: "", location: expr.location, inner: false_br, right_expr: rest_dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
    list_head: Expr <- Expr { kind: 17, value: "", name: "", location: expr.location, inner: true_br, right_expr: list_inner, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
    case_e: Expr <- Expr { kind: 13, value: "", name: "", location: expr.location, inner: expr.inner, right_expr: list_head, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
    case_expr_to_sir(context, case_e, expected_type, bound_name, bound_type, in_body)
}
