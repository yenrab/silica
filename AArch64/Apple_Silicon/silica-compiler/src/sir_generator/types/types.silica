// SIR type name mapping (base)
// Maps AST type names (Declaration.return_type_name) to SIR type strings

export type_name_to_sir/1;

// Map AST type name to SIR type string (for term syntax and function signatures)
fn type_name_to_sir(name: string) -> string {
    case name of {
        "boolean" -> "bool";
        "atom" -> "atom";
        _: string -> name
    }
}
