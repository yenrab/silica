// Capability: unary negate_<numeric-type>/1 builtins (parser surface)
// Lexer emits distinct kinds (lexer_keywords + lexer_token_kind.is_negate_builtin_kind).
// Call and operand roles for these names come from capability_expr_int64_ops and
// capability_expr_float32 via is_identifier_lexeme_token (includes negate kinds).
// Names: negate_int8 … negate_int64, negate_float16 … negate_float64 (no negate_uint*, no negate_unit)

use constraint_core;

export constraints/0;
export initial_roles/1;

fn constraints() -> ListConstraint {
    constraint_core@empty_list_constraint()
}

fn initial_roles(token_kind: int64) -> ListInt {
    constraint_core@empty_list_int()
}
