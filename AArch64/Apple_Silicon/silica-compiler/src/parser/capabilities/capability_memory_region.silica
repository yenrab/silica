// Capability: memory region types - ref(R, Space, T), region(R, Space), buf(R, Space, T, N); atomic uses ref(R, atomic, T)
// Supports: bindings, function return types, function parameters
// Memory space keywords: normal, normal_writeback, normal_writethrough, normal_noncacheable, atomic, device

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes for memory region (60-68). Integrates with bind's role_bind_type (42), role_tuple_type_lparen (44).
// role_memory_type_start: ref, region, buf as type constructors
// role_atomic_prefix: "atomic ref" parses as ref(R, Space, T) (Space often atomic)
fn role_memory_type_start() -> int64 { 60 }
fn role_atomic_prefix() -> int64 { 61 }
fn role_tuple_type_lparen() -> int64 { 44 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn constraints() -> ListConstraint {
    // ref/region/buf (role_memory_type_start) must be followed by ( to open params
    c1: Constraint <- Constraint { trigger_role: role_memory_type_start(), next_token_roles: single_role(role_tuple_type_lparen()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 60 };
    // atomic (role_atomic_prefix) must be followed by ref (role_memory_type_start)
    c2: Constraint <- Constraint { trigger_role: role_atomic_prefix(), next_token_roles: single_role(role_memory_type_start()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 61 };
    constraint_core@cons_constraint(c1, constraint_core@cons_constraint(c2, constraint_core@empty_list_constraint()))
}

fn is_memory_space_keyword(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.normal_keyword or token_kind == kinds.normal_writeback_keyword or token_kind == kinds.normal_writethrough_keyword or token_kind == kinds.normal_noncacheable_keyword or token_kind == kinds.atomic_keyword or token_kind == kinds.device_keyword
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.ref_keyword of {
        true -> single_role(role_memory_type_start());
        false -> case token_kind == kinds.region_keyword of {
            true -> single_role(role_memory_type_start());
            false -> case token_kind == kinds.buf_keyword of {
                true -> single_role(role_memory_type_start());
                false -> case token_kind == kinds.atomic_keyword of {
                    true -> single_role(role_atomic_prefix());
                    false -> case is_memory_space_keyword(kinds, token_kind) of {
                        true -> single_role(42);
                        false -> constraint_core@empty_list_int()
                    }
                }
            }
        }
    }
}
