// Capability: case expression — case expr of { branches }
// Grammar (spec): case_expression ::= "case" expression "of" "{" {case_branch} "}"
// case_branch ::= pattern ["if" expression] "->" expression ";"
// Roles 110–125: case surface + pattern + RHS duplicate chain (avoids merging operand 12 with case_rhs_operand 120)

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;
export role_case_keyword/0;
export role_case_of/0;
export role_case_branch_arrow/0;
export role_case_pat_int/0;
export role_case_pat_ident/0;
export role_case_pat_colon/0;
export role_case_pat_type/0;
export role_case_guard_if/0;
export role_case_pat_bool/0;
export role_case_branch_stmt_sep/0;
export role_case_rhs_operand/0;
export role_case_rhs_op/0;
export role_case_rhs_call_name/0;
export role_case_rhs_lparen/0;
export role_case_rhs_rparen/0;
export role_case_rhs_unary_minus/0;
export role_case_branch_lbrace/0;

fn role_case_keyword() -> int64 { 110 }
fn role_case_of() -> int64 { 111 }
fn role_case_branch_arrow() -> int64 { 112 }
fn role_case_pat_int() -> int64 { 113 }
fn role_case_pat_ident() -> int64 { 114 }
fn role_case_pat_colon() -> int64 { 115 }
fn role_case_pat_type() -> int64 { 116 }
fn role_case_guard_if() -> int64 { 117 }
fn role_case_pat_bool() -> int64 { 118 }
fn role_case_branch_stmt_sep() -> int64 { 119 }
fn role_case_rhs_operand() -> int64 { 120 }
fn role_case_rhs_op() -> int64 { 121 }
fn role_case_rhs_call_name() -> int64 { 122 }
fn role_case_rhs_lparen() -> int64 { 123 }
fn role_case_rhs_rparen() -> int64 { 124 }
fn role_case_rhs_unary_minus() -> int64 { 125 }
fn role_case_branch_lbrace() -> int64 { 126 }

fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_operand() -> int64 { 12 }
fn role_op() -> int64 { 13 }
fn role_call_name() -> int64 { 14 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }
fn role_right_arrow() -> int64 { 5 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> ListInt {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> ListInt {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> ListInt {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn six_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64) -> ListInt {
    constraint_core@cons_int(r1, five_roles(r2, r3, r4, r5, r6))
}

fn seven_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64) -> ListInt {
    constraint_core@cons_int(r1, six_roles(r2, r3, r4, r5, r6, r7))
}

fn case_rhs_operand_next() -> ListInt {
    constraint_core@cons_int(role_case_rhs_op(), four_roles(role_right_brace(), role_case_rhs_rparen(), role_case_branch_stmt_sep(), role_case_branch_arrow()))
}

fn case_rhs_operand_prev() -> ListInt {
    four_roles(role_case_rhs_op(), role_case_rhs_lparen(), role_case_branch_arrow(), role_case_rhs_unary_minus())
}

fn is_type_keyword(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.int8_keyword or token_kind == kinds.int16_keyword or token_kind == kinds.int32_keyword or token_kind == kinds.int64_keyword or token_kind == kinds.uint8_keyword or token_kind == kinds.uint16_keyword or token_kind == kinds.uint32_keyword or token_kind == kinds.uint64_keyword or token_kind == kinds.float16_keyword or token_kind == kinds.float32_keyword or token_kind == kinds.float64_keyword or token_kind == kinds.bool_keyword or token_kind == kinds.char_keyword or token_kind == kinds.string_keyword or token_kind == kinds.unit_keyword or token_kind == kinds.atom_keyword
}

fn is_arithmetic_op(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.plus or token_kind == kinds.minus or token_kind == kinds.star or token_kind == kinds.slash or token_kind == kinds.percent
}

fn is_comparison_op(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.less_than or token_kind == kinds.greater_than or token_kind == kinds.less_equal or token_kind == kinds.greater_equal or token_kind == kinds.equal_equal or token_kind == kinds.bang_equal
}

fn is_op_token(kinds: TokenKinds, token_kind: int64) -> bool {
    is_arithmetic_op(kinds, token_kind) or is_comparison_op(kinds, token_kind) or token_kind == kinds.and_keyword or token_kind == kinds.or_keyword
}

fn constraints() -> ListConstraint {
    // case_keyword -> scrutinee starters (same as body after {)
    c_kw: Constraint <- Constraint { trigger_role: role_case_keyword(), next_token_roles: five_roles(role_operand(), role_call_name(), role_op(), role_call_lparen(), role_call_rparen()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 110 };
    // of -> case_branch_lbrace (distinct from fn body left_brace)
    c_of: Constraint <- Constraint { trigger_role: role_case_of(), next_token_roles: single_role(role_case_branch_lbrace()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 111 };
    // { after of -> pattern start or empty }
    c_lb_case: Constraint <- Constraint { trigger_role: role_case_branch_lbrace(), next_token_roles: four_roles(role_case_pat_int(), role_case_pat_ident(), role_case_pat_bool(), role_right_brace()), prev_token_roles: single_role(role_case_of()), constraint_id: 112 };
    // pattern int / bool -> ->
    c_pi: Constraint <- Constraint { trigger_role: role_case_pat_int(), next_token_roles: single_role(role_case_branch_arrow()), prev_token_roles: two_roles(role_case_branch_lbrace(), role_case_branch_stmt_sep()), constraint_id: 113 };
    c_pb: Constraint <- Constraint { trigger_role: role_case_pat_bool(), next_token_roles: single_role(role_case_branch_arrow()), prev_token_roles: two_roles(role_case_branch_lbrace(), role_case_branch_stmt_sep()), constraint_id: 114 };
    // ident pattern -> : or ->
    c_pid: Constraint <- Constraint { trigger_role: role_case_pat_ident(), next_token_roles: two_roles(role_case_pat_colon(), role_case_branch_arrow()), prev_token_roles: two_roles(role_case_branch_lbrace(), role_case_branch_stmt_sep()), constraint_id: 115 };
    c_pcol: Constraint <- Constraint { trigger_role: role_case_pat_colon(), next_token_roles: single_role(role_case_pat_type()), prev_token_roles: single_role(role_case_pat_ident()), constraint_id: 116 };
    c_pt: Constraint <- Constraint { trigger_role: role_case_pat_type(), next_token_roles: two_roles(role_case_branch_arrow(), role_case_guard_if()), prev_token_roles: single_role(role_case_pat_colon()), constraint_id: 117 };
    c_gif: Constraint <- Constraint { trigger_role: role_case_guard_if(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_case_pat_type()), constraint_id: 118 };
    // branch arrow -> case rhs (not plain operand 12 — separate case_rhs chain)
    // prev includes case_rhs_rparen / case_rhs_operand so guard exprs can end with `)` or a literal/identifier before `->` (e.g. `if is_positive(z) ->`, `if true ->` in guard position)
    c_arr: Constraint <- Constraint { trigger_role: role_case_branch_arrow(), next_token_roles: four_roles(role_case_rhs_operand(), role_case_rhs_call_name(), role_case_rhs_lparen(), role_case_rhs_unary_minus()), prev_token_roles: seven_roles(role_case_pat_int(), role_case_pat_bool(), role_case_pat_type(), role_call_rparen(), role_operand(), role_case_rhs_rparen(), role_case_rhs_operand()), constraint_id: 119 };
    // case rhs chain (parallel to int64_ops)
    c_r0: Constraint <- Constraint { trigger_role: role_case_rhs_operand(), next_token_roles: case_rhs_operand_next(), prev_token_roles: case_rhs_operand_prev(), constraint_id: 120 };
    c_r1: Constraint <- Constraint { trigger_role: role_case_rhs_op(), next_token_roles: single_role(role_case_rhs_operand()), prev_token_roles: single_role(role_case_rhs_operand()), constraint_id: 121 };
    c_r2: Constraint <- Constraint { trigger_role: role_case_rhs_call_name(), next_token_roles: single_role(role_case_rhs_lparen()), prev_token_roles: two_roles(role_case_branch_arrow(), role_case_rhs_lparen()), constraint_id: 122 };
    c_r3: Constraint <- Constraint { trigger_role: role_case_rhs_lparen(), next_token_roles: single_role(role_case_rhs_operand()), prev_token_roles: single_role(role_case_rhs_call_name()), constraint_id: 123 };
    c_r4: Constraint <- Constraint { trigger_role: role_case_rhs_rparen(), next_token_roles: three_roles(role_right_brace(), role_case_branch_stmt_sep(), role_case_branch_arrow()), prev_token_roles: single_role(role_case_rhs_operand()), constraint_id: 124 };
    c_r5: Constraint <- Constraint { trigger_role: role_case_rhs_unary_minus(), next_token_roles: single_role(role_case_rhs_operand()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 125 };
    // ; after branch rhs
    c_ss: Constraint <- Constraint { trigger_role: role_case_branch_stmt_sep(), next_token_roles: four_roles(role_case_pat_int(), role_case_pat_ident(), role_case_pat_bool(), role_right_brace()), prev_token_roles: single_role(role_case_rhs_operand()), constraint_id: 126 };
    // } closes case block after rhs or ; or empty (prev case_branch_lbrace)
    c_rb: Constraint <- Constraint { trigger_role: role_right_brace(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: three_roles(role_case_rhs_operand(), role_case_branch_stmt_sep(), role_case_branch_lbrace()), constraint_id: 127 };
    r_ss: ListConstraint <- constraint_core@cons_constraint(c_ss, constraint_core@cons_constraint(c_rb, constraint_core@empty_list_constraint()));
    r_r: ListConstraint <- constraint_core@cons_constraint(c_r5, constraint_core@cons_constraint(c_r4, r_ss));
    r_rchain: ListConstraint <- constraint_core@cons_constraint(c_r0, constraint_core@cons_constraint(c_r1, constraint_core@cons_constraint(c_r2, constraint_core@cons_constraint(c_r3, r_r))));
    r_pat: ListConstraint <- constraint_core@cons_constraint(c_pi, constraint_core@cons_constraint(c_pb, constraint_core@cons_constraint(c_pid, constraint_core@cons_constraint(c_pcol, constraint_core@cons_constraint(c_pt, constraint_core@cons_constraint(c_gif, constraint_core@cons_constraint(c_arr, r_rchain)))))));
    constraint_core@cons_constraint(c_kw, constraint_core@cons_constraint(c_of, constraint_core@cons_constraint(c_lb_case, r_pat)))
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.case_keyword of {
        true -> single_role(role_case_keyword());
        false -> case token_kind == kinds.of_keyword of {
            true -> single_role(role_case_of());
            false -> case token_kind == kinds.right_arrow of {
                true -> two_roles(role_right_arrow(), role_case_branch_arrow());
                false -> case token_kind == kinds.if_keyword of {
                    true -> single_role(role_case_guard_if());
                    false -> case token_kind == kinds.integer_literal of {
                        true -> two_roles(role_case_pat_int(), role_case_rhs_operand());
                        false -> case token_kind == kinds.float_literal of {
                            true -> single_role(role_case_rhs_operand());
                            false -> case token_kind == kinds.true_literal of {
                                true -> two_roles(role_case_pat_bool(), role_case_rhs_operand());
                                false -> case token_kind == kinds.false_literal of {
                                    true -> two_roles(role_case_pat_bool(), role_case_rhs_operand());
                                    false -> case token_kind == kinds.semicolon of {
                                        true -> single_role(role_case_branch_stmt_sep());
                                        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, token_kind) of {
                                            true -> three_roles(role_case_pat_ident(), role_case_rhs_call_name(), role_case_rhs_operand());
                                            false -> case is_op_token(kinds, token_kind) of {
                                                true -> two_roles(role_op(), role_case_rhs_op());
                                                false -> case token_kind == kinds.left_brace of {
                                                    true -> two_roles(role_left_brace(), role_case_branch_lbrace());
                                                    false -> case token_kind == kinds.left_paren of {
                                                        true -> two_roles(role_call_lparen(), role_case_rhs_lparen());
                                                        false -> case token_kind == kinds.right_paren of {
                                                            true -> two_roles(role_call_rparen(), role_case_rhs_rparen());
                                                            false -> case token_kind == kinds.minus of {
                                                                true -> two_roles(role_op(), role_case_rhs_unary_minus());
                                                                false -> case is_type_keyword(kinds, token_kind) of {
                                                                    true -> single_role(role_case_pat_type());
                                                                    false -> constraint_core@empty_list_int()
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
