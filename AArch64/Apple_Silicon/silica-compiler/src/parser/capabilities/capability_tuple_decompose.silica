// Capability: ( ident, ident, ... ) <- expr  or  ( ident: type, ident: type, ... ) <- expr  (tuple decomposition)
// Example: (atom_value, uint64_value) <- some_tuple;
// Example: (a_value:atom, b_value:uint64) <- some_tuple;
// Supports nested tuples: ((a, b), c) <- nested_tuple;
// Elements can be any type, any order, any recursive depth

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;
export role_td_lparen/0;

// Role codes for tuple decomposition (50-59). Shared: left_brace 7, role_operand 12.
fn role_td_lparen() -> int64 { 50 }
fn role_td_ident() -> int64 { 51 }
fn role_td_comma() -> int64 { 52 }
fn role_td_rparen() -> int64 { 53 }
fn role_td_arrow() -> int64 { 54 }
fn role_td_colon() -> int64 { 56 }
fn role_td_type() -> int64 { 57 }
fn role_right_brace() -> int64 { 8 }
fn role_stmt_sep() -> int64 { 55 }
fn role_left_brace() -> int64 { 7 }
fn role_operand() -> int64 { 12 }
fn role_call_rparen() -> int64 { 16 }
fn role_bind_arrow() -> int64 { 43 }
fn role_atom_literal() -> int64 { 17 }
fn role_bind_ident() -> int64 { 40 }
fn role_call_name() -> int64 { 14 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> ListInt {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> ListInt {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn constraints() -> ListConstraint {
    // left_brace can be followed by tuple decomposition (
    c1: Constraint <- Constraint { trigger_role: role_left_brace(), next_token_roles: single_role(role_td_lparen()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 50 };
    // semicolon (stmt_sep): can follow operand/call_rparen/bind_arrow/atom; can precede td_lparen/bind_ident/operand/call_name
    c2: Constraint <- Constraint { trigger_role: role_stmt_sep(), next_token_roles: four_roles(role_td_lparen(), role_bind_ident(), role_operand(), role_call_name()), prev_token_roles: four_roles(role_operand(), role_call_rparen(), role_bind_arrow(), role_atom_literal()), constraint_id: 51 };
    // td_lparen: ( starts tuple pattern; next is ident or nested (
    c3: Constraint <- Constraint { trigger_role: role_td_lparen(), next_token_roles: two_roles(role_td_ident(), role_td_lparen()), prev_token_roles: two_roles(role_left_brace(), role_stmt_sep()), constraint_id: 52 };
    // td_ident: identifier in pattern; next is comma, ), or colon (for ident: type)
    c4: Constraint <- Constraint { trigger_role: role_td_ident(), next_token_roles: three_roles(role_td_comma(), role_td_rparen(), role_td_colon()), prev_token_roles: two_roles(role_td_lparen(), role_td_comma()), constraint_id: 53 };
    // td_colon: after ident in typed pattern; next is type (keyword or ( tuple type ))
    c4b: Constraint <- Constraint { trigger_role: role_td_colon(), next_token_roles: two_roles(role_td_type(), role_td_lparen()), prev_token_roles: single_role(role_td_ident()), constraint_id: 53 };
    // td_type: type keyword or tuple type; next is comma or )
    c4c: Constraint <- Constraint { trigger_role: role_td_type(), next_token_roles: two_roles(role_td_comma(), role_td_rparen()), prev_token_roles: two_roles(role_td_colon(), role_td_lparen()), constraint_id: 53 };
    // td_comma: comma in pattern; next is ident or nested (; prev is ident, type, or )
    c5: Constraint <- Constraint { trigger_role: role_td_comma(), next_token_roles: two_roles(role_td_ident(), role_td_lparen()), prev_token_roles: three_roles(role_td_ident(), role_td_type(), role_td_rparen()), constraint_id: 54 };
    // td_rparen: ) ends pattern; next is <- or comma (nested) or ) (nested call) or } (end of block)
    c6: Constraint <- Constraint { trigger_role: role_td_rparen(), next_token_roles: four_roles(role_td_arrow(), role_td_comma(), role_call_rparen(), role_right_brace()), prev_token_roles: three_roles(role_td_ident(), role_td_type(), role_td_rparen()), constraint_id: 55 };
    // td_arrow: <- after pattern; next is RHS operand
    c7: Constraint <- Constraint { trigger_role: role_td_arrow(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_td_rparen()), constraint_id: 56 };
    c8: Constraint <- Constraint { trigger_role: role_td_arrow(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_td_rparen()), constraint_id: 57 };
    c9: Constraint <- Constraint { trigger_role: role_td_arrow(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_td_rparen()), constraint_id: 58 };
    c10: Constraint <- Constraint { trigger_role: role_td_arrow(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_td_rparen()), constraint_id: 59 };
    r10: ListConstraint <- constraint_core@cons_constraint(c10, constraint_core@empty_list_constraint());
    r9: ListConstraint <- constraint_core@cons_constraint(c9, r10);
    r8: ListConstraint <- constraint_core@cons_constraint(c8, r9);
    r7: ListConstraint <- constraint_core@cons_constraint(c7, r8);
    r6: ListConstraint <- constraint_core@cons_constraint(c6, r7);
    r5: ListConstraint <- constraint_core@cons_constraint(c5, r6);
    r4c: ListConstraint <- constraint_core@cons_constraint(c4c, r5);
    r4b: ListConstraint <- constraint_core@cons_constraint(c4b, r4c);
    r4: ListConstraint <- constraint_core@cons_constraint(c4, r4b);
    r3: ListConstraint <- constraint_core@cons_constraint(c3, r4);
    r2: ListConstraint <- constraint_core@cons_constraint(c2, r3);
    constraint_core@cons_constraint(c1, r2)
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.left_paren of {
        true -> single_role(role_td_lparen());
        false -> case token_kind == kinds.identifier of {
            true -> single_role(role_td_ident());
            false -> case token_kind == kinds.colon of {
                true -> single_role(role_td_colon());
                false -> case token_kind == kinds.comma of {
                    true -> single_role(role_td_comma());
                    false -> case token_kind == kinds.right_paren of {
                        true -> single_role(role_td_rparen());
                        false -> case token_kind == kinds.left_arrow of {
                            true -> single_role(role_td_arrow());
                            false -> case token_kind == kinds.semicolon of {
                                true -> single_role(role_stmt_sep());
                                false -> case is_type_token(kinds, token_kind) of {
                                    true -> single_role(role_td_type());
                                    false -> constraint_core@empty_list_int()
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn is_type_token(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.int8_keyword or token_kind == kinds.int16_keyword or token_kind == kinds.int32_keyword or token_kind == kinds.int64_keyword or token_kind == kinds.uint8_keyword or token_kind == kinds.uint16_keyword or token_kind == kinds.uint32_keyword or token_kind == kinds.uint64_keyword or token_kind == kinds.float16_keyword or token_kind == kinds.float32_keyword or token_kind == kinds.float64_keyword or token_kind == kinds.bool_keyword or token_kind == kinds.char_keyword or token_kind == kinds.string_keyword or token_kind == kinds.atom_keyword
}
