// Parser AST types - Program, Declaration, Expr
// Shared by parser, type checker, and SIR generator

use lexer_core;

export Program/0;
export Declaration/0;
export ListDeclaration/0;
export Expr/0;
export TypeName/0;
export EffectName/0;
export ListEffectName/0;
export TupleDecomposeBinding/0;
export ListTupleDecomposeBinding/0;
export zero_location/0;
export dummy_expr/0;
export dummy_decl/0;
export empty_list_decl/0;
export dummy_effect_name/0;
export empty_effect_name_list/0;
export cons_effect_name/2;
export nil_tuple_decompose_bindings/0;
export cons_tuple_decompose_binding/2;
export make_tuple_decompose_binding/3;
export as_list_tuple_decompose_bindings/1;
export TupleDecomposeResult/0;
export tuple_decompose_result_bindings/1;

// Tuple decomposition pattern element: name and type from the pattern annotation.
struct TupleDecomposeBinding {
    name: string,
    path: string,
    type_str: string
}

struct ListTupleDecomposeBinding {
    is_nil: bool,
    head: TupleDecomposeBinding,
    tail: ListTupleDecomposeBinding
}

struct EffectName {
    name: string,
    parameter: string,
    location: SourceLocation
}

struct ListEffectName {
    is_nil: bool,
    head: EffectName,
    tail: ListEffectName
}

// Expr: kind 0 = integer literal, 1 = identifier, 2 = parenthesized, 3 = binary op, 4 = call, 5 = atom literal, 6 = let binding, 7 = boolean literal, 8 = string literal, 9 = tuple literal, 10 = tuple decomposition, 11 = sequence block, -1 = dummy (defined first for Declaration)
// For kind 10 (tuple decomposition): pattern_bindings holds the structured pattern; value is unused.
// For kind 11 (sequence block): inner = body (statements before produces), right_expr = result (pure expr); sequence_effects = declared effects from proc[ε].
struct Expr {
    kind: int64,
    value: string,
    name: string,
    location: SourceLocation,
    inner: Expr,
    right_expr: Expr,
    pattern_bindings: ListTupleDecomposeBinding,
    sequence_effects: ListEffectName
}

struct TypeName {
    name: string,
    location: SourceLocation
}

// Declaration: tag 0 = function declaration
struct Declaration {
    tag: int64,
    name: string,
    return_type_name: string,
    return_type_location: SourceLocation,
    location: SourceLocation,
    body: Expr,
    declared_effects: ListEffectName
}

struct ListDeclaration {
    is_nil: bool,
    head: Declaration,
    tail: ListDeclaration
}

// Program: root node with list of declarations
struct Program {
    declarations: ListDeclaration,
    location: SourceLocation
}

fn zero_location() -> SourceLocation {
    SourceLocation { file: "", line: 0, column: 0, offset: 0 }
}

fn nil_tuple_decompose_bindings() -> ListTupleDecomposeBinding {
    dummy: TupleDecomposeBinding <- TupleDecomposeBinding { name: "", path: "", type_str: "" };
    nil_placeholder: ListTupleDecomposeBinding <- ListTupleDecomposeBinding { is_nil: true, head: dummy, tail: nil_placeholder };
    nil_placeholder
}

fn cons_tuple_decompose_binding(b: TupleDecomposeBinding, rest: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    ListTupleDecomposeBinding { is_nil: false, head: b, tail: rest }
}

fn make_tuple_decompose_binding(name: string, path: string, type_str: string) -> TupleDecomposeBinding {
    TupleDecomposeBinding { name: name, path: path, type_str: type_str }
}

fn as_list_tuple_decompose_bindings(b: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    b
}

fn dummy_expr() -> Expr {
    placeholder: Expr <- Expr { kind: -1, value: "", name: "", location: zero_location(), inner: placeholder, right_expr: placeholder, pattern_bindings: nil_tuple_decompose_bindings(), sequence_effects: empty_effect_name_list() };
    placeholder
}

fn dummy_decl() -> Declaration {
    Declaration { tag: -1, name: "", return_type_name: "", return_type_location: zero_location(), location: zero_location(), body: dummy_expr(), declared_effects: empty_effect_name_list() }
}

fn empty_list_decl() -> ListDeclaration {
    nil_placeholder: ListDeclaration <- ListDeclaration { is_nil: true, head: dummy_decl(), tail: nil_placeholder };
    nil_placeholder
}

fn dummy_effect_name() -> EffectName {
    EffectName { name: "", parameter: "", location: zero_location() }
}

fn empty_effect_name_list() -> ListEffectName {
    nil_placeholder: ListEffectName <- ListEffectName { is_nil: true, head: dummy_effect_name(), tail: nil_placeholder };
    nil_placeholder
}

fn cons_effect_name(eff: EffectName, list: ListEffectName) -> ListEffectName {
    ListEffectName { is_nil: false, head: eff, tail: list }
}
