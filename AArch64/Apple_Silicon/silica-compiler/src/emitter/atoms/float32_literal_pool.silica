// Float32 literal pool: collect float32 constants for .rodata
// Emit .rodata section with L_f32_N labels; const emitter uses LDR S for float32 values

use sir_ast;
use bst;
use atom_table;

export Float32LiteralTable/0;
export build_float32_literal_table/1;
export float32_literal_value_to_index/2;
export emit_float32_literal_rodata_section/1;
export module_uses_float32_literal_pool/1;

struct ListFloat32LiteralValue {
    is_nil: bool,
    head: string,
    tail: ListFloat32LiteralValue
}

struct Float32LiteralTable {
    is_empty: bool,
    root: BstNode,
    values: ListFloat32LiteralValue
}

fn nil_f32_literal_values() -> ListFloat32LiteralValue {
    ph: ListFloat32LiteralValue <- ListFloat32LiteralValue { is_nil: true, head: "", tail: ph };
    ph
}

fn cons_f32_literal_value(s: string, t: ListFloat32LiteralValue) -> ListFloat32LiteralValue {
    ListFloat32LiteralValue { is_nil: false, head: s, tail: t }
}

fn empty_float32_literal_table() -> Float32LiteralTable {
    Float32LiteralTable { is_empty: true, root: bst@empty_node(), values: nil_f32_literal_values() }
}

fn add_f32_value(table: Float32LiteralTable, value: string, next_index: int64) -> (Float32LiteralTable, int64) {
    case table.is_empty of {
        true -> do
            (root: BstNode, idx: int64) <- bst@bst_insert_string(bst@empty_node(), value, next_index);
            new_values: ListFloat32LiteralValue <- case idx == next_index of {
                true -> cons_f32_literal_value(value, table.values);
                false -> table.values
            };
            (Float32LiteralTable { is_empty: false, root: root, values: new_values }, idx)
        end;
        false -> do
            (new_root: BstNode, idx: int64) <- bst@bst_insert_string(table.root, value, next_index);
            new_values: ListFloat32LiteralValue <- case idx == next_index of {
                true -> cons_f32_literal_value(value, table.values);
                false -> table.values
            };
            (Float32LiteralTable { is_empty: false, root: new_root, values: new_values }, idx)
        end
    }
}

fn float32_literal_value_to_index(table: Float32LiteralTable, value: string) -> int64 {
    case table.is_empty of {
        true -> 0 - 1;
        false -> bst@bst_lookup_string(table.root, value)
    }
}

fn value_has_dot_from(value: string, pos: int64, length: int64) -> bool {
    case pos >= length of {
        true -> false;
        false -> case substring(value, pos, pos + 1) == "." of {
            true -> true;
            false -> value_has_dot_from(value, pos + 1, length)
        }
    }
}

fn value_looks_like_float(value: string) -> bool {
    value_has_dot_from(value, 0, len(value))
}

fn is_float_const(term: SIRTerm) -> bool {
    case term.type_name == "float32" or term.type_name == "float" or term.type_name == "float64" of {
        true -> true;
        false -> term.type_name != "string" and term.type_name != "fn_ptr" and value_looks_like_float(term.value)
    }
}

fn collect_float32_literal_from_term(term: SIRTerm, table: Float32LiteralTable, next_index: int64) -> (Float32LiteralTable, int64) {
    case term.kind < 0 of {
        true -> (table, next_index);
        false -> case term.kind of {
            0 -> case is_float_const(term) of {
                true -> do
                    (t: Float32LiteralTable, i: int64) <- add_f32_value(table, term.value, next_index);
                    new_next: int64 <- case i == next_index of {
                        true -> next_index + 1;
                        false -> next_index
                    };
                    (t, new_next)
                end;
                false -> (table, next_index)
            };
            1 -> (table, next_index);
            2 -> do
                (t1: Float32LiteralTable, i1: int64) <- collect_float32_literal_from_term(term.inner, table, next_index);
                (t2: Float32LiteralTable, i2: int64) <- collect_float32_literal_from_term(term.right_expr, t1, i1);
                (t2, i2)
            end;
            4 -> do
                (t1: Float32LiteralTable, i1: int64) <- collect_float32_literal_from_term(term.inner, table, next_index);
                collect_float32_literal_from_term(term.right_expr, t1, i1)
            end;
            6 -> do
                (t1: Float32LiteralTable, i1: int64) <- collect_float32_literal_from_term(term.inner, table, next_index);
                (t2: Float32LiteralTable, i2: int64) <- collect_float32_literal_from_term(term.right_expr, t1, i1);
                (t2, i2)
            end;
            _: int64 -> (table, next_index)
        }
    }
}

fn collect_float32_literal_from_functions(fns: ListSIRFunction, table: Float32LiteralTable, next_index: int64) -> (Float32LiteralTable, int64) {
    case fns.is_nil of {
        true -> (table, next_index);
        false -> do
            (t1: Float32LiteralTable, i1: int64) <- collect_float32_literal_from_term(fns.head.body, table, next_index);
            collect_float32_literal_from_functions(fns.tail, t1, i1)
        end
    }
}

fn build_float32_literal_table(sir_module: SIRModule) -> Float32LiteralTable {
    (table: Float32LiteralTable, _: int64) <- collect_float32_literal_from_functions(sir_module.functions, empty_float32_literal_table(), 0);
    table
}

fn rev_f32_values_acc(values: ListFloat32LiteralValue, acc: ListFloat32LiteralValue) -> ListFloat32LiteralValue {
    case values.is_nil of {
        true -> acc;
        false -> rev_f32_values_acc(values.tail, cons_f32_literal_value(values.head, acc))
    }
}

fn reverse_f32_values(values: ListFloat32LiteralValue) -> ListFloat32LiteralValue {
    rev_f32_values_acc(values, nil_f32_literal_values())
}

fn emit_float32_literal_values_rodata(values: ListFloat32LiteralValue, index: int64) -> string {
    case values.is_nil of {
        true -> "";
        false -> do
            rest: string <- emit_float32_literal_values_rodata(values.tail, index + 1);
            label_colon: string <- concat(concat(concat("L_f32_", atom_table@int64_to_decimal_string(index)), ":"), "\n");
            single_line: string <- concat(concat("    .single ", values.head), "\n");
            one: string <- concat(label_colon, single_line);
            case len(rest) > 0 of {
                true -> concat(concat(one, "\n"), rest);
                false -> one
            }
        end
    }
}

fn emit_float32_literal_rodata_section(table: Float32LiteralTable) -> string {
    case table.is_empty of {
        true -> "";
        false -> do
            header: string <- ".section __TEXT,__rodata\n.align\t4\n";
            in_order: ListFloat32LiteralValue <- reverse_f32_values(table.values);
            body: string <- emit_float32_literal_values_rodata(in_order, 0);
            concat(header, body)
        end
    }
}

fn module_uses_float32_literal_pool(sir_module: SIRModule) -> bool {
    table: Float32LiteralTable <- build_float32_literal_table(sir_module);
    case table.is_empty of {
        true -> false;
        false -> true
    }
}
