// L_string_eq_helper: delegates to runtime _silica_string_equals (io.rs). X0/X1 = any string repr
// (SilicaString struct ptr or null-terminated literal). Returns W0 = 0/1; clobbers per C ABI.

export emit_string_eq_helper/0;

fn emit_string_eq_helper() -> string {
    "L_string_eq_helper:\n    STP X29, X30, [SP, #-16]!\n    BL _silica_string_equals\n    LDP X29, X30, [SP], #16\n    RET"
}
