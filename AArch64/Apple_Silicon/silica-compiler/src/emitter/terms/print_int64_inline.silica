// Fully inline emission for print_int64/print_uint64 built-in
// Const arg: emit write(2) with L_pi_N label from int_rodata. Var arg: BL L_pi_helper or L_pu_helper.
// Uses int_rodata for const label lookup.

use sir_ast;
use atom_table;
use int_rodata;
use emitter_effects;

export emit_print_int64_inline/4;
export is_print_int64_const_arg/2;
export is_print_uint64_const_arg/2;
export emit_print_int64_var/3;
export emit_print_uint64_var/3;
export emit_print_int64_helper/0;
export emit_print_uint64_helper/0;

fn is_print_int64_const_arg(term: SIRTerm, table: AtomTable) -> bool {
    case term.name == "main.print_int64" of {
        false -> false;
        true -> case term.inner.kind of {
            0 -> term.inner.type_name == "int64";
            _: int64 -> false
        }
    }
}

fn is_print_uint64_const_arg(term: SIRTerm, table: AtomTable) -> bool {
    case term.name == "main.print_uint64" of {
        false -> false;
        true -> case term.inner.kind of {
            0 -> term.inner.type_name == "uint64";
            _: int64 -> false
        }
    }
}

fn emit_print_int64_inline(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable) -> string {
    value: string <- term.inner.value;
    index: int64 <- int_rodata@int64_value_to_index(int64_table, value);
    index_str: string <- atom_table@int64_to_decimal_string(index);
    lp: string <- concat("L_pi", "_");
    label: string <- concat(lp, index_str);
    length: int64 <- len(value);
    length_str: string <- atom_table@int64_to_decimal_string(length);
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    mov_fd: string <- "    MOV X0, #1\n";
    adrp_part: string <- concat(concat(concat("    ADRP X1, ", label), "@PAGE"), "\n");
    add_part: string <- concat(concat(concat("    ADD X1, X1, ", label), "@PAGEOFF"), "\n");
    mov_count: string <- concat(concat("    MOV X2, #", length_str), "\n");
    syscall_line: string <- "\n    MOV X16, #4\n    SVC #0x80\n";
    result_line: string <- concat(concat("    MOV ", dest), ", #0\n");
    with_comment: string <- concat(comment_line, mov_fd);
    with_adrp: string <- concat(with_comment, concat(concat(adrp_part, add_part), concat(mov_count, syscall_line)));
    with_result: string <- concat(with_adrp, result_line);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_result, concat(concat("\n", post_barrier), "\n"));
        false -> concat(with_result, "\n")
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

fn emit_print_int64_var(term: SIRTerm, dest: string, table: AtomTable) -> string {
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- "    BL L_pi_helper\n";
    mov_ret: string <- concat(concat("    MOV ", dest), ", #0\n");
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

fn emit_print_uint64_var(term: SIRTerm, dest: string, table: AtomTable) -> string {
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- "    BL L_pu_helper\n";
    mov_ret: string <- concat(concat("    MOV ", dest), ", #0\n");
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

fn emit_print_int64_helper() -> string {
    "L_pi_helper:\n    SUB SP, SP, #32\n    MOV X10, SP\n    ADD X10, X10, #24\n    MOV X11, #0\n    CMP X0, #0\n    B.ge L_pi_pos\n    MOV X11, #1\n    NEG X0, X0\nL_pi_pos:\n    MOV X8, X10\n    CMP X0, #0\n    B.eq L_pi_zero\n    MOV X9, #10\nL_pi_loop:\n    UDIV X1, X0, X9\n    MSUB X2, X1, X9, X0\n    ADD X2, X2, #48\n    SUB X8, X8, #1\n    STRB W2, [X8]\n    MOV X0, X1\n    CBNZ X0, L_pi_loop\n    B L_pi_maybe_neg\nL_pi_zero:\n    SUB X8, X8, #1\n    MOV X1, #48\n    STRB W1, [X8]\nL_pi_maybe_neg:\n    CBNZ X11, L_pi_prepend_minus\n    B L_pi_do_write\nL_pi_prepend_minus:\n    SUB X8, X8, #1\n    MOV X1, #45\n    STRB W1, [X8]\nL_pi_do_write:\n    SUB X2, X10, X8\n    MOV X0, #1\n    MOV X1, X8\n    MOV X16, #4\n    SVC #0x80\n    ADD SP, SP, #32\n    RET"
}

fn emit_print_uint64_helper() -> string {
    "L_pu_helper:\n    SUB SP, SP, #32\n    MOV X10, SP\n    ADD X10, X10, #24\n    MOV X8, X10\n    CMP X0, #0\n    B.eq L_pu_zero\n    MOV X9, #10\nL_pu_loop:\n    UDIV X1, X0, X9\n    MSUB X2, X1, X9, X0\n    ADD X2, X2, #48\n    SUB X8, X8, #1\n    STRB W2, [X8]\n    MOV X0, X1\n    CBNZ X0, L_pu_loop\n    B L_pu_do_write\nL_pu_zero:\n    SUB X8, X8, #1\n    MOV X1, #48\n    STRB W1, [X8]\nL_pu_do_write:\n    SUB X2, X10, X8\n    MOV X0, #1\n    MOV X1, X8\n    MOV X16, #4\n    SVC #0x80\n    ADD SP, SP, #32\n    RET"
}
