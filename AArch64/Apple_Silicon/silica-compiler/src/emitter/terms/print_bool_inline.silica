// Fully inline emission for print_bool(bool) built-in
// Const arg: emit write(2) with "true" or "false" label. Var arg: BL L_pb_helper (shared helper).
// Uses boolean_rodata for L_pb_true and L_pb_false.

use sir_ast;
use atom_table;
use emitter_effects;

export emit_print_bool_inline/3;
export is_print_bool_const_arg/2;
export emit_print_bool_var/3;
export emit_print_bool_helper/0;

// True when term is a call to main.print_bool and the argument is a const bool.
fn is_print_bool_const_arg(term: SIRTerm, table: AtomTable) -> bool {
    case term.name == "main.print_bool" of {
        false -> false;
        true -> case term.inner.kind of {
            0 -> term.inner.type_name == "bool";
            _: int64 -> false
        }
    }
}

// Emit fully inline assembly for print_bool(const_bool).
// Precondition: term.name == "main.print_bool" and term.inner is const bool (kind 0, type_name "bool").
// Uses write(2) syscall: fd=1 (stdout), buf=label (L_pb_true or L_pb_false), count=4 or 5.
// macOS ARM64: write syscall number 4; X0=fd, X1=buf, X2=count; result in X0.
fn emit_print_bool_inline(term: SIRTerm, dest: string, table: AtomTable) -> string {
    is_true: bool <- term.inner.value == "true";
    label: string <- case is_true of {
        true -> "L_pb_true";
        false -> "L_pb_false"
    };
    count: int64 <- case is_true of {
        true -> 4;
        false -> 5
    };
    count_str: string <- atom_table@int64_to_decimal_string(count);
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    mov_fd: string <- "    MOV X0, #1\n";
    adrp_part: string <- concat(concat(concat("    ADRP X1, ", label), "@PAGE"), "\n");
    add_part: string <- concat(concat(concat("    ADD X1, X1, ", label), "@PAGEOFF"), "\n");
    mov_count: string <- concat(concat("    MOV X2, #", count_str), "\n");
    syscall_line: string <- "\n    MOV X16, #4\n    SVC #0x80\n";
    result_line: string <- concat(concat("    MOV ", dest), ", #0\n");
    with_comment: string <- concat(comment_line, mov_fd);
    with_adrp: string <- concat(with_comment, concat(concat(adrp_part, add_part), concat(mov_count, syscall_line)));
    with_result: string <- concat(with_adrp, result_line);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_result, concat(concat("\n", post_barrier), "\n"));
        false -> concat(with_result, "\n")
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// Emit inline for print_bool when argument is variable (e.g. var or comparison result).
// X0 holds 0 (false) or non-zero (true). Call shared helper L_pb_helper (like print_int64).
fn emit_print_bool_var(term: SIRTerm, dest: string, table: AtomTable) -> string {
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- "    BL L_pb_helper\n";
    mov_ret: string <- concat(concat("    MOV ", dest), ", #0\n");
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// Shared helper for print_bool(var). Expects X0 = 0 (false) or non-zero (true).
// Labels L_pb_false_branch and L_pb_after are local to this helper.
fn emit_print_bool_helper() -> string {
    "L_pb_helper:\n    CMP X0, #0\n    B.eq L_pb_false_branch\n    MOV X0, #1\n    ADRP X1, L_pb_true@PAGE\n    ADD X1, X1, L_pb_true@PAGEOFF\n    MOV X2, #4\n    MOV X16, #4\n    SVC #0x80\n    B L_pb_after\nL_pb_false_branch:\n    MOV X0, #1\n    ADRP X1, L_pb_false@PAGE\n    ADD X1, X1, L_pb_false@PAGEOFF\n    MOV X2, #5\n    MOV X16, #4\n    SVC #0x80\nL_pb_after:\n    RET"
}
