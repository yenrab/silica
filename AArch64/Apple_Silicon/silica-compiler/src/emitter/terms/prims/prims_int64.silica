// int64 (signed) prim emission: add, sub, mul, div, rem, lt, gt, le, ge, eq, ne, and, or
// string_length_bytes, string_length_chars (unary string->int64, spec §silica:StringLengthOperations)
// X registers, ADD/SUB/MUL/SDIV, signed comparison

use sir_ast;
use arithmetic;
use comparison;
use logical;

export emit_prim_op/2;

// Helpers return length in X0 and destroy the string pointer in X0. Outer bindings still
// treat a function param in X0 (e.g. %s) as live in X0 after the prim; restore the pointer
// so later uses (another length_chars, substring, etc.) see the correct address.
// Use X12 for the length temp (not X9): int64 eq uses CMP X9, X10 for operands; left operand
// is emitted into X9 via MOV X9, X12 after restore.
fn emit_string_length_bytes(dest: string) -> string {
    save: string <- "    STR X0, [SP, #-16]!\n";
    bl: string <- "    BL L_length_bytes_helper\n";
    mid: string <- "    MOV X12, X0\n    LDR X0, [SP], #16\n";
    tail: string <- case dest == "X12" of {
        true -> "";
        false -> case dest == "X0" of {
            true -> "    MOV X0, X12\n";
            false -> concat(concat("    MOV ", dest), ", X12\n")
        }
    };
    concat(concat(concat(concat(save, bl), mid), tail), "")
}

fn emit_string_length_chars(dest: string) -> string {
    save: string <- "    STR X0, [SP, #-16]!\n";
    bl: string <- "    BL L_length_chars_helper\n";
    mid: string <- "    MOV X12, X0\n    LDR X0, [SP], #16\n";
    tail: string <- case dest == "X12" of {
        true -> "";
        false -> case dest == "X0" of {
            true -> "    MOV X0, X12\n";
            false -> concat(concat("    MOV ", dest), ", X12\n")
        }
    };
    concat(concat(concat(concat(save, bl), mid), tail), "")
}

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    case term.name of {
        "neg" -> arithmetic@emit_neg_op(dest, "X");
        "add" -> arithmetic@emit_add_op(dest, "X");
        "sub" -> arithmetic@emit_sub_op(dest, "X");
        "mul" -> arithmetic@emit_mul_op(dest, "X");
        "div" -> arithmetic@emit_div_op(dest, "X");
        "rem" -> arithmetic@emit_rem_op(dest, "X");
        "lt" -> comparison@emit_lt_op(dest, "X");
        "gt" -> comparison@emit_gt_op(dest, "X");
        "le" -> comparison@emit_le_op(dest, "X");
        "ge" -> comparison@emit_ge_op(dest, "X");
        "eq" -> comparison@emit_eq_op(dest, "X");
        "nq" -> comparison@emit_ne_op(dest, "X");
        "and" -> logical@emit_and_op(dest, "X");
        "or" -> logical@emit_or_op(dest, "X");
        "string_length_bytes" -> emit_string_length_bytes(dest);
        "string_length_chars" -> emit_string_length_chars(dest);
        _: string -> concat("    ; unsupported int64 prim: ", term.name)
    }
}
