// float32 prim emission: add, sub, mul, div, lt, gt, le, ge, eq, ne
// S registers, FADD/FSUB/FMUL/FDIV, FCMP+CSET for comparison

use sir_ast;
use arithmetic;
use comparison;

export emit_prim_op/2;

fn dest_to_s_reg(dest: string) -> string {
    case dest of {
        "X0" -> "S0";
        "X1" -> "S1";
        "X2" -> "S2";
        "S0" -> "S0";
        "S1" -> "S1";
        "S2" -> "S2";
        _: string -> dest
    }
}

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    dest_reg: string <- dest_to_s_reg(dest);
    case term.name of {
        "add" -> arithmetic@emit_fadd_s_op(dest_reg);
        "sub" -> arithmetic@emit_fsub_s_op(dest_reg);
        "mul" -> arithmetic@emit_fmul_s_op(dest_reg);
        "div" -> arithmetic@emit_fdiv_s_op(dest_reg);
        "lt" -> comparison@emit_fcmp_lt_op(dest_reg, "S");
        "gt" -> comparison@emit_fcmp_gt_op(dest_reg, "S");
        "le" -> comparison@emit_fcmp_le_op(dest_reg, "S");
        "ge" -> comparison@emit_fcmp_ge_op(dest_reg, "S");
        "eq" -> comparison@emit_fcmp_eq_op(dest_reg, "S");
        "nq" -> comparison@emit_fcmp_ne_op(dest_reg, "S");
        _: string -> concat("    ; unsupported float32 prim: ", term.name)
    }
}
