// String length helpers: length_bytes, length_chars (spec §silica:StringLengthOperations).
// Non-MTE fallback for Apple Silicon (macOS ARM64). No libc.
//
// Both delegate to Rust (io.rs): pointers may be SilicaString struct or null-terminated literals.
// Frame around BL preserves LR for nested calls.

export emit_length_bytes_helper/0;
export emit_length_chars_helper/0;

fn emit_length_bytes_helper() -> string {
    "L_length_bytes_helper:\n    STP X29, X30, [SP, #-16]!\n    BL _silica_string_len\n    LDP X29, X30, [SP], #16\n    RET"
}

fn emit_length_chars_helper() -> string {
    "L_length_chars_helper:\n    STP X29, X30, [SP, #-16]!\n    BL _silica_string_len_chars\n    LDP X29, X30, [SP], #16\n    RET"
}
