// String length helpers: length_bytes, length_chars (spec §silica:StringLengthOperations).
// Non-MTE fallback for Apple Silicon (macOS ARM64). No libc.
//
// L_length_bytes_helper: X0 = ptr (null-terminated UTF-8). Returns X0 = byte length (strlen).
// L_length_chars_helper: X0 = ptr (null-terminated UTF-8). Returns X0 = character count (UTF-8 scalar values).

export emit_length_bytes_helper/0;
export emit_length_chars_helper/0;

fn emit_length_bytes_helper() -> string {
    "L_length_bytes_helper:\n    MOV X9, X0\n    MOV X0, #0\nL_lb_loop:\n    LDRB W10, [X9]\n    CBZ W10, L_lb_done\n    ADD X0, X0, #1\n    ADD X9, X9, #1\n    B L_lb_loop\nL_lb_done:\n    RET"
}

fn emit_length_chars_helper() -> string {
    "L_length_chars_helper:\n    MOV X9, X0\n    MOV X0, #0\nL_lc_loop:\n    LDRB W10, [X9]\n    CBZ W10, L_lc_done\n    CMP W10, #0x80\n    B.LO L_lc_inc\n    CMP W10, #0xC0\n    B.HS L_lc_inc\n    ADD X9, X9, #1\n    B L_lc_loop\nL_lc_inc:\n    ADD X0, X0, #1\n    ADD X9, X9, #1\n    B L_lc_loop\nL_lc_done:\n    RET"
}
