// Term dispatcher: SIRTerm.kind -> emit function
// Delegates to const, var, call, prims per sir_emitter_pattern_spec §4.3

use sir_ast;
use atom_table;
use const_dispatcher;
use var;
use call;
use prims;
use prims_tuple;
use let_dispatcher;
use print_atom_inline;
use print_bool_inline;
use print_int64_inline;
use print_int32_inline;
use print_int16_inline;
use print_int8_inline;
use print_float64_inline;
use print_float32_inline;
use print_string_inline;
use int_rodata;
use int64_literal_pool;
use float64_literal_pool;
use float32_literal_pool;
use string_literal_pool;
use reg_conventions;

export term_to_asm/11;
export term_to_asm_debug/12;

// Emit ADRP+ADD for string const (kept here to avoid 6-param emit_const bootstrap issue).
fn emit_string_const(term: SIRTerm, dest: string, string_literal_table: StringLiteralTable) -> string {
    idx: int64 <- string_literal_pool@string_literal_value_to_index(string_literal_table, term.value);
    label: string <- concat("L_str_", atom_table@int64_to_decimal_string(idx));
    adrp: string <- concat(concat(concat(concat("    ADRP ", dest), ", "), concat(label, "@PAGE")), "\n");
    add: string <- concat(concat(concat(concat("    ADD ", dest), ", "), concat(concat(dest, ", "), concat(label, "@PAGEOFF"))), "");
    concat(adrp, add)
}

// Emit AArch64 assembly for a SIR term. dest is the virtual register for the result.
// Tables: int64, int32, int16, int8 for print_X const label lookup; literal_table for large int64 const; float64_literal_table for float64 const; string_literal_table for string const
fn term_to_asm(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable) -> string {
    term_to_asm_opt_bound(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, "", "", "", false)
}

// Debug variant: when debug is true, prints branch/register info for let and var cases
fn term_to_asm_debug(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, debug: bool) -> string proc[DeviceIO] {
    term_to_asm_opt_bound_debug(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, "", "", "", debug)
}

fn term_to_asm_opt_bound(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string {
    case term.kind of {
        0 -> case term.type_name == "string" of {
            true -> emit_string_const(term, dest, string_literal_table);
            false -> const_dispatcher@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table)
        };
        1 -> case term.name == bound_name or term.name == concat("%", bound_name) of {
            true -> var@emit_var_reg(term, dest, bound_reg);
            false -> case len(outer_reg) > 0 of {
                true -> var@emit_var_reg(term, dest, outer_reg);
                false -> var@emit_var(term, dest)
            }
        };
        2 -> case len(bound_name) > 0 and len(bound_reg) > 0 of {
            true -> do
                base_rhs: string <- let_dispatcher@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
                rhs_reg: string <- case term.inner.kind == 0 and term.inner.type_name == "int64" and dest == "X0" and bound_reg == "X1" of {
                    true -> "X2";
                    false -> base_rhs
                };
                rhs_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                body_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, term.name, rhs_reg, bound_reg, true) end;
                    false -> term_to_asm_opt_bound(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, term.name, rhs_reg, bound_reg, false)
                };
                n: int64 <- prims_tuple@count_tuple_allocations(term.inner);
                dealloc: string <- case reg_conventions@is_tuple_type(term.inner.type_name) and n > 0 of {
                    true -> case n == 1 of {
                        true -> "    ADD SP, SP, #16\n";
                        false -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(n * 16), "\n"))
                    };
                    false -> ""
                };
                rhs_sep: string <- case len(rhs_asm) > 0 and substring(rhs_asm, len(rhs_asm) - 1, len(rhs_asm)) == "\n" of {
                    true -> "";
                    false -> "\n"
                };
                concat(concat(rhs_asm, rhs_sep), case len(dealloc) > 0 of {
                    true -> concat(concat(body_asm, "\n"), dealloc);
                    false -> body_asm
                })
            end;
            false -> do
                base_rhs: string <- let_dispatcher@compute_rhs_reg_top_level(term, bound_reg, dest);
                rhs_reg: string <- case term.inner.kind == 0 and term.inner.type_name == "int64" and dest == "X0" and term.right_expr.kind != 4 of {
                    true -> "X1";
                    false -> base_rhs
                };
                rhs_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                body_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, term.name, rhs_reg, rhs_reg, true) end;
                    false -> term_to_asm_opt_bound(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, term.name, rhs_reg, rhs_reg, false)
                };
                n: int64 <- prims_tuple@count_tuple_allocations(term.inner);
                dealloc: string <- case n > 0 of {
                    true -> case n == 1 of {
                        true -> "    ADD SP, SP, #16\n";
                        false -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(n * 16), "\n"))
                    };
                    false -> ""
                };
                rhs_sep: string <- case len(rhs_asm) > 0 and substring(rhs_asm, len(rhs_asm) - 1, len(rhs_asm)) == "\n" of {
                    true -> "";
                    false -> "\n"
                };
                concat(concat(rhs_asm, rhs_sep), case len(dealloc) > 0 of {
                    true -> concat(concat(body_asm, "\n"), dealloc);
                    false -> body_asm
                })
            end
        };
        4 -> case term.name == "main.print_atom" of {
            true -> case print_atom_inline@is_print_atom_const_arg(term, table) of {
                true -> print_atom_inline@emit_print_atom_inline(term, dest, table);
                false -> do
                    arg_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                    inline_asm: string <- print_atom_inline@emit_print_atom_by_index(term, dest, table);
                    concat(concat(arg_asm, "\n"), inline_asm)
                end
            };
            false -> case term.name == "main.print_bool" of {
                true -> case print_bool_inline@is_print_bool_const_arg(term, table) of {
                    true -> print_bool_inline@emit_print_bool_inline(term, dest, table);
                    false -> do
                        arg_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                        inline_asm: string <- print_bool_inline@emit_print_bool_var(term, dest, table);
                        concat(concat(arg_asm, "\n"), inline_asm)
                    end
                };
                false -> case term.name == "main.print_float64" of {
                    true -> do
                        arg_asm: string <- case debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, "D0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                            false -> term_to_asm_opt_bound(term.inner, "D0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                        };
                        inline_asm: string <- print_float64_inline@emit_print_float64_var(term, dest, table);
                        concat(concat(arg_asm, "\n"), inline_asm)
                    end;
                    false -> case term.name == "main.print_float32" of {
                        true -> do
                            arg_asm: string <- case debug of {
                                true -> do term_to_asm_opt_bound_debug(term.inner, "S0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                false -> term_to_asm_opt_bound(term.inner, "S0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                            };
                            inline_asm: string <- print_float32_inline@emit_print_float32_var(term, dest, table);
                            concat(concat(arg_asm, "\n"), inline_asm)
                        end;
                        false -> case term.name == "main.print_int64" of {
                    true -> case print_int64_inline@is_print_int64_const_arg(term, table) of {
                        true -> print_int64_inline@emit_print_int64_inline(term, dest, table, int64_table);
                        false -> do
                            arg_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                            inline_asm: string <- print_int64_inline@emit_print_int64_var(term, dest, table);
                            concat(concat(arg_asm, "\n"), inline_asm)
                        end
                    };
                    false -> case term.name == "main.print_uint64" of {
                        true -> case print_int64_inline@is_print_uint64_const_arg(term, table) of {
                            true -> print_int64_inline@emit_print_int64_inline(term, dest, table, int64_table);
                            false -> do
                                arg_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                                inline_asm: string <- print_int64_inline@emit_print_uint64_var(term, dest, table);
                                concat(concat(arg_asm, "\n"), inline_asm)
                            end
                        };
                        false -> case term.name == "main.print_int32" of {
                            true -> case print_int32_inline@is_print_int32_const_arg(term, table) of {
                                true -> print_int32_inline@emit_print_int32_inline(term, dest, table, int32_table);
                                false -> do
                                    arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "uint32" of {
                                        true -> concat("W", "0");
                                        false -> "X0"
                                    };
                                    arg_asm: string <- case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    inline_asm: string <- print_int32_inline@emit_print_int32_var(term, dest, table);
                                    concat(concat(arg_asm, "\n"), inline_asm)
                                end
                            };
                            false -> case term.name == "main.print_uint32" of {
                                true -> case print_int32_inline@is_print_uint32_const_arg(term, table) of {
                                    true -> print_int32_inline@emit_print_int32_inline(term, dest, table, int32_table);
                                    false -> do
                                        arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "uint32" of {
                                            true -> concat("W", "0");
                                            false -> "X0"
                                        };
                                        arg_asm: string <- case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                        inline_asm: string <- print_int32_inline@emit_print_uint32_var(term, dest, table);
                                        concat(concat(arg_asm, "\n"), inline_asm)
                                    end
                                };
                                false -> case term.name == "main.print_int16" of {
                                    true -> case print_int16_inline@is_print_int16_const_arg(term, table) of {
                                        true -> print_int16_inline@emit_print_int16_inline(term, dest, table, int16_table);
                                        false -> do
                                            arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8" of {
                                                true -> concat("W", "0");
                                                false -> "X0"
                                            };
                                            arg_asm: string <- case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                            inline_asm: string <- print_int16_inline@emit_print_int16_var(term, dest, table);
                                            concat(concat(arg_asm, "\n"), inline_asm)
                                        end
                                    };
                                    false -> case term.name == "main.print_uint16" of {
                                        true -> case print_int16_inline@is_print_uint16_const_arg(term, table) of {
                                            true -> print_int16_inline@emit_print_int16_inline(term, dest, table, int16_table);
                                            false -> do
                                                arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8" of {
                                                    true -> concat("W", "0");
                                                    false -> "X0"
                                                };
                                                arg_asm: string <- case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                                inline_asm: string <- print_int16_inline@emit_print_uint16_var(term, dest, table);
                                                concat(concat(arg_asm, "\n"), inline_asm)
                                            end
                                        };
                                        false -> case term.name == "main.print_int8" of {
                                            true -> case print_int8_inline@is_print_int8_const_arg(term, table) of {
                                                true -> print_int8_inline@emit_print_int8_inline(term, dest, table, int8_table);
                                                false -> do
                                                    arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8" of {
                                                        true -> concat("W", "0");
                                                        false -> "X0"
                                                    };
                                                    arg_asm: string <- case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                                    inline_asm: string <- print_int8_inline@emit_print_int8_var(term, dest, table);
                                                    concat(concat(arg_asm, "\n"), inline_asm)
                                                end
                                            };
                                            false -> case term.name == "main.print_uint8" of {
                                                true -> case print_int8_inline@is_print_uint8_const_arg(term, table) of {
                                                    true -> print_int8_inline@emit_print_int8_inline(term, dest, table, int8_table);
                                                    false -> do
                                                        arg_reg: string <- case term.inner.type_name == "int32" or term.inner.type_name == "int16" or term.inner.type_name == "int8" or term.inner.type_name == "uint32" or term.inner.type_name == "uint16" or term.inner.type_name == "uint8" of {
                                                            true -> concat("W", "0");
                                                            false -> "X0"
                                                        };
                                                        arg_asm: string <- case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, arg_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                                        inline_asm: string <- print_int8_inline@emit_print_uint8_var(term, dest, table);
                                                        concat(concat(arg_asm, "\n"), inline_asm)
                                                    end
                                                };
                                                false -> case term.name == "main.print_string" of {
                                                    true -> case print_string_inline@is_print_string_const_arg(term, table) of {
                                                        true -> print_string_inline@emit_print_string_inline(term, dest, table, string_literal_table);
                                                        false -> do
                                                            arg_asm: string <- case debug of {
                                                                true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                                                false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                                            };
                                                            inline_asm: string <- print_string_inline@emit_print_string_var(term, dest, table);
                                                            concat(concat(arg_asm, "\n"), inline_asm)
                                                        end
                                                    };
                                                    false -> case term.name == "main.println" of {
                                                        true -> do
                                                            ps_term: SIRTerm <- SIRTerm { kind: 4, type_name: "atom", value: term.value, name: "main.print_string", inner: term.inner, right_expr: sir_ast@dummy_sir_term() };
                                                            first_asm: string <- case print_string_inline@is_print_string_const_arg(ps_term, table) of {
                                                                true -> print_string_inline@emit_print_string_inline(ps_term, dest, table, string_literal_table);
                                                                false -> do
                                                                    arg_asm: string <- case debug of {
                                                                        true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                                                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                                                    };
                                                                    inline_asm: string <- print_string_inline@emit_print_string_var(ps_term, dest, table);
                                                                    concat(concat(arg_asm, "\n"), inline_asm)
                                                                end
                                                            };
                                                            newline_call: SIRTerm <- SIRTerm { kind: 4, type_name: "atom", value: term.value, name: "main.print_string", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
                                                            newline_asm: string <- print_string_inline@emit_print_newline_inline(newline_call, dest);
                                                            concat(concat(first_asm, "\n"), newline_asm)
                                                        end;
                                                        false -> do
                                                            arg_asm: string <- case debug of {
                                                                true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                                                false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                                            };
                                                            call_asm: string <- call@emit_call_body(term, dest);
                                                            concat(concat(arg_asm, "\n"), call_asm)
                                                        end
                                                    };
                                                };
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
                }
            }
        };
        6 -> case term.name == "tuple_make" of {
            true -> do
                left_prefix: string <- reg_conventions@reg_prefix_for_type(term.inner.type_name);
                right_prefix: string <- case term.right_expr.kind == 6 and term.right_expr.name == "tuple_make" of {
                    true -> "X";
                    false -> reg_conventions@reg_prefix_for_type(term.right_expr.type_name)
                };
                left_reg: string <- concat(left_prefix, "1");
                right_reg: string <- concat(right_prefix, "2");
                left_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                right_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                op_asm: string <- prims@emit_prim_op(term, dest);
                concat(concat(concat(concat(left_asm, "\n"), right_asm), "\n"), op_asm)
            end;
            false -> case term.type_name == "string" and (term.name == "string_substring" or term.name == "string_substring_until_char") and term.right_expr.kind == 6 of {
            true -> do
                arg1_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                arg2_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.right_expr.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.right_expr.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                arg3_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.right_expr.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.right_expr.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                op_asm: string <- prims@emit_prim_op(term, dest);
                concat(concat(concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n")), concat(arg3_asm, "\n")), op_asm)
            end;
            false -> case term.type_name == "int64" and (term.name == "string_length_bytes" or term.name == "string_length_chars") of {
                true -> do
                    arg_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                    op_asm: string <- prims@emit_prim_op(term, dest);
                    concat(concat(arg_asm, "\n"), op_asm)
                end;
                false -> do
            // Comparisons (lt, gt, le, ge) have result type "bool" but operands determine reg size
            is_cmp: bool <- term.type_name == "bool" and (term.name == "lt" or term.name == "gt" or term.name == "le" or term.name == "ge");
            prim_type: string <- case is_cmp of { true -> term.inner.type_name; false -> term.type_name };
            is_float64: bool <- prim_type == "float64";
            is_float32: bool <- prim_type == "float32";
            is_narrow: bool <- prim_type == "int32" or prim_type == "int16" or prim_type == "int8" or prim_type == "uint32" or prim_type == "uint16" or prim_type == "uint8";
            is_string_prim: bool <- prim_type == "string" and term.name == "string_concat";
            reg_prefix: string <- case is_float64 of {
                true -> "D";
                false -> case is_float32 of {
                    true -> "S";
                    false -> case is_narrow of {
                        true -> "W";
                        false -> "X"
                    }
                }
            };
            left_reg: string <- case is_string_prim of { true -> "X0"; false -> concat(reg_prefix, "1") };
            right_reg: string <- case is_string_prim of { true -> "X1"; false -> concat(reg_prefix, "2") };
            case bound_name == "" of {
                true -> case term.inner.kind == 6 and term.right_expr.kind == 6 of {
                    true -> do
                        // Both operands are prims: left prim loads into S1,S2, right prim loads into S1,S2.
                        // Emit left into temp (reg 0) to avoid overwrite when right loads its operands.
                        // For string_concat: right also needs X0,X1, so save left to stack before right.
                        temp_reg: string <- concat(reg_prefix, "0");
                        left_asm: string <- case debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                            false -> term_to_asm_opt_bound(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                        };
                        save_left: string <- case is_string_prim of {
                            true -> "    STR X0, [SP, #-16]!\n";
                            false -> ""
                        };
                        right_asm: string <- case debug of {
                            true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                            false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                        };
                        restore_left: string <- case is_string_prim of {
                            true -> "    LDR X0, [SP], #16\n";
                            false -> case is_float64 or is_float32 of {
                                true -> concat(concat(concat(concat("    FMOV ", left_reg), ", "), temp_reg), "\n");
                                false -> concat(concat(concat(concat("    MOV ", left_reg), ", "), temp_reg), "\n")
                            }
                        };
                        op_asm: string <- prims@emit_prim_op(term, dest);
                        part1: string <- concat(left_asm, "\n");
                        part2: string <- concat(part1, save_left);
                        part3: string <- concat(part2, right_asm);
                        part4: string <- concat(part3, "\n");
                        part5: string <- concat(part4, restore_left);
                        concat(part5, op_asm)
                    end;
                    false -> do
                        left_is_prim: bool <- term.inner.kind == 6;
                        right_is_prim: bool <- term.right_expr.kind == 6;
                        (first_asm: string, second_asm: string) <- case left_is_prim of {
                            true -> do
                                l: string <- case debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                    false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                };
                                r: string <- case debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                    false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                };
                                (l, r)
                            end;
                            false -> case right_is_prim of {
                                true -> do
                                    r: string <- case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    l: string <- case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    (r, l)
                                end;
                                false -> case term.inner.kind == 6 and term.right_expr.kind == 6 of {
                                    true -> do
                                        l: string <- case debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                            false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                        };
                                        r: string <- case debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                            false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                        };
                                        (concat(concat(concat(l, "\n"), r), "\n"), "")
                                    end;
                                    false -> do
                                        l: string <- case debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                            false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                        };
                                        r: string <- case debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                            false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                        };
                                        identity_moves: string <- case term.inner.kind == 0 and term.right_expr.kind == 0 and (term.name == "and" or term.name == "or") of {
                                            true -> case is_float64 or is_float32 of {
                                                true -> concat(concat(concat(concat("    FMOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    FMOV ", left_reg), ", "), left_reg), ""));
                                                false -> concat(concat(concat(concat("    MOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    MOV ", left_reg), ", "), left_reg), ""))
                                            };
                                            false -> ""
                                        };
                                        second_with_id: string <- case len(identity_moves) > 0 of {
                                            true -> concat(concat(r, "\n"), identity_moves);
                                            false -> r
                                        };
                                        (l, second_with_id)
                                    end
                                }
                            }
                        };
                        op_asm: string <- prims@emit_prim_op(term, dest);
                        concat(concat(concat(first_asm, "\n"), concat(second_asm, "\n")), op_asm)
                    end
                };
                false -> do
                    right_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                    left_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                    op_asm: string <- prims@emit_prim_op(term, dest);
                    // Emit left before right for string_concat: left may be a var in bound_reg (X1), and right loads into X1.
                    // If we emit right first, we clobber the var before copying it to X0.
                    case is_string_prim of {
                        true -> concat(concat(concat(left_asm, "\n"), concat(right_asm, "\n")), op_asm);
                        false -> concat(concat(concat(right_asm, "\n"), concat(left_asm, "\n")), op_asm)
                    }
                end
            }
            end
            }
            }
        };
        _: int64 -> concat("    ; unsupported term kind ", "?")
    }
}

// Debug variant: prints bound_name, bound_reg, term structure for let and var at each recursion
// When debug and let: traces rhs_reg (from compute_rhs_reg_top_level or compute_rhs_reg_in_let)
fn term_to_asm_opt_bound_debug(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string proc[DeviceIO] {
    do
    rhs_reg_trace: string <- case debug and term.kind == 2 of {
        true -> do
            rhs_reg: string <- case len(bound_name) > 0 and len(bound_reg) > 0 of {
                true -> let_dispatcher@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
                false -> let_dispatcher@compute_rhs_reg_top_level(term, bound_reg, dest)
            };
            branch: string <- case len(bound_name) > 0 and len(bound_reg) > 0 of { true -> "in_let"; false -> "top_level" };
            p1: string <- concat("  [TRACE let] rhs_reg=", rhs_reg);
            p2: string <- concat(p1, " branch=");
            p3: string <- concat(p2, branch);
            p4: string <- concat(p3, " bound_name=");
            p5: string <- concat(p4, bound_name);
            p6: string <- concat(p5, " term.name=");
            p7: string <- concat(p6, term.name);
            p8: string <- concat(p7, " bound_reg=");
            p9: string <- concat(p8, bound_reg);
            p10: string <- concat(p9, " term.inner.kind=");
            kind_str: string <- case term.inner.kind == 0 of { true -> "0(const)"; false -> "non-0" };
            concat(p10, kind_str)
        end;
        false -> ""
    };
    _: int64 <- case len(rhs_reg_trace) > 0 of {
        true -> do println(rhs_reg_trace); 0 end;
        false -> 0
    };
    msg: string <- case len(rhs_reg_trace) == 0 and debug and term.kind == 2 of {
        true -> do
            p1: string <- concat("  [EMITTER let] bound_name=", bound_name);
            p2: string <- concat(p1, " bound_reg=");
            p3: string <- concat(p2, bound_reg);
            concat(p3, concat(" term.name=", term.name))
        end;
        false -> case debug and term.kind == 1 of {
            true -> do
                v1: string <- concat("  [EMITTER var] term.name=", term.name);
                v2: string <- concat(v1, " dest=");
                v3: string <- concat(v2, dest);
                v4: string <- concat(v3, " bound_name=");
                v5: string <- concat(v4, bound_name);
                v6: string <- concat(v5, " bound_reg=");
                v7: string <- concat(v6, bound_reg);
                concat(v7, concat(" outer_reg=", outer_reg))
            end;
            false -> ""
        }
    };
    _: int64 <- case len(msg) > 0 of {
        true -> do println(msg); 0 end;
        false -> 0
    };
    prim_msg: string <- case debug and term.kind == 6 of {
        true -> do
            p1: string <- concat("  [TRACE prim] ", term.name);
            p2: string <- concat(p1, " dest=");
            p3: string <- concat(p2, dest);
            p4: string <- concat(p3, " bound_name=");
            concat(p4, bound_name)
        end;
        false -> ""
    };
    _: int64 <- case len(prim_msg) > 0 of {
        true -> do println(prim_msg); 0 end;
        false -> 0
    };
    const_msg: string <- case debug and term.kind == 0 of {
        true -> do
            p1: string <- concat("  [TRACE const] dest=", dest);
            p2: string <- concat(p1, " value=");
            concat(p2, term.value)
        end;
        false -> ""
    };
    _: int64 <- case len(const_msg) > 0 of {
        true -> do println(const_msg); 0 end;
        false -> 0
    };
    term_to_asm_opt_bound(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug)
    end
}
