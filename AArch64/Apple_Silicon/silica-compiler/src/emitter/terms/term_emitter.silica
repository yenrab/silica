                                                                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                                                    };
                                                                    inline_asm: string <- print_string_inline@emit_print_string_var(ps_term, dest, table);
                                                                    concat(concat(arg_asm, "\n"), inline_asm)
                                                                end
                                                            };
                                                            newline_call: SIRTerm <- SIRTerm { kind: 4, type_name: "atom", value: term.value, name: "main.print_string", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
                                                            newline_asm: string <- print_string_inline@emit_print_newline_inline(newline_call, dest);
                                                            concat(concat(first_asm, "\n"), newline_asm)
                                                        end;
                                                        false -> emit_generic_user_call_asm_inner(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug, false, "")
                                                    };
                                                };
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
                }
            }
        };
        5 -> emit_generic_user_call_asm_inner(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug, true, "[]");
        6 -> case term.name == "tuple_make" of {
            true -> do
                count: int64 <- prims_tuple@count_flat_elements(term);
                alloc_asm: string <- concat("    SUB SP, SP, #", concat(prims_tuple@flat_alloc_size_str(count), "\n"));
                stores_asm: string <- emit_flat_tuple_stores(term, 0, count, 0, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug);
                nested_adjust: int64 <- flat_tuple_nested_alloc(term, count, 0);
                dest_ptr: string <- case len(dest) > 0 and substring(dest, 0, 1) == "W" of {
                    true -> concat("X", substring(dest, 1, len(dest)));
                    false -> dest
                };
                mov_asm: string <- case dest == "SP" of {
                    true -> "";
                    false -> case nested_adjust == 0 of {
                        true -> concat(concat("    MOV ", dest_ptr), ", SP");
                        false -> concat("    ADD ", concat(dest_ptr, concat(", SP, #", atom_table@int64_to_decimal_string(nested_adjust))))
                    }
                };
                concat(alloc_asm, concat(stores_asm, case len(mov_asm) > 0 of { true -> concat("\n", mov_asm); false -> "" }))
            end;
            false -> case term.name == "tuple_proj" of {
            true -> do
                tp_var: string <- case term.inner.kind == 1 of { true -> term.inner.name; false -> "" };
                va_key: string <- concat("_va.", tp_var);
                va_str: string <- case len(tp_var) > 0 of { true -> var@find_sp_binding(outer_reg, va_key); false -> "" };
                var_binding: string <- case len(tp_var) > 0 of { true -> var@find_sp_binding(outer_reg, tp_var); false -> "" };
                // Look up the saved tuple pointer using find_last_sp_binding to get the INNERMOST binding.
                // When nested tuple decompositions reuse the same root variable (e.g. %_td_0 for both
                // outer and inner destructuring), outer_reg accumulates multiple _ptr.%_td_0=... entries.
                // find_last_sp_binding returns the last (most recently added, innermost) occurrence,
                // which is the correct register for the current scope rather than a stale outer binding.
                saved_ptr_reg: string <- case len(tp_var) > 0 of { true -> var@find_last_sp_binding(outer_reg, concat("_ptr.", tp_var)); false -> "" };
                tuple_in_reg: bool <- len(var_binding) > 0 and var@is_memory_ref(var_binding) == false;
                // Priority order for the base register:
                // 1. bound_reg when tp_var == bound_name and bound_reg is a real register (most up-to-date)
                // 2. saved_ptr_reg from _ptr. binding in outer_reg (for function params and cross-scope refs)
                // 3. var_binding from outer_reg
                // 4. bound_reg fallback (even if memory ref) when tp_var == bound_name
                tuple_base_reg_raw: string <- case tp_var == bound_name and len(bound_reg) > 0 and var@is_memory_ref(bound_reg) == false of {
                    true -> bound_reg;
                    false -> case len(saved_ptr_reg) > 0 of {
                        true -> saved_ptr_reg;
                        false -> case tuple_in_reg of {
                            true -> var_binding;
                            false -> case tp_var == bound_name of { true -> bound_reg; false -> "" }
                        }
                    }
                };
                tuple_base_reg: string <- case len(va_str) > 0 of {
                    true -> "";
                    false -> tuple_base_reg_raw
                };
                effective_base: string <- case len(tuple_base_reg) > 0 and tuple_base_reg == "X0" of { true -> "X11"; false -> tuple_base_reg };
                proj_index: int64 <- string_parse@string_to_int64(term.right_expr.value);
                proj_count: int64 <- case len(term.value) > 0 of { true -> string_parse@string_to_int64(term.value); false -> 0 };
                needs_chase: bool <- proj_count > 2 and proj_index > 0 and len(tuple_base_reg) > 0;
                proj_mem_ref: string <- case needs_chase of {
                    true -> "";
                    false -> case len(tuple_base_reg) > 0 of {
                        true -> var@reg_offset_for_index(effective_base, term.right_expr.value);
                        false -> do
                            sp_adj: int64 <- case len(va_str) > 0 of {
                                true -> string_parse@string_to_int64(va_str);
                                false -> do
                                    adj_str: string <- var@find_sp_binding(outer_reg, "_adj");
                                    case len(adj_str) > 0 of { true -> string_parse@string_to_int64(adj_str); false -> 0 }
                                end
                            };
                            var@sp_offset_for_index_adj(term.right_expr.value, sp_adj)
                        end
                    }
                };
                proj_prefix: string <- prims_tuple@ldr_prefix_for_type(term.type_name);
                proj_dest_num: string <- case len(dest) > 0 of { true -> substring(dest, 1, len(dest)); false -> "0" };
                proj_ldr_reg: string <- concat(proj_prefix, proj_dest_num);
                preserve_base: string <- case effective_base == "X11" of { true -> "    MOV X11, X0\n"; false -> "" };
                case needs_chase of {
                    true -> do
                        // For 3+ element tuples stored as (first, ptr_to_flat_rest):
                        // Follow one pointer at [base+8], then flat access at [(index-1)*8].
                        // saved_ptr_reg (e.g. X12 for top-level params, or the actual reg for nested tuples)
                        // is already incorporated into effective_base via tuple_base_reg above.
                        setup_chase: string <- case effective_base == "X11" of { true -> preserve_base; false -> "" };
                        ptr_follow: string <- concat("    LDR X11, [", concat(effective_base, ", #8]\n"));
                        rest_offset: string <- chase_offset_str((proj_index - 1) * 8);
                        final_ldr: string <- concat("    LDR ", concat(proj_ldr_reg, concat(", [X11, ", concat(rest_offset, "]"))));
                        concat(setup_chase, concat(ptr_follow, final_ldr))
                    end;
                    false -> concat(preserve_base, concat("    LDR ", concat(proj_ldr_reg, concat(", ", proj_mem_ref))))
                }
            end;
            false -> case term.type_name == "string" and (term.name == "string_substring" or term.name == "string_substring_until_char") and term.right_expr.kind == 6 of {
            true -> do
                arg1_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                arg2_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.right_expr.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.right_expr.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                arg3_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.right_expr.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(term.right_expr.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                op_asm: string <- prims@emit_prim_op(term, dest);
                guarded_arg3: string <- concat("    STR X1, [SP, #-16]!\n", concat(arg3_asm, "\n    LDR X1, [SP], #16\n"));
                concat(concat(concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n")), guarded_arg3), op_asm)
            end;
            false -> case prims_list@is_list_prim(term.name) of {
            true -> case term.name == "list_nil" of {
                true -> prims_list@emit_prim_op(term, dest);
                false -> case term.name == "list_cons" of {
                    true -> do
                        // Emit tail (arg2) into X2 BEFORE head (arg1) into X1.
                        // Evaluating arg2 first ensures that variable references bound to X1
                        // (e.g. prepend(val, xs) where xs is in X1) are resolved before
                        // arg1 overwrites X1 with the new head value.
                        arg2_asm: string <- case debug of {
                            true -> do term_to_asm_opt_bound_debug(term.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                            false -> term_to_asm_opt_bound(term.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                        };
                        arg1_asm: string <- case debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                            false -> term_to_asm_opt_bound(term.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                        };
                        op_asm: string <- prims_list@emit_prim_op(term, dest);
                        concat(concat(concat(concat(arg2_asm, "\n"), concat(arg1_asm, "\n")), "\n"), op_asm)
                    end;
                    false -> do
                        // list_length arg goes to X9 then MOV X0,X9 in prims_list (helper entry still uses X0);
                        // avoids losing the list pointer when X0 holds a prior int64 result (e.g. chained lets).
                        // list_head/remove_head use X9 for the same reason.
                        arg_dest: string <- "X9";
                        arg_asm: string <- case debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, arg_dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                            false -> term_to_asm_opt_bound(term.inner, arg_dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                        };
                        op_asm: string <- prims_list@emit_prim_op(term, dest);
                        concat(concat(arg_asm, "\n"), op_asm)
                    end
                }
                }
            ;
            false -> case prims_memory@is_memory_prim(term.name) of {
            true -> case term.name == "fresh_lifetime" of {
                true -> prims@emit_prim_op(term, dest);
                false -> case term.name == "alloc_region" of {
                    true -> prims@emit_prim_op(term, dest);
                    false -> case term.name == "read_ref" of {
                    true -> do
                        arg_asm: string <- case debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                            false -> term_to_asm_opt_bound(term.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                        };
                        op_asm: string <- prims@emit_prim_op(term, dest);
                        concat(concat(arg_asm, "\n"), op_asm)
                    end;
                    false -> case term.name == "alloc_ref" or term.name == "alloc_rec" or term.name == "alloc_buf" or term.name == "write_ref" or term.name == "buf_load" or term.name == "read_buf" of {
                        true -> do
                            arg1_asm: string <- case debug of {
                                true -> do term_to_asm_opt_bound_debug(term.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                false -> term_to_asm_opt_bound(term.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                            };
                            arg2_asm: string <- case debug of {
                                true -> do term_to_asm_opt_bound_debug(term.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                false -> term_to_asm_opt_bound(term.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                            };
                            op_asm: string <- prims@emit_prim_op(term, dest);
                            // tuple_make for arg2 uses SUB SP; restore before later ops / return. write_ref leaves ref in X1; bindings expect ref in X2.
                            tuple_stack_bytes: int64 <- flat_tuple_total_alloc(term.right_expr);
                            tuple_sp_restore: string <- case tuple_stack_bytes > 0 of {
                                true -> concat("\n    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(tuple_stack_bytes), "\n"));
                                false -> ""
                            };
                            write_ref_recover: string <- case term.name == "write_ref" of {
                                true -> "\n    MOV X2, X1\n";
                                false -> ""
                            };
                            after_op: string <- concat(op_asm, concat(tuple_sp_restore, write_ref_recover));
                            concat(concat(concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n")), "\n"), after_op)
                        end;
                        false -> case term.name == "buf_store" of {
                            true -> do
                                // Emit arg1 (buf) to X1 before arg2 (idx/val tuple) to X2.
                                // alloc_buf leaves the buffer pointer in X2; tuple_make ends with MOV X2, SP.
                                // If we emitted the tuple first, X2 would be overwritten and the follow-up
                                // buf load (e.g. MOV X1, X2) would pass the tuple pointer to buf_store.
                                // Flat tuple emission uses per-element scratch temps (e.g. X9), not X1.
                                arg1_asm: string <- case debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                    false -> term_to_asm_opt_bound(term.inner, "X1", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                };
                                arg2_asm: string <- case debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                    false -> term_to_asm_opt_bound(term.right_expr, "X2", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                };
                                op_asm: string <- prims@emit_prim_op(term, dest);
                                // tuple_make did SUB SP (possibly multiple for nested tuple_make); restore SP before return / next ops.
                                tuple_bytes: int64 <- flat_tuple_total_alloc(term.right_expr);
                                tuple_sp_adj: string <- concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(tuple_bytes), "\n"));
                                // emit_buf_store leaves X1=buf; LDR X2,[X2] leaves X2=index. Bindings still expect buf in X2.
                                recover_buf_reg: string <- "    MOV X2, X1\n";
                                after_store: string <- concat(op_asm, concat("\n", concat(tuple_sp_adj, concat("\n", recover_buf_reg))));
                                concat(concat(concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n")), "\n"), after_store)
                            end;
                            false -> prims@emit_prim_op(term, dest)
                        }
                    }
                    }
                }
            }
            false -> case term.type_name == "int64" and (term.name == "string_length_bytes" or term.name == "string_length_chars") of {
                true -> do
                    arg_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                    op_asm: string <- prims@emit_prim_op(term, dest);
                    concat(concat(arg_asm, "\n"), op_asm)
                end;
                false -> do
            // Comparisons (lt, gt, le, ge) have result type "bool" but operands determine reg size
            is_cmp: bool <- term.type_name == "bool" and (term.name == "lt" or term.name == "gt" or term.name == "le" or term.name == "ge");
            prim_type: string <- case is_cmp of { true -> term.inner.type_name; false -> term.type_name };
            is_float64: bool <- prim_type == "float64";
            is_float32: bool <- prim_type == "float32";
            is_float16: bool <- prim_type == "float16";
            is_narrow: bool <- prim_type == "int32" or prim_type == "int16" or prim_type == "int8" or prim_type == "uint32" or prim_type == "uint16" or prim_type == "uint8";
            is_string_prim: bool <- prim_type == "string" and term.name == "string_concat";
            reg_prefix: string <- case is_float64 of {
                true -> "D";
                false -> case is_float32 of {
                    true -> "S";
                    false -> case is_float16 of {
                        true -> "H";
                        false -> case is_narrow of {
                            true -> "W";
                            false -> "X"
                        }
                    }
                }
            };
            left_reg: string <- case is_string_prim of { true -> "X0"; false -> case is_float64 or is_float32 or is_float16 of { true -> concat(reg_prefix, "1"); false -> concat(reg_prefix, "9") } };
            right_reg: string <- case is_string_prim of { true -> "X1"; false -> case is_float64 or is_float32 or is_float16 of { true -> concat(reg_prefix, "2"); false -> concat(reg_prefix, "10") } };
            case term.name == "neg" of {
                true -> do
                    // Unary negate_* / prim neg: operand in left_reg only (right_expr is dummy)
                    arg_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                    op_asm: string <- prims@emit_prim_op(term, dest);
                    concat(concat(arg_asm, "\n"), op_asm)
                end;
                false -> case bound_name == "" of {
                true -> case term.inner.kind == 6 and term.right_expr.kind == 6 of {
                    true -> do
                        // Both operands are prims: left prim loads into reg 0, right prim may use reg 0 (calls use X0 for args/result).
                        // Must save left to stack before right eval; right can overwrite temp_reg (X0/D0/S0) via calls or nested prims.
                        // Arithmetic expects left in r1, right in r2. For non-string: put right in right_reg, restore left to left_reg.
                        // String concat expects X0=left, X1=right; keep original layout for is_string_prim.
                        // Important: avoid using X0 as a scratch reg for integer prims because tuple_proj may use X0
                        // as the tuple base pointer (function param), and clobbering it breaks subsequent projections.
                        temp_reg: string <- case is_string_prim or is_float64 or is_float32 or is_float16 of {
                            true -> concat(reg_prefix, "0");
                            false -> left_reg
                        };
                        left_asm: string <- case debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                            false -> term_to_asm_opt_bound(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                        };
                        save_left: string <- case is_string_prim of {
                            true -> "    STR X0, [SP, #-16]!\n";
                            false -> case is_float64 or is_float32 or is_float16 of {
                                true -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                false -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n")
                            }
                        };
                        right_asm: string <- case is_string_prim of {
                            true -> case debug of {
                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                            };
                            false -> case debug of {
                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                            }
                        };
                        restore_left: string <- case is_string_prim of {
                            true -> "    LDR X0, [SP], #16\n";
                            false -> case is_float64 or is_float32 or is_float16 of {
                                true -> concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                            }
                        };
                        op_asm: string <- prims@emit_prim_op(term, dest);
                        part1: string <- concat(left_asm, "\n");
                        part2: string <- concat(part1, save_left);
                        part3: string <- concat(part2, right_asm);
                        part4: string <- concat(part3, "\n");
                        part5: string <- concat(part4, restore_left);
                        concat(part5, op_asm)
                    end;
                    false -> do
                        left_is_prim: bool <- term.inner.kind == 6;
                        right_is_prim: bool <- term.right_expr.kind == 6;
                        (first_asm: string, second_asm: string) <- case left_is_prim of {
                            true -> do
                                // Left is prim, right is var. Arithmetic expects left in r1, right in r2. For non-string: right to right_reg, left to left_reg (save/restore).
                                right_asm: string <- case is_string_prim of {
                                    true -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    false -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    }
                                };
                                save_right: string <- concat(concat(concat("    STR ", right_reg), ", [SP, #-16]!\n"), "");
                                left_asm: string <- case is_string_prim of {
                                    true -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    false -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    }
                                };
                                restore_right: string <- concat(concat(concat("    LDR ", right_reg), ", [SP], #16\n"), "");
                                combined: string <- concat(concat(concat(concat(concat(concat(right_asm, "\n"), save_right), left_asm), "\n"), restore_right), "");
                                (combined, "")
                            end;
                            false -> case right_is_prim of {
                                true -> do
                                    // Left is var/call, right is prim. Arithmetic expects left in r1, right in r2.
                                    // Save left to stack; right to right_reg; restore left to left_reg.
                                    temp_reg: string <- concat(reg_prefix, "0");
                                    left_asm: string <- case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    save_left: string <- case is_string_prim of {
                                        true -> "    STR X0, [SP, #-16]!\n";
                                        false -> case is_float64 or is_float32 or is_float16 of {
                                            true -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                            false -> "    STR X0, [SP, #-16]!\n"
                                        }
                                    };
                                    right_asm: string <- case is_string_prim of {
                                        true -> case debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                            false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                        };
                                        false -> case debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                            false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                        }
                                    };
                                    restore_left: string <- case is_string_prim of {
                                        true -> "    LDR X0, [SP], #16\n";
                                        false -> case is_float64 or is_float32 or is_float16 of {
                                            true -> concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                            false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                        }
                                    };
                                    combined: string <- concat(concat(concat(concat(concat(concat(left_asm, "\n"), save_left), right_asm), "\n"), restore_left), "");
                                    (combined, "")
                                end;
                                false -> case (term.inner.kind == 0 or term.inner.kind == 1) and (term.right_expr.kind == 0 or term.right_expr.kind == 1) of {
                                    true -> do
                                        // Both operands are simple (var or const). Calls (kind 4) overwrite X9/X10; must use save/restore.
                                        // Arithmetic expects left in r1, right in r2 (same as add/mul).
                                        l: string <- case debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                            false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                        };
                                        r: string <- case debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                            false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                        };
                                        // For float32/float64: emit right before left. Left writes to S1/D1 (left_reg),
                                        // which may be the source register for the right var (if bound to S1/D1).
                                        // Emitting right first preserves the right operand before left clobbers its source.
                                        // For string_prim with left=const: loading literal into X0 (left_reg) clobbers right var if right is in X0.
                                        // Emit right first (MOV X1, X0) to save right before loading left literal into X0.
                                        case is_float32 or is_float64 or is_float16 or (is_string_prim and term.inner.kind == 0) of {
                                            true -> (concat(concat(concat(r, "\n"), l), "\n"), "");
                                            false -> (concat(concat(concat(l, "\n"), r), "\n"), "")
                                        }
                                    end;
                                    false -> do
                                        // Arithmetic expects left in r1, right in r2 (same as add/mul). For non-string: left to left_reg, right to right_reg.
                                        // String concat expects X0=left, X1=right; keep original layout.
                                        l: string <- case is_string_prim of {
                                            true -> case debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                                false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                            };
                                            false -> case debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                                false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                            }
                                        };
                                        r: string <- case is_string_prim of {
                                            true -> case debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                            };
                                            false -> case debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                            }
                                        };
                                        identity_moves: string <- case term.inner.kind == 0 and term.right_expr.kind == 0 and (term.name == "and" or term.name == "or") of {
                                            true -> case is_float64 or is_float32 or is_float16 of {
                                                true -> concat(concat(concat(concat("    FMOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    FMOV ", left_reg), ", "), left_reg), ""));
                                                false -> concat(concat(concat(concat("    MOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    MOV ", left_reg), ", "), left_reg), ""))
                                            };
                                            false -> ""
                                        };
                                        second_with_id: string <- case len(identity_moves) > 0 of {
                                            true -> concat(concat(r, "\n"), identity_moves);
                                            false -> r
                                        };
                                        // Left may be a call (kind 4): emit right first, save right_reg, then left, restore (right survives left's clobbers).
                                        // If both operands are calls (e.g. fib(n-1)+fib(n-2)), right eval runs first and BLR leaves X0 = fib(n-2), not n — spill X0 before right, LDR X0 before left so fib(n-1) sees n.
                                        // Right-only call: emit left first, then right; spill left_reg across BLR (AAPCS64 volatiles). See factorial n * factorial(n-1).
                                        left_is_call: bool <- term.inner.kind == 4;
                                        right_is_call: bool <- term.right_expr.kind == 4;
                                        save_x0_before_right_when_both_calls: string <- case left_is_call and right_is_call of {
                                            true -> case is_string_prim of {
                                                true -> "    STR X0, [SP, #-16]!\n";
                                                false -> "    STR X0, [SP, #-16]!\n"
                                            };
                                            false -> ""
                                        };
                                        restore_x0_before_left_when_both_calls: string <- case left_is_call and right_is_call of {
                                            true -> case is_string_prim of {
                                                true -> "    LDR X0, [SP], #16\n";
                                                false -> "    LDR X0, [SP], #16\n"
                                            };
                                            false -> ""
                                        };
                                        save_right_after_restore_x0_both_calls: string <- case left_is_call and right_is_call of {
                                            true -> case is_string_prim of {
                                                true -> "    STR X1, [SP, #-16]!\n";
                                                false -> concat(concat("    STR ", right_reg), ", [SP, #-16]!\n")
                                            };
                                            false -> ""
                                        };
                                        save_left_across_right_call: string <- case right_is_call of {
                                            true -> case is_string_prim of {
                                                true -> "    STR X0, [SP, #-16]!\n";
                                                false -> concat(concat("    STR ", left_reg), ", [SP, #-16]!\n")
                                            };
                                            false -> ""
                                        };
                                        restore_left_across_right_call: string <- case right_is_call of {
                                            true -> case is_string_prim of {
                                                true -> "    LDR X0, [SP], #16\n";
                                                false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                            };
                                            false -> ""
                                        };
                                        save_right: string <- case left_is_call of {
                                            true -> case left_is_call and right_is_call of {
                                                true -> "";
                                                false -> case is_string_prim of {
                                                    true -> "    STR X1, [SP, #-16]!\n";
                                                    false -> concat(concat("    STR ", right_reg), ", [SP, #-16]!\n")
                                                }
                                            };
                                            false -> ""
                                        };
                                        restore_right: string <- case left_is_call of {
                                            true -> case is_string_prim of {
                                                true -> "    LDR X1, [SP], #16\n";
                                                false -> concat(concat("    LDR ", right_reg), ", [SP], #16\n")
                                            };
                                            false -> ""
                                        };
                                        first_combined: string <- case left_is_call of {
                                            true -> do
                                                fc0: string <- concat(save_x0_before_right_when_both_calls, second_with_id);
                                                fc1: string <- concat(concat(concat(concat(concat(concat(fc0, "\n"), restore_x0_before_left_when_both_calls), "\n"), save_right_after_restore_x0_both_calls), "\n"), save_right);
                                                concat(concat(concat(concat(fc1, l), "\n"), restore_right), "")
                                            end;
                                            false -> case right_is_call of {
                                                true -> concat(concat(concat(concat(concat(concat(l, "\n"), save_left_across_right_call), second_with_id), "\n"), restore_left_across_right_call), "");
                                                false -> concat(concat(second_with_id, "\n"), l)
                                            }
                                        };
                                        (first_combined, "")
                                    end
                                }
                            }
                        };
                        op_asm: string <- prims@emit_prim_op(term, dest);
                        concat(concat(concat(first_asm, "\n"), concat(second_asm, "\n")), op_asm)
                    end
                };
                false -> do
                    // bound_name != "": inside let/function body. Use same layout as bound_name=="": left->r1, right->r2.
                    // String concat expects X0=left, X1=right; keep original layout for is_string_prim.
                    left_is_prim: bool <- term.inner.kind == 6;
                    right_is_prim: bool <- term.right_expr.kind == 6;
                    bool_and_or_two_prims: bool <- right_is_prim and term.type_name == "bool" and (term.name == "and" or term.name == "or") and is_string_prim == false and is_float64 == false and is_float32 == false and is_float16 == false;
                    (left_asm: string, right_asm: string) <- case left_is_prim of {
                        true -> case bool_and_or_two_prims of {
                            true -> do
                                temp_reg: string <- left_reg;
                                left_inner: string <- case debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                    false -> term_to_asm_opt_bound(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                };
                                save_left: string <- concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                right_inner: string <- case debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                    false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                };
                                restore_left: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                combined: string <- concat(concat(concat(concat(concat(concat(left_inner, "\n"), save_left), right_inner), "\n"), restore_left), "");
                                (combined, "")
                            end;
                            false -> do
                                l: string <- case is_string_prim of {
                                    true -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    false -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    }
                                };
                                r: string <- case is_string_prim of {
                                    true -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    false -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    }
                                };
                                (l, r)
                            end
                        };
                        false -> case right_is_prim of {
                            true -> do
                                temp_reg: string <- concat(reg_prefix, "0");
                                l: string <- case debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                    false -> term_to_asm_opt_bound(term.inner, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                };
                                save: string <- case is_string_prim of {
                                    true -> "    STR X0, [SP, #-16]!\n";
                                    false -> case is_float64 or is_float32 or is_float16 of {
                                        true -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                        false -> "    STR X0, [SP, #-16]!\n"
                                    }
                                };
                                r: string <- case is_string_prim of {
                                    true -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    false -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    }
                                };
                                restore: string <- case is_string_prim of {
                                    true -> "    LDR X0, [SP], #16\n";
                                    false -> case is_float64 or is_float32 or is_float16 of {
                                        true -> concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                        false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                    }
                                };
                                left_combined: string <- concat(concat(concat(concat(concat(concat(l, "\n"), save), r), "\n"), restore), "");
                                (left_combined, "")
                            end;
                            false -> do
                                // left->left_reg, right->right_reg (same as bound_name=="") for arithmetic.
                                l: string <- case is_string_prim of {
                                    true -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    false -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.inner, left_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    }
                                };
                                r: string <- case is_string_prim of {
                                    true -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    };
                                    false -> case debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                                    }
                                };
                                // For float32/float64: emit right before left. Left writes to S1/D1 (left_reg),
                                // which may be the source register for the right var. Emit right first to preserve it.
                                // For string_prim with left=const: loading literal into X0 (left_reg) clobbers right var if right is in X0.
                                // Emit right first (MOV X1, X0) to save right before loading left literal into X0.
                                // When right operand is a call (kind 4), save/restore left_reg across it (AAPCS64: X9-X15 are caller-saved).
                                right_is_call: bool <- term.right_expr.kind == 4;
                                case right_is_call and is_float64 == false and is_float32 == false and is_float16 == false and is_string_prim == false of {
                                    true -> do
                                        save_left: string <- concat(concat("    STR ", left_reg), ", [SP, #-16]!\n");
                                        restore_left: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                        combined: string <- concat(concat(concat(concat(concat(concat(l, "\n"), save_left), r), "\n"), restore_left), "");
                                        (combined, "")
                                    end;
                                    false -> case is_float32 or is_float64 or is_float16 or (is_string_prim and term.inner.kind == 0) of {
                                        true -> (r, l);
                                        false -> (l, r)
                                    }
                                }
                            end
                        }
                    };
                    op_asm: string <- prims@emit_prim_op(term, dest);
                    case len(right_asm) > 0 of {
                        true -> concat(concat(concat(left_asm, "\n"), concat(right_asm, "\n")), op_asm);
                        false -> concat(concat(left_asm, "\n"), op_asm)
                    }
                end
            }
            }
            end
            }
            }
            }
            }
            }
        };
        _: int64 -> concat("    ; unsupported term kind ", "?")
        }
    }
    }
    end
}

// Debug variant: prints bound_name, bound_reg, term structure for let and var at each recursion
// When debug and let: traces rhs_reg (from compute_rhs_reg_top_level or compute_rhs_reg_in_let)
fn term_to_asm_opt_bound_debug(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string proc[DeviceIO] {
    do
    rhs_reg_trace: string <- case debug and term.kind == 2 of {
        true -> do
            rhs_reg: string <- case len(bound_name) > 0 and len(bound_reg) > 0 of {
                true -> let_dispatcher@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
                false -> let_dispatcher@compute_rhs_reg_top_level(term, bound_reg, dest)
            };
            branch: string <- case len(bound_name) > 0 and len(bound_reg) > 0 of { true -> "in_let"; false -> "top_level" };
            p1: string <- concat("  [TRACE let] rhs_reg=", rhs_reg);
            p2: string <- concat(p1, " branch=");
            p3: string <- concat(p2, branch);
            p4: string <- concat(p3, " bound_name=");
            p5: string <- concat(p4, bound_name);
            p6: string <- concat(p5, " term.name=");
            p7: string <- concat(p6, term.name);
            p8: string <- concat(p7, " bound_reg=");
            p9: string <- concat(p8, bound_reg);
            p10: string <- concat(p9, " term.inner.kind=");
            kind_str: string <- case term.inner.kind == 0 of { true -> "0(const)"; false -> "non-0" };
            concat(p10, kind_str)
        end;
        false -> ""
    };
    _: int64 <- case len(rhs_reg_trace) > 0 of {
        true -> do println(rhs_reg_trace); 0 end;
        false -> 0
    };
    msg: string <- case len(rhs_reg_trace) == 0 and debug and term.kind == 2 of {
        true -> do
            p1: string <- concat("  [EMITTER let] bound_name=", bound_name);
            p2: string <- concat(p1, " bound_reg=");
            p3: string <- concat(p2, bound_reg);
            concat(p3, concat(" term.name=", term.name))
        end;
        false -> case debug and term.kind == 1 of {
            true -> do
                v1: string <- concat("  [EMITTER var] term.name=", term.name);
                v2: string <- concat(v1, " dest=");
                v3: string <- concat(v2, dest);
                v4: string <- concat(v3, " bound_name=");
                v5: string <- concat(v4, bound_name);
                v6: string <- concat(v5, " bound_reg=");
                v7: string <- concat(v6, bound_reg);
                concat(v7, concat(" outer_reg=", outer_reg))
            end;
            false -> ""
        }
    };
    _: int64 <- case len(msg) > 0 of {
        true -> do println(msg); 0 end;
        false -> 0
    };
    prim_msg: string <- case debug and term.kind == 6 of {
        true -> do
            p1: string <- concat("  [TRACE prim] ", term.name);
            p2: string <- concat(p1, " dest=");
            p3: string <- concat(p2, dest);
            p4: string <- concat(p3, " bound_name=");
            p5: string <- concat(p4, bound_name);
            p6: string <- concat(p5, " bound_reg=");
            p7: string <- concat(p6, bound_reg);
            left_is_prim: bool <- term.inner.kind == 6;
            right_is_prim: bool <- term.right_expr.kind == 6;
            bound_empty: bool <- len(bound_name) == 0;
            sub_branch: string <- case left_is_prim of {
                true -> case right_is_prim of { true -> "both_prims"; false -> "left_prim_right_var" };
                false -> case right_is_prim of { true -> "left_var_right_prim"; false -> "both_vars" }
            };
            top_or_let: string <- case bound_empty of { true -> "top"; false -> "in_let" };
            p8: string <- concat(p7, " branch=");
            p9: string <- concat(p8, top_or_let);
            p10: string <- concat(p9, " sub=");
            p11: string <- concat(p10, sub_branch);
            p12: string <- concat(p11, " Lkind=");
            lk: string <- case term.inner.kind == 1 of { true -> term.inner.name; false -> "prim" };
            p13: string <- concat(p12, lk);
            p14: string <- concat(p13, " Rkind=");
            rk: string <- case term.right_expr.kind == 1 of { true -> term.right_expr.name; false -> "prim" };
            concat(p14, rk)
        end;
        false -> ""
    };
    _: int64 <- case len(prim_msg) > 0 of {
        true -> do println(prim_msg); 0 end;
        false -> 0
    };
    const_msg: string <- case debug and term.kind == 0 of {
        true -> do
            p1: string <- concat("  [TRACE const] dest=", dest);
            p2: string <- concat(p1, " value=");
            concat(p2, term.value)
        end;
        false -> ""
    };
    _: int64 <- case len(const_msg) > 0 of {
        true -> do println(const_msg); 0 end;
        false -> 0
    };
    term_to_asm_opt_bound(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug)
    end
}

// For each tuple-typed element in a tuple_make chain, compute the inner adj value and
// encode as |_adj.{idx}={adj}| bindings.  adj_i = suffix_alloc_after_i + elem_i_nested.
fn compute_inner_adj_bindings(term: SIRTerm, idx: int64, count: int64, cumulative_alloc: int64, total_nested: int64) -> string {
    case idx < count - 1 and term.kind == 6 and term.name == "tuple_make" of {
        true -> do
            elem: SIRTerm <- term.inner;
            eit: bool <- elem.kind == 6 and elem.name == "tuple_make";
            eta: int64 <- case eit of { true -> flat_tuple_total_alloc(elem); false -> 0 };
            nc: int64 <- cumulative_alloc + eta;
            binding: string <- case eit of {
                true -> do
                    sa: int64 <- total_nested - nc;
                    ec: int64 <- prims_tuple@count_flat_elements(elem);
                    en: int64 <- flat_tuple_nested_alloc(elem, ec, 0);
                    ia: int64 <- sa + en;
                    concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                end;
                false -> ""
            };
            rest: string <- compute_inner_adj_bindings(term.right_expr, idx + 1, count, nc, total_nested);
            concat(binding, rest)
        end;
        false -> do
            eit: bool <- term.kind == 6 and term.name == "tuple_make";
            eta: int64 <- case eit of { true -> flat_tuple_total_alloc(term); false -> 0 };
            nc: int64 <- cumulative_alloc + eta;
            case eit of {
                true -> do
                    sa: int64 <- total_nested - nc;
                    ec: int64 <- prims_tuple@count_flat_elements(term);
                    en: int64 <- flat_tuple_nested_alloc(term, ec, 0);
                    ia: int64 <- sa + en;
                    concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                end;
                false -> ""
            }
        end
    }
}

// Walk tuple_make chain, emit each element value and store at [SP, #(idx*8 + sp_adjust)].
// count = total elements from type; idx = current element index; sp_adjust = bytes SP moved from nested tuple emissions.
// Returns (assembly_string, total_sp_adjust_after_all_stores) encoded as "asm\x00adjust".
fn emit_flat_tuple_stores(term: SIRTerm, idx: int64, count: int64, sp_adjust: int64, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string {
    case idx < count - 1 and term.kind == 6 and term.name == "tuple_make" of {
        true -> do
            elem: SIRTerm <- term.inner;
            elem_is_tuple: bool <- elem.kind == 6 and elem.name == "tuple_make";
            type_prefix: string <- reg_conventions@reg_prefix_for_type(elem.type_name);
            elem_prefix: string <- case elem_is_tuple of {
                true -> "X";
                false -> case type_prefix == "X" and elem.kind == 0 and value_has_dot(elem.value) of {
                    true -> "D";
                    false -> type_prefix
                }
            };
            // Use a scratch register that won't clobber argument registers (X1/X2),
            // since tuple_make often appears adjacent to memory prims like alloc_ref(region, value).
            temp_reg: string <- concat(elem_prefix, "9");
            elem_asm: string <- case debug of {
                true -> do term_to_asm_opt_bound_debug(elem, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                false -> term_to_asm_opt_bound(elem, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
            };
            nested_bytes: int64 <- case elem_is_tuple of {
                true -> flat_tuple_total_alloc(elem);
                false -> 0
            };
            new_adjust: int64 <- sp_adjust + nested_bytes;
            store_offset: int64 <- idx * 8 + new_adjust;
            store_asm: string <- concat("    STR ", concat(temp_reg, concat(", [SP, #", concat(atom_table@int64_to_decimal_string(store_offset), "]"))));
            rest_asm: string <- emit_flat_tuple_stores(term.right_expr, idx + 1, count, new_adjust, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug);
            concat(concat(elem_asm, concat("\n", store_asm)), concat("\n", rest_asm))
        end;
        false -> do
            elem_is_tuple: bool <- term.kind == 6 and term.name == "tuple_make";
            type_prefix2: string <- reg_conventions@reg_prefix_for_type(term.type_name);
            elem_prefix: string <- case elem_is_tuple of {
                true -> "X";
                false -> case type_prefix2 == "X" and term.kind == 0 and value_has_dot(term.value) of {
                    true -> "D";
                    false -> type_prefix2
                }
            };
            // Use a scratch register that won't clobber argument registers (X1/X2),
            // since tuple_make often appears adjacent to memory prims like alloc_ref(region, value).
            temp_reg: string <- concat(elem_prefix, "9");
            elem_asm: string <- case debug of {
                true -> do term_to_asm_opt_bound_debug(term, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                false -> term_to_asm_opt_bound(term, temp_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
            };
            nested_bytes: int64 <- case elem_is_tuple of {
                true -> flat_tuple_total_alloc(term);
                false -> 0
            };
            new_adjust: int64 <- sp_adjust + nested_bytes;
            store_offset: int64 <- idx * 8 + new_adjust;
            store_asm: string <- concat("    STR ", concat(temp_reg, concat(", [SP, #", concat(atom_table@int64_to_decimal_string(store_offset), "]"))));
            concat(elem_asm, concat("\n", store_asm))
        end
    }
}

// Total stack bytes allocated by a tuple_make tree (this tuple + all nested tuple elements).
fn flat_tuple_total_alloc(term: SIRTerm) -> int64 {
    case term.kind == 6 and term.name == "tuple_make" of {
        true -> do
            my_count: int64 <- prims_tuple@count_flat_elements(term);
            my_size: int64 <- prims_tuple@flat_alloc_size(my_count);
            nested: int64 <- flat_tuple_nested_alloc(term, my_count, 0);
            my_size + nested
        end;
        false -> 0
    }
}

// Sum nested tuple element allocations within a tuple_make chain of `count` elements.
fn flat_tuple_nested_alloc(term: SIRTerm, remaining: int64, acc: int64) -> int64 {
    case remaining <= 1 of {
        true -> case term.kind == 6 and term.name == "tuple_make" of {
            true -> acc + flat_tuple_total_alloc(term);
            false -> acc
        };
        false -> case term.kind == 6 and term.name == "tuple_make" of {
            true -> do
                elem_bytes: int64 <- flat_tuple_total_alloc(term.inner);
                flat_tuple_nested_alloc(term.right_expr, remaining - 1, acc + elem_bytes)
            end;
            false -> acc
        }
    }
}

fn flat_tuple_dealloc_size(term: SIRTerm) -> int64 {
    flat_tuple_total_alloc(term)
}
