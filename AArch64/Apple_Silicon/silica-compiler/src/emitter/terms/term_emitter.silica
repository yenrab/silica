// Term dispatcher: SIRTerm.kind -> emit function
// Delegates to const, var, call, prims per sir_emitter_pattern_spec §4.3

use sir_ast;
use atom_table;
use const_dispatcher;
use var;
use call;
use prims;
use prims_tuple;
use prims_memory;
use string_parse;
use let_dispatcher;
use print_atom_inline;
use print_bool_inline;
use print_int64_inline;
use print_int32_inline;
use print_int16_inline;
use print_int8_inline;
use print_float64_inline;
use print_float32_inline;
use print_string_inline;
use int_rodata;
use int64_literal_pool;
use float64_literal_pool;
use float32_literal_pool;
use string_literal_pool;
use reg_conventions;

export term_to_asm/11;
export term_to_asm_debug/12;
export term_to_asm_debug_with_outer/13;

// Total stack bytes to deallocate for tuple-constructed call arguments.
// tuple_make allocates on SP; callers must restore SP after the call returns.
fn call_tuple_args_dealloc_bytes(term: SIRTerm) -> int64 {
    case term.kind < 0 of {
        true -> 0;
        false -> case term.name == "user_call_rest" of {
            true -> flat_tuple_dealloc_size(term.inner) + call_tuple_args_dealloc_bytes(term.right_expr);
            false -> flat_tuple_dealloc_size(term)
        }
    }
}

fn check_dot_from(value: string, pos: int64, length: int64) -> bool {
    case pos >= length of {
        true -> false;
        false -> case substring(value, pos, pos + 1) == "." of {
            true -> true;
            false -> check_dot_from(value, pos + 1, length)
        }
    }
}

fn value_has_dot(value: string) -> bool {
    check_dot_from(value, 0, len(value))
}

fn arg_reg_for_index(idx: int64, type_name: string) -> string {
    prefix: string <- case type_name == "float64" of {
        true -> "D";
        false -> case type_name == "float32" of {
            true -> "S";
            false -> "X"
        }
    };
    case idx of {
        0 -> concat(prefix, "0");
        1 -> concat(prefix, "1");
        2 -> concat(prefix, "2");
        3 -> concat(prefix, "3");
        4 -> concat(prefix, "4");
        5 -> concat(prefix, "5");
        6 -> concat(prefix, "6");
        7 -> concat(prefix, "7");
        _: int64 -> concat(prefix, "0")
    }
}

fn emit_rest_args(rest: SIRTerm, idx: int64, type_name: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string {
    reg: string <- arg_reg_for_index(idx, type_name);
    case rest.name == "user_call_rest" of {
        true -> do
            arg_asm: string <- case debug of {
                true -> do term_to_asm_opt_bound_debug(rest.inner, reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                false -> term_to_asm_opt_bound(rest.inner, reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
            };
            rest_asm: string <- emit_rest_args(rest.right_expr, idx + 1, type_name, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug);
            concat(concat(arg_asm, "\n"), rest_asm)
        end;
        false -> case debug of {
            true -> do term_to_asm_opt_bound_debug(rest, reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
            false -> term_to_asm_opt_bound(rest, reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
        }
    }
}

fn is_inline_float_var(name: string, dest: string) -> bool {
    case len(name) > 1 of {
        true -> case substring(name, 0, 1) == "#" of {
            true -> case len(dest) > 0 of {
                true -> case substring(dest, 0, 1) == "S" of {
                    true -> true;
                    false -> case substring(dest, 0, 1) == "D" of {
                        true -> true;
                        false -> false
                    }
                };
                false -> false
            };
            false -> false
        };
        false -> false
    }
}

// Emit ADRP+ADD for string const (kept here to avoid 6-param emit_const bootstrap issue).
fn emit_string_const(term: SIRTerm, dest: string, string_literal_table: StringLiteralTable) -> string {
    idx: int64 <- string_literal_pool@string_literal_value_to_index(string_literal_table, term.value);
    label: string <- concat("L_str_", atom_table@int64_to_decimal_string(idx));
    adrp: string <- concat(concat(concat(concat("    ADRP ", dest), ", "), concat(label, "@PAGE")), "\n");
    add: string <- concat(concat(concat(concat("    ADD ", dest), ", "), concat(concat(dest, ", "), concat(label, "@PAGEOFF"))), "");
    concat(adrp, add)
}

// Emit AArch64 assembly for a SIR term. dest is the virtual register for the result.
// Tables: int64, int32, int16, int8 for print_X const label lookup; literal_table for large int64 const; float64_literal_table for float64 const; string_literal_table for string const
fn term_to_asm(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable) -> string {
    term_to_asm_opt_bound(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, "", "", "", false)
}

// Debug variant: when debug is true, prints branch/register info for let and var cases
fn term_to_asm_debug(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, debug: bool) -> string proc[DeviceIO] {
    term_to_asm_opt_bound_debug(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, "", "", "", debug)
}

// Variant with initial outer_reg (for function param bindings: %x=X0, %y=X1, etc.)
fn term_to_asm_debug_with_outer(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, outer_reg: string, debug: bool) -> string proc[DeviceIO] {
    term_to_asm_opt_bound_debug(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, "", "", outer_reg, debug)
}

fn term_to_asm_opt_bound(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string {
    case term.kind of {
        0 -> case term.type_name == "string" of {
            true -> emit_string_const(term, dest, string_literal_table);
            false -> const_dispatcher@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table)
        };
        1 -> case is_inline_float_var(term.name, dest) of {
            true -> do
                float_val: string <- substring(term.name, 1, len(term.name));
                float_type: string <- case substring(dest, 0, 1) == "S" of { true -> "float32"; false -> "float64" };
                synthetic_const: SIRTerm <- SIRTerm { kind: 0, type_name: float_type, value: float_val, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
                const_dispatcher@emit_const(synthetic_const, dest, table, literal_table, float64_literal_table, float32_literal_table)
            end;
            false -> case term.name == bound_name or term.name == concat("%", bound_name) of {
                true -> case len(bound_reg) > 0 and substring(bound_reg, 0, 1) == "[" of {
                    true -> var@emit_var_sp_load(dest, bound_reg);
                    false -> var@emit_var_reg(term, dest, bound_reg)
                };
                false -> var@emit_var_with_sp_check(term, dest, outer_reg)
            }
        };
        2 -> case len(bound_name) > 0 and len(bound_reg) > 0 of {
            true -> do
                clean_bound: string <- var@base_reg_of(bound_reg);
                clean_outer: string <- var@base_reg_of(outer_reg);
                base_rhs: string <- let_dispatcher@compute_rhs_reg_in_let(term, dest, bound_name, clean_bound, clean_outer);
                rhs_reg: string <- case term.inner.kind == 0 and term.inner.type_name == "int64" and dest == "X0" and clean_bound == "X1" of {
                    true -> "X2";
                    false -> base_rhs
                };
                rhs_asm: string <- case term.inner.kind < 0 of {
                    true -> "";
                    false -> case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    }
                };
                adj_str_b: string <- var@find_sp_binding(outer_reg, "_adj");
                sp_adj_b: int64 <- case len(adj_str_b) > 0 of { true -> string_parse@string_to_int64(adj_str_b); false -> 0 };
                tm_adj: int64 <- case term.inner.kind == 6 and term.inner.name == "tuple_make" of {
                    true -> flat_tuple_nested_alloc(term.inner, prims_tuple@count_flat_elements(term.inner), 0);
                    false -> sp_adj_b
                };
                adj_binding: string <- case tm_adj > 0 of {
                    true -> concat("|_adj=", atom_table@int64_to_decimal_string(tm_adj));
                    false -> ""
                };
                iap_b: string <- case term.inner.kind == 6 and term.inner.name == "tuple_make" of {
                    true -> do
                        ic_b: int64 <- prims_tuple@count_flat_elements(term.inner);
                        it_b: int64 <- flat_tuple_nested_alloc(term.inner, ic_b, 0);
                        compute_inner_adj_bindings(term.inner, 0, ic_b, 0, it_b)
                    end;
                    false -> ""
                };
                va_b_tm: string <- case term.inner.kind == 6 and term.inner.name == "tuple_make" of {
                    true -> concat("|_va.", concat(term.name, concat("=", atom_table@int64_to_decimal_string(tm_adj))));
                    false -> ""
                };
                tp_pi_b: string <- case term.inner.kind == 6 and term.inner.name == "tuple_proj" and len(va_b_tm) == 0 of {
                    true -> term.inner.right_expr.value;
                    false -> ""
                };
                tp_eas_b: string <- case len(tp_pi_b) > 0 and reg_conventions@is_tuple_type(term.inner.type_name) of {
                    true -> var@find_sp_binding(outer_reg, concat("_adj.", tp_pi_b));
                    false -> ""
                };
                va_b_tp: string <- case len(tp_pi_b) > 0 and reg_conventions@is_tuple_type(term.inner.type_name) of {
                    true -> case len(tp_eas_b) > 0 of {
                        true -> concat("|_va.", concat(term.name, concat("=", tp_eas_b)));
                        false -> concat("|_va.", concat(term.name, "=0"))
                    };
                    false -> ""
                };
                vr_svk_b: string <- case term.inner.kind == 1 and (reg_conventions@is_tuple_type(term.inner.type_name) or reg_conventions@is_tuple_type(term.type_name)) and len(va_b_tm) == 0 and len(va_b_tp) == 0 of {
                    true -> concat("_va.", term.inner.name);
                    false -> ""
                };
                vr_svs_b: string <- case len(vr_svk_b) > 0 of { true -> var@find_sp_binding(outer_reg, vr_svk_b); false -> "" };
                vr_adj_fb: string <- case len(vr_svs_b) == 0 and len(vr_svk_b) > 0 of {
                    true -> var@find_sp_binding(outer_reg, "_adj");
                    false -> vr_svs_b
                };
                va_b_vr: string <- case len(vr_svk_b) > 0 of {
                    true -> case len(vr_adj_fb) > 0 of {
                        true -> concat("|_va.", concat(term.name, concat("=", vr_adj_fb)));
                        false -> ""
                    };
                    false -> ""
                };
                va_b: string <- concat(va_b_tm, concat(va_b_tp, va_b_vr));
                proj_tpv: string <- case term.inner.kind == 6 and term.inner.name == "tuple_proj" of {
                    true -> case term.inner.inner.kind == 1 of { true -> term.inner.inner.name; false -> "" };
                    false -> ""
                };
                proj_tvs: string <- case len(proj_tpv) > 0 of { true -> var@find_sp_binding(outer_reg, concat("_va.", proj_tpv)); false -> "" };
                proj_sp_adj: int64 <- case len(proj_tvs) > 0 of { true -> string_parse@string_to_int64(proj_tvs); false -> sp_adj_b };
                tp_proj_var_b: string <- case term.inner.kind == 6 and term.inner.name == "tuple_proj" and term.inner.inner.kind == 1 of { true -> term.inner.inner.name; false -> "" };
                tp_ptr_reg_b: string <- case len(tp_proj_var_b) > 0 of {
                    true -> do
                        from_outer: string <- var@find_sp_binding(outer_reg, concat("_ptr.", tp_proj_var_b));
                        case len(from_outer) > 0 of {
                            true -> from_outer;
                            false -> case tp_proj_var_b == bound_name and len(bound_reg) > 0 and substring(bound_reg, 0, 1) != "[" of {
                                true -> bound_reg;
                                false -> ""
                            }
                        }
                    end;
                    false -> ""
                };
                tp_is_reg_b: bool <- len(tp_ptr_reg_b) > 0;
                body_bound: string <- case tp_is_reg_b of {
                    true -> rhs_reg;
                    false -> var@tuple_proj_body_bound(term.inner, rhs_reg, proj_sp_adj)
                };
                ptr_binding_inner: string <- case term.inner.kind == 1 and reg_conventions@is_tuple_type(term.type_name) and len(rhs_reg) > 0 and substring(rhs_reg, 0, 1) != "[" of {
                    true -> concat("|_ptr.", concat(term.name, concat("=", rhs_reg)));
                    false -> ""
                };
                reg_binding_inner: string <- case tp_is_reg_b of {
                    true -> concat("|", concat(term.name, concat("=", rhs_reg)));
                    false -> ""
                };
                new_outer_raw: string <- case tp_is_reg_b of {
                    true -> do
                        nob_r: string <- var@base_reg_of(outer_reg);
                        nosp_r: string <- var@extract_sp_bindings(outer_reg);
                        concat(nob_r, concat(nosp_r, reg_binding_inner))
                    end;
                    false -> var@build_outer_with_sp(bound_name, bound_reg, outer_reg, term.name, term.inner, proj_sp_adj)
                };
                nob: string <- var@base_reg_of(new_outer_raw);
                nosp: string <- var@extract_sp_bindings(new_outer_raw);
                new_outer: string <- concat(nob, concat(va_b, concat(adj_binding, concat(iap_b, concat(nosp, ptr_binding_inner)))));
                body_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, term.name, body_bound, new_outer, true) end;
                    false -> term_to_asm_opt_bound(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, term.name, body_bound, new_outer, false)
                };
                dealloc_bytes: int64 <- case reg_conventions@is_tuple_type(term.inner.type_name) of {
                    true -> flat_tuple_dealloc_size(term.inner);
                    false -> 0
                };
                dealloc: string <- case dealloc_bytes > 0 of {
                    true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(dealloc_bytes), "\n"));
                    false -> ""
                };
                rhs_sep: string <- case len(rhs_asm) > 0 and substring(rhs_asm, len(rhs_asm) - 1, len(rhs_asm)) == "\n" of {
                    true -> "";
                    false -> "\n"
                };
                concat(concat(rhs_asm, rhs_sep), case len(dealloc) > 0 of {
                    true -> concat(concat(body_asm, "\n"), dealloc);
                    false -> body_asm
                })
            end;
            false -> do
                base_rhs: string <- let_dispatcher@compute_rhs_reg_top_level(term, bound_reg, dest);
                rhs_reg: string <- case term.inner.kind == 0 and term.inner.type_name == "int64" and dest == "X0" and term.right_expr.kind != 4 of {
                    true -> "X1";
                    false -> base_rhs
                };
                rhs_asm: string <- case term.inner.kind < 0 of {
                    true -> "";
                    false -> case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    }
                };
                tm_adj_tl: int64 <- case term.inner.kind == 6 and term.inner.name == "tuple_make" of {
                    true -> flat_tuple_nested_alloc(term.inner, prims_tuple@count_flat_elements(term.inner), 0);
                    false -> 0
                };
                adj_binding_tl: string <- case tm_adj_tl > 0 of {
                    true -> concat("|_adj=", atom_table@int64_to_decimal_string(tm_adj_tl));
                    false -> ""
                };
                iap_tl: string <- case term.inner.kind == 6 and term.inner.name == "tuple_make" of {
                    true -> do
                        ic_tl: int64 <- prims_tuple@count_flat_elements(term.inner);
                        it_tl: int64 <- flat_tuple_nested_alloc(term.inner, ic_tl, 0);
                        compute_inner_adj_bindings(term.inner, 0, ic_tl, 0, it_tl)
                    end;
                    false -> ""
                };
                vab_tl: string <- case term.inner.kind == 6 and term.inner.name == "tuple_make" of {
                    true -> concat("|_va.", concat(term.name, concat("=", atom_table@int64_to_decimal_string(tm_adj_tl))));
                    false -> ""
                };
                body_bound_tl: string <- var@tuple_proj_body_bound(term.inner, rhs_reg, 0);
                tp_binding_tl: string <- var@new_tp_binding(term.name, term.inner, 0);
                reg_binding_tl: string <- var@reg_binding(term.name, rhs_reg);
                ptr_binding_tl: string <- case term.inner.kind == 1 and reg_conventions@is_tuple_type(term.type_name) and len(rhs_reg) > 0 and substring(rhs_reg, 0, 1) != "[" of {
                    true -> concat("|_ptr.", concat(term.name, concat("=", rhs_reg)));
                    false -> ""
                };
                new_outer_tl: string <- concat(rhs_reg, concat(reg_binding_tl, concat(tp_binding_tl, concat(adj_binding_tl, concat(iap_tl, concat(vab_tl, ptr_binding_tl))))));
                body_asm: string <- case debug of {
                    true -> do term_to_asm_opt_bound_debug(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, term.name, body_bound_tl, new_outer_tl, true) end;
                    false -> term_to_asm_opt_bound(term.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, term.name, body_bound_tl, new_outer_tl, false)
                };
                dealloc_bytes_tl: int64 <- flat_tuple_dealloc_size(term.inner);
                dealloc: string <- case dealloc_bytes_tl > 0 of {
                    true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(dealloc_bytes_tl), "\n"));
                    false -> ""
                };
                rhs_sep: string <- case len(rhs_asm) > 0 and substring(rhs_asm, len(rhs_asm) - 1, len(rhs_asm)) == "\n" of {
                    true -> "";
                    false -> "\n"
                };
                concat(concat(rhs_asm, rhs_sep), case len(dealloc) > 0 of {
                    true -> concat(concat(body_asm, "\n"), dealloc);
                    false -> body_asm
                })
            end
        };
        4 -> case term.name == "main.print_atom" of {
            true -> case print_atom_inline@is_print_atom_const_arg(term, table) of {
                true -> print_atom_inline@emit_print_atom_inline(term, dest, table);
                false -> do
                    arg_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                    inline_asm: string <- print_atom_inline@emit_print_atom_by_index(term, dest, table);
                    concat(concat(arg_asm, "\n"), inline_asm)
                end
            };
            false -> case term.name == "main.print_bool" of {
                true -> case print_bool_inline@is_print_bool_const_arg(term, table) of {
                    true -> print_bool_inline@emit_print_bool_inline(term, dest, table);
                    false -> do
                        arg_asm: string <- case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, "X0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    };
                        inline_asm: string <- print_bool_inline@emit_print_bool_var(term, dest, table);
                        concat(concat(arg_asm, "\n"), inline_asm)
                    end
                };
                false -> case term.name == "main.print_float64" of {
                    true -> do
                        arg_asm: string <- case debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, "D0", table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
