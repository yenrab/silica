// Term dispatcher: SIRTerm.kind -> emit function
// Delegates to const, var, call, prims per sir_emitter_pattern_spec §4.3

use sir_ast;
use atom_table;
use const_dispatcher;
use var;
use call;
use prims;
use prims_tuple;
use prims_memory;
use prims_list;
use string_parse;
use let_dispatcher;
use print_atom_inline;
use print_bool_inline;
use print_int64_inline;
use print_int32_inline;
use print_int16_inline;
use print_int8_inline;
use print_float64_inline;
use print_float32_inline;
use print_string_inline;
use int_rodata;
use int64_literal_pool;
use float64_literal_pool;
use float32_literal_pool;
use string_literal_pool;
use reg_conventions;
use recursion_support;

export term_to_asm/11;
export emit_function_tail_user_call_root/14;
export term_to_asm_debug/12;
export term_to_asm_debug_with_outer/13;

// Total stack bytes to deallocate for tuple-constructed call arguments.
// tuple_make allocates on SP; callers must restore SP after the call returns.
// Convert an integer offset to a # prefixed string for AArch64 immediates
fn chase_offset_str(byte_offset: int64) -> string {
    concat("#", atom_table@int64_to_decimal_string(byte_offset))
}

fn call_tuple_args_dealloc_bytes(term: SIRTerm) -> int64 {
    case term.kind < 0 of {
        true -> 0;
        false -> case term.name == "user_call_rest" of {
            true -> flat_tuple_dealloc_size(term.inner) + call_tuple_args_dealloc_bytes(term.right_expr);
            false -> flat_tuple_dealloc_size(term)
        }
    }
}

fn check_dot_from(value: string, pos: int64, length: int64) -> bool {
    case pos >= length of {
        true -> false;
        false -> case substring(value, pos, pos + 1) == "." of {
            true -> true;
            false -> check_dot_from(value, pos + 1, length)
        }
    }
}

fn value_has_dot(value: string) -> bool {
    check_dot_from(value, 0, len(value))
}

fn arg_reg_for_index(idx: int64, type_name: string) -> string {
    prefix: string <- case type_name == "float64" of {
        true -> "D";
        false -> case type_name == "float32" of {
            true -> "S";
            false -> "X"
        }
    };
    case idx of {
        0 -> concat(prefix, "0");
        1 -> concat(prefix, "1");
        2 -> concat(prefix, "2");
        3 -> concat(prefix, "3");
        4 -> concat(prefix, "4");
        5 -> concat(prefix, "5");
        6 -> concat(prefix, "6");
        7 -> concat(prefix, "7");
        _: int64 -> concat(prefix, "0")
    }
}

fn emit_rest_args(rest: SIRTerm, idx: int64, type_name: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string {
    reg: string <- arg_reg_for_index(idx, type_name);
    case rest.name == "user_call_rest" of {
        true -> do
            arg_asm: string <- case debug of {
                true -> do term_to_asm_opt_bound_debug(rest.inner, reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                false -> term_to_asm_opt_bound(rest.inner, reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
            };
            rest_asm: string <- case rest.right_expr.kind < 0 of {
                true -> "";
                false -> emit_rest_args(rest.right_expr, idx + 1, type_name, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug)
            };
            // fib_iter(n-1, b, a+b): emitting var(b)→X1 at idx=1 clobbers a(X1) before add(a,b)→X2 can read it.
            // Detect: idx==1, current arg is var(v), next arg is add/mul with v as an operand.
            // Fix: STR next_reg; emit add/mul into next_reg using original X1=a and X2=b; LDR current_reg=b.
            // Guard all field accesses: first confirm idx/kind/name before descending into inner nodes.
            next_is_add_or_mul: bool <- case idx == 1 and rest.right_expr.kind >= 0 and rest.inner.kind == 1 of {
                true -> case rest.right_expr.name == "user_call_rest" of {
                    true -> rest.right_expr.inner.kind == 6
                        and (rest.right_expr.inner.name == "add" or rest.right_expr.inner.name == "mul");
                    false -> rest.right_expr.kind == 6
                        and (rest.right_expr.name == "add" or rest.right_expr.name == "mul")
                };
                false -> false
            };
            next_arg_node: SIRTerm <- case next_is_add_or_mul of {
                true -> case rest.right_expr.name == "user_call_rest" of {
                    true -> rest.right_expr.inner;
                    false -> rest.right_expr
                };
                false -> rest.inner
            };
            next_has_matching_var: bool <- case next_is_add_or_mul of {
                true -> (next_arg_node.inner.kind == 1 and next_arg_node.inner.name == rest.inner.name)
                    or (next_arg_node.right_expr.kind == 1 and next_arg_node.right_expr.name == rest.inner.name);
                false -> false
            };
            use_save_next_for_current: bool <- next_has_matching_var;
            next_reg: string <- arg_reg_for_index(idx + 1, type_name);
            next_arg_asm: string <- case use_save_next_for_current of {
                true -> case debug of {
                    true -> do term_to_asm_opt_bound_debug(next_arg_node, next_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                    false -> term_to_asm_opt_bound(next_arg_node, next_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                };
                false -> ""
            };
            further_rest_asm: string <- case use_save_next_for_current of {
                true -> case rest.right_expr.name == "user_call_rest" and rest.right_expr.right_expr.kind >= 0 of {
                    true -> emit_rest_args(rest.right_expr.right_expr, idx + 2, type_name, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug);
                    false -> ""
                };
                false -> ""
            };
            save_next: string <- concat(concat("    STR ", next_reg), ", [SP, #-16]!\n");
            restore_current: string <- concat(concat("    LDR ", reg), ", [SP], #16\n");
            case use_save_next_for_current of {
                true -> concat(concat(concat(concat(save_next, next_arg_asm), "\n"), restore_current), further_rest_asm);
                false -> concat(concat(arg_asm, "\n"), rest_asm)
            }
        end;
        false -> case debug of {
            true -> do term_to_asm_opt_bound_debug(rest, reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
            false -> term_to_asm_opt_bound(rest, reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
        }
    }
}

fn is_inline_float_var(name: string, dest: string) -> bool {
    case len(name) > 1 of {
        true -> case substring(name, 0, 1) == "#" of {
            true -> case len(dest) > 0 of {
                true -> case substring(dest, 0, 1) == "S" of {
                    true -> true;
                    false -> case substring(dest, 0, 1) == "D" of {
                        true -> true;
                        false -> false
                    }
                };
                false -> false
            };
            false -> false
        };
        false -> false
    }
}

// Emit ADRP+ADD for string const (kept here to avoid 6-param emit_const bootstrap issue).
fn emit_string_const(term: SIRTerm, dest: string, string_literal_table: StringLiteralTable) -> string {
    idx: int64 <- string_literal_pool@string_literal_value_to_index(string_literal_table, term.value);
    label: string <- concat("L_str_", atom_table@int64_to_decimal_string(idx));
    adrp: string <- concat(concat(concat(concat("    ADRP ", dest), ", "), concat(label, "@PAGE")), "\n");
    add: string <- concat(concat(concat(concat("    ADD ", dest), ", "), concat(concat(dest, ", "), concat(label, "@PAGEOFF"))), "");
    concat(adrp, add)
}

// Case labels: legacy L_case_br_N / L_case_done / L_case_fb when case_name is empty.
// When SIR kind-3 term.name is non-empty (e.g. "o" + source offset), use L_case{name}_br_N so nested case/if does not reuse symbols.
fn case_emit_done_label(case_name: string) -> string {
    case len(case_name) > 0 of {
        true -> concat(concat(concat("L_case_", case_name), "_"), "done");
        false -> "L_case_done"
    }
}

fn case_emit_fb_label(case_name: string) -> string {
    case len(case_name) > 0 of {
        true -> concat(concat(concat("L_case_", case_name), "_"), "fb");
        false -> "L_case_fb"
    }
}

fn case_emit_branch_entry_label(case_name: string, idx: int64) -> string {
    idx_s: string <- atom_table@int64_to_decimal_string(idx);
    case len(case_name) > 0 of {
        true -> concat(concat(concat(concat("L_case_", case_name), "_br_"), idx_s), "");
        false -> concat("L_case_br_", idx_s)
    }
}

// AArch64 CMP uses Wn for 32-bit compare of low bits of Xn (matches bool scrutinee convention).
fn scrut_reg_w_for_cmp(scrut_reg: string) -> string {
    case len(scrut_reg) > 0 of {
        true -> case substring(scrut_reg, 0, 1) == "X" of {
            true -> concat("W", substring(scrut_reg, 1, len(scrut_reg)));
            false -> scrut_reg
        };
        false -> scrut_reg
    }
}

// Case (SIR kind 3): scrutinee in inner, branch list in right_expr (kind 7 chain of kind 8 branches).
fn emit_case_pattern_check(branch: SIRTerm, scrut_t: string, scrut_reg: string, lit_reg: string, fail_l: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable) -> string {
    pk: string <- branch.value;
    case pk == "wild" of {
        true -> "";
        false -> case pk == "bind" of {
            true -> "";
            false -> case pk == "bool" of {
                true -> do
                    imm: string <- case branch.name == "true" of { true -> "1"; false -> "0" };
                    wreg: string <- scrut_reg_w_for_cmp(scrut_reg);
                    cmp_ln: string <- concat(concat(concat(concat("    CMP ", wreg), ", #"), imm), "\n");
                    bne_ln: string <- concat(cmp_ln, concat("    B.NE ", fail_l));
                    concat(bne_ln, "\n")
                end;
                false -> case pk == "int" of {
                    true -> do
                        syn: SIRTerm <- SIRTerm { kind: 0, type_name: scrut_t, value: branch.name, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
                        ld: string <- const_dispatcher@emit_const(syn, lit_reg, table, literal_table, float64_literal_table, float32_literal_table);
                        ln: string <- concat(ld, "\n");
                        cmp_ln: string <- concat(concat(concat(ln, "    CMP "), scrut_reg), ", ");
                        cmp_full: string <- concat(concat(cmp_ln, lit_reg), "\n");
                        bne_ln: string <- concat(cmp_full, "    B.NE ");
                        concat(concat(bne_ln, fail_l), "\n")
                    end;
                    false -> case pk == "string" of {
                        true -> do
                            syn: SIRTerm <- SIRTerm { kind: 0, type_name: "string", value: branch.name, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
                            ld: string <- emit_string_const(syn, lit_reg, string_literal_table);
                            str_save: string <- concat(concat(concat("    STR ", scrut_reg), ", [SP, #-16]!\n"), concat(ld, "\n"));
                            mov_x0_ln: string <- concat(concat("    MOV X0, ", scrut_reg), "\n");
                            mov_x1_ln: string <- concat(concat("    MOV X1, ", lit_reg), "\n");
                            bl_ln: string <- "    BL L_string_eq_helper\n";
                            mov_bl: string <- concat(concat(mov_x0_ln, mov_x1_ln), bl_ln);
                            cmp_bne: string <- concat(concat(concat("    CMP W12, #0\n", "    B.EQ "), fail_l), "\n");
                            tail: string <- concat(concat(concat("    MOV W12, W0\n    LDR ", scrut_reg), ", [SP], #16\n"), cmp_bne);
                            concat(concat(str_save, mov_bl), tail)
                        end;
                        false -> case pk == "list_nil" of {
                            true -> do
                                cmp_ln: string <- concat(concat(concat("    CMP ", scrut_reg), ", #0\n"), "");
                                bne_ln: string <- concat(cmp_ln, concat("    B.NE ", fail_l));
                                concat(bne_ln, "\n")
                            end;
                            false -> case pk == "list_cons" of {
                                true -> concat(concat(concat("    CBZ ", scrut_reg), ", "), concat(fail_l, "\n"));
                                false -> concat(concat("    B ", fail_l), "\n")
                            }
                        }
                    }
                }
            }
        }
    }
}

// List cons pattern: branch.name is "%h|%t" (or _), branch.type_name is "head_t|list_t" (SIR).
fn emit_list_cons_pattern_loads(branch: SIRTerm, scrut_reg: string, outer_reg: string) -> (string, string) {
    pipe_n: int64 <- var@find_pipe_from(branch.name, 0);
    case pipe_n < 0 of {
        true -> ("", outer_reg);
        false -> do
            left_pat: string <- substring(branch.name, 0, pipe_n);
            right_pat: string <- substring(branch.name, pipe_n + 1, len(branch.name));
            pipe_t: int64 <- var@find_pipe_from(branch.type_name, 0);
            head_t: string <- case pipe_t < 0 of {
                true -> "";
                false -> substring(branch.type_name, 0, pipe_t)
            };
            ext0: string <- outer_reg;
            (asm_h: string, ext1: string) <- case left_pat == "_" of {
                true -> ("", ext0);
                false -> do
                    hr: string <- var@next_free_int_reg(ext0);
                    hr_w: string <- case reg_conventions@is_narrow_type(head_t) of {
                        true -> concat("W", substring(hr, 1, len(hr)));
                        false -> hr
                    };
                    h_ld: string <- case reg_conventions@is_narrow_type(head_t) of {
                        true -> case head_t of {
                            "int8" -> concat(concat(concat(concat("    LDRSB ", hr_w), ", ["), scrut_reg), "]\n");
                            "uint8" -> concat(concat(concat(concat("    LDRB ", hr_w), ", ["), scrut_reg), "]\n");
                            "int16" -> concat(concat(concat(concat("    LDRSH ", hr_w), ", ["), scrut_reg), "]\n");
                            "uint16" -> concat(concat(concat(concat("    LDRH ", hr_w), ", ["), scrut_reg), "]\n");
                            _: string -> concat(concat(concat(concat("    LDR ", hr_w), ", ["), scrut_reg), "]\n")
                        };
                        false -> concat(concat(concat(concat("    LDR ", hr), ", ["), scrut_reg), "]\n")
                    };
                    nb: string <- var@reg_binding(left_pat, hr);
                    (h_ld, concat(ext0, nb))
                end
            };
            (asm_t: string, ext2: string) <- case right_pat == "_" of {
                true -> ("", ext1);
                false -> do
                    tr: string <- var@next_free_int_reg(ext1);
                    t_ld: string <- concat(concat(concat(concat("    LDR ", tr), ", ["), scrut_reg), ", #8]\n");
                    nb2: string <- var@reg_binding(right_pat, tr);
                    (t_ld, concat(ext1, nb2))
                end
            };
            (concat(asm_h, asm_t), ext2)
        end
    }
}

fn emit_case_one_branch_inner(branch: SIRTerm, scrut_t: string, scrut_reg: string, lit_reg: string, guard_reg: string, dest: string, done_l: string, fail_l: string, entry_l: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string {
    pat_asm: string <- emit_case_pattern_check(branch, scrut_t, scrut_reg, lit_reg, fail_l, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table);
    pkind: string <- branch.value;
    (list_bind_asm: string, outer_for_list: string) <- case pkind == "list_cons" of {
        true -> emit_list_cons_pattern_loads(branch, scrut_reg, outer_reg);
        false -> ("", outer_reg)
    };
    pat_full: string <- concat(pat_asm, list_bind_asm);
    br_bn: string <- case pkind == "bind" of {
        true -> case len(branch.name) > 1 of { true -> substring(branch.name, 1, len(branch.name)); false -> "" };
        false -> bound_name
    };
    br_br: string <- case pkind == "bind" of {
        true -> scrut_reg;
        false -> bound_reg
    };
    outer_body: string <- case pkind == "list_cons" of {
        true -> outer_for_list;
        false -> outer_reg
    };
    guard_asm: string <- case branch.inner.kind < 0 of {
        true -> "";
        false -> do
            g_asm: string <- term_to_asm_opt_bound(branch.inner, guard_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, br_bn, br_br, outer_body, false);
            g_nl: string <- concat(g_asm, "\n");
            cbz_mid: string <- concat(concat(concat(g_nl, "    CBZ "), guard_reg), ", ");
            concat(cbz_mid, concat(fail_l, "\n"))
        end
    };
    body_asm: string <- term_to_asm_opt_bound(branch.right_expr, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, br_bn, br_br, outer_body, false);
    h0: string <- concat(entry_l, ":\n");
    h1: string <- concat(concat(h0, pat_full), guard_asm);
    h2: string <- concat(concat(h1, body_asm), "\n");
    br: string <- concat(concat("    B ", done_l), "\n");
    concat(h2, br)
}

fn emit_case_branch_seq(rest: SIRTerm, scrut_t: string, scrut_reg: string, lit_reg: string, guard_reg: string, dest: string, done_l: string, fb_l: string, case_name: string, idx: int64, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string {
    case rest.kind < 0 of {
        true -> "";
        false -> case rest.kind == 7 of {
            true -> do
                fail_l: string <- case rest.right_expr.kind < 0 of {
                    true -> fb_l;
                    false -> case_emit_branch_entry_label(case_name, idx + 1)
                };
                entry_l: string <- case_emit_branch_entry_label(case_name, idx);
                inner_asm: string <- emit_case_one_branch_inner(rest.inner, scrut_t, scrut_reg, lit_reg, guard_reg, dest, done_l, fail_l, entry_l, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug);
                tail_asm: string <- emit_case_branch_seq(rest.right_expr, scrut_t, scrut_reg, lit_reg, guard_reg, dest, done_l, fb_l, case_name, idx + 1, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug);
                concat(inner_asm, tail_asm)
            end;
            false -> ""
        }
    }
}

// Case scrutinee default: dest X0/X1 -> X2 so we do not use X0 (result). If outer_reg already binds X2
// (e.g. let value <- 2; case cmd of { ... } with cmd in X1), use X3+ so loading the scrutinee does not clobber value.
// term_to_asm_opt_bound passes bound_reg = body_bound: the register for the enclosing let's binding in the
// case body (e.g. let value <- 2 in case cmd -> body_bound is X2 where value lives). Default scrutinee X2
// would clobber that; use X3+ when body_bound is X2 or outer_reg records X2.
fn emit_case_pick_scrut_reg(dest: string, outer_reg: string, bound_reg: string) -> string {
    case dest == "X1" of {
        true -> case var@is_reg_bound(outer_reg, "X2") of {
            true -> case var@is_reg_bound(outer_reg, "X3") of {
                true -> case var@is_reg_bound(outer_reg, "X4") of { true -> "X5"; false -> "X4" };
                false -> "X3"
            };
            false -> case bound_reg == "X2" of {
                true -> "X3";
                false -> "X2"
            }
        };
        false -> case dest == "X0" of {
            true -> case var@is_reg_bound(outer_reg, "X2") of {
                true -> case var@is_reg_bound(outer_reg, "X3") of {
                    true -> case var@is_reg_bound(outer_reg, "X4") of { true -> "X5"; false -> "X4" };
                    false -> "X3"
                };
                false -> case bound_reg == "X2" of {
                    true -> "X3";
                    false -> "X2"
                }
            };
            false -> "X1"
        }
    }
}

fn emit_case_lit_reg_for_scrut(scrut_reg: string) -> string {
    case scrut_reg == "X1" of {
        true -> "X3";
        false -> case scrut_reg == "X2" of {
            true -> "X3";
            false -> case scrut_reg == "X3" of {
                true -> "X4";
                false -> case scrut_reg == "X4" of {
                    true -> "X5";
                    false -> case scrut_reg == "X5" of {
                        true -> "X6";
                        false -> "X2"
                    }
                }
            }
        }
    }
}

fn emit_case_guard_reg_for_scrut(scrut_reg: string) -> string {
    case scrut_reg == "X1" of {
        true -> "X4";
        false -> case scrut_reg == "X2" of {
            true -> "X4";
            false -> case scrut_reg == "X3" of {
                true -> "X5";
                false -> case scrut_reg == "X4" of {
                    true -> "X6";
                    false -> case scrut_reg == "X5" of {
                        true -> "X7";
                        false -> "X3"
                    }
                }
            }
        }
    }
}

fn emit_case_expression(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string {
    // Scrutinee register must not clobber AArch64 args still needed in branch bodies. X0/X1 are the first two
    // int64 params; placing the bool scrutinee in X1 when dest is X0 (return) breaks e.g. ack(m,n): CSET X1,EQ
    // overwrites n before the true branch can do n+1.
    scrut_reg: string <- emit_case_pick_scrut_reg(dest, outer_reg, bound_reg);
    lit_reg: string <- emit_case_lit_reg_for_scrut(scrut_reg);
    guard_reg: string <- emit_case_guard_reg_for_scrut(scrut_reg);
    scrut_asm: string <- term_to_asm_opt_bound(term.inner, scrut_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false);
    case_name: string <- term.name;
    done_l: string <- case_emit_done_label(case_name);
    fb_l: string <- case_emit_fb_label(case_name);
    branches_asm: string <- emit_case_branch_seq(term.right_expr, term.value, scrut_reg, lit_reg, guard_reg, dest, done_l, fb_l, case_name, 0, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug);
    fb_head: string <- concat(concat(concat(fb_l, ":\n    MOV "), dest), ", #0\n");
    fb_tail: string <- concat(concat("    B ", done_l), "\n");
    fb_asm: string <- concat(fb_head, fb_tail);
    scr_nl: string <- concat(scrut_asm, "\n");
    scr_br: string <- concat(scr_nl, branches_asm);
    scr_fb: string <- concat(scr_br, fb_asm);
    done_lbl: string <- concat(done_l, ":\n");
    concat(scr_fb, done_lbl)
}

// Generic user call (non-builtin): args in regs, then BLR or tail BR. use_tail + fn_effects for kind 5 / root tail.
fn emit_generic_user_call_asm_inner(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool, use_tail: bool, fn_effects_for_tail: string) -> string {
    arg1_reg: string <- arg_reg_for_index(0, term.type_name);
    arg1_asm: string <- case debug of {
        true -> do term_to_asm_opt_bound_debug(term.inner, arg1_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
        false -> term_to_asm_opt_bound(term.inner, arg1_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
    };
    rest_asm: string <- case term.right_expr.kind >= 0 of {
        true -> case term.right_expr.name == "user_call_rest" of {
            true -> emit_rest_args(term.right_expr, 1, term.type_name, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug);
            false -> case debug of {
                true -> do term_to_asm_opt_bound_debug(term.right_expr, arg_reg_for_index(1, term.type_name), table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                false -> term_to_asm_opt_bound(term.right_expr, arg_reg_for_index(1, term.type_name), table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
            }
        };
        false -> ""
    };
    call_asm: string <- case use_tail of {
        true -> call@emit_tail_call_body(term, fn_effects_for_tail);
        false -> call@emit_call_body(term, dest)
    };
    // Two GPR args (X0, X1): if arg1 is evaluated first it may clobber X0 while arg2 is a nested
    // call that still needs the caller's first argument in X0 (e.g. ack(m-1, ack(m, n-1))). Then:
    // STR X0; emit arg2 into X1; LDR X0; emit arg1 into X0. Only when arg2 is a call (kind 4): if arg2
    // is a var/const, X0 may no longer hold the first param (e.g. after let inner <- ack(...)) and
    // STR would save the wrong value. Skip 3+ arg chains (user_call_rest with non-dummy tail) and floats.
    arg2_reg: string <- arg_reg_for_index(1, term.type_name);
    two_arg_tail_rest: bool <- case term.right_expr.name == "user_call_rest" of {
        true -> term.right_expr.right_expr.kind < 0;
        false -> true
    };
    arg2_term_ok: bool <- case term.right_expr.name == "user_call_rest" of {
        true -> term.right_expr.inner.kind >= 0;
        false -> term.right_expr.kind >= 0
    };
    arg2_is_nested_call: bool <- case term.right_expr.name == "user_call_rest" of {
        true -> term.right_expr.inner.kind == 4;
        false -> term.right_expr.kind == 4
    };
    use_two_arg_gpr_reorder: bool <- len(rest_asm) > 0
        and arg1_reg == "X0"
        and arg2_reg == "X1"
        and two_arg_tail_rest
        and term.inner.kind >= 0
        and arg2_term_ok
        and arg2_is_nested_call;
    // Tail gcd(b, a % b): emitting arg1 first does MOV X0,X1 and clobbers a/b before rem loads X9/X10 from X0/X1.
    // Emit rem into arg2_reg first; divisor stays in r10 (see arithmetic@emit_rem_op). Then MOV arg1_reg, r10 when
    // first arg is the same var as rem's right operand (divisor).
    // SIR: kind 0=const, 1=var. rem's divisor is the right subterm; first tail arg must be that same var.
    // Two-arg calls often wrap arg2 as user_call_rest(inner=rem, dummy tail) — not prim(rem) at top level.
    rem_arg1_is_divisor: bool <- case term.right_expr.kind == 6 and term.right_expr.name == "user_call_rest" of {
        true -> case term.right_expr.inner.kind == 6 and term.right_expr.inner.name == "rem" of {
            true -> term.inner.kind == 1
                and term.right_expr.inner.right_expr.kind == 1
                and term.inner.name == term.right_expr.inner.right_expr.name;
            false -> false
        };
        false -> case term.right_expr.kind == 6 and term.right_expr.name == "rem" of {
            true -> term.inner.kind == 1
                and term.right_expr.right_expr.kind == 1
                and term.inner.name == term.right_expr.right_expr.name;
            false -> false
        }
    };
    use_two_arg_gpr_reorder_rem_first: bool <- len(rest_asm) > 0
        and two_arg_tail_rest
        and arg2_term_ok
        and rem_arg1_is_divisor;
    // sum_to(n-1, acc+n): arg1=sub clobbers X0(n) before arg2=add can read n for acc+n. Emit add into X1 first; X0 still n.
    // SIR: sub left (minuend) must match add right — same var as first param in X0.
    add_second_before_sub: bool <- case term.right_expr.kind == 6 and term.right_expr.name == "user_call_rest" of {
        true -> case term.right_expr.inner.kind == 6 and term.right_expr.inner.name == "add" of {
            true -> case term.inner.kind == 6 and term.inner.name == "sub" of {
                true -> term.inner.inner.kind == 1
                    and term.right_expr.inner.right_expr.kind == 1
                    and term.inner.inner.name == term.right_expr.inner.right_expr.name;
                false -> false
            };
            false -> false
        };
        false -> case term.right_expr.kind == 6 and term.right_expr.name == "add" of {
            true -> case term.inner.kind == 6 and term.inner.name == "sub" of {
                true -> term.inner.inner.kind == 1
                    and term.right_expr.right_expr.kind == 1
                    and term.inner.inner.name == term.right_expr.right_expr.name;
                false -> false
            };
            false -> false
        }
    };
    // factorial_acc(n-1, acc*n): arg1=sub clobbers X0(n) before arg2=mul can read n for acc*n. Emit mul into X1 first.
    // SIR: sub left (minuend) must match mul right — same var as first param in X0.
    mul_second_before_sub: bool <- case term.right_expr.kind == 6 and term.right_expr.name == "user_call_rest" of {
        true -> case term.right_expr.inner.kind == 6 and term.right_expr.inner.name == "mul" of {
            true -> case term.inner.kind == 6 and term.inner.name == "sub" of {
                true -> term.inner.inner.kind == 1
                    and term.right_expr.inner.right_expr.kind == 1
                    and term.inner.inner.name == term.right_expr.inner.right_expr.name;
                false -> false
            };
            false -> false
        };
        false -> case term.right_expr.kind == 6 and term.right_expr.name == "mul" of {
            true -> case term.inner.kind == 6 and term.inner.name == "sub" of {
                true -> term.inner.inner.kind == 1
                    and term.right_expr.right_expr.kind == 1
                    and term.inner.inner.name == term.right_expr.right_expr.name;
                false -> false
            };
            false -> false
        }
    };
    use_two_arg_gpr_reorder_add_second_first: bool <- len(rest_asm) > 0
        and two_arg_tail_rest
        and arg2_term_ok
        and (add_second_before_sub or mul_second_before_sub);
    // str_len_acc/count_a_acc/sum_digits_acc: arg1=substring sets MOV X1,#start clobbering acc(X1) before arg2 can use it.
    // Fix: emit arg2 (rest_asm) first to compute acc result into X1, save X1, emit substring arg1, restore X1.
    arg1_is_substring: bool <- term.inner.kind == 6
        and (term.inner.name == "string_substring" or term.inner.name == "string_substring_until_char");
    use_arg2_first_around_substring_arg1: bool <- len(rest_asm) > 0
        and two_arg_tail_rest
        and arg1_is_substring
        and arg1_reg == "X0"
        and arg2_reg == "X1";
    args_asm: string <- case len(rest_asm) > 0 of {
        true -> case use_two_arg_gpr_reorder of {
            true -> do
                save0: string <- "    STR X0, [SP, #-16]!\n";
                bridge: string <- "    LDR X0, [SP], #16\n";
                concat(concat(concat(concat(concat(save0, rest_asm), "\n"), bridge), arg1_asm), "\n")
            end;
            false -> case use_two_arg_gpr_reorder_rem_first of {
                true -> do
                    rp: string <- reg_conventions@reg_prefix_for_type(term.type_name);
                    arg1_gpr: string <- concat(rp, "0");
                    div_gpr: string <- concat(rp, "10");
                    mov_line: string <- concat(concat(concat(concat("    MOV ", arg1_gpr), ", "), div_gpr), "\n");
                    concat(concat(rest_asm, "\n"), mov_line)
                end;
                false -> case use_two_arg_gpr_reorder_add_second_first of {
                    true -> concat(concat(rest_asm, "\n"), concat(arg1_asm, "\n"));
                    false -> case use_arg2_first_around_substring_arg1 of {
                        true -> concat(concat(concat(concat(rest_asm, "\n"), "    STR X1, [SP, #-16]!\n"), concat(arg1_asm, "\n")), "    LDR X1, [SP], #16\n");
                        false -> concat(concat(arg1_asm, "\n"), concat(rest_asm, "\n"))
                    }
                }
            }
        };
        false -> concat(arg1_asm, "\n")
    };
    dealloc_bytes_call: int64 <- call_tuple_args_dealloc_bytes(term.inner)
        + call_tuple_args_dealloc_bytes(term.right_expr);
    dealloc_asm_call: string <- case dealloc_bytes_call > 0 of {
        true -> concat("\n    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(dealloc_bytes_call), ""));
        false -> ""
    };
    fuel: string <- case use_tail of {
        true -> recursion_support@emit_fuel_backedge_stub_comment();
        false -> ""
    };
    concat(fuel, concat(concat(args_asm, call_asm), dealloc_asm_call))
}

// Root function body only: SIR kind 5 tail user call with enclosing function effects for frame release + barriers.
fn emit_function_tail_user_call_root(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, outer_reg: string, fn_effects: string, debug: bool) -> string {
    emit_generic_user_call_asm_inner(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, "", "", outer_reg, debug, true, fn_effects)
}

// Emit AArch64 assembly for a SIR term. dest is the virtual register for the result.
// Tables: int64, int32, int16, int8 for print_X const label lookup; literal_table for large int64 const; float64_literal_table for float64 const; string_literal_table for string const
fn term_to_asm(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable) -> string {
    term_to_asm_opt_bound(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, "", "", "", false)
}

// Debug variant: when debug is true, prints branch/register info for let and var cases
fn term_to_asm_debug(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, debug: bool) -> string proc[DeviceIO] {
    term_to_asm_opt_bound_debug(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, "", "", "", debug)
}

// Variant with initial outer_reg (for function param bindings: %x=X0, %y=X1, etc.)
fn term_to_asm_debug_with_outer(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, outer_reg: string, debug: bool) -> string proc[DeviceIO] {
    term_to_asm_opt_bound_debug(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, "", "", outer_reg, debug)
}

fn term_to_asm_opt_bound(term: SIRTerm, dest: string, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, bound_name: string, bound_reg: string, outer_reg: string, debug: bool) -> string {
    do
    k_rel_case: int64 <- term.kind - 3;
    case k_rel_case == 0 of {
        true -> emit_case_expression(term, dest, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, debug);
        false -> case term.kind + 1 < 2 of {
            true -> case term.kind + 1 == 1 of {
                true -> case term.type_name == "string" of {
                    true -> emit_string_const(term, dest, string_literal_table);
                    false -> const_dispatcher@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table)
                };
                false -> concat("    ; unsupported term kind (dummy k)", "?")
            };
            false -> case term.kind of {
        1 -> case is_inline_float_var(term.name, dest) of {
            true -> do
                float_val: string <- substring(term.name, 1, len(term.name));
                float_type: string <- case substring(dest, 0, 1) == "S" of { true -> "float32"; false -> "float64" };
                synthetic_const: SIRTerm <- SIRTerm { kind: 0, type_name: float_type, value: float_val, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() };
                const_dispatcher@emit_const(synthetic_const, dest, table, literal_table, float64_literal_table, float32_literal_table)
            end;
            false -> do
                bound_norm: string <- case substring(bound_name, 0, 1) == "%" of {
                    true -> bound_name;
                    false -> concat("%", bound_name)
                };
                case term.name == bound_norm of {
                    true -> case len(bound_reg) > 0 and substring(bound_reg, 0, 1) == "[" of {
                        true -> var@emit_var_sp_load(dest, bound_reg);
                        false -> var@emit_var_reg(term, dest, bound_reg)
                    };
                    false -> var@emit_var_with_sp_check(term, dest, outer_reg)
                }
            end
        };
        2 -> case len(bound_name) > 0 and len(bound_reg) > 0 of {
            true -> do
                clean_bound: string <- var@base_reg_of(bound_reg);
                clean_outer: string <- var@base_reg_of(outer_reg);
                base_rhs: string <- let_dispatcher@compute_rhs_reg_in_let(term, dest, bound_name, clean_bound, outer_reg);
                rhs_reg: string <- case term.inner.kind == 0 and term.inner.type_name == "int64" and dest == "X0" and clean_bound == "X1" of {
                    true -> "X2";
                    false -> base_rhs
                };
                rhs_asm: string <- case term.inner.kind < 0 of {
                    true -> "";
                    false -> case debug of {
                        true -> do term_to_asm_opt_bound_debug(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, true) end;
                        false -> term_to_asm_opt_bound(term.inner, rhs_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, bound_name, bound_reg, outer_reg, false)
                    }
                };
                adj_str_b: string <- var@find_sp_binding(outer_reg, "_adj");
                sp_adj_b: int64 <- case len(adj_str_b) > 0 of { true -> string_parse@string_to_int64(adj_str_b); false -> 0 };
                tm_adj: int64 <- case term.inner.kind == 6 and term.inner.name == "tuple_make" of {
                    true -> flat_tuple_nested_alloc(term.inner, prims_tuple@count_flat_elements(term.inner), 0);
                    false -> sp_adj_b
                };
                adj_binding: string <- case tm_adj > 0 of {
                    true -> concat("|_adj=", atom_table@int64_to_decimal_string(tm_adj));
                    false -> ""
                };
                iap_b: string <- case term.inner.kind == 6 and term.inner.name == "tuple_make" of {
                    true -> do
                        ic_b: int64 <- prims_tuple@count_flat_elements(term.inner);
                        it_b: int64 <- flat_tuple_nested_alloc(term.inner, ic_b, 0);
                        compute_inner_adj_bindings(term.inner, 0, ic_b, 0, it_b)
                    end;
                    false -> ""
                };
                va_b_tm: string <- case term.inner.kind == 6 and term.inner.name == "tuple_make" of {
                    true -> concat("|_va.", concat(term.name, concat("=", atom_table@int64_to_decimal_string(tm_adj))));
                    false -> ""
                };
                tp_pi_b: string <- case term.inner.kind == 6 and term.inner.name == "tuple_proj" and len(va_b_tm) == 0 of {
                    true -> term.inner.right_expr.value;
                    false -> ""
                };
                tp_eas_b: string <- case len(tp_pi_b) > 0 and reg_conventions@is_tuple_type(term.inner.type_name) of {
                    true -> var@find_sp_binding(outer_reg, concat("_adj.", tp_pi_b));
                    false -> ""
                };
                va_b_tp: string <- case len(tp_pi_b) > 0 and reg_conventions@is_tuple_type(term.inner.type_name) of {
                    true -> case len(tp_eas_b) > 0 of {
                        true -> concat("|_va.", concat(term.name, concat("=", tp_eas_b)));
                        false -> ""
                    };
                    false -> ""
                };
                vr_svk_b: string <- case term.inner.kind == 1 and (reg_conventions@is_tuple_type(term.inner.type_name) or reg_conventions@is_tuple_type(term.type_name)) and len(va_b_tm) == 0 and len(va_b_tp) == 0 of {
                    true -> concat("_va.", term.inner.name);
                    false -> ""
                };
                vr_svs_b: string <- case len(vr_svk_b) > 0 of { true -> var@find_sp_binding(outer_reg, vr_svk_b); false -> "" };
                vr_adj_fb: string <- case len(vr_svs_b) == 0 and len(vr_svk_b) > 0 of {
                    true -> var@find_sp_binding(outer_reg, "_adj");
                    false -> vr_svs_b
                };
                va_b_vr: string <- case len(vr_svk_b) > 0 of {
                    true -> case len(vr_adj_fb) > 0 of {
                        true -> concat("|_va.", concat(term.name, concat("=", vr_adj_fb)));
                        false -> ""
                    };
                    false -> ""
                };
                va_b: string <- concat(va_b_tm, concat(va_b_tp, va_b_vr));
                proj_tpv: string <- case term.inner.kind == 6 and term.inner.name == "tuple_proj" of {
                    true -> case term.inner.inner.kind == 1 of { true -> term.inner.inner.name; false -> "" };
                    false -> ""
                };
                proj_tvs: string <- case len(proj_tpv) > 0 of { true -> var@find_sp_binding(outer_reg, concat("_va.", proj_tpv)); false -> "" };
                proj_sp_adj: int64 <- case len(proj_tvs) > 0 of { true -> string_parse@string_to_int64(proj_tvs); false -> sp_adj_b };
                tp_proj_var_b: string <- case term.inner.kind == 6 and term.inner.name == "tuple_proj" and term.inner.inner.kind == 1 of { true -> term.inner.inner.name; false -> "" };
                tp_ptr_reg_b: string <- case len(tp_proj_var_b) > 0 of {
                    true -> do
                        from_outer: string <- var@find_sp_binding(outer_reg, concat("_ptr.", tp_proj_var_b));
                        case len(from_outer) > 0 of {
                            true -> from_outer;
                            false -> case tp_proj_var_b == bound_name and len(bound_reg) > 0 and substring(bound_reg, 0, 1) != "[" of {
                                true -> bound_reg;
                                false -> ""
                            }
                        }
                    end;
                    false -> ""
                };
                tp_is_reg_b: bool <- len(tp_ptr_reg_b) > 0;
                body_bound: string <- case tp_is_reg_b of {
                    true -> rhs_reg;
                    false -> case term.inner.kind == 6 and term.inner.name == "tuple_proj" and len(proj_tvs) > 0 of {
                        true -> var@sp_offset_for_index_adj(term.inner.right_expr.value, proj_sp_adj);
                        false -> var@tuple_proj_body_bound(term.inner, rhs_reg, proj_sp_adj)
                    }
                };
                tuple_elem_count_b: int64 <- case term.inner.kind == 1 and reg_conventions@is_tuple_type(term.type_name) of { true -> prims_tuple@count_type_elements(term.type_name); false -> 0 };
                ptr_binding_inner: string <- case term.inner.kind == 1 and reg_conventions@is_tuple_type(term.type_name) and len(rhs_reg) > 0 and substring(rhs_reg, 0, 1) != "[" of {
                    true -> case tuple_elem_count_b > 2 of {
