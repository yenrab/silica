                nob: string <- var@base_reg_of(new_outer_raw);
                nosp: string <- var@extract_sp_bindings(new_outer_raw);
                new_outer: string <- concat(nob, concat(va_b, concat(adj_binding, concat(iap_b, concat(nosp, ptr_binding_inner)))));
                body_asm: string <- case debug of {
