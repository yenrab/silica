// Operator recognition for Silica lexer
// Recognizes minimal operators: ->, delimiters, arithmetic/comparison ops

// Import token kind enum
use lexer_token_kind;

// Import lexer core types
use lexer_core;

// Import for negative numeric literals (-1.414, -42, etc.)
use lexer_integer_literals;
use lexer_float_literals;


{-
- Returns true if the character is one of the operator/grouping characters recognized by this module: '-', '>', '(', ')', '{', '}' (used for the arrow "->" and for parentheses and braces); returns false otherwise.
- Used by the lexer to detect when the current character can start or be part of an operator token. Fits into the design as the predicate that gates operator tokenization (e.g. before reading "->" or single-char grouping tokens).
- Example: is_operator_char('-') and is_operator_char('>') return true; they form the "->" arrow operator.
- Example: is_operator_char('(') and is_operator_char('}') return true; grouping characters are operator characters.
- Example: is_operator_char('a') and is_operator_char('+') return false; letters and other symbols are not in the recognized operator set.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over one character; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_operator_char(c: char) -> bool {
    case c of {
        '-' -> true;
        '>' -> true;
        '(' -> true;
        ')' -> true;
        '{' -> true;
        '}' -> true;
        '[' -> true;
        ']' -> true;
        ',' -> true;
        '.' -> true;
        '@' -> true;
        '+' -> true;
        '*' -> true;
        '/' -> true;
        '%' -> true;
        '<' -> true;
        '=' -> true;
        '!' -> true;
        _: char -> false
    }
}


{-
- Returns true if the character is a grouping character: '(', ')', '{', or '}'; returns false otherwise.
- Used by the lexer to detect parentheses and braces so they can be tokenized as single-character grouping tokens. Subset of the operator characters; allows the lexer to treat grouping separately (e.g. for read_grouping or dispatch). Fits into the design as the predicate for grouping-only tokens.
- Example: is_grouping_char('(') and is_grouping_char(')') return true; parentheses are grouping characters.
- Example: is_grouping_char('{') and is_grouping_char('}') return true; braces are grouping characters.
- Example: is_grouping_char('-') and is_grouping_char('a') return false; arrow and letters are not grouping characters.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over one character; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_grouping_char(c: char) -> bool {
    case c of {
        '(' -> true;
        ')' -> true;
        '{' -> true;
        '}' -> true;
        '[' -> true;
        ']' -> true;
        _: char -> false
    }
}

{-
- If the lexer is at "-" followed by ">", consumes both and returns the right_arrow token with lexeme "->" and the updated lexer; otherwise returns an eof token and the lexer unchanged (so the caller can treat this as "not an arrow").
- Used when the lexer has seen "-" and must distinguish "->" from a lone "-" or other use. Only succeeds when both characters are present; on failure the lexer is not advanced so another path (e.g. single "-" or error) can handle it. Fits into the design as the two-character arrow tokenizer.
- Example: lexer at "-" of "-> x" — first is "-", advance; second is ">", advance; result is (Token right_arrow "->", lexer past ">").
- Example: lexer at "-" of "- 5" — first is "-", second is " "; result is (Token eof "", lexer unchanged); not "->".
- Example: lexer at "x" — first is not "-"; result is (Token eof "", lexer unchanged).
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Two peeks, up to two advances, one token; no recursion.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn read_arrow(lexer: Lexer) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    
    // Read '-' character
    first: string <- lexer_core@peek_char(lexer);
    case first of {
        "-" -> do
            after_minus: Lexer <- lexer_core@advance(lexer);
            second: string <- lexer_core@peek_char(after_minus);
            case second of {
                ">" -> (lexer_core@make_token(kinds.right_arrow, "->", start_location), lexer_core@advance(after_minus));
                _: string -> case lexer_integer_literals@is_decimal_digit_char(second) or second == "." of {
                    true -> lexer_float_literals@read_negative_numeric_literal(after_minus, start_location);
                    false -> (lexer_core@make_token(kinds.minus, "-", start_location), after_minus)
                }
            }
        end;
        _: string -> (lexer_core@make_token(kinds.eof, "", start_location), lexer)
    }
}


{-
- Consumes a single-character arithmetic operator (+, *, /, %) and returns the corresponding token with lexeme and the advanced lexer.
- Used when the lexer has peeked one of these characters; advances once and returns the token.
- Time: O(1), Ω(1), Θ(1).
-}
fn read_single_char_arithmetic(lexer: Lexer, c: string) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    updated_lexer: Lexer <- lexer_core@advance(lexer);
    
    case c of {
        "+" -> (lexer_core@make_token(kinds.plus, "+", start_location), updated_lexer);
        "*" -> (lexer_core@make_token(kinds.star, "*", start_location), updated_lexer);
        "/" -> (lexer_core@make_token(kinds.slash, "/", start_location), updated_lexer);
        "%" -> (lexer_core@make_token(kinds.percent, "%", start_location), updated_lexer);
        _: string -> (lexer_core@make_token(kinds.eof, "", start_location), lexer)
    }
}


{-
- If the lexer is at "<" followed by "=", consumes both and returns less_equal; if at "<" followed by "-", consumes both and returns left_arrow (binding/assignment); if at "<" alone, consumes it and returns less_than.
- Time: O(1), Ω(1), Θ(1).
-}
fn read_less_than(lexer: Lexer) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    first: string <- lexer_core@peek_char(lexer);
    case first of {
        "<" -> do
            after_less: Lexer <- lexer_core@advance(lexer);
            second: string <- lexer_core@peek_char(after_less);
            case second of {
                "=" -> (lexer_core@make_token(kinds.less_equal, "<=", start_location), lexer_core@advance(after_less));
                "-" -> (lexer_core@make_token(kinds.left_arrow, "<-", start_location), lexer_core@advance(after_less));
                _: string -> (lexer_core@make_token(kinds.less_than, "<", start_location), after_less)
            }
        end;
        _: string -> (lexer_core@make_token(kinds.eof, "", start_location), lexer)
    }
}


{-
- If the lexer is at ">" followed by "=", consumes both and returns greater_equal; if at ">" alone, consumes it and returns greater_than.
- Time: O(1), Ω(1), Θ(1).
-}
fn read_greater_than(lexer: Lexer) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    first: string <- lexer_core@peek_char(lexer);
    case first of {
        ">" -> do
            after_greater: Lexer <- lexer_core@advance(lexer);
            second: string <- lexer_core@peek_char(after_greater);
            case second of {
                "=" -> (lexer_core@make_token(kinds.greater_equal, ">=", start_location), lexer_core@advance(after_greater));
                _: string -> (lexer_core@make_token(kinds.greater_than, ">", start_location), after_greater)
            }
        end;
        _: string -> (lexer_core@make_token(kinds.eof, "", start_location), lexer)
    }
}


{-
- If the lexer is at "=" followed by "=", consumes both and returns equal_equal; if at "=" alone, consumes it and returns equal.
- Time: O(1), Ω(1), Θ(1).
-}
fn read_equal(lexer: Lexer) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    first: string <- lexer_core@peek_char(lexer);
    case first of {
        "=" -> do
            after_equal: Lexer <- lexer_core@advance(lexer);
            second: string <- lexer_core@peek_char(after_equal);
            case second of {
                "=" -> (lexer_core@make_token(kinds.equal_equal, "==", start_location), lexer_core@advance(after_equal));
                _: string -> (lexer_core@make_token(kinds.equal, "=", start_location), after_equal)
            }
        end;
        _: string -> (lexer_core@make_token(kinds.eof, "", start_location), lexer)
    }
}


{-
- If the lexer is at "!" followed by "=", consumes both and returns bang_equal; if at "!" alone, consumes it and returns unknown_char.
- Time: O(1), Ω(1), Θ(1).
-}
fn read_bang_equal(lexer: Lexer) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    first: string <- lexer_core@peek_char(lexer);
    case first of {
        "!" -> do
            after_bang: Lexer <- lexer_core@advance(lexer);
            second: string <- lexer_core@peek_char(after_bang);
            case second of {
                "=" -> (lexer_core@make_token(kinds.bang_equal, "!=", start_location), lexer_core@advance(after_bang));
                _: string -> (lexer_core@make_token(kinds.unknown_char, "!", start_location), after_bang)
            }
        end;
        _: string -> (lexer_core@make_token(kinds.eof, "", start_location), lexer)
    }
}

// Read a single character grouping operator
// Returns token with lexeme and updated lexer
{-
- Consumes the current character (expected to be one of "(", ")", "{", "}") and returns the corresponding grouping token (left_paren, right_paren, left_brace, right_brace) with that lexeme and the advanced lexer; if c is not a grouping character, returns an eof token and the lexer unchanged.
- Used when the lexer has already peeked a grouping character: pass peek_char(lexer) as c; the function advances once and returns the token. Caller should only call when c is known to be a grouping char (e.g. is_grouping_char) to avoid the fallback. Fits into the design as the single place that turns a grouping character into its token.
- Example: read_grouping_operator(lexer, "(") with lexer at "(" — advances past "(", returns (Token left_paren "(", lexer past "(").
- Example: read_grouping_operator(lexer, "}") — returns (Token right_brace "}", lexer past "}").
- Example: read_grouping_operator(lexer, "x") — c is not grouping; returns (Token eof "", lexer unchanged); caller should not have invoked with non-grouping c.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One advance, one case match, one token; no recursion.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn read_grouping_operator(lexer: Lexer, c: string) -> (Token, Lexer) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    updated_lexer: Lexer <- lexer_core@advance(lexer);
    
    case c of {
        "(" -> (lexer_core@make_token(kinds.left_paren, "(", start_location), updated_lexer);
        ")" -> (lexer_core@make_token(kinds.right_paren, ")", start_location), updated_lexer);
        "{" -> (lexer_core@make_token(kinds.left_brace, "{", start_location), updated_lexer);
        "}" -> (lexer_core@make_token(kinds.right_brace, "}", start_location), updated_lexer);
        "[" -> (lexer_core@make_token(kinds.left_bracket, "[", start_location), updated_lexer);
        "]" -> (lexer_core@make_token(kinds.right_bracket, "]", start_location), updated_lexer);
        "," -> (lexer_core@make_token(kinds.comma, ",", start_location), updated_lexer);
        ";" -> (lexer_core@make_token(kinds.semicolon, ";", start_location), updated_lexer);
        "." -> (lexer_core@make_token(kinds.dot, ".", start_location), updated_lexer);
        "@" -> (lexer_core@make_token(kinds.at_sign, "@", start_location), updated_lexer);
        _: string -> (lexer_core@make_token(kinds.eof, "", start_location), lexer)  
    }
}
