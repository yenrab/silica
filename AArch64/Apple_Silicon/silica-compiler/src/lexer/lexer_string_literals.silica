// String and character literal parsing for Silica lexer
// Supports string literals with Unicode and escape sequences: \\, \', \", \n, \t, \r, \xNN
// Per language spec §2.2: string_literal ::= "\"" {character | escape_sequence} "\""
// Character literals use same escape sequences per character_literal grammar
// UTF-8: advance_utf8_char advances by full character length (1-4 bytes) for multi-byte sequences

// Import token kind
use lexer_token_kind;

// Import lexer core types
use lexer_core;

// Export entry points
export read_string_literal/1;
export read_char_literal/1;


{-
- Returns UTF-8 byte length (1-4) from lead byte. Used to advance past multi-byte characters.
- 1-byte: 0x00-0x7F; 2-byte: 0xC2-0xDF; 3-byte: 0xE0-0xEF; 4-byte: 0xF0-0xF7; else 1 (fallback).
- Last-date-modified: 2025-03-03
-}
fn utf8_lead_byte_length(lead: string) -> int64 {
    case lead of {
        "\xC2" -> 2; "\xC3" -> 2; "\xC4" -> 2; "\xC5" -> 2; "\xC6" -> 2; "\xC7" -> 2; "\xC8" -> 2; "\xC9" -> 2;
        "\xCA" -> 2; "\xCB" -> 2; "\xCC" -> 2; "\xCD" -> 2; "\xCE" -> 2; "\xCF" -> 2; "\xD0" -> 2; "\xD1" -> 2;
        "\xD2" -> 2; "\xD3" -> 2; "\xD4" -> 2; "\xD5" -> 2; "\xD6" -> 2; "\xD7" -> 2; "\xD8" -> 2; "\xD9" -> 2;
        "\xDA" -> 2; "\xDB" -> 2; "\xDC" -> 2; "\xDD" -> 2; "\xDE" -> 2; "\xDF" -> 2;
        "\xE0" -> 3; "\xE1" -> 3; "\xE2" -> 3; "\xE3" -> 3; "\xE4" -> 3; "\xE5" -> 3; "\xE6" -> 3; "\xE7" -> 3;
        "\xE8" -> 3; "\xE9" -> 3; "\xEA" -> 3; "\xEB" -> 3; "\xEC" -> 3; "\xED" -> 3; "\xEE" -> 3; "\xEF" -> 3;
        "\xF0" -> 4; "\xF1" -> 4; "\xF2" -> 4; "\xF3" -> 4; "\xF4" -> 4; "\xF5" -> 4; "\xF6" -> 4; "\xF7" -> 4;
        _: string -> 1
    }
}


{-
- Advances the lexer past one UTF-8 character (1-4 bytes). Uses utf8_lead_byte_length on peek_char.
- For n=1, use advance() to handle newline in column/line. For n>1, use advance_by (no newline in continuation bytes).
- Last-date-modified: 2025-03-03
-}
fn advance_utf8_char(lexer: Lexer) -> Lexer {
    lead: string <- lexer_core@peek_char(lexer);
    n: int64 <- utf8_lead_byte_length(lead);
    case n of {
        1 -> lexer_core@advance(lexer);
        _: int64 -> lexer_core@advance_by(lexer, n)
    }
}


{-
- Reads a string literal from the current lexer position. Expects opening "\"" already seen.
- Advances past the opening quote, then consumes characters and escape sequences until closing "\"".
- Escape sequences: \\ (backslash), \' (single quote), \" (double quote), \n (newline), \t (tab), \r (carriage return).
- String content may include Unicode characters (UTF-8). Lexeme is the raw source text including quotes.
- Example: lexer at "\"" of "\"hello\"" — returns (Token string_literal "\"hello\"", lexer past closing quote).
- Example: lexer at "\"" of "\"hi\\nthere\"" — consumes \n as escape, returns token with lexeme "\"hi\\nthere\"".
- Time: O(k), Ω(1), Θ(k) where k is string length. Space: O(k), Ω(1), Θ(k).
- Last-date-modified: 2025-02-27
-}
fn read_string_literal(lexer: Lexer) -> (Token, Lexer) {
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    start_pos: int64 <- lexer.position;
    kinds: TokenKinds <- lexer_token_kind@token_kinds();

    // Advance past opening quote
    after_open: Lexer <- lexer_core@advance(lexer);

    // Read string content (recursive)
    (final_lexer: Lexer, ok: bool) <- read_string_content(after_open, start_pos, kinds, start_location);

    case ok of {
        true -> do
            lexeme: string <- lexer_core@extract_lexeme(final_lexer, start_pos);
            token: Token <- lexer_core@make_token(kinds.string_literal, lexeme, start_location);
            (token, final_lexer)
        end;
        false -> do
            // On error, return error token (unknown_char) so tokenize can continue
            error_lexeme: string <- lexer_core@extract_lexeme(final_lexer, start_pos);
            error_token: Token <- lexer_core@make_token(kinds.unknown_char, error_lexeme, start_location);
            (error_token, final_lexer)
        end
    }
}


{-
- Recursively reads string content: normal chars, escape sequences, or closing quote.
- Returns (lexer, ok). ok is false on unterminated string or invalid escape.
-}
fn read_string_content(lexer: Lexer, start_pos: int64, kinds: TokenKinds, start_location: SourceLocation) -> (Lexer, bool) {
    current: string <- lexer_core@peek_char(lexer);

    case current of {
        "" -> (lexer, false);
        "\"" -> do
            // Closing quote - advance and success
            after_close: Lexer <- lexer_core@advance(lexer);
            (after_close, true)
        end;
        "\\" -> do
            // Escape sequence - advance past backslash, check next char
            after_backslash: Lexer <- lexer_core@advance(lexer);
            next: string <- lexer_core@peek_char(after_backslash);
            is_valid_escape: bool <- case next of {
                "n" -> true;
                "t" -> true;
                "r" -> true;
                "\\" -> true;
                "\"" -> true;
                "'" -> true;
                _: string -> false
            };
            case is_valid_escape of {
                true -> do
                    after_escape: Lexer <- lexer_core@advance(after_backslash);
                    read_string_content(after_escape, start_pos, kinds, start_location)
                end;
                false -> (after_backslash, false)
            }
        end;
        _: string -> do
            // Normal character (including Unicode) - advance by full UTF-8 sequence and continue
            advanced: Lexer <- advance_utf8_char(lexer);
            read_string_content(advanced, start_pos, kinds, start_location)
        end
    }
}


{-
- Reads a character literal from the current lexer position. Expects opening "'" already seen.
- Advances past the opening quote, reads one character (or escape sequence), then expects closing "'".
- Escape sequences: \\, \', \", \n, \t, \r. Lexeme is the raw source text including quotes.
- Example: lexer at "'" of "'a'" — returns (Token char_literal "'a'", lexer past closing quote).
- Example: lexer at "'" of "'\\n'" — consumes \n as escape, returns token with lexeme "'\\n'".
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1).
- Last-date-modified: 2025-02-27
-}
fn read_char_literal(lexer: Lexer) -> (Token, Lexer) {
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    start_pos: int64 <- lexer.position;
    kinds: TokenKinds <- lexer_token_kind@token_kinds();

    // Advance past opening quote
    after_open: Lexer <- lexer_core@advance(lexer);
    current: string <- lexer_core@peek_char(after_open);

    case current of {
        "" -> do
            error_token: Token <- lexer_core@make_token(kinds.unknown_char, "", start_location);
            (error_token, after_open)
        end;
        "'" -> do
            // Empty char or closing quote too soon - error
            error_lexeme: string <- lexer_core@extract_lexeme(after_open, start_pos);
            error_token: Token <- lexer_core@make_token(kinds.unknown_char, error_lexeme, start_location);
            (error_token, after_open)
        end;
        "\\" -> do
            // Escape sequence
            after_backslash: Lexer <- lexer_core@advance(after_open);
            next: string <- lexer_core@peek_char(after_backslash);
            is_valid_escape: bool <- case next of {
                "n" -> true;
                "t" -> true;
                "r" -> true;
                "\\" -> true;
                "\"" -> true;
                "'" -> true;
                _: string -> false
            };
            case is_valid_escape of {
                true -> do
                    after_escape: Lexer <- lexer_core@advance(after_backslash);
                    closing: string <- lexer_core@peek_char(after_escape);
                    case closing of {
                        "'" -> do
                            after_close: Lexer <- lexer_core@advance(after_escape);
                            lexeme: string <- lexer_core@extract_lexeme(after_close, start_pos);
                            token: Token <- lexer_core@make_token(kinds.char_literal, lexeme, start_location);
                            (token, after_close)
                        end;
                        _: string -> do
                            error_lexeme: string <- lexer_core@extract_lexeme(after_escape, start_pos);
                            error_token: Token <- lexer_core@make_token(kinds.unknown_char, error_lexeme, start_location);
                            (error_token, after_escape)
                        end
                    }
                end;
                false -> do
                    error_lexeme: string <- lexer_core@extract_lexeme(after_backslash, start_pos);
                    error_token: Token <- lexer_core@make_token(kinds.unknown_char, error_lexeme, start_location);
                    (error_token, after_backslash)
                end
            }
        end;
        _: string -> do
            // Normal character (including multi-byte UTF-8) - advance past full character, expect closing quote
            after_char: Lexer <- advance_utf8_char(after_open);
            closing: string <- lexer_core@peek_char(after_char);
            case closing of {
                "'" -> do
                    after_close: Lexer <- lexer_core@advance(after_char);
                    lexeme: string <- lexer_core@extract_lexeme(after_close, start_pos);
                    token: Token <- lexer_core@make_token(kinds.char_literal, lexeme, start_location);
                    (token, after_close)
                end;
                _: string -> do
                    error_lexeme: string <- lexer_core@extract_lexeme(after_char, start_pos);
                    error_token: Token <- lexer_core@make_token(kinds.unknown_char, error_lexeme, start_location);
                    (error_token, after_char)
                end
            }
        end
    }
}
