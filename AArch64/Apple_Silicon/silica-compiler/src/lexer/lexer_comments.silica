// Comment handling for Silica lexer
// Handles line comments (//) and block comments ({- -})

// Import lexer core types
use lexer_core;

// Export comment handling functions
export is_line_comment_start/1;
export skip_line_comment/1;

{-
- Returns true when the lexer is at the start of a line comment (two consecutive slashes).
- Used by the lexer to detect whether the current input position starts a line comment (//), so the lexer can decide whether to call skip_line_comment and consume characters until the end of the line. This is the predicate that gates line-comment handling.
- Example: when the input is "// rest" and the lexer is at the first character, peek_char and peek_next_char are both "/", so the result is true.
- Example: when the input is "/x" or "/ ", peek_char is "/" but peek_next_char is not "/", so the result is false.
- Example: when the input is "a/..." at the "a", peek_char is "a" and the first element of the pair is not "/", so the result is false.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Two peek operations and a case match; no recursion or unbounded allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_line_comment_start(lexer: Lexer) -> bool {
    pair: (string,string) <- (lexer_core@peek_char(lexer), lexer_core@peek_next_char(lexer));
    case pair of {
        ("/", "/") -> true;
        _: (string, string) -> false
    }
}

{-
- Advances the lexer from the current position to just after the end of the current line (or to EOF), consuming all characters in between, and returns the resulting lexer.
- Used after is_line_comment_start returns true to skip the rest of a line comment. Consumes characters until either the next character is newline (then advances past it) or the input is empty. Returns the updated lexer so tokenization can continue after the comment.
- Example: lexer at the second "/" of "// foo\nx" — after skip_line_comment, the lexer is positioned at "x"; the newline is consumed and advanced over.
- Example: lexer at start of "//" with no newline (e.g. EOF after "//") — recursion hits "" and returns the lexer with position at end of input.
- Example: lexer at "a" in "// a\n" — one step advances past "a", then "\n" is seen and advance(lexer) is returned, so the lexer ends just after the newline.
- Time: O(k), Ω(k), Θ(k) where k is the number of characters from current position to end of line. Space: O(k), Ω(1), Θ(k) due to recursion depth k (tail recursion may reduce to Θ(1) if optimized).
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn skip_line_comment(lexer: Lexer) -> Lexer {
    current: string <- lexer_core@peek_char(lexer);
    case current of {
        "" -> lexer;
        "\n" -> lexer_core@advance(lexer);
        _: string -> skip_line_comment(lexer_core@advance(lexer))
    }
}
