// Expression type-check dispatcher: Expr kind 0-4
// Delegates to literals, identifiers; handles binary ops and calls inline (recursive)

use parser_ast;
use type_checker_core;
use type_checker_expressions_literals;
use type_checker_expressions_identifiers;
use type_checker_expressions_atoms;
use type_checker_expressions_float32_calls;
use type_checker_expressions_string_calls;
use boolean_type_checker_expressions;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use type_checker_lists;
use type_checker_expressions_actors;

export check_expr/3;

fn is_primitive_numeric_type_name(t: string) -> bool {
    t == "int8" or t == "int16" or t == "int32" or t == "int64" or t == "uint8" or t == "uint16" or t == "uint32" or t == "uint64" or t == "float16" or t == "float32" or t == "float64"
}

// Expr kind 12: unary minus (-) on an expression; disallowed — use negate_<type>(...) instead.
fn check_unary_minus_forbidden(expr: Expr, context: TypeContext) -> TypeCheckResult {
    inner_t: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
    case len(inner_t) == 0 of {
        true -> type_checker_core@type_check_err("E2013", expr.location, "Unary minus (-) is not allowed; use negate_<type>(...) instead of the `-` symbol, where <type> matches the operand's numeric type (operand type could not be inferred)", "sect6");
        false -> case is_primitive_numeric_type_name(inner_t) of {
            true -> do
                suggest: string <- concat("negate_", inner_t);
                type_checker_core@type_check_err("E2013", expr.location, concat(concat("Unary minus (-) is not allowed; use ", suggest), "(...) instead of the `-` symbol"), "sect6")
            end;
            false -> type_checker_core@type_check_err("E2013", expr.location, concat(concat("Unary minus (-) is not allowed; use negate_<type>(...) instead of the `-` symbol (operand type is ", inner_t), ", not a primitive numeric)"), "sect6")
        }
    }
}

// Arithmetic: +, -, *, /, % (mod) - operands int64/int32/int16/int8/uint64/uint32/uint16/uint8, result matches operands
fn is_arithmetic_op_lexeme(op: string) -> bool {
    op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
}

// Comparison: <, >, <=, >=, ==, != - operands int64, int32, int16, int8, float32, float16, string, boolean; result bool
fn is_comparison_op_lexeme(op: string) -> bool {
    op == "<" or op == ">" or op == "<=" or op == ">=" or op == "==" or op == "!="
}

// Try checking both operands with operand_type; return result if both ok.
fn check_comparison_operands(expr: Expr, operand_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    left_result: TypeCheckResult <- check_expr(expr.inner, operand_type, context);
    case left_result.is_ok of {
        false -> left_result;
        true -> check_expr(expr.right_expr, operand_type, context)
    }
}

// Try each supported comparison operand type; first match wins.
// Signed: int64, int32, int16, int8. Unsigned: uint64, uint32, uint16, uint8. Also float32, float16, string, boolean.
fn bool_result(expected_type: string, location: SourceLocation) -> TypeCheckResult {
    case expected_type of {
        "boolean" -> type_checker_core@type_check_ok();
        "discard" -> type_checker_core@type_check_ok();
        _: string -> type_checker_core@type_check_err("E2003", location, concat("comparison op expects boolean result, got ", expected_type), "sect6")
    }
}

fn check_comparison_result(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    rb: TypeCheckResult <- check_comparison_operands(expr, "boolean", context);
    case rb.is_ok of {
        true -> bool_result(expected_type, expr.location);
        false -> check_comparison_result_rest(expr, expected_type, context, rb)
    }
}

fn check_comparison_result_rest(expr: Expr, expected_type: string, context: TypeContext, first_err: TypeCheckResult) -> TypeCheckResult proc[DeviceIO] {
    r64: TypeCheckResult <- check_comparison_operands(expr, "int64", context);
    case r64.is_ok of {
        true -> bool_result(expected_type, expr.location);
        false -> do
            r32: TypeCheckResult <- check_comparison_operands(expr, "int32", context);
            case r32.is_ok of {
                true -> bool_result(expected_type, expr.location);
                false -> do
                    r16: TypeCheckResult <- check_comparison_operands(expr, "int16", context);
                    case r16.is_ok of {
                        true -> bool_result(expected_type, expr.location);
                        false -> do
                            r8: TypeCheckResult <- check_comparison_operands(expr, "int8", context);
                            case r8.is_ok of {
                                true -> bool_result(expected_type, expr.location);
                                false -> do
                                    ru64: TypeCheckResult <- check_comparison_operands(expr, "uint64", context);
                                    case ru64.is_ok of {
                                        true -> bool_result(expected_type, expr.location);
                                        false -> do
                                            ru32: TypeCheckResult <- check_comparison_operands(expr, "uint32", context);
                                            case ru32.is_ok of {
                                                true -> bool_result(expected_type, expr.location);
                                                false -> do
                                                    ru16: TypeCheckResult <- check_comparison_operands(expr, "uint16", context);
                                                    case ru16.is_ok of {
                                                        true -> bool_result(expected_type, expr.location);
                                                        false -> do
                                                            ru8: TypeCheckResult <- check_comparison_operands(expr, "uint8", context);
                                                            case ru8.is_ok of {
                                                                true -> bool_result(expected_type, expr.location);
                                                                false -> do
                                                                    rf32: TypeCheckResult <- check_comparison_operands(expr, "float32", context);
                                                                    case rf32.is_ok of {
                                                                        true -> bool_result(expected_type, expr.location);
                                                                        false -> do
                                                                            rf16: TypeCheckResult <- check_comparison_operands(expr, "float16", context);
                                                                            case rf16.is_ok of {
                                                                                true -> bool_result(expected_type, expr.location);
                                                                                false -> do
                                                                                    rs: TypeCheckResult <- check_comparison_operands(expr, "string", context);
                                                                                    case rs.is_ok of {
                                                                                        true -> bool_result(expected_type, expr.location);
                                                                                        false -> first_err
                                                                                    }
                                                                                end
                                                                            }
                                                                        end
                                                                    }
                                                                end
                                                            }
                                                        end
                                                    }
                                                end
                                            }
                                        end
                                    }
                                end
                            }
                        end
                    }
                end
            }
        end
    }
}

// Logical: and, or - operands boolean, result boolean
fn is_logical_op_lexeme(op: string) -> bool {
    op == "and" or op == "or"
}

fn check_binary_op(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    op: string <- expr.value;
    case is_arithmetic_op_lexeme(op) of {
        true -> do
            operand_type: string <- case expected_type of {
                "int64" -> "int64";
                "int32" -> "int32";
                "int16" -> "int16";
                "int8" -> "int8";
                "uint64" -> "uint64";
                "uint32" -> "uint32";
                "uint16" -> "uint16";
                "uint8" -> "uint8";
                "float64" -> "float64";
                "float32" -> "float32";
                "float16" -> "float16";
                _: string -> "int64"
            };
            left_result: TypeCheckResult <- check_expr(expr.inner, operand_type, context);
            case left_result.is_ok of {
                false -> left_result;
                true -> do
                    right_result: TypeCheckResult <- check_expr(expr.right_expr, operand_type, context);
                    case right_result.is_ok of {
                        false -> right_result;
                        true -> case expected_type of {
                            "int64" -> type_checker_core@type_check_ok();
                            "int32" -> type_checker_core@type_check_ok();
                            "int16" -> type_checker_core@type_check_ok();
                            "int8" -> type_checker_core@type_check_ok();
                            "uint64" -> type_checker_core@type_check_ok();
                            "uint32" -> type_checker_core@type_check_ok();
                            "uint16" -> type_checker_core@type_check_ok();
                            "uint8" -> type_checker_core@type_check_ok();
                            "float64" -> type_checker_core@type_check_ok();
                            "float32" -> type_checker_core@type_check_ok();
                            "float16" -> type_checker_core@type_check_ok();
                            "discard" -> type_checker_core@type_check_ok();
                            _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("arithmetic op expects integer or float result (int64/.../float64/float32/float16), got ", expected_type), "sect6")
                        }
                    }
                end
            }
        end;
        false -> case is_comparison_op_lexeme(op) of {
            true -> check_comparison_result(expr, expected_type, context);
            false -> case is_logical_op_lexeme(op) of {
                true -> do
                    left_result: TypeCheckResult <- check_expr(expr.inner, "boolean", context);
                    case left_result.is_ok of {
                        false -> left_result;
                        true -> do
                            right_result: TypeCheckResult <- check_expr(expr.right_expr, "boolean", context);
                            case right_result.is_ok of {
                                false -> right_result;
                            true -> case expected_type of {
                                "boolean" -> type_checker_core@type_check_ok();
                                "discard" -> type_checker_core@type_check_ok();
                                _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("logical op expects boolean result, got ", expected_type), "sect6")
                            }
                            }
                        end
                    }
                end;
                false -> type_checker_core@type_check_err("E2004", expr.location, concat("unknown operator: ", op), "sect6")
            }
        }
    }
}

// Multi-arg calls use kind-4 continuations with name "" (see extract_call_rest). Second argument is inner of that node.
fn call_second_arg_expr(expr: Expr) -> Expr {
    case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
        true -> expr.right_expr.inner;
        false -> expr.right_expr
    }
}

// Third argument of a 3-arg call like write_buf(buf, idx, val).
// Parser encodes as call(inner=buf, right=pair("", inner=idx, right=pair("", inner=val, right=dummy))).
fn call_third_arg_expr(expr: Expr) -> Expr {
    case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
        true -> case expr.right_expr.right_expr.kind == 4 and expr.right_expr.right_expr.name == "" of {
            true -> expr.right_expr.right_expr.inner;
            false -> expr.right_expr.right_expr
        };
        false -> expr.right_expr
    }
}

// Memory region built-ins per spec §4.4, §9.2.2, §12, §22
fn check_region_builtin_call(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    case expr.name == "alloc_region" of {
        true -> do
            mem_result: TypeCheckResult <- type_checker_memory_regions@validate_memory_region_type(expected_type, expr.location);
            case mem_result.is_ok of {
                false -> mem_result;
                true -> case expr.inner.kind == 1 of {
                    true -> do
                        arg_space: string <- expr.inner.name;
                        expected_space: string <- type_checker_memory_regions@get_space_from_region_type(expected_type);
                        case type_checker_memory_regions@is_valid_memory_space(arg_space) of {
                            false -> type_checker_core@type_check_err("E2010", expr.location, concat(concat("alloc_region: invalid memory space '", arg_space), "'"), "sect4.4.1");
                            true -> case arg_space == expected_space of {
                                false -> type_checker_core@type_check_err("E2010", expr.location, concat(concat("alloc_region: space '", arg_space), concat("' does not match expected type ", expected_type)), "sect4.4.1");
                                true -> type_checker_core@type_check_ok()
                            }
                        }
                    end;
                    false -> type_checker_core@type_check_err("E2010", expr.location, "alloc_region: argument must be memory space identifier", "sect4.4.1")
                }
            }
        end;
        false -> case expr.name == "alloc_ref" of {
            true -> do
                region_type: string <- type_checker_memory_regions@ref_type_to_region_type(expected_type);
                elem_type: string <- type_checker_memory_regions@extract_element_type_from_ref(expected_type);
                case len(region_type) == 0 of {
                    true -> type_checker_core@type_check_err("E2010", expr.location, concat("alloc_ref result must be ref(R, Space, T), got ", expected_type), "sect4.4.2");
                    false -> do
                        r1: TypeCheckResult <- check_expr(expr.inner, region_type, context);
                        case r1.is_ok of { false -> r1; true -> check_expr(call_second_arg_expr(expr), elem_type, context) }
                    end
                }
            end;
            false -> case expr.name == "read_ref" of {
                true -> do
                    ref_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                    elem_type: string <- type_checker_memory_regions@extract_element_type_from_ref(ref_type);
                    case len(elem_type) == 0 of {
                        true -> type_checker_core@type_check_err("E2010", expr.location, "read_ref: argument must have ref(R, Space, T) type", "sect4.4.2");
                        false -> case elem_type == expected_type of {
                            false -> type_checker_core@type_check_err("E2010", expr.location, concat(concat("read_ref: element type ", elem_type), concat(" does not match expected ", expected_type)), "sect4.4.2");
                            true -> check_expr(expr.inner, ref_type, context)
                        }
                    }
                end;
                false -> case expr.name == "write_ref" of {
                    true -> do
                        ref_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                        elem_type: string <- type_checker_memory_regions@extract_element_type_from_ref(ref_type);
                        case len(elem_type) == 0 of {
                            true -> type_checker_core@type_check_err("E2010", expr.location, "write_ref: first argument must have ref(R, Space, T) type", "sect4.4.2");
                            false -> do
                                r1: TypeCheckResult <- check_expr(expr.inner, ref_type, context);
                                case r1.is_ok of {
                                    false -> r1;
                                    true -> do
                                        r2: TypeCheckResult <- check_expr(call_second_arg_expr(expr), elem_type, context);
                                        case r2.is_ok of {
                                            false -> r2;
                                            true -> case expected_type == "atom" or expected_type == "discard" of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> type_checker_core@type_check_err("E2003", expr.location, "write_ref returns atom", "sect4.4.2")
                                            }
                                        }
                                    end
                                }
                            end
                        }
                    end;
                    false -> case expr.name == "alloc_buf" of {
                        true -> do
                            region_type: string <- type_checker_memory_regions@buf_type_to_region_type(expected_type);
                            case len(region_type) == 0 of {
                                true -> type_checker_core@type_check_err("E2010", expr.location, concat("alloc_buf result must be buf(R, Space, T, N), got ", expected_type), "sect4.4.3");
                                false -> do
                                    r1: TypeCheckResult <- check_expr(expr.inner, region_type, context);
                                    case r1.is_ok of { false -> r1; true -> check_expr(call_second_arg_expr(expr), "int64", context) }
                                end
                            }
                        end;
                        false -> case expr.name == "read_buf" or expr.name == "buf_load" of {
                            true -> do
                                buf_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                                elem_type: string <- type_checker_memory_regions@extract_element_type_from_buf(buf_type);
                                case len(elem_type) == 0 of {
                                    true -> type_checker_core@type_check_err("E2010", expr.location, "read_buf/buf_load: first argument must have buf(R, Space, T, N) type", "sect4.4.3");
                                    false -> case elem_type == expected_type of {
                                        false -> type_checker_core@type_check_err("E2010", expr.location, concat(concat("read_buf/buf_load: element type ", elem_type), concat(" does not match expected ", expected_type)), "sect4.4.3");
                                        true -> do
                                            r1: TypeCheckResult <- check_expr(expr.inner, buf_type, context);
                                            case r1.is_ok of { false -> r1; true -> check_expr(call_second_arg_expr(expr), "int64", context) }
                                        end
                                    }
                                }
                            end;
                            false -> case expr.name == "write_buf" or expr.name == "buf_store" of {
                                true -> do
                                    buf_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                                    elem_type: string <- type_checker_memory_regions@extract_element_type_from_buf(buf_type);
                                    case len(elem_type) == 0 of {
                                        true -> type_checker_core@type_check_err("E2010", expr.location, "write_buf/buf_store: first argument must have buf(R, Space, T, N) type", "sect4.4.3");
                                        false -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                                            false -> type_checker_core@type_check_err("E2005", expr.location, "write_buf/buf_store requires 3 arguments: (buf, index, value)", "sect12.3.2");
                                            true -> do
                                                r1: TypeCheckResult <- check_expr(expr.inner, buf_type, context);
                                                case r1.is_ok of {
                                                    false -> r1;
                                                    true -> do
                                                        r2: TypeCheckResult <- check_expr(expr.right_expr.inner, "int64", context);
                                                        case r2.is_ok of {
                                                            false -> r2;
                                                            true -> do
                                                                r3: TypeCheckResult <- check_expr(call_third_arg_expr(expr), elem_type, context);
                                                                case r3.is_ok of {
                                                                    false -> r3;
                                                                    true -> case expected_type == "atom" or expected_type == "discard" of {
                                                                        true -> type_checker_core@type_check_ok();
                                                                        false -> type_checker_core@type_check_err("E2003", expr.location, "write_buf/buf_store returns atom", "sect12.3.2")
                                                                    }
                                                                }
                                                            end
                                                        }
                                                    end
                                                }
                                            end
                                        }
                                    }
                                end;
                                false -> case expr.name == "fresh_lifetime" of {
                                        true -> case expected_type == "lifetime" of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> type_checker_core@type_check_err("E2003", expr.location, concat("fresh_lifetime returns lifetime, got ", expected_type), "sect22.1")
                                        };
                                        false -> type_checker_core@type_check_err("E2005", expr.location, concat("unknown region built-in: ", expr.name), "sect22")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
}

// Built-in: print_int64/32/16/8, print_uint64/32/16/8 - arg matches type, returns atom
// Built-in: print_atom(atom:x) - arg atom, returns atom (:ok on success, :fail on failure)
fn check_print_call(expr: Expr, arg_type: string, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    arg_result: TypeCheckResult <- check_expr(expr.inner, arg_type, context);
    case arg_result.is_ok of {
        false -> arg_result;
        true -> case expected_type of {
            "atom" -> type_checker_core@type_check_ok();
            "discard" -> type_checker_core@type_check_ok();
            _: string -> type_checker_core@type_check_err("E2003", expr.location, concat(concat("print_", concat(arg_type, " expects atom result, got ")), expected_type), "sect6")
        }
    }
}

// Built-in: negate_<primitive>/1 — signed int and float only. negate_uint* are not builtins (unknown function, E2005). negate_unit is rejected below.
fn negate_builtin_arg_type(name: string) -> string {
    case name of {
        "negate_int8" -> "int8";
        "negate_int16" -> "int16";
        "negate_int32" -> "int32";
        "negate_int64" -> "int64";
        "negate_float16" -> "float16";
        "negate_float32" -> "float32";
        "negate_float64" -> "float64";
        _: string -> ""
    }
}

fn check_negate_call(expr: Expr, num_type: string, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    arg_result: TypeCheckResult <- check_expr(expr.inner, num_type, context);
    case arg_result.is_ok of {
        false -> arg_result;
        true -> case expected_type of {
            "discard" -> type_checker_core@type_check_ok();
            _: string -> case expected_type == num_type of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat(expr.name, " returns "), num_type), ", expected "), expected_type), "sect6")
            }
        }
    }
}

// §4.5 actor_ref, §15 spawn, §16 call/cast/send, self; recv forbidden §15.1.2;
// CPU affinity / topology helpers (spec appendix): pin_actor_*, unpin_actor, remove_actor, set_actor_priority, get_cpu_topology, get_*_cores, get_core_capabilities.
fn actor_runtime_builtin_return_type(name: string) -> string {
    case name of {
        "pin_actor_to_core" -> "(int64,affinity_error)";
        "pin_actor_to_efficiency_core" -> "(int64,affinity_error)";
        "pin_actor_to_performance_core" -> "(int64,affinity_error)";
        "pin_actor_realtime" -> "(int64,affinity_error)";
        "remove_actor" -> "(int64,affinity_error)";
        "pin_actor_to_numa_node" -> "(int64,affinity_error)";
        "unpin_actor" -> "atom";
        "set_actor_priority" -> "atom";
        "get_cpu_topology" -> "cpu_topology";
        "get_efficiency_cores" -> "List[int64,normal]";
        "get_performance_cores" -> "List[int64,normal]";
        "get_core_capabilities" -> "core_info";
        _: string -> ""
    }
}

fn is_actor_runtime_helper_name(name: string) -> bool {
    len(actor_runtime_builtin_return_type(name)) > 0
}

// §4.5 actor_ref, §15 spawn, §16 call/cast/send, self; recv forbidden §15.1.2.
fn is_actor_concurrency_builtin(name: string) -> bool {
    name == "spawn" or name == "send" or name == "cast" or name == "call" or name == "self" or name == "recv" or is_actor_runtime_helper_name(name)
}

fn check_runtime_builtin_return(expr: Expr, inferred: string, expected_type: string) -> TypeCheckResult {
    case expected_type == "discard" of {
        true -> type_checker_core@type_check_ok();
        false -> case type_checker_lists@types_equal_strip(inferred, expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat(expr.name, " returns "), inferred), ", expected "), expected_type), "sect15")
        }
    }
}

fn check_actor_runtime_helper_call(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    inferred: string <- actor_runtime_builtin_return_type(expr.name);
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case expr.name == "get_cpu_topology" of {
        true -> case ac == 0 of {
            false -> type_checker_core@type_check_err("E2005", expr.location, "get_cpu_topology expects 0 arguments", "sect15");
            true -> check_runtime_builtin_return(expr, inferred, expected_type)
        };
        false -> case expr.name == "get_efficiency_cores" of {
            true -> case ac == 0 of {
                false -> type_checker_core@type_check_err("E2005", expr.location, "get_efficiency_cores expects 0 arguments", "sect15");
                true -> check_runtime_builtin_return(expr, inferred, expected_type)
            };
            false -> case expr.name == "get_performance_cores" of {
                true -> case ac == 0 of {
                    false -> type_checker_core@type_check_err("E2005", expr.location, "get_performance_cores expects 0 arguments", "sect15");
                    true -> check_runtime_builtin_return(expr, inferred, expected_type)
                };
                false -> case expr.name == "get_core_capabilities" of {
                    true -> case ac == 1 of {
                        false -> type_checker_core@type_check_err("E2005", expr.location, "get_core_capabilities expects 1 argument: (core_id: int64)", "sect15");
                        true -> do
                            r0: TypeCheckResult <- check_expr(expr.inner, "int64", context);
                            case r0.is_ok of {
                                false -> r0;
                                true -> check_runtime_builtin_return(expr, inferred, expected_type)
                            }
                        end
                    };
                    false -> case expr.name == "pin_actor_to_core" of {
                        true -> case ac == 2 of {
                            false -> type_checker_core@type_check_err("E2005", expr.location, "pin_actor_to_core expects 2 arguments: (actor_ref, core_id)", "sect15");
                            true -> do
                                r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
                                case r0.is_ok of {
                                    false -> r0;
                                    true -> do
                                        r1: TypeCheckResult <- check_expr(call_second_arg_expr(expr), "int64", context);
                                        case r1.is_ok of {
                                            false -> r1;
                                            true -> check_runtime_builtin_return(expr, inferred, expected_type)
                                        }
                                    end
                                }
                            end
                        };
                        false -> case expr.name == "pin_actor_realtime" of {
                            true -> case ac == 2 of {
                                false -> type_checker_core@type_check_err("E2005", expr.location, "pin_actor_realtime expects 2 arguments: (actor_ref, priority)", "sect15");
                                true -> do
                                    r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
                                    case r0.is_ok of {
                                        false -> r0;
                                        true -> do
                                            r1: TypeCheckResult <- check_expr(call_second_arg_expr(expr), "int64", context);
                                            case r1.is_ok of {
                                                false -> r1;
                                                true -> check_runtime_builtin_return(expr, inferred, expected_type)
                                            }
                                        end
                                    }
                                end
                            };
                            false -> case expr.name == "set_actor_priority" of {
                                true -> case ac == 2 of {
                                    false -> type_checker_core@type_check_err("E2005", expr.location, "set_actor_priority expects 2 arguments: (actor_ref, priority_level)", "sect15");
                                    true -> do
                                        r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
                                        case r0.is_ok of {
                                            false -> r0;
                                            true -> do
                                                r1: TypeCheckResult <- check_expr(call_second_arg_expr(expr), "discard", context);
                                                case r1.is_ok of {
                                                    false -> r1;
                                                    true -> check_runtime_builtin_return(expr, inferred, expected_type)
                                                }
                                            end
                                        }
                                    end
                                };
                                false -> case expr.name == "pin_actor_to_numa_node" of {
                                    true -> case ac == 2 of {
                                        false -> type_checker_core@type_check_err("E2005", expr.location, "pin_actor_to_numa_node expects 2 arguments: (actor_ref, numa_node)", "sect15");
                                        true -> do
                                            r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
                                            case r0.is_ok of {
                                                false -> r0;
                                                true -> do
                                                    r1: TypeCheckResult <- check_expr(call_second_arg_expr(expr), "discard", context);
                                                    case r1.is_ok of {
                                                        false -> r1;
                                                        true -> check_runtime_builtin_return(expr, inferred, expected_type)
                                                    }
                                                end
                                            }
                                        end
                                    };
                                    false -> case expr.name == "pin_actor_to_efficiency_core" of {
                                        true -> case ac == 1 of {
                                            false -> type_checker_core@type_check_err("E2005", expr.location, "pin_actor_to_efficiency_core expects 1 argument: (actor_ref)", "sect15");
                                            true -> do
                                                r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
                                                case r0.is_ok of {
                                                    false -> r0;
                                                    true -> check_runtime_builtin_return(expr, inferred, expected_type)
                                                }
                                            end
                                        };
                                        false -> case expr.name == "pin_actor_to_performance_core" of {
                                            true -> case ac == 1 of {
                                                false -> type_checker_core@type_check_err("E2005", expr.location, "pin_actor_to_performance_core expects 1 argument: (actor_ref)", "sect15");
                                                true -> do
                                                    r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
                                                    case r0.is_ok of {
                                                        false -> r0;
                                                        true -> check_runtime_builtin_return(expr, inferred, expected_type)
                                                    }
                                                end
                                            };
                                            false -> case expr.name == "unpin_actor" of {
                                                true -> case ac == 1 of {
                                                    false -> type_checker_core@type_check_err("E2005", expr.location, "unpin_actor expects 1 argument: (actor_ref)", "sect15");
                                                    true -> do
                                                        r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
                                                        case r0.is_ok of {
                                                            false -> r0;
                                                            true -> check_runtime_builtin_return(expr, inferred, expected_type)
                                                        }
                                                    end
                                                };
                                                false -> case expr.name == "remove_actor" of {
                                                    true -> case ac == 1 of {
                                                        false -> type_checker_core@type_check_err("E2005", expr.location, "remove_actor expects 1 argument: (actor_ref)", "sect15");
                                                        true -> do
                                                            r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
                                                            case r0.is_ok of {
                                                                false -> r0;
                                                                true -> check_runtime_builtin_return(expr, inferred, expected_type)
                                                            }
                                                        end
                                                    };
                                                    false -> type_checker_core@type_check_err("E2005", expr.location, "unknown actor runtime helper", "sect15")
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn check_actor_self_call(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 0 of {
        false -> type_checker_core@type_check_err("E2005", expr.location, "self expects 0 arguments (§15.1.3)", "sect15");
        true -> case expected_type == "actor_ref" of {
            true -> type_checker_core@type_check_ok();
            false -> case expected_type == "discard" of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr.location, concat("self returns actor_ref, expected ", expected_type), "sect15")
            }
        }
    }
}

fn check_actor_spawn_call(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 or ac == 3 of {
        false -> type_checker_core@type_check_err("E2005", expr.location, "spawn expects 2 or 3 arguments: (initial_state, behavior_fn [, core_affinity]) §15.1.1", "sect15");
        true -> do
            init_e: Expr <- type_checker_expressions_actors@spawn_init_expr(expr);
            beh_e: Expr <- type_checker_expressions_actors@spawn_behavior_expr(expr);
            case beh_e.kind == 1 of {
                false -> type_checker_core@type_check_err("E2005", expr.location, "spawn: behavior must be a function identifier", "sect15");
                true -> do
                    (beh_found: bool, beh_type: string) <- type_checker_core@lookup_symbol_found(context.env, beh_e.name);
                    case beh_found of {
                        false -> type_checker_core@type_check_err("E2005", expr.location, concat("spawn: unknown behavior function: ", beh_e.name), "sect15");
                        true -> case is_function_type_user_call(beh_type) of {
                            false -> type_checker_core@type_check_err("E2005", expr.location, "spawn: behavior must be a function", "sect15");
                            true -> do
                                sig_ok: TypeCheckResult <- type_checker_expressions_actors@validate_spawn_behavior_function_type(beh_type, expr.location);
                                case sig_ok.is_ok of {
                                    false -> sig_ok;
                                    true -> do
                                        state_t: string <- type_checker_expressions_actors@parse_behavior_state_param_type(beh_type);
                                        case len(state_t) == 0 of {
                                            true -> type_checker_core@type_check_err("E2005", expr.location, "spawn: could not parse behavior state parameter type", "sect15");
                                            false -> do
                                                r_init: TypeCheckResult <- check_expr(init_e, state_t, context);
                                                case r_init.is_ok of {
                                                    false -> r_init;
                                                    true -> case ac == 3 of {
                                                        true -> do
                                                            place_e: Expr <- type_checker_expressions_actors@spawn_placement_expr(expr);
                                                            r_pl: TypeCheckResult <- check_expr(place_e, "discard", context);
                                                            case r_pl.is_ok of {
                                                                false -> r_pl;
                                                                true -> check_actor_spawn_result_type(expr, expected_type)
                                                            }
                                                        end;
                                                        false -> check_actor_spawn_result_type(expr, expected_type)
                                                    }
                                                }
                                            end
                                        }
                                    end
                                }
                            end
                        }
                    }
                end
            }
        end
    }
}

fn check_actor_spawn_result_type(expr: Expr, expected_type: string) -> TypeCheckResult {
    case expected_type == "actor_ref" of {
        true -> type_checker_core@type_check_ok();
        false -> case expected_type == "discard" of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", expr.location, concat("spawn returns actor_ref, expected ", expected_type), "sect15")
        }
    }
}

fn check_actor_call_builtin(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 of {
        false -> type_checker_core@type_check_err("E2005", expr.location, "call expects 2 arguments: (actor_ref, message) §16.1.1", "sect16");
        true -> do
            r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
            case r0.is_ok of {
                false -> r0;
                true -> do
                    msg_e: Expr <- call_second_arg_expr(expr);
                    r1: TypeCheckResult <- check_expr(msg_e, "discard", context);
                    case r1.is_ok of {
                        false -> r1;
                        true -> type_checker_core@type_check_ok()
                    }
                end
            }
        end
    }
}

fn check_actor_cast_builtin(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 of {
        false -> type_checker_core@type_check_err("E2005", expr.location, "cast expects 2 arguments: (actor_ref, message) §16.1.2", "sect16");
        true -> do
            r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
            case r0.is_ok of {
                false -> r0;
                true -> do
                    msg_e: Expr <- call_second_arg_expr(expr);
                    r1: TypeCheckResult <- check_expr(msg_e, "discard", context);
                    case r1.is_ok of {
                        false -> r1;
                        true -> case expected_type == "boolean" of {
                            true -> type_checker_core@type_check_ok();
                            false -> case expected_type == "discard" of {
                                true -> type_checker_core@type_check_ok();
                                false -> type_checker_core@type_check_err("E2003", expr.location, concat("cast returns boolean, expected ", expected_type), "sect16")
                            }
                        }
                    }
                end
            }
        end
    }
}

fn check_actor_send_builtin(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 of {
        false -> type_checker_core@type_check_err("E2005", expr.location, "send expects 2 arguments: (actor_ref, message) §16.1", "sect16");
        true -> do
            r0: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context);
            case r0.is_ok of {
                false -> r0;
                true -> do
                    msg_e: Expr <- call_second_arg_expr(expr);
                    r1: TypeCheckResult <- check_expr(msg_e, "discard", context);
                    case r1.is_ok of {
                        false -> r1;
                        true -> case expected_type == "atom" of {
                            true -> type_checker_core@type_check_ok();
                            false -> case expected_type == "discard" of {
                                true -> type_checker_core@type_check_ok();
                                false -> type_checker_core@type_check_err("E2003", expr.location, concat("send returns atom, expected ", expected_type), "sect16")
                            }
                        }
                    }
                end
            }
        end
    }
}

fn check_actor_concurrency_call(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    case is_actor_runtime_helper_name(expr.name) of {
        true -> check_actor_runtime_helper_call(expr, expected_type, context);
        false -> case expr.name == "recv" of {
            true -> type_checker_core@type_check_err("E2005", expr.location, "recv() is runtime-internal only; user code cannot call recv (§15.1.2)", "sect15");
            false -> case expr.name == "self" of {
                true -> check_actor_self_call(expr, expected_type, context);
                false -> case expr.name == "spawn" of {
                    true -> check_actor_spawn_call(expr, expected_type, context);
                    false -> case expr.name == "call" of {
                        true -> check_actor_call_builtin(expr, expected_type, context);
                        false -> case expr.name == "cast" of {
                            true -> check_actor_cast_builtin(expr, expected_type, context);
                            false -> check_actor_send_builtin(expr, expected_type, context)
                        }
                    }
                }
            }
        }
    }
}

fn check_call(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    case type_checker_memory_regions@is_region_builtin_call(expr.name) of {
        true -> check_region_builtin_call(expr, expected_type, context);
        false -> case is_actor_concurrency_builtin(expr.name) of {
            true -> check_actor_concurrency_call(expr, expected_type, context);
            false -> case expr.name == "negate_unit" of {
            true -> type_checker_core@type_check_err("E2003", expr.location, "negation is not supported for unit", "sect6");
            false -> case len(negate_builtin_arg_type(expr.name)) > 0 of {
                    true -> check_negate_call(expr, negate_builtin_arg_type(expr.name), expected_type, context);
                    false -> case expr.name == "print_int64" of {
        true -> check_print_call(expr, "int64", expected_type, context);
        false -> case expr.name == "print_int32" of {
            true -> check_print_call(expr, "int32", expected_type, context);
            false -> case expr.name == "print_int16" of {
                true -> check_print_call(expr, "int16", expected_type, context);
                false -> case expr.name == "print_int8" of {
                    true -> check_print_call(expr, "int8", expected_type, context);
                    false -> case expr.name == "print_uint64" of {
                        true -> check_print_call(expr, "uint64", expected_type, context);
                        false -> case expr.name == "print_uint32" of {
                            true -> check_print_call(expr, "uint32", expected_type, context);
                            false -> case expr.name == "print_uint16" of {
                                true -> check_print_call(expr, "uint16", expected_type, context);
                                false -> case expr.name == "print_uint8" of {
                                    true -> check_print_call(expr, "uint8", expected_type, context);
                                    false -> case expr.name == "print_bool" of {
                                        true -> do
                                            arg_result: TypeCheckResult <- check_expr(expr.inner, "boolean", context);
                                            case arg_result.is_ok of {
                                                false -> arg_result;
                                                true -> case expected_type of {
                                                    "boolean" -> type_checker_core@type_check_ok();
                                                    "atom" -> type_checker_core@type_check_ok();
                                                    "discard" -> type_checker_core@type_check_ok();
                                                    _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("print_bool expects boolean or atom result, got ", expected_type), "sect6")
                                                }
                                            }
                                        end;
                                        false -> case expr.name == "print_atom" of {
                                            true -> do
                                                arg_result: TypeCheckResult <- check_expr(expr.inner, "atom", context);
                                                case arg_result.is_ok of {
                                                    false -> arg_result;
                                                    true -> case expected_type of {
                                                        "atom" -> type_checker_core@type_check_ok();
                                                        "discard" -> type_checker_core@type_check_ok();
                                                        _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("print_atom expects atom result, got ", expected_type), "sect6")
                                                    }
                                                }
                                            end;
                                            false -> case expr.name == "print_float64" of {
                                                true -> check_print_call(expr, "float64", expected_type, context);
                                                false -> case expr.name == "print_float32" of {
                                                    true -> do
                                                        arg_result: TypeCheckResult <- check_expr(expr.inner, "float32", context);
                                                        type_checker_expressions_float32_calls@check_print_float32_call(expr, expected_type, arg_result)
                                                    end;
                                                    false -> case expr.name == "print_string" of {
                                                        true -> check_print_call(expr, "string", expected_type, context);
                                                        false -> case expr.name == "println" of {
                                                            true -> check_print_call(expr, "string", expected_type, context);
                                                            false -> case expr.name == "concat" of {
                                                                true -> do
                                                                    a1: TypeCheckResult <- check_expr(expr.inner, "string", context);
                                                                    a2: TypeCheckResult <- check_expr(expr.right_expr.inner, "string", context);
                                                                    type_checker_expressions_string_calls@check_concatenate_call(expr, expected_type, a1, a2)
                                                                end;
                                                                    false -> case expr.name == "concatenate" of {
                                                                    true -> do
                                                                        a1: TypeCheckResult <- check_expr(expr.inner, "string", context);
                                                                        a2: TypeCheckResult <- check_expr(expr.right_expr.inner, "string", context);
                                                                        type_checker_expressions_string_calls@check_concatenate_call(expr, expected_type, a1, a2)
                                                                    end;
                                                                    false -> case expr.name == "substring" of {
                                                                        true -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                                                                            true -> do
                                                                                s1: TypeCheckResult <- check_expr(expr.inner, "string", context);
                                                                                s2: TypeCheckResult <- check_expr(expr.right_expr.inner, "int64", context);
                                                                                s3: TypeCheckResult <- check_expr(expr.right_expr.right_expr.inner, "int64", context);
                                                                                type_checker_expressions_string_calls@check_substring_call(expr, expected_type, s1, s2, s3)
                                                                            end;
                                                                            false -> type_checker_core@type_check_err("E2005", expr.location, "substring requires 3 arguments: (s: string, start: int64, end: int64)", "sect6")
                                                                        };
                                                                        false -> case expr.name == "substring_until_char" of {
                                                                            true -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                                                                                true -> do
                                                                                    u1: TypeCheckResult <- check_expr(expr.inner, "string", context);
                                                                                    u2: TypeCheckResult <- check_expr(expr.right_expr.inner, "int64", context);
                                                                                    u3: TypeCheckResult <- check_expr(expr.right_expr.right_expr.inner, "char", context);
                                                                                    type_checker_expressions_string_calls@check_substring_until_char_call(expr, expected_type, u1, u2, u3)
                                                                                end;
                                                                                false -> type_checker_core@type_check_err("E2005", expr.location, "substring_until_char requires 3 arguments: (s: string, start: int64, char: char)", "sect6")
                                                                            };
                                                                            false -> case expr.name == "length_bytes" of {
                                                                                true -> do
                                                                                    lb: TypeCheckResult <- check_expr(expr.inner, "string", context);
                                                                                    type_checker_expressions_string_calls@check_length_bytes_call(expr, expected_type, lb)
                                                                                end;
                                                                                        false -> case expr.name == "length_chars" of {
                                                                                        true -> do
                                                                                            lc: TypeCheckResult <- check_expr(expr.inner, "string", context);
                                                                                            type_checker_expressions_string_calls@check_length_chars_call(expr, expected_type, lc)
                                                                                        end;
                                                                                        false -> case type_checker_lists@is_list_primitive_name(expr.name) of {
                                                                                            true -> check_list_primitive_call(expr, expected_type, context);
                                                                                            false -> check_user_defined_call(expr, expected_type, context)
                                                                                        }
                                                                                    }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
            }
        }
        }
    }
    }
}

// User-defined function call: lookup in symbol table, parse function type "(T1,T2) -> R", check args and result
fn find_arrow_pos_user_call(s: string, i: int64) -> int64 {
    case i + 4 > len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 4) == " -> " of {
            true -> i;
            false -> find_arrow_pos_user_call(s, i + 1)
        }
    }
}

fn is_function_type_user_call(type_str: string) -> bool {
    find_arrow_pos_user_call(type_str, 0) >= 0
}

// Find first comma at depth 0 (top level). Respects parentheses and brackets in type strings
// so that a single tuple parameter like (int64, int64) or ref(R, Space, T) counts as 1 param.
fn find_top_level_comma_user_call(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) == "(" or substring(s, i, i + 1) == "[" of {
            true -> find_top_level_comma_user_call(s, i + 1, depth + 1);
            false -> case substring(s, i, i + 1) == ")" or substring(s, i, i + 1) == "]" of {
                true -> case depth <= 0 of {
                    true -> len(s);
                    false -> find_top_level_comma_user_call(s, i + 1, depth - 1)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> i;
                        false -> find_top_level_comma_user_call(s, i + 1, depth)
                    };
                    false -> find_top_level_comma_user_call(s, i + 1, depth)
                }
            }
        }
    }
}

fn trim_leading_user_call(s: string) -> string {
    trim_leading_user_call_from(s, 0)
}

fn trim_leading_user_call_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_leading_user_call_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

fn parse_function_param_count(func_type: string) -> int64 {
    arrow_pos: int64 <- find_arrow_pos_user_call(func_type, 0);
    case arrow_pos < 0 of {
        true -> 0;
        false -> do
            params_part: string <- substring(func_type, 0, arrow_pos);
            case len(params_part) < 2 or substring(params_part, 0, 1) != "(" or substring(params_part, len(params_part) - 1, len(params_part)) != ")" of {
                true -> 0;
                false -> do
                    inner: string <- trim_leading_user_call(substring(params_part, 1, len(params_part) - 1));
                    case len(inner) == 0 of {
                        true -> 0;
                        false -> parse_param_count_inner(inner)
                    }
                end
            }
        end
    }
}

fn parse_param_count_inner(inner: string) -> int64 {
    comma1: int64 <- find_top_level_comma_user_call(inner, 0, 0);
    case comma1 >= len(inner) of {
        true -> 1;
        false -> do
            rest: string <- trim_leading_user_call(substring(inner, comma1 + 1, len(inner)));
            case len(rest) == 0 of {
                true -> 2;
                false -> 1 + parse_param_count_inner(rest)
            }
        end
    }
}

fn parse_function_return_type(func_type: string) -> string {
    arrow_pos: int64 <- find_arrow_pos_user_call(func_type, 0);
    case arrow_pos < 0 of {
        true -> "";
        false -> trim_leading_user_call(substring(func_type, arrow_pos + 4, len(func_type)))
    }
}

fn get_params_inner_from_func_type(func_type: string) -> string {
    arrow_pos: int64 <- find_arrow_pos_user_call(func_type, 0);
    case arrow_pos < 0 of {
        true -> "";
        false -> do
            params_part: string <- substring(func_type, 0, arrow_pos);
            case len(params_part) < 2 of {
                true -> "";
                false -> trim_leading_user_call(substring(params_part, 1, len(params_part) - 1))
            }
        end
    }
}

fn get_first_param_type(params_inner: string) -> (string, string) {
    case len(params_inner) == 0 of {
        true -> ("", "");
        false -> do
            comma_pos: int64 <- find_top_level_comma_user_call(params_inner, 0, 0);
            case comma_pos >= len(params_inner) of {
                true -> (trim_leading_user_call(params_inner), "");
                false -> do
                    first: string <- trim_leading_user_call(substring(params_inner, 0, comma_pos));
                    rest: string <- trim_leading_user_call(substring(params_inner, comma_pos + 1, len(params_inner)));
                    (first, rest)
                end
            }
        end
    }
}

fn count_call_args_user_call(expr: Expr) -> int64 {
    case expr.inner.kind == -1 of {
        true -> 0;
        false -> case expr.right_expr.kind == -1 of {
            true -> 1;
            false -> case expr.right_expr.kind == 4 of {
                true -> 1 + count_call_args_user_call(expr.right_expr);
                false -> 2
            }
        }
    }
}

fn check_user_call_result_user_call(expr: Expr, expected_type: string, return_type: string) -> TypeCheckResult {
    case expected_type of {
        "discard" -> type_checker_core@type_check_ok();
        _: string -> case expected_type == return_type of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat(expr.name, " returns "), return_type), ", expected "), expected_type), "sect6")
        }
    }
}

fn check_user_call_args_recursive(expr: Expr, params_inner: string, expected_type: string, return_type: string, context: TypeContext, call_expr: Expr) -> TypeCheckResult proc[DeviceIO] {
    case expr.inner.kind == -1 of {
        true -> case len(params_inner) == 0 of {
            true -> check_user_call_result_user_call(call_expr, expected_type, return_type);
            false -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6")
        };
        false -> do
            (first_param: string, rest_params: string) <- get_first_param_type(params_inner);
            case len(first_param) == 0 of {
                true -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6");
                false -> do
                    r1: TypeCheckResult <- check_expr(expr.inner, first_param, context);
                    case r1.is_ok of {
                        false -> r1;
                        true -> case expr.right_expr.kind == -1 of {
                            true -> case len(rest_params) == 0 of {
                                true -> check_user_call_result_user_call(call_expr, expected_type, return_type);
                                false -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6")
                            };
                            false -> case expr.right_expr.kind == 4 of {
                                true -> case len(rest_params) == 0 of {
                                    true -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6");
                                    false -> check_user_call_args_recursive(expr.right_expr, rest_params, expected_type, return_type, context, call_expr)
                                };
                                false -> do
                                    (second_param: string, rest_rest: string) <- get_first_param_type(rest_params);
                                    case len(second_param) == 0 or len(rest_rest) > 0 of {
                                        true -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6");
                                        false -> do
                                            r2: TypeCheckResult <- check_expr(expr.right_expr, second_param, context);
                                            case r2.is_ok of {
                                                false -> r2;
                                                true -> check_user_call_result_user_call(call_expr, expected_type, return_type)
                                            }
                                        end
                                    }
                                end
                            }
                        };
                    }
                end
            }
        end
    }
}


fn check_user_defined_call(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    (found: bool, resolved_type: string) <- type_checker_core@lookup_symbol_found(context.env, expr.name);
    case found of {
        false -> type_checker_core@type_check_err("E2005", expr.location, concat("unknown or unsupported function: ", expr.name), "sect6");
        true -> case is_function_type_user_call(resolved_type) of {
            false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " is not a function"), "sect6");
            true -> check_user_defined_call_parsed(expr, expected_type, context, resolved_type)
        }
    }
}

fn check_user_defined_call_parsed(expr: Expr, expected_type: string, context: TypeContext, func_type: string) -> TypeCheckResult proc[DeviceIO] {
    expected_arg_count: int64 <- parse_function_param_count(func_type);
    params_inner: string <- get_params_inner_from_func_type(func_type);
    return_type: string <- parse_function_return_type(func_type);
    arg_count: int64 <- count_call_args_user_call(expr);
    case arg_count != expected_arg_count of {
        true -> case expected_arg_count == 1 of {
            true -> case arg_count == 2 of {
                true -> case len(params_inner) >= 2 of {
                    true -> case substring(params_inner, 0, 1) == "(" of {
                        true -> case substring(params_inner, len(params_inner) - 1, len(params_inner)) == ")" of {
                            true -> check_user_call_two_args_as_tuple(expr, params_inner, expected_type, return_type, context);
                            false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                        };
                        false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                    };
                    false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                };
                false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
            };
            false -> case expected_arg_count == 2 of {
                true -> case arg_count == 1 of {
                    true -> case expr.inner.kind == 9 of {
                        true -> check_user_call_one_tuple_as_two_args(expr, params_inner, expected_type, return_type, context);
                        false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                    };
                    false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                };
                false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
            }
        };
        false -> check_user_call_args_recursive(expr, params_inner, expected_type, return_type, context, expr)
    }
}

fn check_user_call_one_tuple_as_two_args(expr: Expr, params_inner: string, expected_type: string, return_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    (first_param: string, rest_params: string) <- get_first_param_type(params_inner);
    (second_param: string, _: string) <- get_first_param_type(rest_params);
    case len(first_param) == 0 or len(second_param) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6");
        false -> do
            tuple_type: string <- concat(concat(concat(concat("(", first_param), ","), second_param), ")");
            r1: TypeCheckResult <- check_expr(expr.inner, tuple_type, context);
            case r1.is_ok of {
                false -> r1;
                true -> check_user_call_result_user_call(expr, expected_type, return_type)
            }
        end
    }
}

fn check_user_call_two_args_as_tuple(expr: Expr, tuple_param: string, expected_type: string, return_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    inner: string <- trim_leading_user_call(substring(tuple_param, 1, len(tuple_param) - 1));
    comma_pos: int64 <- find_top_level_comma_user_call(inner, 0, 0);
    case comma_pos >= len(inner) of {
        true -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6");
        false -> do
            first_type: string <- trim_leading_user_call(substring(inner, 0, comma_pos));
            second_type: string <- trim_leading_user_call(substring(inner, comma_pos + 1, len(inner)));
            r1: TypeCheckResult <- check_expr(expr.inner, first_type, context);
            case r1.is_ok of {
                false -> r1;
                true -> do
                    r2: TypeCheckResult <- check_expr(expr.right_expr, second_type, context);
                    case r2.is_ok of {
                        false -> r2;
                        true -> check_user_call_result_user_call(expr, expected_type, return_type)
                    }
                end
            }
        end
    }
}

// Let binding: name: type <- rhs; body. Check rhs has declared type, add to env, check body.
// Reject unit for named variables; allow _ : unit <- expr (discard pattern for expression statements).
// Memory region types (ref, region, buf) are validated before type checking.
fn check_let(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    bind_type: string <- expr.value;
    case type_checker_memory_regions@is_memory_region_type(bind_type) of {
        true -> check_let_memory_region(expr, expected_type, context, bind_type);
        false -> check_let_after_validation(expr, expected_type, context, bind_type)
    }
}

fn check_let_memory_region(expr: Expr, expected_type: string, context: TypeContext, bind_type: string) -> TypeCheckResult proc[DeviceIO] {
    mem_result: TypeCheckResult <- type_checker_memory_regions@validate_memory_region_type(bind_type, expr.location);
    case mem_result.is_ok of {
        false -> mem_result;
        true -> check_let_after_validation(expr, expected_type, context, bind_type)
    }
}

fn check_let_after_validation(expr: Expr, expected_type: string, context: TypeContext, bind_type: string) -> TypeCheckResult proc[DeviceIO] {
    case bind_type == "unit" of {
        true -> case expr.name == "_" of {
            true -> do
                rhs_result: TypeCheckResult <- check_expr(expr.inner, "discard", context);
                case rhs_result.is_ok of {
                    false -> rhs_result;
                    true -> do
                        body_result: TypeCheckResult <- check_expr(expr.right_expr, expected_type, context);
                        body_result
                    end
                }
            end;
            false -> type_checker_core@type_check_err("E2006", expr.location, "unit is not a valid type for variables or parameters", "sect4")
        };
        false -> do
            is_discard: bool <- len(expr.name) == 1 and substring(expr.name, 0, 1) == "_";
            rhs_expected: string <- case is_discard of { true -> "discard"; false -> bind_type };
            rhs_result: TypeCheckResult <- check_expr(expr.inner, rhs_expected, context);
            case rhs_result.is_ok of {
                false -> rhs_result;
                true -> do
                    new_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, expr.name, bind_type, parser_ast@empty_effect_name_list());
                    new_context: TypeContext <- type_checker_core@type_context_with_env(context, new_env);
                    body_result: TypeCheckResult <- check_expr(expr.right_expr, expected_type, new_context);
                    body_result
                end
            }
        end
    }
}

// Build context with all bindings from sequence body (let chain and tuple decomposes).
// The produces pure expr sees variables bound in the body.
fn context_after_sequence_body(body: Expr, context: TypeContext) -> TypeContext {
    case body.kind == 6 of {
        true -> do
            is_discard: bool <- body.value == "unit" and body.name == "_";
            new_context: TypeContext <- case is_discard of {
                true -> context;
                false -> type_checker_core@type_context_with_env(context, type_checker_core@add_symbol(context.env, body.name, body.value, parser_ast@empty_effect_name_list()))
            };
            context_after_sequence_body(body.right_expr, new_context)
        end;
        false -> case body.kind == 10 of {
            true -> do
                extended: TypeContext <- type_checker_tuple_decompose_helpers@add_bindings_to_context(context, body.pattern_bindings);
                context_after_sequence_body(body.right_expr, extended)
            end;
            false -> context
        }
    }
}

// Sequence block (kind 11): sequence [proc[ε]] {statements} produces pure expr end
// inner = body (statements before produces), right_expr = result (pure expr); sequence_effects validated by effect checker
// The produces expr is in scope of all bindings from the body.
// Phase A lifetime analysis: when return type contains ref/buf, region must be returned (spec §12.1.4).
fn check_sequence_block(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    body_result: TypeCheckResult <- check_expr(expr.inner, "discard", context);
    case body_result.is_ok of {
        false -> body_result;
        true -> do
            result_context: TypeContext <- context_after_sequence_body(expr.inner, context);
            expr_result: TypeCheckResult <- check_expr(expr.right_expr, expected_type, result_context);
            case expr_result.is_ok of {
                false -> expr_result;
                true -> type_checker_memory_regions@check_sequence_return_lifetime(expected_type, expr.right_expr.location)
            }
        end
    }
}

// Tuple literal (kind 9): check against expected tuple type "(T1, T2)"
fn check_tuple_literal_inline(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    case len(expected_type) == 7 and substring(expected_type, 0, 1) == "d" and substring(expected_type, 1, 2) == "i" and substring(expected_type, 2, 3) == "s" and substring(expected_type, 3, 4) == "c" and substring(expected_type, 4, 5) == "a" and substring(expected_type, 5, 6) == "r" and substring(expected_type, 6, 7) == "d" of {
        true -> type_checker_core@type_check_ok();
        false -> case len(expected_type) < 2 of {
            true -> type_checker_core@type_check_err("E2005", expr.location, concat("tuple literal requires tuple type, got ", expected_type), "sect4");
            false -> case substring(expected_type, 0, 1) == "(" of {
                true -> case substring(expected_type, len(expected_type) - 1, len(expected_type)) == ")" of {
                    true -> do
                        inner: string <- substring(expected_type, 1, len(expected_type) - 1);
                        comma_pos: int64 <- case expr.inner.kind == 9 of {
                            true -> tuple_find_last_top_level_comma(inner);
                            false -> tuple_find_top_level_comma(inner, 0)
                        };
                        first_type_raw: string <- substring(inner, 0, comma_pos);
                        first_type: string <- tuple_trim_leading(first_type_raw);
                        first_type_wrapped: string <- case tuple_find_top_level_comma(first_type, 0) < len(first_type) of {
                            true -> concat(concat("(", first_type), ")");
                            false -> first_type
                        };
                        rest_start: int64 <- comma_pos + 1;
                        second_type_raw: string <- case rest_start < len(inner) of {
                            true -> substring(inner, rest_start, len(inner));
                            false -> ""
                        };
                        second_type: string <- tuple_trim_leading(second_type_raw);
                        second_type_wrapped: string <- case tuple_find_top_level_comma(second_type, 0) < len(second_type) of {
                            true -> concat(concat("(", second_type), ")");
                            false -> second_type
                        };
                        first_result: TypeCheckResult <- check_expr(expr.inner, first_type_wrapped, context);
                        case first_result.is_ok of {
                            false -> first_result;
                            true -> do
                                second_result: TypeCheckResult <- check_expr(expr.right_expr, second_type_wrapped, context);
                                second_result
                            end
                        }
                    end;
                    false -> type_checker_core@type_check_err("E2005", expr.location, concat("tuple literal requires tuple type, got ", expected_type), "sect4")
                };
                false -> type_checker_core@type_check_err("E2005", expr.location, concat("tuple literal requires tuple type, got ", expected_type), "sect4")
            }
        }
    }
}

fn tuple_trim_leading(s: string) -> string {
    tuple_trim_leading_from(s, 0)
}

fn tuple_trim_leading_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> tuple_trim_leading_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

// Find first comma at top level (not inside parentheses). Handles nested tuples recursively.
fn tuple_find_top_level_comma(s: string, i: int64) -> int64 {
    tuple_find_top_level_comma_from(s, i, 0)
}

fn tuple_find_top_level_comma_from(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) == "(" of {
            true -> tuple_find_top_level_comma_from(s, i + 1, depth + 1);
            false -> case substring(s, i, i + 1) == ")" of {
                true -> case depth <= 0 of {
                    true -> len(s);
                    false -> tuple_find_top_level_comma_from(s, i + 1, depth - 1)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> i;
                        false -> tuple_find_top_level_comma_from(s, i + 1, depth)
                    };
                    false -> tuple_find_top_level_comma_from(s, i + 1, depth)
                }
            }
        }
    }
}

// Find last comma at top level. For right-nested (a,(b,c)), inner has type (A,B), right_expr has type C.
fn tuple_find_last_top_level_comma(s: string) -> int64 {
    tuple_find_last_top_level_comma_from(s, 0, 0, -1)
}

fn tuple_find_last_top_level_comma_from(s: string, i: int64, depth: int64, last: int64) -> int64 {
    case i >= len(s) of {
        true -> case last < 0 of { true -> len(s); false -> last };
        false -> case substring(s, i, i + 1) == "(" of {
            true -> tuple_find_last_top_level_comma_from(s, i + 1, depth + 1, last);
            false -> case substring(s, i, i + 1) == ")" of {
                true -> case depth <= 0 of {
                    true -> case last < 0 of { true -> len(s); false -> last };
                    false -> tuple_find_last_top_level_comma_from(s, i + 1, depth - 1, last)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> tuple_find_last_top_level_comma_from(s, i + 1, depth, i);
                        false -> tuple_find_last_top_level_comma_from(s, i + 1, depth, last)
                    };
                    false -> tuple_find_last_top_level_comma_from(s, i + 1, depth, last)
                }
            }
        }
    }
}

// Whether expression mentions identifier `name` (for case guard rule §3.4: guard must depend on pattern bindings).
fn expr_references_name(e: Expr, name: string) -> bool {
    case e.kind < 0 of {
        true -> false;
        false -> case e.kind of {
            0 -> false;
            1 -> e.name == name;
            2 -> expr_references_name(e.inner, name);
            3 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            4 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            5 -> false;
            6 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            7 -> false;
            8 -> false;
            9 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            10 -> expr_references_name(e.inner, name);
            11 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            12 -> expr_references_name(e.inner, name);
            13 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            19 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr.inner, name) or expr_references_name(e.right_expr.right_expr, name);
            20 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            _: int64 -> false
        }
    }
}

fn case_list_cons_guard_ok_expr(branch: Expr, pi: CasePatternInfo) -> bool {
    head_bound: bool <- len(pi.bind_name) > 0 and pi.bind_name != "_";
    tail_bound: bool <- len(pi.list_tail_name) > 0 and pi.list_tail_name != "_";
    case head_bound of {
        false -> case tail_bound of {
            false -> true;
            true -> expr_references_name(branch.inner, pi.list_tail_name)
        };
        true -> case tail_bound of {
            false -> expr_references_name(branch.inner, pi.bind_name);
            true -> expr_references_name(branch.inner, pi.bind_name) or expr_references_name(branch.inner, pi.list_tail_name)
        }
    }
}

fn check_case_guard_invariant(branch: Expr, pi: CasePatternInfo) -> TypeCheckResult {
    case type_checker_tuple_decompose_helpers@case_pattern_has_named_binding(pi) of {
        true -> case pi.pattern_kind of {
            6 -> case case_list_cons_guard_ok_expr(branch, pi) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", branch.inner.location, "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            };
            _: int64 -> case expr_references_name(branch.inner, type_checker_tuple_decompose_helpers@case_pattern_binding_name(pi)) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", branch.inner.location, "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            }
        };
        false -> type_checker_core@type_check_err("E2014", branch.inner.location, "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
    }
}

fn check_case_branch_guard(branch: Expr, pi: CasePatternInfo, ext_ctx: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    case branch.inner.kind < 0 of {
        true -> type_checker_core@type_check_ok();
        false -> do
            g: TypeCheckResult <- check_expr(branch.inner, "boolean", ext_ctx);
            case g.is_ok of {
                false -> g;
                true -> check_case_guard_invariant(branch, pi)
            }
        end
    }
}

fn check_one_case_branch(branch: Expr, scrutinee_type: string, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    case branch.kind == 18 of {
        false -> type_checker_core@type_check_err("E2005", branch.location, "malformed case branch", "sect3");
        true -> do
            pi: CasePatternInfo <- type_checker_tuple_decompose_helpers@case_parse_pattern(branch.value);
            case pi.is_valid of {
                false -> type_checker_core@type_check_err("E2005", branch.location, "invalid or unsupported case pattern", "sect3");
                true -> case type_checker_tuple_decompose_helpers@case_pattern_matches_scrutinee(pi, scrutinee_type) of {
                    false -> type_checker_core@type_check_err("E2005", branch.location, "case pattern does not match scrutinee type", "sect3");
                    true -> do
                        ext_ctx: TypeContext <- type_checker_tuple_decompose_helpers@case_extend_context_for_pattern(context, scrutinee_type, branch.value);
                        guard_r: TypeCheckResult <- check_case_branch_guard(branch, pi, ext_ctx);
                        case guard_r.is_ok of {
                            false -> guard_r;
                            true -> check_expr(branch.right_expr, expected_type, ext_ctx)
                        }
                    end
                }
            }
        end
    }
}

fn check_case_branch_list(branches: Expr, scrutinee_type: string, expected_type: string, context: TypeContext, case_loc: SourceLocation) -> TypeCheckResult proc[DeviceIO] {
    case branches.kind == -1 of {
        true -> type_checker_core@type_check_ok();
        false -> case branches.kind == 17 of {
            true -> do
                b: Expr <- branches.inner;
                rest: Expr <- branches.right_expr;
                r: TypeCheckResult <- check_one_case_branch(b, scrutinee_type, expected_type, context);
                case r.is_ok of {
                    false -> r;
                    true -> check_case_branch_list(rest, scrutinee_type, expected_type, context, case_loc)
                }
            end;
            false -> type_checker_core@type_check_err("E2005", case_loc, "malformed case branch list", "sect3")
        }
    }
}

fn check_case_boolean_exhaustive(branches: Expr, scrutinee_type: string, case_loc: SourceLocation) -> TypeCheckResult {
    case scrutinee_type == "boolean" of {
        false -> type_checker_core@type_check_ok();
        true -> do
            cov: CaseBoolCoverage <- type_checker_tuple_decompose_helpers@case_scan_bool_coverage(branches, scrutinee_type);
            case type_checker_tuple_decompose_helpers@case_bool_coverage_ok(cov) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2005", case_loc, "case on boolean must cover true and false or include a wildcard branch (_ : boolean)", "sect3")
            }
        end
    }
}

fn check_case_expression(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    case expr.right_expr.kind == -1 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, "case expression must have at least one branch", "sect3");
        false -> do
            scrutinee_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
            case len(scrutinee_type) == 0 of {
                true -> type_checker_core@type_check_err("E2005", expr.location, "cannot infer type of case scrutinee", "sect3");
                false -> do
                    rscr: TypeCheckResult <- check_expr(expr.inner, scrutinee_type, context);
                    case rscr.is_ok of {
                        false -> rscr;
                        true -> do
                            branches_r: TypeCheckResult <- check_case_branch_list(expr.right_expr, scrutinee_type, expected_type, context, expr.location);
                            case branches_r.is_ok of {
                                false -> branches_r;
                                true -> check_case_boolean_exhaustive(expr.right_expr, scrutinee_type, expr.location)
                            }
                        end
                    }
                end
            }
        end
    }
}

// true/false as identifiers: lexer may emit identifier; treat as boolean literal (spec: boolean values)
fn is_true_or_false_identifier(expr: Expr) -> bool {
    case len(expr.name) of {
        4 -> case substring(expr.name, 0, 1) of {
            "t" -> case substring(expr.name, 1, 2) of {
                "r" -> case substring(expr.name, 2, 3) of {
                    "u" -> case substring(expr.name, 3, 4) of { "e" -> true; _: string -> false };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        5 -> case substring(expr.name, 0, 1) of {
            "f" -> case substring(expr.name, 1, 2) of {
                "a" -> case substring(expr.name, 2, 3) of {
                    "l" -> case substring(expr.name, 3, 4) of {
                        "s" -> case substring(expr.name, 4, 5) of { "e" -> true; _: string -> false };
                        _: string -> false
                    };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        _: int64 -> false
    }
}

// List literal (kind 20): value = full List[T, S] on root; inner/right_expr chain like tuple kind 9.
fn check_list_literal(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    lit_t: string <- case len(expr.value) > 0 of {
        true -> expr.value;
        false -> expected_type
    };
    case len(lit_t) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, "list literal requires a typed binding (name: List[T, S] <- [...])", "list");
        false -> do
            case type_checker_lists@list_types_compatible(expected_type, lit_t) of {
                false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("list literal type ", lit_t), " does not match expected "), expected_type), ""), "list");
                true -> do
                    (_ok: bool, elem_t: string, _: string) <- type_checker_lists@parse_list_type_params(lit_t);
                    case expr.inner.kind == -1 of {
                        true -> type_checker_core@type_check_ok();
                        false -> check_list_elem_tree(expr, elem_t, context)
                    }
                end
            }
        end
    }
}

fn check_list_elem_tree(expr: Expr, elem_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    case expr.kind == 20 of {
        true -> do
            r1: TypeCheckResult <- check_expr(expr.inner, elem_type, context);
            case r1.is_ok of {
                false -> r1;
                true -> case expr.right_expr.kind == -1 of {
                    true -> type_checker_core@type_check_ok();
                    false -> check_list_elem_tree(expr.right_expr, elem_type, context)
                }
            }
        end;
        false -> check_expr(expr, elem_type, context)
    }
}

// Compiler-known list primitives (list_implementation_design.md §7): empty, length, prepend, remove_head, head.
fn check_list_primitive_call(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    (elem: string, space: string) <- type_checker_lists@parse_generic_ts(expr.value);
    case len(elem) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, concat(concat("list primitive ", expr.name), " requires explicit generic type arguments [T, S] or [T]"), "list");
        false -> do
            list_t: string <- type_checker_lists@format_list_type_from_parts(elem, space);
            case expr.name == "empty" of {
                true -> do
                    ac: int64 <- type_checker_lists@count_call_args_list(expr);
                    case ac == 0 of {
                        false -> type_checker_core@type_check_err("E2005", expr.location, "empty expects 0 arguments", "list");
                        true -> case expected_type == "discard" of {
                            true -> type_checker_core@type_check_ok();
                            false -> case type_checker_lists@list_types_compatible(expected_type, list_t) of {
                                true -> type_checker_core@type_check_ok();
                                false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("empty returns ", list_t), ", expected "), expected_type), ""), "list")
                            }
                        }
                    }
                end;
                false -> case expr.name == "length" of {
                    true -> do
                        ac: int64 <- type_checker_lists@count_call_args_list(expr);
                        case ac == 1 of {
                            false -> type_checker_core@type_check_err("E2005", expr.location, "length expects 1 argument", "list");
                            true -> do
                                r1: TypeCheckResult <- check_expr(expr.inner, list_t, context);
                                case r1.is_ok of {
                                    false -> r1;
                                    true -> case expected_type == "discard" of {
                                        true -> type_checker_core@type_check_ok();
                                        false -> case expected_type == "int64" of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat("length returns int64, expected ", expected_type), ""), "list")
                                        }
                                    }
                                }
                            end
                        }
                    end;
                    false -> case expr.name == "prepend" of {
                        true -> do
                            ac: int64 <- type_checker_lists@count_call_args_list(expr);
                            case ac == 2 of {
                                false -> type_checker_core@type_check_err("E2005", expr.location, "prepend expects 2 arguments (element, list)", "list");
                                true -> do
                                    r1: TypeCheckResult <- check_expr(expr.inner, elem, context);
                                    case r1.is_ok of {
                                        false -> r1;
                                        true -> do
                                            r2: TypeCheckResult <- check_expr(call_second_arg_expr(expr), list_t, context);
                                            case r2.is_ok of {
                                                false -> r2;
                                                true -> case expected_type == "discard" of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> case type_checker_lists@list_types_compatible(expected_type, list_t) of {
                                                        true -> type_checker_core@type_check_ok();
                                                        false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("prepend returns ", list_t), ", expected "), expected_type), ""), "list")
                                                    }
                                                }
                                            }
                                        end
                                    }
                                end
                            }
                        end;
                        false -> case expr.name == "remove_head" of {
                            true -> do
                                ac: int64 <- type_checker_lists@count_call_args_list(expr);
                                case ac == 1 of {
                                    false -> type_checker_core@type_check_err("E2005", expr.location, "remove_head expects 1 argument", "list");
                                    true -> do
                                        r1: TypeCheckResult <- check_expr(expr.inner, list_t, context);
                                        case r1.is_ok of {
                                            false -> r1;
                                            true -> case expected_type == "discard" of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> case type_checker_lists@list_types_compatible(expected_type, list_t) of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("remove_head returns ", list_t), ", expected "), expected_type), ""), "list")
                                                }
                                            }
                                        }
                                    end
                                }
                            end;
                            false -> case expr.name == "head" of {
                                true -> do
                                    ac: int64 <- type_checker_lists@count_call_args_list(expr);
                                    case ac == 1 of {
                                        false -> type_checker_core@type_check_err("E2005", expr.location, "head expects 1 argument", "list");
                                        true -> do
                                            r1: TypeCheckResult <- check_expr(expr.inner, list_t, context);
                                            case r1.is_ok of {
                                                false -> r1;
                                                true -> case expected_type == "discard" of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> case type_checker_lists@types_equal_strip(expected_type, elem) of {
                                                        true -> type_checker_core@type_check_ok();
                                                        false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("head returns ", elem), ", expected "), expected_type), ""), "list")
                                                    }
                                                }
                                            }
                                        end
                                    }
                                end;
                                false -> type_checker_core@type_check_err("E2005", expr.location, concat("unknown list primitive: ", expr.name), "list")
                            }
                        }
                    }
                }
            }
        end
    }
}

// Dispatch on Expr kind: 0=literal, 1=identifier, 2=parenthesized (recurse), 3=binary op, 4=call, 5=atom literal, 6=let binding, 7=boolean literal, 8=string literal, 12=unary minus (forbidden); 20=list literal
fn check_expr(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    case expr.kind of {
        0 -> type_checker_expressions_literals@check_expr(expr, expected_type, context);
        1 -> case is_true_or_false_identifier(expr) of {
            true -> boolean_type_checker_expressions@check_expr(expr, expected_type, context);
            false -> type_checker_expressions_identifiers@check_expr(expr, expected_type, context)
        };
        2 -> check_expr(expr.inner, expected_type, context);
        3 -> check_binary_op(expr, expected_type, context);
        4 -> check_call(expr, expected_type, context);
        5 -> type_checker_expressions_atoms@check_expr(expr, expected_type, context);
        6 -> check_let(expr, expected_type, context);
        7 -> boolean_type_checker_expressions@check_expr(expr, expected_type, context);
        8 -> case len(expected_type) == 6 and substring(expected_type, 0, 1) == "s" and substring(expected_type, 1, 2) == "t" and substring(expected_type, 2, 3) == "r" and substring(expected_type, 3, 4) == "i" and substring(expected_type, 4, 5) == "n" and substring(expected_type, 5, 6) == "g" of {
            true -> type_checker_core@type_check_ok();
            false -> case len(expected_type) == 7 and substring(expected_type, 0, 1) == "d" and substring(expected_type, 1, 2) == "i" and substring(expected_type, 2, 3) == "s" and substring(expected_type, 3, 4) == "c" and substring(expected_type, 4, 5) == "a" and substring(expected_type, 5, 6) == "r" and substring(expected_type, 6, 7) == "d" of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2001", expr.location, concat("string literal requires string type, got ", case expected_type of { "" -> "[EMPTY]"; _: string -> expected_type }), "sect6")
            }
        };
        9 -> check_tuple_literal_inline(expr, expected_type, context);
        10 -> check_tuple_decompose(expr, expected_type, context);
        11 -> check_sequence_block(expr, expected_type, context);
        12 -> check_unary_minus_forbidden(expr, context);
        13 -> check_case_expression(expr, expected_type, context);
        19 -> check_if_expression(expr, expected_type, context);
        20 -> check_list_literal(expr, expected_type, context);
        _: int64 -> type_checker_core@type_check_ok()
    }
}

fn check_if_expression(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    rc: TypeCheckResult <- check_expr(expr.inner, "boolean", context);
    case rc.is_ok of {
        false -> rc;
        true -> do
            rt: TypeCheckResult <- check_expr(expr.right_expr.inner, expected_type, context);
            case rt.is_ok of {
                false -> rt;
                true -> case expr.right_expr.right_expr.kind < 0 of {
                    true -> type_checker_core@type_check_ok();
                    false -> check_expr(expr.right_expr.right_expr, expected_type, context)
                }
            }
        end
    }
}

// Tuple decomposition (kind 10): (pattern) <- rhs; body
// Uses structured pattern_bindings from AST. All elements must be typed; pattern types must match RHS.
fn check_tuple_decompose(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    rhs_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
    case len(rhs_type) < 2 or substring(rhs_type, 0, 1) != "(" of {
        true -> type_checker_core@type_check_err("E2005", expr.location, concat("tuple decomposition RHS must have tuple type, got ", case len(rhs_type) == 0 of { true -> "[unknown]"; false -> rhs_type }), "sect4");
        false -> do
            bindings: ListTupleDecomposeBinding <- expr.pattern_bindings;
            valid_result: TypeCheckResult <- type_checker_tuple_decompose_helpers@pattern_bindings_valid(bindings, expr.location);
            case valid_result.is_ok of {
                false -> valid_result;
                true -> check_tuple_decompose_after_valid(expr, expected_type, context, rhs_type, bindings)
            }
        end
    }
}

fn check_tuple_decompose_after_valid(expr: Expr, expected_type: string, context: TypeContext, rhs_type: string, bindings: ListTupleDecomposeBinding) -> TypeCheckResult proc[DeviceIO] {
    match_result: TypeCheckResult <- type_checker_tuple_decompose_helpers@pattern_types_match_rhs(bindings, rhs_type, expr.location);
    case match_result.is_ok of {
        false -> match_result;
        true -> do
            rhs_result: TypeCheckResult <- check_expr(expr.inner, rhs_type, context);
            case rhs_result.is_ok of {
                false -> rhs_result;
                true -> do
                    extended_context: TypeContext <- type_checker_tuple_decompose_helpers@add_bindings_to_context(context, bindings);
                    check_expr(expr.right_expr, expected_type, extended_context)
                end
            }
        end
    }
}
