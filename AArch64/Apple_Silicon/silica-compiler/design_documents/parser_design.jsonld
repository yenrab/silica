{
  "@context": {
    "@vocab": "https://aalang.dev/silica/parser/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "http://schema.org/",
    "silica": "https://aalang.dev/silica/spec/",
    "parser": "https://aalang.dev/silica/parser/",
    "compiler": "https://aalang.dev/silica/compiler/"
  },
  "@graph": [
    {
      "@id": "parser:ParserDesign",
      "@type": "Document",
      "rdfs:label": "Silica Parser Design: Constraint Propagation",
      "description": "Principles, properties, and architecture for the Silica parser using constraint propagation",
      "version": "1.0",
      "created": "2025-02-15",
      "implementationLanguage": "Silica",
      "relatedDocuments": [
        {"@id": "compiler:CodeOrganization", "title": "Silica Compiler Code Organization"},
        {"path": "silica-specification.md", "title": "Silica Language Specification"},
        {"path": "sir_generator_formalization_spec.md", "title": "SIR Generator Formalization"}
      ]
    },
    {
      "@id": "parser:Principle1",
      "@type": "DesignPrinciple",
      "rdfs:label": "Principle 1: Constraint Propagation",
      "number": 1,
      "description": "Parsing is constraint satisfaction, not grammar-driven recognition",
      "details": "Each token starts with a set of possible roles. Grammar rules are expressed as constraints between adjacent tokens. Parsing repeatedly applies constraints until each token has exactly one role or a contradiction is found. Structure emerges from the final role sequence.",
      "properties": [
        "Constraints are local: each rule only references adjacent token pairs",
        "Constraints are independent: adding a new rule does not require modifying existing rules",
        "The propagation engine is generic: it does not need to know grammar specifics"
      ]
    },
    {
      "@id": "parser:Principle2",
      "@type": "DesignPrinciple",
      "rdfs:label": "Principle 2: One File Per Capability",
      "number": 2,
      "description": "Each language capability has exactly one dedicated file",
      "details": "A capability is a coherent syntactic construct (e.g., function declarations, integer literals, case expressions). All constraints, role definitions, and structure extraction for that capability live in a single file. Adding a new capability requires adding one new file and one line in the constraint registry.",
      "properties": [
        "Easy navigation: locate all code for a feature in one place",
        "Minimal merge conflicts: new capabilities rarely touch existing files",
        "Incremental development: capabilities can be added in any order",
        "Testability: each capability can be tested in isolation"
      ],
      "rules": [
        "No capability spans multiple files",
        "No file spans multiple capabilities",
        "Add capability = add file + one line in constraint registry"
      ]
    },
    {
      "@id": "parser:Principle3",
      "@type": "DesignPrinciple",
      "rdfs:label": "Principle 3: Immutability",
      "number": 3,
      "description": "All parser data structures are immutable",
      "details": "Constraint propagation returns new structures; it never mutates in place. Token slots, constraint sets, and the final AST are all immutable values.",
      "properties": [
        "Aligns with Silica's functional design",
        "Enables safe concurrency"
      ]
    },
    {
      "@id": "parser:Principle4",
      "@type": "DesignPrinciple",
      "rdfs:label": "Principle 4: Implementation Language Silica",
      "number": 4,
      "description": "The parser is implemented in Silica",
      "details": "Uses Silica's structs, linked lists, recursion, and case expressions. No arrays or mutable buffers in the initial implementation.",
      "constraints": [
        "Uses ListToken, ListInt, and similar linked structures",
        "All types are concrete; no generics"
      ]
    },
    {
      "@id": "parser:Pipeline",
      "@type": "Pipeline",
      "rdfs:label": "Parser Pipeline",
      "stages": [
        {"order": 1, "name": "Lexer", "input": "source", "output": "ListToken"},
        {"order": 2, "name": "Slot Initialization", "input": "ListToken", "output": "ListTokenSlot"},
        {"order": 3, "name": "Constraint Propagation", "input": "ListTokenSlot", "output": "ListTokenSlot"},
        {"order": 4, "name": "Structure Extraction", "input": "ListTokenSlot", "output": "Program"},
        {"order": 5, "name": "Output", "input": "Program", "output": "AST"}
      ]
    },
    {
      "@id": "parser:TokenSlot",
      "@type": "DataType",
      "rdfs:label": "TokenSlot",
      "description": "A token with a set of possible syntactic roles",
      "fields": [
        {"name": "token", "type": "Token", "description": "From lexer (kind, lexeme, location)"},
        {"name": "possible_roles", "type": "ListInt", "description": "List of role codes still possible"}
      ]
    },
    {
      "@id": "parser:Constraint",
      "@type": "DataType",
      "rdfs:label": "Constraint",
      "description": "Bidirectional rules: forward—when token A has role X, token B (immediately following) must have role in next_token_roles; backward—when token B has role X, token A (immediately preceding) must have role in prev_token_roles",
      "fields": [
        {"name": "trigger_role", "type": "int64", "description": "When a token is fixed to this role"},
        {"name": "next_token_roles", "type": "ListInt", "description": "Allowed roles for the following token (empty = no forward constraint)"},
        {"name": "prev_token_roles", "type": "ListInt", "description": "Allowed roles for the preceding token (empty = no backward constraint)"},
        {"name": "constraint_id", "type": "int64", "description": "For debugging and error reporting"}
      ]
    },
    {
      "@id": "parser:DirectoryStructure",
      "@type": "Directory",
      "rdfs:label": "Parser Directory Structure",
      "path": "parser/",
      "description": "Constraint propagation parser layout with one file per capability",
      "coreFiles": [
        {"name": "constraint_core.silica", "description": "TokenSlot, Constraint, ListTokenSlot, propagation engine"},
        {"name": "constraint_runner.silica", "description": "parse_program, all_constraints registry, orchestration"},
        {"name": "constraint_extract.silica", "description": "slots_to_program (structure extraction)"}
      ],
      "subdirectories": [
        {
          "@id": "parser:CapabilitiesDirectory",
          "path": "parser/capabilities/",
          "rdfs:label": "Capabilities Directory",
          "description": "One file per language capability",
          "files": [
            {"name": "capability_fn_decl.silica", "description": "fn name ( ) -> type { body }"},
            {"name": "capability_expr_literal.silica", "description": "42, identifiers (minimal: fn main(){ 42 })"},
            {"name": "capability_case.silica", "description": "case x of { ... }"},
            {"name": "capability_struct.silica", "description": "struct X { ... }"},
            {"name": "capability_if.silica", "description": "if ... then ... else ..."}
          ]
        }
      ]
    },
    {
      "@id": "parser:CapabilityFileContract",
      "@type": "Contract",
      "rdfs:label": "Capability File Contract",
      "description": "Requirements for each capability file",
      "mustExport": [
        {"function": "constraints", "signature": "() -> ListConstraint", "description": "All constraints for this capability"},
        {"function": "initial_roles", "signature": "(token_kind: int64) -> ListInt", "description": "Roles this capability allows for the given token kind"}
      ],
      "optionalExport": [
        {"function": "extract_contribution", "signature": "(slots: ListTokenSlot, start_index: int64) -> (ASTFragment, int64)", "description": "Parse span and return fragment for structure extraction"}
      ],
      "mustNot": [
        "Depend on another capability's internals",
        "Modify shared state",
        "Define constraints that reference roles from other capabilities (except shared roles)"
      ]
    },
    {
      "@id": "parser:AddingCapability",
      "@type": "Process",
      "rdfs:label": "Adding a New Capability",
      "description": "Steps to add a new language capability to the parser",
      "steps": [
        {"step": 1, "action": "Create capability file", "file": "capabilities/capability_<name>.silica"},
        {"step": 2, "action": "Implement constraints()", "description": "Export all constraints for this capability"},
        {"step": 3, "action": "Implement initial_roles()", "description": "Export role initialization for token kinds"},
        {"step": 4, "action": "Implement extract_contribution()", "description": "Optional: structure extraction for this capability"},
        {"step": 5, "action": "Register in runner", "file": "constraint_runner.silica", "description": "Add one line to all_constraints()"},
        {"step": 6, "action": "Merge initial_roles", "description": "Add one line to merge initial_roles in role initialization"}
      ]
    },
    {
      "@id": "parser:InitialCapability",
      "@type": "Capability",
      "rdfs:label": "Initial Capability: fn main(){ 42 }",
      "scope": "Function declaration with empty params, return type, and integer literal body",
      "requiredFiles": [
        {"file": "capability_fn_decl.silica", "responsibility": "fn, name, params (empty), return type, braces"},
        {"file": "capability_expr_literal.silica", "responsibility": "integer literal, identifier as expression"}
      ]
    },
    {
      "@id": "parser:RoleCodes",
      "@type": "Concept",
      "rdfs:label": "Role Codes",
      "description": "Integer codes for syntactic roles; each capability defines its own namespace",
      "examples": [
        {"code": 1, "name": "fn_keyword", "capability": "fn_decl"},
        {"code": 2, "name": "fn_name", "capability": "fn_decl"},
        {"code": 3, "name": "left_paren", "capability": "fn_decl"},
        {"code": 4, "name": "right_paren", "capability": "fn_decl"},
        {"code": 5, "name": "right_arrow", "capability": "fn_decl"},
        {"code": 6, "name": "type_name", "capability": "fn_decl"},
        {"code": 7, "name": "left_brace", "capability": "fn_decl"},
        {"code": 8, "name": "right_brace", "capability": "fn_decl"},
        {"code": 9, "name": "body_expr", "capability": "fn_decl, expr_literal"},
        {"code": 10, "name": "integer_literal", "capability": "expr_literal"},
        {"code": 11, "name": "identifier", "capability": "expr_literal"}
      ]
    },
    {
      "@id": "parser:Properties",
      "@type": "Concept",
      "rdfs:label": "Design Properties",
      "properties": [
        {"name": "Modularity", "description": "One file per capability; no cross-file capability logic"},
        {"name": "Extensibility", "description": "Add capability = add file + one registry line"},
        {"name": "Immutability", "description": "All data structures immutable; propagation returns new values"},
        {"name": "Locality", "description": "Constraints reference only adjacent token pairs"},
        {"name": "Independence", "description": "Constraints do not depend on each other"},
        {"name": "Testability", "description": "Each capability testable in isolation"},
        {"name": "Incremental", "description": "Capabilities can be added in any order"},
        {"name": "Silica-native", "description": "Uses structs, linked lists, recursion; no arrays required"}
      ]
    },
    {
      "@id": "parser:ErrorReporting",
      "@type": "Concept",
      "rdfs:label": "Error Reporting",
      "cases": [
        {"condition": "Contradiction", "description": "Slot's possible_roles becomes empty", "action": "Report parse error at token location"},
        {"condition": "Ambiguity", "description": "Fixed point with slot having >1 role", "action": "Report ambiguity or apply disambiguation"},
        {"condition": "Incomplete", "description": "EOF before complete declaration", "action": "Report unexpected end of file"}
      ],
      "format": "Follows silica-specification.md §1.6: structured message with location, error code, spec section"
    },
    {
      "@id": "parser:Algorithm",
      "@type": "Algorithm",
      "rdfs:label": "Constraint Propagation Algorithm",
      "phases": [
        {
          "name": "Initialization",
          "description": "For each token, set possible_roles based on token kind from all capabilities"
        },
        {
          "name": "Propagation",
          "description": "For each adjacent pair (slot_i, slot_{i+1}): forward—if slot_i has one role, narrow slot_{i+1} by next_token_roles; backward—if slot_{i+1} has one role, narrow slot_i by prev_token_roles"
        },
        {
          "name": "Fixed Point",
          "description": "Repeat until no changes or contradiction"
        },
        {
          "name": "Structure Extraction",
          "description": "Build AST from final role sequence when all slots have exactly one role"
        }
      ]
    }
  ]
}
