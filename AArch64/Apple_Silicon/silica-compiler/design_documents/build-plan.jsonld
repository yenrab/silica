    {
      "@id": "plan:SilicaPattern1",
      "@type": "SilicaPattern",
      "rdfs:label": "Pattern 1: Region-Based Memory Management",
      "patternType": "memory_management",
      "pattern": "analysis_region: region(R, normal) <- alloc_region(normal) proc[mem(normal)]; env: ref(R, normal, TypeEnv) <- alloc_ref(analysis_region, create_type_env()) proc[mem(normal)];",
      "description": "Use region-based allocation for compiler data structures",
      "applicableTo": ["All compiler components"],
      "benefits": "Memory safety without garbage collection, explicit lifetime management"
    },
    {
      "@id": "plan:SilicaPattern2",
      "@type": "SilicaPattern",
      "rdfs:label": "Pattern 2: Explicit Effect Declarations",
      "patternType": "effect_system",
      "pattern": "fn check_syntax(ast: AST) -> bool { } fn analyze_types(ast: AST, env: ref(R, normal, TypeEnv)) -> Type proc[mem(normal)] { }",
      "description": "All compiler functions must explicitly declare effects",
      "applicableTo": ["All compiler functions"],
      "benefits": "Explicit side effect tracking, enables effect-based optimizations"
    },
    {
      "@id": "plan:SilicaPattern3",
      "@type": "SilicaPattern",
      "rdfs:label": "Pattern 3: Trait-Based Polymorphism",
      "patternType": "code_structure",
      "pattern": "trait CompilerPhase { fn analyze(self: Self, input: PhaseInput) -> PhaseOutput proc[mem(normal)]; } impl CompilerPhase for RegionAnalyzer { fn analyze(self: RegionAnalyzer, input: PhaseInput) -> PhaseOutput proc[mem(normal)] { } }",
      "description": "Use traits for polymorphic compiler components",
      "applicableTo": ["Compiler component interfaces"],
      "benefits": "Polymorphism without generics, explicit trait implementations"
    },
    {
      "@id": "plan:SilicaPattern4",
      "@type": "SilicaPattern",
      "rdfs:label": "Pattern 4: Pattern Matching for AST Traversal",
      "patternType": "code_structure",
      "pattern": "fn analyze_expression(expr: Expression) -> Type proc[mem(normal)] { case expr of { Literal(lit) -> analyze_literal(lit); Identifier(name) -> lookup_type(name); Call(call_expr) -> analyze_call(call_expr); _: Expression -> error(\"Unsupported expression\"); } }",
      "description": "Use pattern matching for AST node analysis",
      "applicableTo": ["AST analysis functions"],
      "benefits": "Exhaustive pattern matching, clear control flow"
    },
    {
      "@id": "plan:SilicaPattern5",
      "@type": "SilicaPattern",
      "rdfs:label": "Pattern 5: Recursive Data Structures",
      "patternType": "code_structure",
      "pattern": "enum DecisionTree { Leaf { result: Expression }, Branch { condition: Expression, true_branch: DecisionTree, false_branch: DecisionTree } }",
      "description": "Use recursive types for compiler data structures",
      "applicableTo": ["AST, type environments, analysis results"],
      "benefits": "Natural representation of hierarchical data, type-safe recursion"
    },
    {
      "@id": "plan:SilicaPattern6",
      "@type": "SilicaPattern",
      "rdfs:label": "Pattern 6: Explicit Type Annotations",
      "patternType": "code_structure",
      "pattern": "fn optimize_region_layout(regions: ListRegion, numa_topology: NUMATopology, cache_hierarchy: CacheHierarchy) -> OptimizedLayout proc[mem(normal)] { }",
      "description": "All function parameters and return types must be explicit",
      "applicableTo": ["All compiler functions"],
      "benefits": "No type inference ambiguity, clear interfaces"
    },
    {
      "@id": "plan:Component17",
