{
  "@context": {
    "@vocab": "https://aalang.dev/silica-compiler-planning/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "http://schema.org/",
    "silica": "https://aalang.dev/silica/spec/",
    "plan": "https://aalang.dev/silica-compiler-planning/"
  },
  "@graph": [
    {
      "@id": "plan:SilicaCompilerBuildPlan",
      "@type": "BuildPlan",
      "rdfs:label": "Silica Compiler Build Plan",
      "description": "Comprehensive plan for implementing missing compiler phases for the Silica compiler, written in Silica itself",
      "version": "1.0",
      "created": "2025-01-XX",
      "targetLanguage": "Silica",
      "targetPlatform": "AArch64",
      "sourceDocuments": [
        "specification-analysis-state.md",
        "bootstrap-analysis-state.md",
        "gap-analysis-state.md"
      ],
      "outputDocument": "build-plan.md",
      "phases": [
        {"@id": "plan:Phase1", "number": 1, "name": "Region Analysis Phase"},
        {"@id": "plan:Phase2", "number": 2, "name": "Pattern Matching Exhaustiveness Enhancement"},
        {"@id": "plan:Phase3", "number": 3, "name": "Hardware Capability Validation"},
        {"@id": "plan:Phase4", "number": 4, "name": "Region Optimization Phase"},
        {"@id": "plan:Phase5", "number": 5, "name": "Actor Optimization Phase"},
        {"@id": "plan:Phase6", "number": 6, "name": "Effect Lowering Phase"},
        {"@id": "plan:Phase7", "number": 7, "name": "Vectorization Phase"},
        {"@id": "plan:Phase8", "number": 8, "name": "Native Backend Phases"}
      ],
      "components": [
        {"@id": "plan:Component0", "number": 0, "name": "Lexer"},
        {"@id": "plan:Component1", "number": 1, "name": "Parser"},
        {"@id": "plan:Component2", "number": 2, "name": "Module Resolver"},
        {"@id": "plan:Component3", "number": 3, "name": "Type Checker"},
        {"@id": "plan:Component4", "number": 4, "name": "Effect Checker"},
        {"@id": "plan:Component5", "number": 5, "name": "Code Generator (LLVM)"},
        {"@id": "plan:Component6", "number": 6, "name": "Region Analyzer"},
        {"@id": "plan:Component7", "number": 7, "name": "Pattern Analyzer"},
        {"@id": "plan:Component8", "number": 8, "name": "Hardware Detector"},
        {"@id": "plan:Component9", "number": 9, "name": "Region Optimizer"},
        {"@id": "plan:Component10", "number": 10, "name": "Actor Optimizer"},
        {"@id": "plan:Component11", "number": 11, "name": "Effect Lowering"},
        {"@id": "plan:Component12", "number": 12, "name": "Vectorizer"},
        {"@id": "plan:Component13", "number": 13, "name": "Instruction Selector"},
        {"@id": "plan:Component14", "number": 14, "name": "Register Allocator"},
        {"@id": "plan:Component15", "number": 15, "name": "Code Layout Optimizer"},
        {"@id": "plan:Component16", "number": 16, "name": "Link-Time Optimizer"},
        {"@id": "plan:Component17", "number": 17, "name": "Toolchain Integration"}
      ],
      "toolchainIntegration": {
        "@id": "plan:ToolchainIntegration",
        "description": "Toolchain selection and configuration handled by build systems (Makefiles). Compiler accepts toolchain configuration via command-line flags.",
        "buildSystemResponsibility": [
          "Toolchain detection (detecting available Apple Clang or LLVM toolchains)",
          "Toolchain selection based on target platform",
          "Passing toolchain configuration to compiler via command-line flags",
          "Invoking assembler and linker after compiler generates assembly",
          "Managing toolchain-specific flags and library paths"
        ],
        "compilerResponsibility": [
          "Parsing toolchain configuration from command-line flags",
          "Generating assembly compatible with specified toolchain",
          "Optionally invoking toolchain drivers when --assemble or --link flags provided"
        ],
        "tasks": [
          {"@id": "plan:TaskTC1"},
          {"@id": "plan:TaskTC2"},
          {"@id": "plan:TaskTC3"},
          {"@id": "plan:TaskTC4"}
        ]
      }
    },
    {
      "@id": "plan:Phase1",
      "@type": "CompilerPhase",
      "rdfs:label": "Phase 1: Region Analysis Phase",
      "phaseNumber": 1,
      "priority": "critical",
      "gapId": "GAP-001",
      "severity": "critical",
      "description": "Analyze region-based memory management for lifetime and ownership verification",
      "specificationReferences": [
        {"section": "12", "title": "Memory Model"},
        {"section": "12.1.4", "title": "Static Region Lifetime Analysis"},
        {"section": "27.5.1", "title": "Frontend Phases"}
      ],
      "dependencies": ["Type Checking Phase"],
      "blocks": ["Region Optimization Phase"],
      "subPhases": [
        {"@id": "plan:Phase1_1", "number": "1.1", "name": "Lifetime Environment Infrastructure"},
        {"@id": "plan:Phase1_2", "number": "1.2", "name": "Region Allocation Analysis"},
        {"@id": "plan:Phase1_3", "number": "1.3", "name": "Reference Usage Analysis"},
        {"@id": "plan:Phase1_4", "number": "1.4", "name": "Cross-Function Analysis"},
        {"@id": "plan:Phase1_5", "number": "1.5", "name": "Cross-Module Region Analysis"}
      ],
      "implementsComponent": "plan:Component1"
    },
    {
      "@id": "plan:Phase1_1",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 1.1: Lifetime Environment Infrastructure",
      "parentPhase": "plan:Phase1",
      "component": "plan:Component1",
      "tasks": [
        {
          "@id": "plan:Task1_1_1",
          "taskNumber": "1.1.1",
          "name": "Define Lifetime Environment Types",
          "subtasks": [
            {"number": "1.1.1.1", "name": "Define LifetimeEnv type mapping region identifiers to scopes"},
            {"number": "1.1.1.2", "name": "Define DependencySet type tracking references and creation scopes"},
            {"number": "1.1.1.3", "name": "Define ScopeId type for lexical scope identification"}
          ],
          "specificationReference": {"section": "12.1.4"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "struct LifetimeEnv { regions: MapRegionIdScope, current_scope: ScopeId }",
            "description": "Use struct types with explicit type annotations"
          },
          "module": "plan:Module1_1"
        },
        {
          "@id": "plan:Task1_1_2",
          "taskNumber": "1.1.2",
          "name": "Implement Scope Tracking",
          "subtasks": [
            {"number": "1.1.2.1", "name": "Create scope entry function"},
            {"number": "1.1.2.2", "name": "Create scope exit function"},
            {"number": "1.1.2.3", "name": "Implement scope hierarchy tracking"}
          ],
          "specificationReference": {"section": "12.1.4"},
          "silicaPattern": {
            "patternType": "memory_management",
            "pattern": "fn enter_scope(env: ref(R, normal, LifetimeEnv)) -> ScopeId proc[mem(normal)]",
            "description": "Use region-based memory for scope tracking"
          },
          "module": "plan:Module1_1"
        }
      ]
    },
    {
      "@id": "plan:Phase1_2",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 1.2: Region Allocation Analysis",
      "parentPhase": "plan:Phase1",
      "component": "plan:Component1",
      "tasks": [
        {
          "@id": "plan:Task1_2_1",
          "taskNumber": "1.2.1",
          "name": "Implement Region Allocation Rule",
          "subtasks": [
            {"number": "1.2.1.1", "name": "Analyze alloc_region expressions"},
            {"number": "1.2.1.2", "name": "Add region to lifetime environment"},
            {"number": "1.2.1.3", "name": "Assign current scope to region"}
          ],
          "specificationReference": {"section": "12.1.4"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "fn analyze_region_allocation(expr: RegionExpr, env: ref(R, normal, LifetimeEnv), deps: ref(R, normal, DependencySet)) -> (Type, LifetimeEnv, DependencySet) proc[mem(normal)]",
            "description": "Pattern match on AST expression types"
          },
          "module": "plan:Module1_3"
        },
        {
          "@id": "plan:Task1_2_2",
          "taskNumber": "1.2.2",
          "name": "Implement Reference Allocation Rule",
          "subtasks": [
            {"number": "1.2.2.1", "name": "Analyze alloc_ref expressions"},
            {"number": "1.2.2.2", "name": "Verify region exists in lifetime environment"},
            {"number": "1.2.2.3", "name": "Add reference to dependency set"}
          ],
          "specificationReference": {"section": "12.1.4"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "fn analyze_ref_allocation(expr: AllocRefExpr, env: ref(R, normal, LifetimeEnv), deps: ref(R, normal, DependencySet)) -> (Type, LifetimeEnv, DependencySet) proc[mem(normal)]",
            "description": "Use case expressions for pattern matching"
          },
          "module": "plan:Module1_3"
        }
      ]
    },
    {
      "@id": "plan:Phase1_3",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 1.3: Reference Usage Analysis",
      "parentPhase": "plan:Phase1",
      "component": "plan:Component1",
      "tasks": [
        {
          "@id": "plan:Task1_3_1",
          "taskNumber": "1.3.1",
          "name": "Implement Reference Read Rule",
          "subtasks": [
            {"number": "1.3.1.1", "name": "Analyze read_ref expressions"},
            {"number": "1.3.1.2", "name": "Verify region exists in lifetime environment"},
            {"number": "1.3.1.3", "name": "Verify reference exists in dependency set"},
            {"number": "1.3.1.4", "name": "Verify scope constraints"}
          ],
          "specificationReference": {"section": "12.1.4"},
          "silicaPattern": {
            "patternType": "effect_system",
            "pattern": "fn analyze_ref_read(expr: ReadRefExpr, env: ref(R, normal, LifetimeEnv), deps: ref(R, normal, DependencySet)) -> (Type, LifetimeEnv, DependencySet) proc[mem(normal)]",
            "description": "Use explicit type annotations and effect declarations"
          },
          "module": "plan:Module1_3"
        },
        {
          "@id": "plan:Task1_3_2",
          "taskNumber": "1.3.2",
          "name": "Implement Reference Write Rule",
          "subtasks": [
            {"number": "1.3.2.1", "name": "Analyze write_ref expressions"},
            {"number": "1.3.2.2", "name": "Verify reference and region constraints"},
            {"number": "1.3.2.3", "name": "Verify value type matches reference type"}
          ],
          "specificationReference": {"section": "12.1.4"},
          "module": "plan:Module1_3"
        }
      ]
    },
    {
      "@id": "plan:Phase1_4",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 1.4: Cross-Function Analysis",
      "parentPhase": "plan:Phase1",
      "component": "plan:Component1",
      "tasks": [
        {
          "@id": "plan:Task1_4_1",
          "taskNumber": "1.4.1",
          "name": "Implement Function Parameter Lifetime Extension",
          "subtasks": [
            {"number": "1.4.1.1", "name": "Analyze function parameters with region types"},
            {"number": "1.4.1.2", "name": "Extend region lifetimes to function return scope"}
          ],
          "specificationReference": {"section": "12.1.4"},
          "silicaPattern": {
            "patternType": "effect_system",
            "pattern": "fn analyze_function_lifetime(func: FunctionDecl, env: ref(R, normal, LifetimeEnv), deps: ref(R, normal, DependencySet)) -> (LifetimeEnv, DependencySet) proc[mem(normal)]",
            "description": "Use function types with explicit effects"
          },
          "module": "plan:Module1_3"
        },
        {
          "@id": "plan:Task1_4_2",
          "taskNumber": "1.4.2",
          "name": "Implement Function Return Lifetime Constraint",
          "subtasks": [
            {"number": "1.4.2.1", "name": "Analyze function return types with reference types"},
            {"number": "1.4.2.2", "name": "Verify region outlives function call"}
          ],
          "specificationReference": {"section": "12.1.4"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "fn check_return_lifetime(return_type: Type, env: ref(R, normal, LifetimeEnv)) -> bool proc[mem(normal)]",
            "description": "Pattern match on return type"
          },
          "module": "plan:Module1_3"
        }
      ]
    },
    {
      "@id": "plan:Phase1_5",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 1.5: Cross-Module Region Analysis",
      "parentPhase": "plan:Phase1",
      "component": "plan:Component1",
      "tasks": [
        {
          "@id": "plan:Task1_5_1",
          "taskNumber": "1.5.1",
          "name": "Implement Cross-Module Lifetime Tracking",
          "subtasks": [
            {"number": "1.5.1.1", "name": "Track regions across module boundaries"},
            {"number": "1.5.1.2", "name": "Verify cross-module reference usage"}
          ],
          "specificationReference": {"section": "12"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "struct CrossModuleLifetimeEnv { module_envs: MapModuleNameLifetimeEnv, global_regions: SetRegionId }",
            "description": "Use module-scoped lifetime environments"
          },
          "module": "plan:Module1_3"
        },
        {
          "@id": "plan:Task1_5_2",
          "taskNumber": "1.5.2",
          "name": "Implement Module Boundary Safety Checks",
          "subtasks": [
            {"number": "1.5.2.1", "name": "Verify exported functions don't leak regions"},
            {"number": "1.5.2.2", "name": "Verify imported functions respect region lifetimes"}
          ],
          "specificationReference": {"section": "12"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "trait RegionSafe { fn verify_region_safety(self: Self) -> bool proc[mem(normal)]; }",
            "description": "Use trait-based validation"
          },
          "module": "plan:Module1_3"
        }
      ]
    },
    {
      "@id": "plan:Phase2",
      "@type": "CompilerPhase",
      "rdfs:label": "Phase 2: Pattern Matching Exhaustiveness Enhancement",
      "phaseNumber": 2,
      "priority": "critical",
      "gapId": "GAP-002",
      "severity": "critical",
      "description": "Enhance pattern matching with guard exhaustiveness checking and AArch64 optimizations",
      "specificationReferences": [
        {"section": "3.6", "title": "Pattern Matching Semantics"},
        {"section": "27.5.3", "title": "Backend Phases"}
      ],
      "dependencies": ["Parsing Phase"],
      "blocks": [],
      "subPhases": [
        {"@id": "plan:Phase2_1", "number": "2.1", "name": "Guard Exhaustiveness Checking"},
        {"@id": "plan:Phase2_2", "number": "2.2", "name": "Pattern Compilation Strategy Selection"},
        {"@id": "plan:Phase2_3", "number": "2.3", "name": "AArch64 Pattern Optimization"}
      ],
      "implementsComponent": "plan:Component2"
    },
    {
      "@id": "plan:Phase2_1",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 2.1: Guard Exhaustiveness Checking",
      "parentPhase": "plan:Phase2",
      "component": "plan:Component2",
      "tasks": [
        {
          "@id": "plan:Task2_1_1",
          "taskNumber": "2.1.1",
          "name": "Implement Guard Coverage Computation",
          "subtasks": [
            {"number": "2.1.1.1", "name": "Define guard coverage set computation"},
            {"number": "2.1.1.2", "name": "Implement guard exhaustiveness checking algorithm"},
            {"number": "2.1.1.3", "name": "Handle conservative coverage for function calls"}
          ],
          "specificationReference": {"section": "3.6"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "fn compute_guard_coverage(pattern: Pattern, guard: OptionExpression, type_: Type) -> CoverageSet proc[mem(normal)]",
            "description": "Use recursive pattern matching"
          },
          "module": "plan:Module2_1"
        },
        {
          "@id": "plan:Task2_1_2",
          "taskNumber": "2.1.2",
          "name": "Implement Pattern-Guard Exhaustiveness",
          "subtasks": [
            {"number": "2.1.2.1", "name": "Check pattern exhaustiveness"},
            {"number": "2.1.2.2", "name": "Check guard exhaustiveness for each pattern"},
            {"number": "2.1.2.3", "name": "Verify catch-all patterns when guards incomplete"}
          ],
          "specificationReference": {"section": "3.6"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "fn check_exhaustiveness(patterns: ListPattern, matched_type: Type) -> ResultUnitExhaustivenessError proc[mem(normal)]",
            "description": "Use case expressions for exhaustiveness checking"
          },
          "module": "plan:Module2_1"
        }
      ]
    },
    {
      "@id": "plan:Phase2_2",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 2.2: Pattern Compilation Strategy Selection",
      "parentPhase": "plan:Phase2",
      "component": "plan:Component2",
      "tasks": [
        {
          "@id": "plan:Task2_2_1",
          "taskNumber": "2.2.1",
          "name": "Implement Decision Tree Generation",
          "subtasks": [
            {"number": "2.2.1.1", "name": "Build decision tree from patterns"},
            {"number": "2.2.1.2", "name": "Optimize decision tree structure"},
            {"number": "2.2.1.3", "name": "Generate code from decision tree"}
          ],
          "specificationReference": {"section": "3.6"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "enum DecisionTree { Leaf { result: Expression }, Branch { condition: Expression, true_branch: DecisionTree, false_branch: DecisionTree } }",
            "description": "Use recursive data structures"
          },
          "module": "plan:Module2_2"
        },
        {
          "@id": "plan:Task2_2_2",
          "taskNumber": "2.2.2",
          "name": "Implement Jump Table Generation",
          "subtasks": [
            {"number": "2.2.2.1", "name": "Detect dense integer/enum patterns"},
            {"number": "2.2.2.2", "name": "Generate jump table for dense patterns"},
            {"number": "2.2.2.3", "name": "Use PC-relative addressing for AArch64"}
          ],
          "specificationReference": {"section": "3.6", "section": "27.5.3"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "fn generate_jump_table(patterns: ListPattern, matched_type: Type) -> JumpTable proc[mem(normal)]",
            "description": "Use AArch64-specific code generation"
          },
          "module": "plan:Module2_2"
        }
      ]
    },
    {
      "@id": "plan:Phase2_3",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 2.3: AArch64 Pattern Optimization",
      "parentPhase": "plan:Phase2",
      "component": "plan:Component2",
      "tasks": [
        {
          "@id": "plan:Task2_3_1",
          "taskNumber": "2.3.1",
          "name": "Implement Conditional Select Optimization",
          "subtasks": [
            {"number": "2.3.1.1", "name": "Detect simple two-way pattern matches"},
            {"number": "2.3.1.2", "name": "Generate CSEL instructions"},
            {"number": "2.3.1.3", "name": "Eliminate branch misprediction penalties"}
          ],
          "specificationReference": {"section": "27.5.3"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "fn generate_csel_pattern(condition: Expression, true_value: Expression, false_value: Expression) -> AArch64Instruction proc[mem(normal)]",
            "description": "Use AArch64 instruction patterns"
          },
          "module": "plan:Module2_2"
        },
        {
          "@id": "plan:Task2_3_2",
          "taskNumber": "2.3.2",
          "name": "Implement Pattern-Guard Fusion",
          "subtasks": [
            {"number": "2.3.2.1", "name": "Detect patterns with simple guards"},
            {"number": "2.3.2.2", "name": "Fuse pattern matching and guard evaluation"},
            {"number": "2.3.2.3", "name": "Generate single conditional instruction sequence"}
          ],
          "specificationReference": {"section": "27.5.3"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "fn fuse_pattern_guard(pattern: Pattern, guard: Expression) -> FusedPattern proc[mem(normal)]",
            "description": "Combine pattern and guard analysis"
          },
          "module": "plan:Module2_2"
        }
      ]
    },
    {
      "@id": "plan:Phase3",
      "@type": "CompilerPhase",
      "rdfs:label": "Phase 3: Hardware Capability Validation",
      "phaseNumber": 3,
      "priority": "critical",
      "gapId": "GAP-003",
      "severity": "critical",
      "description": "Detect and validate AArch64 hardware capabilities during type checking",
      "specificationReferences": [
        {"section": "27.5.1", "title": "Frontend Phases"},
        {"section": "1.4", "title": "Target Platform"},
        {"section": "27.6.1", "title": "Hardware-Aware Build Configuration"}
      ],
      "dependencies": ["Type Checking Phase"],
      "blocks": ["Vectorization Phase", "Optimizations"],
      "subPhases": [
        {"@id": "plan:Phase3_1", "number": "3.1", "name": "Hardware Feature Detection"},
        {"@id": "plan:Phase3_2", "number": "3.2", "name": "Capability Validation During Type Checking"}
      ],
      "implementsComponent": "plan:Component3"
    },
    {
      "@id": "plan:Phase3_1",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 3.1: Hardware Feature Detection",
      "parentPhase": "plan:Phase3",
      "component": "plan:Component3",
      "tasks": [
        {
          "@id": "plan:Task3_1_1",
          "taskNumber": "3.1.1",
          "name": "Implement CPU Feature Detection",
          "subtasks": [
            {"number": "3.1.1.1", "name": "Detect SVE/SVE2 support"},
            {"number": "3.1.1.2", "name": "Detect NEON support"},
            {"number": "3.1.1.3", "name": "Detect MTE support"},
            {"number": "3.1.1.4", "name": "Detect PAC support"}
          ],
          "specificationReference": {"section": "1.4", "section": "27.6.1"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "struct HardwareCapabilities { sve: bool, sve2: bool, neon: bool, mte: bool, pac: bool }",
            "description": "Use AArch64 system registers"
          },
          "module": "plan:Module3_1"
        },
        {
          "@id": "plan:Task3_1_2",
          "taskNumber": "3.1.2",
          "name": "Implement Cache Hierarchy Discovery",
          "subtasks": [
            {"number": "3.1.2.1", "name": "Detect cache levels and sizes"},
            {"number": "3.1.2.2", "name": "Detect NUMA topology"},
            {"number": "3.1.2.3", "name": "Map cache hierarchy structure"}
          ],
          "specificationReference": {"section": "27.6.1"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "struct CacheHierarchy { levels: ListCacheLevel, numa_nodes: ListNUMANode }",
            "description": "Use system information structures"
          },
          "module": "plan:Module3_1"
        }
      ]
    },
    {
      "@id": "plan:Phase3_2",
      "@type": "SubPhase",
      "rdfs:label": "Sub-phase 3.2: Capability Validation During Type Checking",
      "parentPhase": "plan:Phase3",
      "component": "plan:Component3",
      "tasks": [
        {
          "@id": "plan:Task3_2_1",
          "taskNumber": "3.2.1",
          "name": "Integrate Capability Checking into Type Checker",
          "subtasks": [
            {"number": "3.2.1.1", "name": "Add capability context to type checker"},
            {"number": "3.2.1.2", "name": "Validate vector types against capabilities"},
            {"number": "3.2.1.3", "name": "Validate atomic operations against capabilities"}
          ],
          "specificationReference": {"section": "27.5.1"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "struct TypeCheckerContext { type_env: TypeEnv, capabilities: HardwareCapabilities, constraints: ListConstraint }",
            "description": "Extend type checker context"
          },
          "module": "plan:Module3_2"
        },
        {
          "@id": "plan:Task3_2_2",
          "taskNumber": "3.2.2",
          "name": "Implement Capability Error Reporting",
          "subtasks": [
            {"number": "3.2.2.1", "name": "Generate capability mismatch errors"},
            {"number": "3.2.2.2", "name": "Suggest alternative implementations"},
            {"number": "3.2.2.3", "name": "Provide fallback options"}
          ],
          "specificationReference": {"section": "1.6"},
          "silicaPattern": {
            "patternType": "code_structure",
            "pattern": "enum CapabilityError { UnsupportedFeature { feature: string, required: HardwareCapabilities }, MissingCapability { feature: string, available: HardwareCapabilities } }",
            "description": "Use structured error types"
          },
          "module": "plan:Module3_2"
        }
      ]
