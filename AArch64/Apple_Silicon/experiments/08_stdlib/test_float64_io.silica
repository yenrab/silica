// Test float64 I/O operations
// Tests float64 values in I/O contexts

fn test_float64_io() -> int64 proc[DeviceIO] {
    do
        print("Testing float64 I/O operations");
        println("");
        
        // Test various float64 values
        val1: float64 <- 3.141592653589793;
        val2: float64 <- 2.718281828459045;
        val3: float64 <- -1.4142135623730951;
        val4: float64 <- 0.0;
        val5: float64 <- 1.7976931348623157e308;  // approximate max float64
        
        print("float64 value 1 (pi): ");
        print_float64(val1);
        println("");
        
        print("float64 value 2 (e): ");
        print_float64(val2);
        println("");
        
        print("float64 value 3 (sqrt(2)): ");
        print_float64(val3);
        println("");
        
        print("float64 value 4 (zero): ");
        print_float64(val4);
        println("");
        
        print("float64 value 5 (max): ");
        print_float64(val5);
        println("");
        
        0
    end
}

fn main() -> int64 proc[DeviceIO] {
    result: int64 <- test_float64_io();
    result
}
