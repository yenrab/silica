// Reproduction test for bootstrap compiler string case matching bug.
// Bug: In case op of { "!=" -> ...; "==" -> ... }, whichever appears first matches BOTH operators.
// With "!=" before "==", both "==" and "!=" incorrectly match "!=" and return "nq".
// Expected: "==" -> "eq", "!=" -> "nq"
// If bug present: both return "nq"

fn op_to_prim(op: string) -> string {
    case op of {
        "!=" -> "nq";
        "==" -> "eq";
        "<" -> "lt";
        ">" -> "gt";
        "<=" -> "le";
        ">=" -> "ge";
        _: string -> ""
    }
}

fn main() -> int64 proc[DeviceIO] {
    do
        println("=== String case eq/ne bug reproduction ===");

        // Test "==" - should return "eq" (if bug: returns "nq")
        result_eq: string <- op_to_prim("==");
        println("op_to_prim(==) result: ");
        print(result_eq);
        println("");
        eq_ok: boolean <- result_eq == "eq";
        print_int64(case eq_ok of { true -> 1; false -> 0 });
        println("  ; 1=pass (eq), 0=bug (got nq)");

        // Test "!=" - should return "nq"
        result_ne: string <- op_to_prim("!=");
        println("op_to_prim(!=) result: ");
        print(result_ne);
        println("");
        ne_ok: boolean <- result_ne == "nq";
        print_int64(case ne_ok of { true -> 1; false -> 0 });
        println("  ; 1=pass (nq), 0=bug");

        // Both must pass for test to succeed
        both_ok: boolean <- eq_ok and ne_ok;
        print_int64(case both_ok of { true -> 0; false -> 1 });
        println("  ; exit: 0=all pass, 1=bug present");
        case both_ok of {
            true -> 0;
            false -> 1
        }
    end
}
