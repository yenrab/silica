// Test State Pattern with Traits
// Demonstrates behavioral state patterns using trait polymorphism

trait ConnectionState {
    fn connect(self: Self) -> int64;
    fn send_data(self: Self, data: int64) -> int64;
    fn disconnect(self: Self) -> int64;
    fn get_state_name(self: Self) -> int64;
}

// Concrete states
struct Disconnected {
    retry_count: int64
}

struct Connecting {
    timeout: int64
}

struct Connected {
    session_id: int64
}

struct ErrorState {
    error_code: int64
}

impl ConnectionState for Disconnected {
    fn connect(self: Disconnected) -> int64 {
        // Transition to connecting state
        1  // Connecting state code
    }

    fn send_data(self: Disconnected, data: int64) -> int64 {
        // Can't send when disconnected
        -1  // Error: not connected
    }

    fn disconnect(self: Disconnected) -> int64 {
        // Already disconnected
        0  // No-op
    }

    fn get_state_name(self: Disconnected) -> int64 {
        100  // "Disconnected" code
    }
}

impl ConnectionState for Connecting {
    fn connect(self: Connecting) -> int64 {
        // Already connecting, complete connection
        2  // Connected state code
    }

    fn send_data(self: Connecting, data: int64) -> int64 {
        // Queue data for when connection completes
        data + 10  // Queued data marker
    }

    fn disconnect(self: Connecting) -> int64 {
        // Cancel connection attempt
        0  // Disconnected state code
    }

    fn get_state_name(self: Connecting) -> int64 {
        200  // "Connecting" code
    }
}

impl ConnectionState for Connected {
    fn connect(self: Connected) -> int64 {
        // Already connected
        2  // Stay connected
    }

    fn send_data(self: Connected, data: int64) -> int64 {
        // Send data successfully
        data * 2  // Successful send marker
    }

    fn disconnect(self: Connected) -> int64 {
        // Disconnect gracefully
        0  // Disconnected state code
    }

    fn get_state_name(self: Connected) -> int64 {
        300  // "Connected" code
    }
}

impl ConnectionState for ErrorState {
    fn connect(self: ErrorState) -> int64 {
        // Try to recover from error
        case self.error_code < 10 of {
            true -> 1;   // Try connecting again
            false -> -2; // Fatal error, can't recover
        }
    }

    fn send_data(self: ErrorState, data: int64) -> int64 {
        // Can't send in error state
        self.error_code * -1  // Error response
    }

    fn disconnect(self: ErrorState) -> int64 {
        // Force disconnect from error state
        0  // Disconnected
    }

    fn get_state_name(self: ErrorState) -> int64 {
        400 + self.error_code  // "Error: {code}" code
    }
}

// Connection manager that uses state pattern
struct ConnectionManager {
    current_state: int64  // Simplified state representation
}

impl ConnectionState for ConnectionManager {
    fn connect(self: ConnectionManager) -> int64 {
        // Manager-level connection logic
        self.current_state + 1
    }

    fn send_data(self: ConnectionManager, data: int64) -> int64 {
        // Manager-level send logic
        self.current_state + data
    }

    fn disconnect(self: ConnectionManager) -> int64 {
        // Manager-level disconnect logic
        0
    }

    fn get_state_name(self: ConnectionManager) -> int64 {
        self.current_state + 1000  // Manager state offset
    }
}

fn simulate_connection_lifecycle() -> int64 {
    do
        // Start disconnected
        disconnected:Disconnected <- Disconnected { retry_count: 0 };
        start_state:int64 <- disconnected.get_state_name();  // 100

        // Try to connect
        connect_result:int64 <- disconnected.connect();  // 1 (Connecting)

        // Create connecting state
        connecting:Connecting <- Connecting { timeout: 5000 };
        connecting_state:int64 <- connecting.get_state_name();  // 200

        // Try to send data while connecting
        send_while_connecting:int64 <- connecting.send_data(42);  // 42 + 10 = 52

        // Complete connection
        connected:Connected <- Connected { session_id: 12345 };
        connected_state:int64 <- connected.get_state_name();  // 300

        // Send data when connected
        send_when_connected:int64 <- connected.send_data(25);  // 25 * 2 = 50

        // Create error state
        error_state:ErrorState <- ErrorState { error_code: 5 };
        error_state_name:int64 <- error_state.get_state_name();  // 400 + 5 = 405

        // Try to recover from error
        error_recovery:int64 <- error_state.connect();  // 1 (try connecting)

        // Results combination
        start_state + connect_result + connecting_state + send_while_connecting +
        connected_state + send_when_connected + error_state_name + error_recovery
    end
}

fn main() -> int64 {
    simulate_connection_lifecycle()
}

// Expected result: 100 + 1 + 200 + 52 + 300 + 50 + 405 + 1 = 1109