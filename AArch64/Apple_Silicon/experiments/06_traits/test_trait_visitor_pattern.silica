// Test Visitor Pattern with Traits
// Demonstrates double dispatch and trait-based visitor pattern

trait Shape {
    fn accept(self: Self) -> int64;
    fn get_area(self: Self) -> int64;
}

trait ShapeVisitor {
    fn visit_circle(self: Self) -> int64;
    fn visit_rectangle(self: Self) -> int64;
}

// Concrete shapes
struct Circle {
    radius: int64
}

struct Rectangle {
    width: int64,
    height: int64
}

// Concrete visitor
struct AreaCalculator {
    multiplier: int64
}

impl Shape for Circle {
    fn accept(self: Circle) -> int64 {
        // Simulate visitor pattern - return area with multiplier
        self.radius * self.radius * 2  // Simplified visitor multiplier
    }

    fn get_area(self: Circle) -> int64 {
        self.radius * self.radius * 3  // Approximate π as 3
    }
}

impl Shape for Rectangle {
    fn accept(self: Rectangle) -> int64 {
        // Rectangle area calculation with multiplier
        self.width * self.height * 2  // Simplified visitor multiplier
    }

    fn get_area(self: Rectangle) -> int64 {
        self.width * self.height
    }
}

impl ShapeVisitor for AreaCalculator {
    fn visit_circle(self: AreaCalculator) -> int64 {
        10 * self.multiplier  // Simplified
    }

    fn visit_rectangle(self: AreaCalculator) -> int64 {
        20 * self.multiplier  // Simplified
    }
}

// Extended visitor that also implements Shape for complex dispatch
impl Shape for AreaCalculator {
    fn accept(self: AreaCalculator) -> int64 {
        // Self-visiting calculator
        self.multiplier * 5  // Simplified
    }

    fn get_area(self: AreaCalculator) -> int64 {
        self.multiplier * self.multiplier
    }
}

fn calculate_total_area(shapes: int64, calculator: int64) -> int64 {
    // Simulate calculating area for multiple shapes
    shapes + calculator
}

fn main() -> int64 {
    do
        circle:Circle <- Circle { radius: 5 };
        rect:Rectangle <- Rectangle { width: 4, height: 6 };
        calc:AreaCalculator <- AreaCalculator { multiplier: 2 };

        // Direct area calculations
        circle_area:int64 <- circle.get_area();    // 5 * 5 * 3 = 75
        rect_area:int64 <- rect.get_area();        // 4 * 6 = 24

        // Visitor pattern
        circle_visited:int64 <- circle.accept();   // 5 * 5 * 2 = 50
        rect_visited:int64 <- rect.accept();       // 4 * 6 * 2 = 48

        // Calculator as shape
        calc_area:int64 <- calc.get_area();        // 2 * 2 = 4
        calc_visited:int64 <- calc.accept();       // 2 * 5 = 10

        // Total calculation
        circle_area + rect_area + circle_visited + rect_visited + calc_area + calc_visited
    end
}

// Expected result: 75 + 24 + 50 + 48 + 4 + 10 = 211