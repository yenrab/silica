// Test basic sub-trait functionality
// Demonstrates how traits can include other traits as sub-traits

trait Printable {
    fn to_string(self: Self) -> int64;
}

trait Debug includes Printable {
    fn debug_info(self: Self) -> int64;
}

// Point type that implements both traits
type Point = {x: int64, y: int64};

impl Printable for Point {
    fn to_string(self: Point) -> int64 {
        self.x + self.y  // Simple representation
    }
}

impl Debug for Point {
    fn debug_info(self: Point) -> int64 {
        self.x * self.y  // Different computation for debug
    }
}

fn main() -> int64 {
    do
        p:Point <- Point { x: 3, y: 7 };

        // Can call both methods
        printable_result:int64 <- p.to_string();    // Should be 10 (3 + 7)
        debug_result:int64 <- p.debug_info();       // Should be 21 (3 * 7)

        // Return sum of both results
        printable_result + debug_result
    end
}

// Expected result: 10 + 21 = 31