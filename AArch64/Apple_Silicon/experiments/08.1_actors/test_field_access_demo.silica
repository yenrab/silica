// Demo of generic field access in function literals
// This tests that field access works for any struct, not just hardcoded ones

type TestStruct = { value: int64, flag: bool, name: string };

// Implement ActorState trait for type used as actor initial state
impl ActorState for TestStruct { }

fn main() -> int64 proc[concurrency] {
    // Test field access in function literals
    spawn(TestStruct { value: 42, flag: true, name: "test" }, fn(msg: int64, state: TestStruct) -> int64 {
        // This should now work with the generic field access implementation
        state.value + msg  // Access the 'value' field
    });

    0
}
