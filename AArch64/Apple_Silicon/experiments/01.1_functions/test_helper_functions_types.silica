// Test helper functions with various types

// Helper functions with primitive types
fn helper_int_math(a: int64, b: int64) -> int64 {
    a + b * 2
}

fn helper_bool_logic(x: boolean, y: boolean) -> boolean {
    (x and y) or (not x and not y)
}

fn helper_char_compare(c1: char, c2: char) -> boolean {
    c1 < c2
}

// Helper functions with complex types
fn helper_string_concat(s1: string, s2: string) -> string {
    s1  // Simplified for now
}

fn helper_tuple_transform(t: (int64, boolean)) -> (boolean, int64) {
    (x: int64, b: boolean) <- t;
    (b, x * 2)
}

// Helper functions calling other helper functions
fn helper_nested_calls(n: int64) -> boolean {
    result: int64 <- helper_int_math(n, 10);
    comparison: boolean <- helper_char_compare('a', 'b');
    result > 50 and comparison
}

// Main functions that use helpers
fn test_primitive_helpers() -> int64 proc[DeviceIO] {
    int_result: int64 <- helper_int_math(5, 3);
    print_int64(int_result);  // Should print 11

    bool_result: boolean <- helper_bool_logic(true, false);
    print_bool(bool_result);  // Should print false

    char_result: boolean <- helper_char_compare('x', 'y');
    print_bool(char_result);  // Should print true
    0
}

fn test_complex_helpers() -> int64 proc[DeviceIO] {
    tuple_input:(int64, boolean) <- (42, true);
    (b: boolean, x: int64) <- helper_tuple_transform(tuple_input);
    print_bool(b);  // Should print true
    print_int64(x);   // Should print 84
    0
}

fn test_nested_helpers() -> int64 proc[DeviceIO] {
    nested_result: boolean <- helper_nested_calls(30);
    print_bool(nested_result);  // Should print false (30+10=40, 40>50 is false)

    nested_result2: boolean <- helper_nested_calls(60);
    print_bool(nested_result2);  // Should print true (60+10=70, 70>50 is true)
    0
}

// Main function
fn main() -> int64 {
    test_primitive_helpers();
    test_complex_helpers();
    test_nested_helpers();
    0
}
