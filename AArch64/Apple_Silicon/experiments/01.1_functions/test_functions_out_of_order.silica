-- Test that functions can be called and exported out of order of their declaration

export return_int/0;
export take_int/1;

fn main() -> int64 {
    take_int(123);
    i: int64 <- return_int();
    take_int(i);
    0
}


fn return_int() -> int64 {
    42
}


fn take_int(x: int64) -> int64 proc[DeviceIO]{
    print_int64(x);
    x
}

