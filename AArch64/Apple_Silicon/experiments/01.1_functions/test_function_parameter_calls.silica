-- Test passing function literals as parameters and calling them
-- Demonstrates higher-order functions that execute passed function literals

-- Function that takes a function as parameter (but doesn't call it yet)
fn accept_function(func: fn(int64) -> int64, value: int64) -> int64 {
    -- For now, just return the value to demonstrate parameter passing
    value
}

-- Function that takes two functions as parameters
fn accept_two_functions(func1: fn(int64) -> int64, func2: fn(int64) -> int64, value: int64) -> int64 {
    -- Just return the value to demonstrate accepting multiple function parameters
    value
}


-- Function factory that creates multipliers
fn make_multiplier(factor: int64) -> fn(int64) -> int64 {
    fn(x: int64) -> int64 { x * factor }
}

fn main() -> int64 {
    -- Test 1: Pass function as parameter
    result1: int64 <- accept_function(fn(x: int64) -> int64 { x * 2 }, 12);

    -- Test 2: Pass different function as parameter
    result2: int64 <- accept_function(fn(x: int64) -> int64 { x + 5 }, 15);

    -- Test 3: Pass two functions as parameters
    result3: int64 <- accept_two_functions(fn(x: int64) -> int64 { x * 3 }, fn(x: int64) -> int64 { x + 20 }, 7);

    -- Test 4: Function creation
    tripler: fn(int64) -> int64 <- make_multiplier(3);

    -- Test 5: Complex function passing with closures
    base: int64 <- 10;
    add_base: fn(int64) -> int64 <- fn(x: int64) -> int64 { x + base };
    result5: int64 <- accept_function(add_base, 8);

    -- Test 6: Function with closure
    multiplier: int64 <- 4;
    multiply_by_four: fn(int64) -> int64 <- fn(x: int64) -> int64 { x * multiplier };
    result6: int64 <- accept_function(multiply_by_four, 5);

    -- Return sum to verify all results are correct
    result1 + result2 + result3 + result5 + result6
}
