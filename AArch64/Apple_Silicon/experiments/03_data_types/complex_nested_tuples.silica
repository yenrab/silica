// Test nested tuples with non-numeric values
// Tests tuple nesting: tuples containing other tuples

fn test_nested_tuples() -> int64 {
    do
        // Create tuple containing other tuples
        nested_tuple:((boolean,boolean),(boolean,boolean)) <- (
            (true, false),
            (true, true)
        );

        // Extract the nested tuples
        (inner1: (boolean, boolean), inner2: (boolean, boolean)) <- nested_tuple;
        
        // Just return 42 to verify compilation works
        42
    end
}

fn main() -> int64 {
    test_nested_tuples()
}
