// Advanced Memory Management Tests
// Tests complex memory scenarios and edge cases

// Test complex types in references
type Point = {x: int64, y: int64};
type Person = {name: string, age: int64, active: bool};

fn test_complex_tuple_reference() -> int64 {
    do
        // Test tuple with records
        point1: Point <- Point {x: 10, y: 20};
        point2: Point <- Point {x: 30, y: 40};
        record_tuple: (Point, Point) <- (point1, point2);
        record_tuple_ref:ref(normal, (Point, Point)) <- region(record_tuple);
        read_record_tuple:(Point, Point) <- read_ref(record_tuple_ref);

        // Test tuple with custom types
        person: Person <- Person {name: "Alice", age: 30, active: true};
        complex_tuple: (Person, int64, bool) <- (person, 42, false);
        complex_tuple_ref:ref(normal, (Person, int64, bool)) <- region(complex_tuple);
        read_complex_tuple:(Person, int64, bool) <- read_ref(complex_tuple_ref);

        // Test empty tuple (unit)
        unit_tuple: () <- ();
        unit_tuple_ref:ref(normal, ()) <- region(unit_tuple);
        read_unit_tuple:() <- read_ref(unit_tuple_ref);

        // Test large tuple
        large_tuple: (int64, int64, int64, int64, int64) <- (1, 2, 3, 4, 5);
        large_tuple_ref:ref(normal, (int64, int64, int64, int64, int64)) <- region(large_tuple);
        read_large_tuple:(int64, int64, int64, int64, int64) <- read_ref(large_tuple_ref);

        // Return success
        66
    end
}

fn test_nested_regions() -> int64 {
    do
        // Allocate with simplified region syntax
        outer_ref:ref(normal, int64) <- region(100);

        // Test basic operations
        outer_val:int64 <- read_ref(outer_ref);

        // Return the value
        outer_val
    end
}

fn test_memory_lifecycle() -> int64 {
    do
        // Test that memory is properly managed with explicit types
        ref1:ref(normal, int64) <- region(42);
        ref2:ref(normal, int64) <- region(24);

        val1:int64 <- read_ref(ref1);
        val2:int64 <- read_ref(ref2);

        // Test arithmetic with memory values
        result:int64 <- val1 + val2;

        result
    end
}

fn test_reference_operations() -> int64 {
    do
        // Test reference creation and reading (immutable)
        counter:ref(normal, int64) <- region(30);

        // Read the immutable value
        val:int64 <- read_ref(counter);

        // Return the value
        val
    end
}

fn test_tuple_reference() -> int64 {
    do
        // Test writing and reading tuples to/from references

        // Test tuple of two integers (store and read back)
        int_tuple: (int64, int64) <- (42, 24);
        int_tuple_ref:ref(normal, (int64, int64)) <- region(int_tuple);
        read_back_tuple:(int64, int64) <- read_ref(int_tuple_ref);

        // Test tuple of mixed types
        mixed_tuple: (int64, string) <- (123, "hello");
        mixed_tuple_ref:ref(normal, (int64, string)) <- region(mixed_tuple);
        read_mixed_tuple:(int64, string) <- read_ref(mixed_tuple_ref);

        // Test tuple of three elements
        triple_tuple: (int64, int64, int64) <- (1, 2, 3);
        triple_tuple_ref:ref(normal, (int64, int64, int64)) <- region(triple_tuple);
        read_triple_tuple:(int64, int64, int64) <- read_ref(triple_tuple_ref);

        // Test tuple of booleans
        bool_tuple: (bool, bool) <- (true, false);
        bool_tuple_ref:ref(normal, (bool, bool)) <- region(bool_tuple);
        read_bool_tuple:(bool, bool) <- read_ref(bool_tuple_ref);

        // Test nested tuple
        nested_tuple: ((int64, int64), string) <- ((10, 20), "nested");
        nested_tuple_ref:ref(normal, ((int64, int64), string)) <- region(nested_tuple);
        read_nested_tuple:((int64, int64), string) <- read_ref(nested_tuple_ref);

        // Return the expected sum
        66  // 42 + 24
    end
}

fn test_tuple_with_references() -> int64 {
    do
        // Create individual references with simplified syntax
        ref1:ref(normal, int64) <- region(100);
        ref2:ref(normal, int64) <- region(200);
        ref3:ref(normal, string) <- region("hello");

        // Test that references can be created and used
        // (Full tuple-with-references test requires more complex memory layout support)
        val1:int64 <- read_ref(ref1);
        val2:int64 <- read_ref(ref2);
        str_val:string <- read_ref(ref3);

        // Return sum of values (demonstrates reference functionality)
        val1 + val2  // 100 + 200 = 300
    end
}

fn main() -> int64 {
    do
        // Test each function and combine results
        nested_result:int64 <- test_nested_regions();
        lifecycle_result:int64 <- test_memory_lifecycle();
        ref_result:int64 <- test_reference_operations();
        tuple_result:int64 <- test_tuple_reference();
        complex_result:int64 <- test_complex_tuple_reference();
        ref_in_tuple_result:int64 <- test_tuple_with_references();

        // Return combination to verify all tests passed
        nested_result + lifecycle_result + ref_result + tuple_result + complex_result + ref_in_tuple_result
    end
}
