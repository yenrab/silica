// Test case matching on tuples containing both non-struct (primitive) and struct elements.
// Covers: (int64, Point), (Point, int64). Patterns use literals for primitives and
// typed bindings for struct elements; record patterns (Point { x: 0, y: 0 }) are not used.

struct Point {
    x: int64,
    y: int64
}

// --- (int64, Point): int then struct ---
fn match_int_point(t: (int64, Point)) -> int64 {
    case t of {
        (0, pt0: Point) -> 1;
        (1, pt1: Point) -> 2;
        (2, pt2: Point) -> 3;
        _: (int64, Point) -> 0
    }
}

// --- (Point, int64): struct then int ---
fn match_point_int(t: (Point, int64)) -> int64 {
    case t of {
        (pt0: Point, 0) -> 1;
        (pt1: Point, 1) -> 2;
        (pt2: Point, 2) -> 3;
        _: (Point, int64) -> 0
    }
}

// --- (int64, Point, int64): int, struct, int ---
fn match_int_point_int(t: (int64, Point, int64)) -> int64 {
    case t of {
        (0, pt0: Point, 0) -> 1;
        (1, pt1: Point, 1) -> 2;
        _: (int64, Point, int64) -> 0
    }
}

fn main() -> int64 proc[DeviceIO] {
    // (int64, Point)
    print_int64(match_int_point((0, Point { x: 10, y: 20 })));
    println("");
    print_int64(match_int_point((1, Point { x: 0, y: 0 })));
    println("");
    print_int64(match_int_point((2, Point { x: 1, y: 2 })));
    println("");
    print_int64(match_int_point((3, Point { x: 5, y: 5 })));
    println("");

    // (Point, int64)
    print_int64(match_point_int((Point { x: 0, y: 0 }, 0)));
    println("");
    print_int64(match_point_int((Point { x: 1, y: 1 }, 1)));
    println("");
    print_int64(match_point_int((Point { x: 2, y: 2 }, 2)));
    println("");
    print_int64(match_point_int((Point { x: 3, y: 3 }, 9)));
    println("");

    // (int64, Point, int64)
    print_int64(match_int_point_int((0, Point { x: 0, y: 0 }, 0)));
    println("");
    print_int64(match_int_point_int((1, Point { x: 1, y: 1 }, 1)));
    println("");
    print_int64(match_int_point_int((2, Point { x: 2, y: 2 }, 2)));
    println("");

    0
}
