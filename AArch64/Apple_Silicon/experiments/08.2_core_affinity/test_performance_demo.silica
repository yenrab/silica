// Performance Demonstration Test
// Shows practical usage patterns for core affinity in real applications

// Application state types
type UIState = { clicks: int64, renders: int64 };
type BackgroundState = { tasks: int64, completed: int64 };
type StreamState = { processed: int64, errors: int64 };
type NetworkState = { connections: int64, bytes: int64 };
type StorageState = { reads: int64, writes: int64 };
type LoadBalancerState = { requests: int64, workers: int64 };
type WorkerState = { id: int64, tasks: int64 };
type MonitorState = { metrics: int64, alerts: int64 };

// Implement ActorState trait for all state types
impl ActorState for UIState { }
impl ActorState for BackgroundState { }
impl ActorState for StreamState { }
impl ActorState for NetworkState { }
impl ActorState for StorageState { }
impl ActorState for LoadBalancerState { }
impl ActorState for WorkerState { }
impl ActorState for MonitorState { }

fn main() -> int64 proc[concurrency] {
    do
        // Simulate a real application with different actor roles

        // UI/Frontend actors - need responsiveness
        spawn(UIState { clicks: 0, renders: 0 }, fn(msg: int64, state: int64) -> int64 {
            // Handle user interactions - must be responsive
            state + msg
        }, performance_cores);

        // Background processing actors - power efficient
        spawn(BackgroundState { tasks: 0, completed: 0 }, fn(msg: int64, state: int64) -> int64 {
            // Process background tasks - efficiency matters
            state + msg
        }, efficiency_cores);

        // Real-time data processing - high performance needed
        spawn(StreamState { processed: 0, errors: 0 }, fn(msg: int64, state: int64) -> int64 {
            // Handle real-time data streams
            state + msg * 2
        }, performance_cores);

        // Network I/O coordinator - pin to specific core for cache efficiency
        spawn(NetworkState { connections: 0, bytes: 0 }, fn(msg: int64, state: int64) -> int64 {
            // Coordinate network operations
            state + msg
        }, 1);  // Pin to core 1 for network I/O

        // Storage I/O coordinator - pin to different core
        spawn(StorageState { reads: 0, writes: 0 }, fn(msg: int64, state: int64) -> int64 {
            // Coordinate storage operations
            state + msg
        }, 2);  // Pin to core 2 for storage I/O

        // Load balancer actors - can run anywhere
        spawn(LoadBalancerState { requests: 0, workers: 4 }, fn(msg: int64, state: int64) -> int64 {
            // Route requests to worker actors
            state + msg
        }, any_core);

        // Worker pool - distributed load balancing
        spawn(WorkerState { id: 1, tasks: 0 }, fn(msg: int64, state: int64) -> int64 {
            state + msg
        }, any_core);

        spawn(WorkerState { id: 2, tasks: 0 }, fn(msg: int64, state: int64) -> int64 {
            state + msg
        }, any_core);

        spawn(WorkerState { id: 3, tasks: 0 }, fn(msg: int64, state: int64) -> int64 {
            state + msg
        }, any_core);

        spawn(WorkerState { id: 4, tasks: 0 }, fn(msg: int64, state: int64) -> int64 {
            state + msg
        }, any_core);

        // Monitoring actors - low priority background
        spawn(MonitorState { metrics: 0, alerts: 0 }, fn(msg: int64, state: int64) -> int64 {
            // Collect system metrics
            state + 1
        }, efficiency_cores);

        0
    end
}
