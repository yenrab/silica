// Test complete tuple implementation

// Test tuple types
type Triple<T, U, V> = (T, U, V);

// Test tuple expressions and pattern matching
fn test_tuple_operations() -> int {
    // Create a tuple
    let tuple = (42, true);
    
    // Pattern match on tuple
    case tuple of {
        (x, true) -> x
        (y, false) -> y * 2
        _ -> 0
    }
}

fn main() -> int {
    test_tuple_operations()
}
