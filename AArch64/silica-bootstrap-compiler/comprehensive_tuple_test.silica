// Comprehensive tuple test with generics and pattern matching

// Generic tuple type alias
type Pair<T, U> = (T, U);
type Triple<A, B, C> = (A, B, C);

// Test tuple expressions and pattern matching
fn test_tuples() -> int {
    do
        // Create tuples
        pair <- (42, true);
        triple <- (1, 2, 3);
        
        // Pattern match on pairs
        result1 <- case pair of {
            (x, true) -> x;
            (y, false) -> y * 2;
            _ -> 0;
        };
        
        // Pattern match on triples  
        result2 <- case triple of {
            (a, b, c) -> a + b + c;
            _ -> 0;
        };
        
        result1 + result2
    end
}

fn main() -> int {
    test_tuples()
}
