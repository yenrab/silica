// Test tuple types and expressions (without case expressions)

// Generic tuple type aliases
type Pair<T, U> = (T, U);
type Triple<A, B, C> = (A, B, C);

// Test tuple expressions and type aliases
fn test_tuple_types() -> int {
    do
        // Create tuples
        pair <- (42, true);
        triple <- (1, 2, 3);
        
        // Test that types work
        pair2 <- (100, false);
        triple2 <- (10, 20, 30);
        
        // Return a simple value
        42
    end
}

fn main() -> int {
    test_tuple_types()
}
