// Tuple decomposition examples in Silica

fn make_point() -> (int, int) {
    (100, 200)
}

fn main() -> int {
    do
        // Decompose directly from function call
        (x, y) <- make_point();
        
        // Decompose from tuple literal
        (a, b, c) <- (1, 2, 3);
        
        // Calculate result
        x + y + a + b + c
    end
}
