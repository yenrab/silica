// Example of tuple decomposition in Silica

fn test_tuple_decomposition() -> int {
    do
        // Create a tuple
        person <- ("Alice", 30, true);
        
        // Decompose tuple in pattern matching
        result <- case person of {
            (name, age, is_student) -> {
                do
                    // Access decomposed elements
                    name_len <- 5;  // Simplified for demo
                    age_doubled <- age * 2;
                    
                    // Nested tuple decomposition
                    coords <- (10, 20);
                    (x, y) <- coords;
                    
                    x + y + age
                end
            }
            _ -> 0
        };
        
        result
    end
}

fn swap_pair(pair: (int, int)) -> (int, int) {
    case pair of {
        (a, b) -> (b, a)
        _ -> (0, 0)
    }
}

fn main() -> int {
    do
        // Test decomposition
        result1 <- test_tuple_decomposition();
        
        // Test swap function with decomposition
        original <- (42, 24);
        swapped <- swap_pair(original);
        
        // Decompose result
        (first, second) <- swapped;
        
        first + second
    end
}
