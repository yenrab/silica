// Test Phase 1.3: Advanced Type Features

// Type alias with generics
type Pair<T, U> = (T, U);

// Type operator (type-level function)
type Option<T> = T | Unit;

// Sum type
type Result<T, E> = T | E;

// Associated types in traits
trait Functor<F<_>> {
    type Item;
    
    fn map<A, B>(self: F<A>, f: fn(A) -> B) -> F<B>;
}

impl<T> Functor<Option<_>> for Option<T> {
    type Item = T;
    
    fn map<A, B>(self: Option<A>, f: fn(A) -> B) -> Option<B> {
        match self of {
            Some(x) -> Some(f(x))
            None -> None
        }
    }
}

fn test_advanced_types() -> int {
    // Test type aliases
    let p: Pair<int, bool> = (42, true);
    
    // Test sum types
    let opt: Option<int> = Some(42);
    
    42
}

fn main() -> int {
    test_advanced_types()
}
