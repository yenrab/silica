// Test tuple patterns in case expressions

fn test_tuple_case() -> int {
    do
        // Create a tuple
        data <- (42, true);
        
        // Use tuple in case expression
        case data of {
            (x, true) -> x
            (y, false) -> y * 2
            _ -> 0
        }
    end
}

fn main() -> int {
    test_tuple_case()
}
