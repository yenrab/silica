// Comprehensive tuple decomposition demo

fn make_coords() -> (int, int, int) {
    (100, 200, 300)
}

fn main() -> int {
    do
        // Simple pair decomposition
        (a, b) <- (10, 20);
        
        // Triple decomposition from function
        (x, y, z) <- make_coords();
        
        // Compute result directly to avoid variable scope issues
        x + y + z + a + b
    end
}
