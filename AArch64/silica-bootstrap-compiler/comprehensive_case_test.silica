// Comprehensive case expression test

fn test_comprehensive_case(x: int, flag: bool) -> int {
    case (x, flag) of {
        (0, true) -> 100
        (1, _) -> 200  
        (_, true) -> 300
        _ -> 400
    }
}

fn test_guarded_case(n: int) -> int {
    case n of {
        x -> { 
            do
                temp <- x * 2;
                temp
            end
        } if x > 10
        y -> y + 1
        _ -> 0
    }
}

fn main() -> int {
    do
        result1 <- test_comprehensive_case(1, false);  // Should return 200
        result2 <- test_guarded_case(15);             // Should return 30 (15*2)
        result1 + result2
    end
}
