// Silica Standard Library - Result Type
// Provides error handling with Result<T, E>

export Ok/1, Err/1, is_ok/1, is_err/1, unwrap/1, unwrap_err/1, unwrap_or/2, map/2, map_err/2, and_then/2;

trait ResultUnwrap<T, E> {
    fn unwrap(self) -> T;
    fn unwrap_err(self) -> E;
}

trait ResultMap<T, E, U> {
    fn map<F>(self, f: F) -> Result<U, E> where F: Fn(T) -> U;
}

trait ResultMapErr<T, E, F> {
    fn map_err<G>(self, g: G) -> Result<T, F> where G: Fn(E) -> F;
}

trait ResultAndThen<T, E, U> {
    fn and_then<F>(self, f: F) -> Result<U, E> where F: Fn(T) -> Result<U, E>;
}

// Result variant type definition
type Result<T, E> = Ok T | Err E;

// Constructor functions
fn Ok<T, E>(value: T) -> Result<T, E> {
    Result::Ok(value)
}

fn Err<T, E>(error: E) -> Result<T, E> {
    Result::Err(error)
}

// Utility functions
fn is_ok<T, E>(result: Result<T, E>) -> bool {
    case result of {
        Result::Ok(_) -> true;
        Result::Err(_) -> false
    }
}

fn is_err<T, E>(result: Result<T, E>) -> bool {
    case result of {
        Result::Ok(_) -> false;
        Result::Err(_) -> true
    }
}

fn unwrap<T, E>(result: Result<T, E>) -> T {
    case result of {
        Result::Ok(value) -> value;
        Result::Err(_) -> panic("Called unwrap on Err")
    }
}

fn unwrap_err<T, E>(result: Result<T, E>) -> E {
    case result of {
        Result::Ok(_) -> panic("Called unwrap_err on Ok");
        Result::Err(error) -> error
    }
}

fn unwrap_or<T, E>(result: Result<T, E>, default: T) -> T {
    case result of {
        Result::Ok(value) -> value;
        Result::Err(_) -> default
    }
}

fn map<T, E, U, F>(result: Result<T, E>, f: F) -> Result<U, E>
    where F: Fn(T) -> U
{
    case result of {
        Result::Ok(value) -> Ok(f(value));
        Result::Err(error) -> Err(error)
    }
}

fn map_err<T, E, F, G>(result: Result<T, E>, g: G) -> Result<T, F>
    where G: Fn(E) -> F
{
    case result of {
        Result::Ok(value) -> Ok(value);
        Result::Err(error) -> Err(g(error))
    }
}

fn and_then<T, E, U, F>(result: Result<T, E>, f: F) -> Result<U, E>
    where F: Fn(T) -> Result<U, E>
{
    case result of {
        Result::Ok(value) -> f(value);
        Result::Err(error) -> Err(error)
    }
}

// Implement ResultUnwrap trait for Result
impl<T, E> ResultUnwrap<T, E> for Result<T, E> {
    fn unwrap(self) -> T {
        unwrap(self)
    }

    fn unwrap_err(self) -> E {
        unwrap_err(self)
    }
}

// Implement ResultMap trait for Result
impl<T, E, U> ResultMap<T, E, U> for Result<T, E> {
    fn map<F>(self, f: F) -> Result<U, E> where F: Fn(T) -> U {
        map(self, f)
    }
}

// Implement ResultMapErr trait for Result
impl<T, E, F> ResultMapErr<T, E, F> for Result<T, E> {
    fn map_err<G>(self, g: G) -> Result<T, F> where G: Fn(E) -> F {
        map_err(self, g)
    }
}

// Implement ResultAndThen trait for Result
impl<T, E, U> ResultAndThen<T, E, U> for Result<T, E> {
    fn and_then<F>(self, f: F) -> Result<U, E> where F: Fn(T) -> Result<U, E> {
        and_then(self, f)
    }
}
