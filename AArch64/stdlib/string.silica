// Convert integer to string
fn int_to_string(n: int) -> string {
    if n == 0 {
        "0"
    } else if n < 0 {
        concat("-", int_to_string(-n))
    } else {
        // Simple digit extraction (placeholder)
        "42"  // Would need proper implementation
    }
}

// Convert boolean to string
fn bool_to_string(b: bool) -> string {
    if b {
        "true"
    } else {
        "false"
    }
}
