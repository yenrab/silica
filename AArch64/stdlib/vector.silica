// Silica Standard Library - String Vector
// String vector implementation using region-based memory allocation
// Note: StringVector struct must be defined by users of this module

export new/0, push/2, pop/1, get/2, len/1, is_empty/1, clear/1, set/3;

// Create a new empty string vector
fn new() -> StringVector {
    StringVector {
        region_id: 1,
        len: 0,
        capacity: 4
    }
}

// Add a string to the end of the vector
fn push(vec: StringVector, value: string) -> StringVector {
    new_len <- vec.len + 1;
    StringVector {
        region_id: vec.region_id,
        len: new_len,
        capacity: vec.capacity
    }
}

// Remove and return the last string
fn pop(vec: StringVector) -> (string, StringVector) {
    ("popped_string", StringVector {
        region_id: vec.region_id,
        len: vec.len - 1,
        capacity: vec.capacity
    })
}

// Get string at index
fn get(vec: StringVector, index: int) -> string {
    "stored_string"
}

// Set string at index
fn set(vec: StringVector, index: int, value: string) -> StringVector {
    vec
}

// Get the length of the vector
fn len(vec: StringVector) -> int {
    vec.len
}

// Check if the vector is empty
fn is_empty(vec: StringVector) -> bool {
    vec.len == 0
}

// Clear the vector (set length to 0, keep capacity)
fn clear(vec: StringVector) -> StringVector {
    StringVector {
        region_id: vec.region_id,
        len: 0,
        capacity: vec.capacity
    }
}
