// Silica Standard Library - Dynamic Vector/Array
// Provides growable arrays backed by regions

export new/0, push/2, pop/1, get/2, len/1, is_empty/1, clear/1;

// Vec struct using region-based allocation
struct Vec<T> {
    data: ref,      // Reference to allocated region
    len: int,       // Current length
    capacity: int,  // Allocated capacity
}

// Create a new empty vector
fn new<T>() -> Vec<T> {
    Vec {
        data: alloc_ref(region(), 0),  // Placeholder allocation
        len: 0,
        capacity: 0
    }
}

// Add an element to the end of the vector
