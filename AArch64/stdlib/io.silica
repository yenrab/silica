// Silica Standard Library - Input/Output Operations
// Provides basic I/O functionality

export print/1, println/1, print_int/1, print_bool/1, print_char/1;

// Print functions implemented as external calls to runtime
extern fn silica_print(s: *char, len: int) -> unit;
extern fn silica_println(s: *char, len: int) -> unit;
extern fn silica_print_int(n: int) -> unit;
extern fn silica_print_bool(b: bool) -> unit;
extern fn silica_print_char(c: char) -> unit;

fn print(s: string) -> unit {
    // Call external runtime print function
    silica_print(s as *char, len(s))
}

fn println(s: string) -> unit {
    // Print string followed by newline
    silica_println(s as *char, len(s))
}

fn print_int(n: int) -> unit {
    // Call external runtime print_int function
    silica_print_int(n)
}

fn print_bool(b: bool) -> unit {
    // Call external runtime print_bool function
    silica_print_bool(b)
}

fn print_char(c: char) -> unit {
    // Call external runtime print_char function
    silica_print_char(c)
}

