// Silica Standard Library - Basic Option-like functionality
// Simplified for current compiler capabilities

export some/1, none/0, is_some/1, unwrap_or/2;

// Simple constructor functions (using ints for now)
fn some(value: int) -> int {
    value  // Placeholder - just return the value
}

fn none() -> int {
    0  // Placeholder - represent None as 0
}

// Utility functions
fn is_some(value: int) -> bool {
    value != 0  // Placeholder check
}

fn unwrap_or(value: int, default: int) -> int {
    if value != 0 {
        value
    } else {
        default
    }
}
