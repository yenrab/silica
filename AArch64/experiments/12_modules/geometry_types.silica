// Geometry types module
// Defines type aliases and struct types for geometric shapes
// Types are automatically available when this module is imported

// Struct type aliases for geometric points
type Point2D = {x: int64, y: int64};
type Point3D = {x: int64, y: int64, z: int64};
type Rectangle = {width: int64, height: int64};

// Tuple type aliases
type CoordPair = (int64, int64);
type SizePair = (int64, int64);
