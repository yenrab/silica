// Calculator module
// Demonstrates a module that imports from others and exports its own functions

// Import math utilities
use math_utils;

// Export declarations
export calculate_expression/2;
export evaluate/1;

// Calculator functions that use imported math functions
fn calculate_expression(x: int64, y: int64) -> int64 {
    // Use imported functions for complex calculation
    add(multiply(x, y), square(add(x, y)))
}

fn evaluate(n: int64) -> int64 {
    // Chain multiple imported operations
    square(multiply(n, add(n, 1)))
}