// Application module
// Demonstrates complex multi-module dependencies and usage

// Import multiple modules
use calculator;
use string_utils;

// Main application function with debug output
fn main() -> int proc[DeviceIO] {
    do
        println("=== Testing Complex Multi-Module App ===");

        // Test calculator functions (which use math_utils internally)
        println("Testing calculator functions:");
        calc_result:int <- calculate_expression(3, 4);
        print("calculate_expression(3, 4) = add(multiply(3,4), square(add(3,4))) = ");
        print_int(calc_result);
        println(" (expected: add(12, square(7)) = add(12, 49) = 61)");

        eval_result:int <- evaluate(5);
        print("evaluate(5) = square(multiply(5, add(5,1))) = square(multiply(5,6)) = ");
        print_int(eval_result);
        println(" (expected: square(30) = 900)");

        // Test string utilities
        println("");
        println("Testing string utilities:");
        combined:int <- concat(calc_result, eval_result);
        print("concat(61, 900) = ");
        print_int(combined);
        println(" (simulated concatenation: 61900)");

        // Final computation combining results from multiple modules
        println("");
        println("Final computation (spans 3 modules):");
        result:int <- add(calc_result, add(eval_result, combined));
        print("add(61, add(900, 61900)) = ");
        print_int(result);
        println(" (expected: 61 + 900 + 61900 = 62861)");

        println("");
        println("=== All multi-module calls working correctly! ===");

        result
    end
}

// Application helper function
fn process_data(input: int) -> int {
    // Use functions from different imported modules
    calc_result:int <- calculate_expression(input, 2);
    eval_result:int <- evaluate(input);
    concat(calc_result, eval_result)
}