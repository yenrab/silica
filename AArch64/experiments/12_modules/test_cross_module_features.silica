// Cross-module features test
// Demonstrates cross-module usage of tuples, traits, and type aliases

// Import modules with types, traits, and implementations
use geometry_types;
use geometry_traits;
use geometry_impls;

fn main() -> int64 proc[DeviceIO] {
    do
        println("=== Testing Cross-Module Features ===");
        
        // Test 1: Using type aliases from imported module
        println("Test 1: Type aliases from geometry_types");
        point: Point2D <- Point2D { x: 10, y: 20 };
        rect: Rectangle <- Rectangle { width: 5, height: 8 };
        print("Point2D: ");
        print_int64(point.x);
        print(", ");
        print_int64(point.y);
        println("");
        
        // Test 2: Using tuples from imported module
        println("Test 2: Tuple type aliases");
        coord_pair: CoordPair <- (30, 40);
        (x: int64, y: int64) <- coord_pair;
        print("CoordPair: (");
        print_int64(x);
        print(", ");
        print_int64(y);
        println(")");
        
        // Test 3: Using trait methods from imported implementations
        println("Test 3: Trait methods");
        area_result: int64 <- rect.area();
        print("Rectangle area: ");
        print_int64(area_result);
        println(" (expected: 40)");
        
        moved_point: Point2D <- point.move_by(5, 10);
        print("Moved point: (");
        print_int64(moved_point.x);
        print(", ");
        print_int64(moved_point.y);
        println(") (expected: (15, 30))");
        
        // Test 4: Cross-module functions with tuples
        println("Test 4: Cross-module functions with tuples");
        sum: int64 <- geometry_impls@get_coord_sum(coord_pair);
        print("Coord sum: ");
        print_int64(sum);
        println(" (expected: 70)");
        
        new_point: Point2D <- geometry_impls@create_point_from_pair((50, 60));
        print("Point from pair: (");
        print_int64(new_point.x);
        print(", ");
        print_int64(new_point.y);
        println(") (expected: (50, 60))");
        
        // Test 5: Combining features
        println("Test 5: Combining features");
        size_pair: SizePair <- (rect.width, rect.height);
        (w: int64, h: int64) <- size_pair;
        combined_area: int64 <- w * h;
        print("Combined area from SizePair: ");
        print_int64(combined_area);
        println(" (expected: 40)");
        
        println("");
        println("=== All cross-module features working! ===");
        
        0
    end
}
