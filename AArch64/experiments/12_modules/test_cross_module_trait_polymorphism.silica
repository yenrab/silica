// Cross-module trait polymorphism test
// Demonstrates passing trait-implementing elements to functions in other modules
// where those module functions use the element's trait methods

// Import modules with types, traits, implementations, and operations
use geometry_types;
use geometry_traits;
use geometry_impls;
use geometry_operations;

fn main() -> int64 proc[DeviceIO] {
    do
        println("=== Testing Cross-Module Trait Polymorphism ===");
        
        // Create instances of types that implement traits
        rect1: Rectangle <- Rectangle { width: 5, height: 8 };
        rect2: Rectangle <- Rectangle { width: 3, height: 10 };
        
        // Test 1: Pass Rectangle (implements Shape) to function in geometry_operations
        println("Test 1: Passing Shape-implementing type to cross-module function");
        area1: int64 <- geometry_operations@compute_area(rect1);
        print("compute_area(rect1) = ");
        print_int64(area1);
        println(" (expected: 40)");
        
        // Test 2: Pass Rectangle to function that uses trait method multiple times
        println("");
        println("Test 2: Function using trait method multiple times");
        doubled: int64 <- geometry_operations@double_area(rect1);
        print("double_area(rect1) = ");
        print_int64(doubled);
        println(" (expected: 80)");
        
        // Test 3: Pass multiple trait-implementing types to comparison function
        println("");
        println("Test 3: Comparing two Shape-implementing types");
        diff: int64 <- geometry_operations@compare_areas(rect1, rect2);
        print("compare_areas(rect1, rect2) = ");
        print_int64(diff);
        println(" (expected: 40 - 30 = 10)");
        
        // Test 4: Verify trait method dispatch works correctly
        println("");
        println("Test 4: Trait method dispatch verification");
        direct_area: int64 <- rect1.area();
        cross_module_area: int64 <- geometry_operations@compute_area(rect1);
        match direct_area == cross_module_area {
            true => println("✓ Trait dispatch works: direct call and cross-module call match"),
            false => println("✗ Trait dispatch mismatch!")
        };
        
        println("");
        println("=== All cross-module trait polymorphism tests complete! ===");
        
        0
    end
}
