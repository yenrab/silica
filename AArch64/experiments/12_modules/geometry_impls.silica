// Geometry implementations module
// Implements traits for types from geometry_types module

// Import types and traits
use geometry_types;
use geometry_traits;

// Implement Shape trait for Rectangle
impl Shape for Rectangle {
    fn area(self: Rectangle) -> int64 {
        self.width * self.height
    }
}

// Implement Movable trait for Point2D
impl Movable for Point2D {
    fn move_by(self: Point2D, dx: int64, dy: int64) -> Point2D {
        Point2D {
            x: self.x + dx,
            y: self.y + dy
        }
    }
}

// Export functions that work with tuples
export create_point_from_pair/1;
export get_coord_sum/1;

// Create a Point2D from a CoordPair tuple
fn create_point_from_pair(pair: CoordPair) -> Point2D {
    (x: int64, y: int64) <- pair;
    Point2D { x: x, y: y }
}

// Get sum of coordinates from a CoordPair tuple
fn get_coord_sum(pair: CoordPair) -> int64 {
    (x: int64, y: int64) <- pair;
    x + y
}
