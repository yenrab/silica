// Math utilities module
// Demonstrates basic exported functions
// This module gets statically linked into applications that import it

// Export declarations
export add/2;
export multiply/2;
export square/1;

// Basic arithmetic functions
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn multiply(x: int64, y: int64) -> int64 {
    x * y
}

fn square(x: int64) -> int64 {
    multiply(x, x)
}