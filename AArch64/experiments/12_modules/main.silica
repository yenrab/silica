// Main module demonstrating module imports
// This tests importing and using functions from other modules

// Import modules
use math_utils;
use string_utils;

// Test function that also uses imported functions
fn test_imports() -> int {
    add(square(3), multiply(4, 5))
}

// Main function using imported functions with debug output
fn main() -> int proc[DeviceIO] {
    do
        println("=== Testing Module Imports ===");

        // Test math_utils functions
        println("Testing math_utils functions:");
        sum:int <- add(10, 5);
        print("add(10, 5) = ");
        print_int(sum);
        println(" (expected: 15)");

        product:int <- multiply(sum, 2);
        print("multiply(15, 2) = ");
        print_int(product);
        println(" (expected: 30)");

        squared:int <- square(4);
        print("square(4) = ");
        print_int(squared);
        println(" (expected: 16)");

        // Test string_utils functions (simulated)
        println("");
        println("Testing string_utils functions:");
        combined:int <- concat(12, 34);
        print("concat(12, 34) = ");
        print_int(combined);
        println(" (simulated concatenation: 1234)");

        len:int <- length(123);
        print("length(123) = ");
        print_int(len);
        println(" (simulated length: 123)");

        // Final computation
        println("");
        println("Final computation:");
        result:int <- add(product, add(squared, add(combined, len)));
        print("add(30, add(16, add(1234, 123))) = ");
        print_int(result);
        println(" (expected: 1403)");

        // Test the test_imports function
        println("");
        println("Testing test_imports function:");
        test_result:int <- test_imports();
        print("test_imports() = add(square(3), multiply(4, 5)) = ");
        print_int(test_result);
        println(" (expected: add(9, 20) = 29)");

        println("");
        println("=== All module imports working correctly! ===");

        result
    end
}