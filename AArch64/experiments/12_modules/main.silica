// Main module demonstrating module imports and chaining
// This shows how modules can import other modules and build complex functionality
// Module chain: main -> calculator -> math_utils

// Import calculator module (which internally imports math_utils)
use calculator;

// Test function demonstrating function composition across modules
fn test_module_chaining() -> int64 {
    // This function uses calculator functions which internally use math_utils
    add(calculate_expression(2, 3), evaluate(4))
}

// Main function demonstrating multi-level module usage
fn main() -> int64 proc[DeviceIO] {
    do
        println("=== Testing Module Imports and Chaining ===");

        // Test basic calculator functions (which use math_utils internally)
        println("Testing calculator functions (using math_utils internally):");

        calc_result:int64 <- calculate_expression(3, 4);
        print("calculate_expression(3, 4) = add(multiply(3,4), square(add(3,4))) = ");
        print_int64(calc_result);
        println(" (expected: add(12, square(7)) = add(12, 49) = 61)");

        eval_result:int64 <- evaluate(5);
        print("evaluate(5) = square(multiply(5, add(5,1))) = square(multiply(5,6)) = ");
        print_int64(eval_result);
        println(" (expected: square(30) = 900)");

        // Test numeric operations (demonstrating integer manipulation)
        println("");
        println("Testing numeric operations:");
        combined:int64 <- calc_result * 1000 + eval_result;
        print("combine(61, 900) = ");
        print_int64(combined);
        println(" (numeric combination: 61900)");

        // Test the module chaining function
        println("");
        println("Testing module chaining function:");
        chain_result:int64 <- test_module_chaining();
        print("test_module_chaining() = add(calculate_expression(2,3), evaluate(4)) = ");
        print_int64(chain_result);
        println(" (expected: add(calculate_expression(2,3), evaluate(4)) = add(31, 400) = 431)");

        // Final computation demonstrating full module chain
        println("");
        println("Final computation (spans main -> calculator -> math_utils):");
        result:int64 <- add(calc_result, add(eval_result, add(combined, chain_result)));
        print("add(61, add(900, add(61900, 431))) = ");
        print_int64(result);
        println(" (expected: 61 + 900 + 61900 + 431 = 63292)");

        println("");
        println("=== Module imports and chaining working correctly! ===");

        result
    end
}