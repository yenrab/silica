// Cross-module effects test
// Demonstrates cross-module usage of effect aliases and effect-annotated functions

// Import modules with effects and effect-using functions
use effect_definitions;
use effect_operations;

fn main() -> int64 proc[DeviceIO] {
    do
        println("=== Testing Cross-Module Effects ===");
        
        // Test 1: Using effect-annotated function from imported module
        println("Test 1: I/O effect function from effect_operations module");
        io_result: int64 <- effect_operations@io_function("Hello from I/O effect function!");
        print("I/O function returned: ");
        print_int64(io_result);
        println(" (expected: 42)");
        
        // Test 2: Using memory effect function
        println("");
        println("Test 2: Memory effect function");
        memory_result: int64 <- effect_operations@memory_function(100);
        print("Memory function returned: ");
        print_int64(memory_result);
        println(" (expected: 100)");
        
        // Test 3: Using combined I/O and memory effect function
        println("");
        println("Test 3: Combined I/O and memory effect function");
        combined_result: int64 <- effect_operations@io_memory_function(25);
        print("Combined function returned: ");
        print_int64(combined_result);
        println(" (expected: 50)");
        
        // Test 4: Effect propagation - calling effect functions from main
        println("");
        println("Test 4: Effect propagation");
        println("Main function declares device_io effect, which allows calling");
        println("functions that require device_io or io_effect");
        
        // Test 5: Chaining effect functions
        println("");
        println("Test 5: Chaining effect functions");
        chain_result1: int64 <- effect_operations@io_function("Chain step 1");
        chain_result2: int64 <- effect_operations@io_memory_function(chain_result1);
        print("Chained results: ");
        print_int64(chain_result1);
        print(" -> ");
        print_int64(chain_result2);
        println(" (expected: 42 -> 84)");
        
        println("");
        println("=== All cross-module effects working! ===");
        
        0
    end
}
