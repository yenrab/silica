// Test cast() return value (success/failure)
// Verifies that cast() properly returns bool indicating success

type Ping = { id: int };
impl ActorMessage for Ping { }

type Pong = { id: int };
impl ActorMessage for Pong { }

type PingerState = { sent: int };
impl ActorState for PingerState { }

type PongerState = { received: int };
impl ActorState for PongerState { }

fn main() -> int proc[concurrency] {
    // Spawn ponger actor
    ponger_ref: actor_ref <- spawn(
        PongerState { received: 0 },
        fn(msg: Ping, state: PongerState) -> PongerState {
            PongerState { received: state.received + 1 }
        }
    );

    // Spawn pinger actor that casts to ponger and checks success
    pinger_ref: actor_ref <- spawn(
        PingerState { sent: 0 },
        fn(msg: Pong, state: PingerState) -> PingerState {
            // Cast ping to ponger - cast() returns bool indicating success
            // For this test, we always update state (cast should succeed for valid actors)
            cast(ponger_ref, Ping { id: msg.id });
            PingerState { sent: state.sent + 1 }
        }
    );

    // Cast initial pong to pinger to start the chain
    cast(pinger_ref, Pong { id: 1 });
    cast(pinger_ref, Pong { id: 2 });
    cast(pinger_ref, Pong { id: 3 });

    // Pinger should cast 3 pings to ponger, all should succeed
    // Ponger should receive 3 pings
    0
}
