// Test cast-back pattern using reply_to field
// Actor A casts to Actor B, which casts back to Actor A

type Request = { data: int, reply_to: actor_ref };
impl ActorMessage for Request { }

type Response = { result: int };
impl ActorMessage for Response { }

type ProcessorState = { processed: int };
impl ActorState for ProcessorState { }

type EchoState = { received: int };
impl ActorState for EchoState { }

fn main() -> int proc[concurrency] {
    // Spawn echo actor that will receive the cast-back response
    echo_ref: actor_ref <- spawn(
        EchoState { received: 0 },
        fn(msg: Response, state: EchoState) -> EchoState {
            EchoState { received: state.received + msg.result }
        }
    );

    // Spawn processor actor that receives requests and casts back responses
    processor_ref: actor_ref <- spawn(
        ProcessorState { processed: 0 },
        fn(msg: Request, state: ProcessorState) -> ProcessorState {
            // Process the request: multiply data by 2
            result: int <- msg.data * 2;
            
            // Cast response back to the originator
            cast(msg.reply_to, Response { result: result });
            
            // Update processor state
            ProcessorState { processed: state.processed + 1 }
        }
    );

    // Cast a request to the processor, including our echo actor as reply_to
    cast(processor_ref, Request { data: 42, reply_to: echo_ref });
    cast(processor_ref, Request { data: 100, reply_to: echo_ref });

    // The processor should cast back to echo_ref with Response { result: 84 } and { result: 200 }
    // Echo actor should receive both responses
    0
}
