// Test multi-actor chain with cast and cast-back
// Actor A -> Actor B -> Actor C -> Actor B -> Actor A (full round trip)

type Forward = { data: int64, next: actor_ref, origin: actor_ref };
impl ActorMessage for Forward { }

type Backward = { data: int64, origin: actor_ref };
impl ActorMessage for Backward { }

type Final = { result: int64 };
impl ActorMessage for Final { }

type ChainState = { hops: int64 };
impl ActorState for ChainState { }

fn main() -> int64 proc[concurrency] {
    // Spawn Actor A (originator/final receiver)
    actor_a_ref: actor_ref <- spawn(
        ChainState { hops: 0 },
        fn(msg: Final, state: ChainState) -> ChainState {
            ChainState { hops: state.hops + 1 }
        }
    );

    // Spawn Actor C (middle of chain)
    actor_c_ref: actor_ref <- spawn(
        ChainState { hops: 0 },
        fn(msg: Forward, state: ChainState) -> ChainState {
            // Cast back to Actor B2 with processed data
            processed: int64 <- msg.data * 2;
            cast(actor_b2_ref, Backward { data: processed, origin: msg.origin });
            ChainState { hops: state.hops + 1 }
        }
    );

    // Spawn Actor B (middle, forwards to C)
    actor_b_ref: actor_ref <- spawn(
        ChainState { hops: 0 },
        fn(msg: Forward, state: ChainState) -> ChainState {
            // Forward to Actor C
            cast(msg.next, Forward { data: msg.data + 1, next: actor_b_ref, origin: msg.origin });
            ChainState { hops: state.hops + 1 }
        }
    );

    // Spawn Actor B2 (receives from C, forwards to A)
    actor_b2_ref: actor_ref <- spawn(
        ChainState { hops: 0 },
        fn(msg: Backward, state: ChainState) -> ChainState {
            // Receive from Actor C, cast back to origin (Actor A)
            cast(msg.origin, Final { result: msg.data });
            ChainState { hops: state.hops + 1 }
        }
    );

    // Start the chain: Actor A casts to Actor B
    // Flow: A -> B -> C -> B -> A
    // Initial data: 10
    // B forwards to C with data: 11
    // C processes: 11 * 2 = 22, casts back to B
    // B casts to A: Final { result: 22 }
    cast(actor_b_ref, Forward { data: 10, next: actor_c_ref, origin: actor_a_ref });

    0
}
