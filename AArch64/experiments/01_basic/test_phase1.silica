// Test Phase 1.1: Core Language Features

{-
- Pattern-matches on an int64 parameter and returns the constant 30 via a single case arm with a variable binding.
- Demonstrates a case expression over x with one arm: a variable pattern `y: int64` that binds any value; since y is unused, every input matches and the result is always 30.
- Example: `test_pattern_alternatives(0)` yields 30.
- Example: `test_pattern_alternatives(42)` yields 30.
- Example: `test_pattern_alternatives(-100)` yields 30.
- Complexity: time O(1), Ω(1), Θ(1); space O(1), Ω(1), Θ(1).
- Last-date-modified: 2025-02-09
- Last-modified-by: Lee S. Barney
-}
fn test_pattern_alternatives(x: int64) -> int64 {
    // Case expression: pattern match on parameter x
    // Syntax: case <expression> of { <pattern> -> <result>; ... }
    case x of {
        // Wildcard pattern 'y' matches any value and binds it to variable y
        // Since we dont use y, this effectively matches everything and returns 30
        y: int64 -> 30;
    }
}

fn main() -> int64 {
    test_pattern_alternatives(2)
}
