// Test mixing different numeric types in function parameters and tuples

fn test_mixed_parameters(x: int8, y: int16, z: int32, w: int64) -> int64 {
    a: int64 <- x as int64;
    b: int64 <- y as int64;
    c: int64 <- z as int64;
    a + b + c + w
}

fn test_tuple_numerics() -> (int8, int16, int32, int64, float16, float32) {
    (8, 16, 32, 64, 16.0, 32.0)
}

fn main() -> int64 {
    result: int64 <- test_mixed_parameters(10, 100, 1000, 10000);
    test_tuple_numerics();
    result
}
