// Test structs with different numeric type fields

struct NumericData {
    byte_val: int8,
    short_val: int16,
    int_val: int32,
    long_val: int64,
    half_float: float16,
    single_float: float32
}

fn create_numeric_data() -> NumericData {
    NumericData {
        byte_val: 42,
        short_val: 1000,
        int_val: 100000,
        long_val: 1000000000,
        half_float: 2.5,
        single_float: 3.14159
    }
}

fn main() -> int64 {
    let data <- create_numeric_data();
    data.long_val
}
