// Test structs with different numeric type fields

struct NumericData {
    byte_val: int8,
    short_val: int16,
    int_val: int32,
    long_val: int64,
    half_float: float16,
    single_float: float32,
    double_float: float64
}

fn create_numeric_data() -> NumericData {
    //types are not inferred, so we need to explicitly cast the literals to the correct types
    NumericData {
        byte_val: 42 as int8,
        short_val: 1000 as int16,
        int_val: 100000 as int32,
        long_val: 1000000000,
        half_float: 2.5 as float16,
        single_float: 3.14159 as float32,
        double_float: 3.141592653589793 as float64
    }
}

fn main() -> int64 {
        data: NumericData <- create_numeric_data();
        data.long_val
}
