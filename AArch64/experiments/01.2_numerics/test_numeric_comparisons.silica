// Test comparison operations with different numeric types

fn compare_int8(x: int8, y: int8) -> boolean {
    x == y
}

fn compare_int16(x: int16, y: int16) -> boolean {
    x < y
}

fn compare_int32(x: int32, y: int32) -> boolean {
    x > y
}

fn compare_int64(x: int64, y: int64) -> boolean {
    x != y
}

fn compare_float16(x: float16, y: float16) -> boolean {
    x <= y
}

fn compare_float32(x: float32, y: float32) -> boolean {
    x >= y
}

fn main() -> boolean {
    compare_int8(5, 5) and
    compare_int16(10, 20) and
    compare_int32(100, 50) and
    compare_int64(1000, 2000) and
    compare_float16(1.5, 2.0) and
    compare_float32(3.14, 3.14)
}
