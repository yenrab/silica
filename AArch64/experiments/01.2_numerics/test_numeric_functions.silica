// Test functions with different numeric return types

fn return_int8() -> int8 {
    127
}

fn return_int16() -> int16 {
    32767
}

fn return_int32() -> int32 {
    2147483647
}

fn return_int64() -> int64 {
    9223372036854775807
}

fn return_float16() -> float16 {
    3.14
}

fn return_float32() -> float32 {
    3.14159
}

fn return_float64() -> float64 {
    3.141592653589793
}

fn main() -> int64 {
    a: int64 <- return_int8() as int64;
    b: int64 <- return_int16() as int64;
    c: int64 <- return_int32() as int64;
    d: int64 <- return_int64();
    a + b + c + d
}
