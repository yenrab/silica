// Test float16 I/O operations
// Tests float16 values in I/O contexts
// Note: No direct print_float function exists, so we test float16 in IO operations

fn test_float16_io() -> int64 proc[DeviceIO] {
    do
        print("Testing float16 I/O operations");
        println("");
        
        // Test various float16 values
        val1: float16 <- 3.14;
        val2: float16 <- 2.5;
        val3: float16 <- -1.5;
        val4: float16 <- 0.0;
        val5: float16 <- 65504.0;  // approximate max float16
        
        print("float16 value 1: ");
        print_float16(val1);
        println("");
        
        print("float16 value 2: ");
        print_float16(val2);
        println("");
        
        print("float16 value 3: ");
        print_float16(val3);
        println("");
        
        print("float16 value 4: ");
        print_float16(val4);
        println("");
        
        print("float16 value 5: ");
        print_float16(val5);
        println("");
        
        0
    end
}

fn main() -> int64 proc[DeviceIO] {
    result: int64 <- test_float16_io();
    result
}
