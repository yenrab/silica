// Test Process Execution functionality
// Tests the exec_command built-in function

fn test_basic_command() -> unit {
    // Test basic command execution
    do
        result <- exec_command("echo");
        // Note: This will execute but we can't easily test the result
        // In a real test environment, we'd check result.success, result.exit_code, etc.
        ()
    end
}

fn test_command_with_logic() -> int {
    // Test that exec_command can be used in expressions
    // This demonstrates integration with the language
    do
        cmd_result <- exec_command("true");

        // Return a value to show the function executed
        42
    end
}

fn main() -> int {
    do
        test_basic_command();
        test_command_with_logic()
    end
}
