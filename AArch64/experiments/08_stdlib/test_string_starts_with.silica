// Test string starts_with function: starts_with(s: string, prefix: string) -> bool
// Tests the starts_with function from string.silica stdlib module

fn main() -> int64 proc[DeviceIO] {
    do
        println("=== Testing starts_with ===");
        
        // Test with simple prefix match
        result1:bool <- starts_with("Hello World", "Hello");
        print_bool(result1);
        println("");  // Should print true
        
        // Test with non-matching prefix
        result2:bool <- starts_with("Hello World", "World");
        print_bool(result2);
        println("");  // Should print false
        
        // Test with empty prefix (should always match)
        result3:bool <- starts_with("Hello World", "");
        print_bool(result3);
        println("");  // Should print true
        
        // Test with prefix longer than string
        result4:bool <- starts_with("Hi", "Hello");
        print_bool(result4);
        println("");  // Should print false
        
        // Test with exact match
        result5:bool <- starts_with("Hello", "Hello");
        print_bool(result5);
        println("");  // Should print true
        
        // Test with single character prefix
        result6:bool <- starts_with("Hello", "H");
        print_bool(result6);
        println("");  // Should print true
        
        result7:bool <- starts_with("Hello", "h");
        print_bool(result7);
        println("");  // Should print false (case-sensitive)
        
        // Test with UTF-8 characters
        result8:bool <- starts_with("Café au lait", "Café");
        print_bool(result8);
        println("");  // Should print true
        
        // Test with Japanese characters
        result9:bool <- starts_with("こんにちは世界", "こんにちは");
        print_bool(result9);
        println("");  // Should print true
        
        result10:bool <- starts_with("こんにちは世界", "世界");
        print_bool(result10);
        println("");  // Should print false
        
        // Test with emoji
        result11:bool <- starts_with("👋 Hello", "👋");
        print_bool(result11);
        println("");  // Should print true
        
        // Test with partial UTF-8 match (should fail - can't split multi-byte character)
        result12:bool <- starts_with("Café", "Caf");
        print_bool(result12);
        println("");  // Should print true (byte comparison works)
        
        // Test with runtime strings
        content:string <- read_lines("test.txt");
        result13:bool <- starts_with(content, "Test");
        print_bool(result13);
        println("");  // Depends on file content
        
        // Test with mixed constants and runtime strings
        result14:bool <- starts_with(content, "Hello");
        print_bool(result14);
        println("");  // Depends on file content
        
        // Test chaining with other functions
        test_str:string <- concat("Hello", " World");
        result15:bool <- starts_with(test_str, "Hello");
        print_bool(result15);
        println("");  // Should print true
        
        0
    end
}
