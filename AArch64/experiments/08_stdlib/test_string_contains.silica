// Test string contains function: contains(s: string, substr: string) -> bool
// Tests the contains function from string.silica stdlib module

fn main() -> int proc[DeviceIO] {
    do
        println("=== Testing contains ===");
        
        // Test with simple substring match
        result1:bool <- contains("Hello World", "World");
        print_bool(result1);
        println("");  // Should print true
        
        // Test with substring at start
        result2:bool <- contains("Hello World", "Hello");
        print_bool(result2);
        println("");  // Should print true
        
        // Test with substring in middle
        result3:bool <- contains("Hello World", "lo Wo");
        print_bool(result3);
        println("");  // Should print true
        
        // Test with non-matching substring
        result4:bool <- contains("Hello World", "xyz");
        print_bool(result4);
        println("");  // Should print false
        
        // Test with empty substring (should always match)
        result5:bool <- contains("Hello World", "");
        print_bool(result5);
        println("");  // Should print true
        
        // Test with substring longer than string
        result6:bool <- contains("Hi", "Hello");
        print_bool(result6);
        println("");  // Should print false
        
        // Test with exact match
        result7:bool <- contains("Hello", "Hello");
        print_bool(result7);
        println("");  // Should print true
        
        // Test with single character
        result8:bool <- contains("Hello", "e");
        print_bool(result8);
        println("");  // Should print true
        
        result9:bool <- contains("Hello", "E");
        print_bool(result9);
        println("");  // Should print false (case-sensitive)
        
        // Test with UTF-8 characters
        result10:bool <- contains("Café au lait", "Café");
        print_bool(result10);
        println("");  // Should print true
        
        result11:bool <- contains("Café au lait", "lait");
        print_bool(result11);
        println("");  // Should print true
        
        // Test with Japanese characters
        result12:bool <- contains("こんにちは世界", "世界");
        print_bool(result12);
        println("");  // Should print true
        
        result13:bool <- contains("こんにちは世界", "こんにちは");
        print_bool(result13);
        println("");  // Should print true
        
        // Test with emoji
        result14:bool <- contains("Hello 👋 World", "👋");
        print_bool(result14);
        println("");  // Should print true
        
        // Test with multiple occurrences (should return true on first match)
        result15:bool <- contains("a,b,c,d", ",");
        print_bool(result15);
        println("");  // Should print true
        
        // Test with overlapping potential matches
        result16:bool <- contains("ababab", "abab");
        print_bool(result16);
        println("");  // Should print true
        
        // Test with runtime strings
        content:string <- read_lines("test.txt");
        result17:bool <- contains(content, "test");
        print_bool(result17);
        println("");  // Depends on file content
        
        // Test with mixed constants and runtime strings
        result18:bool <- contains(content, "Hello");
        print_bool(result18);
        println("");  // Depends on file content
        
        // Test chaining with other functions
        test_str:string <- concat("Hello", " World");
        result19:bool <- contains(test_str, "World");
        print_bool(result19);
        println("");  // Should print true
        
        // Test combining with starts_with and ends_with
        result20:bool <- contains("Hello World", "lo");
        result21:bool <- starts_with("Hello World", "Hello");
        result22:bool <- ends_with("Hello World", "World");
        result23:bool <- result20 and result21 and result22;
        print_bool(result23);
        println("");  // Should print true
        
        0
    end
}
