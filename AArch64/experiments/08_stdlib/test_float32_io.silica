// Test float32 I/O operations
// Tests float32 values in I/O contexts
// Note: No direct print_float function exists, so we test float32 in IO operations

fn test_float32_io() -> int64 proc[DeviceIO] {
    do
        print("Testing float32 I/O operations");
        println("");
        
        // Test various float32 values
        val1: float32 <- 3.14159;
        val2: float32 <- 2.71828;
        val3: float32 <- -1.5;
        val4: float32 <- 0.0;
        val5: float32 <- 3.4028235e38;  // approximate max float32
        
        print("float32 value 1: ");
        print_float32(val1);
        println("");
        
        print("float32 value 2: ");
        print_float32(val2);
        println("");
        
        print("float32 value 3: ");
        print_float32(val3);
        println("");
        
        print("float32 value 4: ");
        print_float32(val4);
        println("");
        
        print("float32 value 5: ");
        print_float32(val5);
        println("");
        
        0
    end
}

fn main() -> int64 proc[DeviceIO] {
    result: int64 <- test_float32_io();
    result
}
