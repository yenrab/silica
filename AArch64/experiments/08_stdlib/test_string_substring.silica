// Test string substring function: substring(s: string, start: int, end: int) -> string
// Tests the substring function from string.silica stdlib module
// Note: start and end are byte indices (start inclusive, end exclusive)

fn main() -> int proc[DeviceIO] {
    do
        println("=== Testing substring ===");
        
        // Test with simple string
        result1:string <- substring("Hello", 0, 5);
        print(result1);
        println("");  // Should print "Hello"
        
        // Test with start index
        result2:string <- substring("Hello World", 0, 5);
        print(result2);
        println("");  // Should print "Hello"
        
        // Test with middle substring
        result3:string <- substring("Hello World", 6, 11);
        print(result3);
        println("");  // Should print "World"
        
        // Test with single character
        result4:string <- substring("Hello", 0, 1);
        print(result4);
        println("");  // Should print "H"
        
        // Test with empty substring (start == end)
        result5:string <- substring("Hello", 2, 2);
        print(result5);
        println("");  // Should print nothing (empty string)
        
        // Test with UTF-8 characters (accented)
        result6:string <- substring("Café", 0, 4);
        print(result6);
        println("");  // Should print "Caf" (é is 2 bytes, so index 4 is after 'f')
        
        result7:string <- substring("Café", 0, 5);
        print(result7);
        println("");  // Should print "Café" (full string, 5 bytes)
        
        // Test with Japanese characters
        result8:string <- substring("こんにちは", 0, 3);
        print(result8);
        println("");  // Should print "こ" (first character, 3 bytes)
        
        result9:string <- substring("こんにちは", 3, 6);
        print(result9);
        println("");  // Should print "ん" (second character, 3 bytes)
        
        // Test with emoji
        result10:string <- substring("Hello 👋 World", 0, 6);
        print(result10);
        println("");  // Should print "Hello " (6 bytes)
        
        result11:string <- substring("Hello 👋 World", 6, 10);
        print(result11);
        println("");  // Should print "👋" (emoji is 4 bytes)
        
        // Test with out-of-bounds indices (should clamp)
        result12:string <- substring("Hello", -5, 10);
        print(result12);
        println("");  // Should print "Hello" (clamped to 0, 5)
        
        result13:string <- substring("Hello", 2, 100);
        print(result13);
        println("");  // Should print "llo" (clamped to 2, 5)
        
        // Test with start > end (should return empty)
        result14:string <- substring("Hello", 3, 2);
        print(result14);
        println("");  // Should print nothing (empty string)
        
        // Test with runtime strings
        content:string <- read_lines("test.txt");
        result15:string <- substring(content, 0, 5);
        print(result15);
        println("");  // Should print first 5 bytes of file content
        
        // Test chaining substring operations
        result16:string <- substring("Hello World", 0, 5);
        result17:string <- substring(result16, 0, 2);
        print(result17);
        println("");  // Should print "He"
        
        0
    end
}
