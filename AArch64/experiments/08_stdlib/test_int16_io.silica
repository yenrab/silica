// Test int16 I/O operations
// Tests printing int16 values using print_int (with casting to int64)

fn test_int16_io() -> int64 proc[DeviceIO] {
    do
        print("Testing int16 I/O: ");
        println("");
        
        // Test various int16 values
        val1: int16 <- 42;
        val2: int16 <- 1000;
        val3: int16 <- -500;
        val4: int16 <- 32767;   // max int16
        val5: int16 <- -32768;  // min int16
        
        print("int16 value 1: ");
        print_int16(val1);
        println("");
        
        print("int16 value 2: ");
        print_int16(val2);
        println("");
        
        print("int16 value 3: ");
        print_int16(val3);
        println("");
        
        print("int16 value 4 (max): ");
        print_int16(val4);
        println("");
        
        print("int16 value 5 (min): ");
        print_int16(val5);
        println("");
        
        0
    end
}

fn main() -> int64 proc[DeviceIO] {
    result: int64 <- test_int16_io();
    result
}
