// Test string length functions: len(s: string) -> int64 (bytes) and len_chars(s: string) -> int64 (characters)
// Tests both len (byte count) and len_chars (character count) functions
// Includes UTF-8 characters and emoji to test multi-byte character handling

fn main() -> int64 proc[DeviceIO] {
    do
        println("=== Testing len (byte count) ===");
        
        // Test with string constant
        length1:int64 <- len("Hello");
        print_int(length1);
        println("");  // Should be 5 bytes
        
        // Test with empty string
        length2:int64 <- len("");
        print_int(length2);
        println("");  // Should be 0 bytes
        
        // Test with longer string
        length3:int64 <- len("Hello, World!");
        print_int(length3);
        println("");  // Should be 13 bytes
        
        // Test with UTF-8 characters (accented letters)
        length4:int64 <- len("Café");
        print_int(length4);
        println("");  // Should be 5 bytes (é is 2 bytes)
        
        // Test with Japanese characters
        length5:int64 <- len("こんにちは");
        print_int(length5);
        println("");  // Should be 15 bytes (each character is 3 bytes)
        
        // Test with emoji
        length6:int64 <- len("Hello 👋 World");
        print_int(length6);
        println("");  // Should be 17 bytes (emoji is 4 bytes)
        
        // Test with multiple emoji
        length7:int64 <- len("🚀🌟✨");
        print_int(length7);
        println("");  // Should be 11 bytes (🚀=4, 🌟=4, ✨=3)
        
        // Test with mixed UTF-8 and emoji
        length8:int64 <- len("Café 🍕 こんにちは");
        print_int(length8);
        println("");  // Should be 26 bytes
        
        // Test with string from read_lines (runtime string)
        content:string <- read_lines("test.txt");
        length9:int64 <- len(content);
        print_int(length9);
        println("");
        
        println("=== Testing len_chars (character count) ===");
        
        // Test with string constant
        char_len1:int64 <- len_chars("Hello");
        print_int(char_len1);
        println("");  // Should be 5 characters
        
        // Test with empty string
        char_len2:int64 <- len_chars("");
        print_int(char_len2);
        println("");  // Should be 0 characters
        
        // Test with longer string
        char_len3:int64 <- len_chars("Hello, World!");
        print_int(char_len3);
        println("");  // Should be 13 characters
        
        // Test with UTF-8 characters (accented letters)
        char_len4:int64 <- len_chars("Café");
        print_int(char_len4);
        println("");  // Should be 4 characters (é is 1 character)
        
        // Test with Japanese characters
        char_len5:int64 <- len_chars("こんにちは");
        print_int(char_len5);
        println("");  // Should be 5 characters
        
        // Test with emoji
        char_len6:int64 <- len_chars("Hello 👋 World");
        print_int(char_len6);
        println("");  // Should be 13 characters (emoji is 1 character)
        
        // Test with multiple emoji
        char_len7:int64 <- len_chars("🚀🌟✨");
        print_int(char_len7);
        println("");  // Should be 3 characters
        
        // Test with mixed UTF-8 and emoji
        char_len8:int64 <- len_chars("Café 🍕 こんにちは");
        print_int(char_len8);
        println("");  // Should be 12 characters (Café=4, space=1, 🍕=1, space=1, こんにちは=5)
        
        // Test with string from read_lines (runtime string)
        char_len9:int64 <- len_chars(content);
        print_int(char_len9);
        println("");
        
        0
    end
}
