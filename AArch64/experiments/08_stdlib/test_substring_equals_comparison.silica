// Test that substring results compare correctly with string literals.
// This exercises the bug where peek_char (substring) returns a value that
// doesn't match "=" in case expressions, breaking == and != parsing.
// Expected: all comparisons pass (1). If bug present: some fail (0).

fn main() -> int64 proc[DeviceIO] {
    do
        println("=== Testing substring vs literal equality (lexer peek_char bug) ===");

        // Test 1: substring of "==" at position 1 should equal "="
        test_str: string <- "==";
        second: string <- substring(test_str, 1, 2);
        eq1: bool <- second == "=";
        print_int64(case eq1 of { true -> 1; false -> 0 });
        println("  ; 1=pass (substring(==,1,2) == =)");

        // Test 2: substring of "!=" at position 1 should equal "="
        ne_str: string <- "!=";
        second_ne: string <- substring(ne_str, 1, 2);
        eq2: bool <- second_ne == "=";
        print_int64(case eq2 of { true -> 1; false -> 0 });
        println("  ; 1=pass (substring(!=,1,2) == =)");

        // Test 3: case expression matching (the actual lexer pattern)
        check_eq: int64 <- case second of {
            "=" -> 1;
            _: string -> 0
        };
        print_int64(check_eq);
        println("  ; 1=pass (case second of { = -> 1 })");

        // Test 4: empty string (known workaround exists in lexer)
        empty: string <- substring("x", 1, 1);
        empty_ok: bool <- len(empty) == 0;
        print_int64(case empty_ok of { true -> 1; false -> 0 });
        println("  ; 1=pass (empty substring len)");

        all_pass: bool <- eq1 and eq2 and (check_eq == 1) and empty_ok;
        print_int64(case all_pass of { true -> 0; false -> 1 });
        println("  ; exit: 0=all pass, 1=bug present");

        case all_pass of {
            true -> 0;
            false -> 1
        }
    end
}
