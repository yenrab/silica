// Test Unicode character support
fn test_unicode() -> int64 proc[DeviceIO] {
    print("Unicode test: ");
    print_char('A');      // ASCII
    print_char('ñ');      // Latin-1 supplement
    print_char('π');      // Greek
    print_char('🚀');     // Emoji
    print_char('世');     // CJK
    println("");
    42
}

fn main() -> int64 proc[DeviceIO] {
    test_unicode()
}
