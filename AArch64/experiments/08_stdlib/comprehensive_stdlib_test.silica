// Comprehensive Standard Library Test
// Tests all stdlib modules and their integration

fn test_io_operations() -> int {
    // Test print functions
    print("Testing I/O operations");
    println("Line with newline");
    print_int(42);
    print_bool(true);
    print_bool(false);
    print_char('!');
    42
}

fn test_data_structure_operations() -> int {
    do
        r <- region();

        // Test memory operations
        ref <- alloc_ref(r, 100);
        val <- read_ref(ref);
        write_ref(ref, 200);
        new_val <- read_ref(ref);

        // Test region lifecycle
        // (region will be cleaned up automatically)

        val + new_val
    end
}

fn test_actor_operations() -> int {
    do
        // Test actor creation and messaging
        actor <- spawn(42, 100);

        // Send messages
        send(actor, 10);
        send(actor, 20);

        // In real implementation, would receive responses
        // For testing, verify infrastructure works
        42
    end
}

fn test_combined_operations() -> int {
    do
        // Combine multiple stdlib features
        r <- region();
        data <- alloc_ref(r, 0);

        actor <- spawn(0, 200);

        // Simulate some work
        write_ref(data, 100);
        send(actor, 50);

        result <- read_ref(data);

        result
    end
}

fn main() -> int {
    do
        io_result <- test_io_operations();
        data_result <- test_data_structure_operations();
        actor_result <- test_actor_operations();
        combined_result <- test_combined_operations();

        io_result + data_result + actor_result + combined_result
    end
}
