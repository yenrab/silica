// Test string concatenation function: concat(a: string, b: string) -> string
// Tests the concat function from string.silica stdlib module

fn main() -> int proc[DeviceIO] {
    do
        println("=== Testing concat ===");
        
        // Test with two string constants
        result1:string <- concat("Hello", "World");
        print(result1);
        println("");  // Should print "HelloWorld"
        
        // Test with empty strings
        result2:string <- concat("", "");
        print(result2);
        println("");  // Should print nothing (empty string)
        
        // Test with one empty string
        result3:string <- concat("Hello", "");
        print(result3);
        println("");  // Should print "Hello"
        
        result4:string <- concat("", "World");
        print(result4);
        println("");  // Should print "World"
        
        // Test with space separator
        result5:string <- concat("Hello", " ");
        result6:string <- concat(result5, "World");
        print(result6);
        println("");  // Should print "Hello World"
        
        // Test with UTF-8 characters
        result7:string <- concat("Café", " ");
        result8:string <- concat(result7, "🍕");
        print(result8);
        println("");  // Should print "Café 🍕"
        
        // Test with Japanese characters
        result9:string <- concat("こんにちは", "世界");
        print(result9);
        println("");  // Should print "こんにちは世界"
        
        // Test with emoji
        result10:string <- concat("Hello ", "👋");
        result11:string <- concat(result10, " World");
        print(result11);
        println("");  // Should print "Hello 👋 World"
        
        // Test chaining multiple concats
        result12:string <- concat("A", "B");
        result13:string <- concat(result12, "C");
        result14:string <- concat(result13, "D");
        print(result14);
        println("");  // Should print "ABCD"
        
        // Test with runtime strings
        content1:string <- read_lines("test.txt");
        content2:string <- read_lines("test.txt");
        result15:string <- concat(content1, content2);
        print(result15);
        println("");  // Should print file content twice
        
        // Test mixing constants and runtime strings
        result16:string <- concat("Prefix: ", content1);
        print(result16);
        println("");  // Should print "Prefix: " followed by file content
        
        // Test with newline
        result17:string <- concat("Line 1", "\n");
        result18:string <- concat(result17, "Line 2");
        print(result18);
        println("");  // Should print "Line 1" newline "Line 2"
        
        0
    end
}
