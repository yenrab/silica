// Comprehensive Standard Library Test
// Tests all stdlib modules and their integration

fn test_io_operations() -> int proc[DeviceIO] {
    do
        // Test print functions
        print("Testing I/O operations");
        println("Line with newline");
        print_int(42);
        println("");
        print_bool(true);
        println("");
        print_bool(false);
        println("");
        print_char('!');
        println("");
        42
    end
}

fn main() -> int proc[DeviceIO] {
    io_result <- test_io_operations();
    io_result
}
