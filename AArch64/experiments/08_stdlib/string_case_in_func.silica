
fn op_to_prim_and_type(op: string) -> (string, string) {
    case op of {
        "+" -> ("add", "int64");
        "-" -> ("sub", "int64");
        "*" -> ("mul", "int64");
        "/" -> ("div", "int64");
        "%" -> ("rem", "int64");
        "<" -> ("lt", "bool");
        ">" -> ("gt", "bool");
        "<=" -> ("le", "bool");
        ">=" -> ("ge", "bool");
        "==" -> ("eq", "bool");
        "!=" -> ("ne", "bool");
        _: string -> ("", "int64")
    }
}

fn main() -> int64 proc[DeviceIO] {
    original: string <- "+ 2";
    first_char: string <- substring(original, 0, 1);
    print(first_char);
    println("");
    (prim_op: string, result_type: string) <- op_to_prim_and_type(first_char);
    println("  DEBUG sir: op_to_prim_and_type op=[");
    print(prim_op);
    println("");
    print(result_type);
    println("");
    0
}