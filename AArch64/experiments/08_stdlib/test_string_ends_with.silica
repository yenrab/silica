// Test string ends_with function: ends_with(s: string, suffix: string) -> bool
// Tests the ends_with function from string.silica stdlib module

fn main() -> int proc[DeviceIO] {
    do
        println("=== Testing ends_with ===");
        
        // Test with simple suffix match
        result1:bool <- ends_with("Hello World", "World");
        print_bool(result1);
        println("");  // Should print true
        
        // Test with non-matching suffix
        result2:bool <- ends_with("Hello World", "Hello");
        print_bool(result2);
        println("");  // Should print false
        
        // Test with empty suffix (should always match)
        result3:bool <- ends_with("Hello World", "");
        print_bool(result3);
        println("");  // Should print true
        
        // Test with suffix longer than string
        result4:bool <- ends_with("Hi", "Hello");
        print_bool(result4);
        println("");  // Should print false
        
        // Test with exact match
        result5:bool <- ends_with("Hello", "Hello");
        print_bool(result5);
        println("");  // Should print true
        
        // Test with single character suffix
        result6:bool <- ends_with("Hello", "o");
        print_bool(result6);
        println("");  // Should print true
        
        result7:bool <- ends_with("Hello", "O");
        print_bool(result7);
        println("");  // Should print false (case-sensitive)
        
        // Test with UTF-8 characters
        result8:bool <- ends_with("Café au lait", "lait");
        print_bool(result8);
        println("");  // Should print true
        
        // Test with Japanese characters
        result9:bool <- ends_with("こんにちは世界", "世界");
        print_bool(result9);
        println("");  // Should print true
        
        result10:bool <- ends_with("こんにちは世界", "こんにちは");
        print_bool(result10);
        println("");  // Should print false
        
        // Test with emoji
        result11:bool <- ends_with("Hello 👋", "👋");
        print_bool(result11);
        println("");  // Should print true
        
        // Test with file extension pattern
        result12:bool <- ends_with("document.txt", ".txt");
        print_bool(result12);
        println("");  // Should print true
        
        result13:bool <- ends_with("document.txt", ".pdf");
        print_bool(result13);
        println("");  // Should print false
        
        // Test with newline at end
        result14:bool <- ends_with("Line 1\n", "\n");
        print_bool(result14);
        println("");  // Should print true
        
        // Test with runtime strings
        content:string <- read_lines("test.txt");
        result15:bool <- ends_with(content, "\n");
        print_bool(result15);
        println("");  // Depends on file content
        
        // Test with mixed constants and runtime strings
        result16:bool <- ends_with(content, "end");
        print_bool(result16);
        println("");  // Depends on file content
        
        // Test chaining with other functions
        test_str:string <- concat("Hello", " World");
        result17:bool <- ends_with(test_str, "World");
        print_bool(result17);
        println("");  // Should print true
        
        // Test with both starts_with and ends_with
        result18:bool <- starts_with("Hello World", "Hello");
        result19:bool <- ends_with("Hello World", "World");
        result20:bool <- result18 and result19;
        print_bool(result20);
        println("");  // Should print true
        
        0
    end
}
