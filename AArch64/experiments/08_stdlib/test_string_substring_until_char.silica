// Test string substring_until_char function: substring_until_char(s: string, start: int, char: char) -> string
// Tests the substring_until_char function from string.silica stdlib module
// Extracts substring from start index until (but not including) the specified character is found

fn main() -> int proc[DeviceIO] {
    do
        println("=== Testing substring_until_char ===");
        
        // Test with simple string and space character
        result1:string <- substring_until_char("Hello World", 0, ' ');
        print(result1);
        println("");  // Should print "Hello"
        
        // Test starting from middle
        result2:string <- substring_until_char("Hello World", 6, ' ');
        print(result2);
        println("");  // Should print "World" (no space after, so returns rest)
        
        // Test with comma separator
        result3:string <- substring_until_char("apple,banana,cherry", 0, ',');
        print(result3);
        println("");  // Should print "apple"
        
        // Test with newline character
        result4:string <- substring_until_char("Line 1\nLine 2", 0, '\n');
        print(result4);
        println("");  // Should print "Line 1"
        
        // Test with character not found (should return rest of string)
        result5:string <- substring_until_char("Hello World", 0, 'x');
        print(result5);
        println("");  // Should print "Hello World" (entire string)
        
        // Test with character at start position (should return empty)
        result6:string <- substring_until_char("Hello", 0, 'H');
        print(result6);
        println("");  // Should print nothing (empty string)
        
        // Test with UTF-8 characters
        result7:string <- substring_until_char("Café au lait", 0, ' ');
        print(result7);
        println("");  // Should print "Café"
        
        // Test with Japanese characters
        result8:string <- substring_until_char("こんにちは 世界", 0, ' ');
        print(result8);
        println("");  // Should print "こんにちは"
        
        // Test with emoji
        result9:string <- substring_until_char("Hello 👋 World", 0, ' ');
        print(result9);
        println("");  // Should print "Hello"
        
        // Test with tab character
        result10:string <- substring_until_char("Name\tValue", 0, '\t');
        print(result10);
        println("");  // Should print "Name"
        
        // Test with multiple occurrences (should stop at first)
        result11:string <- substring_until_char("a,b,c,d", 0, ',');
        print(result11);
        println("");  // Should print "a" (stops at first comma)
        
        // Test with start index after character
        result12:string <- substring_until_char("Hello World", 3, ' ');
        print(result12);
        println("");  // Should print "lo" (from index 3 until space)
        
        // Test with runtime strings
        content:string <- read_lines("test.txt");
        result13:string <- substring_until_char(content, 0, '\n');
        print(result13);
        println("");  // Should print first line of file content
        
        // Test chaining with other string functions
        result14:string <- substring_until_char("Hello World", 0, ' ');
        result15:string <- concat(result14, "!");
        print(result15);
        println("");  // Should print "Hello!"
        
        0
    end
}
