// Case expression test (basic implementation)
// Currently returns first matching branch value
fn test_case_expression(x: int) -> int {
    case x of {
        0 -> 100;      // Literal pattern
        5 -> 250;      // Another literal pattern
        _ -> 42         // Wildcard pattern
    }
}

fn main() -> int {
    test_case_expression(5)  // Returns 100 (first branch)
}
