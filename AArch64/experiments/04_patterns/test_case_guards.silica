// Case expression with guards test
// Note: Guards are parsed but not fully implemented in runtime yet
fn test_guards(x: int) -> int {
    case x of {
        n if n > 10 -> n * 2;  // Guard: only matches if n > 10
        n if n > 5 -> n + 10;  // Guard: only matches if n > 5
        _ -> 0                 // Fallback for other values
    }
}

fn main() -> int {
    test_guards(15)  // Should return 30 (15 * 2) if guards worked
}
