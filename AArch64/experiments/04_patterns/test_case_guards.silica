// Case expression with guards test
fn is_positive(x: int) -> bool {
    x > 0
}

fn test_guards(x: int) -> int {
    case x of {
        value if value > 10 -> value * 2;        // Primitive comparison
        value if is_positive(value) -> value + 10; // Custom function in guard
        _ -> 0                                   // Fallback
    }
}

fn main() -> int {
    test_guards(15)  // Should return 30 (15 * 2) - first guard matches
}
