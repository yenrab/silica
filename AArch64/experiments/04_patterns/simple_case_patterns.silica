// Test case expressions with different patterns

fn test_literal_patterns(x: int) -> int {
    case x of {
        0 -> 100;
        1 -> 200;
        2 -> 300;
        _ -> 400
    }
}

fn test_wildcard_only(x: int) -> int {
    case x of {
        _ -> 999
    }
}

fn main() -> int {
    do
        result1 <- test_literal_patterns(1);  // Should return 200
        result2 <- test_wildcard_only(42);    // Should return 999
        result1 + result2
    end
}
