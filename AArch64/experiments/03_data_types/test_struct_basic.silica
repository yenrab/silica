// Basic struct test - struct declaration, literal creation, and field access
struct Point {
    x: int,
    y: int
}

fn test_struct_operations() -> int {
    do
        // Create a struct literal and access a field directly
        aPoint:Point <- Point { x: 10, y: 20 };
        aPoint.x // Should return 10
    end
}

fn main() -> int {
    test_struct_operations()
}
