// Simple struct test with basic struct operations
struct Point {
    x: int,
    y: int
}

fn test_struct_operations() -> int {
    do
        // Create a struct literal
        point <- Point { x: 10, y: 20 };
        // Access fields and return their sum
        point.x + point.y  // Should return 10 + 20 = 30
    end
}

fn main() -> int {
    test_struct_operations()
}
