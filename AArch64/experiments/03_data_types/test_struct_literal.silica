// Struct literal test with mixed types
// Tests struct literal creation with different field types
struct MixedData {
    x: int64,
    y: boolean,
    z: char
}

fn main() -> int64 {
    do
        // Create a struct literal with mixed field types and access directly
        data:MixedData <- MixedData { x: 100, y: true, z: 'A' };
        data.x

    end
}