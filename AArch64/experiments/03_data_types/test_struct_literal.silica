// Struct literal test with mixed types
// Tests struct literal creation with different field types
struct MixedData {
    x: int,
    y: bool,
    z: char
}

fn main() -> int {
    do
        // Create a struct literal with mixed field types
        data <- MixedData { x: 100, y: true, z: 'A' };
        // Access the integer field
        data.x
    end
}