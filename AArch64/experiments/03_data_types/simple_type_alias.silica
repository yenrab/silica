// Test type aliases

// Type alias declaration - demonstrates that Silica supports type aliases
type IntBoolPair = (int, boolean);

// Function that uses the type alias in its parameter type
fn process_pair(pair: IntBoolPair) -> int {
    do
        // Pattern matching on type aliases works in function bodies
        (num: int, _: boolean) <- pair;
        num
    end
}

// Function that decomposes the type alias directly in the parameter pattern
fn process_pair_decomposed((num: int, flag: boolean): IntBoolPair) -> int {
    // num and flag are automatically decomposed from the IntBoolPair parameter
    num
}

fn main() -> int {
    do
        // Create a tuple that matches the alias type
        pair:(int, boolean) <- (42, true);
        // Test both approaches: explicit parameter + pattern matching, and direct pattern parameter
        result1:int <- process_pair(pair);
        result2:int <- process_pair_decomposed(pair);
        // Both should return 42
        result1 + result2//should return 84
    end
}
