// Test tuple patterns in case expressions

fn test_tuple_case() -> int64 {
    do
        // Create a tuple
        data:(int64, boolean) <- (42, true);
        
        // Use tuple in case expression - simplified for now
        case data of {
            (42, true) -> 42;
            _:(int64,boolean) -> 0
        }
    end
}

fn main() -> int64 {
    test_tuple_case()
}
