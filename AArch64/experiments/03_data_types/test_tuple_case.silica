// Test tuple patterns in case expressions

fn test_tuple_case() -> int {
    do
        // Create a tuple
        data <- (42, true);
        
        // Use tuple in case expression - simplified for now
        case data of {
            (42, true) -> 42;
            _:(int,boolean) -> 0
        }
    end
}

fn main() -> int {
    test_tuple_case()
}
