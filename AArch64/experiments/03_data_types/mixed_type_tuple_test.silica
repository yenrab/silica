// Test for mixed-type tuples
// Currently implemented as i64 storage, but demonstrates the API
fn main() -> int {
    do
        // Test tuple with different literal types
        mixed_tuple <- (42, true, 'a');

        // Elements are stored in their native LLVM types:
        // 42 -> i64 at offset 0, true -> i1 at offset 8, 'a' -> i32 at offset 12
        // Type-aware storage preserves memory efficiency and type safety

        42  // Return success
    end
}
