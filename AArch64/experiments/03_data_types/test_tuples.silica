// Test complete tuple implementation

// Test tuple types
type IntTriple = (int, int, int);

// Test tuple expressions and pattern matching
fn test_tuple_operations() -> int {
    do
    // Create a tuple
        tuple <- (42, true);
    
        // Pattern match on tuple - simplified
    case tuple of {
            (42, true) -> 42;
        _:(int,boolean) -> 0
    }
    end
}

fn main() -> int {
    test_tuple_operations()
}
