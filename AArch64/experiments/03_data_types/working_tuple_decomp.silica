// Working tuple decomposition example

fn process_pair((x, y): (int, int)) -> int {
    // Actually decompose the tuple parameter into x and y
    x + y
}

fn make_triple() -> (int, int, int) {
    (10, 20, 30)
}

fn main() -> int {
    do
        // Test tuple parameter decomposition
        result1 <- process_pair((5, 7));  // This should be 5 + 7 = 12

        // Test tuple return decomposition
        (a, b, c) <- make_triple();  // This should decompose (10, 20, 30)

        // Return a computation using all the decomposed values
        result1 + a + b + c  // Should be 12 + 10 + 20 + 30 = 72
    end
}
