// Test typed struct variables and type aliases
// Demonstrates the intended syntax for storing structs in typed variables
// Note: These examples show the desired language syntax but may not compile
// with the current type checker due to named type vs record type issues

struct Point {
    x: int64,
    y: int64
}

struct Person {
    name: string,
    age: int64
}

// Type alias for Point
type PointAlias = Point;

// Type alias for Person
type PersonAlias = Person;

// Type alias for coordinate pair
type CoordPair = (int64, int64);

fn test_struct_in_typed_variable() -> int64 {
    do
        // Example 1: Store struct in typed variable (desired syntax)
        // This demonstrates the intended language feature
        center:Point <- Point { x: 10, y: 20 };

        // Access field from stored struct variable
        center.x
    end
}

fn test_struct_alias_in_typed_variable() -> int64 {
    do
        // Example 2: Store struct with type alias in typed variable (desired syntax)
        // Demonstrates aliased struct storage
        aliased_point:PointAlias <- Point { x: 5, y: 15 };

        // Access field from aliased struct variable
        aliased_point.x
    end
}

fn test_person_struct_examples() -> int64 {
    do
        // Example 3: Person struct with different field types (desired syntax)
        // Shows structs with mixed field types (string, int64)
        person:Person <- Person { name: "Alice", age: 30 };

        // Access field from person struct variable
        person.age
    end
}

fn test_person_alias_example() -> int64 {
    do
        // Example 4: Person struct with alias (desired syntax)
        // Demonstrates aliased struct storage with mixed types
        person_alias:PersonAlias <- Person { name: "Bob", age: 25 };

        // Access field from aliased person struct variable
        person_alias.age
    end
}

fn test_working_typed_variables() -> int64 {
    do
        // Example 5: Working typed variables (tuples work with current type checker)
        coords:(int64, int64) <- (10, 20);
        (x:int64, y:int64) <- coords;

        // Example 6: Type alias usage with tuples (also works)
        pair:CoordPair <- (5, 15);

        x + y  // Returns 10 + 20 = 30
    end
}

fn main() -> int64 {
    do
        // Test each function individually to avoid complex expression chaining
        result1:int64 <- test_struct_in_typed_variable();
        result2:int64 <- test_struct_alias_in_typed_variable();
        result3:int64 <- test_person_struct_examples();
        result4:int64 <- test_person_alias_example();
        result5:int64 <- test_working_typed_variables();

        // Return sum of all results
        result1 + result2 + result3 + result4 + result5
    end
}
