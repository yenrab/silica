// Simple tuple decomposition examples

fn get_coordinates() -> (int, int, int) {
    (10, 20, 30)
}

fn main() -> int proc[DeviceIO] {
    do
        // Create and decompose a tuple
        point <- (5, 10, false);
        (x:int, y:int, ignore:boolean) <- point;

        // Debug prints for first tuple
        print_int(x);
        print_int(y);
        print_bool(ignore);

        // Decompose function result
        coords <- get_coordinates();
        (a: int, b: int, c: int) <- coords;

        // Debug prints for second tuple
        print_int(a);
        print_int(b);
        print_int(c);

        // Calculate sum
        x + y + a + b + c//75
    end
}
