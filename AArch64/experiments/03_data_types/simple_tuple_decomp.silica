// Simple tuple decomposition examples

fn get_coordinates() -> (int64, int64, int64) {
    (10, 20, 30)
}

fn main() -> int64 proc[DeviceIO] {
    do
        // Create and decompose a tuple
        point:(int64, int64, boolean) <- (5, 10, false);
        (x:int64, y:int64, ignore:boolean) <- point;

        // Debug prints for first tuple
        print_int64(x);
        print_int64(y);
        print_bool(ignore);

        // Decompose function result
        coords:(int64,int64,int64) <- get_coordinates();
        (a: int64, b: int64, c: int64) <- coords;

        // Debug prints for second tuple
        print_int64(a);
        print_int64(b);
        print_int64(c);

        // Calculate sum
        x + y + a + b + c//75
    end
}
