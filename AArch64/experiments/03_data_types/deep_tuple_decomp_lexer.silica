// Module: Lexer-like types for deep tuple decomp stress test
// Mimics lexer_runner - Token, ListToken, empty_token_list (lexer nil, kind 0)
// One of TWO different ListToken nil implementations (lexer style)

use deep_tuple_decomp_ast;

struct Token {
    kind: int64,
    lexeme: string,
    loc: Loc
}

struct ListToken {
    is_nil: bool,
    head: Token,
    tail: ListToken
}

// Lexer nil: dummy token kind 0 (mimics lexer_runner empty_token_list)
fn empty_token_list() -> ListToken {
    dummy_token: Token <- Token { kind: 0, lexeme: "", loc: deep_tuple_decomp_ast@zero_loc() };
    nil_placeholder: ListToken <- ListToken { is_nil: true, head: dummy_token, tail: nil_placeholder };
    nil_placeholder
}

// Build list ending with lexer nil - for passing to parser reverse (mixes two nil styles)
fn build_simple_list() -> ListToken {
    eof_tok: Token <- Token { kind: 50, lexeme: "", loc: deep_tuple_decomp_ast@zero_loc() };
    lexer_nil: ListToken <- empty_token_list();
    ListToken { is_nil: false, head: eof_tok, tail: lexer_nil }
}
