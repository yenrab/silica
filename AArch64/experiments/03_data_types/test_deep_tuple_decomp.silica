// Stress test: deep, complex tuple decomposition with MULTIPLE MODULES
// Mimics parser crash scenario to stress bootstrap compiler:
// 1. Cross-module types: Loc, Expr, Decl, ListDecl from ast; Token, ListToken from lexer
// 2. Two different ListToken nil implementations: lexer (kind 0) vs parser (kind 50)
// 3. Tuple return from recursive function across module boundary
// 4. 5-tuple destructuring in proc[DeviceIO] caller

use deep_tuple_decomp_ast;
use deep_tuple_decomp_lexer;
use deep_tuple_decomp_parser;

fn main() -> int64 proc[DeviceIO] {
    do
        // Stress 1: destructure 5-tuple from parser module (cross-module types)
        result: (bool, ListDecl, ListToken, string, Loc) <- deep_tuple_decomp_parser@make_result();
        (ok: bool, decls: ListDecl, rest: ListToken, err_msg: string, err_loc: Loc) <- result;
        // Stress 2: destructure from recursive return (mimics parse_declarations)
        result2: (bool, ListDecl, ListToken, string, Loc) <- deep_tuple_decomp_parser@make_result_rec(3);
        (ok2: bool, decls2: ListDecl, rest2: ListToken, err_msg2: string, err_loc2: Loc) <- result2;
        // Stress 3: list built from lexer nil, reversed with parser nil (mixes both implementations)
        result3: (bool, ListDecl, ListToken, string, Loc) <- deep_tuple_decomp_parser@make_result_with_reversed_list();
        (ok3: bool, decls3: ListDecl, rest3: ListToken, err_msg3: string, err_loc3: Loc) <- result3;
        // If we get here without crash, return 42
        42
    end
}
