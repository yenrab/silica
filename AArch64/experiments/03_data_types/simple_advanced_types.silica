// Test advanced type features

// Function returning a tuple type
fn make_pair(first: int64, second: boolean) -> (int64, boolean) {
    (first, second)
}

fn main() -> int64 {
    do
        // Test function returning tuple
        pair:(int64,boolean) <- make_pair(42, true);

        // Decompose the tuple
        (num: int64, flag: boolean) <- pair;

        // Return the numeric value
        num
    end
}
