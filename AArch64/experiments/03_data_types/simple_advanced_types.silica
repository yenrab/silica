// Test advanced type features

// Function returning a tuple type
fn make_pair(first: int, second: boolean) -> (int, boolean) {
    (first, second)
}

fn main() -> int {
    do
        // Test function returning tuple
        pair <- make_pair(42, true);

        // Decompose the tuple
        (num, flag) <- pair;

        // Return the numeric value
        num
    end
}
