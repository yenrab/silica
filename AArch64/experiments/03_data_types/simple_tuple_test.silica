// Simple tuple test
// NOTE: Implementation now uses precise type-preserving tuple storage
// (42, true) is stored as i64=42 and i1=1 in memory with correct layout
// Memory allocation: 9 bytes (8 for i64 + 1 for i1, properly aligned)
fn main() -> int {
    do
        tuple <- (42, true);
        (x: int, y: bool) <- tuple;
        thruple <- (true,"hello",15);
        (_: boolean, message: string, _: int) <- thruple;
        x  // Return the integer element (42)
    end
}
