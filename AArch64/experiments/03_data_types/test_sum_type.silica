// Test sum types (enums/variants)
enum Option<T> {
    Some(T),
    None
}

enum Result<T, E> {
    Ok(T),
    Error(E)
}

fn test_option() -> int {
    // Test enum declaration and basic usage
    // For now, just return a value to verify compilation
    42
}

fn test_result() -> int {
    // Test enum with multiple type parameters
    // For now, just return a value to verify compilation
    24
}

fn main() -> int {
    do
        opt_val <- test_option();
        res_val <- test_result();
        opt_val + res_val  // Should return 42 + 24 = 66
    end
}
