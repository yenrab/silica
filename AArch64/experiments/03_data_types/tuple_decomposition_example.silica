// Example demonstrating full runtime pattern matching in case expressions
// Tests literal patterns (int/bool), tuple patterns, and proper branching

fn test_tuple_decomposition() -> int {
    do
        // Test integer literal patterns
        result1:int <- case 42 of {
            42 -> 100;
            24 -> 200;
            _:int -> 0
        };

        // Test boolean literal patterns
        result2:int <- case true of {
            true -> 10;
            false -> 20;
            _:boolean -> 0
        };

        // Test tuple patterns (simplified - always matches first tuple pattern)
        person:(int, int, boolean) <- (42, 30, true);
        result3:int <- case person of {
            (x:int, y:int, z:boolean) -> 5;  // Tuple pattern matches
            _:(int,int,boolean) -> 0
        };

        // Return combination of results: 100 + 10 + 5 = 115
        result1 + result2 + result3
    end
}

// fn swap_pair(pair: (int, int)) -> (int, int) {
//     case pair of {
//         (a, b) -> (b, a)
//         _:(int,int) -> (0, 0)
//     }
// }

fn main() -> int {
    test_tuple_decomposition()
}
