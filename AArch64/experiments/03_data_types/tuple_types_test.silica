// Test tuple types and expressions (without case expressions)

// Concrete tuple type aliases (generics not yet supported)
type IntBoolPair = (int, boolean);
type IntTriple = (int, int, int);

// Test tuple expressions and type aliases
fn test_tuple_types() -> int {
    do
        // Create tuples
        pair:(int, boolean) <- (42, true);
        triple:(int, int, int) <- (1, 2, 3);

        // Test that types work
        pair2:(int, boolean) <- (100, false);
        triple2:(int, int, int) <- (10, 20, 30);

        // Test tuple decomposition (pattern matching)
        (first: int, second: int, third: int) <- triple;     // Decompose triple
        (int_val: int, bool_val: boolean) <- pair;           // Decompose pair

        // Do some computation with decomposed values
        sum:int <- first + second + third;  // 1 + 2 + 3 = 6

        // Return the computed result directly
        sum + int_val  // 6 + 42 = 48
    end
}

fn main() -> int {
    test_tuple_types()
}
