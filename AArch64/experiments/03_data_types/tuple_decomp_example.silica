// Tuple decomposition examples in Silica

fn make_point() -> (boolean, int) {
    (true, 300)  // Reduced values to avoid exit code wrapping
}

fn main() -> int {
    do
        // Decompose directly from function call
        (_, y) <- make_point();
        
        // Decompose from tuple literal
        (a, b, c) <- (1, 2, 3);
        
        // Calculate result: 300 + 1 + 2 + 3 = 306
        y + a + b + c
    end
}
