// Tuple decomposition examples in Silica

fn make_point() -> (boolean, int64) {
    (true, 300)  // Reduced values to avoid exit code wrapping
}

fn main() -> int64 proc[DeviceIO] {
    do
        // Create tuple from function call
        point:(boolean, int64) <- make_point();

        // Decompose the tuple
        (dummy: boolean, y: int64) <- point;

        // Create tuple literal
        triple:(int64, int64, int64) <- (1, 2, 3);

        // Decompose from tuple
        (a: int64, b: int64, c: int64) <- triple;

        // Calculate result: 300 + 1 + 2 + 3 = 306 (306 % 2)
        y + a + b + c
    end
}
