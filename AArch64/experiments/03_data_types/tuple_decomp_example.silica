// Tuple decomposition examples in Silica

fn make_point() -> (boolean, int) {
    (true, 300)  // Reduced values to avoid exit code wrapping
}

fn main() -> int proc[DeviceIO] {
    do
        // Create tuple from function call
        point <- make_point();

        // Decompose the tuple
        (dummy: boolean, y: int) <- point;

        // Create tuple literal
        triple <- (1, 2, 3);

        // Decompose from tuple
        (a: int, b: int, c: int) <- triple;

        // Calculate result: 300 + 1 + 2 + 3 = 306
        y + a + b + c
    end
}
