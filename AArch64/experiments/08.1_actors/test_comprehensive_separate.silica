// Comprehensive actor state types test - separate functions
// Each test case in its own function to avoid multiple statements in main

fn test_int_state() -> int64 proc[concurrency] {
    spawn(42, fn(msg: int64, state: int64) -> int64 { state });
    0
}

fn test_negative_int_state() -> int64 proc[concurrency] {
    spawn(-10, fn(msg: int64, state: int64) -> int64 { state });
    0
}

fn test_bool_true_state() -> int64 proc[concurrency] {
    spawn(true, fn(msg: int64, state: int64) -> int64 { state });
    0
}

fn test_bool_false_state() -> int64 proc[concurrency] {
    spawn(false, fn(msg: int64, state: int64) -> int64 { state });
    0
}

fn test_tuple_state() -> int64 proc[concurrency] {
    spawn((1, 2), fn(msg: int64, state: (int64, int64)) -> (int64, int64) { state });
    0
}

fn test_expr_state() -> int64 proc[concurrency] {
    spawn(10 + 5, fn(msg: int64, state: int64) -> int64 { state });
    0
}

fn test_var_state() -> int64 proc[concurrency] {
    x:int64 <- 100;
    spawn(x, fn(msg: int64, state: int64) -> int64 { state });
    0
}

fn main() -> int64 proc[concurrency] {
    // Call all test functions
    test_int_state();
    test_negative_int_state();
    test_bool_true_state();
    test_bool_false_state();
    test_tuple_state();
    test_expr_state();
    test_var_state();
    0
}
