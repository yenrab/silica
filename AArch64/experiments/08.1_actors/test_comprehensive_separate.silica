// Comprehensive actor state types test - separate functions
// Each test case in its own function to avoid multiple statements in main

fn test_int_state() -> int proc[concurrency] {
    spawn(42, fn(msg: int, state: int) -> int { state })
}

fn test_negative_int_state() -> int proc[concurrency] {
    spawn(-10, fn(msg: int, state: int) -> int { state })
}

fn test_bool_true_state() -> int proc[concurrency] {
    spawn(true, fn(msg: int, state: int) -> int { state })
}

fn test_bool_false_state() -> int proc[concurrency] {
    spawn(false, fn(msg: int, state: int) -> int { state })
}

fn test_tuple_state() -> int proc[concurrency] {
    spawn((1, 2), fn(msg: int, state: (int, int)) -> (int, int) { state })
}

fn test_expr_state() -> int proc[concurrency] {
    spawn(10 + 5, fn(msg: int, state: int) -> int { state })
}

fn test_var_state() -> int proc[concurrency] {
    x:int <- 100;
    spawn(x, fn(msg: int, state: int) -> int { state })
}

fn main() -> int proc[concurrency] {
    // Call all test functions
    test_int_state();
    test_negative_int_state();
    test_bool_true_state();
    test_bool_false_state();
    test_tuple_state();
    test_expr_state();
    test_var_state();
    0
}
