// Test demonstrating that actor states can be various Silica types
// This shows the general solution for handling different initial state types

fn main() -> int proc[concurrency] {
    // Integer literals as states
    spawn(0, fn(msg: int, state: int) -> int { state });        // i64 state
    spawn(42, fn(msg: int, state: int) -> int { state });       // i64 state
    spawn(-10, fn(msg: int, state: int) -> int { state });      // i64 state

    // Boolean literals converted to integers (0/1)
    spawn(true, fn(msg: int, state: int) -> int { state });     // i1 true -> i64 1
    spawn(false, fn(msg: int, state: int) -> int { state });    // i1 false -> i64 0

    // All states are properly converted to i64 for runtime compatibility
    // This provides a general solution that works with the current runtime
}
