// Test function literals used in future actor behaviors
// Demonstrates the primary use case for function literals in Silica

fn main() -> int64 {
    // Test 1: Simple counter literal using function literal
    initial_count:int64 <- 0;
    counter_behavior: fn(int64, int64) -> int64 <- fn(msg: int64, state: int64) -> int64 {
        // Increment counter by message value
        state + msg
    };

    // Test 2: Message handler literal
    message_handler: fn(int64, int64) -> int64 <- fn(msg: int64, state: int64) -> int64 {
        case msg of {
            1 -> state + 1;     // Increment
            2 -> state - 1;     // Decrement
            3 -> 0;             // Reset
            _ : int64 -> state;         // No change
        }
    };

    // Test 3: literal with captured data
    max_value:int64 <- 100;
    min_value:int64 <- 0;
    bounded_counter: fn(int64, int64) -> int64 <- fn(msg: int64, state: int64) -> int64 {
        new_state:int64 <- state + msg;
        // Clamp to bounds (captures max_value and min_value)
        // Simplified for now - bounds checking would require if/else or case
        new_state
    };

    // Test 4: Complex literal behavior with captured variables
    complex_behavior: fn(int64, int64) -> int64 <- fn(msg: int64, state: int64) -> int64 {
        // literal behavior that captures configuration
        max_val:int64 <- 100;
        min_val:int64 <- 0;
        new_state:int64 <- state + msg;

        // Simple bounds checking using arithmetic
        // For now, just return new_state (bounds checking would need if/else or case)
        new_state
    };

    // Return success - full actor system not yet implemented
    0
}
