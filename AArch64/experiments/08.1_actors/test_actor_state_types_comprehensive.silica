// Comprehensive test for actor states of various Silica types
// This tests the general solution for any valid Silica type as actor state

fn main() -> int64 proc[concurrency] {
    do
        // Test 1: Integer states
        spawn(0, fn(msg: int64, state: int64) -> int64 { state });
        spawn(42, fn(msg: int64, state: int64) -> int64 { state });
        spawn(-10, fn(msg: int64, state: int64) -> int64 { state });

        // Test 2: Boolean states
        spawn(true, fn(msg: int64, state: int64) -> int64 { state });
        spawn(false, fn(msg: int64, state: int64) -> int64 { state });

        // Test 3: Tuple states
        spawn((1, 2), fn(msg: int64, state: (int64, int64)) -> (int64, int64) { state });

        // Test 4: Complex expression states
        spawn(10 + 5, fn(msg: int64, state: int64) -> int64 { state });

        // Test 5: Variable states
        initial:int64 <- 100;
        spawn(initial, fn(msg: int64, state: int64) -> int64 { state });

        // Return value
        0
    end
}
