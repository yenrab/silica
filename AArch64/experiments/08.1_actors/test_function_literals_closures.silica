// Test function literals with captured variables (closures)
// Demonstrates variable capture from outer scope

fn main() -> int {
    // Test 1: Simple variable capture
    multiplier <- 2;
    multiply_by_two <- fn(x: int) -> int {
        x * multiplier  // Captures 'multiplier' from outer scope
    };

    // Test 2: Multiple captured variables
    base <- 10;
    increment <- 5;
    complex_calc <- fn(x: int) -> int {
        (x + increment) * base
    };

    // Test 3: Capture in nested functions
    outer_var <- 100;
    outer_func <- fn() -> int {
        inner_var <- 50;
        inner_func <- fn(x: int) -> int {
            x + outer_var + inner_var  // Captures both variables
        };
        42  // Return placeholder
    };

    // Test 4: Mutable capture (when supported)
    // counter <- 0;
    // increment_counter <- fn() -> int {
    //     counter = counter + 1;
    //     counter
    // };

    // Test 5: Closure in actor behavior (the main use case)
    behavior_state <- 1000;
    actor_behavior <- fn(msg: int, state: int) -> int {
        // In a real actor, this would process messages and update state
        // Here we capture behavior_state from the outer scope
        state + msg + behavior_state
    };

    // Return success - closure capture not yet fully implemented
    0
}
