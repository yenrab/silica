// Test core affinity system for actors
// Demonstrates spawning actors with various core affinity options

fn main() -> int proc[concurrency] {
    do
        // Test 1: Spawn actor on specific core (core 1)
        spawn(0, fn(msg: int, state: int) -> int { state + msg }, 1);

        // Test 2: Spawn actor on specific core (core 2)
        spawn(10, fn(msg: int, state: int) -> int { state * msg }, 2);

        // Test 3: Spawn actor with load balancing (any available core)
        spawn(5, fn(msg: int, state: int) -> int { state - msg });

        // Test 4: Spawn actor with explicit "any core" affinity
        spawn(100, fn(msg: int, state: int) -> int { state / 2 }, 0);

        // Test 5: Spawn actor on performance cores (load balanced within performance cores)
        spawn(20, fn(msg: int, state: int) -> int { state + msg * 2 }, performance_cores);

        // Test 6: Spawn actor on efficiency cores (load balanced within efficiency cores)
        spawn(30, fn(msg: int, state: int) -> int { state - msg }, efficiency_cores);

        // Test 7: Spawn actor using any_core identifier
        spawn(40, fn(msg: int, state: int) -> int { state * 3 }, any_core);

        0
    end
}
