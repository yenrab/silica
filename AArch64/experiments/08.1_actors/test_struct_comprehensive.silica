// Comprehensive test of structs in spawn calls
// Tests complex struct allocation and mixing with other types (full field access after bootstrap self-compilation)

type Message = { action: string, data: int64, priority: bool };
type State = { counter: int64, history: (int64, int64, int64), enabled: bool, threshold: int64 };

impl ActorState for State { }
impl ActorState for Message { }

fn main() -> int64 proc[concurrency] {
    // Actor with complex nested struct initial state
    spawn(State {
        counter: 0,
        history: (0, 0, 0),
        enabled: true,
        threshold: 100
    }, fn(msg: int64, state: int64) -> int64 {
        msg + 1  // TODO: Will become: if state.enabled { state.counter + msg } else { msg }
    });

    // Actor with simple struct initial state
    spawn(Message { action: "init", data: 1, priority: true }, fn(msg: int64, state: int64) -> int64 {
        msg + 1  // TODO: Will access message and state fields
    });

    // Actor with mixed initial state types
    spawn(42, fn(msg: int64, state: int64) -> int64 {
        state + msg  // Simple integer state (works now)
    });

    // Actor with another struct initial state
    spawn(Message {
        action: "simple",
        data: 20,
        priority: false
    }, fn(msg: int64, state: int64) -> int64 {
        msg + 1  // TODO: Will access message fields like: msg.data + state.value
    });

    0
}
