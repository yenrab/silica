// Test moderate statements
fn main() -> int proc[concurrency] {
    // Integer state
    spawn(42, fn(msg: int, state: int) -> int { state });
    // Boolean state
    spawn(true, fn(msg: int, state: int) -> int { state });
    // Variable state
    x:int <- 100;
    spawn(x, fn(msg: int, state: int) -> int { state })
}
