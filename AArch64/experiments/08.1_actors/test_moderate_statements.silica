// Test moderate statements
fn main() -> int64 proc[concurrency] {
    // Integer state
    spawn(42, fn(msg: int64, state: int64) -> int64 { state });
    // Boolean state
    spawn(true, fn(msg: int64, state: int64) -> int64 { state });
    // Variable state
    x:int64 <- 100;
    spawn(x, fn(msg: int64, state: int64) -> int64 { state });
    0  // Return value
}
