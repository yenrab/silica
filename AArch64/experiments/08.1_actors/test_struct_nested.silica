// Test nested structs in spawn calls
// Tests deeply nested struct allocation (cannot access fields in behavior functions)

type Address = { street: string, city: string, zip: int64 };
type Person = { name: string, age: int64, address: Address, active: bool };
type Company = { name: string, employees: int64, hq: Address, founded: int64 };
type NestedLevel3 = { value: int64, flag: bool };
type NestedData = { level1: { level2: NestedLevel3 } };

// Implement ActorState trait for types used as actor initial state
impl ActorState for Person { }
impl ActorState for Company { }

fn main() -> int64 proc[concurrency] {
    // Actor with deeply nested struct initial state
    spawn(Person {
        name: "John Doe",
        age: 30,
        address: Address { street: "123 Main St", city: "Anytown", zip: 12345 },
        active: true
    }, fn(msg: int64, state: int64) -> int64 {
        msg + 1  // Cannot access state fields in bootstrap compiler
    });

    // Actor with nested struct initial state
    spawn(Company {
        name: "Tech Corp",
        employees: 100,
        hq: Address { street: "456 Business Ave", city: "Metropolis", zip: 67890 },
        founded: 2000
    }, fn(msg: int64, state: int64) -> int64 {
        msg + 1  // Cannot access state fields in bootstrap compiler
    });

    // Actor with simpler nested struct initial state
    spawn(Person {
        name: "Jane Smith",
        age: 28,
        address: Address { street: "321 Oak Ave", city: "Somewhere", zip: 54321 },
        active: true
    }, fn(msg: int64, state: int64) -> int64 {
        msg + 1  // Cannot access nested state fields in bootstrap compiler
    });

    0
}
