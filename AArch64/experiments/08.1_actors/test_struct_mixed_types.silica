// Test mixing structs with other Silica types in spawn calls
// Tests complex combinations of structs, tuples, primitives (cannot access fields in behavior functions)

type UserProfile = { id: int, name: string, active: bool };
type SystemStatus = { uptime: int, users: int, healthy: bool };
type RequestData = { user: UserProfile, action: string, params: (int, bool, string) };

impl ActorState for SystemStatus { }
impl ActorState for UserProfile { }

fn main() -> int proc[concurrency] {
    // Actor with struct initial state
    spawn(SystemStatus { uptime: 0, users: 0, healthy: true }, fn(msg: int, state: int) -> int {
        msg + 1  // Cannot access state fields in bootstrap compiler
    });

    // Actor with another struct initial state
    spawn(UserProfile { id: 1, name: "admin", active: false }, fn(msg: int, state: int) -> int {
        msg + 1  // Cannot access state fields in bootstrap compiler
    });

    // Actor with tuple containing struct as initial state
    spawn((UserProfile { id: 100, name: "test", active: true }, 42, false, "initial"), fn(msg: int, state: int) -> int {
        msg + 1  // Cannot access tuple elements in bootstrap compiler
    });

    // Actor with computed expression as initial state
    spawn(10 + 5, fn(msg: int, state: int) -> int {
        state + msg  // Simple operation
    });

    // Actor with simple struct initial state
    spawn(UserProfile { id: 42, name: "simple_user", active: true }, fn(msg: int, state: int) -> int {
        msg + 1  // Cannot access state fields in bootstrap compiler
    });

    0
}
