// Test that behavior functions can return different types
// Demonstrates the infrastructure for generic return types

type TestStruct = { value: int, flag: bool, name: string };

fn main() -> int proc[concurrency] {

    // Behavior function with int state, returning int
    spawn(42, fn(msg: int, state: int) -> int {
        state + msg  // Both state and return are int
    });

    // Behavior function with int state, returning bool (different type)
    spawn(42, fn(msg: int, state: int) -> bool {
        msg > 50  // State is int, return is bool
    });

    // Behavior function with struct state, returning struct (same type)
    spawn(TestStruct { value: 10, flag: false, name: "initial" }, fn(msg: int, state: TestStruct) -> TestStruct {
        TestStruct { value: state.value + msg, flag: state.flag, name: state.name }  // Return modified struct
    });

    0
}
