// Test that behavior functions can return different types
// Demonstrates the infrastructure for generic return types

type TestStruct = { value: int64, flag: bool, name: string };

// Implement ActorState trait for type used as actor initial state
impl ActorState for TestStruct { }

fn main() -> int64 proc[concurrency] {

    // Behavior function with int64 state, returning int64
    spawn(42, fn(msg: int64, state: int64) -> int64 {
        state + msg  // Both state and return are int64
    });

    // Behavior function with int64 state, returning bool (different type)
    spawn(42, fn(msg: int64, state: int64) -> bool {
        msg > 50  // State is int64, return is bool
    });

    // Behavior function with struct state, returning struct (same type)
    spawn(TestStruct { value: 10, flag: false, name: "initial" }, fn(msg: int64, state: TestStruct) -> TestStruct {
        TestStruct { value: state.value + msg, flag: state.flag, name: state.name }  // Return modified struct
    });

    0
}
