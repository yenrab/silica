// Test spawning actors with different types of initial states

fn main() -> int64 proc[concurrency] {
    // Test 1: Integer literal state (0)
    spawn(0, fn(msg: int64, state: int64) -> int64 { state + msg });

    // Test 2: Different integer literal state (42)
    spawn(42, fn(msg: int64, state: int64) -> int64 { state + msg });

    // Test 3: Boolean literal state 
    spawn(true, fn(msg: int64, state: int64) -> int64 { state + msg });

    // Test 4: Boolean literal state
    spawn(false, fn(msg: int64, state: int64) -> int64 { state + msg });

    42 // Return value
}
