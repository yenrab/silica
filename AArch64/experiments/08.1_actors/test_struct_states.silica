// Test using structs as actor states
// Tests actors with struct initial states (field access will be enabled after bootstrap compiler self-compilation)

type CounterState = { counter: int64, name: string, active: bool };
type Stats = { operations: int64, last_value: int64 };
type Config = { enabled: bool, max_ops: int64 };
type ComplexState = { stats: Stats, config: Config };

impl ActorState for CounterState { }
impl ActorState for Stats { }
impl ActorState for Config { }
impl ActorState for ComplexState { }

fn main() -> int64 proc[concurrency] {
    // Actor with struct initial state - demonstrates struct allocation
    spawn(CounterState { counter: 0, name: "counter", active: true }, fn(msg: int64, state: int64) -> int64 {
        msg  // TODO: Will become: state.counter + msg (after Priority 1 completion)
    });

    // Actor with nested struct initial state
    spawn(ComplexState {
        stats: Stats { operations: 0, last_value: 0 },
        config: Config { enabled: true, max_ops: 50 }
    }, fn(msg: int64, state: int64) -> int64 {
        msg * 2  // TODO: Will become: state.stats.operations + msg (after Priority 1 completion)
    });

    0
}
