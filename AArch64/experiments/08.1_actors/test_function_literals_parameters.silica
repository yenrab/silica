// Test function literals with parameters
// Demonstrates parameter handling in function literals

fn main() -> int {
    // Test 1: Single parameter function
    double <- fn(x: int) -> int { x * 2 };

    // Test 2: Multiple parameters function
    add <- fn(a: int, b: int) -> int { a + b };

    // Test 3: Function with different parameter types
    mixed <- fn(x: int, y: bool) -> int { x };

    // Test 4: Simple outer function
    outer <- fn() -> int { 42 };

    // Test 5: Function literal in complex expression
    complex <- fn(n: int) -> int { n * 2 };

    // Return success
    0
}
