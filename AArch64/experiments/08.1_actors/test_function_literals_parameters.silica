// Test function literals with parameters
// Demonstrates parameter handling in function literals

fn main() -> int {
    // Test 1: Single parameter function
    double <- fn(x: int) -> int { x * 2 };

    // Test 2: Multiple parameters function
    add <- fn(a: int, b: int) -> int { a + b };

    // Test 3: Function with different parameter types (when supported)
    // mixed <- fn(x: int, y: bool) -> int { if y { x } else { 0 } };

    // Test 4: Nested function literals
    outer <- fn() -> int {
        inner <- fn(x: int) -> int { x + 10 };
        42  // Return a constant for now
    };

    // Test 5: Function literal in complex expression
    complex <- fn(n: int) -> int {
        temp <- n + 1;
        temp * 2
    };

    // Return success
    0
}
