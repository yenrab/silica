// Test using structs in spawn calls and initial states
// Tests struct allocation and storage (cannot return structs from behavior functions in bootstrap compiler)

type OperationResult = { success: bool, value: int, message: string };
type ComputationResult = { input: int, output: int, method: string };

impl ActorState for OperationResult { }
impl ActorState for ComputationResult { }

fn main() -> int proc[concurrency] {
    // Actor with struct initial state (cannot return structs from behavior functions)
    spawn(OperationResult {
        success: true,
        value: 42,
        message: "initial state"
    }, fn(msg: int, state: int) -> int {
        msg + 1  // Cannot return structs in bootstrap compiler
    });

    // Actor with another struct initial state
    spawn(ComputationResult {
        input: 0,
        output: 0,
        method: "none"
    }, fn(msg: int, state: int) -> int {
        msg * 2  // Cannot return structs in bootstrap compiler
    });

    0
}
