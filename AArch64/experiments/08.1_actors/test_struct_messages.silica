// Test using structs as messages in actor communication
// Tests sending struct messages between actors (field access after bootstrap self-compilation)

type Message = { command: string, value: int };
type Response = { status: string, result: int };

fn main() -> int proc[concurrency] {
    // Spawn an actor that receives struct messages
    spawn(0, fn(msg: Message, state: int) -> int {
        state + 1  // TODO: Will become: if msg.command == "increment" { state + msg.value } else { state }
    });

    // Spawn another actor with struct initial state
    spawn(Message { command: "init", value: 100 }, fn(msg: Message, state: int) -> int {
        state + 1  // TODO: Will access both msg and state fields after Priority 1 completion
    });

    0
}
