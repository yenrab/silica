// Test spawning actors with various types of initial states

fn echo_behavior(msg: int, state: int) -> int {
    state  // Just return the current state
}

fn main() -> int proc[concurrency] {
    // Test 1: Integer literal states
    spawn(0, echo_behavior);
    spawn(42, echo_behavior);
    spawn(-10, echo_behavior);

    // Test 2: Boolean literal states (converted to 0/1)
    spawn(true, echo_behavior);
    spawn(false, echo_behavior);

    // Test 3: Variable states
    initial_val:int <- 100;
    spawn(initial_val, echo_behavior);

    0
}
