fn factorial(n: int) -> int {
    case n <= 1 of {
        true -> 1
        false -> n * factorial(n - 1)
    }
}

fn fibonacci(n: int) -> int {
    case n <= 1 of {
        true -> n
        false -> fibonacci(n - 1) + fibonacci(n - 2)
    }
}

fn complex_calculation(x: int, y: int) -> int {
    x * 2 + y / 3 - 1
}

fn process_number(n: int) -> int {
    case n % 2 == 0 of {
        true -> complex_calculation(n, n + 5) + factorial(n / 2)
        false -> n + 1
    }
}

fn main() -> int {
    factorial(5) + fibonacci(7) + process_number(6)  // 120 + 13 + 22 = 155
}