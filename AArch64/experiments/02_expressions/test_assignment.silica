// Assignment test - demonstrates single-binding semantics in Silica
// Variables can only be bound once. Reassignment is not allowed.
fn main() -> int {
    do
        // Test basic variable binding (each variable bound exactly once)
        x:int <- 10;
        y:int <- 20;
        z:int <- x + y;  // z is bound to the result of x + y (30)

        // Test chained computations using different variables
        a:int <- z * 2;  // a is bound to z * 2 (60)
        b:int <- a - 10; // b is bound to a - 10 (50)

        // Return final result - this should compile and run successfully
        b
    end
}

// Note: Silica enforces single binding per variable. Attempting to bind
// the same variable name twice in the same scope causes a compilation error.
// This is demonstrated in test_invalid_reassignment.silica
