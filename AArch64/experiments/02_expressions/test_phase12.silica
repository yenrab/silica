// Test Phase 1.2: Memory & Effects System

fn test_memory_operations() -> int {
    // Test reference counting operations
    let region = region();
    let ref1 = alloc_ref(region, 42);
    let ref2 = clone_ref(ref1);  // Increment reference count
    let value = read_ref(ref1);  // Should be 42
    let is_unique = is_unique_ref(ref1);  // Should be false (count = 2)
    drop_ref(ref2);  // Decrement reference count
    let is_unique_now = is_unique_ref(ref1);  // Should be true (count = 1)
    
    // Test garbage collection
    collect_garbage();
    
    value
}

fn main() -> int {
    test_memory_operations()
}
