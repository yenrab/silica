// Test Strategy Pattern with Traits
// Demonstrates how traits enable the Strategy design pattern

trait SortingStrategy {
    fn sort(self: Self) -> int;
}

trait SearchStrategy {
    fn search(self: Self) -> int;
}

// Concrete strategy implementations
struct QuickSort {
    pivot: int
}

struct BinarySearch {
    sorted: int  // flag indicating if data is sorted
}

impl SortingStrategy for QuickSort {
    fn sort(self: QuickSort) -> int {
        // Simulate quicksort with pivot
        case 10 > self.pivot of {
            true -> 10 - self.pivot   // "sort" by subtracting pivot
            false -> 10 + self.pivot  // "sort" by adding pivot
        }
    }
}

impl SearchStrategy for BinarySearch {
    fn search(self: BinarySearch) -> int {
        case self.sorted > 0 of {
            true -> self.sorted     // Return sorted flag for now
            false -> -2             // Data not sorted, can't search
        }
    }
}

// Algorithm that uses strategies
struct DataProcessor {
    value: int
}

impl SortingStrategy for DataProcessor {
    fn sort(self: DataProcessor) -> int {
        // Use quicksort strategy
        self.value  // Simplified
    }
}

impl SearchStrategy for DataProcessor {
    fn search(self: DataProcessor) -> int {
        // Use binary search strategy
        self.value  // Simplified
    }
}

fn main() -> int {
    do
        // Test different strategies
        quick:QuickSort <- QuickSort { pivot: 10 };
        binary:BinarySearch <- BinarySearch { sorted: 1 };
        processor:DataProcessor <- DataProcessor { value: 25 };

        // Apply sorting strategy
        sorted_result:int <- quick.sort();    // Test quicksort
        sort_result2:int <- processor.sort();  // Test processor sort

        // Apply search strategy
        search_result:int <- binary.search();  // Test binary search
        search_result2:int <- processor.search(); // Test processor search

        // Return combination
        sorted_result + sort_result2 + search_result + search_result2
    end
}

// Expected result: 5 + 30 + (-1) + 5 = 39