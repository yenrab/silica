// Test Builder Pattern with Traits
// Demonstrates fluent interfaces and trait-based builders

trait Builder {
    fn build(self: Self) -> int;
}

trait Configurable {
    fn set_option(self: Self, value: int) -> int;
}

trait Validatable {
    fn validate(self: Self) -> int;
}

// HTTP Request Builder
struct HttpRequestBuilder {
    method: int,    // 1=GET, 2=POST, etc.
    url: int,       // Simplified URL representation
    headers: int,   // Number of headers
    body: int       // Request body size
}

impl Builder for HttpRequestBuilder {
    fn build(self: HttpRequestBuilder) -> int {
        // Build final request: combine all parts
        self.method + self.url + self.headers + self.body
    }
}

impl Configurable for HttpRequestBuilder {
    fn set_option(self: HttpRequestBuilder, value: int) -> int {
        // Set configuration option and return updated builder
        self.method + value  // Simplified: add to method
    }
}

impl Validatable for HttpRequestBuilder {
    fn validate(self: HttpRequestBuilder) -> int {
        // Validate the request configuration
        case self.method > 0 and self.url > 0 of {
            true -> 1;  // Valid
            false -> 0; // Invalid
        }
    }
}

// Advanced builder that extends basic functionality
struct AdvancedHttpBuilder {
    base: int,
    timeout: int,
    retries: int
}

impl Builder for AdvancedHttpBuilder {
    fn build(self: AdvancedHttpBuilder) -> int {
        self.base + self.timeout + self.retries
    }
}

impl Configurable for AdvancedHttpBuilder {
    fn set_option(self: AdvancedHttpBuilder, value: int) -> int {
        self.base + value
    }
}

impl Validatable for AdvancedHttpBuilder {
    fn validate(self: AdvancedHttpBuilder) -> int {
        case self.base > 0 and self.timeout > 0 and self.retries >= 0 of {
            true -> 2;  // Advanced validation passed
            false -> 0; // Invalid
        }
    }
}

// Builder factory and utilities
struct BuilderFactory {
    default_value: int
}

impl Builder for BuilderFactory {
    fn build(self: BuilderFactory) -> int {
        self.default_value * 10  // Factory build result
    }
}

fn create_request_builder(base_config: int) -> int {
    // Factory function that creates builders
    base_config + 100
}

fn main() -> int {
    do
        // Create basic HTTP request builder
        basic_builder:HttpRequestBuilder <- HttpRequestBuilder {
            method: 1,   // GET
            url: 200,    // example.com
            headers: 3,  // 3 headers
            body: 0      // No body for GET
        };

        // Use builder pattern
        configured:int <- basic_builder.set_option(5);  // Set some option
        is_valid:int <- basic_builder.validate();       // Should be 1 (valid)
        built:int <- basic_builder.build();             // 1 + 200 + 3 + 0 = 204

        // Create advanced builder
        advanced_builder:AdvancedHttpBuilder <- AdvancedHttpBuilder {
            base: 50,
            timeout: 30,
            retries: 3
        };

        advanced_valid:int <- advanced_builder.validate();  // Should be 2 (advanced valid)
        advanced_built:int <- advanced_builder.build();     // 50 + 30 + 3 = 83

        // Factory usage
        factory:BuilderFactory <- BuilderFactory { default_value: 7 };
        factory_built:int <- factory.build();  // 7 * 10 = 70

        // Combine results
        configured + is_valid + built + advanced_valid + advanced_built + factory_built
    end
}

// Expected result: (1+5) + 1 + 204 + 2 + 83 + 70 = 6 + 1 + 204 + 2 + 83 + 70 = 366