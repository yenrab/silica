// Test complex sub-trait relationships
// Demonstrates nested trait inheritance and multiple inheritance levels

trait BaseTrait {
    fn base_value(self: Self) -> int;
}

trait MiddleTrait includes BaseTrait {
    fn middle_value(self: Self) -> int;
}

trait TopTrait includes MiddleTrait {
    fn top_value(self: Self) -> int;
}

// Additional independent traits
trait ExtraTrait {
    fn extra_value(self: Self) -> int;
}

trait CombinedTrait includes TopTrait, ExtraTrait {
    fn combined_value(self: Self) -> int;
}

// Complex type that implements everything
type ComplexData = {value: int, scale: int};

impl BaseTrait for ComplexData {
    fn base_value(self: ComplexData) -> int {
        self.value
    }
}

impl MiddleTrait for ComplexData {
    fn middle_value(self: ComplexData) -> int {
        self.value * 2
    }
}

impl TopTrait for ComplexData {
    fn top_value(self: ComplexData) -> int {
        self.value * 3
    }
}

impl ExtraTrait for ComplexData {
    fn extra_value(self: ComplexData) -> int {
        self.scale
    }
}

impl CombinedTrait for ComplexData {
    fn combined_value(self: ComplexData) -> int {
        self.value + self.scale
    }
}

fn test_nested_inheritance(data: ComplexData) -> int {
    do
        base:int <- data.base_value();      // Should be value
        middle:int <- data.middle_value();  // Should be value * 2
        top:int <- data.top_value();        // Should be value * 3
        extra:int <- data.extra_value();    // Should be scale
        combined:int <- data.combined_value(); // Should be value + scale

        base + middle + top + extra + combined
    end
}

fn main() -> int {
    do
        data:ComplexData <- ComplexData { value: 2, scale: 5 };

        // Test all levels of inheritance
        result:int <- test_nested_inheritance(data);

        result
    end
}

// Expected result:
// base: 2, middle: 4, top: 6, extra: 5, combined: 7
// Sum: 2 + 4 + 6 + 5 + 7 = 24