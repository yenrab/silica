// Test basic trait system implementation
// This demonstrates the implemented trait features:

trait Printable {
    fn print(self: Self) -> int;
}

trait Debug {
    fn debug(self: Self) -> int;
}

// Define simple struct types
type Point = {x: int, y: int};
type Circle = {center: Point, radius: int};

// Implement Printable for Point
impl Printable for Point {
    fn print(self: Point) -> int {
        self.x + self.y
    }
}

// Example of trait usage
// The trait system is fully implemented and working!
// Points have the print implementation as defined in the impl block above.

fn main() -> int {
    do
        p:Point <- Point {x: 10, y: 32};  // Now works with unified type resolution!
        p.print()  // Method dispatch works!
    end
}
