// Test Complex Diamond Inheritance with Traits
// Demonstrates sophisticated trait composition with diamond patterns

// Base traits
trait Loggable {
    fn log(self: Self, level: int64) -> int64;
}

trait Serializable {
    fn serialize(self: Self) -> int64;
}

trait Validatable {
    fn validate(self: Self) -> int64;
}

// Intermediate traits that combine base traits
trait Persistent includes Loggable, Serializable {
    fn save(self: Self) -> int64;
}

trait Secure includes Loggable, Validatable {
    fn authenticate(self: Self, token: int64) -> int64;
}

// Advanced trait that combines multiple intermediate traits
trait EnterpriseService includes Persistent, Secure {
    fn process_request(self: Self, request: int64) -> int64;
}

// Utility trait for monitoring
trait Monitorable {
    fn get_metrics(self: Self) -> int64;
}

// Most complex trait combining everything
trait FullEnterpriseSystem includes EnterpriseService, Monitorable {
    fn system_health_check(self: Self) -> int64;
}

// Concrete implementation
struct DatabaseService {
    connections: int64,
    security_level: int64,
    log_level: int64
}

impl Loggable for DatabaseService {
    fn log(self: DatabaseService, level: int64) -> int64 {
        self.log_level + level
    }
}

impl Serializable for DatabaseService {
    fn serialize(self: DatabaseService) -> int64 {
        self.connections + 100  // Serialized connection count
    }
}

impl Validatable for DatabaseService {
    fn validate(self: DatabaseService) -> int64 {
        case self.connections > 0 of {
            true -> 1;  // Valid
            false -> 0; // Invalid
        }
    }
}

impl Persistent for DatabaseService {
    fn save(self: DatabaseService) -> int64 {
        // Save operation: log + serialize
        self.log(1) + self.serialize()
    }
}

impl Secure for DatabaseService {
    fn authenticate(self: DatabaseService, token: int64) -> int64 {
        // Authentication: validate + token check
        self.validate() + token + self.security_level
    }
}

impl EnterpriseService for DatabaseService {
    fn process_request(self: DatabaseService, request: int64) -> int64 {
        // Full enterprise request processing
        self.authenticate(request) + self.save()
    }
}

impl Monitorable for DatabaseService {
    fn get_metrics(self: DatabaseService) -> int64 {
        // System metrics: connections + security
        self.connections + self.security_level
    }
}

impl FullEnterpriseSystem for DatabaseService {
    fn system_health_check(self: DatabaseService) -> int64 {
        // Comprehensive health check
        self.validate() + self.get_metrics() + 1000  // Health bonus
    }
}

// Test the diamond inheritance
fn test_diamond_inheritance() -> int64 {
    do
        service:DatabaseService <- DatabaseService {
            connections: 5,
            security_level: 3,
            log_level: 2
        };

        // Test base trait methods
        log_result:int64 <- service.log(1);           // 2 + 1 = 3
        serialize_result:int64 <- service.serialize(); // 5 + 100 = 105
        validate_result:int64 <- service.validate();   // 1 (valid)

        // Test intermediate trait methods
        save_result:int64 <- service.save();           // 3 + 105 = 108
        auth_result:int64 <- service.authenticate(10); // 1 + 10 + 3 = 14

        // Test advanced trait methods
        process_result:int64 <- service.process_request(5);  // 14 + 108 = 122

        // Test monitoring
        metrics_result:int64 <- service.get_metrics(); // 5 + 3 = 8

        // Test full system
        health_result:int64 <- service.system_health_check(); // 1 + 8 + 1000 = 1009

        // Combine all results
        log_result + serialize_result + validate_result + save_result +
        auth_result + process_result + metrics_result + health_result
    end
}

fn main() -> int64 {
    test_diamond_inheritance()
}

// Expected result: 3 + 105 + 1 + 108 + 14 + 122 + 8 + 1009 = 1370