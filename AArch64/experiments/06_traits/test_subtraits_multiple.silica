// Test multiple sub-traits in a single trait
// Demonstrates how traits can accumulate functionality from multiple sub-traits

trait Displayable {
    fn display(self: Self) -> int64;
}

trait Serializable {
    fn serialize(self: Self) -> int64;
}

trait Comparable {
    fn compare(self: Self, other: int64) -> int64;
}

// FullFeatured trait includes all three sub-traits
trait FullFeatured includes Displayable, Serializable, Comparable {
    fn version(self: Self) -> int64;
}

// Rectangle type that implements the FullFeatured trait
type Rectangle = {width: int64, height: int64};

impl Displayable for Rectangle {
    fn display(self: Rectangle) -> int64 {
        self.width  // Just return width
    }
}

impl Serializable for Rectangle {
    fn serialize(self: Rectangle) -> int64 {
        self.height  // Just return height
    }
}

impl Comparable for Rectangle {
    fn compare(self: Rectangle, other: int64) -> int64 {
        other  // Just return the other value
    }
}

impl FullFeatured for Rectangle {
    fn version(self: Rectangle) -> int64 {
        1  // Version number
    }
}

fn main() -> int64 {
    do
        rect:Rectangle <- Rectangle { width: 4, height: 5 };

        // Test all methods from sub-traits and main trait
        display_result:int64 <- rect.display();        // Should be 4 (width)
        serialize_result:int64 <- rect.serialize();    // Should be 5 (height)
        compare_result:int64 <- rect.compare(15);      // Should be 15 (other)
        version_result:int64 <- rect.version();        // Should be 1

        // Return sum of all results
        display_result + serialize_result + compare_result + version_result
    end
}

// Expected result: 4 + 5 + 15 + 1 = 25