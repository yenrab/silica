// Test Trait-based Error Handling
// Demonstrates error handling patterns using traits

trait ErrorHandler {
    fn handle_error(self: Self, error_code: int) -> int;
    fn get_error_message(self: Self, error_code: int) -> int;
}

trait Recoverable includes ErrorHandler {
    fn can_recover(self: Self, error_code: int) -> int;
    fn attempt_recovery(self: Self, error_code: int) -> int;
}

trait LoggableError includes ErrorHandler {
    fn log_error(self: Self, error_code: int, context: int) -> int;
}

// Error handling strategies
struct SilentHandler {
    error_count: int
}

struct VerboseHandler {
    error_count: int,
    log_level: int,
    max_errors: int
}

struct RecoveryHandler {
    recovery_attempts: int,
    success_rate: int
}

impl ErrorHandler for SilentHandler {
    fn handle_error(self: SilentHandler, error_code: int) -> int {
        // Silent handling - just count errors
        self.error_count + 1
    }

    fn get_error_message(self: SilentHandler, error_code: int) -> int {
        // Silent handler returns minimal info
        error_code
    }
}

impl ErrorHandler for VerboseHandler {
    fn handle_error(self: VerboseHandler, error_code: int) -> int {
        // Verbose handling with logging
        case self.error_count < self.max_errors of {
            true -> error_code + 100;  // Log and continue
            false -> -1;               // Too many errors, fail
        }
    }

    fn get_error_message(self: VerboseHandler, error_code: int) -> int {
        // Detailed error message
        error_code + self.log_level + 200
    }
}

impl ErrorHandler for RecoveryHandler {
    fn handle_error(self: RecoveryHandler, error_code: int) -> int {
        // Recovery-focused handling
        case error_code < 100 of {
            true -> error_code + 50;   // Attempt recovery
            false -> error_code + 500; // Severe error
        }
    }

    fn get_error_message(self: RecoveryHandler, error_code: int) -> int {
        // Recovery-oriented message
        error_code + self.success_rate
    }
}

impl Recoverable for RecoveryHandler {
    fn can_recover(self: RecoveryHandler, error_code: int) -> int {
        case error_code < 50 of {
            true -> 1;  // Can recover (simplified)
            false -> 0; // Cannot recover
        }
    }

    fn attempt_recovery(self: RecoveryHandler, error_code: int) -> int {
        case error_code < 100 of {  // Simplified recovery logic
            true -> self.recovery_attempts + 1;
            false -> -1; // Recovery failed
        }
    }
}

impl LoggableError for VerboseHandler {
    fn log_error(self: VerboseHandler, error_code: int, context: int) -> int {
        // Advanced logging with context
        error_code + context + self.log_level + 300
    }
}

// Error processing system
struct ErrorProcessor {
    strategy: int,  // Which error handling strategy to use
    total_errors: int
}

impl ErrorHandler for ErrorProcessor {
    fn handle_error(self: ErrorProcessor, error_code: int) -> int {
        // Route to appropriate handler based on strategy
        self.strategy + error_code + self.total_errors
    }

    fn get_error_message(self: ErrorProcessor, error_code: int) -> int {
        // Processor-level error message
        error_code + self.strategy + 1000
    }
}

fn simulate_error_scenarios() -> int {
    do
        // Create different error handlers
        silent:SilentHandler <- SilentHandler { error_count: 0 };
        verbose:VerboseHandler <- VerboseHandler { error_count: 0, log_level: 2, max_errors: 5 };
        recovery:RecoveryHandler <- RecoveryHandler { recovery_attempts: 0, success_rate: 80 };

        // Test basic error handling
        silent_handle:int <- silent.handle_error(10);      // 0 + 1 = 1
        verbose_handle:int <- verbose.handle_error(20);    // 20 + 100 = 120
        recovery_handle:int <- recovery.handle_error(30);  // 30 + 50 = 80

        // Test error messages
        silent_msg:int <- silent.get_error_message(10);    // 10
        verbose_msg:int <- verbose.get_error_message(20);  // 20 + 2 + 200 = 222
        recovery_msg:int <- recovery.get_error_message(30); // 30 + 80 = 110

        // Test recovery capabilities
        can_recover:int <- recovery.can_recover(25);      // 1 (can recover)
        recovery_attempt:int <- recovery.attempt_recovery(25); // 0 + 1 = 1

        // Test logging capabilities
        log_result:int <- verbose.log_error(15, 5);       // 15 + 5 + 2 + 300 = 322

        // Test error processor
        processor:ErrorProcessor <- ErrorProcessor { strategy: 3, total_errors: 2 };
        processor_handle:int <- processor.handle_error(40);  // 3 + 40 + 2 = 45

        // Combine all results
        silent_handle + verbose_handle + recovery_handle + silent_msg +
        verbose_msg + recovery_msg + can_recover + recovery_attempt +
        log_result + processor_handle
    end
}

fn main() -> int {
    simulate_error_scenarios()
}

// Expected result: 1 + 120 + 80 + 10 + 222 + 110 + 1 + 1 + 322 + 45 = 912