// Comprehensive trait system test
// This tests multiple traits, implementations, and method dispatch

// Define multiple traits with different signatures
trait Display {
    fn display(self: Self) -> int;
}

trait Math {
    fn compute(self: Self, other: int) -> int;
}

trait Info {
    fn get_info(self: Self) -> int;
}

// Define struct types using type aliases
type Point2D = {x: int, y: int};
type Rectangle = {width: int, height: int};
type Circle = {radius: int};

// Implement Display trait for Point2D
impl Display for Point2D {
    fn display(self: Point2D) -> int {
        self.x + self.y  // Returns coordinate sum
    }
}

// Implement Display trait for Rectangle
impl Display for Rectangle {
    fn display(self: Rectangle) -> int {
        self.width * self.height  // Returns area
    }
}

// Implement Math trait for Point2D
impl Math for Point2D {
    fn compute(self: Point2D, other: int) -> int {
        (self.x + self.y) * other  // Sum scaled by other
    }
}

// Implement Math trait for Rectangle
impl Math for Rectangle {
    fn compute(self: Rectangle, other: int) -> int {
        (self.width + self.height) * other  // Perimeter scaled by other
    }
}

// Implement Info trait for Circle
impl Info for Circle {
    fn get_info(self: Circle) -> int {
        self.radius * 2  // Returns diameter
    }
}

fn main() -> int {
    do
        // Test Point2D Display implementation
        p1 <- Point2D {x: 3, y: 7};
        point_display <- p1.display();  // Should be 10 (3 + 7)

        // Test Rectangle Display implementation
        rect <- Rectangle {width: 4, height: 5};
        rect_display <- rect.display();  // Should be 20 (4 * 5)

        // Test Point2D Math implementation
        p2 <- Point2D {x: 2, y: 3};
        point_math <- p2.compute(4);  // Should be 20 ((2 + 3) * 4)

        // Test Rectangle Math implementation
        rect2 <- Rectangle {width: 6, height: 8};
        rect_math <- rect2.compute(2);  // Should be 28 ((6 + 8) * 2)

        // Test Circle Info implementation
        circle <- Circle {radius: 5};
        circle_info <- circle.get_info();  // Should be 10 (5 * 2)

        // Return sum of all results
        point_display + rect_display + point_math + rect_math + circle_info
    end
}

// Expected result: 10 + 20 + 20 + 28 + 10 = 88
