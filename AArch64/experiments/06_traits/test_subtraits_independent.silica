// Test independent sub-trait implementations
// Demonstrates that sub-traits can be implemented independently of their including traits

trait BasicOps {
    fn value(self: Self) -> int;
}

trait AdvancedOps includes BasicOps {
    fn enhanced_value(self: Self) -> int;
}

// Two different structs with different implementation strategies

type SimpleValue = {data: int};

type ComplexValue = {data: int, multiplier: int};

// SimpleValue only implements BasicOps
impl BasicOps for SimpleValue {
    fn value(self: SimpleValue) -> int {
        self.data
    }
}

// ComplexValue implements both traits
impl BasicOps for ComplexValue {
    fn value(self: ComplexValue) -> int {
        self.data
    }
}

impl AdvancedOps for ComplexValue {
    fn enhanced_value(self: ComplexValue) -> int {
        self.data  // Simplified - just return data
    }
}

fn main() -> int {
    do
        simple:SimpleValue <- SimpleValue { data: 5 };
        complex:ComplexValue <- ComplexValue { data: 3, multiplier: 4 };

        // Test that both can use BasicOps
        simple_basic:int <- simple.value();    // Should be 5
        complex_basic:int <- complex.value();  // Should be 3

        // Only ComplexValue can use AdvancedOps
        complex_advanced:int <- complex.enhanced_value();  // Should be 3

        // Return a simple result
        simple_basic
    end
}

// Expected result: 5