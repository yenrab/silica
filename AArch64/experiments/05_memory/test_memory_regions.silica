// Test Silica Memory Regions (no garbage collection)

fn test_memory_regions() -> int {
    do
        let region = region();
        
        // Allocate a reference in the region
        let ref1 = alloc_ref(region, 42);
        
        // Read from the reference
        let value = read_ref(ref1);
        
        // Write to the reference
        write_ref(ref1, 100);
        
        // Read again to verify the write
        let new_value = read_ref(ref1);
        
        // When region goes out of scope, all memory is automatically freed
        new_value
    end
}

fn main() -> int {
    test_memory_regions()
}
