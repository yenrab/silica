// Test Silica Memory Regions with simplified syntax

fn test_memory_regions() -> int64 {
    do
        // Create a reference with simplified region syntax (immutable)
        my_ref:ref(normal, int64) <- region(42);

        // Read from the reference
        value:int64 <- read_ref(my_ref);

        // Regions are now immutable - no write_ref operation
        // Memory is automatically freed when reference goes out of scope
        value
    end
}

fn main() -> int64 {
    test_memory_regions()
}
