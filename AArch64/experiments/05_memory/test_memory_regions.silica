// Test Silica Memory Regions 

fn test_memory_regions() -> int64 {
    do
        // Create a memory region with explicit type annotation
        my_region:region(normal) <- region();

        // Allocate a reference in the region
        my_ref:ref(my_region, normal, int64) <- alloc_ref(my_region, 42);

        // Read from the reference
        value:int64 <- read_ref(my_ref);

        // Write to the reference
        write_ref(my_ref, 100);

        // Read again to verify the write
        new_value:int64 <- read_ref(my_ref);

        // When region goes out of scope, all memory is automatically freed
        new_value
    end
}

fn main() -> int64 {
    test_memory_regions()
}
