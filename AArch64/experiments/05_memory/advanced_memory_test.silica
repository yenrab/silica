// Advanced Memory Management Tests
// Tests complex memory scenarios and edge cases

fn test_nested_regions() -> int {
    do
        // Create outer region with explicit complex type
        outer_region:region(normal) <- region();

        // Allocate in outer region with explicit reference type
        outer_ref:ref(outer_region, normal, int) <- alloc_ref(outer_region, 100);

        // Test basic operations
        outer_val:int <- read_ref(outer_ref);

        // Return the value
        outer_val
    end
}

fn test_memory_lifecycle() -> int {
    do
        // Test that memory is properly managed with explicit types
        r:region(normal) <- region();
        ref1:ref(r, normal, int) <- alloc_ref(r, 42);
        ref2:ref(r, normal, int) <- alloc_ref(r, 24);

        val1:int <- read_ref(ref1);
        val2:int <- read_ref(ref2);

        // Test arithmetic with memory values
        result:int <- val1 + val2;

        result
    end
}

fn test_reference_operations() -> int {
    do
        // Test multiple read/write cycles with explicit types
        r:region(normal) <- region();
        counter:ref(r, normal, int) <- alloc_ref(r, 0);

        // Test multiple read/write cycles
        write_ref(counter, 10);
        val1:int <- read_ref(counter);

        write_ref(counter, 20);
        val2:int <- read_ref(counter);

        write_ref(counter, 30);
        val3:int <- read_ref(counter);

        // Return final value
        val3
    end
}

fn main() -> int {
    do
        // Test each function and combine results
        nested_result:int <- test_nested_regions();
        lifecycle_result:int <- test_memory_lifecycle();
        ref_result:int <- test_reference_operations();

        // Return combination to verify all tests passed
        nested_result + lifecycle_result + ref_result
    end
}
