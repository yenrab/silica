// Advanced Memory Management Tests
// Tests complex memory scenarios and edge cases

fn test_nested_regions() -> int {
    do
        // Create outer region
        outer_region <- region();

        // Allocate in outer region
        outer_ref <- alloc_ref(outer_region, 100);

        // Create inner region
        inner_region <- region();

        // Allocate in inner region
        inner_ref <- alloc_ref(inner_region, 200);

        // Test that values are independent
        outer_val <- read_ref(outer_ref);
        inner_val <- read_ref(inner_ref);

        // Modify values
        write_ref(outer_ref, 150);
        write_ref(inner_ref, 250);

        // Verify modifications
        new_outer <- read_ref(outer_ref);
        new_inner <- read_ref(inner_ref);

        // Return sum to verify all operations worked
        new_outer + new_inner
    end
}

fn test_memory_lifecycle() -> int {
    do
        // Test that memory is properly managed
        r <- region();
        ref1 <- alloc_ref(r, 42);
        ref2 <- alloc_ref(r, 24);

        val1 <- read_ref(ref1);
        val2 <- read_ref(ref2);

        // Test arithmetic with memory values
        result <- val1 + val2;

        result
    end
}

fn test_reference_operations() -> int {
    do
        r <- region();
        counter <- alloc_ref(r, 0);

        // Test multiple read/write cycles
        write_ref(counter, 10);
        val1 <- read_ref(counter);

        write_ref(counter, 20);
        val2 <- read_ref(counter);

        write_ref(counter, 30);
        val3 <- read_ref(counter);

        // Return final value
        val3
    end
}

fn main() -> int {
    let nested_result = test_nested_regions();
    let lifecycle_result = test_memory_lifecycle();
    let ref_result = test_reference_operations();

    // Return combination to verify all tests passed
    nested_result + lifecycle_result + ref_result
}
