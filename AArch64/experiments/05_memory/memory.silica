// Basic memory operations test
fn main() -> int {
    do
        // Create a memory region
        r <- region();

        // Allocate a reference in the region
        my_ref <- alloc_ref(r, 100);

        // Read the initial value
        initial_value <- read_ref(my_ref);

        // Modify the value
        write_ref(my_ref, 200);

        // Read the modified value
        final_value <- read_ref(my_ref);

        // Return the final value to verify the operations worked
        final_value
    end
}
