// Basic memory operations test
fn main() -> int64 {
    do
        // Create a memory region with explicit type annotation
        r:region(normal) <- region();

        // Create a reference with explicit type annotation
        ref_to_200:ref(r, normal, int64) <- alloc_ref(r, 200);

        // Read the value from the reference
        value:int64 <- read_ref(ref_to_200);

        // Return the stored value
        value
    end
}
