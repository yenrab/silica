// Function that performs I/O (has effects)
proc io_read_value() -> int effects(mem(normal)) {
    let region = region();
    let ref = alloc_ref(region, 0);
    // Simulate reading from I/O
    write_ref(ref, 42);
    read_ref(ref)
}

// Pure function (no effects)
fn double(x: int) -> int {
    x * 2
}

fn main() -> int {
    // Demonstrate effect system: io_read_value has effects, double is pure
    let input = io_read_value();  // Effects: mem(normal)
    double(input)  // 42 * 2 = 84 (pure function)
}
