// Scheduler Module
// Contains all scheduler types, behaviors, and helper functions

// Export declarations
export scheduler_behavior/2;
export core_behavior/2;
export worker_behavior/2;
export move_actor/2;
export compute_intensive/1;

// Core type enumeration
type core_type = performance | efficiency;

// Process affinity types
type process_affinity = 
    Pinned(int64)              // Pinned to specific core (cannot be moved)
  | GroupAssigned(core_type)  // Assigned to core group (can move within group)
  | AnyCore;               // Can be stolen by any core

// Scheduler message types
type scheduler_msg =
    CoreIdle(int64)                           // Core requesting work steal
  | ProcessCountResponse(int64, int64, int64)     // Response: core_id, total processes, processes with messages
  | MoveComplete(actor_ref, int64, int64)       // Confirmation: process moved from->to
  | GetMetrics;                             // Request metrics

impl ActorMessage for scheduler_msg { }

// Core actor message types
type core_msg =
    QueryProcessCount                       // Scheduler: how many processes, how many with messages?
  | MoveProcess(actor_ref)                  // Scheduler: add this process
  | RemoveProcess(actor_ref)               // Scheduler: remove this process
  | WorkerStatus(actor_ref, bool);         // Worker: (actor_ref, active/busy)

impl ActorMessage for core_msg { }

// Worker process message type
type work_msg = int64;  // Simple integer work message

impl ActorMessage for work_msg { }

// Placeholder move function - reports success without actually moving
fn move_actor(actor: actor_ref, target_core: int64) -> bool proc[concurrency] {
    do
        // Placeholder: just return success
        // In full implementation, this would change actor's core affinity
        true
    end
}

// Scheduler actor state
type scheduler_state = {
    core_assignments: list<(int64, list<(actor_ref, process_affinity)>)>,  // Per-core process lists
    core_actors: list<(int64, actor_ref)>,                                   // Core ID -> Core Actor mapping
    pending_queries: list<(int64, int64)>,                                     // (requesting_core, queried_core)
    metrics: (int64, int64)                                                     // (total_moves, total_steals)
};

impl ActorState for scheduler_state { }

// Core actor state
type core_state = {
    core_id: int64,
    core_type: core_type,
    pinned_processes: list<actor_ref>,      // Processes that cannot be moved
    movable_processes: list<actor_ref>,     // Processes that can be moved
    idle_count: int64,                         // Count of idle processes
    scheduler: actor_ref                    // Reference to scheduler actor
};

impl ActorState for core_state { }

// Worker process state
type worker_state = {
    worker_id: int64,
    core_actor: actor_ref,                   // Reference to managing core actor
    computation_count: int64                  // Track computation performed
};

impl ActorState for worker_state { }

// Scheduler actor behavior
fn scheduler_behavior(msg: scheduler_msg, state: scheduler_state) -> scheduler_state proc[concurrency] {
    do
        case msg of
            CoreIdle(requesting_core) ->
                // Core has run out of work - find processes to steal
                // Query eligible cores for processes with messages
                // For now, simplified: query all cores
                // TODO: Filter by affinity rules (only query eligible cores)
                state  // Placeholder - will implement full logic
            
            ProcessCountResponse(core_id, total, with_messages) ->
                // Received response from core query
                // TODO: Process response and decide which processes to steal
                state  // Placeholder
            
            MoveComplete(actor, from_core, to_core) ->
                // Process move completed
                // Update metrics
                {
                    core_assignments: state.core_assignments,
                    core_actors: state.core_actors,
                    pending_queries: state.pending_queries,
                    metrics: (state.metrics.0, state.metrics.1 + 1)  // Increment total_steals
                }
            
            GetMetrics ->
                // Return metrics (for now, just continue)
                state
        end
    end
}

// Core actor behavior
fn core_behavior(msg: core_msg, state: core_state) -> core_state proc[concurrency] {
    do
        case msg of
            QueryProcessCount ->
                // Count processes with messages in mailbox
                // For now, simplified: return total count
                // TODO: Actually check mailboxes
                let total = length(state.pinned_processes) + length(state.movable_processes);
                let with_messages = length(state.movable_processes);  // Simplified
                send(state.scheduler, ProcessCountResponse(state.core_id, total, with_messages));
                state
            
            MoveProcess(actor) ->
                // Add process to this core
                {
                    core_id: state.core_id,
                    core_type: state.core_type,
                    pinned_processes: state.pinned_processes,
                    movable_processes: append(state.movable_processes, [actor]),
                    idle_count: state.idle_count,
                    scheduler: state.scheduler
                }
            
            RemoveProcess(actor) ->
                // Remove process from this core
                {
                    core_id: state.core_id,
                    core_type: state.core_type,
                    pinned_processes: filter(state.pinned_processes, fn(p: actor_ref) -> bool { p != actor }),
                    movable_processes: filter(state.movable_processes, fn(p: actor_ref) -> bool { p != actor }),
                    idle_count: state.idle_count,
                    scheduler: state.scheduler
                }
            
            WorkerStatus(actor, active) ->
                // Worker reports status change
                let new_idle_count = if active then
                    state.idle_count - 1  // Worker became active
                else
                    state.idle_count + 1  // Worker became idle
                end;
                
                // If all processes idle, request work stealing
                let total_processes = length(state.pinned_processes) + length(state.movable_processes);
                if new_idle_count >= total_processes then
                    send(state.scheduler, CoreIdle(state.core_id))
                end;
                
                {
                    core_id: state.core_id,
                    core_type: state.core_type,
                    pinned_processes: state.pinned_processes,
                    movable_processes: state.movable_processes,
                    idle_count: new_idle_count,
                    scheduler: state.scheduler
                }
        end
    end
}

// Worker process behavior - performs complex computation
fn worker_behavior(msg: work_msg, state: worker_state) -> worker_state proc[concurrency] {
    do
        // Notify core actor that work is starting (active)
        send(state.core_actor, WorkerStatus(self(), true));
        
        // Perform complex computation (simulated with nested loops)
        let result = compute_intensive(msg);
        
        // Notify core actor that work is complete (idle)
        send(state.core_actor, WorkerStatus(self(), false));
        
        {
            worker_id: state.worker_id,
            core_actor: state.core_actor,
            computation_count: state.computation_count + 1
        }
    end
}

// Helper function: complex computation simulation
fn compute_intensive(input: int64) -> int64 {
    // Simulate CPU-intensive work with nested loops
    let mut sum = 0;
    let mut i = 0;
    while i < input * 100 do
        let mut j = 0;
        while j < 100 do
            sum = sum + i + j;
            j = j + 1
        end;
        i = i + 1
    end;
    sum
}
