// Test case expressions with different patterns

fn test_literal_patterns(x: int64) -> int64 {
    case x of {
        0 -> 100;
        1 -> 200;
        2 -> 300;
        _: int64 -> 400
    }
}

fn test_wildcard_only(x: int64) -> int64 {
    case x of {
        _: int64 -> 999
    }
}

fn main() -> int64 {
    do
        result1: int64 <- test_literal_patterns(1);  // Should return 200
        result2: int64 <- test_wildcard_only(42);    // Should return 999
        result1 + result2
    end
}
