// Test case expressions on tuples of sizes 2-6 with different type combinations.
// Covers: (int64, int64), (string, string), (int64, string), (int64,int64,int64),
//         (int64, string, int64), and homogeneous int64 tuples of size 4, 5, 6.
// Expected: int64-only tuple cases produce 1/2/3 for literal matches, 0 for wildcard.
// String/mixed tuple cases exercise pattern matching; string literal storage in
// tuples may affect those results depending on compiler support.

// --- Size 2: (int64, int64) ---
fn match_pair_int(t: (int64, int64)) -> int64 {
    case t of {
        (0, 0) -> 1;
        (1, 1) -> 2;
        (2, 3) -> 3;
        _: (int64, int64) -> 0
    }
}

// --- Size 2: (string, string) ---
fn match_pair_string(t: (string, string)) -> int64 {
    case t of {
        ("a", "a") -> 1;
        ("x", "y") -> 2;
        _: (string, string) -> 0
    }
}

// --- Size 2: (int64, string) - mixed ---
fn match_pair_mixed(t: (int64, string)) -> int64 {
    case t of {
        (0, "zero") -> 1;
        (1, "one") -> 2;
        _: (int64, string) -> 0
    }
}

// --- Size 3: (int64, int64, int64) ---
fn match_triple(t: (int64, int64, int64)) -> int64 {
    case t of {
        (0, 0, 0) -> 1;
        (1, 2, 3) -> 2;
        (10, 20, 30) -> 3;
        _: (int64, int64, int64) -> 0
    }
}

// --- Size 3: (int64, string, int64) ---
fn match_triple_mixed(t: (int64, string, int64)) -> int64 {
    case t of {
        (0, "mid", 0) -> 1;
        (1, "x", 2) -> 2;
        _: (int64, string, int64) -> 0
    }
}

// --- Size 4: (int64, int64, int64, int64) ---
fn match_quad(t: (int64, int64, int64, int64)) -> int64 {
    case t of {
        (1, 2, 3, 4) -> 1;
        (0, 0, 0, 0) -> 2;
        _: (int64, int64, int64, int64) -> 0
    }
}

// --- Size 5: (int64, int64, int64, int64, int64) ---
fn match_five(t: (int64, int64, int64, int64, int64)) -> int64 {
    case t of {
        (1, 2, 3, 4, 5) -> 1;
        (5, 4, 3, 2, 1) -> 2;
        _: (int64, int64, int64, int64, int64) -> 0
    }
}

// --- Size 6: (int64, int64, int64, int64, int64, int64) ---
fn match_six(t: (int64, int64, int64, int64, int64, int64)) -> int64 {
    case t of {
        (1, 2, 3, 4, 5, 6) -> 1;
        (6, 5, 4, 3, 2, 1) -> 2;
        _: (int64, int64, int64, int64, int64, int64) -> 0
    }
}

fn main() -> int64 proc[DeviceIO] {
    // Size 2 - (int64, int64)
    print_int64(match_pair_int((0, 0)));
    println("");
    print_int64(match_pair_int((1, 1)));
    println("");
    print_int64(match_pair_int((2, 3)));
    println("");
    print_int64(match_pair_int((99, 99)));
    println("");

    // Size 2 - (string, string)
    print_int64(match_pair_string(("a", "a")));
    println("");
    print_int64(match_pair_string(("x", "y")));
    println("");
    print_int64(match_pair_string(("other", "pair")));
    println("");

    // Size 2 - (int64, string) - need substring for single-char; use literals we can construct
    print_int64(match_pair_mixed((0, "zero")));
    println("");
    print_int64(match_pair_mixed((1, "one")));
    println("");
    print_int64(match_pair_mixed((2, "two")));
    println("");

    // Size 3
    print_int64(match_triple((0, 0, 0)));
    println("");
    print_int64(match_triple((1, 2, 3)));
    println("");
    print_int64(match_triple((10, 20, 30)));
    println("");
    print_int64(match_triple((7, 8, 9)));
    println("");

    // Size 3 mixed
    print_int64(match_triple_mixed((0, "mid", 0)));
    println("");
    print_int64(match_triple_mixed((1, "x", 2)));
    println("");
    print_int64(match_triple_mixed((0, "other", 0)));
    println("");

    // Size 4
    print_int64(match_quad((1, 2, 3, 4)));
    println("");
    print_int64(match_quad((0, 0, 0, 0)));
    println("");
    print_int64(match_quad((2, 2, 2, 2)));
    println("");

    // Size 5
    print_int64(match_five((1, 2, 3, 4, 5)));
    println("");
    print_int64(match_five((5, 4, 3, 2, 1)));
    println("");
    print_int64(match_five((0, 0, 0, 0, 0)));
    println("");

    // Size 6
    print_int64(match_six((1, 2, 3, 4, 5, 6)));
    println("");
    print_int64(match_six((6, 5, 4, 3, 2, 1)));
    println("");
    print_int64(match_six((1, 1, 1, 1, 1, 1)));
    println("");

    0
}
