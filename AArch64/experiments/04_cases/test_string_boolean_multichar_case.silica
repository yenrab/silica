

fn is_line_comment_start(aString: string) -> bool {
    pair: (string,string) <- (substring(aString, 0, 1), substring(aString, 1, 2));
    case pair of {
        ("/", "/") -> true;
        _: (string, string) -> false
    }
}

fn main() -> int64 proc[DeviceIO] {
    first: boolean <- is_line_comment_start("//hello");  // Should return true
    second: boolean <- is_line_comment_start("/6");  // Should return false
    third: boolean <- is_line_comment_start(" ");  // Should return false
    fourth: boolean <- is_line_comment_start("");  // Should return false

    print_bool(first);
    println("");
    print_bool(second);
    println("");
    print_bool(third);
    println("");
    print_bool(fourth);
    println("");
    0
}