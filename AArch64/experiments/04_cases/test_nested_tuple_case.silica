// Test case matching on tuples that contain both non-tuple elements and tuple elements.
// Covers: (int64, (int64, int64)), ((int64, int64), int64), (int64, (int64, int64), int64),
//        and mixed types: (bool, (int64, int64)), ((int64, int64), bool), (int64, (int64, bool)).
//
// Part 1: Patterns that bind the nested tuple (n: int64, pair: (int64, int64)) - supported.
// Part 2: Literal nested patterns (0, (0, 0)) - require codegen support for Pattern::Tuple
//         as a tuple element; currently unsupported (compilation fails on match_int_pair_lit etc.).

// --- (int64, (int64, int64)): bind nested pair; match on outer int ---
fn match_int_pair(t: (int64, (int64, int64))) -> int64 {
    case t of {
        (0, inner0: (int64, int64)) -> 1;
        (1, inner1: (int64, int64)) -> 2;
        (10, inner2: (int64, int64)) -> 3;
        _: (int64, (int64, int64)) -> 0
    }
}

// --- ((int64, int64), int64): bind inner pair; match on outer int ---
fn match_pair_int(t: ((int64, int64), int64)) -> int64 {
    case t of {
        (inner0: (int64, int64), 0) -> 1;
        (inner1: (int64, int64), 1) -> 2;
        _: ((int64, int64), int64) -> 0
    }
}

// --- (int64, (int64, int64), int64): bind nested pair; match on outer ints ---
fn match_int_pair_int(t: (int64, (int64, int64), int64)) -> int64 {
    case t of {
        (0, mid0: (int64, int64), 0) -> 1;
        (1, mid1: (int64, int64), 1) -> 2;
        _: (int64, (int64, int64), int64) -> 0
    }
}

// --- (bool, (int64, int64)): match on outer bool ---
fn match_bool_pair(t: (boolean, (int64, int64))) -> int64 {
    case t of {
        (true, inner0: (int64, int64)) -> 1;
        (false, inner1: (int64, int64)) -> 2;
        _: (boolean, (int64, int64)) -> 0
    }
}

// --- ((int64, int64), bool): match on outer bool ---
fn match_pair_bool(t: ((int64, int64), boolean)) -> int64 {
    case t of {
        (inner0: (int64, int64), true) -> 1;
        (inner1: (int64, int64), false) -> 2;
        _: ((int64, int64), boolean) -> 0
    }
}

// --- (int64, (int64, bool)): bind nested (int64, bool); match on outer int ---
fn match_int_pair_bool(t: (int64, (int64, boolean))) -> int64 {
    case t of {
        (0, inner0: (int64, boolean)) -> 1;
        (1, inner1: (int64, boolean)) -> 2;
        _: (int64, (int64, boolean)) -> 0
    }
}

// --- (int64, (bool, int64)): bind nested (bool, int64); match on outer int ---
fn match_int_bool_int_pair(t: (int64, (boolean, int64))) -> int64 {
    case t of {
        (0, inner0: (boolean, int64)) -> 1;
        (1, inner1: (boolean, int64)) -> 2;
        _: (int64, (boolean, int64)) -> 0
    }
}

fn main() -> int64 proc[DeviceIO] {
    // (int64, (int64, int64))
    print_int64(match_int_pair((0, (0, 0))));
    println("");
    print_int64(match_int_pair((1, (2, 3))));
    println("");
    print_int64(match_int_pair((10, (20, 30))));
    println("");
    print_int64(match_int_pair((99, (1, 1))));
    println("");

    // ((int64, int64), int64)
    print_int64(match_pair_int(((0, 0), 0)));
    println("");
    print_int64(match_pair_int(((1, 2), 1)));
    println("");
    print_int64(match_pair_int(((5, 5), 10)));
    println("");

    // (int64, (int64, int64), int64)
    print_int64(match_int_pair_int((0, (0, 0), 0)));
    println("");
    print_int64(match_int_pair_int((1, (2, 3), 4)));
    println("");
    print_int64(match_int_pair_int((1, (1, 1), 1)));
    println("");

    // (bool, (int64, int64))
    print_int64(match_bool_pair((true, (0, 0))));
    println("");
    print_int64(match_bool_pair((false, (1, 2))));
    println("");
    print_int64(match_bool_pair((true, (10, 20))));
    println("");

    // ((int64, int64), bool)
    print_int64(match_pair_bool(((0, 0), true)));
    println("");
    print_int64(match_pair_bool(((1, 2), false)));
    println("");
    print_int64(match_pair_bool(((5, 5), true)));
    println("");

    // (int64, (int64, bool))
    print_int64(match_int_pair_bool((0, (0, true))));
    println("");
    print_int64(match_int_pair_bool((1, (2, false))));
    println("");
    print_int64(match_int_pair_bool((2, (0, true))));
    println("");

    // (int64, (bool, int64))
    print_int64(match_int_bool_int_pair((0, (true, 0))));
    println("");
    print_int64(match_int_bool_int_pair((1, (false, 1))));
    println("");
    print_int64(match_int_bool_int_pair((1, (true, 9))));
    println("");

    0
}
