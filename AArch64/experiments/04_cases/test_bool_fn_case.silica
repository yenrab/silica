// Test: boolean-returning function called before case, then same function called in case scrutinee
// Both functions return tuples where the second value is a recursively defined struct

struct ListInt {
    is_nil: bool,
    head: int64,
    tail: ListInt
}

fn nil_list() -> ListInt {
    nil_placeholder: ListInt <- ListInt { is_nil: true, head: 0, tail: nil_placeholder };
    nil_placeholder
}

fn cons_list(x: int64, xs: ListInt) -> ListInt {
    ListInt { is_nil: false, head: x, tail: xs }
}

fn is_even(n: int64) -> boolean {
    (n % 2) == 0
}

fn test_bool_before_case(n: int64) -> (int64, ListInt) {
    b: boolean <- is_even(n);
    case b of {
        true -> (1, cons_list(n, nil_list()));
        false -> (0, nil_list())
    }
}

fn test_bool_in_case(n: int64) -> (int64, ListInt) {
    case is_even(n) of {
        true -> (1, cons_list(n, nil_list()));
        false -> (0, nil_list())
    }
}

fn main() -> int64 proc[DeviceIO] {
    (r1, _: ListInt) <- test_bool_before_case(4);
    (r2, _: ListInt) <- test_bool_in_case(4);
    print_int64(r1);
    println("");
    print_int64(r2);
    println("");
    0
}
