

fn is_line_comment_start(aString: string) -> bool {
    case aString of {
        "/" -> true;
        _: string -> false
    }
}

fn main() -> int64 proc[DeviceIO] {
    first: boolean <- is_line_comment_start("/");  // Should return true
    second: boolean <- is_line_comment_start("6");  // Should return false
    third: boolean <- is_line_comment_start(" ");  // Should return false
    fourth: boolean <- is_line_comment_start("");  // Should return false

    print_bool(first);
    println("");
    print_bool(second);
    println("");
    print_bool(third);
    println("");
    print_bool(fourth);
    println("");
    0
}