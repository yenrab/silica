// Core Classification Test
// Tests how the topology detection classifies cores as performance or efficiency
// Demonstrates the difference between real detection and fallback heuristics

fn main() -> int64 proc[concurrency] {
    do
        // Test 1: Spawn actors on performance cores using detected topology
        // These will be scheduled on cores detected as high-performance
        spawn(0, fn(msg: int64, state: int64) -> int64 {
            // CPU-intensive computation - belongs on performance cores
            state + msg * msg * 10 // Simple computation for performance cores
        }, performance_cores);

        // Test 2: Spawn actors on efficiency cores using detected topology
        // These will be scheduled on cores detected as power-efficient
        spawn(10, fn(msg: int64, state: int64) -> int64 {
            // Light processing - suitable for efficiency cores
            state + msg
        }, efficiency_cores);

        // Test 3: Spawn actors with automatic core selection
        // These use load balancing across all available cores
        spawn(20, fn(msg: int64, state: int64) -> int64 {
            // General purpose - any core is fine
            state + msg
        }, any_core);

        // Test 4: Specific core targeting (bypasses topology detection)
        spawn(30, fn(msg: int64, state: int64) -> int64 {
            // Special case - must run on core 0
            state + msg
        }, 0);

        // Return success - core classification working
        0
    end
}
