// Advanced Topology Detection Test
// Comprehensive test of topology detection features and runtime information

fn main() -> int proc[concurrency] {
    do
        // Test 1: Performance core utilization
        // Spawn multiple CPU-intensive actors on performance cores
        spawn(0, fn(msg: int, state: int) -> int {
            // Simulate heavy computation - complex arithmetic
            ((state + msg) * 2 + msg) * 3
        }, performance_cores);

        spawn(10, fn(msg: int, state: int) -> int {
            // Another heavy computation actor
            (state * 2 + msg) * (state + msg)
        }, performance_cores);

        spawn(20, fn(msg: int, state: int) -> int {
            // Third performance core actor
            state + msg * msg + msg
        }, performance_cores);

        spawn(30, fn(msg: int, state: int) -> int {
            // Fourth performance core actor
            (state + msg) * 4 + msg * 2
        }, performance_cores);

        // Test 2: Efficiency core utilization
        // Spawn many light-weight actors on efficiency cores
        spawn(100, fn(msg: int, state: int) -> int {
            // Light background processing 1
            state + msg
        }, efficiency_cores);

        spawn(110, fn(msg: int, state: int) -> int {
            // Light background processing 2
            state + msg + 1
        }, efficiency_cores);

        spawn(120, fn(msg: int, state: int) -> int {
            // Light background processing 3
            state + msg
        }, efficiency_cores);

        spawn(130, fn(msg: int, state: int) -> int {
            // Light background processing 4
            state + msg + 2
        }, efficiency_cores);

        spawn(140, fn(msg: int, state: int) -> int {
            // Light background processing 5
            state + msg
        }, efficiency_cores);

        spawn(150, fn(msg: int, state: int) -> int {
            // Light background processing 6
            state + msg + 3
        }, efficiency_cores);

        spawn(160, fn(msg: int, state: int) -> int {
            // Light background processing 7
            state + msg
        }, efficiency_cores);

        spawn(170, fn(msg: int, state: int) -> int {
            // Light background processing 8
            state + msg + 4
        }, efficiency_cores);

        // Test 3: Load balancing demonstration
        // Spawn actors that will be distributed across all cores
        spawn(200, fn(msg: int, state: int) -> int {
            // Moderate workload 1 - suitable for any core
            (state + msg) * 3 / 2
        }, any_core);

        spawn(210, fn(msg: int, state: int) -> int {
            // Moderate workload 2
            (state + msg) * 2 + msg
        }, any_core);

        spawn(220, fn(msg: int, state: int) -> int {
            // Moderate workload 3
            state + msg * 2
        }, any_core);

        spawn(230, fn(msg: int, state: int) -> int {
            // Moderate workload 4
            (state + msg + 1) * 2
        }, any_core);

        spawn(240, fn(msg: int, state: int) -> int {
            // Moderate workload 5
            state + msg * 3
        }, any_core);

        spawn(250, fn(msg: int, state: int) -> int {
            // Moderate workload 6
            (state + msg) * 5 / 3
        }, any_core);

        // Test 4: Explicit core pinning for special cases
        spawn(1000, fn(msg: int, state: int) -> int {
            // Critical real-time task - pin to core 0
            state + msg
        }, 0);

        spawn(2000, fn(msg: int, state: int) -> int {
            // I/O intensive task - pin to core 1
            state + msg
        }, 1);

        spawn(3000, fn(msg: int, state: int) -> int {
            // Memory management task - pin to core 2
            state + msg
        }, 2);

        // Test 5: Mixed affinity patterns
        // Demonstrate that different affinity types work together
        spawn(4000, fn(msg: int, state: int) -> int {
            // User interface - performance matters
            state + msg
        }, performance_cores);

        spawn(5000, fn(msg: int, state: int) -> int {
            // Background sync - efficiency matters
            state + msg
        }, efficiency_cores);

        spawn(6000, fn(msg: int, state: int) -> int {
            // Utility task - any core fine
            state + msg
        }, any_core);

        // Return success - advanced topology features working
        0
    end
}
