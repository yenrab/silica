// Actor Topology-Based Placement Test
// Demonstrates intelligent actor placement based on detected CPU topology
// Shows how different workloads are automatically placed on appropriate core types

fn main() -> int64 proc[concurrency] {
    do
        // High-performance actors - placed on performance cores
        // These handle CPU-intensive tasks like real-time processing
        spawn(0, fn(msg: int64, state: int64) -> int64 {
            // Real-time signal processing simulation - CPU intensive computation
            (state + msg) * (state + msg) + msg // Quadratic-style computation
        }, performance_cores);

        spawn(1, fn(msg: int64, state: int64) -> int64 {
            // High-frequency data processing - bit manipulation heavy
            (state * 2 + msg) * 3 + msg // Bit manipulation style computation
        }, performance_cores);

        // Efficiency actors - placed on efficiency cores
        // These handle background tasks that don't need high performance
        spawn(100, fn(msg: int64, state: int64) -> int64 {
            // Background data synchronization
            state + msg // Simple accumulation
        }, efficiency_cores);

        spawn(200, fn(msg: int64, state: int64) -> int64 {
            // Idle-time maintenance tasks
            state + 1 // Minimal computation
        }, efficiency_cores);

        spawn(300, fn(msg: int64, state: int64) -> int64 {
            // Periodic health checks
            case state > 100 of {
                true -> 0;
                false -> state + msg
            }
        }, efficiency_cores);

        // General purpose actors - load balanced across all cores
        spawn(1000, fn(msg: int64, state: int64) -> int64 {
            // User interface event handling
            state + msg
        }, any_core);

        spawn(2000, fn(msg: int64, state: int64) -> int64 {
            // General computation tasks
            (state + msg) / 2
        }, any_core);

        // Specialized actors - explicit core assignment
        spawn(3000, fn(msg: int64, state: int64) -> int64 {
            // GPU coordination - needs specific core near GPU
            state + msg
        }, 0); // Core 0 (typically closest to system agents)

        spawn(4000, fn(msg: int64, state: int64) -> int64 {
            // Network I/O - needs core with good I/O access
            state + msg
        }, 1); // Core 1

        spawn(5000, fn(msg: int64, state: int64) -> int64 {
            // Storage I/O - needs core with storage controller access
            state + msg
        }, 2); // Core 2

        // Return success - intelligent topology-based placement working
        0
    end
}
