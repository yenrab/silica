// Test Helper Functions in Actor Behaviors
// Demonstrates calling external helper functions from within spawned actor behaviors

// Helper function for CPU-intensive computation
fn compute_cpu_load(value: int64) -> int64 {
    // Simulate some computation
    value * value + value
}

// Helper function for state updates
fn update_state(current: int64, message: int64) -> int64 {
    current + compute_cpu_load(message)
}

// Helper function for topology-based decisions
fn should_use_performance_cores(load_factor: int64) -> int64 {
    case load_factor of {
        n: int64 if n > 50 -> 1; // Use performance cores
        _: int64 -> 0              // Use efficiency cores
    }
}

fn main() -> int64 proc[concurrency] {
    do
        // Spawn actor that uses external helper functions
        spawn(0, fn(msg: int64, state: int64) -> int64 {
            // Call external helper functions
            new_state <- update_state(state, msg);

            // Make topology decision using helper
            use_performance <- should_use_performance_cores(msg);

            // Return updated state
            new_state
        }, performance_cores);

        // Spawn another actor with different behavior
        spawn(100, fn(msg: int64, state: int64) -> int64 {
            // Use helper function for computation
            computed <- compute_cpu_load(msg);

            // Update state
            state + computed
        }, efficiency_cores);

        // Success - helper functions work in actors
        0
    end
}
