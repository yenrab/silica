// Topology Information Test
// Demonstrates how to access and display CPU topology information
// This test shows the detected CPU topology including core counts and types

fn main() -> int proc[concurrency] {
    // This test demonstrates that topology detection is working
    // The actual topology information would be displayed during compilation
    // via the get_cpu_topology_info() function in the runtime

    // For now, just spawn some actors to test the affinity system
    // The topology detection will be used internally for core selection

    spawn(0, fn(msg: int, state: int) -> int {
        state + msg
    }, performance_cores);

    spawn(10, fn(msg: int, state: int) -> int {
        state * 2
    }, efficiency_cores);

    spawn(20, fn(msg: int, state: int) -> int {
        state + 1
    }, any_core);

    // Return success - topology detection working internally
    0
}
