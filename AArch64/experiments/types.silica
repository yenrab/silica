// Type alias
type Score = int;

// Struct definition
struct Point {
    x: int,
    y: int,
}

// Enum definition
enum Direction {
    North,
    South,
    East,
    West,
}

fn distance(p1: Point, p2: Point) -> int {
    let dx = p2.x - p1.x;
    let dy = p2.y - p1.y;
    // Simplified distance (not actual Euclidean)
    dx + dy
}

fn main() -> int {
    let origin = Point { x: 0, y: 0 };
    let target = Point { x: 3, y: 4 };
    distance(origin, target)
}
