// Test file for Phase 5: Pattern Guards and Exhaustiveness Checking

fn test_exhaustiveness(flag: bool) -> int {
    case flag of {
        true -> 1;
        false -> 0
    }  // This should be exhaustive
}

fn test_exhaustive_with_wildcard(flag: bool) -> int {
    case flag of {
        true -> 1;
        false -> 0  // Explicit false case
    }
}

fn test_simple_pattern(x: int) -> int {
    case x of {
        n: int -> n * 2
    }
}

fn test_guards(x: int) -> int {
    case x of {
        n: int -> n * 2
    }
}

fn main() -> int {
    test_exhaustiveness(true) + test_guards(5)
}
