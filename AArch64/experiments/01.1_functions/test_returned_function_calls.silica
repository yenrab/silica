-- Test executing function literals returned from functions
-- Demonstrates that functions can return function literals that are then called

-- Function that returns a multiplier function
fn make_multiplier(factor: int) -> fn(int) -> int {
    fn(x: int) -> int { x * factor }
}

-- Function that returns an adder function
fn make_adder(base: int) -> fn(int) -> int {
    fn(x: int) -> int { x + base }
}

-- Function that returns a conditional function
fn make_conditional(threshold: int) -> fn(int) -> int {
    fn(x: int) -> int {
        case x > threshold of {
            true -> x * 2
            false -> x + threshold
        }
    }
}

-- Function that returns a function with captured variables
fn make_power_function(power: int) -> fn(int) -> int {
    fn(base: int) -> int {
        case power of {
            2 -> base * base
            3 -> base * base * base
            _: int -> base
        }
    }
}

fn main() -> int {
    -- Test 1: Call a returned multiplier function
    doubler: fn(int) -> int <- make_multiplier(2);
    result1: int <- doubler(5);  -- Should be 10 (5 * 2)

    -- Test 2: Call a returned adder function
    add_ten: fn(int) -> int <- make_adder(10);
    result2: int <- add_ten(7);  -- Should be 17 (7 + 10)

    -- Test 3: Call a returned conditional function
    conditional_func: fn(int) -> int <- make_conditional(10);
    result3a: int <- conditional_func(15);  -- Should be 30 (15 > 10, so 15 * 2)
    result3b: int <- conditional_func(5);   -- Should be 15 (5 <= 10, so 5 + 10)

    -- Test 4: Call a returned power function
    squarer: fn(int) -> int <- make_power_function(2);
    cuber: fn(int) -> int <- make_power_function(3);
    result4a: int <- squarer(4);  -- Should be 16 (4^2)
    result4b: int <- cuber(3);    -- Should be 27 (3^3)

    -- Test 5: Chain returned functions
    multiplier: fn(int) -> int <- make_multiplier(3);
    adder: fn(int) -> int <- make_adder(5);
    temp: int <- multiplier(4);     -- 4 * 3 = 12
    result5: int <- adder(temp);    -- 12 + 5 = 17

    -- Test 6: Function factory with different parameters
    mul_by_5: fn(int) -> int <- make_multiplier(5);
    mul_by_7: fn(int) -> int <- make_multiplier(7);
    result6a: int <- mul_by_5(6);   -- Should be 30 (6 * 5)
    result6b: int <- mul_by_7(4);   -- Should be 28 (4 * 7)

    -- Return sum of results to verify correctness
    result1 + result2 + result3a + result3b + result4a + result4b + result5 + result6a + result6b
}
