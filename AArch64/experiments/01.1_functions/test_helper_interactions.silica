//Test helper function interactions with types

//Helper functions with different signatures
fn helper_int(x: int) -> int {
    x * 2
}

fn helper_bool(b: boolean) -> boolean {
    !b
}


fn helper_mixed(i: int, b: boolean) -> int {
    case b of {
        true -> i;
        false -> i + 10
    }
}

//Helper function that calls other helpers
fn helper_caller(value: int, flag: boolean) -> int {
    doubled <- helper_int(value);
    flipped <- helper_bool(flag);
    helper_mixed(doubled, flipped)
}

//Main function using helpers
fn main() -> int {
    result1 <- helper_int(5);
    result2 <- helper_bool(true);
    result3 <- helper_mixed(10, false);
    result4 <- helper_caller(3, true);
    result4  //Return the final result
}
