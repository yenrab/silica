//Test helper function interactions with types

//Helper functions with different signatures
fn helper_int(x: int64) -> int64 {
    x * 2
}

fn helper_bool(b: boolean) -> boolean {
    !b
}


fn helper_mixed(i: int64, b: boolean) -> int64 {
    case b of {
        true -> i;
        false -> i + 10
    }
}

//Helper function that calls other helpers
fn helper_caller(value: int64, flag: boolean) -> int64 {
    doubled: int64 <- helper_int(value);
    flipped: boolean <- helper_bool(flag);
    helper_mixed(doubled, flipped)
}

//Main function using helpers
fn main() -> int64 {
    result1: int64 <- helper_int(5);
    result2: boolean <- helper_bool(true);
    result3: int64 <- helper_mixed(10, false);
    result4: int64 <- helper_caller(3, true);
    result4  //Return the final result
}
