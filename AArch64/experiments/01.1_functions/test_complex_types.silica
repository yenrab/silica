-- Test complex types in functions

-- Functions with string parameters and return types
fn string_identity(s: string) -> string {
    s
}

-- Functions with tuple parameters and return types
fn tuple_identity(t: (int, boolean)) -> (int, boolean) {
    t
}

fn create_tuple(x: int, b: boolean) -> (int, boolean) {
    (x, b)
}

-- Helper function that uses other helper functions
fn process_data(value: int) -> (int, boolean) {
    is_positive:boolean <- value > 0;
    create_tuple(value, is_positive)
}

-- Main function testing complex types
fn main() -> int {
    s <- string_identity("hello");

    t1:(int, boolean) <- tuple_identity((42, true));
    t2:(int, boolean) <- create_tuple(100, false);

    processed:(int, boolean) <- process_data(-5);

    42  -- Return success code
}
