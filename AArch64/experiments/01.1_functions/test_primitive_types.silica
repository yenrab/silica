//Test primitive types in functions

//Functions with int parameters and return types
fn take_int(x: int) -> int proc[DeviceIO] {
    print_int(x);
    x
}

fn take_bool(b: boolean) -> int proc[DeviceIO] {
    print_bool(b);
    0
}

fn take_char(c: char) -> int proc[DeviceIO] {
    print_char(c);
    0
}

fn int_identity(x: int) -> int {
    x
}

fn add_ints(a: int, b: int) -> int {
    a + b
}

//Functions with bool parameters and return types
fn bool_identity(b: boolean) -> boolean {
    b
}

fn and_bools(x: boolean, y: boolean) -> boolean {
    x and y
}

//Functions with char parameters and return types
fn char_identity(c: char) -> char {
    c
}

//Main function testing primitive types
fn main() -> int proc[DeviceIO] {
    s <- 42;
    i <- 20;

    b <- true;
    result <- false;

    c <- 'A';

    42
}
