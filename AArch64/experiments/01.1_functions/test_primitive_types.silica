//Test primitive types in functions

//Functions with int64 parameters and return types
fn take_int(x: int64) -> int64 proc[DeviceIO] {
    print_int64(x);
    x
}

fn take_bool(b: boolean) -> int64 proc[DeviceIO] {
    print_bool(b);
    0
}

fn take_char(c: char) -> int64 proc[DeviceIO] {
    print_char(c);
    0
}

fn int_identity(x: int64) -> int64 {
    x
}

fn add_ints(a: int64, b: int64) -> int64 {
    a + b
}

//Functions with bool parameters and return types
fn bool_identity(b: boolean) -> boolean {
    b
}

fn and_bools(x: boolean, y: boolean) -> boolean {
    x and y
}

//Functions with char parameters and return types
fn char_identity(c: char) -> char {
    c
}

//Main function testing primitive types
fn main() -> int64 proc[DeviceIO] {
    s: int64 <- 42;
    i: int64 <- 20;

    b: boolean <- true;
    result: boolean <- false;

    c: char <- 'A';

    42
}
