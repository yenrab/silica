-- Test comprehensive function and helper function interactions with types

-- Helper functions with mixed parameter types
fn helper_mixed_types(i: int, b: boolean, c: char) -> int {
    case b of {
        true -> i + 1;
        false -> i - 1
    }
}

-- Helper function that calls other helpers
fn helper_caller(x: int) -> boolean {
    even <- helper_is_even(x);
    positive <- x > 0;
    even and positive
}

-- Helper function that returns different types based on input
fn helper_conditional_return(n: int) -> (int, boolean) {
    case n > 10 of {
        true -> (n * 2, true);
        false -> (n + 10, false)
    }
}

-- Main processing functions
fn process_with_helpers() -> int {
    -- Test helper with mixed types
    result1 <- helper_mixed_types(5, true, 'x');
    print_int(result1);  -- Should print 6

    result2 <- helper_mixed_types(5, false, 'y');
    print_int(result2);  -- Should print 4

    -- Test helper caller
    caller_result1 <- helper_caller(4);
    print_bool(caller_result1);  -- true (4 is even and positive)

    caller_result2 <- helper_caller(-2);
    print_bool(caller_result2);  -- false (-2 is negative)

    caller_result3 <- helper_caller(3);
    print_bool(caller_result3);  -- false (3 is odd)
    0
}

fn process_conditional_returns() -> int {
    (val1, flag1) <- helper_conditional_return(15);
    print_int(val1);   -- 30
    print_bool(flag1); -- true

    (val2, flag2) <- helper_conditional_return(5);
    print_int(val2);   -- 15
    print_bool(flag2); -- false
    0
}

-- Helper functions for string processing
fn helper_string_length_approximation(s: string) -> int {
    10  -- Simplified approximation
}

fn helper_format_result(value: int, is_valid: boolean) -> string {
    case is_valid of {
        true -> "valid";
        false -> "invalid"
    }
}

-- Complex interaction test
fn complex_interaction_test() -> int {
    -- Get some values
    base_val <- helper_return_int();
    is_even_val <- helper_is_even(base_val);

    -- Process with mixed types helper
    processed <- helper_mixed_types(base_val, is_even_val, 'A');

    -- Get conditional result
    (final_val, final_flag) <- helper_conditional_return(processed);

    -- Format result
    result_str <- helper_format_result(final_val, final_flag);

    -- Output results
    print_int(base_val);
    print_bool(is_even_val);
    print_int(processed);
    print_int(final_val);
    print_bool(final_flag);
    print(result_str);
    0
}

-- Main function that orchestrates all tests
fn main() -> int {
    print("Testing basic function types...");
    test_function_types_basic();

    print("Testing complex function types...");
    test_function_types_complex();

    print("Testing helper function types...");
    test_helper_functions_types();

    print("Testing return types...");
    test_return_types();

    print("Testing function interactions...");
    process_with_helpers();
    process_conditional_returns();
    complex_interaction_test();

    print("All type tests completed!");
    0
}

-- Include the basic tests
fn test_function_types_basic() -> int {
    take_int(123);
    take_bool(false);
    take_char('z');

    i <- return_int();
    b <- return_bool();
    c <- return_char();
    u <- return_unit();

    take_int(i);
    take_bool(b);
    take_char(c);
    0
}

fn test_function_types_complex() -> int {
    take_string("Direct string");
    take_tuple((123, false));

    s <- return_string();
    t <- return_tuple();

    take_string(s);
    take_tuple(t);

    use_helpers();
    0
}

fn test_helper_functions_types() -> int {
    test_primitive_helpers();
    test_complex_helpers();
    test_nested_helpers();
    0
}

fn test_return_types() -> int {
    test_int_returns();
    test_bool_returns();
    test_char_returns();
    test_unit_returns();

    chained <- chain_helpers();
    print_int(chained);
    0
}

-- Forward declarations for functions defined elsewhere
fn take_int(x: int) -> int { x }
fn take_bool(b: boolean) -> int { case b of { true -> 1; false -> 0 } }
fn take_char(c: char) -> int { 0 }
fn return_int() -> int { 42 }
fn return_bool() -> boolean { true }
fn return_char() -> char { 'a' }
fn return_unit() -> int { 0 }
fn take_string(s: string) -> int { 0 }
fn take_tuple(t: (int, boolean)) -> int { 0 }
fn return_string() -> string { "test" }
fn return_tuple() -> (int, boolean) { (1, true) }
fn use_helpers() -> int { 0 }
fn test_primitive_helpers() -> int { 0 }
fn test_complex_helpers() -> int { 0 }
fn test_nested_helpers() -> int { 0 }
fn test_int_returns() -> int { 0 }
fn test_bool_returns() -> int { 0 }
fn test_char_returns() -> int { 0 }
fn test_unit_returns() -> int { 0 }
fn chain_helpers() -> int { 0 }
fn helper_is_even(n: int) -> boolean { true }
