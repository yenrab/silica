// Test comprehensive function and helper function interactions with types

fn take_int(x: int) -> int { x }
fn take_bool(b: boolean) -> int { case b of { true -> 1; false -> 0 } }
fn take_char(c: char) -> int { 0 }
fn return_int() -> int { 42 }
fn return_bool() -> boolean { true }
fn return_char() -> char { 'a' }
fn return_unit() -> int { 0 }
fn take_string(s: string) -> int { 0 }
fn take_tuple(t: (int, boolean)) -> int { 0 }
fn return_string() -> string { "test" }
fn return_tuple() -> (int, boolean) { (1, true) }


// Helper functions with mixed parameter types
fn helper_mixed_types(i: int, b: boolean, c: char) -> int {
    case b of {
        true -> i + 1;
        false -> i - 1
    }
}

// Helper function for even checking
fn helper_is_even(n: int) -> boolean {
    n % 2 == 0
}

// Helper function that calls other helpers
fn helper_caller(x: int) -> boolean {
    even <- helper_is_even(x);
    positive <- x > 0;
    even and positive
}

// Helper functions that return individual values (bootstrap compiler workaround)
fn helper_conditional_val(n: int) -> int {
    case n > 10 of {
        true -> n * 2;
        false -> n + 10
    }
}

fn helper_conditional_flag(n: int) -> boolean {
    n > 10
}

// Additional helper functions for primitive types
fn test_primitive_helpers() -> int {
    i <- return_int();
    b <- return_bool();
    c <- return_char();
    u <- return_unit();

    take_int(i);
    take_bool(b);
    take_char(c);

    0
}

fn test_complex_helpers() -> int {
    s:string <- return_string();
    t:(int, boolean) <- return_tuple();

    dummy1 <- take_string(s);
    dummy2 <- take_tuple(t);

    0
}

fn test_nested_helpers() -> int {
    val <- return_int();
    result <- helper_mixed_types(val, helper_is_even(val), 'x');
    take_int(result);

    0
}

fn use_helpers() -> int {
    test_primitive_helpers();
    test_complex_helpers();
    test_nested_helpers();

    0
}

// Main processing functions
fn process_with_helpers() -> int proc[DeviceIO] {
    // Test helper with mixed types

    result1 <- helper_mixed_types(5, true, 'x');
    print_int(result1);  // Should print 6

    result2 <- helper_mixed_types(5, false, 'y');
    print_int(result2);  // Should print 4

    // Test helper caller
    caller_result1 <- helper_caller(4);
    print_bool(caller_result1);  // true (4 is even and positive)

    caller_result2 <- helper_caller(-2);
    print_bool(caller_result2);  // false (-2 is negative)

    caller_result3 <- helper_caller(3);
    print_bool(caller_result3);  // false (3 is odd)

    0
}

fn process_conditional_returns() -> int proc[DeviceIO] {
    val1 <- helper_conditional_val(15);
    flag1 <- helper_conditional_flag(15);
    print_int(val1);   // 30
    print_bool(flag1); // true

    val2 <- helper_conditional_val(5);
    flag2 <- helper_conditional_flag(5);
    print_int(val2);   // 15
    print_bool(flag2); // false
    0
}

// Helper functions for string processing
fn helper_string_length_approximation(s: string) -> int {
    10  // Simplified approximation
}

fn helper_format_result(value: int, is_valid: boolean) -> string {
    case is_valid of {
        true -> "valid";
        false -> "invalid"
    }
}

// Complex interaction test
fn complex_interaction_test() -> int proc[DeviceIO] {
    // Get some values
    base_val:int <- return_int();
    is_even_val:boolean <- helper_is_even(base_val);

    // Process with mixed types helper
    processed:int <- helper_mixed_types(base_val, is_even_val, 'A');

    // Get conditional result
    final_val:int <- helper_conditional_val(processed);
    final_flag:boolean <- helper_conditional_flag(processed);

    // Format result
    result_str:string <- helper_format_result(final_val, final_flag);

    // Output results
    print_int(base_val);
    print_bool(is_even_val);
    print_int(processed);
    print_int(final_val);
    print_bool(final_flag);
    print(result_str);
    0
}

// Return type test functions
fn test_int_returns() -> int {
    val <- return_int();
    take_int(val);
    0
}

fn test_bool_returns() -> int {
    val <- return_bool();
    take_bool(val);
    0
}

fn test_char_returns() -> int {
    val <- return_char();
    take_char(val);
    0
}

fn test_unit_returns() -> int {
    val <- return_unit();
    take_int(val);
    0
}

fn test_string_returns() -> int {
    val <- return_string();
    take_string(val);
    0
}

fn test_tuple_returns() -> int {
    val:(int, boolean) <- return_tuple();
    dummy <- take_tuple(val);
    0
}

fn chain_helpers() -> int {
    val1 <- return_int();
    val2 <- helper_mixed_types(val1, true, 'x');
    val3 <- helper_conditional_val(val2);
    take_int(val3);
    0
}


// Main function that orchestrates all tests
fn main() -> int proc[DeviceIO] {
    print("Testing function interactions...");
    dummy5 <- process_with_helpers();
    dummy6 <- process_conditional_returns();
    dummy7 <- complex_interaction_test();

    print("Basic type tests completed!");
    0
}

// Include the basic tests
fn test_function_types_basic() -> int {
    dummy1 <- take_int(123);
    dummy2 <- take_bool(false);
    dummy3 <- take_char('z');

    i:int <- return_int();
    b:boolean <- return_bool();
    c:char <- return_char();
    u:int <- return_unit();

    dummy4 <- take_int(i);
    dummy5 <- take_bool(b);
    dummy6 <- take_char(c);
    0
}

fn test_function_types_complex() -> int {
    dummy1 <- take_string("Direct string");
    dummy2 <- take_tuple((123, false));

    s:string <- return_string();
    t:(int, boolean) <- return_tuple();

    dummy3 <- take_string(s);
    dummy4 <- take_tuple(t);

    dummy5 <- use_helpers();
    0
}

fn test_helper_functions_types() -> int {
    dummy1 <- test_primitive_helpers();
    dummy2 <- test_complex_helpers();
    dummy3 <- test_nested_helpers();
    0
}

fn test_return_types() -> int proc[DeviceIO] {
    dummy1 <- test_int_returns();
    dummy2 <- test_bool_returns();
    dummy3 <- test_char_returns();
    dummy4 <- test_unit_returns();
    dummy5 <- test_string_returns();
    dummy6 <- test_tuple_returns();

    chained <- chain_helpers();
    print_int(chained);
    0
}

