-- Test return type handling in helper functions

-- Helper functions returning different types
fn return_int_helper() -> int {
    42
}

fn return_bool_helper() -> boolean {
    true
}

fn return_char_helper() -> char {
    'X'
}

-- Helper function with computation
fn compute_and_return(x: int, y: int) -> int {
    x + y
}

-- Function that uses helper return values
fn use_helper_returns() -> int {
    a: int <- return_int_helper();
    b: int <- compute_and_return(a, 8);
    b
}

-- Main function
fn main() -> int {
    i: int <- return_int_helper();
    b: boolean <- return_bool_helper();
    c: char <- return_char_helper();

    computed: int <- use_helper_returns();
    computed  -- Return the computed value
}
