-- Test passing function literals as parameters to higher-order functions
-- Demonstrates that function literals can be passed as first-class values

-- Function that takes a function as parameter (but doesn't call it yet)
fn accept_function(func: fn(int) -> int, value: int) -> int {
    -- For now, just return the value unchanged to demonstrate parameter passing
    value
}

-- Function that creates a multiplier function (returns it without calling)
fn make_multiplier(factor: int) -> fn(int) -> int {
    fn(x: int) -> int { x * factor }
}

fn main() -> int {
    -- Test 1: Pass function literal directly as parameter
    result1 <- accept_function(fn(x: int) -> int { x * 2 }, 10);

    -- Test 2: Pass different function literal
    result2 <- accept_function(fn(x: int) -> int { x + 100 }, 25);

    -- Test 3: Create and pass a multiplier function
    tripler <- make_multiplier(3);
    result3 <- accept_function(tripler, 7);

    -- Test 4: Chain creation and parameter passing
    quadrupler <- make_multiplier(4);
    result4 <- accept_function(quadrupler, 5);

    -- Return sum to verify the functions were accepted as parameters
    result1 + result2 + result3 + result4
}
