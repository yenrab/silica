// Test functions with complex parameter and return types

// Test functions with complex parameter types
fn take_string(s: string) -> int proc[DeviceIO] {
    print(s);
    0  // Return success status
}

fn take_tuple(t: (int, boolean)) -> int proc[DeviceIO] {
    (x, b) <- t;
    print_int(x);
    print_bool(b);
    0  // Return success status
}

// Test functions with complex return types
fn return_string() -> string {
    "Hello, World!"
}

fn return_tuple() -> (int, boolean) {
    (42, true)
}

// Helper function that processes a string
fn process_string(s: string) -> string {
    s  // For now just return the string
}

// Function that uses helper functions
fn use_helpers() -> int {
    s <- return_string();
    processed_s <- process_string(s);
    status1 <- take_string(processed_s);

    0  // Return status
}

// Main function
fn main() -> int {
    // Test functions with complex parameter types
    status1 <- take_string("Direct string");
    status2 <- take_tuple((123, true));

    // Test functions with complex return types
    s:string <- return_string();
    t:(int, boolean) <- return_tuple();

    // Test processing functions
    status3 <- take_string(s);
    status4 <- take_tuple(t);

    // Test helper functions
    status5 <- use_helpers();

    // Return combined status
    status1 + status2 + status3 + status4 + status5
}