-- Test functions with complex parameter and return types

-- Test functions with complex parameter types
fn take_string(s: String) -> Unit {
    print(s)
}

fn take_tuple(t: Tuple(Int, Bool)) -> Unit {
    (x: Int, b: Bool) <- t
    print_int(x)
    print_bool(b)
}

-- Test functions with complex return types
fn return_string() -> String {
    "Hello, World!"
}

fn return_tuple() -> Tuple(Int, Bool) {
    (42, true)
}

-- Helper function that processes a string
fn process_string(s: String) -> String {
    s  -- For now just return the string
}

-- Helper function that processes a tuple
fn process_tuple(t: Tuple(Int, Bool)) -> Tuple(Int, Bool) {
    (x: Int, b: Bool) <- t
    (x + 1, not b)
}

-- Function that uses helper functions
fn use_helpers() -> Unit {
    s <- return_string()
    processed_s <- process_string(s)
    take_string(processed_s)

    t <- return_tuple()
    processed_t <- process_tuple(t)
    take_tuple(processed_t)
}

-- Main function
fn main() -> Unit {
    take_string("Direct string")
    take_tuple((123, false))

    s <- return_string()
    t <- return_tuple()

    take_string(s)
    take_tuple(t)

    use_helpers()
}
