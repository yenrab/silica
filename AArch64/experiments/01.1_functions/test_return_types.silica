-- Test return type handling in helper functions

-- Helper functions with different return types
fn helper_return_int() -> int {
    42
}

fn helper_return_bool() -> boolean {
    true
}

fn helper_return_char() -> char {
    'Z'
}

fn helper_return_unit() -> int {
    0
}

-- Helper function that returns a computed value
fn helper_compute_sum(a: int, b: int) -> int {
    a + b
}

-- Helper function that returns a boolean result
fn helper_is_even(n: int) -> boolean {
    n % 2 == 0
}

-- Helper function that returns a char based on condition
fn helper_get_grade(score: int) -> char {
    case score >= 90 of {
        true -> 'A';
        false -> case score >= 80 of {
            true -> 'B';
            false -> case score >= 70 of {
                true -> 'C';
                false -> 'F'
            }
        }
    }
}

-- Functions that use helper return values
fn test_int_returns() -> int proc[DeviceIO] {
    x: int <- helper_return_int();
    y: int <- helper_compute_sum(x, 8);
    print_int(y);  -- Should print 50
    0
}

fn test_bool_returns() -> int proc[DeviceIO] {
    b1: boolean <- helper_return_bool();
    b2: boolean <- helper_is_even(4);
    b3: boolean <- helper_is_even(5);

    print_bool(b1);  -- true
    print_bool(b2);  -- true (4 is even)
    print_bool(b3);  -- false (5 is odd)
    0
}

fn test_char_returns() -> int proc[DeviceIO] {
    c1: char <- helper_return_char();
    c2: char <- helper_get_grade(95);
    c3: char <- helper_get_grade(75);
    c4: char <- helper_get_grade(65);

    print_char(c1);  -- 'Z'
    print_char(c2);  -- 'A'
    print_char(c3);  -- 'C'
    print_char(c4);  -- 'F'
    0
}

fn test_unit_returns() -> int proc[DeviceIO] {
    helper_return_unit();  -- Just call it, no return value to use
    print_int(999);        -- Print something to show execution
    0
}

-- Function that chains helper function calls
fn chain_helpers() -> int {
    base: int <- helper_return_int();
    doubled: int <- helper_compute_sum(base, base);
    doubled
}

-- Main function
fn main() -> int proc[DeviceIO] {
    test_int_returns();
    test_bool_returns();
    test_char_returns();
    test_unit_returns();

    chained: int <- chain_helpers();
    print_int(chained);  -- Should print 84
    0
}
