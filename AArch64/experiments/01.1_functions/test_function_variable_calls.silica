-- Test calling function literals stored in variables
-- Demonstrates dynamic function invocation through variable function calls

fn main() -> int {
    -- Test 1: Store function literal and call it directly
    doubler <- fn(x: int) -> int { x * 2 };
    result1 <- doubler(5);  -- Should be 10

    -- Test 2: Store different function and call it
    adder <- fn(x: int) -> int { x + 100 };
    result2 <- adder(25);   -- Should be 125

    -- Test 3: Store function with different logic
    square <- fn(x: int) -> int { x * x };
    result3 <- square(6);   -- Should be 36

    -- Test 4: Store function that uses variables from closure
    multiplier <- 3;
    scaled_add <- fn(x: int) -> int { x + multiplier * 10 };
    result4 <- scaled_add(5);  -- Should be 5 + 30 = 35

    -- Test 5: Function with conditional logic
    checker <- fn(x: int) -> int {
        case x > 10 of {
            true -> x * 2
            false -> x + 10
        }
    };
    result5a <- checker(15);  -- Should be 30
    result5b <- checker(5);   -- Should be 15

    -- Test 6: Chain function calls through variables
    increment <- fn(x: int) -> int { x + 1 };
    result6_temp <- doubler(3);      -- 3*2 = 6
    result6 <- increment(result6_temp);  -- 6+1 = 7

    -- Return sum to verify all results are correct
    result1 + result2 + result3 + result4 + result5a + result5b + result6
}
