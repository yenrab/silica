// Edge Cases Test
// Tests boundary conditions and unusual core affinity scenarios

fn main() -> int proc[concurrency] {
    do
        // Test 1: Core 0 targeting (edge case)
        spawn(0, fn(msg: int, state: int) -> int {
            state + msg
        }, 0);

        // Test 2: High core numbers (may exceed available cores)
        spawn(10, fn(msg: int, state: int) -> int {
            state + msg
        }, 15);  // May not exist on system

        spawn(20, fn(msg: int, state: int) -> int {
            state + msg
        }, 31);  // Definitely too high

        // Test 3: Negative core numbers (invalid)
        // Runtime should handle gracefully - fallback to load balancing
        spawn(30, fn(msg: int, state: int) -> int {
            state + msg
        }, -1);  // Should use performance_cores

        spawn(40, fn(msg: int, state: int) -> int {
            state + msg
        }, -5);  // Invalid - should fallback

        // Test 4: Single-core system simulation
        // These should all work even if only 1 core available
        spawn(100, fn(msg: int, state: int) -> int {
            state + 1
        }, any_core);

        spawn(200, fn(msg: int, state: int) -> int {
            state + 2
        }, performance_cores);

        spawn(300, fn(msg: int, state: int) -> int {
            state + 3
        }, efficiency_cores);

        // Test 5: Many actors with same affinity
        // Tests load balancer under load
        spawn(1000, fn(msg: int, state: int) -> int { state + 1 }, any_core);
        spawn(1001, fn(msg: int, state: int) -> int { state + 1 }, any_core);
        spawn(1002, fn(msg: int, state: int) -> int { state + 1 }, any_core);
        spawn(1003, fn(msg: int, state: int) -> int { state + 1 }, any_core);
        spawn(1004, fn(msg: int, state: int) -> int { state + 1 }, any_core);

        spawn(2000, fn(msg: int, state: int) -> int { state + 1 }, performance_cores);
        spawn(2001, fn(msg: int, state: int) -> int { state + 1 }, performance_cores);
        spawn(2002, fn(msg: int, state: int) -> int { state + 1 }, performance_cores);

        // Test 6: Affinity type consistency
        // Multiple actors using different affinity syntax for same result
        spawn(3000, fn(msg: int, state: int) -> int { state }, 0);        // Explicit 0
        spawn(3001, fn(msg: int, state: int) -> int { state }, any_core); // Identifier

        0
    end
}
