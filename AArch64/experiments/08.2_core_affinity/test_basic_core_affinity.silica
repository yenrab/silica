// Basic Core Affinity Test Suite
// Tests Phase 3.1: Basic Core Affinity features
// Demonstrates load balancing, core targeting, and backward compatibility

fn main() -> int64 proc[concurrency] {
    do
        // Test 1: Backward compatibility - spawn without core affinity
        // Should default to any_core load balancing
        spawn(0, fn(msg: int64, state: int64) -> int64 {
            state + msg
        });

        // Test 2: Explicit any_core affinity
        spawn(10, fn(msg: int64, state: int64) -> int64 {
            state * 2
        }, any_core);

        // Test 3: Specific core targeting
        spawn(20, fn(msg: int64, state: int64) -> int64 {
            state + msg * 2
        }, 1);  // Core 1

        spawn(30, fn(msg: int64, state: int64) -> int64 {
            state - msg
        }, 2);  // Core 2

        // Test 4: Performance cores load balancing
        spawn(40, fn(msg: int64, state: int64) -> int64 {
            state + msg * 3
        }, performance_cores);

        // Test 5: Efficiency cores load balancing
        spawn(50, fn(msg: int64, state: int64) -> int64 {
            state + msg * 4
        }, efficiency_cores);

        // Test 6: Multiple actors with same affinity type
        // Should demonstrate load balancing within the group
        spawn(60, fn(msg: int64, state: int64) -> int64 {
            state + 1
        }, performance_cores);

        spawn(70, fn(msg: int64, state: int64) -> int64 {
            state + 2
        }, performance_cores);

        spawn(80, fn(msg: int64, state: int64) -> int64 {
            state + 3
        }, efficiency_cores);

        spawn(90, fn(msg: int64, state: int64) -> int64 {
            state + 4
        }, efficiency_cores);

        // Test 7: Mixed affinity types
        spawn(100, fn(msg: int64, state: int64) -> int64 {
            state * 2
        }, 0);  // Explicit any core

        spawn(110, fn(msg: int64, state: int64) -> int64 {
            state + 2
        }, any_core);  // Identifier any core

        0
    end
}
