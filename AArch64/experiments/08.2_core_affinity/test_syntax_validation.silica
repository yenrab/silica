// Syntax Validation Test
// Minimal test to verify core affinity syntax compiles correctly

fn main() -> int proc[concurrency] {
    do
        // Test all core affinity syntax variants
        spawn(0, fn(msg: int, state: int) -> int { state }, any_core);
        spawn(1, fn(msg: int, state: int) -> int { state }, performance_cores);
        spawn(2, fn(msg: int, state: int) -> int { state }, efficiency_cores);
        spawn(3, fn(msg: int, state: int) -> int { state }, 0);
        spawn(4, fn(msg: int, state: int) -> int { state }, 1);
        spawn(5, fn(msg: int, state: int) -> int { state });  // No affinity

        0
    end
}
