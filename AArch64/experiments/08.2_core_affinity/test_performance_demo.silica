// Performance Demonstration Test
// Shows practical usage patterns for core affinity in real applications

fn main() -> int proc[concurrency] {
    do
        // Simulate a real application with different actor roles

        // UI/Frontend actors - need responsiveness
        spawn(UIState { clicks: 0, renders: 0 }, fn(msg: int, state: int) -> int {
            // Handle user interactions - must be responsive
            state + msg
        }, performance_cores);

        // Background processing actors - power efficient
        spawn(BackgroundState { tasks: 0, completed: 0 }, fn(msg: int, state: int) -> int {
            // Process background tasks - efficiency matters
            state + msg
        }, efficiency_cores);

        // Real-time data processing - high performance needed
        spawn(StreamState { processed: 0, errors: 0 }, fn(msg: int, state: int) -> int {
            // Handle real-time data streams
            state + msg * 2
        }, performance_cores);

        // Network I/O coordinator - pin to specific core for cache efficiency
        spawn(NetworkState { connections: 0, bytes: 0 }, fn(msg: int, state: int) -> int {
            // Coordinate network operations
            state + msg
        }, 1);  // Pin to core 1 for network I/O

        // Storage I/O coordinator - pin to different core
        spawn(StorageState { reads: 0, writes: 0 }, fn(msg: int, state: int) -> int {
            // Coordinate storage operations
            state + msg
        }, 2);  // Pin to core 2 for storage I/O

        // Load balancer actors - can run anywhere
        spawn(LoadBalancerState { requests: 0, workers: 4 }, fn(msg: int, state: int) -> int {
            // Route requests to worker actors
            state + msg
        }, any_core);

        // Worker pool - distributed load balancing
        spawn(WorkerState { id: 1, tasks: 0 }, fn(msg: int, state: int) -> int {
            state + msg
        }, any_core);

        spawn(WorkerState { id: 2, tasks: 0 }, fn(msg: int, state: int) -> int {
            state + msg
        }, any_core);

        spawn(WorkerState { id: 3, tasks: 0 }, fn(msg: int, state: int) -> int {
            state + msg
        }, any_core);

        spawn(WorkerState { id: 4, tasks: 0 }, fn(msg: int, state: int) -> int {
            state + msg
        }, any_core);

        // Monitoring actors - low priority background
        spawn(MonitorState { metrics: 0, alerts: 0 }, fn(msg: int, state: int) -> int {
            // Collect system metrics
            state + 1
        }, efficiency_cores);

        0
    end
}

// Application state types
type UIState = { clicks: int, renders: int };
type BackgroundState = { tasks: int, completed: int };
type StreamState = { processed: int, errors: int };
type NetworkState = { connections: int, bytes: int };
type StorageState = { reads: int, writes: int };
type LoadBalancerState = { requests: int, workers: int };
type WorkerState = { id: int, tasks: int };
type MonitorState = { metrics: int, alerts: int };
