// Load Balancing Test
// Demonstrates round-robin distribution across cores and core groups

fn main() -> int proc[concurrency] {
    do
        // Test 1: Multiple actors with any_core affinity
        // Should distribute across all available cores
        spawn(1, fn(msg: int, state: int) -> int { state + msg }, any_core);
        spawn(2, fn(msg: int, state: int) -> int { state + msg }, any_core);
        spawn(3, fn(msg: int, state: int) -> int { state + msg }, any_core);
        spawn(4, fn(msg: int, state: int) -> int { state + msg }, any_core);

        // Test 2: Multiple actors with performance_cores affinity
        // Should distribute among performance cores only
        spawn(10, fn(msg: int, state: int) -> int { state + msg }, performance_cores);
        spawn(20, fn(msg: int, state: int) -> int { state + msg }, performance_cores);
        spawn(30, fn(msg: int, state: int) -> int { state + msg }, performance_cores);

        // Test 3: Multiple actors with efficiency_cores affinity
        // Should distribute among efficiency cores only
        spawn(100, fn(msg: int, state: int) -> int { state + msg }, efficiency_cores);
        spawn(200, fn(msg: int, state: int) -> int { state + msg }, efficiency_cores);
        spawn(300, fn(msg: int, state: int) -> int { state + msg }, efficiency_cores);

        // Test 4: Mixed load balancing patterns
        // Some any_core, some performance, some efficiency
        spawn(1000, fn(msg: int, state: int) -> int { state + msg }, any_core);
        spawn(2000, fn(msg: int, state: int) -> int { state + msg }, performance_cores);
        spawn(3000, fn(msg: int, state: int) -> int { state + msg }, efficiency_cores);
        spawn(4000, fn(msg: int, state: int) -> int { state + msg }, any_core);

        0
    end
}
