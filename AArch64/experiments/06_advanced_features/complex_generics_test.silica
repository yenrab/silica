// Complex Generic Scenarios Test
// Tests advanced generic function usage, multiple parameters, etc.

fn pair<A, B>(first: A, second: B) -> (A, B) {
    (first, second)
}

fn swap<A, B>(pair: (A, B)) -> (B, A) {
    let (first, second) = pair;
    (second, first)
}

fn apply_twice<T>(value: T, f: fn(T) -> T) -> T {
    f(f(value))
}

fn double(x: int) -> int {
    x * 2
}

fn test_generic_pairs() -> int {
    do
        // Test pair creation
        int_pair <- pair<int, int>(10, 20);
        string_pair <- pair<string, int>("hello", 42);

        // Test pair manipulation
        swapped <- swap(int_pair);

        let (a, b) = swapped;

        // Return sum
        a + b
    end
}

fn test_higher_order_generics() -> int {
    // Test function that takes a generic function
    let result = apply_twice(5, double);

    // 5 -> 10 -> 20, so result should be 20
    result
}

fn test_multiple_generic_calls() -> int {
    do
        // Test chaining generic operations
        p1 <- pair<int, string>(100, "world");
        p2 <- pair<string, (int, string)>("hello", p1);

        // Extract and manipulate
        let (_, nested) = p2;
        let (num, _) = nested;

        num
    end
}

fn main() -> int {
    let pairs_result = test_generic_pairs();
    let higher_order_result = test_higher_order_generics();
    let multiple_result = test_multiple_generic_calls();

    pairs_result + higher_order_result + multiple_result
}
