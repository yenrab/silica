// Error Handling and Edge Cases Test
// Tests error conditions, boundary cases, and robustness

fn test_boundary_values() -> int {
    // Test with extreme values
    do
        r <- region();

        // Test with zero
        zero_ref <- alloc_ref(r, 0);
        zero_val <- read_ref(zero_ref);

        // Test with large numbers
        large_ref <- alloc_ref(r, 2147483647);  // Max 32-bit signed int
        large_val <- read_ref(large_ref);

        // Test with negative numbers
        neg_ref <- alloc_ref(r, -1000);
        neg_val <- read_ref(neg_ref);

        // Return a computed value to verify operations
        zero_val + (large_val / 1000000) + neg_val
    end
}

fn test_struct_edge_cases() -> int {
    // Test structs with various field types
    type ComplexStruct = {
        count: int,
        name: string,
        active: bool
    };

    type NestedStruct = {
        inner: ComplexStruct,
        values: (int, int)
    };

    do
        // Create complex nested structure
        complex <- ComplexStruct {
            count: 42,
            name: "test",
            active: true
        };

        nested <- NestedStruct {
            inner: complex,
            values: (10, 20)
        };

        // Access nested fields
        let inner_count = nested.inner.count;
        let (val1, val2) = nested.values;

        inner_count + val1 + val2
    end
}

fn test_deep_nesting() -> int {
    // Test deeply nested expressions and scopes
    do
        r <- region();

        do
            inner_r <- region();

            do
                deepest_r <- region();
                ref <- alloc_ref(r, 1);

                do
                    another_ref <- alloc_ref(inner_r, 2);
                    final_ref <- alloc_ref(deepest_r, 3);

                    val1 <- read_ref(ref);
                    val2 <- read_ref(another_ref);
                    val3 <- read_ref(final_ref);

                    val1 + val2 + val3
                end
            end
        end
    end
}

fn test_large_data_structures() -> int {
    // Test with larger data structures (within reason for testing)
    type BigTuple = (int, int, int, int, int);

    do
        big_tuple <- (1, 2, 3, 4, 5);

        let (a, b, c, d, e) = big_tuple;

        a + b + c + d + e
    end
}

fn main() -> int {
    let boundary_result = test_boundary_values();
    let struct_result = test_struct_edge_cases();
    let nesting_result = test_deep_nesting();
    let large_result = test_large_data_structures();

    boundary_result + struct_result + nesting_result + large_result
}
