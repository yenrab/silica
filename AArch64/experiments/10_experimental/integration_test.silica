// Integration Test - Combining Multiple Features
// Tests that all language features work together seamlessly

// Define a trait for testable objects
trait Testable {
    fn test_value(self) -> int;
    fn is_valid(self) -> bool;
}

// Implement for int
impl Testable for int {
    fn test_value(self) -> int {
        self
    }

    fn is_valid(self) -> bool {
        self >= 0
    }
}

// Generic function using traits
fn process_data<T: Testable>(data: T) -> int {
    if data.is_valid() {
        data.test_value() * 2
    } else {
        0
    }
}

// Struct with generic fields
type Container<T> = {
    value: T,
    metadata: string
};

// Actor for concurrent processing
fn create_processor(initial_count: int) -> int {
    do
        // Create an actor for processing
        processor <- spawn(initial_count, 0);

        // Send some work
        send(processor, 10);
        send(processor, 20);

        // Simulate receiving result (simplified)
        // In real implementation, this would receive from the actor
        42
    end
}

fn test_full_integration() -> int {
    do
        // Test memory management
        r <- region();
        data_ref <- alloc_ref(r, 100);

        // Test generics and traits
        let processed = process_data(50);

        // Test data structures
        container <- Container<int> {
            value: processed,
            metadata: "integration_test"
        };

        // Test pattern matching with structs
        let result = case container.value {
            0 -> 0;
            n -> n + 10
        };

        // Test file I/O (placeholder - would need proper setup)
        // let file_result = read_file("test.txt");

        // Test concurrency
        actor_result <- create_processor(5);

        // Combine all results
        final_val <- read_ref(data_ref);

        result + actor_result + final_val
    end
}

fn test_complex_patterns() -> int {
    // Test complex pattern matching scenarios
    type Result<T, E> = Ok T | Err E;
    type ComplexData = {
        id: int,
        values: (int, int, int),
        status: Result<string, string>
    };

    do
        data <- ComplexData {
            id: 123,
            values: (10, 20, 30),
            status: Ok("success")
        };

        // Complex pattern matching
        result <- case data {
            { id: 123, values: (a, b, c), status: Ok(msg) } -> a + b + c;
            { id: _, values: _, status: Err(_) } -> -1;
            _ -> 0
        };

        result
    end
}

fn main() -> int {
    let integration_result = test_full_integration();
    let pattern_result = test_complex_patterns();

    integration_result + pattern_result
}
