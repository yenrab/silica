        "canReceiveFrom": ["user", "sb:GenerationPersona1", "sb:ClarificationPersona1", "sb:ClarificationPersona2", "sb:DiscussionPersona1", "sb:DiscussionPersona2", "sb:FormalizationPersona1", "sb:FormalizationPersona2"],
