        "canReceiveFrom": ["user", "sb:ClarificationPersona1", "sb:ClarificationPersona2", "sb:DiscussionPersona1", "sb:DiscussionPersona2", "sb:FormalizationPersona1", "sb:FormalizationPersona2", "sb:GenerationPersona1", "sb:GenerationPersona2"],
