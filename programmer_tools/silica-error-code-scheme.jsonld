{
  "@context": {
    "@vocab": "https://aalang.dev/silica-dev/error-code/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "spec": "https://aalang.dev/silica-dev/specification/"
  },
  "@graph": [
    {
      "@id": "error-code-scheme",
      "@type": "ErrorCodeScheme",
      "name": "Silica Compiler Error Code Scheme",
      "version": "1.0",
      "description": "Comprehensive error code scheme for Silica compiler error messages. Error codes follow the format E#### where the first digit indicates the error category.",
      "categories": [
        {
          "range": "E0001-E0999",
          "category": "LexerErrors",
          "description": "Lexical analysis errors - invalid tokens, characters, or literals",
          "specificationSection": "spec:§2"
        },
        {
          "range": "E1000-E1999",
          "category": "ParseErrors",
          "description": "Syntax parsing errors - unexpected tokens, missing syntax elements, invalid constructs",
          "specificationSection": "spec:§3"
        },
        {
          "range": "E2000-E2999",
          "category": "TypeErrors",
          "description": "Type checking errors - type mismatches, undefined types, unification failures",
          "specificationSection": "spec:§6"
        },
        {
          "range": "E3000-E3999",
          "category": "EffectErrors",
          "description": "Effect system errors - missing effects, effect mismatches, capability violations",
          "specificationSection": "spec:§8"
        },
        {
          "range": "E4000-E4999",
          "category": "CodegenErrors",
          "description": "Code generation errors - LLVM context issues, unknown types, implementation gaps",
          "specificationSection": null
        },
        {
          "range": "E5000-E5999",
          "category": "ModuleErrors",
          "description": "Module and import errors - module resolution failures, import issues",
          "specificationSection": "spec:§11"
        },
        {
          "range": "E9000-E9999",
          "category": "InternalErrors",
          "description": "Internal compiler errors - implementation bugs, corrupted state",
          "specificationSection": null
        }
      ]
    },
    {
      "@id": "E0000",
      "@type": "LexerError",
      "errorCode": "E0000",
      "category": "LexerErrors",
      "name": "LexerErrorDefault",
      "description": "Default lexer error (used when specific error code not provided)",
      "commonCauses": [
        "Generic lexer error",
        "Error code not specified"
      ],
      "specificationSection": "spec:§2",
      "severity": "error"
    },
    {
      "@id": "E0001",
      "@type": "LexerError",
      "errorCode": "E0001",
      "category": "LexerErrors",
      "name": "UnexpectedCharacter",
      "description": "Encountered an unexpected character that cannot be tokenized",
      "commonCauses": [
        "Invalid character in source code",
        "Character not part of any valid token"
      ],
      "specificationSection": "spec:§2.1",
      "severity": "error"
    },
    {
      "@id": "E0002",
      "@type": "LexerError",
      "errorCode": "E0002",
      "category": "LexerErrors",
      "name": "InvalidEscapeSequence",
      "description": "Invalid escape sequence in string or character literal",
      "commonCauses": [
        "Unknown escape sequence (e.g., \\z)",
        "Invalid escape character"
      ],
      "specificationSection": "spec:§2.2.3",
      "severity": "error"
    },
    {
      "@id": "E0003",
      "@type": "LexerError",
      "errorCode": "E0003",
      "category": "LexerErrors",
      "name": "UnterminatedStringLiteral",
      "description": "String literal not properly closed with closing quote",
      "commonCauses": [
        "Missing closing double quote",
        "Unterminated string across multiple lines"
      ],
      "specificationSection": "spec:§2.2.3",
      "severity": "error"
    },
    {
      "@id": "E0004",
      "@type": "LexerError",
      "errorCode": "E0004",
      "category": "LexerErrors",
      "name": "UnterminatedCharacterLiteral",
      "description": "Character literal not properly closed with closing quote",
      "commonCauses": [
        "Missing closing single quote",
        "Multiple characters in character literal"
      ],
      "specificationSection": "spec:§2.2.3",
      "severity": "error"
    },
    {
      "@id": "E0005",
      "@type": "LexerError",
      "errorCode": "E0005",
      "category": "LexerErrors",
      "name": "InvalidIntegerLiteral",
      "description": "Integer literal cannot be parsed as a valid number",
      "commonCauses": [
        "Invalid hex literal (e.g., 0xGG)",
        "Invalid binary literal",
        "Number too large for i64"
      ],
      "specificationSection": "spec:§2.2.3",
      "severity": "error"
    },
    {
      "@id": "E0006",
      "@type": "LexerError",
      "errorCode": "E0006",
      "category": "LexerErrors",
      "name": "UnterminatedBlockComment",
      "description": "Block comment not properly closed",
      "commonCauses": [
        "Missing closing {- -}",
        "Nested comment issues"
      ],
      "specificationSection": "spec:§2.3.2",
      "severity": "error"
    },
    {
      "@id": "E1000",
      "@type": "ParseError",
      "errorCode": "E1000",
      "category": "ParseErrors",
      "name": "ParseErrorDefault",
      "description": "Default parse error (used when specific error code not provided)",
      "commonCauses": [
        "Generic parse error",
        "Error code not specified"
      ],
      "specificationSection": "spec:§3",
      "severity": "error"
    },
    {
      "@id": "E1001",
      "@type": "ParseError",
      "errorCode": "E1001",
      "category": "ParseErrors",
      "name": "ExpectedToken",
      "description": "Expected a specific token but found a different one",
      "commonCauses": [
        "Missing semicolon",
        "Missing closing brace/parenthesis/bracket",
        "Unexpected token in context"
      ],
      "specificationSection": "spec:§3",
      "severity": "error"
    },
    {
      "@id": "E1002",
      "@type": "ParseError",
      "errorCode": "E1002",
      "category": "ParseErrors",
      "name": "NestedFunctionDeclaration",
      "description": "Function declaration found inside another function body (nested functions not allowed)",
      "commonCauses": [
        "Function declared inside another function",
        "Function declared inside do block"
      ],
      "specificationSection": "spec:§3.4.1",
      "severity": "error",
      "suggestion": "Move function to top-level or use function literal (lambda)"
    },
    {
      "@id": "E1003",
      "@type": "ParseError",
      "errorCode": "E1003",
      "category": "ParseErrors",
      "name": "ExpectedIdentifier",
      "description": "Expected an identifier but found a different token",
      "commonCauses": [
        "Missing variable name",
        "Missing function name",
        "Missing type name"
      ],
      "specificationSection": "spec:§3",
      "severity": "error"
    },
    {
      "@id": "E1004",
      "@type": "ParseError",
      "errorCode": "E1004",
      "category": "ParseErrors",
      "name": "ExpectedType",
      "description": "Expected a type annotation but found a different token",
      "commonCauses": [
        "Missing type annotation",
        "Invalid type syntax"
      ],
      "specificationSection": "spec:§3",
      "severity": "error"
    },
    {
      "@id": "E1005",
      "@type": "ParseError",
      "errorCode": "E1005",
      "category": "ParseErrors",
      "name": "ExpectedExpression",
      "description": "Expected an expression but found a different token",
      "commonCauses": [
        "Missing expression in context",
        "Invalid expression syntax"
      ],
      "specificationSection": "spec:§3.3",
      "severity": "error"
    },
    {
      "@id": "E1006",
      "@type": "ParseError",
      "errorCode": "E1006",
      "category": "ParseErrors",
      "name": "ExpectedMemorySpace",
      "description": "Expected 'normal' or 'atomic' memory space specification",
      "commonCauses": [
        "Invalid memory space keyword",
        "Missing memory space in region type"
      ],
      "specificationSection": "spec:§10",
      "severity": "error"
    },
    {
      "@id": "E1007",
      "@type": "ParseError",
      "errorCode": "E1007",
      "category": "ParseErrors",
      "name": "WildcardRequiresTypeAnnotation",
      "description": "Wildcard pattern (_) must have explicit type annotation",
      "commonCauses": [
        "Wildcard without type annotation: _",
        "Should be: _: Type"
      ],
      "specificationSection": "spec:§3",
      "severity": "error"
    },
    {
      "@id": "E1008",
      "@type": "ParseError",
      "errorCode": "E1008",
      "category": "ParseErrors",
      "name": "UnsupportedSyntax",
      "description": "Syntax element not supported in Silica (e.g., if-else, for loops)",
      "commonCauses": [
        "Using 'if' keyword (use 'case' instead)",
        "Using 'for' keyword (use recursion instead)",
        "Using 'while' keyword (use recursion instead)"
      ],
      "specificationSection": "spec:§3",
      "severity": "error"
    },
    {
      "@id": "E1009",
      "@type": "ModuleError",
      "errorCode": "E1009",
      "category": "ModuleErrors",
      "name": "UnknownModuleInUse",
      "description": "A `use` clause names a module that is not part of the current compilation (silica.config)",
      "commonCauses": [
        "Typo in module name",
        "Module file not listed in silica.config",
        "Module path missing from the build"
      ],
      "specificationSection": "spec:§19.3",
      "severity": "error"
    },
    {
      "@id": "E1010",
      "@type": "ModuleError",
      "errorCode": "E1010",
      "category": "ModuleErrors",
      "name": "ModuleQualifiedCallWithoutUse",
      "description": "A module-qualified call (module@function) appears without a `use` for that module",
      "commonCauses": [
        "Omitted `use` for the callee module",
        "Wrong module prefix in the call"
      ],
      "specificationSection": "spec:§19.3",
      "severity": "error"
    },
    {
      "@id": "E1011",
      "@type": "ModuleError",
      "errorCode": "E1011",
      "category": "ModuleErrors",
      "name": "CrossModuleCallNotExported",
      "description": "A module-qualified call targets a function that is defined in the callee module but not listed on its export surface (spec §19.2)",
      "commonCauses": [
        "Calling a helper that was not exported from the module",
        "Stale or incomplete export list after adding an internal function"
      ],
      "specificationSection": "spec:§19.2",
      "severity": "error"
    },
    {
      "@id": "E2000",
      "@type": "TypeError",
      "errorCode": "E2000",
      "category": "TypeErrors",
      "name": "TypeErrorDefault",
      "description": "Default type error (used when specific error code not provided)",
      "commonCauses": [
        "Generic type error",
        "Error code not specified"
      ],
      "specificationSection": "spec:§6",
      "severity": "error"
    },
    {
      "@id": "E2001",
      "@type": "TypeError",
      "errorCode": "E2001",
      "category": "TypeErrors",
      "name": "TypeMismatch",
      "description": "Type mismatch - expected one type but found another",
      "commonCauses": [
        "Variable type doesn't match assigned value",
        "Function return type doesn't match body",
        "Function argument type doesn't match parameter"
      ],
      "specificationSection": "spec:§6.2",
      "severity": "error"
    },
    {
      "@id": "E2002",
      "@type": "TypeError",
      "errorCode": "E2002",
      "category": "TypeErrors",
      "name": "UndefinedType",
      "description": "Type name is not defined in current scope",
      "commonCauses": [
        "Type not imported",
        "Type name misspelled",
        "Type not declared"
      ],
      "specificationSection": "spec:§6.1",
      "severity": "error"
    },
    {
      "@id": "E2003",
      "@type": "TypeError",
      "errorCode": "E2003",
      "category": "TypeErrors",
      "name": "TypeUnificationFailure",
      "description": "Cannot unify two types (type inference failure)",
      "commonCauses": [
        "Conflicting type constraints",
        "Type inference cannot find common type",
        "Incompatible types in expression"
      ],
      "specificationSection": "spec:§6.3",
      "severity": "error"
    },
    {
      "@id": "E2004",
      "@type": "TypeError",
      "errorCode": "E2004",
      "category": "TypeErrors",
      "name": "VariableShadowing",
      "description": "Variable name shadows an existing binding (shadowing not allowed)",
      "commonCauses": [
        "Variable with same name as outer scope",
        "Parameter shadows outer variable"
      ],
      "specificationSection": "spec:§6",
      "severity": "error"
    },
    {
      "@id": "E2005",
      "@type": "TypeError",
      "errorCode": "E2005",
      "category": "TypeErrors",
      "name": "TupleArityMismatch",
      "description": "Tuple types have different number of elements",
      "commonCauses": [
        "Tuple pattern doesn't match tuple value",
        "Tuple type annotation has wrong arity"
      ],
      "specificationSection": "spec:§6.1",
      "severity": "error"
    },
    {
      "@id": "E2006",
      "@type": "TypeError",
      "errorCode": "E2006",
      "category": "TypeErrors",
      "name": "RecordFieldCountMismatch",
      "description": "Record types have different number of fields",
      "commonCauses": [
        "Struct literal missing fields",
        "Struct literal has extra fields",
        "Record type annotation has wrong field count"
      ],
      "specificationSection": "spec:§6.1",
      "severity": "error"
    },
    {
      "@id": "E2007",
      "@type": "TypeError",
      "errorCode": "E2007",
      "category": "TypeErrors",
      "name": "RecordFieldTypeMismatch",
      "description": "Record field type doesn't match expected type",
      "commonCauses": [
        "Struct field has wrong type",
        "Field type annotation incorrect"
      ],
      "specificationSection": "spec:§6.1",
      "severity": "error"
    },
    {
      "@id": "E2008",
      "@type": "TypeError",
      "errorCode": "E2008",
      "category": "TypeErrors",
      "name": "FunctionReturnTypeMismatch",
      "description": "Function body return type doesn't match declared return type",
      "commonCauses": [
        "Return expression has wrong type",
        "Function body returns different type than declared"
      ],
      "specificationSection": "spec:§6.3",
      "severity": "error"
    },
    {
      "@id": "E2009",
      "@type": "TypeError",
      "errorCode": "E2009",
      "category": "TypeErrors",
      "name": "MissingTraitImplementation",
      "description": "Type does not implement required trait",
      "commonCauses": [
        "Actor message type doesn't implement ActorMessage trait",
        "Type missing required trait implementation"
      ],
      "specificationSection": "spec:§7",
      "severity": "error"
    },
    {
      "@id": "E2010",
      "@type": "TypeError",
      "errorCode": "E2010",
      "category": "TypeErrors",
      "name": "TypeInferenceNotImplemented",
      "description": "Type inference not implemented for this expression type",
      "commonCauses": [
        "Compiler limitation",
        "Complex expression type not yet supported"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E2011",
      "@type": "TypeError",
      "errorCode": "E2011",
      "category": "TypeErrors",
      "name": "FunctionLiteralMissingEffectDeclaration",
      "description": "Function literal uses effects but doesn't declare them in proc[...] or missing required trait declaration",
      "commonCauses": [
        "Function literal uses I/O operations without proc[DeviceIO] or ActorIO trait declaration",
        "Function literal uses concurrency operations without proc[concurrency]",
        "Function literal uses effects but missing proc[...] declaration",
        "Actor handler function uses I/O operations without ActorIO trait declaration"
      ],
      "specificationSection": "spec:§3.4.1",
      "severity": "error",
      "suggestion": "Add proc[EffectName] to function literal signature: fn(params) -> ReturnType proc[EffectName] { ... } or add trait declaration: impl ActorIO for fn(...) -> ...;"
    },
    {
      "@id": "E3000",
      "@type": "EffectError",
      "errorCode": "E3000",
      "category": "EffectErrors",
      "name": "EffectErrorDefault",
      "description": "Default effect error (used when specific error code not provided)",
      "commonCauses": [
        "Generic effect error",
        "Error code not specified"
      ],
      "specificationSection": "spec:§8",
      "severity": "error"
    },
    {
      "@id": "E3001",
      "@type": "EffectError",
      "errorCode": "E3001",
      "category": "EffectErrors",
      "name": "MissingEffectCapability",
      "description": "Expression requires effect not covered by active capabilities",
      "commonCauses": [
        "Function doesn't declare required effects in proc[...]",
        "Effect not in active effect set",
        "Missing effect declaration"
      ],
      "specificationSection": "spec:§8",
      "severity": "error"
    },
    {
      "@id": "E3002",
      "@type": "EffectError",
      "errorCode": "E3002",
      "category": "EffectErrors",
      "name": "EffectNotActive",
      "description": "Required effect is not currently active",
      "commonCauses": [
        "Effect capability not available in current context",
        "Effect not pushed onto capability stack"
      ],
      "specificationSection": "spec:§8",
      "severity": "error"
    },
    {
      "@id": "E3003",
      "@type": "EffectError",
      "errorCode": "E3003",
      "category": "EffectErrors",
      "name": "EffectCompatibilityMismatch",
      "description": "Required effect not declared in function signature",
      "commonCauses": [
        "Function body uses effect not in proc[...]",
        "Effect mismatch between declaration and usage"
      ],
      "specificationSection": "spec:§8",
      "severity": "error"
    },
    {
      "@id": "E3004",
      "@type": "EffectError",
      "errorCode": "E3004",
      "category": "EffectErrors",
      "name": "EffectPushFailure",
      "description": "Failed to push declared effects onto capability stack",
      "commonCauses": [
        "Internal compiler error",
        "Effect system state corruption"
      ],
      "specificationSection": "spec:§8",
      "severity": "error"
    },
    {
      "@id": "E4000",
      "@type": "CodegenError",
      "errorCode": "E4000",
      "category": "CodegenErrors",
      "name": "CodegenErrorDefault",
      "description": "Default codegen error (used when specific error code not provided)",
      "commonCauses": [
        "Generic code generation error",
        "Error code not specified"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E4001",
      "@type": "CodegenError",
      "errorCode": "E4001",
      "category": "CodegenErrors",
      "name": "LLVMContextNotInitialized",
      "description": "LLVM context not initialized for code generation",
      "commonCauses": [
        "LLVM backend not properly set up",
        "Codegen called before initialization"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E4002",
      "@type": "CodegenError",
      "errorCode": "E4002",
      "category": "CodegenErrors",
      "name": "UnknownStructType",
      "description": "Struct type not found during code generation",
      "commonCauses": [
        "Type not defined",
        "Type not in codegen symbol table"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E4003",
      "@type": "CodegenError",
      "errorCode": "E4003",
      "category": "CodegenErrors",
      "name": "UnknownVariable",
      "description": "Variable not found in codegen context",
      "commonCauses": [
        "Variable not in scope",
        "Variable not tracked in codegen"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E4004",
      "@type": "CodegenError",
      "errorCode": "E4004",
      "category": "CodegenErrors",
      "name": "NotImplemented",
      "description": "Code generation not implemented for this construct",
      "commonCauses": [
        "Compiler limitation",
        "Feature not yet implemented"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E5001",
      "@type": "ModuleError",
      "errorCode": "E5001",
      "category": "ModuleErrors",
      "name": "ModuleNotFound",
      "description": "Module not found in search paths",
      "commonCauses": [
        "Module file doesn't exist",
        "Module not in search path",
        "Incorrect module name"
      ],
      "specificationSection": "spec:§11",
      "severity": "error"
    },
    {
      "@id": "E5002",
      "@type": "ModuleError",
      "errorCode": "E5002",
      "category": "ModuleErrors",
      "name": "ModuleReadFailure",
      "description": "Failed to read module file",
      "commonCauses": [
        "File permission issues",
        "File doesn't exist",
        "IO error"
      ],
      "specificationSection": "spec:§11",
      "severity": "error"
    },
    {
      "@id": "E5003",
      "@type": "ModuleError",
      "errorCode": "E5003",
      "category": "ModuleErrors",
      "name": "InvalidModuleFilename",
      "description": "Module filename is invalid",
      "commonCauses": [
        "Filename doesn't match module name",
        "Invalid file extension"
      ],
      "specificationSection": "spec:§11",
      "severity": "error"
    },
    {
      "@id": "E9000",
      "@type": "InternalError",
      "errorCode": "E9000",
      "category": "InternalErrors",
      "name": "InternalErrorDefault",
      "description": "Default internal error (used when specific error code not provided)",
      "commonCauses": [
        "Generic internal compiler error",
        "Error code not specified"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E9001",
      "@type": "InternalError",
      "errorCode": "E9001",
      "category": "InternalErrors",
      "name": "InternalCompilerError",
      "description": "Internal compiler error - unexpected state or bug",
      "commonCauses": [
        "Compiler bug",
        "Corrupted internal state",
        "Unexpected condition"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E9002",
      "@type": "InternalError",
      "errorCode": "E9002",
      "category": "InternalErrors",
      "name": "ParserPositionCorrupted",
      "description": "Parser position tracking corrupted",
      "commonCauses": [
        "Internal parser state issue",
        "Position tracking bug"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E9003",
      "@type": "InternalError",
      "errorCode": "E9003",
      "category": "InternalErrors",
      "name": "IOError",
      "description": "IO error during compilation",
      "commonCauses": [
        "File read/write failure",
        "Permission issues",
        "Disk full"
      ],
      "specificationSection": null,
      "severity": "error"
    },
    {
      "@id": "E9004",
      "@type": "InternalError",
      "errorCode": "E9004",
      "category": "InternalErrors",
      "name": "UTF8Error",
      "description": "UTF-8 encoding error",
      "commonCauses": [
        "Invalid UTF-8 in source file",
        "Encoding conversion failure"
      ],
      "specificationSection": null,
      "severity": "error"
    }
  ]
}
