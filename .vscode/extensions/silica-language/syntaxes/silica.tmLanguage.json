{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Silica",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#actors"
    },
    {
      "include": "#effects"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.silica",
          "match": "//.*$"
        },
        {
          "name": "comment.block.silica",
          "begin": "\\{-",
          "end": "-\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.silica"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.silica"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.silica",
          "match": "\\b(if|else|case|do|end|for|return|let|where)\\b"
        },
        {
          "name": "keyword.other.silica",
          "match": "\\b(fn|type|struct|enum|trait|impl|module|use|import|export|pub|as|from|of|cast|self|underscore)\\b"
        },
        {
          "name": "keyword.operator.logical.silica",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.other.unit.silica",
          "match": "\\b(unit|true|false)\\b"
        },
        {
          "name": "keyword.other.actor.silica",
          "match": "\\b(actor|actor_ref|spawn|send|recv|mailbox)\\b"
        },
        {
          "name": "keyword.other.effect.silica",
          "match": "\\b(effect|proc|concurrency|mem|device_io|atomic|normal)\\b"
        },
        {
          "name": "keyword.other.memory.silica",
          "match": "\\b(ref|region|buf)\\b"
        },
        {
          "name": "keyword.other.core.silica",
          "match": "\\b(core_id|core_set|efficiency_cores|performance_cores|includes)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.silica",
          "match": "\\b(int|bool|char|string|unit)\\b"
        },
        {
          "name": "entity.name.type.silica",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#character"
        },
        {
          "include": "#number"
        },
        {
          "include": "#boolean"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.silica",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.silica",
          "match": "\\\\[nrt\\\\\"']"
        },
        {
          "name": "invalid.illegal.character.escape.silica",
          "match": "\\\\."
        }
      ]
    },
    "character": {
      "name": "string.quoted.single.silica",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.silica",
          "match": "\\\\[nrt\\\\\"']"
        },
        {
          "name": "invalid.illegal.character.escape.silica",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.silica",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.silica",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.silica",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "boolean": {
      "name": "constant.language.boolean.silica",
      "match": "\\b(true|false)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.silica",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.silica",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.silica",
          "match": "(<-|=)"
        },
        {
          "name": "keyword.operator.arrow.silica",
          "match": "(->|::)"
        },
        {
          "name": "keyword.operator.type.silica",
          "match": ":"
        },
        {
          "name": "keyword.operator.reference.silica",
          "match": "&"
        },
        {
          "name": "keyword.operator.logical.silica",
          "match": "!"
        },
        {
          "name": "punctuation.separator.silica",
          "match": "[,;]"
        },
        {
          "name": "punctuation.definition.group.silica",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.array.silica",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.block.silica",
          "match": "[{}]"
        },
        {
          "name": "punctuation.other.silica",
          "match": "[.|]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.silica",
          "begin": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.function.silica"
            },
            "2": {
              "name": "entity.name.function.silica"
            }
          },
          "end": "(?=\\{|->|$)",
          "patterns": [
            {
              "include": "#parameters"
            },
            {
              "include": "#types"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.silica",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "actors": {
      "patterns": [
        {
          "name": "meta.actor.silica",
          "begin": "\\b(actor)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.actor.silica"
            },
            "2": {
              "name": "entity.name.type.actor.silica"
            }
          },
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "meta.effect.silica",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "keyword.other.effect.silica",
              "match": "\\b(mem|concurrency|device_io|atomic|normal)\\b"
            },
            {
              "name": "punctuation.definition.effect.silica",
              "match": "[()]"
            },
            {
              "include": "#identifiers"
            }
          ]
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.silica",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.silica"
}
