{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Silica",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#strings" },
    { "include": "#character-literals" },
    { "include": "#atom-literals" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#effects" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.silica",
          "match": "//[^\\n]*"
        },
        {
          "name": "comment.block.silica",
          "begin": "\\{-",
          "end": "-\\}"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.silica",
          "match": "\\b(actor|actor_ref|as|atom|atomic|buf|case|cast|do|else|end|enum|fn|for|from|if|impl|import|module|not|of|proc|pub|recv|ref|region|return|self|send|spawn|trait|type|use|where)\\b"
        },
        {
          "name": "keyword.other.silica",
          "match": "\\b(concurrency|core_id|core_set|device_io|effect|efficiency_cores|mailbox|mem|normal|performance_cores)\\b"
        },
        {
          "name": "constant.language.silica",
          "match": "\\b(true|false|underscore)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.silica",
          "match": "\\b(int8|int16|int32|int64|float16|float32|float64|bool|char|string|unit|atom|actor_ref|core_id|core_set|performance_cores|efficiency_cores)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.silica",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.silica",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.silica",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "character-literals": {
      "patterns": [
        {
          "name": "string.quoted.single.silica",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.silica",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "atom-literals": {
      "patterns": [
        {
          "name": "constant.other.symbol.silica",
          "match": ":[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.silica",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.silica",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.silica",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.silica",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "keyword.operator.silica",
          "match": "(<-|->|::|\\+|\\-|\\*|/|%|==|!=|<=|>=|<|>|&&|\\|\\||!|\\?|:|\\||=|@)"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "meta.effect.silica",
          "begin": "proc\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "keyword.other.effect.silica",
              "match": "\\b(device_io|mem\\(normal\\)|concurrency)\\b"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.silica"
}
