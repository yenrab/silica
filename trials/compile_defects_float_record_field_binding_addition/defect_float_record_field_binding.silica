// A float64 field bound by a record case pattern, `{ x: a, y: b }`, is loaded into an integer
// register and then moved with `FMOV S2, X1`, which the assembler rejects (a 64-bit float needs a D
// register): term_case_patterns@emit_ldr_record_field loads every field as an X register and the
// binding is consumed as float32. Found 2026-10-02 while writing the record-shape trials; the same
// program with the fields read by projection assembles. Expected: prints 7; exits 0.

fn whole(p: { x: float64, y: float64 }) -> int64 {
    case p of {
        { x: a, y: b } -> case a + b > 6.5 of { true -> 7; false -> 6 }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        print_int64(whole({ x: 3.5, y: 3.25 }));
        println("")
    produces
        pure 0
    end
}
