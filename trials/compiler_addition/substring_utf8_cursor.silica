// One UTF-8 character disables the all-ASCII substring fast path.
// Sequential substring(s, i, i+1) must resume from a cached byte offset;
// walking from byte 0 each time is O(n²) and hung lex of type_interner.silica
// (comments contain § — →). Want 42.

fn score_char(ch: string) -> int64 {
    case ch of {
        "§" -> 2;
        "x" -> 1;
        "" -> 0;
        _ -> 0
    }
}

fn walk(s: string, i: int64, acc: int64) -> int64 {
    ch: string <- substring(s, i, i + 1);
    case ch of {
        "" -> acc;
        _: string -> walk(s, i + 1, acc + score_char(ch))
    }
}

fn grow(n: int64, acc: string) -> string {
    case n <= 0 of {
        true -> acc;
        false -> grow(n - 1, concat(acc, "aaaaaaaaaa"))
    }
}

fn main() -> int64 {
    sequence
        body: string <- grow(400, "");
        s: string <- concat("§", concat(body, "x"));
        result: int64 <- case walk(s, 0, 0) == 3 of {
            true -> 42;
            false -> 1
        }
    produces
        pure result
    end
}
