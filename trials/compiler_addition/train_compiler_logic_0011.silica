// and/or truth table bits (bool alias accepted); want 25
fn tt() -> bool {
    true
}

fn ff() -> bool {
    false
}

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn main() -> int64 {
    r0: int64 <- bit(ff() or tt(), 1);
    r1: int64 <- bit(ff() or ff(), 2);
    r2: int64 <- bit(ff() and ff(), 4);
    r3: int64 <- bit(tt() and tt(), 8);
    r4: int64 <- bit(tt() or tt(), 16);
    r0 + r1 + r2 + r3 + r4
}
