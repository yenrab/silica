// Whole-line `//` and end-of-line `//` must stop at the newline.
// If the comment runs to EOF, `main` is never parsed (undefined symbol).
// If `//` is two `/` tokens, this is a parse error or `3 / / 4`.
// A lone `/` after a comment is still division.
// Want 7.

// whole-line comment before the function
fn main() -> int64 {
    a: int64 <- 6; // end-of-line after a binding
    // whole-line comment between statements
    b: int64 <- 2; // end-of-line after another binding
    a / b + 4 // end-of-line after the return expression
}
