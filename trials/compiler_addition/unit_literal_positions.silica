// The unit literal `()` (spec §2.2.3) in every legal expression position: a discard binding,
// a call argument, and an alloc_ref payload (unit is not a valid return type, E2006). Both parsers used to return a dummy for `()`, which silently emptied
// the enclosing function body (memory_region_addition/alloc_ref_unit passed only because the
// placeholder main returned 0). Want 44.
fn take_unit(u: unit, n: int64) -> int64 {
    n + 1
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        _: unit <- ();
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        cell: ref(L1, normal, unit) <- alloc_ref(r, ());
        m: int64 <- case cell of { _: ref(L1, normal, unit) -> 0 };
        n: int64 <- take_unit((), 40) + take_unit((), 2) + m
    produces
        pure n
    end
}
