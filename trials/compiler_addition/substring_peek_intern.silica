// peek_char is substring(s, i, i+1). The helper used to mmap a page per call and
// strlen the whole source each time, so lexing a large ASCII unit hung and grew
// multi-GB. Empty and 1-byte results must intern and still compare equal to
// literals; a longer slice must still copy. Want 42.

fn score_char(ch: string) -> int64 {
    case ch of {
        "a" -> 1;
        " " -> 2;
        "\n" -> 3;
        "x" -> 4;
        "" -> 0;
        _ -> 7
    }
}

fn walk(s: string, i: int64, acc: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> case substring(s, i, i + 1) == "" of {
            true -> acc;
            false -> -1
        };
        false -> walk(s, i + 1, acc + score_char(substring(s, i, i + 1)))
    }
}

fn main() -> int64 {
    sequence
        walked: int64 <- walk("a x\na", 0, 0);
        mid: string <- substring("hello", 1, 4);
        extra: int64 <- case mid == "ell" of {
            true -> 31;
            false -> 0
        };
        result: int64 <- walked + extra
    produces
        pure result
    end
}
