// `call` with a record ActorMessage must lower to record_make (stack stores),
// not MOV Xn, #0. A null message pointer makes the PID-registry behavior
// load from address 0 (SIGILL / exit 132).

fn worker_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        wa: actor_ref <- spawn(0, worker_beh);
        dummy: actor_ref <- spawn(0, worker_beh);
        reg: actor_ref <- get_pid_registry();
        _: (atom, actor_ref) <- call(reg,
            { op: :insert, name: :stick_key, pid: wa } impl ActorMessage {});
        lr: (atom, actor_ref) <- call(reg,
            { op: :lookup, name: :stick_key, pid: dummy } impl ActorMessage {});
        (r: atom, _: actor_ref) <- lr;
        _: atom <- print_atom(r);
        println("");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
