// Selfhost type-check hung on `required { fn ... }` (Announcer / Doubling / Sizeable).
// extract_trait_required_fn let-bound the tag-7 decl and returned `(decl, rest)`;
// the record must be built inline in the pair. Want 42.

export trait TraitRequiredFn;
export double/1;

required {
    fn double(x: TraitRequiredFn) -> int64;
}

impl fn double(n: int64) -> int64 {
    n + n
}

fn main() -> int64 {
    double(21)
}
