fn digits(a: int64, b: int64, k: int64) -> (int64, int64) {
    case k > 0 of {
        true -> (a + k, b + 1);
        false -> (a, b)
    }
}

fn read_hex(start: int64) -> (int64, int64) {
    p: int64 <- start + 1;
    q: int64 <- p + 1;
    digits(q, p, 3)
}

fn read_many(n: int64, acc: int64) -> int64 {
    case n > 0 of {
        true -> {
            (v: int64, w: int64) <- read_hex(n);
            read_many(n - 1, acc + v + w)
        };
        false -> acc
    }
}

fn main() -> int64 {
    read_many(6, 0)
}
