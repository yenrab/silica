// Nested export surface is interned at publish (after emit / after SIR in batch).
// Pair with iface_after_emit_use.silica. Want 7.

export pack/0;

fn pack() -> { a: int64, inner: { b: int64, c: int64 } } {
    { a: 3, inner: { b: 4, c: 5 } }
}

fn main() -> int64 {
    p: { a: int64, inner: { b: int64, c: int64 } } <- pack();
    p.a + p.inner.b
}
