    ADRP X0, L_sc_arena_end
    ADD X0, X0, :lo12:L_sc_arena_end
    STR X1, [X0]
    B L_sc_rt_caches
L_sc_rt_noend:
    ADRP X0, L_sc_arena_end
    ADD X0, X0, :lo12:L_sc_arena_end
    STR XZR, [X0]
L_sc_rt_caches:
    ADRP X0, L_sc_len_key
    ADD X0, X0, :lo12:L_sc_len_key
    STR XZR, [X0]
    ADRP X0, L_sc_len_val
    ADD X0, X0, :lo12:L_sc_len_val
    STR XZR, [X0]
    LDP X19, X20, [SP], #16
    LDP X2, X3, [SP], #16
    LDP X0, X1, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_sc_arena_release:
    STP X19, X30, [SP, #-32]!
    STP X20, X21, [SP, #16]
    ADRP X20, L_sc_arena_head
    ADD X20, X20, :lo12:L_sc_arena_head
    LDR X19, [X20]
L_sc_rel_loop:
    CBZ X19, L_sc_rel_done
    LDR X21, [X19]
    LDR X1, [X19, #8]
    MOV X0, X19
    STR X8, [SP, #-16]!
    MOV X8, #215
    SVC #0
    LDR X8, [SP], #16
    MOV X19, X21
    B L_sc_rel_loop
L_sc_rel_done:
    STR XZR, [X20]
    ADRP X1, L_sc_arena_ptr
    ADD X1, X1, :lo12:L_sc_arena_ptr
    STR XZR, [X1]
    ADRP X1, L_sc_arena_end
    ADD X1, X1, :lo12:L_sc_arena_end
    STR XZR, [X1]
    ADRP X1, L_sc_len_key
    ADD X1, X1, :lo12:L_sc_len_key
    STR XZR, [X1]
    ADRP X1, L_sc_len_val
    ADD X1, X1, :lo12:L_sc_len_val
    STR XZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
    .bss
    .p2align 3
L_sc_len_key:
    .space 8
L_sc_len_val:
    .space 8
L_sc_arena_ptr:
    .space 8
L_sc_arena_end:
    .space 8
L_sc_arena_head:
