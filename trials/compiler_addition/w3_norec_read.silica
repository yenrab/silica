// No recursion at all: one call returning (bool, record), then read a field of the
// destructured record. If this is wrong, the trigger is the field access on a
// tuple-destructured record binding -- recursion is irrelevant.
fn tag(n: int64) -> { line: int64, col: int64 } { { line: n, col: n } }

fn pick(flag: bool) -> (bool, { line: int64, col: int64 }) {
    case flag of { true -> (true, tag(1)); false -> (false, tag(2)) }
}

fn main() -> int64 {
    (bad: bool, r: { line: int64, col: int64 }) <- pick(false);
    r.line          // want 2
}
