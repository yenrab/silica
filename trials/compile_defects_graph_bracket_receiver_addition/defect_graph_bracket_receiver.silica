// Documented open type-checker defect (2026-09-18), found while writing the DirectedGraph and
// WeightedGraph traits (stdlib/data_structures/DirectedGraph.silica deviation 6, WeightedGraph.silica
// deviation 4). It sits alone in this directory because a compile rejection fails the whole directory.
//
// Defect: a value bound with DirectedGraph[N, P, mem(S)] from its registered constructor cannot be
// passed to any trait method whose implementation takes the constructor's record. The bracket-to-
// record fit (type_checker_collections collection_return_accepts_directed_graph) checks the record's
// edge_target field with fn_type_witnesses_edge_target, which compares fn(ValueType) -> KeyType with
// fn(int64) -> int64 by plain type equality, without the placeholder acceptance the compare_node /
// compare_edge checks have. WeightedGraph[N, E, W, mem(S)] fails the same way through its
// edge_weight field ("type mismatch" on the receiver). directed_graph_trait.md §3/§11 dispatch
// DirectedGraph@... on exactly such a value (`DirectedGraph@has_edge(g1.graph, 10, 20)`).
// Expected: compiles and prints 3, exit 0.
// Observed: E2003 on the receiver argument ("argument type DirectedGraph [ int64 , int64 ,
// mem ( normal ) ] does not match parameter type {...} for ProbeDirected@count").
//
// To run by hand:
//   mkdir -p /tmp/gbr && cp StubGraphDirected.silica ProbeDirected.silica defect_graph_bracket_receiver.silica /tmp/gbr/ && cd /tmp/gbr
//   printf 'StubGraphDirected.silica\nProbeDirected.silica\ndefect_graph_bracket_receiver.silica\n' > silica.config
//   /Volumes/2T/silica/binaries/silica-compiler

use StubGraphDirected;
use ProbeDirected;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn ident(x: int64) -> int64 {
    x
}

fn main() -> int64 {
    sequence proc[device_io]
        g: DirectedGraph[int64, int64, mem(normal)] <- StubGraphDirected@empty({ compare_node: cmp_i64, compare_edge: cmp_i64, edge_target: ident });
        n: int64 <- ProbeDirected@count(g);
        print_int64(n);
        println("")
    produces
        pure 0
    end
}
