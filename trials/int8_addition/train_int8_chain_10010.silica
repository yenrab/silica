// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8(48 + 31);
        println("");
        _: atom <- print_int8(27 + 59);
        println("");
        _: atom <- print_int8(60);
        println("");
        result: atom <- print_int8(13 % (59 / 50))
    produces pure result end
}
