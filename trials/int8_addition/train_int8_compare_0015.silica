// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(31 % 17 < (43 + 60));
        println("");
        _: atom <- print_bool((1 + 30) < (23 - 13));
        println("");
        _: atom <- print_bool((9 + 22) <= (57 + 16));
        println("");
        result: atom <- print_bool(24 % 34 >= 34 / 1)
    produces pure result end
}
