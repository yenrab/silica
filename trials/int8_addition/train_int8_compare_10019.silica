// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(46 % 48 >= 53);
        println("");
        _: atom <- print_bool(18 > 40 % 22);
        println("");
        result: atom <- print_bool((38 - 37) <= (36 + 33))
    produces
        pure result
    end
}
