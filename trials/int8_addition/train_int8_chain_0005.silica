// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8(59);
        println("");
        _: atom <- print_int8(50 - 40 + 19 % 49);
        println("");
        _: atom <- print_int8(28);
        println("");
        result: atom <- print_int8(33)
    produces pure result end
}
