// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((12 + 41) >= 54 / 38);
        println("");
        _: atom <- print_bool((45 - 43) != 48);
        println("");
        _: atom <- print_bool((10 + 51) >= (8 + 43));
        println("");
        result: atom <- print_bool(56 >= (1 + 3))
        produces pure result end
}
