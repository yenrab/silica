// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((12 + 42) <= 11);
        println("");
        _: atom <- print_bool(55 / 32 == (8 + 9));
        println("");
        _: atom <- print_bool((18 + 7) <= 0 % 32);
        println("");
        _: atom <- print_bool(37 > 48 % 58);
        println("");
        result: atom <- print_bool((0 + 18) >= 2)
        produces pure result end
}
