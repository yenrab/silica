// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((10 + 8) != (15 + 53));
        println("");
        _: atom <- print_bool(42 > 50);
        println("");
        _: atom <- print_bool((31 + 35) < (25 - 10));
        println("");
        result: atom <- print_bool(12 % 6 >= 48)
    produces pure result end
}
