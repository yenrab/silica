// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(49 / 42 >= (48 + 38));
        println("");
        _: atom <- print_bool((48 + 19) > 55);
        println("");
        _: atom <- print_bool(11 > 21 / 16);
        println("");
        _: atom <- print_bool((56 - 24) < 39);
        println("");
        result: atom <- print_bool((22 + 48) == (32 + 28))
        produces pure result end
}
