// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(46 % 58 > 36 % 26);
        println("");
        _: atom <- print_bool((20 + 21) > 13);
        println("");
        result: atom <- print_bool((46 - 41) < 28)
    produces pure result end
}
