// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(19 / 7 <= 5 / 49);
        println("");
        _: atom <- print_bool(46 > (37 + 56));
        println("");
        _: atom <- print_bool(41 / 36 != 5);
        println("");
        result: atom <- print_bool((58 - 4) == 17)
    produces
        pure result
    end
}
