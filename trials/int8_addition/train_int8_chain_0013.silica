// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8(((53 + 29) + (7 + 13)));
        println("");
        _: atom <- print_int8(27);
        println("");
        result: atom <- print_int8(6)
    produces
        pure result
    end
}
