// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((19 + 38) > 49 / 60);
        println("");
        _: atom <- print_bool(29 >= 46);
        println("");
        _: atom <- print_bool((36 + 48) == 3 / 8);
        println("");
        result: atom <- print_bool((45 % 57) <= 22)
    produces pure result end
}
