// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8(48);
        println("");
        _: atom <- print_int8(35 / 6);
        println("");
        _: atom <- print_int8(45 / 12);
        println("");
        result: atom <- print_int8(58)
    produces pure result end
}
