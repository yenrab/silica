// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8(23 + 58);
        println("");
        _: atom <- print_int8(22);
        println("");
        _: atom <- print_int8(4);
        println("");
        result: atom <- print_int8(40)
    produces pure result end
}
