// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((44 + 25) > 12);
        println("");
        _: atom <- print_bool((44 + 33) > 16);
        println("");
        result: atom <- print_bool(57 % 26 == (1 - 0))
        produces pure result end
}
