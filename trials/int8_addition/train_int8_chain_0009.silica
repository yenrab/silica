// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8((32 + 44) % 44);
        println("");
        _: atom <- print_int8(21);
        println("");
        _: atom <- print_int8(24);
        println("");
        result: atom <- print_int8(20)
    produces pure result end
}
