// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(35 % 18 == (49 + 48));
        println("");
        _: atom <- print_bool(54 / 13 <= 12);
        println("");
        _: atom <- print_bool(55 % 39 >= (13 + 57));
        println("");
        result: atom <- print_bool(16 < (23 + 21))
    produces pure result end
}
