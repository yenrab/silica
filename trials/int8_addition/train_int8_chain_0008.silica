// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8((34 + 26) % 49);
        println("");
        _: atom <- print_int8(49 + (11 + 35));
        println("");
        _: atom <- print_int8(38);
        println("");
        result: atom <- print_int8(41)
    produces pure result end
}
