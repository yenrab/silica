// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(33.25 != 29.5);
        println("");
        _: atom <- print_bool(9.0 >= (28.5 + 14.25));
        println("");
        _: atom <- print_bool((28.5 + 24.5) > (40.5 - 1.0));
        println("");
        done: atom <- print_bool(35.5 > 33.0)
    produces pure done end
}
