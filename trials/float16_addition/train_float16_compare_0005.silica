// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(4.0 >= 12.25);
        println("");
        _: atom <- print_bool(30.0 * 3.5 == 5.5);
        println("");
        _: atom <- print_bool(21.25 != 38.0 / 38.0);
        println("");
        done: atom <- print_bool((11.5 - 7.0) >= 1.5)
    produces pure done end
}
