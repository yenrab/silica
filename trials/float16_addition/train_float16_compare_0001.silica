// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(10.0 > 19.0 * 16.5);
        println("");
        _: atom <- print_bool(28.0 != (13.5 + 26.5));
        println("");
        _: atom <- print_bool((7.0 - 21.75) <= 24.0);
        println("");
        done: atom <- print_bool(28.0 * 33.75 < 39.0)
    produces pure done end
}
