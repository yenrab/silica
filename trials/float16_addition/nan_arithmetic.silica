fn main() -> atom {
    sequence proc[device_io]
        nan: float16 <- float16_nan();
        one: float16 <- 1.0;
        two: float16 <- 2.0;
        _: atom <- print_bool(float16_is_nan(nan + one));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan(one + nan));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan(nan - one));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan(one - nan));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan(nan * two));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan(two * nan));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan(nan / two));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan(two / nan));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan((nan + one) * two));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan((one + nan) / two));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan(nan + float16_nan()));
        _: unit <- println("");
        done: atom <- print_bool(float16_is_nan((float16_nan() * nan) - float16_nan()));
        _: unit <- println("")
    produces
        pure done
    end
}
