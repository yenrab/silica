// float16 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((35.5 + 27.75) < 14.5 / 32.0);
        println("");
        _: atom <- print_bool((7.5 - 7.75) != (16.5 + 35.0));
        println("");
        done: atom <- print_bool((5.0 + 14.5) < (22.5 + 19.5))
        produces pure done end
}
