// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(4.5 * 32.5 >= 37.0);
        println("");
        _: atom <- print_bool((6.25 + 18.75) > 2.5);
        println("");
        done: atom <- print_bool((6.0 + 15.75) <= 3.25 * 11.0)
    produces pure done end
}
