// float16 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(37.75 * 9.0 >= (24.25 + 34.0));
        println("");
        _: atom <- print_bool(20.5 / 20.5 == (7.0 + 6.5));
        println("");
        done: atom <- print_bool((40.0 + 13.75) == (35.5 + 28.5))
        produces pure done end
}
