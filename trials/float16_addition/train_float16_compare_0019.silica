// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(2.0 > (30.0 - 5.5));
        println("");
        _: atom <- print_bool((37.75 + 29.0) > 3.0);
        println("");
        done: atom <- print_bool(3.5 > (25.0 + 15.75))
    produces pure done end
}
