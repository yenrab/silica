// float16 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((20.75 - 18.5) <= (6.25 + 25.0));
        println("");
        _: atom <- print_bool((27.75 + 25.5) != (28.75 + 37.0));
        println("");
        done: atom <- print_bool(20.0 * 32.5 < 18.25)
        produces pure done end
}
