// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((6.0 - 27.75) == 5.5 * 2.5);
        println("");
        _: atom <- print_bool((9.0 + 27.5) >= (35.75 + 6.25));
        println("");
        done: atom <- print_bool((24.5 - 18.0) == 7.0)
    produces pure done end
}
