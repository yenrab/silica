// float16 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(5.5 != (7.0 - 4.75));
        println("");
        _: atom <- print_bool((14.0 - 35.5) <= 5.5);
        println("");
        _: atom <- print_bool(20.0 <= (1.0 + 37.5));
        println("");
        done: atom <- print_bool((1.5 - 18.25) < 10.5)
        produces pure done end
}
