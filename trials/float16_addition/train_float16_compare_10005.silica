// float16 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((4.5 + 11.0) <= 18.5 * 22.0);
        println("");
        _: atom <- print_bool((33.5 - 4.75) == (11.5 + 10.0));
        println("");
        _: atom <- print_bool((27.5 + 6.25) != 36.5);
        println("");
        done: atom <- print_bool((23.5 + 22.5) < 8.25)
        produces pure done end
}
