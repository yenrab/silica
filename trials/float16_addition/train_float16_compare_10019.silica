// float16 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(5.75 >= (25.5 - 3.5));
        println("");
        _: atom <- print_bool(36.25 < (27.0 + 24.0));
        println("");
        done: atom <- print_bool((25.5 - 14.25) < 26.0 * 10.0)
        produces pure done end
}
