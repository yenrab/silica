// float16 twin of float64_addition/case_float_compare_params: a case on a comparison of two float16
// parameters whose arms return those parameters. The compare staged its operands in H1/H2, which
// overwrote b's register H1, so the true arm returned a.
fn bigger(a: float16, b: float16) -> float16 {
    case a < b of {
        true -> b;
        false -> a
    }
}

fn main() -> atom {
    sequence proc[device_io] r: atom <- print_float16(bigger(1.5, 2.5)) produces pure r end
}
