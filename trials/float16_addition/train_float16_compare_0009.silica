// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(31.5 >= (24.5 + 17.5));
        println("");
        _: atom <- print_bool((33.5 - 14.25) <= (27.25 + 30.0));
        println("");
        done: atom <- print_bool(16.5 / 22.0 >= 39.0)
    produces
        pure done
    end
}
