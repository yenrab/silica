// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(20.5 > 37.0);
        println("");
        _: atom <- print_bool(9.5 * 38.0 == 2.0);
        println("");
        done: atom <- print_bool((27.375 + 2.0) == 31.25 / 8.0)
    produces
        pure done
    end
}
