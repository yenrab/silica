// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((40.0 + 2.25) <= 12.0);
        println("");
        _: atom <- print_bool(26.375 > (28.5 - 25.0));
        println("");
        _: atom <- print_bool(12.25 < 16.25 * 24.25);
        println("");
        done: atom <- print_bool((38.125 + 17.25) == 34.75)
    produces
        pure done
    end
}
