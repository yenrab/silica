// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((5.0 + 34.125) > 16.0);
        println("");
        _: atom <- print_bool((14.5 - 22.75) != (7.0 + 17.75));
        println("");
        done: atom <- print_bool(8.0 <= (29.5 + 38.375))
    produces
        pure done
    end
}
