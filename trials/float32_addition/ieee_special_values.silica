fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(float32_is_nan(float32_nan()));
        _: unit <- println("");
        _: atom <- print_float32(float32_nan());
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan(0.0 / 0.0));
        _: unit <- println("");
        _: atom <- print_float32(0.0 / 0.0);
        _: unit <- println("");
        _: atom <- print_bool(float32_is_inf(float32_inf()));
        _: unit <- println("");
        _: atom <- print_float32(float32_inf());
        _: unit <- println("");
        _: atom <- print_bool(float32_is_inf(float32_neg_inf()));
        _: unit <- println("");
        _: atom <- print_float32(float32_neg_inf());
        _: unit <- println("");
        _: atom <- print_bool(float32_is_inf(1.0 / 0.0));
        _: unit <- println("");
        _: atom <- print_float32(1.0 / 0.0);
        _: unit <- println("");
        _: atom <- print_bool(float32_is_inf((0.0 - 1.0) / 0.0));
        _: unit <- println("");
        _: atom <- print_float32((0.0 - 1.0) / 0.0);
        _: unit <- println("");
        _: atom <- print_bool(float32_is_inf((0.0 - 1.0) / 0.0));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_inf(1.0 / (0.0 / float32_neg_inf())));
        _: unit <- println("");
        _: atom <- print_float32(1.0 / (0.0 / float32_neg_inf()));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_finite(1.0));
        _: unit <- println("");
        _: atom <- print_float32(1.0);
        _: unit <- println("");
        _: atom <- print_bool(float32_is_finite(float32_inf()) == false);
        _: unit <- println("");
        done: atom <- print_bool(float32_is_finite(float32_nan()) == false);
        _: unit <- println("")
    produces
        pure done
    end
}
