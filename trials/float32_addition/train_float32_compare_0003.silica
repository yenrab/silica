// float32 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((23.0 + 34.0) <= 0.0 * 37.0);
        println("");
        _: atom <- print_bool(7.375 != 10.25);
        println("");
        _: atom <- print_bool((24.0 - 17.0) <= 37.0);
        println("");
        done: atom <- print_bool(25.5 >= 8.25)
        produces pure done end
}
