// float32 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(4.25 * 32.5 == 39.5);
        println("");
        _: atom <- print_bool(10.0 * 4.5 <= 37.5);
        println("");
        done: atom <- print_bool((14.5 - 1.0) <= (10.125 - 35.5))
        produces pure done end
}
