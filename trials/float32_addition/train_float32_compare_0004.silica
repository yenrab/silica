// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((27.5 - 37.5) <= (38.25 + 26.25));
        println("");
        _: atom <- print_bool(5.125 <= 5.5);
        println("");
        done: atom <- print_bool(27.5 != (39.75 + 38.125))
    produces
        pure done
    end
}
