// float32 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((27.25 + 12.375) <= 17.75);
        println("");
        _: atom <- print_bool((22.0 + 37.75) == (32.5 - 1.0));
        println("");
        done: atom <- print_bool(20.5 >= 4.0)
        produces pure done end
}
