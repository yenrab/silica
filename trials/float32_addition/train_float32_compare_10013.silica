// float32 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(1.25 * 23.5 >= 30.0 * 38.0);
        println("");
        _: atom <- print_bool(31.0 > 3.25);
        println("");
        _: atom <- print_bool((38.25 - 21.75) <= 25.0);
        println("");
        done: atom <- print_bool((38.0 - 32.0) != (27.5 + 0.25))
        produces pure done end
}
