// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(34.0 == 24.125);
        println("");
        _: atom <- print_bool((11.5 + 20.0) > (25.5 - 1.75));
        println("");
        _: atom <- print_bool(24.5 > (27.25 - 2.25));
        println("");
        done: atom <- print_bool(6.0 * 22.25 > (38.0 - 25.5))
    produces pure done end
}
