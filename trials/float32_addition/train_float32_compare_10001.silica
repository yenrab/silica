// float32 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(27.375 / 3.0 >= (4.0 - 20.25));
        println("");
        _: atom <- print_bool((13.5 - 25.25) >= (40.5 + 31.125));
        println("");
        done: atom <- print_bool(19.75 != 39.125)
        produces pure done end
}
