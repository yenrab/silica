// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(37.0 < (14.375 - 11.125));
        println("");
        _: atom <- print_bool((16.0 + 40.0) == (40.0 + 24.0));
        println("");
        done: atom <- print_bool((32.0 + 29.125) > (25.5 - 9.5))
    produces
        pure done
    end
}
