// float32 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((1.5 - 21.5) <= 29.0);
        println("");
        _: atom <- print_bool(37.0 <= 0.5 * 31.5);
        println("");
        _: atom <- print_bool(7.0 <= 4.5 * 29.375);
        println("");
        done: atom <- print_bool((13.375 - 19.5) < 22.125)
        produces pure done end
}
