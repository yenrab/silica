// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((59 + 4) > (29 + 2));
        println("");
        _: atom <- print_bool(41 > (32 + 27));
        println("");
        result: atom <- print_bool(52 % 22 >= 8 / 13)
        produces pure result end
}
