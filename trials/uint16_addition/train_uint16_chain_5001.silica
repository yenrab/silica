// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_uint16(7 + 38);
        println("");
        _: atom <- print_uint16(14);
        println("");
        _: atom <- print_uint16(12);
        println("");
        result: atom <- print_uint16(38 / 52)
        produces pure result end
}
