// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16(53);
        println("");
        _: atom <- print_uint16(40);
        println("");
        _: atom <- print_uint16(53);
        println("");
        result: atom <- print_uint16(39 + 47)
    produces
        pure result
    end
}
