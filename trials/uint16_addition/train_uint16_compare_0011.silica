// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(45 / 22 > 28);
        println("");
        _: atom <- print_bool((59 - 29) != 59 / 13);
        println("");
        _: atom <- print_bool((56 - 35) > 7);
        println("");
        _: atom <- print_bool(57 * 0 <= (57 + 33));
        println("");
        result: atom <- print_bool(20 != (51 + 16))
    produces
        pure result
    end
}
