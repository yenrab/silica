// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(58 / 3 < (25 + 21));
        println("");
        _: atom <- print_bool(29 / 13 >= 56 * 48);
        println("");
        _: atom <- print_bool((20 + 15) > (48 - 38));
        println("");
        result: atom <- print_bool(8 != (24 - 22))
    produces
        pure result
    end
}
