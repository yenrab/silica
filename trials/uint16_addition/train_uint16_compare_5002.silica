// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(6 % 23 != (17 + 14));
        println("");
        _: atom <- print_bool(53 / 46 < 15 / 4);
        println("");
        _: atom <- print_bool(40 / 47 == (0 + 40));
        println("");
        result: atom <- print_bool(20 / 37 > (56 + 15))
    produces pure result end
}
