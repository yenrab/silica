// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(31 / 60 != (2 + 45));
        println("");
        _: atom <- print_bool(59 * 38 != 16);
        println("");
        result: atom <- print_bool(18 / 36 == 27 * 57)
        produces pure result end
}
