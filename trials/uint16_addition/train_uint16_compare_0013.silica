// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((41 - 22) <= (53 + 50));
        println("");
        _: atom <- print_bool((11 - 7) > 16 / 51);
        println("");
        _: atom <- print_bool(6 * 4 != (25 + 7));
        println("");
        result: atom <- print_bool((48 / 10) <= (56 * 13))
    produces
        pure result
    end
}
