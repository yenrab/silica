// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16((6 + 39) / (30 - 17));
        println("");
        _: atom <- print_uint16(26);
        println("");
        result: atom <- print_uint16((0 + 21) % (15 + 58))
    produces pure result end
}
