// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(59 < 36 * 22);
        println("");
        _: atom <- print_bool((45 / 41) == 23 * 47);
        println("");
        _: atom <- print_bool((43 + 32) >= (46 + 59));
        println("");
        result: atom <- print_bool(43 * 44 > (55 + 54))
    produces pure result end
}
