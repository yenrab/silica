// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(1 == 3 * 15);
        println("");
        _: atom <- print_bool(13 <= 31);
        println("");
        result: atom <- print_bool((57 + 57) < 30 % 6)
        produces pure result end
}
