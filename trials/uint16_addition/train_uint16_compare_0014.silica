// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((0 % 58) <= (37 / 34));
        println("");
        _: atom <- print_bool(26 / 14 >= 41 * 15);
        println("");
        result: atom <- print_bool((30 - 9) <= 42)
        produces pure result end
}
