// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16(26 * 50);
        println("");
        _: atom <- print_uint16((27 / 12));
        println("");
        _: atom <- print_uint16(12 % 58 + 21);
        println("");
        result: atom <- print_uint16(42)
    produces
        pure result
    end
}
