// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((36 - 17) == 59);
        println("");
        _: atom <- print_bool(36 / 40 <= 16 * 32);
        println("");
        result: atom <- print_bool(17 >= 19 * 35)
    produces
        pure result
    end
}
