// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(52 < 46 / 55);
        println("");
        _: atom <- print_bool(9 >= 8 % 31);
        println("");
        result: atom <- print_bool(18 >= 23)
    produces pure result end
}
