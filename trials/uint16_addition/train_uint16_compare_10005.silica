// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(39 > 21 % 5);
        println("");
        _: atom <- print_bool(56 % 11 < 22);
        println("");
        _: atom <- print_bool((41 / 53) != 58 * 25);
        println("");
        _: atom <- print_bool(5 == (38 + 16));
        println("");
        result: atom <- print_bool(1 / 28 <= 35)
    produces
        pure result
    end
}
