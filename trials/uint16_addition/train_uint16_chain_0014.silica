// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16(39 + 54);
        println("");
        _: atom <- print_uint16(22 / 11 * (1 + 36));
        println("");
        result: atom <- print_uint16(28 * 57)
    produces
        pure result
    end
}
