// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_uint16(37);
        println("");
        _: atom <- print_uint16(57);
        println("");
        _: atom <- print_uint16(23);
        println("");
        result: atom <- print_uint16(23)
        produces pure result end
}
