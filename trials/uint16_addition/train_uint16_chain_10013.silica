// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_uint16(8 + 25 + (17 + 2));
        println("");
        _: atom <- print_uint16(40);
        println("");
        result: atom <- print_uint16(50 * (40 % 19))
        produces pure result end
}
