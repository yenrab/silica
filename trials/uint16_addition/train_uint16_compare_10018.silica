// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(45 / 22 < 58 * 57);
        println("");
        _: atom <- print_bool(28 < (43 / 27));
        println("");
        _: atom <- print_bool(31 % 29 > (36 + 51));
        println("");
        result: atom <- print_bool((21 + 19) <= 49)
    produces pure result end
}
