// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((53 + 38) == 46 * 47);
        println("");
        _: atom <- print_bool(51 % 36 > 37 / 58);
        println("");
        result: atom <- print_bool(21 >= 11 % 50)
        produces pure result end
}
