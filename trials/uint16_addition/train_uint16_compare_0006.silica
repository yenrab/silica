// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((19 / 40) <= 8 * 13);
        println("");
        _: atom <- print_bool(19 / 40 != 17 % 41);
        println("");
        _: atom <- print_bool(3 % 6 > (5 * 42));
        println("");
        _: atom <- print_bool((25 + 50) >= 46);
        println("");
        result: atom <- print_bool(57 / 10 < (18 + 55))
    produces pure result end
}
