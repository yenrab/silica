// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16(19 + 1);
        println("");
        _: atom <- print_uint16(23 * 5);
        println("");
        _: atom <- print_uint16(8);
        println("");
        result: atom <- print_uint16(29)
    produces pure result end
}
