// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16((21 % 42) + 21 / 58);
        println("");
        _: atom <- print_uint16((54 % 16 / (18 / 10)));
        println("");
        _: atom <- print_uint16(27 % 8 + 54 % 21);
        println("");
        result: atom <- print_uint16((57 * 33))
    produces
        pure result
    end
}
