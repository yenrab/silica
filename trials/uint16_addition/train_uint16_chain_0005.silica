// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16(48);
        println("");
        _: atom <- print_uint16(45);
        println("");
        _: atom <- print_uint16(27);
        println("");
        result: atom <- print_uint16(56 % 43)
    produces pure result end
}
