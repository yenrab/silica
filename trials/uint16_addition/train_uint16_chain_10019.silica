// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16(18 - 0 - 4 % 59);
        println("");
        _: atom <- print_uint16(4 % 51);
        println("");
        result: atom <- print_uint16(53)
    produces pure result end
}
