// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16(35 % 25);
        println("");
        _: atom <- print_uint16(32 * 25);
        println("");
        result: atom <- print_uint16(42 / (11 + 5))
    produces pure result end
}
