// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: alloc_buf with a runtime size, write/read round-trip at index 1
fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        capacity: int64 <- 2;
        index: int64 <- 1;
        buf: buf(L1, normal, int64, capacity) <- alloc_buf(r, capacity);
        _: atom <- write_buf(buf, index, 135);
        value: int64 <- read_buf(buf, index)
    produces
        pure value
    end
}
