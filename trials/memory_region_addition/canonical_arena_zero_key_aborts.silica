// §15.4.5.5: canonical_arena_lookup requires a non-zero specialization key; a zero key is a failed
// runtime check, which is a runtime abort: the report "[silica] abort: canonical arena key is zero at
// 0x<pc>" (plus " in <symbol>+0x<offset>" where the target can name the address) on stderr, and exit
// status 71. Until 2026-09-19 this path called C abort(): status 134 and no report.
// The key reaches the lookup through a parameter. The first lookup (key 77) makes the arena and prints
// 77; the second passes 0, and nothing after it runs.
// compare_scout_normalized.sh folds everything after " at " to <PTR>.

fn touch(key: int64) -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        arena: region(L, normal) <- canonical_arena_lookup(key)
    produces
        pure key
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- touch(77);
        print_int64(a);
        println("");
        b: int64 <- touch(77 - 77);
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
