// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: alloc_ref into atomic region (same as other spaces; adds proc[atomic] when Space is atomic)

fn main() -> int64 {
    sequence proc[mem(atomic), atomic]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, atomic) <- alloc_region(atomic);
        counter: ref(L1, atomic, int64) <- alloc_ref(r, 0)
    produces
        pure 0
    end
}
