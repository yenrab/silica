// §12.3.3 and §15.4.5.5: a negative buffer index is out of bounds too. The check is one unsigned
// compare against the element count (emit_buf_bounds_check), so a negative index -- which as an
// unsigned value is larger than any length -- fails it without a second branch.
// compare_scout_normalized.sh folds everything after " at " to <PTR>.

fn read_at(index: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        _: atom <- write_buf(buf, 3, 9);
        value: int64 <- read_buf(buf, index)
    produces
        pure value
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- read_at(3);
        print_int64(a);
        println("");
        b: int64 <- read_at(0 - 1);
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
