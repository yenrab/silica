// §12.3.3 and §15.4.5.5: a buffer load at an index at or past the buffer's length is a failed runtime
// check -- a runtime abort with the report "[silica] abort: buffer index out of bounds at 0x<pc>" on
// stderr and exit status 71. read_buf had no check at all until 2026-09-19; the element count now sits
// in the word below element 0 (emit_alloc_buf) and every load and store compares the index with it.
// The index reaches read_buf through a parameter, which is the case a size named in the buffer's type
// cannot cover. compare_scout_normalized.sh folds everything after " at " to <PTR>.

fn read_at(index: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        _: atom <- write_buf(buf, 0, 7);
        value: int64 <- read_buf(buf, index)
    produces
        pure value
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- read_at(0);
        print_int64(a);
        println("");
        b: int64 <- read_at(4);
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
