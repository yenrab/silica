// §12.3.3 and §15.4.5.5: a buffer store at an index at or past the buffer's length is a failed
// runtime check -- a runtime abort with the report "[silica] abort: buffer index out of bounds at
// 0x<pc>" on stderr and exit status 71. The emitter had the target (L_buf_bounds) but nothing ever
// branched to it: the check fired only on a "|bounds:" marker that the SIR value never began with,
// and the size in the buffer's type may be an identifier that is not in scope at the access. Since
// 2026-09-19 a buffer carries its element count in the word below element 0 (prims_memory@
// emit_alloc_buf) and every store and load compares the index against it (emit_buf_bounds_check).
// The index reaches write_buf through a parameter. compare_scout_normalized.sh folds everything
// after " at " to <PTR>.

fn store_at(index: int64) -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        _: atom <- write_buf(buf, index, 5);
        value: int64 <- read_buf(buf, index)
    produces
        pure value
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- store_at(3);
        print_int64(a);
        println("");
        b: int64 <- store_at(4);
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
