// Trial-only checked comparison with an injectable atom-typed comparator (invalid-comparator
// trials). A well-typed comparator cannot return a foreign atom (the checker rejects it, E2001),
// so the core's halt is unreachable from user code; this mirrors brodal_okasaki_compare@le with
// the same comparator_result_validate builtin and reports :invalid_comparator_result instead of
// halting. compare_status stays first so :less/:equal/:greater are numbered as in user comparators.

export compare_status/3;
export le_status/4;
export compare_valid/3;

fn compare_status(cmp: fn(int64, int64) -> atom, a: int64, b: int64) -> atom {
    sequence
        valid: atom <- comparator_result_validate(cmp(a, b))
    produces
        pure case valid of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            _: atom -> :invalid_comparator_result
        }
    end
}

// 1 when a may sit above b under the orientation, 0 otherwise, -1 for an invalid comparator atom.
// Integers rather than atoms: atom values are numbered per compilation unit, so an atom minted
// here would not match a case pattern in the trial that calls this.
fn le_status(cmp: fn(int64, int64) -> atom, max_oriented: boolean, a: int64, b: int64) -> int64 {
    case compare_status(cmp, a, b) of {
        :less -> case max_oriented of { true -> 0; false -> 1 };
        :equal -> 1;
        :greater -> case max_oriented of { true -> 1; false -> 0 };
        _: atom -> -1
    }
}

// 1 for a valid comparator atom, -1 otherwise.
fn compare_valid(cmp: fn(int64, int64) -> atom, a: int64, b: int64) -> int64 {
    case compare_status(cmp, a, b) of {
        :less -> 1;
        :equal -> 1;
        :greater -> 1;
        _: atom -> -1
    }
}
