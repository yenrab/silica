.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



bo_validate_invariants_cmp_i64:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    CMP X9, X10
    CSET X3, LT
L_case_o452_br_0:
    CMP W3, #1
    B.NE L_case_o452_br_1
    MOV X0, #23
    B L_case_o452_done
L_case_o452_br_1:
    CMP W3, #0
    B.NE L_case_o452_fb
    MOV X9, X19
    MOV X10, X20


    CMP X9, X10
    CSET X3, EQ
L_case_o508_br_0:
    CMP W3, #1
    B.NE L_case_o508_br_1
    MOV X0, #24
    B L_case_o508_done
L_case_o508_br_1:
    CMP W3, #0
    B.NE L_case_o508_fb
    MOV X0, #25
    B L_case_o508_done
L_case_o508_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o508_done
L_case_o508_done:

    B L_case_o452_done
L_case_o452_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o452_done
L_case_o452_done:

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

