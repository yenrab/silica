.text
    ; use brodal_okasaki, bo_trial_i64
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


bo_rank_collisions_pick:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2

    MOV X3, X19
L_case_o398_br_0:
    CMP W3, #1
    B.NE L_case_o398_br_1
    MOV X0, X21
    B L_case_o398_done
L_case_o398_br_1:
    CMP W3, #0
    B.NE L_case_o398_fb
    MOV X0, X20
    B L_case_o398_done
L_case_o398_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o398_done
L_case_o398_done:

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

bo_rank_collisions_sizes:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    SUB SP, SP, #16
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    CMP X9, X10
    CSET X3, GT
L_case_o512_br_0:
    CMP W3, #1
    B.NE L_case_o512_br_1
    MOV X0, #1
    B L_case_o512_done
L_case_o512_br_1:
    CMP W3, #0
    B.NE L_case_o512_fb
    ; unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o892|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_trial_i64_new_min@PAGE
    ADD X9, X9, bo_trial_i64_new_min@PAGEOFF
    BLR X9

    MOV X16, X0
    STR X16, [SP, #-16]!
    MOV X16, #0
    STR X16, [SP, #-16]!
    MOV X16, X19
    STR X16, [SP, #-16]!
    MOV X16, #1
    STR X16, [SP, #-16]!
    LDR X0, [SP, #48]
    LDR X1, [SP, #32]
    LDR X2, [SP, #16]
    LDR X3, [SP, #0]
    ADD SP, SP, #64
    ; effects []|sir_rec:o870|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_trial_i64_push_seq@PAGE
    ADD X9, X9, bo_trial_i64_push_seq@PAGEOFF
    BLR X9

    MOV X21, X0
    ; unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o1249|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_trial_i64_new_min@PAGE
    ADD X9, X9, bo_trial_i64_new_min@PAGEOFF
    BLR X9

    MOV X16, X0
    STR X16, [SP, #-16]!
    MOV X16, X19
    STR X16, [SP, #-16]!
    MOV X16, #0
    STR X16, [SP, #-16]!
    MOV X16, #-1
    STR X16, [SP, #-16]!
    LDR X0, [SP, #48]
    LDR X1, [SP, #32]
    LDR X2, [SP, #16]
    LDR X3, [SP, #0]
    ADD SP, SP, #64
    ; effects []|sir_rec:o1227|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_trial_i64_push_seq@PAGE
    ADD X9, X9, bo_trial_i64_push_seq@PAGEOFF
    BLR X9

    MOV X22, X0
    STR X3, [X29, #-16]
    MOV X16, X21
    STR X16, [SP, #-16]!
    MOV X16, X19
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o1301|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_trial_i64_valid_with_count@PAGE
    ADD X9, X9, bo_trial_i64_valid_with_count@PAGEOFF
    BLR X9

    MOV X3, X0
    CBZ X3, L_sc_o1338_done
    LDR X3, [X29, #-16]
    MOV X16, X21
    STR X16, [SP, #-16]!
    MOV X16, X19
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o1342|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_trial_i64_pops_sorted@PAGE
    ADD X9, X9, bo_trial_i64_pops_sorted@PAGEOFF
    BLR X9

    MOV X3, X0
L_sc_o1338_done:

L_case_o1296_br_0:
    CMP W3, #0
    B.NE L_case_o1296_br_1
    MOV X0, #0
    B L_case_o1296_done
L_case_o1296_br_1:
    CMP W3, #1
    B.NE L_case_o1296_fb
    STR X3, [X29, #-16]
    MOV X16, X22
    STR X16, [SP, #-16]!
    MOV X16, X19
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o1440|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_trial_i64_valid_with_count@PAGE
    ADD X9, X9, bo_trial_i64_valid_with_count@PAGEOFF
    BLR X9

    MOV X3, X0
    CBZ X3, L_sc_o1479_done
    LDR X3, [X29, #-16]
    MOV X16, X22
    STR X16, [SP, #-16]!
    MOV X16, X19
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o1483|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_trial_i64_pops_sorted@PAGE
    ADD X9, X9, bo_trial_i64_pops_sorted@PAGEOFF
    BLR X9

    MOV X3, X0
L_sc_o1479_done:

L_case_o1435_br_0:
    CMP W3, #0
    B.NE L_case_o1435_br_1
    MOV X0, #0
    B L_case_o1435_done
L_case_o1435_br_1:
    CMP W3, #1
    B.NE L_case_o1435_fb
    MOV X9, X19
    MOV X10, #1


    ADD X16, X9, X10
    STR X16, [SP, #-16]!
    MOV X16, X20
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o1586|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_rank_collisions_sizes@PAGE
    ADD X9, X9, bo_rank_collisions_sizes@PAGEOFF
    BLR X9

    B L_case_o1435_done
L_case_o1435_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o1435_done
L_case_o1435_done:

    B L_case_o1296_done
L_case_o1296_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o1296_done
L_case_o1296_done:



    B L_case_o512_done
L_case_o512_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o512_done
L_case_o512_done:

    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    ADD SP, SP, #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    MOV X16, #0
    STR X16, [SP, #-16]!
    MOV X16, #36
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o1716|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_rank_collisions_sizes@PAGE
    ADD X9, X9, bo_rank_collisions_sizes@PAGEOFF
    BLR X9

    MOV X19, X0
    MOV X16, X19
    STR X16, [SP, #-16]!
    MOV X16, #1
    STR X16, [SP, #-16]!
    MOV X16, #0
    STR X16, [SP, #-16]!
    LDR X0, [SP, #32]
    LDR X1, [SP, #16]
    LDR X2, [SP, #0]
    ADD SP, SP, #48
    ; effects []|sir_rec:o1755|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bo_rank_collisions_pick@PAGE
    ADD X9, X9, bo_rank_collisions_pick@PAGEOFF
    BLR X9


    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #23
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

