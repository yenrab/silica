// Construction-module stub for defect_graph_bracket_receiver: StubGraphDirected is a module name the
// type checker registers for DirectedGraph[N, P, mem(S)] bracket bindings.

export empty/1;
export count_of/1;

fn empty(
    functions: {
        compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater,
        edge_target: fn(ValueType) -> KeyType
    }
) -> {
    compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater,
    compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater,
    edge_target: fn(ValueType) -> KeyType,
    count: int64
} {
    { compare_node: functions.compare_node, compare_edge: functions.compare_edge, edge_target: functions.edge_target, count: 3 }
}

fn count_of(
    g: {
        compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater,
        edge_target: fn(ValueType) -> KeyType,
        count: int64
    }
) -> int64 {
    g.count
}
