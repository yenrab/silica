// Trait for defect_graph_bracket_receiver: one implementation, for the stub's record.

use StubGraphDirected;

export trait ProbeDirected;
export count/1;

required {
    fn count(g: ProbeDirected) -> int64;
}

impl fn count(
    g: {
        compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_edge: fn(ValueType, ValueType) -> :less | :equal | :greater,
        edge_target: fn(ValueType) -> KeyType,
        count: int64
    }
) -> int64 {
    StubGraphDirected@count_of(g)
}
