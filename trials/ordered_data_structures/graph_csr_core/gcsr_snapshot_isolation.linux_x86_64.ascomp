    jmp L_lph_new_stored
L_lph_ns8:
    mov QWORD PTR [r11], rsi
L_lph_new_stored:
    test rdx, rdx
    jz L_lph_next_nil
    mov r10, QWORD PTR [rdx + 8]
    mov QWORD PTR [r14 + r8], r10
    jmp L_lph_alloc_handle
L_lph_next_nil:
    mov QWORD PTR [r14 + r8], 0
L_lph_alloc_handle:
    mov QWORD PTR [r14 + r8 + 8], rbx
    sub rsp, 16
    mov QWORD PTR [rsp], r14
    mov QWORD PTR [rsp + 8], rbx
    mov edi, 24
    call silica_rt_region_alloc
    mov r14, QWORD PTR [rsp]
    mov rbx, QWORD PTR [rsp + 8]
    add rsp, 16
    mov r9, QWORD PTR [rsp]
    add rsp, 16
    mov rcx, QWORD PTR [rsp]
    mov r8, QWORD PTR [rsp + 8]
    add rsp, 16
    mov rsi, QWORD PTR [rsp]
    mov rdx, QWORD PTR [rsp + 8]
    add rsp, 16
    test rdx, rdx
    jz L_lph_len1
    mov r10, QWORD PTR [rdx]
    add r10, 1
    jmp L_lph_setlen
L_lph_len1:
    mov r10d, 1
L_lph_setlen:
    mov QWORD PTR [rdi], r10
    mov QWORD PTR [rdi + 8], r14
    mov QWORD PTR [rdi + 16], rbx
    pop rbp
    ret

L_list_tail_helper:
    push rbp
    mov rbp, rsp
    mov rcx, QWORD PTR [rdi]
    mov r8, QWORD PTR [rdi + 8]
    mov r9, QWORD PTR [rdi + 16]
    lea r14, [r9 + rsi]
    cmp r14, rdx
    jge L_lth_next_chunk
    sub rcx, 1
    test rcx, rcx
    jz L_lth_nil
    sub rsp, 16
    mov QWORD PTR [rsp], rcx
    mov QWORD PTR [rsp + 8], r8
    sub rsp, 16
    mov QWORD PTR [rsp], r14
    mov QWORD PTR [rsp + 8], 0
    mov edi, 24
    call silica_rt_region_alloc
    mov r14, QWORD PTR [rsp]
    add rsp, 16
    mov rcx, QWORD PTR [rsp]
    mov r8, QWORD PTR [rsp + 8]
    add rsp, 16
    mov QWORD PTR [rdi], rcx
    mov QWORD PTR [rdi + 8], r8
    mov QWORD PTR [rdi + 16], r14
    pop rbp
    ret
L_lth_next_chunk:
    mov r15, QWORD PTR [r8 + rdx]
    test r15, r15
    jz L_lth_nil
    sub rcx, 1
    test rcx, rcx
    jz L_lth_nil
    sub rsp, 16
    mov QWORD PTR [rsp], rcx
    mov QWORD PTR [rsp + 8], r15
    mov edi, 24
    call silica_rt_region_alloc
    mov rcx, QWORD PTR [rsp]
    mov r15, QWORD PTR [rsp + 8]
    add rsp, 16
    mov QWORD PTR [rdi], rcx
    mov QWORD PTR [rdi + 8], r15
    mov QWORD PTR [rdi + 16], 0
    pop rbp
    ret
L_lth_nil:
    xor edi, edi
    pop rbp
    ret

L_list_length_helper:
