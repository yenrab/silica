    LDP X1, X2, [SP, #32]
    SUB X8, X4, X3
    ADD X10, X6, X8
    CBZ X5, L_lph_new_scalar
    MOV X12, #0
L_lph_new_agg:
    CMP X12, X3
    B.GE L_lph_new_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_new_agg
    B L_lph_new_stored
L_lph_new_scalar:
    CMP X3, #8
    B.EQ L_lph_ns8
    CMP X3, #4
    B.EQ L_lph_ns4
    CMP X3, #2
    B.EQ L_lph_ns2
    STRB W1, [X10]
    B L_lph_new_stored
L_lph_ns2:
    STRH W1, [X10]
    B L_lph_new_stored
L_lph_ns4:
    STR W1, [X10]
    B L_lph_new_stored
L_lph_ns8:
    STR X1, [X10]
L_lph_new_stored:
    CBZ X2, L_lph_next_nil
    LDR X9, [X2, #8]
    STR X9, [X6, X4]
    B L_lph_alloc_handle
L_lph_next_nil:
    STR XZR, [X6, X4]
L_lph_alloc_handle:
    STP X6, X8, [SP, #-16]!
    MOV X0, #24
    BL silica_rt_region_alloc
    LDP X6, X8, [SP], #16
    LDR X5, [SP], #16
    LDP X3, X4, [SP], #16
    LDP X1, X2, [SP], #16
    CBZ X2, L_lph_len1
    LDR X9, [X2]
    ADD X9, X9, #1
    B L_lph_setlen
L_lph_len1:
    MOV X9, #1
L_lph_setlen:
    STR X9, [X0]
    STR X6, [X0, #8]
    STR X8, [X0, #16]
    LDP X29, X30, [SP], #16
    RET

L_list_tail_helper:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    LDR X3, [X0]
    LDR X4, [X0, #8]
    LDR X5, [X0, #16]
    ADD X6, X5, X1
    CMP X6, X2
    B.GE L_lth_next_chunk
    SUB X3, X3, #1
    CBZ X3, L_lth_nil
    STP X3, X4, [SP, #-16]!
    STP X6, XZR, [SP, #-16]!
    MOV X0, #24
    BL silica_rt_region_alloc
    LDP X6, XZR, [SP], #16
    LDP X3, X4, [SP], #16
    STR X3, [X0]
    STR X4, [X0, #8]
    STR X6, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lth_next_chunk:
    LDR X7, [X4, X2]
    CBZ X7, L_lth_nil
    SUB X3, X3, #1
    CBZ X3, L_lth_nil
    STP X3, X7, [SP, #-16]!
    MOV X0, #24
    BL silica_rt_region_alloc
    LDP X3, X7, [SP], #16
    STR X3, [X0]
    STR X7, [X0, #8]
    STR XZR, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lth_nil:
    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET

L_list_length_helper:
    CBZ X0, L_list_len_nil
    LDR X0, [X0]
    RET
L_list_len_nil:
    MOV X0, #0
    RET

L_region_overflow:
    BL abort
L_buf_invalid:
    BL abort
L_buf_bounds:
    BL abort
L_region_grow:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X0, X1, [SP, #-16]!
    STP X2, X3, [SP, #-16]!
    STP X4, X5, [SP, #-16]!
    STP X6, X7, [SP, #-16]!
    STP X8, X9, [SP, #-16]!
    STP X10, X11, [SP, #-16]!
    STP X12, X13, [SP, #-16]!
    STP X14, X15, [SP, #-16]!
    STP X16, X17, [SP, #-16]!
    STR X18, [SP, #-16]!
    MOV X19, X1
    SUB X20, X5, X3
    ADD X20, X20, #15
    BIC X20, X20, #15
    MOV X9, #4096
    CMP X20, X9
    B.HS 1f
    MOV X20, X9
1:
    ADD X0, X20, #32
    BL silica_rt_raw_alloc
    CBZ X0, L_region_overflow
    ADD X1, X0, #32
    ADD X2, X1, X20
    STR X2, [X0, #24]
    LDR X3, [X19, #16]
    STR X3, [X0, #16]
    STR X0, [X19, #16]
    STR X1, [X19]
    STR X2, [X19, #8]
    LDR X18, [SP], #16
    LDP X16, X17, [SP], #16
    LDP X14, X15, [SP], #16
    LDP X12, X13, [SP], #16
    LDP X10, X11, [SP], #16
    LDP X8, X9, [SP], #16
    LDP X6, X7, [SP], #16
    LDP X4, X5, [SP], #16
    LDP X2, X3, [SP], #16
    LDP X0, X1, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_region_contains:
    STP X6, X7, [SP, #-16]!
    ADD X6, X2, #32
    LDR X7, [X2, #24]
    CMP X1, X6
    B.LO 2f
    CMP X1, X7
    B.LO 3f
2:
    LDR X6, [X2, #16]
1:
    CBZ X6, 4f
    ADD X7, X6, #32
    CMP X1, X7
    B.LO 5f
    LDR X7, [X6, #24]
    CMP X1, X7
    B.LO 3f
5:
    LDR X6, [X6, #16]
    B 1b
3:
    MOV X5, #1
    LDP X6, X7, [SP], #16
    RET
4:
    MOV X5, #0
    LDP X6, X7, [SP], #16
    RET

