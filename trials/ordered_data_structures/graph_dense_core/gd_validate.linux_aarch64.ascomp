    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    CMP X9, X10
    CSET X3, LT
L_case_o856_br_0:
    CMP W3, #1
    B.NE L_case_o856_br_1
    MOV X0, #23
    B L_case_o856_done
L_case_o856_br_1:
    CMP W3, #0
    B.NE L_case_o856_fb
    MOV X9, X19
    MOV X10, X20


    CMP X9, X10
    CSET X3, EQ
L_case_o912_br_0:
    CMP W3, #1
    B.NE L_case_o912_br_1
    MOV X0, #24
    B L_case_o912_done
L_case_o912_br_1:
    CMP W3, #0
    B.NE L_case_o912_fb
    MOV X0, #25
    B L_case_o912_done
L_case_o912_fb:
    BL silica_rt_case_clause
    MOV X0, #0
    B L_case_o912_done
L_case_o912_done:

    B L_case_o856_done
L_case_o856_fb:
    BL silica_rt_case_clause
    MOV X0, #0
    B L_case_o856_done
L_case_o856_done:

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

