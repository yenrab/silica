// Minimal PriorityQueue construction module for pq_priority_type_composite_result and
// pq_item_type_is_value. `StubPriorityQueue` is one of the module names the checker registers for
// PriorityQueue[P, V, mem(S)] bindings (type_checker_collections representation_id_from_module), so a
// bracket-typed `x <- StubPriorityQueue@empty({...})` binding type-checks without the real stdlib.
// Stored comparator witnesses follow the design (compare_priority for PriorityType, compare_item for
// the value); every signature uses the design placeholders PriorityType and ItemType.

export empty/1;
export peek/3;
export value_only/2;

fn empty(
    functions: {
        compare_priority: fn(PriorityType, PriorityType) -> :less | :equal | :greater,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater
    }
) -> {
        compare_priority: fn(PriorityType, PriorityType) -> :less | :equal | :greater,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        count: int64
    } {
    { compare_priority: functions.compare_priority, compare_item: functions.compare_item, count: 0 }
}

// Composite result naming PriorityType and ItemType.
fn peek(
    queue: {
        compare_priority: fn(PriorityType, PriorityType) -> :less | :equal | :greater,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        count: int64
    },
    placeholder_priority: PriorityType,
    placeholder_value: ItemType
) -> { status: :not_found | :found, priority: PriorityType, value: ItemType } {
    { status: :not_found, priority: placeholder_priority, value: placeholder_value }
}

// Bare ItemType formal: the stored value (bracket parameter 2), string for PriorityQueue[int64, string, mem(normal)].
fn value_only(
    queue: {
        compare_priority: fn(PriorityType, PriorityType) -> :less | :equal | :greater,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        count: int64
    },
    value: ItemType
) -> ItemType {
    value
}
