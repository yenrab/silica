    LDR X2, [X9, #8]
    MOV X0, #1
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_ps_helper:
    LDR X9, [X0]
    MOV X10, #-1
    CMP X9, X10
    B.NE L_ps_bad
    LDR X1, [X0, #8]
    LDR X2, [X0, #16]
    MOV X0, #1
    STP X19, X20, [SP, #-16]!
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    LDP X19, X20, [SP], #16
    RET
L_ps_bad:
    BRK #1
