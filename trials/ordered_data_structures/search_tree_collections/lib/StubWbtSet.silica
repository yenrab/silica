// A minimal OrderedSet/SearchTree construction module for the compile-defect trial beside it.
// `StubWbtSet` is one of the module names the checker registers for the wbt_set representation
// (type_checker_collections representation_id_from_module), so a bracket-typed
// `t <- StubWbtSet@empty({...})` binding type-checks without the real stdlib. The record keeps only
// the comparator witness and a logical count; insert adds one to the count.

export empty/1;
export insert/2;
export count/1;

fn empty(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }
) -> { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, count: int64 } {
    { compare_item: functions.compare_item, count: 0 }
}

fn insert(
    set: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, count: int64 },
    item: ItemType
) -> { set: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, count: int64 }, inserted: boolean } {
    { set: { compare_item: set.compare_item, count: set.count + 1 }, inserted: true }
}

fn count(set: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, count: int64 }) -> int64 {
    set.count
}
