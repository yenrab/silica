    MOV X1, #48
    STRB W1, [X8]
L_pi_maybe_neg:
    CBNZ X11, L_pi_prepend_minus
    B L_pi_do_write
L_pi_prepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pi_do_write:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    STP X19, X20, [SP, #-16]!
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    LDP X19, X20, [SP], #16
    ADD SP, SP, #32
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #23
    B.ge L_pa_oob
    ADRP X9, L_pa_table
    ADD X9, X9, :lo12:L_pa_table
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    STR X8, [SP, #-16]!
    MOV X8, #64
    SVC #0
    LDR X8, [SP], #16
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

