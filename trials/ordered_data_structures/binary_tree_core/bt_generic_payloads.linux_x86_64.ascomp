    jb Lcmp_lt
    jmp Lcmp_gt
Lcmp_anull:
    test r12, r12
    jz Lcmp_eq
Lcmp_lt:
    mov edi, -1
    jmp Lcmp_exit
Lcmp_gt:
    mov edi, 1
    jmp Lcmp_exit
Lcmp_eq:
