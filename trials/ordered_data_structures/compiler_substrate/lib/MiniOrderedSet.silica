export trait MiniOrderedSet;
export fold/3;
export size/1;

fn fold_add_one(acc: int64, _: string) -> int64 {
    acc + 1
}

required {
    fn fold(
        set: MiniOrderedSet,
        init: int64,
        step: fn(int64, string) -> int64
    ) -> int64;
}

provided {
    fn size(set: MiniOrderedSet) -> int64 {
        MiniOrderedSet@fold(set, 0, fold_add_one)
    }
}

impl fn fold(
    set: { stored_size: int64, compare_item: fn(string, string) -> :less | :equal | :greater },
    init: int64,
    step: fn(int64, string) -> int64
) -> int64 {
    case set.stored_size == 0 of {
        true -> init;
        false -> step(init, "x")
    }
}
