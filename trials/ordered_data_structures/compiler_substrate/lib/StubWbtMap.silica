export empty/1;

fn empty(functions: { compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(string, string) -> :less | :equal | :greater }) -> {
    stored_size: int64,
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(string, string) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64
} {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        ph: region(L, normal) <- canonical_arena_lookup(1);
        out: {
            stored_size: int64,
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(string, string) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- {
            stored_size: 0,
            compare_key: functions.compare_key,
            compare_value: functions.compare_value,
            region: ph,
            specialization_key: 0
        }
    produces
        pure out
    end
}
