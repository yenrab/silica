// Layer 1 §7.2: min and max heap orientations produce incompatible bundle tokens.

fn cmp_int64(a: int64, b: int64) -> atom {
    case a < b of {
        true -> :less;
        false -> case a > b of {
            true -> :greater;
            false -> :equal
        }
    }
}

fn main() -> int64 {
    sequence
        fn_token: int64 <- ordering_identity_materialize(cmp_int64);
        min_bundle: int64 <- ordering_identity_bundle_make(fn_token, :min);
        max_bundle: int64 <- ordering_identity_bundle_make(fn_token, :max);
        same: boolean <- ordering_identity_same(min_bundle, max_bundle);
        exit_code: int64 <- case same of {
            true -> 1;
            false -> 0
        }
    produces
        pure exit_code
    end
}
