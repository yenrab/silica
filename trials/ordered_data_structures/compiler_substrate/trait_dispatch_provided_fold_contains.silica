// Layer 1 §7.4: provided method delegates to a required trait hook (fold-derived size).

use MiniOrderedSet;

fn string_equal(_a: string, _b: string) -> :less | :equal | :greater {
    :equal
}

fn main() -> int64 {
    cmp: fn(string, string) -> :less | :equal | :greater <- string_equal;
    set0: { stored_size: int64, compare_item: fn(string, string) -> :less | :equal | :greater } <- {
        stored_size: 3,
        compare_item: cmp
    };
    MiniOrderedSet@size(set0)
}
