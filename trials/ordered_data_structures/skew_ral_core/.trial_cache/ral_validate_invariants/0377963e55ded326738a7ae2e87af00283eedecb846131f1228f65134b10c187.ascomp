    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!

    MOV X0, SP
    ; unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o849|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, skew_ral_arena_key@PAGE
    ADD X9, X9, skew_ral_arena_key@PAGEOFF
    BLR X9

    MOV X1, X0
    MOV X19, X1
    MOV X1, X19
    MOV X0, X1
