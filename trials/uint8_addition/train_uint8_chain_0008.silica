// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint8(55 % 35 / (24 + 55));
        println("");
        _: atom <- print_uint8(55 % 13 % (29 - 21));
        println("");
        _: atom <- print_uint8(55);
        println("");
        result: atom <- print_uint8(25 + 10)
    produces
        pure result
    end
}
