// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((38 + 48) == (37 - 29));
        println("");
        _: atom <- print_bool(45 >= (54 + 18));
        println("");
        _: atom <- print_bool(46 / 12 == (8 + 21));
        println("");
        result: atom <- print_bool(38 != 50)
    produces pure result end
}
