// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((41 - 27) >= 29 % 35);
        println("");
        _: atom <- print_bool((33 + 19) >= (38 - 5));
        println("");
        result: atom <- print_bool(21 == 49 / 44)
        produces pure result end
}
