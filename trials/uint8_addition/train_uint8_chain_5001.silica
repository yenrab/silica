// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_uint8(8);
        println("");
        _: atom <- print_uint8(47 + 10);
        println("");
        _: atom <- print_uint8(45);
        println("");
        result: atom <- print_uint8(19 * 1)
        produces pure result end
}
