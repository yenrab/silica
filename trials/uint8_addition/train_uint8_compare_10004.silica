// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(31 / 37 > 17 / 12);
        println("");
        _: atom <- print_bool(6 < 8 % 16);
        println("");
        _: atom <- print_bool(20 % 60 != 17);
        println("");
        _: atom <- print_bool((17 - 10) >= 16);
        println("");
        result: atom <- print_bool(37 > 41 / 43)
    produces pure result end
}
