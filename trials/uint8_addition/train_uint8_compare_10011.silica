// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(27 < (4 + 59));
        println("");
        _: atom <- print_bool(41 % 5 < (17 + 53));
        println("");
        _: atom <- print_bool(44 > 54 / 54);
        println("");
        _: atom <- print_bool((20 + 41) != 34 % 55);
        println("");
        result: atom <- print_bool(35 <= 51 % 1)
        produces pure result end
}
