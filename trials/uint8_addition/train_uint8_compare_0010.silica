// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(46 % 34 < 25 % 18);
        println("");
        _: atom <- print_bool((4 + 22) >= (57 / 3));
        println("");
        _: atom <- print_bool(15 % 8 == 7 * 15);
        println("");
        _: atom <- print_bool((44 + 42) > 15);
        println("");
        result: atom <- print_bool(48 < (45 + 43))
    produces pure result end
}
