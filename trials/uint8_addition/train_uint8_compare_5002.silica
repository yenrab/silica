// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(39 < 21);
        println("");
        _: atom <- print_bool((22 + 25) == 55 % 43);
        println("");
        result: atom <- print_bool((23 / 25) == 12)
        produces pure result end
}
