// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint8(10);
        println("");
        _: atom <- print_uint8(58);
        println("");
        _: atom <- print_uint8(9);
        println("");
        result: atom <- print_uint8(34)
    produces
        pure result
    end
}
