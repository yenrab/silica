// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint8(22 / 26);
        println("");
        _: atom <- print_uint8((60 - 37));
        println("");
        result: atom <- print_uint8(58 % 18 + (46 + 13))
    produces pure result end
}
