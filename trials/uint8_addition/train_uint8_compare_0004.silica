// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((18 + 17) < 60);
        println("");
        _: atom <- print_bool((6 + 4) <= (53 + 49));
        println("");
        _: atom <- print_bool((44 + 10) <= 27 % 59);
        println("");
        _: atom <- print_bool((0 + 50) != 18 % 17);
        println("");
        result: atom <- print_bool((52 - 46) >= 19)
    produces
        pure result
    end
}
