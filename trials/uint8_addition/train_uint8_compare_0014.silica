// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(50 >= 1 * 2);
        println("");
        _: atom <- print_bool((52 + 48) == 57);
        println("");
        result: atom <- print_bool((42 + 40) > 4 % 28)
        produces pure result end
}
