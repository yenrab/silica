// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((23 + 10) < (38 + 31));
        println("");
        _: atom <- print_bool((59 - 53) <= 38);
        println("");
        _: atom <- print_bool((51 + 36) < 33);
        println("");
        result: atom <- print_bool(60 != (6 + 22))
    produces
        pure result
    end
}
