// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(3 % 34 < (50 - 14));
        println("");
        _: atom <- print_bool(6 > (4 + 3));
        println("");
        _: atom <- print_bool((58 / 50) >= 17);
        println("");
        result: atom <- print_bool((1 / 29) == (57 / 17))
    produces pure result end
}
