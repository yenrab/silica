// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((46 + 46) <= (41 + 19));
        println("");
        _: atom <- print_bool((22 + 42) <= 42);
        println("");
        result: atom <- print_bool(1 >= 38)
    produces pure result end
}
