// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((29 + 46) >= (40 - 13));
        println("");
        _: atom <- print_bool(28 < (14 - 4));
        println("");
        _: atom <- print_bool((58 + 50) == 26 / 15);
        println("");
        result: atom <- print_bool(2 % 3 > (50 + 50))
        produces pure result end
}
