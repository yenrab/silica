// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((29 + 22) >= 27 % 22);
        println("");
        _: atom <- print_bool((48 + 60) != 45);
        println("");
        _: atom <- print_bool(6 != (51 - 28));
        println("");
        result: atom <- print_bool(42 % 52 != 44 / 8)
    produces
        pure result
    end
}
