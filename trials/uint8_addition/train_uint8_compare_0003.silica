// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((12 - 11) == 44);
        println("");
        _: atom <- print_bool((34 - 19) < 4 % 26);
        println("");
        _: atom <- print_bool((43 + 54) >= (24 + 10));
        println("");
        result: atom <- print_bool(40 % 8 > (34 + 35))
    produces pure result end
}
