// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint8(22);
        println("");
        _: atom <- print_uint8(16);
        println("");
        _: atom <- print_uint8(53);
        println("");
        result: atom <- print_uint8(19)
    produces pure result end
}
