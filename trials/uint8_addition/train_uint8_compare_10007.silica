// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(58 / 31 >= 54);
        println("");
        _: atom <- print_bool(9 % 51 != (1 + 27));
        println("");
        _: atom <- print_bool((10 + 29) >= 31 % 2);
        println("");
        _: atom <- print_bool((0 + 58) < (2 + 4));
        println("");
        result: atom <- print_bool(50 / 10 == 28 / 56)
    produces pure result end
}
