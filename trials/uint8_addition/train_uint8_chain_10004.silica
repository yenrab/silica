// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_uint8(1 * 27 - (12 % 28));
        println("");
        _: atom <- print_uint8(13);
        println("");
        _: atom <- print_uint8((12 / (48 / 15)));
        println("");
        result: atom <- print_uint8(36 / (0 + 35))
        produces pure result end
}
