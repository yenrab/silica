// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(40 > 25 / 7);
        println("");
        _: atom <- print_bool(51 < 44 * 1);
        println("");
        _: atom <- print_bool(36 / 46 == 9);
        println("");
        result: atom <- print_bool((7 + 23) != 50 % 59)
        produces pure result end
}
