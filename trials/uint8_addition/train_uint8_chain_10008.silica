// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint8(36);
        println("");
        _: atom <- print_uint8(7);
        println("");
        _: atom <- print_uint8(14 / 11 % 39);
        println("");
        result: atom <- print_uint8(2)
    produces pure result end
}
