// chained print_uint64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint64(28 - 17);
        println("");
        _: atom <- print_uint64(19);
        println("");
        _: atom <- print_uint64(0 * 60 * (25 * 41));
        println("");
        result: atom <- print_uint64(29 - 21)
    produces
        pure result
    end
}
