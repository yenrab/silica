// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((21 + 2) < 54 / 26);
        println("");
        _: atom <- print_bool((37 - 3) == 40);
        println("");
        _: atom <- print_bool(45 / 31 > 46 % 41);
        println("");
        _: atom <- print_bool((23 + 37) > (53 + 60));
        println("");
        result: atom <- print_bool(11 >= (20 + 56))
    produces pure result end
}
