// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(55 != 42);
        println("");
        _: atom <- print_bool(54 / 37 <= 54 / 3);
        println("");
        _: atom <- print_bool((8 / 30) > 0 % 55);
        println("");
        result: atom <- print_bool(56 / 51 > (41 - 37))
    produces
        pure result
    end
}
