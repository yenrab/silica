// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(52 < (57 + 0));
        println("");
        _: atom <- print_bool(44 * 49 >= 43);
        println("");
        _: atom <- print_bool((46 + 23) != (34 + 45));
        println("");
        result: atom <- print_bool(42 * 50 > 43 / 6)
    produces
        pure result
    end
}
