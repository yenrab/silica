// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(24 != (48 - 29));
        println("");
        _: atom <- print_bool(56 >= (58 - 23));
        println("");
        _: atom <- print_bool(58 % 2 != 7 % 5);
        println("");
        result: atom <- print_bool(56 > 18)
        produces pure result end
}
