// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(11 / 54 < 25 % 20);
        println("");
        _: atom <- print_bool(42 < (41 + 43));
        println("");
        _: atom <- print_bool((60 + 4) == 25);
        println("");
        result: atom <- print_bool((58 % 20) == 27)
    produces pure result end
}
