// chained print_uint64 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_uint64(44);
        println("");
        _: atom <- print_uint64(11 / (28 / 18));
        println("");
        _: atom <- print_uint64(0 * 35 + 8);
        println("");
        result: atom <- print_uint64((46 % 5 + 7 * 46))
        produces pure result end
}
