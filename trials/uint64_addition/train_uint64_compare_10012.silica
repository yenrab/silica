// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(56 / 13 <= 27);
        println("");
        _: atom <- print_bool(43 / 45 > (59 % 56));
        println("");
        result: atom <- print_bool((42 + 6) < 27)
        produces pure result end
}
