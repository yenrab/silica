// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(51 == (51 + 31));
        println("");
        _: atom <- print_bool((37 + 2) >= 33 * 11);
        println("");
        result: atom <- print_bool(3 * 28 < 49 % 48)
    produces
        pure result
    end
}
