// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(31 / 44 == 11 % 41);
        println("");
        _: atom <- print_bool(8 % 31 >= (55 % 38));
        println("");
        _: atom <- print_bool(12 > (21 * 12));
        println("");
        result: atom <- print_bool(46 / 49 <= (50 + 52))
        produces pure result end
}
