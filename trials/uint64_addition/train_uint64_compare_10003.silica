// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(47 % 47 > 50 % 12);
        println("");
        _: atom <- print_bool((21 + 26) <= (50 - 0));
        println("");
        _: atom <- print_bool(35 * 60 > (21 + 54));
        println("");
        _: atom <- print_bool((24 + 18) <= (37 / 36));
        println("");
        result: atom <- print_bool(15 % 46 < 37 / 52)
    produces pure result end
}
