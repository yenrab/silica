// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(35 % 10 > 17 % 58);
        println("");
        _: atom <- print_bool(12 % 53 <= (30 + 58));
        println("");
        result: atom <- print_bool((21 + 49) > 40 * 10)
        produces pure result end
}
