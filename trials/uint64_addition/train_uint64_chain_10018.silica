// chained print_uint64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint64(36 * 23);
        println("");
        _: atom <- print_uint64(44);
        println("");
        _: atom <- print_uint64(41 * 41);
        println("");
        result: atom <- print_uint64(38 / 31)
    produces
        pure result
    end
}
