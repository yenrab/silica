// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((51 + 2) == (31 - 15));
        println("");
        _: atom <- print_bool((27 + 26) > (48 + 58));
        println("");
        _: atom <- print_bool((43 - 31) > 14 * 50);
        println("");
        result: atom <- print_bool(28 * 55 <= (16 + 1))
    produces pure result end
}
