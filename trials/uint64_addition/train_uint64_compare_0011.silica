// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(11 % 54 >= 30 % 17);
        println("");
        _: atom <- print_bool(57 / 6 != 8);
        println("");
        result: atom <- print_bool(17 / 57 == 17)
    produces
        pure result
    end
}
