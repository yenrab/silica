// chained print_uint64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint64(6);
        println("");
        _: atom <- print_uint64((2 / 37 % (23 + 32)));
        println("");
        result: atom <- print_uint64((11 % 17 + (36 + 55)))
    produces pure result end
}
