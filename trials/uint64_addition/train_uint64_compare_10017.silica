// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(54 * 18 > 1);
        println("");
        _: atom <- print_bool((22 - 13) >= (50 + 7));
        println("");
        result: atom <- print_bool((52 + 23) != 1)
    produces
        pure result
    end
}
