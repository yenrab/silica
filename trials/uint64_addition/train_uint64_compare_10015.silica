// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(8 / 33 > (30 + 50));
        println("");
        _: atom <- print_bool(45 * 15 == (14 + 42));
        println("");
        _: atom <- print_bool((7 + 2) <= (7 * 41));
        println("");
        _: atom <- print_bool((37 - 7) > 31);
        println("");
        result: atom <- print_bool((51 - 44) <= 50 * 40)
    produces pure result end
}
