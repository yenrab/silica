// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((19 * 50) < (1 + 25));
        println("");
        _: atom <- print_bool((34 + 16) != 56 * 15);
        println("");
        result: atom <- print_bool(54 <= 41)
        produces pure result end
}
