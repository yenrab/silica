// Trait for defect_trait_placeholder_result_dispatch: one method whose result mentions ValueType, two
// implementations with different records.

use ItemStore;

export trait Items;
export items/1;

required {
    fn items(b: Items) -> List[ValueType, mem(normal)];
}

impl fn items(b: { compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, xs: List[ValueType, mem(normal)] }) -> List[ValueType, mem(normal)] {
    ItemStore@first_items(b)
}

impl fn items(b: { compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, tag: int64, ys: List[ValueType, mem(normal)] }) -> List[ValueType, mem(normal)] {
    ItemStore@second_items(b)
}
