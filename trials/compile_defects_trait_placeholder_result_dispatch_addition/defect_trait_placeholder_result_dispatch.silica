// Documented open type-checker defect (2026-09-18), found while adding the CSR and dense
// implementations to the graph traits (stdlib/data_structures/DirectedGraph.silica deviation 7). It
// sits alone in this directory because a compile rejection fails the whole directory.
//
// Defect: a call to a trait method whose result type mentions a placeholder (List[ValueType, ...]
// here; AccType, KeyType, ItemType and {status, weight: ItemType} results behave the same) is
// resolved against the LAST implementation in the trait unit instead of the one whose record the
// argument has. Here the argument is the first implementation's record and the call is rejected
// (E2003, "... does not match parameter type {... tag ... ys ...} for Items@items"). With the
// graph records, whose runtime fields let the argument through, the call compiles and runs the last
// implementation on the wrong record (ordered_data_structures/graph_collections/
// emitter_defect_trait_placeholder_result_dispatch). Methods returning int64, boolean or atoms
// dispatch correctly.
// Expected: compiles and prints 7, exit 0.
// Observed: in this directory's one-process compile the checker first re-checks Items' first impl
// body against this call site and rejects the forwarded result (E2003 at Items.silica 14:5,
// "ItemStore@first_items returns List [ int64 , ... ], expected List[ValueType, normal]"); with
// Items compiled beforehand as a library (as the stdlib graph traits are) the call itself is
// rejected against the last implementation (E2003 at 44:54, quoted above).
//
// To run by hand:
//   mkdir -p /tmp/prd && cp ItemStore.silica Items.silica defect_trait_placeholder_result_dispatch.silica /tmp/prd/ && cd /tmp/prd
//   printf 'ItemStore.silica\nItems.silica\ndefect_trait_placeholder_result_dispatch.silica\n' > silica.config
//   /Volumes/2T/silica/binaries/silica-compiler

use Items;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn lists() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [7, 8]
    produces
        pure xs
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: { compare_value: fn(int64, int64) -> :less | :equal | :greater, xs: List[int64, mem(normal)] } <- { compare_value: cmp_i64, xs: lists() };
        got: List[int64, mem(normal)] <- Items@items(a);
        print_int64(got.head);
        println("")
    produces
        pure 0
    end
}
