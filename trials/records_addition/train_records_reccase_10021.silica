// record pattern matching (guard); expect 9
fn score(p: { x: int64, y: int64 }) -> int64 {
    case p of {
        { x: xv, y: yv } if xv > yv -> xv - yv;
        { x: xv, y: yv } if yv > xv -> yv - xv;
        { x: xv, y: yv } -> xv + yv
    }
}

fn main() -> int64 {
    p: { x: int64, y: int64 } <- { x: 0, y: 9 };
    score(p)
}
