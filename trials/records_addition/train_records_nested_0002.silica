// nested inline records; sum = 36
fn main() -> int64 {
    rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
        top_left: { x: 0, y: 3 },
        bottom_right: { x: 14, y: 19 }
    };
    rect.top_left.x + rect.top_left.y + rect.bottom_right.x + rect.bottom_right.y
}
