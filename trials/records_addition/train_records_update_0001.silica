// functional record update through bump; counter ends at 55
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0: { counter: int64, label: string } <- { counter: 39, label: "count" };
    s1: { counter: int64, label: string } <- bump(s0, 8);
    s2: { counter: int64, label: string } <- bump(s1, 8);
    s2.counter
}
