// Documented open defect (2026-09-18): see defect_supervisor_init_in_other_unit_sup.silica. This main
// spawns a supervisor whose impl and init live in another unit; expected output once the link defect
// is fixed: 5, then exit 0.

use Supervisor;
use defect_supervisor_init_in_other_unit_sup;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- spawn_registered_supervisor(OtherUnitSup, 0, :other_unit_sup, stack_policy(0, :keep_last_message));
        _: boolean <- cast_registered(:adder, (2, 3) impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
