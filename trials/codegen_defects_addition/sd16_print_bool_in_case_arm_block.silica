// SD-16: print_bool inside a case-arm block { ... } emits BL L_pb_helper / L_pb_true but never the
// helper, so the assembler fails ("local symbol not defined"); at sequence top level it works.
// Reconstructed from the project-bees S4 spike note §3 (the note's source is not on disk).
// Expected: true
fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- case 1 == 1 of {
            true -> { _: atom <- print_bool(true); println(""); :ok };
            false -> :ok
        }
    produces pure 0 end
}
