// Documented open type-checker defect (book-verification 2026-09-19, repro ds_graph). The
// `UndirectedGraph` shape of the defect documented in
// compile_defects_ordered_set_field_annotation_addition (see that README): a record annotation
// with an `UndirectedGraph[N, E, mem(normal)]`-typed field is rejected even though the plain,
// non-nested binding of the same bracket type is accepted. References the real stdlib
// `graph_wbt_undirected.silica`/`graph_wbt_core.silica` (and their `wbt_set`/`wbt_map`
// dependencies) by relative path rather than copying them.
// Expected: an edge is added between "Big Pool" and "Mud Hole", `r.inserted` is true, exit 1.
// Observed: E2003 "graph_wbt_undirected@add_edge returns {graph : {...concrete fields...},
// inserted: boolean, replaced: boolean}, expected {graph: UndirectedGraph[string, int64,
// normal], inserted: boolean, replaced: boolean}".

use graph_wbt_undirected;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_counts(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        g: UndirectedGraph[string, int64, mem(normal)] <- graph_wbt_undirected@empty({ compare_node: compare_names, compare_edge_data: compare_counts });
        r: { graph: UndirectedGraph[string, int64, mem(normal)], inserted: boolean, replaced: boolean } <- graph_wbt_undirected@add_edge(g, "Big Pool", "Mud Hole", 4)
    produces
        pure case r.inserted of {
            true -> 1;
            false -> 0
        }
    end
}
