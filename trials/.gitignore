# Regenerated by each trial Makefile target `silica.config` (see that directory's Makefile).
**/silica.config
# Written by `make integrate` / sub-trial checks; removed by `make clean`.
**/.integrate_counts

# Written by the shared integrate wrapper (silica_compiler.mk); removed by `make clean`.
**/.integrate_log
**/.integrate_report
**/.integrate_status
**/.integrate_start
**/.integrate_results
**/.integrate_skipped
**/.integrate_last_dot
**/.integrate_running/
# Per-unit sandboxes and stamps in ordered_data_structures leaves.
**/.sandbox/
**/*.checked
