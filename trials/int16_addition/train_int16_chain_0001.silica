// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int16((14 + 17));
        println("");
        _: atom <- print_int16(48 + 50);
        println("");
        _: atom <- print_int16(30 % 34 + (33 + 47));
        println("");
        result: atom <- print_int16(33)
    produces
        pure result
    end
}
