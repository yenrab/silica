// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int16(18);
        println("");
        _: atom <- print_int16(25);
        println("");
        _: atom <- print_int16(24 % 6 % (26 + 8));
        println("");
        result: atom <- print_int16(10)
    produces
        pure result
    end
}
