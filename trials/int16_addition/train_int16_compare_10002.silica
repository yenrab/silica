// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(23 % 59 >= 10);
        println("");
        _: atom <- print_bool((13 + 8) < 37);
        println("");
        _: atom <- print_bool(18 > 50 * 58);
        println("");
        _: atom <- print_bool(3 * 52 >= 51);
        println("");
        result: atom <- print_bool(3 % 53 == (30 + 53))
    produces pure result end
}
