// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(54 != (52 + 42));
        println("");
        _: atom <- print_bool(3 * 52 != 29 % 2);
        println("");
        result: atom <- print_bool((51 + 24) != (51 - 40))
    produces
        pure result
    end
}
