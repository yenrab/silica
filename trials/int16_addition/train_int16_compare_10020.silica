// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((52 - 46) != (39 + 8));
        println("");
        _: atom <- print_bool(53 != 42);
        println("");
        result: atom <- print_bool(18 == 12)
    produces
        pure result
    end
}
