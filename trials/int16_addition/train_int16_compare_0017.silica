// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(4 * 1 == (34 + 38));
        println("");
        _: atom <- print_bool(45 >= 57 % 47);
        println("");
        result: atom <- print_bool((55 - 19) < (9 + 31))
        produces pure result end
}
