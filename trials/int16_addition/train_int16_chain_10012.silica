// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int16(32);
        println("");
        _: atom <- print_int16(36 / 1 - (9 - 22));
        println("");
        result: atom <- print_int16((43 + 47) / (50 + 13))
    produces pure result end
}
