// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(27 <= (52 * 50));
        println("");
        _: atom <- print_bool((0 + 16) >= (2 + 23));
        println("");
        _: atom <- print_bool((46 + 14) == 26);
        println("");
        result: atom <- print_bool(58 / 34 != 49 * 17)
        produces pure result end
}
