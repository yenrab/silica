// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(36 * 34 > 53 % 15);
        println("");
        _: atom <- print_bool((22 + 44) > 48 * 8);
        println("");
        _: atom <- print_bool(24 <= 21 / 27);
        println("");
        result: atom <- print_bool((18 / 41) >= (19 + 2))
    produces
        pure result
    end
}
