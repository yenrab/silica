// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(1 * 1 <= (38 - 38));
        println("");
        _: atom <- print_bool((33 + 23) > 43 * 52);
        println("");
        _: atom <- print_bool(4 != 25 / 35);
        println("");
        _: atom <- print_bool((59 + 53) == 20 * 37);
        println("");
        result: atom <- print_bool(16 >= 56 % 39)
        produces pure result end
}
