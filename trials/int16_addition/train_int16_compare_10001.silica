// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(34 % 45 != 45);
        println("");
        _: atom <- print_bool(59 % 47 < (44 / 25));
        println("");
        _: atom <- print_bool((56 + 58) != (6 + 6));
        println("");
        _: atom <- print_bool(22 * 50 >= 55);
        println("");
        result: atom <- print_bool((12 + 34) >= (52 - 39))
    produces
        pure result
    end
}
