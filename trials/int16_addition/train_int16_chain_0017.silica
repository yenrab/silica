// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int16(28);
        println("");
        _: atom <- print_int16(60);
        println("");
        _: atom <- print_int16((36 + 10));
        println("");
        result: atom <- print_int16((7 / 18))
        produces pure result end
}
