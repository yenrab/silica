// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(9 != 47 % 40);
        println("");
        _: atom <- print_bool((16 + 22) >= (28 % 39));
        println("");
        result: atom <- print_bool(25 == (59 / 24))
    produces pure result end
}
