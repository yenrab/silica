// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int16(43);
        println("");
        _: atom <- print_int16(43);
        println("");
        _: atom <- print_int16(48);
        println("");
        result: atom <- print_int16(43 % 12)
        produces pure result end
}
