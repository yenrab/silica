// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int16(5);
        println("");
        _: atom <- print_int16(7);
        println("");
        _: atom <- print_int16(19);
        println("");
        result: atom <- print_int16(48)
    produces
        pure result
    end
}
