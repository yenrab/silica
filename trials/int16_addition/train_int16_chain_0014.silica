// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int16(40);
        println("");
        _: atom <- print_int16((41 * 15) + 21);
        println("");
        _: atom <- print_int16(45);
        println("");
        result: atom <- print_int16(56)
        produces pure result end
}
