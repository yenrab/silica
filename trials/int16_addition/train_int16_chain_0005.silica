// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int16(2 * 38);
        println("");
        _: atom <- print_int16(41);
        println("");
        _: atom <- print_int16(12 * 34);
        println("");
        result: atom <- print_int16(14)
    produces
        pure result
    end
}
