// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int16(26);
        println("");
        _: atom <- print_int16(25 % 59);
        println("");
        _: atom <- print_int16(((38 - 12) % (47 / 24)));
        println("");
        result: atom <- print_int16(58)
        produces pure result end
}
