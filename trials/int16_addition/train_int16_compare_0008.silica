// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((19 + 8) < 43 / 38);
        println("");
        _: atom <- print_bool((21 + 18) != 8);
        println("");
        _: atom <- print_bool((52 + 4) < 59);
        println("");
        _: atom <- print_bool(57 % 20 != (40 * 55));
        println("");
        result: atom <- print_bool(41 <= (35 + 55))
    produces pure result end
}
