// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(48 * 27 < 34 * 14);
        println("");
        _: atom <- print_bool(10 * 0 >= 32);
        println("");
        result: atom <- print_bool(46 >= 29)
    produces
        pure result
    end
}
