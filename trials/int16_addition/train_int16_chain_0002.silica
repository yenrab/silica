// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int16(((51 + 27) / (43 * 2)));
        println("");
        _: atom <- print_int16(20 + 41);
        println("");
        _: atom <- print_int16(39 * 38);
        println("");
        result: atom <- print_int16(56)
    produces pure result end
}
