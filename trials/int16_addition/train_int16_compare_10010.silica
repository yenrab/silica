// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(5 == (59 - 14));
        println("");
        _: atom <- print_bool(0 % 29 == (19 % 16));
        println("");
        _: atom <- print_bool((54 + 49) >= (41 + 36));
        println("");
        _: atom <- print_bool((43 + 46) <= (15 + 32));
        println("");
        result: atom <- print_bool(0 / 25 == (43 - 35))
    produces pure result end
}
