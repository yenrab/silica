// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int16((58 - 20) % (25 + 34));
        println("");
        _: atom <- print_int16(43 + 40);
        println("");
        _: atom <- print_int16(1);
        println("");
        result: atom <- print_int16(39 % 18)
        produces pure result end
}
