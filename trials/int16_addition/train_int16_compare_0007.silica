// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((0 + 8) < 56 / 36);
        println("");
        _: atom <- print_bool(49 / 16 <= (16 + 9));
        println("");
        result: atom <- print_bool((39 / 43) == 28)
    produces pure result end
}
