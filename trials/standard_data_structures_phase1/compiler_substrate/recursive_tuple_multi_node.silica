// Layer 1 §7.3: multi-node recursive structure traverses optional references.

fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        n2: ref(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (2, :none, :none));
        n1: ref(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (1, n2, :none));
        node1: (int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(n1);
        (k1: int64, next: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node1;
        exit_code: int64 <- case next of {
            :none -> 1;
            next_ref: ref(L, normal, (int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> do
                node2: (int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(next_ref);
                (k2: int64, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node2;
                case k1 == 1 and k2 == 2 of {
                    true -> 0;
                    false -> 2
                }
            end
        }
    produces
        pure exit_code
    end
}
