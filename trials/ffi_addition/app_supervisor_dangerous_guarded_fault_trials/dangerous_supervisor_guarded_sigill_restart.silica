// Supervisor + guarded FFI SIGILL trial (get_child + cast):
// One static :dangerous child faults on msg 0 and reports 42 on msg 1 after restart.
// SIGSEGV/null-deref, SIGABRT, and SIGTRAP supervisor pairs live elsewhere.

module dangerous_supervisor_guarded_sigill_restart;

use Supervisor;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_ffi_sigill_probe"
fn sigill_probe_raw() -> int64;

foreign c_wrapper "silica_legacy_math_add_int64"
fn add_raw(left: int64, right: int64) -> int64;

impl DangerousSupervisorGuardedSigillRestartSup for Supervisor;

fn result_sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        print_int64(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn dangerous_ffi_worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        _: int64 <- case msg == 0 of {
            true -> sigill_probe_raw();
            false -> 0
        };
        sum: int64 <- case msg == 1 of {
            true -> add_raw(40, 2);
            false -> 0
        };
        _: boolean <- case msg == 1 of {
            true -> cast_registered(:sup_result_sink, sum impl ActorMessage {});
            false -> true
        }
    produces
        pure (:no_reply, reply_to)
    end
}

fn init(_initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 60 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            {
                id: :dangerous_guarded_ffi_sigill_worker,
                agent_type: :worker,
                initial_state: 0,
                behavior: dangerous_ffi_worker,
                restart: :permanent,
                shutdown: 0,
                flavor: :dangerous
            }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: actor_ref <- spawn_registered(0, result_sink, :sup_result_sink);
        sup: supervisor_ref <- spawn_registered_supervisor(
            DangerousSupervisorGuardedSigillRestartSup,
            0,
            :dangerous_sup_guarded_sigill_restart
        );

        first_get: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :dangerous_guarded_ffi_sigill_worker } impl SupervisorMessage {});

        _: boolean <- cast(first_get.child, 0 impl ActorMessage {});

        second_get: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :dangerous_guarded_ffi_sigill_worker } impl SupervisorMessage {});

        _: boolean <- cast(second_get.child, 1 impl ActorMessage {});

        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
