// SD-18: a spawn_dangerous worker faults on its SECOND message ("[silica] fault ... in
// os_unfair_lock_lock"); the first request is answered, and any number of foreign calls inside one
// dispatch work (app_legacy_math_add_twice). FFI wrapper spec §4.4: the worker "receives
// foreign-call request casts" and §4.2's cast-mediated model puts no limit on their number.
// Reconstructed from project-bees trials/s04_native_edge/dangerous_sd18_second_message_faults.silica
// on Silica's legacy_math fixture (the original calls a BEES clock wrapper). Expected: 41 / done / 42 / done
module dangerous_sd18_worker_second_message;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_legacy_math_add_int64"
fn add_raw(left: int64, right: int64) -> int64;

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_int64(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state + 1)
    end
}

fn worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        t: int64 <- add_raw(40, msg);
        _: boolean <- cast(reply_to, t impl ActorMessage {})
    produces
        pure (:no_reply, reply_to)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        w: dangerous_actor_ref <- spawn_dangerous(s, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 1 impl ActorMessage {});
        _: boolean <- cast(w, 2 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
