module foreign_fault_without_actor;

// spec §15.4.5.5: a fault in guarded foreign code when no actor is current has no supervisor to be
// delivered to, so it is a fatal fault: the report line and exit status 70. The guarded call is made
// by the C probe (foreign_fault_without_actor_probe.c) from a constructor before main, through the
// same runtime entries the emitted code uses; main never runs. Before this the runtime printed
// "foreign_fault" and exited 1.
fn main() -> int64 {
    sequence proc[device_io]
        println("main ran")
    produces
        pure 0
    end
}
