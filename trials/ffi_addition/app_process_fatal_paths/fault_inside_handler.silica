module fault_inside_handler;

// spec §15.4.5.5: a fault raised while the fault handler itself is running takes a last-resort path
// that writes the fault report line and exits 70 without re-entering the handler. The C probe
// (fault_inside_handler_probe.c) faults in a constructor before main; the runtime's handler asks
// dladdr to name the faulting code, and the probe's own dladdr, which takes the C library's place in
// this program, faults inside the handler. Before the last-resort path the second SIGSEGV arrived
// while the first was blocked and the process ended with the default action (status 139).
fn main() -> int64 {
    sequence proc[device_io]
        println("main ran")
    produces
        pure 0
    end
}
