module fault_before_main;

// spec §15.4.5.5: the fault handlers are installed by the startup code before main runs, so a fault
// raised before main -- here by a C constructor in fault_before_main_probe.c, which the Makefile
// links after the Silica runtime object so that it runs after the runtime's constructor -- is a
// fatal fault like any other: the report line on stderr and exit status 70. main never runs, so
// "main ran" is never printed. Before the handlers were installed at startup this ended with the
// default action of SIGSEGV (status 139).
fn main() -> int64 {
    sequence proc[device_io]
        println("main ran")
    produces
        pure 0
    end
}
