// §15.1.2.2: a reservation that cannot be made fails the spawn. main is not an actor and has no
// supervisor, so the process ends with a runtime abort, reason "stack reservation failed", exit
// status 71 (§15.4.5.5). 2^62 bytes exceeds any AArch64 user address space.

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        println("before");
        w: actor_ref <- spawn(0, beh, stack_policy(4611686018427387904, :keep_high_water));
        r: int64 <- call(w, 1 impl ActorMessage {});
        print_int64(r);
        println("after")
    produces
        pure 0
    end
}
