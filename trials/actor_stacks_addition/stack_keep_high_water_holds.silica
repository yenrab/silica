// §15.1.2.2 :keep_high_water releases nothing until the actor ends: a shallow message after a deep
// one leaves the committed stack where the deep message left it.

fn depth(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> {
            r: int64 <- depth(n - 1);
            r + 1
        }
    }
}

fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    r: int64 <- depth(msg);
    (:reply, r, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, beh, stack_policy(0, :keep_high_water));
        _: int64 <- call(w, 200000 impl ActorMessage {});
        deep: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
        _: int64 <- call(w, 10 impl ActorMessage {});
        after: { reserved: int64, committed: int64, retained: int64, high_water: int64 } <- get_actor_memory_usage(w);
        print_bool(deep.committed > 1048576);
        println("");
        print_bool(after.committed == deep.committed);
        println("");
        print_bool(after.retained == after.committed);
        println("");
        print_bool(after.high_water == deep.committed);
        println("")
    produces
        pure 0
    end
}
