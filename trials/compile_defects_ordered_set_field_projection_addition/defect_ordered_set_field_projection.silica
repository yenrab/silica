// Documented open type-checker defect (book-verification 2026-09-19, repro r_set_field). A
// second shape of the defect in compile_defects_ordered_set_field_annotation_addition (see that
// README): instead of destructuring `wbt_set@insert`'s result with a full record annotation,
// this binds the `.set` field directly through a `<expr>.field` projection whose LHS binding is
// typed `OrderedSet[string, mem(normal)]`. Rejected the same way, and here the checker's error
// shows its own placeholder-substitution gap too: the "expected" side it prints still has a bare
// `ItemType` where `string` belongs (`compare_item: (ItemType,ItemType) -> ...`), instead of the
// substituted concrete type.
// Expected: same as the sibling trial -- `Ada` inserts into an empty set, exit 0 (this program
// discards `inserted` and always returns 0; see the sibling trial for the informative form).
//   0
// Observed: E2003 "wbt_set@insert returns {set : {...concrete fields...}, inserted: boolean},
// expected {set: {...record spelled out with ItemType unresolved...}, inserted: boolean}".

use wbt_set;
use OrderedSet;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        s: OrderedSet[string, mem(normal)] <- wbt_set@empty({ compare_item: compare_names });
        r: OrderedSet[string, mem(normal)] <- wbt_set@insert(s, "Ada").set
    produces
        pure 0
    end
}
