// band / bor on uint32 (spec §3.9: bitwise operators on every unsigned width). A uint32 value read
// from a device register is masked and combined without widening. Expected exit status 3.
fn main() -> int64 {
    a: uint32 <- 4294901760;
    b: uint32 <- 65535;
    all: uint32 <- a bor b;
    high: uint32 <- a band 4278190080;
    byte: uint32 <- (a shr 16) band 255;
    c1: int64 <- case all == 4294967295 of { true -> 1; false -> 0 };
    c2: int64 <- case high == 4278190080 of { true -> 1; false -> 0 };
    c3: int64 <- case byte == 255 of { true -> 1; false -> 0 };
    c1 + c2 + c3
}
