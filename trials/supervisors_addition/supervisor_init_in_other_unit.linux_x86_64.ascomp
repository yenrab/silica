    .intel_syntax noprefix
    .text
    // use Supervisor, other_unit_sup
.extern silica_rt_ffi_guarded_enter
.extern silica_rt_ffi_guarded_exit
.extern silica_rt_ffi_guarded_setjmp
.extern silica_rt_ffi_guarded_fault_finish
.extern silica_rt_ffi_arena_bump
.global main


.set SVR_AREA, 80
.set SVR_X11, 8
.set SVR_X12, 16
.set SVR_X16, 24
.set SVR_X19, 32
.set SVR_CS0, 40
.set SVR_CS1, 48
.set SVR_CS2, 56
.set SVR_CS3, 64
.set SVR_CS4, 72
.globl main
main:
    push rbp
    mov rbp, rsp
    sub rsp, SVR_AREA
    mov QWORD PTR [rbp - SVR_CS0], rbx
    mov QWORD PTR [rbp - SVR_CS1], r12
    mov QWORD PTR [rbp - SVR_CS2], r13
    mov QWORD PTR [rbp - SVR_CS3], r14
    mov QWORD PTR [rbp - SVR_CS4], r15
    lea rsp, [rsp + -16]

    call silica_pid_registry_init
    call silica_dangerous_pid_registry_init
    call silica_device_pid_registry_init
    // unsupported term kind (dummy k)?
    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 16]
    // effects []|sir_rec:o676|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    lea r10, [rip + other_unit_sup_registry_name]
    call r10

    mov QWORD PTR [rbp - SVR_X19], rdi
    mov r10, 0

    mov QWORD PTR [rbp - SVR_X11], r10
    mov r10, QWORD PTR [rbp - SVR_X19]

    mov QWORD PTR [rbp - SVR_AREA - 16], r10

    mov r10, 0

    mov r11, 26

    mov rax, r10
    add rax, 15
    mov r10, rax
    mov rax, r10
    and rax, -16
    mov r10, rax
    mov r11, 2
    mov rax, r10
    or rax, r11
    mov r10, rax


    mov QWORD PTR [rbp - SVR_AREA - 8], r10

    lea r11, [rbp - SVR_AREA - 16]

    lea rsp, [rsp + -16]
    mov rax, QWORD PTR [r11]
    mov QWORD PTR [rbp - SVR_X12], rax
    mov rax, QWORD PTR [rbp - SVR_X12]
    mov QWORD PTR [rsp + 8], rax
    lea rcx, [rip + silica_supervisor_start_OtherUnitSup]
    mov rdi, QWORD PTR [rbp - SVR_X11]
    mov rsi, 0
    mov r8, QWORD PTR [r11 + 8]
    mov edx, 0
    call silica_rt_actor_spawn
    mov QWORD PTR [rsp], rdi
    mov rsi, QWORD PTR [rsp + 8]
    call silica_rt_register_actor_named
    mov rdi, QWORD PTR [rsp]
    lea rsp, [rsp + 16]


    mov QWORD PTR [rbp - SVR_X16], 2

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov QWORD PTR [rbp - SVR_X16], 3

    mov rax, QWORD PTR [rbp - SVR_X16]
    lea rsp, [rsp - 16]
    mov QWORD PTR [rsp], rax
    mov rdi, QWORD PTR [rsp + 16]
    mov rsi, QWORD PTR [rsp]
    lea rsp, [rsp + 32]
    // effects []|sir_rec:o848|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    lea r10, [rip + other_unit_sup_send_pair]
    call r10

    call silica_rt_wait_for_exit

    mov rdi, 0





    lea rsp, [rsp + 16]
    mov rax, rdi
    mov rbx, QWORD PTR [rbp - SVR_CS0]
    mov r12, QWORD PTR [rbp - SVR_CS1]
    mov r13, QWORD PTR [rbp - SVR_CS2]
    mov r14, QWORD PTR [rbp - SVR_CS3]
    mov r15, QWORD PTR [rbp - SVR_CS4]
    leave
    ret
L_pa_helper:
    test rdi, rdi
    js L_pa_oob
    cmp rdi, 163
    jge L_pa_oob
    lea r9, [rip + L_pa_table]
    mov r10, rdi
    shl r10, 4
    add r9, r10
    mov rsi, QWORD PTR [r9]
    mov rdx, QWORD PTR [r9 + 8]
    mov edi, 1
    mov eax, 1
    syscall
    xor edi, edi
    ret
L_pa_oob:
    xor edi, edi
    ret

