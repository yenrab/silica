// A Supervisor child whose state is a tuple (int64, int64), in a module that also spawns a plain
// worker (`collector`) with spawn (SD-10, S1). The SIR generator's old "e4a" fallback tagged EVERY
// spawn in a module that implements a supervisor with that supervisor's start trampoline, so the
// plain collector ran S1tupleSup's init with its own state 0 as the supervisor state and faulted
// reading the tuple. Only spawn_registered_supervisor creates a supervisor (spec §15.4.8.1); the
// fallback is gone. Through the supervisor the child reads its state and replies 10 + 20 + 5.
// Expected:
//   35
//   0

impl S1tupleSup for Supervisor;

fn worker(msg: int64, state: (int64, int64)) -> (:reply, int64, (int64, int64)) {
    (a: int64, b: int64) <- state;
    (:reply, a + b + msg, state)
}

fn init(initial_state: (int64, int64)) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: (int64, int64), behavior: fn(msg: int64, state: (int64, int64)) -> (:reply, int64, (int64, int64)), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: (int64, int64), behavior: fn(msg: int64, state: (int64, int64)) -> (:reply, int64, (int64, int64)), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :s1_tuple_worker, agent_type: :worker, initial_state: initial_state, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn collector(msg: int64, state: int64) -> (:reply, int64, int64) { (:reply, state + msg, state + msg) }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        col: actor_ref <- spawn(0, collector, stack_policy(0, :keep_last_message));
        sup: supervisor_ref <- spawn_registered_supervisor(S1tupleSup, (10, 20), :s1_tuple_sup, stack_policy(0, :keep_last_message));
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: :s1_tuple_worker } impl SupervisorMessage {});
        v: int64 <- call(got.child, 5 impl ActorMessage {});
        _: atom <- print_int64(v);
        println("")
    produces pure 0 end
}
