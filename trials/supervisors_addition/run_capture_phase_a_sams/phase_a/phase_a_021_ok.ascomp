    MOV X0, X9
    MOV X1, XZR
    MOV W2, WZR
    BL _silica_rt_actor_spawn
    SUB SP, SP, #16
    STR X0, [SP, #0]
    BL _silica_rt_register_actor
    LDR X0, [SP, #0]
    ADD SP, SP, #16

    MOV X19, X0
    SUB SP, SP, #80
    MOV X9, #23
    STR X9, [SP, #0]
    MOV X9, X19
    MOV X11, X9
    SUB SP, SP, #64
    MOV X9, #24
    STR X9, [SP, #0]
    MOV X9, #24
    STR X9, [SP, #8]
    MOV X9, #0
    STR X9, [SP, #16]
    ADRP X9, child_worker@PAGE
    ADD X9, X9, child_worker@PAGEOFF
    STR X9, [SP, #24]
    MOV X9, #9
    STR X9, [SP, #32]
    MOV X9, #0
    STR X9, [SP, #40]
    STR XZR, [SP, #48]
    MOV X10, SP
    MOV X0, X11
    MOV X1, X10
    BL _silica_rt_supervisor_add_child
