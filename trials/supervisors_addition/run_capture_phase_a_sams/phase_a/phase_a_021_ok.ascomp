.text
    ; use Supervisor
    ; supervisors Phase E (e3b): per-impl start trampolines (calls init + materialize children)
.globl _silica_supervisor_start_PhaseASup
.p2align 2
_silica_supervisor_start_PhaseASup:
    STP X20, X19, [SP, #-32]!
    STP X29, X30, [SP, #16]
    ADD X29, SP, #16
    MOV X19, X0
    LDR X0, [X19]
    BL init
    MOV X1, X0
    MOV X0, X19
    BL _silica_rt_supervisor_materialize_init_children
    LDP X29, X30, [SP, #16]
    LDP X20, X19, [SP], #32
    RET
.global main


