// Helper unit for emitter_defect_cast_registered_double_record_literal.silica: the child
// behaviour. Reconstructed from the book-verification repro r_area_main (prints width * height).

export area_and_print/2;

fn area_and_print(msg: { width: int64, height: int64 }, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        area: int64 <- msg.width * msg.height;
        _: atom <- print_int64(area);
        _: atom <- println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}
