// Helper unit for emitter_defect_cast_registered_double_tuple_literal.silica: the child behaviour.
// Reconstructed from the book-verification repro r_tuple2 (multiplies the pair it is sent).

export multiply_and_print/2;

fn multiply_and_print(msg: (int64, int64), state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        (left: int64, right: int64) <- msg;
        product: int64 <- left * right;
        _: atom <- print_int64(product);
        _: atom <- println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}
