// Documented open defect (book-verification 2026-09-19, repro r_cb; a second form, r_cb2, casts
// the reply through a helper function instead of directly from the behaviour and is flaky:
// correct 1 of 6 runs, garbage 4, nothing 1 -- this trial uses the direct-from-behaviour form,
// which fails the same way every run). Spec §15.4.7.3 and §16.3.5 say a cast's message is copied
// at send time, so the payload must survive independently of the sender's frame. Here `doubler`
// casts a record message back to `asker` directly from its own behaviour body (not from `main`);
// the record's fields do not survive the round trip. Likely the same root cause family as
// supervisors_addition/emitter_defect_cast_registered_double_tuple_literal.silica /
// emitter_defect_cast_registered_double_record_literal.silica (an aggregate-literal cast_registered
// argument is not durably copied at the call site) but a different manifestation: only one cast
// happens per hop here, and the corruption survives even a let-bound literal
// (`request: {...} <- {...}; cast_registered(:doubler, request ...)`), so this is specific to
// casting a record FROM WITHIN A RUNNING ACTOR'S OWN BEHAVIOUR rather than from `main`.
// Expected: 21 arrives at the doubler; it replies with 42.
//   Question sent. Getting on with other things.
//   21 arrived at the doubler
//   The answer came back: 42
//   done
//   0
// Observed (deterministic, every run): both hops' record fields are corrupted -- the doubler
// receives value 0 (not 21), and the reply's `kind` field arrives as neither `:answer` nor any
// of the other explicitly-matched atoms, so `asker`'s case falls to the catch-all arm, printing
// "The answer came back: 9000" (9000 + msg.value, with msg.value also read back as 0).

use Supervisor;

impl BookSupervisor for Supervisor;

fn asker(msg: { kind: atom, reply_to: atom, value: int64 }, state: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- case msg.kind of {
            :start -> ask_doubler(msg.value);
            :answer -> hear_answer(msg.value);
            :request -> hear_answer(1000 + msg.value);
            :asker -> hear_answer(2000 + msg.value);
            :doubler -> hear_answer(3000 + msg.value);
            _: atom -> hear_answer(9000 + msg.value)
        }
    produces
        pure (:no_reply, state)
    end
}

fn ask_doubler(number: int64) -> atom {
    sequence proc[concurrency, device_io]
        request: { kind: atom, reply_to: atom, value: int64 } <- { kind: :request, reply_to: :asker, value: number };
        _: boolean <- cast_registered(:doubler, request impl ActorMessage {});  // send the question, and do not wait
        println("Question sent. Getting on with other things.")
    produces
        pure :ok
    end
}

fn hear_answer(answer: int64) -> atom {
    sequence proc[device_io]
        print_string("The answer came back: ");
        _: atom <- print_int64(answer);
        println("");
        println("done")
    produces
        pure :ok
    end
}

fn doubler(msg: { kind: atom, reply_to: atom, value: int64 }, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        _: atom <- print_int64(msg.value);
        println(" arrived at the doubler");
        _: boolean <- cast_registered(:asker, { kind: :answer, reply_to: :doubler, value: msg.value * 2 } impl ActorMessage {})  // cast the answer back to whoever asked
    produces
        pure (:no_reply, state)
    end
}
fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: { kind: atom, reply_to: atom, value: int64 }, state: int64) -> (:no_reply, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 };
        children: List[
        {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: { kind: atom, reply_to: atom, value: int64 }, state: int64) -> (:no_reply, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            {
                id: :asker,
                agent_type: :worker,
                initial_state: 0,
                behavior: asker,
                restart: :permanent,
                shutdown: 0,
                flavor: :plain
            },
            {
                id: :doubler,
                agent_type: :worker,
                initial_state: 0,
                behavior: doubler,
                restart: :permanent,
                shutdown: 0,
                flavor: :plain
            }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- spawn_registered_supervisor(BookSupervisor, 0, :book_supervisor, stack_policy(0, :keep_last_message));
        start: { kind: atom, reply_to: atom, value: int64 } <- { kind: :start, reply_to: :asker, value: 21 };
        _: boolean <- cast_registered(:asker, start impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
