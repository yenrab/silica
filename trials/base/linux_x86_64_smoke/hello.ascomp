# trials/base/linux_x86_64_smoke/hello.sams -- hand-written, not emitted by any compiler.
#
# The first Linux x86-64 unit in the tree: the assembly text form the linux_x86_64 backend will
# emit (Intel syntax, ELF sections, undecorated symbols, .L local labels, GNU-stack note), small
# enough to prove the assemble, link and run path on a machine with only clang or cc and make.
# `main` writes one line with the write(2) syscall and returns 0 to crt1's _start.
#
# Comments are `#`: GNU as on x86 rejects a trailing `//` after an instruction (clang accepts it),
# and `#` is not an immediate prefix under `.intel_syntax noprefix`. Both assemblers take this file.
#
# Register roles: see compiler/silica-compiler/src_selfhost/emitter/linux_x86_64/regs/README.md.
	.intel_syntax noprefix
	.text
	.globl	main
	.type	main,@function
	.p2align	4
main:
	push	rbp
	mov	rbp, rsp                        # rsp is 16-aligned here: crt1 pushed nothing after the return address
	mov	eax, 1                          # SYS_write
	mov	edi, 1                          # fd 1
	lea	rsi, [rip + .Lhello]            # buf
	mov	edx, OFFSET .Lhello_len         # count
	syscall                                 # clobbers rcx, r11; result in rax (ignored, as the print helpers do)
	xor	eax, eax                        # return 0
	pop	rbp
	ret
	.size	main, .-main

	.section	.rodata,"a",@progbits
.Lhello:
	.ascii	"hello from linux_x86_64\n"
	.set	.Lhello_len, . - .Lhello

	.section	.note.GNU-stack,"",@progbits
