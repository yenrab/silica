// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io] t: (string, int64, atom) <- ("stone", 49, :ok);
        (name: string, k: int64, tag: atom) <- t;
        print_string(name);
        println("");
        print_int64(k);
        println("");
        print_atom(tag);
        println("")
        produces pure :ok end
}
