fn main() -> uint64 {
    a_tuple:((uint8, string), uint64) <- ((1, "hello 😱"), 123456789012345);
    _used_a_tuple:((uint8, string), uint64) <- a_tuple;
    b_tuple:(int16,(float64, string),string) <- ((1, (2.0, "world 😱")), " fdaewq5432k 😱");
    _used_b_tuple:(int16,(float64, string),string) <- b_tuple;
    42
}
