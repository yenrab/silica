// Documented open emitter defect (front end fixed 2026-09-24; formerly
// compile_defects_tagged_optional_type_addition, E1040). An inline sum type with a tagged-tuple alternative,
// `:none | (:some, int64)` (spec §15.4.11.2 writes the failure reason the same way,
// `:normal | ... | (:explicit, atom) | ...`), is now accepted in every type position: the parser takes a tuple
// alternative after `|`, the OR-return-type validator accepts a tagged tuple, and
// type_checker/type_sum_alternatives picks the tuple alternative by its tag for tuple literals, tuple case
// patterns and their SIR lowering. `:none` is the word 0 and a present value is a tuple pointer, so the
// `:none` arm matches. The remaining half is the emitter: a tuple case pattern whose elements are an atom
// literal and a named binding, `(:some, v: int64)`, is emitted as an unconditional `B fail` and `v` is never
// loaded (terms/term_case_patterns@emit_tuple_case_elems_check compares only string-literal elements), the
// same defect as case_addition/emitter_defect_tuple_pattern_atom_element, reproduced on a plain (atom, int64)
// scrutinee with the 2026-09-24 compiler. No .ascomp until the emitter is fixed.
// Expected: 0, 7, exit 0. Observed (2026-09-24): "case_clause", exit 1 at the (:some, 7) value.

fn cell_value(c: :none | (:some, int64)) -> int64 {
    case c of {
        :none -> 0;
        (:some, v: int64) -> v
    }
}

fn present(v: int64) -> :none | (:some, int64) {
    (:some, v)
}

fn absent() -> :none | (:some, int64) {
    :none
}

fn main() -> int64 {
    sequence proc[device_io]
        a: :none | (:some, int64) <- absent();
        b: :none | (:some, int64) <- present(7);
        x: int64 <- cell_value(a);
        y: int64 <- cell_value(b);
        print_int64(x);
        println("");
        print_int64(y);
        println("")
    produces
        pure 0
    end
}
