// Reading a tuple-typed record field back. The record stores the tuple inline; the field read must
// yield the tuple (5, 6), not treat its first element as a tuple pointer.
fn main() -> int64 {
    labelled: { start: (int64, int64) } <- { start: (5, 6) };
    st: (int64, int64) <- labelled.start;
    (a: int64, b: int64) <- st;
    a + b
}
