// A record whose tuple-literal field is built in a callee and returned. The tuple must outlive the
// callee's frame (it is heap-promoted before the pointer is stored), so the caller reads it back intact.
fn make(x: int64) -> { start: (int64, int64, int64), n: int64 } {
    { start: (x, x + 1, x + 2), n: 7 }
}

fn main() -> int64 {
    labelled: { start: (int64, int64, int64), n: int64 } <- make(5);
    st: (int64, int64, int64) <- labelled.start;
    (a: int64, b: int64, c: int64) <- st;
    a + b + c + labelled.n
}
