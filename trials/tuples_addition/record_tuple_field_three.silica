// A three-element tuple literal as a record field value, with a scalar field beside it. The tuple is
// built in its own slab and the field holds its pointer; the record base and the scalar field must not
// be shifted by the tuple's slab (they were: this printed 148, and the single-field form 244).
fn main() -> int64 {
    labelled: { n: int64, start: (int64, int64, int64) } <- { n: 100, start: (5, 6, 7) };
    st: (int64, int64, int64) <- labelled.start;
    (a: int64, b: int64, c: int64) <- st;
    a + b + c + labelled.n
}
