// four arithmetic helpers; sub(6, 5) + mul(10, 7) + div(30, 1) + add(30, 6) = 137
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sub(6, 5) + mul(10, 7) + div(30, 1) + add(30, 6)//137
}
