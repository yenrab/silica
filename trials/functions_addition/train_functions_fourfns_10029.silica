// four arithmetic helpers; div(26, 7) + add(9, 9) + mul(26, 7) + sub(4, 3) = 204
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    div(26, 7) + add(9, 9) + mul(26, 7) + sub(4, 3)//204
}
