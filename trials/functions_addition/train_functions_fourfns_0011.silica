// four arithmetic helpers; add(30, 7) + div(10, 8) + mul(11, 5) + sub(8, 7) = 94
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    add(30, 7) + div(10, 8) + mul(11, 5) + sub(8, 7)//94
}
