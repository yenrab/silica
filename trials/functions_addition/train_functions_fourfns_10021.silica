// four arithmetic helpers; sub(19, 3) + div(27, 4) + add(9, 9) + mul(30, 3) = 130
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sub(19, 3) + div(27, 4) + add(9, 9) + mul(30, 3)//130
}
