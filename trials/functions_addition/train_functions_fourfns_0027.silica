// four arithmetic helpers; mul(23, 7) + div(20, 9) + sub(26, 3) + add(13, 5) = 204
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    mul(23, 7) + div(20, 9) + sub(26, 3) + add(13, 5)//204
}
