// four arithmetic helpers; sub(10, 3) + mul(14, 6) + add(17, 3) + div(14, 7) = 113
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sub(10, 3) + mul(14, 6) + add(17, 3) + div(14, 7)//113
}
