// four arithmetic helpers; mul(18, 2) + sub(5, 3) + add(5, 9) + div(30, 1) = 82
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    mul(18, 2) + sub(5, 3) + add(5, 9) + div(30, 1)//82
}
