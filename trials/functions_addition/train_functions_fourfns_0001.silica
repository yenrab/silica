// four arithmetic helpers; mul(10, 4) + div(26, 6) + add(12, 5) + sub(6, 6) = 61
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    mul(10, 4) + div(26, 6) + add(12, 5) + sub(6, 6)//61
}
