// four arithmetic helpers; sub(10, 7) + add(26, 8) + mul(17, 2) = 71
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sub(10, 7) + add(26, 8) + mul(17, 2)//71
}
