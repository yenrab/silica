// four arithmetic helpers; div(9, 2) + add(24, 5) + mul(19, 4) + sub(10, 3) = 116
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    div(9, 2) + add(24, 5) + mul(19, 4) + sub(10, 3)//116
}
