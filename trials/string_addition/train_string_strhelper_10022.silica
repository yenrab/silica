// string helper shout; prints river!!!

fn shout(s: string, n: int64) -> string {
    case n == 0 of {
        true -> s;
        false -> concatenate(shout(s, n - 1), "!")
    }
}

fn main() -> atom {
    sequence proc[device_io] print_string(shout("river", 3));
        println("")
        produces pure :ok end
}
