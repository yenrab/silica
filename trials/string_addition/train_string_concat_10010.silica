// concat of 4 pieces prints northcherryworldñandú

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "north";
        b: string <- "cherry";
        s: string <- concat(a, b);
        s0: string <- concat(s, "world");
        s1: string <- concat(s0, "ñandú");
        print_string(s1);
        println("")
    produces
        pure :ok
    end
}
