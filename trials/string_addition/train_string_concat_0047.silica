// concat of 4 pieces prints actoralphastonehello

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "actor";
        b: string <- "alpha";
        s: string <- concat(a, b);
        s0: string <- concat(s, "stone");
        s1: string <- concat(s0, "hello");
        print_string(s1);
        println("")
    produces pure :ok end
}
