// concatenate of 4 pieces prints deltaomegahelloüber

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "delta";
        b: string <- "omega";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "hello");
        s1: string <- concatenate(s0, "über");
        print_string(s1);
        println("")
    produces
        pure :ok
    end
}
