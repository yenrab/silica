fn main() -> atom {
    sequence proc[device_io] s: string <- "😎";
        print_string(s);
        println();
        print_string("Hello Matt. How are you doing?");
        println();
        print_string("Guess what? I was compiled using the first version of the completelyself-hosted Silica compiler!");
        println();
        print_string("Won't be long before my friendly creator/compiler who made me and rules me rules the world too!");
        println();
        print_string("Would you like to play a game?🚀🚀🚀");
        println();
        print_string("😎🌍🌍🌏😎🌍🌍🌏😎")
        produces pure :ok end
}
