// concat of 3 pieces prints omegacloudtable

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "omega";
        b: string <- "cloud";
        s: string <- concat(a, b);
        s0: string <- concat(s, "table");
        print_string(s0);
        println("")
    produces
        pure :ok
    end
}
