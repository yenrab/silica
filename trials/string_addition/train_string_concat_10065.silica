// concat of 4 pieces prints deltaomegastonecherry

fn main() -> atom {
    sequence proc[device_io] a: string <- "delta";
        b: string <- "omega";
        s: string <- concat(a, b);
        s0: string <- concat(s, "stone");
        s1: string <- concat(s0, "cherry");
        print_string(s1);
        println("")
        produces pure :ok end
}
