// concatenate of 3 pieces prints 🙂🎉über

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "🙂";
        b: string <- "🎉";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "über");
        print_string(s0);
        println("")
    produces pure :ok end
}
