.text
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    STR X0, [SP, #-16]!
    BL L_length_chars_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X0, X12

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #23
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_length_chars_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    CBZ X19, Lch_z
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lch_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lch_cstr
    LDR X20, [X0, #8]
    LDR X21, [X0, #16]
    MOV X2, #0x40000000
    CMP X21, X2
    B.HS Lch_cstr
    B Lch_count
Lch_cstr:
    MOV X20, X0
    MOV X21, #0
    MOV X1, X0
Lch_lp:
    LDRB W3, [X1], #1
    CBZ W3, Lch_count
    ADD X21, X21, #1
    CMP X21, #0x100000
    B.LT Lch_lp
Lch_count:
    ADD X26, X20, X21
    MOV X25, X20
    MOV X24, #0
Lch_loop:
    CMP X25, X26
    B.GE Lch_done
    LDRB W1, [X25], #1
    AND W2, W1, #0xC0
    CMP W2, #0x80
    B.EQ Lch_loop
    ADD X24, X24, #1
    B Lch_loop
Lch_done:
    MOV X0, X24
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Lch_z:
    MOV X0, #0
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

