// concatenate of 3 pieces prints chairnaïvecafé

fn main() -> atom {
    sequence proc[device_io] a: string <- "chair";
        b: string <- "naïve";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "café");
        print_string(s0);
        println("")
        produces pure :ok end
}
