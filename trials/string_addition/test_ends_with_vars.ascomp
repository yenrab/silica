.text
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


main:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X19, X1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X20, X1
    MOV X0, X19
    STR X0, [SP, #-16]!
    MOV X1, X20
    LDR X0, [SP], #16
    BL L_string_ends_with_helper
    MOV W3, W0
L_case_o135_br_0:
    CMP W3, #1
    B.NE L_case_o135_br_1
    MOV X0, #1
    B L_case_o135_done
L_case_o135_br_1:
    CMP W3, #0
    B.NE L_case_o135_fb
    MOV X0, #0
    B L_case_o135_done
L_case_o135_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o135_done
L_case_o135_done:

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #21
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_string_starts_with_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lsw_false
    CBZ X20, Lsw_false
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lsw_n1_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lsw_n1_cstr
    LDR X21, [X0, #8]
    LDR X22, [X0, #16]
    MOV X2, #0x40000000
    CMP X22, X2
    B.HS Lsw_n1_cstr
    B Lsw_n1_done
Lsw_n1_cstr:
    MOV X21, X0
    MOV X22, #0
    MOV X1, X0
Lsw_n1l:
    LDRB W3, [X1], #1
    CBZ W3, Lsw_n1_done
    ADD X22, X22, #1
    CMP X22, #0x100000
    B.LT Lsw_n1l
Lsw_n1_done:
    MOV X0, X20
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lsw_n2_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lsw_n2_cstr
    LDR X23, [X0, #8]
    LDR X24, [X0, #16]
    MOV X2, #0x40000000
    CMP X24, X2
    B.HS Lsw_n2_cstr
    B Lsw_n2_done
Lsw_n2_cstr:
    MOV X23, X0
    MOV X24, #0
    MOV X1, X0
Lsw_n2l:
    LDRB W3, [X1], #1
    CBZ W3, Lsw_n2_done
    ADD X24, X24, #1
    CMP X24, #0x100000
    B.LT Lsw_n2l
Lsw_n2_done:
    CBZ X24, Lsw_true
    CMP X24, X22
    B.HI Lsw_false
    MOV X25, X21
    MOV X26, X23
    MOV X27, X24
Lsw_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Lsw_false
    SUBS X27, X27, #1
    B.NE Lsw_cloop
Lsw_true:
    MOV W0, #1
    B Lsw_exit
Lsw_false:
    MOV W0, #0
Lsw_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

L_string_ends_with_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lew_false
    CBZ X20, Lew_false
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lew_n1_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lew_n1_cstr
    LDR X21, [X0, #8]
    LDR X22, [X0, #16]
    MOV X2, #0x40000000
    CMP X22, X2
    B.HS Lew_n1_cstr
    B Lew_n1_done
Lew_n1_cstr:
    MOV X21, X0
    MOV X22, #0
    MOV X1, X0
Lew_n1l:
    LDRB W3, [X1], #1
    CBZ W3, Lew_n1_done
    ADD X22, X22, #1
    CMP X22, #0x100000
    B.LT Lew_n1l
Lew_n1_done:
    MOV X0, X20
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lew_n2_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lew_n2_cstr
    LDR X23, [X0, #8]
    LDR X24, [X0, #16]
    MOV X2, #0x40000000
    CMP X24, X2
    B.HS Lew_n2_cstr
    B Lew_n2_done
Lew_n2_cstr:
    MOV X23, X0
    MOV X24, #0
    MOV X1, X0
Lew_n2l:
    LDRB W3, [X1], #1
    CBZ W3, Lew_n2_done
    ADD X24, X24, #1
    CMP X24, #0x100000
    B.LT Lew_n2l
Lew_n2_done:
    CBZ X24, Lew_true
    CMP X24, X22
    B.HI Lew_false
    SUB X25, X22, X24
    ADD X25, X21, X25
    MOV X26, X23
    MOV X27, X24
Lew_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Lew_false
    SUBS X27, X27, #1
    B.NE Lew_cloop
Lew_true:
    MOV W0, #1
    B Lew_exit
Lew_false:
    MOV W0, #0
Lew_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

L_string_contains_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lsc_false
    CBZ X20, Lsc_false
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lsc_n1_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lsc_n1_cstr
    LDR X21, [X0, #8]
    LDR X22, [X0, #16]
    MOV X2, #0x40000000
    CMP X22, X2
    B.HS Lsc_n1_cstr
    B Lsc_n1_done
Lsc_n1_cstr:
    MOV X21, X0
    MOV X22, #0
    MOV X1, X0
Lsc_n1l:
    LDRB W3, [X1], #1
    CBZ W3, Lsc_n1_done
    ADD X22, X22, #1
    CMP X22, #0x100000
    B.LT Lsc_n1l
Lsc_n1_done:
    MOV X0, X20
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lsc_n2_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lsc_n2_cstr
    LDR X23, [X0, #8]
    LDR X24, [X0, #16]
    MOV X2, #0x40000000
    CMP X24, X2
    B.HS Lsc_n2_cstr
    B Lsc_n2_done
Lsc_n2_cstr:
    MOV X23, X0
    MOV X24, #0
    MOV X1, X0
Lsc_n2l:
    LDRB W3, [X1], #1
    CBZ W3, Lsc_n2_done
    ADD X24, X24, #1
    CMP X24, #0x100000
    B.LT Lsc_n2l
Lsc_n2_done:
    CBZ X24, Lsc_true
    CMP X24, X22
    B.HI Lsc_false
    SUB X25, X22, X24
    ADD X25, X25, #1
    MOV X26, X21
Lsc_outer:
    MOV X27, X26
    MOV X28, X23
    MOV X0, X24
Lsc_inner:
    LDRB W1, [X27], #1
    LDRB W2, [X28], #1
    CMP W1, W2
    B.NE Lsc_next
    SUBS X0, X0, #1
    B.NE Lsc_inner
    B Lsc_true
Lsc_next:
    ADD X26, X26, #1
    SUBS X25, X25, #1
    B.NE Lsc_outer
    B Lsc_false
Lsc_true:
    MOV W0, #1
    B Lsc_exit
Lsc_false:
    MOV W0, #0
Lsc_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

