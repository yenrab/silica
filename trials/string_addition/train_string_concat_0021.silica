// concatenate of 3 pieces prints αβγdeltaactor

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "αβγ";
        b: string <- "delta";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "actor");
        print_string(s0);
        println("")
    produces pure :ok end
}
