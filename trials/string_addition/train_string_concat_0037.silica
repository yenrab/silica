// concat of 3 pieces prints 世界ñandútable

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "世界";
        b: string <- "ñandú";
        s: string <- concat(a, b);
        s0: string <- concat(s, "table");
        print_string(s0);
        println("")
    produces
        pure :ok
    end
}
