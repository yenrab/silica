// concatenate of 4 pieces prints cherryalpha日本語naïve

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "cherry";
        b: string <- "alpha";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "日本語");
        s1: string <- concatenate(s0, "naïve");
        print_string(s1);
        println("")
    produces
        pure :ok
    end
}
