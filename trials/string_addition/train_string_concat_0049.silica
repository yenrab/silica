// concatenate of 3 pieces prints gammaworldαβγ

fn main() -> atom {
    sequence proc[device_io] a: string <- "gamma";
        b: string <- "world";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "αβγ");
        print_string(s0);
        println("")
        produces pure :ok end
}
