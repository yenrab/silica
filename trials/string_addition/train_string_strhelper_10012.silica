// string helper shout; prints stone!!!

fn shout(s: string, n: int64) -> string {
    case n == 0 of {
        true -> s;
        false -> concatenate(shout(s, n - 1), "!")
    }
}

fn main() -> atom {
    sequence proc[device_io]
        print_string(shout("stone", 3));
        println("")
    produces pure :ok end
}
