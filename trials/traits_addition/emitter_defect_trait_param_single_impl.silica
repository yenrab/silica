// Documented open code-generation defect (2026-09-18), found while writing algorithms over the graph
// traits (stdlib/data_structures/DirectedGraph.silica, UndirectedGraph.silica, WeightedGraph.silica).
// No .ascomp until it is fixed.
//
// A function whose parameter is typed with a trait (`m: Measure`) is emitted once, and the trait
// call in its body is bound to the implementation selected for one call site. Called with a value of
// a second implementation, the body still runs the first implementation on it (silica-specification
// §3.4.12 binds the callee's body to the SELECTED implementation for each call).
// Expected (by hand): 20 (rectangle 2 x 5 = 10, doubled), 42 (radius 7 * 3 = 21, doubled), exit 0.
// Observed: one call is right and the other wrong — the body runs one implementation for both. In a
// three-unit compile the circle prints 0 (read as a rectangle, width = tag 0, height = pad 0); in this
// directory's compile the rectangle prints a pointer-sized value (read as a circle).
// traits/Measure.silica holds the trait and its two implementations.

use Measure;

fn doubled(m: Measure) -> int64 {
    Measure@size(m) * 2
}

fn main() -> int64 {
    sequence proc[device_io]
        r: { width: int64, height: int64 } <- { width: 2, height: 5 };
        c: { tag: int64, pad: int64, radius: int64 } <- { tag: 0, pad: 0, radius: 7 };
        a: int64 <- doubled(r);
        b: int64 <- doubled(c);
        print_int64(a);
        println("");
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
