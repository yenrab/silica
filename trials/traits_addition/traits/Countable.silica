export trait Countable;
export count/1;
export double_count/1;

required {
    fn count(c: Countable) -> int64;
}

provided {
    fn double_count(c: Countable) -> int64 { Countable@count(c) * 2 }
}

impl fn count(n: int64) -> int64 {
    n
}

impl fn count(r: { items: int64, extra: int64 }) -> int64 {
    r.items + r.extra
}
