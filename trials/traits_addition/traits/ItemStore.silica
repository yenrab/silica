// Generic readers for defect_trait_placeholder_result_dispatch (the trait bodies forward here).

export first_items/1;
export second_items/1;

fn first_items(b: { compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, xs: List[ValueType, mem(normal)] }) -> List[ValueType, mem(normal)] {
    b.xs
}

fn second_items(b: { compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, tag: int64, ys: List[ValueType, mem(normal)] }) -> List[ValueType, mem(normal)] {
    b.ys
}
