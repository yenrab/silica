export trait Announcer;
export announce/1;

required {
    fn announce(n: Announcer) -> atom;
}

impl fn announce(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_string("Announcer: ");
        _: atom <- print_int64(n);
        _: atom <- print_string(" ");
        _: atom <- print_string("ok");
        _: atom <- println("");
        result: atom <- :ok
        produces pure result end
}
