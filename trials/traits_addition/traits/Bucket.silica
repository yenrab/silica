// Trait for provided_method_branch_per_impl: a PROVIDED method whose body branches, inherited by two
// implementations with different record layouts (silica-specification §3.4.8).
// classify: 3 when 100 < weight < 1000, 2 when 10 < weight <= 100 or weight >= 1000, 0 when weight <= 0,
// 1 otherwise (1..10). The outer case guards on the bound weight, the inner cases short-circuit.

export trait Bucket;
export weight/1;
export classify/1;

required {
    fn weight(b: Bucket) -> int64;
}

provided {
    fn classify(b: Bucket) -> int64 {
        w: int64 <- Bucket@weight(b);
        case w of {
            n: int64 if n > 10 -> case n > 100 and n < 1000 of {
                true -> 3;
                false -> 2
            };
            n: int64 -> case n == 0 or n < 0 of {
                true -> 0;
                false -> 1
            }
        }
    }
}

impl fn weight(r: { count: int64, each: int64 }) -> int64 {
    r.count * r.each
}

impl fn weight(c: { tag: int64, pad: int64, grams: int64 }) -> int64 {
    c.grams
}
