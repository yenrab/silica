// Trait for emitter_defect_trait_param_single_impl: two implementations with different record layouts.

export trait Measure;
export size/1;

required {
    fn size(m: Measure) -> int64;
}

impl fn size(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

impl fn size(c: { tag: int64, pad: int64, radius: int64 }) -> int64 {
    c.radius * 3
}
