// Trait for defect_trait_nested_placeholder: the required result nests the ValueType placeholder
// inside List[...]; the implementation's result nests a record there.

use NestedStore;

export trait NestedBox;
export items/1;

required {
    fn items(b: NestedBox) -> List[ValueType, mem(normal)];
}

impl fn items(
    b: {
        compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater,
        entries: List[{ to: KeyType, data: ValueType }, mem(normal)]
    }
) -> List[{ to: KeyType, data: ValueType }, mem(normal)] {
    NestedStore@entries(b)
}
