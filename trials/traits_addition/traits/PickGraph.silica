// Trait for emitter_defect_bracket_receiver_impl_order: two implementations whose records both carry
// the compare_node / compare_edge_data witnesses of an UndirectedGraph[...] bracket type; the
// stub's own record is declared first, the other record's last.

use StubGraphUndirected;

export trait PickGraph;
export count/1;

required {
    fn count(g: PickGraph) -> int64;
}

impl fn count(g: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, count: int64 }) -> int64 {
    StubGraphUndirected@count_of(g)
}

impl fn count(g: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, tag: int64, pad: int64, count: int64 }) -> int64 {
    StubGraphUndirected@extra_count_of(g)
}
