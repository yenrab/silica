// Trait for defect_trait_placeholder_return: a required method whose result mentions ValueType.

use BagStore;

export trait ItemBag;
export items/1;

required {
    fn items(b: ItemBag) -> List[ValueType, mem(normal)];
}

impl fn items(b: { compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, entries: List[ValueType, mem(normal)] }) -> List[ValueType, mem(normal)] {
    BagStore@entries(b)
}
