// Construction-module stub for emitter_defect_bracket_receiver_impl_order: StubGraphUndirected is a
// module name the type checker registers for UndirectedGraph[N, E, mem(S)] bracket bindings.

export empty/1;
export count_of/1;
export extra_count_of/1;

fn empty(
    functions: {
        compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater,
        compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater
    }
) -> {
    compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater,
    compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater,
    count: int64
} {
    { compare_node: functions.compare_node, compare_edge_data: functions.compare_edge_data, count: 5 }
}

fn count_of(g: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, count: int64 }) -> int64 {
    g.count
}

fn extra_count_of(g: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, tag: int64, pad: int64, count: int64 }) -> int64 {
    100 + g.count
}
