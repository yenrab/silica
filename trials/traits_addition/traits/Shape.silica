export trait Shape;
export area/1;
export double_area/1;

required {
    fn area(s: Shape) -> int32;
}

provided {
    fn double_area(s: Shape) -> int32 { Shape@area(s) * 2 }
}

impl fn area(side: int32) -> int32 {
    side * side
}

impl fn area(r: { width: int32, length: int32 }) -> int32 {
    r.width * r.length
}
