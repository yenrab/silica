// Documented open trait-dispatch defect (2026-09-18), found while writing the UndirectedGraph trait
// over graph_wbt_undirected and graph_weighted_undirected. No .ascomp until it is fixed.
//
// A value bound with a collection bracket type (`g: UndirectedGraph[int64, int64, mem(normal)] <-
// StubGraphUndirected@empty({...})`) fits every trait implementation whose record carries the
// bracket's witnesses. The checker then picks an implementation by declaration order instead of by
// the value's constructor: here the other record's implementation is declared last in
// traits/PickGraph.silica and the call runs it on the stub's record. Which one is picked also differs
// between a whole-directory compile and a one-unit compile of the same source (the graph traits list
// their bracket-constructible representation last for that reason).
// Expected (by hand): 5 (the stub record's count), exit 0.
// Observed: a pointer-sized garbage value (the other implementation's layout read over the stub).

use StubGraphUndirected;
use PickGraph;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        g: UndirectedGraph[int64, int64, mem(normal)] <- StubGraphUndirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_i64 });
        n: int64 <- PickGraph@count(g);
        print_int64(n);
        println("")
    produces
        pure 0
    end
}
