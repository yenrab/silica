use Sizeable;
use Scalable;
use Doubling;
use Labeled;
use TwiceRaw;

fn main() -> atom {
    sequence proc[device_io]
        v0: int64 <- Sizeable@size(11);
        _: atom <- print_int64(v0);
        _: atom <- println("");
        v1: int64 <- Scalable@scale(7);
        _: atom <- print_int64(v1);
        _: atom <- println("");
        v2: int64 <- Doubling@double(3);
        _: atom <- print_int64(v2);
        _: atom <- println("");
        v3: int64 <- Labeled@code_of(41);
        _: atom <- print_int64(v3);
        _: atom <- println("");
        v4: int64 <- TwiceRaw@total(5);
        _: atom <- print_int64(v4);
        _: atom <- println("");
        result: atom <- :ok
        produces pure result end
}
