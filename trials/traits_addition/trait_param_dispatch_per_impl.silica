// silica-specification §3.4.12: a function whose parameter is typed with a trait (`m: Measure`)
// binds its body to the implementation SELECTED at each call. Silica has no runtime vtables, so the
// function is copied once per implementation of that trait (trait_specialization, as for a provided
// method) and each call site picks its copy by the argument's type.
// traits/Measure.silica holds the trait and its two implementations.
// Expected: 20 (rectangle 2 x 5 = 10, doubled), 42 (radius 7 * 3 = 21, doubled), exit 0.

use Measure;

fn doubled(m: Measure) -> int64 {
    Measure@size(m) * 2
}

fn main() -> int64 {
    sequence proc[device_io]
        r: { width: int64, height: int64 } <- { width: 2, height: 5 };
        c: { tag: int64, pad: int64, radius: int64 } <- { tag: 0, pad: 0, radius: 7 };
        a: int64 <- doubled(r);
        b: int64 <- doubled(c);
        print_int64(a);
        println("");
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
