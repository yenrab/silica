// expected failure E1047: named struct declaration 'Node' is not allowed
// case on string literals; "other" gives 78
struct Node { x: int64, y: int64 }

fn main() -> int64 {
    mode: string <- "other";
    case mode of {
        "south" -> 7;
        "silica" -> 85;
        "north" -> 36;
        _: string -> 78
    }
}
