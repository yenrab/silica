// expected failure E2005: call to unknown function 'printlz'
// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16(56 - 51);
        printlz("");
        result: atom <- print_uint16(15 / 16 * (50 + 59))
    produces pure result end
}
