// expected failure E4016: no main/0: entry function renamed to 'main_program'
// parameters of three different types; describe(47, "south", true) = 52
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main_program() -> int64 {
    describe(47, "south", true)
}
