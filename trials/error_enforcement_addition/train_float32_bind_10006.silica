// expected failure E2003: integer binding mixed into float arithmetic
// float32 bindings 25.5 + 2.0 printed as 27.5
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 25.5;
        b: int64 <- 2;
        result: atom <- print_float32(a + b)
    produces
        pure result
    end
}
