// expected failure E2003: shift returns float32 but its result feeds print_float64
// float64 helper shift; prints -6.125
fn shift(x: float64) -> float32 {
    x - 36.5 + 0.25
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(shift(30.125))
    produces pure result end
}
