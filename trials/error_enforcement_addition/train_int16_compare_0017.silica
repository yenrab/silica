// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 4 * 1 == (34 + 38));
        println("");
        _: atom <- print_bool(45 >= 57 % 47);
        println("");
        result: atom <- print_bool((55 - 19) < (9 + 31))
        produces pure result end
}
