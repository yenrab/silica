// expected failure E2002: undefined accumulator name in the recursive call
// fibonacci; fib_iter(7, 0, 1) = 13
fn fib_iter(n: int64, a: int64, b: int64) -> int64 {
    case n <= 0 of {
        true -> a;
        false -> fib_iter(n - 1, b, a + c)
    }
}

fn main() -> int64 {
    fib_iter(7, 0, 1)
}
