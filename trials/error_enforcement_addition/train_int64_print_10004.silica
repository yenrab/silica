// expected failure E1041: trailing ';' after the pure expression
// print_int64 two; prints 696 then 48
fn main() -> atom {
    sequence proc[device_io]
        a: int64 <- 12 * 58;
        b: int64 <- 38 + 10;
        _: atom <- print_int64(a);
        println("");
        result: atom <- print_int64(b)
    produces pure result; end
}
