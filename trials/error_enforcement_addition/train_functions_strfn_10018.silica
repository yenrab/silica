// expected failure E4015: function 'greet' defined twice
// string helper greet prints hi north

fn greet(name: string) -> string {
    concatenate("hi ", name)
}

fn greet(name: string) -> string {
    concatenate("hi ", name)
}

fn main() -> atom {
    sequence proc[device_io]
        print_string(greet("north"));
        println("")
    produces pure :ok end
}
