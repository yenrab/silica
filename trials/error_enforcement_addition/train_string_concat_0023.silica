// expected failure E2001: integer literal passed to concatenate
// concatenate of 2 pieces prints cherrystone

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "cherry";
        b: string <- 5;
        s: string <- concatenate(a, b);
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
