// expected failure E3009: proc[...] written on the function return type instead of the sequence
// uint64 comparisons printed with print_bool
fn main() -> atom proc[device_io] {
    sequence proc[device_io]
        _: atom <- print_bool(25 == 45 * 26);
        println("");
        _: atom <- print_bool((48 + 9) != (39 - 21));
        println("");
        _: atom <- print_bool((14 / 39) < 56 % 36);
        println("");
        result: atom <- print_bool((13 + 7) > 47)
    produces
        pure result
    end
}
