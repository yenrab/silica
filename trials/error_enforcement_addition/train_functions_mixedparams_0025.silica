// expected failure E2005: call to unknown function 'describex'
// parameters of three different types; describe(53, "apple", false) = 53
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describex(53, "apple", false)
}
