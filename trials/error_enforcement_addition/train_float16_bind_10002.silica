// expected failure E2003: integer binding mixed into float arithmetic
// float16 bindings 0.5 + 28.0 printed as 28.5
fn main() -> atom {
    sequence proc[device_io]
        a: float16 <- 0.5;
        b: int64 <- 28;
        result: atom <- print_float16(a + b)
    produces
        pure result
    end
}
