// expected failure E1055: binding 'scratch' is never used
// uint32 bindings then expression; expect 64
fn main() -> uint32 {
    scratch: int64 <- 41;
    count: uint32 <- 47;
    k: uint32 <- (50 % count) / (count + 15);
    total: uint32 <- 15;
    d: uint32 <- (count / 51);
    count + 15 + 44 / total + k - k + d - d
}
