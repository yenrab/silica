// expected failure E2005: wrong argument count in call to 'mul'
// four arithmetic helpers; add(18, 7) + mul(7, 9) = 88
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    add(18, 7) + mul(7)//88
}
