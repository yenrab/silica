// expected failure E2018: binding 'n' has no type annotation
// Positive: list allocation requires sequence proc[mem(normal_writeback)] (spec §9.3.1)
fn main() -> int64 {
    sequence proc[mem(normal_writeback)]
        xs: List[int64, mem(normal_writeback)] <- [32, 29, 30, 34];
        n <- length[int64, mem(normal_writeback)](xs)
    produces
        pure n
    end
}
