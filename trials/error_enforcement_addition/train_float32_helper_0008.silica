// expected failure E2003: scale returns float16 but its result feeds print_float32
// float32 helper scale; prints 51.0
fn scale(x: float32) -> float16 {
    x + 31.375 + 0.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(scale(19.125))
    produces pure result end
}
