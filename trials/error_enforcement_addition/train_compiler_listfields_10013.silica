// expected failure E1049: sequence block without produces
// list field accessors is_nil/head; want 12
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [12, 2, 44, 4];
        r: int64 <- case xs.is_nil of {
            true -> 0;
            false -> xs.head
        }
    pure r
    end
}
