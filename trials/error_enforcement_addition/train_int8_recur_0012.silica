// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on int8; tri_acc(10, 0) = 55
fn tri_acc(n: int8, acc: int8) -> int8 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> int8 {
    tri_acc(10, 0)
}
