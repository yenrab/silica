// expected failure E1047: named struct declaration 'Point' is not allowed
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: two lifetimes and two regions; expect 80
struct Point { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        L2: lifetime <- fresh_lifetime();
        r1: region(L1, normal) <- alloc_region(normal);
        r2: region(L2, normal) <- alloc_region(normal);
        c1: ref(L1, normal, int64) <- alloc_ref(r1, 1);
        c2: ref(L2, normal, int64) <- alloc_ref(r2, 79);
        v1: int64 <- read_ref(c1);
        v2: int64 <- read_ref(c2)
    produces
        pure v1 + v2
    end
}
