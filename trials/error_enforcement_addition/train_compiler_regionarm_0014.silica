// expected failure E1060: unbalanced braces
// region handle passed to a helper that allocates inside a case arm; want 63
fn pick(r: region(L1, normal), n: int64) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- case n > 0 of {
            true -> {
                cell: ref(L1, normal, int64) <- alloc_ref(r, n);
                read_ref(cell)
            };
            false -> 0
        }
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        v: int64 <- pick(r, 63)
    produces
        pure v
    end
}}
