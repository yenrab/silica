// expected failure E4016: no main/0: entry function renamed to 'start'
// float32 bindings 3.5 - 37.375 printed as -33.875
fn start() -> atom {
    sequence proc[device_io]
        a: float32 <- 3.5;
        b: float32 <- 37.375;
        result: atom <- print_float32(a - b)
    produces
        pure result
    end
}
