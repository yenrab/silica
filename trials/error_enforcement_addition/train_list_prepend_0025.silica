// expected failure E2001: string element prepended to an integer list
// 1 prepends after empty; length is 1
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)]("6", xs0);
        n: int64 <- length[int32, mem(normal)](xs1)
    produces pure n end
}
