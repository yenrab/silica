// expected failure E1055: binding 'leftover' is never used
// print_uint16 two; prints 3120 then 12
fn main() -> atom {
    leftover: int64 <- 41;
    sequence proc[device_io]
        a: uint16 <- 60 * 52;
        b: uint16 <- 12;
        _: atom <- print_uint16(a);
        println("");
        result: atom <- print_uint16(b)
    produces pure result end
}
