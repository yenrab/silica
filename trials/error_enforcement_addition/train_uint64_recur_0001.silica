// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on uint64; digit_count(14) = 2
fn digit_count(n: uint64) -> uint64 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> uint64 {
    digit_count(14)
}
