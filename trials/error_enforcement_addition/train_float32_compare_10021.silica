// expected failure E1055: binding 'scratch' is never used
// float32 comparisons
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_bool(38.375 * 14.5 != (12.0 + 10.0));
        println("");
        done: atom <- print_bool(13.375 > 23.75)
    produces
        pure done
    end
}
