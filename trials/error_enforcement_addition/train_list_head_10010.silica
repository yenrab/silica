// expected failure E1050: produces clause without pure
// remove_head on [31, 27, 24] gives 2
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [31, 27, 24];
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
        n: int64 <- length[int64, mem(normal)](rest)
        produces n end
}
