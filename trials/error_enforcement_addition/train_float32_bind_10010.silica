// expected failure E1055: binding 'temp_val' is never used
// float32 bindings 40.5 * 2.25 printed as 91.125
fn main() -> atom {
    temp_val: int64 <- 41;
    sequence proc[device_io]
        a: float32 <- 40.5;
        b: float32 <- 2.25;
        result: atom <- print_float32(a * b)
    produces
        pure result
    end
}
