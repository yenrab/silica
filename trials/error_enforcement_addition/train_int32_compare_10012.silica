// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (60 - 1) <= 13);
        println("");
        _: atom <- print_bool(31 == (25 + 33));
        println("");
        result: atom <- print_bool(47 <= (29 + 38))
    produces
        pure result
    end
}
