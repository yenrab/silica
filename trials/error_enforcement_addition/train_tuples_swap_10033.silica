// expected failure E4015: function 'swap' defined twice
// swap((41, 13)); second = 41
fn swap(p: (int64, int64)) -> (int64, int64) {
    (x: int64, y: int64) <- p;
    (y, x)
}

fn swap(p: (int64, int64)) -> (int64, int64) {
    (x: int64, y: int64) <- p;
    (y, x)
}

fn main() -> int64 {
    (first: int64, second: int64) <- swap((41, 13));
    second
}
