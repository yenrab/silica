// expected failure E2001: string literal in one case arm of an integer case
// case on int64 value 23; expect 165
fn main() -> int64 {
    v: int64 <- 23;
    case v of {
        31 -> "63";
        24 -> 15;
        1 -> 69;
        10 -> 38;
        n: int64 if n > 15 -> 165;
        _: int64 -> 125
    }
}
