// expected failure E2003: shift returns float32 but its result feeds print_float16
// float16 helper shift; prints -7.5
fn shift(x: float16) -> float32 {
    x - 9.25 + 1.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(shift(0.75))
    produces
        pure result
    end
}
