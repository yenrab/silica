// expected failure E1055: binding 'spare' is never used
// nested boolean cases; (true, true) selects 19
fn main() -> int64 {
    spare: int64 <- 41;
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 19;
            false -> 3
        };
        false -> case b of {
            true -> 0;
            false -> 0
        }
    }
}
