// expected failure E2005: call to unknown function 'print_uint16x'
// print_uint16 two; prints 32 then 51
fn main() -> atom {
    sequence proc[device_io] a: uint16 <- 21 + 11;
        b: uint16 <- 51 % 57;
        _: atom <- print_uint16x(a);
        println("");
        result: atom <- print_uint16(b)
        produces pure result end
}
