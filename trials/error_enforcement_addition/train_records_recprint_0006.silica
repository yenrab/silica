// expected failure E4016: no main/0: entry function renamed to 'entry'
// print each field of a mixed record
fn entry() -> atom {
    sequence proc[device_io]
        person: { name: string, age: int64, active: boolean } <- { name: "river", age: 69, active: false };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
    produces pure :ok end
}
