// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 33 gives 16
fn main() -> int64 {
    n: int64 <- 33;
    case n of {
        n: int64 if n -> n - 1;
        n: int64 if n >= 5 and n < 113 -> n / 2;
        n: int64 if n >= 113 -> n + 100
    }
}
