// expected failure E1043: whitespace between binding name 'a' and ':'
// nested boolean cases; (false, true) selects 43
fn main() -> int64 {
    a :boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 47;
            false -> 94
        };
        false -> case b of {
            true -> 43;
            false -> 37
        }
    }
}
