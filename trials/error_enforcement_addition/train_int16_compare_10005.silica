// expected failure E2018: binding 'result' has no type annotation
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((12 * 17) < (44 + 56));
        println("");
        _: atom <- print_bool((30 + 3) == 36);
        println("");
        result <- print_bool((20 + 30) >= (39 % 4))
    produces pure result end
}
