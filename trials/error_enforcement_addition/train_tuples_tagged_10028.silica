// expected failure E1055: binding 'scratch' is never used
// tagged tuple (atom, int64) from safe_div(26, 9); expect 2
fn safe_div(x: int64, y: int64) -> (atom, int64) {
    scratch: int64 <- 41;
    case y == 0 of {
        true -> (:error, 0);
        false -> (:ok, x / y)
    }
}

fn main() -> int64 {
    r: (atom, int64) <- safe_div(26, 9);
    (tag: atom, v: int64) <- r;
    case tag of {
        :ok -> v;
        _: atom -> 200
    }
}
