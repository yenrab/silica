// expected failure E2005: call to unknown function 'print_uint64x'
// print_uint64 two; prints 30 then 4
fn main() -> atom {
    sequence proc[device_io]
        a: uint64 <- 30 % 35;
        b: uint64 <- 11 % 7;
        _: atom <- print_uint64x(a);
        println("");
        result: atom <- print_uint64(b)
    produces
        pure result
    end
}
