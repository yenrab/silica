// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 60 / 60 < 10 * 42);
        println("");
        _: atom <- print_bool((52 + 25) != 55 / 25);
        println("");
        _: atom <- print_bool(40 == (46 + 43));
        println("");
        _: atom <- print_bool((16 + 1) < (2 + 48));
        println("");
        result: atom <- print_bool(47 != 9 / 15)
    produces
        pure result
    end
}
