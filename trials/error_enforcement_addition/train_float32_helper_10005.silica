// expected failure E2003: shift returns float64 but its result feeds print_float32
// float32 helper shift; prints 3.5
fn shift(x: float32) -> float64 {
    x - 20.0 + 5.0
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float32(shift(18.5))
        produces pure result end
}
