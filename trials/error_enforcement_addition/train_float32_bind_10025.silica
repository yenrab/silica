// expected failure E2003: integer binding mixed into float arithmetic
// float32 bindings 29.0 + 30.0 printed as 59.0
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 29.0;
        b: int64 <- 30;
        result: atom <- print_float32(a + b)
    produces
        pure result
    end
}
