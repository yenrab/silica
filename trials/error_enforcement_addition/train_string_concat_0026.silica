// expected failure E2003: string binding used where an integer is expected
// concatenate of 3 pieces prints cherrycaféalpha

fn main() -> atom {
    sequence proc[device_io] a: string <- "cherry";
        b: string <- "café";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "alpha");
        print_int64(s0);
        println("")
        produces pure :ok end
}
