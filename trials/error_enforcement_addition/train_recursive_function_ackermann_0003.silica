// expected failure E1045: function 'ack_nonzero' declared without the fn keyword
// Ackermann A(2, 3) = 9
ack_nonzero(m: int64, n: int64) -> int64 {
    case n == 0 of {
        true -> ack(m - 1, 1);
        false -> ack(m - 1, ack(m, n - 1))
    }
}

fn ack(m: int64, n: int64) -> int64 {
    case m == 0 of {
        true -> n + 1;
        false -> ack_nonzero(m, n)
    }
}

fn main() -> int64 {
    ack(2, 3)
}
