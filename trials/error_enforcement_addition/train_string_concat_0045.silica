// expected failure E2001: integer literal passed to concatenate
// concatenate of 3 pieces prints 世界betasilica

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "世界";
        b: string <- "beta";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, 6);
        print_string(s0);
        println("")
    produces pure :ok end
}
