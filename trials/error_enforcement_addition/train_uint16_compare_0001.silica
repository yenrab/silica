// expected failure E1060: unbalanced braces
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(12 * 15 != 48);
        println("");
        _: atom <- print_bool(1 % 34 < (31 + 30));
        println("");
        _: atom <- print_bool(10 % 12 == 22 * 18);
        println("");
        _: atom <- print_bool((49 + 42) > 25);
        println("");
        result: atom <- print_bool((25 / 22) == (53 + 15))
    produces
        pure result
    end
