// Enforce E3002 with concrete location:
// spawn_registered is inside a sequence block, but concurrency is not declared.

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[device_io]
        ref: actor_ref <- spawn_registered(0, worker, :reg_worker)
    produces
        pure 0
    end
}
