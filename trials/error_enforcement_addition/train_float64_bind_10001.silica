// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// float64 bindings 3.0 - 16.25 printed as -13.25
fn main() -> atom {
    sequence proc[device_io, mem(normal)] a: float64 <- 3.0;
        b: float64 <- 16.25;
        result: atom <- print_float64(a - b)
        produces pure result end
}
