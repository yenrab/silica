// expected failure E1055: binding 'spare' is never used
// comments must stop at the newline; want 3
// whole-line comment before the function
fn main() -> int64 {
    spare: int64 <- 41;
    a: int64 <- 4; // end-of-line after a binding
    // whole-line comment between statements
    b: int64 <- 4; // another
    a / b + 2 // end-of-line after the return expression
}
