// expected failure E1042: function 'main' has no return type
// chained print_uint64 calls separated by println
fn main() {
    sequence proc[device_io]
        _: atom <- print_uint64(60);
        println("");
        _: atom <- print_uint64(13 * 11 / (40 % 29));
        println("");
        result: atom <- print_uint64(23 * 3)
    produces pure result end
}
