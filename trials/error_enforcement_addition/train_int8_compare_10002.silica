// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 40 % 1 < (50 + 15));
        println("");
        result: atom <- print_bool(2 / 53 != 39 / 40)
    produces
        pure result
    end
}
