// expected failure E2003: prepend called with its arguments swapped
// 5 prepends after empty; length is 5
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](xs0, 9);
        xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](5, xs1);
        xs3: List[int32, mem(normal)] <- prepend[int32, mem(normal)](26, xs2);
        xs4: List[int32, mem(normal)] <- prepend[int32, mem(normal)](21, xs3);
        xs5: List[int32, mem(normal)] <- prepend[int32, mem(normal)](8, xs4);
        n: int64 <- length[int32, mem(normal)](xs5)
    produces pure n end
}
