// expected failure E2005: call to unknown function 'print_int8_all'
// print_int8 two; prints 87 then 13
fn main() -> atom {
    sequence proc[device_io] a: int8 <- 38 + 49;
        b: int8 <- 13;
        _: atom <- print_int8(a);
        println("");
        result: atom <- print_int8_all(b)
        produces pure result end
}
