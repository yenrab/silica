// expected failure E1055: binding 'spare' is never used
// record pattern matching (axis); expect 3
fn classify(p: { x: int64, y: int64 }) -> int64 {
    spare: int64 <- 41;
    case p of {
        { x: 0, y: 0 } -> 0;
        { x: 0, y: _ } -> 1;
        { x: _, y: 0 } -> 2;
        _ -> 3
    }
}

fn main() -> int64 {
    p: { x: int64, y: int64 } <- { x: 4, y: 6 };
    classify(p)
}
