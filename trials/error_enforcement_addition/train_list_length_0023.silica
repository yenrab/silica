// expected failure E2001: string element inside an integer list literal
// list literal of 2 uint8 elements; length is 2
fn main() -> int64 {
    sequence proc[mem(normal_writethrough)]
        xs: List[uint8, mem(normal_writethrough)] <- ["31", 4];
        n: int64 <- length[uint8, mem(normal_writethrough)](xs)
    produces
        pure n
    end
}
