// expected failure E2003: binding step declared uint16 but used as uint32
// uint32 bindings then expression; expect 5
fn main() -> uint32 {
    step: uint16 <- 44 + 19 * 18;
    total: uint32 <- step % step + 53;
    width: uint32 <- step;
    count: uint32 <- (16 * 16 + step);
    ((count % 7) % 34) + total - total + width - width
}
