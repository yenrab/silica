// defect A2 (stays red until closure environments exist; E1067 rejects it today): a closure returned from make_adder must keep its captured k; add_k(5) = 15
fn make_adder(k: int64) -> fn(int64) -> int64 {
    fn(x: int64) -> int64 { x + k }
}

fn main() -> int64 {
    add_k: fn(int64) -> int64 <- make_adder(10);
    add_k(5)
}
