// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (32 - 13) > (44 - 26));
        println("");
        _: atom <- print_bool(7 / 49 == 22);
        println("");
        result: atom <- print_bool((11 + 16) != 50 % 28)
    produces
        pure result
    end
}
