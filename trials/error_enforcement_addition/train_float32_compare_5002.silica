// expected failure E1060: unbalanced braces
// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((12.375 - 1.0) >= (30.125 + 29.125));
        println("");
        _: atom <- print_bool(25.25 * 14.0 == 26.5 * 0.0);
        println("");
        _: atom <- print_bool(32.0 <= (36.0 + 6.5));
        println("");
        done: atom <- print_bool(25.375 * 3.25 != 32.75)
    produces
        pure done
    end
