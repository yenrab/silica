// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[mem(normal)] t: (int64, string, boolean) <- (4, "hello", true);
        (k: int64, name: string, flag: boolean) <- t;
        print_int64(k);
        println("");
        print_string(name);
        println("");
        print_bool(flag);
        println("")
        produces pure :ok end
}
