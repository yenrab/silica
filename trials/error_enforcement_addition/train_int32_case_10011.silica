// expected failure E2005: string literal pattern against an integer scrutinee
// case on int32 value 15; expect 99
fn main() -> int32 {
    v: int32 <- 15;
    case v of {
        true -> 123;
        9 -> 29;
        33 -> 126;
        12 -> 56;
        n: int32 if n > 36 -> 115;
        _: int32 -> 99
    }
}
