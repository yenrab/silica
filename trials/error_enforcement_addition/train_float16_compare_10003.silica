// expected failure E2018: binding 'done' has no type annotation
// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((20.75 + 10.5) == (27.5 - 1.25));
        println("");
        _: atom <- print_bool((40.25 - 16.5) >= 9.5);
        println("");
        _: atom <- print_bool((25.25 - 28.0) >= 7.5);
        println("");
        done <- print_bool((14.0 + 4.0) != (9.25 + 11.5))
    produces
        pure done
    end
}
