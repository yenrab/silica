// expected failure E3010: mix given nine parameters
// helper mix/3 on uint16; mix(10, 17, 3) = 0
fn mix9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn mix(x: uint16, y: uint16, z: uint16) -> uint16 {
    z % 42 / (x + y)
}

fn main() -> uint16 {
    mix(10, 17, 3)
}
