// expected failure E2018: binding 'r0' has no type annotation
// Spec §16.1.1: call(actor_ref, message) -> Reply; behavior returns (:reply, reply, new_state)
fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(5, acc);
        r0 <- call(w, 7 impl ActorMessage {});
        print_int64(r0);
        println("");
        r1: int64 <- call(w, 1 impl ActorMessage {});
        print_int64(r1);
        println("")
    produces
        pure :ok
    end
}
