// expected failure E2018: binding 'b' has no type annotation
// nested boolean cases; (true, true) selects 54
fn main() -> int64 {
    a: boolean <- true;
    b <- true;
    case a of {
        true -> case b of {
            true -> 54;
            false -> 7
        };
        false -> case b of {
            true -> 68;
            false -> 40
        }
    }
}
