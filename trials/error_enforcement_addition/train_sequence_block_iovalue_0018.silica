// expected failure E1055: binding 'spare' is never used
// sequence prints and returns the same sum 36
fn main() -> int64 {
    spare: int64 <- 41;
    sequence proc[device_io]
        a: int64 <- 12;
        b: int64 <- 24;
        print_int64(a + b);
        println("");
        total: int64 <- a + b
    produces
        pure total
    end
}
