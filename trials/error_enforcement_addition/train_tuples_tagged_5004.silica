// expected failure E2001: string literal in the int64 slot of the tuple
// tagged tuple (atom, int64) from safe_div(23, 9); expect 2
fn safe_div(x: int64, y: int64) -> (atom, int64) {
    case y == 0 of {
        true -> (:error, "0");
        false -> (:ok, x / y)
    }
}

fn main() -> int64 {
    r: (atom, int64) <- safe_div(23, 9);
    (tag: atom, v: int64) <- r;
    case tag of {
        :ok -> v;
        _: atom -> 200
    }
}
