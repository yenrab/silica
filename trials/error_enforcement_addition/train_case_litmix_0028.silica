// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 7 gives 25
fn main() -> int32 {
    v: int32 <- 7;
    case v of {
        :9 -> 32;
        5 -> 10;
        7 -> 25;
        m: int32 if m > 14 -> 48;
        _: int32 -> 41
    }
}
