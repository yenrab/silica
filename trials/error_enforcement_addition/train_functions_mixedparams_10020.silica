// expected failure E1055: binding 'unused_value' is never used
// parameters of three different types; describe(36, "apple", false) = 36
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    unused_value: int64 <- 41;
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(36, "apple", false)
}
