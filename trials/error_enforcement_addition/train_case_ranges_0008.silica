// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 112 gives 224
fn main() -> int64 {
    n: int64 <- 112;
    case n of {
        n: int64 if n < 74 -> "n / 2";
        n: int64 if n >= 74 and n < 112 -> n / 2;
        n: int64 if n >= 112 -> n * 2
    }
}
