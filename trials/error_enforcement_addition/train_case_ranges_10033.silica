// expected failure E1041: trailing ';' after the block's final expression
// guards partition int64 into three ranges; n = 90 gives 45
fn main() -> int64 {
    n: int64 <- 90;
    case n of {
        n: int64 if n < 41 -> n * 2;
        n: int64 if n >= 41 and n < 43 -> n - 1;
        n: int64 if n >= 43 -> n / 2
    };
}
