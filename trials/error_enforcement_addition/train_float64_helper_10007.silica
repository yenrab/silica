// expected failure E2003: blend returns float16 but its result feeds print_float64
// float64 helper blend; prints -0.125
fn blend(x: float64) -> float16 {
    x - 14.125 + 2.5
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float64(blend(11.5))
        produces pure result end
}
