// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (15 + 55) < 1);
        println("");
        _: atom <- print_bool(41 != (52 + 40));
        println("");
        _: atom <- print_bool(1 > 26);
        println("");
        result: atom <- print_bool(36 <= (11 + 6))
        produces pure result end
}
