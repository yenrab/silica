// expected failure E2003: blend returns float32 but its result feeds print_float64
// float64 helper blend; prints 24.5
fn blend(x: float64) -> float32 {
    x - 6.0 + 1.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(blend(29.5))
    produces pure result end
}
