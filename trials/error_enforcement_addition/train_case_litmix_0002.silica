// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on uint8; v = 3 gives 16
fn main() -> uint8 {
    v: uint8 <- 3;
    case v of {
        :9 -> 23;
        2 -> 45;
        5 -> 33;
        m: uint8 if m > 4 -> 46;
        _: uint8 -> 16
    }
}
