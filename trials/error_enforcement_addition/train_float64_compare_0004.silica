// expected failure E1045: function 'main' declared without the fn keyword
// float64 comparisons
main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(27.25 < 30.375 * 13.25);
        println("");
        _: atom <- print_bool(28.375 * 10.25 > 18.0);
        println("");
        _: atom <- print_bool(4.5 >= (9.0 + 1.0));
        println("");
        done: atom <- print_bool(24.0 > 8.25)
    produces
        pure done
    end
}
