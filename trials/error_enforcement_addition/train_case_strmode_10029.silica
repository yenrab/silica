// expected failure E1043: whitespace between binding name 'mode' and ':'
// string case with an effectful sequence in each arm
fn main() -> atom {
    mode :string <- "quiet";
    case mode of {
        "quiet" -> {
            sequence proc[device_io]
                print_string("quiet");
                println("");
                print_int64(0);
                println("")
            produces
                pure :ok
            end
        }
        "trace" -> {
            sequence proc[device_io]
                print_int64(4);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
