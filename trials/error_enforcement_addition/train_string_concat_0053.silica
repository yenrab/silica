// expected failure E2001: integer literal passed to concatenate
// concatenate of 3 pieces prints silicaαβγZürich

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "silica";
        b: string <- "αβγ";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, 6);
        print_string(s0);
        println("")
    produces
        pure :ok
    end
}
