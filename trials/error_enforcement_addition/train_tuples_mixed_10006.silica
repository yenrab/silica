// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[mem(normal)]
        t: (boolean, int64, string) <- (false, 71, "south");
        (flag: boolean, k: int64, name: string) <- t;
        print_bool(flag);
        println("");
        print_int64(k);
        println("");
        print_string(name);
        println("")
    produces pure :ok end
}
