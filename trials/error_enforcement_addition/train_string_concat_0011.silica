// expected failure E2001: integer literal passed to concatenate
// concatenate of 4 pieces prints αβγbananacherrysilica

fn main() -> atom {
    sequence proc[device_io]
        s: string <- concatenate(concatenate(concatenate("αβγ", "banana"), "cherry"), 6);
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
