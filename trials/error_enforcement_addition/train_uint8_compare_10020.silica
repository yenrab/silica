// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 8 % 36 < 59 % 45);
        println("");
        _: atom <- print_bool(24 == (43 - 20));
        println("");
        _: atom <- print_bool((60 - 27) > 41 % 15);
        println("");
        _: atom <- print_bool(55 >= (24 + 47));
        println("");
        result: atom <- print_bool((10 % 11) <= (43 % 17))
        produces pure result end
}
