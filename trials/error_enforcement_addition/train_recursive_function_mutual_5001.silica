// expected failure E1045: function 'main' declared without the fn keyword
// mutual recursion even/odd; even(9) + odd(9) = 1
fn even(n: int64) -> int64 {
    case n == 0 of {
        true -> 1;
        false -> odd(n - 1)
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

main() -> int64 {
    even(9) + odd(9)
}
