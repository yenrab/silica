// expected failure E3010: sum8 extended to nine parameters
// function with 8 parameter(s); sum8(1, 7, 24, 19, 4, 1, 20, 2, 1) = 78
fn sum8(a: uint16, b: uint16, c: uint16, d: uint16, e: uint16, f: uint16, g: uint16, h: uint16, i: uint16) -> uint16 {
    a + b + c + d + e + f + g + h + i
}

fn main() -> uint16 {
    sum8(1, 7, 24, 19, 4, 1, 20, 2)
}
