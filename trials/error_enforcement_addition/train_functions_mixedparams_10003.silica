// expected failure E2002: undefined identifier 'n2'
// parameters of three different types; describe(22, "river", true) = 27
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n2
    }
}

fn main() -> int64 {
    describe(22, "river", true)
}
