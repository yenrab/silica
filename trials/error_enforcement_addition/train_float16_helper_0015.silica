// expected failure E2003: half_sum returns float64 but its result feeds print_float16
// float16 helper half_sum; prints 53.5
fn half_sum(x: float16) -> float64 {
    x * 12.0 + 2.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(half_sum(4.25))
    produces pure result end
}
