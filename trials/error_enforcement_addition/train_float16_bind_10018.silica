// expected failure E1055: binding 'temp_val' is never used
// float16 bindings 26.5 - 14.0 printed as 12.5
fn main() -> atom {
    temp_val: int64 <- 41;
    sequence proc[device_io]
        a: float16 <- 26.5;
        b: float16 <- 14.0;
        result: atom <- print_float16(a - b)
    produces pure result end
}
