// expected failure E1043: whitespace between binding name 'result' and ':'
// negate_float64 applied 3 time(s); prints -17.375
fn main() -> atom {
    sequence proc[device_io]
        result :atom <- print_float64(negate_float64(negate_float64(negate_float64(17.375))))
    produces
        pure result
    end
}
