// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 86 gives 0
fn main() -> int64 {
    n: int64 <- 86;
    case n of {
        n: int64 if n -> 0;
        n: int64 if n >= 10 and n < 61 -> n;
        n: int64 if n >= 61 -> 0
    }
}
