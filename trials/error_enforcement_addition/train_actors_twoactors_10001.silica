// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// Spec §15.1.1: two actor_ref values from spawn; each replies independently
fn adder(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn doubler(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg * 2, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io, mem(normal)]
        a: actor_ref <- spawn(5, adder);
        b: actor_ref <- spawn(0, doubler);
        ra: int64 <- call(a, 7 impl ActorMessage {});
        rb: int64 <- call(b, 6 impl ActorMessage {});
        print_int64(ra + rb);
        println("")
    produces
        pure :ok
    end
}
