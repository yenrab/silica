// expected failure E2003: print_int32 result bound as int64 instead of atom
// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_int32(2);
        println("");
        _: atom <- print_int32(0);
        println("");
        _: atom <- print_int32(49);
        println("");
        result: atom <- print_int32(37 / 45 / (59 / 44))
    produces
        pure result
    end
}
