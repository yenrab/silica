// expected failure E1041: trailing ';' after the block's final expression
// uint16 bindings then expression; expect 0
fn main() -> uint16 {
    height: uint16 <- 30 % 33;
    a: uint16 <- 14 * height - (height + height);
    c: uint16 <- a;
    m: uint16 <- a % 39;
    13 * a % a + c - c + m - m;
}
