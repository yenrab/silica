// expected failure E1060: unbalanced braces
// print_int8 two; prints 29 then 49
fn main() -> atom {
    sequence proc[device_io]
        a: int8 <- 29 + 0;
        b: int8 <- 49;
        _: atom <- print_int8(a);
        println("");
        result: atom <- print_int8(b)
    produces pure result end
}}
