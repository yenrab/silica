// expected failure E1041: trailing ';' after the block's final expression
// guard calls a boolean helper; z = -11 gives 0
fn is_positive(v: int64) -> boolean {
    v > 0
}

fn main() -> int64 {
    z: int64 <- -11;
    case z of {
        z: int64 if is_positive(z) -> z * 2;
        _: int64 -> 0
    };
}
