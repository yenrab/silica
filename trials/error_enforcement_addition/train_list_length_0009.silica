// expected failure E1051: sequence block without a closing end
// list literal of 3 uint32 elements; length is 3
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[uint32, mem(normal)] <- [31, 22, 5];
        n: int64 <- length[uint32, mem(normal)](xs)
    produces
        pure n
}
