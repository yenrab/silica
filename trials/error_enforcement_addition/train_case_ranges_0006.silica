// expected failure E1055: binding 'spare' is never used
// guards partition int64 into three ranges; n = 105 gives 205
fn main() -> int64 {
    spare: int64 <- 41;
    n: int64 <- 105;
    case n of {
        n: int64 if n < 101 -> n + 100;
        n: int64 if n >= 101 and n < 117 -> n + 100;
        n: int64 if n >= 117 -> n
    }
}
