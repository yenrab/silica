// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (51 % 12) >= (19 + 36));
        println("");
        result: atom <- print_bool(34 / 33 <= (12 - 5))
    produces
        pure result
    end
}
