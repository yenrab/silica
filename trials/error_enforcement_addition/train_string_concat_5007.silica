// expected failure E3009: proc[...] written on the function return type instead of the sequence
// concatenate of 3 pieces prints 日本語世界cherry

fn main() -> atom proc[device_io] {
    sequence proc[device_io] a: string <- "日本語";
        b: string <- "世界";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "cherry");
        print_string(s0);
        println("")
        produces pure :ok end
}
