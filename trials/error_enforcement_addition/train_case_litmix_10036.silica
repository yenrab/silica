// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int64; v = 7 gives 43
fn main() -> int64 {
    v: int64 <- 7;
    case v of {
        :5 -> 15;
        0 -> 46;
        6 -> 4;
        m: int64 if m > 9 -> 37;
        _: int64 -> 43
    }
}
