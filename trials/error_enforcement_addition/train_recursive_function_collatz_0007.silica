// expected failure E1045: function 'main' declared without the fn keyword
// collatz steps for 17 = 12
fn collatz(n: int64, acc: int64) -> int64 {
    case n == 1 of {
        true -> acc;
        false -> case n % 2 == 0 of {
            true -> collatz(n / 2, acc + 1);
            false -> collatz(3 * n + 1, acc + 1)
        }
    }
}

main() -> int64 {
    collatz(17, 0)
}
