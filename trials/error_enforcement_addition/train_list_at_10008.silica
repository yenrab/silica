// expected failure E2001: string literal used as a list index
// list_at index 4 of [22, 28, 8, 28, 13, 3] is 13
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [22, 28, 8, 28, 13, 3];
        v: int64 <- list_at[int64, mem(normal)](xs, "4")
    produces pure v end
}
