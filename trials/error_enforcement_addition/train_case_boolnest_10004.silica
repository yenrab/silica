// expected failure E1045: function 'main' declared without the fn keyword
// nested boolean cases; (true, true) selects 62
main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 62;
            false -> 5
        };
        false -> case b of {
            true -> 94;
            false -> 64
        }
    }
}
