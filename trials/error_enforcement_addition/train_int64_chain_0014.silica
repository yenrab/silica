// expected failure E2003: print_int64 result bound as int64 instead of atom
// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io] n_out: int64 <- print_int64(2 + 29);
        println("");
        _: atom <- print_int64((58 + 4));
        println("");
        result: atom <- print_int64(3)
        produces pure result end
}
