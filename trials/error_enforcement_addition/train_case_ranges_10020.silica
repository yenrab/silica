// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 13 gives 12
fn main() -> int64 {
    n: int64 <- 13;
    case n of {
        n: int64 if n < 77 -> "n - 1";
        n: int64 if n >= 77 and n < 80 -> n * 2;
        n: int64 if n >= 80 -> n
    }
}
