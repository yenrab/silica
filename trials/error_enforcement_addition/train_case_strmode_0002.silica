// expected failure E2005: integer pattern against a string scrutinee
// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "quiet";
    case mode of {
        "quiet" -> {
            sequence proc[device_io]
                print_string("quiet");
                println("");
                print_int64(0);
                println("")
            produces
                pure :ok
            end
        }
        2 -> {
            sequence proc[device_io]
                print_int64(9);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
