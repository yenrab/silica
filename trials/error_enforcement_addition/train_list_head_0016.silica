// expected failure E2003: list operation instantiated with the wrong element type
// head on [20, 18, 26, 5] gives 20
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [20, 18, 26, 5];
        first: int64 <- head[string, mem(normal)](xs)
        produces pure first end
}
