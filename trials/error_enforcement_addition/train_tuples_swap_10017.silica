// expected failure E2005: call to unknown function 'swap_all'
// swap((59, 39)); first * 2 + second = 137
fn swap(p: (int64, int64)) -> (int64, int64) {
    (x: int64, y: int64) <- p;
    (y, x)
}

fn main() -> int64 {
    (first: int64, second: int64) <- swap_all((59, 39));
    first * 2 + second
}
