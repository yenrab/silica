// expected failure E2005: decomposition pattern element types in the wrong order
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t: (boolean, int64, string) <- (false, 66, "south");
        (flag: boolean, k: string, name: int64) <- t;
        print_bool(flag);
        println("");
        print_int64(k);
        println("");
        print_string(name);
        println("")
    produces
        pure :ok
    end
}
