// expected failure E2003: list operation instantiated with the wrong element type
// remove_head on [27, 19] gives 1
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [27, 19];
        rest: List[int64, mem(normal)] <- remove_head[uint8, mem(normal)](xs);
        n: int64 <- length[int64, mem(normal)](rest)
        produces pure n end
}
