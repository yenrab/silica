// expected failure E2018: binding 'done' has no type annotation
// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(30.5 / 0.5 != 29.75);
        println("");
        _: atom <- print_bool(1.25 * 18.75 == 1.5 * 35.25);
        println("");
        _: atom <- print_bool((29.0 - 28.0) > 9.25);
        println("");
        done <- print_bool((27.25 - 29.0) < 18.5 * 3.5)
    produces pure done end
}
