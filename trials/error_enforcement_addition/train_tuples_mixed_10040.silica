// expected failure E1055: binding 'leftover' is never used
// decompose a mixed tuple and print each element
fn main() -> atom {
    leftover: int64 <- 41;
    sequence proc[device_io] t: (boolean, int64, string) <- (true, 93, "alpha");
        (flag: boolean, k: int64, name: string) <- t;
        print_bool(flag);
        println("");
        print_int64(k);
        println("");
        print_string(name);
        println("")
        produces pure :ok end
}
