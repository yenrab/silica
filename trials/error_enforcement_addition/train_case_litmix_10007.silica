// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 13 gives 20
fn main() -> int32 {
    v: int32 <- 13;
    case v of {
        :9 -> 4;
        7 -> 31;
        3 -> 44;
        m: int32 if m > 12 -> 20;
        _: int32 -> 19
    }
}
