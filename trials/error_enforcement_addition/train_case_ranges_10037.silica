// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 103 gives 51
fn main() -> int64 {
    n: int64 <- 103;
    case n of {
        n: int64 if n -> n - 1;
        n: int64 if n >= 33 and n < 102 -> n * 2;
        n: int64 if n >= 102 -> n / 2
    }
}
