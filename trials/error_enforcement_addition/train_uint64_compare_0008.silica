// expected failure E2005: call to unknown function 'print_bool_all'
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(41 == 32 % 1);
        println("");
        _: atom <- print_bool_all(1 < (14 + 59));
        println("");
        _: atom <- print_bool(38 > 24 / 12);
        println("");
        _: atom <- print_bool(32 / 44 >= 50 / 35);
        println("");
        result: atom <- print_bool((11 - 1) < (9 + 25))
        produces pure result end
}
