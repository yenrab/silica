// expected failure E2001: integer literal passed to concat
// concat of 3 pieces prints appleriveromega

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "apple";
        b: string <- "river";
        s: string <- concat(a, b);
        s0: string <- concat(s, 5);
        print_string(s0);
        println("")
    produces
        pure :ok
    end
}
