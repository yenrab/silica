// expected failure E2003: print_int8 result bound as int64 instead of atom
// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_int8(10 % 32);
        println("");
        _: atom <- print_int8(29);
        println("");
        result: atom <- print_int8(5 + 29 / 54)
    produces pure result end
}
