// expected failure E1045: function 'tri_acc' declared without the fn keyword
// recursive tri_acc on uint8; tri_acc(9, 0) = 45
tri_acc(n: uint8, acc: uint8) -> uint8 {
    case n == 0 of {
        true -> acc;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> uint8 {
    tri_acc(9, 0)
}
