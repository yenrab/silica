// expected failure E2005: reading a field that the record type does not declare
// functional record update through bump; counter ends at 74
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0: { counter: int64, label: string } <- { counter: 24, label: "count" };
    s1: { counter: int64, label: string } <- bump(s0, 25);
    s2: { counter: int64, label: string } <- bump(s1, 25);
    s2.total
}
