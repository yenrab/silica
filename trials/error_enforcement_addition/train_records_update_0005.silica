// expected failure E1055: binding 'temp_val' is never used
// functional record update through bump; counter ends at 71
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    temp_val: int64 <- 41;
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0: { counter: int64, label: string } <- { counter: 29, label: "count" };
    s1: { counter: int64, label: string } <- bump(s0, 21);
    s2: { counter: int64, label: string } <- bump(s1, 21);
    s2.counter
}
