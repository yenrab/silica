// expected failure E1055: binding 'scratch' is never used
// parameters of three different types; describe(3, "south", false) = 3
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    scratch: int64 <- 41;
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(3, "south", false)
}
