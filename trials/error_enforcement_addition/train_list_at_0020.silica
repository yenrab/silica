// expected failure E2001: string literal used as a list index
// list_at index 1 of [8, 3, 32] is 3
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [8, 3, 32];
        v: int64 <- list_at[int64, mem(normal)](xs, "1")
    produces
        pure v
    end
}
