// expected failure E1042: function 'main' has no return type
// uint16 comparisons printed with print_bool
fn main() {
    sequence proc[device_io]
        _: atom <- print_bool(60 <= 60);
        println("");
        _: atom <- print_bool(59 % 35 >= 32);
        println("");
        result: atom <- print_bool(52 * 8 > 51 % 25)
    produces
        pure result
    end
}
