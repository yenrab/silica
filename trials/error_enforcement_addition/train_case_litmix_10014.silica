// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on uint64; v = 10 gives 11
fn main() -> uint64 {
    v: uint64 <- 10;
    case v of {
        :9 -> 17;
        15 -> 31;
        1 -> 11;
        m: uint64 if m > 14 -> 44;
        _: uint64 -> 11
    }
}
