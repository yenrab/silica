// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint16 value 7; expect 94
fn main() -> uint16 {
    v: uint16 <- 7;
    case v of {
        "one" -> 54;
        29 -> 172;
        14 -> 132;
        n: uint16 if n > 31 -> 67;
        _: uint16 -> 94
    }
}
