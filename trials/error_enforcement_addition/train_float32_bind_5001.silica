// expected failure E2003: a declared float64 but combined with a float32 value
// float32 bindings 11.25 - 35.0 printed as -23.75
fn main() -> atom {
    sequence proc[device_io] a: float64 <- 11.25;
        b: float32 <- 35.0;
        result: atom <- print_float32(a - b)
        produces pure result end
}
