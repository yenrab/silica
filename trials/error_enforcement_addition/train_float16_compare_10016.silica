// expected failure E2005: call to unknown function 'print_bool_all'
// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool_all((2.0 + 9.5) < (26.0 + 5.0));
        println("");
        _: atom <- print_bool((13.25 + 15.0) != (16.5 + 20.0));
        println("");
        _: atom <- print_bool(34.0 == (1.5 + 29.5));
        println("");
        done: atom <- print_bool((7.75 + 4.0) == (28.5 + 41.0))
    produces
        pure done
    end
}
