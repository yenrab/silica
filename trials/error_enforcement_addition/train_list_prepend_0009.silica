// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// 3 prepends after empty; length is 3
fn main() -> int64 {
    sequence proc[device_io]
        xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
        xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](11, xs0);
        xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](32, xs1);
        xs3: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](39, xs2);
        n: int64 <- length[uint32, mem(normal)](xs3)
    produces
        pure n
    end
}
