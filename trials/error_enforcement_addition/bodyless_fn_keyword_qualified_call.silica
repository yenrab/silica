// `link` is lexed as a keyword, so `helper@link(...)` inside a sequence let cannot be parsed.
// The function body used to be dropped silently and emitted as `MOV X0, #0`; E1069 now names
// the function whose body could not be parsed.
fn pair_sum(x: int64) -> int64 {
    sequence
        linked: (int64, int64) <- helper@link(x, x)
    produces
        pure x
    end
}

fn main() -> int64 {
    pair_sum(3)
}
