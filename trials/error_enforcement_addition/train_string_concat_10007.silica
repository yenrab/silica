// expected failure E1047: named struct declaration 'Config' is not allowed
// concatenate of 4 pieces prints tableñandúZürichbeta

struct Config { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io] a: string <- "table";
        b: string <- "ñandú";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "Zürich");
        s1: string <- concatenate(s0, "beta");
        print_string(s1);
        println("")
        produces pure :ok end
}
