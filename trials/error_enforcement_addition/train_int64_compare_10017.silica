// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io, mem(normal)]
        _: atom <- print_bool(33 / 9 < (60 - 16));
        println("");
        _: atom <- print_bool(41 / 44 <= (27 + 48));
        println("");
        _: atom <- print_bool(22 * 7 < 53 * 30);
        println("");
        _: atom <- print_bool(48 == 21 * 40);
        println("");
        result: atom <- print_bool((30 + 33) > 44)
    produces pure result end
}
