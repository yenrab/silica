// expected failure E3010: list space does not match the sequence's mem effect
// list literal of 2 int64 elements; length is 2
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal_writethrough)] <- [2, 8];
        n: int64 <- length[int64, mem(normal_writethrough)](xs)
    produces
        pure n
    end
}
