// expected failure E1045: function 'main' declared without the fn keyword
// uint32 comparisons printed with print_bool
main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((37 + 12) < (14 + 12));
        println("");
        _: atom <- print_bool((14 + 15) == 41 * 40);
        println("");
        _: atom <- print_bool(57 / 35 <= 46 / 30);
        println("");
        result: atom <- print_bool(9 <= 36 * 48)
    produces pure result end
}
