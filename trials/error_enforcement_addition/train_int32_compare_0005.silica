// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 22 >= (21 - 11));
        println("");
        _: atom <- print_bool((34 - 1) < 43);
        println("");
        result: atom <- print_bool(32 % 33 <= (28 - 16))
    produces
        pure result
    end
}
