// expected failure E1047: named struct declaration 'Config' is not allowed
// Positive: mem(normal) list ops only inside case arms still justify sequence proc[mem(normal)]
struct Config { x: int64, y: int64 }

fn main() -> int64 {
    flag: boolean <- false;
    sequence proc[mem(normal)]
        n: int64 <- case flag of {
            true -> {
                xs: List[int64, mem(normal)] <- [4, 23];
                length[int64, mem(normal)](xs)
            };
            false -> {
                ys: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
                length[int64, mem(normal)](ys)
            }
        }
    produces
        pure n
    end
}
