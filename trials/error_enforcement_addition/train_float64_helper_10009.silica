// expected failure E2003: half_sum returns float32 but its result feeds print_float64
// float64 helper half_sum; prints 604.71875
fn half_sum(x: float64) -> float32 {
    x * 15.375 + 1.25
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(half_sum(39.25))
    produces
        pure result
    end
}
