// expected failure E1045: function 'main' declared without the fn keyword
// print_int32 two; prints 2296 then 25
main() -> atom {
    sequence proc[device_io]
        a: int32 <- 56 * 41;
        b: int32 <- 25;
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
    produces pure result end
}
