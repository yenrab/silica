// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (0 + 22) > 24 * 60);
        println("");
        _: atom <- print_bool((34 + 9) > 33 % 17);
        println("");
        _: atom <- print_bool((44 + 26) != 14 / 21);
        println("");
        _: atom <- print_bool(30 % 21 == 1 % 11);
        println("");
        result: atom <- print_bool(6 != (49 + 27))
        produces pure result end
}
