// expected failure E2005: call to unknown function 'print_strinz'
// concat of 2 pieces prints ñandúüber

fn main() -> atom {
    sequence proc[device_io] a: string <- "ñandú";
        b: string <- "über";
        s: string <- concat(a, b);
        print_strinz(s);
        println("")
        produces pure :ok end
}
