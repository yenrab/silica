// expected failure E1042: function 'describe' has no return type
// parameters of three different types; describe(12, "south", true) = 17
fn describe(n: int64, s: string, flag: boolean) {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(12, "south", true)
}
