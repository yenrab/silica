// expected failure E1042: function 'main' has no return type
// int32 comparisons printed with print_bool
fn main() -> {
    sequence proc[device_io]
        _: atom <- print_bool(41 / 5 == 20 * 38);
        println("");
        _: atom <- print_bool((53 + 20) != (30 + 60));
        println("");
        result: atom <- print_bool(39 * 15 != 40)
    produces pure result end
}
