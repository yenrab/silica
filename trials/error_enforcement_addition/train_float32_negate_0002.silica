// expected failure E1047: named struct declaration 'Node' is not allowed
// negate_float32 applied 2 time(s); prints 34.25
struct Node { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(negate_float32(negate_float32(34.25)))
    produces
        pure result
    end
}
