// expected failure E2001: string literal used as a list index
// list_at index 3 of [13, 1, 0, 23, 22, 18, 23] is 23
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [13, 1, 0, 23, 22, 18, 23];
        v: int64 <- list_at[int64, mem(normal)](xs, "3")
    produces
        pure v
    end
}
