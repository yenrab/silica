// expected failure E2001: integer literal bound to a boolean
// nested boolean cases; (true, true) selects 46
fn main() -> int64 {
    a: boolean <- 1;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 46;
            false -> 34
        };
        false -> case b of {
            true -> 75;
            false -> 8
        }
    }
}
