// expected failure E2018: binding 'result' has no type annotation
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(25 / 28 == 42 * 21);
        println("");
        _: atom <- print_bool(17 % 32 <= 23);
        println("");
        _: atom <- print_bool(55 % 25 != (28 + 17));
        println("");
        _: atom <- print_bool(39 % 54 <= 29 * 44);
        println("");
        result <- print_bool(52 > (32 - 21))
    produces pure result end
}
