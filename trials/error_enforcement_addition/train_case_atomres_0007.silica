// expected failure E1042: function 'main' has no return type
// case producing atoms then case dispatching on them; grade(13) -> 2
fn grade(n: int64) -> atom {
    case n of {
        0 -> :zero;
        k: int64 if k < 3 -> :low;
        _: int64 -> :high
    }
}

fn main() -> {
    g: atom <- grade(13);
    case g of {
        :zero -> 0;
        :low -> 1;
        :high -> 2;
        _: atom -> 9
    }
}
