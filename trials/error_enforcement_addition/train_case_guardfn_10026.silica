// expected failure E1055: binding 'leftover' is never used
// guard calls a boolean helper; z = 24 gives 48
fn is_positive(v: int64) -> boolean {
    leftover: int64 <- 41;
    v > 0
}

fn main() -> int64 {
    z: int64 <- 24;
    case z of {
        z: int64 if is_positive(z) -> z * 2;
        _: int64 -> 0
    }
}
