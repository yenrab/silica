// expected failure E4016: no main/0: entry function renamed to 'mainx'
// nested inline records; width = 10
fn mainx() -> int64 {
    rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
        top_left: { x: 12, y: 27 },
        bottom_right: { x: 22, y: 15 }
    };
    rect.bottom_right.x - rect.top_left.x
}
