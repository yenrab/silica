// expected failure E1041: trailing ';' after the pure expression
// print_uint16 two; prints 12 then 3021
fn main() -> atom {
    sequence proc[device_io]
        a: uint16 <- 13 - 1;
        b: uint16 <- 57 * 53;
        _: atom <- print_uint16(a);
        println("");
        result: atom <- print_uint16(b)
    produces
        pure result;
    end
}
