// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[mem(normal)]
        _: atom <- print_uint8(10);
        println("");
        _: atom <- print_uint8(34);
        println("");
        _: atom <- print_uint8(27);
        println("");
        result: atom <- print_uint8(7)
    produces
        pure result
    end
}
