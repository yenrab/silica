// expected failure E2005: decomposition pattern element types in the wrong order
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t: (int64, string, boolean) <- (90, "world", false);
        (k: string, name: int64, flag: boolean) <- t;
        print_int64(k);
        println("");
        print_string(name);
        println("");
        print_bool(flag);
        println("")
    produces
        pure :ok
    end
}
