// expected failure E1045: function 'main' declared without the fn keyword
// print_uint32 two; prints 65 then 45
main() -> atom {
    sequence proc[device_io] a: uint32 <- (57 + 8);
        b: uint32 <- 41 + 4;
        _: atom <- print_uint32(a);
        println("");
        result: atom <- print_uint32(b)
        produces pure result end
}
