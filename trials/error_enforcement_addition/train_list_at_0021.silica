// expected failure E2001: string literal used as a list index
// list_at index 3 of [9, 17, 40, 7, 6, 24] is 7
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [9, 17, 40, 7, 6, 24];
        v: int64 <- list_at[int64, mem(normal)](xs, "3")
    produces pure v end
}
