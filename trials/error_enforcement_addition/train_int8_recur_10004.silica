// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on int8; digit_count(89) = 2
fn digit_count(n: int8) -> int8 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> int8 {
    digit_count(89)
}
