// expected failure E2003: print_uint16 result bound as int64 instead of atom
// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint16(28);
        println("");
        result: atom <- print_uint16(16 / 34 + (4 + 31))
    produces
        pure result
    end
}
