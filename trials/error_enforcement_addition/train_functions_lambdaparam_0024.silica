// expected failure E2002: undefined identifier 'missing_num'
// function literal passed as a parameter, capturing z; expect 114
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, missing_num)
}

fn main() -> int64 {
    z: int64 <- 14;
    apply_pair(10, fn(a: int64, b: int64) -> int64 {
        a * b + z
    })
}
