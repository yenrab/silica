// expected failure E2003: shift returns float16 but its result feeds print_float64
// float64 helper shift; prints 17.625
fn shift(x: float64) -> float16 {
    x * 35.0 + 0.125
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float64(shift(0.5))
        produces pure result end
}
