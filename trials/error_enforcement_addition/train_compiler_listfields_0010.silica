// expected failure E1045: function 'main' declared without the fn keyword
// list field accessors is_nil/head; want 1
main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 38, 7, 9, 18];
        r: int64 <- case xs.is_nil of {
            true -> 0;
            false -> xs.head
        }
    produces
        pure r
    end
}
