// expected failure E2018: binding 'b' has no type annotation
// nested boolean cases; (true, true) selects 65
fn main() -> int64 {
    a: boolean <- true;
    b <- true;
    case a of {
        true -> case b of {
            true -> 65;
            false -> 45
        };
        false -> case b of {
            true -> 84;
            false -> 31
        }
    }
}
