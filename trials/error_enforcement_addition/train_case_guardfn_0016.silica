// expected failure E1045: function 'is_positive' declared without the fn keyword
// guard calls a boolean helper; z = -8 gives 0
is_positive(v: int64) -> boolean {
    v > 0
}

fn main() -> int64 {
    z: int64 <- -8;
    case z of {
        z: int64 if is_positive(z) -> z * 2;
        _: int64 -> 0
    }
}
