// expected failure E2001: integer literal passed to concatenate
// concatenate of 4 pieces prints caféalphahellobanana

fn main() -> atom {
    sequence proc[device_io]
        s: string <- concatenate(concatenate(concatenate("café", "alpha"), "hello"), 6);
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
