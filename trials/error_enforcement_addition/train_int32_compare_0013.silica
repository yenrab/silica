// expected failure E4016: no main/0: entry function renamed to 'start'
// int32 comparisons printed with print_bool
fn start() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(12 * 37 == (29 - 11));
        println("");
        _: atom <- print_bool(29 / 60 <= (30 + 45));
        println("");
        _: atom <- print_bool(53 * 0 > (24 + 29));
        println("");
        _: atom <- print_bool(54 / 48 == 29 % 47);
        println("");
        result: atom <- print_bool(5 == 56 % 57)
    produces
        pure result
    end
}
