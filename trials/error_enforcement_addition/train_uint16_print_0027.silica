// expected failure E2018: binding 'b' has no type annotation
// print_uint16 two; prints 2 then 31
fn main() -> atom {
    sequence proc[device_io]
        a: uint16 <- 59 % 57;
        b <- (18 + 13);
        _: atom <- print_uint16(a);
        println("");
        result: atom <- print_uint16(b)
    produces
        pure result
    end
}
