// expected failure E1065: parameter list of 'succ' is not closed
// named function passed as a value; apply(twice, 2) = 4
fn twice(x: int64) -> int64 {
    x * 2
}

fn succ(x: int64 -> int64 {
    x + 1
}

fn apply(f: fn(int64) -> int64, v: int64) -> int64 {
    f(v)
}

fn main() -> int64 {
    apply(twice, 2)
}
