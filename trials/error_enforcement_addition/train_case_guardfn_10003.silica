// expected failure E2003: guard helper returns int64 rather than boolean
// guard calls a boolean helper; z = 40 gives 80
fn is_positive(v: int64) -> int64 {
    v
}

fn main() -> int64 {
    z: int64 <- 40;
    case z of {
        z: int64 if is_positive(z) -> z * 2;
        _: int64 -> 0
    }
}
