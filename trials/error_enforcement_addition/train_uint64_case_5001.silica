// expected failure E1041: trailing ';' after the block's final expression
// case on uint64 value 9; expect 179
fn main() -> uint64 {
    v: uint64 <- 9;
    case v of {
        44 -> 177;
        6 -> 58;
        35 -> 32;
        41 -> 108;
        n: uint64 if n > 17 -> 101;
        _: uint64 -> 179
    };
}
