// expected failure E1045: function 'main' declared without the fn keyword
// guards partition int64 into three ranges; n = 82 gives 81
main() -> int64 {
    n: int64 <- 82;
    case n of {
        n: int64 if n < 92 -> n - 1;
        n: int64 if n >= 92 and n < 113 -> n;
        n: int64 if n >= 113 -> n
    }
}
