// expected failure E2003: scale returns float16 but its result feeds print_float64
// float64 helper scale; prints 18.0
fn scale(x: float64) -> float16 {
    x - 15.0 + 4.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(scale(29.0))
    produces
        pure result
    end
}
