// expected failure E2003: a declared float64 but combined with a float16 value
// float16 bindings 32.5 + 21.0 printed as 53.5
fn main() -> atom {
    sequence proc[device_io] a: float64 <- 32.5;
        b: float16 <- 21.0;
        result: atom <- print_float16(a + b)
        produces pure result end
}
