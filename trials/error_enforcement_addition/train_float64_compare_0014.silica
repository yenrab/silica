// expected failure E1045: function 'main' declared without the fn keyword
// float64 comparisons
main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((23.125 + 13.0) >= (9.0 + 30.5));
        println("");
        done: atom <- print_bool((28.5 + 22.0) <= (23.125 - 23.0))
    produces
        pure done
    end
}
