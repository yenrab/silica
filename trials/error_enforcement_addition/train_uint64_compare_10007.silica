// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (33 * 18) >= (22 - 12));
        println("");
        _: atom <- print_bool(7 % 25 >= (43 + 59));
        println("");
        result: atom <- print_bool(30 >= 45 * 48)
    produces pure result end
}
