// expected failure E2005: call to unknown function 'print_bool_all'
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((30 + 43) < (31 + 9));
        println("");
        _: atom <- print_bool_all((9 + 37) < 4);
        println("");
        _: atom <- print_bool(34 % 42 != (58 - 29));
        println("");
        result: atom <- print_bool((53 - 49) < (45 + 7))
        produces pure result end
}
