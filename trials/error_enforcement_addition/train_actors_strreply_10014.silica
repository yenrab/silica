// expected failure E1042: function 'echo' has no return type
// String message and string reply through call
fn echo(msg: string, state: int64) {
    (:reply, concatenate("echo: ", msg), state + 1)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        e: actor_ref <- spawn(0, echo);
        r: string <- call(e, "delta" impl ActorMessage {});
        print_string(r);
        println("")
    produces
        pure :ok
    end
}
