// expected failure E2005: call to unknown function 'my_print_float16'
// float16 bindings 23.0 + 1.5 printed as 24.5
fn main() -> atom {
    sequence proc[device_io]
        a: float16 <- 23.0;
        b: float16 <- 1.5;
        result: atom <- my_print_float16(a + b)
    produces
        pure result
    end
}
