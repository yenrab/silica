// expected failure E2005: boolean literal pattern against an integer scrutinee
// case expression as a binding's right-hand side; expect 19
fn main() -> int64 {
    x: int64 <- 16;
    label: int64 <- case x % 3 of {
        true -> 15;
        1 -> 18;
        _: int64 -> x
    };
    label + 1
}
