// expected failure E2005: call to unknown function 'my_print_int64'
// Positive: both device_io and mem(normal) declared and used in one sequence
fn main() -> atom {
    sequence proc[mem(normal), device_io] xs: List[int64, mem(normal)] <- [28, 17, 29];
        n: int64 <- length[int64, mem(normal)](xs);
        result: atom <- my_print_int64(n)
        produces pure result end
}
