// expected failure E2018: binding 'result' has no type annotation
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(58 % 15 < 0);
        println("");
        _: atom <- print_bool((12 + 27) > 15);
        println("");
        _: atom <- print_bool((30 * 5) > 5 / 54);
        println("");
        result <- print_bool(47 * 41 <= 12 * 6)
        produces pure result end
}
