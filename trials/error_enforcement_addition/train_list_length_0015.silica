// expected failure E2001: string element inside an integer list literal
// list literal of 5 int64 elements; length is 5
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- ["37", 2, 3, 10, 25];
        n: int64 <- length[int64, mem(normal)](xs)
    produces
        pure n
    end
}
