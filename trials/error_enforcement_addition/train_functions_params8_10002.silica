// expected failure E2005: call with one argument too few
// function with 8 parameter(s); sum8(24, 3, 11, 22, 20, 16, 9, 17) = 122
fn sum8(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64) -> int64 {
    a + b + c + d + e + f + g + h
}

fn main() -> int64 {
    sum8(24, 3, 11, 22, 20, 16, 9)
}
