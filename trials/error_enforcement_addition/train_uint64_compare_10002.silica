// expected failure E1050: produces clause without pure
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(9 * 3 == 50);
        println("");
        _: atom <- print_bool((20 + 34) <= (43 - 33));
        println("");
        _: atom <- print_bool(19 < 42 * 39);
        println("");
        result: atom <- print_bool(43 < 9)
    produces result end
}
