// expected failure E2003: print_int16 result bound as int64 instead of atom
// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_int16(48);
        println("");
        _: atom <- print_int16(47);
        println("");
        _: atom <- print_int16(57 * 1);
        println("");
        result: atom <- print_int16(9 * 44 + 2)
    produces pure result end
}
