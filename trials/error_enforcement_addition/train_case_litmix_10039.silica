// expected failure E1045: function 'main' declared without the fn keyword
// literal patterns, a guard and a typed wildcard on int32; v = 0 gives 33
main() -> int32 {
    v: int32 <- 0;
    case v of {
        4 -> 2;
        6 -> 0;
        13 -> 32;
        m: int32 if m > 9 -> 5;
        _: int32 -> 33
    }
}
