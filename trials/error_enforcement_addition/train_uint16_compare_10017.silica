// expected failure E1042: function 'main' has no return type
// uint16 comparisons printed with print_bool
fn main() {
    sequence proc[device_io]
        _: atom <- print_bool(0 * 53 >= (36 / 18));
        println("");
        _: atom <- print_bool(11 / 42 >= 22 / 12);
        println("");
        _: atom <- print_bool(44 / 21 <= (14 + 44));
        println("");
        result: atom <- print_bool(0 == 9 * 32)
    produces pure result end
}
