// expected failure E2018: binding 'result' has no type annotation
// float64 bindings 5.0 - 10.0 printed as -5.0
fn main() -> atom {
    sequence proc[device_io]
        a: float64 <- 5.0;
        b: float64 <- 10.0;
        result <- print_float64(a - b)
    produces
        pure result
    end
}
