// expected failure E1055: binding 'spare' is never used
// print_int8 two; prints 66 then 1
fn main() -> atom {
    spare: int64 <- 41;
    sequence proc[device_io]
        a: int8 <- 11 + 55;
        b: int8 <- 52 / 36;
        _: atom <- print_int8(a);
        println("");
        result: atom <- print_int8(b)
    produces pure result end
}
