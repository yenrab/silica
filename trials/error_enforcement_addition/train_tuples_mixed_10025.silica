// expected failure E1050: produces clause without pure
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t: (boolean, int64, string) <- (false, 80, "silica");
        (flag: boolean, k: int64, name: string) <- t;
        print_bool(flag);
        println("");
        print_int64(k);
        println("");
        print_string(name);
        println("")
    produces :ok end
}
