// expected failure E1049: sequence block without produces
// print_int32 two; prints 1200 then 33
fn main() -> atom {
    sequence proc[device_io]
        a: int32 <- 24 * 50;
        b: int32 <- 33;
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
    pure result end
}
