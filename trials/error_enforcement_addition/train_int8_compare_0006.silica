// expected failure E4016: no main/0: entry function renamed to 'entry'
// int8 comparisons printed with print_bool
fn entry() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(26 % 18 < 20);
        println("");
        _: atom <- print_bool(1 >= (11 + 43));
        println("");
        _: atom <- print_bool(40 < (20 + 51));
        println("");
        _: atom <- print_bool(5 % 51 < (49 + 46));
        println("");
        result: atom <- print_bool((7 + 22) >= (53 + 24))
    produces pure result end
}
