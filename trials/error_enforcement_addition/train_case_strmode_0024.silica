// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "debug";
    case mode of {
        "quiet" -> {
            sequence proc[mem(normal)]
                print_string("quiet");
                println("");
                print_int64(1);
                println("")
            produces
                pure :ok
            end
        }
        "debug" -> {
            sequence proc[device_io]
                print_int64(7);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
