// expected failure E1047: named struct declaration 'Pair' is not allowed
// print_int16 two; prints 35 then 55
struct Pair { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io]
        a: int16 <- 20 + 15;
        b: int16 <- (21 + 34);
        _: atom <- print_int16(a);
        println("");
        result: atom <- print_int16(b)
    produces pure result end
}
