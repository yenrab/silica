// expected failure E1041: trailing ';' after the block's final expression
// nested inline records; width = 23
fn main() -> int64 {
    rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
        top_left: { x: 24, y: 4 },
        bottom_right: { x: 1, y: 15 }
    };
    rect.top_left.x - rect.bottom_right.x;
}
