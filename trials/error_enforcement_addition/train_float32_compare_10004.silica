// expected failure E1041: trailing ';' after the pure expression
// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((33.25 - 1.0) > (8.25 - 9.375));
        println("");
        done: atom <- print_bool(34.75 * 24.5 < (6.0 - 17.5))
    produces
        pure done;
    end
}
