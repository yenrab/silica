// expected failure E1055: binding 'leftover' is never used
// list literal of 5 int32 elements; length is 5
fn main() -> int64 {
    leftover: int64 <- 41;
    sequence proc[mem(normal)]
        xs: List[int32, mem(normal)] <- [28, 19, 5, 15, 36];
        n: int64 <- length[int32, mem(normal)](xs)
    produces
        pure n
    end
}
