// expected failure E1053: duplicate produces keyword
// list field accessors is_nil/head; want 26
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [26, 4, 19];
        r: int64 <- case xs.is_nil of {
            true -> 0;
            false -> xs.head
        }
    produces produces
        pure r
    end
}
