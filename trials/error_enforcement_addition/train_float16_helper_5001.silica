// expected failure E2003: shift returns float32 but its result feeds print_float16
// float16 helper shift; prints 41.125
fn shift(x: float16) -> float32 {
    x * 4.5 + 1.75
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float16(shift(8.75))
        produces pure result end
}
