// expected failure E1041: trailing ';' after the block's final expression
// function literal passed as a parameter, capturing z; expect 215
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    z: int64 <- 19;
    apply_pair(14, fn(a: int64, b: int64) -> int64 {
        a * b + z
    });
}
