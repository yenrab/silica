// expected failure E1045: function 'tri_acc' declared without the fn keyword
// recursive tri_acc on int32; tri_acc(5, 0) = 15
tri_acc(n: int32, acc: int32) -> int32 {
    case n == 0 of {
        true -> acc;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> int32 {
    tri_acc(5, 0)
}
