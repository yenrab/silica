// expected failure E4016: no main/0: entry function renamed to 'main_program'
// mutual recursion even/odd; even(3) + odd(10) = 0
fn even(n: int64) -> int64 {
    case n == 0 of {
        true -> 1;
        false -> odd(n - 1)
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

fn main_program() -> int64 {
    even(3) + odd(10)
}
