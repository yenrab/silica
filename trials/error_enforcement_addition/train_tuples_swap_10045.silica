// expected failure E4016: no main/0: entry function renamed to 'main_program'
// swap((59, 8)); first * 2 + second = 75
fn swap(p: (int64, int64)) -> (int64, int64) {
    (x: int64, y: int64) <- p;
    (y, x)
}

fn main_program() -> int64 {
    (first: int64, second: int64) <- swap((59, 8));
    first * 2 + second
}
