// expected failure E2003: print_int64 result bound as int64 instead of atom
// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_int64(27);
        println("");
        _: atom <- print_int64(13 - 0 - (34 - 36));
        println("");
        _: atom <- print_int64(27);
        println("");
        result: atom <- print_int64(42)
    produces
        pure result
    end
}
