// expected failure E1055: binding 'leftover' is never used
// int16 comparisons printed with print_bool
fn main() -> atom {
    leftover: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_bool(25 * 21 <= 47 * 13);
        println("");
        _: atom <- print_bool((54 - 51) < 27);
        println("");
        result: atom <- print_bool(9 % 5 == 30)
    produces
        pure result
    end
}
