// expected failure E2003: half_sum returns float16 but its result feeds print_float32
// float32 helper half_sum; prints 789.0625
fn half_sum(x: float32) -> float16 {
    x * 32.125 + 2.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(half_sum(24.5))
    produces
        pure result
    end
}
