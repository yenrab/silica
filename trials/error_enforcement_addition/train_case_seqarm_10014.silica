// expected failure E1047: named struct declaration 'Node' is not allowed
// case inside a sequence chooses what to print
struct Node { x: int64, y: int64 }

fn main() -> atom {
    flag: boolean <- true;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 7;
            false -> 8
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
