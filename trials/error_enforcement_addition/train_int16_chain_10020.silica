// expected failure E1043: whitespace between binding name 'result' and ':'
// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int16(14);
        println("");
        _: atom <- print_int16(44);
        println("");
        result :atom <- print_int16(54 * 31)
        produces pure result end
}
