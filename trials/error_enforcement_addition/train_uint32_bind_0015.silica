// expected failure E1045: function 'main' declared without the fn keyword
// uint32 bindings then expression; expect 0
main() -> uint32 {
    c: uint32 <- 22;
    m: uint32 <- 24 * 18 + (c + 51);
    step: uint32 <- 48;
    height: uint32 <- 33 + 60;
    (m + 49) % (c / c) + step - step + height - height
}
