// expected failure E1042: function 'main' has no return type
// Positive: list allocation requires sequence proc[mem(normal)] (spec §9.3.1)
fn main() -> {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [35, 34, 23, 9];
        n: int64 <- length[int64, mem(normal)](xs)
    produces
        pure n
    end
}
