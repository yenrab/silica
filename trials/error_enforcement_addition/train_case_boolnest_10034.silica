// expected failure E2001: integer literal bound to a boolean
// nested boolean cases; (false, false) selects 50
fn main() -> int64 {
    a: boolean <- 1;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 16;
            false -> 32
        };
        false -> case b of {
            true -> 57;
            false -> 50
        }
    }
}
