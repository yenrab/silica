// expected failure E1050: produces clause without pure
// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((2.5 - 5.75) < (28.5 - 8.5));
        println("");
        _: atom <- print_bool(30.0 * 31.0 <= 34.0);
        println("");
        done: atom <- print_bool(3.25 > (40.75 + 4.0))
    produces
        done
    end
}
