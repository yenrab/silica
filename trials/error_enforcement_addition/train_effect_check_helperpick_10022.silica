// expected failure E2005: call to unknown function 'my_print_int64'
// Positive: pure helper chosen from a case arm; the effect runs in the sequence body
fn pick_value(flag: boolean) -> int64 {
    case flag of {
        true -> 7;
        false -> 5
    }
}

fn main() -> atom {
    flag: boolean <- true;
    sequence proc[device_io]
        v: int64 <- pick_value(flag);
        result: atom <- my_print_int64(v)
    produces
        pure result
    end
}
