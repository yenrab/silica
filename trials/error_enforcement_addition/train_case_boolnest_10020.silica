// expected failure E2005: inner boolean case missing its false arm
// nested boolean cases; (true, true) selects 19
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 19
        };
        false -> case b of {
            true -> 8;
            false -> 84
        }
    }
}
