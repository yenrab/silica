// expected failure E1047: named struct declaration 'Node' is not allowed
// tagged tuple (atom, int64) from safe_div(32, 8); expect 4
struct Node { x: int64, y: int64 }

fn safe_div(x: int64, y: int64) -> (atom, int64) {
    case y == 0 of {
        true -> (:error, 0);
        false -> (:ok, x / y)
    }
}

fn main() -> int64 {
    r: (atom, int64) <- safe_div(32, 8);
    (tag: atom, v: int64) <- r;
    case tag of {
        :ok -> v;
        _: atom -> 200
    }
}
