// expected failure E1054: extra end after the sequence block
// head on [22, 16, 28, 10, 25] gives 22
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [22, 16, 28, 10, 25];
        first: int64 <- head[int64, mem(normal)](xs)
    produces pure first end end
}
