// expected failure E1055: binding 'unused_value' is never used
// int64 comparisons printed with print_bool
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_bool((44 + 40) == 49 % 48);
        println("");
        result: atom <- print_bool((23 + 51) < 0 * 21)
    produces
        pure result
    end
}
