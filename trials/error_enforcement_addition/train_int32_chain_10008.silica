// expected failure E2003: print_int32 result bound as int64 instead of atom
// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io] n_out: int64 <- print_int32(7);
        println("");
        _: atom <- print_int32(39 + 41);
        println("");
        _: atom <- print_int32(2 + 15);
        println("");
        result: atom <- print_int32(3)
        produces pure result end
}
