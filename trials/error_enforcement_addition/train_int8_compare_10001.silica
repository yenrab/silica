// expected failure E2018: binding 'result' has no type annotation
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(45 % 13 > 7);
        println("");
        _: atom <- print_bool(9 < (35 - 22));
        println("");
        _: atom <- print_bool((53 + 51) >= (22 % 32));
        println("");
        result <- print_bool(33 > 46)
        produces pure result end
}
