// expected failure E2018: binding 'a' has no type annotation
// print_uint64 two; prints 46 then 27
fn main() -> atom {
    sequence proc[device_io]
        a <- 46;
        b: uint64 <- 54 / 2;
        _: atom <- print_uint64(a);
        println("");
        result: atom <- print_uint64(b)
    produces pure result end
}
