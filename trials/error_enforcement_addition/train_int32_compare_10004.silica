// expected failure E1055: binding 'scratch' is never used
// int32 comparisons printed with print_bool
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io] _: atom <- print_bool(25 * 0 < (39 + 59));
        println("");
        _: atom <- print_bool(29 / 5 != (10 % 1));
        println("");
        _: atom <- print_bool(37 % 15 <= 40 / 35);
        println("");
        result: atom <- print_bool((56 - 45) >= 2)
        produces pure result end
}
