// expected failure E1045: function 'main' declared without the fn keyword
// case inside a sequence chooses what to print
main() -> atom {
    flag: boolean <- false;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 2;
            false -> 7
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
