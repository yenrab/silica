// expected failure E1043: whitespace between binding name 'v' and ':'
// literal patterns, a guard and a typed wildcard on uint64; v = 14 gives 11
fn main() -> uint64 {
    v :uint64 <- 14;
    case v of {
        7 -> 1;
        2 -> 50;
        3 -> 23;
        m: uint64 if m > 4 -> 11;
        _: uint64 -> 46
    }
}
