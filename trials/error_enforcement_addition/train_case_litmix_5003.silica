// expected failure E1042: function 'main' has no return type
// literal patterns, a guard and a typed wildcard on uint64; v = 15 gives 37
fn main() {
    v: uint64 <- 15;
    case v of {
        14 -> 29;
        3 -> 37;
        12 -> 42;
        m: uint64 if m > 14 -> 37;
        _: uint64 -> 31
    }
}
