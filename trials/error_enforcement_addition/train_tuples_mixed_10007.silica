// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io, mem(normal)] t: (boolean, int64, string) <- (false, 50, "apple");
        (flag: boolean, k: int64, name: string) <- t;
        print_bool(flag);
        println("");
        print_int64(k);
        println("");
        print_string(name);
        println("")
        produces pure :ok end
}
