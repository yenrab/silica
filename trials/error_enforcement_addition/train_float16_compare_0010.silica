// expected failure E3009: proc[...] written on the function return type instead of the sequence
// float16 comparisons
fn main() -> atom proc[device_io] {
    sequence proc[device_io]
        _: atom <- print_bool(13.25 >= (16.5 + 39.5));
        println("");
        _: atom <- print_bool((31.0 - 7.75) >= 9.25);
        println("");
        done: atom <- print_bool(39.0 / 6.5 > 2.5)
    produces
        pure done
    end
}
