// expected failure E1055: binding 'scratch' is never used
// concat of 4 pieces prints 🙂ñandú🎉north

fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        s: string <- concat(concat(concat("🙂", "ñandú"), "🎉"), "north");
        print_string(s);
        println("")
    produces pure :ok end
}
