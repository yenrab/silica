// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (9 + 21) > (24 + 53));
        println("");
        _: atom <- print_bool((49 * 18) > (29 - 0));
        println("");
        _: atom <- print_bool(34 != (24 + 2));
        println("");
        result: atom <- print_bool(43 <= 12)
        produces pure result end
}
