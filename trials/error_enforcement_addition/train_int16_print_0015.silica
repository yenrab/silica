// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// print_int16 two; prints 39 then 5
fn main() -> atom {
    sequence proc[mem(normal)] a: int16 <- 39;
        b: int16 <- (53 / 10);
        _: atom <- print_int16(a);
        println("");
        result: atom <- print_int16(b)
        produces pure result end
}
