// expected failure E1041: trailing ';' after the pure expression
// float32 bindings 32.25 + 36.5 printed as 68.75
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 32.25;
        b: float32 <- 36.5;
        result: atom <- print_float32(a + b)
    produces
        pure result;
    end
}
