// expected failure E1055: binding 'temp_val' is never used
// float16 bindings 26.0 - 26.25 printed as -0.25
fn main() -> atom {
    temp_val: int64 <- 41;
    sequence proc[device_io]
        a: float16 <- 26.0;
        b: float16 <- 26.25;
        result: atom <- print_float16(a - b)
    produces pure result end
}
