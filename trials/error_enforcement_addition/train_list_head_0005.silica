// expected failure E2018: binding 'second' has no type annotation
// second on [24, 37, 32, 36, 9] gives 37
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [24, 37, 32, 36, 9];
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
        second <- head[int64, mem(normal)](rest)
    produces
        pure second
    end
}
