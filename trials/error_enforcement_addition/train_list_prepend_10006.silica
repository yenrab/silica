// expected failure E4016: no main/0: entry function renamed to 'main_program'
// 5 prepends after empty; length is 5
fn main_program() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
        xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](31, xs0);
        xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](32, xs1);
        xs3: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](40, xs2);
        xs4: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](12, xs3);
        xs5: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](8, xs4);
        n: int64 <- length[uint32, mem(normal)](xs5)
    produces pure n end
}
