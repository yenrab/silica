// expected failure E1047: named struct declaration 'Point' is not allowed
// function literal passed as a parameter, capturing z; expect 48
struct Point { x: int64, y: int64 }

fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    z: int64 <- 12;
    apply_pair(18, fn(a: int64, b: int64) -> int64 {
        a + b + z
    })
}
