// expected failure E1055: binding 'unused_value' is never used
// collatz steps for 27 = 111
fn collatz(n: int64, acc: int64) -> int64 {
    unused_value: int64 <- 41;
    case n == 1 of {
        true -> acc;
        false -> case n % 2 == 0 of {
            true -> collatz(n / 2, acc + 1);
            false -> collatz(3 * n + 1, acc + 1)
        }
    }
}

fn main() -> int64 {
    collatz(27, 0)
}
