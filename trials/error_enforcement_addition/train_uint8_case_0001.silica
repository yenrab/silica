// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint8 value 13; expect 141
fn main() -> uint8 {
    v: uint8 <- 13;
    case v of {
        :one -> 42;
        33 -> 124;
        21 -> 179;
        22 -> 112;
        n: uint8 if n > 14 -> 85;
        _: uint8 -> 141
    }
}
