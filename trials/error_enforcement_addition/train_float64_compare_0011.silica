// expected failure E1045: function 'main' declared without the fn keyword
// float64 comparisons
main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((15.5 + 33.125) > (35.5 - 13.25));
        println("");
        _: atom <- print_bool(3.0 != 16.5 * 24.375);
        println("");
        done: atom <- print_bool((17.5 - 34.5) == 3.25)
    produces pure done end
}
