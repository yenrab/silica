// expected failure E2005: inner boolean case missing its false arm
// nested boolean cases; (true, false) selects 8
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 3
        };
        false -> case b of {
            true -> 10;
            false -> 48
        }
    }
}
