// expected failure E1047: named struct declaration 'Point' is not allowed
// negate_float16 applied 3 time(s); prints -22.0
struct Point { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float16(negate_float16(negate_float16(negate_float16(22.0))))
        produces pure result end
}
