// expected failure E1055: binding 'unused_value' is never used
// print_uint16 two; prints 82 then 24
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        a: uint16 <- 36 + 46;
        b: uint16 <- 18 + 6;
        _: atom <- print_uint16(a);
        println("");
        result: atom <- print_uint16(b)
    produces pure result end
}
