// expected failure E4016: no main/0: entry function renamed to 'entry'
// int64 comparisons printed with print_bool
fn entry() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((28 + 42) > 55 * 12);
        println("");
        _: atom <- print_bool(22 != 59);
        println("");
        _: atom <- print_bool((42 * 9) >= 52);
        println("");
        _: atom <- print_bool((36 + 47) <= (1 + 20));
        println("");
        result: atom <- print_bool((56 + 51) <= 40 / 10)
    produces
        pure result
    end
}
