// expected failure E2003: print_uint16 result bound as int64 instead of atom
// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] n_out: int64 <- print_uint16(13 * 59 - (59 + 45));
        println("");
        _: atom <- print_uint16(20);
        println("");
        result: atom <- print_uint16(36 + 56)
        produces pure result end
}
