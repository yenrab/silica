// expected failure E1055: binding 'temp_val' is never used
// guards partition int64 into three ranges; n = 10 gives 20
fn main() -> int64 {
    temp_val: int64 <- 41;
    n: int64 <- 10;
    case n of {
        n: int64 if n < 37 -> n * 2;
        n: int64 if n >= 37 and n < 59 -> n * 2;
        n: int64 if n >= 59 -> n
    }
}
