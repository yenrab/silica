// expected failure E3009: proc[...] written on the function return type instead of the sequence
// string helper shout; prints actor!!!

fn shout(s: string, n: int64) -> string {
    case n == 0 of {
        true -> s;
        false -> concatenate(shout(s, n - 1), "!")
    }
}

fn main() -> atom proc[device_io] {
    sequence proc[device_io] print_string(shout("actor", 3));
        println("")
        produces pure :ok end
}
