// expected failure E2003: scale returns float16 but its result feeds print_float32
// float32 helper scale; prints 11.625
fn scale(x: float32) -> float16 {
    x - 22.375 + 3.75
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(scale(30.25))
    produces
        pure result
    end
}
