// expected failure E1065: parameter list of 'describe' is not closed
// parameters of three different types; describe(9, "cherry", false) = 9
fn describe(n: int64, s: string, flag: boolean -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(9, "cherry", false)
}
