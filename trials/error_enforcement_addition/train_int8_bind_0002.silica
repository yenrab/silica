// expected failure E2003: binding height declared int16 but used as int8
// int8 bindings then expression; expect 23
fn main() -> int8 {
    height: int16 <- 38;
    step: int8 <- 40 + height - (4 + height);
    c: int8 <- 60 / height;
    base: int8 <- 52 + (12 + c);
    7 + base / 4 + step - step
}
