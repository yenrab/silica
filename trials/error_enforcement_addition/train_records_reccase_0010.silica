// expected failure E1042: function 'main' has no return type
// record pattern matching (axis); expect 0
fn classify(p: { x: int64, y: int64 }) -> int64 {
    case p of {
        { x: 0, y: 0 } -> 0;
        { x: 0, y: _ } -> 1;
        { x: _, y: 0 } -> 2;
        _ -> 3
    }
}

fn main() -> {
    p: { x: int64, y: int64 } <- { x: 0, y: 0 };
    classify(p)
}
