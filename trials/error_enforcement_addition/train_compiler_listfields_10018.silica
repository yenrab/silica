// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// list field accessors is_nil/head; want 39
fn main() -> int64 {
    sequence proc[device_io]
        xs: List[int64, mem(normal)] <- [39, 8, 4, 11];
        r: int64 <- case xs.is_nil of {
            true -> 0;
            false -> xs.head
        }
    produces
        pure r
    end
}
