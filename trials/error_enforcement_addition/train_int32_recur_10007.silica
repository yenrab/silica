// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on int32; tri_acc(6, 0) = 21
fn tri_acc(n: int32, acc: int32) -> int32 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> int32 {
    tri_acc(6, 0)
}
