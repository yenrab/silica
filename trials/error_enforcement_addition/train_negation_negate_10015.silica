// expected failure E2005: call to unknown function 'negate_float32x'
// negate_float32 applied 3 time(s); prints -18.375
fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(negate_float32x(negate_float32(negate_float32(18.375))))
    produces
        pure result
    end
}
