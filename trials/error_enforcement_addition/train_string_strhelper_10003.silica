// expected failure E2002: undefined identifier 's2'
// string helper shout; prints cherry!!!

fn shout(s: string, n: int64) -> string {
    case n == 0 of {
        true -> s;
        false -> concatenate(shout(s2, n - 1), "!")
    }
}

fn main() -> atom {
    sequence proc[device_io]
        print_string(shout("cherry", 3));
        println("")
    produces pure :ok end
}
