// expected failure E1051: sequence block without a closing end
// print_int32 two; prints 170 then 1
fn main() -> atom {
    sequence proc[device_io]
        a: int32 <- 5 * 34;
        b: int32 <- (41 / 23);
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
    produces pure result
}
