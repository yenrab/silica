// expected failure E4016: no main/0: entry function renamed to 'main_program'
// chained print_uint16 calls separated by println
fn main_program() -> atom {
    sequence proc[device_io] _: atom <- print_uint16(55 * 0);
        println("");
        _: atom <- print_uint16(16 / 15);
        println("");
        result: atom <- print_uint16(37)
        produces pure result end
}
