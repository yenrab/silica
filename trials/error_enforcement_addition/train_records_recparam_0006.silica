// expected failure E1047: named struct declaration 'Config' is not allowed
// record passed to a function; perimeter({ width: 11, height: 4 }) = 30
struct Config { x: int64, y: int64 }

fn perimeter(r: { width: int64, height: int64 }) -> int64 {
    2 * (r.width + r.height)
}

fn main() -> int64 {
    perimeter({ width: 11, height: 4 })
}
