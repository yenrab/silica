// expected failure E4015: function 'describe' defined twice
// parameters of three different types; describe(3, "cloud", true) = 8
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

