// expected failure E2001: string literal in an integer list arm
// recursive sum_list over a list; total 122
fn sum_list(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> "0";
        [h: int64, t: List[int64, mem(normal)]] -> h + sum_list(t);
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [30, 7, 12, 19, 26, 28];
        total: int64 <- sum_list(xs)
    produces
        pure total
    end
}
