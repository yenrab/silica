// expected failure E2018: binding 'flag' has no type annotation
// case inside a sequence chooses what to print
fn main() -> atom {
    flag <- false;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 2;
            false -> 2
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
