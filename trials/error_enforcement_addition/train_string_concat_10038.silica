// expected failure E1045: function 'main' declared without the fn keyword
// concatenate of 4 pieces prints stonegamma🙂actor

main() -> atom {
    sequence proc[device_io]
        s: string <- concatenate(concatenate(concatenate("stone", "gamma"), "🙂"), "actor");
        print_string(s);
        println("")
    produces pure :ok end
}
