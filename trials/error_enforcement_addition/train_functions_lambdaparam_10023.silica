// expected failure E1055: binding 'leftover' is never used
// function literal passed as a parameter, capturing z; expect 27
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    leftover: int64 <- 41;
    op(num, num)
}

fn main() -> int64 {
    z: int64 <- 27;
    apply_pair(8, fn(a: int64, b: int64) -> int64 {
        a - b + z
    })
}
