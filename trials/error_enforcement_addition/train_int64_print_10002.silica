// expected failure E2018: binding 'result' has no type annotation
// print_int64 two; prints 71 then 3
fn main() -> atom {
    sequence proc[device_io] a: int64 <- 38 + 33;
        b: int64 <- 36 % 11;
        _: atom <- print_int64(a);
        println("");
        result <- print_int64(b)
        produces pure result end
}
