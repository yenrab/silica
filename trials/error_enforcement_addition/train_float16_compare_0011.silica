// expected failure E1050: produces clause without pure
// float16 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(5.0 * 15.25 < (14.25 + 24.75));
        println("");
        done: atom <- print_bool((19.5 + 16.25) <= (28.0 + 33.5))
    produces done end
}
