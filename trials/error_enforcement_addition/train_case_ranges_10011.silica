// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 16 gives 32
fn main() -> int64 {
    n: int64 <- 16;
    case n of {
        n: int64 if n < 17 -> "n * 2";
        n: int64 if n >= 17 and n < 33 -> n + 100;
        n: int64 if n >= 33 -> n
    }
}
