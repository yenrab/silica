// expected failure E2003: scale returns float16 but its result feeds print_float64
// float64 helper scale; prints 58.25
fn scale(x: float64) -> float16 {
    x + 34.5 + 2.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(scale(21.25))
    produces pure result end
}
