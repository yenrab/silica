// expected failure E4016: no main/0: entry function renamed to 'main_program'
// line-ending `or` followed by a blank line stays one expression
fn main_program() -> int64 {
    a: int64 <- 7;
    b: int64 <- 7;
    hit: boolean <- a > 1 or

        b > 1;
    case hit of {
        true -> 1;
        false -> 0
    }
}
