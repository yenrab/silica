// expected failure E4016: no main/0: entry function renamed to 'main_program'
// concat of 4 pieces prints tableriver🎉river

fn main_program() -> atom {
    sequence proc[device_io] s: string <- concat(concat(concat("table", "river"), "🎉"), "river");
        print_string(s);
        println("")
        produces pure :ok end
}
