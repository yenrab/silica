// expected failure E2001: integer literal operand to and
// and/or truth table bits (bool alias accepted); want 1
fn tt() -> bool {
    true
}

fn ff() -> bool {
    false
}

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn main() -> int64 {
    r0: int64 <- bit(1 and tt(), 1);
    r1: int64 <- bit(tt() and ff(), 2);
    r2: int64 <- bit(ff() or ff(), 4);
    r0 + r1 + r2
}
