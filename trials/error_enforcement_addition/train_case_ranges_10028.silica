// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 131 gives 65
fn main() -> int64 {
    n: int64 <- 131;
    case n of {
        n: int64 if n < 23 -> "0";
        n: int64 if n >= 23 and n < 83 -> n + 100;
        n: int64 if n >= 83 -> n / 2
    }
}
