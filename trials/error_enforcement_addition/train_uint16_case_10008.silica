// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint16 value 28; expect 185
fn main() -> uint16 {
    v: uint16 <- 28;
    case v of {
        :one -> 168;
        19 -> 13;
        22 -> 11;
        18 -> 106;
        n: uint16 if n > 27 -> 185;
        _: uint16 -> 69
    }
}
