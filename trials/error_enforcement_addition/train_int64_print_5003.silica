// expected failure E1042: function 'main' has no return type
// print_int64 two; prints 7 then 7
fn main() {
    sequence proc[device_io]
        a: int64 <- 7 % 34;
        b: int64 <- 59 % 52;
        _: atom <- print_int64(a);
        println("");
        result: atom <- print_int64(b)
    produces pure result end
}
