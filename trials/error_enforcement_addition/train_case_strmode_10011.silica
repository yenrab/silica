// expected failure E1053: duplicate produces keyword
// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "quiet";
    case mode of {
        "trace" -> {
            sequence proc[device_io]
                print_string("trace");
                println("");
                print_int64(5);
                println("")
            produces produces
                pure :ok
            end
        }
        "quiet" -> {
            sequence proc[device_io]
                print_int64(0);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
