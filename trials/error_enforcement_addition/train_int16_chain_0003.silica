// expected failure E2003: print_int16 result bound as int64 instead of atom
// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] n_out: int64 <- print_int16(41);
        println("");
        _: atom <- print_int16(54 + 40);
        println("");
        _: atom <- print_int16(3);
        println("");
        result: atom <- print_int16(40)
        produces pure result end
}
