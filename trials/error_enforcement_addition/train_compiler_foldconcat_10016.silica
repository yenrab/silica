// expected failure E1042: function 'main' has no return type
// fold a string list with concat; byte length 19
fn build(xs: List[string, mem(normal)]) -> string {
    sequence proc[mem(normal)]
        result: string <- case xs of {
            []: List[string, mem(normal)] -> "";
            [h: string, t: List[string, mem(normal)]] -> concat(h, build(t));
            _: List[string, mem(normal)] -> ""
        }
    produces
        pure result
    end
}

fn main() {
    sequence proc[mem(normal)]
        xs: List[string, mem(normal)] <- ["beta", "beta", "region", "gamma"];
        s: string <- build(xs)
    produces
        pure length_bytes(s)
    end
}
