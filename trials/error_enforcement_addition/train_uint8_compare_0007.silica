// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (38 + 0) < (52 + 55));
        println("");
        result: atom <- print_bool((26 + 41) <= 49)
        produces pure result end
}
