// expected failure E2018: binding 'b' has no type annotation
// print_uint8 two; prints 15 then 48
fn main() -> atom {
    sequence proc[device_io]
        a: uint8 <- (47 / 3);
        b <- 36 + 12;
        _: atom <- print_uint8(a);
        println("");
        result: atom <- print_uint8(b)
    produces pure result end
}
