// expected failure E2003: comparison against a string binding
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (23 + 13) >= 11);
        println("");
        _: atom <- print_bool(53 == 44 % 11);
        println("");
        _: atom <- print_bool(16 / 45 != (57 + 26));
        println("");
        _: atom <- print_bool(26 / 7 >= (7 + 10));
        println("");
        result: atom <- print_bool(5 / 51 != (41 + 5))
    produces
        pure result
    end
}
