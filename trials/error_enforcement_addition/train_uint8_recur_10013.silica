// expected failure E4016: no main/0: entry function renamed to 'start'
// recursive tri_acc on uint8; tri_acc(4, 0) = 10
fn tri_acc(n: uint8, acc: uint8) -> uint8 {
    case n == 0 of {
        true -> acc;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn start() -> uint8 {
    tri_acc(4, 0)
}
