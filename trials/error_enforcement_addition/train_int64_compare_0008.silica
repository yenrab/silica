// expected failure E1055: binding 'scratch' is never used
// int64 comparisons printed with print_bool
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io] _: atom <- print_bool((32 + 43) != 30 / 36);
        println("");
        _: atom <- print_bool((42 - 19) < 22 * 35);
        println("");
        _: atom <- print_bool(42 > 2);
        println("");
        result: atom <- print_bool(56 / 37 == 0 / 23)
        produces pure result end
}
