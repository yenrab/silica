// expected failure E1055: binding 'temp_val' is never used
// negate_float16 applied 3 time(s); prints -21.5
fn main() -> atom {
    temp_val: int64 <- 41;
    sequence proc[device_io]
        result: atom <- print_float16(negate_float16(negate_float16(negate_float16(21.5))))
    produces
        pure result
    end
}
