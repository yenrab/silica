// expected failure E2003: print_int8 result bound as int64 instead of atom
// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_int8((23 + 15) / 8);
        println("");
        _: atom <- print_int8(50);
        println("");
        _: atom <- print_int8(3);
        println("");
        result: atom <- print_int8(2)
    produces
        pure result
    end
}
