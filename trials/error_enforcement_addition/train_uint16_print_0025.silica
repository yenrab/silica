// expected failure E2018: binding 'b' has no type annotation
// print_uint16 two; prints 4 then 2958
fn main() -> atom {
    sequence proc[device_io] a: uint16 <- 42 % 38;
        b <- 58 * 51;
        _: atom <- print_uint16(a);
        println("");
        result: atom <- print_uint16(b)
        produces pure result end
}
