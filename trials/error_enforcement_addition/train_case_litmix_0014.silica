// expected failure E1055: binding 'temp_val' is never used
// literal patterns, a guard and a typed wildcard on uint64; v = 10 gives 22
fn main() -> uint64 {
    temp_val: int64 <- 41;
    v: uint64 <- 10;
    case v of {
        14 -> 4;
        10 -> 22;
        5 -> 30;
        m: uint64 if m > 5 -> 2;
        _: uint64 -> 36
    }
}
