// expected failure E2005: inner boolean case missing its false arm
// nested boolean cases; (true, false) selects 12
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 76
        };
        false -> case b of {
            true -> 81;
            false -> 64
        }
    }
}
