// expected failure E1045: function 'main' declared without the fn keyword
// uint8 comparisons printed with print_bool
main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(3 / 10 != (25 + 53));
        println("");
        result: atom <- print_bool((41 + 48) < (24 + 60))
        produces pure result end
}
