// expected failure E2001: integer literal passed to concatenate
// concatenate of 4 pieces prints naïve🎉world🙂

fn main() -> atom {
    sequence proc[device_io] s: string <- concatenate(concatenate(concatenate("naïve", "🎉"), "world"), 1);
        print_string(s);
        println("")
        produces pure :ok end
}
