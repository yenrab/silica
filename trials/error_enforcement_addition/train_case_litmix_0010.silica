// expected failure E1045: function 'main' declared without the fn keyword
// literal patterns, a guard and a typed wildcard on int32; v = 5 gives 32
main() -> int32 {
    v: int32 <- 5;
    case v of {
        2 -> 39;
        6 -> 21;
        8 -> 30;
        m: int32 if m > 11 -> 28;
        _: int32 -> 32
    }
}
