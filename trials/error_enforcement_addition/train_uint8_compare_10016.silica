// expected failure E1051: sequence block without a closing end
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(32 % 10 > (36 - 25));
        println("");
        _: atom <- print_bool(53 <= 19 % 32);
        println("");
        _: atom <- print_bool(24 / 38 <= (48 - 27));
        println("");
        _: atom <- print_bool(24 / 53 == (47 % 44));
        println("");
        result: atom <- print_bool((11 % 56) < (17 + 1))
    produces
        pure result
}
