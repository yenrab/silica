// expected failure E1040: missing ';' between two statements
// String message and string reply through call
fn echo(msg: string, state: int64) -> (:reply, string, int64) {
    (:reply, concatenate("echo: ", msg), state + 1)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        e: actor_ref <- spawn(0, echo);
        r: string <- call(e, "beta" impl ActorMessage {});
        print_string(r)
        println("")
    produces
        pure :ok
    end
}
