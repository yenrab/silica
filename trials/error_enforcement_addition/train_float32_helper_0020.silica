// expected failure E1045: function 'scale' declared without the fn keyword
// float32 helper scale; prints 37.0
scale(x: float32) -> float32 {
    x + 23.25 + 3.375
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(scale(10.375))
    produces
        pure result
    end
}
