// expected failure E1047: named struct declaration 'Point' is not allowed
// functional record update through bump; counter ends at 70
struct Point { x: int64, y: int64 }

fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0: { counter: int64, label: string } <- { counter: 34, label: "count" };
    s1: { counter: int64, label: string } <- bump(s0, 18);
    s2: { counter: int64, label: string } <- bump(s1, 18);
    s2.counter
}
