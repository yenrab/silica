// expected failure E1045: function 'main' declared without the fn keyword
// line-ending `or` followed by a blank line stays one expression
main() -> int64 {
    a: int64 <- 9;
    b: int64 <- 1;
    hit: boolean <- a > 5 or

        b > 5;
    case hit of {
        true -> 1;
        false -> 0
    }
}
