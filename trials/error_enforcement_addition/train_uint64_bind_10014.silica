// expected failure E2003: binding step declared int64 but used as uint64
// uint64 bindings then expression; expect 54
fn main() -> uint64 {
    step: int64 <- 15;
    d: uint64 <- 46 / 10 % (1 + step);
    base: uint64 <- 59;
    count: uint64 <- d % d % (27 % 34);
    36 + step + 39 % 9 + base - base + count - count
}
