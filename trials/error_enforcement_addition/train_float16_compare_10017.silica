// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// float16 comparisons
fn main() -> atom {
    sequence proc[mem(normal)]
        _: atom <- print_bool(5.5 == 1.5 * 21.0);
        println("");
        _: atom <- print_bool(30.5 == (39.0 - 17.5));
        println("");
        _: atom <- print_bool(23.25 < 13.0);
        println("");
        done: atom <- print_bool((2.0 + 35.75) != (17.0 + 0.25))
    produces pure done end
}
