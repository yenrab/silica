// expected failure E1041: trailing ';' after the pure expression
// list literal of 2 int64 elements; length is 2
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [27, 2];
        n: int64 <- length[int64, mem(normal)](xs)
    produces
        pure n;
    end
}
