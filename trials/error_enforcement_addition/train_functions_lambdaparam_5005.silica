// expected failure E2005: call to unknown function 'apply_pairx'
// function literal passed as a parameter, capturing z; expect 19
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    z: int64 <- 19;
    apply_pairx(10, fn(a: int64, b: int64) -> int64 {
        a - b + z
    })
}
