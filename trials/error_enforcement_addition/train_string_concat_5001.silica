// expected failure E2003: string binding used where an integer is expected
// concatenate of 3 pieces prints northregiontable

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "north";
        b: string <- "region";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "table");
        print_int64(s0);
        println("")
    produces pure :ok end
}
