// expected failure E1042: function 'main' has no return type
// case inside a sequence chooses what to print
fn main() -> {
    flag: boolean <- false;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 7;
            false -> 6
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
