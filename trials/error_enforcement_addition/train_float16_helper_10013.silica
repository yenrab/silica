// expected failure E2003: blend returns float32 but its result feeds print_float16
// float16 helper blend; prints 122.625
fn blend(x: float16) -> float32 {
    x * 25.5 + 1.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(blend(4.75))
    produces
        pure result
    end
}
