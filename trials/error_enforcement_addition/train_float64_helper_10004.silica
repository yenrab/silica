// expected failure E2003: blend returns float16 but its result feeds print_float64
// float64 helper blend; prints 39.125
fn blend(x: float64) -> float16 {
    x + 11.5 + 1.5
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float64(blend(26.125))
        produces pure result end
}
