// expected failure E1041: trailing ';' after the block's final expression
// guards partition int64 into three ranges; n = 89 gives 189
fn main() -> int64 {
    n: int64 <- 89;
    case n of {
        n: int64 if n < 30 -> n * 2;
        n: int64 if n >= 30 and n < 66 -> n / 2;
        n: int64 if n >= 66 -> n + 100
    };
}
