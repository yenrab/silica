// expected failure E2001: integer literal in the string-typed arm
// typed `string { ... }` case arm body; want 1
fn first_char(s: string) -> string {
    case s == "" of {
        false -> string {
            c: string <- substring(s, 0, 1);
            c
        };
        true -> 0
    }
}

fn main() -> int64 {
    case first_char("chair") == "c" of {
        true -> 1;
        false -> 0
    }
}
