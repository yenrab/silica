// regression (already diagnosed by silica-999997): expected failure E2005: a behavior must take (message, state)
fn beh(msg: int64) -> (:reply, int64, int64) {
    (:reply, msg, msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, beh);
        r: int64 <- call(w, 1 impl ActorMessage {});
        print_int64(r);
        println("")
    produces pure :ok end
}
