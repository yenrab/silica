// expected failure E2003: string binding used where an integer is expected
// concat of 3 pieces prints southstoneregion

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "south";
        b: string <- "stone";
        s: string <- concat(a, b);
        s0: string <- concat(s, "region");
        print_int64(s0);
        println("")
    produces
        pure :ok
    end
}
