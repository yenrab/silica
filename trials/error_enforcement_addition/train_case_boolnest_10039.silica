// expected failure E2005: inner boolean case missing its false arm
// nested boolean cases; (false, true) selects 59
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 84
        };
        false -> case b of {
            true -> 59;
            false -> 44
        }
    }
}
