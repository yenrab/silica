// expected failure E2018: binding 'v' has no type annotation
// list_at index 1 of [28, 10, 18, 24, 0, 2, 8] is 10
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [28, 10, 18, 24, 0, 2, 8];
        v <- list_at[int64, mem(normal)](xs, 1)
    produces
        pure v
    end
}
