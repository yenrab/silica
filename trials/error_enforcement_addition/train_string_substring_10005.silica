// expected failure E1055: binding 'unused_value' is never used
// substring uses character indices [5, 5) of "table"
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        s: string <- substring("table", 5, 5);
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
