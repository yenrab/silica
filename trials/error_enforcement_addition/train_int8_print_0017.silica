// expected failure E1050: produces clause without pure
// print_int8 two; prints 6 then 47
fn main() -> atom {
    sequence proc[device_io] a: int8 <- 6;
        b: int8 <- 0 + 47;
        _: atom <- print_int8(a);
        println("");
        result: atom <- print_int8(b)
        produces result end
}
