// expected failure E2005: call to unknown function 'join_alz'
// join_all over a list of strings
fn join_all(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, t: List[string, mem(normal)]] -> concatenate(h, join_all(t));
        _: List[string, mem(normal)] -> ""
    }
}

fn main() -> atom {
    sequence proc[mem(normal), device_io]
        xs: List[string, mem(normal)] <- ["river", "cherry"];
        s: string <- join_alz(xs);
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
