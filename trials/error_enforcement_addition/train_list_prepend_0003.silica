// expected failure E2001: string element prepended to an integer list
// 3 prepends after empty; head is 9
fn main() -> uint32 {
    sequence proc[mem(normal)]
        xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
        xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)]("2", xs0);
        xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](10, xs1);
        xs3: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](9, xs2);
        h: uint32 <- head[uint32, mem(normal)](xs3)
    produces
        pure h
    end
}
