// expected failure E1045: function 'main' declared without the fn keyword
// case scrutinee is a tuple-returning call; expect 5
fn pair(n: int64) -> (int64, int64) {
    (n, n + 1)
}

main() -> int64 {
    case pair(2) of {
        t: (int64, int64) -> {
            (x: int64, y: int64) <- t;
            x + y + 0
        }
    }
}
