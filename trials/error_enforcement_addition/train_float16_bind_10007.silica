// expected failure E2003: a declared float32 but combined with a float16 value
// float16 bindings 39.5 + 17.5 printed as 57.0
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 39.5;
        b: float16 <- 17.5;
        result: atom <- print_float16(a + b)
    produces pure result end
}
