// expected failure E2003: half_sum returns float32 but its result feeds print_float64
// float64 helper half_sum; prints -7.0
fn half_sum(x: float64) -> float32 {
    x - 32.0 + 4.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(half_sum(21.0))
    produces
        pure result
    end
}
