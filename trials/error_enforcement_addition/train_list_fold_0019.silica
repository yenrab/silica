// expected failure E1042: function 'main' has no return type
// max_acc over [34] = 34
fn max_acc(xs: List[int64, mem(normal)], best: int64) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> best;
        [h: int64, t: List[int64, mem(normal)]] -> case h > best of {
            true -> max_acc(t, h);
            false -> max_acc(t, best)
        };
        _: List[int64, mem(normal)] -> best
    }
}

fn main() -> {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [34];
        r: int64 <- max_acc(xs, 0)
    produces
        pure r
    end
}
