// expected failure E2005: call to an undefined third helper
// mutual recursion even/odd; even(12) + odd(8) = 1
fn even(n: int64) -> int64 {
    case n == 0 of {
        true -> 1;
        false -> oddly(n - 1)
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

fn main() -> int64 {
    even(12) + odd(8)
}
