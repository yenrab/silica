// expected failure E1052: duplicate sequence keyword
// print_uint32 two; prints 18 then 18
fn main() -> atom {
    sequence sequence proc[device_io] a: uint32 <- 15 + 3;
        b: uint32 <- (18 % 49);
        _: atom <- print_uint32(a);
        println("");
        result: atom <- print_uint32(b)
        produces pure result end
}
