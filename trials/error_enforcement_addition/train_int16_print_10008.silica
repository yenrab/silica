// expected failure E2018: binding 'b' has no type annotation
// print_int16 two; prints 64 then 65
fn main() -> atom {
    sequence proc[device_io]
        a: int16 <- 8 * 8;
        b <- 37 + 28;
        _: atom <- print_int16(a);
        println("");
        result: atom <- print_int16(b)
    produces
        pure result
    end
}
