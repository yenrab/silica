// expected failure E1055: binding 'scratch' is never used
// named function passed as a value; apply(succ, 24) = 25
fn twice(x: int64) -> int64 {
    scratch: int64 <- 41;
    x * 2
}

fn succ(x: int64) -> int64 {
    x + 1
}

fn apply(f: fn(int64) -> int64, v: int64) -> int64 {
    f(v)
}

fn main() -> int64 {
    apply(succ, 24)
}
