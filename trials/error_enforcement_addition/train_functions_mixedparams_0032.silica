// expected failure E2001: string literal in the int64 argument slot
// parameters of three different types; describe(13, "hello", false) = 13
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe("hello", "hello", false)
}
