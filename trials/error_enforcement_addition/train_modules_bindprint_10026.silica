// expected failure E1047: named struct declaration 'Point' is not allowed
// qualified call bound then printed; prints 13
use lib_math_utils_spec;

struct Point { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io] v: int64 <- lib_math_utils_spec@add(3, 10);
        result: atom <- print_int64(v)
        produces pure result end
}
