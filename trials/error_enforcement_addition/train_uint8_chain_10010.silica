// expected failure E1041: trailing ';' after the pure expression
// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint8(24 + 14);
        println("");
        _: atom <- print_uint8(32);
        println("");
        result: atom <- print_uint8(58)
    produces
        pure result;
    end
}
