// expected failure E1055: binding 'temp_val' is never used
// qualified call bound then printed; prints 1
use lib_arity;

fn main() -> atom {
    temp_val: int64 <- 41;
    sequence proc[device_io]
        v: int64 <- lib_arity@add3(0, 0, 1);
        result: atom <- print_int64(v)
    produces pure result end
}
