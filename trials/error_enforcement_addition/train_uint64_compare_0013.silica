// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 7 / 16 <= 14 / 46);
        println("");
        _: atom <- print_bool(17 * 45 == 33 * 11);
        println("");
        _: atom <- print_bool(58 < 28 % 60);
        println("");
        _: atom <- print_bool((55 + 27) <= 7);
        println("");
        result: atom <- print_bool(43 % 16 < 6)
    produces
        pure result
    end
}
