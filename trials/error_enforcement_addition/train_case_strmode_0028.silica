// expected failure E4016: no main/0: entry function renamed to 'entry'
// string case with an effectful sequence in each arm
fn entry() -> atom {
    mode: string <- "other";
    case mode of {
        "trace" -> {
            sequence proc[device_io]
                print_string("trace");
                println("");
                print_int64(6);
                println("")
            produces
                pure :ok
            end
        }
        "verbose" -> {
            sequence proc[device_io]
                print_int64(9);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
