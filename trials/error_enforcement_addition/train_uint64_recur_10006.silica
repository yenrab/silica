// expected failure E1047: named struct declaration 'Config' is not allowed
// recursive pow2 on uint64; pow2(4) = 16
struct Config { x: int64, y: int64 }

fn pow2(n: uint64) -> uint64 {
    case n == 0 of {
        true -> 1;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> uint64 {
    pow2(4)
}
