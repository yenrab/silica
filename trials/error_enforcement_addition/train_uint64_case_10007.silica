// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint64 value 17; expect 131
fn main() -> uint64 {
    v: uint64 <- 17;
    case v of {
        :one -> 160;
        23 -> 129;
        43 -> 50;
        30 -> 0;
        n: uint64 if n > 37 -> 61;
        _: uint64 -> 131
    }
}
