// expected failure E2003: comparison against a string binding
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (41 * 12) < 45 % 49);
        println("");
        _: atom <- print_bool(54 * 50 == (7 + 32));
        println("");
        result: atom <- print_bool((19 + 16) > (12 + 15))
    produces
        pure result
    end
}
