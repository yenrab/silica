// Statement separator: `sequence ... end` is one statement; `;` is required after `end`
// when another statement follows in the same block.

fn forwarder(msg: int64, state: { sink: actor_ref }) -> (:no_reply, { sink: actor_ref }) {
    sequence proc[concurrency]
        _: boolean <- cast(state.sink, msg impl ActorMessage {})
    produces
        pure :ok
    end
    (:no_reply, state)
}
