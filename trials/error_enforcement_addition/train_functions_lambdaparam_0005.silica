// expected failure E2005: function literal called with one argument instead of two
// function literal passed as a parameter, capturing z; expect 2
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num)
}

fn main() -> int64 {
    z: int64 <- 2;
    apply_pair(3, fn(a: int64, b: int64) -> int64 {
        a - b + z
    })
}
