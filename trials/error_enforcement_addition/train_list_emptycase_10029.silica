// expected failure E1055: binding 'leftover' is never used
// case on an empty list; expect 43
fn main() -> int64 {
    leftover: int64 <- 41;
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 43;
            [h: int64, _: List[int64, mem(normal)]] -> h + 58;
            _: List[int64, mem(normal)] -> 43
        }
    produces
        pure r
    end
}
