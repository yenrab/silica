// expected failure E2005: unknown list field
// list field accessors is_nil/head; want 36
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [36, 49, 22, 26];
        r: int64 <- case xs.is_nil of {
            true -> 0;
            false -> xs.first
        }
    produces
        pure r
    end
}
