// expected failure E1045: function 'main' declared without the fn keyword
// uint16 comparisons printed with print_bool
main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((2 % 53) >= 33 * 8);
        println("");
        _: atom <- print_bool((46 - 24) > (43 / 18));
        println("");
        _: atom <- print_bool((40 + 3) != 2);
        println("");
        _: atom <- print_bool(3 * 42 >= (14 - 10));
        println("");
        result: atom <- print_bool(59 % 33 != 34)
    produces
        pure result
    end
}
