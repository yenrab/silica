// expected failure E2001: string literal used as a list index
// list_at index 2 of [28, 3, 9, 10, 9, 21, 26] is 9
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [28, 3, 9, 10, 9, 21, 26];
        v: int64 <- list_at[int64, mem(normal)](xs, "2")
    produces
        pure v
    end
}
