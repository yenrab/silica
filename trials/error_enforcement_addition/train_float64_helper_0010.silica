// expected failure E2003: shift returns float16 but its result feeds print_float64
// float64 helper shift; prints 21.5
fn shift(x: float64) -> float16 {
    x + 13.0 + 2.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(shift(6.5))
    produces pure result end
}
