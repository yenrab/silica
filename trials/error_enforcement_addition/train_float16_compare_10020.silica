// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// float16 comparisons
fn main() -> atom {
    sequence proc[mem(normal)]
        _: atom <- print_bool((6.0 - 27.75) == 5.5 * 2.5);
        println("");
        _: atom <- print_bool((9.0 + 27.5) >= (35.75 + 6.25));
        println("");
        done: atom <- print_bool((24.5 - 18.0) == 7.0)
    produces pure done end
}
