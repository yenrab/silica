// expected failure E1065: parameter list of 'bit' is not closed
// boolean helpers combined into bits; expect 1
fn bit(b: boolean, w: int64 -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main() -> int64 {
    bit(ff() or tt(), 1) + bit(ff() or ff(), 2) + bit(tt() == ff(), 4)
}
