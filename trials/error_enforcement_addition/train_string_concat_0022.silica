// expected failure E2001: integer literal passed to concatenate
// concatenate of 4 pieces prints applestone世界alpha

fn main() -> atom {
    sequence proc[device_io] a: string <- "apple";
        b: string <- "stone";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "世界");
        s1: string <- concatenate(s0, 5);
        print_string(s1);
        println("")
        produces pure :ok end
}
