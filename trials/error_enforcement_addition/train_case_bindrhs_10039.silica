// expected failure E4016: no main/0: entry function renamed to 'main_program'
// case expression as a binding's right-hand side; expect 15
fn main_program() -> int64 {
    x: int64 <- 14;
    label: int64 <- case x % 3 of {
        0 -> 1;
        1 -> 18;
        _: int64 -> x
    };
    label + 1
}
