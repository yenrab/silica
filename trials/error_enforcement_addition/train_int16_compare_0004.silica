// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 43 < (7 * 5));
        println("");
        _: atom <- print_bool(7 % 7 >= 41 % 48);
        println("");
        _: atom <- print_bool(41 > (21 - 4));
        println("");
        result: atom <- print_bool(10 >= 51 * 36)
    produces pure result end
}
