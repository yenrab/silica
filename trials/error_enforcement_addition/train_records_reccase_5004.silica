// expected failure E2005: record pattern naming a field the type lacks
// record pattern matching (axis); expect 1
fn classify(p: { x: int64, y: int64 }) -> int64 {
    case p of {
        { x: 0, z: 0 } -> 0;
        { x: 0, y: _ } -> 1;
        { x: _, y: 0 } -> 2;
        _ -> 3
    }
}

fn main() -> int64 {
    p: { x: int64, y: int64 } <- { x: 0, y: 5 };
    classify(p)
}
