// expected failure E2003: prepend called with its arguments swapped
// 3 prepends after empty; head is 34
fn main() -> int32 {
    sequence proc[mem(normal)]
        xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](xs0, 36);
        xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](16, xs1);
        xs3: List[int32, mem(normal)] <- prepend[int32, mem(normal)](34, xs2);
        h: int32 <- head[int32, mem(normal)](xs3)
    produces pure h end
}
