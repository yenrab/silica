// expected failure E1060: unbalanced braces
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(42 == (22 + 26));
        println("");
        _: atom <- print_bool(2 % 5 == 15 % 24);
        println("");
        _: atom <- print_bool((5 + 12) != (51 + 6));
        println("");
        _: atom <- print_bool((36 + 15) <= 15);
        println("");
        result: atom <- print_bool(5 % 41 < (44 - 18))
        produces pure result end
