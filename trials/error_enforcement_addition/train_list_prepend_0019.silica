// expected failure E2018: binding 'xs4' has no type annotation
// 5 prepends after empty; length is 5
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](0, xs0);
        xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](6, xs1);
        xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](11, xs2);
        xs4 <- prepend[int64, mem(normal)](37, xs3);
        xs5: List[int64, mem(normal)] <- prepend[int64, mem(normal)](11, xs4);
        n: int64 <- length[int64, mem(normal)](xs5)
    produces pure n end
}
