// E1054: a sequence block closes with one end; the surrounding function closes with }.

fn update_and_print(p: { x: int64, y: int64 }) -> { x: int64, y: int64 } {
    sequence proc[device_io]
        updated: { x: int64, y: int64 } <- { x: p.x + 1, y: p.y + 1 }
        produces pure updated end
    end
}
