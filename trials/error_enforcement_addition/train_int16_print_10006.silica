// expected failure E2005: call to unknown function 'print_int1z'
// print_int16 two; prints 50 then 23
fn main() -> atom {
    sequence proc[device_io]
        a: int16 <- 50;
        b: int16 <- 35 - 12;
        _: atom <- print_int16(a);
        println("");
        result: atom <- print_int1z(b)
    produces
        pure result
    end
}
