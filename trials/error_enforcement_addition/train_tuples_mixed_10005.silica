// expected failure E1042: function 'main' has no return type
// decompose a mixed tuple and print each element
fn main() -> {
    sequence proc[device_io]
        t: (string, int64, atom) <- ("chair", 50, :done);
        (name: string, k: int64, tag: atom) <- t;
        print_string(name);
        println("");
        print_int64(k);
        println("");
        print_atom(tag);
        println("")
    produces pure :ok end
}
