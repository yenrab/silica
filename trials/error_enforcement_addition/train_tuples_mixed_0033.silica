// expected failure E1045: function 'main' declared without the fn keyword
// decompose a mixed tuple and print each element
main() -> atom {
    sequence proc[device_io]
        t: (boolean, int64, string) <- (true, 38, "south");
        (flag: boolean, k: int64, name: string) <- t;
        print_bool(flag);
        println("");
        print_int64(k);
        println("");
        print_string(name);
        println("")
    produces
        pure :ok
    end
}
