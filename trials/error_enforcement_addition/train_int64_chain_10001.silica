// expected failure E2003: print_int64 result bound as int64 instead of atom
// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_int64(59 * 48);
        println("");
        _: atom <- print_int64(54);
        println("");
        _: atom <- print_int64(35);
        println("");
        result: atom <- print_int64(0 + 55)
    produces pure result end
}
