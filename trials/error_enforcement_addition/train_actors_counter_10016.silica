// expected failure E1042: function 'main' has no return type
// Spec §16.1.1: call(actor_ref, message) -> Reply; behavior returns (:reply, reply, new_state)
fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn main() {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(9, acc);
        r0: int64 <- call(w, 20 impl ActorMessage {});
        print_int64(r0);
        println("");
        r1: int64 <- call(w, 4 impl ActorMessage {});
        print_int64(r1);
        println("");
        r2: int64 <- call(w, 13 impl ActorMessage {});
        print_int64(r2);
        println("");
        r3: int64 <- call(w, 13 impl ActorMessage {});
        print_int64(r3);
        println("")
    produces
        pure :ok
    end
}
