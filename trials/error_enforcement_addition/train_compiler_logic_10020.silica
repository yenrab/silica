// expected failure E1041: trailing ';' after the block's final expression
// and/or truth table bits (bool alias accepted); want 2
fn tt() -> bool {
    true
}

fn ff() -> bool {
    false;
}

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn main() -> int64 {
    r0: int64 <- bit(ff() and tt(), 1);
    r1: int64 <- bit(tt() and tt(), 2);
    r2: int64 <- bit(ff() and ff(), 4);
    r0 + r1 + r2
}
