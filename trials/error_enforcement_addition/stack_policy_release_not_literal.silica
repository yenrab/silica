// expected failure E2005: stack_policy release must be an atom literal (the runtime holds the algorithm as an index)
fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        alg: atom <- :keep_high_water;
        w: actor_ref <- spawn(0, beh, stack_policy(0, alg))
    produces
        pure 0
    end
}
