// expected failure E2005: spawn called without a behavior function
// Spec §16.1.1: call(actor_ref, message) -> Reply; behavior returns (:reply, reply, new_state)
fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(16);
        r0: int64 <- call(w, 3 impl ActorMessage {});
        print_int64(r0);
        println("");
        r1: int64 <- call(w, 5 impl ActorMessage {});
        print_int64(r1);
        println("");
        r2: int64 <- call(w, 13 impl ActorMessage {});
        print_int64(r2);
        println("")
    produces
        pure :ok
    end
}
