// expected failure E2005: behavior declared with a single parameter
// Spec §16.1.3: repeated call() to the same actor preserves FIFO order
fn step(msg: int64) -> (:reply, int64, int64) {
    (:reply, msg, msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, step);
        v0: int64 <- call(w, 1 impl ActorMessage {});
        v1: int64 <- call(w, 1 impl ActorMessage {});
        print_int64(v1);
        println("")
    produces
        pure :ok
    end
}
