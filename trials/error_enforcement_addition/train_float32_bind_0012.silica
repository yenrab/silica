// expected failure E2003: a declared float16 but combined with a float32 value
// float32 bindings 33.375 * 38.0 printed as 1268.25
fn main() -> atom {
    sequence proc[device_io] a: float16 <- 33.375;
        b: float32 <- 38.0;
        result: atom <- print_float32(a * b)
        produces pure result end
}
