// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint32 value 11; expect 72
fn main() -> uint32 {
    v: uint32 <- 11;
    case v of {
        true -> 59;
        34 -> 150;
        25 -> 73;
        31 -> 33;
        n: uint32 if n > 11 -> 125;
        _: uint32 -> 72
    }
}
