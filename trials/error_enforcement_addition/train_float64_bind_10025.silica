// expected failure E2003: integer binding mixed into float arithmetic
// float64 bindings 4.375 + 1.5 printed as 5.875
fn main() -> atom {
    sequence proc[device_io]
        a: float64 <- 4.375;
        b: int64 <- 1;
        result: atom <- print_float64(a + b)
    produces
        pure result
    end
}
