// expected failure E1042: function 'bit' has no return type
// boolean helpers combined into bits; expect 7
fn bit(b: boolean, w: int64) {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main() -> int64 {
    bit(ff() == ff(), 1) + bit(ff() or tt(), 2) + bit(tt() and tt(), 4)
}
