// expected failure E1043: whitespace between binding name 'result' and ':'
// float32 helper half_sum; prints 1180.125
fn half_sum(x: float32) -> float32 {
    x * 32.5 + 2.0
}

fn main() -> atom {
    sequence proc[device_io]
        result :atom <- print_float32(half_sum(36.25))
    produces
        pure result
    end
}
