// expected failure E2001: integer literal bound to a boolean
// nested boolean cases; (false, false) selects 71
fn main() -> int64 {
    a: boolean <- 1;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 99;
            false -> 50
        };
        false -> case b of {
            true -> 70;
            false -> 71
        }
    }
}
