// expected failure E1043: whitespace between binding name 'done' and ':'
// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(20.375 > (10.75 + 32.5));
        println("");
        done :atom <- print_bool((4.75 + 19.25) < (33.5 + 11.0))
    produces
        pure done
    end
}
