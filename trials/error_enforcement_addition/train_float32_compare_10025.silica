// expected failure E1043: whitespace between binding name 'done' and ':'
// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(4.0 * 10.25 > (13.0 + 13.5));
        println("");
        _: atom <- print_bool(14.25 > 16.5);
        println("");
        _: atom <- print_bool(37.25 <= (36.0 - 23.125));
        println("");
        done :atom <- print_bool(3.75 == (7.0 + 23.25))
    produces pure done end
}
