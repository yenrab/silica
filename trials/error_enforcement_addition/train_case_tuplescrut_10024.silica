// expected failure E2005: call to unknown function 'pairx'
// case scrutinee is a tuple-returning call; expect 33
fn pair(n: int64) -> (int64, int64) {
    (n, n + 1)
}

fn main() -> int64 {
    case pairx(12) of {
        t: (int64, int64) -> {
            (x: int64, y: int64) <- t;
            x + y + 8
        }
    }
}
