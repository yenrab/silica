// expected failure E4015: function 'area' defined twice
// record passed to a function; area(make_rect(4, 13)) = 52
fn make_rect(w: int64, h: int64) -> { width: int64, height: int64 } {
    { width: w, height: h }
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

fn main() -> int64 {
    area(make_rect(4, 13))
}
