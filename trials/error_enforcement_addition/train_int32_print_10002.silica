// expected failure E1054: extra end after the sequence block
// print_int32 two; prints 0 then 86
fn main() -> atom {
    sequence proc[device_io] a: int32 <- 28 / 40;
        b: int32 <- 26 + 60;
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
        produces pure result end end
