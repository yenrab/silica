// expected failure E3009: proc[...] written on the function return type instead of the sequence
// case on an empty list; expect 84
fn main() -> int64 proc[mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 84;
            [h: int64, _: List[int64, mem(normal)]] -> h + 44;
            _: List[int64, mem(normal)] -> 84
        }
    produces
        pure r
    end
}
