// expected failure E2003: shift returns float16 but its result feeds print_float32
// float32 helper shift; prints -1.75
fn shift(x: float32) -> float16 {
    x - 34.25 + 3.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(shift(29.0))
    produces pure result end
}
