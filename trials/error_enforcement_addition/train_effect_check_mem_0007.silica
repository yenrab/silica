// expected failure E3002: mem(normal) used under proc[device_io]
// Positive: list allocation requires sequence proc[mem(normal)] (spec §9.3.1)
fn main() -> int64 {
    sequence proc[device_io]
        xs: List[int64, mem(normal)] <- [40, 26, 39];
        n: int64 <- length[int64, mem(normal)](xs)
    produces
        pure n
    end
}
