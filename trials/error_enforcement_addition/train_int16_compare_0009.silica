// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (51 + 19) > 27 / 47);
        println("");
        result: atom <- print_bool(27 % 50 <= 18)
        produces pure result end
}
