// expected failure E2003: half_sum returns float64 but its result feeds print_float32
// float32 helper half_sum; prints 37.25
fn half_sum(x: float32) -> float64 {
    x + 28.0 + 4.5
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float32(half_sum(4.75))
        produces pure result end
}
