// expected failure E1041: trailing ';' after the block's final expression
// float32 helper blend; prints 504.25
fn blend(x: float32) -> float32 {
    x * 15.75 + 0.25;
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float32(blend(32.0))
        produces pure result end
}
