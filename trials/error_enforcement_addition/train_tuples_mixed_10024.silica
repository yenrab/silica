// expected failure E2003: string element printed with print_int64
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t: (string, int64, atom) <- ("delta", 4, :ok);
        (name: string, k: int64, tag: atom) <- t;
        print_int64(name);
        println("");
        print_int64(k);
        println("");
        print_atom(tag);
        println("")
    produces pure :ok end
}
