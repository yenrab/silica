// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// float32 comparisons
fn main() -> atom {
    sequence proc[mem(normal)]
        _: atom <- print_bool((8.75 - 27.75) < 11.375);
        println("");
        _: atom <- print_bool(9.25 >= 30.375);
        println("");
        _: atom <- print_bool(30.0 != (0.75 - 22.5));
        println("");
        done: atom <- print_bool((31.5 + 11.25) == (39.0 + 13.25))
    produces
        pure done
    end
}
