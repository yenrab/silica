// expected failure E2003: scale returns float64 but its result feeds print_float32
// float32 helper scale; prints 10.375
fn scale(x: float32) -> float64 {
    x - 7.25 + 0.25
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float32(scale(17.375))
        produces pure result end
}
