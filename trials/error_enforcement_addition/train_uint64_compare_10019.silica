// expected failure E1054: extra end after the sequence block
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((53 + 0) < 28 / 3);
        println("");
        _: atom <- print_bool(23 % 60 == (49 - 49));
        println("");
        _: atom <- print_bool((53 % 25) == (15 + 35));
        println("");
        _: atom <- print_bool(5 <= 57);
        println("");
        result: atom <- print_bool((44 + 33) <= (14 + 21))
    produces pure result end end
}
