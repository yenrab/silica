// expected failure E1055: binding 'temp_val' is never used
// list literal of 5 int32 elements; length is 5
fn main() -> int64 {
    temp_val: int64 <- 41;
    sequence proc[mem(normal_writethrough)]
        xs: List[int32, mem(normal_writethrough)] <- [17, 37, 1, 27, 10];
        n: int64 <- length[int32, mem(normal_writethrough)](xs)
    produces
        pure n
    end
}
