// expected failure E4016: no main/0: entry function renamed to 'mainx'
// concat of 2 pieces prints helloregion

fn mainx() -> atom {
    sequence proc[device_io]
        a: string <- "hello";
        b: string <- "region";
        s: string <- concat(a, b);
        print_string(s);
        println("")
    produces pure :ok end
}
