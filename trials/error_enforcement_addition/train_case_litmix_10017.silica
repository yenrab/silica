// expected failure E1055: binding 'scratch' is never used
// literal patterns, a guard and a typed wildcard on int64; v = 2 gives 27
fn main() -> int64 {
    scratch: int64 <- 41;
    v: int64 <- 2;
    case v of {
        7 -> 36;
        5 -> 22;
        14 -> 33;
        m: int64 if m > 7 -> 10;
        _: int64 -> 27
    }
}
