// expected failure E1055: binding 'temp_val' is never used
// case on a non-empty list; expect 65
fn main() -> int64 {
    temp_val: int64 <- 41;
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [0];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 72;
            [h: int64, _: List[int64, mem(normal)]] -> h + 65;
            _: List[int64, mem(normal)] -> 72
        }
    produces
        pure r
    end
}
