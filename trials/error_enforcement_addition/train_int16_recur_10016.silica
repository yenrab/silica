// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on int16; tri_acc(6, 0) = 21
fn tri_acc(n: int16, acc: int16) -> int16 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> int16 {
    tri_acc(6, 0)
}
