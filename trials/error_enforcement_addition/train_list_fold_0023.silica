// expected failure E4016: no main/0: entry function renamed to 'main_program'
// count over [25, 48, 40] = 3
fn count(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [_: int64, t: List[int64, mem(normal)]] -> 1 + count(t);
        _: List[int64, mem(normal)] -> 0
    }
}

fn main_program() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [25, 48, 40];
        r: int64 <- count(xs)
        produces pure r end
}
