// expected failure E2005: inner boolean case missing its false arm
// nested boolean cases; (false, true) selects 68
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 15
        };
        false -> case b of {
            true -> 68;
            false -> 40
        }
    }
}
