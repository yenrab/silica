// expected failure E2005: spawn_registered without the required stack_policy argument (§15.1.1, §15.1.2.2)
fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        w: actor_ref <- spawn_registered(0, beh, :named_worker)
    produces
        pure 0
    end
}
