// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (18 - 6) >= 5);
        println("");
        _: atom <- print_bool(31 / 14 == 59);
        println("");
        _: atom <- print_bool((59 - 56) < 17 * 42);
        println("");
        result: atom <- print_bool(47 * 18 < (48 % 47))
        produces pure result end
}
