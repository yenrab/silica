// expected failure E2003: shift returns float32 but its result feeds print_float64
// float64 helper shift; prints 43.0
fn shift(x: float64) -> float32 {
    x + 27.25 + 0.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(shift(15.25))
    produces pure result end
}
