// expected failure E1045: function 'twice' declared without the fn keyword
// named function passed as a value; apply(succ, 17) = 18
twice(x: int64) -> int64 {
    x * 2
}

fn succ(x: int64) -> int64 {
    x + 1
}

fn apply(f: fn(int64) -> int64, v: int64) -> int64 {
    f(v)
}

fn main() -> int64 {
    apply(succ, 17)
}
