// expected failure E1055: binding 'unused_value' is never used
// uint16 comparisons printed with print_bool
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_bool(8 % 47 <= 26);
        println("");
        result: atom <- print_bool(53 * 18 > (35 + 23))
    produces pure result end
}
