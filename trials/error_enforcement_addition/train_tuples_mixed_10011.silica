// expected failure E2018: binding 't' has no type annotation
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t <- (30, "omega", false);
        (k: int64, name: string, flag: boolean) <- t;
        print_int64(k);
        println("");
        print_string(name);
        println("");
        print_bool(flag);
        println("")
    produces pure :ok end
}
