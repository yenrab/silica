// expected failure E1060: unbalanced braces
// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "verbose";
    case mode of {
        "trace" -> {
            sequence proc[device_io]
                print_string("trace");
                println("");
                print_int64(8);
                println("")
            produces
                pure :ok
            end
        }
        "verbose" -> {
            sequence proc[device_io]
                print_int64(6);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}}
