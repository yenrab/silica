// expected failure E2003: binding width declared int32 but used as uint32
// uint32 bindings then expression; expect 24
fn main() -> uint32 {
    width: int32 <- 32;
    a: uint32 <- 3 + width - width / width;
    step: uint32 <- 50;
    k: uint32 <- 53 % 37 + (width - width);
    24 + a - a + step - step + k - k
}
