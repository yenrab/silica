// expected failure E1055: binding 'leftover' is never used
// print_int64 two; prints 2 then 54
fn main() -> atom {
    leftover: int64 <- 41;
    sequence proc[device_io]
        a: int64 <- 56 / 25;
        b: int64 <- 42 + 12;
        _: atom <- print_int64(a);
        println("");
        result: atom <- print_int64(b)
    produces
        pure result
    end
}
