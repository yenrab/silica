// expected failure E1053: duplicate produces keyword
// case on an empty list; expect 4
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 4;
            [h: int64, _: List[int64, mem(normal)]] -> h + 63;
            _: List[int64, mem(normal)] -> 4
        }
    produces produces
        pure r
    end
}
