// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// list literal of 6 int64 elements; length is 6
fn main() -> int64 {
    sequence proc[device_io] xs: List[int64, mem(normal)] <- [0, 39, 7, 12, 1, 38];
        n: int64 <- length[int64, mem(normal)](xs)
        produces pure n end
