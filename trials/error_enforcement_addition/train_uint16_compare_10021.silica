// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[mem(normal)]
        _: atom <- print_bool(57 / 49 >= 26);
        println("");
        _: atom <- print_bool(57 * 48 > 1 % 11);
        println("");
        _: atom <- print_bool(10 * 4 >= 47);
        println("");
        _: atom <- print_bool((53 + 50) == (50 + 60));
        println("");
        result: atom <- print_bool(44 <= 29 * 42)
    produces pure result end
}
