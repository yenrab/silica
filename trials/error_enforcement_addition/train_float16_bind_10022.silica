// expected failure E4016: no main/0: entry function renamed to 'start'
// float16 bindings 28.75 * 0.5 printed as 14.375
fn start() -> atom {
    sequence proc[device_io] a: float16 <- 28.75;
        b: float16 <- 0.5;
        result: atom <- print_float16(a * b)
        produces pure result end
}
