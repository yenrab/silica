// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// negate_float16 applied 2 time(s); prints 13.0
fn main() -> atom {
    sequence proc[device_io, mem(normal)]
        result: atom <- print_float16(negate_float16(negate_float16(13.0)))
    produces
        pure result
    end
}
