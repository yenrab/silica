// expected failure E2005: call to unknown function 'bumpx'
// functional record update through bump; counter ends at 90
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0: { counter: int64, label: string } <- { counter: 34, label: "count" };
    s1: { counter: int64, label: string } <- bumpx(s0, 28);
    s2: { counter: int64, label: string } <- bump(s1, 28);
    s2.counter
}
