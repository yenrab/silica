// expected failure E2003: half_sum returns float64 but its result feeds print_float32
// float32 helper half_sum; prints 572.0
fn half_sum(x: float32) -> float64 {
    x * 31.75 + 0.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(half_sum(18.0))
    produces
        pure result
    end
}
