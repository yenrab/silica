// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint64 value 4; expect 9
fn main() -> uint64 {
    v: uint64 <- 4;
    case v of {
        true -> 160;
        1 -> 38;
        10 -> 112;
        32 -> 78;
        n: uint64 if n > 37 -> 123;
        _: uint64 -> 9
    }
}
