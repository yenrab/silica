// expected failure E1055: binding 'unused_value' is never used
// float16 comparisons
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_bool((40.0 + 19.0) < (14.0 - 29.5));
        println("");
        _: atom <- print_bool((37.5 - 7.75) != 15.0 * 31.0);
        println("");
        done: atom <- print_bool(29.0 * 5.0 == 20.5 * 15.0)
    produces
        pure done
    end
}
