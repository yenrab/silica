// expected failure E1045: function 'main' declared without the fn keyword
// negate_float32 applied 3 time(s); prints -19.5
main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(negate_float32(negate_float32(negate_float32(19.5))))
    produces
        pure result
    end
}
