// expected failure E2005: call to unknown function 'print_booz'
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((32 + 19) != 36 / 34);
        println("");
        result: atom <- print_booz(20 / 6 < (29 - 16))
    produces
        pure result
    end
}
