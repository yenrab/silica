// expected failure E2018: binding 'done' has no type annotation
// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(13.375 <= (2.25 + 17.0));
        println("");
        _: atom <- print_bool((40.25 - 30.25) != (6.375 - 23.5));
        println("");
        done <- print_bool(40.5 < 4.5)
    produces
        pure done
    end
}
