// expected failure E1047: named struct declaration 'Node' is not allowed
// chained print_int8 calls separated by println
struct Node { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8(59);
        println("");
        result: atom <- print_int8(13)
    produces pure result end
}
