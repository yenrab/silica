// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 13 % 17 >= (52 - 32));
        println("");
        _: atom <- print_bool((25 + 3) >= 12 * 4);
        println("");
        result: atom <- print_bool((24 + 53) != 31)
    produces
        pure result
    end
}
