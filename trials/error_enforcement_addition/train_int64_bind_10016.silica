// expected failure E2013: unary minus on a variable instead of negate_int64
// int64 bindings then expression; expect 10
fn main() -> int64 {
    count: int64 <- 30 / 16 * (7 + 20);
    k: int64 <- count + count + (45 + 7);
    total: int64 <- (53 + k) / (k / count);
    step: int64 <- k - 43;
    -count + 10 + total - total + step - step
}
