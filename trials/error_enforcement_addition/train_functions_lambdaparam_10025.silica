// expected failure E2018: binding 'z' has no type annotation
// function literal passed as a parameter, capturing z; expect 22
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    z <- 2;
    apply_pair(10, fn(a: int64, b: int64) -> int64 {
        a + b + z
    })
}
