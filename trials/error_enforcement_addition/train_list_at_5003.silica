// expected failure E4016: no main/0: entry function renamed to 'mainx'
// list_at index 1 of [13, 29, 33, 8, 38, 13, 34] is 29
fn mainx() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [13, 29, 33, 8, 38, 13, 34];
        v: int64 <- list_at[int64, mem(normal)](xs, 1)
    produces pure v end
}
