// expected failure E2005: call with one argument too few
// function with 7 parameter(s); sum7(23, 20, 20, 4, 21, 24, 11) = 123
fn sum7(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64) -> int64 {
    a + b + c + d + e + f + g
}

fn main() -> int64 {
    sum7(23, 20, 20, 4, 21, 24)
}
