// expected failure E1055: binding 'scratch' is never used
// decompose a mixed tuple and print each element
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io] t: (string, int64, atom) <- ("delta", 69, :done);
        (name: string, k: int64, tag: atom) <- t;
        print_string(name);
        println("");
        print_int64(k);
        println("");
        print_atom(tag);
        println("")
        produces pure :ok end
}
