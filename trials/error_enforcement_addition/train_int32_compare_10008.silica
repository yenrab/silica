// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 51 > 8);
        println("");
        _: atom <- print_bool(32 * 26 != 54 % 13);
        println("");
        _: atom <- print_bool((14 + 57) != 11 * 23);
        println("");
        _: atom <- print_bool((55 + 42) < (42 + 13));
        println("");
        result: atom <- print_bool((7 + 20) < 3)
        produces pure result end
}
