// expected failure E2001: integer literal passed to concatenate
// concatenate of 3 pieces prints southgammaalpha

fn main() -> atom {
    sequence proc[device_io] a: string <- "south";
        b: string <- "gamma";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, 5);
        print_string(s0);
        println("")
        produces pure :ok end
}
