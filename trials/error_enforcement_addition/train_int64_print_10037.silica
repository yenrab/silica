// expected failure E2018: binding 'a' has no type annotation
// print_int64 two; prints 0 then 3
fn main() -> atom {
    sequence proc[device_io]
        a <- (6 % 2);
        b: int64 <- 14 - 11;
        _: atom <- print_int64(a);
        println("");
        result: atom <- print_int64(b)
    produces
        pure result
    end
}
