// expected failure E1045: function 'main' declared without the fn keyword
// literal patterns, a guard and a typed wildcard on uint64; v = 8 gives 31
main() -> uint64 {
    v: uint64 <- 8;
    case v of {
        15 -> 44;
        8 -> 31;
        9 -> 28;
        m: uint64 if m > 4 -> 0;
        _: uint64 -> 37
    }
}
