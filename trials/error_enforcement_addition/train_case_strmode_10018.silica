// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "silent";
    case mode of {
        "silent" -> {
            sequence proc[mem(normal)]
                print_string("silent");
                println("");
                print_int64(8);
                println("")
            produces
                pure :ok
            end
        }
        "verbose" -> {
            sequence proc[device_io]
                print_int64(9);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
