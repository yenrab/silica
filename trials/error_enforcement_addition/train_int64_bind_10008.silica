// expected failure E2003: binding k declared int16 but used as int64
// int64 bindings then expression; expect 104
fn main() -> int64 {
    k: int16 <- 21;
    a: int64 <- k % 59 % (k * 54);
    step: int64 <- (40 - a) * 31;
    height: int64 <- 9 * 47 + (a - 55);
    a + 44 + (k + 18) + step - step + height - height
}
