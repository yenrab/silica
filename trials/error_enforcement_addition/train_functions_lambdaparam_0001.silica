// expected failure E2002: undefined identifier 'num2'
// function literal passed as a parameter, capturing z; expect 36
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num2, num)
}

fn main() -> int64 {
    z: int64 <- 0;
    apply_pair(18, fn(a: int64, b: int64) -> int64 {
        a + b + z
    })
}
