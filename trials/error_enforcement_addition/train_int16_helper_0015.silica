// expected failure E3010: blend given nine parameters
// helper blend/3 on int16; blend(17, 5, 12) = 0
fn blend9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn blend(x: int16, y: int16, z: int16) -> int16 {
    ((x + y) / (z + x))
}

fn main() -> int16 {
    blend(17, 5, 12)
}
