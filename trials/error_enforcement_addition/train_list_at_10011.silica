// expected failure E3009: proc[...] written on the function return type instead of the sequence
// list_at index 5 of [26, 10, 7, 10, 9, 7] is 7
fn main() -> int64 proc[mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [26, 10, 7, 10, 9, 7];
        v: int64 <- list_at[int64, mem(normal)](xs, 5)
    produces pure v end
}
