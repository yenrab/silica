// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 140 gives 0
fn main() -> int64 {
    n: int64 <- 140;
    case n of {
        n: int64 if n -> n + 100;
        n: int64 if n >= 64 and n < 67 -> n;
        n: int64 if n >= 67 -> 0
    }
}
