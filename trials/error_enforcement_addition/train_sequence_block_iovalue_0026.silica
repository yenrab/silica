// expected failure E1055: binding 'scratch' is never used
// sequence prints and returns the same sum 29
fn main() -> int64 {
    scratch: int64 <- 41;
    sequence proc[device_io]
        a: int64 <- 29;
        b: int64 <- 0;
        print_int64(a + b);
        println("");
        total: int64 <- a + b
    produces pure total end
}
