// expected failure E2002: undefined identifier 'x2'
// four arithmetic helpers; sub(10, 3) + mul(11, 2) = 29
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x2 - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sub(10, 3) + mul(11, 2)//29
}
