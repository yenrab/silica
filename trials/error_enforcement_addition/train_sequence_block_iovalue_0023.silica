// expected failure E2003: sum bound as a boolean
// sequence prints and returns the same sum 17
fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- 15;
        b: int64 <- 2;
        print_int64(a + b);
        println("");
        total: boolean <- a + b
    produces
        pure total
    end
}
