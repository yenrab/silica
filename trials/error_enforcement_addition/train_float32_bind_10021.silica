// expected failure E2003: integer binding mixed into float arithmetic
// float32 bindings 31.0 * 12.25 printed as 379.75
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 31.0;
        b: int64 <- 12;
        result: atom <- print_float32(a * b)
    produces
        pure result
    end
}
