// expected failure E1041: trailing ';' after the pure expression
// print_int64 two; prints 58 then 49
fn main() -> atom {
    sequence proc[device_io]
        a: int64 <- 58;
        b: int64 <- 49;
        _: atom <- print_int64(a);
        println("");
        result: atom <- print_int64(b)
    produces pure result; end
}
