// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on uint16; digit_count(62) = 2
fn digit_count(n: uint16) -> uint16 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> uint16 {
    digit_count(62)
}
