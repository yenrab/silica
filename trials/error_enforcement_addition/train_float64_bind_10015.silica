// expected failure E2003: integer binding mixed into float arithmetic
// float64 bindings 25.5 + 23.5 printed as 49.0
fn main() -> atom {
    sequence proc[device_io]
        a: float64 <- 25.5;
        b: int64 <- 23;
        result: atom <- print_float64(a + b)
    produces
        pure result
    end
}
