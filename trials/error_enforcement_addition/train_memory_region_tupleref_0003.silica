// expected failure E2005: call to unknown function 'alloc_ref_all'
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: flat tuple stored in a ref and read back; expect 33
fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        t: (int64, int64, int64) <- (20, 0, 13);
        cell: ref(L1, normal, (int64, int64, int64)) <- alloc_ref_all(r, t);
        back: (int64, int64, int64) <- read_ref(cell);
        (x: int64, y: int64, z: int64) <- back;
        value: int64 <- x + y + z
    produces
        pure value
    end
}
