// expected failure E1045: function 'main' declared without the fn keyword
// guards partition int64 into three ranges; n = 9 gives 4
main() -> int64 {
    n: int64 <- 9;
    case n of {
        n: int64 if n < 46 -> n / 2;
        n: int64 if n >= 46 and n < 98 -> n;
        n: int64 if n >= 98 -> n
    }
}
