// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (32 + 24) >= 53);
        println("");
        _: atom <- print_bool((60 + 33) <= 39 / 54);
        println("");
        _: atom <- print_bool(13 >= (31 / 56));
        println("");
        _: atom <- print_bool((6 + 47) > 25 / 57);
        println("");
        result: atom <- print_bool(42 / 42 != (32 + 27))
    produces pure result end
}
