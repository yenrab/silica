// expected failure E2005: wrong argument count in call to 'first_char'
// typed `string { ... }` case arm body; want 1
fn first_char(s: string) -> string {
    case s == "" of {
        false -> string {
            c: string <- substring(s, 0, 1);
            c
        };
        true -> ""
    }
}

fn main() -> int64 {
    case first_char() == "t" of {
        true -> 1;
        false -> 0
    }
}
