// expected failure E2005: swap returns a pair but is decomposed as a triple
// swap((38, 16)); second = 38
fn swap(p: (int64, int64)) -> (int64, int64) {
    (x: int64, y: int64) <- p;
    (y, x)
}

fn main() -> int64 {
    (first: int64, second: int64, third: int64) <- swap((38, 16));
    second
}
