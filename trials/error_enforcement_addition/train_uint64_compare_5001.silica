// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 3 * 16 >= 36);
        println("");
        _: atom <- print_bool((32 + 56) < (52 % 7));
        println("");
        _: atom <- print_bool((52 + 48) > 32 % 26);
        println("");
        result: atom <- print_bool(13 != 47 * 41)
        produces pure result end
}
