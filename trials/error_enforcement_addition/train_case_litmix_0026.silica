// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 12 gives 6
fn main() -> int32 {
    v: int32 <- 12;
    case v of {
        :5 -> 9;
        14 -> 43;
        12 -> 6;
        m: int32 if m > 12 -> 24;
        _: int32 -> 34
    }
}
