// expected failure E4016: no main/0: entry function renamed to 'start'
// decompose a mixed tuple and print each element
fn start() -> atom {
    sequence proc[device_io] t: (boolean, int64, string) <- (false, 12, "actor");
        (flag: boolean, k: int64, name: string) <- t;
        print_bool(flag);
        println("");
        print_int64(k);
        println("");
        print_string(name);
        println("")
        produces pure :ok end
}
