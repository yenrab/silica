// expected failure E2018: binding 'h' has no type annotation
// 3 prepends after empty; head is 10
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](7, xs0);
        xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](32, xs1);
        xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](10, xs2);
        h <- head[int64, mem(normal)](xs3)
    produces pure h end
}
