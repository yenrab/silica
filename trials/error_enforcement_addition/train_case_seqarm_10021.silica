// expected failure E2018: binding 'v' has no type annotation
// case inside a sequence chooses what to print
fn main() -> atom {
    flag: boolean <- false;
    sequence proc[device_io]
        v <- case flag of {
            true -> 2;
            false -> 4
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
