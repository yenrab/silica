// expected failure E4016: no main/0: entry function renamed to 'mainx'
// named function passed as a value; apply(succ, 4) = 5
fn twice(x: int64) -> int64 {
    x * 2
}

fn succ(x: int64) -> int64 {
    x + 1
}

fn apply(f: fn(int64) -> int64, v: int64) -> int64 {
    f(v)
}

fn mainx() -> int64 {
    apply(succ, 4)
}
