// expected failure E2018: binding 'a' has no type annotation
// float32 bindings 38.0 + 37.375 printed as 75.375
fn main() -> atom {
    sequence proc[device_io]
        a <- 38.0;
        b: float32 <- 37.375;
        result: atom <- print_float32(a + b)
    produces
        pure result
    end
}
