// expected failure E1055: binding 'scratch' is never used
// negate_float32 applied 3 time(s); prints -8.0
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        result: atom <- print_float32(negate_float32(negate_float32(negate_float32(8.0))))
    produces
        pure result
    end
}
