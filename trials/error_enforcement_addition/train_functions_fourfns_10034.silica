// expected failure E1042: function 'add' has no return type
// four arithmetic helpers; mul(14, 9) + add(25, 6) = 157
fn add(x: int64, y: int64) -> {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    mul(14, 9) + add(25, 6)//157
}
