// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 41 gives 40
fn main() -> int64 {
    n: int64 <- 41;
    case n of {
        n: int64 if n < 46 -> "n - 1";
        n: int64 if n >= 46 and n < 82 -> n - 1;
        n: int64 if n >= 82 -> n
    }
}
