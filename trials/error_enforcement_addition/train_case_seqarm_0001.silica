// expected failure E2001: case arms disagree with the binding's int64 type
// case inside a sequence chooses what to print
fn main() -> atom {
    flag: boolean <- false;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 8;
            false -> "8"
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
