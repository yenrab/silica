// expected failure E4016: no main/0: entry function renamed to 'main_program'
// case scrutinee is a tuple-returning call; expect 26
fn pair(n: int64) -> (int64, int64) {
    (n, n + 1)
}

fn main_program() -> int64 {
    case pair(5) of {
        t: (int64, int64) -> {
            (x: int64, y: int64) <- t;
            x + y + 15
        }
    }
}
