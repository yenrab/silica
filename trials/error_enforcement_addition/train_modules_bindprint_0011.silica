// expected failure E1047: named struct declaration 'Pair' is not allowed
// qualified call bound then printed; prints 19
use lib_alpha;

struct Pair { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io] v: int64 <- lib_alpha@bump(18);
        result: atom <- print_int64(v)
        produces pure result end
}
