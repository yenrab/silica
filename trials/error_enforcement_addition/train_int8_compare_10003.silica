// expected failure E3009: proc[...] written on the function return type instead of the sequence
// int8 comparisons printed with print_bool
fn main() -> atom proc[device_io] {
    sequence proc[device_io]
        _: atom <- print_bool(49 != (30 + 24));
        println("");
        _: atom <- print_bool(18 >= 37 / 50);
        println("");
        _: atom <- print_bool(32 > 44 / 17);
        println("");
        _: atom <- print_bool((59 + 22) != 18);
        println("");
        result: atom <- print_bool((53 - 42) != 12 / 60)
    produces
        pure result
    end
}
