// expected failure E2001: integer literal passed to concat
// concat of 4 pieces prints omegachair日本語日本語

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "omega";
        b: string <- "chair";
        s: string <- concat(a, b);
        s0: string <- concat(s, 3);
        s1: string <- concat(s0, "日本語");
        print_string(s1);
        println("")
    produces
        pure :ok
    end
}
