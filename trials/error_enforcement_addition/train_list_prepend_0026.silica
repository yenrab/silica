    sequence proc[mem(normal)]
        xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](39, xs0);
        xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](32, xs1);
        xs3: List[int32, mem(normal)] <- prepend[int32, mem(normal)](18, xs2);
        xs4: List[int32, mem(normal)] <- prepend[int32, mem(normal)](11, xs3);
        xs5: List[int32, mem(normal)] <- prepend[int32, mem(normal)](24, xs4);
        n: int64 <- length[int32, mem(normal)](xs5)
