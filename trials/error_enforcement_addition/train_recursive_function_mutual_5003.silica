// expected failure E2005: wrong argument count in call to 'odd'
// mutual recursion even/odd; even(12) + odd(0) = 1
fn even(n: int64) -> int64 {
    case n == 0 of {
        true -> 1;
        false -> odd()
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

fn main() -> int64 {
    even(12) + odd(0)
}
