// expected failure E1055: binding 'scratch' is never used
// print_int64 two; prints 19 then 12
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io] a: int64 <- 19;
        b: int64 <- 12 % 35;
        _: atom <- print_int64(a);
        println("");
        result: atom <- print_int64(b)
        produces pure result end
}
