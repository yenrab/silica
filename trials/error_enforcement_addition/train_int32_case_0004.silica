// expected failure E2001: string literal in one case arm of an integer case
// case on int32 value 39; expect 15
fn main() -> int32 {
    v: int32 <- 39;
    case v of {
        5 -> "139";
        39 -> 15;
        13 -> 51;
        8 -> 113;
        n: int32 if n > 1 -> 158;
        _: int32 -> 58
    }
}
