// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// Positive: pure helper chosen from a case arm; the effect runs in the sequence body
fn pick_value(flag: boolean) -> int64 {
    case flag of {
        true -> 7;
        false -> 7
    }
}

fn main() -> atom {
    flag: boolean <- true;
    sequence proc[mem(normal)]
        v: int64 <- pick_value(flag);
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
