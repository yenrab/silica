// expected failure E1045: function 'main' declared without the fn keyword
// list literal of 3 uint32 elements; length is 3
main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[uint32, mem(normal)] <- [5, 19, 12];
        n: int64 <- length[uint32, mem(normal)](xs)
    produces
        pure n
    end
}
