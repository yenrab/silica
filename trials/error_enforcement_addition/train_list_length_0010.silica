// expected failure E2001: string element inside an integer list literal
// list literal of 4 int64 elements; length is 4
fn main() -> int64 {
    sequence proc[mem(normal_writethrough)] xs: List[int64, mem(normal_writethrough)] <- ["5", 21, 21, 19];
        n: int64 <- length[int64, mem(normal_writethrough)](xs)
        produces pure n end
}
