// expected failure E2003: blend returns float16 but its result feeds print_float32
// float32 helper blend; prints 92.25
fn blend(x: float32) -> float16 {
    x * 2.5 + 4.75
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float32(blend(35.0))
        produces pure result end
}
