module dangerous_external_danger_at_spawn_site;

use dangerous_legacy_stub;

fn ffi_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger]
        _: int64 <- dangerous_legacy_stub@add(msg, state)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[external_danger, concurrency]
        _: dangerous_actor_ref <- spawn_dangerous(0, ffi_worker)
    produces
        pure 0
    end
}
