module dangerous_cast_registered_on_dangerous_atom;

use dangerous_legacy_stub;

fn ffi_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger]
        _: int64 <- dangerous_legacy_stub@add(msg, state)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        _: dangerous_actor_ref <- spawn_dangerous_registered(0, ffi_worker, :dangerous_worker);
        _: boolean <- cast_registered(:dangerous_worker, 2 impl ActorMessage {})
    produces
        pure 0
    end
}
