module dangerous_spawn_registered_bad_atom;

use dangerous_legacy_stub;

fn ffi_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger]
        _: int64 <- dangerous_legacy_stub@add(msg, state)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        _: dangerous_actor_ref <- spawn_dangerous_registered(0, ffi_worker, :bad_worker_name)
    produces
        pure 0
    end
}
