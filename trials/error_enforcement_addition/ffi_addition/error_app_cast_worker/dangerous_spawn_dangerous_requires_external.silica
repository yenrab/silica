module dangerous_spawn_dangerous_requires_external;

fn worker_behavior(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        worker_ref: dangerous_actor_ref <- spawn_dangerous(0, worker_behavior)
    produces
        pure 0
    end
}
