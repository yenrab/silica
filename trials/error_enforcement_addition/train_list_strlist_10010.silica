// expected failure E3002: device_io used but only mem(normal) declared
// join_all over a list of strings
fn join_all(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, t: List[string, mem(normal)]] -> concatenate(h, join_all(t));
        _: List[string, mem(normal)] -> ""
    }
}

fn main() -> atom {
    sequence proc[mem(normal)]
        xs: List[string, mem(normal)] <- ["beta", "north"];
        s: string <- join_all(xs);
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
