// expected failure E2005: call to unknown function 'negate_float6z'
// negate_float64 applied 3 time(s); prints -30.375
fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(negate_float64(negate_float6z(negate_float64(30.375))))
    produces
        pure result
    end
}
