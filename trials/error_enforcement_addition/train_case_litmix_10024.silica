// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int64; v = 0 gives 9
fn main() -> int64 {
    v: int64 <- 0;
    case v of {
        :0 -> 9;
        9 -> 3;
        15 -> 33;
        m: int64 if m > 10 -> 49;
        _: int64 -> 28
    }
}
