// expected failure E1043: whitespace between binding name 'result' and ':'
// print_int16 two; prints 46 then 34
fn main() -> atom {
    sequence proc[device_io]
        a: int16 <- 46;
        b: int16 <- 13 + 21;
        _: atom <- print_int16(a);
        println("");
        result :atom <- print_int16(b)
    produces pure result end
}
