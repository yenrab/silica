// expected failure E2018: binding 'result' has no type annotation
// float16 helper half_sum; prints 59.0
fn half_sum(x: float16) -> float16 {
    x + 21.75 + 4.75
}

fn main() -> atom {
    sequence proc[device_io]
        result <- print_float16(half_sum(32.5))
    produces
        pure result
    end
}
