// expected failure E1042: function 'main' has no return type
// print_uint8 two; prints 77 then 4
fn main() {
    sequence proc[device_io] a: uint8 <- 32 + 45;
        b: uint8 <- 27 % 23;
        _: atom <- print_uint8(a);
        println("");
        result: atom <- print_uint8(b)
        produces pure result end
}
