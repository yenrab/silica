    temp_val: int64 <- 41;
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 95;
            false -> 63
        };
        false -> case b of {
            true -> 1;
            false -> 86
        }
    }
}
