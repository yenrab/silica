// expected failure E2003: integer binding mixed into float arithmetic
// float64 bindings 19.0 - 16.0 printed as 3.0
fn main() -> atom {
    sequence proc[device_io]
        a: float64 <- 19.0;
        b: int64 <- 16;
        result: atom <- print_float64(a - b)
    produces
        pure result
    end
}
