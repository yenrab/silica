// expected failure E2018: binding 'v' has no type annotation
// literal patterns, a guard and a typed wildcard on int64; v = 12 gives 36
fn main() -> int64 {
    v <- 12;
    case v of {
        5 -> 10;
        9 -> 6;
        1 -> 50;
        m: int64 if m > 3 -> 36;
        _: int64 -> 34
    }
}
