// expected failure E4015: function 'gcd' defined twice
// Euclid's gcd; gcd(110, 15) = 5
fn gcd(a: int64, b: int64) -> int64 {
    case b == 0 of {
        true -> a;
        false -> gcd(b, a % b)
    }
}

fn gcd(a: int64, b: int64) -> int64 {
    case b == 0 of {
        true -> a;
        false -> gcd(b, a % b)
    }
}

fn main() -> int64 {
    gcd(110, 15)
}
