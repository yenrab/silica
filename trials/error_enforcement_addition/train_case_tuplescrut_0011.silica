// expected failure E1045: function 'pair' declared without the fn keyword
// case scrutinee is a tuple-returning call; expect 45
pair(n: int64) -> (int64, int64) {
    (n, n + 1)
}

fn main() -> int64 {
    case pair(17) of {
        t: (int64, int64) -> {
            (x: int64, y: int64) <- t;
            x + y + 10
        }
    }
}
