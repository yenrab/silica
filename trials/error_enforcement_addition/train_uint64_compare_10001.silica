// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 3 % 2 != 22);
        println("");
        result: atom <- print_bool(26 * 50 < 21)
    produces
        pure result
    end
}
