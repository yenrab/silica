// expected failure E2018: binding 'result' has no type annotation
// chained print_uint64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint64(7);
        println("");
        _: atom <- print_uint64(1 * 25);
        println("");
        result <- print_uint64(45)
    produces pure result end
}
