// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// substring_until_char from 0 up to '|'
fn main() -> atom {
    sequence proc[mem(normal)] s: string <- substring_until_char("stone|river|chair|gamma", 0, '|');
        print_string(s);
        println("")
        produces pure :ok end
}
