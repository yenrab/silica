// expected failure E1042: function 'main' has no return type
// print_int32 two; prints 1 then 20
fn main() -> {
    sequence proc[device_io] a: int32 <- 56 % 55;
        b: int32 <- 20;
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
        produces pure result end
}
