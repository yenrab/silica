// expected failure E2018: binding 'a' has no type annotation
// comments must stop at the newline; want 7
// whole-line comment before the function
fn main() -> int64 {
    a <- 12; // end-of-line after a binding
    // whole-line comment between statements
    b: int64 <- 8; // another
    a / b + 6 // end-of-line after the return expression
}
