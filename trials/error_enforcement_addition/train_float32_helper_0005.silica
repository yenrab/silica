// expected failure E2003: blend returns float64 but its result feeds print_float32
// float32 helper blend; prints -21.375
fn blend(x: float32) -> float64 {
    x - 36.125 + 2.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(blend(12.25))
    produces
        pure result
    end
}
