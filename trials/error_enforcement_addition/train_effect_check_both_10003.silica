// expected failure E1042: function 'main' has no return type
// Positive: both device_io and mem(normal) declared and used in one sequence
fn main() {
    sequence proc[device_io, mem(normal)]
        xs: List[int64, mem(normal)] <- [35, 34, 13, 17, 7];
        n: int64 <- length[int64, mem(normal)](xs);
        result: atom <- print_int64(n)
    produces
        pure result
    end
}
