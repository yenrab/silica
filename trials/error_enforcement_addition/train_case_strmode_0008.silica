// expected failure E1045: function 'main' declared without the fn keyword
// string case with an effectful sequence in each arm
main() -> atom {
    mode: string <- "trace";
    case mode of {
        "trace" -> {
            sequence proc[device_io]
                print_string("trace");
                println("");
                print_int64(7);
                println("")
            produces
                pure :ok
            end
        }
        "silent" -> {
            sequence proc[device_io]
                print_int64(4);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
