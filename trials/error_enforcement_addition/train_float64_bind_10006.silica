// expected failure E2003: a declared float32 but combined with a float64 value
// float64 bindings 8.5 + 22.5 printed as 31.0
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 8.5;
        b: float64 <- 22.5;
        result: atom <- print_float64(a + b)
    produces pure result end
}
