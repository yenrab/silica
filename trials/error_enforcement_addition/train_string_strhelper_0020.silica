// expected failure E2001: integer literal returned from a string-typed arm
// string helper shout; prints stone!!

fn shout(s: string, n: int64) -> string {
    case n == 0 of {
        true -> 0;
        false -> concatenate(shout(s, n - 1), "!")
    }
}

fn main() -> atom {
    sequence proc[device_io]
        print_string(shout("stone", 2));
        println("")
    produces pure :ok end
}
