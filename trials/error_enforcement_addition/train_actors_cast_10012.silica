// expected failure E2005: cast payload lacks the ActorMessage marker
// Spec §16.1.2: cast enqueues asynchronously and returns boolean; behavior returns (:no_reply, new_state)
fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(6, sink);
        enqueued: boolean <- cast(w, 7);
        print_bool(enqueued);
        println("")
    produces
        pure :ok
    end
}
