// expected failure E4016: no main/0: entry function renamed to 'main_program'
// negate_float64 applied 3 time(s); prints -1.5
fn main_program() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(negate_float64(negate_float64(negate_float64(1.5))))
    produces pure result end
}
