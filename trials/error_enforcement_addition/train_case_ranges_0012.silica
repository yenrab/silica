// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 111 gives 211
fn main() -> int64 {
    n: int64 <- 111;
    case n of {
        n: int64 if n -> n / 2;
        n: int64 if n >= 11 and n < 38 -> n - 1;
        n: int64 if n >= 38 -> n + 100
    }
}
