// expected failure E4015: function 'digit_sum' defined twice
// digit_sum(1701) = 9
fn digit_sum(n: int64) -> int64 {
    case n < 10 of {
        true -> n;
        false -> n % 10 + digit_sum(n / 10)
    }
}

fn digit_sum(n: int64) -> int64 {
    case n < 10 of {
        true -> n;
        false -> n % 10 + digit_sum(n / 10)
    }
}

fn main() -> int64 {
    digit_sum(1701)
}
