// expected failure E1047: named struct declaration 'Pair' is not allowed
// Positive: list allocation requires sequence proc[mem(normal_writethrough)] (spec §9.3.1)
struct Pair { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[mem(normal_writethrough)]
        xs: List[int64, mem(normal_writethrough)] <- [35, 30, 11, 24];
        n: int64 <- length[int64, mem(normal_writethrough)](xs)
    produces pure n end
}
