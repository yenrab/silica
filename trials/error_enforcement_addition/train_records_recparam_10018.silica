// expected failure E2005: call to unknown function 'my_make_rect'
// record passed to a function; area(make_rect(10, 5)) = 50
fn make_rect(w: int64, h: int64) -> { width: int64, height: int64 } {
    { width: w, height: h }
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

fn main() -> int64 {
    area(my_make_rect(10, 5))
}
