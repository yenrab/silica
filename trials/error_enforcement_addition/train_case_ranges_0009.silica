// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 149 gives 148
fn main() -> int64 {
    n: int64 <- 149;
    case n of {
        n: int64 if n < 27 -> "n";
        n: int64 if n >= 27 and n < 44 -> n * 2;
        n: int64 if n >= 44 -> n - 1
    }
}
