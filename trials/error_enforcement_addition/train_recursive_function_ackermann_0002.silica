// expected failure E2005: wrong argument count in call to 'ack'
// Ackermann A(0, 3) = 4
fn ack_nonzero(m: int64, n: int64) -> int64 {
    case n == 0 of {
        true -> ack(m - 1, 1);
        false -> ack(m - 1, ack(m))
    }
}

fn ack(m: int64, n: int64) -> int64 {
    case m == 0 of {
        true -> n + 1;
        false -> ack_nonzero(m, n)
    }
}

fn main() -> int64 {
    ack(0, 3)
}
