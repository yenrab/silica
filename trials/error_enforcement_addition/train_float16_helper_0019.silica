// expected failure E2018: binding 'result' has no type annotation
// float16 helper half_sum; prints -24.5
fn half_sum(x: float16) -> float16 {
    x - 38.0 + 3.5
}

fn main() -> atom {
    sequence proc[device_io]
        result <- print_float16(half_sum(10.0))
    produces
        pure result
    end
}
