// expected failure E2003: print_uint64 result bound as int64 instead of atom
// chained print_uint64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint64(38);
        println("");
        _: atom <- print_uint64(4);
        println("");
        _: atom <- print_uint64(22);
        println("");
        result: atom <- print_uint64(34)
    produces
        pure result
    end
}
