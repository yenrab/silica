// expected failure E2001: string literal passed to print_int64 inside a nested arm
// Positive: device_io only in a nested case arm inside sequence proc[device_io] still counts as used
fn main() -> atom {
    outer: int64 <- 2;
    inner: int64 <- 2;
    sequence proc[device_io]
        result: atom <- case outer of {
            0 -> print_int64(1);
            _: int64 -> case inner of {
                2 -> print_int64("7");
                _: int64 -> print_int64(6)
            }
        }
    produces
        pure result
    end
}
