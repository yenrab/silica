// expected failure E2003: string binding used where an integer is expected
// concatenate of 2 pieces prints 日本語ñandú

fn main() -> atom {
    sequence proc[device_io] a: string <- "日本語";
        b: string <- "ñandú";
        s: string <- concatenate(a, b);
        print_int64(s);
        println("")
        produces pure :ok end
}
