// expected failure E1047: named struct declaration 'Node' is not allowed
// print each field of a mixed record
struct Node { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io] person: { name: string, age: int64, active: boolean } <- { name: "delta", age: 93, active: true };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
        produces pure :ok end
}
