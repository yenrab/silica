// expected failure E1050: produces clause without pure
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(38 % 29 < 60);
        println("");
        _: atom <- print_bool(1 / 23 <= 16 * 2);
        println("");
        _: atom <- print_bool((25 + 5) >= 60);
        println("");
        result: atom <- print_bool(39 <= (16 + 38))
    produces result end
}
