// expected failure E1055: binding 'unused_value' is never used
// pure sequence inside a helper; churn(2) = 10
fn churn(n: int64) -> int64 {
    unused_value: int64 <- 41;
    sequence
        a: string <- concatenate("xx", "yy");
        b: string <- concatenate(a, a)
    produces
        pure length_bytes(b) + n
    end
}

fn main() -> int64 {
    churn(2)
}
