// expected failure E2003: string binding used where an integer is expected
// concat of 4 pieces prints riverbananañandúbanana

fn main() -> atom {
    sequence proc[device_io] a: string <- "river";
        b: string <- "banana";
        s: string <- concat(a, b);
        s0: string <- concat(s, "ñandú");
        s1: string <- concat(s0, "banana");
        print_int64(s1);
        println("")
        produces pure :ok end
}
