// expected failure E2001: atom literal returned from the recursion base case
// recursive steps on uint16; steps(5, 0) = 5
fn steps(n: uint16, acc: uint16) -> uint16 {
    case n == 0 of {
        true -> :done;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint16 {
    steps(5, 0)
}
