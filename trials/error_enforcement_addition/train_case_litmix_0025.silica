// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on uint8; v = 12 gives 25
fn main() -> uint8 {
    v: uint8 <- 12;
    case v of {
        :12 -> 25;
        1 -> 48;
        2 -> 36;
        m: uint8 if m > 7 -> 2;
        _: uint8 -> 49
    }
}
