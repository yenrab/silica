// expected failure E1055: binding 'spare' is never used
// list_at index 0 of [12, 35, 25, 4, 39] is 12
fn main() -> int64 {
    spare: int64 <- 41;
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [12, 35, 25, 4, 39];
        v: int64 <- list_at[int64, mem(normal)](xs, 0)
    produces pure v end
}
