// expected failure E1055: binding 'temp_val' is never used
// case producing atoms then case dispatching on them; grade(20) -> 2
fn grade(n: int64) -> atom {
    temp_val: int64 <- 41;
    case n of {
        0 -> :zero;
        k: int64 if k < 2 -> :low;
        _: int64 -> :high
    }
}

fn main() -> int64 {
    g: atom <- grade(20);
    case g of {
        :zero -> 0;
        :low -> 1;
        :high -> 2;
        _: atom -> 9
    }
}
