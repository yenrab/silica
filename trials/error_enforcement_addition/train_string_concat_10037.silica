// expected failure E2005: call to unknown function 'my_concat'
// concat of 3 pieces prints 🎉Zürichnorth

fn main() -> atom {
    sequence proc[device_io] a: string <- "🎉";
        b: string <- "Zürich";
        s: string <- my_concat(a, b);
        s0: string <- concat(s, "north");
        print_string(s0);
        println("")
        produces pure :ok end
}
