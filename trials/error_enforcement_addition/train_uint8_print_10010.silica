// expected failure E2018: binding 'result' has no type annotation
// print_uint8 two; prints 32 then 42
fn main() -> atom {
    sequence proc[device_io]
        a: uint8 <- 12 + 20;
        b: uint8 <- 42;
        _: atom <- print_uint8(a);
        println("");
        result <- print_uint8(b)
    produces
        pure result
    end
}
