// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 18 * 2 >= 30);
        println("");
        _: atom <- print_bool((31 % 57) < 47 * 53);
        println("");
        result: atom <- print_bool(30 > (10 + 32))
    produces
        pure result
    end
}
