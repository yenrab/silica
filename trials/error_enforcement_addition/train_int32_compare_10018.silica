// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 59 <= 58);
        println("");
        _: atom <- print_bool(15 * 57 == (28 + 24));
        println("");
        _: atom <- print_bool((40 + 21) != 15 * 3);
        println("");
        result: atom <- print_bool((37 + 14) >= (52 + 18))
    produces pure result end
}
