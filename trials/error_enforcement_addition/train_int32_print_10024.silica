// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// print_int32 two; prints 52 then 65
fn main() -> atom {
    sequence proc[mem(normal)]
        a: int32 <- 11 + 41;
        b: int32 <- 11 + 54;
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
    produces
        pure result
    end
}
