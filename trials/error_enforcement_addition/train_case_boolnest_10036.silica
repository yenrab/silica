// expected failure E1045: function 'main' declared without the fn keyword
// nested boolean cases; (true, true) selects 19
main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 19;
            false -> 49
        };
        false -> case b of {
            true -> 19;
            false -> 22
        }
    }
}
