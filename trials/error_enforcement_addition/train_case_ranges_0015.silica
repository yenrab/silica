// expected failure E4016: no main/0: entry function renamed to 'start'
// guards partition int64 into three ranges; n = 7 gives 6
fn start() -> int64 {
    n: int64 <- 7;
    case n of {
        n: int64 if n < 39 -> n - 1;
        n: int64 if n >= 39 and n < 77 -> n;
        n: int64 if n >= 77 -> 0
    }
}
