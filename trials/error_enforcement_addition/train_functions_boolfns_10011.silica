// expected failure E2001: integer literal passed where bit expects a boolean
// boolean helpers combined into bits; expect 2
fn bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main() -> int64 {
    bit(1, 1) + bit(ff() or tt(), 2) + bit(ff() or ff(), 4)
}
