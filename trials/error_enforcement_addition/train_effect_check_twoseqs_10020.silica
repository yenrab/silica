// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// Positive: two sequences with separate effect declarations in one function
fn main() -> int64 {
    sequence proc[mem(normal)]
        print_int64(5);
        println("")
    produces pure :ok end;
    n: int64 <- sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [5, 2]
    produces
        pure length[int64, mem(normal)](xs)
    end;
    n
}
