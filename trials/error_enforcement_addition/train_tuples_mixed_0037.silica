// expected failure E1055: binding 'scratch' is never used
// decompose a mixed tuple and print each element
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        t: (int64, string, boolean) <- (51, "beta", false);
        (k: int64, name: string, flag: boolean) <- t;
        print_int64(k);
        println("");
        print_string(name);
        println("");
        print_bool(flag);
        println("")
    produces
        pure :ok
    end
}
