// expected failure E1050: produces clause without pure
// print_int8 two; prints 40 then 11
fn main() -> atom {
    sequence proc[device_io] a: int8 <- 40;
        b: int8 <- 11;
        _: atom <- print_int8(a);
        println("");
        result: atom <- print_int8(b)
        produces result end
}
