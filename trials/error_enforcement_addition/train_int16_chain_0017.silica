// expected failure E2003: print_int16 result bound as int64 instead of atom
// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] n_out: int64 <- print_int16(28);
        println("");
        _: atom <- print_int16(60);
        println("");
        _: atom <- print_int16((36 + 10));
        println("");
        result: atom <- print_int16((7 / 18))
        produces pure result end
}
