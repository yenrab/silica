// expected failure E1042: function 'main' has no return type
// Ackermann A(3, 1) = 13
fn ack_nonzero(m: int64, n: int64) -> int64 {
    case n == 0 of {
        true -> ack(m - 1, 1);
        false -> ack(m - 1, ack(m, n - 1))
    }
}

fn ack(m: int64, n: int64) -> int64 {
    case m == 0 of {
        true -> n + 1;
        false -> ack_nonzero(m, n)
    }
}

fn main() -> {
    ack(3, 1)
}
