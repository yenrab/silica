// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int64; v = 2 gives 15
fn main() -> int64 {
    v: int64 <- 2;
    case v of {
        :3 -> 44;
        15 -> 46;
        8 -> 13;
        m: int64 if m > 9 -> 18;
        _: int64 -> 15
    }
}
