// expected failure E2003: print_int32 result bound as int64 instead of atom
// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io] n_out: int64 <- print_int32(6 * (52 % 50));
        println("");
        _: atom <- print_int32(23 / 39);
        println("");
        _: atom <- print_int32(48 + 36);
        println("");
        result: atom <- print_int32(41)
        produces pure result end
}
