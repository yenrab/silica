// expected failure E1055: binding 'temp_val' is never used
// case inside a sequence chooses what to print
fn main() -> atom {
    temp_val: int64 <- 41;
    flag: boolean <- false;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 8;
            false -> 9
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
