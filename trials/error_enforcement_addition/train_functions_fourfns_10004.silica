// expected failure E4015: the mul helper is defined twice
// four arithmetic helpers; mul(25, 2) + add(26, 7) + div(20, 6) + sub(11, 7) = 90
fn add(x: int64, y: int64) -> int64 {
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    mul(25, 2) + add(26, 7) + div(20, 6) + sub(11, 7)//90
}
