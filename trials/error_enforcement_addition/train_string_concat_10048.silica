// expected failure E2003: string binding used where an integer is expected
// concatenate of 4 pieces prints cherrynaïveriveralpha

fn main() -> atom {
    sequence proc[device_io]
        s: string <- concatenate(concatenate(concatenate("cherry", "naïve"), "river"), "alpha");
        print_int64(s);
        println("")
    produces
        pure :ok
    end
}
