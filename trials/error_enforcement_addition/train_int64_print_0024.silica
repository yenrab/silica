// expected failure E1055: binding 'scratch' is never used
// print_int64 two; prints 101 then 7
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        a: int64 <- 51 + 50;
        b: int64 <- 31 % 24;
        _: atom <- print_int64(a);
        println("");
        result: atom <- print_int64(b)
    produces pure result end
}
