// expected failure E2003: a declared float32 but combined with a float16 value
// float16 bindings 40.5 + 14.75 printed as 55.25
fn main() -> atom {
    sequence proc[device_io] a: float32 <- 40.5;
        b: float16 <- 14.75;
        result: atom <- print_float16(a + b)
        produces pure result end
}
