// expected failure E2003: shift amount taken from a boolean binding
// set, test and clear bit 1 of a uint64 word; expect 1
fn main() -> uint64 {
    one: uint64 <- 1;
    zero: uint64 <- 0;
    bit_index: boolean <- true;
    mask: uint64 <- one shl bit_index;
    word: uint64 <- zero bor mask;
    present: uint64 <- (word band mask) shr bit_index;
    cleared: uint64 <- word band (bnot mask);
    present + cleared
}
