// expected failure E1042: function 'main' has no return type
// uint16 comparisons printed with print_bool
fn main() -> {
    sequence proc[device_io]
        _: atom <- print_bool(12 / 34 > 23);
        println("");
        _: atom <- print_bool((23 - 0) > 48 / 44);
        println("");
        result: atom <- print_bool(45 * 10 > (10 % 13))
    produces
        pure result
    end
}
