// expected failure E3002: device_io used in an arm whose sequence declares mem(normal)
// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "quiet";
    case mode of {
        "verbose" -> {
            sequence proc[device_io]
                print_string("verbose");
                println("");
                print_int64(6);
                println("")
            produces
                pure :ok
            end
        }
        "quiet" -> {
            sequence proc[mem(normal)]
                print_int64(9);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
