// expected failure E1055: binding 'spare' is never used
// substring_until_char from 0 up to ';'
fn main() -> atom {
    spare: int64 <- 41;
    sequence proc[device_io]
        s: string <- substring_until_char("apple;banana", 0, ';');
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
