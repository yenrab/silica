// expected failure E2003: prepend called with its arguments swapped
// 1 prepends after empty; head is 4
fn main() -> uint32 {
    sequence proc[mem(normal)] xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
        xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](xs0, 4);
        h: uint32 <- head[uint32, mem(normal)](xs1)
        produces pure h end
}
