// expected failure E2003: shift returns float64 but its result feeds print_float16
// float16 helper shift; prints 179.0
fn shift(x: float16) -> float64 {
    x * 35.5 + 1.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(shift(5.0))
    produces
        pure result
    end
}
