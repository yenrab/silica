// expected failure E1055: binding 'scratch' is never used
// recursive steps on uint32; steps(9, 0) = 9
fn steps(n: uint32, acc: uint32) -> uint32 {
    scratch: int64 <- 41;
    case n == 0 of {
        true -> acc;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint32 {
    steps(9, 0)
}
