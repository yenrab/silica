// expected failure E2005: call to unknown function 'grade_all'
// case producing atoms then case dispatching on them; grade(18) -> 2
fn grade(n: int64) -> atom {
    case n of {
        0 -> :zero;
        k: int64 if k < 4 -> :low;
        _: int64 -> :high
    }
}

fn main() -> int64 {
    g: atom <- grade_all(18);
    case g of {
        :zero -> 0;
        :low -> 1;
        :high -> 2;
        _: atom -> 9
    }
}
