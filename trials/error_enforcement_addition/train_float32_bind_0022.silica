// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// float32 bindings 35.0 * 34.375 printed as 1203.125
fn main() -> atom {
    sequence proc[device_io, mem(normal)]
        a: float32 <- 35.0;
        b: float32 <- 34.375;
        result: atom <- print_float32(a * b)
    produces
        pure result
    end
}
