// expected failure E1055: binding 'scratch' is never used
// four arithmetic helpers; sub(22, 5) + add(29, 8) + div(18, 5) = 57
fn add(x: int64, y: int64) -> int64 {
    scratch: int64 <- 41;
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sub(22, 5) + add(29, 8) + div(18, 5)//57
}
