// expected failure E2005: decomposition of a pair into three names
// minmax returns a pair; p + q = 35
fn minmax(x: int64, y: int64) -> (int64, int64) {
    case x < y of {
        true -> (x, y);
        false -> (y, x)
    }
}

fn main() -> int64 {
    (p: int64, q: int64, r: int64) <- minmax(6, 29);
    p + q
}
