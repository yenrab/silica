// expected failure E2003: a declared float16 but combined with a float64 value
// float64 bindings 1.0 * 13.25 printed as 13.25
fn main() -> atom {
    sequence proc[device_io]
        a: float16 <- 1.0;
        b: float64 <- 13.25;
        result: atom <- print_float64(a * b)
    produces pure result end
}
