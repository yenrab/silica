// expected failure E2003: string binding used where an integer is expected
// concat of 4 pieces prints northworldnorthñandú

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "north";
        b: string <- "world";
        s: string <- concat(a, b);
        s0: string <- concat(s, "north");
        s1: string <- concat(s0, "ñandú");
        print_int64(s1);
        println("")
    produces pure :ok end
}
