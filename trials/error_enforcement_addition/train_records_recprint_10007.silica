// expected failure E2005: call to unknown function 'print_int64_all'
// print each field of a mixed record
fn main() -> atom {
    sequence proc[device_io]
        person: { name: string, age: int64, active: boolean } <- { name: "river", age: 82, active: false };
        print_string(person.name);
        println("");
        print_int64_all(person.age);
        println("");
        print_bool(person.active);
        println("")
    produces pure :ok end
}
