// expected failure E2005: decomposition pattern element types in the wrong order
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t: (string, int64, atom) <- ("cherry", 3, :done);
        (name: int64, k: string, tag: atom) <- t;
        print_string(name);
        println("");
        print_int64(k);
        println("");
        print_atom(tag);
        println("")
    produces
        pure :ok
    end
}
