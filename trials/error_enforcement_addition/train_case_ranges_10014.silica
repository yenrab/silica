// expected failure E1047: named struct declaration 'Point' is not allowed
// guards partition int64 into three ranges; n = 16 gives 15
struct Point { x: int64, y: int64 }

fn main() -> int64 {
    n: int64 <- 16;
    case n of {
        n: int64 if n < 40 -> n - 1;
        n: int64 if n >= 40 and n < 48 -> n * 2;
        n: int64 if n >= 48 -> 0
    }
}
