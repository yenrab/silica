// expected failure E1045: function 'main' declared without the fn keyword
// list_at index 0 of [21, 30] is 21
main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [21, 30];
        v: int64 <- list_at[int64, mem(normal)](xs, 0)
    produces
        pure v
    end
}
