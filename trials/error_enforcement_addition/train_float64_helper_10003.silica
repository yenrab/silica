// expected failure E2003: scale returns float32 but its result feeds print_float64
// float64 helper scale; prints 38.375
fn scale(x: float64) -> float32 {
    x + 2.5 + 0.375
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(scale(35.5))
    produces pure result end
}
