// expected failure E1055: binding 'temp_val' is never used
// Positive: list allocation requires sequence proc[mem(normal)] (spec §9.3.1)
fn main() -> int64 {
    temp_val: int64 <- 41;
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [8, 19];
        n: int64 <- length[int64, mem(normal)](xs)
    produces
        pure n
    end
}
