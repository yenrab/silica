// expected failure E2003: scale returns float64 but its result feeds print_float16
// float16 helper scale; prints 29.75
fn scale(x: float16) -> float64 {
    x - 7.0 + 2.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(scale(34.75))
    produces pure result end
}
