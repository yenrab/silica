// expected failure E2005: recursive call with the wrong argument count
// tail-recursive factorial; factorial_acc(5, 1) = 120
fn factorial_acc(n: int64, acc: int64) -> int64 {
    case n <= 1 of {
        true -> acc;
        false -> factorial_acc(n - 1)
    }
}

fn main() -> int64 {
    factorial_acc(5, 1)
}
