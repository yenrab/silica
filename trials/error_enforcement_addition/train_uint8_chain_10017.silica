// expected failure E2003: print_uint8 result bound as int64 instead of atom
// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint8(16);
        println("");
        _: atom <- print_uint8(34);
        println("");
        _: atom <- print_uint8(22 / 10);
        println("");
        result: atom <- print_uint8(46)
    produces
        pure result
    end
}
