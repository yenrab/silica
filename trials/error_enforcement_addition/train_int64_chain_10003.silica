// expected failure E2003: print_int64 result bound as int64 instead of atom
// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_int64(24 + 50 + (26 + 36));
        println("");
        _: atom <- print_int64((52 - 11));
        println("");
        _: atom <- print_int64(7 + 53);
        println("");
        result: atom <- print_int64(56 / 25)
    produces
        pure result
    end
}
