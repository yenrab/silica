// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (39 + 58) != (28 + 12));
        println("");
        _: atom <- print_bool((53 + 32) < 38);
        println("");
        result: atom <- print_bool(32 == 16 % 44)
    produces
        pure result
    end
}
