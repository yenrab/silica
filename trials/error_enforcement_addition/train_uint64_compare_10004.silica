// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 2 < (46 - 40));
        println("");
        _: atom <- print_bool(33 != (56 + 32));
        println("");
        result: atom <- print_bool(53 / 20 <= (24 + 12))
    produces pure result end
}
