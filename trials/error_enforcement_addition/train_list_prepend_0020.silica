// expected failure E2015: List type without its mem(Space)
// 1 prepends after empty; head is 18
fn main() -> uint32 {
    sequence proc[mem(normal)] xs0: List[uint32] <- empty[uint32, mem(normal)]();
        xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](18, xs0);
        h: uint32 <- head[uint32, mem(normal)](xs1)
        produces pure h end
}
