// expected failure E1045: function 'main' declared without the fn keyword
// case on a non-empty list; expect 59
main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [14, 38, 38];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 63;
            [h: int64, _: List[int64, mem(normal)]] -> h + 45;
            _: List[int64, mem(normal)] -> 63
        }
    produces
        pure r
    end
}
