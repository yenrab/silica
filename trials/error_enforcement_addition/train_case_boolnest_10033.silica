// expected failure E4016: no main/0: entry function renamed to 'mainx'
// nested boolean cases; (true, false) selects 12
fn mainx() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 69;
            false -> 12
        };
        false -> case b of {
            true -> 49;
            false -> 89
        }
    }
}
