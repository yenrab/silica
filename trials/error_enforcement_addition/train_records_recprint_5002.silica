// expected failure E1055: binding 'spare' is never used
// print each field of a mixed record
fn main() -> atom {
    spare: int64 <- 41;
    sequence proc[device_io]
        person: { name: string, age: int64, active: boolean } <- { name: "cherry", age: 26, active: true };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
    produces
        pure :ok
    end
}
