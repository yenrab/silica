// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 28 * 46 <= 22);
        println("");
        _: atom <- print_bool((22 + 31) < (34 * 18));
        println("");
        _: atom <- print_bool((55 + 33) >= 2 / 58);
        println("");
        _: atom <- print_bool((54 + 9) > 3 / 4);
        println("");
        result: atom <- print_bool((13 - 5) == (43 * 14))
    produces pure result end
}
