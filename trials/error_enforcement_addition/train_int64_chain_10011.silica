// expected failure E2003: print_int64 result bound as int64 instead of atom
// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io] n_out: int64 <- print_int64(16 / 28);
        println("");
        _: atom <- print_int64(45);
        println("");
        _: atom <- print_int64(39 + 29);
        println("");
        result: atom <- print_int64(32 % 22)
        produces pure result end
}
