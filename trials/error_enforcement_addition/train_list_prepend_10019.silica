// expected failure E2001: string element prepended to an integer list
// 4 prepends after empty; head is 7
fn main() -> int32 {
    sequence proc[mem(normal)]
        xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)]("23", xs0);
        xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](4, xs1);
        xs3: List[int32, mem(normal)] <- prepend[int32, mem(normal)](30, xs2);
        xs4: List[int32, mem(normal)] <- prepend[int32, mem(normal)](7, xs3);
        h: int32 <- head[int32, mem(normal)](xs4)
    produces
        pure h
    end
}
