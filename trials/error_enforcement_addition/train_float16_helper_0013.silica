// expected failure E2003: scale returns float32 but its result feeds print_float16
// float16 helper scale; prints 15.75
fn scale(x: float16) -> float32 {
    x - 15.5 + 1.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(scale(30.25))
    produces pure result end
}
