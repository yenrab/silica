// expected failure E3010: second sequence declares device_io it never uses
// Positive: two sequences with separate effect declarations in one function
fn main() -> int64 {
    sequence proc[device_io]
        print_int64(9);
        println("")
    produces pure :ok end;
    n: int64 <- sequence proc[mem(normal), device_io]
        xs: List[int64, mem(normal)] <- [9, 5]
    produces
        pure length[int64, mem(normal)](xs)
    end;
    n
}
