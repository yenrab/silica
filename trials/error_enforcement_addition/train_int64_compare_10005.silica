// expected failure E2018: binding 'result' has no type annotation
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((12 + 3) < 34);
        println("");
        _: atom <- print_bool((46 - 17) < 34);
        println("");
        result <- print_bool(35 != (7 + 5))
    produces pure result end
}
