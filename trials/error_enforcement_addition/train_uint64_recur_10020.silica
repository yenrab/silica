// expected failure E2001: atom literal returned from the recursion base case
// recursive steps on uint64; steps(46, 0) = 46
fn steps(n: uint64, acc: uint64) -> uint64 {
    case n == 0 of {
        true -> :done;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint64 {
    steps(46, 0)
}
