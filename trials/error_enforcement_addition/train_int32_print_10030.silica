// expected failure E1042: function 'main' has no return type
// print_int32 two; prints 9 then 22
fn main() {
    sequence proc[device_io] a: int32 <- 35 % 26;
        b: int32 <- 22 + 0;
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
        produces pure result end
}
