// expected failure E2015: list pattern without its mem(Space)
// case on a non-empty list; expect 42
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [29, 0, 7];
        r: int64 <- case xs of {
            []: List[int64] -> 26;
            [h: int64, _: List[int64, mem(normal)]] -> h + 13;
            _: List[int64, mem(normal)] -> 26
        }
    produces
        pure r
    end
}
