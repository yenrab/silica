// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// float32 helper half_sum; prints 26.5
fn half_sum(x: float32) -> float32 {
    x - 12.5 + 2.0
}

fn main() -> atom {
    sequence proc[device_io, mem(normal)] result: atom <- print_float32(half_sum(37.0))
        produces pure result end
}
