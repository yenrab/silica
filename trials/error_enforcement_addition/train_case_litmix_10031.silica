// expected failure E1055: binding 'unused_value' is never used
// literal patterns, a guard and a typed wildcard on int32; v = 14 gives 48
fn main() -> int32 {
    unused_value: int64 <- 41;
    v: int32 <- 14;
    case v of {
        12 -> 24;
        7 -> 43;
        8 -> 49;
        m: int32 if m > 9 -> 48;
        _: int32 -> 27
    }
}
