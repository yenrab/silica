// expected failure E2001: string written into an int64 ref
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: write on a ref in normal; expect 19
fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        cell: ref(L1, normal, int64) <- alloc_ref(r, "18");
        _: atom <- write_ref(cell, 19);
        value: int64 <- read_ref(cell)
    produces
        pure value
    end
}
