// expected failure E1055: binding 'spare' is never used
// float16 bindings 4.0 + 15.75 printed as 19.75
fn main() -> atom {
    spare: int64 <- 41;
    sequence proc[device_io]
        a: float16 <- 4.0;
        b: float16 <- 15.75;
        result: atom <- print_float16(a + b)
    produces
        pure result
    end
}
