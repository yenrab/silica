// expected failure E1042: function 'main' has no return type
// int16 comparisons printed with print_bool
fn main() -> {
    sequence proc[device_io]
        _: atom <- print_bool((7 + 43) != 60);
        println("");
        _: atom <- print_bool(31 <= 39 * 29);
        println("");
        result: atom <- print_bool((50 + 38) <= (13 + 3))
    produces
        pure result
    end
}
