// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on uint32; digit_count(103) = 3
fn digit_count(n: uint32) -> uint32 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> uint32 {
    digit_count(103)
}
