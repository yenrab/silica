// expected failure E4016: no main/0: entry function renamed to 'start'
// literal patterns, a guard and a typed wildcard on uint64; v = 10 gives 20
fn start() -> uint64 {
    v: uint64 <- 10;
    case v of {
        1 -> 49;
        3 -> 5;
        7 -> 15;
        m: uint64 if m > 13 -> 14;
        _: uint64 -> 20
    }
}
