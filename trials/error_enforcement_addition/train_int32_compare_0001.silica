// expected failure E1055: binding 'scratch' is never used
// int32 comparisons printed with print_bool
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_bool(32 / 21 >= 23 / 15);
        println("");
        _: atom <- print_bool(56 * 25 >= 22 / 17);
        println("");
        _: atom <- print_bool((32 - 21) > 5 % 15);
        println("");
        result: atom <- print_bool(32 / 45 > (40 + 6))
    produces pure result end
}
