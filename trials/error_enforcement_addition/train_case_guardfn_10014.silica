// expected failure E2001: helper declared boolean but returns an integer literal
// guard calls a boolean helper; z = 2 gives 4
fn is_positive(v: int64) -> boolean {
    1
}

fn main() -> int64 {
    z: int64 <- 2;
    case z of {
        z: int64 if is_positive(z) -> z * 2;
        _: int64 -> 0
    }
}
