// expected failure E2005: wrong argument count in call to 'collatz'
// collatz steps for 25 = 23
fn collatz(n: int64, acc: int64) -> int64 {
    case n == 1 of {
        true -> acc;
        false -> case n % 2 == 0 of {
            true -> collatz(n / 2);
            false -> collatz(3 * n + 1, acc + 1)
        }
    }
}

fn main() -> int64 {
    collatz(25, 0)
}
