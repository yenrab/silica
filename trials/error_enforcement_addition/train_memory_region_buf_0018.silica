// expected failure E2001: string index passed to write_buf
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: alloc_buf with a literal size, write/read round-trip at index 9
fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf: buf(L1, normal, int64, 14) <- alloc_buf(r, 14);
        _: atom <- write_buf(buf, "9", 12);
        value: int64 <- read_buf(buf, 9)
    produces
        pure value
    end
}
