// expected failure E2001: string literal in one case arm of an integer case
// case on int32 value 28; expect 73
fn main() -> int32 {
    v: int32 <- 28;
    case v of {
        27 -> "162";
        12 -> 114;
        23 -> 107;
        20 -> 160;
        n: int32 if n > 11 -> 73;
        _: int32 -> 55
    }
}
