// expected failure E1043: whitespace between binding name 'result' and ':'
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(1 / 34 <= 20);
        println("");
        _: atom <- print_bool(28 < 11 / 29);
        println("");
        _: atom <- print_bool((49 / 38) >= 32);
        println("");
        result :atom <- print_bool(24 <= 28 % 2)
    produces pure result end
}
