// expected failure E1045: function 'main' declared without the fn keyword
// string case with an effectful sequence in each arm
main() -> atom {
    mode: string <- "other";
    case mode of {
        "quiet" -> {
            sequence proc[device_io]
                print_string("quiet");
                println("");
                print_int64(1);
                println("")
            produces
                pure :ok
            end
        }
        "silent" -> {
            sequence proc[device_io]
                print_int64(1);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
