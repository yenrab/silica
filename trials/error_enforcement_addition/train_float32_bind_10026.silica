// expected failure E2003: integer binding mixed into float arithmetic
// float32 bindings 17.125 - 12.75 printed as 4.375
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 17.125;
        b: int64 <- 12;
        result: atom <- print_float32(a - b)
    produces
        pure result
    end
}
