// expected failure E2018: binding 'a' has no type annotation
// nested boolean cases; (true, true) selects 67
fn main() -> int64 {
    a <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 67;
            false -> 41
        };
        false -> case b of {
            true -> 59;
            false -> 61
        }
    }
}
