// expected failure E2001: boolean field initialised with an integer
// print each field of a mixed record
fn main() -> atom {
    sequence proc[device_io] person: { name: string, age: int64, active: boolean } <- { name: "north", age: 32, active: 1 };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
        produces pure :ok end
}
