// expected failure E2003: string binding used where an integer is expected
// concatenate of 3 pieces prints ñandúbananañandú

fn main() -> atom {
    sequence proc[device_io] a: string <- "ñandú";
        b: string <- "banana";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "ñandú");
        print_int64(s0);
        println("")
        produces pure :ok end
}
