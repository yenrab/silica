// expected failure E1055: binding 'leftover' is never used
// Positive: pure helper chosen from a case arm; the effect runs in the sequence body
fn pick_value(flag: boolean) -> int64 {
    leftover: int64 <- 41;
    case flag of {
        true -> 1;
        false -> 5
    }
}

fn main() -> atom {
    flag: boolean <- false;
    sequence proc[device_io]
        v: int64 <- pick_value(flag);
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
