// expected failure E3009: proc[...] written on the function return type instead of the sequence
// float16 comparisons
fn main() -> atom proc[device_io] {
    sequence proc[device_io] _: atom <- print_bool((13.5 + 25.5) != 19.5);
        println("");
        _: atom <- print_bool(26.0 > 27.75);
        println("");
        done: atom <- print_bool((33.5 + 20.5) >= (17.5 - 4.5))
        produces pure done end
}
