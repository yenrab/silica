// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 22 gives 0
fn main() -> int64 {
    n: int64 <- 22;
    case n of {
        n: int64 if n -> n - 1;
        n: int64 if n >= 20 and n < 45 -> 0;
        n: int64 if n >= 45 -> n
    }
}
