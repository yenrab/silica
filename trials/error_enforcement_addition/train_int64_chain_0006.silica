// expected failure E2018: binding 'result' has no type annotation
// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(30 - 11 + (41 + 2));
        println("");
        _: atom <- print_int64(49 % (30 % 12));
        println("");
        _: atom <- print_int64((34 + 5) % 31);
        println("");
        result <- print_int64(5 / (35 * 36))
    produces pure result end
}
