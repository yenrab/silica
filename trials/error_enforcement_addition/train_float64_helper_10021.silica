// expected failure E2018: binding 'result' has no type annotation
// float64 helper scale; prints 39.875
fn scale(x: float64) -> float64 {
    x + 24.25 + 5.5
}

fn main() -> atom {
    sequence proc[device_io]
        result <- print_float64(scale(10.125))
    produces
        pure result
    end
}
