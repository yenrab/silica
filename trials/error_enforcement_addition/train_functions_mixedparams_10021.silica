// expected failure E2005: wrong argument count in call to 'describe'
// parameters of three different types; describe(38, "table", false) = 38
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(38, "table")
}
