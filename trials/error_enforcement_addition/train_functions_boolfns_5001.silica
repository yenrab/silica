// expected failure E1047: named struct declaration 'Pair' is not allowed
// boolean helpers combined into bits; expect 4
struct Pair { x: int64, y: int64 }

fn bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main() -> int64 {
    bit(tt() and ff(), 1) + bit(ff() or ff(), 2) + bit(ff() or tt(), 4)
}
