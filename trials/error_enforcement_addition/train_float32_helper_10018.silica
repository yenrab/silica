// expected failure E2003: blend returns float64 but its result feeds print_float32
// float32 helper blend; prints 27.1875
fn blend(x: float32) -> float64 {
    x * 14.25 + 2.25
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float32(blend(1.75))
        produces pure result end
}
