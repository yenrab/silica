// expected failure E1045: function 'main' declared without the fn keyword
// literal patterns, a guard and a typed wildcard on int32; v = 13 gives 12
main() -> int32 {
    v: int32 <- 13;
    case v of {
        11 -> 9;
        2 -> 4;
        13 -> 12;
        m: int32 if m > 11 -> 33;
        _: int32 -> 12
    }
}
