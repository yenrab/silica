// expected failure E1045: function 'main' declared without the fn keyword
// float32 bindings 8.5 - 11.125 printed as -2.625
main() -> atom {
    sequence proc[device_io]
        a: float32 <- 8.5;
        b: float32 <- 11.125;
        result: atom <- print_float32(a - b)
    produces
        pure result
    end
}
