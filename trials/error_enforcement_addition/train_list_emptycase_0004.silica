// expected failure E2018: binding 'r' has no type annotation
// case on a non-empty list; expect 56
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [40];
        r <- case xs of {
            []: List[int64, mem(normal)] -> 36;
            [h: int64, _: List[int64, mem(normal)]] -> h + 16;
            _: List[int64, mem(normal)] -> 36
        }
    produces
        pure r
    end
}
