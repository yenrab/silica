// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 35 % 22 > (39 + 51));
        println("");
        _: atom <- print_bool(53 / 59 != 18 % 45);
        println("");
        _: atom <- print_bool(0 * 55 < 30 % 10);
        println("");
        _: atom <- print_bool(49 >= 6);
        println("");
        result: atom <- print_bool(47 / 12 == (38 + 18))
        produces pure result end
}
