// expected failure E1047: named struct declaration 'Config' is not allowed
// decompose a mixed tuple and print each element
struct Config { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io] t: (int64, string, boolean) <- (99, "delta", true);
        (k: int64, name: string, flag: boolean) <- t;
        print_int64(k);
        println("");
        print_string(name);
        println("");
        print_bool(flag);
        println("")
        produces pure :ok end
}
