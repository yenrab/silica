// expected failure E1047: named struct declaration 'Point' is not allowed
// digit_sum(2434) = 13
struct Point { x: int64, y: int64 }

fn digit_sum(n: int64) -> int64 {
    case n < 10 of {
        true -> n;
        false -> n % 10 + digit_sum(n / 10)
    }
}

fn main() -> int64 {
    digit_sum(2434)
}
