// expected failure E1060: unbalanced braces
// print_uint16 two; prints 5 then 16
fn main() -> atom {
    sequence proc[device_io] a: uint16 <- 5;
        b: uint16 <- 16;
        _: atom <- print_uint16(a);
        println("");
        result: atom <- print_uint16(b)
        produces pure result end
