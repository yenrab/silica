// expected failure E2003: string parameter compared against an integer
// string recursion via substring; count_rec("south") = 0
fn count_rec(s: string) -> int64 {
    case s == 0 of {
        true -> 0;
        false -> count_step(s)
    }
}

fn count_step(s: string) -> int64 {
    head: string <- substring(s, 0, 1);
    case head == "a" of {
        true -> 1 + count_rec(substring(s, 1, length_chars(s)));
        false -> count_rec(substring(s, 1, length_chars(s)))
    }
}

fn main() -> int64 {
    count_rec("south")
}
