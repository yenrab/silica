// expected failure E1041: trailing ';' after the pure expression
// case inside a sequence chooses what to print
fn main() -> atom {
    flag: boolean <- false;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 7;
            false -> 8
        };
        result: atom <- print_int64(v)
    produces
        pure result;
    end
}
