// expected failure E1040: missing ';' between two statements
// print_int16 two; prints 0 then 1
fn main() -> atom {
    sequence proc[device_io]
        a: int16 <- 10 / 12;
        b: int16 <- 15 / 15;
        _: atom <- print_int16(a);
        println("")
        result: atom <- print_int16(b)
    produces pure result end
}
