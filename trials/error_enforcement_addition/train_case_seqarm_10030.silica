// expected failure E2005: call to unknown function 'print_int6z'
// case inside a sequence chooses what to print
fn main() -> atom {
    flag: boolean <- true;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 5;
            false -> 3
        };
        result: atom <- print_int6z(v)
    produces
        pure result
    end
}
