// expected failure E2018: binding 'result' has no type annotation
// Positive: both device_io and mem(normal) declared and used in one sequence
fn main() -> atom {
    sequence proc[mem(normal), device_io] xs: List[int64, mem(normal)] <- [21];
        n: int64 <- length[int64, mem(normal)](xs);
        result <- print_int64(n)
        produces pure result end
}
