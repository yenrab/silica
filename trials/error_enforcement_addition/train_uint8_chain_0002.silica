// expected failure E1055: binding 'scratch' is never used
// chained print_uint8 calls separated by println
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_uint8((11 + 43) % (32 - 12));
        println("");
        _: atom <- print_uint8(10);
        println("");
        result: atom <- print_uint8(43)
    produces pure result end
}
