// expected failure E2018: binding 'a' has no type annotation
// nested boolean cases; (true, true) selects 0
fn main() -> int64 {
    a <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 0;
            false -> 31
        };
        false -> case b of {
            true -> 99;
            false -> 41
        }
    }
}
