// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (31 + 0) < (44 + 59));
        println("");
        _: atom <- print_bool(52 / 9 > (22 + 37));
        println("");
        result: atom <- print_bool(45 / 60 == 20 % 52)
        produces pure result end
}
