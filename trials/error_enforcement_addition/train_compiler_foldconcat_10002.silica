// expected failure E1047: named struct declaration 'Node' is not allowed
// fold a string list with concat; byte length 16
struct Node { x: int64, y: int64 }

fn build(xs: List[string, mem(normal)]) -> string {
    sequence proc[mem(normal)]
        result: string <- case xs of {
            []: List[string, mem(normal)] -> "";
            [h: string, t: List[string, mem(normal)]] -> concat(h, build(t));
            _: List[string, mem(normal)] -> ""
        }
    produces
        pure result
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[string, mem(normal)] <- ["apple", "south", "region"];
        s: string <- build(xs)
    produces
        pure length_bytes(s)
    end
}
