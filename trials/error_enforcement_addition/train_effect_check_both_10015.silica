// expected failure E1045: function 'main' declared without the fn keyword
// Positive: both device_io and mem(normal) declared and used in one sequence
main() -> atom {
    sequence proc[device_io, mem(normal)] xs: List[int64, mem(normal)] <- [19, 20, 22];
        n: int64 <- length[int64, mem(normal)](xs);
        result: atom <- print_int64(n)
        produces pure result end
}
