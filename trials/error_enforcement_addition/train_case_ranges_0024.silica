// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 126 gives 126
fn main() -> int64 {
    n: int64 <- 126;
    case n of {
        n: int64 if n -> n;
        n: int64 if n >= 32 and n < 72 -> n * 2;
        n: int64 if n >= 72 -> n
    }
}
