// expected failure E1042: function 'main' has no return type
// print_uint32 two; prints 41 then 4
fn main() {
    sequence proc[device_io] a: uint32 <- 41;
        b: uint32 <- (13 % 9);
        _: atom <- print_uint32(a);
        println("");
        result: atom <- print_uint32(b)
        produces pure result end
}
