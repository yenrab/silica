// expected failure E2003: print_uint64 result bound as int64 instead of atom
// chained print_uint64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint64(51);
        println("");
        _: atom <- print_uint64(42 - 26);
        println("");
        _: atom <- print_uint64(37);
        println("");
        result: atom <- print_uint64(51)
    produces
        pure result
    end
}
