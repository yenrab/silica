// expected failure E2018: binding 'result' has no type annotation
// print_int64 two; prints 0 then 54
fn main() -> atom {
    sequence proc[device_io]
        a: int64 <- 18 / 31;
        b: int64 <- 54;
        _: atom <- print_int64(a);
        println("");
        result <- print_int64(b)
    produces
        pure result
    end
}
