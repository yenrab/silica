// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// string helper count_a_rec; prints 2
fn count_a_rec(s: string) -> int64 {
    case length_chars(s) == 0 of {
        true -> 0;
        false -> count_a_step(s)
    }
}

fn count_a_step(s: string) -> int64 {
    head: string <- substring(s, 0, 1);
    rest: string <- substring(s, 1, length_chars(s));
    case head == "a" of {
        true -> 1 + count_a_rec(rest);
        false -> count_a_rec(rest)
    }
}

fn main() -> atom {
    sequence proc[mem(normal)] result: atom <- print_int64(count_a_rec("cascade"))
        produces pure result end
}
