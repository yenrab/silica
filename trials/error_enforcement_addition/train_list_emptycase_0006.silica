// expected failure E2015: list pattern without its mem(Space)
// case on a non-empty list; expect 91
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [18];
        r: int64 <- case xs of {
            []: List[int64] -> 89;
            [h: int64, _: List[int64, mem(normal)]] -> h + 73;
            _: List[int64, mem(normal)] -> 89
        }
    produces
        pure r
    end
}
