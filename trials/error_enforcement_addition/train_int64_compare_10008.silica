// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (0 / 38) > 60);
        println("");
        _: atom <- print_bool((60 + 38) == (31 + 0));
        println("");
        _: atom <- print_bool(45 * 4 >= (40 + 16));
        println("");
        result: atom <- print_bool(8 * 2 == (35 + 5))
        produces pure result end
}
