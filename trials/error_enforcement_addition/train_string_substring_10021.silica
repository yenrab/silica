// expected failure E2005: call to unknown function 'substringx'
// substring uses character indices [0, 0) of "🎉"
fn main() -> atom {
    sequence proc[device_io]
        text: string <- "🎉";
        s: string <- substringx(text, 0, 0);
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
