// expected failure E1047: named struct declaration 'Pair' is not allowed
// list field accessors is_nil/head; want 1
struct Pair { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 26, 26, 40];
        r: int64 <- case xs.is_nil of {
            true -> 0;
            false -> xs.head
        }
    produces
        pure r
    end
}
