// expected failure E1047: named struct declaration 'Node' is not allowed
// chained print_int16 calls separated by println
struct Node { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int16((3 / 53));
        println("");
        _: atom <- print_int16(44 / 17);
        println("");
        _: atom <- print_int16(38 + 8 - (28 + 7));
        println("");
        result: atom <- print_int16(59)
    produces
        pure result
    end
}
