// expected failure E2001: atom literal returned from the recursion base case
// recursive steps on uint32; steps(13, 0) = 13
fn steps(n: uint32, acc: uint32) -> uint32 {
    case n == 0 of {
        true -> :done;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint32 {
    steps(13, 0)
}
