// expected failure E2018: binding 'r' has no type annotation
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: read_only on a ref in normal_noncacheable; expect 78
fn main() -> int64 {
    sequence proc[mem(normal_noncacheable)]
        L1: lifetime <- fresh_lifetime();
        r <- alloc_region(normal_noncacheable);
        cell: ref(L1, normal_noncacheable, int64) <- alloc_ref(r, 78);
        value: int64 <- read_ref(cell)
    produces
        pure value
    end
}
