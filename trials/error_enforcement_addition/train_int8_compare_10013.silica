// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 33 % 59 > (9 + 32));
        println("");
        _: atom <- print_bool((27 + 12) <= 17 / 56);
        println("");
        _: atom <- print_bool(22 * 5 == 29 / 7);
        println("");
        _: atom <- print_bool((35 + 44) != 7);
        println("");
        result: atom <- print_bool(17 >= (60 - 9))
        produces pure result end
}
