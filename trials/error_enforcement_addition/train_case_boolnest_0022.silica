// expected failure E1045: function 'main' declared without the fn keyword
// nested boolean cases; (false, false) selects 64
main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 57;
            false -> 0
        };
        false -> case b of {
            true -> 89;
            false -> 64
        }
    }
}
