// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 5 gives 15
fn main() -> int32 {
    v: int32 <- 5;
    case v of {
        :3 -> 40;
        6 -> 17;
        10 -> 6;
        m: int32 if m > 1 -> 15;
        _: int32 -> 50
    }
}
