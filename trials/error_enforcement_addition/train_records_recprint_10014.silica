// expected failure E1051: sequence block without a closing end
// print each field of a mixed record
fn main() -> atom {
    sequence proc[device_io] person: { name: string, age: int64, active: boolean } <- { name: "world", age: 99, active: false };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
        produces pure :ok
}
