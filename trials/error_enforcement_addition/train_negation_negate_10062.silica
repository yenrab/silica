// expected failure E1047: named struct declaration 'Node' is not allowed
// negate_float16 applied 3 time(s); prints -1.75
struct Node { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float16(negate_float16(negate_float16(negate_float16(1.75))))
        produces pure result end
}
