// expected failure E1049: sequence block without produces
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(28 * 39 != (60 + 43));
        println("");
        _: atom <- print_bool(50 <= (17 + 43));
        println("");
        _: atom <- print_bool((2 + 25) > (37 + 17));
        println("");
        _: atom <- print_bool(41 >= 59 % 55);
        println("");
        result: atom <- print_bool(6 / 6 >= 37 * 55)
        pure result end
}
