// expected failure E2018: binding 'a' has no type annotation
// nested boolean cases; (false, true) selects 8
fn main() -> int64 {
    a <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 59;
            false -> 78
        };
        false -> case b of {
            true -> 8;
            false -> 2
        }
    }
}
