// expected failure E2001: string literal used as a list index
// list_at index 2 of [33, 29, 12, 8, 12] is 12
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [33, 29, 12, 8, 12];
        v: int64 <- list_at[int64, mem(normal)](xs, "2")
        produces pure v end
}
