// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// list literal of 6 uint32 elements; length is 6
fn main() -> int64 {
    sequence proc[device_io]
        xs: List[uint32, mem(normal)] <- [25, 34, 6, 27, 10, 11];
        n: int64 <- length[uint32, mem(normal)](xs)
    produces pure n end
}
