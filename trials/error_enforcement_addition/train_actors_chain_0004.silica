// expected failure E1047: named struct declaration 'Config' is not allowed
// Spec §16.1.3: repeated call() to the same actor preserves FIFO order
struct Config { x: int64, y: int64 }

fn step(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state + msg, state + msg)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, step);
        v0: int64 <- call(w, 2 impl ActorMessage {});
        v1: int64 <- call(w, 2 impl ActorMessage {});
        v2: int64 <- call(w, 2 impl ActorMessage {});
        print_int64(v2);
        println("")
    produces
        pure :ok
    end
}
