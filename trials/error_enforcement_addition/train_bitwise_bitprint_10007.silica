// expected failure E1055: binding 'unused_value' is never used
// print_uint64 of 20 band 38 = 4
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        a: uint64 <- 20;
        b: uint64 <- 38;
        result: atom <- print_uint64(a band b)
    produces
        pure result
    end
}
