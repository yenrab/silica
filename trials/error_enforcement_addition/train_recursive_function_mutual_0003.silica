// expected failure E1045: function 'even' declared without the fn keyword
// mutual recursion even/odd; even(10) + odd(4) = 1
even(n: int64) -> int64 {
    case n == 0 of {
        true -> 1;
        false -> odd(n - 1)
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

fn main() -> int64 {
    even(10) + odd(4)
}
