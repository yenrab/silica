// expected failure E2003: a declared float64 but combined with a float16 value
// float16 bindings 17.0 * 18.0 printed as 306.0
fn main() -> atom {
    sequence proc[device_io] a: float64 <- 17.0;
        b: float16 <- 18.0;
        result: atom <- print_float16(a * b)
        produces pure result end
}
