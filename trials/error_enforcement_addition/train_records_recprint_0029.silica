// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// print each field of a mixed record
fn main() -> atom {
    sequence proc[mem(normal)]
        person: { name: string, age: int64, active: boolean } <- { name: "cherry", age: 40, active: true };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
    produces pure :ok end
}
