// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// float16 helper combine; prints 789.5
fn combine(x: float16) -> float16 {
    x * 21.0 + 2.0
}

fn main() -> atom {
    sequence proc[device_io, mem(normal)] result: atom <- print_float16(combine(37.5))
        produces pure result end
}
