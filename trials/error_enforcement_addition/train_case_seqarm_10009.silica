// expected failure E1050: produces clause without pure
// case inside a sequence chooses what to print
fn main() -> atom {
    flag: boolean <- false;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 7;
            false -> 4
        };
        result: atom <- print_int64(v)
    produces
        result
    end
}
