// expected failure E2003: print_uint32 result bound as int64 instead of atom
// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint32(6 / (36 + 15));
        println("");
        result: atom <- print_uint32(52 % 42 % (17 + 40))
    produces pure result end
}
