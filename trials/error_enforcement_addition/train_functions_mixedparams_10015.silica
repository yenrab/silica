// expected failure E1047: named struct declaration 'Point' is not allowed
// parameters of three different types; describe(22, "gamma", true) = 27
struct Point { x: int64, y: int64 }

fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(22, "gamma", true)
}
