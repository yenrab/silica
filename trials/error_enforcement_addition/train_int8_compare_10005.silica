// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 53 > 35 / 46);
        println("");
        _: atom <- print_bool(41 > 28 / 51);
        println("");
        _: atom <- print_bool((43 + 56) == 42);
        println("");
        result: atom <- print_bool(22 / 21 < 52)
    produces
        pure result
    end
}
