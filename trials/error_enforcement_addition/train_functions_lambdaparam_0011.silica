// expected failure E1045: function 'main' declared without the fn keyword
// function literal passed as a parameter, capturing z; expect 18
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

main() -> int64 {
    z: int64 <- 18;
    apply_pair(7, fn(a: int64, b: int64) -> int64 {
        a - b + z
    })
}
