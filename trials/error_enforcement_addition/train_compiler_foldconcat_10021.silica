// expected failure E1049: sequence block without produces
// fold a string list with concat; byte length 22
fn build(xs: List[string, mem(normal)]) -> string {
    sequence proc[mem(normal)]
        result: string <- case xs of {
            []: List[string, mem(normal)] -> "";
            [h: string, t: List[string, mem(normal)]] -> concat(h, build(t));
            _: List[string, mem(normal)] -> ""
        }
    pure result
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[string, mem(normal)] <- ["table", "cherry", "cherry", "alpha"];
        s: string <- build(xs)
    produces
        pure length_bytes(s)
    end
}
