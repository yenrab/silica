// expected failure E1041: trailing ';' after a block arm's final expression
// case arms with multi-statement block bodies; expect 15
fn main() -> int64 {
    x: int64 <- 1;
    case x of {
        0 -> {
            base: int64 <- 1;
            base * 2;
        }
        _: int64 -> {
            step: int64 <- 14;
            x * step + 1
        }
    }
}
