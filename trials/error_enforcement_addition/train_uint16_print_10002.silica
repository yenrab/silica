// expected failure E1040: missing ';' between two statements
// print_uint16 two; prints 0 then 0
fn main() -> atom {
    sequence proc[device_io] a: uint16 <- 8 / 11;
        b: uint16 <- 0;
        _: atom <- print_uint16(a);
        println("")
