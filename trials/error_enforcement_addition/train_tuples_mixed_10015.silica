// expected failure E2018: binding 't' has no type annotation
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t <- ("cloud", 46, :ok);
        (name: string, k: int64, tag: atom) <- t;
        print_string(name);
        println("");
        print_int64(k);
        println("");
        print_atom(tag);
        println("")
    produces pure :ok end
}
