// expected failure E1043: whitespace between binding name 'a' and ':'
// comments must stop at the newline; want 4
// whole-line comment before the function
fn main() -> int64 {
    a :int64 <- 6; // end-of-line after a binding
    // whole-line comment between statements
    b: int64 <- 4; // another
    a / b + 3 // end-of-line after the return expression
}
