// expected failure E2018: binding 'r' has no type annotation
// tagged tuple (atom, int64) from safe_div(34, 4); expect 8
fn safe_div(x: int64, y: int64) -> (atom, int64) {
    case y == 0 of {
        true -> (:error, 0);
        false -> (:ok, x / y)
    }
}

fn main() -> int64 {
    r <- safe_div(34, 4);
    (tag: atom, v: int64) <- r;
    case tag of {
        :ok -> v;
        _: atom -> 200
    }
}
