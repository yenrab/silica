// expected failure E2001: integer literal bound to a boolean
// nested boolean cases; (true, true) selects 76
fn main() -> int64 {
    a: boolean <- 1;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 76;
            false -> 69
        };
        false -> case b of {
            true -> 63;
            false -> 64
        }
    }
}
