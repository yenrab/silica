// expected failure E4016: no main/0: entry function renamed to 'start'
// pure sequence inside a helper; churn(8) = 16
fn churn(n: int64) -> int64 {
    sequence
        a: string <- concatenate("xx", "yy");
        b: string <- concatenate(a, a)
    produces
        pure length_bytes(b) + n
    end
}

fn start() -> int64 {
    churn(8)
}
