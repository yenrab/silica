// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 49 % 60 > (59 - 56));
        println("");
        _: atom <- print_bool((6 % 32) != 26);
        println("");
        _: atom <- print_bool(34 * 20 == 46 % 12);
        println("");
        _: atom <- print_bool((21 + 34) != (28 / 46));
        println("");
        result: atom <- print_bool(53 % 54 < (35 + 43))
        produces pure result end
}
