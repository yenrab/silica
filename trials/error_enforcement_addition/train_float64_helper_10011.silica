// expected failure E2003: combine returns float16 but its result feeds print_float64
// float64 helper combine; prints 28.375
fn combine(x: float64) -> float16 {
    x + 8.375 + 2.5
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float64(combine(17.5))
        produces pure result end
}
