// expected failure E1055: binding 'unused_value' is never used
// float64 comparisons
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_bool(11.25 >= (17.25 - 3.5));
        println("");
        _: atom <- print_bool((22.0 + 2.5) != 24.125);
        println("");
        done: atom <- print_bool(4.75 >= (18.5 + 31.0))
    produces
        pure done
    end
}
