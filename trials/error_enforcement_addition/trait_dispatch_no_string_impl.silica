// Type checker: qualified trait call with no `impl fn` for the inferred concrete type (E2003).
export trait trait_dispatch_no_string_impl;
export only_one/1;

required {
    fn only_one(x: trait_dispatch_no_string_impl) -> int64;
}

impl fn only_one(n: int64) -> int64 {
    n
}

fn main() -> int64 {
    s: string <- "hi";
    trait_dispatch_no_string_impl@only_one(s)
}
