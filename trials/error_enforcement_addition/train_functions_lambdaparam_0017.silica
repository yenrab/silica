// expected failure E1042: function 'main' has no return type
// function literal passed as a parameter, capturing z; expect 179
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> {
    z: int64 <- 10;
    apply_pair(13, fn(a: int64, b: int64) -> int64 {
        a * b + z
    })
}
