// expected failure E2003: print_uint32 result bound as int64 instead of atom
// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint32(9);
        println("");
        _: atom <- print_uint32(53 + 4 / 7);
        println("");
        _: atom <- print_uint32((13 + 12) * 9);
        println("");
        result: atom <- print_uint32(8)
    produces pure result end
}
