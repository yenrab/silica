// expected failure E1053: duplicate produces keyword
// 3 prepends after empty; length is 3
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
        xs1: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](15, xs0);
        xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](40, xs1);
        xs3: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](28, xs2);
        n: int64 <- length[uint32, mem(normal)](xs3)
    produces produces
        pure n
    end
}
