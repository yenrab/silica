// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on int64; tri_acc(20, 0) = 210
fn tri_acc(n: int64, acc: int64) -> int64 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> int64 {
    tri_acc(20, 0)
}
