// expected failure E2018: binding 'p' has no type annotation
// record pattern matching (guard); expect 8
fn score(p: { x: int64, y: int64 }) -> int64 {
    case p of {
        { x: xv, y: yv } if xv > yv -> xv - yv;
        { x: xv, y: yv } if yv > xv -> yv - xv;
        { x: xv, y: yv } -> xv + yv
    }
}

fn main() -> int64 {
    p <- { x: 9, y: 1 };
    score(p)
}
