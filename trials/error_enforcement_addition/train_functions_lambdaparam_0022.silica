// expected failure E2005: call to unknown function 'apply_paiz'
// function literal passed as a parameter, capturing z; expect 16
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    z: int64 <- 4;
    apply_paiz(6, fn(a: int64, b: int64) -> int64 {
        a + b + z
    })
}
