// expected failure E2003: string element printed with print_int64
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t: (boolean, int64, string) <- (false, 56, "south");
        (flag: boolean, k: int64, name: string) <- t;
        print_bool(flag);
        println("");
        print_int64(k);
        println("");
        print_int64(name);
        println("")
    produces
        pure :ok
    end
}
