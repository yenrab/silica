// expected failure E1045: function 'main' declared without the fn keyword
// list of inline records folded by sum_v = 4
fn sum_v(xs: List[{ k: int64, v: int64 }, mem(normal)]) -> int64 {
    case xs of {
        []: List[{ k: int64, v: int64 }, mem(normal)] -> 0;
        [h: { k: int64, v: int64 }, t: List[{ k: int64, v: int64 }, mem(normal)]] -> h.v + sum_v(t);
        _: List[{ k: int64, v: int64 }, mem(normal)] -> 0
    }
}

main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[{ k: int64, v: int64 }, mem(normal)] <- [{ k: 1, v: 4 }, { k: 2, v: 0 }];
        total: int64 <- sum_v(xs)
    produces
        pure total
    end
}
