// expected failure E2018: binding 's2' has no type annotation
// functional record update through bump; counter ends at 26
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0: { counter: int64, label: string } <- { counter: 14, label: "count" };
    s1: { counter: int64, label: string } <- bump(s0, 6);
    s2 <- bump(s1, 6);
    s2.counter
}
