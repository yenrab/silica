// expected failure E1042: function 'main' has no return type
// chained print_int8 calls separated by println
fn main() -> {
    sequence proc[device_io]
        _: atom <- print_int8(30);
        println("");
        _: atom <- print_int8(2 % (36 % 31));
        println("");
        result: atom <- print_int8(29 + 10 - 8 / 1)
    produces pure result end
}
