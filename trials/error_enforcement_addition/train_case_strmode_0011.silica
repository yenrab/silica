// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "other";
    case mode of {
        "debug" -> {
            sequence proc[mem(normal)]
                print_string("debug");
                println("");
                print_int64(2);
                println("")
            produces
                pure :ok
            end
        }
        "silent" -> {
            sequence proc[device_io]
                print_int64(5);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
