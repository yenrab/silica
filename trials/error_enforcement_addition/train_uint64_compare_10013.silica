// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 35 < 31 % 55);
        println("");
        _: atom <- print_bool((44 / 44) < 21);
        println("");
        _: atom <- print_bool((24 / 34) != 11);
        println("");
        result: atom <- print_bool(33 / 32 != 53)
    produces pure result end
}
