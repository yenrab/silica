// expected failure E1051: sequence block without a closing end
// list literal of 6 uint32 elements; length is 6
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[uint32, mem(normal)] <- [19, 17, 7, 21, 6, 3];
        n: int64 <- length[uint32, mem(normal)](xs)
    produces
        pure n
}
