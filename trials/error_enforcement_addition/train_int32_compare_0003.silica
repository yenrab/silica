// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 17 / 58 <= 52 % 18);
        println("");
        result: atom <- print_bool(48 % 27 >= 48 % 15)
    produces
        pure result
    end
}
