// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 60 > 27 * 58);
        println("");
        _: atom <- print_bool(8 % 57 > 59);
        println("");
        _: atom <- print_bool((41 + 48) > 19);
        println("");
        result: atom <- print_bool(12 < 23 * 34)
    produces pure result end
}
