// expected failure E2015: list pattern without its mem(Space)
// case on an empty list; expect 18
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        r: int64 <- case xs of {
            []: List[int64] -> 18;
            [h: int64, _: List[int64, mem(normal)]] -> h + 79;
            _: List[int64, mem(normal)] -> 18
        }
    produces
        pure r
    end
}
