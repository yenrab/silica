// expected failure E2005: tuple pattern annotated with the wrong arity
// case scrutinee is a tuple-returning call; expect 42
fn pair(n: int64) -> (int64, int64) {
    (n, n + 1)
}

fn main() -> int64 {
    case pair(20) of {
        t: (int64, int64, int64) -> {
            (x: int64, y: int64) <- t;
            x + y + 1
        }
    }
}
