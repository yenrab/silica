// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 27 != 58 / 56);
        println("");
        _: atom <- print_bool(34 <= (6 + 43));
        println("");
        _: atom <- print_bool((17 + 2) != (29 * 36));
        println("");
        result: atom <- print_bool(22 <= 2 % 10)
        produces pure result end
}
