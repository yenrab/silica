// expected failure E2005: spawn without the required stack_policy argument (§15.1.2.2)
fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        w: actor_ref <- spawn(0, beh)
    produces
        pure 0
    end
}
