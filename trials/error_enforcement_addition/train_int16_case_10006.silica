// expected failure E2005: string literal pattern against an integer scrutinee
// case on int16 value 35; expect 141
fn main() -> int16 {
    v: int16 <- 35;
    case v of {
        "one" -> 170;
        6 -> 108;
        24 -> 126;
        40 -> 56;
        n: int16 if n > 32 -> 141;
        _: int16 -> 165
    }
}
