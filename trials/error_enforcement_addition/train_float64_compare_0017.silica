// expected failure E4016: no main/0: entry function renamed to 'main_program'
// float64 comparisons
fn main_program() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((25.5 - 1.0) > 25.5 * 8.5);
        println("");
        done: atom <- print_bool(14.25 != (32.25 + 24.5))
    produces pure done end
