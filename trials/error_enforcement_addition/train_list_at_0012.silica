// expected failure E1055: binding 'leftover' is never used
// list_at index 1 of [26, 9, 20, 27, 18, 13] is 9
fn main() -> int64 {
    leftover: int64 <- 41;
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [26, 9, 20, 27, 18, 13];
        v: int64 <- list_at[int64, mem(normal)](xs, 1)
    produces pure v end
}
