// expected failure E2001: string literal in one case arm of an integer case
// case on uint8 value 8; expect 102
fn main() -> uint8 {
    v: uint8 <- 8;
    case v of {
        22 -> "22";
        8 -> 102;
        41 -> 77;
        0 -> 132;
        n: uint8 if n > 35 -> 31;
        _: uint8 -> 0
    }
}
