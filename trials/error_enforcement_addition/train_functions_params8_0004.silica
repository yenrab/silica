// expected failure E3010: sum8 extended to nine parameters
// function with 8 parameter(s); sum8(19, 0, 1, 7, 12, 0, 0, 7, 1) = 46
fn sum8(a: int32, b: int32, c: int32, d: int32, e: int32, f: int32, g: int32, h: int32, i: int32) -> int32 {
    a + b + c + d + e + f + g + h + i
}

fn main() -> int32 {
    sum8(19, 0, 1, 7, 12, 0, 0, 7)
}
