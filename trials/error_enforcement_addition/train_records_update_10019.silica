// expected failure E1055: binding 'leftover' is never used
// functional record update through bump; counter ends at 30
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    leftover: int64 <- 41;
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0: { counter: int64, label: string } <- { counter: 2, label: "count" };
    s1: { counter: int64, label: string } <- bump(s0, 14);
    s2: { counter: int64, label: string } <- bump(s1, 14);
    s2.counter
}
