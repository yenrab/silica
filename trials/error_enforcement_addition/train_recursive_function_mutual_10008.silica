// expected failure E2005: call to unknown function 'oddx'
// mutual recursion even/odd; even(0) + odd(1) = 2
fn even(n: int64) -> int64 {
    case n == 0 of {
        true -> 1;
        false -> oddx(n - 1)
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

fn main() -> int64 {
    even(0) + odd(1)
}
