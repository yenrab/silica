// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (60 - 27) < (20 + 17));
        println("");
        result: atom <- print_bool((58 + 23) <= (39 + 48))
    produces pure result end
}
