    sequence proc[device_io] _: atom <- print_bool(26 * 31 > 40 * 44);
        println("");
        _: atom <- print_bool(20 != 53 / 9);
        println("");
        _: atom <- print_bool((45 + 33) >= 30 / 28);
        println("");
        result: atom <- print_bool(31 % 18 > (13 - 6))
        produces pure result
}
