// expected failure E1055: binding 'unused_value' is never used
// case inside a sequence chooses what to print
fn main() -> atom {
    unused_value: int64 <- 41;
    flag: boolean <- false;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 6;
            false -> 6
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
