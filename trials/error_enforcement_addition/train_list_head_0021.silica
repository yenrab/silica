// expected failure E1055: binding 'spare' is never used
// second on [8, 18, 27] gives 18
fn main() -> int64 {
    spare: int64 <- 41;
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [8, 18, 27];
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
        second: int64 <- head[int64, mem(normal)](rest)
    produces
        pure second
    end
}
