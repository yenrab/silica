// expected failure E2018: binding 'mode' has no type annotation
// string case with an effectful sequence in each arm
fn main() -> atom {
    mode <- "silent";
    case mode of {
        "silent" -> {
            sequence proc[device_io]
                print_string("silent");
                println("");
                print_int64(0);
                println("")
            produces
                pure :ok
            end
        }
        "quiet" -> {
            sequence proc[device_io]
                print_int64(0);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
