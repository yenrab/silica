// expected failure E1043: whitespace between binding name 'r' and ':'
// count over [1, 33, 40] = 3
fn count(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [_: int64, t: List[int64, mem(normal)]] -> 1 + count(t);
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1, 33, 40];
        r :int64 <- count(xs)
    produces
        pure r
    end
}
