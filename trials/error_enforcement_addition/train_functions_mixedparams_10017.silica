// expected failure E2005: call to unknown function 'describe_all'
// parameters of three different types; describe(20, "table", true) = 25
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe_all(20, "table", true)
}
