// expected failure E2018: binding 'buf' has no type annotation
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: alloc_buf with a literal size, write/read round-trip at index 3
fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        buf <- alloc_buf(r, 5);
        _: atom <- write_buf(buf, 3, 196);
        value: int64 <- read_buf(buf, 3)
    produces
        pure value
    end
}
