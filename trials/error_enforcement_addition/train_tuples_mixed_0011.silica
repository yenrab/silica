// expected failure E3009: proc[...] written on the function return type instead of the sequence
// decompose a mixed tuple and print each element
fn main() -> atom proc[device_io] {
    sequence proc[device_io]
        t: (string, int64, atom) <- ("actor", 61, :done);
        (name: string, k: int64, tag: atom) <- t;
        print_string(name);
        println("");
        print_int64(k);
        println("");
        print_atom(tag);
        println("")
    produces pure :ok end
}
