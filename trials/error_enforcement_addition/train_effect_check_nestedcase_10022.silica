// expected failure E1043: whitespace between binding name 'outer' and ':'
// Positive: device_io only in a nested case arm inside sequence proc[device_io] still counts as used
fn main() -> atom {
    outer :int64 <- 0;
    inner: int64 <- 0;
    sequence proc[device_io]
        result: atom <- case outer of {
            0 -> print_int64(8);
            _: int64 -> case inner of {
                2 -> print_int64(1);
                _: int64 -> print_int64(5)
            }
        }
    produces
        pure result
    end
}
