// expected failure E1043: whitespace between binding name 'inner' and ':'
// Positive: device_io only in a nested case arm inside sequence proc[device_io] still counts as used
fn main() -> atom {
    outer: int64 <- 1;
    inner :int64 <- 2;
    sequence proc[device_io]
        result: atom <- case outer of {
            0 -> print_int64(5);
            _: int64 -> case inner of {
                2 -> print_int64(4);
                _: int64 -> print_int64(6)
            }
        }
    produces
        pure result
    end
}
