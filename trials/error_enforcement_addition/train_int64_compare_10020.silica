// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (37 + 20) >= (5 / 21));
        println("");
        _: atom <- print_bool(4 != (54 + 25));
        println("");
        _: atom <- print_bool((47 + 57) < (24 / 15));
        println("");
        result: atom <- print_bool(20 * 36 == (13 + 37))
        produces pure result end
}
