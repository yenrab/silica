// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// concatenate of 4 pieces prints 世界hellonaïvealpha

fn main() -> atom {
    sequence proc[mem(normal)]
        a: string <- "世界";
        b: string <- "hello";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "naïve");
        s1: string <- concatenate(s0, "alpha");
        print_string(s1);
        println("")
    produces pure :ok end
}
