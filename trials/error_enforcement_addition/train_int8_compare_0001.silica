// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 42 % 36 >= (50 + 53));
        println("");
        _: atom <- print_bool((2 + 8) == 17 / 6);
        println("");
        _: atom <- print_bool((41 / 55) == 28);
        println("");
        result: atom <- print_bool(11 * 2 > 36)
    produces pure result end
}
