// expected failure E4016: no main/0: entry function renamed to 'mainx'
// tail-recursive factorial; factorial_acc(3, 1) = 6
fn factorial_acc(n: int64, acc: int64) -> int64 {
    case n <= 1 of {
        true -> acc;
        false -> factorial_acc(n - 1, acc * n)
    }
}

fn mainx() -> int64 {
    factorial_acc(3, 1)
}
