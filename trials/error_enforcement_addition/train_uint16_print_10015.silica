// expected failure E2005: call to unknown function 'my_print_uint16'
// print_uint16 two; prints 7 then 1
fn main() -> atom {
    sequence proc[device_io]
        a: uint16 <- 7 % 43;
        b: uint16 <- 19 % 3;
        _: atom <- print_uint16(a);
        println("");
        result: atom <- my_print_uint16(b)
    produces
        pure result
    end
}
