// expected failure E2018: binding 'a' has no type annotation
// nested boolean cases; (false, false) selects 70
fn main() -> int64 {
    a <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 74;
            false -> 94
        };
        false -> case b of {
            true -> 97;
            false -> 70
        }
    }
}
