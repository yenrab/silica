// expected failure E2003: a declared float64 but combined with a float16 value
// float16 bindings 6.0 * 13.75 printed as 82.5
fn main() -> atom {
    sequence proc[device_io] a: float64 <- 6.0;
        b: float16 <- 13.75;
        result: atom <- print_float16(a * b)
        produces pure result end
}
