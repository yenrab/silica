// expected failure E2002: undefined identifier 'missing_m'
// Ackermann A(1, 4) = 6
fn ack_nonzero(m: int64, n: int64) -> int64 {
    case n == 0 of {
        true -> ack(m - 1, 1);
        false -> ack(m - 1, ack(m, n - 1))
    }
}

