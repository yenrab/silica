// expected failure E2001: string literal used as a list index
// list_at index 3 of [9, 12, 37, 34, 12, 17] is 34
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [9, 12, 37, 34, 12, 17];
        v: int64 <- list_at[int64, mem(normal)](xs, "3")
    produces
        pure v
    end
}
