// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// print_float16 of 15.25 + 41.5 - (39.5 + 9.5); prints 7.75
fn main() -> atom {
    sequence proc[mem(normal)]
        _: atom <- print_float16(15.25 + 41.5 - (39.5 + 9.5))
    produces
        pure :ok
    end
}
