// expected failure E2003: blend returns float64 but its result feeds print_float16
// float16 helper blend; prints 3.0
fn blend(x: float16) -> float64 {
    x - 30.0 + 0.75
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(blend(32.25))
    produces pure result end
}
