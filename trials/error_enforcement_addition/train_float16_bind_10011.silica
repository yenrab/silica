// expected failure E2003: integer binding mixed into float arithmetic
// float16 bindings 23.25 * 0.5 printed as 11.625
fn main() -> atom {
    sequence proc[device_io]
        a: float16 <- 23.25;
        b: int64 <- 0;
        result: atom <- print_float16(a * b)
    produces
        pure result
    end
}
