// expected failure E2003: string binding used where an integer is expected
// concatenate of 2 pieces prints omegabanana

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "omega";
        b: string <- "banana";
        s: string <- concatenate(a, b);
        print_int64(s);
        println("")
    produces
        pure :ok
    end
}
