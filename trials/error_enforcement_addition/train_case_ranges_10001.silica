// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 35 gives 34
fn main() -> int64 {
    n: int64 <- 35;
    case n of {
        n: int64 if n -> n - 1;
        n: int64 if n >= 72 and n < 76 -> n - 1;
        n: int64 if n >= 76 -> n * 2
    }
}
