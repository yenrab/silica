// expected failure E1049: sequence block without produces
// case on an empty list; expect 65
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 65;
            [h: int64, _: List[int64, mem(normal)]] -> h + 77;
            _: List[int64, mem(normal)] -> 65
        }
    pure r
    end
}
