// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (46 + 46) <= (41 + 19));
        println("");
        _: atom <- print_bool((22 + 42) <= 42);
        println("");
        result: atom <- print_bool(1 >= 38)
    produces pure result end
}
