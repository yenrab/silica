// expected failure E2005: the stack policy is the third argument; the optional core id follows it (§15.1.1)
fn beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        w: actor_ref <- spawn(0, beh, 2, stack_policy(0, :keep_high_water))
    produces
        pure 0
    end
}
