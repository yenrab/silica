// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// case inside a sequence chooses what to print
fn main() -> atom {
    flag: boolean <- true;
    sequence proc[device_io, mem(normal)]
        v: int64 <- case flag of {
            true -> 8;
            false -> 5
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
