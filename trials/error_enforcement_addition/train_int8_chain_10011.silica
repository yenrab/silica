// expected failure E1050: produces clause without pure
// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8(30);
        println("");
        _: atom <- print_int8(21);
        println("");
        result: atom <- print_int8(37 % 6)
    produces
        result
    end
}
