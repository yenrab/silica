// expected failure E1040: missing ';' between two statements
// float16 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(39.5 != (41.5 + 39.0));
        println("")
        _: atom <- print_bool((5.5 - 2.0) <= 15.0 * 14.25);
        println("");
        _: atom <- print_bool(27.25 == 10.75);
        println("");
        done: atom <- print_bool((30.5 - 28.0) == (20.25 + 9.5))
        produces pure done end
}
