// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// print_float32 of 3.5 + 10.25 + (5.0 + 36.5); prints 55.25
fn main() -> atom {
    sequence proc[mem(normal)]
        _: atom <- print_float32(3.5 + 10.25 + (5.0 + 36.5))
    produces
        pure :ok
    end
}
