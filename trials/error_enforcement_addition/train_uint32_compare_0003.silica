// expected failure E1042: function 'main' has no return type
// uint32 comparisons printed with print_bool
fn main() {
    sequence proc[device_io]
        _: atom <- print_bool((25 + 25) > 57);
        println("");
        result: atom <- print_bool(44 != (22 + 4))
    produces
        pure result
    end
}
