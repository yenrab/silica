// expected failure E2003: print_uint32 result bound as int64 instead of atom
// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint32(60);
        println("");
        _: atom <- print_uint32(4 / 24);
        println("");
        result: atom <- print_uint32(46)
    produces
        pure result
    end
}
