// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 24 / 48 < (37 + 7));
        println("");
        _: atom <- print_bool(28 / 25 != (53 + 58));
        println("");
        result: atom <- print_bool((37 - 32) >= (33 + 31))
        produces pure result end
}
