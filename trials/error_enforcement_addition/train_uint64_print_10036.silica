// expected failure E1055: binding 'temp_val' is never used
// print_uint64 two; prints 49 then 10
fn main() -> atom {
    temp_val: int64 <- 41;
    sequence proc[device_io] a: uint64 <- (49 % 50);
        b: uint64 <- 43 / 4;
        _: atom <- print_uint64(a);
        println("");
        result: atom <- print_uint64(b)
        produces pure result end
}
