// expected failure E2003: string binding used where an integer is expected
// concat of 4 pieces prints betacherry🎉🎉

fn main() -> atom {
    sequence proc[device_io]
        s: string <- concat(concat(concat("beta", "cherry"), "🎉"), "🎉");
        print_int64(s);
        println("")
    produces pure :ok end
}
