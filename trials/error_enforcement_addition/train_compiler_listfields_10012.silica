// expected failure E1055: binding 'unused_value' is never used
// list field accessors is_nil/head; want 35
fn main() -> int64 {
    unused_value: int64 <- 41;
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [35];
        r: int64 <- case xs.is_nil of {
            true -> 0;
            false -> xs.head
        }
    produces
        pure r
    end
}
