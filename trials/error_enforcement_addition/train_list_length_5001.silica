// expected failure E3010: list space does not match the sequence's mem effect
// list literal of 6 int64 elements; length is 6
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal_writethrough)] <- [18, 10, 7, 18, 12, 35];
        n: int64 <- length[int64, mem(normal_writethrough)](xs)
    produces pure n end
}
