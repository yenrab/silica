// expected failure E2015: List type without its mem(Space)
// list field accessors is_nil/head; want 37
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64] <- [37, 28, 0, 39];
        r: int64 <- case xs.is_nil of {
            true -> 0;
            false -> xs.head
        }
    produces
        pure r
    end
}
