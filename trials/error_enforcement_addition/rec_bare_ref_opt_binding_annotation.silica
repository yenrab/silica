// Spec §4.2.2 and recursive_tuple_specification.md §2: `rec` is valid only inside a tuple type.
// A binding annotated with a bare ref?(L, normal, rec) has no enclosing tuple, so the tuple that `rec`
// stands for cannot be determined: the compiler rejects it (E2010). The spelled-out form of the same
// binding is valid (memory_region_addition/ref_opt_binding_annotation). Formerly project-bees SD-5.
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        cell: ref?(L, normal, rec) <- alloc_rec(r, (:ok, 1, :none));
        n: int64 <- case cell of { :none -> 0; _: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> 1 }
    produces pure n end
}
