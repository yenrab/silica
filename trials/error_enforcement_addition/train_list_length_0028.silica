// expected failure E1043: whitespace between binding name 'n' and ':'
// list literal of 1 int64 elements; length is 1
fn main() -> int64 {
    sequence proc[mem(normal_writethrough)] xs: List[int64, mem(normal_writethrough)] <- [11];
        n :int64 <- length[int64, mem(normal_writethrough)](xs)
        produces pure n end
}
