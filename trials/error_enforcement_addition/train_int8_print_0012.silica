// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// print_int8 two; prints 8 then 49
fn main() -> atom {
    sequence proc[mem(normal)] a: int8 <- 30 % 11;
        b: int8 <- 25 + 24;
        _: atom <- print_int8(a);
        println("");
        result: atom <- print_int8(b)
        produces pure result end
}
