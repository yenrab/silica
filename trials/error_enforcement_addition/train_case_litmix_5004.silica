// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on uint64; v = 3 gives 12
fn main() -> uint64 {
    v: uint64 <- 3;
    case v of {
        :14 -> 34;
        10 -> 50;
        1 -> 1;
        m: uint64 if m > 15 -> 43;
        _: uint64 -> 12
    }
}
