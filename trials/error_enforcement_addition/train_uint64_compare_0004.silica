// expected failure E2005: call to unknown function 'print_boolx'
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(46 == (49 + 12));
        println("");
        _: atom <- print_boolx(37 * 25 != 9 % 46);
        println("");
        result: atom <- print_bool((30 / 14) <= 19 * 57)
    produces
        pure result
    end
}
