// expected failure E1042: function 'main' has no return type
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: alloc_ref with element type boolean
fn main() {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        flag: ref(L1, normal, boolean) <- alloc_ref(r, false);
        v: boolean <- read_ref(flag)
    produces
        pure case v of { true -> 1; false -> 0 }
    end
}
