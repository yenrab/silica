// expected failure E2018: binding 's0' has no type annotation
// functional record update through bump; counter ends at 66
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0 <- { counter: 26, label: "count" };
    s1: { counter: int64, label: string } <- bump(s0, 20);
    s2: { counter: int64, label: string } <- bump(s1, 20);
    s2.counter
}
