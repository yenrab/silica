// expected failure E2003: string parameter compared against an integer
// string recursion via substring; str_len_acc("hello", 0) = 5
fn str_len_acc(s: string, acc: int64) -> int64 {
    case s == 0 of {
        true -> acc;
        false -> str_len_acc(substring(s, 1, length_chars(s)), acc + 1)
    }
}

fn main() -> int64 {
    str_len_acc("hello", 0)
}
