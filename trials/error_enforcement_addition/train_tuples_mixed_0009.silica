// expected failure E1053: duplicate produces keyword
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io] t: (boolean, int64, string) <- (true, 79, "cherry");
        (flag: boolean, k: int64, name: string) <- t;
        print_bool(flag);
        println("");
        print_int64(k);
        println("");
        print_string(name);
        println("")
        produces produces pure :ok end
}
