// expected failure E1051: sequence block without a closing end
// Positive: list allocation requires sequence proc[mem(normal)] (spec §9.3.1)
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [31, 9, 0, 25, 2];
        n: int64 <- length[int64, mem(normal)](xs)
        produces pure n
}
