// expected failure E2005: wrong argument count in call to 'is_positive'
// guard calls a boolean helper; z = -16 gives 0
fn is_positive(v: int64) -> boolean {
    v > 0
}

fn main() -> int64 {
    z: int64 <- -16;
    case z of {
        z: int64 if is_positive() -> z * 2;
        _: int64 -> 0
    }
}
