// expected failure E2003: combine returns float64 but its result feeds print_float16
// float16 helper combine; prints 35.75
fn combine(x: float16) -> float64 {
    x + 13.75 + 2.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(combine(20.0))
    produces pure result end
}
