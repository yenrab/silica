// expected failure E2018: binding 'result' has no type annotation
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((1 + 46) == (19 + 30));
        println("");
        _: atom <- print_bool(41 > 24 % 44);
        println("");
        _: atom <- print_bool(3 / 36 >= 15 * 34);
        println("");
        _: atom <- print_bool(4 <= 53);
        println("");
        result <- print_bool((41 - 38) == (43 + 7))
        produces pure result end
}
