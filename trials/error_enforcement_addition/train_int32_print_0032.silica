// expected failure E1051: sequence block without a closing end
// print_int32 two; prints 18 then 638
fn main() -> atom {
    sequence proc[device_io]
        a: int32 <- 18;
        b: int32 <- 29 * 22;
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
    produces
        pure result
}
