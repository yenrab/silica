// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (46 + 3) >= 41 / 33);
        println("");
        _: atom <- print_bool((3 * 32) != (15 + 1));
        println("");
        result: atom <- print_bool(26 <= 29)
    produces
        pure result
    end
}
