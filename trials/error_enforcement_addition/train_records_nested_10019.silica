// expected failure E1043: whitespace between binding name 'rect' and ':'
// nested inline records; sum = 65
fn main() -> int64 {
    rect :{ top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
        top_left: { x: 29, y: 6 },
        bottom_right: { x: 27, y: 3 }
    };
    rect.top_left.x + rect.top_left.y + rect.bottom_right.x + rect.bottom_right.y
}
