// expected failure E1043: whitespace between binding name 'z' and ':'
// function literal passed as a parameter, capturing z; expect 143
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    z :int64 <- 22;
    apply_pair(11, fn(a: int64, b: int64) -> int64 {
        a * b + z
    })
}
