// expected failure E1047: named struct declaration 'Pair' is not allowed
// negate_float32 applied 2 time(s); prints 38.5
struct Pair { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(negate_float32(negate_float32(38.5)))
    produces pure result end
}
