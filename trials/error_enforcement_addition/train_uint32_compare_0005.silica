// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io, mem(normal)] _: atom <- print_bool((23 + 37) == 23 / 13);
        println("");
        _: atom <- print_bool(47 * 26 != 6 * 8);
        println("");
        _: atom <- print_bool(46 < 59);
        println("");
        _: atom <- print_bool((40 + 48) == 44 / 55);
        println("");
        result: atom <- print_bool(21 < 60 / 2)
        produces pure result end
}
