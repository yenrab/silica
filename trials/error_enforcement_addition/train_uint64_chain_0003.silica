// expected failure E1040: missing ';' between two statements
// chained print_uint64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint64(10);
        println("")
        _: atom <- print_uint64(4 % 38 + 5 / 2);
        println("");
        result: atom <- print_uint64(37 / 37 + 14)
    produces
        pure result
    end
}
