// expected failure E2001: integer literal bound to a boolean
// nested boolean cases; (true, true) selects 26
fn main() -> int64 {
    a: boolean <- 1;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 26;
            false -> 12
        };
        false -> case b of {
            true -> 89;
            false -> 83
        }
    }
}
