// expected failure E1055: binding 'unused_value' is never used
// chained print_uint8 calls separated by println
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_uint8(29 + 48);
        println("");
        _: atom <- print_uint8((20 % 33) + (35 % 42));
        println("");
        _: atom <- print_uint8(16);
        println("");
        result: atom <- print_uint8((7 + 14))
    produces
        pure result
    end
}
