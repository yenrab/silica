// expected failure E1045: function 'main' declared without the fn keyword
// decompose a mixed tuple and print each element
main() -> atom {
    sequence proc[device_io] t: (string, int64, atom) <- ("chair", 18, :done);
        (name: string, k: int64, tag: atom) <- t;
        print_string(name);
        println("");
        print_int64(k);
        println("");
        print_atom(tag);
        println("")
        produces pure :ok end
}
