// expected failure E2003: comparison against a string binding
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (51 + 32) >= (16 + 4));
        println("");
        _: atom <- print_bool((52 * 44) != (13 + 45));
        println("");
        result: atom <- print_bool((13 + 9) == (53 + 32))
    produces
        pure result
    end
}
