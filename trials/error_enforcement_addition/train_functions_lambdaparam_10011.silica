// expected failure E2002: undefined identifier 'nu'
// function literal passed as a parameter, capturing z; expect 128
fn apply_pair(num: int64, op: fn(a: int64, b: int64) -> int64) -> int64 {
    op(num, nu)
}

fn main() -> int64 {
    z: int64 <- 28;
    apply_pair(10, fn(a: int64, b: int64) -> int64 {
        a * b + z
    })
}
