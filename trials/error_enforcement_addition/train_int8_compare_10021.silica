// expected failure E2018: binding 'result' has no type annotation
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(30 < (56 % 45));
        println("");
        _: atom <- print_bool((39 + 13) == 6 % 14);
        println("");
        _: atom <- print_bool(20 < 1 * 34);
        println("");
        _: atom <- print_bool(59 / 14 <= 15 / 1);
        println("");
        result <- print_bool((32 / 39) > 27 % 42)
    produces
        pure result
    end
}
