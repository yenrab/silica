// expected failure E2018: binding 'v' has no type annotation
// literal patterns, a guard and a typed wildcard on uint8; v = 1 gives 14
fn main() -> uint8 {
    v <- 1;
    case v of {
        0 -> 25;
        3 -> 22;
        5 -> 3;
        m: uint8 if m > 15 -> 0;
        _: uint8 -> 14
    }
}
