// expected failure E1055: binding 'leftover' is never used
// chained print_uint16 calls separated by println
fn main() -> atom {
    leftover: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_uint16(10);
        println("");
        _: atom <- print_uint16(16 + 44 + (11 + 42));
        println("");
        result: atom <- print_uint16(43 * 39 + 32 % 24)
    produces
        pure result
    end
}
