// expected failure E1065: parameter list of 'apply_pair' is not closed
// function literal passed as a parameter, capturing z; expect 12
fn apply_pair(num: int64, op: fn(a: int64, b: int64 -> int64) -> int64 {
    op(num, num)
}

fn main() -> int64 {
    z: int64 <- 12;
    apply_pair(2, fn(a: int64, b: int64) -> int64 {
        a - b + z
    })
}
