// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[mem(normal)] _: atom <- print_uint32(40);
        println("");
        _: atom <- print_uint32(23 * 59 + 23);
        println("");
        result: atom <- print_uint32(35 + 52)
        produces pure result end
}
