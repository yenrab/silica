// expected failure E1055: binding 'temp_val' is never used
// guard calls a boolean helper; z = 4 gives 8
fn is_positive(v: int64) -> boolean {
    temp_val: int64 <- 41;
    v > 0
}

fn main() -> int64 {
    z: int64 <- 4;
    case z of {
        z: int64 if is_positive(z) -> z * 2;
        _: int64 -> 0
    }
}
