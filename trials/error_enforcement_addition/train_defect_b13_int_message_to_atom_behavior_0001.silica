// expected failure E2001: integer literal message sent to an atom-typed behavior
fn srv(msg: atom, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, srv);
        r: int64 <- call(w, 7 impl ActorMessage {});
        print_int64(r);
        println("")
    produces pure :ok end
}
