// expected failure E4016: no main/0: entry function renamed to 'start'
// print each field of a mixed record
fn start() -> atom {
    sequence proc[device_io]
        person: { name: string, age: int64, active: boolean } <- { name: "table", age: 27, active: true };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
    produces pure :ok end
}
