// expected failure E2001: string element in the returned tuple
// minmax returns a pair; p + q = 4
fn minmax(x: int64, y: int64) -> (int64, int64) {
    case x < y of {
        true -> (x, "y");
        false -> (y, x)
    }
}

fn main() -> int64 {
    (p: int64, q: int64) <- minmax(3, 1);
    p + q
}
