// expected failure E2018: binding 'rest' has no type annotation
// second on [39, 19, 8] gives 19
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [39, 19, 8];
        rest <- remove_head[int64, mem(normal)](xs);
        second: int64 <- head[int64, mem(normal)](rest)
    produces pure second end
}
