// expected failure E1055: binding 'leftover' is never used
// comments must stop at the newline; want 14
// whole-line comment before the function
fn main() -> int64 {
    leftover: int64 <- 41;
    a: int64 <- 3; // end-of-line after a binding
    // whole-line comment between statements
    b: int64 <- 9; // another
    a / b + 14 // end-of-line after the return expression
}
