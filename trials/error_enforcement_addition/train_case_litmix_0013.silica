// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on uint8; v = 1 gives 20
fn main() -> uint8 {
    v: uint8 <- 1;
    case v of {
        :12 -> 14;
        14 -> 43;
        5 -> 17;
        m: uint8 if m > 15 -> 14;
        _: uint8 -> 20
    }
}
