// expected failure E1041: trailing ';' after the pure expression
// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(29 * 24);
        println("");
        _: atom <- print_int64(1 * 57);
        println("");
        result: atom <- print_int64(45)
    produces pure result; end
}
