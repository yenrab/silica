// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// float64 comparisons
fn main() -> atom {
    sequence proc[device_io, mem(normal)]
        _: atom <- print_bool((39.0 + 33.5) != (18.25 + 19.5));
        println("");
        done: atom <- print_bool((25.0 + 24.0) != 33.5)
    produces pure done end
}
