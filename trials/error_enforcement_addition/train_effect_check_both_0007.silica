// expected failure E3002: device_io dropped from the declaration
// Positive: both device_io and mem(normal) declared and used in one sequence
fn main() -> atom {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [24, 27, 10, 34, 21];
        n: int64 <- length[int64, mem(normal)](xs);
        result: atom <- print_int64(n)
    produces pure result end
}
