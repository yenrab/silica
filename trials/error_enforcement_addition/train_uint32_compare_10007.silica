// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (21 % 5) > (33 + 44));
        println("");
        _: atom <- print_bool(7 == (10 + 44));
        println("");
        result: atom <- print_bool(58 <= (52 + 39))
    produces
        pure result
    end
}
