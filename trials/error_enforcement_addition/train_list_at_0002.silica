// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// list_at index 1 of [22, 34, 31, 32, 39, 30] is 34
fn main() -> int64 {
    sequence proc[device_io] xs: List[int64, mem(normal)] <- [22, 34, 31, 32, 39, 30];
        v: int64 <- list_at[int64, mem(normal)](xs, 1)
        produces pure v end
}
