// expected failure E2005: call to unknown function 'print_int6z'
// print_int64 two; prints 73 then 13
fn main() -> atom {
    sequence proc[device_io]
        a: int64 <- 29 + 44;
        b: int64 <- 13;
        _: atom <- print_int6z(a);
        println("");
        result: atom <- print_int64(b)
    produces
        pure result
    end
}
