// expected failure E2002: undefined identifier 'n_'
// parameters of three different types; describe(17, "delta", true) = 22
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n_ + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(17, "delta", true)
}
