// expected failure E2003: a declared float16 but combined with a float32 value
// float32 bindings 13.0 - 3.0 printed as 10.0
fn main() -> atom {
    sequence proc[device_io]
        a: float16 <- 13.0;
        b: float32 <- 3.0;
        result: atom <- print_float32(a - b)
    produces
        pure result
    end
}
