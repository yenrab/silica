// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 57 % 26 == 37);
        println("");
        _: atom <- print_bool((51 - 26) > 14);
        println("");
        result: atom <- print_bool((7 + 4) > 36 * 18)
    produces
        pure result
    end
}
