// expected failure E2232: the device-worker surface in a module without the device_ prefix (device spec §3.1)
fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn main() -> int64 {
    sequence proc[concurrency]
        d: device_actor_ref <- spawn_device(0, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device(d, 1 impl ActorMessage {})
    produces
        pure 0
    end
}
