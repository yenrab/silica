// expected failure E4016: no main/0: entry function renamed to 'main_program'
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: write on a ref in normal; expect 14
fn main_program() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        cell: ref(L1, normal, int64) <- alloc_ref(r, 98);
        _: atom <- write_ref(cell, 14);
        value: int64 <- read_ref(cell)
    produces
        pure value
    end
}
