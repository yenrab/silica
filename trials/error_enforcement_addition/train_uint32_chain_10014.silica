// expected failure E2003: print_uint32 result bound as int64 instead of atom
// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint32(34 * 60);
        println("");
        result: atom <- print_uint32(25 * (25 / 27))
    produces
        pure result
    end
}
