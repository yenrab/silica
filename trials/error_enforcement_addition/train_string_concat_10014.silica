// expected failure E1055: binding 'scratch' is never used
// concatenate of 4 pieces prints stoneomegabetaapple

fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        a: string <- "stone";
        b: string <- "omega";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "beta");
        s1: string <- concatenate(s0, "apple");
        print_string(s1);
        println("")
    produces
        pure :ok
    end
}
