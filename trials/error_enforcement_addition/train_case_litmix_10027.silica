// expected failure E1047: named struct declaration 'Pair' is not allowed
// literal patterns, a guard and a typed wildcard on int64; v = 6 gives 0
struct Pair { x: int64, y: int64 }

fn main() -> int64 {
    v: int64 <- 6;
    case v of {
        0 -> 37;
        3 -> 0;
        11 -> 37;
        m: int64 if m > 1 -> 0;
        _: int64 -> 3
    }
}
