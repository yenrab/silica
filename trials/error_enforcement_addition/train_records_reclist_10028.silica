// expected failure E2005: call to unknown function 'sum_z'
// list of inline records folded by sum_v = 100
fn sum_v(xs: List[{ k: int64, v: int64 }, mem(normal)]) -> int64 {
    case xs of {
        []: List[{ k: int64, v: int64 }, mem(normal)] -> 0;
        [h: { k: int64, v: int64 }, t: List[{ k: int64, v: int64 }, mem(normal)]] -> h.v + sum_z(t);
        _: List[{ k: int64, v: int64 }, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[{ k: int64, v: int64 }, mem(normal)] <- [{ k: 1, v: 26 }, { k: 2, v: 14 }, { k: 3, v: 29 }, { k: 4, v: 31 }];
        total: int64 <- sum_v(xs)
    produces
        pure total
    end
}
