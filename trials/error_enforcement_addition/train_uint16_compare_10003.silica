// expected failure E1043: whitespace between binding name 'result' and ':'
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(54 % 4 > 6);
        println("");
        _: atom <- print_bool((57 + 57) > 33);
        println("");
        result :atom <- print_bool(22 * 45 < 18)
    produces pure result end
}
