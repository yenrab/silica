// expected failure E2018: binding 'result' has no type annotation
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(3 / 20 > (47 - 38));
        println("");
        _: atom <- print_bool(23 % 38 < 29);
        println("");
        _: atom <- print_bool(5 * 43 == 59 / 31);
        println("");
        result <- print_bool(8 / 45 != 11)
    produces
        pure result
    end
}
