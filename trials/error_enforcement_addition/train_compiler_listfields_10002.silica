// expected failure E1042: function 'main' has no return type
// list field accessors is_nil/head; want 43
fn main() -> {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [43, 11, 46, 26, 33];
        r: int64 <- case xs.is_nil of {
            true -> 0;
            false -> xs.head
        }
    produces
        pure r
    end
}
