// expected failure E1045: function 'main' declared without the fn keyword
// tagged tuple (atom, int64) from safe_div(36, 4); expect 9
fn safe_div(x: int64, y: int64) -> (atom, int64) {
    case y == 0 of {
        true -> (:error, 0);
        false -> (:ok, x / y)
    }
}

main() -> int64 {
    r: (atom, int64) <- safe_div(36, 4);
    (tag: atom, v: int64) <- r;
    case tag of {
        :ok -> v;
        _: atom -> 200
    }
}
