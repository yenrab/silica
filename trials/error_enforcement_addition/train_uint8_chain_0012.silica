// expected failure E1047: named struct declaration 'Pair' is not allowed
// chained print_uint8 calls separated by println
struct Pair { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint8(10);
        println("");
        _: atom <- print_uint8(17 + 10);
        println("");
        result: atom <- print_uint8((55 + 25))
    produces
        pure result
    end
}
