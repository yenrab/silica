// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 40 % 57 > 38);
        println("");
        _: atom <- print_bool((35 + 52) <= 27);
        println("");
        _: atom <- print_bool(55 >= (53 - 44));
        println("");
        _: atom <- print_bool(11 != 32 % 1);
        println("");
        result: atom <- print_bool(32 != 46 / 22)
    produces pure result end
}
