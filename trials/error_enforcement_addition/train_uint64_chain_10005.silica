// expected failure E1042: function 'main' has no return type
// chained print_uint64 calls separated by println
fn main() {
    sequence proc[device_io]
        _: atom <- print_uint64((36 - 5) / 42);
        println("");
        _: atom <- print_uint64(1);
        println("");
        result: atom <- print_uint64(55)
    produces pure result end
}
