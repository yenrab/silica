// expected failure E1055: binding 'scratch' is never used
// print_uint8 two; prints 74 then 1
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io] a: uint8 <- 60 + 14;
        b: uint8 <- 46 / 37;
        _: atom <- print_uint8(a);
        println("");
        result: atom <- print_uint8(b)
        produces pure result end
}
