// expected failure E1043: whitespace between binding name 's0' and ':'
// functional record update through bump; counter ends at 93
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0 :{ counter: int64, label: string } <- { counter: 35, label: "count" };
    s1: { counter: int64, label: string } <- bump(s0, 29);
    s2: { counter: int64, label: string } <- bump(s1, 29);
    s2.counter
}
