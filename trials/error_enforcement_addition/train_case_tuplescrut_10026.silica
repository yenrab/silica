// expected failure E2005: wrong argument count in call to 'pair'
// case scrutinee is a tuple-returning call; expect 41
fn pair(n: int64) -> (int64, int64) {
    (n, n + 1)
}

fn main() -> int64 {
    case pair() of {
        t: (int64, int64) -> {
            (x: int64, y: int64) <- t;
            x + y + 2
        }
    }
}
