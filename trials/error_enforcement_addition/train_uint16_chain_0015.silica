// expected failure E1042: function 'main' has no return type
// chained print_uint16 calls separated by println
fn main() {
    sequence proc[device_io]
        _: atom <- print_uint16(28);
        println("");
        _: atom <- print_uint16(13);
        println("");
        _: atom <- print_uint16((42 + 3) * 43);
        println("");
        result: atom <- print_uint16(23 + 38)
    produces pure result end
}
