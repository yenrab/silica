// expected failure E2018: binding 'v' has no type annotation
// list_at index 2 of [18, 31, 10, 21] is 10
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [18, 31, 10, 21];
        v <- list_at[int64, mem(normal)](xs, 2)
    produces
        pure v
    end
}
