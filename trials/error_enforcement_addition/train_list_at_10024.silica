// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// list_at index 2 of [7, 9, 17, 39] is 17
fn main() -> int64 {
    sequence proc[device_io]
        xs: List[int64, mem(normal)] <- [7, 9, 17, 39];
        v: int64 <- list_at[int64, mem(normal)](xs, 2)
    produces
        pure v
    end
}
