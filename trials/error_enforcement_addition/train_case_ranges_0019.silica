// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 111 gives 55
fn main() -> int64 {
    n: int64 <- 111;
    case n of {
        n: int64 if n -> n + 100;
        n: int64 if n >= 39 and n < 100 -> n;
        n: int64 if n >= 100 -> n / 2
    }
}
