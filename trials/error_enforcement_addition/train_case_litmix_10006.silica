// expected failure E1055: binding 'temp_val' is never used
// literal patterns, a guard and a typed wildcard on int32; v = 8 gives 43
fn main() -> int32 {
    temp_val: int64 <- 41;
    v: int32 <- 8;
    case v of {
        14 -> 39;
        1 -> 19;
        8 -> 43;
        m: int32 if m > 7 -> 47;
        _: int32 -> 49
    }
}
