// expected failure E4016: no main/0: entry function renamed to 'main_program'
// float64 bindings 21.25 - 29.0 printed as -7.75
fn main_program() -> atom {
    sequence proc[device_io] a: float64 <- 21.25;
        b: float64 <- 29.0;
        result: atom <- print_float64(a - b)
        produces pure result end
}
