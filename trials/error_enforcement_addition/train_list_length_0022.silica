// expected failure E2015: List type without its mem(Space)
// list literal of 5 uint32 elements; length is 5
fn main() -> int64 {
    sequence proc[mem(normal_writethrough)]
        xs: List[uint32] <- [17, 30, 13, 16, 5];
        n: int64 <- length[uint32, mem(normal_writethrough)](xs)
    produces
        pure n
    end
}
