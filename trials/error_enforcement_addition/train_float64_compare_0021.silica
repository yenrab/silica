// expected failure E2018: binding 'done' has no type annotation
// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(2.25 != (39.0 - 3.75));
        println("");
        _: atom <- print_bool((14.25 - 2.75) > 40.5 * 5.75);
        println("");
        done <- print_bool((30.0 + 28.0) >= 25.0)
    produces pure done end
}
