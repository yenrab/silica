// expected failure E1042: function 'ff' has no return type
// and/or truth table bits (bool alias accepted); want 28
fn tt() -> bool {
    true
}

fn ff() {
    false
}

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn main() -> int64 {
    r0: int64 <- bit(tt() and ff(), 1);
    r1: int64 <- bit(ff() or ff(), 2);
    r2: int64 <- bit(tt() or tt(), 4);
    r3: int64 <- bit(tt() and tt(), 8);
    r4: int64 <- bit(tt() or ff(), 16);
    r5: int64 <- bit(ff() and tt(), 32);
    r0 + r1 + r2 + r3 + r4 + r5
}
