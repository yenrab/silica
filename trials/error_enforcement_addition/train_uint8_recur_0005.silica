// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on uint8; digit_count(94) = 2
fn digit_count(n: uint8) -> uint8 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> uint8 {
    digit_count(94)
}
