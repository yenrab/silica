// expected failure E4016: no main/0: entry function renamed to 'main_program'
// boolean helpers combined into bits; expect 3
fn bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main_program() -> int64 {
    bit(tt() and tt(), 1) + bit(ff() or tt(), 2) + bit(ff() or ff(), 4)
}
