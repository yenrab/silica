// expected failure E1047: named struct declaration 'Pair' is not allowed
// case producing atoms then case dispatching on them; grade(3) -> 1
struct Pair { x: int64, y: int64 }

fn grade(n: int64) -> atom {
    case n of {
        0 -> :zero;
        k: int64 if k < 5 -> :low;
        _: int64 -> :high
    }
}

fn main() -> int64 {
    g: atom <- grade(3);
    case g of {
        :zero -> 0;
        :low -> 1;
        :high -> 2;
        _: atom -> 9
    }
}
