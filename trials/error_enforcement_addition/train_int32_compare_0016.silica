// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 45 * 50 >= 30 % 28);
        println("");
        result: atom <- print_bool((43 - 11) >= (40 - 19))
    produces pure result end
}
