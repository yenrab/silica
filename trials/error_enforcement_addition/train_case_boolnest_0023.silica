// expected failure E2001: integer literal bound to a boolean
// nested boolean cases; (false, true) selects 62
fn main() -> int64 {
    a: boolean <- 1;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 83;
            false -> 76
        };
        false -> case b of {
            true -> 62;
            false -> 97
        }
    }
}
