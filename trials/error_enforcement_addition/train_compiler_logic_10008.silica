// expected failure E1055: binding 'unused_value' is never used
// and/or truth table bits (bool alias accepted); want 5
fn tt() -> bool {
    unused_value: int64 <- 41;
    true
}

fn ff() -> bool {
    false
}

fn bit(b: bool, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn main() -> int64 {
    r0: int64 <- bit(tt() or tt(), 1);
    r1: int64 <- bit(ff() or ff(), 2);
    r2: int64 <- bit(ff() or tt(), 4);
    r0 + r1 + r2
}
