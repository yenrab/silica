// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 60 / 46 <= (40 % 53));
        println("");
        result: atom <- print_bool(0 % 50 < 49 % 30)
    produces pure result end
}
