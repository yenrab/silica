// expected failure E1055: binding 'scratch' is never used
// nested boolean cases; (false, false) selects 14
fn main() -> int64 {
    scratch: int64 <- 41;
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 78;
            false -> 28
        };
        false -> case b of {
            true -> 65;
            false -> 14
        }
    }
}
