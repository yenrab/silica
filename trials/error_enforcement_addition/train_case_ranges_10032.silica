// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 106 gives 53
fn main() -> int64 {
    n: int64 <- 106;
    case n of {
        n: int64 if n -> n;
        n: int64 if n >= 1 and n < 106 -> n / 2;
        n: int64 if n >= 106 -> n / 2
    }
}
