// expected failure E2018: binding 'b' has no type annotation
// print_int64 two; prints 18 then 0
fn main() -> atom {
    sequence proc[device_io] a: int64 <- 18 % 20;
        b <- 13 / 58;
        _: atom <- print_int64(a);
        println("");
        result: atom <- print_int64(b)
        produces pure result end
}
