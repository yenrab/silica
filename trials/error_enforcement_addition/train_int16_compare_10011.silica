// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (48 + 13) < 14);
        println("");
        _: atom <- print_bool((24 + 12) != (5 - 4));
        println("");
        _: atom <- print_bool(19 / 15 == (59 - 26));
        println("");
        result: atom <- print_bool(54 % 55 < 55 / 47)
    produces
        pure result
    end
}
