// The second description of (:esp32s3_uart): E2201 in the unit that sees both.
use DeviceDescription;

impl fn registers(device: (:esp32s3_uart)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :fifo, offset: 0x00, width: 32, access: :read_write }
    ]
}
