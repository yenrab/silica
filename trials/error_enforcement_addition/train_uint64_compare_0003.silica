// expected failure E1040: missing ';' between two statements
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(57 > (52 + 38));
        println("")
        _: atom <- print_bool(49 != 44);
        println("");
        _: atom <- print_bool((51 - 48) >= 16);
        println("");
        result: atom <- print_bool((4 + 21) == (32 + 46))
    produces
        pure result
    end
}
