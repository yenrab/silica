// expected failure E1047: named struct declaration 'Node' is not allowed
// Spec §15.1.1: two actor_ref values from spawn; each replies independently
struct Node { x: int64, y: int64 }

fn adder(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn doubler(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg * 2, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        a: actor_ref <- spawn(9, adder);
        b: actor_ref <- spawn(4, doubler);
        ra: int64 <- call(a, 3 impl ActorMessage {});
        rb: int64 <- call(b, 7 impl ActorMessage {});
        print_int64(ra + rb);
        println("")
    produces
        pure :ok
    end
}
