// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (35 + 57) != 43);
        println("");
        result: atom <- print_bool(32 / 8 >= 7)
    produces
        pure result
    end
}
