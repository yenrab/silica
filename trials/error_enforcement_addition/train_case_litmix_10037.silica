// expected failure E4016: no main/0: entry function renamed to 'entry'
// literal patterns, a guard and a typed wildcard on int32; v = 11 gives 29
fn entry() -> int32 {
    v: int32 <- 11;
    case v of {
        6 -> 26;
        3 -> 10;
        9 -> 50;
        m: int32 if m > 9 -> 29;
        _: int32 -> 47
    }
}
