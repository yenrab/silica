// expected failure E2003: half_sum returns float16 but its result feeds print_float64
// float64 helper half_sum; prints 21.25
fn half_sum(x: float64) -> float16 {
    x + 8.0 + 3.0
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float64(half_sum(10.25))
        produces pure result end
}
