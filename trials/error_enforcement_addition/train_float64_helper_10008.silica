// expected failure E1043: whitespace between binding name 'result' and ':'
// float64 helper combine; prints 635.0625
fn combine(x: float64) -> float64 {
    x * 29.375 + 3.5
}

fn main() -> atom {
    sequence proc[device_io]
        result :atom <- print_float64(combine(21.5))
    produces
        pure result
    end
}
