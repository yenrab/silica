// expected failure E1055: binding 'leftover' is never used
// print_int64 two; prints 1 then 14
fn main() -> atom {
    leftover: int64 <- 41;
    sequence proc[device_io] a: int64 <- 40 / 40;
        b: int64 <- 14;
        _: atom <- print_int64(a);
        println("");
        result: atom <- print_int64(b)
        produces pure result end
}
