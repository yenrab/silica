// expected failure E2002: undefined identifier 'missing_n'
// guards partition int64 into three ranges; n = 2 gives 102
fn main() -> int64 {
    n: int64 <- 2;
    case n of {
        n: int64 if n < 65 -> n + 100;
        n: int64 if missing_n >= 65 and n < 85 -> n / 2;
        n: int64 if n >= 85 -> n / 2
    }
}
