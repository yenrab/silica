// expected failure E3009: proc[...] written on the function return type instead of the sequence
// float32 comparisons
fn main() -> atom proc[device_io] {
    sequence proc[device_io]
        _: atom <- print_bool((14.5 - 22.125) >= (7.0 + 2.25));
        println("");
        _: atom <- print_bool((27.25 + 29.0) >= (33.375 + 33.5));
        println("");
        done: atom <- print_bool((34.0 + 36.5) <= 25.0)
    produces
        pure done
    end
}
