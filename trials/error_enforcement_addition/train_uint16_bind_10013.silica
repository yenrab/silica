// expected failure E2003: binding height declared uint64 but used as uint16
// uint16 bindings then expression; expect 17
fn main() -> uint16 {
    height: uint64 <- 22 / 18 % (55 + 42);
    total: uint16 <- height;
    c: uint16 <- height * height;
    count: uint16 <- c;
    17 + total - total + count - count
}
