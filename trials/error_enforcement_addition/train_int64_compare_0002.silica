// expected failure E2003: comparison against a string binding
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 57 * 60 > (58 - 40));
        println("");
        result: atom <- print_bool((57 / 48) != 9)
        produces pure result end
}
