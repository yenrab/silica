// expected failure E2005: call to unknown function 'print_uint8x'
// print_uint8 two; prints 30 then 45
fn main() -> atom {
    sequence proc[device_io]
        a: uint8 <- 30;
        b: uint8 <- 45;
        _: atom <- print_uint8x(a);
        println("");
        result: atom <- print_uint8(b)
    produces pure result end
}
