// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 7 gives 0
fn main() -> int64 {
    n: int64 <- 7;
    case n of {
        n: int64 if n -> 0;
        n: int64 if n >= 26 and n < 114 -> 0;
        n: int64 if n >= 114 -> n * 2
    }
}
