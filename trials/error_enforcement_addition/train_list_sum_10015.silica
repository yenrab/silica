// expected failure E1042: function 'main' has no return type
// recursive sum_list over a list; total 51
fn sum_list(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [h: int64, t: List[int64, mem(normal)]] -> h + sum_list(t);
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [30, 20, 1];
        total: int64 <- sum_list(xs)
    produces pure total end
}
