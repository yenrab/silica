// expected failure E2018: binding 'result' has no type annotation
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(17 / 53 < (40 + 10));
        println("");
        _: atom <- print_bool((51 + 37) >= 37);
        println("");
        result <- print_bool(29 % 30 < 25 % 1)
    produces pure result end
}
