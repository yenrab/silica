// expected failure E2003: list operation instantiated with the wrong element type
// second on [17, 28] gives 28
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [17, 28];
        rest: List[int64, mem(normal)] <- remove_head[uint8, mem(normal)](xs);
        second: int64 <- head[int64, mem(normal)](rest)
    produces
        pure second
    end
}
