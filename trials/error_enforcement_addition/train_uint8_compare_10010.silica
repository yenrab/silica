// expected failure E1049: sequence block without produces
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((36 + 13) != (46 + 9));
        println("");
        _: atom <- print_bool(22 / 55 >= 1);
        println("");
        _: atom <- print_bool((25 + 60) != 30 % 22);
        println("");
        _: atom <- print_bool(31 > 0 % 58);
        println("");
        result: atom <- print_bool(31 / 37 != 9)
    pure result
    end
}
