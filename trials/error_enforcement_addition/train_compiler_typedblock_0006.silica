// expected failure E2002: undefined identifier 'ss'
// typed `string { ... }` case arm body; want 1
fn first_char(s: string) -> string {
    case s == "" of {
        false -> string {
            c: string <- substring(ss, 0, 1);
            c
        };
        true -> ""
    }
}

fn main() -> int64 {
    case first_char("south") == "s" of {
        true -> 1;
        false -> 0
    }
}
