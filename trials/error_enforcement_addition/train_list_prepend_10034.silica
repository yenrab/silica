// expected failure E2015: List type without its mem(Space)
// 2 prepends after empty; length is 2
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[uint32, mem(normal)] <- empty[uint32, mem(normal)]();
        xs1: List[uint32] <- prepend[uint32, mem(normal)](16, xs0);
        xs2: List[uint32, mem(normal)] <- prepend[uint32, mem(normal)](28, xs1);
        n: int64 <- length[uint32, mem(normal)](xs2)
    produces pure n end
}
