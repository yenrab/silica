    x * y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sub(4, 1) + mul(23, 8) + div(9, 6) + add(26, 4)//218
