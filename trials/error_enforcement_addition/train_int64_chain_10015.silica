// expected failure E2018: binding 'result' has no type annotation
// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(18);
        println("");
        _: atom <- print_int64(57 / (41 % 39));
        println("");
        result <- print_int64(((13 - 2) * 33))
    produces
        pure result
    end
}
