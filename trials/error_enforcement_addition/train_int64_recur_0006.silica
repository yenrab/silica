// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on int64; digit_count(105) = 3
fn digit_count(n: int64) -> int64 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> int64 {
    digit_count(105)
}
