// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (46 - 5) == 8 % 50);
        println("");
        _: atom <- print_bool((18 % 28) != 42 % 44);
        println("");
        _: atom <- print_bool(12 > 1);
        println("");
        _: atom <- print_bool((8 + 47) <= (28 + 59));
        println("");
        result: atom <- print_bool(35 != (10 % 4))
    produces
        pure result
    end
}
