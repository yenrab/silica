// expected failure E2003: comparison against a string binding
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 16 % 7 >= 49 * 47);
        println("");
        _: atom <- print_bool((45 + 35) > 43 % 25);
        println("");
        _: atom <- print_bool(43 / 19 < (33 + 36));
        println("");
        result: atom <- print_bool((29 + 58) >= 42)
    produces pure result end
}
