// expected failure E2005: call to unknown function 'print_float32_all'
// float32 bindings 17.5 + 0.0 printed as 17.5
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 17.5;
        b: float32 <- 0.0;
        result: atom <- print_float32_all(a + b)
    produces pure result end
}
