// expected failure E1042: function 'main' has no return type
// int16 comparisons printed with print_bool
fn main() -> {
    sequence proc[device_io]
        _: atom <- print_bool(7 * 49 != (27 / 49));
        println("");
        _: atom <- print_bool(20 == 34);
        println("");
        result: atom <- print_bool((29 + 3) != (15 / 11))
    produces
        pure result
    end
}
