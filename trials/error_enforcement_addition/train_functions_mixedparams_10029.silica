// expected failure E2002: undefined identifier 'nx'
// parameters of three different types; describe(27, "omega", true) = 32
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> nx + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(27, "omega", true)
}
