// expected failure E1043: whitespace between binding name 'base' and ':'
// int8 bindings then expression; expect 48
fn main() -> int8 {
    c: int8 <- 33;
    height: int8 <- (c - c - c % c);
    k: int8 <- c + height - (c + height);
    base :int8 <- c + (15 - height);
    base * (35 / 33) + k - k
}
