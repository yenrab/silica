// expected failure E2005: call to unknown function 'print_int1z'
// print_int16 two; prints 1 then 30
fn main() -> atom {
    sequence proc[device_io]
        a: int16 <- 42 / 38;
        b: int16 <- (30 % 58);
        _: atom <- print_int1z(a);
        println("");
        result: atom <- print_int16(b)
    produces pure result end
}
