// expected failure E1045: function 'main' declared without the fn keyword
// chained print_uint32 calls separated by println
main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint32(31);
        println("");
        _: atom <- print_uint32(1);
        println("");
        result: atom <- print_uint32(28)
    produces
        pure result
    end
}
