// expected failure E1055: binding 'leftover' is never used
// print_uint64 two; prints 26 then 17
fn main() -> atom {
    leftover: int64 <- 41;
    sequence proc[device_io]
        a: uint64 <- 26;
        b: uint64 <- 60 % 43;
        _: atom <- print_uint64(a);
        println("");
        result: atom <- print_uint64(b)
    produces pure result end
}
