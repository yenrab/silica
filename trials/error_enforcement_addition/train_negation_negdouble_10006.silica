// expected failure E1047: named struct declaration 'Point' is not allowed
// negate_int8 double; prints -25
struct Point { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_int8(negate_int8(negate_int8(-25)))
    produces
        pure result
    end
}
