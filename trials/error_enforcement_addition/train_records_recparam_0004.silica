// expected failure E2003: record argument with a missing field
// record passed to a function; area(make_rect(8, 11)) = 88
fn make_rect(w: int64, h: int64) -> { width: int64, height: int64 } {
    { width: w }
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

fn main() -> int64 {
    area(make_rect(8, 11))
}
