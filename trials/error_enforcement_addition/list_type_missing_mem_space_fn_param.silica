// Error enforcement: function parameter List types must use mem(Space) (E2015).
fn take(xs: List[int64]) -> int64 {
    length[int64, mem(normal)](xs)
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [1];
        take(xs)
    produces
        pure 0
    end
}
