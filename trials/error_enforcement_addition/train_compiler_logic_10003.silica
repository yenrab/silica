// expected failure E1065: parameter list of 'bit' is not closed
// and/or truth table bits (bool alias accepted); want 25
fn tt() -> bool {
    true
}

fn ff() -> bool {
    false
}

fn bit(b: bool, w: int64 -> int64 {
    case b of { true -> w; false -> 0 }
}

fn main() -> int64 {
    r0: int64 <- bit(tt() or ff(), 1);
    r1: int64 <- bit(ff() and tt(), 2);
    r2: int64 <- bit(tt() and ff(), 4);
    r3: int64 <- bit(tt() or tt(), 8);
    r4: int64 <- bit(ff() or tt(), 16);
    r5: int64 <- bit(ff() or ff(), 32);
    r0 + r1 + r2 + r3 + r4 + r5
}
