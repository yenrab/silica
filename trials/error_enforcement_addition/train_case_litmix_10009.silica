// expected failure E1042: function 'main' has no return type
// literal patterns, a guard and a typed wildcard on uint64; v = 1 gives 1
fn main() {
    v: uint64 <- 1;
    case v of {
        9 -> 26;
        11 -> 2;
        8 -> 20;
        m: uint64 if m > 4 -> 49;
        _: uint64 -> 1
    }
}
