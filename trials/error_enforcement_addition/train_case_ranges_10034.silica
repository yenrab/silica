// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 6 gives 106
fn main() -> int64 {
    n: int64 <- 6;
    case n of {
        n: int64 if n < 26 -> "n + 100";
        n: int64 if n >= 26 and n < 64 -> n;
        n: int64 if n >= 64 -> n / 2
    }
}
