// expected failure E2003: string binding used where an integer is expected
// concatenate of 4 pieces prints deltaomegahelloapple

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "delta";
        b: string <- "omega";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "hello");
        s1: string <- concatenate(s0, "apple");
        print_int64(s1);
        println("")
    produces
        pure :ok
    end
}
