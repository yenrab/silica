// expected failure E1049: sequence without produces
// pure sequence inside a helper; churn(1) = 9
fn churn(n: int64) -> int64 {
    sequence
        a: string <- concatenate("xx", "yy");
        b: string <- concatenate(a, a)
        pure length_bytes(b) + n
    end
}

fn main() -> int64 {
    churn(1)
}
