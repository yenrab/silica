// expected failure E2018: binding 'b' has no type annotation
// print_uint64 two; prints 85 then 44
fn main() -> atom {
    sequence proc[device_io] a: uint64 <- 27 + 58;
        b <- 44;
        _: atom <- print_uint64(a);
        println("");
        result: atom <- print_uint64(b)
        produces pure result end
}
