// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 48 * 27 < 34 * 14);
        println("");
        _: atom <- print_bool(10 * 0 >= 32);
        println("");
        result: atom <- print_bool(46 >= 29)
    produces
        pure result
    end
}
