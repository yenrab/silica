    sequence proc[device_io] _: atom <- print_bool(17 >= 30);
        println("");
        _: atom <- print_bool(36 % 6 <= (18 + 25));
        println("");
        _: atom <- print_bool(41 / 50 > 51 * 3);
        println("");
        result: atom <- print_bool((22 + 60) < 17)
        produces pure result end
