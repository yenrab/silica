// expected failure E2005: call to unknown function 'print_uint8_all'
// chained print_uint8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint8(58);
        println("");
        _: atom <- print_uint8(52 % 14);
        println("");
        result: atom <- print_uint8_all(48)
    produces pure result end
}
