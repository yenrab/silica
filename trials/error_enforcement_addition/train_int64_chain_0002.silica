// expected failure E2003: print_int64 result bound as int64 instead of atom
// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io] n_out: int64 <- print_int64(52);
        println("");
        _: atom <- print_int64(29);
        println("");
        _: atom <- print_int64(49 + 5);
        println("");
        result: atom <- print_int64(53)
        produces pure result end
}
