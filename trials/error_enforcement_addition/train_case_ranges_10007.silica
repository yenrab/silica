// expected failure E2002: undefined identifier 'nx'
// guards partition int64 into three ranges; n = 76 gives 152
fn main() -> int64 {
    n: int64 <- 76;
    case n of {
        n: int64 if n < 53 -> n - 1;
        n: int64 if n >= 53 and nx < 86 -> n * 2;
        n: int64 if n >= 86 -> n - 1
    }
}
