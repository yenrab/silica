// expected failure E2003: scale returns float32 but its result feeds print_float64
// float64 helper scale; prints 142.125
fn scale(x: float64) -> float32 {
    x * 7.0 + 2.125
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float64(scale(20.0))
        produces pure result end
}
