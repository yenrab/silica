// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 13 != 25 / 40);
        println("");
        _: atom <- print_bool(38 >= 41);
        println("");
        result: atom <- print_bool(60 >= 38 * 41)
    produces
        pure result
    end
}
