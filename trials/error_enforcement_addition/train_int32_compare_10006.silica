// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (9 + 18) >= 41 / 15);
        println("");
        _: atom <- print_bool(18 == (55 - 22));
        println("");
        _: atom <- print_bool((6 + 55) == 19 % 17);
        println("");
        result: atom <- print_bool(21 <= 29)
    produces pure result end
}
