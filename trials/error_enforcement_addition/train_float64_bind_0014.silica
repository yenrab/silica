// expected failure E2003: integer binding mixed into float arithmetic
// float64 bindings 39.25 - 33.0 printed as 6.25
fn main() -> atom {
    sequence proc[device_io]
        a: float64 <- 39.25;
        b: int64 <- 33;
        result: atom <- print_float64(a - b)
    produces
        pure result
    end
}
