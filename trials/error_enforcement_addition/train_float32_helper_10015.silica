// expected failure E2003: shift returns float64 but its result feeds print_float32
// float32 helper shift; prints 36.5
fn shift(x: float32) -> float64 {
    x + 6.25 + 4.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(shift(26.25))
    produces
        pure result
    end
}
