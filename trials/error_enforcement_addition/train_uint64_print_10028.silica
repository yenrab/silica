// expected failure E2018: binding 'result' has no type annotation
// print_uint64 two; prints 5 then 33
fn main() -> atom {
    sequence proc[device_io]
        a: uint64 <- 5 % 44;
        b: uint64 <- 33 % 50;
        _: atom <- print_uint64(a);
        println("");
        result <- print_uint64(b)
    produces pure result end
}
