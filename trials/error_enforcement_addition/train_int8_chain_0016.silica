// expected failure E1045: function 'main' declared without the fn keyword
// chained print_int8 calls separated by println
main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8(30);
        println("");
        _: atom <- print_int8((41 / 21) / (30 + 29));
        println("");
        result: atom <- print_int8(25)
    produces
        pure result
    end
}
