// expected failure E1055: binding 'leftover' is never used
// set, test and clear bit 0 of a uint64 word; expect 1
fn main() -> uint64 {
    leftover: int64 <- 41;
    one: uint64 <- 1;
    zero: uint64 <- 0;
    bit_index: int64 <- 0;
    mask: uint64 <- one shl bit_index;
    word: uint64 <- zero bor mask;
    present: uint64 <- (word band mask) shr bit_index;
    cleared: uint64 <- word band (bnot mask);
    present + cleared
}
