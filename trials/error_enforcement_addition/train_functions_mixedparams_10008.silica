// expected failure E2005: call to unknown function 'my_describe'
// parameters of three different types; describe(0, "actor", true) = 5
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    my_describe(0, "actor", true)
}
