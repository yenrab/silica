// expected failure E2003: scale returns float64 but its result feeds print_float32
// float32 helper scale; prints -20.125
fn scale(x: float32) -> float64 {
    x - 27.5 + 0.375
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(scale(7.0))
    produces pure result end
}
