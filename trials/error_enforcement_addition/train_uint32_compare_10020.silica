// expected failure E1042: function 'main' has no return type
// uint32 comparisons printed with print_bool
fn main() {
    sequence proc[device_io]
        _: atom <- print_bool((60 + 28) <= 25);
        println("");
        result: atom <- print_bool(55 <= (33 + 1))
    produces
        pure result
    end
}
