// expected failure E2005: call to unknown function 'length_bytesx'
// pure sequence inside a helper; churn(5) = 13
fn churn(n: int64) -> int64 {
    sequence
        a: string <- concatenate("xx", "yy");
        b: string <- concatenate(a, a)
    produces
        pure length_bytesx(b) + n
    end
}

fn main() -> int64 {
    churn(5)
}
