// expected failure E1055: binding 'unused_value' is never used
// recursive tri_acc on int64; tri_acc(16, 0) = 136
fn tri_acc(n: int64, acc: int64) -> int64 {
    unused_value: int64 <- 41;
    case n == 0 of {
        true -> acc;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> int64 {
    tri_acc(16, 0)
}
