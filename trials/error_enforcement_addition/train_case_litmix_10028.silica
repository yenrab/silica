// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on uint8; v = 6 gives 22
fn main() -> uint8 {
    v: uint8 <- 6;
    case v of {
        :12 -> 25;
        11 -> 14;
        10 -> 45;
        m: uint8 if m > 13 -> 4;
        _: uint8 -> 22
    }
}
