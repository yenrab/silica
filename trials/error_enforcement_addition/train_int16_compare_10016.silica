// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (48 + 53) > 43 % 30);
        println("");
        result: atom <- print_bool(37 > (27 + 55))
    produces pure result end
}
