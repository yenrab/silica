// expected failure E1055: binding 'unused_value' is never used
// record passed to a function; area(make_rect(4, 3)) = 12
fn make_rect(w: int64, h: int64) -> { width: int64, height: int64 } {
    unused_value: int64 <- 41;
    { width: w, height: h }
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

fn main() -> int64 {
    area(make_rect(4, 3))
}
