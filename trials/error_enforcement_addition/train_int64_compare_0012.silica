// expected failure E2018: binding 'result' has no type annotation
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(27 % 49 != 36);
        println("");
        _: atom <- print_bool((9 + 10) == (32 + 43));
        println("");
        _: atom <- print_bool(52 % 9 > 14 * 51);
        println("");
        _: atom <- print_bool((29 + 25) < (38 + 5));
        println("");
        result <- print_bool(28 * 30 > (37 + 39))
        produces pure result end
}
