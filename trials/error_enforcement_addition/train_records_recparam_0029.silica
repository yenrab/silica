// expected failure E1045: function 'main' declared without the fn keyword
// record passed to a function; perimeter({ width: 13, height: 12 }) = 50
fn perimeter(r: { width: int64, height: int64 }) -> int64 {
    2 * (r.width + r.height)
}

main() -> int64 {
    perimeter({ width: 13, height: 12 })
}
