// expected failure E2005: call to unknown function 'print_uint1z'
// print_uint16 two; prints 1 then 26
fn main() -> atom {
    sequence proc[device_io] a: uint16 <- 49 / 27;
        b: uint16 <- 26;
        _: atom <- print_uint16(a);
        println("");
        result: atom <- print_uint1z(b)
        produces pure result end
}
