// expected failure E4016: no main/0: entry function renamed to 'mainx'
// case producing atoms then case dispatching on them; grade(17) -> 2
fn grade(n: int64) -> atom {
    case n of {
        0 -> :zero;
        k: int64 if k < 14 -> :low;
        _: int64 -> :high
    }
}

fn mainx() -> int64 {
    g: atom <- grade(17);
    case g of {
        :zero -> 0;
        :low -> 1;
        :high -> 2;
        _: atom -> 9
    }
}
