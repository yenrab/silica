// expected failure E2005: string pattern against an atom scrutinee
// case producing atoms then case dispatching on them; grade(18) -> 2
fn grade(n: int64) -> atom {
    case n of {
        0 -> :zero;
        k: int64 if k < 3 -> :low;
        _: int64 -> :high
    }
}

fn main() -> int64 {
    g: atom <- grade(18);
    case g of {
        :zero -> 0;
        "low" -> 1;
        :high -> 2;
        _: atom -> 9
    }
}
