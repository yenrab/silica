// expected failure E1055: binding 'spare' is never used
// four arithmetic helpers; sub(14, 5) + div(26, 3) + add(29, 2) = 48
fn add(x: int64, y: int64) -> int64 {
    spare: int64 <- 41;
    x + y
}

fn sub(x: int64, y: int64) -> int64 {
    x - y
}

fn mul(x: int64, y: int64) -> int64 {
    x * y
}

fn div(x: int64, y: int64) -> int64 {
    x / y
}

fn main() -> int64 {
    sub(14, 5) + div(26, 3) + add(29, 2)//48
}
