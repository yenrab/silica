// expected failure E4015: function 'shout' defined twice
// string helper shout; prints north!!

fn shout(s: string, n: int64) -> string {
    case n == 0 of {
        true -> s;
        false -> concatenate(shout(s, n - 1), "!")
    }
}

fn shout(s: string, n: int64) -> string {
    case n == 0 of {
        true -> s;
        false -> concatenate(shout(s, n - 1), "!")
    }
}

fn main() -> atom {
    sequence proc[device_io]
        print_string(shout("north", 2));
        println("")
    produces
        pure :ok
    end
}
