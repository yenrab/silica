// expected failure E1040: missing ';' between two statements
// print_uint32 two; prints 0 then 767
fn main() -> atom {
    sequence proc[device_io]
        a: uint32 <- 57 * 0;
        b: uint32 <- (59 * 13);
        _: atom <- print_uint32(a);
        println("")
        result: atom <- print_uint32(b)
    produces pure result end
}
