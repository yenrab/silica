// expected failure E1042: function 'main' has no return type
// print_int32 two; prints 24 then 47
fn main() {
    sequence proc[device_io] a: int32 <- 24 % 37;
        b: int32 <- 17 + 30;
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
        produces pure result end
}
