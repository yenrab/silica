// expected failure E1052: duplicate sequence keyword
// chained print_int16 calls separated by println
fn main() -> atom {
    sequence sequence proc[device_io]
        _: atom <- print_int16(3);
        println("");
        _: atom <- print_int16((19 + 58) + 54);
        println("");
        _: atom <- print_int16(3);
        println("");
        result: atom <- print_int16(38 % 42)
    produces pure result end
}
