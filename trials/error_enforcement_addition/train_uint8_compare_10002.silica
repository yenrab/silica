// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (26 + 45) <= (29 + 22));
        println("");
        _: atom <- print_bool((56 + 2) == 48 % 20);
        println("");
        result: atom <- print_bool(26 / 58 < (0 + 9))
    produces pure result end
}
