// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on uint16; tri_acc(12, 0) = 78
fn tri_acc(n: uint16, acc: uint16) -> uint16 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> uint16 {
    tri_acc(12, 0)
}
