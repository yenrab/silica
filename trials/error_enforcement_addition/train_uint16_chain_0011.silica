// expected failure E2003: print_uint16 result bound as int64 instead of atom
// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint16(35);
        println("");
        _: atom <- print_uint16(2);
        println("");
        result: atom <- print_uint16(25 % 38)
    produces
        pure result
    end
}
