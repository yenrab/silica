// expected failure E2003: blend returns float64 but its result feeds print_float16
// float16 helper blend; prints -12.25
fn blend(x: float16) -> float64 {
    x - 19.75 + 5.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(blend(2.0))
    produces pure result end
}
