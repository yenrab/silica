// expected failure E2003: comparison against a string binding
// int16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 29 <= 29);
        println("");
        _: atom <- print_bool((26 - 2) <= 44);
        println("");
        _: atom <- print_bool(28 <= 57);
        println("");
        result: atom <- print_bool(9 * 31 == (13 + 21))
    produces pure result end
}
