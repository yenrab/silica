// expected failure E2005: call to unknown function 'combine_all'
// float64 helper combine; prints 322.625
fn combine(x: float64) -> float64 {
    x * 35.5 + 3.125
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(combine_all(9.0))
    produces pure result end
}
