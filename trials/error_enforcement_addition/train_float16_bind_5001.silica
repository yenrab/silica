// expected failure E2003: a declared float64 but combined with a float16 value
// float16 bindings 11.25 + 23.5 printed as 34.75
fn main() -> atom {
    sequence proc[device_io]
        a: float64 <- 11.25;
        b: float16 <- 23.5;
        result: atom <- print_float16(a + b)
    produces pure result end
}
