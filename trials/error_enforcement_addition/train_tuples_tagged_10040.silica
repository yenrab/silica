// expected failure E2005: call to unknown function 'safe_div_all'
// tagged tuple (atom, int64) from safe_div(16, 3); expect 5
fn safe_div(x: int64, y: int64) -> (atom, int64) {
    case y == 0 of {
        true -> (:error, 0);
        false -> (:ok, x / y)
    }
}

fn main() -> int64 {
    r: (atom, int64) <- safe_div_all(16, 3);
    (tag: atom, v: int64) <- r;
    case tag of {
        :ok -> v;
        _: atom -> 200
    }
}
