// expected failure E1042: function 'main' has no return type
// literal patterns, a guard and a typed wildcard on uint64; v = 11 gives 24
fn main() -> {
    v: uint64 <- 11;
    case v of {
        7 -> 50;
        4 -> 17;
        15 -> 20;
        m: uint64 if m > 11 -> 29;
        _: uint64 -> 24
    }
}
