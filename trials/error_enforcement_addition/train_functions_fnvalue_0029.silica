// expected failure E2002: undefined identifier 'x_'
// named function passed as a value; apply(twice, 40) = 80
fn twice(x: int64) -> int64 {
    x_ * 2
}

fn succ(x: int64) -> int64 {
    x + 1
}

fn apply(f: fn(int64) -> int64, v: int64) -> int64 {
    f(v)
}

fn main() -> int64 {
    apply(twice, 40)
}
