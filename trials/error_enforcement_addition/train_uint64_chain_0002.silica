// expected failure E2003: print_uint64 result bound as int64 instead of atom
// chained print_uint64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        n_out: int64 <- print_uint64(34 - 10);
        println("");
        _: atom <- print_uint64(52);
        println("");
        result: atom <- print_uint64(18)
    produces pure result end
}
