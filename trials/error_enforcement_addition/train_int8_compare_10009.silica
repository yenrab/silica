// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 58 / 46 != 56);
        println("");
        _: atom <- print_bool(8 / 35 <= 7 / 36);
        println("");
        result: atom <- print_bool((12 + 16) > (55 + 12))
    produces
        pure result
    end
}
