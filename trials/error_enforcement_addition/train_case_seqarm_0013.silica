// expected failure E4016: no main/0: entry function renamed to 'mainx'
// case inside a sequence chooses what to print
fn mainx() -> atom {
    flag: boolean <- false;
    sequence proc[device_io]
        v: int64 <- case flag of {
            true -> 5;
            false -> 9
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
