// expected failure E1055: binding 'scratch' is never used
// float16 comparisons
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_bool((27.0 + 26.0) <= (31.75 + 20.5));
        println("");
        _: atom <- print_bool(27.5 > (33.5 - 26.75));
        println("");
        _: atom <- print_bool((22.0 - 14.0) == (19.0 + 4.5));
        println("");
        done: atom <- print_bool(27.0 > (36.0 - 6.5))
    produces
        pure done
    end
}
