// expected failure E2018: binding 'b' has no type annotation
// print_int32 two; prints 65 then 89
fn main() -> atom {
    sequence proc[device_io]
        a: int32 <- 7 + 58;
        b <- 59 + 30;
        _: atom <- print_int32(a);
        println("");
        result: atom <- print_int32(b)
    produces pure result end
}
