// expected failure E1047: named struct declaration 'Node' is not allowed
// Euclid's gcd; gcd(39, 36) = 3
struct Node { x: int64, y: int64 }

fn gcd(a: int64, b: int64) -> int64 {
    case b == 0 of {
        true -> a;
        false -> gcd(b, a % b)
    }
}

fn main() -> int64 {
    gcd(39, 36)
}
