// expected failure E2003: string element printed with print_int64
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t: (int64, string, boolean) <- (75, "cloud", false);
        (k: int64, name: string, flag: boolean) <- t;
        print_int64(k);
        println("");
        print_int64(name);
        println("");
        print_bool(flag);
        println("")
    produces pure :ok end
}
