// expected failure E1060: unbalanced braces
// parameters of three different types; describe(35, "silica", true) = 41
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(35, "silica", true)
}}
