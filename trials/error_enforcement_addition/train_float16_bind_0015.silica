// expected failure E2003: integer binding mixed into float arithmetic
// float16 bindings 5.25 * 18.25 printed as 95.8125
fn main() -> atom {
    sequence proc[device_io]
        a: float16 <- 5.25;
        b: int64 <- 18;
        result: atom <- print_float16(a * b)
    produces pure result end
}
