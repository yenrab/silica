// expected failure E2003: blend returns float32 but its result feeds print_float16
// float16 helper blend; prints 65.75
fn blend(x: float16) -> float32 {
    x + 36.5 + 0.75
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(blend(28.5))
    produces pure result end
}
