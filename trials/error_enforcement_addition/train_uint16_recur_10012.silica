// expected failure E2002: undefined identifier 'missing_n'
// recursive tri_acc on uint16; tri_acc(13, 0) = 91
fn tri_acc(n: uint16, acc: uint16) -> uint16 {
    case n == 0 of {
        true -> acc;
        false -> tri_acc(n - 1, acc + missing_n)
    }
}

fn main() -> uint16 {
    tri_acc(13, 0)
}
