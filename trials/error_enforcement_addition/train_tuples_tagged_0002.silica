// expected failure E2005: integer pattern against an atom scrutinee
// tagged tuple (atom, int64) from safe_div(33, 3); expect 11
fn safe_div(x: int64, y: int64) -> (atom, int64) {
    case y == 0 of {
        true -> (:error, 0);
        false -> (:ok, x / y)
    }
}

fn main() -> int64 {
    r: (atom, int64) <- safe_div(33, 3);
    (tag: atom, v: int64) <- r;
    case tag of {
        1 -> v;
        _: atom -> 200
    }
}
