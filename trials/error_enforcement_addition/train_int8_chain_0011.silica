// expected failure E2018: binding 'result' has no type annotation
// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int8(54 + 22);
        println("");
        _: atom <- print_int8(54 - 35);
        println("");
        _: atom <- print_int8(25);
        println("");
        result <- print_int8((7 / 17))
    produces
        pure result
    end
}
