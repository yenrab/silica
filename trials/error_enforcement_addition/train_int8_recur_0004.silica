// expected failure E1055: binding 'temp_val' is never used
// recursive digit_count on int8; digit_count(87) = 2
fn digit_count(n: int8) -> int8 {
    temp_val: int64 <- 41;
    case n < 10 of {
        true -> 1;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> int8 {
    digit_count(87)
}
