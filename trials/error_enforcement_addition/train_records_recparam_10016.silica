// expected failure E2005: field name misspelled in the function body
// record passed to a function; area(make_rect(6, 15)) = 90
fn make_rect(w: int64, h: int64) -> { width: int64, height: int64 } {
    { width: w, height: h }
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.heigth
}

fn main() -> int64 {
    area(make_rect(6, 15))
}
