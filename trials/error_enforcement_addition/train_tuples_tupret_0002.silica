// expected failure E1055: binding 'temp_val' is never used
// minmax returns a pair; p + q = 27
fn minmax(x: int64, y: int64) -> (int64, int64) {
    temp_val: int64 <- 41;
    case x < y of {
        true -> (x, y);
        false -> (y, x)
    }
}

fn main() -> int64 {
    (p: int64, q: int64) <- minmax(5, 22);
    p + q
}
