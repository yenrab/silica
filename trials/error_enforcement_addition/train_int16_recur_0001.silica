// expected failure E2001: atom literal returned from the recursion base case
// recursive digit_count on int16; digit_count(120) = 3
fn digit_count(n: int16) -> int16 {
    case n < 10 of {
        true -> :one;
        false -> 1 + digit_count(n / 10)
    }
}

fn main() -> int16 {
    digit_count(120)
}
