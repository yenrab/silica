// expected failure E4016: no main/0: entry function renamed to 'mainx'
// typed `string { ... }` case arm body; want 1
fn first_char(s: string) -> string {
    case s == "" of {
        false -> string {
            c: string <- substring(s, 0, 1);
            c
        };
        true -> ""
    }
}

fn mainx() -> int64 {
    case first_char("gamma") == "g" of {
        true -> 1;
        false -> 0
    }
}
