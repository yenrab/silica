// expected failure E2001: string element inside an integer list literal
// list literal of 4 uint32 elements; length is 4
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[uint32, mem(normal)] <- ["28", 30, 10, 23];
        n: int64 <- length[uint32, mem(normal)](xs)
        produces pure n end
}
