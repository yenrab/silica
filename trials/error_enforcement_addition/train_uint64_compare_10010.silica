// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 17 % 24 <= (1 + 38));
        println("");
        _: atom <- print_bool((48 + 54) <= (51 + 55));
        println("");
        _: atom <- print_bool(35 == 49 * 52);
        println("");
        result: atom <- print_bool(25 == 10 / 55)
        produces pure result end
}
