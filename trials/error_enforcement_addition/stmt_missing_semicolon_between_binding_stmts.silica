// E1040: same gap as stmt_missing_semicolon_between_binding_and_tail_expr, but the missing ';'
// is between two binding statements inside a `sequence proc[...] ... produces ... end` block
// rather than in a plain function body. Confirmed by book-verification repro r_semi2: this
// compiles and prints 3 today, with no error.

fn main() -> int64 {
    sequence proc[device_io]
        total: int64 <- 1 + 2
        _: atom <- print_int64(total);
        println("")
    produces
        pure 0
    end
}
