// expected failure E2003: prepend called with its arguments swapped
// 3 prepends after empty; length is 3
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](xs0, 22);
        xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](28, xs1);
        xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](30, xs2);
        n: int64 <- length[int64, mem(normal)](xs3)
    produces pure n end
}
