// expected failure E2005: record pattern naming a field the type lacks
// record pattern matching (guard); expect 4
fn score(p: { x: int64, y: int64 }) -> int64 {
    case p of {
        { x: xv, w: yv } if xv > yv -> xv - yv;
        { x: xv, y: yv } if yv > xv -> yv - xv;
        { x: xv, y: yv } -> xv + yv
    }
}

fn main() -> int64 {
    p: { x: int64, y: int64 } <- { x: 2, y: 2 };
    score(p)
}
