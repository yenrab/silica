// expected failure E3010: sequence declares mem(normal) but nothing in it needs that effect
// print each field of a mixed record
fn main() -> atom {
    sequence proc[device_io, mem(normal)]
        person: { name: string, age: int64, active: boolean } <- { name: "silica", age: 66, active: true };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
    produces
        pure :ok
    end
}
