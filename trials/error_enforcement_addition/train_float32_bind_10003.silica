// expected failure E2003: integer binding mixed into float arithmetic
// float32 bindings 4.0 + 22.5 printed as 26.5
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 4.0;
        b: int64 <- 22;
        result: atom <- print_float32(a + b)
    produces
        pure result
    end
}
