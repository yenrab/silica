// expected failure E2018: binding 'r' has no type annotation
// case on an empty list; expect 76
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        r <- case xs of {
            []: List[int64, mem(normal)] -> 76;
            [h: int64, _: List[int64, mem(normal)]] -> h + 6;
            _: List[int64, mem(normal)] -> 76
        }
    produces
        pure r
    end
}
