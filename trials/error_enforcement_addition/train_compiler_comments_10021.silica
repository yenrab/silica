// expected failure E2018: binding 'b' has no type annotation
// comments must stop at the newline; want 10
// whole-line comment before the function
fn main() -> int64 {
    a: int64 <- 15; // end-of-line after a binding
    // whole-line comment between statements
    b <- 9; // another
    a / b + 9 // end-of-line after the return expression
}
