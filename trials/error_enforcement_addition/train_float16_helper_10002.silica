// expected failure E1041: trailing ';' after the pure expression
// float16 helper scale; prints 13.0
fn scale(x: float16) -> float16 {
    x + 3.0 + 4.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(scale(6.0))
    produces
        pure result;
    end
}
