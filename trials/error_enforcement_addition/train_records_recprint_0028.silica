// expected failure E2005: call to unknown function 'my_print_bool'
// print each field of a mixed record
fn main() -> atom {
    sequence proc[device_io] person: { name: string, age: int64, active: boolean } <- { name: "banana", age: 31, active: false };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        my_print_bool(person.active);
        println("")
        produces pure :ok end
}
