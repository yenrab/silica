// expected failure E2003: guard expression is an integer, not a boolean
// guards partition int64 into three ranges; n = 74 gives 148
fn main() -> int64 {
    n: int64 <- 74;
    case n of {
        n: int64 if n -> n * 2;
        n: int64 if n >= 32 and n < 81 -> n * 2;
        n: int64 if n >= 81 -> n + 100
    }
}
