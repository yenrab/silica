// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (51 + 56) < (38 / 18));
        println("");
        result: atom <- print_bool(0 * 24 >= 58 / 32)
    produces pure result end
}
