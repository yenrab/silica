// expected failure E1047: named struct declaration 'Node' is not allowed
// recursive pow2 on uint32; pow2(4) = 16
struct Node { x: int64, y: int64 }

fn pow2(n: uint32) -> uint32 {
    case n == 0 of {
        true -> 1;
        false -> 2 * pow2(n - 1)
    }
}

fn main() -> uint32 {
    pow2(4)
}
