// expected failure E2005: nested field access with a misspelled inner field
// nested inline records; width = 7
fn main() -> int64 {
    rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
        top_left: { x: 20, y: 22 },
        bottom_right: { x: 13, y: 1 }
    };
    rect.top_left.z - rect.bottom_right.x
}
