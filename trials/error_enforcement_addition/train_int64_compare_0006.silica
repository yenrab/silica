// expected failure E1053: duplicate produces keyword
// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(25 / 26 < (7 + 54));
        println("");
        _: atom <- print_bool(31 <= 1);
        println("");
        _: atom <- print_bool(0 != 25 * 24);
        println("");
        _: atom <- print_bool(58 * 40 < (56 - 25));
        println("");
        result: atom <- print_bool(50 % 29 != (33 + 7))
    produces produces
        pure result
    end
}
