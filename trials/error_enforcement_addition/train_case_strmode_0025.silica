// expected failure E1055: binding 'spare' is never used
// string case with an effectful sequence in each arm
fn main() -> atom {
    spare: int64 <- 41;
    mode: string <- "other";
    case mode of {
        "silent" -> {
            sequence proc[device_io]
                print_string("silent");
                println("");
                print_int64(0);
                println("")
            produces
                pure :ok
            end
        }
        "trace" -> {
            sequence proc[device_io]
                print_int64(4);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
