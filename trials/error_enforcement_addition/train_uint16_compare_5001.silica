// expected failure E2005: call to unknown function 'my_print_bool'
// uint16 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- my_print_bool((16 % 55) != (1 + 3));
        println("");
        _: atom <- print_bool((29 + 11) <= (44 + 23));
        println("");
        _: atom <- print_bool(38 / 11 <= 35);
        println("");
        result: atom <- print_bool(28 == 32 % 28)
        produces pure result end
}
