// expected failure E2005: call to unknown function 'substring_until_charx'
// substring_until_char from 0 up to ';'
fn main() -> atom {
    sequence proc[device_io]
        s: string <- substring_until_charx("region;stone", 0, ';');
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
