// expected failure E1049: sequence block without produces
// print_int16 two; prints 0 then 40
fn main() -> atom {
    sequence proc[device_io] a: int16 <- 6 / 41;
        b: int16 <- 40;
        _: atom <- print_int16(a);
        println("");
        result: atom <- print_int16(b)
        pure result end
}
