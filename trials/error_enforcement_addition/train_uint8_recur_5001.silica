// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on uint8; tri_acc(1, 0) = 1
fn tri_acc(n: uint8, acc: uint8) -> uint8 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> uint8 {
    tri_acc(1, 0)
}
