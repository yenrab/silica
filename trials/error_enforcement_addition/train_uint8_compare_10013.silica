// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 15 < (44 + 20));
        println("");
        _: atom <- print_bool(20 / 43 > (42 + 51));
        println("");
        _: atom <- print_bool((48 + 13) >= (12 + 57));
        println("");
        _: atom <- print_bool(13 != (54 / 57));
        println("");
        result: atom <- print_bool((35 - 10) <= 0 % 4)
    produces pure result end
}
