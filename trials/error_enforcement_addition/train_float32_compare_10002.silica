// expected failure E2018: binding 'done' has no type annotation
// float32 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(0.375 * 8.0 > 31.0 * 22.375);
        println("");
        _: atom <- print_bool((5.5 - 29.25) <= 15.375);
        println("");
        done <- print_bool(22.0 >= 23.25)
    produces
        pure done
    end
}
