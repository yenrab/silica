// expected failure E2003: comparison against a string binding
// uint64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 47 <= (16 + 22));
        println("");
        _: atom <- print_bool((6 + 16) >= (6 + 12));
        println("");
        result: atom <- print_bool(9 / 51 < 34)
    produces pure result end
}
