// expected failure E4016: no main/0: entry function renamed to 'main_program'
// recursive tri_acc on uint32; tri_acc(15, 0) = 120
fn tri_acc(n: uint32, acc: uint32) -> uint32 {
    case n == 0 of {
        true -> acc;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main_program() -> uint32 {
    tri_acc(15, 0)
}
