// expected failure E4016: no main/0: entry function renamed to 'mainx'
// int32 bindings then expression; expect 1
fn mainx() -> int32 {
    m: int32 <- 42;
    width: int32 <- m + 26;
    a: int32 <- 51;
    height: int32 <- 18 * 33;
    m / 35 % (9 + 40) + width - width + a - a + height - height
}
