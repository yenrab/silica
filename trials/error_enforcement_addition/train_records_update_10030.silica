// expected failure E4016: no main/0: entry function renamed to 'entry'
// functional record update through bump; counter ends at 62
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn entry() -> int64 {
    s0: { counter: int64, label: string } <- { counter: 34, label: "count" };
    s1: { counter: int64, label: string } <- bump(s0, 14);
    s2: { counter: int64, label: string } <- bump(s1, 14);
    s2.counter
}
