// expected failure E1055: binding 'unused_value' is never used
// chained print_int16 calls separated by println
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_int16(13);
        println("");
        _: atom <- print_int16(15);
        println("");
        result: atom <- print_int16(14 + 25)
    produces pure result end
}
