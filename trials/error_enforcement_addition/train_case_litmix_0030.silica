// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on uint64; v = 3 gives 24
fn main() -> uint64 {
    v: uint64 <- 3;
    case v of {
        :11 -> 9;
        8 -> 15;
        7 -> 18;
        m: uint64 if m > 8 -> 37;
        _: uint64 -> 24
    }
}
