// expected failure E3002: sequence declares the wrong effect; mem(normal) is used but not declared
// recursive sum_list over a list; total 10
fn sum_list(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [h: int64, t: List[int64, mem(normal)]] -> h + sum_list(t);
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        xs: List[int64, mem(normal)] <- [10];
        total: int64 <- sum_list(xs)
    produces
        pure total
    end
}
