// expected failure E2003: a declared float32 but combined with a float16 value
// float16 bindings 2.5 + 12.5 printed as 15.0
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 2.5;
        b: float16 <- 12.5;
        result: atom <- print_float16(a + b)
    produces
        pure result
    end
}
