// expected failure E2018: binding 'r' has no type annotation
// list field accessors is_nil/head; want 34
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [34, 46];
        r <- case xs.is_nil of {
            true -> 0;
            false -> xs.head
        }
    produces
        pure r
    end
}
