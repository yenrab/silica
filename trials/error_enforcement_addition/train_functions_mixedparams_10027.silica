// expected failure E4016: no main/0: entry function renamed to 'mainx'
// parameters of three different types; describe(48, "banana", false) = 48
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn mainx() -> int64 {
    describe(48, "banana", false)
}
