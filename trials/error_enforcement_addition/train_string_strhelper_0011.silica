// expected failure E1047: named struct declaration 'Pair' is not allowed
// string helper wrap; prints [south]

struct Pair { x: int64, y: int64 }

fn wrap(s: string) -> string {
    concatenate("[", concatenate(s, "]"))
}

fn main() -> atom {
    sequence proc[device_io]
        print_string(wrap("south"));
        println("")
    produces pure :ok end
}
