// expected failure E2003: combine returns float32 but its result feeds print_float16
// float16 helper combine; prints 34.0
fn combine(x: float16) -> float32 {
    x + 3.5 + 0.5
}

fn main() -> atom {
    sequence proc[device_io] result: atom <- print_float16(combine(30.0))
        produces pure result end
}
