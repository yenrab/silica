// expected failure E2005: call to unknown function 'substring_until_char_all'
// substring_until_char from 7 up to ';'
fn main() -> atom {
    sequence proc[device_io]
        s: string <- substring_until_char_all("cherry;cherry;gamma", 7, ';');
        print_string(s);
        println("")
    produces
        pure :ok
    end
}
