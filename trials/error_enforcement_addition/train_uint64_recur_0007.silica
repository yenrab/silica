// expected failure E2001: atom literal returned from the recursion base case
// recursive tri_acc on uint64; tri_acc(15, 0) = 120
fn tri_acc(n: uint64, acc: uint64) -> uint64 {
    case n == 0 of {
        true -> :done;
        false -> tri_acc(n - 1, acc + n)
    }
}

fn main() -> uint64 {
    tri_acc(15, 0)
}
