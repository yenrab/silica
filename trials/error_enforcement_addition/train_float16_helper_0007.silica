// expected failure E1041: trailing ';' after the block's final expression
// float16 helper shift; prints -19.5
fn shift(x: float16) -> float16 {
    x - 27.5 + 1.0;
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(shift(7.0))
    produces pure result end
}
