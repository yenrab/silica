// expected failure E2003: combine returns float16 but its result feeds print_float64
// float64 helper combine; prints 70.0
fn combine(x: float64) -> float16 {
    x + 26.0 + 4.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(combine(40.0))
    produces
        pure result
    end
}
