// expected failure E2211: a poke value without a RegisterN width marker (device spec §4.8)
use DeviceDescription;

impl fn registers(device: (:esp32s3_uart)) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)] {
    [
        { name: :fifo,    offset: 0x00, width: 32, access: :read_write },
        { name: :int_raw, offset: 0x04, width: 32, access: :write_one_to_clear },
        { name: :status,  offset: 0x1C, width: 32, access: :read_only },
        { name: :ctrl,    offset: 0x20, width: 32, access: :write_only }
    ]
}

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[register_rwr]
        w: device_window(L, (:esp32s3_uart)) <- map_device((:esp32s3_uart), 0x60000000);
        _: atom <- poke(w, :fifo, 7)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        d: device_actor_ref <- spawn_device(0, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device(d, 1 impl ActorMessage {})
    produces
        pure 0
    end
}
