// expected failure E2002: undefined identifier 'ns'
// guards partition int64 into three ranges; n = 92 gives 184
fn main() -> int64 {
    n: int64 <- 92;
    case n of {
        n: int64 if n < 7 -> n + 100;
        n: int64 if ns >= 7 and n < 37 -> n + 100;
        n: int64 if n >= 37 -> n * 2
    }
}
