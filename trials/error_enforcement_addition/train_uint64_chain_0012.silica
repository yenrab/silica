// expected failure E1042: function 'main' has no return type
// chained print_uint64 calls separated by println
fn main() {
    sequence proc[device_io]
        _: atom <- print_uint64((41 % 29));
        println("");
        _: atom <- print_uint64((45 / 9 * (31 / 59)));
        println("");
        _: atom <- print_uint64(27);
        println("");
        result: atom <- print_uint64(41)
    produces
        pure result
    end
}
