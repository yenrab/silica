// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 2 gives 24
fn main() -> int32 {
    v: int32 <- 2;
    case v of {
        :8 -> 18;
        5 -> 21;
        1 -> 15;
        m: int32 if m > 6 -> 7;
        _: int32 -> 24
    }
}
