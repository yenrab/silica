// expected failure E3010: combine given nine parameters
// helper combine/1 on int16; combine(15) = 72
fn combine9(p1: int64, p2: int64, p3: int64, p4: int64, p5: int64, p6: int64, p7: int64, p8: int64, p9: int64) -> int64 {
    p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
}

fn combine(x: int16) -> int16 {
    37 - x + 50
}

fn main() -> int16 {
    combine(15)
}
