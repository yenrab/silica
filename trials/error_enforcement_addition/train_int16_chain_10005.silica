// expected failure E2003: print_int16 result bound as int64 instead of atom
// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io] n_out: int64 <- print_int16(46 * 1);
        println("");
        _: atom <- print_int16((6 + 8));
        println("");
        _: atom <- print_int16(51 + 48 + (38 - 16));
        println("");
        result: atom <- print_int16(55)
        produces pure result end
}
