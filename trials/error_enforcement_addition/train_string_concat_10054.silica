// expected failure E2003: string binding used where an integer is expected
// concatenate of 3 pieces prints actordeltacherry

fn main() -> atom {
    sequence proc[device_io] a: string <- "actor";
        b: string <- "delta";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, "cherry");
        print_int64(s0);
        println("")
        produces pure :ok end
}
