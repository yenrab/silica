// expected failure E1040: missing ';' between two statements
// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((33.5 + 40.375) != 3.0 * 5.5);
        println("");
        _: atom <- print_bool((21.0 + 16.5) <= 2.5 * 25.125);
        println("");
        _: atom <- print_bool((33.125 - 5.0) == (22.125 - 20.0));
        println("")
        done: atom <- print_bool((36.25 + 36.5) <= 25.75 * 39.375)
    produces pure done end
}
