// expected failure E4016: no main/0: entry function renamed to 'main_program'
// negate_float16 applied 2 time(s); prints 1.75
fn main_program() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(negate_float16(negate_float16(1.75)))
    produces
        pure result
    end
}
