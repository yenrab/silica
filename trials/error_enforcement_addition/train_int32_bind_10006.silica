// expected failure E2003: binding width declared uint32 but used as int32
// int32 bindings then expression; expect 14
fn main() -> int32 {
    width: uint32 <- 32 % 23 + (43 * 49);
    c: int32 <- width % width;
    height: int32 <- (23 - c) * (50 % width);
    d: int32 <- c * 57;
    11 % 30 + 3 + height - height + d - d
}
