// expected failure E1055: binding 'scratch' is never used
// nested boolean cases; (true, false) selects 36
fn main() -> int64 {
    scratch: int64 <- 41;
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 84;
            false -> 36
        };
        false -> case b of {
            true -> 82;
            false -> 15
        }
    }
}
