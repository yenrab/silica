// expected failure E1055: binding 'leftover' is never used
// Positive: list allocation requires sequence proc[mem(normal_writethrough)] (spec §9.3.1)
fn main() -> int64 {
    leftover: int64 <- 41;
    sequence proc[mem(normal_writethrough)] xs: List[int64, mem(normal_writethrough)] <- [40, 10, 21, 40];
        n: int64 <- length[int64, mem(normal_writethrough)](xs)
        produces pure n end
}
