// expected failure E2018: binding 'L1' has no type annotation
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: double_write on a ref in normal_noncacheable; expect 29
fn main() -> int64 {
    sequence proc[mem(normal_noncacheable)]
        L1 <- fresh_lifetime();
        r: region(L1, normal_noncacheable) <- alloc_region(normal_noncacheable);
        cell: ref(L1, normal_noncacheable, int64) <- alloc_ref(r, 21);
        _: atom <- write_ref(cell, 59);
        _: atom <- write_ref(cell, 29);
        value: int64 <- read_ref(cell)
    produces
        pure value
    end
}
