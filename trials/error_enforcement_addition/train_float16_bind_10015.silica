// expected failure E2003: a declared float32 but combined with a float16 value
// float16 bindings 35.25 + 18.5 printed as 53.75
fn main() -> atom {
    sequence proc[device_io] a: float32 <- 35.25;
        b: float16 <- 18.5;
        result: atom <- print_float16(a + b)
        produces pure result end
}
