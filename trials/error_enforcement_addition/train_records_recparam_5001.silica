// expected failure E1041: trailing ';' after the block's final expression
// record passed to a function; area(make_rect(6, 3)) = 18
fn make_rect(w: int64, h: int64) -> { width: int64, height: int64 } {
    { width: w, height: h }
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height;
}

fn main() -> int64 {
    area(make_rect(6, 3))
}
