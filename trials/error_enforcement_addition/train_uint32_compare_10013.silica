// expected failure E1045: function 'main' declared without the fn keyword
// uint32 comparisons printed with print_bool
main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(19 % 52 < 33);
        println("");
        result: atom <- print_bool(47 != 49 % 20)
    produces
        pure result
    end
}
