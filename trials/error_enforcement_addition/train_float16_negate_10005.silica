// expected failure E1055: binding 'scratch' is never used
// negate_float16 applied 3 time(s); prints -20.0
fn main() -> atom {
    scratch: int64 <- 41;
    sequence proc[device_io]
        result: atom <- print_float16(negate_float16(negate_float16(negate_float16(20.0))))
    produces pure result end
}
