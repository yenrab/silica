// expected failure E1055: binding 'leftover' is never used
// print_uint8 two; prints 7 then 1
fn main() -> atom {
    leftover: int64 <- 41;
    sequence proc[device_io] a: uint8 <- 7 % 25;
        b: uint8 <- 26 / 17;
        _: atom <- print_uint8(a);
        println("");
        result: atom <- print_uint8(b)
        produces pure result end
}
