// expected failure E1055: binding 'scratch' is never used
// case producing atoms then case dispatching on them; grade(6) -> 1
fn grade(n: int64) -> atom {
    scratch: int64 <- 41;
    case n of {
        0 -> :zero;
        k: int64 if k < 15 -> :low;
        _: int64 -> :high
    }
}

fn main() -> int64 {
    g: atom <- grade(6);
    case g of {
        :zero -> 0;
        :low -> 1;
        :high -> 2;
        _: atom -> 9
    }
}
