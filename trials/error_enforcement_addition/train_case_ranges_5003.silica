// expected failure E2002: undefined identifier 'missing_n'
// guards partition int64 into three ranges; n = 75 gives 37
fn main() -> int64 {
    n: int64 <- 75;
    case n of {
        n: int64 if n < 28 -> n - 1;
        n: int64 if n >= 28 and n < 33 -> missing_n + 100;
        n: int64 if n >= 33 -> n / 2
    }
}
