// expected failure E4015: function 'blend' defined twice
// helper blend/3 on uint64; blend(12, 10, 2) = 14
fn blend(x: uint64, y: uint64, z: uint64) -> uint64 {
    (x - y) + (14 - z)
}

fn blend(x: uint64, y: uint64, z: uint64) -> uint64 {
    (x - y) + (14 - z)
}

fn main() -> uint64 {
    blend(12, 10, 2)
}
