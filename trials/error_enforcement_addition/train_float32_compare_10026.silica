// expected failure E1055: binding 'unused_value' is never used
// float32 comparisons
fn main() -> atom {
    unused_value: int64 <- 41;
    sequence proc[device_io]
        _: atom <- print_bool(4.0 < 28.0);
        println("");
        _: atom <- print_bool((39.375 - 8.125) < 22.0);
        println("");
        _: atom <- print_bool((33.5 + 28.75) > 25.0);
        println("");
        done: atom <- print_bool(20.25 > (18.5 + 15.5))
    produces
        pure done
    end
}
