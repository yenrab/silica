// expected failure E2005: call to unknown function 'apply_all'
// named function passed as a value; apply(succ, 39) = 40
fn twice(x: int64) -> int64 {
    x * 2
}

fn succ(x: int64) -> int64 {
    x + 1
}

fn apply(f: fn(int64) -> int64, v: int64) -> int64 {
    f(v)
}

fn main() -> int64 {
    apply_all(succ, 39)
}
