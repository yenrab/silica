// expected failure E1053: duplicate produces keyword
// float16 bindings 27.5 * 4.5 printed as 123.75
fn main() -> atom {
    sequence proc[device_io]
        a: float16 <- 27.5;
        b: float16 <- 4.5;
        result: atom <- print_float16(a * b)
    produces produces
        pure result
    end
}
