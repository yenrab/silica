// expected failure E1055: binding 'spare' is never used
// case scrutinee is a tuple-returning call; expect 40
fn pair(n: int64) -> (int64, int64) {
    spare: int64 <- 41;
    (n, n + 1)
}

fn main() -> int64 {
    case pair(15) of {
        t: (int64, int64) -> {
            (x: int64, y: int64) <- t;
            x + y + 9
        }
    }
}
