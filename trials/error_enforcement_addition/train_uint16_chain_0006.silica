// expected failure E2018: binding 'result' has no type annotation
// chained print_uint16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint16(54);
        println("");
        _: atom <- print_uint16(51);
        println("");
        result <- print_uint16(51 + 35)
    produces
        pure result
    end
}
