// expected failure E4016: no main/0: entry function renamed to 'mainx'
// record passed to a function; area(make_rect(10, 6)) = 60
fn make_rect(w: int64, h: int64) -> { width: int64, height: int64 } {
    { width: w, height: h }
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

fn mainx() -> int64 {
    area(make_rect(10, 6))
}
