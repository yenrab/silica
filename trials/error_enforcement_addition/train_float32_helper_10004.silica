// expected failure E1055: binding 'leftover' is never used
// float32 helper half_sum; prints 767.3125
fn half_sum(x: float32) -> float32 {
    leftover: int64 <- 41;
    x * 25.25 + 3.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float32(half_sum(30.25))
    produces pure result end
}
