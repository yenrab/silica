// expected failure E2018: binding 'b' has no type annotation
// sequence prints and returns the same sum 47
fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- 29;
        b <- 18;
        print_int64(a + b);
        println("");
        total: int64 <- a + b
    produces
        pure total
    end
}
