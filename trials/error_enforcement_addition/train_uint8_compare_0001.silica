// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 7 != 6 * 10);
        println("");
        _: atom <- print_bool((59 / 19) >= 28);
        println("");
        _: atom <- print_bool(5 >= 32 % 25);
        println("");
        result: atom <- print_bool((5 + 33) < 0 / 21)
    produces
        pure result
    end
}
