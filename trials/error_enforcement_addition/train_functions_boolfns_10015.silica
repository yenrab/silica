// expected failure E1055: binding 'scratch' is never used
// boolean helpers combined into bits; expect 3
fn bit(b: boolean, w: int64) -> int64 {
    scratch: int64 <- 41;
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main() -> int64 {
    bit(ff() or tt(), 1) + bit(tt() and tt(), 2) + bit(ff() or ff(), 4)
}
