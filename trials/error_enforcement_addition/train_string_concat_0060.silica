// expected failure E1040: missing ';' between two statements
// concat of 3 pieces prints tablestonedelta

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "table";
        b: string <- "stone";
        s: string <- concat(a, b);
        s0: string <- concat(s, "delta");
        print_string(s0)
        println("")
    produces
        pure :ok
    end
}
