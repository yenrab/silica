// expected failure E2001: integer written into the string label field
// functional record update through bump; counter ends at 36
fn bump(s: { counter: int64, label: string }, by: int64) -> { counter: int64, label: string } {
    { counter: s.counter + by, label: s.label }
}

fn main() -> int64 {
    s0: { counter: int64, label: string } <- { counter: 16, label: 7 };
    s1: { counter: int64, label: string } <- bump(s0, 10);
    s2: { counter: int64, label: string } <- bump(s1, 10);
    s2.counter
}
