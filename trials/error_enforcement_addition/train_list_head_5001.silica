// expected failure E2018: binding 'n' has no type annotation
// remove_head on [38, 25] gives 1
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [38, 25];
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
        n <- length[int64, mem(normal)](rest)
    produces pure n end
}
