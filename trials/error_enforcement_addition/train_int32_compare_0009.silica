// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 60 / 52 != 22 / 28);
        println("");
        result: atom <- print_bool(8 % 7 > (29 + 49))
        produces pure result end
}
