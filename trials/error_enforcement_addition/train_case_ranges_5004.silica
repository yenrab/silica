// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 30 gives 15
fn main() -> int64 {
    n: int64 <- 30;
    case n of {
        n: int64 if n < 6 -> "n + 100";
        n: int64 if n >= 6 and n < 76 -> n / 2;
        n: int64 if n >= 76 -> 0
    }
}
