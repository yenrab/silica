// expected failure E2005: call to unknown function 'println_all'
// chained print_int16 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int16(21 / 58);
        println("");
        _: atom <- print_int16(49);
        println("");
        _: atom <- print_int16(20 - 14 + 41 / 12);
        println_all("");
        result: atom <- print_int16(31)
    produces
        pure result
    end
}
