// expected failure E1047: named struct declaration 'Point' is not allowed
// sequence prints and returns the same sum 50
struct Point { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- 17;
        b: int64 <- 33;
        print_int64(a + b);
        println("");
        total: int64 <- a + b
    produces
        pure total
    end
}
