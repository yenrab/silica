// expected failure E2001: string result in one arm of an integer case
// guards partition int64 into three ranges; n = 94 gives 93
fn main() -> int64 {
    n: int64 <- 94;
    case n of {
        n: int64 if n < 9 -> "n";
        n: int64 if n >= 9 and n < 113 -> n - 1;
        n: int64 if n >= 113 -> n * 2
    }
}
