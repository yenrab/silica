// expected failure E1055: binding 'scratch' is never used
// string case with an effectful sequence in each arm
fn main() -> atom {
    scratch: int64 <- 41;
    mode: string <- "verbose";
    case mode of {
        "debug" -> {
            sequence proc[device_io]
                print_string("debug");
                println("");
                print_int64(6);
                println("")
            produces
                pure :ok
            end
        }
        "verbose" -> {
            sequence proc[device_io]
                print_int64(7);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
