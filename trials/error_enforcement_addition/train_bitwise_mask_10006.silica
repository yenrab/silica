// expected failure E1042: function 'main' has no return type
// set, test and clear bit 8 of a uint64 word; expect 1
fn main() {
    one: uint64 <- 1;
    zero: uint64 <- 0;
    bit_index: int64 <- 8;
    mask: uint64 <- one shl bit_index;
    word: uint64 <- zero bor mask;
    present: uint64 <- (word band mask) shr bit_index;
    cleared: uint64 <- word band (bnot mask);
    present + cleared
}
