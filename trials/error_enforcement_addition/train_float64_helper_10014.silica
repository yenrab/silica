// expected failure E2003: combine returns float32 but its result feeds print_float64
// float64 helper combine; prints 5.625
fn combine(x: float64) -> float32 {
    x - 30.0 + 1.5
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float64(combine(34.125))
    produces pure result end
}
