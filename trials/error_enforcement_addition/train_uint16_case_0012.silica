// expected failure E2005: string literal pattern against an integer scrutinee
// case on uint16 value 15; expect 139
fn main() -> uint16 {
    v: uint16 <- 15;
    case v of {
        :one -> 139;
        6 -> 3;
        10 -> 35;
        n: uint16 if n > 21 -> 32;
        _: uint16 -> 125
    }
}
