// expected failure E1045: function 'main' declared without the fn keyword
// boolean helpers combined into bits; expect 1
fn bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

main() -> int64 {
    bit(tt() and tt(), 1) + bit(tt() and ff(), 2) + bit(tt() == ff(), 4)
}
