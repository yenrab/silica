// expected failure E2003: blend returns float32 but its result feeds print_float16
// float16 helper blend; prints 269.25
fn blend(x: float16) -> float32 {
    x * 18.5 + 1.0
}

fn main() -> atom {
    sequence proc[device_io]
        result: atom <- print_float16(blend(14.5))
    produces
        pure result
    end
}
