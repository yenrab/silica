// expected failure E1050: produces clause without pure
// print each field of a mixed record
fn main() -> atom {
    sequence proc[device_io]
        person: { name: string, age: int64, active: boolean } <- { name: "banana", age: 76, active: false };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
    produces :ok end
}
