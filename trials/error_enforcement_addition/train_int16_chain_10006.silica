// expected failure E1042: function 'main' has no return type
// chained print_int16 calls separated by println
fn main() -> {
    sequence proc[device_io] _: atom <- print_int16(20 / (10 + 50));
        println("");
        _: atom <- print_int16(25);
        println("");
        result: atom <- print_int16(5 + 34)
        produces pure result end
}
