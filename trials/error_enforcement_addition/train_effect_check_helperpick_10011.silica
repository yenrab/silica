// expected failure E3001: print moved into the pure helper without a sequence
// Positive: pure helper chosen from a case arm; the effect runs in the sequence body
fn pick_value(flag: boolean) -> int64 {
    case flag of {
        true -> {
            print_int64(9);
            9
        };
        false -> 9
    }
}

fn main() -> atom {
    flag: boolean <- true;
    sequence proc[device_io]
        v: int64 <- pick_value(flag);
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
