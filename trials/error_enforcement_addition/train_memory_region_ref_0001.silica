// expected failure E1047: named struct declaration 'Pair' is not allowed
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: double_write on a ref in normal_writeback; expect 45
struct Pair { x: int64, y: int64 }

fn main() -> int64 {
    sequence proc[mem(normal_writeback)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal_writeback) <- alloc_region(normal_writeback);
        cell: ref(L1, normal_writeback, int64) <- alloc_ref(r, 62);
        _: atom <- write_ref(cell, 90);
        _: atom <- write_ref(cell, 45);
        value: int64 <- read_ref(cell)
    produces
        pure value
    end
}
