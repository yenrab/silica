// expected failure E2005: call to unknown function 'print_int64_all'
// decompose a mixed tuple and print each element
fn main() -> atom {
    sequence proc[device_io]
        t: (string, int64, atom) <- ("gamma", 5, :done);
        (name: string, k: int64, tag: atom) <- t;
        print_string(name);
        println("");
        print_int64_all(k);
        println("");
        print_atom(tag);
        println("")
    produces
        pure :ok
    end
}
