// expected failure E2018: binding 'back' has no type annotation
// Memory space S is explicit: `sequence proc[mem(S)]` matches `alloc_region(S)` and
// `region(L1, S)` / `ref(L1, S, ...)` / `buf(...)` (same S throughout).
// Trial: flat tuple stored in a ref and read back; expect 46
fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        t: (int64, int64) <- (23, 23);
        cell: ref(L1, normal, (int64, int64)) <- alloc_ref(r, t);
        back <- read_ref(cell);
        (x: int64, y: int64) <- back;
        value: int64 <- x + y
    produces
        pure value
    end
}
