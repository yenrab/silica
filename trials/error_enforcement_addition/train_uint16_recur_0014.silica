// expected failure E1055: binding 'unused_value' is never used
// recursive steps on uint16; steps(4, 0) = 4
fn steps(n: uint16, acc: uint16) -> uint16 {
    unused_value: int64 <- 41;
    case n == 0 of {
        true -> acc;
        false -> steps(n - 1, acc + 1)
    }
}

fn main() -> uint16 {
    steps(4, 0)
}
