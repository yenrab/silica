// Expected compile failure — read_ref into mismatched recursive tuple field type.
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        cell: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (42, :none));
        bad: (string, ref?(L, normal, rec)) <- read_ref(cell);
    produces
        pure 0
    end
}
