use StubWbtMap;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    :equal
}

fn cmp_str(_a: string, _b: string) -> :less | :equal | :greater {
    :equal
}

fn main() -> int64 {
    _: OrderedMap[int64, string, mem(normal)] <- StubWbtMap@empty({
        compare_key: cmp_i64,
        compare_value: cmp_str,
        extra_field: cmp_i64
    });
    0
}
