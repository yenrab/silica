// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 32 == (58 - 49));
        println("");
        _: atom <- print_bool((52 - 17) != (4 + 38));
        println("");
        _: atom <- print_bool(7 * 10 > 51 % 55);
        println("");
        _: atom <- print_bool(24 == (15 + 46));
        println("");
        result: atom <- print_bool(2 > 37 / 17)
    produces
        pure result
    end
}
