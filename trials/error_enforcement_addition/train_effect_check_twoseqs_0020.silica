// expected failure E1042: function 'main' has no return type
// Positive: two sequences with separate effect declarations in one function
fn main() {
    sequence proc[device_io]
        print_int64(5);
        println("")
    produces pure :ok end;
    n: int64 <- sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [5, 0]
    produces
        pure length[int64, mem(normal)](xs)
    end;
    n
}
