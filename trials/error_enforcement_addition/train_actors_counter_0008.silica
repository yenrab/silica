// expected failure E3002: spawn under a sequence that only declares device_io
// Spec §16.1.1: call(actor_ref, message) -> Reply; behavior returns (:reply, reply, new_state)
fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn main() -> atom {
    sequence proc[device_io]
        w: actor_ref <- spawn(19, acc);
        r0: int64 <- call(w, 9 impl ActorMessage {});
        print_int64(r0);
        println("");
        r1: int64 <- call(w, 5 impl ActorMessage {});
        print_int64(r1);
        println("")
    produces
        pure :ok
    end
}
