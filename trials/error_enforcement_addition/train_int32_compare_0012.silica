// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 43 * 22 >= (0 + 57));
        println("");
        _: atom <- print_bool((57 - 9) == 46);
        println("");
        _: atom <- print_bool((16 + 40) >= 27);
        println("");
        result: atom <- print_bool((54 + 7) < 35)
    produces
        pure result
    end
}
