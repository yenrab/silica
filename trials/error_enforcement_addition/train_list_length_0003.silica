// expected failure E3010: list space does not match the sequence's mem effect
// list literal of 3 int64 elements; length is 3
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal_writethrough)] <- [37, 9, 26];
        n: int64 <- length[int64, mem(normal_writethrough)](xs)
        produces pure n end
}
