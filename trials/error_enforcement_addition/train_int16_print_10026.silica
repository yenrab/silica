// expected failure E1055: binding 'spare' is never used
// print_int16 two; prints 90 then 18
fn main() -> atom {
    spare: int64 <- 41;
    sequence proc[device_io]
        a: int16 <- 35 + 55;
        b: int16 <- 18;
        _: atom <- print_int16(a);
        println("");
        result: atom <- print_int16(b)
    produces
        pure result
    end
}
