// expected failure E2003: a declared float64 but combined with a float16 value
// float16 bindings 34.0 + 34.5 printed as 68.5
fn main() -> atom {
    sequence proc[device_io]
        a: float64 <- 34.0;
        b: float16 <- 34.5;
        result: atom <- print_float16(a + b)
    produces
        pure result
    end
}
