// expected failure E1040: missing ';' between two statements
// print_uint64 two; prints 34 then 82
fn main() -> atom {
    sequence proc[device_io]
        a: uint64 <- 34;
        b: uint64 <- 54 + 28;
        _: atom <- print_uint64(a);
        println("")
        result: atom <- print_uint64(b)
    produces pure result end
}
