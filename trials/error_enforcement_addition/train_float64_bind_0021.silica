// expected failure E2005: call to unknown function 'my_print_float64'
// float64 bindings 19.5 - 0.0 printed as 19.5
fn main() -> atom {
    sequence proc[device_io]
        a: float64 <- 19.5;
        b: float64 <- 0.0;
        result: atom <- my_print_float64(a - b)
    produces pure result end
}
