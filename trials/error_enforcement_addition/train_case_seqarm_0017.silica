// expected failure E3002: sequence declares the wrong effect; device_io is used but not declared
// case inside a sequence chooses what to print
fn main() -> atom {
    flag: boolean <- false;
    sequence proc[mem(normal)]
        v: int64 <- case flag of {
            true -> 4;
            false -> 7
        };
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
