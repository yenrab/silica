// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == 56 * 14 < 5 % 21);
        println("");
        _: atom <- print_bool(49 > 8 * 37);
        println("");
        _: atom <- print_bool((1 % 6) <= 51 % 29);
        println("");
        _: atom <- print_bool(18 < (59 + 24));
        println("");
        result: atom <- print_bool(50 % 44 != 25)
        produces pure result end
}
