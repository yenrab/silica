// expected failure E2005: call to unknown function 'ttx'
// boolean helpers combined into bits; expect 1
fn bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main() -> int64 {
    bit(ff() or tt(), 1) + bit(ttx() and ff(), 2) + bit(tt() == ff(), 4)
}
