// expected failure E1047: named struct declaration 'Config' is not allowed
// float16 bindings 17.0 + 17.75 printed as 34.75
struct Config { x: int64, y: int64 }

fn main() -> atom {
    sequence proc[device_io]
        a: float16 <- 17.0;
        b: float16 <- 17.75;
        result: atom <- print_float16(a + b)
    produces
        pure result
    end
}
