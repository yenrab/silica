// expected failure E2005: call to unknown function 'my_minmax'
// minmax returns a pair; p + q = 62
fn minmax(x: int64, y: int64) -> (int64, int64) {
    case x < y of {
        true -> (x, y);
        false -> (y, x)
    }
}

fn main() -> int64 {
    (p: int64, q: int64) <- my_minmax(15, 47);
    p + q
}
