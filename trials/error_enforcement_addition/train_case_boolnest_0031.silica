// expected failure E2005: inner boolean case missing its false arm
// nested boolean cases; (true, false) selects 41
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 27
        };
        false -> case b of {
            true -> 70;
            false -> 54
        }
    }
}
