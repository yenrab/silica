// expected failure E2003: string binding used where an integer is expected
// concat of 4 pieces prints caféalphaactorcherry

fn main() -> atom {
    sequence proc[device_io] a: string <- "café";
        b: string <- "alpha";
        s: string <- concat(a, b);
        s0: string <- concat(s, "actor");
        s1: string <- concat(s0, "cherry");
        print_int64(s1);
        println("")
        produces pure :ok end
}
