// expected failure E3009: proc[...] written on the function return type instead of the sequence
// print each field of a mixed record
fn main() -> atom proc[device_io] {
    sequence proc[device_io]
        person: { name: string, age: int64, active: boolean } <- { name: "beta", age: 38, active: true };
        print_string(person.name);
        println("");
        print_int64(person.age);
        println("");
        print_bool(person.active);
        println("")
    produces pure :ok end
}
