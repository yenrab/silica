// expected failure E2003: comparison against a string binding
// uint8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (58 - 45) >= 51);
        println("");
        _: atom <- print_bool((28 + 7) != (44 + 3));
        println("");
        result: atom <- print_bool((36 + 38) <= 42 % 53)
    produces
        pure result
    end
}
