// expected failure E2001: string element inside an integer list literal
// list literal of 3 int32 elements; length is 3
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int32, mem(normal)] <- ["6", 20, 26];
        n: int64 <- length[int32, mem(normal)](xs)
    produces pure n end
}
