// expected failure E1045: function 'bit' declared without the fn keyword
// boolean helpers combined into bits; expect 6
bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main() -> int64 {
    bit(tt() and ff(), 1) + bit(ff() == ff(), 2) + bit(tt() and tt(), 4)
}
