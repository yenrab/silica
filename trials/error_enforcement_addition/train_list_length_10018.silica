// expected failure E1050: produces clause without pure
// list literal of 6 int64 elements; length is 6
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [18, 0, 32, 15, 18, 14];
        n: int64 <- length[int64, mem(normal)](xs)
    produces
        n
    end
}
