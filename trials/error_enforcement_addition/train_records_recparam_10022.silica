// expected failure E4016: no main/0: entry function renamed to 'entry'
// record passed to a function; area(make_rect(8, 10)) = 80
fn make_rect(w: int64, h: int64) -> { width: int64, height: int64 } {
    { width: w, height: h }
}

fn area(r: { width: int64, height: int64 }) -> int64 {
    r.width * r.height
}

fn entry() -> int64 {
    area(make_rect(8, 10))
}
