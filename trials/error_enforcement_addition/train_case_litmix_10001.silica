// expected failure E2005: atom pattern against an integer scrutinee
// literal patterns, a guard and a typed wildcard on int32; v = 0 gives 27
fn main() -> int32 {
    v: int32 <- 0;
    case v of {
        :15 -> 12;
        11 -> 38;
        1 -> 41;
        m: int32 if m > 4 -> 13;
        _: int32 -> 27
    }
}
