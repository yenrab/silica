// expected failure E4016: no main/0: entry function renamed to 'main_program'
// float32 comparisons
fn main_program() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((29.0 + 8.0) == 21.125);
        println("");
        done: atom <- print_bool((0.0 + 16.375) == (24.5 - 34.75))
    produces
        pure done
    end
