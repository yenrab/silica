// expected failure E1042: function 'main' has no return type
// collatz steps for 20 = 7
fn collatz(n: int64, acc: int64) -> int64 {
    case n == 1 of {
        true -> acc;
        false -> case n % 2 == 0 of {
            true -> collatz(n / 2, acc + 1);
            false -> collatz(3 * n + 1, acc + 1)
        }
    }
}

fn main() {
    collatz(20, 0)
}
