// expected failure E1042: function 'main' has no return type
// int16 comparisons printed with print_bool
fn main() -> {
    sequence proc[device_io]
        _: atom <- print_bool((25 % 49) >= 55);
        println("");
        result: atom <- print_bool(31 != (33 % 1))
    produces
        pure result
    end
}
