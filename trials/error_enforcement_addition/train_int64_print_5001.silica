// expected failure E2005: call to unknown function 'print_int6z'
// print_int64 two; prints 85 then 9
fn main() -> atom {
    sequence proc[device_io] a: int64 <- 55 + 30;
        b: int64 <- 44 - 35;
        _: atom <- print_int6z(a);
        println("");
        result: atom <- print_int64(b)
        produces pure result end
}
