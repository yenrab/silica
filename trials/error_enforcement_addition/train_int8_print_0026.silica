// expected failure E1042: function 'main' has no return type
// print_int8 two; prints 97 then 45
fn main() {
    sequence proc[device_io]
        a: int8 <- 53 + 44;
        b: int8 <- 45;
        _: atom <- print_int8(a);
        println("");
        result: atom <- print_int8(b)
    produces pure result end
}
