// expected failure E2002: undefined identifier 'ns'
// mutual recursion even/odd; even(1) + odd(6) = 0
fn even(n: int64) -> int64 {
    case n == 0 of {
        true -> 1;
        false -> odd(ns - 1)
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

fn main() -> int64 {
    even(1) + odd(6)
}
