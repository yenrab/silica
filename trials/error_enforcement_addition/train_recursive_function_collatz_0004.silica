// expected failure E2002: undefined identifier 'missing_n'
// collatz steps for 6 = 8
fn collatz(n: int64, acc: int64) -> int64 {
    case n == 1 of {
        true -> acc;
        false -> case n % 2 == 0 of {
            true -> collatz(n / 2, acc + 1);
            false -> collatz(3 * missing_n + 1, acc + 1)
        }
    }
}

fn main() -> int64 {
    collatz(6, 0)
}
