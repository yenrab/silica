// expected failure E3009: proc[...] written on the function return type instead of the sequence
// chained print_int8 calls separated by println
fn main() -> atom proc[device_io] {
    sequence proc[device_io]
        _: atom <- print_int8(54);
        println("");
        _: atom <- print_int8(10);
        println("");
        _: atom <- print_int8(19 + 15);
        println("");
        result: atom <- print_int8(3)
    produces
        pure result
    end
}
