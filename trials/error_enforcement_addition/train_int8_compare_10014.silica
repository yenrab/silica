// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 56 / 36 == (44 + 25));
        println("");
        result: atom <- print_bool(3 * 28 < (4 + 20))
    produces
        pure result
    end
}
