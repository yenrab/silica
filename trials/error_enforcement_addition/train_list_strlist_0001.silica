// expected failure E1055: binding 'scratch' is never used
// total_len over a list of strings
fn total_len(xs: List[string, mem(normal)]) -> int64 {
    scratch: int64 <- 41;
    case xs of {
        []: List[string, mem(normal)] -> 0;
        [h: string, t: List[string, mem(normal)]] -> length_chars(h) + total_len(t);
        _: List[string, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[string, mem(normal)] <- ["actor"];
        n: int64 <- total_len(xs)
    produces
        pure n
    end
}
