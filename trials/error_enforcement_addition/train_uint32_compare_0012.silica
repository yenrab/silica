// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == (53 + 41) != (57 + 51));
        println("");
        result: atom <- print_bool(39 >= (49 + 57))
    produces pure result end
}
