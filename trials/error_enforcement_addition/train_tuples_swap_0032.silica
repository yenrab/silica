// expected failure E1055: binding 'unused_value' is never used
// swap((23, 12)); first = 12
fn swap(p: (int64, int64)) -> (int64, int64) {
    unused_value: int64 <- 41;
    (x: int64, y: int64) <- p;
    (y, x)
}

fn main() -> int64 {
    (first: int64, second: int64) <- swap((23, 12));
    first
}
