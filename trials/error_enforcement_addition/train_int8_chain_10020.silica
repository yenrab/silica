// expected failure E1041: trailing ';' after the pure expression
// chained print_int8 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int8(43);
        println("");
        _: atom <- print_int8(45);
        println("");
        result: atom <- print_int8((44 + 19) / 58)
        produces pure result; end
}
