// expected failure E2003: comparison against a string binding
// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x"; _: atom <- print_bool(label == (1 + 22) != 58 * 60);
        println("");
        _: atom <- print_bool((50 * 50) < 10);
        println("");
        result: atom <- print_bool((46 - 26) <= (17 + 44))
        produces pure result end
}
