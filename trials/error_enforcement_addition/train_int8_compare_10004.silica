// expected failure E2003: comparison against a string binding
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 0 <= (42 + 6));
        println("");
        _: atom <- print_bool(49 % 40 > 6);
        println("");
        _: atom <- print_bool((29 + 31) > (22 + 45));
        println("");
        _: atom <- print_bool((43 + 52) < 7);
        println("");
        result: atom <- print_bool(32 >= (11 + 17))
    produces pure result end
}
