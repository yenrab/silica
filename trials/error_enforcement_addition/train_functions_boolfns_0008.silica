// expected failure E2005: call to unknown function 'my_ff'
// boolean helpers combined into bits; expect 6
fn bit(b: boolean, w: int64) -> int64 {
    case b of { true -> w; false -> 0 }
}

fn tt() -> boolean {
    true
}

fn ff() -> boolean {
    false
}

fn main() -> int64 {
    bit(tt() == my_ff(), 1) + bit(tt() and tt(), 2) + bit(ff() == ff(), 4)
}
