// expected failure E2001: string literal in one case arm of an integer case
// case on uint64 value 12; expect 170
fn main() -> uint64 {
    v: uint64 <- 12;
    case v of {
        8 -> "187";
        34 -> 64;
        23 -> 68;
        33 -> 105;
        n: uint64 if n > 15 -> 115;
        _: uint64 -> 170
    }
}
