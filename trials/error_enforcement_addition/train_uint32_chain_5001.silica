// expected failure E1042: function 'main' has no return type
// chained print_uint32 calls separated by println
fn main() -> {
    sequence proc[device_io]
        _: atom <- print_uint32(47 + 0);
        println("");
        _: atom <- print_uint32(58);
        println("");
        result: atom <- print_uint32(2)
    produces
        pure result
    end
}
