// expected failure E2003: comparison against a string binding
// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        label: string <- "x";
        _: atom <- print_bool(label == 9 >= 40);
        println("");
        _: atom <- print_bool(21 <= (36 + 6));
        println("");
        result: atom <- print_bool((21 + 12) == (58 + 34))
    produces pure result end
}
