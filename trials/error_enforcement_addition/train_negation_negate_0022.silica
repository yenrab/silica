// expected failure E1055: binding 'leftover' is never used
// negate_float32 applied 2 time(s); prints 31.0
fn main() -> atom {
    leftover: int64 <- 41;
    sequence proc[device_io]
        result: atom <- print_float32(negate_float32(negate_float32(31.0)))
    produces
        pure result
    end
}
