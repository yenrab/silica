// expected failure E1045: function 'main' declared without the fn keyword
// int32 comparisons printed with print_bool
main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(6 % 50 == (44 % 16));
        println("");
        _: atom <- print_bool((20 + 17) < 5 * 20);
        println("");
        result: atom <- print_bool((55 + 22) >= (15 % 53))
    produces pure result end
}
