// expected failure E2003: integer binding mixed into float arithmetic
// float32 bindings 17.125 - 25.375 printed as -8.25
fn main() -> atom {
    sequence proc[device_io]
        a: float32 <- 17.125;
        b: int64 <- 25;
        result: atom <- print_float32(a - b)
    produces
        pure result
    end
}
