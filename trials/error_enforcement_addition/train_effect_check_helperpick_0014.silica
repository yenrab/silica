// expected failure E2018: binding 'v' has no type annotation
// Positive: pure helper chosen from a case arm; the effect runs in the sequence body
fn pick_value(flag: boolean) -> int64 {
    case flag of {
        true -> 1;
        false -> 3
    }
}

fn main() -> atom {
    flag: boolean <- true;
    sequence proc[device_io]
        v <- pick_value(flag);
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
