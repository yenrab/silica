// expected failure E2002: undefined identifier 'x2'
// named function passed as a value; apply(twice, 27) = 54
fn twice(x: int64) -> int64 {
    x * 2
}

fn succ(x: int64) -> int64 {
    x2 + 1
}

fn apply(f: fn(int64) -> int64, v: int64) -> int64 {
    f(v)
}

fn main() -> int64 {
    apply(twice, 27)
}
