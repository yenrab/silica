// expected failure E1055: binding 'leftover' is never used
// parameters of three different types; describe(39, "gamma", false) = 39
fn describe(n: int64, s: string, flag: boolean) -> int64 {
    leftover: int64 <- 41;
    case flag of {
        true -> n + length_chars(s);
        false -> n
    }
}

fn main() -> int64 {
    describe(39, "gamma", false)
}
