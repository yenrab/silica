// expected failure E2002: undefined identifier 'n2'
// mutual recursion even/odd; even(8) + odd(9) = 2
fn even(n: int64) -> int64 {
    case n2 == 0 of {
        true -> 1;
        false -> odd(n - 1)
    }
}

fn odd(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> even(n - 1)
    }
}

fn main() -> int64 {
    even(8) + odd(9)
}
