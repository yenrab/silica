// expected failure E4016: no main/0: entry function renamed to 'start'
// concatenate of 2 pieces prints über🎉

fn start() -> atom {
    sequence proc[device_io] a: string <- "über";
        b: string <- "🎉";
        s: string <- concatenate(a, b);
        print_string(s);
        println("")
        produces pure :ok end
}
