// expected failure E2018: binding 'b' has no type annotation
// print_int16 two; prints 49 then 25
fn main() -> atom {
    sequence proc[device_io] a: int16 <- 11 + 38;
        b <- 25;
        _: atom <- print_int16(a);
        println("");
        result: atom <- print_int16(b)
        produces pure result end
}
