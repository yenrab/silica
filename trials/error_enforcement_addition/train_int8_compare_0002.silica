// expected failure E1060: unbalanced braces
// int8 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((36 + 48) > 56);
        println("");
        _: atom <- print_bool((15 + 5) > 3 * 34);
        println("");
        _: atom <- print_bool(0 % 55 != (50 - 23));
        println("");
        _: atom <- print_bool(37 == (27 - 2));
        println("");
        result: atom <- print_bool(25 / 4 >= (4 % 22))
        produces pure result end
}}
