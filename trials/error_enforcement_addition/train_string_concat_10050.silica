// expected failure E2001: integer literal passed to concatenate
// concatenate of 3 pieces prints silicachair世界

fn main() -> atom {
    sequence proc[device_io]
        a: string <- "silica";
        b: string <- "chair";
        s: string <- concatenate(a, b);
        s0: string <- concatenate(s, 2);
        print_string(s0);
        println("")
    produces
        pure :ok
    end
}
