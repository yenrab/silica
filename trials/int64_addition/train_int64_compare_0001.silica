// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(0 * 45 >= (42 + 32));
        println("");
        _: atom <- print_bool((23 + 18) < 57 % 33);
        println("");
        _: atom <- print_bool(52 / 32 < (57 + 5));
        println("");
        result: atom <- print_bool((26 + 45) >= 11 / 44)
    produces
        pure result
    end
}
