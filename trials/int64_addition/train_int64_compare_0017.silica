// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((54 + 14) < (40 + 43));
        println("");
        _: atom <- print_bool((50 + 33) != 14);
        println("");
        _: atom <- print_bool((53 + 52) <= (59 + 19));
        println("");
        _: atom <- print_bool(58 / 17 == 16 * 43);
        println("");
        result: atom <- print_bool((60 + 32) < 24 / 51)
    produces pure result end
}
