// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((45 * 7) != 33);
        println("");
        _: atom <- print_bool((49 - 28) <= (1 + 42));
        println("");
        result: atom <- print_bool(28 % 43 <= (34 + 13))
    produces
        pure result
    end
}
