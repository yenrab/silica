// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(6);
        println("");
        _: atom <- print_int64(4);
        println("");
        _: atom <- print_int64(49 - (16 + 8));
        println("");
        result: atom <- print_int64(53 - 27 + (58 + 36))
    produces
        pure result
    end
}
