// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(59 + 40);
        println("");
        _: atom <- print_int64(59 % 23 - 59 % 28);
        println("");
        _: atom <- print_int64(19);
        println("");
        result: atom <- print_int64(56 / 11)
    produces pure result end
}
