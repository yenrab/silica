// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((51 - 34) != 7);
        println("");
        _: atom <- print_bool(32 > 26 * 55);
        println("");
        _: atom <- print_bool(56 / 30 == (4 + 26));
        println("");
        _: atom <- print_bool((37 + 9) < 58 * 19);
        println("");
        result: atom <- print_bool(11 / 44 <= (57 - 0))
    produces
        pure result
    end
}
