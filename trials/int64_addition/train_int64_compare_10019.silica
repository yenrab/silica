// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(0 <= 3);
        println("");
        _: atom <- print_bool((50 + 54) > 39 / 57);
        println("");
        result: atom <- print_bool((6 + 38) >= (50 + 26))
    produces pure result end
}
