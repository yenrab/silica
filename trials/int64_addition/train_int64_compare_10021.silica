// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(32 >= 31);
        println("");
        _: atom <- print_bool((47 / 42) <= (34 - 13));
        println("");
        result: atom <- print_bool((16 + 6) == 32 % 54)
        produces pure result end
}
