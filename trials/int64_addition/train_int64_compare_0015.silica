// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(30 >= 23 % 60);
        println("");
        _: atom <- print_bool(21 % 49 >= 42 % 34);
        println("");
        result: atom <- print_bool(19 * 22 <= 56 % 12)
    produces
        pure result
    end
}
