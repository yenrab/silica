// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((8 + 45) >= (41 + 46));
        println("");
        _: atom <- print_bool(35 < 51 / 57);
        println("");
        _: atom <- print_bool(6 * 30 <= (51 + 60));
        println("");
        result: atom <- print_bool((12 + 18) != (36 - 23))
        produces pure result end
}
