// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((47 + 32) == 53 * 58);
        println("");
        _: atom <- print_bool(0 == 13 * 25);
        println("");
        result: atom <- print_bool(46 % 35 >= 37 / 20)
    produces pure result end
}
