// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(28 * 22);
        println("");
        _: atom <- print_int64(11);
        println("");
        result: atom <- print_int64(34 / 42 * (24 - 19))
    produces
        pure result
    end
}
