// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((25 + 39) >= 38);
        println("");
        _: atom <- print_bool(25 / 13 != 52 % 32);
        println("");
        _: atom <- print_bool(51 * 12 <= 54 / 15);
        println("");
        _: atom <- print_bool(60 % 24 < 48 % 7);
        println("");
        result: atom <- print_bool(45 / 50 <= 49 % 8)
        produces pure result end
}
