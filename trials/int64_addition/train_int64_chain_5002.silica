// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(11);
        println("");
        _: atom <- print_int64((34 * 40));
        println("");
        result: atom <- print_int64(10 * 55 + 17 / 32)
    produces pure result end
}
