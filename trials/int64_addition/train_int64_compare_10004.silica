// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(24 > 12);
        println("");
        _: atom <- print_bool((43 - 8) == 57 * 59);
        println("");
        _: atom <- print_bool((58 + 39) <= 33);
        println("");
        _: atom <- print_bool((39 + 48) < 19);
        println("");
        result: atom <- print_bool((21 - 19) <= 31 % 53)
    produces pure result end
}
