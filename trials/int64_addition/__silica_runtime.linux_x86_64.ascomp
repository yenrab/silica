	.p2align	2
# -- Begin function silica_rt_build_int_range_list
silica_rt_build_int_range_list:
# rdi=start rsi=count -> rdi=cons list [start..start+count-1] or nil
# frame: [rbp-8] start (X19), [rbp-16] count (X20), [rbp-24] head (X21), [rbp-32] value (X22)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], 0
	test	rsi, rsi
	jz	LBBrl_done
	lea	rax, [rdi + rsi - 1]
	mov	QWORD PTR [rbp - 32], rax
LBBrl_loop:
	mov	edi, 16
	call	malloc
	test	rax, rax
	jz	LBBrl_done
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax], rcx
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 8], rcx
	mov	QWORD PTR [rbp - 24], rax
	mov	rcx, QWORD PTR [rbp - 32]
	sub	rcx, 1
	mov	QWORD PTR [rbp - 32], rcx
	cmp	rcx, QWORD PTR [rbp - 8]
	jge	LBBrl_loop
LBBrl_done:
	mov	rdi, QWORD PTR [rbp - 24]
	leave
	ret
# -- End function
# rdi = sysctl name cstring. Returns edi = int32 value, or -1 on failure.
	.p2align	2
silica_rt_sysctl_i32:
# frame: [rbp-8] name (X19); [rsp] value, [rsp+8] length (the AArch64 [sp], [sp, #8])
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_si32_fail
	mov	edi, DWORD PTR [rsp]
	leave
	ret
L_si32_fail:
	mov	edi, -1
	leave
	ret
# rdi = C string pointer, rsi = tail (cons list or 0). Returns rdi = new head; malloc fail returns the tail.
	.p2align	2
silica_rt_cons_cstr_list:
# frame: [rbp-8] cstring (X19), [rbp-16] tail (X20)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	edi, 16
	call	malloc
	test	rax, rax
	jz	L_ccl_fail
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], rcx
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 8], rcx
	mov	rdi, rax
	leave
	ret
L_ccl_fail:
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
# Machine-wide sysctl hw.optional.* flags -> cons list of cstrings (see cpu_topology_implementation_plan).
	.globl	silica_rt_apple_hw_optional_caps_list
	.p2align	2
silica_rt_apple_hw_optional_caps_list:
# frame: [rbp-8] list head (X19)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], 0
	lea	rdi, [rip + L_sc_opt_neon]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_1
	lea	rdi, [rip + L_tok_opt_neon]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_1:
	lea	rdi, [rip + L_sc_opt_armv8crc]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_2
	lea	rdi, [rip + L_tok_opt_armv8crc]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_2:
	lea	rdi, [rip + L_sc_opt_arm64]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_3
	lea	rdi, [rip + L_tok_opt_arm64]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_3:
	lea	rdi, [rip + L_sc_opt_lse]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_4
	lea	rdi, [rip + L_tok_opt_lse]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_4:
	lea	rdi, [rip + L_sc_opt_sha512]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_5
	lea	rdi, [rip + L_tok_opt_sha512]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_5:
	lea	rdi, [rip + L_sc_opt_sha256]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_6
	lea	rdi, [rip + L_tok_opt_sha256]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_6:
	lea	rdi, [rip + L_sc_opt_aes]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_7
	lea	rdi, [rip + L_tok_opt_aes]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_7:
	lea	rdi, [rip + L_sc_opt_advsimd]
	call	silica_rt_sysctl_i32
	cmp	edi, 1
	jne	L_iho_done
	lea	rdi, [rip + L_tok_opt_advsimd]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_cons_cstr_list
	mov	QWORD PTR [rbp - 8], rdi
L_iho_done:
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	ret
# rdi = sysctl name cstring. Returns rdi = uint64 (0 on failure).
	.p2align	2
silica_rt_sysctl_u64:
# frame: [rbp-8] name (X19); [rsp] value, [rsp+8] length (the AArch64 [sp], [sp, #8])
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	DWORD PTR [rsp + 8], 8
	mov	QWORD PTR [rsp], 0
	mov	QWORD PTR [rsp + 8], 0
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_s64_fail
	mov	rdi, QWORD PTR [rsp]
	leave
	ret
L_s64_fail:
	xor	edi, edi
	leave
	ret
# Apple Silicon cache_info.levels: sysctl exposes per-cluster L1D/L2 (hw.perflevel0/1.*), aggregate hw.l1d/l2/l3,
# hw.cachelinesize, hw.nperflevels. Not exposed in sysctl: SLC/unified last-level cache as a stable L3; associativity
# (we store 0). rdi=P, rsi=E, rdx=total, rcx=all-core-ids list. Returns rdi = list head (cons spine) or 0.
	.globl	silica_rt_apple_build_cache_levels
	.p2align	2
silica_rt_apple_build_cache_levels:
# frame: [rbp-8] P (X19), [rbp-16] E (X20), [rbp-24] total (X21), [rbp-32] head (X22), [rbp-40] line (X23),
# [rbp-48] P ids (X24), [rbp-56] E ids (X25), [rbp-64] all ids (X26), [rbp-72] nperflevels (X27),
# [rbp-80] all-core-ids arg (X28); [rsp] sysctl value, [rsp+8] sysctl length
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	QWORD PTR [rbp - 80], rcx
	mov	QWORD PTR [rbp - 32], 0
	lea	rdi, [rip + L_hw_cachelinesize_str]
	call	silica_rt_sysctl_u64
	mov	QWORD PTR [rbp - 40], rdi
	xor	edi, edi
	mov	esi, DWORD PTR [rbp - 8]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 48], rdi
	cmp	DWORD PTR [rbp - 16], 0
	je	L_bc_no_epl
	mov	edi, DWORD PTR [rbp - 8]
	mov	esi, DWORD PTR [rbp - 16]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 56], rdi
	jmp	L_bc_have_epl
L_bc_no_epl:
	mov	QWORD PTR [rbp - 56], 0
L_bc_have_epl:
	xor	edi, edi
	mov	esi, DWORD PTR [rbp - 24]
	call	silica_rt_build_int_range_list
	mov	QWORD PTR [rbp - 64], rdi
	mov	DWORD PTR [rsp + 8], 4
	mov	DWORD PTR [rsp], 0
	lea	rdi, [rip + L_hw_nperflevels_str]
	mov	rsi, rsp
	lea	rdx, [rsp + 8]
	xor	ecx, ecx
	xor	r8d, r8d
	call	silica_rt_sysctlbyname
	test	edi, edi
	jnz	L_bc_nperf_fail
	mov	eax, DWORD PTR [rsp]
	mov	QWORD PTR [rbp - 72], rax
	cmp	eax, 2
	jae	L_bc_dual
	jmp	L_bc_agg
L_bc_nperf_fail:
L_bc_agg:
	lea	rdi, [rip + L_hw_l3cachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_a_skip_l3
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_a_skip_l3
	mov	esi, 3
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_a_skip_l3:
	lea	rdi, [rip + L_hw_l2cachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_a_skip_l2
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_a_skip_l2
	mov	esi, 2
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_a_skip_l2:
	lea	rdi, [rip + L_hw_l1dcachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_done
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_done
	mov	esi, 1
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
	jmp	L_bc_done
L_bc_dual:
	lea	rdi, [rip + L_hw_l3cachesize_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_l3
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_l3
	mov	esi, 3
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 64]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_l3:
	cmp	DWORD PTR [rbp - 16], 0
	je	L_bc_d_skip_el2
	lea	rdi, [rip + L_hw_pl1_l2_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_el2
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_el2
	mov	esi, 2
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 56]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_el2:
	cmp	DWORD PTR [rbp - 8], 0
	je	L_bc_d_skip_pl2
	lea	rdi, [rip + L_hw_pl0_l2_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_pl2
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_pl2
	mov	esi, 2
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 48]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_pl2:
	cmp	DWORD PTR [rbp - 16], 0
	je	L_bc_d_skip_el1
	lea	rdi, [rip + L_hw_pl1_l1d_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_d_skip_el1
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_d_skip_el1
	mov	esi, 1
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 56]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_d_skip_el1:
	cmp	DWORD PTR [rbp - 8], 0
	je	L_bc_done
	lea	rdi, [rip + L_hw_pl0_l1d_str]
	call	silica_rt_sysctl_u64
	test	rdi, rdi
	jz	L_bc_done
	mov	rdx, rdi
	shr	rdx, 10
	test	rdx, rdx
	jz	L_bc_done
	mov	esi, 1
	mov	rcx, QWORD PTR [rbp - 40]
	xor	r8d, r8d
	mov	r9, QWORD PTR [rbp - 48]
	mov	rdi, QWORD PTR [rbp - 32]
	call	L_bc_push
	mov	QWORD PTR [rbp - 32], rdi
L_bc_done:
	mov	rdi, QWORD PTR [rbp - 32]
	leave
	ret
# rdi=head rsi=level rdx=size_kb rcx=line r8=assoc r9=shared -> rdi=new head (malloc failure returns head)
L_bc_push:
# frame: [rbp-8] head (X19), [rbp-16] level (X20), [rbp-24] size_kb (X21), [rbp-32] line, [rbp-40] assoc,
# [rbp-48] shared, [rbp-56] entry pointer
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	QWORD PTR [rbp - 32], rcx
	mov	QWORD PTR [rbp - 40], r8
	mov	QWORD PTR [rbp - 48], r9
	mov	edi, 40
	call	malloc
	test	rax, rax
	jz	L_bcp_fail
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax], rcx
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 8], rcx
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 16], rcx
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 24], rcx
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 32], rcx
	mov	QWORD PTR [rbp - 56], rax
	mov	edi, 16
	call	malloc
	test	rax, rax
	jz	L_bcp_fail
	mov	rcx, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rax], rcx
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 8], rcx
	mov	rdi, rax
	leave
	ret
L_bcp_fail:
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	ret
	.bss
	.p2align	3
silica_actor_pthread_key:
	.zero	8
silica_actor_tls_init_lock:
	.zero	4
silica_actor_tls_key_ready:
	.zero	1
	.text
	.globl	silica_rt_ensure_actor_tls_key
	.p2align	2
silica_rt_ensure_actor_tls_key:
# frame: [rbp-16] address of silica_actor_tls_key_ready (X20)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	lea	rax, [rip + silica_actor_tls_key_ready]
	mov	QWORD PTR [rbp - 16], rax
	movzx	eax, BYTE PTR [rax]
	test	eax, eax
	jnz	L_tlse_done
	lea	rdi, [rip + silica_actor_tls_init_lock]
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 16]
	movzx	eax, BYTE PTR [rax]
	test	eax, eax
	jnz	L_tlse_unlock
	lea	rdi, [rip + silica_actor_pthread_key]
	xor	esi, esi
	call	pthread_key_create
	test	eax, eax
	jnz	L_tlse_unlock
	mov	rax, QWORD PTR [rbp - 16]
	mov	BYTE PTR [rax], 1
L_tlse_unlock:
	lea	rdi, [rip + silica_actor_tls_init_lock]
	call	silica_rt_lock_unlock
L_tlse_done:
	leave
	ret
	.globl	silica_rt_tls_current_actor_get
	.p2align	2
silica_rt_tls_current_actor_get:
# -> rdi = current actor (pthread_getspecific result) or 0
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	call	silica_rt_ensure_actor_tls_key
	lea	rax, [rip + silica_actor_pthread_key]
	mov	rdi, QWORD PTR [rax]
	call	pthread_getspecific
	mov	rdi, rax
	leave
	ret
	.globl	silica_rt_tls_actor_set_from_x19
	.p2align	2
silica_rt_tls_actor_set_from_x19:
# rdi = ACB (the caller's X19 value, moved into rdi by the caller); kept in [rsp] across
# silica_rt_ensure_actor_tls_key. Nothing of the caller's frame is read or reloaded.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rsp], rdi
	call	silica_rt_ensure_actor_tls_key
	mov	rsi, QWORD PTR [rsp]
	lea	rax, [rip + silica_actor_pthread_key]
	mov	rdi, QWORD PTR [rax]
	call	pthread_setspecific
	mov	rdi, rax
	leave
	ret
	.p2align	2
silica_rt_actor_init_region: # arena bookkeeping for the actor's implicit heap
# rdi=actor_ptr. The arena is a chain of anonymous blocks allocated on demand by
# silica_rt_region_alloc, so nothing is mapped here: #160 newest block (header: prev, size),
# #168 bytes mapped so far, #176 bump pointer, #184 limit of the newest block.
	mov	QWORD PTR [rdi + 160], 0
	mov	QWORD PTR [rdi + 168], 0
	mov	QWORD PTR [rdi + 176], 0
	mov	QWORD PTR [rdi + 184], 0
	ret
# -- End function
	.p2align	2
silica_rt_actor_dealloc_region: # release every arena block of an actor
# rdi=actor_ptr. Walks the block chain from #160 and munmaps each block.
# frame: [rbp-8] block (X19), [rbp-16] actor (X20), [rbp-24] previous block (X21)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, QWORD PTR [rdi + 160]
	mov	QWORD PTR [rbp - 8], rax
LBBdr_loop:
	mov	rdi, QWORD PTR [rbp - 8]
	test	rdi, rdi
	jz	LBBdr_done
	mov	rax, QWORD PTR [rdi]
	mov	QWORD PTR [rbp - 24], rax
	mov	rsi, QWORD PTR [rdi + 8]
	call	munmap
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rbp - 8], rax
	jmp	LBBdr_loop
LBBdr_done:
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 160], 0
	mov	QWORD PTR [rax + 168], 0
	mov	QWORD PTR [rax + 176], 0
	mov	QWORD PTR [rax + 184], 0
	leave
	ret
# -- End function
	.section .rodata
	.p2align	2
L_silica_root_actor_exit:
	.asciz	"[silica] root actor exited (no supervisor)\n"
