	.globl	silica_rt_sync_fault_handler
	.p2align	4
silica_rt_sync_fault_handler:
# C-called: rdi = signo, rsi = siginfo*, rdx = ucontext*. Frame slots: [rbp-8] x19 fault address,
# [rbp-16] x20 actor, [rbp-24] x21 stack base, [rbp-32] x22 signo, [rbp-40] x23 siginfo,
# [rbp-48] x24 ucontext, [rbp-56..-88] the caller's rbx r12 r13 r14 r15.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 56], rbx
	mov	QWORD PTR [rbp - 64], r12
	mov	QWORD PTR [rbp - 72], r13
	mov	QWORD PTR [rbp - 80], r14
	mov	QWORD PTR [rbp - 88], r15
	mov	QWORD PTR [rbp - 32], rdi
	mov	QWORD PTR [rbp - 40], rsi
	mov	QWORD PTR [rbp - 48], rdx
# Stack growth is established first (spec §15.1.2.2): a fault at an address inside the current
# actor's reservation is growth, and only afterwards is a guarded foreign fault considered.
# Linux siginfo_t: si_addr @16.
