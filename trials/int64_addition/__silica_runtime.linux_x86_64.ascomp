	mov	rdi, QWORD PTR [rbp - 24]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax + 8]
	call	silica_rt_register_actor_named
Lsscr_register_done:
	mov	rdi, QWORD PTR [rbp - 24]
	leave
	ret
	.globl	silica_rt_supervisor_materialize_init_children
	.p2align	2
silica_rt_supervisor_materialize_init_children:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	r8, QWORD PTR [rsi]
	cmp	r8, 4096
	jb	Lmat_pre_flags_flat
	mov	QWORD PTR [rbp - 96], 8
	mov	r9, QWORD PTR [r8]
	mov	QWORD PTR [rdi + 296], r9
	mov	r9, QWORD PTR [r8 + 8]
	mov	QWORD PTR [rdi + 304], r9
	mov	r9, QWORD PTR [r8 + 16]
	mov	QWORD PTR [rdi + 312], r9
	jmp	Lmat_pre_flags_done
Lmat_pre_flags_flat:
	mov	QWORD PTR [rbp - 96], 24
	mov	QWORD PTR [rdi + 296], r8
	mov	r9, QWORD PTR [rsi + 8]
	mov	QWORD PTR [rdi + 304], r9
	mov	r9, QWORD PTR [rsi + 16]
	mov	QWORD PTR [rdi + 312], r9
Lmat_pre_flags_done:
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	rax, rsi
	add	rax, QWORD PTR [rbp - 96]
	mov	QWORD PTR [rbp - 88], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 16], rax
	test	rax, rax
	jz	Lmat_done
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 24], rcx
	mov	rcx, QWORD PTR [rax + 16]
	mov	QWORD PTR [rbp - 88], rcx
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 16], rax
Lmat_loop:
	cmp	QWORD PTR [rbp - 16], 0
	je	Lmat_done
	mov	rax, QWORD PTR [rbp - 24]
	test	rax, rax
	jz	Lmat_done
	add	rax, QWORD PTR [rbp - 88]
	mov	QWORD PTR [rbp - 96], rax
	mov	rcx, QWORD PTR [rax + 16]
	mov	QWORD PTR [rbp - 32], rcx
	mov	rcx, QWORD PTR [rax + 24]
	mov	QWORD PTR [rbp - 40], rcx
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 48], rcx
	mov	rcx, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 56], rcx
	mov	rcx, QWORD PTR [rax + 32]
	mov	QWORD PTR [rbp - 64], rcx
	mov	rcx, QWORD PTR [rax + 40]
	mov	QWORD PTR [rbp - 72], rcx
# Phase E e4f + Option B: ensure one more list node, then walk `len` links from head for stable row ptr (no realloc).
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rdi + 264]
	add	rsi, 1
	call	silica_rt_child_table_ensure_min_cap
	test	rdi, rdi
	jnz	Lmat_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 256]
	mov	r9, QWORD PTR [rax + 264]
	mov	r10, r9
Lmat_walk_row:
	test	r10, r10
	jz	Lmat_walk_row_done
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmat_walk_row
Lmat_walk_row_done:
	mov	QWORD PTR [rbp - 80], rcx
    mov QWORD PTR [rcx], 0
    mov rax, QWORD PTR [rbp - 56]
    mov QWORD PTR [rcx + 8], rax
    mov rax, QWORD PTR [rbp - 48]
    mov QWORD PTR [rcx + 16], rax
    mov rax, QWORD PTR [rbp - 32]
    mov QWORD PTR [rcx + 24], rax
    mov rax, QWORD PTR [rbp - 40]
    mov QWORD PTR [rcx + 32], rax
    mov rax, QWORD PTR [rbp - 64]
    mov QWORD PTR [rcx + 40], rax
    mov rax, QWORD PTR [rbp - 72]
    mov QWORD PTR [rcx + 48], rax
    mov QWORD PTR [rcx + 56], 0
    mov rax, QWORD PTR [rbp - 96]
    mov r9, QWORD PTR [rax + 48]
    mov QWORD PTR [rcx + 64], r9
    mov r9, QWORD PTR [rax + 56]
    mov QWORD PTR [rcx + 72], r9
    mov r9, QWORD PTR [rcx + 64]
    cmp r9, 22
    je Lmat_row_spawn_dangerous
    mov rdi, QWORD PTR [rbp - 32]
    mov rsi, QWORD PTR [rbp - 40]
    mov rdx, QWORD PTR [rbp - 48]
    mov r8, QWORD PTR [rcx + 72]
    call silica_rt_actor_spawn_linked
    mov rax, QWORD PTR [rbp - 8]
    mov QWORD PTR [rdi + 192], rax
    mov rcx, QWORD PTR [rbp - 80]
    mov QWORD PTR [rcx], rdi
    mov QWORD PTR [rcx + 56], 0
    mov rdi, QWORD PTR [rcx]
    mov rsi, QWORD PTR [rcx + 8]
    call silica_rt_register_actor_named
    jmp Lmat_row_spawn_done
Lmat_row_spawn_dangerous:
    mov rdi, QWORD PTR [rbp - 80]
    mov rsi, QWORD PTR [rbp - 8]
    call silica_rt_supervisor_spawn_child_row_by_flavor
Lmat_row_spawn_done:
	mov	rax, QWORD PTR [rbp - 8]
	add	QWORD PTR [rax + 264], 1
	mov	rax, QWORD PTR [rbp - 24]
	mov	rax, QWORD PTR [rax + 64]
	mov	QWORD PTR [rbp - 24], rax
	mov	QWORD PTR [rbp - 88], 0
	sub	QWORD PTR [rbp - 16], 1
	jmp	Lmat_loop
Lmat_done:
	leave
	ret
	.globl	silica_rt_supervisor_start_child
	.p2align	2
silica_rt_supervisor_start_child:
# Phase E e4f: the frame also keeps x27 (row_ptr) and x28 (appended flag) so we can
# locate / allocate the table row first, then call spawn_linked with X3 = row_ptr.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, QWORD PTR [rdi]
	mov	QWORD PTR [rbp - 24], rax
	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 32], rax
	mov	rax, QWORD PTR [rdi + 16]
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rdi + 24]
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rdi + 32]
	mov	QWORD PTR [rbp - 56], rax
	mov	rax, QWORD PTR [rdi + 40]
	mov	QWORD PTR [rbp - 64], rax
Lsc_tls_prep:
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 8], rdi
# Phase E e4f + Option B: tombstone scan / append on singly-linked row nodes (+80).
	mov	r8, QWORD PTR [rdi + 256]
	mov	r9, QWORD PTR [rdi + 264]
	xor	r10d, r10d
Lsc_reuse_loop:
	cmp	r10, r9
	jae	Lsc_append_new
	mov	QWORD PTR [rbp - 72], r8
	mov	r11, r10
Lsc_walk_reuse:
	test	r11, r11
	jz	Lsc_reuse_at_row
	mov	rax, QWORD PTR [rbp - 72]
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 72], rax
	sub	r11, 1
	jmp	Lsc_walk_reuse
Lsc_reuse_at_row:
	mov	rax, QWORD PTR [rbp - 72]
	mov	rcx, QWORD PTR [rax]
	test	rcx, rcx
	jz	Lsc_use_reuse_row
	add	r10, 1
	jmp	Lsc_reuse_loop
Lsc_append_new:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rdi + 264]
	add	rsi, 1
	call	silica_rt_child_table_ensure_min_cap
	test	rdi, rdi
	jnz	Lsc_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	r8, QWORD PTR [rax + 256]
	mov	r9, QWORD PTR [rax + 264]
	mov	QWORD PTR [rbp - 72], r8
	mov	r11, r9
Lsc_walk_append:
	test	r11, r11
	jz	Lsc_append_at_row
	mov	rax, QWORD PTR [rbp - 72]
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 72], rax
	sub	r11, 1
	jmp	Lsc_walk_append
Lsc_append_at_row:
	mov	QWORD PTR [rbp - 80], 1
	jmp	Lsc_post_row
Lsc_use_reuse_row:
	mov	QWORD PTR [rbp - 80], 0
Lsc_post_row:
	mov	rax, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rax + 56]
	mov	rcx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rcx + 72], r8
    mov r9, QWORD PTR [rax + 48]
    mov QWORD PTR [rcx], 0
    mov rax, QWORD PTR [rbp - 24]
    mov QWORD PTR [rcx + 8], rax
    mov rax, QWORD PTR [rbp - 32]
    mov QWORD PTR [rcx + 16], rax
    mov rax, QWORD PTR [rbp - 40]
    mov QWORD PTR [rcx + 24], rax
    mov rax, QWORD PTR [rbp - 48]
    mov QWORD PTR [rcx + 32], rax
    mov rax, QWORD PTR [rbp - 56]
    mov QWORD PTR [rcx + 40], rax
    mov rax, QWORD PTR [rbp - 64]
    mov QWORD PTR [rcx + 48], rax
    mov QWORD PTR [rcx + 56], 0
    mov QWORD PTR [rcx + 64], r9
    mov r9, QWORD PTR [rcx + 64]
    cmp r9, 22
    je Lsc_row_spawn_dangerous
    mov rdi, QWORD PTR [rbp - 40]
    mov rsi, QWORD PTR [rbp - 48]
    mov rdx, QWORD PTR [rbp - 32]
    mov r8, QWORD PTR [rcx + 72]
    call silica_rt_actor_spawn_linked
    mov rax, QWORD PTR [rbp - 8]
    mov QWORD PTR [rdi + 192], rax
    mov QWORD PTR [rbp - 16], rdi
    mov rcx, QWORD PTR [rbp - 72]
    mov QWORD PTR [rcx], rdi
    mov QWORD PTR [rcx + 56], 0
    mov rdi, QWORD PTR [rcx]
    mov rsi, QWORD PTR [rcx + 8]
    call silica_rt_register_actor_named
    jmp Lsc_row_spawn_done
Lsc_row_spawn_dangerous:
    mov rdi, QWORD PTR [rbp - 72]
    mov rsi, QWORD PTR [rbp - 8]
    call silica_rt_supervisor_spawn_child_row_by_flavor
    mov QWORD PTR [rbp - 16], rdi
Lsc_row_spawn_done:
	cmp	QWORD PTR [rbp - 80], 0
	je	Lsc_done
	mov	rax, QWORD PTR [rbp - 8]
	add	QWORD PTR [rax + 264], 1
Lsc_done:
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
	.p2align	2
silica_rt_supervisor_drain_ingress:
# X0 = supervisor ACB. [rbp - 8] ACB (x19), [rbp - 16] message (x20), [rbp - 24] payload (x21),
# [rbp - 40] caller's TLS actor (x23), [rbp - 48] supervisor (x24).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
Lsdrain_loop:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 232
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	Lsdrain_empty
	mov	rax, QWORD PTR [rbp - 8]
	mov	r9d, DWORD PTR [rax + 248]
	test	r9d, r9d
	jz	Lsdrain_depth_done
	sub	r9d, 1
	mov	DWORD PTR [rax + 248], r9d
Lsdrain_depth_done:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 16]
	mov	r9d, DWORD PTR [rax + 24]
	test	r9d, r9d
	jnz	Lsdrain_free_msg
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 24], rcx
	test	rcx, rcx
	jz	Lsdrain_free_msg
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rbp - 48], rax
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 40], rdi
	mov	rax, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rbp - 8], rax
	mov	rdi, rax
	call	silica_rt_tls_actor_set_from_x19
	mov	rax, QWORD PTR [rbp - 24]
	mov	rdi, QWORD PTR [rax]
	mov	rsi, QWORD PTR [rbp - 48]
	mov	rdx, QWORD PTR [rax + 8]
	call	silica_rt_supervisor_maybe_restart
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rbp - 8], rax
	mov	rdi, rax
	call	silica_rt_tls_actor_set_from_x19
	mov	rax, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rbp - 8], rax
	mov	rdi, QWORD PTR [rbp - 24]
	call	free
Lsdrain_free_msg:
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
	jmp	Lsdrain_loop
Lsdrain_empty:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	leave
	ret
	.globl	silica_rt_supervisor_add_child
	.p2align	2
silica_rt_supervisor_add_child:
# X0 = supervisor ACB, X1 = child_spec -> X0 = the new child. [rbp - 8] TLS handoff (x19),
# [rbp - 16] supervisor, then the child (x20), [rbp - 24] spec (x21), [rbp - 32] caller's TLS actor (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 24], rsi
	call	silica_rt_supervisor_drain_ingress
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 32], rdi
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rbp - 8], rax
	mov	rdi, rax
	call	silica_rt_tls_actor_set_from_x19
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_supervisor_start_child
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rbp - 8], rax
	mov	rdi, rax
	call	silica_rt_tls_actor_set_from_x19
	mov	rdi, QWORD PTR [rbp - 16]
	leave
	ret
	.p2align	2
silica_rt_supervisor_drop_pending_exit:
# X0 = supervisor ACB, X1 = child ACB. [rbp - 8] ACB (x19), [rbp - 16] child (x20), [rbp - 24] payload (x21),
# [rbp - 32] node (x22), [rbp - 40] queue anchor (x23), [rbp - 48] previous node (x24).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	add	rax, 232
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	mov	QWORD PTR [rbp - 48], 0
Ldpe_front_loop:
	mov	rax, QWORD PTR [rbp - 32]
	test	rax, rax
	jz	Ldpe_scan_rear
	mov	r8, QWORD PTR [rax + 8]
	test	r8, r8
	jz	Ldpe_front_next
	mov	r9, QWORD PTR [r8]
	cmp	r9, QWORD PTR [rbp - 16]
	je	Ldpe_remove
Ldpe_front_next:
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	jmp	Ldpe_front_loop
Ldpe_scan_rear:
	mov	rax, QWORD PTR [rbp - 8]
	add	rax, 240
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	mov	QWORD PTR [rbp - 48], 0
Ldpe_rear_loop:
	mov	rax, QWORD PTR [rbp - 32]
	test	rax, rax
	jz	Ldpe_not_found
	mov	r8, QWORD PTR [rax + 8]
	test	r8, r8
	jz	Ldpe_rear_next
	mov	r9, QWORD PTR [r8]
	cmp	r9, QWORD PTR [rbp - 16]
	je	Ldpe_remove
Ldpe_rear_next:
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	jmp	Ldpe_rear_loop
Ldpe_remove:
	mov	r10, QWORD PTR [rax]
	mov	rcx, QWORD PTR [rbp - 48]
	test	rcx, rcx
	jz	Ldpe_remove_head
	mov	QWORD PTR [rcx], r10
	jmp	Ldpe_removed_link
Ldpe_remove_head:
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rcx], r10
Ldpe_removed_link:
	mov	QWORD PTR [rbp - 24], r8
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11d, DWORD PTR [rax + 248]
	test	r11d, r11d
	jz	Ldpe_depth_done
	sub	r11d, 1
	mov	DWORD PTR [rax + 248], r11d
Ldpe_depth_done:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 24]
	call	free
	mov	rdi, QWORD PTR [rbp - 32]
	call	free
	jmp	Ldpe_done
Ldpe_not_found:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Ldpe_done:
	leave
	ret
	.globl	silica_rt_supervisor_maybe_restart
	.p2align	2
silica_rt_supervisor_maybe_restart:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 80], rdx
	mov	rax, QWORD PTR [rsi + 256]
	mov	QWORD PTR [rbp - 24], rax
	test	rax, rax
	jz	Lmr_done
	mov	rax, QWORD PTR [rsi + 264]
	mov	QWORD PTR [rbp - 32], rax
	test	rax, rax
	jz	Lmr_done
	mov	QWORD PTR [rbp - 40], 0
Lmr_scan:
	mov	rax, QWORD PTR [rbp - 40]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_done
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_walk_scan:
	test	r10, r10
	jz	Lmr_scan_at_row
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_walk_scan
Lmr_scan_at_row:
	mov	QWORD PTR [rbp - 48], rcx
	mov	r8, QWORD PTR [rcx]
	cmp	r8, QWORD PTR [rbp - 8]
	jne	Lmr_next
	mov	rdi, QWORD PTR [rcx + 40]
	cmp	rdi, 9
	je	Lmr_can_restart
	cmp	rdi, 10
	je	Lmr_check_transient
	jmp	Lmr_tombstone_done
Lmr_check_transient:
	cmp	QWORD PTR [rbp - 80], 0
	je	Lmr_tombstone_done
Lmr_can_restart:
	mov	rax, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rax + 304]
	mov	r9, QWORD PTR [rax + 312]
	mov	r10, r8
	or	r10, r9
	jz	Lmr_freq_ok
	test	r8, r8
	jz	Lmr_freq_escalate
	xor	edi, edi
	call	time
	mov	QWORD PTR [rbp - 56], rax
	mov	rcx, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rcx + 328]
	test	r8, r8
	jz	Lmr_freq_first
	mov	r9, QWORD PTR [rcx + 312]
	mov	r10, rax
	sub	r10, r8
	cmp	r10, r9
	ja	Lmr_freq_reset
	mov	r8, QWORD PTR [rcx + 320]
	add	r8, 1
	mov	r9, QWORD PTR [rcx + 304]
	cmp	r8, r9
	ja	Lmr_freq_escalate
	mov	QWORD PTR [rcx + 320], r8
	jmp	Lmr_freq_ok
Lmr_freq_first:
Lmr_freq_reset:
	mov	rcx, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rcx + 328], rax
	mov	r8d, 1
	mov	QWORD PTR [rcx + 320], r8
	mov	r9, QWORD PTR [rcx + 304]
	cmp	r8, r9
	ja	Lmr_freq_escalate
	jmp	Lmr_freq_ok
Lmr_freq_escalate:
# Claim sync_failure_reported BEFORE mark-dead+signal. Otherwise actor_thread_main can
# observe alive==0, take LBB1_exit, and emit a duplicate root failure banner/note.
	mov	rcx, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rcx + 192]
	test	r8, r8
	jnz	Lmr_freq_escalate_mark_dead
	mov	r8, QWORD PTR [rcx + 272]
	test	r8, r8
	jnz	Lmr_freq_escalate_mark_dead
	mov	QWORD PTR [rcx + 272], 1
	lea	rdi, [rcx + 16]
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 16]
	mov	DWORD PTR [rcx + 152], 0
	lea	rdi, [rcx + 80]
	call	silica_rt_cv_signal
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_actor_deliver_unwind_report
	mov	edi, 2
Lmr_root_note_a:
	lea	rsi, [rip + L_silica_root_actor_exit]
Lmr_root_note_b:
	mov	edx, 43
	call	write
	jmp	Lmr_done
Lmr_freq_escalate_mark_dead:
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 16]
	mov	DWORD PTR [rcx + 152], 0
	lea	rdi, [rcx + 80]
	call	silica_rt_cv_signal
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
	jmp	Lmr_done
Lmr_freq_ok:
	mov	rax, QWORD PTR [rbp - 16]
	mov	rdi, QWORD PTR [rax + 296]
	cmp	rdi, 13
	je	Lmr_ofa_kill
	cmp	rdi, 14
	je	Lmr_rfo_kill
	jmp	Lmr_ofo
Lmr_ofo:
# Phase E e4f: pass row_ptr (x24) as X3 so the new child's actor_thread_main can flag
# this row's exit_done on its own teardown; clear stale exit_done from prior incarnation.
	mov	rdi, QWORD PTR [rbp - 48]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_spawn_child_row_by_flavor
	jmp	Lmr_done
Lmr_ofa_kill:
	mov	QWORD PTR [rbp - 56], 0
Lmr_ofa_kill_loop:
	mov	rax, QWORD PTR [rbp - 56]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_ofa_spawn
	cmp	rax, QWORD PTR [rbp - 40]
	je	Lmr_ofa_kill_next
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_ofa_kill_walk_idx:
	test	r10, r10
	jz	Lmr_ofa_kill_at_idx
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_ofa_kill_walk_idx
Lmr_ofa_kill_at_idx:
	mov	QWORD PTR [rbp - 64], rcx
	mov	rcx, QWORD PTR [rcx]
	mov	QWORD PTR [rbp - 72], rcx
	test	rcx, rcx
	jz	Lmr_ofa_kill_next
	lea	rdi, [rcx + 16]
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 72]
	mov	DWORD PTR [rcx + 152], 0
	lea	rdi, [rcx + 80]
	call	silica_rt_cv_signal
	mov	rdi, QWORD PTR [rbp - 72]
	add	rdi, 16
	call	silica_rt_lock_unlock
# Phase E e4f: per-user-spec sequential stop — block here until this child's actor_thread_main
# has fully unwound (ACB freed) and stamped row[+56]=1. Only then proceed to the next sibling,
# so two children's teardowns never overlap (no concurrent libsystem_malloc cleanup races).
# Reset the flag once observed so a future cascade restart targeting this row can re-arm.
	mov	rcx, QWORD PTR [rbp - 64]
Lmr_ofa_kill_wait:
	mov	r8, QWORD PTR [rcx + 56]
	test	r8, r8
	jz	Lmr_ofa_kill_wait
	mov	QWORD PTR [rcx + 56], 0
Lmr_ofa_kill_next:
	add	QWORD PTR [rbp - 56], 1
	jmp	Lmr_ofa_kill_loop
Lmr_ofa_spawn:
	mov	QWORD PTR [rbp - 56], 0
Lmr_ofa_spawn_loop:
# Phase E e4f: per-user-spec sequential start — spawn_linked itself spins on the new
# child's ACB[+288] before returning, so iteration k cannot proceed until child k's
# thread has finished its TLS init / first-schedule. Children come up in list order,
# one at a time, after every cascaded stop has retired.
