# Silica actor/supervisor runtime definitions. Link this object once per executable.
    .intel_syntax noprefix
	.text
	.globl	silica_rt_actor_spawn # -- Begin function silica_rt_actor_spawn
	.p2align	2
silica_rt_actor_spawn: # @silica_rt_actor_spawn
# X0..X4 = rdi rsi rdx rcx r8. x19..x25 live in the frame: [rbp-8] acb, [rbp-16] beh, [rbp-24] init,
# [rbp-32] w22 (=1), [rbp-40] core_id / pthread_create rc, [rbp-48] trampoline, [rbp-56] stack_policy.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 56], r8
	mov	QWORD PTR [rbp - 48], rcx
	mov	QWORD PTR [rbp - 40], rdx
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdi
	mov	QWORD PTR [rbp - 32], 1
	mov	edi, 1
	mov	esi, 512
	call	calloc
	mov	rdi, rax
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	LBB0_4
# %bb.1:
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rdi], rax
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rdi + 8], rax
	mov	QWORD PTR [rdi + 192], 0
	mov	QWORD PTR [rdi + 200], 0
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rdi + 208], rax
	mov	QWORD PTR [rdi + 216], 0
	mov	QWORD PTR [rdi + 224], 0
	mov	QWORD PTR [rdi + 232], 0
	mov	QWORD PTR [rdi + 240], 0
	mov	DWORD PTR [rdi + 248], 0
	mov	QWORD PTR [rdi + 256], 0
	mov	QWORD PTR [rdi + 264], 0
	mov	QWORD PTR [rdi + 272], 0
	mov	rax, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rdi + 280], rax
	mov	QWORD PTR [rdi + 288], 0
	mov	QWORD PTR [rdi + 296], 0
	mov	QWORD PTR [rdi + 304], 0
	mov	QWORD PTR [rdi + 312], 0
	mov	QWORD PTR [rdi + 320], 0
	mov	QWORD PTR [rdi + 328], 0
	mov	QWORD PTR [rdi + 336], 0
	mov	QWORD PTR [rdi + 344], 0
# Phase E e4f: ACB+16 is the 4 B lock word and ACB+80 is a 4 B futex seq word.
# Both are zero from calloc above (unlocked == 0); no init call needed.
	mov	DWORD PTR [rdi + 152], 1
# The reservation, the fault handlers and the arena bookkeeping exist before the thread does:
# its first instruction on the actor stack faults, and the handler must already be installed.
	mov	rsi, QWORD PTR [rbp - 56]
	call	silica_rt_actor_stack_reserve
	test	rdi, rdi
	jnz	LBB0_reserve_failed
	call	silica_rt_install_sync_fault_handlers
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_init_region
	sub	rsp, 64
	mov	rdi, rsp
	call	pthread_attr_init
	mov	rdi, rsp
	mov	esi, 0x20000
	call	pthread_attr_setstacksize
	lea	rdx, [rip + actor_thread_main]
	mov	rcx, QWORD PTR [rbp - 8]
	lea	rdi, [rcx + 144]
	mov	rsi, rsp
	call	pthread_create
	mov	edi, eax
	mov	QWORD PTR [rbp - 40], rdi
	mov	rdi, rsp
	call	pthread_attr_destroy
	add	rsp, 64
	cmp	QWORD PTR [rbp - 40], 0
	je	LBB0_3
# %bb.2:
	mov	rdi, QWORD PTR [rbp - 8]
	xor	esi, esi
	call	silica_rt_actor_stack_free
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	mov	QWORD PTR [rbp - 8], 0
	jmp	LBB0_4
LBB0_reserve_failed:
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	call	silica_rt_spawn_reserve_failed
LBB0_3:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 144]
	call	pthread_detach
# Phase E: supervisor trampoline (ACB#280) runs on the new thread; wait until #288 is set so
# callers see a materialized child table before receiving the actor_ref.
	cmp	QWORD PTR [rbp - 48], 0
	je	LBB0_4
LBB0_tramp_spin:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rbx, QWORD PTR [rax + 288]
	test	rbx, rbx
	jz	LBB0_tramp_spin
LBB0_4:
# Phase I: wait_for_exit consults silica_rt_wait_root_acb (+#152 alive). Only top-level spawn()
# registers here; spawn_linked workers must not steal the slot (see LBBsl_4).
	mov	rax, QWORD PTR [rbp - 8]
	test	rax, rax
	jz	LBB0_wr_skip
LBB0_wr_try:
	lea	rbx, [rip + silica_rt_wait_root_acb]
	mov	r10, QWORD PTR [rbx]
	test	r10, r10
	jnz	LBB0_wr_skip
	mov	QWORD PTR [rbx], rax
LBB0_wr_skip:
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	ret
                                        # -- End function
	.globl	silica_rt_actor_spawn_linked # Phase A: supervision metadata (supervisors_implementation_development_plan.md §A)
	.p2align	2
silica_rt_actor_spawn_linked: # @silica_rt_actor_spawn_linked
# X0..X4 = rdi rsi rdx rcx r8. Frame: [rbp-8] acb, [rbp-16] beh, [rbp-24] init / parent (0),
# [rbp-32] trampoline, [rbp-40] agent_type / pthread_create rc, [rbp-48] row/core metadata.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 40], rdx
	mov	QWORD PTR [rbp - 48], rcx
	mov	QWORD PTR [rbp - 32], r8
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdi
	mov	edi, 1
	mov	esi, 512
	call	calloc
	mov	rdi, rax
	mov	QWORD PTR [rbp - 8], rdi
	test	rdi, rdi
	jz	LBBsl_4
	mov	rax, rdi
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax], rcx
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 8], rcx
# Parent/supervisor is recorded by the internal supervisor runtime path after spawn returns.
	mov	QWORD PTR [rax + 192], 0
	mov	QWORD PTR [rbp - 24], 0
	xor	edi, edi
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 200], rcx
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 208], rcx
	mov	QWORD PTR [rax + 216], 0
	mov	QWORD PTR [rax + 224], 0
	mov	QWORD PTR [rax + 232], 0
	mov	QWORD PTR [rax + 240], 0
	mov	DWORD PTR [rax + 248], 0
	mov	QWORD PTR [rax + 256], 0
	mov	QWORD PTR [rax + 264], 0
	mov	QWORD PTR [rax + 272], 0
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 280], rcx
	mov	QWORD PTR [rax + 288], 0
	mov	QWORD PTR [rax + 296], 0
	mov	QWORD PTR [rax + 304], 0
	mov	QWORD PTR [rax + 312], 0
	mov	QWORD PTR [rax + 320], 0
	mov	QWORD PTR [rax + 328], 0
	mov	QWORD PTR [rax + 336], 0
	mov	QWORD PTR [rax + 344], 0
	test	rdi, rdi
	jz	Lslp_skip_list
	sub	rsp, 16
	mov	QWORD PTR [rsp + 8], rdi
	mov	rsi, QWORD PTR [rsp + 8]
	lea	rdi, [rsi + 16]
	call	silica_rt_lock_lock
	mov	rsi, QWORD PTR [rsp + 8]
	mov	rbx, QWORD PTR [rsi + 216]
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 224], rbx
	mov	QWORD PTR [rsi + 216], rax
	lea	rdi, [rsi + 16]
	call	silica_rt_lock_unlock
	add	rsp, 16
Lslp_skip_list:
# Phase E e4f: ACB+16 (lock word) and ACB+80 (futex seq word) are pre-zeroed by calloc.
# Unlocked == 0, seq baseline 0; no init call required.
	mov	rax, QWORD PTR [rbp - 8]
	mov	DWORD PTR [rax + 152], 1
# Children started from child specs inherit the spawning actor's stack policy (X1 = 0).
	mov	rdi, rax
	xor	esi, esi
	call	silica_rt_actor_stack_reserve
	test	rdi, rdi
	jnz	LBBsl_reserve_failed
	call	silica_rt_install_sync_fault_handlers
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_init_region
	sub	rsp, 64
	mov	rdi, rsp
	call	pthread_attr_init
	mov	rdi, rsp
	mov	esi, 0x20000
	call	pthread_attr_setstacksize
	lea	rdx, [rip + actor_thread_main]
	mov	rcx, QWORD PTR [rbp - 8]
	lea	rdi, [rcx + 144]
	mov	rsi, rsp
	call	pthread_create
	mov	edi, eax
	mov	QWORD PTR [rbp - 40], rdi
	mov	rdi, rsp
	call	pthread_attr_destroy
	add	rsp, 64
	cmp	QWORD PTR [rbp - 40], 0
	je	LBBsl_3
	mov	rdi, QWORD PTR [rbp - 8]
	xor	esi, esi
	call	silica_rt_actor_stack_free
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	mov	QWORD PTR [rbp - 8], 0
	jmp	LBBsl_4
LBBsl_reserve_failed:
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	call	silica_rt_spawn_reserve_failed
LBBsl_3:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 144]
	call	pthread_detach
# Phase E e4f: spin until the new actor's thread has finished its TLS init / trampoline
# (signalled by ACB[+288] == 1 in actor_thread_main). Keeps spawn ordering strictly
# sequential — the supervisor never overlaps two children's startup, eliminating the
# libsystem mfm_alloc / TLS-instantiate race observed with 3+ concurrent spawns.
LBBsl_started_spin:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rbx, QWORD PTR [rax + 288]
	test	rbx, rbx
	jz	LBBsl_started_spin
LBBsl_4:
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	ret
                                        # -- End function
	.globl	silica_rt_actor_spawn_dangerous_linked
	.p2align	2
silica_rt_actor_spawn_dangerous_linked:
	jmp	silica_rt_actor_spawn_linked
	.p2align	2 # -- Begin function actor_thread_main
actor_thread_main: # @actor_thread_main
# pthread start routine (SysV callee): rdi = ACB; returns rax = 0. Saves rbx r12-r15 below the
# x19..x25 frame slots ([rbp-8] acb, [rbp-16] message / exit flag, [rbp-24] w21 ingress flag / reply,
# [rbp-32] w22, [rbp-40] x23, [rbp-56] x25). Behaviours run with rdi = message, rsi = state,
# rdx = sret and return the result pointer in rdi; nothing else survives the call.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 128
	mov	QWORD PTR [rbp - 88], rbx
	mov	QWORD PTR [rbp - 96], r12
	mov	QWORD PTR [rbp - 104], r13
	mov	QWORD PTR [rbp - 112], r14
	mov	QWORD PTR [rbp - 120], r15
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_ensure_actor_tls_key
# The ACB is x19's home ([rbp-8]) and is also passed in rdi for silica_rt_tls_actor_set_from_x19.
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_tls_actor_set_from_x19
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_altstack_install
# Phase E e3b: first-schedule supervisor trampoline hook. It runs on the actor's stack, like a
# behavior: the top of the reservation is the empty stack, and the runtime keeps this thread's
# own SP in ACB+480 while user code runs there.
	mov	rax, QWORD PTR [rbp - 8]
	mov	rbx, QWORD PTR [rax + 280]
	test	rbx, rbx
	jz	LBB1_skip_tramp
	mov	r10, QWORD PTR [rax + 288]
	test	r10, r10
	jnz	LBB1_skip_tramp
	mov	rdi, rax
	mov	r10, QWORD PTR [rax + 384]
	test	r10, r10
	jz	LBB1_sw_none_0
	mov	r11, QWORD PTR [rax + 392]
	add	r10, r11
	mov	r11, rsp
	mov	QWORD PTR [rax + 480], r11
	mov	rsp, r10
LBB1_sw_none_0:
	call	rbx
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 480]
	test	r11, r11
	jz	LBB1_sw_back_0
	mov	rsp, r11
	mov	QWORD PTR [rax + 480], 0
LBB1_sw_back_0:
LBB1_skip_tramp:
# Phase E e4f: mark actor as started (post TLS init + post any first-schedule trampoline) so
# spawn / spawn_linked callers can serialize on +288 == 1 for both supervisors and workers.
# This delivers the user-requested ordering: each child starts one at a time, waiting until
# the previous child's actor_thread_main has materialised before the next spawn proceeds.
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 288], 1
	mov	QWORD PTR [rbp - 32], 1
LBB1_loop:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
LBB1_wait:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 232
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	LBB1_try_std
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10d, DWORD PTR [rax + 248]
	sub	r10d, 1
	mov	DWORD PTR [rax + 248], r10d
	mov	QWORD PTR [rbp - 24], 1
	jmp	LBB1_process
LBB1_try_std:
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10d, DWORD PTR [rax + 152]
	test	r10d, r10d
	jz	LBB1_exit
	lea	rdi, [rax + 128]
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 24], 0
	test	rdi, rdi
	jnz	LBB1_process
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10d, DWORD PTR [rax + 152]
	test	r10d, r10d
	jz	LBB1_exit
# Phase E e4f: blocking silica_rt_cv_wait (lock word + silica_rt_futex_wait).
# Earlier pthread_cond_timedwait_relative_np drove libpthread kwq malloc churn racing TLS instantiation
# (mfm_alloc SIGBUS). Wake paths hold ACB+16, signal ACB+80, then unlock before silica_rt_cv_wait.
# A :release_when_idle actor waits with a timeout while it still holds committed stack; the
# check releases it once a second has passed since its last message (spec §15.1.2.2).
	mov	rdi, rax
	call	silica_rt_stack_idle_check
	mov	rdx, rdi
	mov	rax, QWORD PTR [rbp - 8]
	lea	rdi, [rax + 80]
	lea	rsi, [rax + 16]
	call	silica_rt_cv_wait_timeout
	jmp	LBB1_wait
LBB1_process:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	sub	rsp, 48
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rsp + 24], rax
	mov	ebx, DWORD PTR [rax + 16]
	mov	DWORD PTR [rsp + 32], ebx
	test	ebx, ebx
	jz	LBB1_no_active_call
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx + 344], rax
	jmp	LBB1_active_call_set
LBB1_no_active_call:
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx + 344], 0
LBB1_active_call_set:
	mov	rax, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rbp - 32], rax
	test	rax, rax
	jnz	LBB1_ingress_check_kind
	mov	rax, QWORD PTR [rbp - 16]
	mov	rdi, QWORD PTR [rax + 8]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax]
	mov	rbx, QWORD PTR [rax + 8]
	test	rbx, rbx
	jz	LBB1_ingress_no_beh
	mov	rdx, rsp
	mov	r10, QWORD PTR [rax + 384]
	test	r10, r10
	jz	LBB1_sw_none_1
	mov	r11, QWORD PTR [rax + 392]
	add	r10, r11
	mov	r11, rsp
	mov	QWORD PTR [rax + 480], r11
	mov	rsp, r10
LBB1_sw_none_1:
	call	rbx
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 480]
	test	r11, r11
	jz	LBB1_sw_back_1
	mov	rsp, r11
	mov	QWORD PTR [rax + 480], 0
LBB1_sw_back_1:
	mov	r11, QWORD PTR [rdi]
	mov	ebx, DWORD PTR [rsp + 32]
	test	ebx, ebx
	jz	LBB1_no_reply_result
	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 24], rax
	mov	r10, QWORD PTR [rdi + 16]
	jmp	LBB1_post_beh
LBB1_no_reply_result:
	mov	QWORD PTR [rbp - 24], 0
	mov	r10, QWORD PTR [rdi + 8]
	jmp	LBB1_post_beh
LBB1_ingress_check_kind:
	mov	rax, QWORD PTR [rbp - 16]
	mov	r10d, DWORD PTR [rax + 24]
	test	r10d, r10d
	jnz	LBB1_ingress_user_beh
LBB1_ingress_no_beh:
# Phase C / structured exit: message[+8] is heap payload; do not invoke beh(msg,…). phase_e4f rest_for_one.
	mov	QWORD PTR [rbp - 24], 0
	xor	r10d, r10d
	jmp	LBB1_post_beh
LBB1_ingress_user_beh:
# Phase B trial: message[+8] is inline int64; run behavior like a normal dequeue.
	mov	rax, QWORD PTR [rbp - 16]
	mov	rdi, QWORD PTR [rax + 8]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax]
	mov	rbx, QWORD PTR [rax + 8]
	test	rbx, rbx
	jz	LBB1_ingress_no_beh
	mov	rdx, rsp
	mov	r10, QWORD PTR [rax + 384]
	test	r10, r10
	jz	LBB1_sw_none_2
	mov	r11, QWORD PTR [rax + 392]
	add	r10, r11
	mov	r11, rsp
	mov	QWORD PTR [rax + 480], r11
	mov	rsp, r10
LBB1_sw_none_2:
	call	rbx
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 480]
	test	r11, r11
	jz	LBB1_sw_back_2
	mov	rsp, r11
	mov	QWORD PTR [rax + 480], 0
LBB1_sw_back_2:
	mov	r11, QWORD PTR [rdi]
	mov	ebx, DWORD PTR [rsp + 32]
	test	ebx, ebx
	jz	LBB1_ingress_no_reply_result
	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 24], rax
	mov	r10, QWORD PTR [rdi + 16]
	mov	QWORD PTR [rbp - 32], 0
	jmp	LBB1_post_beh
LBB1_ingress_no_reply_result:
	mov	QWORD PTR [rbp - 24], 0
	mov	r10, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 32], 0
	jmp	LBB1_post_beh
LBB1_post_beh:
# Message boundary: the behavior has returned and its stack is empty, so the release algorithm
# runs now, before the reply is handed to the caller (spec §15.1.2.2).
	mov	QWORD PTR [rbp - 40], r10
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_stack_on_message_return
	mov	r10, QWORD PTR [rbp - 40]
	mov	rax, QWORD PTR [rsp + 24]
	mov	QWORD PTR [rbp - 16], rax
	mov	ebx, DWORD PTR [rsp + 32]
	add	rsp, 48
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 344], 0
	cmp	QWORD PTR [rbp - 32], 0
	jne	LBB1_skip_actor_state
	mov	QWORD PTR [rax], r10
LBB1_skip_actor_state:
	cmp	QWORD PTR [rbp - 32], 0
	jne	LBB1_ingress_restore_w21
	jmp	LBB1_after_w21
LBB1_ingress_restore_w21:
	mov	rax, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rbp - 24], rax
LBB1_after_w21:
	test	ebx, ebx
	jz	LBB1_free
# Phase E e4f: take the call wrapper lock before draining supervision ingress so the
# caller cannot complete actor_call (and free the wrapper) until every enqueued exit
# notification has been processed. kill_abnormal only signals the victim; deliver_exit
# runs on child threads while sup_beh is still finishing — without this ordering, main
# could free the wrapper concurrently with deliver_exit / LBB1_exit (SIGBUS mfm_*) on
# phase_e4f_rest_for_one.
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 72
	call	silica_rt_lock_lock
LBB1_drain_ingress:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 232
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 40], rdi
	test	rdi, rdi
	jz	LBB1_drain_ingress_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	r10d, DWORD PTR [rax + 248]
	sub	r10d, 1
	mov	DWORD PTR [rax + 248], r10d
	lea	rdi, [rax + 16]
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 40]
	mov	r10d, DWORD PTR [rax + 24]
	test	r10d, r10d
	jnz	LBB1_drain_ingress_free_msg
	mov	rax, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 32], rax
	test	rax, rax
	jz	LBB1_drain_ingress_free_msg
	mov	rdi, QWORD PTR [rax]
	mov	rsi, QWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rax + 8]
	call	silica_rt_supervisor_maybe_restart
	mov	rdi, QWORD PTR [rbp - 32]
	call	free
LBB1_drain_ingress_free_msg:
	mov	rdi, QWORD PTR [rbp - 40]
	call	free
	jmp	LBB1_drain_ingress
LBB1_drain_ingress_done:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 16]
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 144], rcx
	mov	DWORD PTR [rax + 136], 1
	lea	rdi, [rax + 24]
	call	silica_rt_cv_signal
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 72
	call	silica_rt_lock_unlock
	jmp	LBB1_loop
LBB1_free:
# Phase E e3c+e4b: if this was an ingress message (w22==1), attempt automatic restart before freeing. X2 = reason_tag from payload+8 (e4b).
# Payload ptr must live in the frame across maybe_restart (x25 -> [rbp-56]); every register is clobbered by it.
# Phase B trial: message[+24]!=0 and +8 is inline int64 — do not treat +8 as heap or call maybe_restart (phase_b_ingress_before_cast).
	cmp	QWORD PTR [rbp - 32], 0
	je	LBB1_free_skip_restart
	mov	rax, QWORD PTR [rbp - 16]
	mov	r10d, DWORD PTR [rax + 24]
	test	r10d, r10d
	jnz	LBB1_free_skip_restart
	mov	rax, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 56], rax
	test	rax, rax
	jz	LBB1_free_skip_restart
	mov	rdi, QWORD PTR [rax]
	mov	rsi, QWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rax + 8]
	call	silica_rt_supervisor_maybe_restart
	mov	rdi, QWORD PTR [rbp - 56]
	call	free
LBB1_free_skip_restart:
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
	jmp	LBB1_loop
LBB1_exit:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rbx, QWORD PTR [rax + 272]
	test	rbx, rbx
	jnz	LBB1_exit_report_already_done
	mov	rdi, rax
	call	silica_rt_actor_deliver_exit
	mov	QWORD PTR [rbp - 16], rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_deliver_unwind_report
	jmp	LBB1_exit_after_report
LBB1_exit_report_already_done:
	mov	QWORD PTR [rbp - 16], 0
LBB1_exit_after_report:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 192]
	mov	QWORD PTR [rbp - 24], rax
	test	rax, rax
	jz	LBB1_exit_no_sup_drain
	mov	rdi, rax
	call	silica_rt_supervisor_drain_ingress
	mov	rax, QWORD PTR [rbp - 8]
	mov	ecx, DWORD PTR [rax + 336]
	mov	QWORD PTR [rbp - 40], rcx
	test	ecx, ecx
	jz	LBB1_exit_no_sup_drain
	mov	rcx, QWORD PTR [rax + 208]
	mov	QWORD PTR [rbp - 32], rcx
	test	rcx, rcx
	jz	LBB1_exit_no_sup_drain
	mov	rax, QWORD PTR [rbp - 24]
	mov	ebx, DWORD PTR [rax + 152]
	test	ebx, ebx
	jz	LBB1_exit_no_sup_drain
LBB1_exit_wait_new_child:
	mov	rcx, QWORD PTR [rbp - 32]
	mov	rdi, QWORD PTR [rcx]
	cmp	rdi, QWORD PTR [rbp - 8]
	je	LBB1_exit_wait_new_child
	test	rdi, rdi
	jz	LBB1_exit_wait_new_child
	mov	rbx, QWORD PTR [rdi + 288]
	test	rbx, rbx
	jz	LBB1_exit_wait_new_child
LBB1_exit_no_sup_drain:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_signal_pending_call_deaths
	mov	rdi, QWORD PTR [rbp - 8]
	xor	esi, esi
	call	silica_rt_actor_stack_free
	cmp	QWORD PTR [rbp - 16], 0
	je	LBB1_exit_skip_legacy_root
	mov	edi, 2
	lea	rsi, [rip + L_silica_root_actor_exit]
	mov	edx, 43
	call	write
LBB1_exit_skip_legacy_root:
# Phase E e4f: capture row_ptr from ACB[+208] (set by spawn_linked from X3) into a
# frame slot so we can flag the supervisor AFTER our own teardown completes.
# Top-level supervisors spawned via spawn() have ACB[+208] == 0 (their X3 is the
# trampoline fn pointer routed to ACB[+280]), so x20 == 0 and the post-free flag write
# is skipped — there is no parent row to notify.
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 208]
	mov	QWORD PTR [rbp - 16], rcx
	mov	rcx, QWORD PTR [rax + 192]
	mov	QWORD PTR [rbp - 24], rcx
	test	rcx, rcx
	jz	LBB1_exit_no_row
	mov	rdi, rax
	call	silica_rt_child_table_free
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_ffi_arena_teardown
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_dealloc_region
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
# Phase E e4f: AFTER full teardown (mutex/cond destroyed, ACB freed) signal the
# supervisor's row.exit_done = 1. The supervisor's cascade kill loop spins on this
# flag for sequential stop ordering — every libsystem cleanup has now retired before
# the next sibling is asked to die, eliminating the malloc / TLS-instantiate races
# observed when 3+ worker teardowns overlapped.
	mov	rax, QWORD PTR [rbp - 16]
	test	rax, rax
	jz	LBB1_exit_no_row
	mov	QWORD PTR [rax + 56], 1
LBB1_exit_no_row:
	xor	eax, eax
	xor	edi, edi
	mov	rbx, QWORD PTR [rbp - 88]
	mov	r12, QWORD PTR [rbp - 96]
	mov	r13, QWORD PTR [rbp - 104]
	mov	r14, QWORD PTR [rbp - 112]
	mov	r15, QWORD PTR [rbp - 120]
	leave
	ret
