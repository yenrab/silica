	cmp	r12, 240
	jge	LBB4r_not_found
	mov	r11, QWORD PTR [r10 + r12*8]
	cmp	r11, 1
	jne	LBB4r_not_found
	add	r10, 1920
	mov	rdi, QWORD PTR [r10 + r12*8]
	test	rdi, rdi
	jz	LBB4r_not_found
	mov	rsi, r13
	jmp	silica_rt_actor_call
LBB4r_not_found:
	xor	edi, edi
	ret
