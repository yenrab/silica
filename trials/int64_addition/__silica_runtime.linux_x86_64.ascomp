	mov	r11, QWORD PTR [rsp + 112]
	mov	eax, DWORD PTR [rsp + 152]
	test	eax, eax
	jnz	Lsri_unit_ok
	mov	eax, 1
Lsri_unit_ok:
	imul	r11, rax
	add	r10, r11
	test	r10, r10
	jnz	Lsri_have_total
	mov	r10, 17179869184
Lsri_have_total:
	mov	r11, QWORD PTR [rbp - 16]
	sub	r11, 1
	add	r10, r11
	not	r11
	and	r10, r11
	lea	rax, [rip + silica_rt_stack_default_reserve]
	mov	QWORD PTR [rax], r10
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], 1
Lsri_done:
