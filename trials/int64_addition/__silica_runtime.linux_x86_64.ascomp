	.text
	.globl	silica_rt_cv_signal
	.p2align	2
# X0 = cv_addr (4-byte futex word). Caller must hold the lock paired with this CV.
silica_rt_cv_signal:
	push	rbp
	mov	rbp, rsp
# bump seq (32-bit; wraparound after 4G signals is fine -- only mismatch w/ waiter snapshot matters)
	mov	eax, DWORD PTR [rdi]
	add	eax, 1
	mov	DWORD PTR [rdi], eax
# silica_rt_futex_wake(3, cv_addr, 0)
	mov	rsi, rdi
	mov	edi, 3
	xor	edx, edx
	call	silica_rt_futex_wake
	leave
	ret
	.globl	silica_rt_cv_wait
	.p2align	2
# X0 = cv_addr, X1 = lock_addr. Caller must hold lock; lock held on return.
silica_rt_cv_wait:
# slots: [rbp-8] = x19 cv_addr, [rbp-16] = x20 lock_addr, [rbp-24] = w22 seq snapshot (zero-extended)
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
# snapshot seq (under lock)
	mov	eax, DWORD PTR [rdi]
	mov	QWORD PTR [rbp - 24], rax
# release lock
	mov	rdi, rsi
	call	silica_rt_lock_unlock
# silica_rt_futex_wait(3, cv_addr, snapshot, 0 = no timeout)
	mov	edi, 3
	mov	rsi, QWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rbp - 24]
	xor	ecx, ecx
	call	silica_rt_futex_wait
# re-acquire lock
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_lock_lock
	leave
	ret
	.text
# --- Phase E e3a Option B: linked-list child table ---
# silica_rt_child_table_free: X0=ACB* — walk nodes (+80 next), free each, clear anchors.
# silica_rt_child_table_ensure_min_cap: X0=ACB*, X1=min node count — X0=0 ok, 1 OOM. Appends 88 B nodes (80 B row + next) until count >= X1.
	.globl	silica_rt_child_table_free
	.p2align	2
silica_rt_child_table_free:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	r8, QWORD PTR [rdi + 256]
Lct_free_loop:
	test	r8, r8
	jz	Lct_free_clear
	mov	rax, QWORD PTR [r8 + 80]
	mov	QWORD PTR [rbp - 16], rax
	mov	rdi, r8
	call	free
	mov	r8, QWORD PTR [rbp - 16]
	jmp	Lct_free_loop
Lct_free_clear:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 256], 0
	mov	QWORD PTR [rax + 264], 0
# Do not clear ACB[+272] (sync_failure_reported) — that flag outlives the child-table list.
	leave
	ret
	.globl	silica_rt_child_table_ensure_min_cap
	.p2align	2
silica_rt_child_table_ensure_min_cap:
# X0=ACB* X1=min_nodes. Returns X0=0 success, 1 OOM.
# [rbp - 8] ACB (x19), [rbp - 16] min (x20), [rbp - 24] head (x21), [rbp - 32] count (x22), [rbp - 40] cursor (x23),
# [rbp - 48] new node (x24), [rbp - 56] tail cursor (x25), [rbp - 64] tail next (x26).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	cmp	rsi, 0
	jle	Lct_ens_ok
Lct_ens_retry:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 256]
	mov	QWORD PTR [rbp - 24], rax
	mov	QWORD PTR [rbp - 32], 0
	mov	QWORD PTR [rbp - 40], rax
Lct_count_loop:
	mov	rax, QWORD PTR [rbp - 40]
	test	rax, rax
	jz	Lct_count_done
	add	QWORD PTR [rbp - 32], 1
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 40], rax
	jmp	Lct_count_loop
Lct_count_done:
	mov	rax, QWORD PTR [rbp - 32]
	cmp	rax, QWORD PTR [rbp - 16]
	jae	Lct_ens_ok
	mov	edi, 1
	mov	esi, 88
	call	calloc
	mov	rdi, rax
	test	rdi, rdi
	jz	Lct_ens_fail
	mov	QWORD PTR [rbp - 48], rdi
	mov	QWORD PTR [rdi + 80], 0
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 256]
	mov	QWORD PTR [rbp - 24], rax
	test	rax, rax
	jnz	Lct_link_at_tail
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 256], rdi
	jmp	Lct_ens_retry
Lct_link_at_tail:
	mov	QWORD PTR [rbp - 56], rax
Lct_find_tail:
	mov	rax, QWORD PTR [rbp - 56]
	mov	rcx, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 64], rcx
	test	rcx, rcx
	jz	Lct_found_tail
	mov	QWORD PTR [rbp - 56], rcx
	jmp	Lct_find_tail
Lct_found_tail:
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 80], rcx
	jmp	Lct_ens_retry
Lct_ens_ok:
	xor	edi, edi
	leave
	ret
Lct_ens_fail:
	mov	edi, 1
	leave
	ret
	.globl	silica_rt_supervisor_spawn_child_row_by_flavor
	.p2align	2
silica_rt_supervisor_spawn_child_row_by_flavor:
# X0 = row, X1 = supervisor ACB -> X0 = the new child's ACB. [rbp - 8] row (x19), [rbp - 16] supervisor (x20), [rbp - 24] child (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	r9, QWORD PTR [rdi + 64]
	cmp	r9, 22
	je	Lsscr_spawn_dangerous
	mov	rcx, rdi
	mov	rdi, QWORD PTR [rcx + 24]
	mov	rsi, QWORD PTR [rcx + 32]
	mov	rdx, QWORD PTR [rcx + 16]
	mov	r8, QWORD PTR [rcx + 72]
	call	silica_rt_actor_spawn_linked
	jmp	Lsscr_spawn_done
Lsscr_spawn_dangerous:
	mov	rcx, rdi
	mov	rdi, QWORD PTR [rcx + 24]
	mov	rsi, QWORD PTR [rcx + 32]
	mov	rdx, QWORD PTR [rcx + 16]
	mov	r8, QWORD PTR [rcx + 72]
	call	silica_rt_actor_spawn_dangerous_linked
Lsscr_spawn_done:
	mov	QWORD PTR [rbp - 24], rdi
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rdi + 192], rax
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], rdi
	mov	QWORD PTR [rax + 56], 0
	mov	rsi, QWORD PTR [rax + 8]
	mov	r9, QWORD PTR [rax + 64]
	cmp	r9, 22
