	jz	Lreg_named_done
	mov	r10, QWORD PTR [rbx]
	test	r10, r10
	jz	Lreg_named_done
	mov	rax, QWORD PTR [rbp - 16]
	cmp	rax, 0
	jl	Lreg_named_done
	cmp	rax, 240
	jge	Lreg_named_done
	mov	r11d, 1
	mov	QWORD PTR [r10 + rax*8], r11
	add	r10, 1920
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [r10 + rax*8], rcx
Lreg_named_done:
	xor	edi, edi
	leave
	ret
