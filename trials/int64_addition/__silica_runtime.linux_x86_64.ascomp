	mov	rbp, rsp
	sub	rsp, 240
	lea	rax, [rip + silica_rt_stack_init_done]
	mov	QWORD PTR [rbp - 8], rax
	cmp	QWORD PTR [rax], 0
	jne	Lsri_done
	mov	edi, 30
	call	sysconf
	cmp	rax, 0
	jg	Lsri_have_page
	mov	eax, 4096
Lsri_have_page:
