	jz	Ladd_child_done
	test	rsi, rsi
	jz	Ladd_child_done
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rsi + 192], rdi
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	mov	rdx, QWORD PTR [rax + 216]
	mov	QWORD PTR [rcx + 224], rdx
	mov	QWORD PTR [rax + 216], rcx
	lea	rdi, [rax + 16]
	call	silica_rt_lock_unlock
	leave
Ladd_child_done:
	xor	edi, edi
	ret
# -- End function
	.globl	silica_rt_actor_link
	.p2align	2
# Phase G: spec 15.4.8.4-8.5
silica_rt_actor_link:
# rdi=target actor_ref -> rdi=atom :ok (index 0). Idempotent link; dead target must enqueue exit (ingress if supervisor) -- stub.
	xor	edi, edi
	ret
# -- End function
	.globl	silica_rt_actor_monitor
	.p2align	2
# Phase G: spec 15.4.8.6
silica_rt_actor_monitor:
# rdi=target -> rdi=monitor_ref. Real runtime: DOWN (:down, ref, target, reason) to standard mailbox only, not ingress.
