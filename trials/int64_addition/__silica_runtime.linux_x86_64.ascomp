	cmp	r10, 2
	je	Lsys_cpuid
	cmp	r10, 3
	je	Lsys_memsize
	cmp	r10, 4
	je	Lsys_cpuid
	jmp	Lsys_store
Lsys_sysconf:
	call	sysconf
	xor	edi, edi
	test	rax, rax
	cmovns	rdi, rax
	jmp	Lsys_store
Lsys_cpuid:
# rdi = bit index, r10 = kind (2: leaf 1 ecx, 4: leaf 7 ebx). cpuid writes eax ebx ecx edx.
