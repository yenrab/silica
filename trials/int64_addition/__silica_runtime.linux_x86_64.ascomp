	.globl	silica_rt_set_actor_priority # -- Begin function silica_rt_set_actor_priority
	.p2align	2
silica_rt_set_actor_priority: # @silica_rt_set_actor_priority
# %bb.0: X0=actor_ref X1=priority; map to pthread QoS class
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rsi
	mov	rdi, QWORD PTR [rdi + 144]
	cmp	rsi, 3
	jge	LBBsp_interactive
	cmp	rsi, 2
	je	LBBsp_initiated
	cmp	rsi, 1
	je	LBBsp_default
	cmp	rsi, 0
	je	LBBsp_utility
	mov	esi, 0x09
	jmp	LBBsp_set
LBBsp_interactive:
	mov	esi, 0x21
	jmp	LBBsp_set
LBBsp_initiated:
	mov	esi, 0x19
	jmp	LBBsp_set
LBBsp_default:
	mov	esi, 0x15
	jmp	LBBsp_set
LBBsp_utility:
	mov	esi, 0x11
LBBsp_set:
	xor	edx, edx
	call	silica_rt_pthread_set_qos_class_np
	leave
	ret
