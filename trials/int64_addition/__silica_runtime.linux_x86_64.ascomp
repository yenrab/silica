	call	mmap
	mov	rdi, rax
	cmp	rdi, -1
	jne	Lasr_mapped
	cmp	QWORD PTR [rbp - 48], 0
	jne	Lasr_fail
# The host refused the whole-machine reservation by heuristic: reserve just under it, in
# sixteenths, down to half of the default.
	lea	rax, [rip + silica_rt_stack_default_reserve]
	mov	r10, QWORD PTR [rax]
	mov	r11, r10
	shr	r11, 4
	mov	rax, QWORD PTR [rbp - 40]
	sub	rax, 1
	add	r11, rax
	not	rax
	and	r11, rax
	mov	rax, QWORD PTR [rbp - 32]
	sub	rax, r11
	mov	QWORD PTR [rbp - 32], rax
	shr	r10, 1
	cmp	rax, r10
	jb	Lasr_fail
	jmp	Lasr_try
Lasr_mapped:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 384], rdi
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 392], rcx
	mov	QWORD PTR [rax + 400], 0
	mov	QWORD PTR [rax + 408], 0
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax + 416], rcx
	mov	rcx, QWORD PTR [rbp - 24]
	mov	QWORD PTR [rax + 424], rcx
	mov	QWORD PTR [rax + 432], 0
	mov	QWORD PTR [rax + 440], 0
	mov	QWORD PTR [rax + 448], 0
	mov	QWORD PTR [rax + 456], 0
	mov	QWORD PTR [rax + 464], 0
	mov	r10, QWORD PTR [rbp - 16]
	and	r10, -16
	or	r10, rcx
	mov	QWORD PTR [rax + 472], r10
	mov	QWORD PTR [rax + 480], 0
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 488], rcx
	mov	QWORD PTR [rax + 496], 0
	cmp	QWORD PTR [rbp - 24], 3
	jne	Lasr_no_ring
	mov	edi, 32
	mov	esi, 8
	call	calloc
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx + 440], rax
Lasr_no_ring:
	xor	edi, edi
	jmp	Lasr_ret
Lasr_fail:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 384], 0
	mov	edi, 1
Lasr_ret:
	leave
	ret
	.globl	silica_rt_actor_altstack_install
	.p2align	2
silica_rt_actor_altstack_install:
# X0 = ACB. Every actor thread faults with SP inside its own inaccessible reservation, so the
# handler needs an alternate stack of its own on this thread.
# Frame: [rbp - 8] ACB (x19); stack_t at [rsp]: ss_sp @0, ss_flags (int) @8, ss_size @16.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 112
	mov	QWORD PTR [rbp - 8], rdi
# mmap(0, 65536, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS = 0x22, -1, 0)
	xor	edi, edi
	mov	esi, 65536
	mov	edx, 3
	mov	ecx, 34
	mov	r8d, -1
	xor	r9d, r9d
	call	mmap
	cmp	rax, -1
	je	Lsai_ret
	mov	rcx, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rcx + 464], rax
	mov	QWORD PTR [rsp], rax
	mov	QWORD PTR [rsp + 8], 0
	mov	QWORD PTR [rsp + 16], 65536
	mov	rdi, rsp
	xor	esi, esi
	call	sigaltstack
Lsai_ret:
	leave
	ret
	.globl	silica_rt_actor_stack_free
	.p2align	2
silica_rt_actor_stack_free:
# X0 = ACB, X1 = 1 when called on the alt stack (keep it mapped). Unmaps the reservation.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] on-alt-stack flag (x20).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	rdi, QWORD PTR [rdi + 384]
	test	rdi, rdi
	jz	Lsaf_alt
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax + 392]
	call	munmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 384], 0
Lsaf_alt:
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lsaf_ring
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 464]
	test	rdi, rdi
	jz	Lsaf_ring
	mov	esi, 65536
	call	munmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 464], 0
Lsaf_ring:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 440]
	test	rdi, rdi
	jz	Lsaf_done
	call	free
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 440], 0
Lsaf_done:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 400], 0
	mov	QWORD PTR [rax + 432], 0
	leave
	ret
	.globl	silica_rt_stack_grow_to
	.p2align	2
silica_rt_stack_grow_to:
# X0 = ACB, X1 = faulting address inside the reservation. Commits chunks below the committed run
# until the address is covered. X0 = 0 grown, 1 the lowered reservation is exhausted, 2 the host
# refused the commit, 3 the address was already committed (not stack growth).
# Frame: [rbp - 8] ACB (x19), [rbp - 16] address (x20), [rbp - 24] run low address (x21),
# [rbp - 32] chunk (x22), [rbp - 40] 1 = grew (x23).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 40], 0
Lsgt_loop:
	mov	rax, QWORD PTR [rbp - 8]
	mov	r8, QWORD PTR [rax + 384]
	mov	r10, QWORD PTR [rax + 392]
	add	r10, r8
	mov	r11, QWORD PTR [rax + 400]
	mov	rcx, r10
	sub	rcx, r11
	mov	QWORD PTR [rbp - 24], rcx
	cmp	QWORD PTR [rbp - 16], rcx
	jae	Lsgt_covered
# The lowest page of the reservation is never committed: reaching it is the end of the
# reservation whatever mapping sits below (the remainder stays a second, inaccessible mapping).
	mov	rdx, QWORD PTR [rax + 416]
	mov	QWORD PTR [rbp - 32], rdx
	mov	r11, rcx
	sub	r11, r8
	lea	rax, [rip + silica_rt_stack_page]
	mov	rax, QWORD PTR [rax]
	sub	r11, rax
	jbe	Lsgt_exhausted
	cmp	rdx, r11
	cmova	rdx, r11
	mov	QWORD PTR [rbp - 32], rdx
	mov	rdi, rcx
	sub	rdi, rdx
	mov	rsi, rdx
	mov	edx, 3
	call	mprotect
	test	eax, eax
	jnz	Lsgt_commit_failed
	mov	QWORD PTR [rbp - 40], 1
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 400]
	add	r11, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 400], r11
	cmp	r11, QWORD PTR [rax + 408]
	jbe	Lsgt_no_hw
	mov	QWORD PTR [rax + 408], r11
Lsgt_no_hw:
	mov	rcx, QWORD PTR [rax + 416]
	cmp	rcx, 1048576
	jae	Lsgt_loop
	shl	rcx, 1
	mov	QWORD PTR [rax + 416], rcx
	jmp	Lsgt_loop
Lsgt_covered:
	cmp	QWORD PTR [rbp - 40], 0
	je	Lsgt_not_ours
	xor	edi, edi
	jmp	Lsgt_ret
Lsgt_not_ours:
	mov	edi, 3
	jmp	Lsgt_ret
Lsgt_exhausted:
	mov	edi, 1
	jmp	Lsgt_ret
Lsgt_commit_failed:
	mov	edi, 2
Lsgt_ret:
	leave
	ret
	.globl	silica_rt_stack_measure
	.p2align	2
silica_rt_stack_measure:
# X0 = ACB -> X0 = bytes from the top down to the lowest page holding a nonzero word (0 = none).
# Leaf: rsi = base (x8), rdx = top (x9), rcx = committed (x10), r8 = page cursor (x11),
# r9 = page size (x12), r10 = word cursor (x13), r11 = page end (x14).
	mov	rsi, QWORD PTR [rdi + 384]
	mov	rdx, QWORD PTR [rdi + 392]
	add	rdx, rsi
	mov	rcx, QWORD PTR [rdi + 400]
	mov	r8, rdx
	sub	r8, rcx
	lea	r9, [rip + silica_rt_stack_page]
	mov	r9, QWORD PTR [r9]
Lsm_page:
	cmp	r8, rdx
	jae	Lsm_none
	mov	r10, r8
	mov	r11, r8
	add	r11, r9
Lsm_word:
	mov	rax, QWORD PTR [r10]
	or	rax, QWORD PTR [r10 + 8]
	lea	r10, [r10 + 16]
	jnz	Lsm_found
	cmp	r10, r11
	jb	Lsm_word
	mov	r8, r11
	jmp	Lsm_page
Lsm_found:
	mov	rdi, rdx
	sub	rdi, r8
	ret
Lsm_none:
	xor	edi, edi
	ret
	.globl	silica_rt_stack_release_to
	.p2align	2
silica_rt_stack_release_to:
# X0 = ACB, X1 = bytes to keep, X2 = bytes at the top the last message used (zeroed if kept).
# Releases whole chunks below the smallest chunk prefix that covers X1, in the sizes they grew by.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] keep prefix (x20), [rbp - 24] used (x21), [rbp - 32] next chunk (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 24], rdx
	mov	rdi, rsi
	test	rdi, rdi
	jz	Lsrt_zero_keep
	call	silica_rt_stack_prefix_for
	jmp	Lsrt_have
Lsrt_zero_keep:
	xor	edi, edi
	lea	rax, [rip + silica_rt_stack_page]
	mov	rsi, QWORD PTR [rax]
Lsrt_have:
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 32], rsi
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 400]
	cmp	rdi, r11
	jae	Lsrt_zero
	mov	r8, QWORD PTR [rax + 384]
	mov	r10, QWORD PTR [rax + 392]
	add	r10, r8
	mov	rdi, r10
	sub	rdi, r11
	mov	rsi, r11
	sub	rsi, QWORD PTR [rbp - 16]
# mmap(run low, committed - keep, PROT_NONE, MAP_FIXED|MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE = 0x4032, -1, 0)
	xor	edx, edx
	mov	ecx, 16434
	mov	r8d, -1
	xor	r9d, r9d
	call	mmap
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 400], rcx
	mov	rcx, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 416], rcx
	cmp	QWORD PTR [rbp - 16], 0
	jne	Lsrt_zero
	mov	rdi, QWORD PTR [rax + 464]
	test	rdi, rdi
	jz	Lsrt_zero
	mov	esi, 65536
	mov	edx, 4
	call	madvise
Lsrt_zero:
	mov	rax, QWORD PTR [rbp - 8]
	mov	r11, QWORD PTR [rax + 400]
	mov	QWORD PTR [rax + 432], r11
	mov	rcx, QWORD PTR [rbp - 24]
	test	rcx, rcx
	jz	Lsrt_ret
	cmp	rcx, r11
	cmova	rcx, r11
	mov	QWORD PTR [rbp - 24], rcx
	test	rcx, rcx
	jz	Lsrt_ret
	mov	r8, QWORD PTR [rax + 384]
	mov	r10, QWORD PTR [rax + 392]
	add	r10, r8
	mov	rdi, r10
	sub	rdi, rcx
	xor	esi, esi
	mov	rdx, rcx
	call	memset
Lsrt_ret:
	leave
	ret
	.globl	silica_rt_stack_on_message_return
	.p2align	2
silica_rt_stack_on_message_return:
# X0 = ACB. The behavior has returned and the stack is empty: apply the actor's release algorithm.
# Frame: [rbp - 8] ACB (x19), [rbp - 16] measured depth (x20), [rbp - 24] bytes to keep (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	cmp	QWORD PTR [rdi + 384], 0
	je	Lsmr_ret
	mov	r10, QWORD PTR [rdi + 424]
	cmp	r10, 5
	je	Lsmr_keep_all
	cmp	r10, 4
	je	Lsmr_idle_stamp
	cmp	r10, 1
	je	Lsmr_release_all
	call	silica_rt_stack_measure
	mov	QWORD PTR [rbp - 16], rdi
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 424], 3
	jne	Lsmr_keep_depth
	mov	r11, QWORD PTR [rax + 440]
	test	r11, r11
	jz	Lsmr_keep_depth
	mov	rcx, QWORD PTR [rax + 448]
	mov	rdx, rcx
	and	rdx, 31
	mov	QWORD PTR [r11 + rdx*8], rdi
	add	rcx, 1
	mov	QWORD PTR [rax + 448], rcx
	xor	edx, edx
	xor	r8d, r8d
Lsmr_ring_max:
	mov	r9, QWORD PTR [r11 + rdx*8]
	cmp	r9, r8
	cmova	r8, r9
	add	rdx, 1
	cmp	rdx, 32
	jb	Lsmr_ring_max
	mov	QWORD PTR [rbp - 24], r8
	jmp	Lsmr_release_keep
Lsmr_keep_depth:
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rbp - 24], rax
Lsmr_release_keep:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 24]
	mov	rdx, QWORD PTR [rbp - 16]
	call	silica_rt_stack_release_to
	jmp	Lsmr_ret
Lsmr_keep_all:
	mov	r11, QWORD PTR [rdi + 400]
	mov	QWORD PTR [rdi + 432], r11
	jmp	Lsmr_ret
Lsmr_idle_stamp:
	mov	r11, QWORD PTR [rdi + 400]
	mov	QWORD PTR [rdi + 432], r11
	call	silica_rt_stack_now_ns
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 456], rdi
	jmp	Lsmr_ret
Lsmr_release_all:
	mov	rdi, QWORD PTR [rbp - 8]
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_stack_release_to
Lsmr_ret:
	leave
	ret
	.globl	silica_rt_stack_idle_check
	.p2align	2
silica_rt_stack_idle_check:
# X0 = ACB -> X0 = mailbox wait timeout in microseconds (0 = wait without a timeout). Only
# :release_when_idle actors holding committed stack wait with a timeout; once a second has passed
# since the last message the stack is released and the wait becomes untimed.
# Frame: [rbp - 8] ACB (x19).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	cmp	QWORD PTR [rdi + 424], 4
	jne	Lsic_none
	cmp	QWORD PTR [rdi + 400], 0
	je	Lsic_none
	call	silica_rt_stack_now_ns
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 456]
	mov	rdx, rdi
	sub	rdx, rcx
	mov	r8, 1000000000
	cmp	rdx, r8
	jb	Lsic_wait
	mov	rdi, rax
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_stack_release_to
	jmp	Lsic_none
Lsic_wait:
	sub	r8, rdx
	mov	rax, r8
	xor	edx, edx
	mov	ecx, 1000
	div	rcx
	lea	rdi, [rax + 1]
	jmp	Lsic_ret
Lsic_none:
	xor	edi, edi
Lsic_ret:
	leave
	ret
	.globl	silica_rt_cv_wait_timeout
	.p2align	2
silica_rt_cv_wait_timeout:
# X0 = cv_addr, X1 = lock_addr, X2 = timeout in microseconds (0 = none). Caller holds the lock;
# the lock is held again on return, whether woken or timed out.
# Frame: [rbp - 8] cv (x19), [rbp - 16] lock (x20), [rbp - 24] timeout (x21), [rbp - 32] cv snapshot (w22);
# struct timespec at [rsp].
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	eax, DWORD PTR [rdi]
	mov	QWORD PTR [rbp - 32], rax
	mov	rdi, rsi
	call	silica_rt_lock_unlock
	cmp	QWORD PTR [rbp - 24], 0
	je	Lcwt_untimed
# futex(addr, FUTEX_WAIT_PRIVATE = 128, expected, &timespec{us / 1000000, (us % 1000000) * 1000}, 0, 0),
# raw syscall 202 (clobbers rcx, r11).
	mov	rax, QWORD PTR [rbp - 24]
	xor	edx, edx
	mov	rcx, 1000000
	div	rcx
	imul	rdx, rdx, 1000
	mov	QWORD PTR [rsp], rax
	mov	QWORD PTR [rsp + 8], rdx
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 128
	mov	edx, DWORD PTR [rbp - 32]
	mov	r10, rsp
	xor	r8d, r8d
	xor	r9d, r9d
	mov	eax, 202
	syscall
	jmp	Lcwt_lock
Lcwt_untimed:
	mov	edi, 3
	mov	rsi, QWORD PTR [rbp - 8]
	mov	edx, DWORD PTR [rbp - 32]
	xor	ecx, ecx
	call	silica_rt_futex_wait
Lcwt_lock:
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_lock_lock
	leave
	ret
	.globl	silica_rt_actor_fail_current
	.p2align	2
silica_rt_actor_fail_current:
# X0 = the current actor's ACB, X1 = reason atom. Ends the actor with (:explicit, atom): wakes its
# waiters, delivers the exit to its supervisor, frees what it owns and exits the thread. Runs on the
# signal alt stack (stack exhaustion) or on the actor stack (a spawn whose reservation failed).
# Frame: [rbp - 8] ACB (x19), [rbp - 16] row pointer (x20), [rbp - 24] supervisor (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rdi + 496], rsi
# Move onto the thread's alt stack (its top; nothing there is needed again) so the actor stack
# this may be running on can be unmapped now. On the exhaustion path we are already there.
# The stack is given back before any waiter is woken, as at a message boundary: a caller that
# wakes on the death and asks get_actor_memory_usage must already see the reservation gone.
# The frame slots must move with the stack (they are memory here, not x19..x21): a fresh frame is
# opened at the alt stack top; this routine never returns, so the abandoned frame is not unwound.
	mov	r10, QWORD PTR [rdi + 464]
	test	r10, r10
	jz	Lafc_on_stack
	add	r10, 65536
	mov	rsp, r10
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
Lafc_on_stack:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 1
	call	silica_rt_actor_stack_free
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax + 336], 4
	mov	DWORD PTR [rax + 152], 0
	lea	rdi, [rax + 80]
	call	silica_rt_cv_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rax + 272], 0
	jne	Lafc_report_done
	mov	rdi, rax
	call	silica_rt_actor_deliver_exit
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_deliver_unwind_report
Lafc_report_done:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_signal_pending_call_deaths
	mov	rax, QWORD PTR [rbp - 8]
	mov	rcx, QWORD PTR [rax + 208]
	mov	QWORD PTR [rbp - 16], rcx
	mov	rcx, QWORD PTR [rax + 192]
	mov	QWORD PTR [rbp - 24], rcx
	test	rcx, rcx
	jz	Lafc_thread_exit
	mov	rdi, rax
	call	silica_rt_ffi_arena_teardown
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_child_table_free
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_actor_dealloc_region
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	mov	rax, QWORD PTR [rbp - 16]
	test	rax, rax
	jz	Lafc_thread_exit
	mov	QWORD PTR [rax + 56], 1
Lafc_thread_exit:
	xor	edi, edi
	call	pthread_exit
	jmp	Lafc_thread_exit
	.globl	silica_rt_spawn_reserve_failed
	.p2align	2
silica_rt_spawn_reserve_failed:
# A spawn could not make its reservation. The spawning actor fails with
# (:explicit, :stack_reserve_failed); `main` is not an actor, so there it is reported and the
# program exits, as for any failure in non-actor code. Never returns.
	push	rbp
	mov	rbp, rsp
	call	silica_rt_tls_current_actor_get
	test	rdi, rdi
	jz	Lsrf_main
	lea	rax, [rip + silica_rt_stack_reserve_failed_atom]
	mov	rsi, QWORD PTR [rax]
	call	silica_rt_actor_fail_current
Lsrf_main:
	mov	edi, 2
	lea	rsi, [rip + L_srt_reserve_failed_msg]
	mov	edx, 21
	call	write
	mov	edi, 1
	call	exit
	jmp	Lsrf_main
	.globl	silica_rt_get_actor_memory_usage
	.p2align	2
silica_rt_get_actor_memory_usage:
# X0 = actor_ref -> X0 = heap { reserved, committed, retained, high_water } (bytes; all zero once
# the actor has ended).
# Frame: [rbp - 8] actor_ref (x19).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	edi, 32
	call	malloc
	mov	rdi, rax
	test	rdi, rdi
	jz	Lgmu_ret
	mov	rax, QWORD PTR [rbp - 8]
	cmp	rax, 4096
	jb	Lgmu_zero
	cmp	QWORD PTR [rax + 384], 0
	je	Lgmu_zero
	mov	rcx, QWORD PTR [rax + 392]
	mov	QWORD PTR [rdi], rcx
	mov	rcx, QWORD PTR [rax + 400]
	mov	QWORD PTR [rdi + 8], rcx
	mov	rcx, QWORD PTR [rax + 432]
	mov	QWORD PTR [rdi + 16], rcx
	mov	rcx, QWORD PTR [rax + 408]
	mov	QWORD PTR [rdi + 24], rcx
	jmp	Lgmu_ret
Lgmu_zero:
	mov	QWORD PTR [rdi], 0
	mov	QWORD PTR [rdi + 8], 0
	mov	QWORD PTR [rdi + 16], 0
	mov	QWORD PTR [rdi + 24], 0
Lgmu_ret:
	leave
	ret

    .section .note.GNU-stack,"",@progbits

