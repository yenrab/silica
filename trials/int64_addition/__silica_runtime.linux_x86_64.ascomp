	.globl	silica_rt_ffi_arena_ensure
	.p2align	4
silica_rt_ffi_arena_ensure:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 352]
	test	rax, rax
	jnz	L_arena_ensure_done
	xor	edi, edi
# The arena is 256 KB followed by one inaccessible 16 KB guard page. Without the guard,
# whether a write just past the arena faults depended on whether the kernel happened to
# place another mapping directly after it; under a loaded trial run on the Pi it did, and
# the arena-bounds fault vanished. The guard is not part of the arena: [ACB+360] still
# marks the arena end, so the guard reads as past-the-end to the fault handler.
	mov	esi, 278528
	mov	edx, 3
	mov	ecx, 34
	mov	r8, -1
	xor	r9d, r9d
	call	mmap
	cmp	rax, -1
	je	L_arena_ensure_fail
	test	rax, rax
	jz	L_arena_ensure_fail
	mov	QWORD PTR [rbp - 16], rax
	lea	r10, [rax + 262144]
	mov	QWORD PTR [rbp - 24], r10
	mov	rdi, r10
	mov	esi, 16384
	xor	edx, edx
	call	mprotect
	mov	rax, QWORD PTR [rbp - 16]
	mov	r10, QWORD PTR [rbp - 24]
	mov	rdi, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rdi + 352], rax
	mov	QWORD PTR [rdi + 360], r10
	mov	QWORD PTR [rdi + 368], rax
L_arena_ensure_done:
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	ret
L_arena_ensure_fail:
	xor	edi, edi
	leave
	ret
	.globl	silica_rt_ffi_arena_bump
	.p2align	4
silica_rt_ffi_arena_bump:
	push	rbp
