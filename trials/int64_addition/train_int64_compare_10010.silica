// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(8 != 49 % 8);
        println("");
        _: atom <- print_bool(23 != 60 / 4);
        println("");
        result: atom <- print_bool(54 * 21 <= (60 + 31))
    produces
        pure result
    end
}
