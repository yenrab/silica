// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64(46 % 21);
        println("");
        _: atom <- print_int64(35 % 13 % 4);
        println("");
        result: atom <- print_int64(14 / 50)
    produces
        pure result
    end
}
