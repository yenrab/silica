// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((9 % 6) < 52);
        println("");
        _: atom <- print_bool(52 <= 41 / 36);
        println("");
        _: atom <- print_bool((28 + 9) == 44 / 6);
        println("");
        result: atom <- print_bool((17 - 11) < (59 + 39))
    produces pure result end
}
