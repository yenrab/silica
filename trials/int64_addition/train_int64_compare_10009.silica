// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((35 + 15) >= (59 - 6));
        println("");
        _: atom <- print_bool((31 + 23) > 41 * 1);
        println("");
        _: atom <- print_bool(45 * 11 != 7 % 27);
        println("");
        _: atom <- print_bool(49 % 35 < 39 / 4);
        println("");
        result: atom <- print_bool((37 - 35) <= 0)
        produces pure result end
}
