// int64 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(31 != 40 * 50);
        println("");
        _: atom <- print_bool((36 + 40) >= (32 - 25));
        println("");
        _: atom <- print_bool((0 * 18) != 38 / 54);
        println("");
        _: atom <- print_bool(31 > (50 + 20));
        println("");
        result: atom <- print_bool(34 * 41 > (11 + 36))
        produces pure result end
}
