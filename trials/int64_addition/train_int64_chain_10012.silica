// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64((60 % 7));
        println("");
        _: atom <- print_int64(16);
        println("");
        _: atom <- print_int64(24);
        println("");
        result: atom <- print_int64((59 + 28 + 34))
    produces pure result end
}
