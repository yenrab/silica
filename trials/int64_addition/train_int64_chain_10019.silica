// chained print_int64 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int64((48 + (40 - 33)));
        println("");
        _: atom <- print_int64(25 + 6);
        println("");
        _: atom <- print_int64((26 / 24) / 44);
        println("");
        result: atom <- print_int64(53)
    produces pure result end
}
