// A bare `print_int64(<literal>)` statement inside a sequence block must print the literal.
//
// Open defect (found 2026-09-12 while writing the ESP32-S3 port's early apps): in statement form --
// no `r: atom <- ...` binding -- every literal argument is emitted as `MOV X0, #0` followed by
// `BL L_pi_helper`, so the value is dropped, and L_pi_helper is never emitted, so the module fails
// to assemble ("assembler local symbol 'L_pi_helper' not defined"). The bound form
// (`a: atom <- print_int64(42)`) and a variable argument (`print_int64(x)`) both work, and every
// other trial uses one of those, which is why nothing caught it.
//
// Covers a positive literal, a negative one, and one that needs more than 32 bits.
fn main() -> atom {
    sequence proc[device_io]
        print_int64(42);
        println();
        print_int64(-42);
        println();
        print_int64(5000000000);
        println()
    produces pure :ok end
}
