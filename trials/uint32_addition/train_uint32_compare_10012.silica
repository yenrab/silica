// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((17 + 37) > (41 + 32));
        println("");
        _: atom <- print_bool((11 + 43) != 43 * 49);
        println("");
        _: atom <- print_bool(22 % 21 != (60 + 27));
        println("");
        _: atom <- print_bool((16 + 13) < 12);
        println("");
        result: atom <- print_bool(45 / 33 <= 40)
        produces pure result end
}
