// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(40 > 35);
        println("");
        _: atom <- print_bool(47 < 10);
        println("");
        _: atom <- print_bool((36 + 7) > 25);
        println("");
        result: atom <- print_bool((31 + 25) == (58 + 55))
        produces pure result end
}
