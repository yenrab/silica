// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(28 % 43 < 52);
        println("");
        _: atom <- print_bool((11 + 53) > (51 + 38));
        println("");
        result: atom <- print_bool((38 + 56) == 34)
    produces pure result end
}
