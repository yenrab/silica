// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint32(39);
        println("");
        _: atom <- print_uint32(14 + 6 * 16);
        println("");
        _: atom <- print_uint32(40);
        println("");
        result: atom <- print_uint32(6 % 54)
    produces pure result end
}
