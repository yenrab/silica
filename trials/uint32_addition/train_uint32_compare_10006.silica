// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(27 != 58 / 56);
        println("");
        _: atom <- print_bool(34 <= (6 + 43));
        println("");
        _: atom <- print_bool((17 + 2) != (29 * 36));
        println("");
        result: atom <- print_bool(22 <= 2 % 10)
        produces pure result end
}
