// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(59 < 50 * 56);
        println("");
        _: atom <- print_bool(14 / 23 < (6 + 3));
        println("");
        _: atom <- print_bool(8 / 34 == 10 / 35);
        println("");
        _: atom <- print_bool(7 * 59 == (52 % 14));
        println("");
        result: atom <- print_bool(16 % 53 < 21 % 59)
    produces
        pure result
    end
}
