// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(8 % 57 < 43);
        println("");
        _: atom <- print_bool((28 + 45) > 23 / 31);
        println("");
        _: atom <- print_bool(42 * 6 < 12 % 44);
        println("");
        _: atom <- print_bool(32 < 55 * 45);
        println("");
        result: atom <- print_bool(38 / 41 < (35 + 38))
    produces pure result end
}
