// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint32(28 * 27 + 54 % 46);
        println("");
        _: atom <- print_uint32(21);
        println("");
        _: atom <- print_uint32(4 / 36);
        println("");
        result: atom <- print_uint32(55 + 54)
    produces
        pure result
    end
}
