// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(30 % 46 <= (59 + 14));
        println("");
        _: atom <- print_bool(36 % 20 == 28);
        println("");
        _: atom <- print_bool((2 + 42) < 55);
        println("");
        _: atom <- print_bool((21 + 55) <= 0 % 18);
        println("");
        result: atom <- print_bool(9 * 29 <= (49 + 13))
        produces pure result end
}
