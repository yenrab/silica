// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(48 == (47 + 55));
        println("");
        _: atom <- print_bool(40 / 3 <= 60 / 10);
        println("");
        _: atom <- print_bool((30 + 13) >= (25 + 22));
        println("");
        _: atom <- print_bool(16 * 37 >= (32 + 0));
        println("");
        result: atom <- print_bool((5 + 15) <= (7 + 17))
    produces
        pure result
    end
}
