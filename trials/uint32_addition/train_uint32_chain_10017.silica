// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_uint32(55 % 38);
        println("");
        _: atom <- print_uint32(10);
        println("");
        _: atom <- print_uint32(55 / 45);
        println("");
        result: atom <- print_uint32(53 % (23 % 13))
        produces pure result end
}
