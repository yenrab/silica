// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint32(17);
        println("");
        _: atom <- print_uint32(55);
        println("");
        _: atom <- print_uint32(21);
        println("");
        result: atom <- print_uint32(58)
    produces
        pure result
    end
}
