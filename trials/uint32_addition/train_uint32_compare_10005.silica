// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(33 % 13 != 59 / 48);
        println("");
        _: atom <- print_bool((16 + 27) <= 55);
        println("");
        _: atom <- print_bool((34 % 4) != (52 + 10));
        println("");
        _: atom <- print_bool(45 < 15 % 46);
        println("");
        result: atom <- print_bool(7 > (51 + 26))
    produces pure result end
}
