// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((21 + 14) == 20 / 42);
        println("");
        _: atom <- print_bool((53 - 3) != 0 / 14);
        println("");
        result: atom <- print_bool((28 - 23) >= 33)
        produces pure result end
}
