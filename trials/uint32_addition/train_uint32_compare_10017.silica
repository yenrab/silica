// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(21 / 11 > 42);
        println("");
        _: atom <- print_bool(20 != 29);
        println("");
        _: atom <- print_bool((25 + 14) == 41);
        println("");
        _: atom <- print_bool(47 % 45 > 46 % 36);
        println("");
        result: atom <- print_bool(9 * 53 > (56 - 19))
        produces pure result end
}
