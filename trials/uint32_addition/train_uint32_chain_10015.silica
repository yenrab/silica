// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint32(19);
        println("");
        _: atom <- print_uint32(25);
        println("");
        result: atom <- print_uint32((19 % 16) * (7 / 44))
    produces
        pure result
    end
}
