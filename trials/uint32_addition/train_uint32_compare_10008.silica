// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((4 + 52) == 48);
        println("");
        _: atom <- print_bool(52 < (4 * 20));
        println("");
        result: atom <- print_bool((41 + 32) == 14 % 19)
    produces pure result end
}
