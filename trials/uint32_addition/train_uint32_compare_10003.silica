// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((57 / 6) <= (18 / 5));
        println("");
        _: atom <- print_bool((60 - 36) != 43);
        println("");
        _: atom <- print_bool((53 + 5) >= 51 * 54);
        println("");
        result: atom <- print_bool(15 % 20 < 18)
        produces pure result end
}
