// chained print_uint32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_uint32((40 + 27));
        println("");
        _: atom <- print_uint32(21 + 50);
        println("");
        _: atom <- print_uint32((31 / 36 / (4 + 34)));
        println("");
        result: atom <- print_uint32(34)
    produces pure result end
}
