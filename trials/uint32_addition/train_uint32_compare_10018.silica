// uint32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(30 % 45 != 49 * 5);
        println("");
        _: atom <- print_bool(3 % 19 >= 43);
        println("");
        _: atom <- print_bool((60 - 44) < (0 + 16));
        println("");
        _: atom <- print_bool((32 + 11) > 38 % 38);
        println("");
        result: atom <- print_bool(20 == (13 * 14))
        produces pure result end
}
