// Documented open type-checker defect (book-verification 2026-09-19, repro ds_tree). The `Tree`
// (rose tree) shape of the defect documented in
// compile_defects_ordered_set_field_annotation_addition (see that README): a record annotation
// with a `Tree[string, mem(normal)]`-typed field is rejected even though the plain, non-nested
// binding of the same bracket type is accepted. References the real stdlib
// `tree_rose.silica`/`Tree.silica` (and their `skew_ral*` dependencies) by relative path rather
// than copying them.
// Expected: "Mother" is added as a child of the root, `grown.added` is true, exit 1.
// Observed: E2003 "tree_rose@add_leaf returns {tree : {...concrete fields...}, added: boolean,
// child_slot: int64}, expected {tree: Tree[string, normal], added: boolean, child_slot: int64}".

use tree_rose;
use Tree;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        t: Tree[string, mem(normal)] <- tree_rose@with_root({ compare_item: compare_names }, "Grandmother");
        found: { status: :not_found | :found, value: string, path: List[int64, mem(normal)] } <- tree_rose@find_first(t, "Grandmother", "");
        grown: { tree: Tree[string, mem(normal)], added: boolean, child_slot: int64 } <- tree_rose@add_leaf(t, found.path, "Mother")
    produces
        pure case grown.added of {
            true -> 1;
            false -> 0
        }
    end
}
