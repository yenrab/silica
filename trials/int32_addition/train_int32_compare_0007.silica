// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((11 + 23) != 7);
        println("");
        _: atom <- print_bool(32 * 57 != 8 / 41);
        println("");
        _: atom <- print_bool(33 % 46 == 15 % 36);
        println("");
        result: atom <- print_bool((12 + 45) > 42 * 49)
    produces pure result end
}
