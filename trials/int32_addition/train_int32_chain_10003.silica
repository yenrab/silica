// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int32(16);
        println("");
        _: atom <- print_int32(56);
        println("");
        _: atom <- print_int32(26);
        println("");
        result: atom <- print_int32(36)
        produces pure result end
}
