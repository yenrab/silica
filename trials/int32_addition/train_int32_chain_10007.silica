// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int32(2);
        println("");
        _: atom <- print_int32(42 + 30);
        println("");
        _: atom <- print_int32(37);
        println("");
        result: atom <- print_int32(39)
    produces pure result end
}
