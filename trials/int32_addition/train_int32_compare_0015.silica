// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((25 / 53) <= 31);
        println("");
        _: atom <- print_bool(23 % 46 <= (30 + 13));
        println("");
        _: atom <- print_bool(24 % 21 != 10 * 27);
        println("");
        result: atom <- print_bool(24 * 48 >= 31 / 37)
    produces
        pure result
    end
}
