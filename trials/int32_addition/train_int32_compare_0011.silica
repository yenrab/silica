// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(52 > (43 + 27));
        println("");
        _: atom <- print_bool(10 == 50 / 33);
        println("");
        result: atom <- print_bool((52 + 4) != (54 + 19))
        produces pure result end
}
