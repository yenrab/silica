// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((34 + 49) == (24 + 9));
        println("");
        _: atom <- print_bool(19 * 5 > 21 / 15);
        println("");
        result: atom <- print_bool((16 / 20) >= 44)
    produces
        pure result
    end
}
