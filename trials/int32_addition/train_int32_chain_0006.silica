// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int32(46 * 1);
        println("");
        _: atom <- print_int32(15 / 26 + (47 + 21));
        println("");
        result: atom <- print_int32(42)
    produces pure result end
}
