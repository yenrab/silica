// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int32((39 * 14) % 3);
        println("");
        _: atom <- print_int32(11 % 20 + 60);
        println("");
        _: atom <- print_int32(44);
        println("");
        result: atom <- print_int32(54)
    produces pure result end
}
