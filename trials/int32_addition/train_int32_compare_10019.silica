// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((35 - 35) == (48 / 47));
        println("");
        _: atom <- print_bool(32 == 56 * 6);
        println("");
        _: atom <- print_bool(22 != (7 - 3));
        println("");
        _: atom <- print_bool(15 < 19 % 17);
        println("");
        result: atom <- print_bool(27 * 10 >= (39 + 45))
    produces
        pure result
    end
}
