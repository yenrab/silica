// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(20 / 56 > (45 + 52));
        println("");
        _: atom <- print_bool((9 / 52) != 34 * 52);
        println("");
        _: atom <- print_bool((15 + 2) < 42);
        println("");
        _: atom <- print_bool(57 < 31);
        println("");
        result: atom <- print_bool(30 * 16 <= 58)
    produces pure result end
}
