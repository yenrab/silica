// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((54 + 43) > 11 / 60);
        println("");
        _: atom <- print_bool((49 % 23) == (37 - 7));
        println("");
        _: atom <- print_bool((13 - 9) > 56 % 28);
        println("");
        result: atom <- print_bool(50 <= 44 % 12)
        produces pure result end
}
