// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int32(15);
        println("");
        _: atom <- print_int32(2);
        println("");
        _: atom <- print_int32((14 + 12) % (42 * 16));
        println("");
        result: atom <- print_int32(0)
    produces pure result end
}
