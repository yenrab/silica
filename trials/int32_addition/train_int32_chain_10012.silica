// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int32((52 / 33 / (11 + 35)));
        println("");
        _: atom <- print_int32(34 % (25 + 42));
        println("");
        result: atom <- print_int32(11)
    produces pure result end
}
