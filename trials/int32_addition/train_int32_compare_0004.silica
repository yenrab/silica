// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((17 - 5) > (25 + 53));
        println("");
        _: atom <- print_bool((42 + 3) == 16 % 57);
        println("");
        _: atom <- print_bool(53 <= 33);
        println("");
        _: atom <- print_bool(37 > 57 * 43);
        println("");
        result: atom <- print_bool(7 * 17 >= (1 + 11))
    produces pure result end
}
