// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(50 >= 17 / 20);
        println("");
        _: atom <- print_bool((44 - 7) <= (58 + 37));
        println("");
        result: atom <- print_bool((10 + 38) < 26)
    produces pure result end
}
