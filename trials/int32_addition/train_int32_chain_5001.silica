// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int32(60);
        println("");
        _: atom <- print_int32(10);
        println("");
        _: atom <- print_int32(9);
        println("");
        result: atom <- print_int32(52 * 36)
    produces
        pure result
    end
}
