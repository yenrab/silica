// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((30 + 4) <= 46 % 22);
        println("");
        _: atom <- print_bool(10 / 12 != 38 % 40);
        println("");
        _: atom <- print_bool((52 + 53) > (19 % 57));
        println("");
        _: atom <- print_bool(56 > 45 / 6);
        println("");
        result: atom <- print_bool((47 + 19) == 53)
        produces pure result end
}
