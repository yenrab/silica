// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(44 != 46 * 19);
        println("");
        _: atom <- print_bool(47 % 48 != 40 * 23);
        println("");
        _: atom <- print_bool(26 * 41 == 50);
        println("");
        _: atom <- print_bool(39 * 17 >= 20 / 54);
        println("");
        result: atom <- print_bool((30 * 24) < 46 % 47)
        produces pure result end
}
