// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int32(41 + 18 + (48 + 5));
        println("");
        _: atom <- print_int32(50 / 16 + 43);
        println("");
        result: atom <- print_int32(33 - 1)
        produces pure result end
}
