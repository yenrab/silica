// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((9 + 49) == (19 + 1));
        println("");
        _: atom <- print_bool((3 + 24) == 17 * 34);
        println("");
        _: atom <- print_bool(6 * 9 > (12 + 2));
        println("");
        _: atom <- print_bool(11 != 6 / 45);
        println("");
        result: atom <- print_bool(9 * 13 > (48 * 34))
        produces pure result end
}
