// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((2 + 58) >= (53 - 40));
        println("");
        _: atom <- print_bool(41 == 3);
        println("");
        _: atom <- print_bool((3 + 20) != 55 * 9);
        println("");
        result: atom <- print_bool(30 >= 9 % 15)
    produces
        pure result
    end
}
