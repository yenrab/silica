// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((8 + 22) >= (37 + 49));
        println("");
        _: atom <- print_bool((58 * 23) <= (49 + 53));
        println("");
        _: atom <- print_bool((45 - 25) != 13 % 45);
        println("");
        _: atom <- print_bool(16 % 30 <= 30 % 39);
        println("");
        result: atom <- print_bool((36 / 14) > (3 * 44))
    produces pure result end
}
