// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int32(43);
        println("");
        _: atom <- print_int32(25);
        println("");
        _: atom <- print_int32(1);
        println("");
        result: atom <- print_int32(18 + 46)
    produces pure result end
}
