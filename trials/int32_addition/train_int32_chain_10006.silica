// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_int32(14);
        println("");
        _: atom <- print_int32(50);
        println("");
        _: atom <- print_int32(25 + 18);
        println("");
        result: atom <- print_int32(23 + (18 + 6))
        produces pure result end
}
