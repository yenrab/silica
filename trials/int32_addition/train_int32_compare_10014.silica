// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((51 + 21) < 15 % 19);
        println("");
        _: atom <- print_bool(19 / 33 < 1 / 55);
        println("");
        _: atom <- print_bool(60 % 54 >= 2 / 21);
        println("");
        result: atom <- print_bool(22 % 26 >= 55)
        produces pure result end
}
