// chained print_int32 calls separated by println
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_int32((18 / 5));
        println("");
        _: atom <- print_int32(51);
        println("");
        _: atom <- print_int32(5);
        println("");
        result: atom <- print_int32(16)
    produces pure result end
}
