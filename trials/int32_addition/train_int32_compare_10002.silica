// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((26 - 3) < 59 * 0);
        println("");
        _: atom <- print_bool(9 == 15 % 31);
        println("");
        result: atom <- print_bool(5 / 25 == 14 % 15)
    produces pure result end
}
