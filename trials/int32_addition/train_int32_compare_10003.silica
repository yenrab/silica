// int32 comparisons printed with print_bool
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((21 + 52) > (52 + 48));
        println("");
        _: atom <- print_bool(3 * 56 < 53 / 18);
        println("");
        _: atom <- print_bool((18 + 28) >= 44);
        println("");
        _: atom <- print_bool((50 - 22) != (57 - 26));
        println("");
        result: atom <- print_bool((53 - 21) == (30 + 48))
    produces pure result end
}
