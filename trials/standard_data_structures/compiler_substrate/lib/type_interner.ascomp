    B.GE L_lph_new_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_new_agg
    B L_lph_new_stored
L_lph_new_scalar:
    CMP X3, #8
    B.EQ L_lph_ns8
