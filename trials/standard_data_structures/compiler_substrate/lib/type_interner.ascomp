    MOV X0, #24
    BL _silica_rt_region_alloc
    LDP X6, XZR, [SP], #16
    LDP X3, X4, [SP], #16
    STR X3, [X0]
    STR X4, [X0, #8]
    STR X6, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lth_next_chunk:
    LDR X7, [X4, X2]
    CBZ X7, L_lth_nil
