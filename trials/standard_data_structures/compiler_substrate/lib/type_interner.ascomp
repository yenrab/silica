    ADD X25, X21, X25
    MOV X26, X23
    MOV X27, X24
Lew_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Lew_false
    SUBS X27, X27, #1
    B.NE Lew_cloop
Lew_true:
    MOV W0, #1
    B Lew_exit
Lew_false:
    MOV W0, #0
Lew_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

L_string_contains_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lsc_false
    CBZ X20, Lsc_false
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lsc_n1_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lsc_n1_cstr
    LDR X21, [X0, #8]
    LDR X22, [X0, #16]
    MOV X2, #0x40000000
    CMP X22, X2
    B.HS Lsc_n1_cstr
    B Lsc_n1_done
Lsc_n1_cstr:
    MOV X21, X0
    MOV X22, #0
    MOV X1, X0
Lsc_n1l:
    LDRB W3, [X1], #1
    CBZ W3, Lsc_n1_done
    ADD X22, X22, #1
    CMP X22, #0x100000
    B.LT Lsc_n1l
Lsc_n1_done:
    MOV X0, X20
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lsc_n2_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lsc_n2_cstr
    LDR X23, [X0, #8]
    LDR X24, [X0, #16]
    MOV X2, #0x40000000
    CMP X24, X2
    B.HS Lsc_n2_cstr
    B Lsc_n2_done
Lsc_n2_cstr:
    MOV X23, X0
    MOV X24, #0
    MOV X1, X0
Lsc_n2l:
    LDRB W3, [X1], #1
    CBZ W3, Lsc_n2_done
    ADD X24, X24, #1
    CMP X24, #0x100000
    B.LT Lsc_n2l
Lsc_n2_done:
    CBZ X24, Lsc_true
    CMP X24, X22
    B.HI Lsc_false
    SUB X25, X22, X24
    ADD X25, X25, #1
    MOV X26, X21
Lsc_outer:
    MOV X27, X26
    MOV X28, X23
    MOV X0, X24
Lsc_inner:
    LDRB W1, [X27], #1
    LDRB W2, [X28], #1
    CMP W1, W2
    B.NE Lsc_next
    SUBS X0, X0, #1
    B.NE Lsc_inner
    B Lsc_true
Lsc_next:
    ADD X26, X26, #1
    SUBS X25, X25, #1
    B.NE Lsc_outer
    B Lsc_false
Lsc_true:
    MOV W0, #1
    B Lsc_exit
Lsc_false:
    MOV W0, #0
Lsc_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

L_list_prepend_helper:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X1, X2, [SP, #-16]!
    STP X3, X4, [SP, #-16]!
    STR X5, [SP, #-16]!
    CBZ X2, L_lph_new_chunk
    LDR X6, [X2, #16]
    CBZ X6, L_lph_new_chunk
    LDR X7, [X2, #8]
    SUB X8, X6, X3
    ADD X10, X7, X8
    LDR X11, [SP]
    CBZ X11, L_lph_room_scalar
    MOV X12, #0
L_lph_room_agg:
    CMP X12, X3
    B.GE L_lph_room_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_room_agg
    B L_lph_room_stored
L_lph_room_scalar:
    CMP X3, #8
    B.EQ L_lph_rs8
    CMP X3, #4
    B.EQ L_lph_rs4
    CMP X3, #2
    B.EQ L_lph_rs2
    STRB W1, [X10]
    B L_lph_room_stored
L_lph_rs2:
    STRH W1, [X10]
    B L_lph_room_stored
L_lph_rs4:
    STR W1, [X10]
    B L_lph_room_stored
L_lph_rs8:
    STR X1, [X10]
L_lph_room_stored:
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDR X5, [SP], #16
    LDP X3, X4, [SP], #16
    LDP X1, X2, [SP], #16
    LDR X6, [X2]
    ADD X6, X6, #1
    STR X6, [X0]
    LDR X7, [X2, #8]
    STR X7, [X0, #8]
    LDR X8, [X2, #16]
    SUB X8, X8, X3
    STR X8, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lph_new_chunk:
    ADD X0, X4, #8
    BL _silica_rt_region_alloc
    MOV X6, X0
    LDR X5, [SP]
    LDP X3, X4, [SP, #16]
    LDP X1, X2, [SP, #32]
    SUB X8, X4, X3
    ADD X10, X6, X8
    CBZ X5, L_lph_new_scalar
    MOV X12, #0
L_lph_new_agg:
    CMP X12, X3
    B.GE L_lph_new_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_new_agg
    B L_lph_new_stored
L_lph_new_scalar:
    CMP X3, #8
    B.EQ L_lph_ns8
    CMP X3, #4
    B.EQ L_lph_ns4
    CMP X3, #2
    B.EQ L_lph_ns2
    STRB W1, [X10]
    B L_lph_new_stored
L_lph_ns2:
    STRH W1, [X10]
    B L_lph_new_stored
L_lph_ns4:
    STR W1, [X10]
    B L_lph_new_stored
L_lph_ns8:
    STR X1, [X10]
L_lph_new_stored:
    CBZ X2, L_lph_next_nil
    LDR X9, [X2, #8]
    STR X9, [X6, X4]
    B L_lph_alloc_handle
L_lph_next_nil:
    STR XZR, [X6, X4]
L_lph_alloc_handle:
    STP X6, X8, [SP, #-16]!
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDP X6, X8, [SP], #16
    LDR X5, [SP], #16
    LDP X3, X4, [SP], #16
    LDP X1, X2, [SP], #16
    CBZ X2, L_lph_len1
