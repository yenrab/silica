export empty/1;

fn empty(functions: {
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge_data: fn(unit, unit) -> :less | :equal | :greater
}) -> {
    node_count: int64,
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge_data: fn(unit, unit) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64
} {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        ph: region(L, normal) <- canonical_arena_lookup(1);
        out: {
            node_count: int64,
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge_data: fn(unit, unit) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64
        } <- {
            node_count: 0,
            compare_node: functions.compare_node,
            compare_edge_data: functions.compare_edge_data,
            region: ph,
            specialization_key: 0
        }
    produces
        pure out
    end
}
