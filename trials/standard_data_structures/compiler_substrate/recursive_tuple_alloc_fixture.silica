// Layer 1 §7.3: one-node recursive tuple allocates via alloc_rec and reads back.

fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        cell: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (42, :none));
        node: (int64, ref?(L, normal, rec)) <- read_ref(cell);
        (v: int64, _: ref?(L, normal, rec)) <- node
    produces
        pure v
    end
}
