// Documented open type-checker defect (2026-09-18), found while writing the UndirectedGraph trait over
// graph_wbt_undirected and graph_weighted_undirected (stdlib/data_structures/UndirectedGraph.silica
// deviation 5). It sits alone in this directory because a compile rejection fails the whole directory.
//
// Defect: a value bound with UndirectedGraph[N, E, mem(S)] from its registered constructor fits every
// implementation whose record carries the compare_node / compare_edge_data witnesses. With two such
// implementations, a trait method whose parameter after the receiver is a placeholder (id: KeyType,
// as in UndirectedGraph@degree / has_vertex / has_edge / connected) rejects the receiver; with one
// implementation the same call compiles, and a receiver-only method compiles either way (dispatched
// by declaration order, trials/traits_addition/emitter_defect_bracket_receiver_impl_order).
// undirected_graph_trait.md §13 calls UndirectedGraph@has_edge(g1.graph, 10, 20) on such a value.
// Expected: compiles and prints 5 (the stub record's count), exit 0.
// Observed: E2003 "type mismatch: g" on the receiver of PlusGraph@count_at (line 36, column 40).
//
// To run by hand:
//   mkdir -p /tmp/bra && cp StubGraphUndirected.silica PlusGraph.silica defect_bracket_receiver_arguments.silica /tmp/bra/ && cd /tmp/bra
//   printf 'StubGraphUndirected.silica\nPlusGraph.silica\ndefect_bracket_receiver_arguments.silica\n' > silica.config
//   /Volumes/2T/silica/binaries/silica-compiler

use StubGraphUndirected;
use PlusGraph;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        g: UndirectedGraph[int64, int64, mem(normal)] <- StubGraphUndirected@empty({ compare_node: cmp_i64, compare_edge_data: cmp_i64 });
        n: int64 <- PlusGraph@count_at(g, 2);
        print_int64(n);
        println("")
    produces
        pure 0
    end
}
