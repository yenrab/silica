// Trait for defect_bracket_receiver_arguments: two implementations whose records both carry the
// compare_node / compare_edge_data witnesses of an UndirectedGraph[...] bracket type.

use StubGraphUndirected;

export trait PlusGraph;
export count_at/2;

required {
    fn count_at(g: PlusGraph, id: KeyType) -> int64;
}

impl fn count_at(g: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, count: int64 }, id: KeyType) -> int64 {
    StubGraphUndirected@count_at(g, id)
}

impl fn count_at(g: { compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, tag: int64, pad: int64, count: int64 }, id: KeyType) -> int64 {
    StubGraphUndirected@extra_count_at(g, id)
}
