// Generic helper for record_item_through_generic_result (2026-09-18), found
// while building the PriorityQueue over brodal_okasaki entries; nested_record_item_through_generic
// uses it too.
//
// A minimal generic module: wrap stores its ItemType argument in a result record. The emitter sees
// `value: ItemType` as one word here, so a record item is stored as its pointer.

export wrap/2;

fn wrap(
    witness: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    x: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    { status: :found, value: x }
}
