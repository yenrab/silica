// Generic half of the staged repro record_tuple_field_then_list_read: a record whose ItemType
// field is followed by a list field, built in a generic unit (the field holds one slot).
export make/2;

fn cons(x: int64, rest: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- prepend[int64, mem(normal)](x, rest)
    produces
        pure out
    end
}

fn nil_list() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure out
    end
}

fn three() -> List[int64, mem(normal)] {
    cons(1, cons(2, cons(3, nil_list())))
}

fn make(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    item: ItemType
) -> { status: :not_found | :found, value: ItemType, path: List[int64, mem(normal)] } {
    p: List[int64, mem(normal)] <- three();
    out: { status: :not_found | :found, value: ItemType, path: List[int64, mem(normal)] } <- { status: :found, value: item, path: p };
    out
}
