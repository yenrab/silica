// Minimal trait module for impl_item_type_return.silica (see its header). Every impl body
// returns an ItemType-valued result it did not build itself: a qualified call into the generic core
// (bare, record-wrapped, tuple-wrapped) and a local helper that takes the collection.

use stub_tree_core;

export trait StubTree;
export root_item/1;
export root_entry/1;
export root_pair/1;
export root_via_helper/1;

required {
    fn root_item(tree: StubTree) -> ItemType;
    fn root_entry(tree: StubTree) -> { status: :not_found | :found, value: ItemType };
    fn root_pair(tree: StubTree) -> (ItemType, int64);
    fn root_via_helper(tree: StubTree) -> ItemType;
}

impl fn root_item(tree: { root: ItemType, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }) -> ItemType {
    stub_tree_core@root_item(tree)
}

impl fn root_entry(tree: { root: ItemType, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }) -> { status: :not_found | :found, value: ItemType } {
    stub_tree_core@root_entry(tree)
}

impl fn root_pair(tree: { root: ItemType, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }) -> (ItemType, int64) {
    stub_tree_core@root_pair(tree)
}

impl fn root_via_helper(tree: { root: ItemType, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }) -> ItemType {
    local_root(tree)
}

fn local_root(tree: { root: ItemType, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }) -> ItemType {
    tree.root
}
