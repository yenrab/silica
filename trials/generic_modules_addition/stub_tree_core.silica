// Minimal generic core for impl_item_type_return.silica (see its header). A tree is the
// record { root: ItemType, compare_item }; compare_item is the ItemType witness of argument one.

export root_item/1;
export root_entry/1;
export root_pair/1;

fn root_item(tree: { root: ItemType, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }) -> ItemType {
    tree.root
}

fn root_entry(tree: { root: ItemType, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }) -> { status: :not_found | :found, value: ItemType } {
    { status: :found, value: tree.root }
}

fn root_pair(tree: { root: ItemType, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater }) -> (ItemType, int64) {
    (tree.root, 1)
}
