// SD-13: comparing a float64 binding with a float literal (`v < 0.0`, `v == 0.0`) is a type
// mismatch (E2003); comparing with a float64 binding that holds the literal works, and the
// literal is fine in arithmetic (`0.0 - v`).
fn main() -> int64 {
    sequence proc[device_io]
        v: float64 <- 0.0 - 2.5;
        neg: boolean <- v < 0.0;
        _: atom <- print_bool(neg);
        println("")
    produces pure 0 end
}
