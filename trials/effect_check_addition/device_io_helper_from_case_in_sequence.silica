// Positive: effectful work stays in sequence proc[device_io] … produces pure … end;
// pure helpers may be chosen from a case arm, then the effect runs in the sequence body.
fn pick_value(flag: boolean) -> int64 {
    case flag of {
        true -> 1;
        false -> 0
    }
}

fn main() -> atom {
    flag: boolean <- true;
    sequence proc[device_io]
        v: int64 <- pick_value(flag);
        result: atom <- print_int64(v)
    produces
        pure result
    end
}
