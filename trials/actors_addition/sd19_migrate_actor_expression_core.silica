// SD-19: migrate_actor(ref, EXPR) with an arithmetic expression as the core argument faults inside
// silica_rt_migrate_actor (the arguments reach the primitive in the wrong registers); a literal or
// a bound name works. Reconstructed from the project-bees S11 spike note (its trials bind the core
// first). Same class as SD-11. Expected: 42 / done
fn handler(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_int64(state + msg);
        println("");
        println("done")
    produces pure (:no_reply, state + msg) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        ref: actor_ref <- spawn(0, handler, stack_policy(0, :keep_last_message));
        i: int64 <- 1;
        _: atom <- migrate_actor(ref, 1 + i % 2);
        _: boolean <- cast(ref, 42 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
