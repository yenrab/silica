// A behaviour's narrow first parameter must survive the calls before it is used. The reply
// buffer behaviour kept boolean messages in the ABI home (X0), where print_string's unit result
// replaced them, so the second print showed 0 instead of the message. §16.1.2 cast.

fn show(v: boolean, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_string("boolean got ");
        _: atom <- print_bool(v);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        w: actor_ref <- spawn(0, show, stack_policy(0, :keep_last_message));
        m: boolean <- true;
        _: boolean <- cast(w, m impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
