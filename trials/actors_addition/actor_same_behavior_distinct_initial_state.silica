// Same behavior, two spawns with different initial state; two call()s then observe both replies (needs X21 spill when X19–X20 hold actor_ref).
// §15.1.1: spawn(initial_state, behavior_fn).

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        low: actor_ref <- spawn(0, acc);
        high: actor_ref <- spawn(100, acc);
        a: int64 <- call(low, 5 impl ActorMessage {});
        b: int64 <- call(high, 5 impl ActorMessage {});
        print_int64(a);
        println("");
        print_int64(b);
        println("")
    produces
        pure :ok
    end
}
