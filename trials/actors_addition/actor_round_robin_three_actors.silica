// Three actors; one call each in order. Replies are printed inside behaviors (avoids many int64 temps in main with three actor_ref).
// §16.1.1: call.

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        print_int64(msg + state);
        println("")
    produces
        pure (:reply, msg + state, msg + state)
    end
}

fn main() -> atom {
    sequence proc[concurrency]
        x: actor_ref <- spawn(0, acc);
        y: actor_ref <- spawn(0, acc);
        z: actor_ref <- spawn(0, acc);
        _: int64 <- call(x, 1 impl ActorMessage {});
        _: int64 <- call(y, 2 impl ActorMessage {});
        _: int64 <- call(z, 3 impl ActorMessage {})
    produces
        pure :ok
    end
}
