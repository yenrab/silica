// Actor whose reply is a function value (same signature); picks same-module fns by message.
fn dbl(x: int64) -> int64 { x + x }
fn inc(x: int64) -> int64 { x + 1 }
fn srv(msg: int64, state: int64) -> (:reply, fn(int64) -> int64, int64) {
    case msg == 0 of {
        true -> (:reply, dbl, state);
        false -> (:reply, inc, state)
    }
}
fn main() -> int64 {
    sequence proc[concurrency]
        w: actor_ref <- spawn(0, srv);
        f0: fn(int64) -> int64 <- call(w, 0 impl ActorMessage {});
        f1: fn(int64) -> int64 <- call(w, 1 impl ActorMessage {});
        a: int64 <- f0(21);
        b: int64 <- f1(9)
    produces pure a + b end
}
