// Several caller actors enqueue synchronous calls to the same victim. The first
// call handled by the victim marks the victim dead; the actor loop must exit
// before servicing the remaining standard mailbox calls, and teardown must wake
// each queued caller with the actor-death result.

fn spin(n: int64) -> int64 {
    case n <= 0 of {
        true -> 0;
        false -> spin(n - 1)
    }
}

fn die_on_first_call(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        _: int64 <- spin(1000);
        me: actor_ref <- self();
        _: atom <- kill_abnormal(me)
    produces
        pure (:reply, msg, state)
    end
}

fn caller(msg: int64, victim: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency, device_io]
        result: int64 <- call(victim, msg impl ActorMessage {});
        print_int64(result);
        println("")
    produces
        pure (:no_reply, victim)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        victim: actor_ref <- spawn(0, die_on_first_call);
        c1: actor_ref <- spawn(victim, caller);
        c2: actor_ref <- spawn(victim, caller);
        c3: actor_ref <- spawn(victim, caller);
        c4: actor_ref <- spawn(victim, caller);
        _: boolean <- cast(c1, 1 impl ActorMessage {});
        _: boolean <- cast(c2, 2 impl ActorMessage {});
        _: boolean <- cast(c3, 3 impl ActorMessage {});
        _: boolean <- cast(c4, 4 impl ActorMessage {});
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
