// migrate_actor(ref, EXPR) with a computed core number. The two-operand actor prims hand the
// runtime X9 and X10; a right operand that is itself computed stages through X9 as well, so the
// actor_ref was overwritten by the core expression and the runtime faulted. The left operand is now
// parked across the right one (term_emit_kind_compound_part3).
// Expected: 42 / done, exit 0.

fn handler(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_int64(state + msg);
        println("");
        println("done")
    produces pure (:no_reply, state + msg) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        ref: actor_ref <- spawn(0, handler, stack_policy(0, :keep_last_message));
        i: int64 <- 1;
        _: atom <- migrate_actor(ref, 1 + i % 2);
        _: boolean <- cast(ref, 42 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
