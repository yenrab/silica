// Spec §15.1.1: two actor_ref values from spawn; each replies independently
fn adder(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, msg + state)
}

fn doubler(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg * 2, state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        a: actor_ref <- spawn(3, adder);
        b: actor_ref <- spawn(9, doubler);
        ra: int64 <- call(a, 1 impl ActorMessage {});
        rb: int64 <- call(b, 5 impl ActorMessage {});
        print_int64(ra + rb);
        println("")
    produces
        pure :ok
    end
}
