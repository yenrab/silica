// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(37.375 > 26.0);
        println("");
        _: atom <- print_bool((5.25 - 31.75) <= 34.25);
        println("");
        _: atom <- print_bool((32.0 - 8.5) > (10.0 + 31.0));
        println("");
        done: atom <- print_bool(29.75 * 37.25 >= (10.5 - 9.25))
    produces pure done end
}
