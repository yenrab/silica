// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((25.0 - 39.25) == 25.0);
        println("");
        _: atom <- print_bool(16.25 <= (13.375 - 26.0));
        println("");
        _: atom <- print_bool(39.25 * 7.0 <= 20.0);
        println("");
        done: atom <- print_bool((28.0 + 11.0) != (29.5 - 17.25))
    produces pure done end
}
