// float64 parameters survive a sequence binding and a call (formerly SD-14, sd14_float_parameter_clobbered).
// b3(1.5, 2.0) printed 4.5 instead of 5.0 (y read as x after the first bind); b4(1.5) printed 4.0
// instead of 3.0 (x overwritten by the call's D0 result). b1 and b2, single expressions, were right.
// Fixed 2026-09-24 with float64_addition/float_let_literal_compare: a float let in a body with
// float parameters now triggers the full parameter shadow (emitter_core@use_full_param_shadow), so
// x and y live in D8/D9 while the lets stage through D0. The compile-time part of the S5 spike note
// -- a float literal in a case arm of a non-main function emitted as `L_f64_-1` -- is
// float64_addition/float_literal_case_scrutinee (fixed the same day); the `MOV X9, D0` for an int64
// comparison inside a float64-returning sequence is not exercised here.
fn two() -> float64 { 2.0 }
fn b1(x: float64) -> float64 {
    x * two()
}
fn b2(x: float64) -> float64 {
    x * 2.0
}
fn b3(x: float64, y: float64) -> float64 {
    sequence
        p: float64 <- x * y;
        q: float64 <- p + y
    produces pure q end
}
fn b4(x: float64) -> float64 {
    sequence
        t: float64 <- two();
        r: float64 <- x * t
    produces pure r end
}
fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- print_float64(b1(1.5));
        println("");
        _: atom <- print_float64(b2(1.5));
        println("");
        _: atom <- print_float64(b3(1.5, 2.0));
        println("");
        _: atom <- print_float64(b4(1.5));
        println("")
    produces pure 0 end
}
