// float64 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(30.0 < (28.0 - 29.0));
        println("");
        _: atom <- print_bool(39.5 > (39.25 + 38.25));
        println("");
        done: atom <- print_bool(11.0 * 32.125 >= 26.5 * 33.125)
        produces pure done end
}
