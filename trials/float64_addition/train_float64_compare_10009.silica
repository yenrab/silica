// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((23.0 + 30.125) <= (15.25 + 35.0));
        println("");
        _: atom <- print_bool(27.125 * 24.25 <= 33.0);
        println("");
        _: atom <- print_bool(25.0 >= (17.0 - 4.0));
        println("");
        done: atom <- print_bool((25.5 - 35.25) != (19.5 - 12.25))
    produces
        pure done
    end
}
