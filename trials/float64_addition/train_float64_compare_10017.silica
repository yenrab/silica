// float64 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(35.0 == 5.5);
        println("");
        _: atom <- print_bool(10.0 * 3.25 == (17.375 + 8.25));
        println("");
        _: atom <- print_bool(2.125 != (38.5 - 18.0));
        println("");
        done: atom <- print_bool(1.75 == (0.5 + 38.0))
        produces pure done end
}
