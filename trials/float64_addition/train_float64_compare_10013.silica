// float64 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((3.5 + 27.0) != (12.5 + 9.0));
        println("");
        _: atom <- print_bool((33.75 + 18.0) > 15.25);
        println("");
        _: atom <- print_bool(11.0 >= 35.5);
        println("");
        done: atom <- print_bool((14.375 + 7.0) == (4.125 + 9.25))
        produces pure done end
}
