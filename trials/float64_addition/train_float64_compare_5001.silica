// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(30.25 > 19.0);
        println("");
        _: atom <- print_bool((18.5 + 1.75) > (18.5 - 41.5));
        println("");
        done: atom <- print_bool(23.5 * 26.5 < 15.0)
    produces pure done end
}
