// A case expression whose arms yield a float64. The fallback arm the emitter appends after the
// arms zeroes the result register; for a float destination that must be `FMOV D0, XZR` (it was
// `MOV D0, #0`, which is not an AArch64 instruction, so the program did not assemble).
fn bigger(a: float64, b: float64) -> float64 {
    case a < b of {
        true -> b;
        false -> a
    }
}

fn main() -> atom {
    sequence proc[device_io] r: atom <- print_float64(bigger(3.25, -8.0) * 4.0) produces pure r end
}
