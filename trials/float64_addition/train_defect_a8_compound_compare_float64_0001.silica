// defect A8: float64 compare with compound operands on both sides (typed through an identity helper)
fn f64(v: float64) -> float64 {
    v
}

fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(f64(3.0) + f64(4.0) > f64(1.0) + f64(1.0));
        println("");
        _: atom <- print_bool((f64(5.5) + f64(29.0)) > (f64(9.375) + f64(18.0)));
        println("");
        done: atom <- print_bool(f64(3.0) * f64(4.0) > f64(1.0) * f64(1.0))
    produces pure done end
}
