// float64 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool((22.0 - 33.25) > 18.375);
        println("");
        _: atom <- print_bool(24.125 * 27.25 <= 9.75);
        println("");
        _: atom <- print_bool(37.25 >= (2.125 + 33.25));
        println("");
        done: atom <- print_bool((1.75 - 3.375) < (14.0 + 3.5))
        produces pure done end
}
