// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((25.5 - 24.0) == (26.75 + 30.5));
        println("");
        _: atom <- print_bool((8.0 - 15.125) <= (41.5 + 33.0));
        println("");
        done: atom <- print_bool((24.75 + 7.0) != 4.0 * 35.0)
    produces pure done end
}
