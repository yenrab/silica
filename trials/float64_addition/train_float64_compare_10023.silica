// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((21.5 - 39.0) > (38.5 - 38.5));
        println("");
        _: atom <- print_bool((0.0 + 30.125) == 6.5);
        println("");
        done: atom <- print_bool((32.0 - 32.75) <= 26.0)
    produces pure done end
}
