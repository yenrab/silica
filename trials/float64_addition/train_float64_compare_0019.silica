// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((35.375 + 6.5) > 19.0);
        println("");
        _: atom <- print_bool(32.75 > (26.25 - 8.25));
        println("");
        done: atom <- print_bool(7.0 <= 13.5 * 0.0)
    produces pure done end
}
