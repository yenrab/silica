// float64 comparisons
fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool((20.0 + 6.25) == (2.25 - 35.25));
        println("");
        _: atom <- print_bool((26.125 - 36.5) >= 33.0);
        println("");
        _: atom <- print_bool(40.0 >= (5.75 + 24.5));
        println("");
        done: atom <- print_bool((3.125 + 3.5) == 14.25)
    produces pure done end
}
