// float64 comparisons
fn main() -> atom {
    sequence proc[device_io] _: atom <- print_bool(22.0 * 29.0 <= (39.0 + 3.0));
        println("");
        _: atom <- print_bool(31.5 > (0.25 + 3.0));
        println("");
        done: atom <- print_bool((2.25 + 19.0) != (10.5 + 27.0))
        produces pure done end
}
