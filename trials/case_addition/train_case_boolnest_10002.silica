// nested boolean cases; (false, false) selects 23
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 75;
            false -> 73
        };
        false -> case b of {
            true -> 46;
            false -> 23
        }
    }
}
