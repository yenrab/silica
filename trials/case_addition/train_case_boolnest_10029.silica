// nested boolean cases; (true, false) selects 2
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 79;
            false -> 2
        };
        false -> case b of {
            true -> 68;
            false -> 52
        }
    }
}
