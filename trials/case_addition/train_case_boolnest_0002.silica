// nested boolean cases; (true, false) selects 81
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 61;
            false -> 81
        };
        false -> case b of {
            true -> 53;
            false -> 40
        }
    }
}
