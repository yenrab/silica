// A binding inside a case brace block. The binding ends with `;` because spec §3.3.4's statement
// production is `pattern "<-" expression ";"`; this trial once had no `;` here and recorded the lenient
// parser that accepted it (E1040 rejects that now). Prints nothing; exits 7.
fn helper(n: int64) -> int64 {
    case n of {
        0 -> 0;
        _: int64 -> {
            x: int64 <- 7;
            x
        }
    }
}

fn main() -> int64 {
    helper(9)
}
