// nested boolean cases; (true, true) selects 33
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 33;
            false -> 65
        };
        false -> case b of {
            true -> 1;
            false -> 17
        }
    }
}
