// nested boolean cases; (false, true) selects 24
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 84;
            false -> 32
        };
        false -> case b of {
            true -> 24;
            false -> 76
        }
    }
}
