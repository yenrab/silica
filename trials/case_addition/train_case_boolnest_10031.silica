// nested boolean cases; (true, false) selects 70
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 89;
            false -> 70
        };
        false -> case b of {
            true -> 13;
            false -> 41
        }
    }
}
