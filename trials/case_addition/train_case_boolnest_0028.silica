// nested boolean cases; (false, true) selects 1
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 0;
            false -> 75
        };
        false -> case b of {
            true -> 1;
            false -> 72
        }
    }
}
