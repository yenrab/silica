// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "other";
    case mode of {
        "trace" -> {
            sequence proc[device_io]
                print_string("trace");
                println("");
                print_int64(2);
                println("")
            produces
                pure :ok
            end
        }
        "silent" -> {
            sequence proc[device_io]
                print_int64(7);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
