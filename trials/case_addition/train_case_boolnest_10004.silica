// nested boolean cases; (true, true) selects 62
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 62;
            false -> 5
        };
        false -> case b of {
            true -> 94;
            false -> 64
        }
    }
}
