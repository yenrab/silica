// nested boolean cases; (false, true) selects 16
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 65;
            false -> 53
        };
        false -> case b of {
            true -> 16;
            false -> 99
        }
    }
}
