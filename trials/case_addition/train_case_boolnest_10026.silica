// nested boolean cases; (true, true) selects 79
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 79;
            false -> 64
        };
        false -> case b of {
            true -> 31;
            false -> 56
        }
    }
}
