// A tuple case pattern whose elements are atom literals and named bindings, `(:ok, n: int64) -> ...`
// (S3.5 tuple_pattern, S4.1.7 tagged tuples). Found 2026-09-18 while fixing the tuple-pattern
// named-binding type-checker defect (supervisors_addition/tuple_pattern_named_binding): the emitter's
// terms/term_case_patterns@emit_tuple_case_elems_check compared only string-literal elements and
// skipped `_`/`_: T`; every other element (atom or integer literal, named binding) was emitted as an
// unconditional `B fail` and a named element was never loaded into its binding, so both tagged arms
// fell through to the wildcard arm (3, 3, 3). Fixed 2026-09-24: atom/int/bool literal elements are
// compared against the tuple slot and named elements are parked in frame slots the way a `bind`
// arm's scrutinee is (emit_tuple_case_pattern_asm). Expected: 15, 2, 3, exit 0.
fn classify(result: (atom, int64)) -> int64 {
    case result of {
        (:ok, n: int64) -> n + 10;
        (:error, _: int64) -> 2;
        _: (atom, int64) -> 3
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- classify((:ok, 5));
        b: int64 <- classify((:error, 0));
        c: int64 <- classify((:other, 1));
        _: atom <- print_int64(a);
        _: atom <- println("");
        _: atom <- print_int64(b);
        _: atom <- println("");
        _: atom <- print_int64(c);
        println("")
    produces
        pure 0
    end
}
