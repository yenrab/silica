fn add_one(x: int64) -> int64 {
    x + 1
}

fn helper(n: int64) -> int64 {
    case n of {
        0 -> 0;
        _: int64 -> do
            node: (int64, int64) <- (n, n);
            (k: int64, _: int64) <- node;
            acc: int64 <- add_one(k);
            acc
        end
    }
}

fn main() -> int64 {
    helper(1)
}
