// nested boolean cases; (false, false) selects 2
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 11;
            false -> 87
        };
        false -> case b of {
            true -> 90;
            false -> 2
        }
    }
}
