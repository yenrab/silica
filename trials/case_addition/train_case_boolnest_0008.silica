// nested boolean cases; (false, true) selects 55
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 94;
            false -> 15
        };
        false -> case b of {
            true -> 55;
            false -> 99
        }
    }
}
