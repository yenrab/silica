// nested boolean cases; (false, false) selects 8
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 41;
            false -> 9
        };
        false -> case b of {
            true -> 65;
            false -> 8
        }
    }
}
