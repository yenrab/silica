// nested boolean cases; (false, true) selects 21
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 37;
            false -> 96
        };
        false -> case b of {
            true -> 21;
            false -> 35
        }
    }
}
