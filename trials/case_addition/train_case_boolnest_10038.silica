// nested boolean cases; (true, false) selects 93
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 90;
            false -> 93
        };
        false -> case b of {
            true -> 20;
            false -> 75
        }
    }
}
