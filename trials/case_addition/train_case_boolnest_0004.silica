// nested boolean cases; (false, false) selects 58
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 26;
            false -> 79
        };
        false -> case b of {
            true -> 34;
            false -> 58
        }
    }
}
