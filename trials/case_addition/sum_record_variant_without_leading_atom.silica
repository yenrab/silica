// A sum holding a record variant beside a tuple variant, `:empty | (:pair, int64, int64) | { x: int64 }`,
// where the record has no leading atom. Every record starts with its shape word (the build-wide
// number of its field names and types, spec §3.7), so the record arm compares that word the way the
// tuple arm compares its tag atom; until 2026-10-02 this was rejected (E2234). Expected: prints 5,
// 42, 0; exits 0.

fn area(s: :empty | (:pair, int64, int64) | { x: int64 }) -> int64 {
    case s of {
        { x: v } -> v;
        (:pair, a: int64, b: int64) -> a * b;
        :empty -> 0
    }
}

fn pair(a: int64, b: int64) -> :empty | (:pair, int64, int64) | { x: int64 } {
    (:pair, a, b)
}

fn point(v: int64) -> :empty | (:pair, int64, int64) | { x: int64 } {
    { x: v }
}

fn nothing() -> :empty | (:pair, int64, int64) | { x: int64 } {
    :empty
}

fn main() -> int64 {
    sequence proc[device_io]
        print_int64(area(point(5)));
        println("");
        print_int64(area(pair(6, 7)));
        println("");
        print_int64(area(nothing()));
        println("")
    produces
        pure 0
    end
}
