// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "verbose";
    case mode of {
        "verbose" -> {
            sequence proc[device_io]
                print_string("verbose");
                println("");
                print_int64(7);
                println("")
            produces
                pure :ok
            end
        }
        "trace" -> {
            sequence proc[device_io]
                print_int64(8);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
