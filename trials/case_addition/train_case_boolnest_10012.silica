// nested boolean cases; (false, true) selects 97
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 27;
            false -> 64
        };
        false -> case b of {
            true -> 97;
            false -> 29
        }
    }
}
