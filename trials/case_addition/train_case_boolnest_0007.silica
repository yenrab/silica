// nested boolean cases; (true, true) selects 91
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 91;
            false -> 94
        };
        false -> case b of {
            true -> 80;
            false -> 55
        }
    }
}
