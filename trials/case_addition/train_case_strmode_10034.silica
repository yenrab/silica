// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "debug";
    case mode of {
        "debug" -> {
            sequence proc[device_io]
                print_string("debug");
                println("");
                print_int64(5);
                println("")
            produces
                pure :ok
            end
        }
        "verbose" -> {
            sequence proc[device_io]
                print_int64(0);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
