// nested boolean cases; (false, false) selects 96
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 52;
            false -> 57
        };
        false -> case b of {
            true -> 29;
            false -> 96
        }
    }
}
