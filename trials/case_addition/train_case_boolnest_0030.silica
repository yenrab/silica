// nested boolean cases; (true, false) selects 56
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 5;
            false -> 56
        };
        false -> case b of {
            true -> 89;
            false -> 43
        }
    }
}
