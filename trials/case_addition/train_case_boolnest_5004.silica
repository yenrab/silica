// nested boolean cases; (true, false) selects 50
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 44;
            false -> 50
        };
        false -> case b of {
            true -> 68;
            false -> 69
        }
    }
}
