// nested boolean cases; (true, true) selects 9
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 9;
            false -> 96
        };
        false -> case b of {
            true -> 4;
            false -> 64
        }
    }
}
