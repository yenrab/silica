// nested boolean cases; (true, false) selects 84
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 70;
            false -> 84
        };
        false -> case b of {
            true -> 86;
            false -> 40
        }
    }
}
