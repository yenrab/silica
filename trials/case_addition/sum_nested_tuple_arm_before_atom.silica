// A sum `:none | (:found, uint32)` nested as the second element of a pair, matched with the nested
// tuple pattern before the nested atom pattern.
// Expected: prints 1, 0; exits 0.

fn present(p: (int64, :none | (:found, uint32))) -> int64 {
    case p of {
        (_: int64, (:found, i: uint32)) -> 1;
        (_: int64, :none) -> 0
    }
}

fn found(v: uint32) -> :none | (:found, uint32) {
    (:found, v)
}

fn absent() -> :none | (:found, uint32) {
    :none
}

fn main() -> int64 {
    sequence proc[device_io]
        seven: uint32 <- 7;
        print_int64(present((1, found(seven))));
        println("");
        print_int64(present((1, absent())));
        println("")
    produces
        pure 0
    end
}
