// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "silent";
    case mode of {
        "verbose" -> {
            sequence proc[device_io]
                print_string("verbose");
                println("");
                print_int64(5);
                println("")
            produces
                pure :ok
            end
        }
        "silent" -> {
            sequence proc[device_io]
                print_int64(1);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
