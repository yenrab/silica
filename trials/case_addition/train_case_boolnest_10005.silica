// nested boolean cases; (true, false) selects 16
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 67;
            false -> 16
        };
        false -> case b of {
            true -> 96;
            false -> 34
        }
    }
}
