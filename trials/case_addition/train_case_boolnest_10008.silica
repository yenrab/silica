// nested boolean cases; (true, true) selects 31
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 31;
            false -> 84
        };
        false -> case b of {
            true -> 67;
            false -> 11
        }
    }
}
