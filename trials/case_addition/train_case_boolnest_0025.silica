// nested boolean cases; (false, false) selects 14
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 40;
            false -> 19
        };
        false -> case b of {
            true -> 98;
            false -> 14
        }
    }
}
