// nested boolean cases; (true, false) selects 72
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 37;
            false -> 72
        };
        false -> case b of {
            true -> 46;
            false -> 4
        }
    }
}
