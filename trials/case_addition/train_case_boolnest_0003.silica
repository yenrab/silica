// nested boolean cases; (true, false) selects 89
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 54;
            false -> 89
        };
        false -> case b of {
            true -> 94;
            false -> 91
        }
    }
}
