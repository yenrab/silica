// nested boolean cases; (false, false) selects 69
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 24;
            false -> 12
        };
        false -> case b of {
            true -> 3;
            false -> 69
        }
    }
}
