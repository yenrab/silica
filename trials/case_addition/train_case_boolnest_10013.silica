// nested boolean cases; (false, false) selects 2
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 79;
            false -> 80
        };
        false -> case b of {
            true -> 1;
            false -> 2
        }
    }
}
