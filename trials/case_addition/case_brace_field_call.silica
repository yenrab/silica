fn helper(
    set: { compare_item: fn(int64, int64) -> :less | :equal | :greater },
    n: int64
) -> int64 {
    case n of {
        0 -> 0;
        _: int64 -> {
            node: (int64, int64) <- (n, n);
            (k: int64, _: int64) <- node;
            cmp_fn_val: fn(int64, int64) -> :less | :equal | :greater <- set.compare_item;
            raw_cmp: :less | :equal | :greater <- cmp_fn_val(k, k);
            case raw_cmp of {
                :equal -> 1;
                _: atom -> 0
            }
        }
    }
}

fn main() -> int64 {
    helper({ compare_item: cmp_fn }, 1)
}

fn cmp_fn(a: int64, b: int64) -> :less | :equal | :greater {
    :equal
}
