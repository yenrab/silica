// nested boolean cases; (false, true) selects 6
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 86;
            false -> 27
        };
        false -> case b of {
            true -> 6;
            false -> 91
        }
    }
}
