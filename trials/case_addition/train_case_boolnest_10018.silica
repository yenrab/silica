// nested boolean cases; (true, true) selects 25
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 25;
            false -> 34
        };
        false -> case b of {
            true -> 27;
            false -> 4
        }
    }
}
