// nested boolean cases; (false, true) selects 74
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 57;
            false -> 55
        };
        false -> case b of {
            true -> 74;
            false -> 94
        }
    }
}
