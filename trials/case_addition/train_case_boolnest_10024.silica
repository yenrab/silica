// nested boolean cases; (false, false) selects 34
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 87;
            false -> 7
        };
        false -> case b of {
            true -> 33;
            false -> 34
        }
    }
}
