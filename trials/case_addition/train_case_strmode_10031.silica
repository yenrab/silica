// string case with an effectful sequence in each arm
fn main() -> atom {
    mode: string <- "other";
    case mode of {
        "verbose" -> {
            sequence proc[device_io]
                print_string("verbose");
                println("");
                print_int64(4);
                println("")
            produces
                pure :ok
            end
        }
        "debug" -> {
            sequence proc[device_io]
                print_int64(6);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
