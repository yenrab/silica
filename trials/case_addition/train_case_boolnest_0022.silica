// nested boolean cases; (false, false) selects 64
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 57;
            false -> 0
        };
        false -> case b of {
            true -> 89;
            false -> 64
        }
    }
}
