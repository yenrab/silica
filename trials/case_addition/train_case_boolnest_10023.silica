// nested boolean cases; (false, false) selects 98
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- false;
    case a of {
        true -> case b of {
            true -> 43;
            false -> 48
        };
        false -> case b of {
            true -> 30;
            false -> 98
        }
    }
}
