// Case scrutinee is a custom function call returning a multi-field record — type inferred from callee.
fn makergb(r0: int64, g0: int64, b0: int64) -> { red: int64, green: int64, blue: int64 } {
    { red: r0, green: g0, blue: b0 }
}

fn main() -> int64 {
    case makergb(1, 2, 3) of {
        _: { red: int64, green: int64, blue: int64 } -> 6
    }
}
