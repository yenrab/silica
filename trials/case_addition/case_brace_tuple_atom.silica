fn cmp_fn(a: int64, b: int64) -> :less | :equal | :greater {
    :equal
}

fn helper(n: int64) -> int64 {
    case n of {
        0 -> 0;
        _: int64 -> {
            node: (int64, int64) <- (n, n);
            (k: int64, _: int64) <- node;
            raw_cmp: :less | :equal | :greater <- cmp_fn(n, k);
            case raw_cmp of {
                :equal -> 1;
                _: atom -> 0
            }
        }
    }
}

fn main() -> int64 {
    helper(1)
}
