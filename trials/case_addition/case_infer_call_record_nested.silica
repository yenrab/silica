// Case scrutinee is a custom function call returning a nested record — type inferred from callee.
fn labeled(n: int64) -> { name: string, pos: { x: int64, y: int64 } } {
    { name: "p", pos: { x: n, y: n + 1 } }
}

fn main() -> int64 {
    case labeled(10) of {
        _: { name: string, pos: { x: int64, y: int64 } } -> 21
    }
}
