// nested boolean cases; (false, true) selects 58
fn main() -> int64 {
    a: boolean <- false;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 25;
            false -> 51
        };
        false -> case b of {
            true -> 58;
            false -> 61
        }
    }
}
