// nested boolean cases; (true, true) selects 99
fn main() -> int64 {
    a: boolean <- true;
    b: boolean <- true;
    case a of {
        true -> case b of {
            true -> 99;
            false -> 86
        };
        false -> case b of {
            true -> 33;
            false -> 91
        }
    }
}
