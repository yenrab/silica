// Documented open type-checker defect (book-verification 2026-09-19, repro ds_map). The
// OrderedMap shape of the defect documented in
// compile_defects_ordered_set_field_annotation_addition (see that README): a record annotation
// with an `OrderedMap[K, V, mem(normal)]`-typed field is rejected even though the plain,
// non-nested binding of the same bracket type is accepted. References the real stdlib
// `wbt_map.silica`/`OrderedMap.silica` by relative path rather than copying them.
// Expected: "apples" inserts into an empty map, `r.inserted` is true, exit 1.
// Observed: E2003 "wbt_map@insert returns {map : {...concrete fields...}, inserted: boolean,
// replaced: boolean}, expected {map: OrderedMap[string, int64, normal], inserted: boolean,
// replaced: boolean}".

use wbt_map;
use OrderedMap;

fn compare_names(a: string, b: string) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_counts(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        m: OrderedMap[string, int64, mem(normal)] <- wbt_map@empty({ compare_key: compare_names, compare_value: compare_counts });
        r: { map: OrderedMap[string, int64, mem(normal)], inserted: boolean, replaced: boolean } <- wbt_map@insert(m, "apples", 3)
    produces
        pure case r.inserted of {
            true -> 1;
            false -> 0
        }
    end
}
