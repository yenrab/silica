// A device worker writes "hi" on UART0 through peek (:status) and poke (:fifo); main only spawns,
// casts and waits (device spec §4.6). The worker shares UART0 with the runtime console, so its bytes
// appear in the program's output. Expected: hi / status 0.
use device_uart_lib;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        u: device_actor_ref <- spawn_device(:unmapped, device_uart_lib@uart_worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device(u, { op: :init, byte: 0 } impl ActorMessage {});
        _: boolean <- cast_device(u, { op: :putc, byte: 104 } impl ActorMessage {});
        _: boolean <- cast_device(u, { op: :putc, byte: 105 } impl ActorMessage {});
        _: boolean <- cast_device(u, { op: :putc, byte: 10 } impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
