// The GPIO matrix as a device worker: window 1 of board_pack.silica at 0x60004000. Only the
// registers these trials touch are described: the bank-0 set/clear words, the output enable set
// word and the input word. The LED is GPIO6 (mask 64) and the Left button GPIO21 (bit 21 of :in,
// idle 0, pressed 1 on the port test board). Every access is inside a sequence proc[register_rwr]
// in this module; the worker maps on :init and keeps the window in its state.
// Messages: { op: :init | :led_on | :led_off | :read_left, reply_to: actor_ref }; :read_left casts
// the button level (0 or 1, int64) to reply_to.
use device_esp32s3_gpio_registers;

export gpio_worker/2;

fn led(w: device_window(L, (:esp32s3_gpio)), on: boolean) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        _: atom <- case on of {
            true -> poke(w, :out_w1ts, 64 impl Register32 {});
            false -> poke(w, :out_w1tc, 64 impl Register32 {})
        }
    produces
        pure w
    end
}

fn enable_led(w: device_window(L, (:esp32s3_gpio))) -> device_window(L, (:esp32s3_gpio)) {
    sequence proc[register_rwr]
        _: atom <- poke(w, :enable_w1ts, 64 impl Register32 {})
    produces
        pure w
    end
}

fn left_level(w: device_window(L, (:esp32s3_gpio))) -> (device_window(L, (:esp32s3_gpio)), int64) {
    sequence proc[register_rwr]
        pads: uint32 <- peek(w, :in) impl Register32 {};
        bit: uint32 <- (pads shr 21) band 1;
        level: int64 <- case bit == 1 of {
            true -> 1;
            false -> 0
        }
    produces
        pure (w, level)
    end
}

fn gpio_worker(msg: { op: atom, reply_to: actor_ref }, state: :unmapped | (:mapped, device_window(L, (:esp32s3_gpio)))) -> (:no_reply, :unmapped | (:mapped, device_window(L, (:esp32s3_gpio)))) {
    sequence proc[register_rwr, concurrency]
        next: :unmapped | (:mapped, device_window(L, (:esp32s3_gpio))) <- case state of {
            :unmapped -> case msg.op of {
                :init -> {
                    w: device_window(L, (:esp32s3_gpio)) <- map_device((:esp32s3_gpio), 0x60004000);
                    (:mapped, enable_led(w))
                };
                _: atom -> :unmapped
            };
            (:mapped, w: device_window(L, (:esp32s3_gpio))) -> case msg.op of {
                :led_on -> (:mapped, led(w, true));
                :led_off -> (:mapped, led(w, false));
                :read_left -> {
                    (w2: device_window(L, (:esp32s3_gpio)), level: int64) <- left_level(w);
                    _: boolean <- cast(msg.reply_to, level impl ActorMessage {});
                    (:mapped, w2)
                };
                _: atom -> (:mapped, w)
            }
        }
    produces
        pure (:no_reply, next)
    end
}
