// The third registry: a device worker registered under a :device_ name is reached only through
// cast_device_registered (device spec §1 "Split registries"). Expected: r / status 0.
use device_uart_lib;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        u: device_actor_ref <- spawn_device_registered(:unmapped, device_uart_lib@uart_worker, :device_uart, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device_registered(:device_uart, { op: :init, byte: 0 } impl ActorMessage {});
        _: boolean <- cast_device_registered(:device_uart, { op: :putc, byte: 114 } impl ActorMessage {});
        _: boolean <- cast_device_registered(:device_uart, { op: :putc, byte: 10 } impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
