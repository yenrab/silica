// 2 prepends after empty; head is 3
fn main() -> int32 {
    sequence proc[mem(normal)]
        xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](31, xs0);
        xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](3, xs1);
        h: int32 <- head[int32, mem(normal)](xs2)
    produces pure h end
}
