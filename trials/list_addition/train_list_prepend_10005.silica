// 4 prepends after empty; length is 4
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](14, xs0);
        xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](32, xs1);
        xs3: List[int32, mem(normal)] <- prepend[int32, mem(normal)](1, xs2);
        xs4: List[int32, mem(normal)] <- prepend[int32, mem(normal)](10, xs3);
        n: int64 <- length[int32, mem(normal)](xs4)
    produces
        pure n
    end
}
