// case on a non-empty list; expect 96
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [37, 19];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 26;
            [h: int64, _: List[int64, mem(normal)]] -> h + 59;
            _: List[int64, mem(normal)] -> 26
        }
    produces
        pure r
    end
}
