// 4 prepends after empty; length is 4
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](28, xs0);
        xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](6, xs1);
        xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](3, xs2);
        xs4: List[int64, mem(normal)] <- prepend[int64, mem(normal)](26, xs3);
        n: int64 <- length[int64, mem(normal)](xs4)
    produces
        pure n
    end
}
