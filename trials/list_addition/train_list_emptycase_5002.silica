// case on a non-empty list; expect 72
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [9, 9, 25];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 51;
            [h: int64, _: List[int64, mem(normal)]] -> h + 63;
            _: List[int64, mem(normal)] -> 51
        }
    produces
        pure r
    end
}
