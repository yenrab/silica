// 1 prepends after empty; head is 34
fn main() -> int64 {
    sequence proc[mem(normal)] xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](34, xs0);
        h: int64 <- head[int64, mem(normal)](xs1)
        produces pure h end
}
