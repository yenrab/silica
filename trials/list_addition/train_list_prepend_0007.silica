// 3 prepends after empty; head is 8
fn main() -> int32 {
    sequence proc[mem(normal)]
        xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](30, xs0);
        xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](34, xs1);
        xs3: List[int32, mem(normal)] <- prepend[int32, mem(normal)](8, xs2);
        h: int32 <- head[int32, mem(normal)](xs3)
    produces pure h end
}
