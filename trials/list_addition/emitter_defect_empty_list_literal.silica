// Documented open code-generation defect (2026-09-18), found while writing the dense graph trials
// (ordered_data_structures/graph_dense_core/gd_universe builds its empty universe with
// empty[int64, mem(normal)]() instead). No .ascomp until it is fixed.
//
// The empty list literal `[]` bound as List[int64, mem(normal)] produces a one-element list: walking
// it counts 1 (its head reads 0). empty[int64, mem(normal)]() gives the empty list.
// Expected (by hand): 0 (the literal's length), 0 (empty[...]()'s length), exit 0.
// Observed: 1, then 0.

fn literal_empty() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- []
    produces
        pure xs
    end
}

fn builtin_empty() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure xs
    end
}

fn count(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs.is_nil of {
        true -> acc;
        false -> count(xs.tail, acc + 1)
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- count(literal_empty(), 0);
        b: int64 <- count(builtin_empty(), 0);
        print_int64(a);
        println("");
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
