// recursive sum_acc over a list; total 63
fn sum_acc(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> acc;
        [h: int64, t: List[int64, mem(normal)]] -> sum_acc(t, acc + h);
        _: List[int64, mem(normal)] -> acc
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [11, 8, 2, 19, 20, 3];
        total: int64 <- sum_acc(xs, 0)
    produces pure total end
}
