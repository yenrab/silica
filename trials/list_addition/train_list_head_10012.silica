// remove_head on [0, 39] gives 1
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [0, 39];
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
        n: int64 <- length[int64, mem(normal)](rest)
    produces
        pure n
    end
}
