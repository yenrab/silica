// 3 prepends after empty; head is 22
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](36, xs0);
        xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](19, xs1);
        xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](22, xs2);
        h: int64 <- head[int64, mem(normal)](xs3)
    produces
        pure h
    end
}
