// remove_head on [32, 35, 33, 14, 39] gives 4
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [32, 35, 33, 14, 39];
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
        n: int64 <- length[int64, mem(normal)](rest)
        produces pure n end
}
