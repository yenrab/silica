// second on [28, 7, 40, 15] gives 7
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [28, 7, 40, 15];
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
        second: int64 <- head[int64, mem(normal)](rest)
        produces pure second end
}
