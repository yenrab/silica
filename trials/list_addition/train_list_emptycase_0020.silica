// case on a non-empty list; expect 97
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [24];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 7;
            [h: int64, _: List[int64, mem(normal)]] -> h + 73;
            _: List[int64, mem(normal)] -> 7
        }
    produces
        pure r
    end
}
