// case on a non-empty list; expect 107
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [36, 22];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 67;
            [h: int64, _: List[int64, mem(normal)]] -> h + 71;
            _: List[int64, mem(normal)] -> 67
        }
    produces
        pure r
    end
}
