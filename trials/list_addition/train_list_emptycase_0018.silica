// case on a non-empty list; expect 18
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [7, 10];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 35;
            [h: int64, _: List[int64, mem(normal)]] -> h + 11;
            _: List[int64, mem(normal)] -> 35
        }
    produces
        pure r
    end
}
