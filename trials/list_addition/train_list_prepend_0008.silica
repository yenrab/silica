// 4 prepends after empty; head is 6
fn main() -> int64 {
    sequence proc[mem(normal)] xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](13, xs0);
        xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](34, xs1);
        xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](39, xs2);
        xs4: List[int64, mem(normal)] <- prepend[int64, mem(normal)](6, xs3);
        h: int64 <- head[int64, mem(normal)](xs4)
        produces pure h end
}
