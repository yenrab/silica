// case on an empty list; expect 40
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 40;
            [h: int64, _: List[int64, mem(normal)]] -> h + 59;
            _: List[int64, mem(normal)] -> 40
        }
    produces
        pure r
    end
}
