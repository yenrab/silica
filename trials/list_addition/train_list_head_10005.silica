// second on [4, 27, 5, 2, 32] gives 27
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [4, 27, 5, 2, 32];
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
        second: int64 <- head[int64, mem(normal)](rest)
    produces
        pure second
    end
}
