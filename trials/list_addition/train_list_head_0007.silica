// remove_head on [40, 38, 25, 33] gives 3
fn main() -> int64 {
    sequence proc[mem(normal)] xs: List[int64, mem(normal)] <- [40, 38, 25, 33];
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](xs);
        n: int64 <- length[int64, mem(normal)](rest)
        produces pure n end
}
