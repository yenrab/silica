// case on a non-empty list; expect 32
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [13, 35];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 75;
            [h: int64, _: List[int64, mem(normal)]] -> h + 19;
            _: List[int64, mem(normal)] -> 75
        }
    produces
        pure r
    end
}
