// 3 prepends after empty; length is 3
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        xs1: List[int32, mem(normal)] <- prepend[int32, mem(normal)](22, xs0);
        xs2: List[int32, mem(normal)] <- prepend[int32, mem(normal)](36, xs1);
        xs3: List[int32, mem(normal)] <- prepend[int32, mem(normal)](25, xs2);
        n: int64 <- length[int32, mem(normal)](xs3)
    produces
        pure n
    end
}
