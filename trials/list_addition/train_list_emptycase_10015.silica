// case on a non-empty list; expect 72
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [18];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 5;
            [h: int64, _: List[int64, mem(normal)]] -> h + 54;
            _: List[int64, mem(normal)] -> 5
        }
    produces
        pure r
    end
}
