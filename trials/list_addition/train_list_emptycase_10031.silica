// case on a non-empty list; expect 119
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [30, 7, 10];
        r: int64 <- case xs of {
            []: List[int64, mem(normal)] -> 94;
            [h: int64, _: List[int64, mem(normal)]] -> h + 89;
            _: List[int64, mem(normal)] -> 94
        }
    produces
        pure r
    end
}
