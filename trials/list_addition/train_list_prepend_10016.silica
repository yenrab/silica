// 3 prepends after empty; length is 3
fn main() -> int64 {
    sequence proc[mem(normal)]
        xs0: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        xs1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](35, xs0);
        xs2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](17, xs1);
        xs3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](17, xs2);
        n: int64 <- length[int64, mem(normal)](xs3)
    produces
        pure n
    end
}
