// §15.4.5.5: list_at with an index at or past the end of the list is a failed runtime check, which is a
// runtime abort: the report "[silica] abort: list index out of range at 0x<pc>" (plus " in
// <symbol>+0x<offset>" where the target can name the address) on stderr, and exit status 71. Until
// 2026-09-19 this path called C abort(): status 134 and no report.
// The index reaches list_at through a parameter, so nothing is known about it at compile time. The
// first call is in range and prints 9; the second is one past the end, and nothing after it runs.
// compare_scout_normalized.sh folds everything after " at " to <PTR>.

fn pick(i: int64) -> int64 {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [7, 8, 9];
        v: int64 <- list_at[int64, mem(normal)](xs, i)
    produces
        pure v
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        a: int64 <- pick(2);
        print_int64(a);
        println("");
        b: int64 <- pick(3);
        print_int64(b);
        println("")
    produces
        pure 0
    end
}
