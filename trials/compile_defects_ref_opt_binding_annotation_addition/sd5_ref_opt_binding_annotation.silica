// SD-5: ref?(L, normal, rec) is not accepted as the type annotation of a sequence binding
// (E1040 "expected ';' after this statement"; with the tuple type spelled out, E1069). The same
// type is accepted for parameters, return types, record fields and tuple patterns. Workaround:
// bind the value through a function whose return type is ref?(L, normal, rec), or through a
// record field.
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        cell: ref?(L, normal, rec) <- alloc_rec(r, (:ok, 1, :none));
        n: int64 <- case cell of { :none -> 0; _: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> 1 }
    produces pure n end
}
