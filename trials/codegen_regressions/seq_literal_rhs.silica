// Sequence binding RHS `<- 7` then `produces` with no semicolon. Newlines are
// lexer whitespace, so those tokens are adjacent. Constraint propagate used to
// empty the literal's roles (produces was only allowed after `sequence` / `]`);
// selfhost `slot_role` then faulted on `.head` of that empty list. Want 7.

fn main() -> int64 {
    sequence
        result: int64 <- 7
    produces
        pure result
    end
}
