// A tuple literal whose first element is a tuple-returning call, built in a function that has no
// sret buffer of its own. The call SUBs its own caller sret slab and the post-BLR ADD is 0 (a
// let-bound call pops it at let-end, an element has no let), so the remaining elements were stored
// through an SP sitting inside that slab and the tuple's ADD popped less than it pushed: main
// returned on a wrong SP and the program hung. Want 77: 33 + 44.

fn inner() -> (int64, int64) {
    (11, 22)
}

fn main() -> int64 {
    t: ((int64, int64), int64, int64) <- (inner(), 33, 44);
    (_: (int64, int64), b: int64, c: int64) <- t;
    b + c
}
