// SD-12: a self-call in tail position is compiled as BL, not a jump, so a 20,000,000-iteration
// accumulator loop overflows a 256 MB stack ("[silica] fault ... in tail_loop"). The design
// document sir_recursion_strategy.md says tail recursion costs no stack. Every BEAM loop is
// recursion, so a dispatch's loop length is bounded by the actor's stack until this is fixed.
fn loop(i: int64, acc: int64) -> int64 {
    case i == 0 of {
        true -> acc;
        false -> loop(i - 1, acc + (i % 7))
    }
}
fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(loop(20000000, 0));
        println("")
    produces pure 0 end
}
