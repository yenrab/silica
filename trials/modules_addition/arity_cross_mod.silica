// False-positive guard for qualified cross-module arity checking: a `module@fn`
// call with exactly the declared number of arguments must compile, link and run.
// The matching negative case lives in
// error_enforcement_addition/qualified_call_wrong_arg_count_trial.
//
// Every existing *_wrong_arg_count trial covers a BUILTIN (actor primitives);
// nothing covered a user-defined function reached through a module qualifier.
// Want 0 (6 - 6).
use lib_arity;

fn main() -> int64 {
    s: int64 <- lib_arity@add3(1, 2, 3);
    s - 6
}
