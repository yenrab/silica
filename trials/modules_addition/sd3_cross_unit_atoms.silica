// SD-3: atom tables are per compilation unit. Each unit numbers its own atoms from 23 by first
// appearance and emits the number as an immediate, so an atom minted in unit A is a different atom
// in unit B and in this unit. Spec §4.1.7 (normative): one program-wide table, "an atom has the
// same index in every compilation unit". Reconstructed from the project-bees S2 spike note
// (trials/s02_cross_unit_atoms as committed passes only under the D30 workaround).
// Expected: 3 1 2 / true / mango / true true
use sd3_atom_a;
use sd3_atom_b;

fn main() -> int64 {
    sequence proc[device_io]
        m: atom <- sd3_atom_a@mint_mango();
        z: atom <- sd3_atom_a@mint_zebra();
        a: atom <- sd3_atom_a@mint_apple();
        _: atom <- print_int64(sd3_atom_b@classify(z));
        print_string(" ");
        _: atom <- print_int64(sd3_atom_b@classify(a));
        print_string(" ");
        _: atom <- print_int64(sd3_atom_b@classify(m));
        println("");
        _: atom <- print_bool(sd3_atom_b@is_mango(m));
        println("");
        println(sd3_atom_b@spelling(m));
        _: atom <- print_bool(m == :mango);
        print_string(" ");
        _: atom <- print_bool(z == :zebra);
        println("")
    produces pure 0 end
}
