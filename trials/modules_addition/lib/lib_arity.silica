// Callee for the cross-module arity trials. add3 takes exactly three parameters;
// arity_cross_mod.silica calls it correctly, and
// error_enforcement_addition/qualified_call_wrong_arg_count_trial asserts that a
// two-argument call to it is rejected.
export add3/3;

fn add3(a: int64, b: int64, c: int64) -> int64 {
    a + b + c
}
