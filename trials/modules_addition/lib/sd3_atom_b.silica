// SD-3 (unit B): classifies atoms it did not mint; first appearance here: apple, mango, zebra.
export classify/1;
export is_mango/1;
export spelling/1;

fn classify(a: atom) -> int64 {
    case a of { :apple -> 1; :mango -> 2; :zebra -> 3; _: atom -> 0 }
}
fn is_mango(a: atom) -> boolean { a == :mango }
fn spelling(a: atom) -> string {
    case a of { :apple -> "apple"; :mango -> "mango"; :zebra -> "zebra"; _: atom -> "?" }
}
