// Narrow-typed parameters reached through a module qualifier; each caller passes a literal.
export next_u32/1;
export next_u8/1;
export next_u16/1;
export next_i8/1;
export next_i16/1;
export next_i32/1;
export next_u64/1;

fn next_u32(i: uint32) -> uint32 {
    i + 1
}

fn next_u8(i: uint8) -> uint8 {
    i + 1
}

fn next_u16(i: uint16) -> uint16 {
    i + 1
}

fn next_i8(i: int8) -> int8 {
    i + 1
}

fn next_i16(i: int16) -> int16 {
    i + 1
}

fn next_i32(i: int32) -> int32 {
    i + 1
}

fn next_u64(i: uint64) -> uint64 {
    i + 1
}
