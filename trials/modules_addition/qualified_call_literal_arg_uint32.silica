// An integer literal passed to a uint32 parameter through a module-qualified call takes the
// parameter's type, as it does in a same-module call (train_uint32_helper_0001). Until 2026-10-01
// the qualified path compared the literal's inferred int64 with the formal and raised E2003
// (type_checker_expressions_user_call_resolve_infer); decimal and hex literals alike.
// Expected: 17, 33; exits 0.
use literal_param_lib;

fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- print_uint32(literal_param_lib@next_u32(16));
        println("");
        _: atom <- print_uint32(literal_param_lib@next_u32(0x20));
        println("")
    produces
        pure 0
    end
}
