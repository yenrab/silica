// Layer 2 §16 steps 5 and 10 — Brodal–Okasaki queue: primitive find-min and delete-min with
// rank normalization (leaf module). Authority: brodal_okasaki_queue.md §9, §10.
// Delete-min removes the tree with the smallest root, splits that node's digits at child_count,
// reinserts each rank-0 child with a skew insert, melds the positive-rank children (a valid forest
// once reversed) with the remaining roots, then melds the node's deferred forest. O(log n).
// Every exported function whose signature mentions ItemType takes the heap record first: the
// compiler resolves ItemType at a qualified call from the record's compare_item witness.

use brodal_okasaki_node;
use brodal_okasaki_compare;
use brodal_okasaki_link;
use brodal_okasaki_forest;

export remove_min_tree/3;
export delete_min_forest/3;

fn push_existing(
    d: (int64, ref?(L, normal, rec)),
    rest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[(int64, ref?(L, normal, rec)), mem(normal)] <- prepend[(int64, ref?(L, normal, rec)), mem(normal)](d, rest)
    produces
        pure out
    end
}

fn none_digit() -> (int64, ref?(L, normal, rec)) {
    (0, :none)
}

fn digit_item_or(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d: (int64, ref?(L, normal, rec)),
    placeholder: ItemType
) -> ItemType {
    (_: int64, tree: ref?(L, normal, rec)) <- d;
    parts: { present: boolean, item: ItemType, child_count: int64, kids: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- brodal_okasaki_node@read_node(heap, tree, placeholder);
    parts.item
}

// One nested call per argument list: the bootstrap emitter mis-slots arguments when two nested
// calls appear among one call's arguments, so both items are bound first.
fn min_tree_choose(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d: (int64, ref?(L, normal, rec)),
    ts: List[(int64, ref?(L, normal, rec)), mem(normal)],
    inner: { found: boolean, tree: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    placeholder: ItemType
) -> { found: boolean, tree: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)] } {
    sequence
        head_item: ItemType <- digit_item_or(heap, d, placeholder);
        inner_item: ItemType <- digit_item_or(heap, inner.tree, placeholder);
        head_wins: boolean <- brodal_okasaki_compare@le(heap, head_item, inner_item)
    produces
        pure case head_wins of {
            true -> { found: true, tree: d, rest: ts };
            false -> { found: true, tree: inner.tree, rest: push_existing(d, inner.rest) }
        }
    end
}

fn min_tree_step(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d: (int64, ref?(L, normal, rec)),
    ts: List[(int64, ref?(L, normal, rec)), mem(normal)],
    placeholder: ItemType
) -> { found: boolean, tree: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)] } {
    inner: { found: boolean, tree: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- remove_min_tree(heap, ts, placeholder);
    case inner.found of {
        false -> { found: true, tree: d, rest: ts };
        true -> min_tree_choose(heap, d, ts, inner, placeholder)
    }
}

// Splits off the tree with the smallest root; `found = false` on an empty forest.
fn remove_min_tree(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
    placeholder: ItemType
) -> { found: boolean, tree: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)] } {
    case forest of {
        []: List[(int64, ref?(L, normal, rec)), mem(normal)] -> { found: false, tree: none_digit(), rest: forest };
        [d: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)]] -> min_tree_step(heap, d, rest, placeholder)
    }
}

// Walks the first `remaining` digits: positives accumulate reversed (ascending ranks, a valid
// skew forest by the child-order invariant), zeros accumulate for reinsertion.
fn split_children(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    kids: List[(int64, ref?(L, normal, rec)), mem(normal)],
    remaining: int64,
    positives: List[(int64, ref?(L, normal, rec)), mem(normal)],
    zeros: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> { positives: List[(int64, ref?(L, normal, rec)), mem(normal)], zeros: List[(int64, ref?(L, normal, rec)), mem(normal)], deferred: List[(int64, ref?(L, normal, rec)), mem(normal)] } {
    case remaining <= 0 of {
        true -> { positives: positives, zeros: zeros, deferred: kids };
        false -> case kids of {
            []: List[(int64, ref?(L, normal, rec)), mem(normal)] -> { positives: positives, zeros: zeros, deferred: kids };
            [d: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)]] -> case brodal_okasaki_link@digit_rank(d) == 0 of {
                true -> split_children(heap, rest, remaining - 1, positives, push_existing(d, zeros));
                false -> split_children(heap, rest, remaining - 1, push_existing(d, positives), zeros)
            }
        }
    }
}

fn reinsert_zeros(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    zeros: List[(int64, ref?(L, normal, rec)), mem(normal)],
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    case zeros of {
        []: List[(int64, ref?(L, normal, rec)), mem(normal)] -> forest;
        [d: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)]] -> reinsert_zeros(heap, rest, brodal_okasaki_forest@insert_tree0(heap, d, forest))
    }
}

fn delete_min_node(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    parts: { present: boolean, item: ItemType, child_count: int64, kids: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    rest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> { found: boolean, item: ItemType, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } {
    sequence
        none: List[(int64, ref?(L, normal, rec)), mem(normal)] <- brodal_okasaki_node@empty_forest();
        split: { positives: List[(int64, ref?(L, normal, rec)), mem(normal)], zeros: List[(int64, ref?(L, normal, rec)), mem(normal)], deferred: List[(int64, ref?(L, normal, rec)), mem(normal)] } <-
            split_children(heap, parts.kids, parts.child_count, none, none);
        with_children: List[(int64, ref?(L, normal, rec)), mem(normal)] <- brodal_okasaki_forest@merge(heap, split.positives, rest);
        with_zeros: List[(int64, ref?(L, normal, rec)), mem(normal)] <- reinsert_zeros(heap, split.zeros, with_children);
        merged: List[(int64, ref?(L, normal, rec)), mem(normal)] <- brodal_okasaki_forest@merge(heap, split.deferred, with_zeros)
    produces
        pure { found: true, item: parts.item, forest: merged }
    end
}

fn delete_min_found(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    removed: { found: boolean, tree: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)] },
    placeholder: ItemType
) -> { found: boolean, item: ItemType, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } {
    (_: int64, tree: ref?(L, normal, rec)) <- removed.tree;
    parts: { present: boolean, item: ItemType, child_count: int64, kids: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- brodal_okasaki_node@read_node(heap, tree, placeholder);
    case parts.present of {
        false -> { found: false, item: placeholder, forest: removed.rest };
        true -> delete_min_node(heap, parts, removed.rest)
    }
}

// Primitive delete-min: returns the removed root's minimum and the normalized forest that holds
// everything else (children, reinserted zeros, and the removed node's deferred forest).
fn delete_min_forest(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)],
    placeholder: ItemType
) -> { found: boolean, item: ItemType, forest: List[(int64, ref?(L, normal, rec)), mem(normal)] } {
    removed: { found: boolean, tree: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)] } <- remove_min_tree(heap, forest, placeholder);
    case removed.found of {
        false -> { found: false, item: placeholder, forest: forest };
        true -> delete_min_found(heap, removed, placeholder)
    }
}
