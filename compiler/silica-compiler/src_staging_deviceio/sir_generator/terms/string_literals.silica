// String literal expression to SIR term (Expr kind 8, extension)
// Per language spec §2.2: string_literal ::= "\"" {character | escape_sequence} "\""
// Lexer produces string_literal token; parser builds Expr { kind: 8, value: lexeme }
// SIR: const(string, content) — content is lexeme with quotes stripped and escapes resolved
// Strings are UTF-8 (Unicode) per spec §2.1

use parser_ast;
use type_checker_core;
use sir_ast;
use types;
use string_escapes;

export expr_to_sir/2;

// Strip surrounding double quotes from lexeme. Lexeme is "\"content\"" from lexer.
fn string_content(lexeme: string) -> string {
    case len(lexeme) >= 2 of {
        true -> substring(lexeme, 1, len(lexeme) - 1);
        false -> lexeme
    }
}

// Build SIR const term for string literal (Expr kind 8)
fn expr_to_sir(context: TypeContext, expr: Expr) -> SIRTerm {
    raw_content: string <- string_content(expr.value);
    content: string <- string_escapes@resolve_string_escapes(raw_content);
    sir_type: string <- types@type_name_to_sir("string");
    SIRTerm { kind: 0, type_name: sir_type, value: content, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}
