# Makefile for Silica lowering cleanup modules (compiled by parent src/Makefile)
.DEFAULT_GOAL := all
.PHONY: all clean help

all:
	@echo "✅ lowering_cleanup modules (compiled by parent)"

clean:
	@echo "lowering_cleanup clean (handled by parent)"

help:
	@echo "lowering_cleanup modules are compiled by parent src/Makefile"
