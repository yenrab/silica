// String call and literal type checking (print_string, string literal)

use type_checker_core;

export check_print_string_result_type/3;
export check_string_literal/3;
export check_concatenate_call/5;
export check_substring_call/5;
export check_substring_until_char_call/5;
export check_length_bytes_call/4;
export check_length_chars_call/4;
export check_string_predicate_call/5;
export check_read_lines_call/4;
export check_file_exists_call/4;
export check_delete_file_call/4;
export check_append_file_call/5;

fn check_int64_or_discard_result(context: TypeContext, expected_type: int64, expr: Expr, builtin_label: string) -> TypeCheckResult {
    case type_checker_core@type_id_eq_or_discard(context, expected_type, type_checker_core@context_tid_int64(context)) of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2003", expr.location, concat(builtin_label, concat(" returns int64, got expected type ", type_checker_core@type_id_to_surface(context, expected_type))), "sect6")
    }
}

fn check_string_or_discard_result(context: TypeContext, expected_type: int64, expr: Expr, builtin_label: string) -> TypeCheckResult {
    case type_checker_core@type_id_eq_or_discard(context, expected_type, type_checker_core@context_tid_string(context)) of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2003", expr.location, concat(builtin_label, concat(" returns string, got expected type ", type_checker_core@type_id_to_surface(context, expected_type))), "sect6")
    }
}

fn check_bool_or_discard_result(context: TypeContext, expected_type: int64, expr: Expr, builtin_label: string, spec: string) -> TypeCheckResult {
    case type_checker_core@type_id_eq_or_discard(context, expected_type, type_checker_core@context_tid_boolean(context)) of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2003", expr.location, concat(builtin_label, concat(" returns boolean, got expected type ", type_checker_core@type_id_to_surface(context, expected_type))), spec)
    }
}

fn check_atom_or_discard_result(context: TypeContext, expected_type: int64, location: SourceLocation, label: string) -> TypeCheckResult {
    case type_checker_core@type_id_eq_or_discard(context, expected_type, type_checker_core@context_tid_atom(context)) of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2003", location, concat(label, concat(" expects atom result, got ", type_checker_core@type_id_to_surface(context, expected_type))), "sect6")
    }
}

// print_string(string) -> atom. Validates expected_type is atom or discard.
fn check_print_string_result_type(context: TypeContext, expected_type: int64, location: SourceLocation) -> TypeCheckResult {
    check_atom_or_discard_result(context, expected_type, location, "print_string")
}

fn check_length_bytes_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> check_int64_or_discard_result(context, expected_type, expr, "length_bytes")
    }
}

fn check_length_chars_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> check_int64_or_discard_result(context, expected_type, expr, "length_chars")
    }
}

fn check_concatenate_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult, arg2_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case arg2_result.is_ok of {
            false -> arg2_result;
            true -> check_string_or_discard_result(context, expected_type, expr, "concatenate/2")
        }
    }
}

fn check_substring_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult, arg2_result: TypeCheckResult, arg3_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case arg2_result.is_ok of {
            false -> arg2_result;
            true -> case arg3_result.is_ok of {
                false -> arg3_result;
                true -> check_string_or_discard_result(context, expected_type, expr, "substring")
            }
        }
    }
}

fn check_substring_until_char_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult, arg2_result: TypeCheckResult, arg3_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case arg2_result.is_ok of {
            false -> arg2_result;
            true -> case arg3_result.is_ok of {
                false -> arg3_result;
                true -> check_string_or_discard_result(context, expected_type, expr, "substring_until_char")
            }
        }
    }
}

fn check_string_predicate_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult, arg2_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case arg2_result.is_ok of {
            false -> arg2_result;
            true -> check_bool_or_discard_result(context, expected_type, expr, expr.name, "sect5.3.3")
        }
    }
}

fn check_read_lines_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> check_string_or_discard_result(context, expected_type, expr, "read_lines")
    }
}

fn check_file_exists_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> check_bool_or_discard_result(context, expected_type, expr, "file_exists", "sect6")
    }
}

fn check_delete_file_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case type_checker_core@type_id_eq_or_discard(context, expected_type, type_checker_core@context_tid_boolean(context)) of {
            true -> type_checker_core@type_check_ok();
            false -> case type_checker_core@type_id_eq_or_discard(context, expected_type, type_checker_core@context_tid_atom(context)) of {
                true -> type_checker_core@type_check_ok();
                false -> case type_checker_core@type_id_is_discard(context, expected_type) of {
                    true -> type_checker_core@type_check_ok();
                    false -> type_checker_core@type_check_err("E2003", expr.location, concat("delete_file returns bool, got expected type ", type_checker_core@type_id_to_surface(context, expected_type)), "sect6")
                }
            }
        }
    }
}

fn check_append_file_call(expr: Expr, expected_type: int64, context: TypeContext, arg1_result: TypeCheckResult, arg2_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case arg2_result.is_ok of {
            false -> arg2_result;
            true -> check_bool_or_discard_result(context, expected_type, expr, "append_file", "sect6")
        }
    }
}

fn check_string_literal(expr: Expr, expected_type: int64, context: TypeContext) -> TypeCheckResult {
    case type_checker_core@type_id_eq_or_discard(context, expected_type, type_checker_core@context_tid_string(context)) of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2001", expr.location, concat("string literal requires string type, got ", type_checker_core@type_id_to_surface(context, expected_type)), "sect6")
    }
}
