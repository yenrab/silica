// Type checker core - TypeContext, TypeCheckResult, symbol table
// Shared by type checker capabilities and runner
// Phase 2: symbol rows carry interned type_id (int64); type_name kept for diagnostics.

use parser_ast;
use instantiated_fn_name;
use lexer_core;
use type_interner;

export TypeContext/0;
export ParamConcreteEnv/0;
export add_params_concrete_loop1/1;
export TypeCheckResult/0;
export TypeCheckWithContext/0;
export SymbolEntry/0;
export ListSymbolEntry/0;
export create_type_context/0;
export add_symbol/5;
export add_effect_alias_symbol/3;
export lookup_symbol/2;
export lookup_symbol_found/2;
export lookup_symbol_source_module/2;
export lookup_function_for_call/2;
export lookup_function_type_for_call/2;
export call_name_is_module_qualified/1;
export split_module_qualified_call_name/1;
export user_call_base_function_name/1;
export type_check_ok/0;
export type_check_err/5;
export empty_symbol_table/0;
export type_context_with_env/2;
export type_context_with_interner/2;
export type_context_with_supervisor_types/2;
export lookup_supervisor_csv/1;
export type_name_in_supervisor_csv/2;
export types_equal_type_ids/2;
export type_id_to_surface/2;
export TypeContextParseOutcome/0;
export context_parse_type/2;
export context_require_type/2;
export context_surfaces_equal/3;
export context_surface_matches_type_id/3;
export invalid_type_id/0;
export context_tid_int64/1;
export context_tid_boolean/1;
export context_tid_string/1;
export context_tid_discard/1;
export context_tid_atom/1;
export context_tid_uint64/1;
export context_tid_float32/1;
export context_tid_float16/1;
export context_tid_char/1;
export context_tid_actor_ref/1;
export context_tid_supervisor_ref/1;
export context_tid_monitor_ref/1;
export context_tid_list_int64_normal/1;
export type_id_is_discard/2;
export type_id_eq_or_discard/3;
export type_id_is_integer_kind/2;
export type_id_is_float_kind/2;
export type_id_accepts_numeric_literal/2;
export lookup_symbol_type_id/2;
export lookup_symbol_type_id_found/2;

// Symbol table: name -> type_id + surface type_name, declared_effects
struct SymbolEntry {
    name: string,
    type_name: string,
    type_id: int64,
    declared_effects: ListEffectName,
    is_effect_alias: bool,
    source_module: string
}

struct ListSymbolEntry {
    is_nil: bool,
    head: SymbolEntry,
    tail: ListSymbolEntry
}

struct TypeContext {
    env: ListSymbolEntry,
    interner: TypeInterner
}

struct TypeContextParseOutcome {
    context: TypeContext,
    type_id: int64,
    ok: bool
}

struct ParamConcreteEnv {
    decl_params: ListParam,
    concrete_types: ListParam,
    base: TypeContext
}

fn invalid_type_id() -> int64 {
    type_interner@invalid_type_id()
}

fn type_context_env(ctx: TypeContext) -> ListSymbolEntry {
    ctx.env
}

fn type_context_interner(ctx: TypeContext) -> TypeInterner {
    ctx.interner
}

fn type_context_make(env: ListSymbolEntry, interner: TypeInterner) -> TypeContext {
    TypeContext { env: env, interner: interner }
}

fn prepend_symbol_entry(env: ListSymbolEntry, entry: SymbolEntry) -> ListSymbolEntry {
    ListSymbolEntry { is_nil: false, head: entry, tail: env }
}

fn symbol_entry_make(name: string, type_name: string, type_id: int64, declared_effects: ListEffectName, is_effect_alias: bool, source_module: string) -> SymbolEntry {
    SymbolEntry { name: name, type_name: type_name, type_id: type_id, declared_effects: declared_effects, is_effect_alias: is_effect_alias, source_module: source_module }
}

fn types_equal_type_ids(a: int64, b: int64) -> bool {
    a == b
}

fn type_id_to_surface(ctx: TypeContext, type_id: int64) -> string {
    type_interner@print_type(type_context_interner(ctx), type_id)
}

fn context_parse_type(ctx: TypeContext, surface: string) -> TypeContextParseOutcome {
    pr: TypeInternParseResult <- type_interner@parse_type(type_context_interner(ctx), surface);
    ctx2: TypeContext <- type_context_make(type_context_env(ctx), type_interner@parse_result_interner(pr));
    case type_interner@parse_result_ok(pr) of {
        true -> TypeContextParseOutcome { context: ctx2, type_id: type_interner@parse_result_id(pr), ok: true };
        false -> TypeContextParseOutcome { context: ctx2, type_id: invalid_type_id(), ok: false }
    }
}

fn context_require_type(ctx: TypeContext, surface: string) -> TypeContextParseOutcome {
    context_parse_type(ctx, surface)
}

fn context_surfaces_equal(ctx: TypeContext, a: string, b: string) -> bool {
    case a == b of {
        true -> true;
        false -> do
            pa: TypeContextParseOutcome <- context_parse_type(ctx, a);
            case pa.ok of {
                false -> false;
                true -> do
                    pb: TypeContextParseOutcome <- context_parse_type(pa.context, b);
                    case pb.ok of {
                        false -> false;
                        true -> types_equal_type_ids(pa.type_id, pb.type_id)
                    }
                end
            }
        end
    }
}

fn context_surface_matches_type_id(ctx: TypeContext, surface: string, expected_type: int64) -> bool {
    pa: TypeContextParseOutcome <- context_parse_type(ctx, surface);
    case pa.ok of {
        false -> false;
        true -> types_equal_type_ids(pa.type_id, expected_type)
    }
}

fn prim_tid(ctx: TypeContext, kind: int64) -> int64 {
    r: { interner: TypeInterner, id: int64 } <- type_interner@mk_prim(type_context_interner(ctx), kind);
    r.id
}

fn context_tid_int64(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_int64()) }
fn context_tid_boolean(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_boolean()) }
fn context_tid_string(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_string()) }
fn context_tid_discard(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_discard()) }
fn context_tid_atom(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_atom()) }
fn context_tid_uint64(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_uint64()) }
fn context_tid_float32(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_float32()) }
fn context_tid_float16(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_float16()) }
fn context_tid_char(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_char()) }
fn context_tid_actor_ref(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_actor_ref()) }
fn context_tid_supervisor_ref(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_supervisor_ref()) }
fn context_tid_monitor_ref(ctx: TypeContext) -> int64 { prim_tid(ctx, type_interner@kind_monitor_ref()) }
fn context_tid_list_int64_normal(ctx: TypeContext) -> int64 {
    // Best-effort: parse surface for List[int64, mem(normal)]
    pa: TypeContextParseOutcome <- context_parse_type(ctx, "List[int64, mem(normal)]");
    case pa.ok of {
        true -> pa.type_id;
        false -> invalid_type_id()
    }
}

fn type_id_is_discard(ctx: TypeContext, type_id: int64) -> bool {
    types_equal_type_ids(type_id, context_tid_discard(ctx))
}

fn type_id_eq_or_discard(ctx: TypeContext, type_id: int64, target_id: int64) -> bool {
    case types_equal_type_ids(type_id, target_id) of {
        true -> true;
        false -> type_id_is_discard(ctx, type_id)
    }
}

fn type_id_is_integer_kind(ctx: TypeContext, type_id: int64) -> bool {
    k: int64 <- type_interner@node_kind(type_context_interner(ctx), type_id);
    k == type_interner@kind_int8() or k == type_interner@kind_int16() or k == type_interner@kind_int32() or k == type_interner@kind_int64() or k == type_interner@kind_uint8() or k == type_interner@kind_uint16() or k == type_interner@kind_uint32() or k == type_interner@kind_uint64()
}

fn type_id_is_float_kind(ctx: TypeContext, type_id: int64) -> bool {
    k: int64 <- type_interner@node_kind(type_context_interner(ctx), type_id);
    k == type_interner@kind_float16() or k == type_interner@kind_float32() or k == type_interner@kind_float64()
}

fn type_id_accepts_numeric_literal(ctx: TypeContext, type_id: int64) -> bool {
    case type_id_is_discard(ctx, type_id) of {
        true -> true;
        false -> case type_id_is_integer_kind(ctx, type_id) of {
            true -> true;
            false -> case type_id_is_float_kind(ctx, type_id) of {
                true -> true;
                false -> type_id_eq_or_discard(ctx, type_id, context_tid_atom(ctx)) or type_id_eq_or_discard(ctx, type_id, context_tid_char(ctx)) or type_id_eq_or_discard(ctx, type_id, context_tid_string(ctx))
            }
        }
    }
}

fn add_params_concrete_loop1(st: ParamConcreteEnv) -> TypeContext {
    case st.decl_params.is_nil of {
        true -> st.base;
        false -> case st.concrete_types.is_nil of {
            true -> st.base;
            false -> do
                ctx2: TypeContext <- add_symbol(st.base, st.decl_params.head.name, st.concrete_types.head.type_name, parser_ast@empty_effect_name_list(), "");
                add_params_concrete_loop1(ParamConcreteEnv {
                    decl_params: st.decl_params.tail,
                    concrete_types: st.concrete_types.tail,
                    base: ctx2
                })
            end
        }
    }
}

struct TypeCheckResult {
    is_ok: bool,
    error_code: string,
    error_location: SourceLocation,
    error_message: string,
    spec_section: string
}

// Single return value for callers that cannot tuple-destructure (e.g. main.silica codegen).
struct TypeCheckWithContext {
    result: TypeCheckResult,
    context: TypeContext
}

// Flat copy of type-check outcome for main.silica: nested TypeCheckWithContext return could SIGSEGV
// after deep module type-check (bootstrap sret/stack); one struct level + scalar fields avoids that path.
struct ModuleTypecheckOutcome {
    is_ok: bool,
    error_code: string,
    error_location: SourceLocation,
    error_message: string,
    spec_section: string,
    context: TypeContext
}

export ModuleTypecheckOutcome/0;
export module_typecheck_outcome_from_pair/2;

fn module_typecheck_outcome_from_pair(r: TypeCheckResult, c: TypeContext) -> ModuleTypecheckOutcome {
    ModuleTypecheckOutcome {
        is_ok: r.is_ok,
        error_code: r.error_code,
        error_location: r.error_location,
        error_message: r.error_message,
        spec_section: r.spec_section,
        context: c
    }
}

fn dummy_symbol_entry() -> SymbolEntry {
    SymbolEntry { name: "", type_name: "", type_id: invalid_type_id(), declared_effects: parser_ast@empty_effect_name_list(), is_effect_alias: false, source_module: "" }
}

fn empty_symbol_table() -> ListSymbolEntry {
    nil_placeholder: ListSymbolEntry <- ListSymbolEntry { is_nil: true, head: dummy_symbol_entry(), tail: nil_placeholder };
    nil_placeholder
}

fn create_type_context() -> TypeContext {
    interner: TypeInterner <- type_interner@create_type_interner();
    ctx: TypeContext <- type_context_make(empty_symbol_table(), interner);
    ctx_false: TypeContext <- add_symbol(ctx, "false", "boolean", parser_ast@empty_effect_name_list(), "");
    ctx_both: TypeContext <- add_symbol(ctx_false, "true", "boolean", parser_ast@empty_effect_name_list(), "");
    ctx_both
}

// Replace env (let bindings, params, pattern bindings); preserve interner.
fn type_context_with_env(ctx: TypeContext, new_env: ListSymbolEntry) -> TypeContext {
    type_context_make(new_env, type_context_interner(ctx))
}

// Thread an updated interner without changing env (parse at check sites).
fn type_context_with_interner(ctx: TypeContext, interner: TypeInterner) -> TypeContext {
    type_context_make(type_context_env(ctx), interner)
}

// Phase E e3b: store supervisor CSV as a magic symbol in the env so struct shape stays unchanged.
fn type_context_with_supervisor_types(ctx: TypeContext, csv: string) -> TypeContext {
    add_symbol(ctx, "__silica_e3b_sup_csv", csv, parser_ast@empty_effect_name_list(), "")
}

fn lookup_supervisor_csv(ctx: TypeContext) -> string {
    lookup_symbol(ctx.env, "__silica_e3b_sup_csv")
}

fn csv_contains_loop(csv: string, t: string, i: int64, seg_start: int64) -> bool {
    case i >= len(csv) of {
        true -> substring(csv, seg_start, i) == t;
        false -> case substring(csv, i, i + 1) == "," of {
            true -> case substring(csv, seg_start, i) == t of {
                true -> true;
                false -> csv_contains_loop(csv, t, i + 1, i + 1)
            };
            false -> csv_contains_loop(csv, t, i + 1, seg_start)
        }
    }
}

fn type_name_in_supervisor_csv(t: string, csv: string) -> bool {
    case len(csv) == 0 of {
        true -> false;
        false -> csv_contains_loop(csv, t, 0, 0)
    }
}

fn add_symbol(ctx: TypeContext, name: string, type_name: string, declared_effects: ListEffectName, source_module: string) -> TypeContext {
    pr: TypeInternParseResult <- type_interner@parse_type(type_context_interner(ctx), type_name);
    tid: int64 <- case type_interner@parse_result_ok(pr) of {
        true -> type_interner@parse_result_id(pr);
        false -> invalid_type_id()
    };
    entry: SymbolEntry <- symbol_entry_make(name, type_name, tid, declared_effects, false, source_module);
    new_env: ListSymbolEntry <- prepend_symbol_entry(type_context_env(ctx), entry);
    type_context_make(new_env, type_interner@parse_result_interner(pr))
}

fn add_effect_alias_symbol(ctx: TypeContext, name: string, effects: ListEffectName) -> TypeContext {
    entry: SymbolEntry <- symbol_entry_make(name, "", invalid_type_id(), effects, true, "");
    new_env: ListSymbolEntry <- prepend_symbol_entry(type_context_env(ctx), entry);
    type_context_make(new_env, type_context_interner(ctx))
}

fn lookup_symbol(env: ListSymbolEntry, name: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == name of {
            true -> env.head.type_name;
            false -> lookup_symbol(env.tail, name)
        }
    }
}

fn lookup_symbol_type_id(env: ListSymbolEntry, name: string) -> int64 {
    case env.is_nil of {
        true -> invalid_type_id();
        false -> case env.head.name == name of {
            true -> env.head.type_id;
            false -> lookup_symbol_type_id(env.tail, name)
        }
    }
}

// Returns (found, type_name). Use when string comparison for "" is unreliable.
fn lookup_symbol_found(env: ListSymbolEntry, name: string) -> (bool, string) {
    case env.is_nil of {
        true -> (false, "");
        false -> case env.head.name == name of {
            true -> (true, env.head.type_name);
            false -> lookup_symbol_found(env.tail, name)
        }
    }
}

fn lookup_symbol_type_id_found(env: ListSymbolEntry, name: string) -> (bool, int64) {
    case env.is_nil of {
        true -> (false, invalid_type_id());
        false -> case env.head.name == name of {
            true -> (true, env.head.type_id);
            false -> lookup_symbol_type_id_found(env.tail, name)
        }
    }
}

// Defining Silica module for imported functions (spec §19.3); "" for locals and non-function symbols.
fn lookup_symbol_source_module(env: ListSymbolEntry, name: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == name and env.head.is_effect_alias == false of {
            true -> env.head.source_module;
            false -> lookup_symbol_source_module(env.tail, name)
        }
    }
}

// First index of "@" in s, or -1 (spec §3.3.2 module@function call surface).
fn first_at_in_call_name(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_call_name(s, i + 1)
        }
    }
}

fn call_name_is_module_qualified(composite: string) -> bool {
    first_at_in_call_name(composite, 0) >= 0
}

// ("", name) if unqualified; else (module, function) for module@function.
fn split_module_qualified_call_name(composite: string) -> (string, string) {
    at: int64 <- first_at_in_call_name(composite, 0);
    case at < 0 of {
        true -> ("", composite);
        false -> (substring(composite, 0, at), substring(composite, at + 1, len(composite)))
    }
}

fn user_call_base_function_name(composite: string) -> string {
    at: int64 <- first_at_in_call_name(composite, 0);
    case at < 0 of {
        true -> composite;
        false -> substring(composite, at + 1, len(composite))
    }
}

// String return avoids (bool, string) tuple return ABI issues from proc[DeviceIO] callers (bootstrap on macOS).
fn lookup_fn_type_by_name_and_module(env: ListSymbolEntry, fn_name: string, required_module: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case instantiated_fn_name@decl_name_matches(env.head.name, fn_name) and env.head.is_effect_alias == false of {
            true -> case len(required_module) == 0 of {
                true -> case env.head.source_module == "" of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module(env.tail, fn_name, required_module)
                };
                false -> case env.head.source_module == required_module of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module(env.tail, fn_name, required_module)
                }
            };
            false -> lookup_fn_type_by_name_and_module(env.tail, fn_name, required_module)
        }
    }
}

// Internal helper for callers that need (bool, string); prefer lookup_fn_type_by_name_and_module from proc callers.
fn lookup_fn_by_name_and_module(env: ListSymbolEntry, fn_name: string, required_module: string) -> (bool, string) {
    ft: string <- lookup_fn_type_by_name_and_module(env, fn_name, required_module);
    case len(ft) == 0 of {
        true -> (false, "");
        false -> (true, ft)
    }
}

fn lookup_function_for_call(env: ListSymbolEntry, composite_name: string) -> (bool, string) {
    ft: string <- lookup_function_type_for_call(env, composite_name);
    case len(ft) == 0 of {
        true -> (false, "");
        false -> (true, ft)
    }
}

fn lookup_function_type_for_call(env: ListSymbolEntry, composite_name: string) -> string {
    at: int64 <- first_at_in_call_name(composite_name, 0);
    case at < 0 of {
        true -> lookup_fn_type_by_name_and_module(env, composite_name, "");
        false -> lookup_fn_type_by_name_and_module(env, substring(composite_name, at + 1, len(composite_name)), substring(composite_name, 0, at))
    }
}

fn type_check_ok() -> TypeCheckResult {
    TypeCheckResult { is_ok: true, error_code: "", error_location: parser_ast@zero_location(), error_message: "", spec_section: "" }
}

fn type_check_err(error_code: string, error_location: SourceLocation, error_message: string, spec_section: string) -> TypeCheckResult {
    TypeCheckResult { is_ok: false, error_code: error_code, error_location: error_location, error_message: error_message, spec_section: spec_section }
}
