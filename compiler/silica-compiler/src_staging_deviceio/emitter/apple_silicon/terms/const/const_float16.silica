// float16 const: reuse float32 literal pool (.single), load with LDR Sn, narrow with FCVT Hd, Sn

use sir_ast;
use atom_table;
use int64_literal_pool;
use float64_literal_pool;
use float32_literal_pool;
use reg_conventions;
use var;

export emit_const/7;

fn dest_h_reg(dest: string) -> string {
    case len(dest) > 0 and substring(dest, 0, 1) == "X" of {
        true -> concat("H", substring(dest, 1, len(dest)));
        false -> dest
    }
}

fn emit_const(term: SIRTerm, dest: string, table: AtomTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, outer_reg: string) -> string {
    idx: int64 <- float32_literal_pool@float32_literal_value_to_index(float32_literal_table, term.value);
    label: string <- concat("L_f32_", atom_table@int64_to_decimal_string(idx));
    h_dest: string <- dest_h_reg(dest);
    suf: string <- substring(h_dest, 1, len(h_dest));
    s_tmp: string <- concat("S", suf);
    fpool: string <- var@find_sp_binding(outer_reg, "_fpool");
    ptr_reg: string <- case len(fpool) > 0 of {
        true -> fpool;
        false -> reg_conventions@float_scalar_literal_pool_ptr_reg(h_dest)
    };
    adrp: string <- concat(concat(concat(concat("    ADRP ", ptr_reg), ", "), concat(label, "@PAGE")), "\n");
    ldr: string <- concat(concat(concat(concat(concat(concat("    LDR ", s_tmp), ", ["), ptr_reg), ", "), concat(label, "@PAGEOFF")), "]\n");
    fcvt: string <- concat(concat(concat(concat("    FCVT ", h_dest), ", "), s_tmp), "\n");
    concat(adrp, concat(ldr, fcvt))
}
