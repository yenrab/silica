use sir_ast;

export module_uses_float16_print/1;
export emit_float16_helper_rodata/0;

fn term_has_float16_print(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            4 -> term.name == "main.print_float16";
            2 -> case term_has_float16_print(term.inner) of {
                true -> true;
                false -> term_has_float16_print(term.right_expr)
            };
            6 -> case term_has_float16_print(term.inner) of {
                true -> true;
                false -> term_has_float16_print(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn float16_print_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_float16_print(fns.head.body) of {
            true -> true;
            false -> float16_print_in_functions(fns.tail)
        }
    }
}

fn module_uses_float16_print(sir_module: SIRModule) -> bool {
    float16_print_in_functions(sir_module.functions)
}

fn emit_float16_helper_rodata() -> string {
    ".section __TEXT,__rodata\n.align\t4\nL_pf16_nan_str:\n    .ascii \"nan\"\nL_pf16_inf_str:\n    .ascii \"inf\"\nL_pf16_neg_inf_str:\n    .ascii \"-inf\"\n"
}
