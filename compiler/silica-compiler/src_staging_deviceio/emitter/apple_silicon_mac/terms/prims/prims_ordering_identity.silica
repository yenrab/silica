// Ordering identity prim emission (Layer 1 §7.2).

use sir_ast;

export is_ordering_identity_prim/1;
export emit_prim_op/2;
export module_uses_ordering_identity/1;

fn is_ordering_identity_prim(name: string) -> bool {
    name == "ordering_identity_fresh_env" or name == "ordering_identity_make" or name == "ordering_identity_same" or name == "ordering_identity_bundle_make"
}

fn emit_ordering_identity_fresh_env(dest: string) -> string {
    bl_fresh: string <- "    BL _silica_rt_ordering_env_fresh\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X0");
    concat(bl_fresh, mov_dest)
}

fn emit_ordering_identity_make(dest: string) -> string {
    mov_code: string <- "    MOV X0, X1\n";
    mov_env: string <- "    MOV X1, X2\n";
    bl_make: string <- "    BL _silica_rt_ordering_identity_make\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X0");
    concat(concat(concat(mov_code, mov_env), bl_make), mov_dest)
}

fn emit_ordering_identity_same(dest: string) -> string {
    mov_a: string <- "    MOV X0, X1\n";
    mov_b: string <- "    MOV X1, X2\n";
    bl_same: string <- "    BL _silica_rt_ordering_identity_same\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X0");
    concat(concat(concat(mov_a, mov_b), bl_same), mov_dest)
}

fn emit_ordering_identity_bundle_make(dest: string) -> string {
    mov_fn: string <- "    MOV X0, X1\n";
    mov_orient: string <- "    MOV X1, X2\n";
    bl_make: string <- "    BL _silica_rt_ordering_bundle_make\n";
    mov_dest: string <- concat(concat("    MOV ", dest), ", X0");
    concat(concat(concat(mov_fn, mov_orient), bl_make), mov_dest)
}

fn term_has_ordering_identity_prim(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            6 -> case is_ordering_identity_prim(term.name) of {
                true -> true;
                false -> case term_has_ordering_identity_prim(term.inner) of {
                    true -> true;
                    false -> term_has_ordering_identity_prim(term.right_expr)
                }
            };
            2 -> case term_has_ordering_identity_prim(term.inner) of {
                true -> true;
                false -> term_has_ordering_identity_prim(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn ordering_identity_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_ordering_identity_prim(fns.head.body) of {
            true -> true;
            false -> ordering_identity_in_functions(fns.tail)
        }
    }
}

fn module_uses_ordering_identity(sir_module: SIRModule) -> bool {
    ordering_identity_in_functions(sir_module.functions)
}

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    case term.name of {
        "ordering_identity_fresh_env" -> emit_ordering_identity_fresh_env(dest);
        "ordering_identity_make" -> emit_ordering_identity_make(dest);
        "ordering_identity_same" -> emit_ordering_identity_same(dest);
        "ordering_identity_bundle_make" -> emit_ordering_identity_bundle_make(dest);
        _: string -> concat(concat("    ; unsupported ordering identity prim: ", term.name), "")
    }
}
