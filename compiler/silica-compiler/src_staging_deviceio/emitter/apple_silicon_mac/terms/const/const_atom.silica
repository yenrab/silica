// atom const emission (SIRTerm kind 0, type atom)
// Delegates to const_atoms for MOV dest, #index

use sir_ast;
use atom_table;
use const_atoms;
use int64_literal_pool;
use float64_literal_pool;
use float32_literal_pool;

export emit_const/7;

fn emit_const(term: SIRTerm, dest: string, table: AtomTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, outer_reg: string) -> string {
    _fpool_ctx: int64 <- len(outer_reg);
    case _fpool_ctx >= 0 of {
        true -> const_atoms@emit_atom_const(term, dest, table);
        false -> const_atoms@emit_atom_const(term, dest, table)
    }
}
