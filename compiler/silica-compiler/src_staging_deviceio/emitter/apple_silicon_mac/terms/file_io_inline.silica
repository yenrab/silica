// Inline emission for DeviceIO file intrinsics.
// Path/content args are string pointers (literal or SilicaString); runtime
// silica_*_path helpers accept either representation.
// SilicaResult ABI (aarch64): X0 = success bool, X1 = data pointer.

use emitter_effects;
use sir_ast;

export emit_read_lines_call/2;
export emit_file_exists_call/2;
export emit_delete_file_call/2;
export emit_append_file_call/2;

fn emit_read_lines_call(term: SIRTerm, dest: string) -> string {
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- "    BL _silica_read_file_path\n";
    mov_ret: string <- concat(concat("    MOV ", dest), ", X1\n");
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

fn emit_file_exists_call(term: SIRTerm, dest: string) -> string {
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    // file_exists uses read attempt success flag (bootstrap parity).
    bl_line: string <- "    BL _silica_read_file_path\n";
    mov_ret: string <- concat(concat("    AND ", dest), ", X0, #1\n");
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

