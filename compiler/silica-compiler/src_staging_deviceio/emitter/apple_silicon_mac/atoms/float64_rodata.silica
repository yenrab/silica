// Float64 print: helper rodata only (L_pf64_100, L_pf64_minus for L_pf64_helper).
// print_float64 always uses L_pf64_helper (const: load from L_f64_N, var: arg in D0).

use sir_ast;

export module_uses_float64_print/1;
export emit_float64_helper_rodata/0;

fn term_has_float64_print(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            4 -> term.name == "main.print_float64";
            2 -> case term_has_float64_print(term.inner) of {
                true -> true;
                false -> term_has_float64_print(term.right_expr)
            };
            6 -> case term_has_float64_print(term.inner) of {
                true -> true;
                false -> term_has_float64_print(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn float64_print_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_float64_print(fns.head.body) of {
            true -> true;
            false -> float64_print_in_functions(fns.tail)
        }
    }
}

fn module_uses_float64_print(sir_module: SIRModule) -> bool {
    float64_print_in_functions(sir_module.functions)
}

// L_pf64_10 (.double 10.0), L_pf64_minus (.byte 0x2d, 0) for L_pf64_helper
fn emit_float64_helper_rodata() -> string {
    header: string <- ".section __TEXT,__rodata\n.align\t8\n";
    ten: string <- "L_pf64_10:\n    .double 10.0\n";
    minus: string <- "L_pf64_minus:\n    .byte 0x2d, 0\n";
    concat(concat(concat(header, ten), minus), "")
}
