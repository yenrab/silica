fn term_has_println(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            4 -> case term.name == "main.println" of {
                true -> true;
                false -> case term.name == "main.println_stderr" of {
                    true -> true;
                    false -> term_has_println(term.inner)
                }
            };
            2 -> case term_has_println(term.inner) of {
                true -> true;
                false -> term_has_println(term.right_expr)
            };
            3 -> case term_has_println(term.inner) of {
                true -> true;
                false -> term_has_println(term.right_expr)
            };
            7 -> case term_has_println(term.inner) of {
                true -> true;
                false -> term_has_println(term.right_expr)
            };
            8 -> case term_has_println(term.inner) of {
                true -> true;
                false -> term_has_println(term.right_expr)
            };
            6 -> case term_has_println(term.inner) of {
                true -> true;
                false -> term_has_println(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn println_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_println(fns.head.body) of {
            true -> true;
            false -> println_in_functions(fns.tail)
        }
    }
}

export module_uses_println/1;

fn module_uses_println(sir_module: SIRModule) -> bool {
    println_in_functions(sir_module.functions)
}

// Case branch with string literal pattern (pk == "string") needs L_string_eq_helper: pointer
// compare is wrong when scrutinee is heap/mmap (e.g. substring) vs rodata literal.
fn term_has_string_case_pattern(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            8 -> term.value == "string";
            3 -> case term_has_string_case_pattern(term.inner) of {
                true -> true;
                false -> term_has_string_case_pattern(term.right_expr)
            };
            5 -> case term_has_string_case_pattern(term.inner) of {
                true -> true;
                false -> term_has_string_case_pattern(term.right_expr)
            };
            7 -> case term_has_string_case_pattern(term.inner) of {
                true -> true;
                false -> term_has_string_case_pattern(term.right_expr)
            };
            2 -> case term_has_string_case_pattern(term.inner) of {
                true -> true;
                false -> term_has_string_case_pattern(term.right_expr)
            };
            4 -> case term_has_string_case_pattern(term.inner) of {
                true -> true;
                false -> term_has_string_case_pattern(term.right_expr)
            };
            6 -> case term_has_string_case_pattern(term.inner) of {
                true -> true;
                false -> term_has_string_case_pattern(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn string_case_pattern_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_string_case_pattern(fns.head.body) of {
            true -> true;
            false -> string_case_pattern_in_functions(fns.tail)
        }
    }
}

export module_uses_string_case_pattern/1;

fn module_uses_string_case_pattern(sir_module: SIRModule) -> bool {
    string_case_pattern_in_functions(sir_module.functions)
}

fn is_string_compare_prim_name(name: string) -> bool {
    name == "lt" or name == "gt" or name == "le" or name == "ge" or name == "eq" or name == "nq"
}

// Bool-result compares dispatch on operand type (term.inner); see prims@bool_result_compare_prim.
fn term_is_string_compare_prim(term: SIRTerm) -> bool {
    case term.kind == 6 and is_string_compare_prim_name(term.name) of {
        false -> false;
        true -> case term.type_name == "bool" of {
            true -> term.inner.type_name == "string";
            false -> term.type_name == "string"
        }
    }
}

fn term_has_string_compare(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            6 -> case term_is_string_compare_prim(term) of {
                true -> true;
                false -> case term_has_string_compare(term.inner) of {
                    true -> true;
                    false -> term_has_string_compare(term.right_expr)
                }
            };
            2 -> case term_has_string_compare(term.inner) of {
                true -> true;
                false -> term_has_string_compare(term.right_expr)
            };
            4 -> case term_has_string_compare(term.inner) of {
                true -> true;
                false -> term_has_string_compare(term.right_expr)
            };
            3 -> case term_has_string_compare(term.inner) of {
                true -> true;
                false -> term_has_string_compare(term.right_expr)
            };
            5 -> case term_has_string_compare(term.inner) of {
                true -> true;
                false -> term_has_string_compare(term.right_expr)
            };
            7 -> case term_has_string_compare(term.inner) of {
                true -> true;
                false -> term_has_string_compare(term.right_expr)
            };
            8 -> case term_has_string_compare(term.inner) of {
                true -> true;
                false -> term_has_string_compare(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn string_compare_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_string_compare(fns.head.body) of {
            true -> true;
            false -> string_compare_in_functions(fns.tail)
        }
    }
}

export module_uses_string_compare/1;

fn module_uses_string_compare(sir_module: SIRModule) -> bool {
    string_compare_in_functions(sir_module.functions)
}
