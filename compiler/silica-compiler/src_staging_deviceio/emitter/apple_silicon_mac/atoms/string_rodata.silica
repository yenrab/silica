// String rodata: detect if module uses print_string or println with var arg (needs L_ps_helper).
// String literals themselves are emitted by string_literal_pool.

use sir_ast;

export module_uses_print_string_var/1;
export module_uses_print_string_stderr_var/1;

fn term_has_print_string_var(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            4 -> case term.name == "main.print_string" of {
                true -> term.inner.kind != 0;
                false -> case term.name == "main.println" of {
                    true -> term.inner.kind != 0;
                    false -> term_has_print_string_var(term.inner)
                }
            };
            2 -> case term_has_print_string_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_var(term.right_expr)
            };
            // Case / sequence / patterns: println/print_string often live only in arms — must recurse
            // or L_ps_helper is omitted while BL L_ps_helper is still emitted.
            3 -> case term_has_print_string_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_var(term.right_expr)
            };
            5 -> case term_has_print_string_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_var(term.right_expr)
            };
            6 -> case term_has_print_string_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_var(term.right_expr)
            };
            7 -> case term_has_print_string_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_var(term.right_expr)
            };
            8 -> case term_has_print_string_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_var(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn print_string_var_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_print_string_var(fns.head.body) of {
            true -> true;
            false -> print_string_var_in_functions(fns.tail)
        }
    }
}

fn module_uses_print_string_var(sir_module: SIRModule) -> bool {
    print_string_var_in_functions(sir_module.functions)
}

// Stderr prints (handle_report / probes): fd 2; needs L_ps_helper_stderr when argument is variable.
fn term_has_print_string_stderr_var(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            4 -> case term.name == "main.print_string_stderr" of {
                true -> term.inner.kind != 0;
                false -> case term.name == "main.println_stderr" of {
                    true -> term.inner.kind != 0;
                    false -> term_has_print_string_stderr_var(term.inner)
                }
            };
            2 -> case term_has_print_string_stderr_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_stderr_var(term.right_expr)
            };
            3 -> case term_has_print_string_stderr_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_stderr_var(term.right_expr)
            };
            5 -> case term_has_print_string_stderr_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_stderr_var(term.right_expr)
            };
            6 -> case term_has_print_string_stderr_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_stderr_var(term.right_expr)
            };
            7 -> case term_has_print_string_stderr_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_stderr_var(term.right_expr)
            };
            8 -> case term_has_print_string_stderr_var(term.inner) of {
                true -> true;
                false -> term_has_print_string_stderr_var(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn print_string_stderr_var_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_print_string_stderr_var(fns.head.body) of {
            true -> true;
            false -> print_string_stderr_var_in_functions(fns.tail)
        }
    }
}

fn module_uses_print_string_stderr_var(sir_module: SIRModule) -> bool {
    print_string_stderr_var_in_functions(sir_module.functions)
}

