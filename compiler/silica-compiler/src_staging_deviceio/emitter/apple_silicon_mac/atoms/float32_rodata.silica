// Float32/float16 print: helper rodata only (L_pf32_10, L_pf32_minus for L_pf32_helper).
// print_float32 uses L_pf32_helper directly; print_float16 widens H0 to S0 first.

use sir_ast;

export module_uses_float32_print/1;
export emit_float32_helper_rodata/0;

fn term_has_float32_print(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            4 -> term.name == "main.print_float32" or term.name == "main.print_float16";
            2 -> case term_has_float32_print(term.inner) of {
                true -> true;
                false -> term_has_float32_print(term.right_expr)
            };
            6 -> case term_has_float32_print(term.inner) of {
                true -> true;
                false -> term_has_float32_print(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn float32_print_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_float32_print(fns.head.body) of {
            true -> true;
            false -> float32_print_in_functions(fns.tail)
        }
    }
}

fn module_uses_float32_print(sir_module: SIRModule) -> bool {
    float32_print_in_functions(sir_module.functions)
}

// L_pf32_10 (.single 10.0), L_pf32_minus (.byte 0x2d, 0) for L_pf32_helper
fn emit_float32_helper_rodata() -> string {
    header: string <- ".section __TEXT,__rodata\n.align\t4\n";
    ten: string <- "L_pf32_10:\n    .single 10.0\n";
    minus: string <- "L_pf32_minus:\n    .byte 0x2d, 0\n";
    concat(concat(concat(header, ten), minus), "")
}
