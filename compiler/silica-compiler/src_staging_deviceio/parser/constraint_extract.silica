// Structure extraction: ListTokenSlot -> Program
// Builds AST from final role sequence

use lexer_core;
use lexer_token_kind;
use constraint_core;
use parser_ast;
use parser_core;
use parser_tuples;
use capability_fn_decl;
use capability_expr_literal;
use capability_tuple_decompose;
use capability_case;
use capability_list;
use constraint_core;
use atom_table;
use instantiated_fn_name;

export slots_to_program/1;
export validate_no_single_element_tuples/1;
export validate_max_params/1;
export validate_max_tuple_decompose_bindings/1;
export validate_required_statement_terminators/1;
export validate_uncategorized_syntax_defect/1;
export validate_no_illegal_trailing_semicolon/1;
export validate_no_unused_scope_bindings/1;
export lift_lambda_expressions/1;
export wrap_lifted_lambda_hof_calls/1;
export find_malformed_ffi_surface/1;

// Role codes (must match capabilities)
fn role_fn_keyword() -> int64 { 1 }
fn role_fn_name() -> int64 { 2 }
fn role_left_paren() -> int64 { 3 }
fn role_right_paren() -> int64 { 4 }
fn role_right_arrow() -> int64 { 5 }
fn role_type_name() -> int64 { 6 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_body_expr() -> int64 { 9 }
fn role_integer_literal() -> int64 { 10 }
fn role_identifier() -> int64 { 11 }
fn role_operand() -> int64 { 12 }
fn role_op() -> int64 { 13 }
fn role_call_name() -> int64 { 14 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }

fn extract_function(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    r1: ListTokenSlot <- slots.tail;
    fn_base: string <- r1.head.token.lexeme;
    fn_loc: SourceLocation <- r1.head.token.location;
    (bracket_suffix: string, after_brackets: ListTokenSlot) <- extract_optional_bracket_suffix_after_name(r1.tail);
    fn_name: string <- concat(fn_base, bracket_suffix);
    (params: ListParam, ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- collect_params_and_find_type_and_body(after_brackets);
    (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(body_slots);
    td_bindings: ListTupleDecomposeBinding <- extract_td_bindings_from_params(r1.tail);
    (final_params: ListParam, final_body: Expr) <- case td_bindings.is_nil of {
        true -> (params, body);
        false -> do
            tuple_type: string <- build_tuple_type_from_td_bindings(td_bindings);
            synth_param: Param <- Param { name: "_td_p0", type_name: tuple_type, location: fn_loc };
            synth_params: ListParam <- parser_ast@cons_param(synth_param, parser_ast@nil_list_param());
            rhs_expr: Expr <- Expr { kind: 1, value: "", name: "_td_p0", location: fn_loc, inner: parser_ast@dummy_expr(), right_expr: parser_ast@dummy_expr(), pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
            wrapped: Expr <- Expr { kind: 10, value: "", name: "", location: fn_loc, inner: rhs_expr, right_expr: body, pattern_bindings: td_bindings, sequence_effects: parser_ast@empty_effect_name_list() };
            (synth_params, wrapped)
        end
    };
    decl: Declaration <- Declaration { tag: 0, name: fn_name, parameters: final_params, return_type_name: ret_type, return_type_location: ret_type_loc, location: fn_loc, body: final_body, declared_effects: effects };
    (decl, rest_after_body)
}

fn extract_effect_declaration(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    do
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> do
            empty: ListTokenSlot <- constraint_core@empty_list_slot();
            (parser_ast@dummy_decl(), empty)
        end;
        false -> case slots.tail.is_nil of {
            true -> (parser_ast@dummy_decl(), slots.tail);
            false -> do
                kw_slot: TokenSlot <- slots.head;
                name_slot: TokenSlot <- slots.tail.head;
                rest_after_name: ListTokenSlot <- slots.tail.tail;
                case rest_after_name.is_nil of {
                    true -> (parser_ast@dummy_decl(), rest_after_name);
                    false -> do
                        after_equal: ListTokenSlot <- rest_after_name.tail;
                        case after_equal.is_nil of {
                            true -> (parser_ast@dummy_decl(), after_equal);
                            false -> case after_equal.head.token.kind == kinds.left_bracket of {
                                true -> do
                                    (effects: ListEffectName, rest_after_effects: ListTokenSlot) <- collect_effects_until_right_bracket(after_equal.tail, parser_ast@empty_effect_name_list());
                                    dummy: Expr <- parser_ast@dummy_expr();
                                    zero_loc: SourceLocation <- parser_ast@zero_location();
                                    decl: Declaration <- Declaration { tag: 1, name: name_slot.token.lexeme, parameters: parser_ast@nil_list_param(), return_type_name: "", return_type_location: zero_loc, location: kw_slot.token.location, body: dummy, declared_effects: effects };
                                    (decl, rest_after_effects)
                                end;
                                false -> (parser_ast@dummy_decl(), after_equal)
                            }
                        }
                    end
                }
            end
        }
    }
    end
}

fn is_use_decl_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == kinds.use_keyword
    }
}

fn is_export_decl_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == kinds.export_keyword
    }
}

fn is_module_decl_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == kinds.module_keyword
    }
}

// use a, b, c; — module names in Param.name (spec §3.4.4, §19.3).
fn collect_use_module_params(slots: ListTokenSlot) -> (ListParam, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@nil_list_param(), trimmed);
        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, trimmed.head.token.kind) of {
            false -> (parser_ast@nil_list_param(), trimmed);
            true -> do
                id_slot: TokenSlot <- trimmed.head;
                after_id: ListTokenSlot <- trimmed.tail;
                p: Param <- Param { name: id_slot.token.lexeme, type_name: "", location: id_slot.token.location };
                after_ws: ListTokenSlot <- skip_leading_whitespace_slots(after_id);
                case after_ws.is_nil of {
                    true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), after_ws);
                    false -> case after_ws.head.token.kind == kinds.semicolon of {
                        true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), after_ws.tail);
                        false -> case after_ws.head.token.kind == kinds.comma of {
                            true -> do
                                (rest_params: ListParam, final_rest: ListTokenSlot) <- collect_use_module_params(after_ws.tail);
                                (parser_ast@cons_param(p, rest_params), final_rest)
                            end;
                            false -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), after_ws)
                        }
                    }
                }
            end
        }
    }
}

fn extract_use_declaration(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.use_keyword of {
            false -> (parser_ast@dummy_decl(), slots);
            true -> do
                use_loc: SourceLocation <- slots.head.token.location;
                after_kw: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                (params: ListParam, after_use: ListTokenSlot) <- collect_use_module_params(after_kw);
                dummy: Expr <- parser_ast@dummy_expr();
                zero_loc: SourceLocation <- parser_ast@zero_location();
                decl: Declaration <- Declaration { tag: 2, name: "", parameters: params, return_type_name: "", return_type_location: zero_loc, location: use_loc, body: dummy, declared_effects: parser_ast@empty_effect_name_list() };
                (decl, after_use)
            end
        }
    }
}

// After an identifier in fn/export position: optional `[T, mem(S)]` suffix (not a generic call).
fn extract_optional_bracket_suffix_after_name(rest_after_name: ListTokenSlot) -> (string, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots_is_nil(rest_after_name) of {
        true -> ("", rest_after_name);
        false -> case slots_head(rest_after_name).token.kind == kinds.left_bracket of {
            true -> do
                (type_join: string, rest_after_brackets: ListTokenSlot) <- skip_square_bracket_group_depth_join(slots_tail(rest_after_name), kinds, 1, "");
                inner_raw: string <- strip_trailing_rbracket_type_arg_join(type_join);
                inner: string <- instantiated_fn_name@strip_all_spaces_inst(inner_raw);
                suffix: string <- concat("[", concat(inner, "]"));
                (suffix, rest_after_brackets)
            end;
            false -> ("", rest_after_name)
        }
    }
}

// export f/1, g/2; — Param.name = function, Param.type_name = arity lexeme (spec §19.2).
fn collect_export_decl_parameters(slots: ListTokenSlot) -> (ListParam, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@nil_list_param(), trimmed);
        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, trimmed.head.token.kind) of {
            false -> (parser_ast@nil_list_param(), trimmed);
            true -> do
                fn_slot: TokenSlot <- trimmed.head;
                after_fn: ListTokenSlot <- trimmed.tail;
                (bracket_suffix: string, after_brackets: ListTokenSlot) <- extract_optional_bracket_suffix_after_name(after_fn);
                fn_full: string <- concat(fn_slot.token.lexeme, bracket_suffix);
                ws1: ListTokenSlot <- skip_leading_whitespace_slots(after_brackets);
                case ws1.is_nil of {
                    true -> (parser_ast@nil_list_param(), ws1);
                    false -> case ws1.head.token.kind == kinds.slash of {
                        false -> (parser_ast@nil_list_param(), ws1);
                        true -> do
                            after_slash: ListTokenSlot <- ws1.tail;
                            ws2: ListTokenSlot <- skip_leading_whitespace_slots(after_slash);
                            case ws2.is_nil of {
                                true -> (parser_ast@nil_list_param(), ws2);
                                false -> case ws2.head.token.kind == kinds.integer_literal of {
                                    false -> (parser_ast@nil_list_param(), ws2);
                                    true -> do
                                        ar_slot: TokenSlot <- ws2.head;
                                        p: Param <- Param { name: fn_full, type_name: ar_slot.token.lexeme, location: fn_slot.token.location };
                                        after_ar: ListTokenSlot <- ws2.tail;
                                        ws3: ListTokenSlot <- skip_leading_whitespace_slots(after_ar);
                                        case ws3.is_nil of {
                                            true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), ws3);
                                            false -> case ws3.head.token.kind == kinds.semicolon of {
                                                true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), ws3.tail);
                                                false -> case ws3.head.token.kind == kinds.comma of {
                                                    true -> do
                                                        (rest_params: ListParam, final_rest: ListTokenSlot) <- collect_export_decl_parameters(ws3.tail);
                                                        (parser_ast@cons_param(p, rest_params), final_rest)
                                                    end;
                                                    false -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), ws3)
                                                }
                                            }
                                        }
                                    end
                                }
                            }
                        end
                    }
                }
            end
        }
    }
}

fn extract_export_declaration(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.export_keyword of {
            false -> (parser_ast@dummy_decl(), slots);
            true -> do
                exp_loc: SourceLocation <- slots.head.token.location;
                after_export_kw: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                case after_export_kw.is_nil of {
                    true -> (parser_ast@dummy_decl(), after_export_kw);
                    false -> case after_export_kw.head.token.kind == kinds.trait_keyword of {
                        true -> do
                            after_trait: ListTokenSlot <- skip_leading_whitespace_slots(after_export_kw.tail);
                            case after_trait.is_nil of {
                                true -> (parser_ast@dummy_decl(), after_trait);
                                false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, after_trait.head.token.kind) of {
                                    false -> (parser_ast@dummy_decl(), after_trait);
                                    true -> do
                                        trait_name: string <- after_trait.head.token.lexeme;
                                        after_name: ListTokenSlot <- skip_leading_whitespace_slots(after_trait.tail);
                                        case after_name.is_nil of {
                                            true -> (parser_ast@dummy_decl(), after_name);
                                            false -> case after_name.head.token.kind == kinds.semicolon of {
                                                false -> (parser_ast@dummy_decl(), after_name);
                                                true -> do
                                                    dummy_tr: Expr <- parser_ast@dummy_expr();
                                                    zero_loc_tr: SourceLocation <- parser_ast@zero_location();
                                                    decl_tr: Declaration <- Declaration { tag: 5, name: trait_name, parameters: parser_ast@nil_list_param(), return_type_name: "", return_type_location: zero_loc_tr, location: exp_loc, body: dummy_tr, declared_effects: parser_ast@empty_effect_name_list() };
                                                    (decl_tr, after_name.tail)
                                                end
                                            }
                                        }
                                    end
                                }
                            }
                        end;
                        false -> do
                            (params: ListParam, after_exp: ListTokenSlot) <- collect_export_decl_parameters(slots.tail);
                            dummy: Expr <- parser_ast@dummy_expr();
                            zero_loc: SourceLocation <- parser_ast@zero_location();
                            decl: Declaration <- Declaration { tag: 3, name: "", parameters: params, return_type_name: "", return_type_location: zero_loc, location: exp_loc, body: dummy, declared_effects: parser_ast@empty_effect_name_list() };
                            (decl, after_exp)
                        end
                    }
                }
            end
        }
    }
}

fn extract_module_declaration(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.module_keyword of {
            false -> (parser_ast@dummy_decl(), slots);
            true -> do
                mod_kw_loc: SourceLocation <- slots.head.token.location;
                after_kw: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                case after_kw.is_nil of {
                    true -> (parser_ast@dummy_decl(), after_kw);
                    false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, after_kw.head.token.kind) of {
                        false -> (parser_ast@dummy_decl(), after_kw);
                        true -> do
                            name_slot: TokenSlot <- after_kw.head;
                            after_name: ListTokenSlot <- after_kw.tail;
                            ws_semi: ListTokenSlot <- skip_leading_whitespace_slots(after_name);
                            case ws_semi.is_nil of {
                                true -> (parser_ast@dummy_decl(), ws_semi);
                                false -> case ws_semi.head.token.kind == kinds.semicolon of {
                                    false -> (parser_ast@dummy_decl(), ws_semi);
                                    true -> do
                                        dummy: Expr <- parser_ast@dummy_expr();
                                        zero_loc: SourceLocation <- parser_ast@zero_location();
                                        decl: Declaration <- Declaration { tag: 4, name: name_slot.token.lexeme, parameters: parser_ast@nil_list_param(), return_type_name: "", return_type_location: zero_loc, location: mod_kw_loc, body: dummy, declared_effects: parser_ast@empty_effect_name_list() };
                                        (decl, ws_semi.tail)
                                    end
                                }
                            }
                        end
                    }
                }
            end
        }
    }
}

fn is_wrapper_meta_decl_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == kinds.wrapper_meta_keyword
    }
}

fn is_foreign_decl_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == kinds.foreign_keyword
    }
}

fn extract_wrapper_meta_declaration(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.wrapper_meta_keyword of {
            false -> (parser_ast@dummy_decl(), slots);
            true -> do
                kw_loc: SourceLocation <- slots.head.token.location;
                after_kw: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                case after_kw.is_nil of {
                    true -> (parser_ast@dummy_decl(), after_kw);
                    false -> case after_kw.head.token.kind == kinds.string_literal of {
                        false -> (parser_ast@dummy_decl(), after_kw);
                        true -> do
                            path_slot: TokenSlot <- after_kw.head;
                            after_path: ListTokenSlot <- skip_leading_whitespace_slots(after_kw.tail);
                            case after_path.is_nil of {
                                true -> (parser_ast@dummy_decl(), after_path);
                                false -> case after_path.head.token.kind == kinds.semicolon of {
                                    false -> (parser_ast@dummy_decl(), after_path);
                                    true -> do
                                        dummy: Expr <- parser_ast@dummy_expr();
                                        zero_loc: SourceLocation <- parser_ast@zero_location();
                                        decl: Declaration <- Declaration { tag: 8, name: path_slot.token.lexeme, parameters: parser_ast@nil_list_param(), return_type_name: "", return_type_location: zero_loc, location: kw_loc, body: dummy, declared_effects: parser_ast@empty_effect_name_list() };
                                        (decl, after_path.tail)
                                    end
                                }
                            }
                        end
                    }
                }
            end
        }
    }
}

fn extract_foreign_declaration(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.foreign_keyword of {
            false -> (parser_ast@dummy_decl(), slots);
            true -> do
                foreign_loc: SourceLocation <- slots.head.token.location;
                after_foreign: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                case after_foreign.is_nil of {
                    true -> (parser_ast@dummy_decl(), after_foreign);
                    false -> case after_foreign.head.token.kind == kinds.c_wrapper_keyword of {
                        false -> (parser_ast@dummy_decl(), after_foreign);
                        true -> do
                            after_c_wrapper: ListTokenSlot <- skip_leading_whitespace_slots(after_foreign.tail);
                            case after_c_wrapper.is_nil of {
                                true -> (parser_ast@dummy_decl(), after_c_wrapper);
                                false -> case after_c_wrapper.head.token.kind == kinds.string_literal of {
                                    false -> (parser_ast@dummy_decl(), after_c_wrapper);
                                    true -> do
                                        symbol_lexeme: string <- after_c_wrapper.head.token.lexeme;
                                        after_symbol: ListTokenSlot <- skip_leading_whitespace_slots(after_c_wrapper.tail);
                                        (meta_path: string, after_meta: ListTokenSlot) <- case after_symbol.is_nil of {
                                            true -> ("", after_symbol);
                                            false -> case after_symbol.head.token.kind == kinds.meta_keyword of {
                                                true -> do
                                                    after_meta_kw: ListTokenSlot <- skip_leading_whitespace_slots(after_symbol.tail);
                                                    case after_meta_kw.is_nil of {
                                                        true -> ("", after_meta_kw);
                                                        false -> case after_meta_kw.head.token.kind == kinds.string_literal of {
                                                            false -> ("", after_meta_kw);
                                                            true -> (after_meta_kw.head.token.lexeme, skip_leading_whitespace_slots(after_meta_kw.tail))
                                                        }
                                                    }
                                                end;
                                                false -> ("", after_symbol)
                                            }
                                        };
                                        case after_meta.is_nil of {
                                            true -> (parser_ast@dummy_decl(), after_meta);
                                            false -> case after_meta.head.token.kind == kinds.fn_keyword of {
                                                false -> (parser_ast@dummy_decl(), after_meta);
                                                true -> do
                                                    fn_slots: ListTokenSlot <- after_meta;
                                                    r1: ListTokenSlot <- fn_slots.tail;
                                                    case r1.is_nil of {
                                                        true -> (parser_ast@dummy_decl(), fn_slots);
                                                        false -> do
                                                            fn_name: string <- r1.head.token.lexeme;
                                                            fn_loc: SourceLocation <- r1.head.token.location;
                                                            (params: ListParam, ret_type: string, ret_type_loc: SourceLocation, _effects: ListEffectName, after_sig: ListTokenSlot) <- collect_params_and_find_type_and_semicolon(r1.tail);
                                                            placeholder_sym: Expr <- parser_ast@dummy_expr();
                                                            symbol_body: Expr <- Expr { kind: -1, value: symbol_lexeme, name: meta_path, location: foreign_loc, inner: placeholder_sym, right_expr: placeholder_sym, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                                            decl: Declaration <- Declaration { tag: 9, name: fn_name, parameters: params, return_type_name: ret_type, return_type_location: ret_type_loc, location: fn_loc, body: symbol_body, declared_effects: parser_ast@empty_effect_name_list() };
                                                            (decl, after_sig)
                                                        end
                                                    }
                                                end
                                            }
                                        }
                                    end
                                }
                            }
                        end
                    }
                }
            end
        }
    }
}

fn find_malformed_ffi_surface(slots: ListTokenSlot) -> (bool, SourceLocation, string) proc[DeviceIO] {
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case is_wrapper_meta_decl_start(trimmed) of {
            true -> do
                (decl: Declaration, rest_after: ListTokenSlot) <- extract_wrapper_meta_declaration(trimmed);
                case decl.tag == 8 of {
                    true -> find_malformed_ffi_surface(rest_after);
                    false -> (true, trimmed.head.token.location, "wrapper_meta must be followed by a string literal path and ';'")
                }
            end;
            false -> case is_foreign_decl_start(trimmed) of {
                true -> do
                    (decl: Declaration, rest_after: ListTokenSlot) <- extract_foreign_declaration(trimmed);
                    case decl.tag == 9 of {
                        true -> find_malformed_ffi_surface(rest_after);
                        false -> (true, trimmed.head.token.location, "foreign c_wrapper declaration is malformed; expected foreign c_wrapper \"symbol\" [meta \"path\"] fn name(...) -> Type;")
                    }
                end;
                false -> find_malformed_ffi_surface(trimmed.tail)
            }
        }
    }
}

fn is_fn_decl_start(slots: ListTokenSlot) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> parser_tuples@slots_start_fn_type(slots)
        }
    }
}

fn is_effect_decl_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> case slots.tail.tail.is_nil of {
                true -> false;
                false -> case slots.tail.tail.tail.is_nil of {
                    true -> false;
                            false -> case slots.head.token.kind == kinds.identifier of {
                        true -> case slots.head.token.lexeme == "effect" of {
                                true -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slots.tail.head.token.kind) of {
                                true -> case slots.tail.tail.head.token.kind == kinds.equal of {
                                    true -> slots.tail.tail.tail.head.token.kind == kinds.left_bracket;
                                    false -> false
                                };
                                false -> false
                            };
                            false -> false
                        };
                        false -> false
                    }
                }
            }
        }
    }
}

fn is_type_keyword(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.int8_keyword or token_kind == kinds.int16_keyword or token_kind == kinds.int32_keyword or token_kind == kinds.int64_keyword or token_kind == kinds.uint8_keyword or token_kind == kinds.uint16_keyword or token_kind == kinds.uint32_keyword or token_kind == kinds.uint64_keyword or token_kind == kinds.float16_keyword or token_kind == kinds.float32_keyword or token_kind == kinds.float64_keyword or token_kind == kinds.bool_keyword or token_kind == kinds.char_keyword or token_kind == kinds.string_keyword or token_kind == kinds.bytes_keyword or token_kind == kinds.unit_keyword or token_kind == kinds.atom_keyword or token_kind == kinds.ref_keyword or token_kind == kinds.region_keyword or token_kind == kinds.buf_keyword or token_kind == kinds.atomic_keyword or token_kind == kinds.lifetime_keyword or token_kind == kinds.normal_keyword or token_kind == kinds.normal_writeback_keyword or token_kind == kinds.normal_writethrough_keyword or token_kind == kinds.normal_noncacheable_keyword or token_kind == kinds.device_keyword or token_kind == kinds.actor_ref_keyword or token_kind == kinds.dangerous_actor_ref_keyword or token_kind == kinds.supervisor_ref_keyword or token_kind == kinds.failure_reason_keyword
}

fn kind_to_type_name(token_kind: int64) -> string {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.failure_reason_keyword of {
        true -> "failure_reason";
        false -> case token_kind == kinds.supervisor_ref_keyword of {
            true -> "supervisor_ref";
            false -> kind_to_type_name_not_failure(token_kind)
        }
    }
}

fn kind_to_type_name_not_failure(token_kind: int64) -> string {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.actor_ref_keyword of {
        true -> "actor_ref";
        false -> case token_kind == kinds.dangerous_actor_ref_keyword of {
            true -> "dangerous_actor_ref";
            false -> case token_kind == kinds.int64_keyword of {
                true -> "int64";
                false -> case token_kind == kinds.int32_keyword of {
                    true -> "int32";
                    false -> case token_kind == kinds.int16_keyword of {
                        true -> "int16";
                        false -> case token_kind == kinds.int8_keyword of {
                            true -> "int8";
                            false -> case token_kind == kinds.uint64_keyword of {
                                true -> "uint64";
                                false -> case token_kind == kinds.uint32_keyword of {
                                    true -> "uint32";
                                    false -> case token_kind == kinds.uint16_keyword of {
                                        true -> "uint16";
                                        false -> case token_kind == kinds.uint8_keyword of {
                                            true -> "uint8";
                                            false -> case token_kind == kinds.float64_keyword of {
                                                true -> "float64";
                                                false -> case token_kind == kinds.float32_keyword of {
                                                    true -> "float32";
                                                    false -> case token_kind == kinds.float16_keyword of {
                                                        true -> "float16";
                                                        false -> case token_kind == kinds.bool_keyword of {
                                                            true -> "boolean";
                                                            false -> case token_kind == kinds.unit_keyword of {
                                                                true -> "unit";
                                                                false -> case token_kind == kinds.atom_keyword of {
                                                                    true -> "atom";
                                                                    false -> case token_kind == kinds.string_keyword of {
                                                                        true -> "string";
                                                                        false -> case token_kind == kinds.bytes_keyword of {
                                                                            true -> "bytes";
                                                                            false -> ""
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn is_op_token(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.plus or token_kind == kinds.minus or token_kind == kinds.star or token_kind == kinds.slash or token_kind == kinds.percent or token_kind == kinds.less_than or token_kind == kinds.greater_than or token_kind == kinds.less_equal or token_kind == kinds.greater_equal or token_kind == kinds.equal_equal or token_kind == kinds.bang_equal or token_kind == kinds.bor_keyword or token_kind == kinds.band_keyword or token_kind == kinds.shl_keyword or token_kind == kinds.shr_keyword
}

// Logical operators and/or are keywords (and_keyword, or_keyword) or identifiers (legacy); treat as binary ops.
fn is_logical_op_slot(slot: TokenSlot, kinds: TokenKinds) -> bool {
    slot.token.kind == kinds.and_keyword or slot.token.kind == kinds.or_keyword or (slot.token.kind == kinds.identifier and (slot.token.lexeme == "and" or slot.token.lexeme == "or"))
}

fn is_operand_token(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.integer_literal or token_kind == kinds.float_literal or lexer_token_kind@is_identifier_lexeme_token(kinds, token_kind) or token_kind == kinds.atom_literal or token_kind == kinds.true_literal or token_kind == kinds.false_literal or token_kind == kinds.string_literal or token_kind == kinds.atomic_keyword or token_kind == kinds.normal_keyword or token_kind == kinds.normal_writeback_keyword or token_kind == kinds.normal_writethrough_keyword or token_kind == kinds.normal_noncacheable_keyword or token_kind == kinds.device_keyword
}

// mem(atomic), mem(normal), etc.: parameter is a keyword, not only a generic identifier (see collect_effects_until_right_bracket).
fn is_effect_paren_param_token(kinds: TokenKinds, token_kind: int64) -> bool {
    lexer_token_kind@is_identifier_lexeme_token(kinds, token_kind) or token_kind == kinds.atomic_keyword or token_kind == kinds.normal_keyword or token_kind == kinds.normal_writeback_keyword or token_kind == kinds.normal_writethrough_keyword or token_kind == kinds.normal_noncacheable_keyword or token_kind == kinds.device_keyword
}

fn collect_effects_until_right_bracket(slots: ListTokenSlot, acc: ListEffectName) -> (ListEffectName, ListTokenSlot) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (acc, slots);
        false -> case slots.head.token.kind == kinds.right_bracket of {
            true -> (acc, slots.tail);
            false -> case slots.head.token.kind == kinds.comma of {
                true -> collect_effects_until_right_bracket(slots.tail, acc);
                false -> case lexer_token_kind@is_proc_list_effect_head_token(kinds, slots.head.token.kind) of {
                    true -> do
                        rest1: ListTokenSlot <- slots.tail;
                        case rest1.is_nil of {
                            true -> do
                                eff: EffectName <- EffectName { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                next_acc: ListEffectName <- parser_ast@cons_effect_name(eff, acc);
                                collect_effects_until_right_bracket(rest1, next_acc)
                            end;
                            false -> case rest1.head.token.kind == kinds.left_paren of {
                                true -> case rest1.tail.is_nil of {
                                    true -> do
                                        eff_no_param: EffectName <- EffectName { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                        next_acc_no_param: ListEffectName <- parser_ast@cons_effect_name(eff_no_param, acc);
                                        collect_effects_until_right_bracket(rest1, next_acc_no_param)
                                    end;
                                    false -> case is_effect_paren_param_token(kinds, rest1.tail.head.token.kind) of {
                                        true -> case rest1.tail.tail.is_nil of {
                                            true -> do
                                                eff_no_param: EffectName <- EffectName { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                                next_acc_no_param: ListEffectName <- parser_ast@cons_effect_name(eff_no_param, acc);
                                                collect_effects_until_right_bracket(rest1, next_acc_no_param)
                                            end;
                                            false -> case rest1.tail.tail.head.token.kind == kinds.right_paren of {
                                                true -> do
                                                    eff: EffectName <- EffectName { name: slots.head.token.lexeme, parameter: rest1.tail.head.token.lexeme, location: slots.head.token.location };
                                                    next_acc: ListEffectName <- parser_ast@cons_effect_name(eff, acc);
                                                    collect_effects_until_right_bracket(rest1.tail.tail.tail, next_acc)
                                                end;
                                                false -> do
                                                    eff_no_param: EffectName <- EffectName { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                                    next_acc_no_param: ListEffectName <- parser_ast@cons_effect_name(eff_no_param, acc);
                                                    collect_effects_until_right_bracket(rest1, next_acc_no_param)
                                                end
                                            }
                                        };
                                        false -> do
                                            eff_no_param: EffectName <- EffectName { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                            next_acc_no_param: ListEffectName <- parser_ast@cons_effect_name(eff_no_param, acc);
                                            collect_effects_until_right_bracket(rest1, next_acc_no_param)
                                        end
                                    }
                                };
                                false -> do
                                    eff: EffectName <- EffectName { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                    next_acc: ListEffectName <- parser_ast@cons_effect_name(eff, acc);
                                    collect_effects_until_right_bracket(rest1, next_acc)
                                end
                            }
                        }
                    end;
                    false -> collect_effects_until_right_bracket(slots.tail, acc)
                }
            }
        }
    }
}

fn collect_optional_proc_effects(slots: ListTokenSlot) -> (ListEffectName, ListTokenSlot) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@empty_effect_name_list(), slots);
        false -> case slots.head.token.kind == kinds.proc_keyword or slots.head.token.lexeme == "proc" of {
            true -> case slots.tail.is_nil of {
                true -> (parser_ast@empty_effect_name_list(), slots);
                false -> case slots.tail.head.token.kind == kinds.left_bracket of {
                    true -> collect_effects_until_right_bracket(slots.tail.tail, parser_ast@empty_effect_name_list());
                    false -> (parser_ast@empty_effect_name_list(), slots)
                }
            };
            false -> (parser_ast@empty_effect_name_list(), slots)
        }
    }
}

// Collect params from ( param_name : param_type , ... ) and find return type/body. Slots start with left_paren.
fn collect_params_and_find_type_and_body(slots: ListTokenSlot) -> (ListParam, string, SourceLocation, ListEffectName, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@nil_list_param(), "", parser_ast@zero_location(), parser_ast@empty_effect_name_list(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.left_paren of {
            true -> case slots.tail.is_nil of {
                true -> (parser_ast@nil_list_param(), "", parser_ast@zero_location(), parser_ast@empty_effect_name_list(), constraint_core@empty_list_slot());
                false -> case slots.tail.head.token.kind == kinds.right_paren of {
                    true -> do
                        rest_after_rparen: ListTokenSlot <- slots.tail.tail;
                        (ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_body(rest_after_rparen);
                        (parser_ast@nil_list_param(), ret_type, ret_type_loc, effects, body_slots)
                    end;
                    false -> do
                        (params: ListParam, rest_after_params: ListTokenSlot) <- collect_params_loop(slots.tail, parser_ast@nil_list_param());
                        (ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_body(rest_after_params);
                        (params, ret_type, ret_type_loc, effects, body_slots)
                    end
                }
            };
            false -> do
                (ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_body(slots);
                (parser_ast@nil_list_param(), ret_type, ret_type_loc, effects, body_slots)
            end
        }
    }
}

// `required` trait methods: signature only, terminated by `;`.
fn collect_params_and_find_type_and_semicolon(slots: ListTokenSlot) -> (ListParam, string, SourceLocation, ListEffectName, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@nil_list_param(), "", parser_ast@zero_location(), parser_ast@empty_effect_name_list(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.left_paren of {
            true -> case slots.tail.is_nil of {
                true -> (parser_ast@nil_list_param(), "", parser_ast@zero_location(), parser_ast@empty_effect_name_list(), constraint_core@empty_list_slot());
                false -> case slots.tail.head.token.kind == kinds.right_paren of {
                    true -> do
                        rest_after_rparen: ListTokenSlot <- slots.tail.tail;
                        (ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_semicolon(rest_after_rparen);
                        (parser_ast@nil_list_param(), ret_type, ret_type_loc, effects, body_slots)
                    end;
                    false -> do
                        (params: ListParam, rest_after_params: ListTokenSlot) <- collect_params_loop(slots.tail, parser_ast@nil_list_param());
                        (ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_semicolon(rest_after_params);
                        (params, ret_type, ret_type_loc, effects, body_slots)
                    end
                }
            };
            false -> do
                (ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_semicolon(slots);
                (parser_ast@nil_list_param(), ret_type, ret_type_loc, effects, body_slots)
            end
        }
    }
}

fn bindings_to_params(bindings: ListTupleDecomposeBinding) -> ListParam {
    case bindings.is_nil of {
        true -> parser_ast@nil_list_param();
        false -> do
            b: TupleDecomposeBinding <- bindings.head;
            p: Param <- Param { name: b.name, type_name: b.type_str, location: parser_ast@zero_location() };
            parser_ast@cons_param(p, bindings_to_params(bindings.tail))
        end
    }
}

// Detect tuple decomposition pattern in function param slots.
// slots = ( ( a : T , b : U ) ) -> ... for the TD case.
// Returns the bindings if found, nil otherwise.
fn extract_td_bindings_from_params(slots: ListTokenSlot) -> ListTupleDecomposeBinding proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> parser_ast@nil_tuple_decompose_bindings();
        false -> case slots.head.token.kind == kinds.left_paren of {
            true -> case slots.tail.is_nil of {
                true -> parser_ast@nil_tuple_decompose_bindings();
                false -> case slots.tail.head.token.kind == kinds.left_paren of {
                    true -> case slots.tail.tail.is_nil of {
                        true -> parser_ast@nil_tuple_decompose_bindings();
                        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slots.tail.tail.head.token.kind) of {
                            true -> do
                                td_result: TupleDecomposeResult <- parser_tuples@extract_tuple_decompose_pattern_from_slots(slots.tail);
                                td_result.bindings
                            end;
                            false -> parser_ast@nil_tuple_decompose_bindings()
                        }
                    };
                    false -> parser_ast@nil_tuple_decompose_bindings()
                }
            };
            false -> parser_ast@nil_tuple_decompose_bindings()
        }
    }
}

// Build tuple type string from decomposition bindings, e.g. "(int64,int64)"
fn build_tuple_type_from_td_bindings(bindings: ListTupleDecomposeBinding) -> string {
    inner: string <- build_tuple_type_inner(bindings);
    concat("(", concat(inner, ")"))
}

fn build_tuple_type_inner(bindings: ListTupleDecomposeBinding) -> string {
    case bindings.is_nil of {
        true -> "";
        false -> do
            b: TupleDecomposeBinding <- bindings.head;
            rest: string <- build_tuple_type_inner(bindings.tail);
            case len(rest) == 0 of {
                true -> b.type_str;
                false -> concat(b.type_str, concat(",", rest))
            }
        end
    }
}

fn append_params(a: ListParam, b: ListParam) -> ListParam {
    case a.is_nil of {
        true -> b;
        false -> parser_ast@cons_param(a.head, append_params(a.tail, b))
    }
}

fn collect_params_loop(slots: ListTokenSlot, acc: ListParam) -> (ListParam, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (acc, slots);
        false -> case slots.head.token.kind == kinds.right_paren of {
            true -> (acc, slots.tail);
            false -> case slots.head.token.kind == kinds.left_paren of {
                true -> case slots.tail.is_nil of {
                    true -> (acc, slots);
                    false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slots.tail.head.token.kind) of {
                        true -> do
                            td_result: TupleDecomposeResult <- parser_tuples@extract_tuple_decompose_pattern_from_slots(slots);
                            td_rest: ListTokenSlot <- td_result.rest_slots;
                            td_bindings: ListTupleDecomposeBinding <- td_result.bindings;
                            params_from_bindings: ListParam <- bindings_to_params(td_bindings);
                            new_acc: ListParam <- append_params(params_from_bindings, acc);
                            case td_rest.is_nil of {
                                true -> (new_acc, td_rest);
                                false -> case td_rest.head.token.kind == kinds.comma of {
                                    true -> collect_params_loop(td_rest.tail, new_acc);
                                    false -> case td_rest.head.token.kind == kinds.right_paren of {
                                        true -> (new_acc, td_rest.tail);
                                        false -> (new_acc, td_rest)
                                    }
                                }
                            }
                        end;
                        false -> (acc, slots)
                    }
                };
                false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slots.head.token.kind) of {
                    true -> case slots.tail.is_nil of {
                        true -> (acc, slots);
                        false -> case slots.tail.tail.is_nil of {
                            true -> (acc, slots);
                            false -> case slots.tail.head.token.kind == kinds.colon of {
                                true -> do
                                    param_name: string <- slots.head.token.lexeme;
                                    param_loc: SourceLocation <- slots.head.token.location;
                                    type_slots: ListTokenSlot <- slots_after_binding_colon(slots);
                                    (param_type_str: string, rest_after_type: ListTokenSlot) <- extract_single_param_type(type_slots);
                                    p: Param <- Param { name: param_name, type_name: param_type_str, location: param_loc };
                                    new_acc: ListParam <- parser_ast@cons_param(p, acc);
                                    case rest_after_type.is_nil of {
                                        true -> (new_acc, rest_after_type);
                                        false -> case rest_after_type.head.token.kind == kinds.comma of {
                                            true -> collect_params_loop(rest_after_type.tail, new_acc);
                                            false -> case rest_after_type.head.token.kind == kinds.right_paren of {
                                                true -> (new_acc, rest_after_type.tail);
                                                false -> (new_acc, rest_after_type)
                                            }
                                        }
                                    }
                                end;
                                false -> (acc, slots)
                            };
                            false -> (acc, slots)
                        }
                    };
                    false -> (acc, slots)
                }
            }
        }
    }
}

fn extract_single_param_type(slots: ListTokenSlot) -> (string, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> ("", slots);
        false -> case slots.head.token.kind == kinds.left_paren of {
            true -> do
                tr: TupleTypeResult <- parser_tuples@extract_tuple_type_from_slots(slots);
                (tr.type_str, tr.rest_slots)
            end;
            false -> case slots.head.token.kind == kinds.ref_keyword or slots.head.token.kind == kinds.region_keyword or slots.head.token.kind == kinds.buf_keyword of {
                true -> do
                    tr: TupleTypeResult <- parser_tuples@extract_parametrized_type_from_slots(slots);
                    (tr.type_str, tr.rest_slots)
                end;
                false -> case slots.head.token.kind == kinds.atomic_keyword of {
                    true -> case slots.tail.is_nil of {
                        true -> ("", slots);
                        false -> case slots.tail.head.token.kind == kinds.ref_keyword of {
                            true -> do
                                tr: TupleTypeResult <- parser_tuples@extract_parametrized_type_from_slots(slots);
                                (tr.type_str, tr.rest_slots)
                            end;
                            false -> (kind_to_type_name(slots.head.token.kind), slots.tail)
                        }
                    };
                    false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
                        true -> do
                            tr_rec: TupleTypeResult <- parser_tuples@extract_inline_record_type_from_slots(slots);
                            (tr_rec.type_str, tr_rec.rest_slots)
                        end;
                        false -> case parser_tuples@slots_start_bracketed_collection_type(slots, kinds) of {
                            true -> do
                                tr_ls: TupleTypeResult <- parser_tuples@extract_list_type_from_slots(slots);
                                (tr_ls.type_str, tr_ls.rest_slots)
                            end;
                            // Same `fn (...) -> …` surface as parser_tuples@extract_tuple_type_loop (fn_keyword or identifier "fn").
                            false -> case parser_tuples@slots_start_fn_type(slots) of {
                                true -> do
                                    (fn_s: string, fn_r: ListTokenSlot) <- parser_tuples@extract_fn_type_from_slots(slots);
                                    (fn_s, fn_r)
                                end;
                                false -> case slots.head.token.kind == kinds.atom_literal of {
                                    true -> do
                                        tr_at: TupleTypeResult <- parser_tuples@extract_atom_option_type_from_slots(slots);
                                        (tr_at.type_str, tr_at.rest_slots)
                                    end;
                                    false -> case is_type_keyword(kinds, slots.head.token.kind) of {
                                        true -> (kind_to_type_name(slots.head.token.kind), slots.tail);
                                        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slots.head.token.kind) of {
                                            true -> (slots.head.token.lexeme, slots.tail);
                                            false -> ("", slots)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// After `-> T` and optional proc effects, slots begin with `{` ... `}`; strip `{` so extract_function_body
// parses inner statements (extract_body does not treat left_brace as a block opener).
fn body_slots_after_open_brace(slots: ListTokenSlot) -> ListTokenSlot {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
            true -> slots.tail;
            false -> slots
        }
    }
}


// After `-> T` and optional proc effects for trait `required` methods: `-> type ;` (silica-specification §3.4.8).
fn body_slots_after_semicolon(slots: ListTokenSlot) -> ListTokenSlot {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> trimmed;
        false -> case trimmed.head.token.kind == kinds.semicolon of {
            true -> trimmed.tail;
            false -> constraint_core@empty_list_slot()
        }
    }
}

// Return type and effects are separate: -> int64 proc[device_io] means return_type=int64, effects=[device_io].
// When proc effects follow, token.lexeme may be empty; derive type from token.kind for type keywords.
fn find_type_and_body(slots: ListTokenSlot) -> (string, SourceLocation, ListEffectName, ListTokenSlot) proc[DeviceIO] {
    do
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> do
            zero_loc: SourceLocation <- parser_ast@zero_location();
            empty_effects: ListEffectName <- parser_ast@empty_effect_name_list();
            empty: ListTokenSlot <- constraint_core@empty_list_slot();
            ("", zero_loc, empty_effects, empty)
        end;
        false -> do
            first: TokenSlot <- slots.head;
            rest: ListTokenSlot <- slots.tail;
            top_or_type: TupleTypeResult <- parser_tuples@extract_top_level_or_type_from_slots(slots);
            case len(top_or_type.type_str) > 0 of {
                true -> do
                    (effects_top: ListEffectName, after_effects_top: ListTokenSlot) <- collect_optional_proc_effects(top_or_type.rest_slots);
                    rest_after_lbrace_top: ListTokenSlot <- after_effects_top.tail;
                    body_slots_top: ListTokenSlot <- body_slots_after_open_brace(rest_after_lbrace_top);
                    (top_or_type.type_str, first.token.location, parser_ast@empty_effect_name_list(), body_slots_top)
                end;
                false -> case first.token.kind == kinds.ref_keyword or first.token.kind == kinds.region_keyword or first.token.kind == kinds.buf_keyword of {
                true -> do
                    tr: TupleTypeResult <- parser_tuples@extract_parametrized_type_from_slots(slots);
                    ret_type: string <- tr.type_str;
                    ret_type_loc: SourceLocation <- first.token.location;
                    (effects: ListEffectName, after_effects: ListTokenSlot) <- collect_optional_proc_effects(tr.rest_slots);
                    rest_after_lbrace: ListTokenSlot <- after_effects.tail;
                    body_slots: ListTokenSlot <- body_slots_after_open_brace(rest_after_lbrace);
                    from_kind: string <- "";
                    use_type: string <- ret_type;
                    ret_empty: string <- case ret_type of { "" -> "ret_empty"; _: string -> "ret_ok" };
                    from_empty: string <- "from_ok";
                    use_type_instrumented: string <- case use_type of { "" -> concat("DEBUG:", concat(ret_empty, concat(",", from_empty))); _: string -> use_type };
                    (use_type_instrumented, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                end;
                false -> case first.token.kind == kinds.atomic_keyword of {
                    true -> case rest.is_nil of {
                        true -> do
                            (ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_body(rest);
                            (ret_type, ret_type_loc, effects, body_slots)
                        end;
                        false -> case rest.head.token.kind == kinds.ref_keyword of {
                            true -> do
                                tr: TupleTypeResult <- parser_tuples@extract_parametrized_type_from_slots(slots);
                                ret_type: string <- tr.type_str;
                                ret_type_loc: SourceLocation <- first.token.location;
                                (effects: ListEffectName, after_effects: ListTokenSlot) <- collect_optional_proc_effects(tr.rest_slots);
                                rest_after_lbrace: ListTokenSlot <- after_effects.tail;
                                body_slots: ListTokenSlot <- body_slots_after_open_brace(rest_after_lbrace);
                                use_type_instrumented: string <- case ret_type of { "" -> "DEBUG:ref_empty"; _: string -> ret_type };
                                (use_type_instrumented, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                            end;
                            false -> do
                                (ret_type: string, ret_type_loc: SourceLocation, _effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_body(rest);
                                (ret_type, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                            end
                        }
                    };
                    false -> case first.token.kind == kinds.atom_literal of {
                        true -> do
                            ret_type_loc_atom: SourceLocation <- first.token.location;
                            tr_atom: TupleTypeResult <- parser_tuples@extract_atom_option_type_from_slots(slots);
                            rest_after_type_atom: ListTokenSlot <- tr_atom.rest_slots;
                            (effects_atom: ListEffectName, after_effects_atom: ListTokenSlot) <- collect_optional_proc_effects(rest_after_type_atom);
                            rest_after_effects_atom: ListTokenSlot <- after_effects_atom.tail;
                            body_slots_atom: ListTokenSlot <- body_slots_after_open_brace(rest_after_effects_atom);
                            (tr_atom.type_str, ret_type_loc_atom, parser_ast@empty_effect_name_list(), body_slots_atom)
                        end;
                        false -> case first.token.kind == kinds.left_paren of {
                            true -> do
                                tr: TupleTypeResult <- parser_tuples@extract_tuple_type_from_slots(slots);
                                ret_type: string <- tr.type_str;
                                ret_type_loc: SourceLocation <- first.token.location;
                                (effects: ListEffectName, after_effects: ListTokenSlot) <- collect_optional_proc_effects(tr.rest_slots);
                                rest_after_lbrace: ListTokenSlot <- after_effects.tail;
                                body_slots: ListTokenSlot <- body_slots_after_open_brace(rest_after_lbrace);
                                (ret_type, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                            end;
                            false -> case parser_tuples@slots_start_bracketed_collection_type(slots, kinds) of {
                            true -> do
                                tr_li: TupleTypeResult <- parser_tuples@extract_list_type_from_slots(slots);
                                ret_type_li: string <- tr_li.type_str;
                                ret_type_loc_li: SourceLocation <- first.token.location;
                                (effects_li: ListEffectName, after_effects_li: ListTokenSlot) <- collect_optional_proc_effects(tr_li.rest_slots);
                                rest_after_lbrace_li: ListTokenSlot <- after_effects_li.tail;
                                body_slots_li: ListTokenSlot <- body_slots_after_open_brace(rest_after_lbrace_li);
                                (ret_type_li, ret_type_loc_li, parser_ast@empty_effect_name_list(), body_slots_li)
                            end;
                            false -> case first.token.kind == kinds.left_brace or first.token.lexeme == "{" of {
                                true -> do
                                    tr_ir: TupleTypeResult <- parser_tuples@extract_inline_record_type_from_slots(slots);
                                    ret_type_ir: string <- tr_ir.type_str;
                                    ret_type_loc_ir: SourceLocation <- first.token.location;
                                    (effects_ir: ListEffectName, after_effects_ir: ListTokenSlot) <- collect_optional_proc_effects(tr_ir.rest_slots);
                                    rest_after_lbrace_ir: ListTokenSlot <- after_effects_ir.tail;
                                    body_slots_ir: ListTokenSlot <- body_slots_after_open_brace(rest_after_lbrace_ir);
                                    (ret_type_ir, ret_type_loc_ir, parser_ast@empty_effect_name_list(), body_slots_ir)
                                end;
                                false -> case is_type_keyword(kinds, first.token.kind) of {
                                    true -> do
                                        ret_type_loc: SourceLocation <- first.token.location;
                                        rest_after_type: ListTokenSlot <- rest;
                                        (effects: ListEffectName, after_effects: ListTokenSlot) <- collect_optional_proc_effects(rest_after_type);
                                        rest_after_lbrace: ListTokenSlot <- after_effects.tail;
                                        body_slots: ListTokenSlot <- body_slots_after_open_brace(rest_after_lbrace);
                                        from_kind: string <- kind_to_type_name(first.token.kind);
                                        ret_lex: string <- first.token.lexeme;
                                        use_type: string <- case len(from_kind) > 0 of { true -> from_kind; false -> ret_lex };
                                        ret_empty: string <- case ret_lex of { "" -> "ret_empty"; _: string -> "ret_ok" };
                                        from_empty: string <- case from_kind of { "" -> "from_empty"; _: string -> "from_ok" };
                                        use_type_instrumented: string <- case use_type of { "" -> concat("DEBUG:", concat(ret_empty, concat(",", from_empty))); _: string -> use_type };
                                        (use_type_instrumented, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                    end;
                                    false -> do
                                        (ret_type: string, ret_type_loc: SourceLocation, _effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_body(rest);
                                        (ret_type, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                    end
                                }
                            }
                        }
                        }
                    }
                }
            }
            }
        end
    }
    end
}
// Same as find_type_and_body but ends with `;` instead of `{` body (trait required methods).
fn find_type_and_semicolon(slots: ListTokenSlot) -> (string, SourceLocation, ListEffectName, ListTokenSlot) proc[DeviceIO] {
    do
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> do
            zero_loc: SourceLocation <- parser_ast@zero_location();
            empty_effects: ListEffectName <- parser_ast@empty_effect_name_list();
            empty: ListTokenSlot <- constraint_core@empty_list_slot();
            ("", zero_loc, empty_effects, empty)
        end;
        false -> do
            first: TokenSlot <- slots.head;
            rest: ListTokenSlot <- slots.tail;
            top_or_type: TupleTypeResult <- parser_tuples@extract_top_level_or_type_from_slots(slots);
            case len(top_or_type.type_str) > 0 of {
                true -> do
                    (effects_top: ListEffectName, after_effects_top: ListTokenSlot) <- collect_optional_proc_effects(top_or_type.rest_slots);
                    body_slots_top: ListTokenSlot <- body_slots_after_semicolon(after_effects_top);
                    (top_or_type.type_str, first.token.location, parser_ast@empty_effect_name_list(), body_slots_top)
                end;
                false -> case first.token.kind == kinds.ref_keyword or first.token.kind == kinds.region_keyword or first.token.kind == kinds.buf_keyword of {
                true -> do
                    tr: TupleTypeResult <- parser_tuples@extract_parametrized_type_from_slots(slots);
                    ret_type: string <- tr.type_str;
                    ret_type_loc: SourceLocation <- first.token.location;
                    (effects: ListEffectName, after_effects: ListTokenSlot) <- collect_optional_proc_effects(tr.rest_slots);
                    body_slots: ListTokenSlot <- body_slots_after_semicolon(after_effects);
                    from_kind: string <- "";
                    use_type: string <- ret_type;
                    ret_empty: string <- case ret_type of { "" -> "ret_empty"; _: string -> "ret_ok" };
                    from_empty: string <- "from_ok";
                    use_type_instrumented: string <- case use_type of { "" -> concat("DEBUG:", concat(ret_empty, concat(",", from_empty))); _: string -> use_type };
                    (use_type_instrumented, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                end;
                false -> case first.token.kind == kinds.atomic_keyword of {
                    true -> case rest.is_nil of {
                        true -> do
                            (ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_semicolon(rest);
                            (ret_type, ret_type_loc, effects, body_slots)
                        end;
                        false -> case rest.head.token.kind == kinds.ref_keyword of {
                            true -> do
                                tr: TupleTypeResult <- parser_tuples@extract_parametrized_type_from_slots(slots);
                                ret_type: string <- tr.type_str;
                                ret_type_loc: SourceLocation <- first.token.location;
                                (effects: ListEffectName, after_effects: ListTokenSlot) <- collect_optional_proc_effects(tr.rest_slots);
                                body_slots: ListTokenSlot <- body_slots_after_semicolon(after_effects);
                                use_type_instrumented: string <- case ret_type of { "" -> "DEBUG:ref_empty"; _: string -> ret_type };
                                (use_type_instrumented, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                            end;
                            false -> do
                                (ret_type: string, ret_type_loc: SourceLocation, _effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_semicolon(rest);
                                (ret_type, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                            end
                        }
                    };
                    false -> case first.token.kind == kinds.atom_literal of {
                        true -> do
                            ret_type_loc_atom2: SourceLocation <- first.token.location;
                            tr_atom2: TupleTypeResult <- parser_tuples@extract_atom_option_type_from_slots(slots);
                            rest_after_type_atom2: ListTokenSlot <- tr_atom2.rest_slots;
                            (effects_atom2: ListEffectName, after_effects_atom2: ListTokenSlot) <- collect_optional_proc_effects(rest_after_type_atom2);
                            body_slots_atom2: ListTokenSlot <- body_slots_after_semicolon(after_effects_atom2);
                            (tr_atom2.type_str, ret_type_loc_atom2, parser_ast@empty_effect_name_list(), body_slots_atom2)
                        end;
                        false -> case first.token.kind == kinds.left_paren of {
                            true -> do
                                tr: TupleTypeResult <- parser_tuples@extract_tuple_type_from_slots(slots);
                                ret_type: string <- tr.type_str;
                                ret_type_loc: SourceLocation <- first.token.location;
                                (effects: ListEffectName, after_effects: ListTokenSlot) <- collect_optional_proc_effects(tr.rest_slots);
                                body_slots: ListTokenSlot <- body_slots_after_semicolon(after_effects);
                                (ret_type, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                            end;
                            false -> case parser_tuples@slots_start_bracketed_collection_type(slots, kinds) of {
                            true -> do
                                tr_li: TupleTypeResult <- parser_tuples@extract_list_type_from_slots(slots);
                                ret_type_li: string <- tr_li.type_str;
                                ret_type_loc_li: SourceLocation <- first.token.location;
                                (effects_li: ListEffectName, after_effects_li: ListTokenSlot) <- collect_optional_proc_effects(tr_li.rest_slots);
                                body_slots_li: ListTokenSlot <- body_slots_after_semicolon(after_effects_li);
                                (ret_type_li, ret_type_loc_li, parser_ast@empty_effect_name_list(), body_slots_li)
                            end;
                            false -> case first.token.kind == kinds.left_brace or first.token.lexeme == "{" of {
                                true -> do
                                    tr_ir: TupleTypeResult <- parser_tuples@extract_inline_record_type_from_slots(slots);
                                    ret_type_ir: string <- tr_ir.type_str;
                                    ret_type_loc_ir: SourceLocation <- first.token.location;
                                    (effects_ir: ListEffectName, after_effects_ir: ListTokenSlot) <- collect_optional_proc_effects(tr_ir.rest_slots);
                                    body_slots_ir: ListTokenSlot <- body_slots_after_semicolon(after_effects_ir);
                                    (ret_type_ir, ret_type_loc_ir, parser_ast@empty_effect_name_list(), body_slots_ir)
                                end;
                                false -> case is_type_keyword(kinds, first.token.kind) of {
                                    true -> do
                                        ret_type_loc: SourceLocation <- first.token.location;
                                        rest_after_type: ListTokenSlot <- rest;
                                        (effects: ListEffectName, after_effects: ListTokenSlot) <- collect_optional_proc_effects(rest_after_type);
                                        body_slots: ListTokenSlot <- body_slots_after_semicolon(after_effects);
                                        from_kind: string <- kind_to_type_name(first.token.kind);
                                        ret_lex: string <- first.token.lexeme;
                                        use_type: string <- case len(from_kind) > 0 of { true -> from_kind; false -> ret_lex };
                                        ret_empty: string <- case ret_lex of { "" -> "ret_empty"; _: string -> "ret_ok" };
                                        from_empty: string <- case from_kind of { "" -> "from_empty"; _: string -> "from_ok" };
                                        use_type_instrumented: string <- case use_type of { "" -> concat("DEBUG:", concat(ret_empty, concat(",", from_empty))); _: string -> use_type };
                                        (use_type_instrumented, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                    end;
                                    false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, first.token.kind) of {
                                        true -> do
                                            ret_type_loc: SourceLocation <- first.token.location;
                                            rest_after_type: ListTokenSlot <- rest;
                                            (effects: ListEffectName, after_effects: ListTokenSlot) <- collect_optional_proc_effects(rest_after_type);
                                            body_slots: ListTokenSlot <- body_slots_after_semicolon(after_effects);
                                            (first.token.lexeme, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                        end;
                                        false -> do
                                            (ret_type: string, ret_type_loc: SourceLocation, _effects: ListEffectName, body_slots: ListTokenSlot) <- find_type_and_semicolon(rest);
                                            (ret_type, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                        end
                                    }
                                }
                            }
                        }
                        }
                    }
                }
            }
            }
        end
    }
    end
}

// True when token is a public collection trait type name with trailing `[...]` type params.
fn token_is_bracketed_collection_type_name(tok: Token, kinds: TokenKinds) -> bool {
    tok.kind == kinds.list_keyword
}

fn token_is_list_type_name(tok: Token, kinds: TokenKinds) -> bool {
    token_is_bracketed_collection_type_name(tok, kinds)
}


// `List[ { stmts; result }, mem(R) ]` → sequence proc[mem(R)] named `__list_typed_block__` (E3001/E3010).
fn slots_start_list_value_block(slots: ListTokenSlot) -> bool proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> case slots.head.token.kind == kinds.list_keyword of {
            true -> do
                after_kw: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                case after_kw.is_nil of {
                    true -> false;
                    false -> case after_kw.head.token.kind == kinds.left_bracket of {
                        true -> do
                            after_lbr: ListTokenSlot <- skip_leading_whitespace_slots(after_kw.tail);
                            case after_lbr.is_nil of {
                                true -> false;
                                false -> case after_lbr.head.token.kind == kinds.left_brace or after_lbr.head.token.lexeme == "{" of {
                                    true -> case is_struct_literal_lbrace_fallback(after_lbr, kinds) of {
                                        true -> false;
                                        false -> true
                                    };
                                    false -> false
                                }
                            }
                        end;
                        false -> false
                    }
                }
            end;
            false -> false
        }
    }
}

fn extract_list_value_block(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots_start_list_value_block(slots) of {
        false -> (parser_ast@dummy_expr(), slots);
        true -> do
            after_kw: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
            after_lbr: ListTokenSlot <- skip_leading_whitespace_slots(after_kw.tail);
            inner: ListTokenSlot <- after_lbr.tail;
            (body_expr: Expr, rest_after: ListTokenSlot) <- extract_function_body(inner);
            case rest_after.is_nil of {
                true -> (parser_ast@dummy_expr(), slots);
                false -> case rest_after.head.token.kind == kinds.right_brace or rest_after.head.token.lexeme == "}" or constraint_core@slot_role(rest_after.head) == role_right_brace() of {
                    true -> do
                        after_rbrace: ListTokenSlot <- skip_leading_whitespace_slots(rest_after.tail);
                        case after_rbrace.is_nil of {
                            true -> (parser_ast@dummy_expr(), slots);
                            false -> case after_rbrace.head.token.kind == kinds.comma or after_rbrace.head.token.lexeme == "," of {
                                true -> do
                                    after_comma: ListTokenSlot <- skip_leading_whitespace_slots(after_rbrace.tail);
                                    (declared_effects: ListEffectName, rest_final: ListTokenSlot) <- collect_effects_until_right_bracket(after_comma, parser_ast@empty_effect_name_list());
                                    seq_expr: Expr <- Expr { kind: 11, value: "", name: "__list_typed_block__", location: slots.head.token.location, inner: parser_ast@dummy_expr(), right_expr: body_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: declared_effects };
                                    (seq_expr, rest_final)
                                end;
                                false -> (parser_ast@dummy_expr(), slots)
                            }
                        }
                    end;
                    false -> (parser_ast@dummy_expr(), slots)
                }
            }
        end
    }
}


// `[` usually has role_list_lit_lbracket after constraint propagation; if that role is missing, still treat as a
// list literal when the next token clearly starts list elements ([] or an operand or `{` struct), so RHS and
// tuple elements like `(0, [ { a: 1 } ])` do not fall through to extract_expr_with_precedence (E1040).
fn is_list_literal_lbracket_fallback(slots: ListTokenSlot, kinds: TokenKinds) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> case slots.head.token.kind == kinds.left_bracket of {
            true -> case slots.tail.is_nil of {
                true -> false;
                false -> do
                    n: TokenSlot <- slots.tail.head;
                    n.token.kind == kinds.right_bracket or n.token.lexeme == "]" or n.token.kind == kinds.integer_literal or n.token.kind == kinds.float_literal or lexer_token_kind@is_identifier_lexeme_token(kinds, n.token.kind) or n.token.kind == kinds.string_literal or n.token.kind == kinds.true_literal or n.token.kind == kinds.false_literal or n.token.kind == kinds.left_bracket or n.token.kind == kinds.left_brace or n.token.lexeme == "{"
                end
            };
            false -> false
        }
    }
}

// Field name token in struct literal `name: expr` (same head tokens as binding LHS).
// After `.`, allow `end` (lexed as end_keyword) and other keywords that are valid field names
// but not identifier tokens — otherwise `s.end` cannot parse as field access (§3.3.x).
fn is_struct_field_name_token(kinds: TokenKinds, tok: Token) -> bool {
    lexer_token_kind@is_identifier_lexeme_token(kinds, tok.kind) or tok.kind == kinds.buf_keyword or tok.kind == kinds.ref_keyword or tok.kind == kinds.region_keyword or tok.kind == kinds.atomic_keyword or tok.kind == kinds.end_keyword
}

// `{ field: expr, ... }` is a struct literal when the first `ident:` is not a binding (`ident: type <- ...`).
// Also `{}` (empty). Fails closed when `{` is not followed by `ident:` so `{ sequence ... }` and `{ foo( ... }` are not literals.
fn is_struct_literal_lbrace_fallback(slots: ListTokenSlot, kinds: TokenKinds) -> bool proc[DeviceIO] {
    case slots.is_nil of {
        true -> false;
        false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
            true -> case slots.tail.is_nil of {
                true -> false;
                false -> do
                    inner: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                    case inner.is_nil of {
                        true -> false;
                        false -> case inner.head.token.kind == kinds.right_brace or inner.head.token.lexeme == "}" of {
                            true -> true;
                            false -> case is_struct_field_name_token(kinds, inner.head.token) of {
                                true -> case inner.tail.is_nil of {
                                    true -> false;
                                    false -> case inner.tail.head.token.kind == kinds.colon of {
                                        true -> case is_binding_start(inner) of {
                                            true -> false;
                                            false -> true
                                        };
                                        false -> false
                                    }
                                };
                                false -> false
                            }
                        }
                    }
                end
            };
            false -> false
        }
    }
}

fn extract_first_struct_field(slots: ListTokenSlot) -> (string, Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    dummy_bad: Expr <- parser_ast@dummy_expr();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> ("", dummy_bad, slots);
        false -> case trimmed.head.token.kind == kinds.right_brace or trimmed.head.token.lexeme == "}" of {
            true -> ("", dummy_bad, trimmed);
            false -> case is_struct_field_name_token(kinds, trimmed.head.token) of {
                false -> ("", dummy_bad, slots);
                true -> do
                    field_name: string <- trimmed.head.token.lexeme;
                    after_name: ListTokenSlot <- trimmed.tail;
                    case after_name.is_nil of {
                        true -> ("", dummy_bad, slots);
                        false -> case after_name.head.token.kind == kinds.colon of {
                            true -> do
                                after_colon: ListTokenSlot <- after_name.tail;
                                (val: Expr, rest_after_val: ListTokenSlot) <- extract_body(after_colon);
                                (field_name, val, rest_after_val)
                            end;
                            false -> ("", dummy_bad, slots)
                        }
                    }
                end
            }
        }
    }
}

// Right-nested kind-21 chain (§3.3.7); last node has right_expr = dummy.
// `extract_body` may return leading whitespace before `}` or `,`; trim before dispatch so
// `{ field: val }` (space before `}`) does not fall through to the dummy branch and leave
// the closing `}` unconsumed in the token stream.
fn extract_struct_fields_tail(field_name: string, field_val: Expr, rest_after_val: ListTokenSlot, lbrace_loc: SourceLocation) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    dummy: Expr <- parser_ast@dummy_expr();
    rest: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_val);
    case rest.is_nil of {
        true -> (dummy, rest);
        false -> case rest.head.token.kind == kinds.right_brace or rest.head.token.lexeme == "}" of {
            true -> do
                leaf: Expr <- Expr { kind: 21, value: "", name: field_name, location: lbrace_loc, inner: field_val, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (leaf, rest.tail)
            end;
            false -> case rest.head.token.kind == kinds.comma of {
                true -> case rest.tail.is_nil of {
                    true -> do
                        sentinel: Expr <- Expr { kind: 999, value: "struct_trailing_comma", name: "", location: lbrace_loc, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (sentinel, rest)
                    end;
                    false -> case rest.tail.head.token.kind == kinds.right_brace or rest.tail.head.token.lexeme == "}" of {
                        true -> do
                            sentinel2: Expr <- Expr { kind: 999, value: "struct_trailing_comma", name: "", location: lbrace_loc, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            (sentinel2, rest.tail)
                        end;
                        false -> do
                            (next_name: string, next_val: Expr, rest2: ListTokenSlot) <- extract_first_struct_field(rest.tail);
                            case len(next_name) == 0 of {
                                true -> (dummy, rest);
                                false -> do
                                    (sub: Expr, rest3: ListTokenSlot) <- extract_struct_fields_tail(next_name, next_val, rest2, lbrace_loc);
                                    node: Expr <- Expr { kind: 21, value: "", name: field_name, location: lbrace_loc, inner: field_val, right_expr: sub, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                    (node, rest3)
                                end
                            }
                        end
                    }
                };
                false -> (dummy, rest)
            }
        }
    }
}

fn extract_struct_literal(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    lbrace_loc: SourceLocation <- slots.head.token.location;
    after_open: ListTokenSlot <- slots.tail;
    (f_name: string, f_val: Expr, rest1: ListTokenSlot) <- extract_first_struct_field(after_open);
    case len(f_name) == 0 of {
        true -> do
            inner_ws: ListTokenSlot <- skip_leading_whitespace_slots(after_open);
            case inner_ws.is_nil of {
                true -> (parser_ast@dummy_expr(), slots);
                false -> case inner_ws.head.token.kind == kinds.right_brace or inner_ws.head.token.lexeme == "}" of {
                    true -> (parser_ast@dummy_expr(), inner_ws.tail);
                    false -> (parser_ast@dummy_expr(), slots)
                }
            }
        end;
        false -> do
            (tree: Expr, rest_final: ListTokenSlot) <- extract_struct_fields_tail(f_name, f_val, rest1, lbrace_loc);
            (tree, rest_final)
        end
    }
}

// ident : List[ ... ] <- (list type is not a single type_keyword token)
fn is_list_type_binding_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> case slots.tail.tail.is_nil of {
                true -> false;
                false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slots.head.token.kind) or slots.head.token.kind == kinds.ref_keyword or slots.head.token.kind == kinds.buf_keyword or slots.head.token.kind == kinds.region_keyword of {
                    true -> case slots.tail.head.token.kind == kinds.colon of {
                        true -> do
                            ac: ListTokenSlot <- slots_after_binding_colon(slots);
                            case ac.is_nil of {
                                true -> false;
                                false -> case parser_tuples@slots_start_bracketed_collection_type(ac, kinds) of {
                                    true -> true;
                                    false -> false
                                }
                            }
                        end;
                        false -> false
                    };
                    false -> false
                }
            }
        }
    }
}

// `ident : fn(T,) -> R <-` (function type in annotation position): fn-token type without lambda-shaped params,
// and `<-` follows the full type. Not `ident : fn(x: T) -> R {` (lambda expression / struct field).
fn binding_start_fn_type(slots: ListTokenSlot) -> bool proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    ac_kw: ListTokenSlot <- slots_after_binding_colon(slots);
    case parser_tuples@slots_start_fn_type(ac_kw) of {
        false -> false;
        true -> case lambda_introduces_body_after_sig(ac_kw) of {
            true -> false;
            false -> do
                (_: string, rest_after_fn_ty: ListTokenSlot) <- parser_tuples@extract_fn_type_from_slots(ac_kw);
                trimmed: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_fn_ty);
                case trimmed.is_nil of {
                    true -> false;
                    false -> trimmed.head.token.kind == kinds.left_arrow
                }
            end
        }
    }
}

// Check if slots start with binding pattern: ident : type <- or ident : ( tuple type
fn is_binding_start(slots: ListTokenSlot) -> bool proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> case slots.tail.tail.is_nil of {
                true -> false;
                false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slots.head.token.kind) or slots.head.token.kind == kinds.ref_keyword or slots.head.token.kind == kinds.buf_keyword or slots.head.token.kind == kinds.region_keyword of {
                    true -> case slots.tail.head.token.kind == kinds.colon of {
                        true -> case is_list_type_binding_start(slots) of {
                            true -> true;
                            false -> case parser_tuples@is_struct_type_binding_start(slots) of {
                                true -> true;
                                false -> do
                                    ac_kw: ListTokenSlot <- slots_after_binding_colon(slots);
                                    case ac_kw.is_nil of {
                                        true -> false;
                                        false -> case is_type_keyword(kinds, ac_kw.head.token.kind) of {
                                            true -> case ac_kw.tail.is_nil of {
                                                true -> false;
                                                false -> case ac_kw.tail.head.token.kind == kinds.left_arrow of {
                                                    true -> true;
                                                    false -> case parser_tuples@is_memory_region_type_binding_start(slots) of {
                                                        true -> true;
                                                        false -> parser_tuples@is_tuple_type_binding_start(slots)
                                                    }
                                                }
                                            };
                                            false -> case parser_tuples@atom_option_binding_has_arrow_after_type(ac_kw) of {
                                                true -> true;
                                                false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, ac_kw.head.token.kind)
                                                    and ac_kw.tail.is_nil == false
                                                    and ac_kw.tail.head.token.kind == kinds.left_arrow of {
                                                    // Compiler-instantiated library code uses
                                                    // identifier placeholders (AccType, ItemType,
                                                    // ActorState, ...).  They are valid annotation
                                                    // syntax at local bind sites just as they are in
                                                    // function parameters and returns.  Resolution
                                                    // remains the type checker's responsibility.
                                                    true -> true;
                                                    false -> case binding_start_fn_type(slots) of {
                                                        true -> true;
                                                        false -> case parser_tuples@is_memory_region_type_binding_start(slots) of {
                                                            true -> true;
                                                            false -> parser_tuples@is_tuple_type_binding_start(slots)
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                end
                            }
                        };
                        false -> false
                    };
                    false -> false
                }
            }
        }
    }
}

fn skip_semicolons(slots: ListTokenSlot) -> ListTokenSlot {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.lexeme == ";" of {
            true -> skip_semicolons(slots.tail);
            false -> slots
        }
    }
}

// Skip leading whitespace tokens (space, tab, newline) so " produces" becomes "produces"
fn skip_leading_whitespace_slots(slots: ListTokenSlot) -> ListTokenSlot {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.lexeme == " " or slots.head.token.lexeme == "\t" or slots.head.token.lexeme == "\n" or slots.head.token.lexeme == "\r" of {
            true -> skip_leading_whitespace_slots(slots.tail);
            false -> slots
        }
    }
}

// Newline may appear between the RHS and `;`; skip leading whitespace before consuming semicolons.
fn skip_semicolons_after_whitespace(slots: ListTokenSlot) -> ListTokenSlot {
    skip_semicolons(skip_leading_whitespace_slots(slots))
}

// After `ident :`, lexer may emit space/newline before the type token or `(`/ `{`/`List`. Consumers that
// used slots.tail.tail as the immediate post-`:` stream must skip so list/tuple/struct/bindings classify
// and extract correctly ("children: \\n List[").
fn slots_after_binding_colon(slots: ListTokenSlot) -> ListTokenSlot {
    skip_leading_whitespace_slots(slots.tail.tail)
}

// After `ident : Type <- rhs`, rest_slots after the type may have leading whitespace before `<-`;
// skip to the RHS (also used for tuple and list binding types, not only ref/region/buf).
fn rhs_slots_after_memory_region_type(rest_after_type: ListTokenSlot) -> ListTokenSlot {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_type);
    case trimmed.is_nil of {
        true -> trimmed;
        false -> case trimmed.head.token.kind == kinds.left_arrow of {
            true -> trimmed.tail;
            false -> trimmed
        }
    }
}

fn slots_tail(slots: ListTokenSlot) -> ListTokenSlot {
    slots.tail
}

fn slots_is_nil(slots: ListTokenSlot) -> bool {
    slots.is_nil
}

fn slots_head(slots: ListTokenSlot) -> TokenSlot {
    slots.head
}

// Operator precedence. Higher = binds tighter.
// multiplicative (*, /, %) = 6; additive (+, -) = 5; shift = 4; band = 3; bor = 2; comparison (<, >, ...) = 1; logical (and, or) = 0.
// Comparisons must bind tighter than `and`/`or` so guards like `n >= 0 and n < 100` parse as
// `(n >= 0) and (n < 100)`, not `(n >= 0) and n` with stray `< 100`.
fn op_precedence(lexeme: string) -> int64 {
    case lexeme of {
        "*" -> 6;
        "/" -> 6;
        "%" -> 6;
        "+" -> 5;
        "-" -> 5;
        "shl" -> 4;
        "shr" -> 4;
        "band" -> 3;
        "bor" -> 2;
        "<" -> 1;
        ">" -> 1;
        "<=" -> 1;
        ">=" -> 1;
        "==" -> 1;
        "!=" -> 1;
        "and" -> 0;
        "or" -> 0;
        _: string -> 0
    }
}

fn extract_binding(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    case parser_tuples@is_memory_region_type_binding_start(slots) of {
        true -> extract_binding_memory_region(slots);
        false -> case parser_tuples@is_tuple_type_binding_start(slots) of {
            true -> extract_binding_tuple(slots);
            false -> case parser_tuples@binding_starts_paren_tuple_type_after_colon(slots) of {
                true -> extract_binding_tuple(slots);
                false -> case is_list_type_binding_start(slots) of {
                    true -> extract_binding_list(slots);
                    false -> case parser_tuples@is_struct_type_binding_start(slots) of {
                        true -> extract_binding_struct(slots);
                        false -> extract_binding_simple(slots)
                    }
                }
            }
        }
    }
}

// Like extract_binding but uses extract_sequence_body for continuation (stops at stop_kind, e.g. produces).
fn extract_binding_for_sequence(slots: ListTokenSlot, stop_kind: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    case slots.is_nil of {
        true -> do
            dummy_err: Expr <- parser_ast@dummy_expr();
            (dummy_err, constraint_core@empty_list_slot())
        end;
        false -> case parser_tuples@is_memory_region_type_binding_start(slots) of {
            true -> extract_binding_memory_region_for_sequence(slots, stop_kind);
        false -> case parser_tuples@is_tuple_type_binding_start(slots) of {
            true -> extract_binding_tuple_for_sequence(slots, stop_kind);
            false -> case parser_tuples@binding_starts_paren_tuple_type_after_colon(slots) of {
                true -> extract_binding_tuple_for_sequence(slots, stop_kind);
                false -> case is_list_type_binding_start(slots) of {
                    true -> extract_binding_list_for_sequence(slots, stop_kind);
                    false -> case parser_tuples@is_struct_type_binding_start(slots) of {
                        true -> extract_binding_struct_for_sequence(slots, stop_kind);
                        false -> extract_binding_simple_for_sequence(slots, stop_kind)
                    }
                }
            }
        }
        }
    }
}

fn extract_binding_tuple(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        ident_slot: TokenSlot <- slots.head;
        tuple_slots: ListTokenSlot <- slots_after_binding_colon(slots);
        tr: TupleTypeResult <- parser_tuples@extract_tuple_type_from_slots(tuple_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: SourceLocation <- ident_slot.token.location;
        case parser_tuples@is_single_element_tuple_type(bind_type) of {
            true -> do
                dummy: Expr <- parser_ast@dummy_expr();
                sentinel: Expr <- Expr { kind: 998, value: "single_tuple_type", name: "", location: bind_loc, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
                (_: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
                (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(after_semicolons);
                (sentinel, rest_after_body)
            end;
            false -> do
                rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
                (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
                (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(after_semicolons);
                dummy: Expr <- parser_ast@dummy_expr();
                let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (let_expr, rest_after_body)
            end
        }
    end
}

fn extract_binding_tuple_for_sequence(slots: ListTokenSlot, stop_kind: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        ident_slot: TokenSlot <- slots.head;
        tuple_slots: ListTokenSlot <- slots_after_binding_colon(slots);
        tr: TupleTypeResult <- parser_tuples@extract_tuple_type_from_slots(tuple_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: SourceLocation <- ident_slot.token.location;
        case parser_tuples@is_single_element_tuple_type(bind_type) of {
            true -> do
                dummy: Expr <- parser_ast@dummy_expr();
                sentinel: Expr <- Expr { kind: 998, value: "single_tuple_type", name: "", location: bind_loc, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
                (_: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
                (body: Expr, rest_after_body: ListTokenSlot) <- extract_sequence_body(after_semicolons, stop_kind);
                (sentinel, rest_after_body)
            end;
            false -> do
                rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
                (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                (let_expr: Expr, rest_after_body: ListTokenSlot) <- sequence_body_after_binding_rhs(rest_after_rhs, stop_kind, bind_type, bind_name, bind_loc, rhs_expr);
                (let_expr, rest_after_body)
            end
        }
    end
}

fn extract_binding_memory_region(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        ident_slot: TokenSlot <- slots.head;
        type_slots: ListTokenSlot <- slots_after_binding_colon(slots);
        tr: TupleTypeResult <- parser_tuples@extract_parametrized_type_from_slots(type_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: SourceLocation <- ident_slot.token.location;
        rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
        after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
        (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(after_semicolons);
        dummy: Expr <- parser_ast@dummy_expr();
        let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
        (let_expr, rest_after_body)
    end
}

fn extract_binding_memory_region_for_sequence(slots: ListTokenSlot, stop_kind: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        ident_slot: TokenSlot <- slots.head;
        type_slots: ListTokenSlot <- slots_after_binding_colon(slots);
        tr: TupleTypeResult <- parser_tuples@extract_parametrized_type_from_slots(type_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: SourceLocation <- ident_slot.token.location;
        rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
        (let_expr: Expr, rest_after_body: ListTokenSlot) <- sequence_body_after_binding_rhs(rest_after_rhs, stop_kind, bind_type, bind_name, bind_loc, rhs_expr);
        (let_expr, rest_after_body)
    end
}

// After `ident : fn(...) <- rhs` where rhs is a lambda `{ ... }`, extract_body leaves the stream at the
// lambda's closing `}`. Consume it before parsing the enclosing binding's continuation (`;` + body).
// Otherwise `}` is parsed as the next expression (bogus let _ <- `}`).
fn consume_optional_leading_right_brace(slots: ListTokenSlot) -> ListTokenSlot {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> trimmed;
        false -> case trimmed.head.token.kind == kinds.right_brace of {
            true -> trimmed.tail;
            false -> trimmed
        }
    }
}

fn extract_binding_simple(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        kinds: TokenKinds <- lexer_token_kind@token_kinds();
        ident_slot: TokenSlot <- slots.head;
        ac: ListTokenSlot <- slots_after_binding_colon(slots);
        case ac.is_nil of {
            true -> do
                dummy_err: Expr <- parser_ast@dummy_expr();
                (dummy_err, constraint_core@empty_list_slot())
            end;
            false -> case parser_tuples@slots_start_fn_type(ac) of {
                true -> do
                    (fn_ty_str: string, rest_after_fn_ty: ListTokenSlot) <- parser_tuples@extract_fn_type_from_slots(ac);
                    bind_name: string <- ident_slot.token.lexeme;
                    bind_type: string <- fn_ty_str;
                    bind_loc: SourceLocation <- ident_slot.token.location;
                    rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(rest_after_fn_ty);
                    (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                    after_rhs_brace: ListTokenSlot <- consume_optional_leading_right_brace(rest_after_rhs);
                    after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(after_rhs_brace);
                    (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(after_semicolons);
                    let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    (let_expr, rest_after_body)
                end;
                false -> case ac.head.token.kind == kinds.atom_literal of {
                    true -> do
                        tr_atom_bind: TupleTypeResult <- parser_tuples@extract_atom_option_type_from_slots(ac);
                        bind_name: string <- ident_slot.token.lexeme;
                        bind_type: string <- tr_atom_bind.type_str;
                        bind_loc: SourceLocation <- ident_slot.token.location;
                        rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr_atom_bind.rest_slots);
                        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                        after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
                        (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(after_semicolons);
                        let_expr2: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (let_expr2, rest_after_body)
                    end;
                    false -> do
                        type_slot: TokenSlot <- ac.head;
                        after_type: ListTokenSlot <- ac.tail;
                        rhs_slots: ListTokenSlot <- case after_type.is_nil of {
                            true -> constraint_core@empty_list_slot();
                            false -> case after_type.head.token.kind == kinds.left_arrow of {
                                true -> after_type.tail;
                                false -> constraint_core@empty_list_slot()
                            }
                        };
                        bind_name: string <- ident_slot.token.lexeme;
                        bind_type: string <- case is_type_keyword(lexer_token_kind@token_kinds(), type_slot.token.kind) of {
                            true -> do
                                from_k: string <- kind_to_type_name(type_slot.token.kind);
                                case len(from_k) > 0 of { true -> from_k; false -> type_slot.token.lexeme }
                            end;
                            false -> type_slot.token.lexeme
                        };
                        bind_loc: SourceLocation <- ident_slot.token.location;
                        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                        after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
                        (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(after_semicolons);
                        let_expr2: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (let_expr2, rest_after_body)
                    end
                }
            }
        }
    end
}

fn extract_binding_simple_for_sequence(slots: ListTokenSlot, stop_kind: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        kinds: TokenKinds <- lexer_token_kind@token_kinds();
        ident_slot: TokenSlot <- slots.head;
        ac: ListTokenSlot <- slots_after_binding_colon(slots);
        case ac.is_nil of {
            true -> do
                dummy_err: Expr <- parser_ast@dummy_expr();
                (dummy_err, constraint_core@empty_list_slot())
            end;
            false -> case parser_tuples@slots_start_fn_type(ac) of {
                true -> do
                    (fn_ty_str2: string, rest_after_fn_ty2: ListTokenSlot) <- parser_tuples@extract_fn_type_from_slots(ac);
                    bind_name: string <- ident_slot.token.lexeme;
                    bind_type: string <- fn_ty_str2;
                    bind_loc: SourceLocation <- ident_slot.token.location;
                    rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(rest_after_fn_ty2);
                    (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                    after_rhs_brace_seq: ListTokenSlot <- consume_optional_leading_right_brace(rest_after_rhs);
                    (let_expr: Expr, rest_after_body: ListTokenSlot) <- sequence_body_after_binding_rhs(after_rhs_brace_seq, stop_kind, bind_type, bind_name, bind_loc, rhs_expr);
                    (let_expr, rest_after_body)
                end;
                false -> case ac.head.token.kind == kinds.atom_literal of {
                    true -> do
                        tr_atom_bind2: TupleTypeResult <- parser_tuples@extract_atom_option_type_from_slots(ac);
                        bind_name: string <- ident_slot.token.lexeme;
                        bind_type: string <- tr_atom_bind2.type_str;
                        bind_loc: SourceLocation <- ident_slot.token.location;
                        rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr_atom_bind2.rest_slots);
                        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                        (let_expr2: Expr, rest_after_body: ListTokenSlot) <- sequence_body_after_binding_rhs(rest_after_rhs, stop_kind, bind_type, bind_name, bind_loc, rhs_expr);
                        (let_expr2, rest_after_body)
                    end;
                    false -> do
                        type_slot: TokenSlot <- ac.head;
                        after_type: ListTokenSlot <- ac.tail;
                        rhs_slots: ListTokenSlot <- case after_type.is_nil of {
                            true -> constraint_core@empty_list_slot();
                            false -> case after_type.head.token.kind == kinds.left_arrow of {
                                true -> after_type.tail;
                                false -> constraint_core@empty_list_slot()
                            }
                        };
                        bind_name: string <- ident_slot.token.lexeme;
                        bind_type: string <- case is_type_keyword(lexer_token_kind@token_kinds(), type_slot.token.kind) of {
                            true -> do
                                from_k2: string <- kind_to_type_name(type_slot.token.kind);
                                case len(from_k2) > 0 of { true -> from_k2; false -> type_slot.token.lexeme }
                            end;
                            false -> type_slot.token.lexeme
                        };
                        bind_loc: SourceLocation <- ident_slot.token.location;
                        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                        (let_expr2: Expr, rest_after_body: ListTokenSlot) <- sequence_body_after_binding_rhs(rest_after_rhs, stop_kind, bind_type, bind_name, bind_loc, rhs_expr);
                        (let_expr2, rest_after_body)
                    end
                }
            }
        }
    end
}

// Illegal trailing `;` after the tail expression of a block or before `produces` / `end` where the grammar omits `;`.
fn trailing_semicolon_marker(semi_loc: SourceLocation, tail_statement: Expr) -> Expr {
    dummy: Expr <- parser_ast@dummy_expr();
    Expr { kind: 997, value: "E1041", name: "", location: semi_loc, inner: tail_statement, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
}

// After `ident : T <- rhs` in a sequence proc region: continuation body, or E1041 if `;` appears before `produces`.
fn sequence_body_after_binding_rhs(rest_after_rhs: ListTokenSlot, stop_kind: int64, bind_type: string, bind_name: string, bind_loc: SourceLocation, rhs_expr: Expr) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    after_rhs_w: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_rhs);
    case after_rhs_w.is_nil of {
        true -> do
            (body: Expr, rest_after_body: ListTokenSlot) <- extract_sequence_body(skip_semicolons_after_whitespace(rest_after_rhs), stop_kind);
            let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
            (let_expr, rest_after_body)
        end;
        false -> case after_rhs_w.head.token.lexeme == ";" of {
            true -> do
                after_semis: ListTokenSlot <- skip_semicolons_after_whitespace(after_rhs_w);
                bound: ListTokenSlot <- skip_leading_whitespace_slots(after_semis);
                case bound.is_nil of {
                    true -> do
                        binding_stmt: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: parser_ast@dummy_expr(), pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        err_wrap: Expr <- trailing_semicolon_marker(after_rhs_w.head.token.location, binding_stmt);
                        let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: err_wrap, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (let_expr, bound)
                    end;
                    false -> case bound.head.token.kind == stop_kind or bound.head.token.lexeme == "produces" of {
                        true -> do
                            binding_stmt: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: parser_ast@dummy_expr(), pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            err_wrap: Expr <- trailing_semicolon_marker(after_rhs_w.head.token.location, binding_stmt);
                            let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: err_wrap, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            (let_expr, bound)
                        end;
                        false -> do
                            (body: Expr, rest_after_body: ListTokenSlot) <- extract_sequence_body(after_semis, stop_kind);
                            let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            (let_expr, rest_after_body)
                        end
                    }
                }
            end;
            false -> do
                (body: Expr, rest_after_body: ListTokenSlot) <- extract_sequence_body(skip_semicolons_after_whitespace(rest_after_rhs), stop_kind);
                let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (let_expr, rest_after_body)
            end
        }
    }
}

// Chain first_expr with rest_body: if first_expr is a let or tuple_decompose, chain rest_body into its continuation (so we keep the body and add rest_body after it);
// otherwise wrap first_expr in a let _ : unit <- first_expr in rest_body so the statement executes before the return.
fn wrap_let_or_return(expr: Expr, rest_body: Expr) -> Expr {
    case expr.kind == 6 of {
        true -> do
            new_continuation: Expr <- wrap_let_or_return(expr.right_expr, rest_body);
            Expr { kind: 6, value: expr.value, name: expr.name, location: expr.location, inner: expr.inner, right_expr: new_continuation, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
        end;
        false -> case expr.kind == 10 of {
            true -> do
                new_continuation: Expr <- wrap_let_or_return(expr.right_expr, rest_body);
                Expr { kind: 10, value: expr.value, name: expr.name, location: expr.location, inner: expr.inner, right_expr: new_continuation, pattern_bindings: parser_ast@as_list_tuple_decompose_bindings(expr.pattern_bindings), sequence_effects: parser_ast@empty_effect_name_list() }
            end;
            false -> Expr { kind: 6, value: "unit", name: "_", location: expr.location, inner: expr, right_expr: rest_body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
        }
    }
}

// True when the next non-whitespace token can open another statement/expression in a block.
// Used to distinguish a genuine missing `;` (E1040) from an uncategorized defect (E1000).
fn next_token_starts_statement(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> do
            tok_kind: int64 <- slots.head.token.kind;
            lex: string <- slots.head.token.lexeme;
            lexer_token_kind@is_identifier_lexeme_token(kinds, tok_kind)
                or tok_kind == kinds.integer_literal
                or tok_kind == kinds.float_literal
                or tok_kind == kinds.string_literal
                or tok_kind == kinds.atom_literal
                or tok_kind == kinds.left_paren or lex == "("
                or tok_kind == kinds.left_bracket or lex == "["
                or tok_kind == kinds.left_brace or lex == "{"
                or tok_kind == kinds.sequence_keyword or lex == "sequence"
                or tok_kind == kinds.case_keyword or lex == "case"
                or tok_kind == kinds.if_keyword or lex == "if"
                or tok_kind == kinds.minus or lex == "-"
                or tok_kind == kinds.bnot_keyword or lex == "bnot"
                or tok_kind == kinds.ref_keyword or lex == "ref"
                or tok_kind == kinds.buf_keyword or lex == "buf"
                or tok_kind == kinds.region_keyword or lex == "region"
        end
    }
}

fn uncategorized_syntax_defect_message() -> string {
    concat(
        "There is an uncategorized syntactic defect in the code you are working on. If you are an LLM or other AI agent:\n\n",
        concat(
            "1) Defect Location: the syntactic defect location provided on a line in the file prior to the line indicated in the error.\n",
            concat(
                "2) Find: Find the location of the actual syntactic defect's location and cause. You may use the Silica language specification document (silica-specification.md) as well as adding temporary debugging print statements to the silica-compiler source code. If the locations of these are not in your current chat data, ask the user for those locations.\n",
                concat(
                    "3) Suggest: Using the actual location and cause, suggest to your user changes that could be made to the compiler, Continuous Integration trials that could be added to the trials/error_enforcement_addition directory and an addition to or modification of the syntactic defect descriptions found in error_codes.md based on the groupings found in error_codes.jsonld.\n",
                    concat(
                        "4) Instructions to give to your user:\n",
                        concat(
                            "A) Do you want me to make the suggested changes to the silica-compiler source code and the trials directory?\n",
                            concat(
                                "B) Ensure all the Continuous Integration trials found in the trials directory still pass and the new ones added are correct and pass.\n",
                                "C) Ensure there is no enhancement request for the suggested addition at https://github.com/yenrab/silica/issues?q=is%3Aissue+is%3Aopen+label%3Aenhancement. If there is not, add one and submit a self-closing pull request."
                            )
                        )
                    )
                )
            )
        )
    )
}

// Parse recovery: mark missing `;` between first_expr and the next statement; inner holds the recovered let-chain.
fn missing_statement_terminator_wrapper(err_loc: SourceLocation, first_expr: Expr, rest_body: Expr) -> Expr {
    dummy: Expr <- parser_ast@dummy_expr();
    glued: Expr <- wrap_let_or_return(first_expr, rest_body);
    Expr { kind: 996, value: "E1040", name: "", location: err_loc, inner: glued, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
}

// Parse recovery: uncategorized syntactic defect when the next token does not look like a new statement.
fn uncategorized_syntax_defect_wrapper(err_loc: SourceLocation, first_expr: Expr, rest_body: Expr) -> Expr {
    dummy: Expr <- parser_ast@dummy_expr();
    glued: Expr <- wrap_let_or_return(first_expr, rest_body);
    Expr { kind: 995, value: "E1000", name: "", location: err_loc, inner: glued, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
}

// Choose E1040 when the next token starts another statement; otherwise E1000 catch-all.
fn statement_boundary_error_wrapper(err_loc: SourceLocation, first_expr: Expr, rest_body: Expr, after_trim: ListTokenSlot) -> Expr {
    case next_token_starts_statement(after_trim) of {
        true -> missing_statement_terminator_wrapper(err_loc, first_expr, rest_body);
        false -> uncategorized_syntax_defect_wrapper(err_loc, first_expr, rest_body)
    }
}


// Parse function body: multiple statements separated by ; allowed; the last expression before } is the return value.
// Preceding let-bindings are chained so their scope includes the return expression.
fn extract_function_body(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    (first_expr: Expr, after_first: ListTokenSlot) <- extract_body(trimmed);
    extract_function_body_tail(first_expr, after_first)
}

// Tail helper: after_first is passed as ListTokenSlot parameter so codegen does not confuse it with tuple element types.
fn extract_function_body_tail(first_expr: Expr, after_first: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    after_trim: ListTokenSlot <- skip_leading_whitespace_slots(after_first);
    case after_trim.is_nil of {
        true -> (first_expr, after_trim);
        false -> case after_trim.head.token.kind == kinds.right_brace of {
            true -> (first_expr, after_trim);
            false -> case after_trim.head.token.lexeme == ";" of {
                true -> do
                    rest: ListTokenSlot <- skip_semicolons_after_whitespace(after_trim);
                    rest_w: ListTokenSlot <- skip_leading_whitespace_slots(rest);
                    case rest_w.is_nil of {
                        true -> do
                            semi_slot: TokenSlot <- after_trim.head;
                            marked: Expr <- trailing_semicolon_marker(semi_slot.token.location, first_expr);
                            (marked, rest_w)
                        end;
                        false -> case rest_w.head.token.kind == kinds.right_brace of {
                            true -> do
                                semi_slot: TokenSlot <- after_trim.head;
                                marked: Expr <- trailing_semicolon_marker(semi_slot.token.location, first_expr);
                                (marked, rest_w)
                            end;
                            false -> do
                                (rest_body: Expr, rest_after: ListTokenSlot) <- extract_function_body(rest_w);
                                body: Expr <- wrap_let_or_return(first_expr, rest_body);
                                (body, rest_after)
                            end
                        }
                    }
                end;
                false -> case first_expr.kind < 0 of {
                    true -> (first_expr, after_trim);
                    false -> do
                        diag_loc: SourceLocation <- first_expr.location;
                        (rest_body: Expr, rest_after: ListTokenSlot) <- extract_function_body(after_trim);
                        body: Expr <- statement_boundary_error_wrapper(diag_loc, first_expr, rest_body, after_trim);
                        (body, rest_after)
                    end
                }
            }
        }
    }
}

// Parse sequence body (statements between proc[ε] and produces) as a let chain. Stops at stop_kind (produces_keyword).
fn extract_sequence_body(slots: ListTokenSlot, stop_kind: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    // After a binding RHS, callers skip semicolons; align entry so stray leading `;` does not
    // reach extract_body (which would mis-parse and break the sequence → dummy main / MOV #0).
    slots_tr: ListTokenSlot <- skip_semicolons_after_whitespace(slots);
    case slots_tr.is_nil of {
        true -> do
            dummy: Expr <- parser_ast@dummy_expr();
            (dummy, slots_tr)
        end;
        false -> case slots_tr.head.token.kind == stop_kind or slots_tr.head.token.lexeme == "produces" of {
            true -> do
                dummy: Expr <- parser_ast@dummy_expr();
                (dummy, slots_tr)
            end;
            false -> case is_binding_start(slots_tr) of {
                true -> extract_binding_for_sequence(slots_tr, stop_kind);
                false -> case parser_tuples@binding_starts_paren_tuple_type_after_colon(slots_tr) of {
                    true -> extract_binding_for_sequence(slots_tr, stop_kind);
                    false -> case slots_tr.head.token.kind == kinds.left_paren of {
                        true -> do
                            (td_expr: Expr, td_rest: ListTokenSlot) <- extract_tuple_decompose_for_sequence(slots_tr, stop_kind);
                            case td_expr.kind == 10 of {
                                true -> (td_expr, td_rest);
                                false -> do
                                    (first_expr: Expr, after_first: ListTokenSlot) <- extract_body(slots_tr);
                                    extract_sequence_body_tail(first_expr, after_first, stop_kind)
                                end
                            }
                        end;
                        false -> do
                            (first_expr: Expr, after_first: ListTokenSlot) <- extract_body(slots_tr);
                            extract_sequence_body_tail(first_expr, after_first, stop_kind)
                        end
                    }
                }
            }
        }
    }
}

// Like `extract_function_body_tail`, skip newline/indent before `;` or `produces` so the last proc
// statement does not require `;` when `produces` begins on the next line.
fn extract_sequence_body_tail(first_expr: Expr, after_first: ListTokenSlot, stop_kind: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    after_trim: ListTokenSlot <- skip_leading_whitespace_slots(after_first);
    case after_trim.is_nil of {
        true -> (first_expr, after_trim);
        false -> case after_trim.head.token.kind == stop_kind or after_trim.head.token.lexeme == "produces" of {
            true -> case first_expr.kind < 0 of {
                true -> (first_expr, after_trim);
                false -> do
                    dummy: Expr <- parser_ast@dummy_expr();
                    body: Expr <- wrap_let_or_return(first_expr, dummy);
                    (body, after_trim)
                end
            };
            false -> case after_trim.head.token.lexeme == ";" of {
                true -> do
                    rest: ListTokenSlot <- skip_semicolons_after_whitespace(after_trim);
                    case rest.is_nil of {
                        true -> do
                            semi_slot: TokenSlot <- after_trim.head;
                            marked: Expr <- trailing_semicolon_marker(semi_slot.token.location, first_expr);
                            (marked, rest)
                        end;
                        false -> case rest.head.token.kind == stop_kind or rest.head.token.lexeme == "produces" of {
                            true -> do
                                semi_slot: TokenSlot <- after_trim.head;
                                marked: Expr <- trailing_semicolon_marker(semi_slot.token.location, first_expr);
                                (marked, rest)
                            end;
                            false -> do
                                (rest_body: Expr, rest_after: ListTokenSlot) <- extract_sequence_body(rest, stop_kind);
                                body: Expr <- case rest_body.kind < 0 of {
                                    true -> first_expr;
                                    false -> wrap_let_or_return(first_expr, rest_body)
                                };
                                (body, rest_after)
                            end
                        }
                    }
                end;
                false -> case first_expr.kind < 0 of {
                    true -> (first_expr, after_trim);
                    false -> do
                        diag_loc: SourceLocation <- first_expr.location;
                        (rest_body: Expr, rest_after: ListTokenSlot) <- extract_sequence_body(after_trim, stop_kind);
                        body: Expr <- statement_boundary_error_wrapper(diag_loc, first_expr, rest_body, after_trim);
                        (body, rest_after)
                    end
                }
            }
        }
    }
}

// kind 10: value is "" or whole-pattern tuple type string when `(p): (T1, T2) <- rhs` (see check_tuple_decompose).
fn tuple_decompose_build_expr(lparen_slot: TokenSlot, rhs_expr: Expr, body: Expr, td_result: TupleDecomposeResult, ann_type_str: string) -> Expr {
    Expr { kind: 10, value: ann_type_str, name: "", location: lparen_slot.token.location, inner: rhs_expr, right_expr: body, pattern_bindings: parser_tuples@get_bindings_for_ast(td_result), sequence_effects: parser_ast@empty_effect_name_list() }
}

fn extract_tuple_decompose_sequence_after_rhs(lparen_slot: TokenSlot, td_result: TupleDecomposeResult, rhs_expr: Expr, rest_after_rhs: ListTokenSlot, stop_kind: int64, ann_type_str: string) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    after_rhs_w: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_rhs);
    case after_rhs_w.is_nil of {
        true -> do
            after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
            (body: Expr, rest_after_body: ListTokenSlot) <- extract_sequence_body(after_semicolons, stop_kind);
            td_expr: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr, body, td_result, ann_type_str);
            (td_expr, rest_after_body)
        end;
        false -> case after_rhs_w.head.token.lexeme == ";" of {
            true -> do
                after_semis: ListTokenSlot <- skip_semicolons_after_whitespace(after_rhs_w);
                bound: ListTokenSlot <- skip_leading_whitespace_slots(after_semis);
                case bound.is_nil of {
                    true -> do
                        td_partial: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr, parser_ast@dummy_expr(), td_result, ann_type_str);
                        err_wrap: Expr <- trailing_semicolon_marker(after_rhs_w.head.token.location, td_partial);
                        td_expr: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr, err_wrap, td_result, ann_type_str);
                        (td_expr, bound)
                    end;
                    false -> case bound.head.token.kind == stop_kind or bound.head.token.lexeme == "produces" of {
                        true -> do
                            td_partial2: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr, parser_ast@dummy_expr(), td_result, ann_type_str);
                            err_wrap2: Expr <- trailing_semicolon_marker(after_rhs_w.head.token.location, td_partial2);
                            td_expr2: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr, err_wrap2, td_result, ann_type_str);
                            (td_expr2, bound)
                        end;
                        false -> do
                            (body2: Expr, rest_after_body2: ListTokenSlot) <- extract_sequence_body(after_semis, stop_kind);
                            td_expr3: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr, body2, td_result, ann_type_str);
                            (td_expr3, rest_after_body2)
                        end
                    }
                }
            end;
            false -> do
                after_semicolons2: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
                (body3: Expr, rest_after_body3: ListTokenSlot) <- extract_sequence_body(after_semicolons2, stop_kind);
                td_expr4: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr, body3, td_result, ann_type_str);
                (td_expr4, rest_after_body3)
            end
        }
    }
}

fn extract_tuple_decompose(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        lparen_slot: TokenSlot <- slots.head;
        td_result: TupleDecomposeResult <- parser_tuples@extract_tuple_decompose_pattern_from_slots(slots);
        rest_after_rparen: ListTokenSlot <- td_result.rest_slots;
        kinds: TokenKinds <- lexer_token_kind@token_kinds();
        rest_w: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_rparen);
        case rest_w.is_nil of {
            true -> do
                dummy: Expr <- parser_ast@dummy_expr();
                (dummy, slots)
            end;
            false -> case rest_w.head.token.kind == kinds.left_arrow of {
                true -> do
                    rhs_slots: ListTokenSlot <- rest_w.tail;
                    (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                    after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
                    (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(after_semicolons);
                    td_expr: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr, body, td_result, "");
                    (td_expr, rest_after_body)
                end;
                false -> case rest_w.head.token.kind == kinds.colon of {
                    true -> do
                        after_colon: ListTokenSlot <- skip_leading_whitespace_slots(rest_w.tail);
                        tr: TupleTypeResult <- parser_tuples@extract_tuple_type_from_slots(after_colon);
                        rest_after_ann: ListTokenSlot <- skip_leading_whitespace_slots(tr.rest_slots);
                        case rest_after_ann.is_nil of {
                            true -> do
                                dummy2: Expr <- parser_ast@dummy_expr();
                                (dummy2, slots)
                            end;
                            false -> case rest_after_ann.head.token.kind == kinds.left_arrow of {
                                true -> do
                                    rhs_slots2: ListTokenSlot <- rest_after_ann.tail;
                                    (rhs_expr2: Expr, rest_after_rhs2: ListTokenSlot) <- extract_body(rhs_slots2);
                                    after_semicolons2: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs2);
                                    (body2: Expr, rest_after_body2: ListTokenSlot) <- extract_function_body(after_semicolons2);
                                    td_expr2: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr2, body2, td_result, tr.type_str);
                                    (td_expr2, rest_after_body2)
                                end;
                                false -> do
                                    dummy3: Expr <- parser_ast@dummy_expr();
                                    (dummy3, slots)
                                end
                            }
                        }
                    end;
                    false -> do
                        dummy4: Expr <- parser_ast@dummy_expr();
                        (dummy4, slots)
                    end
                }
            }
        }
    end
}

fn extract_tuple_decompose_for_sequence(slots: ListTokenSlot, stop_kind: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        lparen_slot: TokenSlot <- slots.head;
        td_result: TupleDecomposeResult <- parser_tuples@extract_tuple_decompose_pattern_from_slots(slots);
        rest_after_rparen: ListTokenSlot <- td_result.rest_slots;
        kinds: TokenKinds <- lexer_token_kind@token_kinds();
        rest_w: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_rparen);
        case rest_w.is_nil of {
            true -> do
                dummy: Expr <- parser_ast@dummy_expr();
                (dummy, slots)
            end;
            false -> case rest_w.head.token.kind == kinds.left_arrow of {
                true -> do
                    rhs_slots: ListTokenSlot <- rest_w.tail;
                    (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                    extract_tuple_decompose_sequence_after_rhs(lparen_slot, td_result, rhs_expr, rest_after_rhs, stop_kind, "")
                end;
                false -> case rest_w.head.token.kind == kinds.colon of {
                    true -> do
                        after_colon: ListTokenSlot <- skip_leading_whitespace_slots(rest_w.tail);
                        tr: TupleTypeResult <- parser_tuples@extract_tuple_type_from_slots(after_colon);
                        rest_after_ann: ListTokenSlot <- skip_leading_whitespace_slots(tr.rest_slots);
                        case rest_after_ann.is_nil of {
                            true -> do
                                dummy_c: Expr <- parser_ast@dummy_expr();
                                (dummy_c, slots)
                            end;
                            false -> case rest_after_ann.head.token.kind == kinds.left_arrow of {
                                true -> do
                                    rhs_slots_c: ListTokenSlot <- rest_after_ann.tail;
                                    (rhs_expr_c: Expr, rest_after_rhs_c: ListTokenSlot) <- extract_body(rhs_slots_c);
                                    extract_tuple_decompose_sequence_after_rhs(lparen_slot, td_result, rhs_expr_c, rest_after_rhs_c, stop_kind, tr.type_str)
                                end;
                                false -> do
                                    dummy_d: Expr <- parser_ast@dummy_expr();
                                    (dummy_d, slots)
                                end
                            }
                        }
                    end;
                    false -> do
                        dummy_e: Expr <- parser_ast@dummy_expr();
                        (dummy_e, slots)
                    end
                }
            }
        }
    end
}

fn is_sequence_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == kinds.sequence_keyword
    }
}

fn extract_sequence(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    // Newline/space may appear between `sequence` and `proc` or `produces`; must trim before `proc` check,
    // otherwise we skip collecting proc[ε] and the body starts at `proc` (not a binding) → dummy sequence / MOV #0.
    after_seq: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
    case after_seq.is_nil of {
        true -> do
            dummy: Expr <- parser_ast@dummy_expr();
            (dummy, slots)
        end;
        false -> do
            (declared_effects: ListEffectName, slots_before_produces: ListTokenSlot) <- case after_seq.head.token.kind == kinds.proc_keyword or after_seq.head.token.lexeme == "proc" of {
                true -> collect_optional_proc_effects(after_seq);
                false -> (parser_ast@empty_effect_name_list(), after_seq)
            };
            case slots_before_produces.is_nil of {
                true -> do
                    dummy: Expr <- parser_ast@dummy_expr();
                    (dummy, slots)
                end;
                false -> do
                    slots_for_sequence_body: ListTokenSlot <- skip_leading_whitespace_slots(slots_before_produces);
                    (body_expr: Expr, slots_from_produces: ListTokenSlot) <- extract_sequence_body(slots_for_sequence_body, kinds.produces_keyword);
                    slots_trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots_from_produces);
                    // After "produces", newline may appear before "pure"; skip leading whitespace on each segment.
                    after_produces_or_start: ListTokenSlot <- case slots_trimmed.is_nil of {
                        true -> constraint_core@empty_list_slot();
                        false -> case slots_trimmed.head.token.kind == kinds.produces_keyword or slots_trimmed.head.token.lexeme == "produces" of {
                            true -> skip_leading_whitespace_slots(slots_trimmed.tail);
                            false -> slots_trimmed
                        }
                    };
                    result_slots: ListTokenSlot <- case after_produces_or_start.is_nil of {
                        true -> constraint_core@empty_list_slot();
                        false -> case after_produces_or_start.head.token.kind == kinds.pure_keyword or after_produces_or_start.head.token.lexeme == "pure" of {
                            true -> skip_leading_whitespace_slots(after_produces_or_start.tail);
                            false -> constraint_core@empty_list_slot()
                        }
                    };
                    case result_slots.is_nil of {
                        true -> do
                            dummy: Expr <- parser_ast@dummy_expr();
                            (dummy, slots)
                        end;
                        false -> do
                            (result_expr: Expr, rest_after_result: ListTokenSlot) <- extract_body(result_slots);
                            rest_trimmed: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_result);
                            case rest_trimmed.is_nil of {
                                true -> do
                                    dummy: Expr <- parser_ast@dummy_expr();
                                    (dummy, slots)
                                end;
                                false -> case rest_trimmed.head.token.lexeme == ";" of {
                                    true -> do
                                        after_result_semis: ListTokenSlot <- skip_semicolons_after_whitespace(rest_trimmed);
                                        after_result_w: ListTokenSlot <- skip_leading_whitespace_slots(after_result_semis);
                                        case after_result_w.is_nil of {
                                            true -> do
                                                dummy: Expr <- parser_ast@dummy_expr();
                                                (dummy, slots)
                                            end;
                                            false -> case after_result_w.head.token.kind == kinds.end_keyword or after_result_w.head.token.lexeme == "end" of {
                                                true -> do
                                                    end_kw_slot: TokenSlot <- after_result_w.head;
                                                    result_marked: Expr <- trailing_semicolon_marker(rest_trimmed.head.token.location, result_expr);
                                                    seq_expr: Expr <- Expr { kind: 11, value: "", name: "", location: end_kw_slot.token.location, inner: body_expr, right_expr: result_marked, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: declared_effects };
                                                    (seq_expr, after_result_w.tail)
                                                end;
                                                false -> do
                                                    dummy: Expr <- parser_ast@dummy_expr();
                                                    (dummy, slots)
                                                end
                                            }
                                        }
                                    end;
                                    false -> case rest_trimmed.head.token.kind == kinds.end_keyword or rest_trimmed.head.token.lexeme == "end" of {
                                        true -> do
                                            end_kw_slot: TokenSlot <- rest_trimmed.head;
                                            seq_expr: Expr <- Expr { kind: 11, value: "", name: "", location: end_kw_slot.token.location, inner: body_expr, right_expr: result_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: declared_effects };
                                            (seq_expr, rest_trimmed.tail)
                                        end;
                                        false -> do
                                            dummy: Expr <- parser_ast@dummy_expr();
                                            (dummy, slots)
                                        end
                                    }
                                }
                            }
                        end
                    }
                end
            }
        end
    }
}

// After `ident : T <- rhs` inside `do` ... `end`: continuation uses extract_do_end_body, not extract_function_body.
fn do_end_body_after_binding_rhs(rest_after_rhs: ListTokenSlot, bind_type: string, bind_name: string, bind_loc: SourceLocation, rhs_expr: Expr) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
    (body: Expr, rest_after_body: ListTokenSlot) <- extract_do_end_body(after_semicolons);
    let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
    (let_expr, rest_after_body)
}

fn extract_tuple_decompose_do_end_after_rhs(lparen_slot: TokenSlot, td_result: TupleDecomposeResult, rhs_expr: Expr, rest_after_rhs: ListTokenSlot, ann_type_str: string) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
    (body: Expr, rest_after_body: ListTokenSlot) <- extract_do_end_body(after_semicolons);
    td_expr: Expr <- tuple_decompose_build_expr(lparen_slot, rhs_expr, body, td_result, ann_type_str);
    (td_expr, rest_after_body)
}

fn extract_binding_simple_for_do_end(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        kinds: TokenKinds <- lexer_token_kind@token_kinds();
        ident_slot: TokenSlot <- slots.head;
        ac: ListTokenSlot <- slots_after_binding_colon(slots);
        case ac.is_nil of {
            true -> do
                dummy_err: Expr <- parser_ast@dummy_expr();
                (dummy_err, constraint_core@empty_list_slot())
            end;
            false -> case parser_tuples@slots_start_fn_type(ac) of {
                true -> do
                    (fn_ty_str: string, rest_after_fn_ty: ListTokenSlot) <- parser_tuples@extract_fn_type_from_slots(ac);
                    bind_name: string <- ident_slot.token.lexeme;
                    bind_type: string <- fn_ty_str;
                    bind_loc: SourceLocation <- ident_slot.token.location;
                    rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(rest_after_fn_ty);
                    (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                    after_rhs_brace: ListTokenSlot <- consume_optional_leading_right_brace(rest_after_rhs);
                    (let_expr: Expr, rest_after_body: ListTokenSlot) <- do_end_body_after_binding_rhs(after_rhs_brace, bind_type, bind_name, bind_loc, rhs_expr);
                    (let_expr, rest_after_body)
                end;
                false -> case ac.head.token.kind == kinds.atom_literal of {
                    true -> do
                        tr_atom_bind: TupleTypeResult <- parser_tuples@extract_atom_option_type_from_slots(ac);
                        bind_name: string <- ident_slot.token.lexeme;
                        bind_type: string <- tr_atom_bind.type_str;
                        bind_loc: SourceLocation <- ident_slot.token.location;
                        rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr_atom_bind.rest_slots);
                        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                        (let_expr2: Expr, rest_after_body: ListTokenSlot) <- do_end_body_after_binding_rhs(rest_after_rhs, bind_type, bind_name, bind_loc, rhs_expr);
                        (let_expr2, rest_after_body)
                    end;
                    false -> do
                        type_slot: TokenSlot <- ac.head;
                        after_type: ListTokenSlot <- ac.tail;
                        rhs_slots: ListTokenSlot <- case after_type.is_nil of {
                            true -> constraint_core@empty_list_slot();
                            false -> case after_type.head.token.kind == kinds.left_arrow of {
                                true -> after_type.tail;
                                false -> constraint_core@empty_list_slot()
                            }
                        };
                        bind_name: string <- ident_slot.token.lexeme;
                        bind_type: string <- case is_type_keyword(lexer_token_kind@token_kinds(), type_slot.token.kind) of {
                            true -> do
                                from_k: string <- kind_to_type_name(type_slot.token.kind);
                                case len(from_k) > 0 of { true -> from_k; false -> type_slot.token.lexeme }
                            end;
                            false -> type_slot.token.lexeme
                        };
                        bind_loc: SourceLocation <- ident_slot.token.location;
                        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                        (let_expr2: Expr, rest_after_body: ListTokenSlot) <- do_end_body_after_binding_rhs(rest_after_rhs, bind_type, bind_name, bind_loc, rhs_expr);
                        (let_expr2, rest_after_body)
                    end
                }
            }
        }
    end
}

fn extract_binding_tuple_for_do_end(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        ident_slot: TokenSlot <- slots.head;
        tuple_slots: ListTokenSlot <- slots_after_binding_colon(slots);
        tr: TupleTypeResult <- parser_tuples@extract_tuple_type_from_slots(tuple_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: SourceLocation <- ident_slot.token.location;
        case parser_tuples@is_single_element_tuple_type(bind_type) of {
            true -> do
                dummy: Expr <- parser_ast@dummy_expr();
                sentinel: Expr <- Expr { kind: 998, value: "single_tuple_type", name: "", location: bind_loc, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
                (_: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
                (body: Expr, rest_after_body: ListTokenSlot) <- extract_do_end_body(after_semicolons);
                (sentinel, rest_after_body)
            end;
            false -> do
                rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
                (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                (let_expr: Expr, rest_after_body: ListTokenSlot) <- do_end_body_after_binding_rhs(rest_after_rhs, bind_type, bind_name, bind_loc, rhs_expr);
                (let_expr, rest_after_body)
            end
        }
    end
}

fn extract_binding_for_do_end(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    case parser_tuples@is_tuple_type_binding_start(slots) of {
        true -> extract_binding_tuple_for_do_end(slots);
        false -> case parser_tuples@binding_starts_paren_tuple_type_after_colon(slots) of {
            true -> extract_binding_tuple_for_do_end(slots);
            false -> extract_binding_simple_for_do_end(slots)
        }
    }
}

fn extract_tuple_decompose_for_do_end(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        lparen_slot: TokenSlot <- slots.head;
        td_result: TupleDecomposeResult <- parser_tuples@extract_tuple_decompose_pattern_from_slots(slots);
        rest_after_rparen: ListTokenSlot <- td_result.rest_slots;
        kinds: TokenKinds <- lexer_token_kind@token_kinds();
        rest_w: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_rparen);
        case rest_w.is_nil of {
            true -> do
                dummy: Expr <- parser_ast@dummy_expr();
                (dummy, slots)
            end;
            false -> case rest_w.head.token.kind == kinds.left_arrow of {
                true -> do
                    rhs_slots: ListTokenSlot <- rest_w.tail;
                    (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
                    extract_tuple_decompose_do_end_after_rhs(lparen_slot, td_result, rhs_expr, rest_after_rhs, "")
                end;
                false -> case rest_w.head.token.kind == kinds.colon of {
                    true -> do
                        after_colon: ListTokenSlot <- skip_leading_whitespace_slots(rest_w.tail);
                        tr: TupleTypeResult <- parser_tuples@extract_tuple_type_from_slots(after_colon);
                        rest_after_ann: ListTokenSlot <- skip_leading_whitespace_slots(tr.rest_slots);
                        case rest_after_ann.is_nil of {
                            true -> do
                                dummy2: Expr <- parser_ast@dummy_expr();
                                (dummy2, slots)
                            end;
                            false -> case rest_after_ann.head.token.kind == kinds.left_arrow of {
                                true -> do
                                    rhs_slots2: ListTokenSlot <- rest_after_ann.tail;
                                    (rhs_expr2: Expr, rest_after_rhs2: ListTokenSlot) <- extract_body(rhs_slots2);
                                    extract_tuple_decompose_do_end_after_rhs(lparen_slot, td_result, rhs_expr2, rest_after_rhs2, tr.type_str)
                                end;
                                false -> do
                                    dummy3: Expr <- parser_ast@dummy_expr();
                                    (dummy3, slots)
                                end
                            }
                        }
                    end;
                    false -> do
                        dummy4: Expr <- parser_ast@dummy_expr();
                        (dummy4, slots)
                    end
                }
            }
        }
    end
}

fn extract_body_for_do_end(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> do
            dummy_nil: Expr <- parser_ast@dummy_expr();
            (dummy_nil, trimmed)
        end;
        false -> do
            first: TokenSlot <- trimmed.head;
            case first.token.kind == kinds.produces_keyword or first.token.lexeme == "produces" of {
                true -> do
                    dummy: Expr <- parser_ast@dummy_expr();
                    (dummy, trimmed)
                end;
                false -> case first.token.kind == kinds.right_paren of {
                    true -> do
                        dummy_rp: Expr <- parser_ast@dummy_expr();
                        (dummy_rp, trimmed)
                    end;
                    false -> case first.token.kind == kinds.sequence_keyword or first.token.lexeme == "sequence" of {
                        true -> extract_sequence(trimmed);
                        false -> case first.token.kind == kinds.if_keyword or first.token.lexeme == "if" of {
                            true -> extract_if_expression(trimmed);
                            false -> case first.token.kind == kinds.left_bracket and (constraint_core@slot_role(first) == capability_list@role_list_lit_lbracket() or is_list_literal_lbracket_fallback(trimmed, kinds)) of {
                                true -> extract_list_literal(trimmed);
                                false -> case first.token.kind == kinds.left_brace and is_struct_literal_lbrace_fallback(trimmed, kinds) of {
                                    true -> extract_struct_literal(trimmed);
                                    false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, first.token.kind) of {
                                        true -> case is_binding_start(trimmed) of {
                                            true -> extract_binding_for_do_end(trimmed);
                                            false -> case parser_tuples@binding_starts_paren_tuple_type_after_colon(trimmed) of {
                                                true -> extract_binding_for_do_end(trimmed);
                                                false -> extract_expr_with_precedence(trimmed, 0)
                                            }
                                        };
                                        false -> case first.token.kind == kinds.left_paren of {
                                            true -> do
                                                (td_expr: Expr, td_rest: ListTokenSlot) <- extract_tuple_decompose_for_do_end(trimmed);
                                                case td_expr.kind == 10 of {
                                                    true -> (td_expr, td_rest);
                                                    false -> extract_expr_with_precedence(trimmed, 0)
                                                }
                                            end;
                                            false -> extract_expr_with_precedence(trimmed, 0)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        end
    }
}

// Parse `do` ... `end` body: like function body but terminates at `end`, not `}`.
fn extract_do_end_body(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    (first_expr: Expr, after_first: ListTokenSlot) <- extract_body_for_do_end(trimmed);
    extract_do_end_body_tail(first_expr, after_first)
}

fn extract_do_end_body_tail(first_expr: Expr, after_first: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    after_trim: ListTokenSlot <- skip_leading_whitespace_slots(after_first);
    case after_trim.is_nil of {
        true -> (first_expr, after_trim);
        false -> case after_trim.head.token.kind == kinds.end_keyword or after_trim.head.token.lexeme == "end" of {
            true -> (first_expr, after_trim);
            false -> case after_trim.head.token.lexeme == ";" of {
                true -> do
                    rest: ListTokenSlot <- skip_semicolons_after_whitespace(after_trim);
                    rest_w: ListTokenSlot <- skip_leading_whitespace_slots(rest);
                    case rest_w.is_nil of {
                        true -> do
                            semi_slot: TokenSlot <- after_trim.head;
                            marked: Expr <- trailing_semicolon_marker(semi_slot.token.location, first_expr);
                            (marked, rest_w)
                        end;
                        false -> case rest_w.head.token.kind == kinds.end_keyword or rest_w.head.token.lexeme == "end" of {
                            true -> do
                                semi_slot: TokenSlot <- after_trim.head;
                                marked: Expr <- trailing_semicolon_marker(semi_slot.token.location, first_expr);
                                (marked, rest_w)
                            end;
                            false -> do
                                (rest_body: Expr, rest_after: ListTokenSlot) <- extract_do_end_body(rest_w);
                                body: Expr <- wrap_let_or_return(first_expr, rest_body);
                                (body, rest_after)
                            end
                        }
                    }
                end;
                false -> case first_expr.kind < 0 of {
                    true -> (first_expr, after_trim);
                    false -> do
                        diag_loc: SourceLocation <- first_expr.location;
                        (rest_body: Expr, rest_after: ListTokenSlot) <- extract_do_end_body(after_trim);
                        body: Expr <- statement_boundary_error_wrapper(diag_loc, first_expr, rest_body, after_trim);
                        (body, rest_after)
                    end
                }
            }
        }
    }
}

// Parse `do` ... `end` as a single expression block (function-body shape). Used for case-branch RHS.
fn extract_do_end_expr_block(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    dummy_e: Expr <- parser_ast@dummy_expr();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case slots_is_nil(trimmed) of {
        true -> (dummy_e, slots);
        false -> case trimmed.head.token.lexeme == "do" of {
            true -> do
                inner_slots: ListTokenSlot <- trimmed.tail;
                (body_expr: Expr, rest_after: ListTokenSlot) <- extract_do_end_body(inner_slots);
                rest_trimmed: ListTokenSlot <- skip_leading_whitespace_slots(rest_after);
                case slots_is_nil(rest_trimmed) of {
                    true -> (dummy_e, slots);
                    false -> case rest_trimmed.head.token.kind == kinds.end_keyword or rest_trimmed.head.token.lexeme == "end" of {
                        true -> (body_expr, rest_trimmed.tail);
                        false -> (dummy_e, slots)
                    }
                }
            end;
            false -> (dummy_e, slots)
        }
    }
}

// Parse `{` ... `}` as a single expression block (function-body shape). Used for if/else arms.
// Returns (rest after closing `}`, body); tuple order matches bootstrap codegen for (ListTokenSlot, Expr).
fn extract_braced_expr_block(slots: ListTokenSlot) -> (ListTokenSlot, Expr) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    dummy_e: Expr <- parser_ast@dummy_expr();
    case slots_is_nil(slots) of {
        true -> (slots, dummy_e);
        false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
            true -> case is_struct_literal_lbrace_fallback(slots, kinds) of {
                true -> do
                    (struct_e: Expr, after_brace: ListTokenSlot) <- extract_struct_literal(slots);
                    (after_brace, struct_e)
                end;
                false -> do
                    inner_slots: ListTokenSlot <- slots.tail;
                    (body_expr: Expr, rest_after: ListTokenSlot) <- extract_function_body(inner_slots);
                    case slots_is_nil(rest_after) of {
                        true -> (slots, dummy_e);
                        false -> case rest_after.head.token.kind == kinds.right_brace or rest_after.head.token.lexeme == "}" or constraint_core@slot_role(rest_after.head) == role_right_brace() of {
                            true -> (rest_after.tail, body_expr);
                            false -> (slots, dummy_e)
                        }
                    }
                end
            };
            false -> (slots, dummy_e)
        }
    }
}

// `if` cond `{` then `}` [`else` `{` else `}`] — distinct from case-branch guards (`pattern if guard ->`).
fn extract_if_expression(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    if_loc: SourceLocation <- slots.head.token.location;
    after_if: ListTokenSlot <- slots.tail;
    (cond_expr: Expr, after_cond: ListTokenSlot) <- extract_expr_with_precedence(after_if, 0);
    (after_then: ListTokenSlot, then_expr: Expr) <- extract_braced_expr_block(after_cond);
    case slots_is_nil(after_then) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case slots_head(after_then).token.lexeme == "else" of {
            true -> do
                after_else_kw: ListTokenSlot <- slots_tail(after_then);
                (after_else: ListTokenSlot, else_expr: Expr) <- extract_braced_expr_block(after_else_kw);
                tuple_exprs: Expr <- Expr { kind: 9, value: "", name: "", location: if_loc, inner: then_expr, right_expr: else_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                if_expr: Expr <- Expr { kind: 19, value: "", name: "", location: if_loc, inner: cond_expr, right_expr: tuple_exprs, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (if_expr, after_else)
            end;
            false -> do
                dummy_else: Expr <- parser_ast@dummy_expr();
                tuple_exprs: Expr <- Expr { kind: 9, value: "", name: "", location: if_loc, inner: then_expr, right_expr: dummy_else, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                if_expr: Expr <- Expr { kind: 19, value: "", name: "", location: if_loc, inner: cond_expr, right_expr: tuple_exprs, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (if_expr, after_then)
            end
        }
    }
}

fn extract_body(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> do
            dummy_nil: Expr <- parser_ast@dummy_expr();
            (dummy_nil, trimmed)
        end;
        false -> do
            first: TokenSlot <- trimmed.head;
            case first.token.kind == kinds.produces_keyword or first.token.lexeme == "produces" of {
                true -> do
                    dummy: Expr <- parser_ast@dummy_expr();
                    (dummy, trimmed)
                end;
                false -> case first.token.kind == kinds.right_paren of {
                    true -> do
                        dummy_rp: Expr <- parser_ast@dummy_expr();
                        (dummy_rp, trimmed)
                    end;
                    false -> case first.token.kind == kinds.sequence_keyword or first.token.lexeme == "sequence" of {
                        true -> extract_sequence(trimmed);
                        false -> case first.token.kind == kinds.if_keyword or first.token.lexeme == "if" of {
                            true -> extract_if_expression(trimmed);
                            false -> case first.token.kind == kinds.left_bracket and (constraint_core@slot_role(first) == capability_list@role_list_lit_lbracket() or is_list_literal_lbracket_fallback(trimmed, kinds)) of {
                                true -> extract_list_literal(trimmed);
                                false -> case first.token.kind == kinds.left_brace and is_struct_literal_lbrace_fallback(trimmed, kinds) of {
                                    true -> extract_struct_literal(trimmed);
                                    false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, first.token.kind) of {
                                        true -> case is_binding_start(trimmed) of {
                                            true -> extract_binding(trimmed);
                                            false -> case parser_tuples@binding_starts_paren_tuple_type_after_colon(trimmed) of {
                                                true -> extract_binding(trimmed);
                                                false -> extract_expr_with_precedence(trimmed, 0)
                                            }
                                        };
                                        false -> case first.token.kind == kinds.left_paren of {
                                            true -> do
                                                (td_expr: Expr, td_rest: ListTokenSlot) <- extract_tuple_decompose(trimmed);
                                                case td_expr.kind == 10 of {
                                                    true -> (td_expr, td_rest);
                                                    false -> extract_expr_with_precedence(trimmed, 0)
                                                }
                                            end;
                                            false -> extract_expr_with_precedence(trimmed, 0)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        end
    }
}

fn extract_parenthesized(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    lparen_slot: TokenSlot <- slots.head;
    inner_slots: ListTokenSlot <- slots.tail;
    (first: Expr, rest_after_first: ListTokenSlot) <- extract_body(inner_slots);
    (result: Expr, rest_after_rparen: ListTokenSlot) <- extract_parenthesized_tail(lparen_slot, first, rest_after_first, kinds);
    (result, rest_after_rparen)
}

fn extract_parenthesized_tail(lparen_slot: TokenSlot, first: Expr, rest_after_first: ListTokenSlot, kinds: TokenKinds) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    case first.kind < 0 of {
        true -> (first, rest_after_first);
        false -> case rest_after_first.is_nil of {
            true -> do
                dummy: Expr <- parser_ast@dummy_expr();
                single: Expr <- Expr { kind: 2, value: "", name: "", location: lparen_slot.token.location, inner: first, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (single, rest_after_first)
            end;
            false -> case rest_after_first.head.token.lexeme == "," or rest_after_first.head.token.kind == kinds.comma of {
                true -> case rest_after_first.tail.is_nil of {
                true -> do
                    dummy: Expr <- parser_ast@dummy_expr();
                    sentinel: Expr <- Expr { kind: 999, value: "single_tuple", name: "", location: lparen_slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    (sentinel, rest_after_first)
                end;
                false -> case rest_after_first.tail.head.token.lexeme == ")" or rest_after_first.tail.head.token.kind == kinds.right_paren of {
                    true -> do
                        dummy: Expr <- parser_ast@dummy_expr();
                        sentinel: Expr <- Expr { kind: 999, value: "single_tuple", name: "", location: lparen_slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (sentinel, rest_after_first.tail)
                    end;
                    false -> do
                        second_slots: ListTokenSlot <- rest_after_first.tail;
                        (second: Expr, rest_after_second: ListTokenSlot) <- extract_body(second_slots);
                        (rest_expr: Expr, rest_final: ListTokenSlot) <- extract_tuple_elements_tail(second, rest_after_second, kinds);
                        tuple_expr: Expr <- Expr { kind: 9, value: "", name: "", location: lparen_slot.token.location, inner: first, right_expr: rest_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (tuple_expr, rest_final)
                    end
                }
                };
                false -> do
                dummy: Expr <- parser_ast@dummy_expr();
                single: Expr <- Expr { kind: 2, value: "", name: "", location: lparen_slot.token.location, inner: first, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (single, slots_tail(rest_after_first))
            end
            }
        }
    }
}

// Recursively parse comma-separated tuple elements; build right-nested (a, (b, (c, d)))
fn extract_tuple_elements_tail(first: Expr, rest: ListTokenSlot, kinds: TokenKinds) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    case rest.is_nil of {
        true -> (first, rest);
        false -> case rest.head.token.lexeme == ")" or rest.head.token.kind == kinds.right_paren of {
            true -> (first, rest.tail);
            false -> case rest.head.token.lexeme == "," or rest.head.token.kind == kinds.comma of {
                true -> case rest.tail.is_nil of {
                    true -> do
                        dummy: Expr <- parser_ast@dummy_expr();
                        sentinel: Expr <- Expr { kind: 999, value: "single_tuple", name: "", location: first.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (sentinel, rest)
                    end;
                    false -> case rest.tail.head.token.lexeme == ")" or rest.tail.head.token.kind == kinds.right_paren of {
                        true -> do
                            dummy: Expr <- parser_ast@dummy_expr();
                            sentinel: Expr <- Expr { kind: 999, value: "single_tuple", name: "", location: first.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            (sentinel, rest.tail)
                        end;
                        false -> do
                            second_slots: ListTokenSlot <- rest.tail;
                            (second: Expr, rest_after_second: ListTokenSlot) <- extract_body(second_slots);
                            (rest_expr: Expr, rest_final: ListTokenSlot) <- extract_tuple_elements_tail(second, rest_after_second, kinds);
                            tuple_expr: Expr <- Expr { kind: 9, value: "", name: "", location: first.location, inner: first, right_expr: rest_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            (tuple_expr, rest_final)
                        end
                    }
                };
                false -> (first, rest)
            }
        }
    }
}

// Comma-separated list literal elements; right-nested (a, (b, (c, d))) shape with kind 20 and value "" on pair nodes.
// Closing `]` normally has role_list_lit_rbracket; if constraint propagation missed the role, still accept `]` when
// `: List[...]` follows (same idea as parse_list_literal_type_suffix), so the suffix parser sees `:` not a stale `]`.
// Also accept `)` or `,` after `]` when the list is a tuple element — constraints expect `;` after list_lit_rbracket,
// so `]` before `)` (e.g. `(0, [0])`) or `,` (e.g. `(0, [0], 1)`) often has no role and must parse structurally.
fn extract_list_elements_tail(first: Expr, rest: ListTokenSlot, kinds: TokenKinds) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    case rest.is_nil of {
        true -> (first, rest);
        false -> case rest.head.token.kind == kinds.right_bracket or rest.head.token.lexeme == "]" of {
            true -> do
                role_ok: bool <- constraint_core@slot_role(rest.head) == capability_list@role_list_lit_rbracket();
                after_rbr: ListTokenSlot <- rest.tail;
                after_ws: ListTokenSlot <- skip_leading_whitespace_slots(after_rbr);
                colon_suffix_ok: bool <- case slots_is_nil(after_ws) of {
                    true -> false;
                    false -> after_ws.head.token.kind == kinds.colon
                };
                semi_suffix_ok: bool <- case slots_is_nil(after_ws) of {
                    true -> true;
                    false -> after_ws.head.token.kind == kinds.semicolon
                };
                rparen_suffix_ok: bool <- case slots_is_nil(after_ws) of {
                    true -> false;
                    false -> after_ws.head.token.kind == kinds.right_paren or after_ws.head.token.lexeme == ")"
                };
                comma_tuple_suffix_ok: bool <- case slots_is_nil(after_ws) of {
                    true -> false;
                    false -> after_ws.head.token.kind == kinds.comma or after_ws.head.token.lexeme == ","
                };
                case role_ok or colon_suffix_ok or semi_suffix_ok or rparen_suffix_ok or comma_tuple_suffix_ok of {
                    true -> (first, rest.tail);
                    false -> (first, rest)
                }
            end;
            false -> case rest.head.token.kind == kinds.comma or rest.head.token.lexeme == "," of {
                true -> case rest.tail.is_nil of {
                    true -> do
                        dummy: Expr <- parser_ast@dummy_expr();
                        sentinel: Expr <- Expr { kind: 999, value: "single_list", name: "", location: first.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (sentinel, rest)
                    end;
                    false -> case rest.tail.head.token.kind == kinds.right_bracket or rest.tail.head.token.lexeme == "]" of {
                        true -> do
                            dummy: Expr <- parser_ast@dummy_expr();
                            sentinel: Expr <- Expr { kind: 999, value: "single_list", name: "", location: first.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            (sentinel, rest.tail)
                        end;
                        false -> do
                            second_slots: ListTokenSlot <- rest.tail;
                            (second: Expr, rest_after_second: ListTokenSlot) <- extract_body(second_slots);
                            (rest_expr: Expr, rest_final: ListTokenSlot) <- extract_list_elements_tail(second, rest_after_second, kinds);
                            list_expr: Expr <- Expr { kind: 20, value: "", name: "", location: first.location, inner: first, right_expr: rest_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            (list_expr, rest_final)
                        end
                    }
                };
                false -> (first, rest)
            }
        }
    }
}

// After `]` of a list literal: `: List[...]`; returns (type annotation text, rest after the closing `]` of List[...]).
// Accept `List` as list_keyword or identifier lexeme "List" (same as extract_list_type_from_slots / token_is_list_type_name).
// If constraint roles omit role_list_lit_colon on `:`, still parse when `List[...]` clearly follows (avoids leaving `:` in the stream).
fn parse_list_literal_type_suffix(after_rbracket: ListTokenSlot, kinds: TokenKinds) -> (string, ListTokenSlot) proc[DeviceIO] {
    case slots_is_nil(after_rbracket) of {
        true -> ("", after_rbracket);
        false -> case after_rbracket.head.token.kind == kinds.colon of {
            true -> do
                after_colon: ListTokenSlot <- after_rbracket.tail;
                role_ok: bool <- constraint_core@slot_role(after_rbracket.head) == capability_list@role_list_lit_colon();
                list_follows: bool <- case slots_is_nil(after_colon) of {
                    true -> false;
                    false -> parser_tuples@slots_start_bracketed_collection_type(after_colon, kinds)
                };
                case role_ok or list_follows of {
                    true -> case slots_is_nil(after_colon) of {
                        true -> ("", after_colon);
                        false -> case parser_tuples@slots_start_bracketed_collection_type(after_colon, kinds) of {
                            true -> do
                                tr_lit: TupleTypeResult <- parser_tuples@extract_list_type_from_slots(after_colon);
                                (tr_lit.type_str, tr_lit.rest_slots)
                            end;
                            false -> ("", after_rbracket)
                        }
                    };
                    false -> ("", after_rbracket)
                }
            end;
            false -> ("", after_rbracket)
        }
    }
}

fn extract_list_literal(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    lbr_loc: SourceLocation <- slots.head.token.location;
    after_open: ListTokenSlot <- slots.tail;
    case slots_is_nil(after_open) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case after_open.head.token.kind == kinds.right_bracket or after_open.head.token.lexeme == "]" of {
            true -> do
                role_ok: bool <- constraint_core@slot_role(after_open.head) == capability_list@role_list_lit_rbracket();
                after_rbr_empty: ListTokenSlot <- after_open.tail;
                after_ws_empty: ListTokenSlot <- skip_leading_whitespace_slots(after_rbr_empty);
                colon_suffix_ok: bool <- case slots_is_nil(after_ws_empty) of {
                    true -> false;
                    false -> after_ws_empty.head.token.kind == kinds.colon
                };
                semi_suffix_ok: bool <- case slots_is_nil(after_ws_empty) of {
                    true -> true;
                    false -> after_ws_empty.head.token.kind == kinds.semicolon
                };
                rparen_suffix_ok: bool <- case slots_is_nil(after_ws_empty) of {
                    true -> false;
                    false -> after_ws_empty.head.token.kind == kinds.right_paren or after_ws_empty.head.token.lexeme == ")"
                };
                comma_tuple_suffix_ok: bool <- case slots_is_nil(after_ws_empty) of {
                    true -> false;
                    false -> after_ws_empty.head.token.kind == kinds.comma or after_ws_empty.head.token.lexeme == ","
                };
                case role_ok or colon_suffix_ok or semi_suffix_ok or rparen_suffix_ok or comma_tuple_suffix_ok of {
                    true -> do
                        after_elems: ListTokenSlot <- after_open.tail;
                        dummy: Expr <- parser_ast@dummy_expr();
                        empty_list: Expr <- Expr { kind: 20, value: "", name: "", location: lbr_loc, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (empty_list, after_elems)
                    end;
                    false -> do
                        (first: Expr, rest_after_first: ListTokenSlot) <- extract_body(after_open);
                        (elem_tree: Expr, after_rbracket: ListTokenSlot) <- extract_list_elements_tail(first, rest_after_first, kinds);
                        dummy_r: Expr <- parser_ast@dummy_expr();
                        root: Expr <- case elem_tree.kind == 20 of {
                            true -> Expr { kind: 20, value: "", name: "", location: lbr_loc, inner: elem_tree.inner, right_expr: elem_tree.right_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            false -> Expr { kind: 20, value: "", name: "", location: lbr_loc, inner: elem_tree, right_expr: dummy_r, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
                        };
                        (root, after_rbracket)
                    end
                }
            end;
            false -> do
                (first: Expr, rest_after_first: ListTokenSlot) <- extract_body(after_open);
                (elem_tree: Expr, after_rbracket: ListTokenSlot) <- extract_list_elements_tail(first, rest_after_first, kinds);
                dummy_r: Expr <- parser_ast@dummy_expr();
                root: Expr <- case elem_tree.kind == 20 of {
                    true -> Expr { kind: 20, value: "", name: "", location: lbr_loc, inner: elem_tree.inner, right_expr: elem_tree.right_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    false -> Expr { kind: 20, value: "", name: "", location: lbr_loc, inner: elem_tree, right_expr: dummy_r, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
                };
                (root, after_rbracket)
            end
        }
    }
}

fn extract_skip_to_rparen(rest: ListTokenSlot, kinds: TokenKinds) -> ListTokenSlot {
    case rest.is_nil of {
        true -> rest;
        false -> case rest.head.token.kind == kinds.right_paren of {
            true -> rest.tail;
            false -> rest
        }
    }
}

fn take_prefix_before_role(slots: ListTokenSlot, target_role: int64) -> ListTokenSlot proc[DeviceIO] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case constraint_core@slot_role(slots.head) == target_role of {
            true -> constraint_core@empty_list_slot();
            false -> do
                tail_p: ListTokenSlot <- take_prefix_before_role(slots.tail, target_role);
                constraint_core@cons_slot(slots.head, tail_p)
            end
        }
    }
}

fn take_suffix_from_role(slots: ListTokenSlot, target_role: int64) -> ListTokenSlot proc[DeviceIO] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case constraint_core@slot_role(slots.head) == target_role of {
            true -> slots;
            false -> take_suffix_from_role(slots.tail, target_role)
        }
    }
}

// Split "case" <scrutinee> "of" using only the lexer kind of `of`. Do not stop on slot_role == role_case_of():
// after constraint propagation, role_case_of can appear as the first role on the scrutinee token (e.g. true),
// which would yield an empty scrutinee slot list and segfault in extract_primary.
fn take_prefix_before_role_or_of_keyword(slots: ListTokenSlot, target_role: int64, kinds: TokenKinds) -> ListTokenSlot proc[DeviceIO] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case slots.head.token.kind == kinds.of_keyword or slots.head.token.lexeme == "of" of {
            true -> constraint_core@empty_list_slot();
            false -> do
                tail_p: ListTokenSlot <- take_prefix_before_role_or_of_keyword(slots.tail, target_role, kinds);
                constraint_core@cons_slot(slots.head, tail_p)
            end
        }
    }
}

fn take_suffix_from_role_or_of_keyword(slots: ListTokenSlot, target_role: int64, kinds: TokenKinds) -> ListTokenSlot proc[DeviceIO] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case slots.head.token.kind == kinds.of_keyword or slots.head.token.lexeme == "of" of {
            true -> slots;
            false -> take_suffix_from_role_or_of_keyword(slots.tail, target_role, kinds)
        }
    }
}

fn take_prefix_before_branch_arrow(slots: ListTokenSlot, kinds: TokenKinds) -> ListTokenSlot proc[DeviceIO] {
    take_prefix_before_branch_arrow_balanced(slots, kinds, 0, 0, 0)
}

fn take_suffix_from_branch_arrow(slots: ListTokenSlot, kinds: TokenKinds) -> ListTokenSlot proc[DeviceIO] {
    take_suffix_from_branch_arrow_balanced(slots, kinds, 0, 0, 0)
}

// Only treat `->` as the branch arrow at brace/paren/bracket depth 0 so `fn(...) -> T` inside patterns does not split early.
fn take_prefix_before_branch_arrow_balanced(slots: ListTokenSlot, kinds: TokenKinds, brace_depth: int64, pdepth: int64, sdepth: int64) -> ListTokenSlot proc[DeviceIO] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case (slots.head.token.kind == kinds.right_arrow or slots.head.token.lexeme == "->") and brace_depth == 0 and pdepth == 0 and sdepth == 0 of {
            true -> constraint_core@empty_list_slot();
            false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
                true -> do
                    tail_p: ListTokenSlot <- take_prefix_before_branch_arrow_balanced(slots.tail, kinds, brace_depth + 1, pdepth, sdepth);
                    constraint_core@cons_slot(slots.head, tail_p)
                end;
                false -> case slots.head.token.kind == kinds.right_brace or slots.head.token.lexeme == "}" of {
                    true -> do
                        nd: int64 <- brace_depth - 1;
                        d2: int64 <- case nd < 0 of { true -> 0; false -> nd };
                        tail_p2: ListTokenSlot <- take_prefix_before_branch_arrow_balanced(slots.tail, kinds, d2, pdepth, sdepth);
                        constraint_core@cons_slot(slots.head, tail_p2)
                    end;
                    false -> case slots.head.token.kind == kinds.left_paren or slots.head.token.lexeme == "(" of {
                        true -> do
                            tail_p3: ListTokenSlot <- take_prefix_before_branch_arrow_balanced(slots.tail, kinds, brace_depth, pdepth + 1, sdepth);
                            constraint_core@cons_slot(slots.head, tail_p3)
                        end;
                        false -> case slots.head.token.kind == kinds.right_paren or slots.head.token.lexeme == ")" of {
                            true -> do
                                np: int64 <- case pdepth > 0 of { true -> pdepth - 1; false -> 0 };
                                tail_p4: ListTokenSlot <- take_prefix_before_branch_arrow_balanced(slots.tail, kinds, brace_depth, np, sdepth);
                                constraint_core@cons_slot(slots.head, tail_p4)
                            end;
                            false -> case slots.head.token.kind == kinds.left_bracket or slots.head.token.lexeme == "[" of {
                                true -> do
                                    tail_p5: ListTokenSlot <- take_prefix_before_branch_arrow_balanced(slots.tail, kinds, brace_depth, pdepth, sdepth + 1);
                                    constraint_core@cons_slot(slots.head, tail_p5)
                                end;
                                false -> case slots.head.token.kind == kinds.right_bracket or slots.head.token.lexeme == "]" of {
                                    true -> do
                                        ns: int64 <- case sdepth > 0 of { true -> sdepth - 1; false -> 0 };
                                        tail_p6: ListTokenSlot <- take_prefix_before_branch_arrow_balanced(slots.tail, kinds, brace_depth, pdepth, ns);
                                        constraint_core@cons_slot(slots.head, tail_p6)
                                    end;
                                    false -> do
                                        tail_p7: ListTokenSlot <- take_prefix_before_branch_arrow_balanced(slots.tail, kinds, brace_depth, pdepth, sdepth);
                                        constraint_core@cons_slot(slots.head, tail_p7)
                                    end
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn take_suffix_from_branch_arrow_balanced(slots: ListTokenSlot, kinds: TokenKinds, brace_depth: int64, pdepth: int64, sdepth: int64) -> ListTokenSlot proc[DeviceIO] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case (slots.head.token.kind == kinds.right_arrow or slots.head.token.lexeme == "->") and brace_depth == 0 and pdepth == 0 and sdepth == 0 of {
            true -> slots;
            false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
                true -> take_suffix_from_branch_arrow_balanced(slots.tail, kinds, brace_depth + 1, pdepth, sdepth);
                false -> case slots.head.token.kind == kinds.right_brace or slots.head.token.lexeme == "}" of {
                    true -> do
                        nd: int64 <- brace_depth - 1;
                        d2: int64 <- case nd < 0 of { true -> 0; false -> nd };
                        take_suffix_from_branch_arrow_balanced(slots.tail, kinds, d2, pdepth, sdepth)
                    end;
                    false -> case slots.head.token.kind == kinds.left_paren or slots.head.token.lexeme == "(" of {
                        true -> take_suffix_from_branch_arrow_balanced(slots.tail, kinds, brace_depth, pdepth + 1, sdepth);
                        false -> case slots.head.token.kind == kinds.right_paren or slots.head.token.lexeme == ")" of {
                            true -> do
                                np: int64 <- case pdepth > 0 of { true -> pdepth - 1; false -> 0 };
                                take_suffix_from_branch_arrow_balanced(slots.tail, kinds, brace_depth, np, sdepth)
                            end;
                            false -> case slots.head.token.kind == kinds.left_bracket or slots.head.token.lexeme == "[" of {
                                true -> take_suffix_from_branch_arrow_balanced(slots.tail, kinds, brace_depth, pdepth, sdepth + 1);
                                false -> case slots.head.token.kind == kinds.right_bracket or slots.head.token.lexeme == "]" of {
                                    true -> do
                                        ns: int64 <- case sdepth > 0 of { true -> sdepth - 1; false -> 0 };
                                        take_suffix_from_branch_arrow_balanced(slots.tail, kinds, brace_depth, pdepth, ns)
                                    end;
                                    false -> take_suffix_from_branch_arrow_balanced(slots.tail, kinds, brace_depth, pdepth, sdepth)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Split case-branch pattern from guard using lexer `if` (same idea as `of` / `->`): do not rely on
// role_case_guard_if being slot_role(head) after constraint merge — merged roles can order `if` last.
fn take_prefix_before_if_keyword(slots: ListTokenSlot, kinds: TokenKinds) -> ListTokenSlot proc[DeviceIO] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case slots.head.token.kind == kinds.if_keyword or slots.head.token.lexeme == "if" of {
            true -> constraint_core@empty_list_slot();
            false -> do
                tail_p: ListTokenSlot <- take_prefix_before_if_keyword(slots.tail, kinds);
                constraint_core@cons_slot(slots.head, tail_p)
            end
        }
    }
}

fn take_suffix_from_if_keyword(slots: ListTokenSlot, kinds: TokenKinds) -> ListTokenSlot proc[DeviceIO] {
    case slots.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> case slots.head.token.kind == kinds.if_keyword or slots.head.token.lexeme == "if" of {
            true -> slots;
            false -> take_suffix_from_if_keyword(slots.tail, kinds)
        }
    }
}

fn slot_lexemes_join(slots: ListTokenSlot) -> string proc[DeviceIO] {
    case slots.is_nil of {
        true -> "";
        false -> case slots_is_nil(slots.tail) of {
            true -> slots.head.token.lexeme;
            false -> do
                rest_s: string <- slot_lexemes_join(slots.tail);
                concat(concat(slots.head.token.lexeme, " "), rest_s)
            end
        }
    }
}

// Prefix of the same cons-chain as `slots` up to (but not including) suffix pointer `rest`.
fn take_prefix_slots(slots: ListTokenSlot, rest: ListTokenSlot) -> ListTokenSlot proc[DeviceIO] {
    case slots_is_nil(slots) of {
        true -> constraint_core@empty_list_slot();
        false -> case slots == rest of {
            true -> constraint_core@empty_list_slot();
            false -> do
                tail_p: ListTokenSlot <- take_prefix_slots(slots.tail, rest);
                constraint_core@cons_slot(slots.head, tail_p)
            end
        }
    }
}

// `slots` is the token stream after the opening `[`; depth is 1 inside one pair of brackets.
fn skip_square_bracket_group_depth(slots: ListTokenSlot, kinds: TokenKinds, depth: int64) -> ListTokenSlot proc[DeviceIO] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == kinds.left_bracket of {
            true -> skip_square_bracket_group_depth(slots.tail, kinds, depth + 1);
            false -> case slots.head.token.kind == kinds.right_bracket of {
                true -> case depth == 1 of {
                    true -> slots.tail;
                    false -> skip_square_bracket_group_depth(slots.tail, kinds, depth - 1)
                };
                false -> skip_square_bracket_group_depth(slots.tail, kinds, depth)
            }
        }
    }
}

fn join_lexemes_space(acc: string, lexeme: string) -> string {
    case len(acc) == 0 of {
        true -> lexeme;
        false -> concat(acc, concat(" ", lexeme))
    }
}

// Same traversal as skip_square_bracket_group_depth; accumulates lexemes like slot_lexemes_join for tokens inside
// the matching `]` (the closing `]` that ends the group is not appended). Used for generic call `[T,S]` text so we
// do not rely on take_prefix_slots(inner, rest) — ListTokenSlot `==` may not be pointer identity, yielding empty join.
fn skip_square_bracket_group_depth_join(slots: ListTokenSlot, kinds: TokenKinds, depth: int64, acc: string) -> (string, ListTokenSlot) proc[DeviceIO] {
    case slots.is_nil of {
        true -> (acc, slots);
        false -> case slots.head.token.kind == kinds.left_bracket of {
            true -> skip_square_bracket_group_depth_join(slots.tail, kinds, depth + 1, join_lexemes_space(acc, slots.head.token.lexeme));
            false -> case slots.head.token.kind == kinds.right_bracket of {
                true -> case depth == 1 of {
                    true -> (acc, slots.tail);
                    false -> skip_square_bracket_group_depth_join(slots.tail, kinds, depth - 1, join_lexemes_space(acc, slots.head.token.lexeme))
                };
                false -> skip_square_bracket_group_depth_join(slots.tail, kinds, depth, join_lexemes_space(acc, slots.head.token.lexeme))
            }
        }
    }
}

// List[...] type text: parser_tuples@extract_list_type_from_slots (used for `ident : List[...] <-` bindings).

fn extract_binding_list(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        ident_slot: TokenSlot <- slots.head;
        type_slots: ListTokenSlot <- slots_after_binding_colon(slots);
        tr: TupleTypeResult <- parser_tuples@extract_list_type_from_slots(type_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: SourceLocation <- ident_slot.token.location;
        rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
        after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
        (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(after_semicolons);
        dummy: Expr <- parser_ast@dummy_expr();
        let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
        (let_expr, rest_after_body)
    end
}

fn extract_binding_list_for_sequence(slots: ListTokenSlot, stop_kind: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        ident_slot: TokenSlot <- slots.head;
        type_slots: ListTokenSlot <- slots_after_binding_colon(slots);
        tr: TupleTypeResult <- parser_tuples@extract_list_type_from_slots(type_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: SourceLocation <- ident_slot.token.location;
        rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
        (let_expr: Expr, rest_after_body: ListTokenSlot) <- sequence_body_after_binding_rhs(rest_after_rhs, stop_kind, bind_type, bind_name, bind_loc, rhs_expr);
        (let_expr, rest_after_body)
    end
}

// Inline record/struct type: `ident : { f: T, ... } <- rhs; body`
fn extract_binding_struct(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        ident_slot: TokenSlot <- slots.head;
        type_slots: ListTokenSlot <- slots_after_binding_colon(slots);
        tr: TupleTypeResult <- parser_tuples@extract_inline_record_type_from_slots(type_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: SourceLocation <- ident_slot.token.location;
        rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
        after_semicolons: ListTokenSlot <- skip_semicolons_after_whitespace(rest_after_rhs);
        (body: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(after_semicolons);
        dummy: Expr <- parser_ast@dummy_expr();
        let_expr: Expr <- Expr { kind: 6, value: bind_type, name: bind_name, location: bind_loc, inner: rhs_expr, right_expr: body, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
        (let_expr, rest_after_body)
    end
}

fn extract_binding_struct_for_sequence(slots: ListTokenSlot, stop_kind: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        ident_slot: TokenSlot <- slots.head;
        type_slots: ListTokenSlot <- slots_after_binding_colon(slots);
        tr: TupleTypeResult <- parser_tuples@extract_inline_record_type_from_slots(type_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: SourceLocation <- ident_slot.token.location;
        rhs_slots: ListTokenSlot <- rhs_slots_after_memory_region_type(tr.rest_slots);
        (rhs_expr: Expr, rest_after_rhs: ListTokenSlot) <- extract_body(rhs_slots);
        (let_expr: Expr, rest_after_body: ListTokenSlot) <- sequence_body_after_binding_rhs(rest_after_rhs, stop_kind, bind_type, bind_name, bind_loc, rhs_expr);
        (let_expr, rest_after_body)
    end
}

// slot_lexemes_join on prefix ending at the slot after `]` still includes the `]` token; strip it so parse_generic_ts does not see "int64 , normal ]".
fn strip_trailing_rbracket_type_arg_join(s: string) -> string {
    case len(s) == 0 of {
        true -> s;
        false -> case substring(s, len(s) - 1, len(s)) == "]" of {
            true -> substring(s, 0, len(s) - 1);
            false -> s
        }
    }
}

// After a call name: optional `[T, S]` with role_call_gen_lbracket; returns (inner type-arg lexemes joined with spaces, slots at `(`).
// If constraint propagation omits role_call_gen_lbracket on `[`, still accept `name[T](` when `(` clearly follows `]`.
fn extract_optional_generic_type_args_after_name(rest_after_name: ListTokenSlot) -> (string, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots_is_nil(rest_after_name) of {
        true -> ("", rest_after_name);
        false -> case slots_head(rest_after_name).token.kind == kinds.left_bracket of {
            true -> case constraint_core@slot_role(slots_head(rest_after_name)) == capability_list@role_call_gen_lbracket() of {
                true -> do
                    (type_join: string, rest_after_brackets: ListTokenSlot) <- skip_square_bracket_group_depth_join(slots_tail(rest_after_name), kinds, 1, "");
                    rest_at_lparen: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_brackets);
                    type_args: string <- strip_trailing_rbracket_type_arg_join(type_join);
                    (type_args, rest_at_lparen)
                end;
                false -> do
                    (type_join2: string, rest_after_brackets2: ListTokenSlot) <- skip_square_bracket_group_depth_join(slots_tail(rest_after_name), kinds, 1, "");
                    rest_at_lparen: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_brackets2);
                    case slots_is_nil(rest_at_lparen) of {
                        true -> ("", rest_after_name);
                        false -> case slots_head(rest_at_lparen).token.kind == kinds.left_paren of {
                            true -> do
                                type_args: string <- strip_trailing_rbracket_type_arg_join(type_join2);
                                (type_args, rest_at_lparen)
                            end;
                            false -> ("", rest_after_name)
                        }
                    }
                end
            };
            false -> ("", rest_after_name)
        }
    }
}

// `name` followed by `[` : use extract_call when role_call_gen_lbracket is set, or when `[...]` is followed by `(` (generic call).
fn should_extract_call_after_name(rest_after_name: ListTokenSlot, kinds: TokenKinds) -> bool {
    case slots_is_nil(rest_after_name) of {
        true -> false;
        false -> case rest_after_name.head.token.kind == kinds.left_bracket of {
            true -> do
                role_ok: bool <- constraint_core@slot_role(rest_after_name.head) == capability_list@role_call_gen_lbracket();
                case role_ok of {
                    true -> true;
                    false -> do
                        rest_after_sq: ListTokenSlot <- skip_square_bracket_group_depth(slots_tail(rest_after_name), kinds, 1);
                        after_ws: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_sq);
                        case slots_is_nil(after_ws) of {
                            true -> false;
                            false -> after_ws.head.token.kind == kinds.left_paren
                        }
                    end
                }
            end;
            false -> false
        }
    }
}

fn extract_case_rhs_primary_nonempty(trimmed: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    first: TokenSlot <- trimmed.head;
    rest: ListTokenSlot <- trimmed.tail;
    first_kind: int64 <- first.token.kind;
    case slots_start_list_value_block(trimmed) of {
        true -> extract_list_value_block(trimmed);
        false -> case constraint_core@slot_role(first) == capability_case@role_case_rhs_unary_minus() of {
        true -> do
            (operand: Expr, rest_after: ListTokenSlot) <- extract_case_rhs_with_precedence(rest, 3);
            dummy: Expr <- parser_ast@dummy_expr();
            unary_minus: Expr <- Expr { kind: 12, value: "", name: "", location: first.token.location, inner: operand, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
            (unary_minus, rest_after)
        end;
        false -> case first_kind == kinds.bnot_keyword of {
            true -> do
                (operand: Expr, rest_after_bnot: ListTokenSlot) <- extract_case_rhs_with_precedence(rest, 7);
                dummy_bnot: Expr <- parser_ast@dummy_expr();
                bnot_expr: Expr <- Expr { kind: 4, value: "", name: "bnot", location: first.token.location, inner: operand, right_expr: dummy_bnot, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (bnot_expr, rest_after_bnot)
            end;
            false -> case constraint_core@slot_role(first) == capability_case@role_case_keyword() or first_kind == kinds.case_keyword of {
            true -> extract_case_expression(trimmed);
            false -> case parser_tuples@slots_start_fn_type(trimmed) of {
                true -> expr_fn_type_opaque_from_slots(trimmed);
                false -> case first.token.lexeme == "do" of {
                    true -> extract_do_end_expr_block(trimmed);
                    false -> case first_kind == kinds.left_brace or first.token.lexeme == "{" or constraint_core@slot_role(first) == capability_case@role_case_branch_lbrace() of {
            true -> case is_struct_literal_lbrace_fallback(trimmed, kinds) of {
                true -> extract_struct_literal(trimmed);
                false -> do
                    inner_slots: ListTokenSlot <- trimmed.tail;
                    (body_expr: Expr, rest_after: ListTokenSlot) <- extract_function_body(inner_slots);
                    case rest_after.is_nil of {
                        true -> (parser_ast@dummy_expr(), trimmed);
                        false -> case rest_after.head.token.kind == kinds.right_brace or rest_after.head.token.lexeme == "}" or constraint_core@slot_role(rest_after.head) == role_right_brace() of {
                            true -> (body_expr, rest_after.tail);
                            false -> (parser_ast@dummy_expr(), trimmed)
                        }
                    }
                end
            };
            false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, first_kind) of {
                true -> case slots_is_nil(rest) of {
                    true -> (extract_operand_expr(first), rest);
                    false -> case slots_head(rest).token.kind == kinds.at_sign of {
                        true -> extract_case_rhs_module_qualified_call(trimmed);
                        false -> case slots_head(rest).token.kind == kinds.left_paren of {
                            true -> extract_case_rhs_call(trimmed);
                            false -> case slots_head(rest).token.kind == kinds.left_bracket of {
                                true -> case should_extract_call_after_name(rest, kinds) of {
                                    true -> extract_case_rhs_call(trimmed);
                                    false -> (extract_operand_expr(first), rest)
                                };
                                false -> (extract_operand_expr(first), rest)
                            }
                        }
                    }
                };
                false -> case first_kind == kinds.left_bracket and (constraint_core@slot_role(first) == capability_list@role_list_lit_lbracket() or is_list_literal_lbracket_fallback(trimmed, kinds)) of {
                    true -> extract_list_literal(trimmed);
                    false -> case first_kind == kinds.left_paren of {
                        true -> extract_parenthesized(trimmed);
                        false -> case is_operand_token(kinds, first_kind) of {
                            true -> (extract_operand_expr(first), rest);
                            false -> (extract_body_expr(first), rest)
                        }
                    }
                }
            }
            }
            }
            }
        }
        }
    }
    }
}

fn extract_case_rhs_primary(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case slots_is_nil(trimmed) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> extract_case_rhs_primary_nonempty(trimmed)
    }
}

fn extract_case_rhs_binary_tail(left: Expr, rest: ListTokenSlot, min_prec: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots_is_nil(rest) of {
        true -> (left, rest);
        false -> case is_op_token(kinds, slots_head(rest).token.kind) or is_logical_op_slot(slots_head(rest), kinds) of {
            false -> (left, rest);
            true -> case op_precedence(slots_head(rest).token.lexeme) < min_prec of {
                true -> (left, rest);
                false -> do
                    op_slot: TokenSlot <- slots_head(rest);
                    rest_after_op: ListTokenSlot <- slots_tail(rest);
                    (right: Expr, rest_after_right: ListTokenSlot) <- extract_case_rhs_with_precedence(rest_after_op, op_precedence(op_slot.token.lexeme) + 1);
                    dummy: Expr <- parser_ast@dummy_expr();
                    binary: Expr <- Expr { kind: 3, value: op_slot.token.lexeme, name: "", location: op_slot.token.location, inner: left, right_expr: right, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    extract_case_rhs_binary_tail(binary, rest_after_right, min_prec)
                end
            }
        }
    }
}

fn extract_case_rhs_with_precedence(slots: ListTokenSlot, min_prec: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        (primary: Expr, rest: ListTokenSlot) <- extract_case_rhs_primary(slots);
        (after_post: Expr, rest_post: ListTokenSlot) <- extract_postfix_tail(primary, rest);
        extract_case_rhs_binary_tail(after_post, rest_post, min_prec)
    end
}

fn extract_case_rhs_call(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    first: TokenSlot <- slots.head;
    rest_after_name: ListTokenSlot <- slots.tail;
    (type_args: string, at_lparen: ListTokenSlot) <- extract_optional_generic_type_args_after_name(rest_after_name);
    case slots_is_nil(at_lparen) of {
        true -> (parser_ast@dummy_expr(), slots);
            false -> case slots_head(at_lparen).token.kind == kinds.left_paren of {
                true -> do
                    arg_slots: ListTokenSlot <- slots_tail(at_lparen);
                    arg_start: ListTokenSlot <- skip_leading_whitespace_slots(arg_slots);
                    call_name: string <- first.token.lexeme;
                    call_loc: SourceLocation <- first.token.location;
                    case slots_is_nil(arg_start) of {
                        true -> (parser_ast@dummy_expr(), slots);
                        false -> case slots_head(arg_start).token.kind == kinds.right_paren of {
                            true -> do
                                dummy_arg: Expr <- parser_ast@dummy_expr();
                                dummy_rest: Expr <- parser_ast@dummy_expr();
                                call0: Expr <- Expr { kind: 4, value: type_args, name: call_name, location: call_loc, inner: dummy_arg, right_expr: dummy_rest, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                (call0, slots_tail(arg_start))
                            end;
                            false -> do
                                (arg1: Expr, rest_after_arg1: ListTokenSlot) <- extract_case_rhs_with_precedence(arg_start, 0);
                                (rest_after_arg1_skipped: ListTokenSlot, _has_am_arg1: bool) <- skip_impl_annotation(rest_after_arg1);
                                (right_expr: Expr, rest_after_rparen: ListTokenSlot) <- extract_case_call_rest(rest_after_arg1_skipped, first.token.location);
                                call_expr: Expr <- Expr { kind: 4, value: type_args, name: call_name, location: call_loc, inner: arg1, right_expr: right_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                (call_expr, rest_after_rparen)
                            end
                        }
                    }
                end;
                false -> (parser_ast@dummy_expr(), slots)
            }
    }
}

fn extract_case_call_rest(slots: ListTokenSlot, call_loc: SourceLocation) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    dummy: Expr <- parser_ast@dummy_expr();
    case slots_is_nil(slots) of {
        true -> (dummy, slots);
        false -> case slots_head(slots).token.kind == kinds.right_paren of {
            true -> (dummy, slots_tail(slots));
            false -> case slots_head(slots).token.kind == kinds.comma of {
                true -> do
                    arg_slots: ListTokenSlot <- slots_tail(slots);
                    (arg: Expr, rest_after_arg: ListTokenSlot) <- extract_case_rhs_with_precedence(arg_slots, 0);
                    (rest_skipped: ListTokenSlot, has_impl_am: bool) <- skip_impl_annotation(rest_after_arg);
                    am_marker: string <- case has_impl_am of { true -> "AM"; false -> "" };
                    (sub_expr: Expr, rest_final: ListTokenSlot) <- extract_case_call_rest(rest_skipped, call_loc);
                    pair: Expr <- Expr { kind: 4, value: am_marker, name: "", location: call_loc, inner: arg, right_expr: sub_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    (pair, rest_final)
                end;
                false -> (dummy, slots)
            }
        }
    }
}

fn take_case_rhs_until_branch_end(slots: ListTokenSlot) -> (ListTokenSlot, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (constraint_core@empty_list_slot(), constraint_core@empty_list_slot());
        // Prefer lexer kinds so we stop before slot_role (possible_roles ordering can disagree with surface syntax).
        false -> case slots.head.token.kind == kinds.semicolon or slots.head.token.lexeme == ";" of {
            true -> (constraint_core@empty_list_slot(), slots);
            false -> case slots.head.token.kind == kinds.right_brace or slots.head.token.lexeme == "}" of {
                true -> (constraint_core@empty_list_slot(), slots);
                false -> case constraint_core@slot_role(slots.head) == capability_case@role_case_branch_stmt_sep() of {
                    true -> (constraint_core@empty_list_slot(), slots);
                    false -> case constraint_core@slot_role(slots.head) == role_right_brace() of {
                        true -> (constraint_core@empty_list_slot(), slots);
                        false -> do
                            (tail_p: ListTokenSlot, rest: ListTokenSlot) <- take_case_rhs_until_branch_end(slots.tail);
                            (constraint_core@cons_slot(slots.head, tail_p), rest)
                        end
                    }
                }
            }
        }
    }
}

fn extract_one_case_branch(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    before_arrow: ListTokenSlot <- take_prefix_before_branch_arrow(slots, kinds);
    from_arrow: ListTokenSlot <- take_suffix_from_branch_arrow(slots, kinds);
    case slots_is_nil(from_arrow) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> do
            after_arrow: ListTokenSlot <- from_arrow.tail;
            pat_before_if: ListTokenSlot <- take_prefix_before_if_keyword(before_arrow, kinds);
            from_if: ListTokenSlot <- take_suffix_from_if_keyword(before_arrow, kinds);
            case slots_is_nil(from_if) of {
                true -> do
                    pat_str: string <- slot_lexemes_join(before_arrow);
                    dummy_g: Expr <- parser_ast@dummy_expr();
                    (rhs_e: Expr, after_rhs: ListTokenSlot) <- extract_case_rhs_with_precedence(after_arrow, 0);
                    branch_e: Expr <- Expr { kind: 18, value: pat_str, name: "", location: slots.head.token.location, inner: dummy_g, right_expr: rhs_e, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    after_semi: ListTokenSlot <- skip_case_branch_terminator(after_rhs);
                    (branch_e, after_semi)
                end;
                false -> do
                    // after_if is only the guard expression (e.g. is_positive(z)); it has no `->`.
                    // The arrow before the branch RHS is the outer from_arrow (split from the full branch line).
                    after_if: ListTokenSlot <- from_if.tail;
                    pat_str: string <- slot_lexemes_join(pat_before_if);
                    guard_slots: ListTokenSlot <- take_prefix_before_branch_arrow(after_if, kinds);
                    guard_rhs_slots: ListTokenSlot <- from_arrow.tail;
                    (guard_e: Expr, _: ListTokenSlot) <- extract_expr_with_precedence(guard_slots, 0);
                    (rhs_e2: Expr, after_rhs2: ListTokenSlot) <- extract_case_rhs_with_precedence(guard_rhs_slots, 0);
                    branch_e2: Expr <- Expr { kind: 18, value: pat_str, name: "", location: slots.head.token.location, inner: guard_e, right_expr: rhs_e2, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    after_semi2: ListTokenSlot <- skip_case_branch_terminator(after_rhs2);
                    (branch_e2, after_semi2)
                end
            }
        end
    }
}

fn skip_case_branch_terminator(slots: ListTokenSlot) -> ListTokenSlot proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    ws: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case ws.is_nil of {
        true -> ws;
        false -> case ws.head.token.kind == kinds.semicolon or ws.head.token.lexeme == ";" of {
            true -> skip_leading_whitespace_slots(ws.tail);
            false -> case constraint_core@slot_role(ws.head) == capability_case@role_case_branch_stmt_sep() of {
                true -> skip_leading_whitespace_slots(ws.tail);
                false -> ws
            }
        }
    }
}

fn extract_case_branches_list(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    extract_case_branches_list_impl(slots, 0)
}

// branch_depth: without this outer guard the bootstrap-built compiler overflows the stack parsing case branch lists; it also caps non-advancing extraction.
fn extract_case_branches_list_impl(slots: ListTokenSlot, branch_depth: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case branch_depth >= 512 of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case trimmed.is_nil of {
            true -> (parser_ast@dummy_expr(), slots);
            // Match `}` by lexer kind first so we never call extract_one on a lone `}` (from_arrow empty -> infinite recursion).
            false -> case trimmed.head.token.kind == kinds.right_brace or trimmed.head.token.lexeme == "}" of {
                true -> (parser_ast@dummy_expr(), trimmed);
                false -> case constraint_core@slot_role(trimmed.head) == role_right_brace() of {
                    true -> (parser_ast@dummy_expr(), trimmed);
                    false -> do
                        (one: Expr, after_one: ListTokenSlot) <- extract_one_case_branch(trimmed);
                        (rest_list: Expr, final_rest: ListTokenSlot) <- extract_case_branches_list_impl(after_one, branch_depth + 1);
                        list_node: Expr <- Expr { kind: 17, value: "", name: "", location: one.location, inner: one, right_expr: rest_list, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        (list_node, final_rest)
                    end
                }
            }
        }
    }
}

fn extract_case_expression(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case_keyword_slot: TokenSlot <- slots.head;
    after_case: ListTokenSlot <- slots.tail;
    scrutinee_slots: ListTokenSlot <- take_prefix_before_role_or_of_keyword(after_case, capability_case@role_case_of(), kinds);
    at_of: ListTokenSlot <- take_suffix_from_role_or_of_keyword(after_case, capability_case@role_case_of(), kinds);
    (scrutinee: Expr, _: ListTokenSlot) <- extract_expr_with_precedence(scrutinee_slots, 0);
    case slots_is_nil(at_of) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> do
            after_of: ListTokenSlot <- at_of.tail;
            after_of_trimmed: ListTokenSlot <- skip_leading_whitespace_slots(after_of);
            case slots_is_nil(after_of_trimmed) of {
                true -> (parser_ast@dummy_expr(), slots);
                false -> case after_of_trimmed.head.token.kind == kinds.left_brace or after_of_trimmed.head.token.lexeme == "{" or constraint_core@slot_role(after_of_trimmed.head) == capability_case@role_case_branch_lbrace() of {
                    true -> do
                        inner: ListTokenSlot <- after_of_trimmed.tail;
                        (branches: Expr, at_close: ListTokenSlot) <- extract_case_branches_list(inner);
                        case slots_is_nil(at_close) of {
                            true -> (parser_ast@dummy_expr(), slots);
                            false -> case at_close.head.token.kind == kinds.right_brace or at_close.head.token.lexeme == "}" or constraint_core@slot_role(at_close.head) == role_right_brace() of {
                                true -> do
                                    case_e: Expr <- Expr { kind: 13, value: "", name: "", location: case_keyword_slot.token.location, inner: scrutinee, right_expr: branches, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                    (case_e, at_close.tail)
                                end;
                                false -> (parser_ast@dummy_expr(), slots)
                            }
                        }
                    end;
                    false -> (parser_ast@dummy_expr(), slots)
                }
            }
        end
    }
}

fn is_actor_callable_keyword(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.spawn_keyword or token_kind == kinds.spawn_dangerous_keyword or token_kind == kinds.spawn_dangerous_registered_keyword or token_kind == kinds.spawn_registered_keyword or token_kind == kinds.spawn_linked_keyword or token_kind == kinds.spawn_registered_supervisor_keyword or token_kind == kinds.call_supervisor_keyword or token_kind == kinds.link_keyword or token_kind == kinds.monitor_keyword or token_kind == kinds.demonitor_keyword or token_kind == kinds.send_keyword or token_kind == kinds.cast_keyword or token_kind == kinds.self_keyword or lexer_token_kind@is_actor_runtime_helper_kind(kinds, token_kind)
}

fn expr_fn_type_opaque_from_slots(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    first: TokenSlot <- slots.head;
    (fn_ty: string, rest_after_fn: ListTokenSlot) <- parser_tuples@extract_fn_type_from_slots(slots);
    dumx: Expr <- parser_ast@dummy_expr();
    fn_ty_expr: Expr <- Expr {
        kind: 992,
        value: fn_ty,
        name: "__fn_type_expr__",
        location: first.token.location,
        inner: dumx,
        right_expr: dumx,
        pattern_bindings: parser_ast@nil_tuple_decompose_bindings(),
        sequence_effects: parser_ast@empty_effect_name_list()
    };
    (fn_ty_expr, rest_after_fn)
}

// `fn(int64) -> T` uses opaque fn-type parsing; `fn(x: T) -> U {`, `fn() -> U {`, `fn((a:T,...)) -> U {` introduce lambdas.
fn lambda_introduces_body_after_sig(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case parser_tuples@slots_start_fn_type(slots) of {
        false -> false;
        true -> do
            after_kw: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
            case after_kw.is_nil of {
                true -> false;
                false -> case after_kw.head.token.kind == kinds.left_paren of {
                    false -> false;
                    true -> case after_kw.tail.is_nil of {
                        true -> false;
                        false -> case after_kw.tail.head.token.kind == kinds.right_paren of {
                            true -> true;
                            false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, after_kw.tail.head.token.kind) of {
                                true -> true;
                                false -> case after_kw.tail.head.token.kind == kinds.left_paren of {
                                    true -> true;
                                    false -> false
                                }
                            }
                        }
                    }
                }
            }
        end
    }
}

fn param_types_str_lambda(params: ListParam) -> string {
    case params.is_nil of {
        true -> "";
        false -> case params.tail.is_nil of {
            true -> params.head.type_name;
            false -> concat(concat(param_types_str_lambda(params.tail), ","), params.head.type_name)
        }
    }
}

fn build_lambda_fn_type_value(params: ListParam, ret: string) -> string {
    case params.is_nil of {
        true -> concat("() -> ", ret);
        false -> concat(concat(concat("(", param_types_str_lambda(params)), ") -> "), ret)
    }
}

fn params_to_lambda_bindings(params: ListParam) -> ListTupleDecomposeBinding {
    case params.is_nil of {
        true -> parser_ast@nil_tuple_decompose_bindings();
        false -> do
            p: Param <- params.head;
            b: TupleDecomposeBinding <- parser_ast@make_tuple_decompose_binding(p.name, "", p.type_name);
            parser_ast@cons_tuple_decompose_binding(b, params_to_lambda_bindings(params.tail))
        end
    }
}

fn extract_lambda_expression(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    kw_slot: TokenSlot <- slots.head;
    after_kw: ListTokenSlot <- slots.tail;
    (params: ListParam, ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, body_slots: ListTokenSlot) <- collect_params_and_find_type_and_body(after_kw);
    (body_expr: Expr, rest_after_body: ListTokenSlot) <- extract_function_body(body_slots);
    bindings: ListTupleDecomposeBinding <- params_to_lambda_bindings(params);
    fn_ty_val: string <- build_lambda_fn_type_value(params, ret_type);
    dumx: Expr <- parser_ast@dummy_expr();
    ret_holder: Expr <- Expr {
        kind: 992,
        value: ret_type,
        name: "__lambda_ret__",
        location: ret_type_loc,
        inner: dumx,
        right_expr: dumx,
        pattern_bindings: parser_ast@nil_tuple_decompose_bindings(),
        sequence_effects: parser_ast@empty_effect_name_list()
    };
    lam: Expr <- Expr {
        kind: 991,
        value: fn_ty_val,
        name: "__lambda__",
        location: kw_slot.token.location,
        inner: body_expr,
        right_expr: ret_holder,
        pattern_bindings: bindings,
        sequence_effects: effects
    };
    rest_ws: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_body);
    rest_after_lambda: ListTokenSlot <- case rest_ws.is_nil of {
        true -> rest_ws;
        false -> case rest_ws.head.token.kind == kinds.right_brace or rest_ws.head.token.lexeme == "}" of {
            true -> rest_ws.tail;
            false -> rest_ws
        }
    };
    (lam, rest_after_lambda)
}

fn extract_primary(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    first: TokenSlot <- slots.head;
    // `fn` before case probe: slot_role can mark `fn` with role_case_keyword in type/record regions,
    // which would route to extract_case_expression and misparse `(msg:...) ->` as statements (E1040).
    // Also reject `identifier`+lexeme`fn`+`(` as a call — use opaque function-type expr (kind 992).
    case slots_start_list_value_block(slots) of {
        true -> extract_list_value_block(slots);
        false -> case parser_tuples@slots_start_fn_type(slots) of {
        true -> case lambda_introduces_body_after_sig(slots) of {
            true -> extract_lambda_expression(slots);
            false -> expr_fn_type_opaque_from_slots(slots)
        };
        false -> case first.token.kind == kinds.bnot_keyword of {
            true -> do
                rest_bnot: ListTokenSlot <- slots.tail;
                (operand_bnot: Expr, rest_after_bnot: ListTokenSlot) <- extract_expr_with_precedence(rest_bnot, 7);
                dummy_bnot: Expr <- parser_ast@dummy_expr();
                bnot_expr: Expr <- Expr { kind: 4, value: "", name: "bnot", location: first.token.location, inner: operand_bnot, right_expr: dummy_bnot, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (bnot_expr, rest_after_bnot)
            end;
            false -> case constraint_core@slot_role(first) == capability_case@role_case_keyword() or first.token.kind == kinds.case_keyword of {
            true -> extract_case_expression(slots);
            false -> do
                rest: ListTokenSlot <- slots.tail;
                first_kind: int64 <- first.token.kind;
                case lexer_token_kind@is_identifier_lexeme_token(kinds, first_kind) or first_kind == kinds.buf_keyword or first_kind == kinds.ref_keyword or first_kind == kinds.region_keyword or first_kind == kinds.atomic_keyword or is_actor_callable_keyword(kinds, first_kind) of {
                    true -> case slots_is_nil(rest) of {
                        true -> (extract_operand_expr(first), rest);
                        false -> case slots_head(rest).token.kind == kinds.at_sign of {
                            true -> extract_module_qualified_value(slots);
                            false -> case slots_head(rest).token.kind == kinds.left_paren of {
                                true -> extract_call(slots);
                                false -> case slots_head(rest).token.kind == kinds.left_bracket of {
                                    true -> case should_extract_call_after_name(rest, kinds) of {
                                        true -> extract_call(slots);
                                        false -> (extract_operand_expr(first), rest)
                                    };
                                    false -> (extract_operand_expr(first), rest)
                                }
                            }
                        }
                    };
                    false -> case first_kind == kinds.left_bracket and (constraint_core@slot_role(first) == capability_list@role_list_lit_lbracket() or is_list_literal_lbracket_fallback(slots, kinds)) of {
                        true -> extract_list_literal(slots);
                        false -> case first_kind == kinds.left_brace and is_struct_literal_lbrace_fallback(slots, kinds) of {
                            true -> extract_struct_literal(slots);
                            false -> case first_kind == kinds.minus of {
                                true -> do
                                    (operand: Expr, rest_after: ListTokenSlot) <- extract_expr_with_precedence(rest, 3);
                                    dummy_m: Expr <- parser_ast@dummy_expr();
                                    unary_minus: Expr <- Expr { kind: 12, value: "", name: "", location: first.token.location, inner: operand, right_expr: dummy_m, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                    (unary_minus, rest_after)
                                end;
                                false -> case first_kind == kinds.left_paren of {
                                    true -> extract_parenthesized(slots);
                                    false -> case is_operand_token(kinds, first_kind) of {
                                        true -> (extract_operand_expr(first), rest);
                                        false -> (extract_body_expr(first), rest)
                                    }
                                }
                            }
                        }
                    }
                }
            end
        }
        }
    }
    }
}

fn extract_binary_tail(left: Expr, rest: ListTokenSlot, min_prec: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots_is_nil(rest) of {
        true -> (left, rest);
        false -> case is_op_token(kinds, slots_head(rest).token.kind) or is_logical_op_slot(slots_head(rest), kinds) of {
            false -> (left, rest);
            true -> case op_precedence(slots_head(rest).token.lexeme) < min_prec of {
                true -> (left, rest);
                false -> do
                    op_slot: TokenSlot <- slots_head(rest);
                    rest_after_op: ListTokenSlot <- slots_tail(rest);
                    (right: Expr, rest_after_right: ListTokenSlot) <- extract_expr_with_precedence(rest_after_op, op_precedence(op_slot.token.lexeme) + 1);
                    dummy: Expr <- parser_ast@dummy_expr();
                    binary: Expr <- Expr { kind: 3, value: op_slot.token.lexeme, name: "", location: op_slot.token.location, inner: left, right_expr: right, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    extract_binary_tail(binary, rest_after_right, min_prec)
                end
            }
        }
    }
}

// Field access and future postfix ops: binds tighter than binary ops (e.g. a.b + c → (a.b) + c).
fn extract_postfix_tail(left: Expr, rest: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    dummy: Expr <- parser_ast@dummy_expr();
    case slots_is_nil(rest) of {
        true -> (left, rest);
        false -> case slots_head(rest).token.kind == kinds.dot of {
            true -> case slots_is_nil(slots_tail(rest)) of {
                true -> (left, rest);
                false -> case is_struct_field_name_token(kinds, slots_head(slots_tail(rest)).token) of {
                    true -> do
                        dot_slot: TokenSlot <- slots_head(rest);
                        field_slot: TokenSlot <- slots_head(slots_tail(rest));
                        after_field: ListTokenSlot <- slots_tail(slots_tail(rest));
                        field_access: Expr <- Expr { kind: 22, value: "", name: field_slot.token.lexeme, location: dot_slot.token.location, inner: left, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        extract_postfix_tail(field_access, after_field)
                    end;
                    false -> (left, rest)
                }
            };
            false -> (left, rest)
        }
    }
}

fn extract_expr_with_precedence(slots: ListTokenSlot, min_prec: int64) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    do
        (primary: Expr, rest: ListTokenSlot) <- extract_primary(slots);
        (after_post: Expr, rest_post: ListTokenSlot) <- extract_postfix_tail(primary, rest);
        extract_binary_tail(after_post, rest_post, min_prec)
    end
}

fn skip_impl_annotation(slots: ListTokenSlot) -> (ListTokenSlot, bool) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (slots, false);
        false -> case trimmed.head.token.kind == kinds.impl_keyword or trimmed.head.token.lexeme == "impl" of {
            true -> do
                after_impl: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                case after_impl.is_nil of {
                    true -> (slots, false);
                    false -> do
                        after_name: ListTokenSlot <- skip_leading_whitespace_slots(after_impl.tail);
                        case after_name.is_nil of {
                            true -> (slots, false);
                            false -> case after_name.head.token.kind == kinds.left_brace of {
                                true -> do
                                    after_lbrace: ListTokenSlot <- skip_leading_whitespace_slots(after_name.tail);
                                    case after_lbrace.is_nil of {
                                        true -> (slots, false);
                                        false -> case after_lbrace.head.token.kind == kinds.right_brace of {
                                            true -> (after_lbrace.tail, true);
                                            false -> (slots, false)
                                        }
                                    }
                                end;
                                false -> (slots, false)
                            }
                        }
                    end
                }
            end;
            false -> (slots, false)
        }
    }
}

// Module-qualified call (silica-spec §3.3.2): kind4 like extract_call; `name` is the function identifier; `value` is generic type-arg text only.
fn extract_module_qualified_call(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    mod_slot: TokenSlot <- slots.head;
    after_mod: ListTokenSlot <- slots.tail;
    case slots_is_nil(after_mod) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case after_mod.head.token.kind == kinds.at_sign of {
            true -> do
                after_at_raw: ListTokenSlot <- after_mod.tail;
                after_at: ListTokenSlot <- skip_leading_whitespace_slots(after_at_raw);
                case slots_is_nil(after_at) of {
                    true -> (parser_ast@dummy_expr(), slots);
                    false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, after_at.head.token.kind) of {
                        true -> do
                            fn_slot: TokenSlot <- after_at.head;
                            rest_after_name: ListTokenSlot <- after_at.tail;
                            (type_args: string, at_lparen: ListTokenSlot) <- extract_optional_generic_type_args_after_name(rest_after_name);
                            case slots_is_nil(at_lparen) of {
                                true -> (parser_ast@dummy_expr(), slots);
                                false -> case slots_head(at_lparen).token.kind == kinds.left_paren of {
                                    true -> do
                                        call_loc: SourceLocation <- mod_slot.token.location;
                                        arg_slots: ListTokenSlot <- slots_tail(at_lparen);
                                        (arg1: Expr, rest_after_arg1: ListTokenSlot) <- extract_body(arg_slots);
                                        (rest_skipped: ListTokenSlot, _has_am_arg1: bool) <- skip_impl_annotation(rest_after_arg1);
                                        (right_expr: Expr, rest_after_rparen: ListTokenSlot) <- extract_call_rest(rest_skipped, call_loc);
                                        mq_name: string <- concat(concat(mod_slot.token.lexeme, "@"), fn_slot.token.lexeme);
                                        call_expr: Expr <- Expr { kind: 4, value: type_args, name: mq_name, location: call_loc, inner: arg1, right_expr: right_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                        (call_expr, rest_after_rparen)
                                    end;
                                    false -> (parser_ast@dummy_expr(), slots)
                                }
                            }
                        end;
                        false -> (parser_ast@dummy_expr(), slots)
                    }
                }
            end;
            false -> (parser_ast@dummy_expr(), slots)
        }
    }
}

// Module-qualified function reference: `Module@function` without call parentheses.
// Use identifier expression shape so function-value paths treat it like a bare `function`.
fn extract_module_qualified_reference(mod_slot: TokenSlot, fn_slot: TokenSlot) -> Expr {
    dummy: Expr <- parser_ast@dummy_expr();
    mq_name: string <- concat(concat(mod_slot.token.lexeme, "@"), fn_slot.token.lexeme);
    Expr { kind: 1, value: "", name: mq_name, location: mod_slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
}

fn extract_module_qualified_value(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    mod_slot: TokenSlot <- slots.head;
    after_mod: ListTokenSlot <- slots.tail;
    case slots_is_nil(after_mod) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case after_mod.head.token.kind == kinds.at_sign of {
            true -> do
                after_at_raw: ListTokenSlot <- after_mod.tail;
                after_at: ListTokenSlot <- skip_leading_whitespace_slots(after_at_raw);
                case slots_is_nil(after_at) of {
                    true -> (parser_ast@dummy_expr(), slots);
                    false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, after_at.head.token.kind) of {
                        true -> do
                            fn_slot: TokenSlot <- after_at.head;
                            rest_after_name: ListTokenSlot <- after_at.tail;
                            (type_args: string, at_lparen: ListTokenSlot) <- extract_optional_generic_type_args_after_name(rest_after_name);
                            case slots_is_nil(at_lparen) of {
                                true -> (extract_module_qualified_reference(mod_slot, fn_slot), at_lparen);
                                false -> case slots_head(at_lparen).token.kind == kinds.left_paren of {
                                    true -> extract_module_qualified_call(slots);
                                    false -> case len(type_args) == 0 of {
                                        true -> (extract_module_qualified_reference(mod_slot, fn_slot), at_lparen);
                                        false -> (parser_ast@dummy_expr(), slots)
                                    }
                                }
                            }
                        end;
                        false -> (parser_ast@dummy_expr(), slots)
                    }
                }
            end;
            false -> (parser_ast@dummy_expr(), slots)
        }
    }
}

fn extract_case_rhs_module_qualified_call(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    mod_slot: TokenSlot <- slots.head;
    after_mod: ListTokenSlot <- slots.tail;
    case slots_is_nil(after_mod) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case after_mod.head.token.kind == kinds.at_sign of {
            true -> do
                after_at_raw: ListTokenSlot <- after_mod.tail;
                after_at: ListTokenSlot <- skip_leading_whitespace_slots(after_at_raw);
                case slots_is_nil(after_at) of {
                    true -> (parser_ast@dummy_expr(), slots);
                    false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, after_at.head.token.kind) of {
                        true -> do
                            fn_slot: TokenSlot <- after_at.head;
                            rest_after_name: ListTokenSlot <- after_at.tail;
                            (type_args: string, at_lparen: ListTokenSlot) <- extract_optional_generic_type_args_after_name(rest_after_name);
                            case slots_is_nil(at_lparen) of {
                                true -> (parser_ast@dummy_expr(), slots);
                                false -> case slots_head(at_lparen).token.kind == kinds.left_paren of {
                                    true -> do
                                        call_loc: SourceLocation <- mod_slot.token.location;
                                        arg_slots: ListTokenSlot <- slots_tail(at_lparen);
                                        mq_case_name: string <- concat(concat(mod_slot.token.lexeme, "@"), fn_slot.token.lexeme);
                                        arg_start: ListTokenSlot <- skip_leading_whitespace_slots(arg_slots);
                                        case slots_is_nil(arg_start) of {
                                            true -> (parser_ast@dummy_expr(), slots);
                                            false -> case slots_head(arg_start).token.kind == kinds.right_paren of {
                                                true -> do
                                                    dummy_arg: Expr <- parser_ast@dummy_expr();
                                                    dummy_rest: Expr <- parser_ast@dummy_expr();
                                                    call0: Expr <- Expr { kind: 4, value: type_args, name: mq_case_name, location: call_loc, inner: dummy_arg, right_expr: dummy_rest, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                                    (call0, slots_tail(arg_start))
                                                end;
                                                false -> do
                                                    (arg1: Expr, rest_after_arg1: ListTokenSlot) <- extract_case_rhs_with_precedence(arg_start, 0);
                                                    (right_expr: Expr, rest_after_rparen: ListTokenSlot) <- extract_case_call_rest(rest_after_arg1, call_loc);
                                                    call_expr: Expr <- Expr { kind: 4, value: type_args, name: mq_case_name, location: call_loc, inner: arg1, right_expr: right_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                                    (call_expr, rest_after_rparen)
                                                end
                                            }
                                        }
                                    end;
                                    false -> (parser_ast@dummy_expr(), slots)
                                }
                            }
                        end;
                        false -> (parser_ast@dummy_expr(), slots)
                    }
                }
            end;
            false -> (parser_ast@dummy_expr(), slots)
        }
    }
}

// `extract_body` may leave leading whitespace before `)` or `,` in the remaining token stream
// (e.g., `{ field: val }` parsed from `call(..., { field: val }, next)` returns rest = `", next )"`
// where a space precedes `)`).  Trim once at the top so both the `)` and `,` checks are
// whitespace-agnostic, matching the same approach used in `extract_struct_fields_tail`.
fn extract_call_rest(slots: ListTokenSlot, call_loc: SourceLocation) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    dummy: Expr <- parser_ast@dummy_expr();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case slots_is_nil(trimmed) of {
        true -> (dummy, trimmed);
        false -> case slots_head(trimmed).token.kind == kinds.right_paren of {
            true -> (dummy, slots_tail(trimmed));
            false -> case slots_head(trimmed).token.kind == kinds.comma of {
                true -> do
                    arg_slots: ListTokenSlot <- slots_tail(trimmed);
                    (arg: Expr, rest_after_arg: ListTokenSlot) <- extract_body(arg_slots);
                    (rest_skipped: ListTokenSlot, has_impl_am: bool) <- skip_impl_annotation(rest_after_arg);
                    am_marker: string <- case has_impl_am of { true -> "AM"; false -> "" };
                    (sub_expr: Expr, rest_final: ListTokenSlot) <- extract_call_rest(rest_skipped, call_loc);
                    pair: Expr <- Expr { kind: 4, value: am_marker, name: "", location: call_loc, inner: arg, right_expr: sub_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    (pair, rest_final)
                end;
                false -> (dummy, trimmed)
            }
        }
    }
}

fn extract_call(slots: ListTokenSlot) -> (Expr, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    first: TokenSlot <- slots.head;
    rest_after_name: ListTokenSlot <- slots.tail;
    (type_args: string, at_lparen: ListTokenSlot) <- extract_optional_generic_type_args_after_name(rest_after_name);
    case slots_is_nil(at_lparen) of {
        true -> (parser_ast@dummy_expr(), slots);
        false -> case slots_head(at_lparen).token.kind == kinds.left_paren of {
            true -> do
                arg_slots: ListTokenSlot <- slots_tail(at_lparen);
                (arg1: Expr, rest_after_arg1: ListTokenSlot) <- extract_body(arg_slots);
                (rest_after_arg1_skipped: ListTokenSlot, _has_am_arg1: bool) <- skip_impl_annotation(rest_after_arg1);
                (right_expr: Expr, rest_after_rparen: ListTokenSlot) <- extract_call_rest(rest_after_arg1_skipped, first.token.location);
                call_name: string <- first.token.lexeme;
                call_loc: SourceLocation <- first.token.location;
                call_expr: Expr <- Expr { kind: 4, value: type_args, name: call_name, location: call_loc, inner: arg1, right_expr: right_expr, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                (call_expr, rest_after_rparen)
            end;
            false -> (parser_ast@dummy_expr(), slots)
        }
    }
}

fn extract_operand_expr(slot: TokenSlot) -> Expr {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    dummy: Expr <- parser_ast@dummy_expr();
    case slot.token.kind == kinds.integer_literal of {
        true -> Expr { kind: 0, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
        false -> case slot.token.kind == kinds.float_literal of {
            true -> Expr { kind: 0, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
            false -> case slot.token.kind == kinds.atom_literal of {
                true -> Expr { kind: 5, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                false -> case slot.token.kind == kinds.true_literal of {
                    true -> Expr { kind: 7, value: "true", name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    false -> case slot.token.kind == kinds.false_literal of {
                        true -> Expr { kind: 7, value: "false", name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        false -> case slot.token.kind == kinds.string_literal of {
                            true -> Expr { kind: 8, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            false -> case slot.token.kind == kinds.char_literal of {
                                true -> Expr { kind: 0, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                false -> Expr { kind: 1, value: "", name: slot.token.lexeme, location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn extract_body_expr(slot: TokenSlot) -> Expr {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    dummy: Expr <- parser_ast@dummy_expr();
    case slot.token.kind == kinds.integer_literal of {
        true -> Expr { kind: 0, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
        false -> case slot.token.kind == kinds.float_literal of {
            true -> Expr { kind: 0, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
            false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slot.token.kind) or slot.token.kind == kinds.buf_keyword or slot.token.kind == kinds.ref_keyword or slot.token.kind == kinds.region_keyword or slot.token.kind == kinds.atomic_keyword of {
                true -> Expr { kind: 1, value: "", name: slot.token.lexeme, location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                false -> case slot.token.kind == kinds.atom_literal of {
                    true -> Expr { kind: 5, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                    false -> case slot.token.kind == kinds.true_literal of {
                        true -> Expr { kind: 7, value: "true", name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                        false -> case slot.token.kind == kinds.false_literal of {
                            true -> Expr { kind: 7, value: "false", name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                            false -> case slot.token.kind == kinds.string_literal of {
                                true -> Expr { kind: 8, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                false -> case slot.token.kind == kinds.char_literal of {
                                    true -> Expr { kind: 0, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                                    false -> Expr { kind: 0, value: slot.token.lexeme, name: "", location: slot.token.location, inner: dummy, right_expr: dummy, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}


fn append_decl_lists(a: ListDeclaration, b: ListDeclaration) -> ListDeclaration {
    case a.is_nil of {
        true -> b;
        false -> parser_ast@cons_declaration(a.head, append_decl_lists(a.tail, b))
    }
}

fn is_required_section_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == kinds.required_keyword
    }
}

fn is_provided_section_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == kinds.provided_keyword
    }
}

fn is_impl_fn_decl_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> do
                w: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                case w.is_nil of {
                    true -> false;
                    false -> slots.head.token.kind == kinds.impl_keyword and w.head.token.kind == kinds.fn_keyword
                }
            end
        }
    }
}

fn is_postfix_message_impl_marker_start(after_impl: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case after_impl.is_nil of {
        true -> false;
        false -> case after_impl.head.token.lexeme == "ActorMessage" or after_impl.head.token.lexeme == "SupervisorMessage" of {
            false -> false;
            true -> do
                after_name: ListTokenSlot <- skip_leading_whitespace_slots(after_impl.tail);
                case after_name.is_nil of {
                    true -> false;
                    false -> after_name.head.token.kind == kinds.left_brace
                }
            end
        }
    }
}

fn is_trait_marker_impl_start(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> do
                w: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                case w.is_nil of {
                    true -> false;
                    false -> case slots.head.token.kind == kinds.impl_keyword of {
                        true -> case w.head.token.kind == kinds.fn_keyword of {
                            true -> false;
                            false -> case is_postfix_message_impl_marker_start(w) of {
                                true -> false;
                                false -> true
                            }
                        };
                        false -> false
                    }
                }
            end
        }
    }
}

// Trait marker impl body (`impl T for Trait;`): join token lexemes with a single space so the
// downstream suffix check for ` for Supervisor` / ` for FailureReporter` (type_checker_supervisor,
// sir_generator/declarations/traits) can detect the trait target. Prior form joined with no
// separator, turning `PhaseDSup for Supervisor` into `PhaseDSupforSupervisor` and hiding the
// supervisor metadata that Phase D depends on.
fn concat_tokens_until_semicolon(slots: ListTokenSlot) -> (string, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> ("", slots);
        false -> case slots.head.token.kind == kinds.semicolon of {
            true -> ("", slots.tail);
            false -> do
                piece: string <- slots.head.token.lexeme;
                (suf: string, after: ListTokenSlot) <- concat_tokens_until_semicolon(slots.tail);
                sep: string <- case len(suf) == 0 of { true -> ""; false -> " " };
                full: string <- concat(piece, concat(sep, suf));
                (full, after)
            end
        }
    }
}

fn extract_trait_marker_impl(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.impl_keyword of {
            false -> (parser_ast@dummy_decl(), slots);
            true -> do
                impl_loc: SourceLocation <- slots.head.token.location;
                after_impl: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                (type_src: string, after_semi: ListTokenSlot) <- concat_tokens_until_semicolon(after_impl);
                dummy_b: Expr <- parser_ast@dummy_expr();
                zero_loc_m: SourceLocation <- parser_ast@zero_location();
                decl_m: Declaration <- Declaration { tag: 6, name: "", parameters: parser_ast@nil_list_param(), return_type_name: type_src, return_type_location: zero_loc_m, location: impl_loc, body: dummy_b, declared_effects: parser_ast@empty_effect_name_list() };
                (decl_m, after_semi)
            end
        }
    }
}

fn extract_impl_fn_function(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    extract_function(slots.tail)
}

fn extract_trait_required_fn(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    r1: ListTokenSlot <- slots.tail;
    fn_name: string <- r1.head.token.lexeme;
    fn_loc: SourceLocation <- r1.head.token.location;
    (params: ListParam, ret_type: string, ret_type_loc: SourceLocation, effects: ListEffectName, after_sig: ListTokenSlot) <- collect_params_and_find_type_and_semicolon(r1.tail);
    dummy_body: Expr <- parser_ast@dummy_expr();
    decl: Declaration <- Declaration { tag: 7, name: fn_name, parameters: params, return_type_name: ret_type, return_type_location: ret_type_loc, location: fn_loc, body: dummy_body, declared_effects: effects };
    (decl, after_sig)
}

fn declarations_from_slots_trait_required(slots: ListTokenSlot) -> (ListDeclaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@empty_list_decl(), trimmed);
        false -> case trimmed.head.token.kind == kinds.right_brace or trimmed.head.token.lexeme == "}" of {
            true -> (parser_ast@empty_list_decl(), trimmed);
            false -> do
                (d: Declaration, rest: ListTokenSlot) <- extract_trait_required_fn(trimmed);
                (tail_decls: ListDeclaration, final_rest: ListTokenSlot) <- declarations_from_slots_trait_required(rest);
                (parser_ast@cons_declaration(d, tail_decls), final_rest)
            end
        }
    }
}

fn declarations_from_slots_trait_provided(slots: ListTokenSlot) -> (ListDeclaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@empty_list_decl(), trimmed);
        false -> case trimmed.head.token.kind == kinds.right_brace or trimmed.head.token.lexeme == "}" of {
            true -> (parser_ast@empty_list_decl(), trimmed);
            false -> do
                (d: Declaration, rest: ListTokenSlot) <- extract_function(trimmed);
                (tail_decls: ListDeclaration, final_rest: ListTokenSlot) <- declarations_from_slots_trait_provided(rest);
                (parser_ast@cons_declaration(d, tail_decls), final_rest)
            end
        }
    }
}

fn extract_required_top_level_block(slots: ListTokenSlot) -> (ListDeclaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@empty_list_decl(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.required_keyword of {
            false -> (parser_ast@empty_list_decl(), slots);
            true -> do
                after_kw: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                case after_kw.is_nil of {
                    true -> (parser_ast@empty_list_decl(), after_kw);
                    false -> case after_kw.head.token.kind == kinds.left_brace or after_kw.head.token.lexeme == "{" of {
                        false -> (parser_ast@empty_list_decl(), after_kw);
                        true -> do
                            inner: ListTokenSlot <- after_kw.tail;
                            (decls_inner: ListDeclaration, rest_after_inner: ListTokenSlot) <- declarations_from_slots_trait_required(inner);
                            rest_scan: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_inner);
                            case rest_scan.is_nil of {
                                true -> (decls_inner, rest_scan);
                                false -> case rest_scan.head.token.kind == kinds.right_brace or rest_scan.head.token.lexeme == "}" of {
                                    true -> (decls_inner, rest_scan.tail);
                                    false -> (decls_inner, rest_scan)
                                }
                            }
                        end
                    }
                }
            end
        }
    }
}

fn extract_provided_top_level_block(slots: ListTokenSlot) -> (ListDeclaration, ListTokenSlot) proc[DeviceIO] {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (parser_ast@empty_list_decl(), constraint_core@empty_list_slot());
        false -> case slots.head.token.kind == kinds.provided_keyword of {
            false -> (parser_ast@empty_list_decl(), slots);
            true -> do
                after_kw: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                case after_kw.is_nil of {
                    true -> (parser_ast@empty_list_decl(), after_kw);
                    false -> case after_kw.head.token.kind == kinds.left_brace or after_kw.head.token.lexeme == "{" of {
                        false -> (parser_ast@empty_list_decl(), after_kw);
                        true -> do
                            inner: ListTokenSlot <- after_kw.tail;
                            (decls_inner: ListDeclaration, rest_after_inner: ListTokenSlot) <- declarations_from_slots_trait_provided(inner);
                            rest_scan: ListTokenSlot <- skip_leading_whitespace_slots(rest_after_inner);
                            case rest_scan.is_nil of {
                                true -> (decls_inner, rest_scan);
                                false -> case rest_scan.head.token.kind == kinds.right_brace or rest_scan.head.token.lexeme == "}" of {
                                    true -> (decls_inner, rest_scan.tail);
                                    false -> (decls_inner, rest_scan)
                                }
                            }
                        end
                    }
                }
            end
        }
    }
}

fn extract_one_declaration(slots: ListTokenSlot) -> (Declaration, ListTokenSlot) proc[DeviceIO] {
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case is_use_decl_start(trimmed) of {
        true -> extract_use_declaration(trimmed);
        false -> case is_export_decl_start(trimmed) of {
            true -> extract_export_declaration(trimmed);
            false -> case is_module_decl_start(trimmed) of {
                true -> extract_module_declaration(trimmed);
                false -> case is_wrapper_meta_decl_start(trimmed) of {
                    true -> extract_wrapper_meta_declaration(trimmed);
                    false -> case is_foreign_decl_start(trimmed) of {
                        true -> extract_foreign_declaration(trimmed);
                        false -> case is_effect_decl_start(trimmed) of {
                            true -> extract_effect_declaration(trimmed);
                            false -> case is_impl_fn_decl_start(trimmed) of {
                                true -> extract_impl_fn_function(trimmed);
                                false -> case is_trait_marker_impl_start(trimmed) of {
                                    true -> extract_trait_marker_impl(trimmed);
                                    false -> case is_fn_decl_start(trimmed) of {
                                        true -> extract_function(trimmed);
                                        false -> do
                                            (parser_ast@dummy_decl(), trimmed.tail)
                                        end
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn declarations_from_slots(slots: ListTokenSlot) -> ListDeclaration proc[DeviceIO] {
    trimmed_top: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed_top.is_nil of {
        true -> parser_ast@empty_list_decl();
        false -> case is_required_section_start(trimmed_top) of {
            true -> do
                (req_decls: ListDeclaration, after_req: ListTokenSlot) <- extract_required_top_level_block(trimmed_top);
                append_decl_lists(req_decls, declarations_from_slots(after_req))
            end;
            false -> case is_provided_section_start(trimmed_top) of {
                true -> do
                    (prov_decls: ListDeclaration, after_prov: ListTokenSlot) <- extract_provided_top_level_block(trimmed_top);
                    append_decl_lists(prov_decls, declarations_from_slots(after_prov))
                end;
                false -> case slots.is_nil of {
                    true -> parser_ast@empty_list_decl();
                    false -> case slots.tail.is_nil of {
                        true -> parser_ast@empty_list_decl();
                        false -> do
                            (decl: Declaration, rest: ListTokenSlot) <- extract_one_declaration(slots);
                            case decl.tag >= 0 of {
                                true -> do
                                    tail_decls: ListDeclaration <- declarations_from_slots(rest);
                                    parser_ast@cons_declaration(decl, tail_decls)
                                end;
                                false -> declarations_from_slots(slots.tail)
                            }
                        end
                    }
                }
            }
        }
    }
}

fn program_location_from_decls(decls: ListDeclaration) -> SourceLocation {
    case decls.is_nil of {
        true -> parser_ast@zero_location();
        false -> decls.head.location
    }
}

fn slots_to_program(slots: ListTokenSlot) -> Program proc[DeviceIO] {
    decls: ListDeclaration <- declarations_from_slots(slots);
    Program { declarations: decls, location: program_location_from_decls(decls) }
}

fn append_declaration_lists(a: ListDeclaration, b: ListDeclaration) -> ListDeclaration {
    case a.is_nil of {
        true -> b;
        false -> parser_ast@cons_declaration(a.head, append_declaration_lists(a.tail, b))
    }
}

// --- Lambda lifting: outer-visible bindings (let + outer lambda formals) for capture params ---

fn append_tb_front(a: ListTupleDecomposeBinding, b: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    case a.is_nil of {
        true -> b;
        false -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(a.head.name, a.head.path, a.head.type_str), append_tb_front(a.tail, b))
    }
}

fn merge_tb_union(a: ListTupleDecomposeBinding, b: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    case a.is_nil of {
        true -> b;
        false -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(a.head.name, a.head.path, a.head.type_str), merge_tb_union(a.tail, b))
    }
}

fn tuple_bindings_contains_name(bindings: ListTupleDecomposeBinding, nm: string) -> bool {
    case bindings.is_nil of {
        true -> false;
        false -> case bindings.head.name == nm of {
            true -> true;
            false -> tuple_bindings_contains_name(bindings.tail, nm)
        }
    }
}

fn lookup_outer_binding_type(outer_visible: ListTupleDecomposeBinding, nm: string) -> string {
    case outer_visible.is_nil of {
        true -> "";
        false -> case outer_visible.head.name == nm of {
            true -> outer_visible.head.type_str;
            false -> lookup_outer_binding_type(outer_visible.tail, nm)
        }
    }
}

fn reverse_tb_loop(tb: ListTupleDecomposeBinding, acc: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    case tb.is_nil of {
        true -> acc;
        false -> reverse_tb_loop(tb.tail, parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(tb.head.name, tb.head.path, tb.head.type_str), acc))
    }
}

fn dedupe_tb_unique_first(tb: ListTupleDecomposeBinding, acc: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    case tb.is_nil of {
        true -> reverse_tb_loop(acc, parser_ast@nil_tuple_decompose_bindings());
        false -> case tuple_bindings_contains_name(acc, tb.head.name) of {
            true -> dedupe_tb_unique_first(tb.tail, acc);
            false -> dedupe_tb_unique_first(tb.tail, parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(tb.head.name, tb.head.path, tb.head.type_str), acc))
        }
    }
}

fn capture_tb_to_params(tb: ListTupleDecomposeBinding) -> ListParam {
    case tb.is_nil of {
        true -> parser_ast@nil_list_param();
        false -> parser_ast@cons_param(parser_ast@rebuild_param(tb.head.name, tb.head.type_str, parser_ast@zero_location()), capture_tb_to_params(tb.tail))
    }
}

fn is_discard_let_name(nm: string) -> bool {
    nm == "_"
}

// Free variables that must be captured from enclosing scope for a lambda body (lexical closures).
fn collect_free_for_lambda(expr: Expr, lambda_formals: ListTupleDecomposeBinding, inner_lets: ListTupleDecomposeBinding, outer_visible: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    case expr.kind == -1 of {
        true -> parser_ast@nil_tuple_decompose_bindings();
        false -> case expr.kind == 991 of {
            true -> collect_free_for_lambda(expr.inner, expr.pattern_bindings, parser_ast@nil_tuple_decompose_bindings(), outer_visible);
            false -> case expr.kind == 6 of {
                true -> do
                    left_tb: ListTupleDecomposeBinding <- collect_free_for_lambda(expr.inner, lambda_formals, inner_lets, outer_visible);
                    ext_inner: ListTupleDecomposeBinding <- case is_discard_let_name(expr.name) of {
                        true -> inner_lets;
                        false -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(expr.name, "", expr.value), inner_lets)
                    };
                    right_tb: ListTupleDecomposeBinding <- collect_free_for_lambda(expr.right_expr, lambda_formals, ext_inner, outer_visible);
                    merge_tb_union(left_tb, right_tb)
                end;
                false -> case expr.kind == 10 of {
                    true -> do
                        inner_tb_td: ListTupleDecomposeBinding <- collect_free_for_lambda(expr.inner, lambda_formals, inner_lets, outer_visible);
                        merged_td: ListTupleDecomposeBinding <- append_tb_front(parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings), inner_lets);
                        right_tb_td: ListTupleDecomposeBinding <- collect_free_for_lambda(expr.right_expr, lambda_formals, merged_td, outer_visible);
                        merge_tb_union(inner_tb_td, right_tb_td)
                    end;
                    false -> case expr.kind == 1 of {
                        true -> do
                            nm: string <- expr.name;
                            case tuple_bindings_contains_name(lambda_formals, nm) of {
                                true -> parser_ast@nil_tuple_decompose_bindings();
                                false -> case tuple_bindings_contains_name(inner_lets, nm) of {
                                    true -> parser_ast@nil_tuple_decompose_bindings();
                                    false -> do
                                        cap_ty: string <- lookup_outer_binding_type(outer_visible, nm);
                                        case len(cap_ty) > 0 of {
                                            true -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(nm, "", cap_ty), parser_ast@nil_tuple_decompose_bindings());
                                            false -> parser_ast@nil_tuple_decompose_bindings()
                                        }
                                    end
                                }
                            }
                        end;
                        false -> do
                            lv: ListTupleDecomposeBinding <- collect_free_for_lambda(expr.inner, lambda_formals, inner_lets, outer_visible);
                            rv: ListTupleDecomposeBinding <- collect_free_for_lambda(expr.right_expr, lambda_formals, inner_lets, outer_visible);
                            merge_tb_union(lv, rv)
                        end
                    }
                }
            }
        }
    }
}

fn lift_lambda_expr(expr: Expr, fn_name: string, seq: int64, outer_visible: ListTupleDecomposeBinding) -> (Expr, ListDeclaration, int64) {
    case expr.kind == -1 of {
        true -> (expr, parser_ast@empty_list_decl(), seq);
        false -> case expr.kind == 991 of {
            true -> do
                rebuilt_lam_tb: ListTupleDecomposeBinding <- parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings);
                inner_lift_env: ListTupleDecomposeBinding <- append_tb_front(rebuilt_lam_tb, outer_visible);
                (body2: Expr, l_inner: ListDeclaration, seq1: int64) <- lift_lambda_expr(expr.inner, fn_name, seq, inner_lift_env);
                syn: string <- concat(fn_name, concat(".__lam", atom_table@int64_to_decimal_string(seq1)));
                ret_ty: string <- expr.right_expr.value;
                raw_caps: ListTupleDecomposeBinding <- collect_free_for_lambda(expr.inner, rebuilt_lam_tb, parser_ast@nil_tuple_decompose_bindings(), outer_visible);
                caps_tb: ListTupleDecomposeBinding <- dedupe_tb_unique_first(raw_caps, parser_ast@nil_tuple_decompose_bindings());
                capt_lp: ListParam <- capture_tb_to_params(caps_tb);
                decl: Declaration <- parser_ast@declaration_from_lambda_lift(syn, expr.pattern_bindings, capt_lp, ret_ty, expr.right_expr.location, expr.location, body2, expr.sequence_effects);
                dummy_i: Expr <- parser_ast@dummy_expr();
                ident: Expr <- Expr { kind: 1, value: "", name: syn, location: expr.location, inner: dummy_i, right_expr: dummy_i, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() };
                batch: ListDeclaration <- parser_ast@cons_declaration(decl, parser_ast@empty_list_decl());
                (ident, append_declaration_lists(l_inner, batch), seq1 + 1)
            end;
            false -> case expr.kind == 6 of {
                true -> do
                    (i2: Expr, li: ListDeclaration, s1: int64) <- lift_lambda_expr(expr.inner, fn_name, seq, outer_visible);
                    ext: ListTupleDecomposeBinding <- case is_discard_let_name(expr.name) of {
                        true -> outer_visible;
                        false -> parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(expr.name, "", expr.value), outer_visible)
                    };
                    (r2: Expr, lr: ListDeclaration, s2: int64) <- lift_lambda_expr(expr.right_expr, fn_name, s1, ext);
                    merged_let: ListDeclaration <- append_declaration_lists(li, lr);
                    out_let: Expr <- Expr { kind: expr.kind, value: expr.value, name: expr.name, location: expr.location, inner: i2, right_expr: r2, pattern_bindings: parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings), sequence_effects: parser_ast@rebuild_effect_name_list(expr.sequence_effects) };
                    (out_let, merged_let, s2)
                end;
                false -> case expr.kind == 10 of {
                    true -> do
                        (i_td: Expr, li_td: ListDeclaration, s1_td: int64) <- lift_lambda_expr(expr.inner, fn_name, seq, outer_visible);
                        ext_td: ListTupleDecomposeBinding <- append_tb_front(parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings), outer_visible);
                        (r_td: Expr, lr_td: ListDeclaration, s2_td: int64) <- lift_lambda_expr(expr.right_expr, fn_name, s1_td, ext_td);
                        merged_td: ListDeclaration <- append_declaration_lists(li_td, lr_td);
                        out_td: Expr <- Expr { kind: expr.kind, value: expr.value, name: expr.name, location: expr.location, inner: i_td, right_expr: r_td, pattern_bindings: parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings), sequence_effects: parser_ast@rebuild_effect_name_list(expr.sequence_effects) };
                        (out_td, merged_td, s2_td)
                    end;
                    false -> do
                        (i2: Expr, li: ListDeclaration, s1: int64) <- lift_lambda_expr(expr.inner, fn_name, seq, outer_visible);
                        (r2: Expr, lr: ListDeclaration, s2: int64) <- lift_lambda_expr(expr.right_expr, fn_name, s1, outer_visible);
                        merged: ListDeclaration <- append_declaration_lists(li, lr);
                        out: Expr <- Expr { kind: expr.kind, value: expr.value, name: expr.name, location: expr.location, inner: i2, right_expr: r2, pattern_bindings: parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings), sequence_effects: parser_ast@rebuild_effect_name_list(expr.sequence_effects) };
                        (out, merged, s2)
                    end
                }
            }
        }
    }
}

fn list_param_to_outer_bindings(params: ListParam) -> ListTupleDecomposeBinding {
    case params.is_nil of {
        true -> parser_ast@nil_tuple_decompose_bindings();
        false -> parser_ast@cons_tuple_decompose_binding(
            parser_ast@make_tuple_decompose_binding(params.head.name, "", params.head.type_name),
            list_param_to_outer_bindings(params.tail)
        )
    }
}

fn lift_decl_list(decls: ListDeclaration, seq: int64, lifted_suffix: ListDeclaration) -> (ListDeclaration, int64, ListDeclaration) {
    case decls.is_nil of {
        true -> (parser_ast@empty_list_decl(), seq, lifted_suffix);
        false -> case decls.head.tag == 0 of {
            true -> do
                d: Declaration <- decls.head;
                param_outer: ListTupleDecomposeBinding <- list_param_to_outer_bindings(d.parameters);
                (body2: Expr, batch: ListDeclaration, seq2: int64) <- lift_lambda_expr(d.body, d.name, seq, param_outer);
                lifted2: ListDeclaration <- append_declaration_lists(lifted_suffix, batch);
                new_d: Declaration <- parser_ast@declaration_with_body(d, body2);
                (rest_new: ListDeclaration, seq3: int64, lifted3: ListDeclaration) <- lift_decl_list(decls.tail, seq2, lifted2);
                (parser_ast@cons_declaration(new_d, rest_new), seq3, lifted3)
            end;
            false -> do
                d2: Declaration <- decls.head;
                (rest_new2: ListDeclaration, seq4: int64, lifted4: ListDeclaration) <- lift_decl_list(decls.tail, seq, lifted_suffix);
                (parser_ast@cons_declaration(d2, rest_new2), seq4, lifted4)
            end
        }
    }
}

// --- HOF arity shim: lifted lambdas append captures as extra parameters (sir_generator functions.silica),
// Argument lists hold specs (ident or int lexeme only); Expr nodes are built last to avoid E2000 on Expr-in-struct lists.

struct HofArgSpec {
    is_ident: bool,
    text: string
}

struct HofArgSpecList {
    is_nil: bool,
    head: HofArgSpec,
    tail: HofArgSpecList
}

fn hof_nil_arg_specs() -> HofArgSpecList {
    ph: HofArgSpecList <- HofArgSpecList { is_nil: true, head: HofArgSpec { is_ident: true, text: "" }, tail: ph };
    ph
}

fn hof_cons_arg_spec(s: HofArgSpec, rest: HofArgSpecList) -> HofArgSpecList {
    HofArgSpecList { is_nil: false, head: s, tail: rest }
}

fn hof_spec_to_expr(s: HofArgSpec, loc: SourceLocation) -> Expr {
    case s.is_ident of {
        true -> expr_ident_here(s.text, loc);
        false -> expr_int_here(s.text, loc)
    }
}

fn hof_suffix_call_chain_specs(es: HofArgSpecList, loc: SourceLocation) -> Expr {
    dummy_tail: Expr <- parser_ast@dummy_expr();
    case es.tail.is_nil of {
        true -> parser_ast@dummy_expr();
        false -> case es.tail.tail.is_nil of {
            true -> Expr {
                kind: 4,
                value: "",
                name: "",
                location: loc,
                inner: hof_spec_to_expr(es.head, loc),
                right_expr: Expr {
                    kind: 4,
                    value: "",
                    name: "",
                    location: loc,
                    inner: hof_spec_to_expr(es.tail.head, loc),
                    right_expr: dummy_tail,
                    pattern_bindings: parser_ast@nil_tuple_decompose_bindings(),
                    sequence_effects: parser_ast@empty_effect_name_list()
                },
                pattern_bindings: parser_ast@nil_tuple_decompose_bindings(),
                sequence_effects: parser_ast@empty_effect_name_list()
            };
            false -> do
                suf: Expr <- hof_suffix_call_chain_specs(es.tail, loc);
                Expr {
                    kind: 4,
                    value: "",
                    name: "",
                    location: loc,
                    inner: hof_spec_to_expr(es.head, loc),
                    right_expr: suf,
                    pattern_bindings: parser_ast@nil_tuple_decompose_bindings(),
                    sequence_effects: parser_ast@empty_effect_name_list()
                }
            end
        }
    }
}

fn hof_call_expr_from_arg_specs(callee: string, args: HofArgSpecList, loc: SourceLocation) -> Expr {
    case args.is_nil of {
        true -> parser_ast@dummy_expr();
        false -> case args.tail.is_nil of {
            true -> Expr {
                kind: 4,
                value: "",
                name: callee,
                location: loc,
                inner: hof_spec_to_expr(args.head, loc),
                right_expr: parser_ast@dummy_expr(),
                pattern_bindings: parser_ast@nil_tuple_decompose_bindings(),
                sequence_effects: parser_ast@empty_effect_name_list()
            };
            false -> case args.tail.tail.is_nil of {
                true -> Expr {
                    kind: 4,
                    value: "",
                    name: callee,
                    location: loc,
                    inner: hof_spec_to_expr(args.head, loc),
                    right_expr: hof_spec_to_expr(args.tail.head, loc),
                    pattern_bindings: parser_ast@nil_tuple_decompose_bindings(),
                    sequence_effects: parser_ast@empty_effect_name_list()
                };
                false -> Expr {
                    kind: 4,
                    value: "",
                    name: callee,
                    location: loc,
                    inner: hof_spec_to_expr(args.head, loc),
                    right_expr: hof_suffix_call_chain_specs(args.tail, loc),
                    pattern_bindings: parser_ast@nil_tuple_decompose_bindings(),
                    sequence_effects: parser_ast@empty_effect_name_list()
                }
            }
        }
    }
}

// but call sites typed with surface arity (e.g. op(a,b)) do not pass them. When every capture resolves to an
// int64 literal visible in the let-environment, synthesize an arity-only wrapper main.__lwN that forwards to
// main.__lamN with those literals (closure in register forwarding does not survive nested calls like op(num,num)).

fn lifted_name_sub_at(m: string, i: int64) -> bool {
    case i + 6 > len(m) of {
        true -> false;
        false -> case substring(m, i, i + 6) == ".__lam" of {
            true -> true;
            false -> lifted_name_sub_at(m, i + 1)
        }
    }
}

fn name_has_lifted_lambda_sub(m: string) -> bool {
    lifted_name_sub_at(m, 0)
}

fn find_tag0_decl_by_name(decls: ListDeclaration, nm: string) -> Declaration {
    case decls.is_nil of {
        true -> parser_ast@dummy_decl();
        false -> case decls.head.tag == 0 and decls.head.name == nm of {
            true -> decls.head;
            false -> find_tag0_decl_by_name(decls.tail, nm)
        }
    }
}

fn list_param_len_w(ps: ListParam) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> 1 + list_param_len_w(ps.tail)
    }
}

fn list_param_take_n_w(ps: ListParam, n: int64) -> ListParam {
    case n <= 0 of {
        true -> parser_ast@nil_list_param();
        false -> case ps.is_nil of {
            true -> parser_ast@nil_list_param();
            false -> parser_ast@cons_param(ps.head, list_param_take_n_w(ps.tail, n - 1))
        }
    }
}

fn list_param_drop_n_w(ps: ListParam, n: int64) -> ListParam {
    case n <= 0 of {
        true -> ps;
        false -> case ps.is_nil of {
            true -> parser_ast@nil_list_param();
            false -> list_param_drop_n_w(ps.tail, n - 1)
        }
    }
}

fn nth_param_type_of_list(ps: ListParam, idx: int64) -> string {
    case idx <= 0 of {
        true -> ps.head.type_name;
        false -> nth_param_type_of_list(ps.tail, idx - 1)
    }
}

// collect_params_loop builds ListParam with cons_param (head = last source param). User call args are
// left-to-right, so user arg i maps to parameter at index (len - 1 - i).
fn nth_param_type_for_user_call_arg(ps: ListParam, user_arg_idx: int64) -> string {
    n: int64 <- list_param_len_w(ps);
    nth_param_type_of_list(ps, n - 1 - user_arg_idx)
}

fn fn_type_count_formals(ty: string) -> int64 {
    t: string <- ty;
    case len(t) < 2 of {
        true -> -1;
        false -> case substring(t, 0, 2) == "fn" of {
            false -> -1;
            true -> do
                open: int64 <- find_first_paren_fn_ty(t, 0);
                case open < 0 of {
                    true -> -1;
                    false -> do
                        nch: int64 <- len(t);
                        after0: int64 <- open + 1;
                        after: int64 <- skip_spaces_in_fn_type_str(t, after0, nch);
                        case after < nch and substring(t, after, after + 1) == ")" of {
                            true -> 0;
                            false -> count_fn_inner_commas_loop(t, after, nch, 1, 0)
                        }
                    end
                }
            end
        }
    }
}

fn find_first_paren_fn_ty(s: string, i: int64) -> int64 {
    case i + 1 > len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "(" of {
            true -> i;
            false -> find_first_paren_fn_ty(s, i + 1)
        }
    }
}

// Token-extracted fn types may contain spaces inside `(` `)` (e.g. `fn( ) -> T`); align with empty-formals detection.
fn skip_spaces_in_fn_type_str(s: string, i: int64, n: int64) -> int64 {
    case i >= n of {
        true -> i;
        false -> case substring(s, i, i + 1) == " " of {
            true -> skip_spaces_in_fn_type_str(s, i + 1, n);
            false -> i
        }
    }
}

fn count_fn_inner_commas_loop(s: string, i: int64, n: int64, depth: int64, commas: int64) -> int64 {
    case i >= n of {
        true -> -1;
        false -> do
            ch: string <- substring(s, i, i + 1);
            d2: int64 <- case ch == "(" of {
                true -> depth + 1;
                false -> case ch == ")" of {
                    true -> depth - 1;
                    false -> depth
                }
            };
            case d2 == 0 of {
                true -> commas + 1;
                false -> do
                    c2: int64 <- case depth == 1 and ch == "," of {
                        true -> commas + 1;
                        false -> commas
                    };
                    count_fn_inner_commas_loop(s, i + 1, n, d2, c2)
                end
            }
        end
    }
}

fn let_env_cons_int_lit(nm: string, int_lex: string, tail: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    parser_ast@cons_tuple_decompose_binding(parser_ast@make_tuple_decompose_binding(nm, int_lex, "__silica_intlit__"), tail)
}

fn let_env_lookup_int_lit(env: ListTupleDecomposeBinding, nm: string) -> (bool, string) {
    case env.is_nil of {
        true -> (false, "");
        false -> case env.head.name == nm of {
            true -> case env.head.type_str == "__silica_intlit__" of {
                true -> (true, env.head.path);
                false -> (false, "")
            };
            false -> let_env_lookup_int_lit(env.tail, nm)
        }
    }
}

fn fold_seq_lets_int_literals(e: Expr, acc: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    case e.kind == 6 of {
        true -> do
            acc2: ListTupleDecomposeBinding <- case e.inner.kind == 0 of {
                true -> let_env_cons_int_lit(e.name, e.inner.value, acc);
                false -> acc
            };
            fold_seq_lets_int_literals(e.right_expr, acc2)
        end;
        false -> acc
    }
}

fn expr_ident_here(nm: string, loc: SourceLocation) -> Expr {
    d: Expr <- parser_ast@dummy_expr();
    Expr { kind: 1, value: "", name: nm, location: loc, inner: d, right_expr: d, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
}

fn expr_int_here(lex: string, loc: SourceLocation) -> Expr {
    d: Expr <- parser_ast@dummy_expr();
    Expr { kind: 0, value: lex, name: "", location: loc, inner: d, right_expr: d, pattern_bindings: parser_ast@nil_tuple_decompose_bindings(), sequence_effects: parser_ast@empty_effect_name_list() }
}

fn user_call_arg_count_w(expr: Expr) -> int64 {
    case expr.inner.kind == -1 of {
        true -> 0;
        false -> case expr.right_expr.kind == -1 of {
            true -> 1;
            false -> case expr.right_expr.kind == 4 of {
                true -> 1 + user_call_arg_count_w(expr.right_expr);
                false -> 2
            }
        }
    }
}

fn user_call_replace_arg_at(expr: Expr, want: int64, cur: int64, new_arg: Expr) -> Expr {
    case expr.inner.kind == -1 of {
        true -> expr;
        false -> case want == cur of {
            true -> Expr {
                kind: expr.kind,
                value: expr.value,
                name: expr.name,
                location: expr.location,
                inner: new_arg,
                right_expr: expr.right_expr,
                pattern_bindings: parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings),
                sequence_effects: parser_ast@rebuild_effect_name_list(expr.sequence_effects)
            };
            false -> case expr.right_expr.kind == 4 of {
                true -> Expr {
                    kind: expr.kind,
                    value: expr.value,
                    name: expr.name,
                    location: expr.location,
                    inner: expr.inner,
                    right_expr: user_call_replace_arg_at(expr.right_expr, want, cur + 1, new_arg),
                    pattern_bindings: parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings),
                    sequence_effects: parser_ast@rebuild_effect_name_list(expr.sequence_effects)
                };
                false -> case want == cur + 1 of {
                    true -> Expr {
                        kind: expr.kind,
                        value: expr.value,
                        name: expr.name,
                        location: expr.location,
                        inner: expr.inner,
                        right_expr: new_arg,
                        pattern_bindings: parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings),
                        sequence_effects: parser_ast@rebuild_effect_name_list(expr.sequence_effects)
                    };
                    false -> expr
                }
            }
        }
    }
}

fn user_call_arg_expr_at(expr: Expr, want: int64, cur: int64) -> Expr {
    case expr.inner.kind == -1 of {
        true -> parser_ast@dummy_expr();
        false -> case want == cur of {
            true -> expr.inner;
            false -> case expr.right_expr.kind == -1 of {
                true -> parser_ast@dummy_expr();
                false -> case expr.right_expr.kind == 4 of {
                    true -> user_call_arg_expr_at(expr.right_expr, want, cur + 1);
                    false -> case want == cur + 1 of {
                        true -> expr.right_expr;
                        false -> parser_ast@dummy_expr()
                    }
                }
            }
        }
    }
}

fn build_lifted_call_arg_specs(lifted_ps: ListParam, exp_ct: int64, idx: int64, env: ListTupleDecomposeBinding, loc: SourceLocation) -> (bool, HofArgSpecList) {
    case lifted_ps.is_nil of {
        true -> (true, hof_nil_arg_specs());
        false -> do
            (rest_ok: bool, rest_le: HofArgSpecList) <- build_lifted_call_arg_specs(lifted_ps.tail, exp_ct, idx + 1, env, loc);
            case rest_ok of {
                false -> (false, hof_nil_arg_specs());
                true -> case idx < exp_ct of {
                    true -> (true, hof_cons_arg_spec(HofArgSpec { is_ident: true, text: lifted_ps.head.name }, rest_le));
                    false -> do
                        (okv: bool, vx: string) <- let_env_lookup_int_lit(env, lifted_ps.head.name);
                        case okv of {
                            false -> (false, hof_nil_arg_specs());
                            true -> (true, hof_cons_arg_spec(HofArgSpec { is_ident: false, text: vx }, rest_le))
                        }
                    end
                }
            }
        end
    }
}

fn hof_wrap_one_arg_if_needed(expr: Expr, callee_decl: Declaration, arg_idx: int64, arg_e: Expr, enclosing_fn: string, all_decls: ListDeclaration, let_env: ListTupleDecomposeBinding, seq: int64) -> (Expr, int64, ListDeclaration) {
    case arg_e.kind == 1 of {
        false -> (expr, seq, parser_ast@empty_list_decl());
        true -> case name_has_lifted_lambda_sub(arg_e.name) of {
            false -> (expr, seq, parser_ast@empty_list_decl());
            true -> do
                lifted: Declaration <- find_tag0_decl_by_name(all_decls, arg_e.name);
                case lifted.tag != 0 of {
                    true -> (expr, seq, parser_ast@empty_list_decl());
                    false -> do
                        exp_ty: string <- nth_param_type_for_user_call_arg(callee_decl.parameters, arg_idx);
                        exp_ct: int64 <- fn_type_count_formals(exp_ty);
                        full_ct: int64 <- list_param_len_w(lifted.parameters);
                        case exp_ct < 0 of {
                            true -> (expr, seq, parser_ast@empty_list_decl());
                            false -> case full_ct > exp_ct of {
                                false -> (expr, seq, parser_ast@empty_list_decl());
                                true -> do
                                    loc: SourceLocation <- expr.location;
                                    (args_ok: bool, ale: HofArgSpecList) <- build_lifted_call_arg_specs(lifted.parameters, exp_ct, 0, let_env, loc);
                                    case args_ok of {
                                        false -> (expr, seq, parser_ast@empty_list_decl());
                                        true -> do
                                            body_call: Expr <- hof_call_expr_from_arg_specs(lifted.name, ale, loc);
                                            wrap_nm: string <- concat(enclosing_fn, concat(".__lw", atom_table@int64_to_decimal_string(seq)));
                                            wrap_ps: ListParam <- list_param_take_n_w(lifted.parameters, exp_ct);
                                            wrap_decl: Declaration <- Declaration {
                                                tag: 0,
                                                name: wrap_nm,
                                                parameters: wrap_ps,
                                                return_type_name: lifted.return_type_name,
                                                return_type_location: lifted.return_type_location,
                                                location: loc,
                                                body: body_call,
                                                declared_effects: parser_ast@empty_effect_name_list()
                                            };
                                            use_ident: Expr <- expr_ident_here(wrap_nm, loc);
                                            rew: Expr <- user_call_replace_arg_at(expr, arg_idx, 0, use_ident);
                                            (rew, seq + 1, parser_ast@cons_declaration(wrap_decl, parser_ast@empty_list_decl()))
                                        end
                                    }
                                end
                            }
                        }
                    end
                }
            end
        }
    }
}

fn hof_wrap_scan_all_args(expr: Expr, callee_decl: Declaration, arg_idx: int64, n_args: int64, enclosing_fn: string, all_decls: ListDeclaration, let_env: ListTupleDecomposeBinding, seq: int64) -> (Expr, int64, ListDeclaration) {
    case arg_idx >= n_args of {
        true -> (expr, seq, parser_ast@empty_list_decl());
        false -> do
            arg_e: Expr <- user_call_arg_expr_at(expr, arg_idx, 0);
            (e2: Expr, s2: int64, w2: ListDeclaration) <- hof_wrap_one_arg_if_needed(expr, callee_decl, arg_idx, arg_e, enclosing_fn, all_decls, let_env, seq);
            (erest: Expr, srest: int64, wrest: ListDeclaration) <- hof_wrap_scan_all_args(e2, callee_decl, arg_idx + 1, n_args, enclosing_fn, all_decls, let_env, s2);
            (erest, srest, append_declaration_lists(w2, wrest))
        end
    }
}

fn try_hof_wrap_after_user_call(expr: Expr, enclosing_fn: string, all_decls: ListDeclaration, let_env: ListTupleDecomposeBinding, seq: int64) -> (Expr, int64, ListDeclaration) {
    callee: string <- expr.name;
    d: Declaration <- find_tag0_decl_by_name(all_decls, callee);
    case d.tag != 0 of {
        true -> (expr, seq, parser_ast@empty_list_decl());
        false -> do
            n_args: int64 <- user_call_arg_count_w(expr);
            hof_wrap_scan_all_args(expr, d, 0, n_args, enclosing_fn, all_decls, let_env, seq)
        end
    }
}

fn rebuild_expr_shallow(expr: Expr, inner: Expr, right_expr: Expr) -> Expr {
    Expr {
        kind: expr.kind,
        value: expr.value,
        name: expr.name,
        location: expr.location,
        inner: inner,
        right_expr: right_expr,
        pattern_bindings: parser_ast@rebuild_tuple_decompose_binding_list(expr.pattern_bindings),
        sequence_effects: parser_ast@rebuild_effect_name_list(expr.sequence_effects)
    }
}

fn wrap_walk_expr(expr: Expr, enclosing_fn: string, all_decls: ListDeclaration, seq: int64, let_env: ListTupleDecomposeBinding) -> (Expr, int64, ListDeclaration) {
    case expr.kind == 1 of {
        true -> (expr, seq, parser_ast@empty_list_decl());
        false -> case expr.kind == 0 of {
            true -> (expr, seq, parser_ast@empty_list_decl());
            false -> case expr.kind == 2 of {
                true -> do
                    (i2: Expr, s1: int64, w1: ListDeclaration) <- wrap_walk_expr(expr.inner, enclosing_fn, all_decls, seq, let_env);
                    (rebuild_expr_shallow(expr, i2, expr.right_expr), s1, w1)
                end;
                false -> case expr.kind == 6 of {
                    true -> do
                        (i2: Expr, s0: int64, w0: ListDeclaration) <- wrap_walk_expr(expr.inner, enclosing_fn, all_decls, seq, let_env);
                        env2: ListTupleDecomposeBinding <- case i2.kind == 0 of {
                            true -> let_env_cons_int_lit(expr.name, i2.value, let_env);
                            false -> let_env
                        };
                        (r2: Expr, s1: int64, w1: ListDeclaration) <- wrap_walk_expr(expr.right_expr, enclosing_fn, all_decls, s0, env2);
                        (rebuild_expr_shallow(expr, i2, r2), s1, append_declaration_lists(w0, w1))
                    end;
                    false -> case expr.kind == 11 of {
                        true -> do
                            (inner2: Expr, s0: int64, w0: ListDeclaration) <- wrap_walk_expr(expr.inner, enclosing_fn, all_decls, seq, let_env);
                            env2: ListTupleDecomposeBinding <- fold_seq_lets_int_literals(inner2, let_env);
                            (res2: Expr, s1: int64, w1: ListDeclaration) <- wrap_walk_expr(expr.right_expr, enclosing_fn, all_decls, s0, env2);
                            (rebuild_expr_shallow(expr, inner2, res2), s1, append_declaration_lists(w0, w1))
                        end;
                        false -> case expr.kind == 4 of {
                            true -> do
                                (i2: Expr, s0: int64, w0: ListDeclaration) <- wrap_walk_expr(expr.inner, enclosing_fn, all_decls, seq, let_env);
                                (r2: Expr, s1: int64, w1: ListDeclaration) <- wrap_walk_expr(expr.right_expr, enclosing_fn, all_decls, s0, let_env);
                                e_mid: Expr <- rebuild_expr_shallow(expr, i2, r2);
                                (e3: Expr, s2: int64, w2: ListDeclaration) <- try_hof_wrap_after_user_call(e_mid, enclosing_fn, all_decls, let_env, s1);
                                (e3, s2, append_declaration_lists(w0, append_declaration_lists(w1, w2)))
                            end;
                            false -> case expr.kind == 3 of {
                                true -> do
                                    (l2: Expr, s0: int64, w0: ListDeclaration) <- wrap_walk_expr(expr.inner, enclosing_fn, all_decls, seq, let_env);
                                    (r2: Expr, s1: int64, w1: ListDeclaration) <- wrap_walk_expr(expr.right_expr, enclosing_fn, all_decls, s0, let_env);
                                    (rebuild_expr_shallow(expr, l2, r2), s1, append_declaration_lists(w0, w1))
                                end;
                                false -> case expr.kind == 12 of {
                                    true -> do
                                        (i2: Expr, s0: int64, w0: ListDeclaration) <- wrap_walk_expr(expr.inner, enclosing_fn, all_decls, seq, let_env);
                                        (rebuild_expr_shallow(expr, i2, expr.right_expr), s0, w0)
                                    end;
                                    false -> (expr, seq, parser_ast@empty_list_decl())
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn wrap_decl_bodies_for_hof(decls: ListDeclaration, all_static: ListDeclaration, seq: int64, acc_wrappers: ListDeclaration) -> (ListDeclaration, ListDeclaration) {
    case decls.is_nil of {
        true -> (parser_ast@empty_list_decl(), acc_wrappers);
        false -> case decls.head.tag == 0 of {
            true -> do
                d: Declaration <- decls.head;
                (body2: Expr, seq2: int64, w1: ListDeclaration) <- wrap_walk_expr(d.body, d.name, all_static, seq, parser_ast@nil_tuple_decompose_bindings());
                d2: Declaration <- parser_ast@declaration_with_body(d, body2);
                (rest_d: ListDeclaration, wacc: ListDeclaration) <- wrap_decl_bodies_for_hof(decls.tail, all_static, seq2, acc_wrappers);
                wmerged: ListDeclaration <- append_declaration_lists(w1, wacc);
                (parser_ast@cons_declaration(d2, rest_d), wmerged)
            end;
            false -> do
                (rest_d2: ListDeclaration, wacc2: ListDeclaration) <- wrap_decl_bodies_for_hof(decls.tail, all_static, seq, acc_wrappers);
                (parser_ast@cons_declaration(decls.head, rest_d2), wacc2)
            end
        }
    }
}

fn wrap_lifted_lambda_hof_calls(program: Program) -> Program {
    (decls2: ListDeclaration, wrappers: ListDeclaration) <- wrap_decl_bodies_for_hof(program.declarations, program.declarations, 0, parser_ast@empty_list_decl());
    merged: ListDeclaration <- append_declaration_lists(decls2, wrappers);
    Program { declarations: merged, location: program.location }
}

fn lift_lambda_expressions(program: Program) -> Program {
    (new_decls: ListDeclaration, _: int64, lifted: ListDeclaration) <- lift_decl_list(program.declarations, 0, parser_ast@empty_list_decl());
    merged: ListDeclaration <- append_declaration_lists(new_decls, lifted);
    Program { declarations: merged, location: program.location }
}

fn expr_has_single_tuple_error(expr: Expr) -> (bool, SourceLocation) {
    case expr.kind == 998 of {
        true -> (true, expr.location);
        false -> case expr.kind == 999 of {
            true -> (true, expr.location);
            false -> case expr.kind == -1 of {
                true -> (false, parser_ast@zero_location());
                false -> case expr.kind == 12 of {
                    true -> expr_has_single_tuple_error(expr.inner);
                    false -> do
                        (inner_found: bool, inner_loc: SourceLocation) <- expr_has_single_tuple_error(expr.inner);
                        case inner_found of {
                            true -> (true, inner_loc);
                            false -> expr_has_single_tuple_error(expr.right_expr)
                        }
                    end
                }
            }
        }
    }
}

fn decl_has_single_tuple_error(decl: Declaration) -> (bool, SourceLocation) {
    expr_has_single_tuple_error(decl.body)
}

fn decls_has_single_tuple_error(decls: ListDeclaration) -> (bool, SourceLocation) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> do
            (head_found: bool, head_loc: SourceLocation) <- decl_has_single_tuple_error(decls.head);
            case head_found of {
                true -> (true, head_loc);
                false -> decls_has_single_tuple_error(decls.tail)
            }
        end
    }
}

fn expr_has_missing_statement_terminator(expr: Expr) -> (bool, SourceLocation) {
    case expr.kind == 996 of {
        true -> (true, expr.location);
        false -> case expr.kind == -1 of {
            true -> (false, parser_ast@zero_location());
            false -> case expr.kind == 12 of {
                true -> expr_has_missing_statement_terminator(expr.inner);
                false -> do
                    (inner_found: bool, inner_loc: SourceLocation) <- expr_has_missing_statement_terminator(expr.inner);
                    case inner_found of {
                        true -> (true, inner_loc);
                        false -> expr_has_missing_statement_terminator(expr.right_expr)
                    }
                end
            }
        }
    }
}

fn expr_has_uncategorized_syntax_defect(expr: Expr) -> (bool, SourceLocation) {
    case expr.kind == 995 of {
        true -> (true, expr.location);
        false -> case expr.kind == -1 of {
            true -> (false, parser_ast@zero_location());
            false -> case expr.kind == 12 of {
                true -> expr_has_uncategorized_syntax_defect(expr.inner);
                false -> do
                    (inner_found: bool, inner_loc: SourceLocation) <- expr_has_uncategorized_syntax_defect(expr.inner);
                    case inner_found of {
                        true -> (true, inner_loc);
                        false -> expr_has_uncategorized_syntax_defect(expr.right_expr)
                    }
                end
            }
        }
    }
}

fn decl_has_missing_statement_terminator(decl: Declaration) -> (bool, SourceLocation) {
    expr_has_missing_statement_terminator(decl.body)
}

fn decl_has_uncategorized_syntax_defect(decl: Declaration) -> (bool, SourceLocation) {
    expr_has_uncategorized_syntax_defect(decl.body)
}

fn decls_has_missing_statement_terminator(decls: ListDeclaration) -> (bool, SourceLocation) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> do
            (head_found: bool, head_loc: SourceLocation) <- decl_has_missing_statement_terminator(decls.head);
            case head_found of {
                true -> (true, head_loc);
                false -> decls_has_missing_statement_terminator(decls.tail)
            }
        end
    }
}

fn decls_has_uncategorized_syntax_defect(decls: ListDeclaration) -> (bool, SourceLocation) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> do
            (head_found: bool, head_loc: SourceLocation) <- decl_has_uncategorized_syntax_defect(decls.head);
            case head_found of {
                true -> (true, head_loc);
                false -> decls_has_uncategorized_syntax_defect(decls.tail)
            }
        end
    }
}

fn expr_has_illegal_trailing_semicolon(expr: Expr) -> (bool, SourceLocation) {
    case expr.kind == 997 of {
        true -> (true, expr.location);
        false -> case expr.kind == -1 of {
            true -> (false, parser_ast@zero_location());
            false -> case expr.kind == 12 of {
                true -> expr_has_illegal_trailing_semicolon(expr.inner);
                false -> do
                    (inner_found: bool, inner_loc: SourceLocation) <- expr_has_illegal_trailing_semicolon(expr.inner);
                    case inner_found of {
                        true -> (true, inner_loc);
                        false -> expr_has_illegal_trailing_semicolon(expr.right_expr)
                    }
                end
            }
        }
    }
}

fn decl_has_illegal_trailing_semicolon(decl: Declaration) -> (bool, SourceLocation) {
    expr_has_illegal_trailing_semicolon(decl.body)
}

fn decls_has_illegal_trailing_semicolon(decls: ListDeclaration) -> (bool, SourceLocation) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> do
            (head_found: bool, head_loc: SourceLocation) <- decl_has_illegal_trailing_semicolon(decls.head);
            case head_found of {
                true -> (true, head_loc);
                false -> decls_has_illegal_trailing_semicolon(decls.tail)
            }
        end
    }
}

fn param_count(params: ListParam) -> int64 {
    case params.is_nil of {
        true -> 0;
        false -> 1 + param_count(params.tail)
    }
}

fn decl_has_too_many_params(decl: Declaration) -> (bool, SourceLocation, string) {
    case decl.tag == 0 of {
        true -> case param_count(decl.parameters) > 8 of {
            true -> (true, decl.location, decl.name);
            false -> (false, parser_ast@zero_location(), "")
        };
        false -> (false, parser_ast@zero_location(), "")
    }
}

fn decls_has_too_many_params(decls: ListDeclaration) -> (bool, SourceLocation, string) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> do
            (head_found: bool, head_loc: SourceLocation, head_name: string) <- decl_has_too_many_params(decls.head);
            case head_found of {
                true -> (true, head_loc, head_name);
                false -> decls_has_too_many_params(decls.tail)
            }
        end
    }
}

fn validate_max_params(program: Program) -> ParseResult {
    (found: bool, err_loc: SourceLocation, fn_name: string) <- decls_has_too_many_params(program.declarations);
    case found of {
        true -> parser_core@parse_err("E3010", err_loc, concat(concat("function '", fn_name), "' has more than 8 parameters; AArch64 calling convention supports at most 8 register arguments"), "sect4.1");
        false -> parser_core@parse_ok(program)
    }
}

fn validate_no_single_element_tuples(program: Program) -> ParseResult {
    (found: bool, err_loc: SourceLocation) <- decls_has_single_tuple_error(program.declarations);
    case found of {
        true -> parser_core@parse_err("E2006", err_loc, "single-element tuples are not allowed; use at least two elements", "sect4");
        false -> parser_core@parse_ok(program)
    }
}

fn validate_required_statement_terminators(program: Program) -> ParseResult {
    (found: bool, err_loc: SourceLocation) <- decls_has_missing_statement_terminator(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1040", err_loc, "expected ';' after this statement before the next statement", "sect3");
        false -> parser_core@parse_ok(program)
    }
}

fn validate_uncategorized_syntax_defect(program: Program) -> ParseResult {
    (found: bool, err_loc: SourceLocation) <- decls_has_uncategorized_syntax_defect(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1000", err_loc, uncategorized_syntax_defect_message(), "sect3");
        false -> parser_core@parse_ok(program)
    }
}

fn validate_no_illegal_trailing_semicolon(program: Program) -> ParseResult {
    (found: bool, err_loc: SourceLocation) <- decls_has_illegal_trailing_semicolon(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1041", err_loc, "the last expression in this block must not be followed by ';'", "sect3");
        false -> parser_core@parse_ok(program)
    }
}

// --- E1055: local bindings must be used within their lexical scope ---

fn is_unused_scope_discard_name(nm: string) -> bool {
    case len(nm) == 0 of {
        true -> false;
        false -> substring(nm, 0, 1) == "_"
    }
}

fn tuple_binding_names_contains(bindings: ListTupleDecomposeBinding, nm: string) -> bool {
    case bindings.is_nil of {
        true -> false;
        false -> case bindings.head.name == nm of {
            true -> true;
            false -> tuple_binding_names_contains(bindings.tail, nm)
        }
    }
}

fn expr_contains_identifier_named(expr: Expr, nm: string) -> bool {
    case expr.kind == -1 of {
        true -> false;
        false -> case expr.kind == 1 of {
            true -> expr.name == nm;
            false -> case expr.kind == 4 of {
                true -> expr.name == nm or expr_contains_identifier_named(expr.inner, nm) or expr_contains_identifier_named(expr.right_expr, nm);
                false -> case expr.kind == 6 of {
                true -> case expr.name == nm of {
                    // Typed call/site args (`f(x: T)`) reuse kind 6 with dummy inner; the name is the use.
                    true -> case expr.inner.kind == -1 of {
                        true -> true;
                        false -> expr_contains_identifier_named(expr.inner, nm)
                    };
                    false -> expr_contains_identifier_named(expr.inner, nm) or expr_contains_identifier_named(expr.right_expr, nm)
                };
                false -> case expr.kind == 10 of {
                    true -> case tuple_binding_names_contains(expr.pattern_bindings, nm) of {
                        true -> expr_contains_identifier_named(expr.inner, nm);
                        false -> expr_contains_identifier_named(expr.inner, nm) or expr_contains_identifier_named(expr.right_expr, nm)
                    };
                    false -> case expr.kind == 991 of {
                        true -> case tuple_binding_names_contains(expr.pattern_bindings, nm) of {
                            true -> false;
                            false -> expr_contains_identifier_named(expr.inner, nm)
                        };
                        false -> case expr.kind == 22 of {
                            true -> expr_contains_identifier_named(expr.inner, nm);
                            false -> expr_contains_identifier_named(expr.inner, nm) or expr_contains_identifier_named(expr.right_expr, nm)
                        }
                    }
                }
            }
            }
        }
    }
}

fn tuple_bindings_find_unused(bindings: ListTupleDecomposeBinding, body: Expr, extra: Expr) -> (bool, string) {
    case bindings.is_nil of {
        true -> (false, "");
        false -> do
            nm: string <- bindings.head.name;
            case is_unused_scope_discard_name(nm) of {
                true -> tuple_bindings_find_unused(bindings.tail, body, extra);
                false -> case expr_contains_identifier_named(body, nm) or expr_contains_identifier_named(extra, nm) of {
                    true -> tuple_bindings_find_unused(bindings.tail, body, extra);
                    false -> (true, nm)
                }
            }
        end
    }
}

fn expr_contains_unused_binding_exempt_expr(expr: Expr) -> bool {
    case expr.kind == -1 of {
        true -> false;
        false -> case expr.kind == 4 or expr.kind == 12 or expr.kind == 991 of {
            true -> true;
            false -> expr_contains_unused_binding_exempt_expr(expr.inner) or expr_contains_unused_binding_exempt_expr(expr.right_expr)
        }
    }
}

fn expr_has_unused_scope_binding(expr: Expr, extra_scope_result: Expr) -> (bool, SourceLocation, string) {
    case expr.kind == -1 of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case expr.kind == 6 of {
            true -> case expr.inner.kind == -1 of {
                // Typed call/site arg (`f(x: T)`): kind 6 with dummy inner — not a scope binding.
                true -> (false, parser_ast@zero_location(), "");
                false -> do
                    (rhs_found: bool, rhs_loc: SourceLocation, rhs_name: string) <- expr_has_unused_scope_binding(expr.inner, parser_ast@dummy_expr());
                    case rhs_found of {
                        true -> (true, rhs_loc, rhs_name);
                        false -> case is_unused_scope_discard_name(expr.name) of {
                            true -> expr_has_unused_scope_binding(expr.right_expr, extra_scope_result);
                            false -> case expr_contains_identifier_named(expr.right_expr, expr.name) or expr_contains_identifier_named(extra_scope_result, expr.name) of {
                                true -> expr_has_unused_scope_binding(expr.right_expr, extra_scope_result);
                                false -> case expr_contains_unused_binding_exempt_expr(expr.inner) of {
                                    true -> expr_has_unused_scope_binding(expr.right_expr, extra_scope_result);
                                    false -> (true, expr.location, expr.name)
                                }
                            }
                        }
                    }
                end
            };
            false -> case expr.kind == 10 of {
                true -> do
                    (rhs_td_found: bool, rhs_td_loc: SourceLocation, rhs_td_name: string) <- expr_has_unused_scope_binding(expr.inner, parser_ast@dummy_expr());
                    case rhs_td_found of {
                        true -> (true, rhs_td_loc, rhs_td_name);
                        false -> do
                            (unused_td: bool, unused_td_name: string) <- tuple_bindings_find_unused(expr.pattern_bindings, expr.right_expr, extra_scope_result);
                            case unused_td of {
                                true -> case expr_contains_unused_binding_exempt_expr(expr.inner) of {
                                    true -> expr_has_unused_scope_binding(expr.right_expr, extra_scope_result);
                                    false -> (true, expr.location, unused_td_name)
                                };
                                false -> expr_has_unused_scope_binding(expr.right_expr, extra_scope_result)
                            }
                        end
                    }
                end;
                false -> case expr.kind == 11 of {
                    true -> do
                        (body_found: bool, body_loc: SourceLocation, body_name: string) <- expr_has_unused_scope_binding(expr.inner, expr.right_expr);
                        case body_found of {
                            true -> (true, body_loc, body_name);
                            false -> expr_has_unused_scope_binding(expr.right_expr, parser_ast@dummy_expr())
                        }
                    end;
                    false -> do
                        (inner_found: bool, inner_loc: SourceLocation, inner_name: string) <- expr_has_unused_scope_binding(expr.inner, parser_ast@dummy_expr());
                        case inner_found of {
                            true -> (true, inner_loc, inner_name);
                            false -> expr_has_unused_scope_binding(expr.right_expr, parser_ast@dummy_expr())
                        }
                    end
                }
            }
        }
    }
}

fn decl_has_unused_scope_binding(decl: Declaration) -> (bool, SourceLocation, string) {
    case decl.tag == 0 of {
        true -> expr_has_unused_scope_binding(decl.body, parser_ast@dummy_expr());
        false -> (false, parser_ast@zero_location(), "")
    }
}

fn decls_has_unused_scope_binding(decls: ListDeclaration) -> (bool, SourceLocation, string) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> do
            (head_found: bool, head_loc: SourceLocation, head_name: string) <- decl_has_unused_scope_binding(decls.head);
            case head_found of {
                true -> (true, head_loc, head_name);
                false -> decls_has_unused_scope_binding(decls.tail)
            }
        end
    }
}

fn validate_no_unused_scope_bindings(program: Program) -> ParseResult {
    (found: bool, err_loc: SourceLocation, bind_name: string) <- decls_has_unused_scope_binding(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1055", err_loc, concat(concat("unused variable '", bind_name), "' in this scope; use it, pass it to a function, return it, or bind it as '_'"), "sect3");
        false -> parser_core@parse_ok(program)
    }
}

// --- E2012: tuple decomposition binding count exceeds register file capacity ---

fn count_decompose_bindings(bindings: ListTupleDecomposeBinding) -> int64 {
    case bindings.is_nil of {
        true -> 0;
        false -> 1 + count_decompose_bindings(bindings.tail)
    }
}

fn expr_has_too_many_decompose_bindings(expr: Expr) -> (bool, SourceLocation, int64) {
    case expr.kind == 10 of {
        true -> do
            n: int64 <- count_decompose_bindings(expr.pattern_bindings);
            case n > 14 of {
                true -> (true, expr.location, n);
                false -> do
                    (r_found: bool, r_loc: SourceLocation, r_n: int64) <- expr_has_too_many_decompose_bindings(expr.right_expr);
                    case r_found of {
                        true -> (true, r_loc, r_n);
                        false -> (false, parser_ast@zero_location(), 0)
                    }
                end
            }
        end;
        false -> case expr.kind == -1 of {
            true -> (false, parser_ast@zero_location(), 0);
            false -> do
                (inner_found: bool, inner_loc: SourceLocation, inner_n: int64) <- expr_has_too_many_decompose_bindings(expr.inner);
                case inner_found of {
                    true -> (true, inner_loc, inner_n);
                    false -> expr_has_too_many_decompose_bindings(expr.right_expr)
                }
            end
        }
    }
}

fn decl_has_too_many_decompose_bindings(decl: Declaration) -> (bool, SourceLocation, int64) {
    case decl.tag == 0 of {
        true -> expr_has_too_many_decompose_bindings(decl.body);
        false -> (false, parser_ast@zero_location(), 0)
    }
}

fn decls_has_too_many_decompose_bindings(decls: ListDeclaration) -> (bool, SourceLocation, int64) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location(), 0);
        false -> do
            (head_found: bool, head_loc: SourceLocation, head_n: int64) <- decl_has_too_many_decompose_bindings(decls.head);
            case head_found of {
                true -> (true, head_loc, head_n);
                false -> decls_has_too_many_decompose_bindings(decls.tail)
            }
        end
    }
}

fn validate_max_tuple_decompose_bindings(program: Program) -> ParseResult {
    (found: bool, err_loc: SourceLocation, n: int64) <- decls_has_too_many_decompose_bindings(program.declarations);
    case found of {
        true -> parser_core@parse_err("E2012", err_loc, concat("tuple decomposition pattern has ", concat(atom_table@int64_to_decimal_string(n), " elements; the AArch64 register file supports at most 14 simultaneous bindings (X0-X15 excluding X8, X12)")), "sect4.2");
        false -> parser_core@parse_ok(program)
    }
}
