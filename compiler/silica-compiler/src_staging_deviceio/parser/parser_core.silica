// Parser core - ParseResult type and shared utilities

use lexer_core;
use parser_ast;

export ParseResult/0;
export parse_ok/1;
export parse_err/5;

struct ParseResult {
    is_ok: bool,
    program: Program,
    error_code: string,
    error_location: SourceLocation,
    error_message: string,
    spec_section: string
}

fn parse_ok(program: Program) -> ParseResult {
    ParseResult { is_ok: true, program: program, error_code: "", error_location: parser_ast@zero_location(), error_message: "", spec_section: "" }
}

fn parse_err(error_code: string, error_location: SourceLocation, error_message: string, spec_section: string) -> ParseResult {
    ParseResult { is_ok: false, program: Program { declarations: parser_ast@empty_list_decl(), location: parser_ast@zero_location() }, error_code: error_code, error_location: error_location, error_message: error_message, spec_section: spec_section }
}
