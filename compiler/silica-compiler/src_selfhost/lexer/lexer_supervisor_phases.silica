// { source: string, position: int64, line: int64, column: int64, file: string }-level classification for design_documents/supervisors_implementation_development_plan.md.
// Phase B (supervision ingress + scheduler ordering): silica-spec §15.4.9, §16.2.2 — runtime drains
// the supervision ingress before the standard mailbox each turn. User code still uses the same
// message parameter, case/of, cast/call/send, spawn_linked, and link/monitor/demonitor surface
// spellings; there is no separate recv-from-ingress keyword.
// Phase C (exit notification, §15.4.10–§15.4.11): failure payload field typing uses built-in
// `failure_reason` (failure_reason_keyword) and `actor_ref` for child_ref; case/of + atom_literal
// for discriminated :normal / :language_error / :memory_fault / … variants.
// Phase D (Supervisor trait, §15.4.13): export trait / required { fn init … } / spawn_linked+link+self
// enforcement — surface keyword kinds are grouped for tooling.
// Phase E (declarative children + automatic restart, §15.4.12.1, §15.4.12.3, §15.4.13.1–2): runtime applies
// supervisor_flags and child_spec.restart to the static table; escalation uses allowed_restart_count and
// restarts_time_frame. { source: string, position: int64, line: int64, column: int64, file: string }-side surface is atom literals (restart + strategy), int literals, inline records,
// List[..., normal] child lists, function types for start, and spawn_linked for dynamic children (§15.4.13.3).
// Phase F (FailureReporter + unwind, §15.4.11.4, §15.4.13.4–13.6): trait FailureReporter { region_dump_limit; handle_report };
// `bytes` type for region_dumps; `String` in spec tokenizes as string_keyword; method names are ordinary identifiers.
// Phase G (link, monitor, cascading shutdown, §15.4.8.4–§15.4.8.7): `link` / `monitor` / `demonitor` + spawn_linked share behavior-only surface with Phase B;
// DOWN to standard mailbox only (not ingress) — spec message `(:down, monitor_ref, actor_ref, failure_reason)` uses atom :down, types monitor_ref, actor_ref, failure_reason (§15.4.8.6).

use lexer_token_kind;

export token_kind_supervisor_phase_b_ingress_ordering/2;
export token_kind_supervisor_phase_c_failure_payload/2;
export token_kind_supervisor_phase_d_supervisor_trait_surface/2;
export token_kind_supervisor_phase_e_automatic_restart_surface/2;
export token_kind_supervisor_phase_f_failure_reporter_surface/2;
export token_kind_supervisor_phase_g_link_monitor_down_surface/2;


fn token_kind_supervisor_phase_b_ingress_ordering(kinds: TokenKinds, k: int64) -> bool {
    k == kinds.spawn_keyword or k == kinds.spawn_dangerous_keyword or k == kinds.spawn_linked_keyword or k == kinds.link_keyword or k == kinds.monitor_keyword or k == kinds.demonitor_keyword or k == kinds.cast_keyword or k == kinds.send_keyword or k == kinds.self_keyword or k == kinds.actor_keyword or k == kinds.actor_ref_keyword or k == kinds.dangerous_actor_ref_keyword or k == kinds.case_keyword or k == kinds.of_keyword or k == kinds.recv_keyword
}

// §15.4.11 failure notification typing + pattern variants (tooling / trials classification).
fn token_kind_supervisor_phase_c_failure_payload(kinds: TokenKinds, k: int64) -> bool {
    k == kinds.failure_reason_keyword or k == kinds.atom_literal or k == kinds.case_keyword or k == kinds.of_keyword or k == kinds.if_keyword or k == kinds.actor_ref_keyword
}

// §15.4.13 Supervisor trait file surface: init, static children, behavior-only intrinsics.
fn token_kind_supervisor_phase_d_supervisor_trait_surface(kinds: TokenKinds, k: int64) -> bool {
    k == kinds.trait_keyword or k == kinds.export_keyword or k == kinds.required_keyword or k == kinds.provided_keyword or k == kinds.fn_keyword or k == kinds.module_keyword or k == kinds.use_keyword or k == kinds.impl_keyword or k == kinds.for_keyword or k == kinds.spawn_linked_keyword or k == kinds.link_keyword or k == kinds.self_keyword
}

// §15.4.12–15.4.13.2 declarative restart + §15.4.13.3 dynamic children (token kinds for trials / tooling).
fn token_kind_supervisor_phase_e_automatic_restart_surface(kinds: TokenKinds, k: int64) -> bool {
    k == kinds.atom_literal
        or k == kinds.integer_literal
        or k == kinds.int64_keyword
        or k == kinds.left_brace
        or k == kinds.right_brace
        or k == kinds.left_paren
        or k == kinds.right_paren
        or k == kinds.comma
        or k == kinds.colon
        or k == kinds.list_keyword
        or k == kinds.normal_keyword
        or k == kinds.fn_keyword
        or k == kinds.right_arrow
        or k == kinds.spawn_linked_keyword
}

// §15.4.13.4 FailureReporter trait: region_dump_limit / handle_report signatures; string+bytes+atom tuple list types.
fn token_kind_supervisor_phase_f_failure_reporter_surface(kinds: TokenKinds, k: int64) -> bool {
    k == kinds.trait_keyword or k == kinds.export_keyword or k == kinds.required_keyword or k == kinds.provided_keyword or k == kinds.fn_keyword or k == kinds.module_keyword or k == kinds.use_keyword or k == kinds.impl_keyword or k == kinds.for_keyword or k == kinds.string_keyword or k == kinds.bytes_keyword or k == kinds.atom_keyword
}

// §15.4.8.4–§15.4.8.7 + §15.4.8.6 DOWN: link/monitor/demonitor + spawn_linked surface; standard-mailbox recv/cast/send;
// DOWN tuple `(:down, monitor_ref, actor_ref, failure_reason)` — left/right paren + comma; case/of for matching.
fn token_kind_supervisor_phase_g_link_monitor_down_surface(kinds: TokenKinds, k: int64) -> bool {
    k == kinds.link_keyword
        or k == kinds.monitor_keyword
        or k == kinds.demonitor_keyword
        or k == kinds.spawn_linked_keyword
        or k == kinds.spawn_keyword
        or k == kinds.spawn_dangerous_keyword
        or k == kinds.actor_ref_keyword
        or k == kinds.dangerous_actor_ref_keyword
        or k == kinds.monitor_ref_keyword
        or k == kinds.failure_reason_keyword
        or k == kinds.atom_literal
        or k == kinds.case_keyword
        or k == kinds.of_keyword
        or k == kinds.left_paren
        or k == kinds.right_paren
        or k == kinds.comma
        or k == kinds.self_keyword
        or k == kinds.recv_keyword
        or k == kinds.cast_keyword
        or k == kinds.send_keyword
}
