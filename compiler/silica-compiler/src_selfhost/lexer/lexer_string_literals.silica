// String and character literal parsing for Silica lexer
// Supports string literals with Unicode and escape sequences: \\, \', \", \n, \t, \r, \e, \xNN
// Per language spec §2.2: string_literal ::= "\"" {character | escape_sequence} "\""
// Character literals use same escape sequences per character_literal grammar
// UTF-8: advance_utf8_char advances by full character length (1-4 bytes) for multi-byte sequences

// Import token kind
use lexer_token_kind;

// Import lexer core types
use lexer_core;
use lexer_integer_literals;

// Export entry points
export read_string_literal/1;
export read_char_literal/1;


{-
- Returns UTF-8 byte length (1-4) from lead byte. Used to advance past multi-byte characters.
- 1-byte: 0x00-0x7F; 2-byte: 0xC2-0xDF; 3-byte: 0xE0-0xEF; 4-byte: 0xF0-0xF7; else 1 (fallback).
- Last-date-modified: 2025-03-03
-}
fn utf8_lead_byte_length(lead: string) -> int64 {
    case lead of {
        "\xC2" -> 2; "\xC3" -> 2; "\xC4" -> 2; "\xC5" -> 2; "\xC6" -> 2; "\xC7" -> 2; "\xC8" -> 2; "\xC9" -> 2;
        "\xCA" -> 2; "\xCB" -> 2; "\xCC" -> 2; "\xCD" -> 2; "\xCE" -> 2; "\xCF" -> 2; "\xD0" -> 2; "\xD1" -> 2;
        "\xD2" -> 2; "\xD3" -> 2; "\xD4" -> 2; "\xD5" -> 2; "\xD6" -> 2; "\xD7" -> 2; "\xD8" -> 2; "\xD9" -> 2;
        "\xDA" -> 2; "\xDB" -> 2; "\xDC" -> 2; "\xDD" -> 2; "\xDE" -> 2; "\xDF" -> 2;
        "\xE0" -> 3; "\xE1" -> 3; "\xE2" -> 3; "\xE3" -> 3; "\xE4" -> 3; "\xE5" -> 3; "\xE6" -> 3; "\xE7" -> 3;
        "\xE8" -> 3; "\xE9" -> 3; "\xEA" -> 3; "\xEB" -> 3; "\xEC" -> 3; "\xED" -> 3; "\xEE" -> 3; "\xEF" -> 3;
        "\xF0" -> 4; "\xF1" -> 4; "\xF2" -> 4; "\xF3" -> 4; "\xF4" -> 4; "\xF5" -> 4; "\xF6" -> 4; "\xF7" -> 4;
        _: string -> 1
    }
}


{-
- Advances the lexer past one UTF-8 character (1-4 bytes). Uses utf8_lead_byte_length on peek_char.
- For n=1, USE advance() to handle newline in column/line. For n>1, USE advance_by (no newline in continuation bytes).
- Last-date-modified: 2025-03-03
-}
fn advance_utf8_char(lexer: { source: string, position: int64, line: int64, column: int64, file: string }) -> { source: string, position: int64, line: int64, column: int64, file: string } {
    lead: string <- lexer_core@peek_char(lexer);
    n: int64 <- utf8_lead_byte_length(lead);
    case n of {
        1 -> lexer_core@advance(lexer);
        _: int64 -> lexer_core@advance_by(lexer, n)
    }
}

fn is_simple_string_escape(next: string) -> bool {
    case next of {
        "n" -> true;
        "t" -> true;
        "r" -> true;
        "e" -> true;
        "\\" -> true;
        "\"" -> true;
        "'" -> true;
        _: string -> false
    }
}

// { source: string, position: int64, line: int64, column: int64, file: string } positioned at 'x' (char after '\\' in \\xNN). Validates the two hex digits after x.
fn is_valid_hex_escape_at(lexer: { source: string, position: int64, line: int64, column: int64, file: string }) -> bool {
    hi: string <- lexer_core@peek_next_char(lexer);
    lo: string <- substring(lexer.source, lexer.position + 2, lexer.position + 3);
    case lexer_integer_literals@is_hex_digit_char(hi) of {
        false -> false;
        true -> lexer_integer_literals@is_hex_digit_char(lo)
    }
}

// Advance past a validated escape sequence (lexer positioned at char after '\\').
fn advance_past_string_escape(lexer: { source: string, position: int64, line: int64, column: int64, file: string }) -> ({ source: string, position: int64, line: int64, column: int64, file: string }, bool) {
    next: string <- lexer_core@peek_char(lexer);
    case next of {
        "x" -> case is_valid_hex_escape_at(lexer) of {
            false -> (lexer, false);
            true -> (lexer_core@advance_by(lexer, 3), true)
        };
        _: string -> case is_simple_string_escape(next) of {
            false -> (lexer, false);
            true -> (lexer_core@advance(lexer), true)
        }
    }
}


{-
- Reads a string literal from the current lexer position. Expects opening "\"" already seen.
- Advances past the opening quote, then consumes characters and escape sequences until closing "\"".
- Escape sequences: \\ (backslash), \' (single quote), \" (double quote), \n (newline), \t (tab), \r (carriage return).
- String content may include Unicode characters (UTF-8). Lexeme is the raw source text including quotes.
- Example: lexer at "\"" of "\"hello\"" — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } string_literal "\"hello\"", lexer past closing quote).
- Example: lexer at "\"" of "\"hi\\nthere\"" — consumes \n as escape, returns token with lexeme "\"hi\\nthere\"".
- Time: O(k), Ω(1), Θ(k) where k is string length. Space: O(k), Ω(1), Θ(k).
- Last-date-modified: 2025-02-27
-}
fn read_string_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string }) {
    sequence
        start_location: { file: string, line: int64, column: int64, offset: int64 } <- lexer_core@current_location(lexer);
        start_pos: int64 <- lexer.position;
                after_open: { source: string, position: int64, line: int64, column: int64, file: string } <- lexer_core@advance(lexer);
        (final_lexer: { source: string, position: int64, line: int64, column: int64, file: string }, ok: bool) <- read_string_content(after_open, start_pos, start_location);
        result: ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string }) <- case ok of {
            true -> {
                lexeme: string <- lexer_core@extract_lexeme(final_lexer, start_pos);
                token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_string_literal(), lexeme, start_location);
                (token, final_lexer)
            };
            false -> {
                error_lexeme: string <- lexer_core@extract_lexeme(final_lexer, start_pos);
                error_token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_unknown_char(), error_lexeme, start_location);
                (error_token, final_lexer)
            }
        }
    produces
        pure result
    end
}


{-
- Recursively reads string content: normal chars, escape sequences, or closing quote.
- Returns (lexer, ok). ok is false on unterminated string or invalid escape.
-}
fn read_string_content(lexer: { source: string, position: int64, line: int64, column: int64, file: string }, start_pos: int64, start_location: { file: string, line: int64, column: int64, offset: int64 }) -> ({ source: string, position: int64, line: int64, column: int64, file: string }, bool) {
    sequence
        current: string <- lexer_core@peek_char(lexer);
        result: ({ source: string, position: int64, line: int64, column: int64, file: string }, bool) <- case current of {
            "" -> (lexer, false);
            "\"" -> {
                after_close: { source: string, position: int64, line: int64, column: int64, file: string } <- lexer_core@advance(lexer);
                (after_close, true)
            };
            "\\" -> {
                after_backslash: { source: string, position: int64, line: int64, column: int64, file: string } <- lexer_core@advance(lexer);
                (after_escape: { source: string, position: int64, line: int64, column: int64, file: string }, ok_escape: bool) <- advance_past_string_escape(after_backslash);
                case ok_escape of {
                    true -> read_string_content(after_escape, start_pos, start_location);
                    false -> (after_backslash, false)
                }
            };
            _: string -> {
                advanced: { source: string, position: int64, line: int64, column: int64, file: string } <- advance_utf8_char(lexer);
                read_string_content(advanced, start_pos, start_location)
            }
        }
    produces
        pure result
    end
}


{-
- Reads a character literal from the current lexer position. Expects opening "'" already seen.
- Advances past the opening quote, reads one character (or escape SEQUENCE), then expects closing "'".
- Escape sequences: \\, \', \", \n, \t, \r. Lexeme is the raw source text including quotes.
- Example: lexer at "'" of "'a'" — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } char_literal "'a'", lexer past closing quote).
- Example: lexer at "'" of "'\\n'" — consumes \n as escape, returns token with lexeme "'\\n'".
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1).
- Last-date-modified: 2025-02-27
-}
fn read_char_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string }) {
    sequence
        start_location: { file: string, line: int64, column: int64, offset: int64 } <- lexer_core@current_location(lexer);
            start_pos: int64 <- lexer.position;
            
            // Advance past opening quote
            after_open: { source: string, position: int64, line: int64, column: int64, file: string } <- lexer_core@advance(lexer);
            current: string <- lexer_core@peek_char(after_open);
        result: ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string }) <- case current of {
                "" -> {
                    error_token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_unknown_char(), "", start_location);
                    (error_token, after_open)
                };
                "'" -> {
                    // Empty char or closing quote too soon - error
                    error_lexeme: string <- lexer_core@extract_lexeme(after_open, start_pos);
                    error_token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_unknown_char(), error_lexeme, start_location);
                    (error_token, after_open)
                };
                "\\" -> {
                    // Escape sequence
                    after_backslash: { source: string, position: int64, line: int64, column: int64, file: string } <- lexer_core@advance(after_open);
                    (after_escape: { source: string, position: int64, line: int64, column: int64, file: string }, ok_escape: bool) <- advance_past_string_escape(after_backslash);
                    case ok_escape of {
                        true -> {
                            closing: string <- lexer_core@peek_char(after_escape);
                            case closing of {
                                "'" -> {
                                    after_close: { source: string, position: int64, line: int64, column: int64, file: string } <- lexer_core@advance(after_escape);
                                    lexeme: string <- lexer_core@extract_lexeme(after_close, start_pos);
                                    token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_char_literal(), lexeme, start_location);
                                    (token, after_close)
                                };
                                _: string -> {
                                    error_lexeme: string <- lexer_core@extract_lexeme(after_escape, start_pos);
                                    error_token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_unknown_char(), error_lexeme, start_location);
                                    (error_token, after_escape)
                                }
                            }
                        };
                        false -> {
                            error_lexeme: string <- lexer_core@extract_lexeme(after_backslash, start_pos);
                            error_token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_unknown_char(), error_lexeme, start_location);
                            (error_token, after_backslash)
                        }
                    }
                };
                _: string -> {
                    // Normal character (including multi-byte UTF-8) - advance past full character, expect closing quote
                    after_char: { source: string, position: int64, line: int64, column: int64, file: string } <- advance_utf8_char(after_open);
                    closing: string <- lexer_core@peek_char(after_char);
                    case closing of {
                        "'" -> {
                            after_close: { source: string, position: int64, line: int64, column: int64, file: string } <- lexer_core@advance(after_char);
                            lexeme: string <- lexer_core@extract_lexeme(after_close, start_pos);
                            token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_char_literal(), lexeme, start_location);
                            (token, after_close)
                        };
                        _: string -> {
                            error_lexeme: string <- lexer_core@extract_lexeme(after_char, start_pos);
                            error_token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_unknown_char(), error_lexeme, start_location);
                            (error_token, after_char)
                        }
                    }
                }
            }
    produces
        pure result
    end
}
