    MOV X26, X21
    MOV X27, X23
Lcmp_cloop:
    LDRB W28, [X26], #1
    LDRB W1, [X27], #1
    CMP W28, W1
    B.LO Lcmp_lt
    B.HI Lcmp_gt
    SUBS X25, X25, #1
