// Post-parse program validators.

use parser_ast;
use parser_core;
use atom_table;

export validate_max_params/1;
export validate_no_single_element_tuples/1;
export validate_required_statement_terminators/1;
export validate_uncategorized_syntax_defect/1;
export validate_no_illegal_trailing_semicolon/1;
export validate_no_unused_scope_bindings/1;
export validate_max_tuple_decompose_bindings/1;



fn uncategorized_syntax_defect_message() -> string {
    concat(
        "There is an uncategorized syntactic defect in the code you are working on. If you are an LLM or other AI agent:\n\n",
        concat(
            "1) Defect Location: the syntactic defect location provided on a line in the file prior to the line indicated in the error.\n",
            concat(
                "2) Find: Find the location of the actual syntactic defect's location and cause. You may use the Silica language specification document (silica-specification.md) as well as adding temporary debugging print statements to the silica-compiler source code. If the locations of these are not in your current chat data, ask the user for those locations.\n",
                concat(
                    "3) Suggest: Using the actual location and cause, suggest to your user changes that could be made to the compiler, Continuous Integration trials that could be added to the trials/error_enforcement_addition directory and an addition to or modification of the syntactic defect descriptions found in error_codes.md based on the groupings found in error_codes.jsonld.\n",
                    concat(
                        "4) Instructions to give to your user:\n",
                        concat(
                            "A) Do you want me to make the suggested changes to the silica-compiler source code and the trials directory?\n",
                            concat(
                                "B) Ensure all the Continuous Integration trials found in the trials directory still pass and the new ones added are correct and pass.\n",
                                "C) Ensure there is no enhancement request for the suggested addition at https://github.com/yenrab/silica/issues?q=is%3Aissue+is%3Aopen+label%3Aenhancement. If there is not, add one and submit a self-closing pull request."
                            )
                        )
                    )
                )
            )
        )
    )
}



// Seed dummy_expr is kind==-1 with inner/right pointing at itself. Flattened
// handles use root<0; a stored dummy may still have root>=0. Do not follow a
// child index that is absent or the current root (self-cycle).
fn expr_child_is_absent(parent_root: int64, child_idx: int64) -> int64 {
    case child_idx < 0 of {
        true -> 1;
        false -> case child_idx == parent_root of {
            true -> 1;
            false -> 0
        }
    }
}

// Only tag 0 (fn) has a statement body. use/export/trait/module/effect/impl
// store dummy_expr; walking that handle can cycle in expr_node_at_from_head.
// Int64 1/0 — bool returns from these helpers have been observed inverted and
// re-enter dummy bodies (parse hang on `use` / `export` files).
fn decl_skips_body_walk(tag: int64, body_root: int64) -> int64 {
    case body_root < 0 of {
        true -> 1;
        false -> case tag == 0 of {
            true -> 0;
            false -> 1
        }
    }
}

fn expr_has_single_tuple_error(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    case expr.root < 0 of {
        true -> (false, parser_ast@zero_location());
        false -> case parser_ast@expr_root_node(expr).kind == 998 of {
            true -> (true, parser_ast@expr_root_node(expr).location);
            false -> case parser_ast@expr_root_node(expr).kind == 999 of {
                true -> (true, parser_ast@expr_root_node(expr).location);
                false -> case parser_ast@expr_root_node(expr).kind == -1 of {
                    true -> (false, parser_ast@zero_location());
                    false -> case parser_ast@expr_root_node(expr).kind == 12 of {
                        true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).inner) == 1 of {
                            true -> (false, parser_ast@zero_location());
                            false -> expr_has_single_tuple_error(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner))
                        };
                        false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).inner) == 1 of {
                            true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).right_expr) == 1 of {
                                true -> (false, parser_ast@zero_location());
                                false -> expr_has_single_tuple_error(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
                            };
                            false -> {
                                (inner_found: bool, inner_loc: { file: string, line: int64, column: int64, offset: int64 }) <- expr_has_single_tuple_error(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner));
                                case inner_found of {
                                    true -> (true, inner_loc);
                                    false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).right_expr) == 1 of {
                                        true -> (false, parser_ast@zero_location());
                                        false -> expr_has_single_tuple_error(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



fn decl_has_single_tuple_error(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    case decl_skips_body_walk(decl.tag, decl.body.root) == 1 of {
        true -> (false, parser_ast@zero_location());
        false -> expr_has_single_tuple_error(decl.body)
    }
}



fn decls_has_single_tuple_error(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> {
            (head_found: bool, head_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decl_has_single_tuple_error(decls.head);
            case head_found of {
                true -> (true, head_loc);
                false -> decls_has_single_tuple_error(decls.tail)
            }
        }
    }
}



fn expr_has_missing_statement_terminator(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    case expr.root < 0 of {
        true -> (false, parser_ast@zero_location());
        false -> case parser_ast@expr_root_node(expr).kind == 996 of {
            true -> (true, parser_ast@expr_root_node(expr).location);
            false -> case parser_ast@expr_root_node(expr).kind == -1 of {
                true -> (false, parser_ast@zero_location());
                false -> case parser_ast@expr_root_node(expr).kind == 12 of {
                    true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).inner) == 1 of {
                        true -> (false, parser_ast@zero_location());
                        false -> expr_has_missing_statement_terminator(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner))
                    };
                    false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).inner) == 1 of {
                        true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).right_expr) == 1 of {
                            true -> (false, parser_ast@zero_location());
                            false -> expr_has_missing_statement_terminator(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
                        };
                        false -> {
                            (inner_found: bool, inner_loc: { file: string, line: int64, column: int64, offset: int64 }) <- expr_has_missing_statement_terminator(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner));
                            case inner_found of {
                                true -> (true, inner_loc);
                                false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).right_expr) == 1 of {
                                    true -> (false, parser_ast@zero_location());
                                    false -> expr_has_missing_statement_terminator(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



fn expr_has_uncategorized_syntax_defect(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    case expr.root < 0 of {
        true -> (false, parser_ast@zero_location());
        false -> case parser_ast@expr_root_node(expr).kind == 995 of {
            true -> (true, parser_ast@expr_root_node(expr).location);
            false -> case parser_ast@expr_root_node(expr).kind == -1 of {
                true -> (false, parser_ast@zero_location());
                false -> case parser_ast@expr_root_node(expr).kind == 12 of {
                    true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).inner) == 1 of {
                        true -> (false, parser_ast@zero_location());
                        false -> expr_has_uncategorized_syntax_defect(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner))
                    };
                    false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).inner) == 1 of {
                        true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).right_expr) == 1 of {
                            true -> (false, parser_ast@zero_location());
                            false -> expr_has_uncategorized_syntax_defect(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
                        };
                        false -> {
                            (inner_found: bool, inner_loc: { file: string, line: int64, column: int64, offset: int64 }) <- expr_has_uncategorized_syntax_defect(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner));
                            case inner_found of {
                                true -> (true, inner_loc);
                                false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).right_expr) == 1 of {
                                    true -> (false, parser_ast@zero_location());
                                    false -> expr_has_uncategorized_syntax_defect(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



fn decl_has_missing_statement_terminator(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    case decl_skips_body_walk(decl.tag, decl.body.root) == 1 of {
        true -> (false, parser_ast@zero_location());
        false -> expr_has_missing_statement_terminator(decl.body)
    }
}



