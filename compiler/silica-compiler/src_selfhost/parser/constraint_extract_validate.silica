    }
}



fn expr_has_illegal_trailing_semicolon(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    case expr.root < 0 of {
        true -> (false, parser_ast@zero_location());
        false -> case parser_ast@expr_root_node(expr).kind == 997 of {
            true -> (true, parser_ast@expr_root_node(expr).location);
            false -> case parser_ast@expr_root_node(expr).kind == -1 of {
                true -> (false, parser_ast@zero_location());
                false -> case parser_ast@expr_root_node(expr).kind == 12 of {
                    true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).inner) == 1 of {
                        true -> (false, parser_ast@zero_location());
                        false -> expr_has_illegal_trailing_semicolon(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner))
                    };
                    false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).inner) == 1 of {
                        true -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).right_expr) == 1 of {
                            true -> (false, parser_ast@zero_location());
                            false -> expr_has_illegal_trailing_semicolon(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
                        };
                        false -> {
                            (inner_found: bool, inner_loc: { file: string, line: int64, column: int64, offset: int64 }) <- expr_has_illegal_trailing_semicolon(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner));
                            case inner_found of {
                                true -> (true, inner_loc);
                                false -> case expr_child_is_absent(expr.root, parser_ast@expr_root_node(expr).right_expr) == 1 of {
                                    true -> (false, parser_ast@zero_location());
                                    false -> expr_has_illegal_trailing_semicolon(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



fn decl_has_illegal_trailing_semicolon(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    case decl_skips_body_walk(decl.tag, decl.body.root) == 1 of {
        true -> (false, parser_ast@zero_location());
        false -> expr_has_illegal_trailing_semicolon(decl.body)
    }
}



fn decls_has_illegal_trailing_semicolon(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> {
            (head_found: bool, head_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decl_has_illegal_trailing_semicolon(decls.head);
            case head_found of {
                true -> (true, head_loc);
                false -> decls_has_illegal_trailing_semicolon(decls.tail)
            }
        }
    }
}



fn param_count(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case params.is_nil of {
        true -> 0;
        false -> 1 + param_count(params.tail)
    }
}



fn decl_has_too_many_params(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case decl.tag == 0 of {
        true -> case param_count(decl.parameters) > 8 of {
            true -> (true, decl.location, decl.name);
            false -> (false, parser_ast@zero_location(), "")
        };
        false -> (false, parser_ast@zero_location(), "")
    }
}



fn decls_has_too_many_params(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> {
            (head_found: bool, head_loc: { file: string, line: int64, column: int64, offset: int64 }, head_name: string) <- decl_has_too_many_params(decls.head);
            case head_found of {
                true -> (true, head_loc, head_name);
                false -> decls_has_too_many_params(decls.tail)
            }
        }
    }
}



fn validate_max_params(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: bool, err_loc: { file: string, line: int64, column: int64, offset: int64 }, fn_name: string) <- decls_has_too_many_params(program.declarations);
    case found of {
        true -> parser_core@parse_err("E3010", err_loc, concat(concat("function '", fn_name), "' has more than 8 parameters; AArch64 calling convention supports at most 8 register arguments"), "sect4.1");
        false -> parser_core@parse_ok(program)
    }
}



fn validate_no_single_element_tuples(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: bool, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decls_has_single_tuple_error(program.declarations);
    case found of {
        true -> parser_core@parse_err("E2006", err_loc, "single-element tuples are not allowed; use at least two elements", "sect4");
        false -> parser_core@parse_ok(program)
    }
}



fn validate_required_statement_terminators(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: bool, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decls_has_missing_statement_terminator(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1040", err_loc, "expected ';' after this statement before the next statement", "sect3");
        false -> parser_core@parse_ok(program)
    }
}



fn validate_uncategorized_syntax_defect(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: bool, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decls_has_uncategorized_syntax_defect(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1000", err_loc, uncategorized_syntax_defect_message(), "sect3");
        false -> parser_core@parse_ok(program)
    }
}



fn validate_no_illegal_trailing_semicolon(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: bool, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- decls_has_illegal_trailing_semicolon(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1041", err_loc, "the last expression in this block must not be followed by ';'", "sect3");
        false -> parser_core@parse_ok(program)
    }
}



// --- E1055: local bindings must be used within their lexical scope ---

fn is_unused_scope_discard_name(nm: string) -> bool {
    case len(nm) == 0 of {
        true -> false;
        false -> substring(nm, 0, 1) == "_"
    }
}



fn tuple_binding_names_contains(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], nm: string) -> bool {
    case bindings.is_nil of {
        true -> false;
        false -> case bindings.head.name == nm of {
            true -> true;
            false -> tuple_binding_names_contains(bindings.tail, nm)
        }
    }
}



fn expr_contains_identifier_named(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, nm: string) -> bool {
    case expr.root < 0 of {
        true -> false;
        false -> case parser_ast@expr_root_node(expr).kind == 1 of {
            true -> parser_ast@expr_root_node(expr).name == nm;
            false -> case parser_ast@expr_root_node(expr).kind == 4 of {
                true -> parser_ast@expr_root_node(expr).name == nm or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), nm) or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), nm);
                false -> case parser_ast@expr_root_node(expr).kind == 6 of {
                true -> case parser_ast@expr_root_node(expr).name == nm of {
                    // Typed call/site args (`f(x: T)`) reuse kind 6 with dummy inner; the name is the use.
                    true -> case parser_ast@expr_root_node(expr).inner < 0 of {
                        true -> true;
                        false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), nm)
                    };
                    false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), nm) or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), nm)
                };
                false -> case parser_ast@expr_root_node(expr).kind == 10 of {
                    true -> case tuple_binding_names_contains(parser_ast@expr_root_node(expr).pattern_bindings, nm) of {
                        true -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), nm);
                        false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), nm) or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), nm)
                    };
                    false -> case parser_ast@expr_root_node(expr).kind == 991 of {
                        true -> case tuple_binding_names_contains(parser_ast@expr_root_node(expr).pattern_bindings, nm) of {
                            true -> false;
                            false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), nm)
                        };
                        false -> case parser_ast@expr_root_node(expr).kind == 22 of {
                            true -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), nm);
                            false -> expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), nm) or expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), nm)
                        }
                    }
                }
            }
            }
        }
    }
}



fn tuple_bindings_find_unused(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, extra: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (bool, string) {
    case bindings.is_nil of {
        true -> (false, "");
        false -> {
            nm: string <- bindings.head.name;
            case is_unused_scope_discard_name(nm) of {
                true -> tuple_bindings_find_unused(bindings.tail, body, extra);
                false -> case expr_contains_identifier_named(body, nm) or expr_contains_identifier_named(extra, nm) of {
                    true -> tuple_bindings_find_unused(bindings.tail, body, extra);
                    false -> (true, nm)
                }
            }
        }
    }
}



fn expr_contains_unused_binding_exempt_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> bool {
    case expr.root < 0 of {
        true -> false;
        false -> case parser_ast@expr_root_node(expr).kind == 4 or parser_ast@expr_root_node(expr).kind == 12 or parser_ast@expr_root_node(expr).kind == 991 of {
            true -> true;
            false -> expr_contains_unused_binding_exempt_expr(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner)) or expr_contains_unused_binding_exempt_expr(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
        }
    }
}



fn expr_has_unused_scope_binding(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, extra_scope_result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case expr.root < 0 of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case parser_ast@expr_root_node(expr).kind == 6 of {
            true -> case parser_ast@expr_root_node(expr).inner < 0 of {
                // Typed call/site arg (`f(x: T)`): kind 6 with dummy inner — not a scope binding.
                true -> (false, parser_ast@zero_location(), "");
                false -> {
                    (rhs_found: bool, rhs_loc: { file: string, line: int64, column: int64, offset: int64 }, rhs_name: string) <- expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), parser_ast@dummy_expr());
                    case rhs_found of {
                        true -> (true, rhs_loc, rhs_name);
                        false -> case is_unused_scope_discard_name(parser_ast@expr_root_node(expr).name) of {
                            true -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), extra_scope_result);
                            false -> case expr_contains_identifier_named(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), parser_ast@expr_root_node(expr).name) or expr_contains_identifier_named(extra_scope_result, parser_ast@expr_root_node(expr).name) of {
                                true -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), extra_scope_result);
                                false -> case expr_contains_unused_binding_exempt_expr(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner)) of {
                                    true -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), extra_scope_result);
                                    false -> (true, parser_ast@expr_root_node(expr).location, parser_ast@expr_root_node(expr).name)
                                }
                            }
                        }
                    }
                }
            };
            false -> case parser_ast@expr_root_node(expr).kind == 10 of {
                true -> {
                    (rhs_td_found: bool, rhs_td_loc: { file: string, line: int64, column: int64, offset: int64 }, rhs_td_name: string) <- expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), parser_ast@dummy_expr());
                    case rhs_td_found of {
                        true -> (true, rhs_td_loc, rhs_td_name);
                        false -> {
                            (unused_td: bool, unused_td_name: string) <- tuple_bindings_find_unused(parser_ast@expr_root_node(expr).pattern_bindings, parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), extra_scope_result);
                            case unused_td of {
                                true -> case expr_contains_unused_binding_exempt_expr(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner)) of {
                                    true -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), extra_scope_result);
                                    false -> (true, parser_ast@expr_root_node(expr).location, unused_td_name)
                                };
                                false -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), extra_scope_result)
                            }
                        }
                    }
                };
                false -> case parser_ast@expr_root_node(expr).kind == 11 of {
                    true -> {
                        (body_found: bool, body_loc: { file: string, line: int64, column: int64, offset: int64 }, body_name: string) <- expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr));
                        case body_found of {
                            true -> (true, body_loc, body_name);
                            false -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), parser_ast@dummy_expr())
                        }
                    };
                    false -> {
                        (inner_found: bool, inner_loc: { file: string, line: int64, column: int64, offset: int64 }, inner_name: string) <- expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner), parser_ast@dummy_expr());
                        case inner_found of {
                            true -> (true, inner_loc, inner_name);
                            false -> expr_has_unused_scope_binding(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr), parser_ast@dummy_expr())
                        }
                    }
                }
            }
        }
    }
}



fn decl_has_unused_scope_binding(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case decl.tag == 0 of {
        true -> expr_has_unused_scope_binding(decl.body, parser_ast@dummy_expr());
        false -> (false, parser_ast@zero_location(), "")
    }
}



fn decls_has_unused_scope_binding(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> {
            (head_found: bool, head_loc: { file: string, line: int64, column: int64, offset: int64 }, head_name: string) <- decl_has_unused_scope_binding(decls.head);
            case head_found of {
                true -> (true, head_loc, head_name);
                false -> decls_has_unused_scope_binding(decls.tail)
            }
        }
    }
}



fn validate_no_unused_scope_bindings(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: bool, err_loc: { file: string, line: int64, column: int64, offset: int64 }, bind_name: string) <- decls_has_unused_scope_binding(program.declarations);
    case found of {
        true -> parser_core@parse_err("E1055", err_loc, concat(concat("unused variable '", bind_name), "' in this scope; use it, pass it to a function, return it, or bind it as '_'"), "sect3");
        false -> parser_core@parse_ok(program)
    }
}



// --- E2012: tuple decomposition binding count exceeds register file capacity ---

fn count_decompose_bindings(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> int64 {
    case bindings.is_nil of {
        true -> 0;
        false -> 1 + count_decompose_bindings(bindings.tail)
    }
}



fn expr_has_too_many_decompose_bindings(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, int64) {
    case parser_ast@expr_root_node(expr).kind == 10 of {
        true -> {
            n: int64 <- count_decompose_bindings(parser_ast@expr_root_node(expr).pattern_bindings);
            case n > 14 of {
                true -> (true, parser_ast@expr_root_node(expr).location, n);
                false -> {
                    (r_found: bool, r_loc: { file: string, line: int64, column: int64, offset: int64 }, r_n: int64) <- expr_has_too_many_decompose_bindings(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr));
                    case r_found of {
                        true -> (true, r_loc, r_n);
                        false -> (false, parser_ast@zero_location(), 0)
                    }
                }
            }
        };
        false -> case expr.root < 0 of {
            true -> (false, parser_ast@zero_location(), 0);
            false -> {
                (inner_found: bool, inner_loc: { file: string, line: int64, column: int64, offset: int64 }, inner_n: int64) <- expr_has_too_many_decompose_bindings(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).inner));
                case inner_found of {
                    true -> (true, inner_loc, inner_n);
                    false -> expr_has_too_many_decompose_bindings(parser_ast@expr_at(expr, parser_ast@expr_root_node(expr).right_expr))
                }
            }
        }
    }
}



fn decl_has_too_many_decompose_bindings(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, int64) {
    case decl.tag == 0 of {
        true -> expr_has_too_many_decompose_bindings(decl.body);
        false -> (false, parser_ast@zero_location(), 0)
    }
}



fn decls_has_too_many_decompose_bindings(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, int64) {
    case decls.is_nil of {
        true -> (false, parser_ast@zero_location(), 0);
        false -> {
            (head_found: bool, head_loc: { file: string, line: int64, column: int64, offset: int64 }, head_n: int64) <- decl_has_too_many_decompose_bindings(decls.head);
            case head_found of {
                true -> (true, head_loc, head_n);
                false -> decls_has_too_many_decompose_bindings(decls.tail)
            }
        }
    }
}



fn validate_max_tuple_decompose_bindings(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    (found: bool, err_loc: { file: string, line: int64, column: int64, offset: int64 }, n: int64) <- decls_has_too_many_decompose_bindings(program.declarations);
    case found of {
        true -> parser_core@parse_err("E2012", err_loc, concat("tuple decomposition pattern has ", concat(atom_table@int64_to_decimal_string(n), " elements; the AArch64 register file supports at most 14 simultaneous bindings (X0-X15 excluding X8, X12)")), "sect4.2");
        false -> parser_core@parse_ok(program)
    }
}
