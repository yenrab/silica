// `List[ { stmts; result }, mem(R) ]` → sequence proc[mem(R)] named `__list_typed_block__` (E3001/E3010).
fn slots_start_list_value_block(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_list_keyword() of {
            true -> {
                after_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                case after_kw.is_nil of {
                    true -> false;
                    false -> case after_kw.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
                        true -> {
                            after_lbr: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_kw.tail);
                            case after_lbr.is_nil of {
                                true -> false;
                                false -> case after_lbr.head.token.kind == lexer_token_kind@token_kind_left_brace() or after_lbr.head.token.lexeme == "{" of {
                                    true -> case constraint_extract_params@is_struct_literal_lbrace_fallback(after_lbr) of {
                                        true -> false;
                                        false -> true
                                    };
                                    false -> false
                                }
                            }
                        };
                        false -> false
                    }
                }
            };
            false -> false
        }
    }
}

fn extract_list_value_block(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], extract_fn_body_cb: fn(List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)])) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
