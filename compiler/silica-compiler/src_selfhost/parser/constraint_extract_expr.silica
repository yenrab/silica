// Comma-separated list literal elements; right-nested (a, (b, (c, d))) shape with kind 20 and value "" on pair nodes.
// Closing `]` normally has role_list_lit_rbracket; if constraint propagation missed the role, still accept `]` when
// `: List[...]` follows (same idea as parse_list_literal_type_suffix), so the suffix parser sees `:` not a stale `]`.
// Also accept `)` or `,` after `]` when the list is a tuple element — constraints expect `;` after list_lit_rbracket,
// so `]` before `)` (e.g. `(0, [0])`) or `,` (e.g. `(0, [0], 1)`) often has no role and must parse structurally.
fn extract_list_elements_tail(first: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    case rest.is_nil of {
        true -> (first, rest);
        false -> case rest.head.token.kind == lexer_token_kind@token_kind_right_bracket() or rest.head.token.lexeme == "]" of {
            true -> {
                role_ok: bool <- constraint_core@slot_role(rest.head) == capability_list@role_list_lit_rbracket();
                after_rbr: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- rest.tail;
                after_ws: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_rbr);
                colon_suffix_ok: bool <- case constraint_extract_slots@slots_is_nil(after_ws) of {
                    true -> false;
                    false -> after_ws.head.token.kind == lexer_token_kind@token_kind_colon()
                };
                semi_suffix_ok: bool <- case constraint_extract_slots@slots_is_nil(after_ws) of {
                    true -> true;
                    false -> after_ws.head.token.kind == lexer_token_kind@token_kind_semicolon()
                };
                rparen_suffix_ok: bool <- case constraint_extract_slots@slots_is_nil(after_ws) of {
                    true -> false;
                    false -> after_ws.head.token.kind == lexer_token_kind@token_kind_right_paren() or after_ws.head.token.lexeme == ")"
                };
                comma_tuple_suffix_ok: bool <- case constraint_extract_slots@slots_is_nil(after_ws) of {
                    true -> false;
                    false -> after_ws.head.token.kind == lexer_token_kind@token_kind_comma() or after_ws.head.token.lexeme == ","
                };
                case role_ok or colon_suffix_ok or semi_suffix_ok or rparen_suffix_ok or comma_tuple_suffix_ok of {
                    true -> (first, rest.tail);
                    false -> (first, rest)
                }
            };
            false -> case rest.head.token.kind == lexer_token_kind@token_kind_comma() or rest.head.token.lexeme == "," of {
                true -> case rest.tail.is_nil of {
                    true -> {
                        dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                        sentinel: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(999, "single_list", "", parser_ast@expr_root_node(first).location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                        (sentinel, rest)
                    };
                    false -> case rest.tail.head.token.kind == lexer_token_kind@token_kind_right_bracket() or rest.tail.head.token.lexeme == "]" of {
                        true -> {
                            dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                            sentinel: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(999, "single_list", "", parser_ast@expr_root_node(first).location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                            (sentinel, rest.tail)
                        };
                        false -> {
                            second_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- rest.tail;
                            (second: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_second: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(second_slots);
                            (rest_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_final: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_list_elements_tail(second, rest_after_second);
                            list_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(20, "", "", parser_ast@expr_root_node(first).location, first, rest_expr, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                            (list_expr, rest_final)
                        }
                    }
                };
                false -> (first, rest)
            }
        }
    }
}



fn extract_list_literal(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence
        lbr_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
        after_open: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
        result: ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- case constraint_extract_slots@slots_is_nil(after_open) of {
            true -> (parser_ast@dummy_expr(), slots);
            false -> case after_open.head.token.kind == lexer_token_kind@token_kind_right_bracket() or after_open.head.token.lexeme == "]" of {
                true -> {
                    role_ok: bool <- constraint_core@slot_role(after_open.head) == capability_list@role_list_lit_rbracket();
                    after_rbr_empty: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_open.tail;
                    after_ws_empty: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_rbr_empty);
                    colon_suffix_ok: bool <- case constraint_extract_slots@slots_is_nil(after_ws_empty) of {
                        true -> false;
                        false -> after_ws_empty.head.token.kind == lexer_token_kind@token_kind_colon()
                    };
                    semi_suffix_ok: bool <- case constraint_extract_slots@slots_is_nil(after_ws_empty) of {
                        true -> true;
                        false -> after_ws_empty.head.token.kind == lexer_token_kind@token_kind_semicolon()
                    };
                    rparen_suffix_ok: bool <- case constraint_extract_slots@slots_is_nil(after_ws_empty) of {
                        true -> false;
                        false -> after_ws_empty.head.token.kind == lexer_token_kind@token_kind_right_paren() or after_ws_empty.head.token.lexeme == ")"
                    };
                    comma_tuple_suffix_ok: bool <- case constraint_extract_slots@slots_is_nil(after_ws_empty) of {
                        true -> false;
                        false -> after_ws_empty.head.token.kind == lexer_token_kind@token_kind_comma() or after_ws_empty.head.token.lexeme == ","
                    };
                    case role_ok or colon_suffix_ok or semi_suffix_ok or rparen_suffix_ok or comma_tuple_suffix_ok of {
                        true -> {
                            after_elems: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_open.tail;
                            dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                            empty_list: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(20, "", "", lbr_loc, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                            (empty_list, after_elems)
                        };
                        false -> {
                            (first: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_first: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(after_open);
                            (elem_tree: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, after_rbracket: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_list_elements_tail(first, rest_after_first);
                            dummy_r: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                            root: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- case parser_ast@expr_root_node(elem_tree).kind == 20 of {
                                true -> parser_ast@make_expr(20, "", "", lbr_loc, parser_ast@expr_at(elem_tree, parser_ast@expr_root_node(elem_tree).inner), parser_ast@expr_at(elem_tree, parser_ast@expr_root_node(elem_tree).right_expr), parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                false -> parser_ast@make_expr(20, "", "", lbr_loc, elem_tree, dummy_r, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
                            };
                            (root, after_rbracket)
                        }
                    }
                };
                false -> {
                    (first: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_first: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(after_open);
                    (elem_tree: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, after_rbracket: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_list_elements_tail(first, rest_after_first);
                    dummy_r: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                    root: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- case parser_ast@expr_root_node(elem_tree).kind == 20 of {
                        true -> parser_ast@make_expr(20, "", "", lbr_loc, parser_ast@expr_at(elem_tree, parser_ast@expr_root_node(elem_tree).inner), parser_ast@expr_at(elem_tree, parser_ast@expr_root_node(elem_tree).right_expr), parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                        false -> parser_ast@make_expr(20, "", "", lbr_loc, elem_tree, dummy_r, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
                    };
                    (root, after_rbracket)
                }
            }
        }
    produces
        pure result
    end
}



// List[...] type text: parser_tuples@extract_list_type_from_slots (used for `ident : List[...] <-` bindings).

fn extract_binding_list(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence
        ident_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.head;
        type_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_after_binding_colon(slots);
        tr: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_list_type_from_slots(type_slots);
        bind_name: string <- ident_slot.token.lexeme;
        bind_type: string <- tr.type_str;
        bind_loc: { file: string, line: int64, column: int64, offset: int64 } <- ident_slot.token.location;
        rhs_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@rhs_slots_after_memory_region_type(tr.rest_slots);
        (rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_rhs: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_body(rhs_slots);
        after_semicolons: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_semicolons_after_whitespace(rest_after_rhs);
        (body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_after_body: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_function_body(after_semicolons);
        dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
        let_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(6, bind_type, bind_name, bind_loc, rhs_expr, body, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
        result: ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- (let_expr, rest_after_body)
    produces
        pure result
    end
}



