                                    true -> {
                                        ret_type_loc: { file: string, line: int64, column: int64, offset: int64 } <- first.token.location;
                                        rest_after_type: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- rest;
                                        (effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_effects: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_optional_proc_effects(rest_after_type);
                                        body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- body_slots_after_semicolon(after_effects);
                                        from_kind: string <- constraint_extract_slots@kind_to_type_name(first.token.kind);
                                        ret_lex: string <- first.token.lexeme;
                                        use_type: string <- case len(from_kind) > 0 of { true -> from_kind; false -> ret_lex };
                                        ret_empty: string <- case ret_lex of { "" -> "ret_empty"; _: string -> "ret_ok" };
                                        from_empty: string <- case from_kind of { "" -> "from_empty"; _: string -> "from_ok" };
                                        use_type_instrumented: string <- case use_type of { "" -> concat("DEBUG:", concat(ret_empty, concat(",", from_empty))); _: string -> use_type };
                                        (use_type_instrumented, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                    };
                                    false -> case lexer_token_kind@is_identifier_lexeme_token(first.token.kind) of {
                                        true -> {
                                            ret_type_loc: { file: string, line: int64, column: int64, offset: int64 } <- first.token.location;
                                            rest_after_type: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- rest;
                                            (effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_effects: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_optional_proc_effects(rest_after_type);
                                            body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- body_slots_after_semicolon(after_effects);
                                            (first.token.lexeme, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                        };
                                        false -> {
                                            (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, _effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- find_type_and_semicolon(rest);
                                            (ret_type, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                        }
                                    }
                                }
                            }
                        }
                        }
                    }
                }
            }
            }
        }
    }
    produces
        pure result
    end
}



// `{ field: expr, ... }` is a struct literal when the first `ident:` is not a binding (`ident: type <- ...`).
// Also `{}` (empty). Fails closed when `{` is not followed by `ident:` so `{ sequence ... }` and `{ foo( ... }` are not literals.
fn is_struct_literal_lbrace_fallback(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    sequence proc[DeviceIO]
        result: bool <- case slots.is_nil of {
            true -> false;
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
                true -> case slots.tail.is_nil of {
                    true -> false;
                    false -> {
                        inner: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                        case inner.is_nil of {
                            true -> false;
                            false -> case inner.head.token.kind == lexer_token_kind@token_kind_right_brace() or inner.head.token.lexeme == "}" of {
                                true -> true;
                                false -> case constraint_extract_slots@is_struct_field_name_token(inner.head.token) of {
                                    true -> case inner.tail.is_nil of {
                                        true -> false;
                                        false -> case inner.tail.head.token.kind == lexer_token_kind@token_kind_colon() of {
                                            true -> case is_binding_start(inner) of {
                                                true -> false;
                                                false -> true
                                            };
                                            false -> false
                                        }
                                    };
                                    false -> false
                                }
                            }
                        }
                    }
                };
                false -> false
            }
        }
    produces
        pure result
    end
}



// ident : List[ ... ] <- (list type is not a single type_keyword token)
fn is_list_type_binding_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> case slots.tail.tail.is_nil of {
                true -> false;
                false -> case lexer_token_kind@is_identifier_lexeme_token(slots.head.token.kind) or slots.head.token.kind == lexer_token_kind@token_kind_ref_keyword() or slots.head.token.kind == lexer_token_kind@token_kind_buf_keyword() or slots.head.token.kind == lexer_token_kind@token_kind_region_keyword() of {
                    true -> case slots.tail.head.token.kind == lexer_token_kind@token_kind_colon() of {
                        true -> {
                            ac: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_after_binding_colon(slots);
                            case ac.is_nil of {
                                true -> false;
                                false -> case parser_tuples@slots_start_bracketed_collection_type(ac) of {
                                    true -> true;
                                    false -> false
                                }
                            }
                        };
                        false -> false
                    };
                    false -> false
                }
            }
        }
    }
}



// `ident : fn(T,) -> R <-` (function type in annotation position): fn-token type without lambda-shaped params,
// and `<-` follows the full type. Not `ident : fn(x: T) -> R {` (lambda expression / struct field).
fn binding_start_fn_type(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    sequence proc[DeviceIO]
        ac_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_after_binding_colon(slots);
        result: bool <- case parser_tuples@slots_start_fn_type(ac_kw) of {
            false -> false;
            true -> case lambda_introduces_body_after_sig(ac_kw) of {
                true -> false;
                false -> {
                    (_: string, rest_after_fn_ty: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- parser_tuples@extract_fn_type_from_slots(ac_kw);
                    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(rest_after_fn_ty);
                    case trimmed.is_nil of {
                        true -> false;
                        false -> trimmed.head.token.kind == lexer_token_kind@token_kind_left_arrow()
                    }
                }
            }
        }
    produces
        pure result
    end
}



// Check if slots start with binding pattern: ident : type <-, ident : ( tuple type,
// or untyped `ident <-` (accepted in the AST; type checker emits E2018).
fn is_binding_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    sequence proc[DeviceIO]
        result: bool <- case slots.is_nil of {
            true -> false;
            false -> case slots.tail.is_nil of {
                true -> false;
                false -> case lexer_token_kind@is_identifier_lexeme_token(slots.head.token.kind) or slots.head.token.kind == lexer_token_kind@token_kind_ref_keyword() or slots.head.token.kind == lexer_token_kind@token_kind_buf_keyword() or slots.head.token.kind == lexer_token_kind@token_kind_region_keyword() of {
                    true -> {
                        after_ident: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                        case after_ident.is_nil of {
                            true -> false;
                            false -> case after_ident.head.token.kind == lexer_token_kind@token_kind_left_arrow() of {
                                // `name <- rhs` — missing type annotation (E2018 at type check)
                                true -> true;
                                false -> case slots.tail.tail.is_nil of {
                                    true -> false;
                                    false -> case slots.tail.head.token.kind == lexer_token_kind@token_kind_colon() of {
                                        true -> case is_list_type_binding_start(slots) of {
                                            true -> true;
                                            false -> case parser_tuples@is_struct_type_binding_start(slots) of {
                                                true -> true;
                                                false -> {
                                                    ac_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_after_binding_colon(slots);
                                                    case ac_kw.is_nil of {
                                                        true -> false;
                                                        false -> case constraint_extract_slots@is_type_keyword(ac_kw.head.token.kind) of {
                                                            true -> case ac_kw.tail.is_nil of {
                                                                true -> false;
                                                                false -> case ac_kw.tail.head.token.kind == lexer_token_kind@token_kind_left_arrow() of {
                                                                    true -> true;
                                                                    false -> case parser_tuples@is_memory_region_type_binding_start(slots) of {
                                                                        true -> true;
                                                                        false -> parser_tuples@is_tuple_type_binding_start(slots)
                                                                    }
                                                                }
                                                            };
                                                            false -> case parser_tuples@atom_option_binding_has_arrow_after_type(ac_kw) of {
                                                                true -> true;
                                                                false -> case lexer_token_kind@is_identifier_lexeme_token(ac_kw.head.token.kind)
                                                                    and ac_kw.tail.is_nil == false
                                                                    and ac_kw.tail.head.token.kind == lexer_token_kind@token_kind_left_arrow() of {
                                                                    // Compiler-instantiated library code uses
                                                                    // identifier placeholders (AccType, ItemType,
                                                                    // ActorState, ...).  They are valid annotation
                                                                    // syntax at local bind sites just as they are in
                                                                    // function parameters and returns.  Resolution
                                                                    // remains the type checker's responsibility.
                                                                    true -> true;
                                                                    false -> case binding_start_fn_type(slots) of {
                                                                        true -> true;
                                                                        false -> case parser_tuples@is_memory_region_type_binding_start(slots) of {
                                                                            true -> true;
                                                                            false -> parser_tuples@is_tuple_type_binding_start(slots)
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        };
                                        false -> false
                                    }
                                }
                            }
                        }
                    };
                    false -> false
                }
            }
        }
    produces
        pure result
    end
}



// Illegal trailing `;` after the tail expression of a block or before `produces` / `end` where the grammar omits `;`.
fn trailing_semicolon_marker(semi_loc: { file: string, line: int64, column: int64, offset: int64 }, tail_statement: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence
        dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(997, "E1041", "", semi_loc, tail_statement, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
    produces
        pure result
    end
}



// Chain first_expr with rest_body: if first_expr is a let or tuple_decompose, chain rest_body into its continuation (so we keep the body and add rest_body after it);
// otherwise wrap first_expr in a let _ : unit <- first_expr in rest_body so the statement executes before the return.
fn wrap_let_or_return(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence proc[mem(normal)]
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- case node.kind == 6 of {
            true -> {
                new_continuation: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- wrap_let_or_return(parser_ast@expr_at(expr, node.right_expr), rest_body);
                parser_ast@make_expr(6, node.value, node.name, node.location, parser_ast@expr_at(expr, node.inner), new_continuation, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
            };
            false -> case node.kind == 10 of {
                true -> {
                    new_continuation: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- wrap_let_or_return(parser_ast@expr_at(expr, node.right_expr), rest_body);
                    parser_ast@make_expr(10, node.value, node.name, node.location, parser_ast@expr_at(expr, node.inner), new_continuation, parser_ast@as_list_tuple_decompose_bindings(node.pattern_bindings), parser_ast@empty_effect_name_list())
                };
                false -> parser_ast@make_expr(6, "unit", "_", node.location, expr, rest_body, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
            }
        }
    produces
        pure result
    end
}



// True when the next non-whitespace token can open another statement/expression in a block.
// Used to distinguish a genuine missing `;` (E1040) from an uncategorized defect (E1000).
fn next_token_starts_statement(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    sequence
        result: bool <- case slots.is_nil of {
            true -> false;
            false -> {
                tok_kind: int64 <- slots.head.token.kind;
                lex: string <- slots.head.token.lexeme;
                lexer_token_kind@is_identifier_lexeme_token(tok_kind)
                    or tok_kind == lexer_token_kind@token_kind_integer_literal()
                    or tok_kind == lexer_token_kind@token_kind_float_literal()
                    or tok_kind == lexer_token_kind@token_kind_string_literal()
                    or tok_kind == lexer_token_kind@token_kind_atom_literal()
                    or tok_kind == lexer_token_kind@token_kind_left_paren() or lex == "("
                    or tok_kind == lexer_token_kind@token_kind_left_bracket() or lex == "["
                    or tok_kind == lexer_token_kind@token_kind_left_brace() or lex == "{"
                    or tok_kind == lexer_token_kind@token_kind_sequence_keyword() or lex == "sequence"
                    or tok_kind == lexer_token_kind@token_kind_case_keyword() or lex == "case"
                    or tok_kind == lexer_token_kind@token_kind_if_keyword() or lex == "if"
                    or tok_kind == lexer_token_kind@token_kind_minus() or lex == "-"
                    or tok_kind == lexer_token_kind@token_kind_bnot_keyword() or lex == "bnot"
                    or tok_kind == lexer_token_kind@token_kind_ref_keyword() or lex == "ref"
                    or tok_kind == lexer_token_kind@token_kind_buf_keyword() or lex == "buf"
                    or tok_kind == lexer_token_kind@token_kind_region_keyword() or lex == "region"
            }
        }
    produces
        pure result
    end
}



// Parse recovery: mark missing `;` between first_expr and the next statement; inner holds the recovered let-chain.
fn missing_statement_terminator_wrapper(err_loc: { file: string, line: int64, column: int64, offset: int64 }, first_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence
        dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
        glued: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- wrap_let_or_return(first_expr, rest_body);
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(996, "E1040", "", err_loc, glued, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
    produces
        pure result
    end
}



// Parse recovery: uncategorized syntactic defect when the next token does not look like a new statement.
fn uncategorized_syntax_defect_wrapper(err_loc: { file: string, line: int64, column: int64, offset: int64 }, first_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence
        dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
        glued: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- wrap_let_or_return(first_expr, rest_body);
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(995, "E1000", "", err_loc, glued, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
    produces
        pure result
    end
}



// Choose E1040 when the next token starts another statement; otherwise E1000 catch-all.
fn statement_boundary_error_wrapper(err_loc: { file: string, line: int64, column: int64, offset: int64 }, first_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, after_trim: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case next_token_starts_statement(after_trim) of {
        true -> missing_statement_terminator_wrapper(err_loc, first_expr, rest_body);
        false -> uncategorized_syntax_defect_wrapper(err_loc, first_expr, rest_body)
    }
}



// kind 10: value is "" or whole-pattern tuple type string when `(p): (T1, T2) <- rhs` (see check_tuple_decompose).
fn tuple_decompose_build_expr(lparen_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, td_result: { pattern_str: string, bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] }, ann_type_str: string) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(10, ann_type_str, "", lparen_slot.token.location, rhs_expr, body, parser_tuples@get_bindings_for_ast(td_result), parser_ast@empty_effect_name_list())
    produces
        pure result
    end
}



fn is_sequence_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == lexer_token_kind@token_kind_sequence_keyword()
    }
}



// After `]` of a list literal: `: List[...]`; returns (type annotation text, rest after the closing `]` of List[...]).
// Accept `List` as list_keyword or identifier lexeme "List" (same as extract_list_type_from_slots / token_is_list_type_name).
// If constraint roles omit role_list_lit_colon on `:`, still parse when `List[...]` clearly follows (avoids leaving `:` in the stream).
fn parse_list_literal_type_suffix(after_rbracket: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (string, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    case constraint_extract_slots@slots_is_nil(after_rbracket) of {
        true -> ("", after_rbracket);
        false -> case after_rbracket.head.token.kind == lexer_token_kind@token_kind_colon() of {
            true -> {
                after_colon: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_rbracket.tail;
                role_ok: bool <- constraint_core@slot_role(after_rbracket.head) == capability_list@role_list_lit_colon();
                list_follows: bool <- case constraint_extract_slots@slots_is_nil(after_colon) of {
                    true -> false;
                    false -> parser_tuples@slots_start_bracketed_collection_type(after_colon)
                };
                case role_ok or list_follows of {
                    true -> case constraint_extract_slots@slots_is_nil(after_colon) of {
                        true -> ("", after_colon);
                        false -> case parser_tuples@slots_start_bracketed_collection_type(after_colon) of {
                            true -> {
                                tr_lit: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_list_type_from_slots(after_colon);
                                (tr_lit.type_str, tr_lit.rest_slots)
                            };
                            false -> ("", after_rbracket)
                        }
                    };
                    false -> ("", after_rbracket)
                }
            };
            false -> ("", after_rbracket)
        }
    }
}



fn extract_skip_to_rparen(rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case rest.is_nil of {
        true -> rest;
        false -> case rest.head.token.kind == lexer_token_kind@token_kind_right_paren() of {
            true -> rest.tail;
            false -> rest
        }
    }
}



// After a call name: optional `[T, S]` with role_call_gen_lbracket; returns (inner type-arg lexemes joined with spaces, slots at `(`).
// If constraint propagation omits role_call_gen_lbracket on `[`, still accept `name[T](` when `(` clearly follows `]`.
fn extract_optional_generic_type_args_after_name(rest_after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (string, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    case constraint_extract_slots@slots_is_nil(rest_after_name) of {
        true -> ("", rest_after_name);
        false -> case constraint_extract_slots@slots_head(rest_after_name).token.kind == lexer_token_kind@token_kind_left_bracket() of {
            true -> case constraint_core@slot_role(constraint_extract_slots@slots_head(rest_after_name)) == capability_list@role_call_gen_lbracket() of {
                true -> {
                    (type_join: string, rest_after_brackets: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_slots@skip_square_bracket_group_depth_join(constraint_extract_slots@slots_tail(rest_after_name), 1, "");
                    rest_at_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(rest_after_brackets);
                    type_args: string <- constraint_extract_slots@strip_trailing_rbracket_type_arg_join(type_join);
                    (type_args, rest_at_lparen)
                };
                false -> {
                    (type_join2: string, rest_after_brackets2: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_slots@skip_square_bracket_group_depth_join(constraint_extract_slots@slots_tail(rest_after_name), 1, "");
                    rest_at_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(rest_after_brackets2);
                    case constraint_extract_slots@slots_is_nil(rest_at_lparen) of {
                        true -> ("", rest_after_name);
                        false -> case constraint_extract_slots@slots_head(rest_at_lparen).token.kind == lexer_token_kind@token_kind_left_paren() of {
                            true -> {
                                type_args: string <- constraint_extract_slots@strip_trailing_rbracket_type_arg_join(type_join2);
                                (type_args, rest_at_lparen)
                            };
                            false -> ("", rest_after_name)
                        }
                    }
                }
            };
            false -> ("", rest_after_name)
        }
    }
}



// `name` followed by `[` : use extract_call when role_call_gen_lbracket is set, or when `[...]` is followed by `(` (generic call).
fn should_extract_call_after_name(rest_after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case constraint_extract_slots@slots_is_nil(rest_after_name) of {
        true -> false;
        false -> case rest_after_name.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
            true -> {
                role_ok: bool <- constraint_core@slot_role(rest_after_name.head) == capability_list@role_call_gen_lbracket();
                case role_ok of {
                    true -> true;
                    false -> {
                        rest_after_sq: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_square_bracket_group_depth(constraint_extract_slots@slots_tail(rest_after_name), 1);
                        after_ws: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(rest_after_sq);
                        case constraint_extract_slots@slots_is_nil(after_ws) of {
                            true -> false;
                            false -> after_ws.head.token.kind == lexer_token_kind@token_kind_left_paren()
                        }
                    }
                }
            };
            false -> false
        }
    }
}



fn take_case_rhs_until_branch_end(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    case slots.is_nil of {
        true -> (constraint_core@empty_list_slot(), constraint_core@empty_list_slot());
        // Prefer lexer kinds so we stop before slot_role (possible_roles ordering can disagree with surface syntax).
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_semicolon() or slots.head.token.lexeme == ";" of {
            true -> (constraint_core@empty_list_slot(), slots);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_brace() or slots.head.token.lexeme == "}" of {
                true -> (constraint_core@empty_list_slot(), slots);
                false -> case constraint_core@slot_role(slots.head) == capability_case@role_case_branch_stmt_sep() of {
                    true -> (constraint_core@empty_list_slot(), slots);
                    false -> case constraint_core@slot_role(slots.head) == constraint_extract_slots@role_right_brace() of {
                        true -> (constraint_core@empty_list_slot(), slots);
                        false -> {
                            (tail_p: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- take_case_rhs_until_branch_end(slots.tail);
                            (constraint_core@cons_slot(slots.head, tail_p), rest)
                        }
                    }
                }
            }
        }
    }
}



fn skip_case_branch_terminator(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] proc[DeviceIO] {
    ws: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case ws.is_nil of {
        true -> ws;
        false -> case ws.head.token.kind == lexer_token_kind@token_kind_semicolon() or ws.head.token.lexeme == ";" of {
            true -> constraint_extract_slots@skip_leading_whitespace_slots(ws.tail);
            false -> case constraint_core@slot_role(ws.head) == capability_case@role_case_branch_stmt_sep() of {
                true -> constraint_extract_slots@skip_leading_whitespace_slots(ws.tail);
                false -> ws
            }
        }
    }
}



fn expr_fn_type_opaque_from_slots(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    first: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.head;
    (fn_ty: string, rest_after_fn: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- parser_tuples@extract_fn_type_from_slots(slots);
    dumx: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
    fn_ty_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(992, fn_ty, "__fn_type_expr__", first.token.location, dumx, dumx, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
    (fn_ty_expr, rest_after_fn)
}



// `fn(int64) -> T` uses opaque fn-type parsing; `fn(x: T) -> U {`, `fn() -> U {`, `fn((a:T,...)) -> U {` introduce lambdas.
fn lambda_introduces_body_after_sig(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case parser_tuples@slots_start_fn_type(slots) of {
        false -> false;
        true -> {
            after_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
            case after_kw.is_nil of {
                true -> false;
                false -> case after_kw.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
                    false -> false;
                    true -> case after_kw.tail.is_nil of {
                        true -> false;
                        false -> case after_kw.tail.head.token.kind == lexer_token_kind@token_kind_right_paren() of {
                            true -> true;
                            false -> case lexer_token_kind@is_identifier_lexeme_token(after_kw.tail.head.token.kind) of {
                                true -> true;
                                false -> case after_kw.tail.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
                                    true -> true;
                                    false -> false
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



fn param_types_str_lambda(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    case params.is_nil of {
        true -> "";
        false -> case params.tail.is_nil of {
            true -> params.head.type_name;
            false -> concat(concat(param_types_str_lambda(params.tail), ","), params.head.type_name)
        }
    }
}



fn build_lambda_fn_type_value(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], ret: string) -> string {
    case params.is_nil of {
        true -> concat("() -> ", ret);
        false -> concat(concat(concat("(", param_types_str_lambda(params)), ") -> "), ret)
    }
}



fn params_to_lambda_bindings(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case params.is_nil of {
        true -> parser_ast@nil_tuple_decompose_bindings();
        false -> {
            p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- params.head;
            b: { name: string, path: string, type_str: string } <- parser_ast@make_tuple_decompose_binding(p.name, "", p.type_name);
            parser_ast@cons_tuple_decompose_binding(b, params_to_lambda_bindings(params.tail))
        }
    }
}



// Field access and future postfix ops: binds tighter than binary ops (e.g. a.b + c → (a.b) + c).
fn extract_postfix_tail(left: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
    case constraint_extract_slots@slots_is_nil(rest) of {
        true -> (left, rest);
        false -> case constraint_extract_slots@slots_head(rest).token.kind == lexer_token_kind@token_kind_dot() of {
            true -> case constraint_extract_slots@slots_is_nil(constraint_extract_slots@slots_tail(rest)) of {
                true -> (left, rest);
                false -> case constraint_extract_slots@is_struct_field_name_token(constraint_extract_slots@slots_head(constraint_extract_slots@slots_tail(rest)).token) of {
                    true -> {
                        dot_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- constraint_extract_slots@slots_head(rest);
                        field_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- constraint_extract_slots@slots_head(constraint_extract_slots@slots_tail(rest));
                        after_field: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_tail(constraint_extract_slots@slots_tail(rest));
                        field_access: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(22, "", field_slot.token.lexeme, dot_slot.token.location, left, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                        extract_postfix_tail(field_access, after_field)
                    };
                    false -> (left, rest)
                }
            };
            false -> (left, rest)
        }
    }
}



fn skip_impl_annotation(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], bool) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (slots, false);
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_impl_keyword() or trimmed.head.token.lexeme == "impl" of {
            true -> {
                after_impl: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(trimmed.tail);
                case after_impl.is_nil of {
                    true -> (slots, false);
                    false -> {
                        after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_impl.tail);
                        case after_name.is_nil of {
                            true -> (slots, false);
                            false -> case after_name.head.token.kind == lexer_token_kind@token_kind_left_brace() of {
                                true -> {
                                    after_lbrace: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_name.tail);
                                    case after_lbrace.is_nil of {
                                        true -> (slots, false);
                                        false -> case after_lbrace.head.token.kind == lexer_token_kind@token_kind_right_brace() of {
                                            true -> (after_lbrace.tail, true);
                                            false -> (slots, false)
                                        }
                                    }
                                };
                                false -> (slots, false)
                            }
                        }
                    }
                }
            };
            false -> (slots, false)
        }
    }
}



// Module-qualified function reference: `Module@function` without call parentheses.
// Use identifier expression shape so function-value paths treat it like a bare `function`.
fn extract_module_qualified_reference(mod_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, fn_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence
        dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
        mq_name: string <- concat(concat(mod_slot.token.lexeme, "@"), fn_slot.token.lexeme);
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(1, "", mq_name, mod_slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
    produces
        pure result
    end
}



fn extract_operand_expr(slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence
        dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- case slot.token.kind == lexer_token_kind@token_kind_integer_literal() of {
            true -> parser_ast@make_expr(0, slot.token.lexeme, "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
            false -> case slot.token.kind == lexer_token_kind@token_kind_float_literal() of {
                true -> parser_ast@make_expr(0, slot.token.lexeme, "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                false -> case slot.token.kind == lexer_token_kind@token_kind_atom_literal() of {
                    true -> parser_ast@make_expr(5, slot.token.lexeme, "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                    false -> case slot.token.kind == lexer_token_kind@token_kind_true_literal() of {
                        true -> parser_ast@make_expr(7, "true", "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                        false -> case slot.token.kind == lexer_token_kind@token_kind_false_literal() of {
                            true -> parser_ast@make_expr(7, "false", "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                            false -> case slot.token.kind == lexer_token_kind@token_kind_string_literal() of {
                                true -> parser_ast@make_expr(8, slot.token.lexeme, "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                false -> case slot.token.kind == lexer_token_kind@token_kind_char_literal() of {
                                    true -> parser_ast@make_expr(0, slot.token.lexeme, "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                    false -> parser_ast@make_expr(1, "", slot.token.lexeme, slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}



