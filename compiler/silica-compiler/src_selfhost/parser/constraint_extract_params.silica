// Parameter/type collection, fn/effect declaration heads, and extract helpers used by expr.

use lexer_core;
use lexer_token_kind;
use constraint_core;
use parser_ast;
use parser_tuples;
use capability_list;
use instantiated_fn_name;
use constraint_extract_slots;

export extract_effect_declaration/1;
export extract_optional_bracket_suffix_after_name/1;
export is_fn_decl_start/1;
export is_effect_decl_start/1;
export collect_optional_proc_effects/1;
export collect_params_and_find_type_and_body/1;
export collect_params_and_find_type_and_semicolon/1;
export extract_td_bindings_from_params/1;
export build_tuple_type_from_td_bindings/1;
export is_struct_literal_lbrace_fallback/1;
export is_list_type_binding_start/1;
export is_binding_start/1;
export trailing_semicolon_marker/2;
export wrap_let_or_return/2;
export statement_boundary_error_wrapper/4;
export tuple_decompose_build_expr/5;
export extract_optional_generic_type_args_after_name/1;
export should_extract_call_after_name/1;
export skip_case_branch_terminator/1;
export expr_fn_type_opaque_from_slots/1;
export lambda_introduces_body_after_sig/1;
export build_lambda_fn_type_value/2;
export params_to_lambda_bindings/1;
export extract_postfix_tail/2;
export skip_impl_annotation/1;
export extract_module_qualified_reference/2;
export extract_operand_expr/1;
export extract_body_expr/1;



fn extract_effect_declaration(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence proc[DeviceIO]
        result: ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- case slots.is_nil of {
            true -> {
                empty: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_core@empty_list_slot();
                (parser_ast@dummy_decl(), empty)
            };
            false -> case slots.tail.is_nil of {
                true -> (parser_ast@dummy_decl(), slots.tail);
                false -> {
                    kw_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
                    name_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.tail.head;
                    rest_after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail.tail;
                    case rest_after_name.is_nil of {
                        true -> (parser_ast@dummy_decl(), rest_after_name);
                        false -> {
                            after_equal: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- rest_after_name.tail;
                            case after_equal.is_nil of {
                                true -> (parser_ast@dummy_decl(), after_equal);
                                false -> case after_equal.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
                                    true -> {
                                        (effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], rest_after_effects: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_effects_until_right_bracket(after_equal.tail, parser_ast@empty_effect_name_list());
                                        dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                        zero_loc: { file: string, line: int64, column: int64, offset: int64 } <- parser_ast@zero_location();
                                        decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- { tag: 1, name: name_slot.token.lexeme, parameters: parser_ast@nil_list_param(), return_type_name: "", return_type_location: zero_loc, location: kw_loc, body: dummy, declared_effects: effects };
                                        (decl, rest_after_effects)
                                    };
                                    false -> (parser_ast@dummy_decl(), after_equal)
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}



// After an identifier in fn/export position: optional `[T, mem(S)]` suffix (not a generic call).
fn extract_optional_bracket_suffix_after_name(rest_after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (string, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    case constraint_extract_slots@slots_is_nil(rest_after_name) of {
        true -> ("", rest_after_name);
        false -> case constraint_extract_slots@slots_head(rest_after_name).token.kind == lexer_token_kind@token_kind_left_bracket() of {
            true -> {
                (type_join: string, rest_after_brackets: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_slots@skip_square_bracket_group_depth_join(constraint_extract_slots@slots_tail(rest_after_name), 1, "");
                inner_raw: string <- constraint_extract_slots@strip_trailing_rbracket_type_arg_join(type_join);
                inner: string <- instantiated_fn_name@strip_all_spaces_inst(inner_raw);
                suffix: string <- concat("[", concat(inner, "]"));
                (suffix, rest_after_brackets)
            };
            false -> ("", rest_after_name)
        }
    }
}



fn is_fn_decl_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> parser_tuples@slots_start_fn_type(slots)
        }
    }
}



fn is_effect_decl_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> case slots.tail.tail.is_nil of {
                true -> false;
                false -> case slots.tail.tail.tail.is_nil of {
                    true -> false;
                            false -> case slots.head.token.kind == lexer_token_kind@token_kind_identifier() of {
                        true -> case slots.head.token.lexeme == "effect" of {
                                true -> case lexer_token_kind@is_identifier_lexeme_token(slots.tail.head.token.kind) of {
                                true -> case slots.tail.tail.head.token.kind == lexer_token_kind@token_kind_equal() of {
                                    true -> slots.tail.tail.tail.head.token.kind == lexer_token_kind@token_kind_left_bracket();
                                    false -> false
                                };
                                false -> false
                            };
                            false -> false
                        };
                        false -> false
                    }
                }
            }
        }
    }
}



fn collect_effects_until_right_bracket(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], acc: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> (List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    case slots.is_nil of {
        true -> (acc, slots);
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_right_bracket() of {
            true -> (acc, slots.tail);
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_comma() of {
                true -> collect_effects_until_right_bracket(slots.tail, acc);
                false -> case lexer_token_kind@is_proc_list_effect_head_token(slots.head.token.kind) of {
                    true -> {
                        rest1: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
                        case rest1.is_nil of {
                            true -> {
                                eff: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                next_acc: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@cons_effect_name(eff, acc);
                                collect_effects_until_right_bracket(rest1, next_acc)
                            };
                            false -> case rest1.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
                                true -> case rest1.tail.is_nil of {
                                    true -> {
                                        eff_no_param: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                        next_acc_no_param: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@cons_effect_name(eff_no_param, acc);
                                        collect_effects_until_right_bracket(rest1, next_acc_no_param)
                                    };
                                    false -> case constraint_extract_slots@is_effect_paren_param_token(rest1.tail.head.token.kind) of {
                                        true -> case rest1.tail.tail.is_nil of {
                                            true -> {
                                                eff_no_param: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                                next_acc_no_param: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@cons_effect_name(eff_no_param, acc);
                                                collect_effects_until_right_bracket(rest1, next_acc_no_param)
                                            };
                                            false -> case rest1.tail.tail.head.token.kind == lexer_token_kind@token_kind_right_paren() of {
                                                true -> {
                                                    eff: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: slots.head.token.lexeme, parameter: rest1.tail.head.token.lexeme, location: slots.head.token.location };
                                                    next_acc: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@cons_effect_name(eff, acc);
                                                    collect_effects_until_right_bracket(rest1.tail.tail.tail, next_acc)
                                                };
                                                false -> {
                                                    eff_no_param: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                                    next_acc_no_param: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@cons_effect_name(eff_no_param, acc);
                                                    collect_effects_until_right_bracket(rest1, next_acc_no_param)
                                                }
                                            }
                                        };
                                        false -> {
                                            eff_no_param: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                            next_acc_no_param: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@cons_effect_name(eff_no_param, acc);
                                            collect_effects_until_right_bracket(rest1, next_acc_no_param)
                                        }
                                    }
                                };
                                false -> {
                                    eff: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: slots.head.token.lexeme, parameter: "", location: slots.head.token.location };
                                    next_acc: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@cons_effect_name(eff, acc);
                                    collect_effects_until_right_bracket(rest1, next_acc)
                                }
                            }
                        }
                    };
                    false -> collect_effects_until_right_bracket(slots.tail, acc)
                }
            }
        }
    }
}



fn collect_optional_proc_effects(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    case slots.is_nil of {
        true -> (parser_ast@empty_effect_name_list(), slots);
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_proc_keyword() or slots.head.token.lexeme == "proc" of {
            true -> case slots.tail.is_nil of {
                true -> (parser_ast@empty_effect_name_list(), slots);
                false -> case slots.tail.head.token.kind == lexer_token_kind@token_kind_left_bracket() of {
                    true -> collect_effects_until_right_bracket(slots.tail.tail, parser_ast@empty_effect_name_list());
                    false -> (parser_ast@empty_effect_name_list(), slots)
                }
            };
            false -> (parser_ast@empty_effect_name_list(), slots)
        }
    }
}



// Collect params from ( param_name : param_type , ... ) and find return type/body. Slots start with left_paren.
fn collect_params_and_find_type_and_body(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], string, { file: string, line: int64, column: int64, offset: int64 }, List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    // Use lexemes for `(`/`)` — kind values can collide in nested List/record param types (same quirk as extract_tuple_type_loop).
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@nil_list_param(), "", parser_ast@zero_location(), parser_ast@empty_effect_name_list(), constraint_core@empty_list_slot());
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_left_paren() or trimmed.head.token.lexeme == "(" of {
            true -> {
                after_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(trimmed.tail);
                case after_lparen.is_nil of {
                    true -> (parser_ast@nil_list_param(), "", parser_ast@zero_location(), parser_ast@empty_effect_name_list(), constraint_core@empty_list_slot());
                    false -> case after_lparen.head.token.kind == lexer_token_kind@token_kind_right_paren() or after_lparen.head.token.lexeme == ")" of {
                        true -> {
                            rest_after_rparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_lparen.tail;
                            (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- find_type_and_body(rest_after_rparen);
                            (parser_ast@nil_list_param(), ret_type, ret_type_loc, effects, body_slots)
                        };
                        false -> {
                            (params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], rest_after_params: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_params_loop(after_lparen, parser_ast@nil_list_param());
                            (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- find_type_and_body(rest_after_params);
                            (params, ret_type, ret_type_loc, effects, body_slots)
                        }
                    }
                }
            };
            false -> {
                (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- find_type_and_body(trimmed);
                (parser_ast@nil_list_param(), ret_type, ret_type_loc, effects, body_slots)
            }
        }
    }
}



// `required` trait methods: signature only, terminated by `;`.
fn collect_params_and_find_type_and_semicolon(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], string, { file: string, line: int64, column: int64, offset: int64 }, List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@nil_list_param(), "", parser_ast@zero_location(), parser_ast@empty_effect_name_list(), constraint_core@empty_list_slot());
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_left_paren() or trimmed.head.token.lexeme == "(" of {
            true -> {
                after_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(trimmed.tail);
                case after_lparen.is_nil of {
                    true -> (parser_ast@nil_list_param(), "", parser_ast@zero_location(), parser_ast@empty_effect_name_list(), constraint_core@empty_list_slot());
                    false -> case after_lparen.head.token.kind == lexer_token_kind@token_kind_right_paren() or after_lparen.head.token.lexeme == ")" of {
                        true -> {
                            rest_after_rparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- after_lparen.tail;
                            (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- find_type_and_semicolon(rest_after_rparen);
                            (parser_ast@nil_list_param(), ret_type, ret_type_loc, effects, body_slots)
                        };
                        false -> {
                            (params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], rest_after_params: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_params_loop(after_lparen, parser_ast@nil_list_param());
                            (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- find_type_and_semicolon(rest_after_params);
                            (params, ret_type, ret_type_loc, effects, body_slots)
                        }
                    }
                }
            };
            false -> {
                (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- find_type_and_semicolon(trimmed);
                (parser_ast@nil_list_param(), ret_type, ret_type_loc, effects, body_slots)
            }
        }
    }
}



fn bindings_to_params(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case bindings.is_nil of {
        true -> parser_ast@nil_list_param();
        false -> {
            b: { name: string, path: string, type_str: string } <- bindings.head;
            p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: b.name, type_name: b.type_str, location: parser_ast@zero_location() };
            parser_ast@cons_param(p, bindings_to_params(bindings.tail))
        }
    }
}



// Detect tuple decomposition pattern in function param slots.
// slots = ( ( a : T , b : U ) ) -> ... for the TD case.
// Returns the bindings if found, nil otherwise.
fn extract_td_bindings_from_params(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] proc[DeviceIO] {
    case slots.is_nil of {
        true -> parser_ast@nil_tuple_decompose_bindings();
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
            true -> case slots.tail.is_nil of {
                true -> parser_ast@nil_tuple_decompose_bindings();
                false -> case slots.tail.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
                    true -> case slots.tail.tail.is_nil of {
                        true -> parser_ast@nil_tuple_decompose_bindings();
                        false -> case lexer_token_kind@is_identifier_lexeme_token(slots.tail.tail.head.token.kind) of {
                            true -> {
                                td_result: { pattern_str: string, bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_tuple_decompose_pattern_from_slots(slots.tail);
                                td_result.bindings
                            };
                            false -> parser_ast@nil_tuple_decompose_bindings()
                        }
                    };
                    false -> parser_ast@nil_tuple_decompose_bindings()
                }
            };
            false -> parser_ast@nil_tuple_decompose_bindings()
        }
    }
}



// Build tuple type string from decomposition bindings, e.g. "(int64,int64)"
fn build_tuple_type_from_td_bindings(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> string {
    inner: string <- build_tuple_type_inner(bindings);
    concat("(", concat(inner, ")"))
}



fn build_tuple_type_inner(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> string {
    case bindings.is_nil of {
        true -> "";
        false -> {
            b: { name: string, path: string, type_str: string } <- bindings.head;
            rest: string <- build_tuple_type_inner(bindings.tail);
            case len(rest) == 0 of {
                true -> b.type_str;
                false -> concat(b.type_str, concat(",", rest))
            }
        }
    }
}



fn append_params(a: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], b: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> parser_ast@cons_param(a.head, append_params(a.tail, b))
    }
}



fn collect_params_loop(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], acc: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> (List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    // Lexeme `)`/`,` — do not close the fn param list on a nested `mem(normal)` `)` when kind collides.
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (acc, trimmed);
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_right_paren() or trimmed.head.token.lexeme == ")" of {
            true -> (acc, trimmed.tail);
            false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_left_paren() or trimmed.head.token.lexeme == "(" of {
                true -> {
                    after_td_lparen: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(trimmed.tail);
                    case after_td_lparen.is_nil of {
                        true -> (acc, trimmed);
                        false -> case lexer_token_kind@is_identifier_lexeme_token(after_td_lparen.head.token.kind) of {
                            true -> {
                                td_result: { pattern_str: string, bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_tuple_decompose_pattern_from_slots(trimmed);
                                td_rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(td_result.rest_slots);
                                td_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)] <- td_result.bindings;
                                params_from_bindings: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- bindings_to_params(td_bindings);
                                new_acc: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- append_params(params_from_bindings, acc);
                                case td_rest.is_nil of {
                                    true -> (new_acc, td_rest);
                                    false -> case td_rest.head.token.kind == lexer_token_kind@token_kind_comma() or td_rest.head.token.lexeme == "," of {
                                        true -> collect_params_loop(td_rest.tail, new_acc);
                                        false -> case td_rest.head.token.kind == lexer_token_kind@token_kind_right_paren() or td_rest.head.token.lexeme == ")" of {
                                            true -> (new_acc, td_rest.tail);
                                            false -> (new_acc, td_rest)
                                        }
                                    }
                                }
                            };
                            false -> (acc, trimmed)
                        }
                    }
                };
                false -> case lexer_token_kind@is_identifier_lexeme_token(trimmed.head.token.kind) of {
                    true -> case trimmed.tail.is_nil of {
                        true -> (acc, trimmed);
                        false -> {
                            after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(trimmed.tail);
                            case after_name.is_nil of {
                                true -> (acc, trimmed);
                                false -> case after_name.head.token.kind == lexer_token_kind@token_kind_colon() of {
                                    true -> {
                                        param_name: string <- trimmed.head.token.lexeme;
                                        param_loc: { file: string, line: int64, column: int64, offset: int64 } <- trimmed.head.token.location;
                                        type_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@slots_after_binding_colon(trimmed);
                                        (param_type_str: string, rest_after_type: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_single_param_type(type_slots);
                                        p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: param_name, type_name: param_type_str, location: param_loc };
                                        new_acc: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@cons_param(p, acc);
                                        rest_delim: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(rest_after_type);
                                        case rest_delim.is_nil of {
                                            true -> (new_acc, rest_delim);
                                            false -> case rest_delim.head.token.kind == lexer_token_kind@token_kind_comma() or rest_delim.head.token.lexeme == "," of {
                                                true -> collect_params_loop(rest_delim.tail, new_acc);
                                                false -> case rest_delim.head.token.kind == lexer_token_kind@token_kind_right_paren() or rest_delim.head.token.lexeme == ")" of {
                                                    true -> (new_acc, rest_delim.tail);
                                                    false -> (new_acc, rest_delim)
                                                }
                                            }
                                        }
                                    };
                                    false -> (acc, trimmed)
                                }
                            }
                        }
                    };
                    false -> (acc, trimmed)
                }
            }
        }
    }
}



fn extract_single_param_type(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (string, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    case slots.is_nil of {
        true -> ("", slots);
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_paren() of {
            true -> {
                tr: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_tuple_type_from_slots(slots);
                (tr.type_str, tr.rest_slots)
            };
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_ref_keyword() or slots.head.token.kind == lexer_token_kind@token_kind_region_keyword() or slots.head.token.kind == lexer_token_kind@token_kind_buf_keyword() of {
                true -> {
                    tr: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_parametrized_type_from_slots(slots);
                    (tr.type_str, tr.rest_slots)
                };
                false -> case slots.head.token.kind == lexer_token_kind@token_kind_atomic_keyword() of {
                    true -> case slots.tail.is_nil of {
                        true -> ("", slots);
                        false -> case slots.tail.head.token.kind == lexer_token_kind@token_kind_ref_keyword() of {
                            true -> {
                                tr: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_parametrized_type_from_slots(slots);
                                (tr.type_str, tr.rest_slots)
                            };
                            false -> (constraint_extract_slots@kind_to_type_name(slots.head.token.kind), slots.tail)
                        }
                    };
                    false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
                        true -> {
                            tr_rec: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_inline_record_type_from_slots(slots);
                            (tr_rec.type_str, tr_rec.rest_slots)
                        };
                        false -> case parser_tuples@slots_start_bracketed_collection_type(slots) of {
                            true -> {
                                tr_ls: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_list_type_from_slots(slots);
                                (tr_ls.type_str, tr_ls.rest_slots)
                            };
                            // Same `fn (...) -> …` surface as parser_tuples@extract_tuple_type_loop (fn_keyword or identifier "fn").
                            false -> case parser_tuples@slots_start_fn_type(slots) of {
                                true -> {
                                    (fn_s: string, fn_r: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- parser_tuples@extract_fn_type_from_slots(slots);
                                    (fn_s, fn_r)
                                };
                                false -> case slots.head.token.kind == lexer_token_kind@token_kind_atom_literal() of {
                                    true -> {
                                        tr_at: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_atom_option_type_from_slots(slots);
                                        (tr_at.type_str, tr_at.rest_slots)
                                    };
                                    false -> case constraint_extract_slots@is_type_keyword(slots.head.token.kind) of {
                                        true -> (constraint_extract_slots@kind_to_type_name(slots.head.token.kind), slots.tail);
                                        false -> case lexer_token_kind@is_identifier_lexeme_token(slots.head.token.kind) of {
                                            true -> (slots.head.token.lexeme, slots.tail);
                                            false -> ("", slots)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



// After `-> T` and optional proc effects, slots begin with `{` ... `}`; strip `{` so extract_function_body
// parses inner statements (extract_body does not treat left_brace as a block opener).
fn body_slots_after_open_brace(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_left_brace() or slots.head.token.lexeme == "{" of {
            true -> slots.tail;
            false -> slots
        }
    }
}




// After `-> T` and optional proc effects for trait `required` methods: `-> type ;` (silica-specification §3.4.8).
fn body_slots_after_semicolon(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> trimmed;
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_semicolon() of {
            true -> trimmed.tail;
            false -> constraint_core@empty_list_slot()
        }
    }
}



// Return type and effects are separate: -> int64 proc[device_io] means return_type=int64, effects=[device_io].
// When proc effects follow, token.lexeme may be empty; derive type from token.kind for type keywords.
fn find_type_and_body(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (string, { file: string, line: int64, column: int64, offset: int64 }, List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence proc[DeviceIO]
        result: (string, { file: string, line: int64, column: int64, offset: int64 }, List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- case slots.is_nil of {
            true -> {
                zero_loc: { file: string, line: int64, column: int64, offset: int64 } <- parser_ast@zero_location();
                empty_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@empty_effect_name_list();
                empty: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_core@empty_list_slot();
                ("", zero_loc, empty_effects, empty)
            };
            false -> {
                first: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- slots.head;
                rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
                top_or_type: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_top_level_or_type_from_slots(slots);
                case len(top_or_type.type_str) > 0 of {
                    true -> {
                        (effects_top: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_effects_top: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_optional_proc_effects(top_or_type.rest_slots);
                        body_slots_top: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- body_slots_after_open_brace(after_effects_top);
                        (top_or_type.type_str, first.token.location, parser_ast@empty_effect_name_list(), body_slots_top)
                    };
                    false -> case first.token.kind == lexer_token_kind@token_kind_ref_keyword() or first.token.kind == lexer_token_kind@token_kind_region_keyword() or first.token.kind == lexer_token_kind@token_kind_buf_keyword() of {
                    true -> {
                        tr: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_parametrized_type_from_slots(slots);
                        ret_type: string <- tr.type_str;
                        ret_type_loc: { file: string, line: int64, column: int64, offset: int64 } <- first.token.location;
                        (effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_effects: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_optional_proc_effects(tr.rest_slots);
                        body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- body_slots_after_open_brace(after_effects);
                     
                        use_type: string <- ret_type;
                        ret_empty: string <- case ret_type of { "" -> "ret_empty"; _: string -> "ret_ok" };
                        from_empty: string <- "from_ok";
                        use_type_instrumented: string <- case use_type of { "" -> concat("DEBUG:", concat(ret_empty, concat(",", from_empty))); _: string -> use_type };
                        (use_type_instrumented, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                    };
                    false -> case first.token.kind == lexer_token_kind@token_kind_atomic_keyword() of {
                        true -> case rest.is_nil of {
                            true -> {
                                (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- find_type_and_body(rest);
                                (ret_type, ret_type_loc, effects, body_slots)
                            };
                            false -> case rest.head.token.kind == lexer_token_kind@token_kind_ref_keyword() of {
                                true -> {
                                    tr: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_parametrized_type_from_slots(slots);
                                    ret_type: string <- tr.type_str;
                                    ret_type_loc: { file: string, line: int64, column: int64, offset: int64 } <- first.token.location;
                                    (effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_effects: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_optional_proc_effects(tr.rest_slots);
                                    body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- body_slots_after_open_brace(after_effects);
                                    use_type_instrumented: string <- case ret_type of { "" -> "DEBUG:ref_empty"; _: string -> ret_type };
                                    (use_type_instrumented, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                };
                                false -> {
                                    (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, _effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- find_type_and_body(rest);
                                    (ret_type, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                }
                            }
                        };
                        false -> case first.token.kind == lexer_token_kind@token_kind_atom_literal() of {
