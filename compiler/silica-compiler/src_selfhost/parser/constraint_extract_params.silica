                    false -> case slot.token.kind == lexer_token_kind@token_kind_atom_literal() of {
                        true -> parser_ast@make_expr(5, slot.token.lexeme, "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                        false -> case slot.token.kind == lexer_token_kind@token_kind_true_literal() of {
                            true -> parser_ast@make_expr(7, "true", "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                            false -> case slot.token.kind == lexer_token_kind@token_kind_false_literal() of {
                                true -> parser_ast@make_expr(7, "false", "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                false -> case slot.token.kind == lexer_token_kind@token_kind_string_literal() of {
                                    true -> parser_ast@make_expr(8, slot.token.lexeme, "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                    false -> case slot.token.kind == lexer_token_kind@token_kind_char_literal() of {
                                        true -> parser_ast@make_expr(0, slot.token.lexeme, "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                        false -> parser_ast@make_expr(0, slot.token.lexeme, "", slot.token.location, dummy, dummy, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list())
