                                ret_type_loc_atom: { file: string, line: int64, column: int64, offset: int64 } <- first.token.location;
                                tr_atom: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_atom_option_type_from_slots(slots);
                                rest_after_type_atom: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- tr_atom.rest_slots;
                                (effects_atom: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_effects_atom: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_optional_proc_effects(rest_after_type_atom);
                                body_slots_atom: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- body_slots_after_open_brace(after_effects_atom);
                                (tr_atom.type_str, ret_type_loc_atom, parser_ast@empty_effect_name_list(), body_slots_atom)
                            };
                            false -> case first.token.kind == lexer_token_kind@token_kind_left_paren() of {
                                true -> {
                                    tr: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_tuple_type_from_slots(slots);
                                    ret_type: string <- tr.type_str;
                                    ret_type_loc: { file: string, line: int64, column: int64, offset: int64 } <- first.token.location;
                                    (effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_effects: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_optional_proc_effects(tr.rest_slots);
                                    body_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- body_slots_after_open_brace(after_effects);
                                    (ret_type, ret_type_loc, parser_ast@empty_effect_name_list(), body_slots)
                                };
                                false -> case parser_tuples@slots_start_bracketed_collection_type(slots) of {
                                true -> {
                                    tr_li: { type_str: string, rest_slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] } <- parser_tuples@extract_list_type_from_slots(slots);
                                    ret_type_li: string <- tr_li.type_str;
                                    ret_type_loc_li: { file: string, line: int64, column: int64, offset: int64 } <- first.token.location;
                                    (effects_li: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_effects_li: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_optional_proc_effects(tr_li.rest_slots);
                                    body_slots_li: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- body_slots_after_open_brace(after_effects_li);
                                    (ret_type_li, ret_type_loc_li, parser_ast@empty_effect_name_list(), body_slots_li)
                                };
                                false -> case first.token.kind == lexer_token_kind@token_kind_left_brace() or first.token.lexeme == "{" of {
