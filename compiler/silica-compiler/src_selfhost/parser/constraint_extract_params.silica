                                        body_slots_ir: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- body_slots_after_open_brace(after_effects_ir);
                                        (ret_type_ir, ret_type_loc_ir, parser_ast@empty_effect_name_list(), body_slots_ir)
                                    };
                                    false -> case constraint_extract_slots@is_type_keyword(first.token.kind) of {
                                        true -> {
                                            ret_type_loc: { file: string, line: int64, column: int64, offset: int64 } <- first.token.location;
