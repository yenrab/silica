.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



capability_recursion_implementation_constraints:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    ; unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o1603|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, constraint_core_empty_list_constraint@PAGE
    ADD X9, X9, constraint_core_empty_list_constraint@PAGEOFF
    BR X9


capability_recursion_implementation_initial_roles:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    ; unsupported term kind (dummy k)?
