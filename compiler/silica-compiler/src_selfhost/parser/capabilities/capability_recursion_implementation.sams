    ; use lexer_token_kind, lexer_recursion_phases, constraint_core
.global capability_recursion_implementation_constraints
.global capability_recursion_implementation_initial_roles
.global capability_recursion_implementation_recursion_jsonld_phase1_token_kind
.global capability_recursion_implementation_recursion_jsonld_phase2_token_kind
