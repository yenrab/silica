// Parser AST types - Program, Declaration, Expr
// Shared by parser, type checker, and SIR generator

use lexer_core;

export empty_named_program_list/0;
export cons_named_program/3;
export find_named_program/2;
export zero_location/0;
export dummy_expr/0;
export dummy_decl/0;
