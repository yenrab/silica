// Tuple decomposition pattern element: name and type from the pattern annotation.
// Bindings list: List[{ name: string, path: string, type_str: string }, mem(normal)]

// Wave C Expr index-arena (seed-legal; replaces recursive named struct Expr):
// Node = {
//   kind: int64, value: string, name: string,
//   location: { file: string, line: int64, column: int64, offset: int64 },
//   inner: int64, right_expr: int64,
//   pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)],
//   sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]
// }
// Handle = { nodes: List[<Node>, mem(normal)], root: int64 } with root == -1 for none/dummy.
// kind 0 = integer literal, 1 = identifier, 2 = parenthesized, 3 = binary op, 4 = call, 5 = atom literal, 6 = let binding, 7 = boolean literal, 8 = string literal, 9 = tuple literal, 10 = tuple decomposition, 11 = sequence block, 12 = illegal unary minus (-expr); inner = operand index, -1 = none
// kind 991 = anonymous function / lambda expression; kind 992 = function type text; kind 996/997 = parse error markers; see prior comments.

// Declaration record (inline): { tag, name, parameters, return_type_name, return_type_location, location, body, declared_effects }
// tag 0 = function, 1 = effect alias, 2 = use, 3 = export, 4 = module, 5 = export trait, 6 = impl Type;, 7 = required method, 8 = wrapper_meta, 9 = foreign c_wrapper

// Declarations list: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]

// Program record (inline): { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }

// NamedProgram record (inline): { module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }
// NamedProgram list: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]

fn zero_location() -> { file: string, line: int64, column: int64, offset: int64 } {
    sequence
        result: { file: string, line: int64, column: int64, offset: int64 } <- { file: "", line: 0, column: 0, offset: 0 }
    produces
        pure result
    end
}

fn nil_tuple_decompose_bindings() -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, path: string, type_str: string }, mem(normal)] <- empty[{ name: string, path: string, type_str: string }, mem(normal)]()
    produces
        pure result
    end
}

fn cons_tuple_decompose_binding(b: { name: string, path: string, type_str: string }, rest: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, path: string, type_str: string }, mem(normal)] <- prepend[{ name: string, path: string, type_str: string }, mem(normal)](b, rest)
    produces
        pure result
    end
}

fn make_tuple_decompose_binding(name: string, path: string, type_str: string) -> { name: string, path: string, type_str: string } {
    sequence
        result: { name: string, path: string, type_str: string } <- { name: name, path: path, type_str: type_str }
    produces
        pure result
    end
}

fn as_list_tuple_decompose_bindings(b: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    b
}

fn empty_expr_nodes() -> List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- empty[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]()
    produces
        pure result
    end
}

fn dummy_expr() -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    sequence
        nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- empty_expr_nodes();
        result: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- { nodes: nodes, root: -1 }
    produces
        pure result
    end
}

fn nil_list_param() -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- empty[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]()
    produces
        pure result
    end
}

fn cons_param(p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, rest: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- prepend[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)](p, rest)
    produces
        pure result
    end
}

fn list_param_reverse_with_acc(front: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], acc: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case front.is_nil of {
        true -> acc;
        false -> List[ {
            stepped: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- cons_param(front.head, acc);
            list_param_reverse_with_acc(front.tail, stepped)
        }
    }
}

fn build_infer_type_bucket(inferred: string, rest: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    cons_param({ name: "_", type_name: inferred, location: zero_location() }, rest)
}

fn param_list_normalize(p: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case p.is_nil of {
        true -> nil_list_param();
        false -> List[ {
            hd: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- p.head;
            tail_norm: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- param_list_normalize(p.tail);
            cons_param(hd, tail_norm)
        }
    }
}

// Nominal rebuild helpers for AST copies produced outside this module (bootstrap assigns structural record types there).
fn rebuild_param(name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } {
    sequence
        result: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: name, type_name: type_name, location: location }
    produces
        pure result
    end
}

fn rebuild_param_list(src: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case src.is_nil of {
        true -> nil_list_param();
        false -> cons_param(rebuild_param(src.head.name, src.head.type_name, src.head.location), rebuild_param_list(src.tail))
    }
}

fn rebuild_effect_name(name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } {
    sequence
        result: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: name, parameter: parameter, location: location }
    produces
        pure result
    end
}

fn rebuild_tuple_decompose_binding_list(src: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case src.is_nil of {
        true -> nil_tuple_decompose_bindings();
        false -> cons_tuple_decompose_binding(make_tuple_decompose_binding(src.head.name, src.head.path, src.head.type_str), rebuild_tuple_decompose_binding_list(src.tail))
    }
}

fn rebuild_param_list_from_lambda_bindings(bindings: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case bindings.is_nil of {
        true -> nil_list_param();
        false -> cons_param(rebuild_param(bindings.head.name, bindings.head.type_str, zero_location()), rebuild_param_list_from_lambda_bindings(bindings.tail))
    }
}

fn append_param_list(a: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], b: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> cons_param(a.head, append_param_list(a.tail, b))
    }
}

fn dummy_decl() -> { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } {
    sequence
        result: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- { tag: -1, name: "", parameters: nil_list_param(), return_type_name: "", return_type_location: zero_location(), location: zero_location(), body: dummy_expr(), declared_effects: empty_effect_name_list() }
    produces
        pure result
    end
}

fn empty_list_decl() -> List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- empty[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]()
    produces
        pure result
    end
}

fn cons_declaration(head_decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, tail: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, locati