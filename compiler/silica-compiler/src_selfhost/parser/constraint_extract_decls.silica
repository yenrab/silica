// Top-level declarations (use/export/module/FFI/trait) and slots_to_program.

use lexer_core;
use lexer_token_kind;
use constraint_core;
use parser_ast;
use parser_tuples;
use constraint_extract_slots;
use constraint_extract_params;
use constraint_extract_expr;

export find_malformed_ffi_surface/1;
export append_decl_lists/2;
export slots_to_program/1;
export append_declaration_lists/2;



fn is_use_decl_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == lexer_token_kind@token_kind_use_keyword()
    }
}



fn is_export_decl_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == lexer_token_kind@token_kind_export_keyword()
    }
}



fn is_module_decl_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == lexer_token_kind@token_kind_module_keyword()
    }
}



// use a, b, c; — module names in { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }.name (spec §3.4.4, §19.3).
fn collect_use_module_params(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@nil_list_param(), trimmed);
        false -> case lexer_token_kind@is_identifier_lexeme_token(trimmed.head.token.kind) of {
            false -> (parser_ast@nil_list_param(), trimmed);
            true -> {
                id_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- trimmed.head;
                after_id: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- trimmed.tail;
                p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: id_slot.token.lexeme, type_name: "", location: id_slot.token.location };
                after_ws: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_id);
                case after_ws.is_nil of {
                    true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), after_ws);
                    false -> case after_ws.head.token.kind == lexer_token_kind@token_kind_semicolon() of {
                        true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), after_ws.tail);
                        false -> case after_ws.head.token.kind == lexer_token_kind@token_kind_comma() of {
                            true -> {
                                (rest_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], final_rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_use_module_params(after_ws.tail);
                                (parser_ast@cons_param(p, rest_params), final_rest)
                            };
                            false -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), after_ws)
                        }
                    }
                }
            }
        }
    }
}



fn extract_use_declaration(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence
        result: ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- case slots.is_nil of {
            true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_use_keyword() of {
                false -> (parser_ast@dummy_decl(), slots);
                true -> {
                    use_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
                    after_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                    (params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_use: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_use_module_params(after_kw);
                    dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                    zero_loc: { file: string, line: int64, column: int64, offset: int64 } <- parser_ast@zero_location();
                    decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- { tag: 2, name: "", parameters: params, return_type_name: "", return_type_location: zero_loc, location: use_loc, body: dummy, declared_effects: parser_ast@empty_effect_name_list() };
                    (decl, after_use)
                }
            }
        }
    produces
        pure result
    end
}



// export f/1, g/2; — { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }.name = function, { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }.type_name = arity lexeme (spec §19.2).
fn collect_export_decl_parameters(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) proc[DeviceIO] {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@nil_list_param(), trimmed);
        false -> case lexer_token_kind@is_identifier_lexeme_token(trimmed.head.token.kind) of {
            false -> (parser_ast@nil_list_param(), trimmed);
            true -> {
                fn_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- trimmed.head;
                after_fn: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- trimmed.tail;
                (bracket_suffix: string, after_brackets: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@extract_optional_bracket_suffix_after_name(after_fn);
                fn_full: string <- concat(fn_slot.token.lexeme, bracket_suffix);
                ws1: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_brackets);
                case ws1.is_nil of {
                    true -> (parser_ast@nil_list_param(), ws1);
                    false -> case ws1.head.token.kind == lexer_token_kind@token_kind_slash() of {
                        false -> (parser_ast@nil_list_param(), ws1);
                        true -> {
                            after_slash: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- ws1.tail;
                            ws2: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_slash);
                            case ws2.is_nil of {
                                true -> (parser_ast@nil_list_param(), ws2);
                                false -> case ws2.head.token.kind == lexer_token_kind@token_kind_integer_literal() of {
                                    false -> (parser_ast@nil_list_param(), ws2);
                                    true -> {
                                        ar_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- ws2.head;
                                        p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: fn_full, type_name: ar_slot.token.lexeme, location: fn_slot.token.location };
                                        after_ar: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- ws2.tail;
                                        ws3: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_ar);
                                        case ws3.is_nil of {
                                            true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), ws3);
                                            false -> case ws3.head.token.kind == lexer_token_kind@token_kind_semicolon() of {
                                                true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), ws3.tail);
                                                false -> case ws3.head.token.kind == lexer_token_kind@token_kind_comma() of {
                                                    true -> {
                                                        (rest_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], final_rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_export_decl_parameters(ws3.tail);
                                                        (parser_ast@cons_param(p, rest_params), final_rest)
                                                    };
                                                    false -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), ws3)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



fn extract_export_declaration(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence
        result: ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- case slots.is_nil of {
            true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
            false -> case slots.head.token.kind == lexer_token_kind@token_kind_export_keyword() of {
                false -> (parser_ast@dummy_decl(), slots);
                true -> {
                    exp_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
                    after_export_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                    case after_export_kw.is_nil of {
                        true -> (parser_ast@dummy_decl(), after_export_kw);
                        false -> case after_export_kw.head.token.kind == lexer_token_kind@token_kind_trait_keyword() of {
                            true -> {
                                after_trait: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_export_kw.tail);
                                case after_trait.is_nil of {
                                    true -> (parser_ast@dummy_decl(), after_trait);
                                    false -> case lexer_token_kind@is_identifier_lexeme_token(after_trait.head.token.kind) of {
                                        false -> (parser_ast@dummy_decl(), after_trait);
                                        true -> {
                                            trait_name: string <- after_trait.head.token.lexeme;
                                            after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_trait.tail);
                                            case after_name.is_nil of {
                                                true -> (parser_ast@dummy_decl(), after_name);
                                                false -> case after_name.head.token.kind == lexer_token_kind@token_kind_semicolon() of {
                                                    false -> (parser_ast@dummy_decl(), after_name);
                                                    true -> {
                                                        dummy_tr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                                        zero_loc_tr: { file: string, line: int64, column: int64, offset: int64 } <- parser_ast@zero_location();
                                                        decl_tr: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- { tag: 5, name: trait_name, parameters: parser_ast@nil_list_param(), return_type_name: "", return_type_location: zero_loc_tr, location: exp_loc, body: dummy_tr, declared_effects: parser_ast@empty_effect_name_list() };
                                                        (decl_tr, after_name.tail)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            };
                            false -> {
                                (params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_exp: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_export_decl_parameters(slots.tail);
                                dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                zero_loc: { file: string, line: int64, column: int64, offset: int64 } <- parser_ast@zero_location();
                                decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- { tag: 3, name: "", parameters: params, return_type_name: "", return_type_location: zero_loc, location: exp_loc, body: dummy, declared_effects: parser_ast@empty_effect_name_list() };
                                (decl, after_exp)
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}



