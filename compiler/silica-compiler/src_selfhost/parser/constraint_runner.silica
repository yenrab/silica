// Constraint runner - parse_program, all_constraints, orchestration

use lexer_core;
use lexer_token_kind;
use lexer_runner;
use constraint_core;
use constraint_extract;
use parser_core;
use parser_ast;
use capability_fn_decl;
use capability_expr_literal;
use capability_expr_atom;
use capability_expr_int64_ops;
use capability_expr_float32;
use capability_effect_decl;
use capability_module;
use capability_trait;
use capability_bind;
use capability_tuple_decompose;
use capability_memory_region;
use capability_sequence;
use capability_expr_negate_builtin;
use capability_case;
use capability_list;
use capability_recursion_implementation;
use capability_supervisor_phases;
use capability_actors;
use capability_foreign;

export parse_program/1;

fn all_constraints() -> ListConstraint {
    base: ListConstraint <- capability_fn_decl@constraints();
    with_expr: ListConstraint <- append_constraints(base, capability_expr_literal@constraints());
    with_atom: ListConstraint <- append_constraints(with_expr, capability_expr_atom@constraints());
    with_ops: ListConstraint <- append_constraints(with_atom, capability_expr_int64_ops@constraints());
    with_float32: ListConstraint <- append_constraints(with_ops, capability_expr_float32@constraints());
    with_effect_decl: ListConstraint <- append_constraints(with_float32, capability_effect_decl@constraints());
    with_module: ListConstraint <- append_constraints(with_effect_decl, capability_module@constraints());
    with_foreign: ListConstraint <- append_constraints(with_module, capability_foreign@constraints());
    with_trait: ListConstraint <- append_constraints(with_foreign, capability_trait@constraints());
    with_bind: ListConstraint <- append_constraints(with_trait, capability_bind@constraints());
    with_td: ListConstraint <- append_constraints(with_bind, capability_tuple_decompose@constraints());
    with_mem: ListConstraint <- append_constraints(with_td, capability_memory_region@constraints());
    with_seq: ListConstraint <- append_constraints(with_mem, capability_sequence@constraints());
    with_neg: ListConstraint <- append_constraints(with_seq, capability_expr_negate_builtin@constraints());
    with_case: ListConstraint <- append_constraints(with_neg, capability_case@constraints());
    with_list: ListConstraint <- append_constraints(with_case, capability_list@constraints());
    with_recursion_jsonld: ListConstraint <- append_constraints(with_list, capability_recursion_implementation@constraints());
    with_supervisor_phases: ListConstraint <- append_constraints(with_recursion_jsonld, capability_supervisor_phases@constraints());
    with_actors: ListConstraint <- append_constraints(with_supervisor_phases, capability_actors@constraints());
    with_actors
}

fn append_constraints(a: ListConstraint, b: ListConstraint) -> ListConstraint {
    constraint_core@append_list_constraint(a, b)
}

fn merge_roles(a: ListInt, b: ListInt) -> ListInt {
    case a.is_nil of {
        true -> b;
        false -> constraint_core@cons_int(a.head, merge_roles(a.tail, b))
    }
}

fn initial_roles_for_token(token_kind: int64) -> ListInt {
    sequence
        fd: ListInt <- capability_fn_decl@initial_roles(token_kind);
        el: ListInt <- capability_expr_literal@initial_roles(token_kind);
        atom_r: ListInt <- capability_expr_atom@initial_roles(token_kind);
        ops: ListInt <- capability_expr_int64_ops@initial_roles(token_kind);
        f32_ops: ListInt <- capability_expr_float32@initial_roles(token_kind);
        eff_decl: ListInt <- capability_effect_decl@initial_roles(token_kind);
        mod_r: ListInt <- capability_module@initial_roles(token_kind);
        foreign_r: ListInt <- capability_foreign@initial_roles(token_kind);
        trait_r: ListInt <- capability_trait@initial_roles(token_kind);
        bind: ListInt <- capability_bind@initial_roles(token_kind);
        td: ListInt <- capability_tuple_decompose@initial_roles(token_kind);
        mem_region: ListInt <- capability_memory_region@initial_roles(token_kind);
        seq: ListInt <- capability_sequence@initial_roles(token_kind);
        neg: ListInt <- capability_expr_negate_builtin@initial_roles(token_kind);
        case_r: ListInt <- capability_case@initial_roles(token_kind);
        list_r: ListInt <- capability_list@initial_roles(token_kind);
        rec_jsonld: ListInt <- capability_recursion_implementation@initial_roles(token_kind);
        sup_jsonld: ListInt <- capability_supervisor_phases@initial_roles(token_kind);
        actors_r: ListInt <- capability_actors@initial_roles(token_kind);
        m14: ListInt <- merge_roles(rec_jsonld, merge_roles(sup_jsonld, actors_r));
        m13: ListInt <- merge_roles(list_r, m14);
        m12: ListInt <- merge_roles(case_r, m13);
        m11: ListInt <- merge_roles(neg, m12);
        m10: ListInt <- merge_roles(seq, m11);
        m9: ListInt <- merge_roles(mem_region, m10);
        m8: ListInt <- merge_roles(td, m9);
        m7b: ListInt <- merge_roles(trait_r, m8);
        m7: ListInt <- merge_roles(bind, m7b);
        m6: ListInt <- merge_roles(foreign_r, merge_roles(mod_r, m7));
        m5: ListInt <- merge_roles(eff_decl, m6);
        m4: ListInt <- merge_roles(f32_ops, m5);
        m3: ListInt <- merge_roles(ops, m4);
        m2: ListInt <- merge_roles(atom_r, m3);
        m1: ListInt <- merge_roles(el, m2);
        result: ListInt <- merge_roles(fd, m1)
    produces
        pure result
    end
}

fn reverse_tokens(acc: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], list: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case list.is_nil of {
        true -> acc;
        false -> reverse_tokens(lexer_runner@cons_token(list.head, acc), list.tail)
    }
}

fn tokens_to_slots(tokens: ListToken) -> ListTokenSlot {
    case tokens.is_nil of {
        true -> constraint_core@empty_list_slot();
        false -> {
            roles: ListInt <- initial_roles_for_token(tokens.head.kind);
            slot: TokenSlot <- constraint_core@make_token_slot(tokens.head, roles);
            rest: ListTokenSlot <- tokens_to_slots(tokens.tail);
            constraint_core@cons_slot(slot, rest)
        }
    }
}

fn is_type_keyword(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.int8_keyword or token_kind == kinds.int16_keyword or token_kind == kinds.int32_keyword or token_kind == kinds.int64_keyword or token_kind == kinds.uint8_keyword or token_kind == kinds.uint16_keyword or token_kind == kinds.uint32_keyword or token_kind == kinds.uint64_keyword or token_kind == kinds.float16_keyword or token_kind == kinds.float32_keyword or token_kind == kinds.float64_keyword or token_kind == kinds.bool_keyword or token_kind == kinds.char_keyword or token_kind == kinds.string_keyword or token_kind == kinds.bytes_keyword or token_kind == kinds.unit_keyword or token_kind == kinds.atom_keyword or token_kind == kinds.ref_keyword or token_kind == kinds.region_keyword or token_kind == kinds.buf_keyword or token_kind == kinds.atomic_keyword or token_kind == kinds.normal_keyword or token_kind == kinds.normal_writeback_keyword or token_kind == kinds.normal_writethrough_keyword or token_kind == kinds.normal_noncacheable_keyword or token_kind == kinds.device_keyword or token_kind == kinds.list_keyword or token_kind == kinds.actor_ref_keyword or token_kind == kinds.dangerous_actor_ref_keyword or token_kind == kinds.supervisor_ref_keyword or token_kind == kinds.failure_reason_keyword
}

// Detect proc after return type: -> type_name proc[...] is invalid (spec §9.3.1)
fn has_proc_after_return_type(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slots.tail.is_nil of {
            true -> (false, parser_ast@zero_location());
            false -> case slots.tail.tail.is_nil of {
                true -> (false, parser_ast@zero_location());
                false -> case slots.head.token.kind == kinds.right_arrow of {
                    true -> case is_type_keyword(kinds, slots.tail.head.token.kind) of {
                        true -> case slots.tail.tail.head.token.kind == kinds.proc_keyword of {
                            true -> (true, slots.tail.tail.head.token.location);
                            false -> has_proc_after_return_type(slots.tail)
                        };
                        false -> has_proc_after_return_type(slots.tail)
                    };
                    false -> has_proc_after_return_type(slots.tail)
                }
            }
        }
    }
}

fn skip_function_parameter_list(slots: ListTokenSlot, depth: int64) -> ListTokenSlot {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == kinds.left_paren of {
            true -> skip_function_parameter_list(slots.tail, depth + 1);
            false -> case slots.head.token.kind == kinds.right_paren of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> skip_function_parameter_list(slots.tail, depth - 1)
                };
                false -> skip_function_parameter_list(slots.tail, depth)
            }
        }
    }
}

fn skip_optional_bracket_suffix_slots(slots: ListTokenSlot, depth: int64) -> ListTokenSlot {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == kinds.left_bracket of {
            true -> skip_optional_bracket_suffix_slots(slots.tail, depth + 1);
            false -> case slots.head.token.kind == kinds.right_bracket of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> skip_optional_bracket_suffix_slots(slots.tail, depth - 1)
                };
                false -> skip_optional_bracket_suffix_slots(slots.tail, depth)
            }
        }
    }
}

fn scan_function_after_params_for_return_arrow(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slots.head.token.kind == kinds.right_arrow of {
            true -> (false, parser_ast@zero_location());
            false -> case slots.head.token.kind == kinds.left_brace of {
                true -> (true, slots.head.token.location);
                false -> case slots.head.token.kind == kinds.semicolon of {
                    true -> (true, slots.head.token.location);
                    false -> scan_function_after_params_for_return_arrow(slots.tail)
                }
            }
        }
    }
}

fn has_missing_function_return_type(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.head.token.kind == kinds.fn_keyword of {
            true -> case slots.tail.is_nil of {
                true -> (false, parser_ast@zero_location(), "");
                false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slots.tail.head.token.kind) of {
                    false -> has_missing_function_return_type(slots.tail);
                    true -> {
                        fn_name: string <- slots.tail.head.token.lexeme;
                        after_name: ListTokenSlot <- slots.tail.tail;
                        after_brackets: ListTokenSlot <- case after_name.is_nil of {
                            true -> after_name;
                            false -> case after_name.head.token.kind == kinds.left_bracket of {
                                true -> skip_optional_bracket_suffix_slots(after_name.tail, 1);
                                false -> after_name
                            }
                        };
                        scan_from: ListTokenSlot <- case after_brackets.is_nil of {
                            true -> after_brackets;
                            false -> case after_brackets.head.token.kind == kinds.left_paren of {
                                true -> skip_function_parameter_list(after_brackets, 0);
                                false -> after_brackets
                            }
                        };
                        (missing: bool, loc: { file: string, line: int64, column: int64, offset: int64 }) <- scan_function_after_params_for_return_arrow(scan_from);
                        case missing of {
                            true -> (true, loc, fn_name);
                            false -> has_missing_function_return_type(slots.tail)
                        }
                    }
                }
            };
            false -> has_missing_function_return_type(slots.tail)
        }
    }
}

fn token_end_offset(token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> int64 {
    token.location.offset + len(token.lexeme)
}

fn is_adjacent_token_pair(left: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, right: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> bool {
    token_end_offset(left) == right.location.offset
}

fn token_starts_with_colon(token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> bool {
    case token.lexeme == ":" of {
        true -> true;
        false -> case len(token.lexeme) > 0 of {
            true -> substring(token.lexeme, 0, 1) == ":";
            false -> false
        }
    }
}

fn has_bind_arrow_before_statement_boundary(slots: ListTokenSlot, paren_depth: int64, brace_depth: int64) -> bool {
    case slots.is_nil of {
        true -> false;
        false -> case slots.head.token.lexeme == "<-" of {
            true -> case paren_depth == 0 and brace_depth == 0 of {
                true -> true;
                false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth)
            };
            false -> case slots.head.token.lexeme == ";" or slots.head.token.lexeme == "if" or slots.head.token.lexeme == "->" of {
                true -> case paren_depth == 0 and brace_depth == 0 of {
                    true -> false;
                    false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth)
                };
                false -> case slots.head.token.lexeme == "(" of {
                    true -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth + 1, brace_depth);
                    false -> case slots.head.token.lexeme == ")" of {
                        true -> case paren_depth <= 0 of {
                            true -> false;
                            false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth - 1, brace_depth)
                        };
                        false -> case slots.head.token.lexeme == "{" of {
                            true -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth + 1);
                            false -> case slots.head.token.lexeme == "}" of {
                                true -> case brace_depth <= 0 of {
                                    true -> false;
                                    false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth - 1)
                                };
                                false -> has_bind_arrow_before_statement_boundary(slots.tail, paren_depth, brace_depth)
                            }
                        }
                    }
                }
            }
        }
    }
}

fn has_spaced_bind_colon(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.tail.is_nil of {
            true -> (false, parser_ast@zero_location(), "");
            false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, slots.head.token.kind) and token_starts_with_colon(slots.tail.head.token) and has_bind_arrow_before_statement_boundary(slots.tail.tail, 0, 0) of {
                true -> case is_adjacent_token_pair(slots.head.token, slots.tail.head.token) of {
                    true -> has_spaced_bind_colon(slots.tail);
                    false -> (true, slots.tail.head.token.location, slots.head.token.lexeme)
                };
                false -> has_spaced_bind_colon(slots.tail)
            }
        }
    }
}

// `meta` / `wrapper_meta` are FFI keywords; using them as `name: type <-` bindings is rejected early
// so the parser does not fall through to a misleading E1040 terminator error.
fn is_reserved_binding_name_keyword(kinds: TokenKinds, token_kind: int64, lexeme: string) -> bool {
    token_kind == kinds.meta_keyword or lexeme == "meta" or token_kind == kinds.wrapper_meta_keyword or lexeme == "wrapper_meta"
}

fn has_reserved_keyword_binding(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> {
            after_name: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
            case is_reserved_binding_name_keyword(kinds, slots.head.token.kind, slots.head.token.lexeme) and after_name.is_nil == false and token_starts_with_colon(after_name.head.token) and has_bind_arrow_before_statement_boundary(after_name.tail, 0, 0) of {
                true -> (true, slots.head.token.location, slots.head.token.lexeme);
                false -> has_reserved_keyword_binding(slots.tail)
            }
        }
    }
}

// Trait-section keywords `required` / `provided` cannot be record field names / `.field` suffixes.
// Reject early so `{ required: … }` does not fall through to a misleading E1040 terminator error.
fn is_reserved_record_field_name_keyword(kinds: TokenKinds, token_kind: int64, lexeme: string) -> bool {
    token_kind == kinds.required_keyword or lexeme == "required" or token_kind == kinds.provided_keyword or lexeme == "provided"
}

fn has_reserved_keyword_record_field_after_dot(slots: ListTokenSlot, brace_depth: int64) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> has_reserved_keyword_record_field_walk(slots, brace_depth);
        false -> case is_reserved_record_field_name_keyword(kinds, trimmed.head.token.kind, trimmed.head.token.lexeme) of {
            true -> (true, trimmed.head.token.location, trimmed.head.token.lexeme);
            false -> has_reserved_keyword_record_field_walk(trimmed, brace_depth)
        }
    }
}

fn has_reserved_keyword_record_field_after_opener(slots: ListTokenSlot, brace_depth: int64) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> has_reserved_keyword_record_field_walk(slots, brace_depth);
        false -> case is_reserved_record_field_name_keyword(kinds, trimmed.head.token.kind, trimmed.head.token.lexeme) of {
            true -> {
                after_name: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                case after_name.is_nil of {
                    true -> has_reserved_keyword_record_field_walk(trimmed.tail, brace_depth);
                    false -> case token_starts_with_colon(after_name.head.token) of {
                        true -> (true, trimmed.head.token.location, trimmed.head.token.lexeme);
                        false -> has_reserved_keyword_record_field_walk(trimmed, brace_depth)
                    }
                }
            };
            false -> has_reserved_keyword_record_field_walk(trimmed, brace_depth)
        }
    }
}

fn has_reserved_keyword_record_field_walk(slots: ListTokenSlot, brace_depth: int64) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
            true -> has_reserved_keyword_record_field_after_opener(slots.tail, brace_depth + 1);
            false -> case slots.head.token.kind == kinds.right_brace or slots.head.token.lexeme == "}" of {
                true -> case brace_depth > 0 of {
                    true -> has_reserved_keyword_record_field_walk(slots.tail, brace_depth - 1);
                    false -> has_reserved_keyword_record_field_walk(slots.tail, 0)
                };
                false -> case (slots.head.token.kind == kinds.comma or slots.head.token.lexeme == ",") and brace_depth > 0 of {
                    true -> has_reserved_keyword_record_field_after_opener(slots.tail, brace_depth);
                    false -> case slots.head.token.kind == kinds.dot or slots.head.token.lexeme == "." of {
                        true -> has_reserved_keyword_record_field_after_dot(slots.tail, brace_depth);
                        false -> has_reserved_keyword_record_field_walk(slots.tail, brace_depth)
                    }
                }
            }
        }
    }
}

fn has_reserved_keyword_record_field(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    has_reserved_keyword_record_field_walk(slots, 0)
}

// Unbalanced `{` / `}` falls through to a misleading E1040 terminator error; reject early.
fn has_unbalanced_braces_walk(slots: ListTokenSlot, brace_depth: int64, open_loc: { file: string, line: int64, column: int64, offset: int64 }) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> case brace_depth > 0 of {
            true -> (true, open_loc, "unclosed '{'; expected a matching '}' before end of file");
            false -> (false, parser_ast@zero_location(), "")
        };
        false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
            true -> has_unbalanced_braces_walk(slots.tail, brace_depth + 1, slots.head.token.location);
            false -> case slots.head.token.kind == kinds.right_brace or slots.head.token.lexeme == "}" of {
                true -> case brace_depth > 0 of {
                    true -> has_unbalanced_braces_walk(slots.tail, brace_depth - 1, open_loc);
                    false -> (true, slots.head.token.location, "unexpected '}'; no matching '{' is open")
                };
                false -> has_unbalanced_braces_walk(slots.tail, brace_depth, open_loc)
            }
        }
    }
}

fn has_unbalanced_braces(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    has_unbalanced_braces_walk(slots, 0, parser_ast@zero_location())
}

fn prev_allows_atom_literal(slots_before_colon_reversed: ListTokenSlot) -> bool {
    case slots_before_colon_reversed.is_nil of {
        true -> true;
        false -> case slots_before_colon_reversed.head.token.lexeme == "<-" or slots_before_colon_reversed.head.token.lexeme == "->" or slots_before_colon_reversed.head.token.lexeme == "{" or slots_before_colon_reversed.head.token.lexeme == "(" or slots_before_colon_reversed.head.token.lexeme == "," or slots_before_colon_reversed.head.token.lexeme == ";" or slots_before_colon_reversed.head.token.lexeme == "==" or slots_before_colon_reversed.head.token.lexeme == "!=" of {
            true -> true;
            false -> false
        }
    }
}

fn has_spaced_atom_literal_from(slots: ListTokenSlot, reversed_prefix: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slots.tail.is_nil of {
            true -> (false, parser_ast@zero_location());
            false -> case slots.head.token.lexeme == ":" and lexer_token_kind@is_identifier_lexeme_token(kinds, slots.tail.head.token.kind) and prev_allows_atom_literal(reversed_prefix) of {
                true -> case is_adjacent_token_pair(slots.head.token, slots.tail.head.token) of {
                    true -> has_spaced_atom_literal_from(slots.tail, constraint_core@cons_slot(slots.head, reversed_prefix));
                    false -> (true, slots.tail.head.token.location)
                };
                false -> has_spaced_atom_literal_from(slots.tail, constraint_core@cons_slot(slots.head, reversed_prefix))
            }
        }
    }
}

fn has_spaced_atom_literal(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    has_spaced_atom_literal_from(slots, constraint_core@empty_list_slot())
}

fn slot_is_whitespace(slot: TokenSlot) -> bool {
    slot.token.lexeme == " " or slot.token.lexeme == "\t" or slot.token.lexeme == "\n" or slot.token.lexeme == "\r"
}

fn slot_is_horizontal_whitespace(slot: TokenSlot) -> bool {
    slot.token.lexeme == " " or slot.token.lexeme == "\t" or slot.token.lexeme == "\r"
}

fn skip_leading_whitespace_slots(slots: ListTokenSlot) -> ListTokenSlot {
    case slots.is_nil of {
        true -> slots;
        false -> case slot_is_whitespace(slots.head) of {
            true -> skip_leading_whitespace_slots(slots.tail);
            false -> slots
        }
    }
}

fn skip_leading_horizontal_whitespace_slots(slots: ListTokenSlot) -> ListTokenSlot {
    case slots.is_nil of {
        true -> slots;
        false -> case slot_is_horizontal_whitespace(slots.head) of {
            true -> skip_leading_horizontal_whitespace_slots(slots.tail);
            false -> slots
        }
    }
}

fn is_record_field_name_token(kinds: TokenKinds, tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> bool {
    lexer_token_kind@is_identifier_lexeme_token(kinds, tok.kind) or tok.kind == kinds.buf_keyword or tok.kind == kinds.ref_keyword or tok.kind == kinds.region_keyword or tok.kind == kinds.atomic_keyword or tok.kind == kinds.end_keyword
}

fn brace_group_starts_record_like(slots_after_lbrace: ListTokenSlot, kinds: TokenKinds) -> bool {
    first: ListTokenSlot <- skip_leading_whitespace_slots(slots_after_lbrace);
    case first.is_nil of {
        true -> false;
        false -> case is_record_field_name_token(kinds, first.head.token) of {
            true -> {
                after_name: ListTokenSlot <- skip_leading_whitespace_slots(first.tail);
                case after_name.is_nil of {
                    true -> false;
                    false -> after_name.head.token.kind == kinds.colon
                }
            };
            false -> false
        }
    }
}

fn token_is_invalid_after_record_last_item(kinds: TokenKinds, tok: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> bool {
    tok.kind == kinds.semicolon or tok.lexeme == ";" or tok.kind == kinds.colon or tok.lexeme == ":" or tok.kind == kinds.plus or tok.lexeme == "+" or tok.kind == kinds.minus or tok.lexeme == "-" or tok.kind == kinds.star or tok.lexeme == "*" or tok.kind == kinds.slash or tok.lexeme == "/" or tok.kind == kinds.percent or tok.lexeme == "%" or tok.kind == kinds.equal or tok.lexeme == "=" or tok.kind == kinds.less_than or tok.lexeme == "<" or tok.kind == kinds.greater_than or tok.lexeme == ">" or tok.kind == kinds.dot or tok.lexeme == "." or tok.kind == kinds.at_sign or tok.lexeme == "@" or tok.kind == kinds.left_paren or tok.lexeme == "(" or tok.kind == kinds.right_paren or tok.lexeme == ")" or tok.kind == kinds.left_bracket or tok.lexeme == "[" or tok.kind == kinds.right_bracket or tok.lexeme == "]" or tok.kind == kinds.unknown_char
}

fn record_like_group_has_invalid_last_item_follower(slots: ListTokenSlot, brace_depth: int64, paren_depth: int64, bracket_depth: int64, kinds: TokenKinds, has_top_level_bind_arrow: bool) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
            true -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth + 1, paren_depth, bracket_depth, kinds, has_top_level_bind_arrow);
            false -> case slots.head.token.kind == kinds.right_brace or slots.head.token.lexeme == "}" of {
                true -> case brace_depth <= 1 of {
                    true -> (false, parser_ast@zero_location(), "");
                    false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth - 1, paren_depth, bracket_depth, kinds, has_top_level_bind_arrow)
                };
                false -> case slots.head.token.kind == kinds.left_paren or slots.head.token.lexeme == "(" of {
                    true -> {
                        after_bad_lp: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                        case brace_depth == 1 and paren_depth == 0 and bracket_depth == 0 and after_bad_lp.is_nil == false and (after_bad_lp.head.token.kind == kinds.right_brace or after_bad_lp.head.token.lexeme == "}") and has_top_level_bind_arrow == false of {
                            true -> (true, slots.head.token.location, slots.head.token.lexeme);
                            false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth + 1, bracket_depth, kinds, has_top_level_bind_arrow)
                        }
                    };
                    false -> case slots.head.token.kind == kinds.right_paren or slots.head.token.lexeme == ")" of {
                        true -> case paren_depth > 0 of {
                            true -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth - 1, bracket_depth, kinds, has_top_level_bind_arrow);
                            false -> {
                                after_bad_rp: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                                case brace_depth == 1 and bracket_depth == 0 and after_bad_rp.is_nil == false and (after_bad_rp.head.token.kind == kinds.right_brace or after_bad_rp.head.token.lexeme == "}") and has_top_level_bind_arrow == false of {
                                    true -> (true, slots.head.token.location, slots.head.token.lexeme);
                                    false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, kinds, has_top_level_bind_arrow)
                                }
                            }
                        };
                        false -> case slots.head.token.kind == kinds.left_bracket or slots.head.token.lexeme == "[" of {
                            true -> {
                                after_bad_lb: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                                case brace_depth == 1 and paren_depth == 0 and bracket_depth == 0 and after_bad_lb.is_nil == false and (after_bad_lb.head.token.kind == kinds.right_brace or after_bad_lb.head.token.lexeme == "}") and has_top_level_bind_arrow == false of {
                                    true -> (true, slots.head.token.location, slots.head.token.lexeme);
                                    false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth + 1, kinds, has_top_level_bind_arrow)
                                }
                            };
                            false -> case slots.head.token.kind == kinds.right_bracket or slots.head.token.lexeme == "]" of {
                                true -> case bracket_depth > 0 of {
                                    true -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth - 1, kinds, has_top_level_bind_arrow);
                                    false -> {
                                        after_bad_rb: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                                        case brace_depth == 1 and paren_depth == 0 and after_bad_rb.is_nil == false and (after_bad_rb.head.token.kind == kinds.right_brace or after_bad_rb.head.token.lexeme == "}") and has_top_level_bind_arrow == false of {
                                            true -> (true, slots.head.token.location, slots.head.token.lexeme);
                                            false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, kinds, has_top_level_bind_arrow)
                                        }
                                    }
                                };
                                false -> case brace_depth == 1 and paren_depth == 0 and bracket_depth == 0 and slots.head.token.kind == kinds.left_arrow of {
                                    true -> {
                                        record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, kinds, true)
                                    };
                                    false -> case brace_depth == 1 and paren_depth == 0 and bracket_depth == 0 and token_is_invalid_after_record_last_item(kinds, slots.head.token) of {
                                        true -> {
                                            after_bad: ListTokenSlot <- skip_leading_whitespace_slots(slots.tail);
                                            case after_bad.is_nil of {
                                                true -> (false, parser_ast@zero_location(), "");
                                                false -> case after_bad.head.token.kind == kinds.right_brace or after_bad.head.token.lexeme == "}" of {
                                                    true -> case has_top_level_bind_arrow == false of {
                                                        true -> (true, slots.head.token.location, slots.head.token.lexeme);
                                                        false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, kinds, has_top_level_bind_arrow)
                                                    };
                                                    false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, kinds, has_top_level_bind_arrow)
                                                }
                                            }
                                        };
                                        false -> record_like_group_has_invalid_last_item_follower(slots.tail, brace_depth, paren_depth, bracket_depth, kinds, has_top_level_bind_arrow)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn has_struct_record_invalid_last_item_follower(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slots.head.token.kind == kinds.left_brace or slots.head.token.lexeme == "{" of {
            true -> case brace_group_starts_record_like(slots.tail, kinds) of {
                true -> {
                    (found: bool, loc: { file: string, line: int64, column: int64, offset: int64 }, bad_token: string) <- record_like_group_has_invalid_last_item_follower(slots.tail, 1, 0, 0, kinds, false);
                    case found of {
                        true -> (true, loc, bad_token);
                        false -> has_struct_record_invalid_last_item_follower(slots.tail)
                    }
                };
                false -> has_struct_record_invalid_last_item_follower(slots.tail)
            };
            false -> has_struct_record_invalid_last_item_follower(slots.tail)
        }
    }
}

fn slots_after_matching_rparen(slots: ListTokenSlot, depth: int64) -> ListTokenSlot {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == kinds.left_paren of {
            true -> slots_after_matching_rparen(slots.tail, depth + 1);
            false -> case slots.head.token.kind == kinds.right_paren of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> slots_after_matching_rparen(slots.tail, depth - 1)
                };
                false -> slots_after_matching_rparen(slots.tail, depth)
            }
        }
    }
}

fn slots_have_function_body_lbrace_on_line(slots: ListTokenSlot, paren_depth: int64, bracket_depth: int64, source_line: int64) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_horizontal_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> false;
        false -> case trimmed.head.token.location.line != source_line of {
            true -> false;
            false -> case trimmed.head.token.kind == kinds.left_paren of {
                true -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth + 1, bracket_depth, source_line);
                false -> case trimmed.head.token.kind == kinds.right_paren of {
                    true -> case paren_depth <= 0 of {
                        true -> false;
                        false -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth - 1, bracket_depth, source_line)
                    };
                    false -> case trimmed.head.token.kind == kinds.left_bracket of {
                        true -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth, bracket_depth + 1, source_line);
                        false -> case trimmed.head.token.kind == kinds.right_bracket of {
                            true -> case bracket_depth <= 0 of {
                                true -> false;
                                false -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth, bracket_depth - 1, source_line)
                            };
                            false -> case trimmed.head.token.kind == kinds.left_brace of {
                                true -> paren_depth == 0 and bracket_depth == 0;
                                false -> case trimmed.head.token.kind == kinds.semicolon of {
                                    true -> false;
                                    false -> slots_have_function_body_lbrace_on_line(trimmed.tail, paren_depth, bracket_depth, source_line)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn slots_start_missing_fn_signature(slots: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> false;
        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, trimmed.head.token.kind) of {
            false -> false;
            true -> {
                after_name: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                case after_name.is_nil of {
                    true -> false;
                    false -> case after_name.head.token.kind == kinds.left_paren of {
                        false -> false;
                        true -> {
                            after_params: ListTokenSlot <- skip_leading_whitespace_slots(slots_after_matching_rparen(after_name.tail, 1));
                            case after_params.is_nil of {
                                true -> false;
                                false -> case after_params.head.token.kind == kinds.right_arrow of {
                                    true -> slots_have_function_body_lbrace_on_line(after_params.tail, 0, 0, trimmed.head.token.location.line);
                                    false -> false
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn has_missing_fn_prefix_at_depth(slots: ListTokenSlot, brace_depth: int64) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case trimmed.head.token.kind == kinds.left_brace of {
            true -> has_missing_fn_prefix_at_depth(trimmed.tail, brace_depth + 1);
            false -> case trimmed.head.token.kind == kinds.right_brace of {
                true -> case brace_depth <= 0 of {
                    true -> has_missing_fn_prefix_at_depth(trimmed.tail, 0);
                    false -> has_missing_fn_prefix_at_depth(trimmed.tail, brace_depth - 1)
                };
                false -> case brace_depth == 0 and slots_start_missing_fn_signature(trimmed) of {
                    true -> (true, trimmed.head.token.location, trimmed.head.token.lexeme);
                    false -> case brace_depth == 0 and trimmed.head.token.kind == kinds.fn_keyword of {
                        true -> {
                            after_fn: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                            case after_fn.is_nil of {
                                true -> (false, parser_ast@zero_location(), "");
                                false -> has_missing_fn_prefix_at_depth(after_fn.tail, brace_depth)
                            }
                        };
                        false -> has_missing_fn_prefix_at_depth(trimmed.tail, brace_depth)
                    }
                }
            }
        }
    }
}

fn has_missing_fn_prefix(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    has_missing_fn_prefix_at_depth(slots, 0)
}

fn has_named_struct_declaration(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case trimmed.head.token.kind == kinds.struct_keyword of {
            true -> {
                after_struct: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                case after_struct.is_nil of {
                    true -> (true, trimmed.head.token.location, "");
                    false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, after_struct.head.token.kind) of {
                        true -> (true, trimmed.head.token.location, after_struct.head.token.lexeme);
                        false -> (true, trimmed.head.token.location, "")
                    }
                }
            };
            false -> has_named_struct_declaration(trimmed.tail)
        }
    }
}

// §3.4.2: named construction `Name { field: … }` is ill-formed; records are anonymous `{ field: … }`.
// Skip `-> Name {` (function body after a named return-type spelling).
fn slots_start_named_struct_construction(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, trimmed.head.token.kind) of {
            false -> (false, parser_ast@zero_location(), "");
            true -> {
                after_name: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                case after_name.is_nil of {
                    true -> (false, parser_ast@zero_location(), "");
                    false -> case after_name.head.token.kind == kinds.left_brace or after_name.head.token.lexeme == "{" of {
                        false -> (false, parser_ast@zero_location(), "");
                        true -> {
                            after_lbrace: ListTokenSlot <- skip_leading_whitespace_slots(after_name.tail);
                            case after_lbrace.is_nil of {
                                true -> (false, parser_ast@zero_location(), "");
                                false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, after_lbrace.head.token.kind) of {
                                    false -> (false, parser_ast@zero_location(), "");
                                    true -> {
                                        after_field: ListTokenSlot <- skip_leading_whitespace_slots(after_lbrace.tail);
                                        case after_field.is_nil of {
                                            true -> (false, parser_ast@zero_location(), "");
                                            false -> case token_starts_with_colon(after_field.head.token) of {
                                                true -> (true, trimmed.head.token.location, trimmed.head.token.lexeme);
                                                false -> (false, parser_ast@zero_location(), "")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn has_named_struct_construction_walk(slots: ListTokenSlot, prev_was_arrow: bool) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case slot_is_whitespace(slots.head) of {
            true -> has_named_struct_construction_walk(slots.tail, prev_was_arrow);
            false -> {
                is_arrow: bool <- slots.head.token.kind == kinds.right_arrow or slots.head.token.lexeme == "->";
                case prev_was_arrow of {
                    true -> has_named_struct_construction_walk(slots.tail, is_arrow);
                    false -> {
                        (hit: bool, loc: { file: string, line: int64, column: int64, offset: int64 }, name: string) <- slots_start_named_struct_construction(slots);
                        case hit of {
                            true -> (true, loc, name);
                            false -> has_named_struct_construction_walk(slots.tail, is_arrow)
                        }
                    }
                }
            }
        }
    }
}

fn has_named_struct_construction(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    has_named_struct_construction_walk(slots, false)
}

// E1063: `-> name { field: … }` — named construction after `->` (case-arm RHS).
// Does not reject `-> AccType { body… }` / `-> ParseResult { x: T <- … }`: those are return type + function body.
fn has_arrow_identifier_before_brace(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case trimmed.head.token.kind == kinds.right_arrow or trimmed.head.token.lexeme == "->" of {
            true -> {
                after_arrow: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                case after_arrow.is_nil of {
                    true -> (false, parser_ast@zero_location(), "");
                    false -> {
                        (hit: bool, loc: { file: string, line: int64, column: int64, offset: int64 }, name: string) <- slots_start_named_struct_construction(after_arrow);
                        case hit of {
                            true -> {
                                after_name: ListTokenSlot <- skip_leading_whitespace_slots(after_arrow.tail);
                                after_lbrace: ListTokenSlot <- skip_leading_whitespace_slots(after_name.tail);
                                case after_lbrace.is_nil of {
                                    true -> has_arrow_identifier_before_brace(trimmed.tail);
                                    false -> case has_bind_arrow_before_statement_boundary(after_lbrace.tail, 0, 0) of {
                                        true -> has_arrow_identifier_before_brace(trimmed.tail);
                                        false -> (true, loc, name)
                                    }
                                }
                            };
                            false -> has_arrow_identifier_before_brace(trimmed.tail)
                        }
                    }
                }
            };
            false -> has_arrow_identifier_before_brace(trimmed.tail)
        }
    }
}

// `-> List {` is incomplete: List requires type arguments `List[T, mem(S)]` before the body `{`.
fn has_incomplete_list_return_type(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case trimmed.head.token.kind == kinds.right_arrow or trimmed.head.token.lexeme == "->" of {
            true -> {
                after_arrow: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                case after_arrow.is_nil of {
                    true -> (false, parser_ast@zero_location());
                    false -> case after_arrow.head.token.kind == kinds.list_keyword or after_arrow.head.token.lexeme == "List" of {
                        true -> {
                            after_list: ListTokenSlot <- skip_leading_whitespace_slots(after_arrow.tail);
                            case after_list.is_nil of {
                                true -> (false, parser_ast@zero_location());
                                false -> case after_list.head.token.kind == kinds.left_brace or after_list.head.token.lexeme == "{" of {
                                    true -> (true, after_arrow.head.token.location);
                                    false -> has_incomplete_list_return_type(trimmed.tail)
                                }
                            }
                        };
                        false -> has_incomplete_list_return_type(trimmed.tail)
                    }
                }
            };
            false -> has_incomplete_list_return_type(trimmed.tail)
        }
    }
}

// §3.4.2: `type Name = …` introduces a custom type name and is ill-formed.
fn has_named_type_alias_declaration(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, trimmed.head.token.kind) of {
            true -> case trimmed.head.token.lexeme == "type" of {
                true -> {
                    after_type: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                    case after_type.is_nil of {
                        true -> has_named_type_alias_declaration(trimmed.tail);
                        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, after_type.head.token.kind) of {
                            true -> {
                                after_name: ListTokenSlot <- skip_leading_whitespace_slots(after_type.tail);
                                case after_name.is_nil of {
                                    true -> has_named_type_alias_declaration(trimmed.tail);
                                    false -> case after_name.head.token.kind == kinds.equal of {
                                        true -> (true, trimmed.head.token.location, after_type.head.token.lexeme);
                                        false -> has_named_type_alias_declaration(trimmed.tail)
                                    }
                                }
                            };
                            false -> has_named_type_alias_declaration(trimmed.tail)
                        }
                    }
                };
                false -> has_named_type_alias_declaration(trimmed.tail)
            };
            false -> has_named_type_alias_declaration(trimmed.tail)
        }
    }
}

fn skip_bracketed_slots(slots: ListTokenSlot, depth: int64) -> ListTokenSlot {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> slots;
        false -> case slots.head.token.kind == kinds.left_bracket of {
            true -> skip_bracketed_slots(slots.tail, depth + 1);
            false -> case slots.head.token.kind == kinds.right_bracket of {
                true -> case depth <= 1 of {
                    true -> slots.tail;
                    false -> skip_bracketed_slots(slots.tail, depth - 1)
                };
                false -> skip_bracketed_slots(slots.tail, depth)
            }
        }
    }
}

fn sequence_has_empty_proc_effect_list(slots_after_sequence: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    after_seq: ListTokenSlot <- skip_leading_whitespace_slots(slots_after_sequence);
    case after_seq.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case after_seq.head.token.kind == kinds.proc_keyword or after_seq.head.token.lexeme == "proc" of {
            true -> {
                proc_loc: { file: string, line: int64, column: int64, offset: int64 } <- after_seq.head.token.location;
                after_proc: ListTokenSlot <- skip_leading_whitespace_slots(after_seq.tail);
                case after_proc.is_nil of {
                    true -> (false, parser_ast@zero_location());
                    false -> case after_proc.head.token.kind == kinds.left_bracket of {
                        true -> {
                            after_lbr: ListTokenSlot <- skip_leading_whitespace_slots(after_proc.tail);
                            case after_lbr.is_nil of {
                                true -> (false, parser_ast@zero_location());
                                false -> case after_lbr.head.token.kind == kinds.right_bracket of {
                                    true -> (true, proc_loc);
                                    false -> (false, parser_ast@zero_location())
                                }
                            }
                        };
                        false -> (false, parser_ast@zero_location())
                    }
                }
            };
            false -> (false, parser_ast@zero_location())
        }
    }
}

fn slots_after_sequence_prefix(slots_after_sequence: ListTokenSlot) -> ListTokenSlot {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    after_seq: ListTokenSlot <- skip_leading_whitespace_slots(slots_after_sequence);
    case after_seq.is_nil of {
        true -> after_seq;
        false -> case after_seq.head.token.kind == kinds.proc_keyword or after_seq.head.token.lexeme == "proc" of {
            true -> {
                after_proc: ListTokenSlot <- skip_leading_whitespace_slots(after_seq.tail);
                case after_proc.is_nil of {
                    true -> after_proc;
                    false -> case after_proc.head.token.kind == kinds.left_bracket of {
                        true -> skip_leading_whitespace_slots(skip_bracketed_slots(after_proc, 0));
                        false -> after_seq
                    }
                }
            };
            false -> after_seq
        }
    }
}

fn find_sequence_produces(slots: ListTokenSlot, brace_depth: int64) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, ListTokenSlot) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), trimmed);
        false -> case trimmed.head.token.kind == kinds.produces_keyword or trimmed.head.token.lexeme == "produces" of {
            true -> case brace_depth == 0 of {
                true -> (true, trimmed.head.token.location, trimmed.tail);
                false -> find_sequence_produces(trimmed.tail, brace_depth)
            };
            false -> case trimmed.head.token.kind == kinds.right_brace or trimmed.head.token.lexeme == "}" of {
                true -> case brace_depth <= 0 of {
                    true -> (false, trimmed.head.token.location, trimmed);
                    false -> find_sequence_produces(trimmed.tail, brace_depth - 1)
                };
                false -> case trimmed.head.token.kind == kinds.left_brace or trimmed.head.token.lexeme == "{" of {
                    true -> find_sequence_produces(trimmed.tail, brace_depth + 1);
                    false -> find_sequence_produces(trimmed.tail, brace_depth)
                }
            }
        }
    }
}

fn find_sequence_end(slots: ListTokenSlot, brace_depth: int64) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, ListTokenSlot) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), trimmed);
        false -> case trimmed.head.token.kind == kinds.end_keyword or trimmed.head.token.lexeme == "end" of {
            true -> case brace_depth == 0 of {
                true -> (true, trimmed.head.token.location, trimmed.tail);
                false -> find_sequence_end(trimmed.tail, brace_depth)
            };
            false -> case trimmed.head.token.kind == kinds.right_brace or trimmed.head.token.lexeme == "}" of {
                true -> case brace_depth <= 0 of {
                    true -> (false, trimmed.head.token.location, trimmed);
                    false -> find_sequence_end(trimmed.tail, brace_depth - 1)
                };
                false -> case trimmed.head.token.kind == kinds.left_brace or trimmed.head.token.lexeme == "{" of {
                    true -> find_sequence_end(trimmed.tail, brace_depth + 1);
                    false -> find_sequence_end(trimmed.tail, brace_depth)
                }
            }
        }
    }
}

fn has_malformed_sequence_keywords(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "", "");
        false -> case trimmed.head.token.kind == kinds.sequence_keyword or trimmed.head.token.lexeme == "sequence" of {
            true -> {
                (empty_proc: bool, empty_proc_loc: { file: string, line: int64, column: int64, offset: int64 }) <- sequence_has_empty_proc_effect_list(trimmed.tail);
                case empty_proc of {
                    true -> (true, empty_proc_loc, "E1056", "empty proc[] on a pure sequence block; omit proc when no effects are required — write 'sequence produces pure <expr> end' (spec §9.3.1)");
                    false -> {
                        after_prefix: ListTokenSlot <- slots_after_sequence_prefix(trimmed.tail);
                        case after_prefix.is_nil of {
                            true -> (true, trimmed.head.token.location, "E1049", "sequence block is missing 'produces'; write 'sequence ... produces pure <expr> end'");
                            false -> case after_prefix.head.token.kind == kinds.sequence_keyword or after_prefix.head.token.lexeme == "sequence" of {
                                true -> (true, after_prefix.head.token.location, "E1052", "duplicate 'sequence' keyword in sequence block; write a single 'sequence ... produces pure <expr> end'");
                                false -> {
                                    (found_produces: bool, produces_or_boundary_loc: { file: string, line: int64, column: int64, offset: int64 }, after_produces: ListTokenSlot) <- find_sequence_produces(after_prefix, 0);
                                    case found_produces of {
                                        false -> (true, trimmed.head.token.location, "E1049", "sequence block is missing 'produces'; write 'sequence ... produces pure <expr> end'");
                                        true -> {
                                            after_produces_trimmed: ListTokenSlot <- skip_leading_whitespace_slots(after_produces);
                                            case after_produces_trimmed.is_nil of {
                                                true -> (true, produces_or_boundary_loc, "E1050", "sequence produces clause is missing 'pure'; write 'produces pure <expr> end'");
                                                false -> case after_produces_trimmed.head.token.kind == kinds.produces_keyword or after_produces_trimmed.head.token.lexeme == "produces" of {
                                                    true -> (true, after_produces_trimmed.head.token.location, "E1053", "duplicate 'produces' keyword in sequence block; write 'produces pure <expr> end'");
                                                    false -> case after_produces_trimmed.head.token.kind == kinds.pure_keyword or after_produces_trimmed.head.token.lexeme == "pure" of {
                                                        false -> (true, after_produces_trimmed.head.token.location, "E1050", "sequence produces clause is missing 'pure'; write 'produces pure <expr> end'");
                                                        true -> {
                                                            (found_end: bool, end_or_boundary_loc: { file: string, line: int64, column: int64, offset: int64 }, after_end: ListTokenSlot) <- find_sequence_end(after_produces_trimmed.tail, 0);
                                                            case found_end of {
                                                                true -> {
                                                                    after_end_trimmed: ListTokenSlot <- skip_leading_whitespace_slots(after_end);
                                                                    case after_end_trimmed.is_nil of {
                                                                        true -> has_malformed_sequence_keywords(after_end);
                                                                        false -> case after_end_trimmed.head.token.kind == kinds.end_keyword or after_end_trimmed.head.token.lexeme == "end" of {
                                                                            true -> (true, after_end_trimmed.head.token.location, "E1054", "extra 'end' after sequence block; sequence blocks close with one 'end' and functions close with '}'");
                                                                            false -> has_malformed_sequence_keywords(after_end)
                                                                        }
                                                                    }
                                                                };
                                                                false -> (true, end_or_boundary_loc, "E1051", "sequence block is missing closing 'end'; write 'sequence ... produces pure <expr> end'")
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            };
            false -> case trimmed.head.token.kind == kinds.produces_keyword or trimmed.head.token.lexeme == "produces" of {
                true -> (true, trimmed.head.token.location, "E1048", "'produces' appears without a preceding 'sequence'; write 'sequence ... produces pure <expr> end'");
                false -> has_malformed_sequence_keywords(trimmed.tail)
            }
        }
    }
}

fn has_sequence_keyword_error(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }, string, string) {
    has_malformed_sequence_keywords(slots)
}

// True when, starting at slots, a case-arm `->` appears at depth 0 before `;` or `}`.
fn has_case_arrow_before_semi_or_rbrace(slots: ListTokenSlot, paren_depth: int64, bracket_depth: int64, brace_depth: int64) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> false;
        false -> {
            tok: Token <- slots.head.token;
            next_paren: int64 <- case tok.kind == kinds.left_paren or tok.lexeme == "(" of {
                true -> paren_depth + 1;
                false -> case tok.kind == kinds.right_paren or tok.lexeme == ")" of {
                    true -> case paren_depth <= 0 of { true -> 0; false -> paren_depth - 1 };
                    false -> paren_depth
                }
            };
            next_bracket: int64 <- case tok.kind == kinds.left_bracket or tok.lexeme == "[" of {
                true -> bracket_depth + 1;
                false -> case tok.kind == kinds.right_bracket or tok.lexeme == "]" of {
                    true -> case bracket_depth <= 0 of { true -> 0; false -> bracket_depth - 1 };
                    false -> bracket_depth
                }
            };
            next_brace: int64 <- case tok.kind == kinds.left_brace or tok.lexeme == "{" of {
                true -> brace_depth + 1;
                false -> case tok.kind == kinds.right_brace or tok.lexeme == "}" of {
                    true -> case brace_depth <= 0 of { true -> 0; false -> brace_depth - 1 };
                    false -> brace_depth
                }
            };
            case paren_depth == 0 and bracket_depth == 0 and brace_depth == 0 of {
                true -> case tok.kind == kinds.right_arrow or tok.lexeme == "->" of {
                    true -> true;
                    false -> case tok.kind == kinds.semicolon or tok.lexeme == ";" or tok.kind == kinds.right_brace or tok.lexeme == "}" of {
                        true -> false;
                        false -> has_case_arrow_before_semi_or_rbrace(slots.tail, next_paren, next_bracket, next_brace)
                    }
                };
                false -> has_case_arrow_before_semi_or_rbrace(slots.tail, next_paren, next_bracket, next_brace)
            }
        }
    }
}

// After a depth-0 `;` in an unbraced case arm: true if that `;` terminates the arm (next arm or `}`).
fn unbraced_case_semi_terminates_arm(after_semi: ListTokenSlot) -> bool {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    rest: ListTokenSlot <- skip_leading_whitespace_slots(after_semi);
    case rest.is_nil of {
        true -> true;
        false -> case rest.head.token.kind == kinds.right_brace or rest.head.token.lexeme == "}" of {
            true -> true;
            false -> has_case_arrow_before_semi_or_rbrace(rest, 0, 0, 0)
        }
    }
}

// Scan unbraced case-arm RHS for an internal `;` (multi-statement, including one line with `;` between exprs).
// Expression continuations across lines (e.g. `and` / `+`) are allowed without braces.
fn unbraced_case_rhs_has_internal_semi(slots: ListTokenSlot, paren_depth: int64, bracket_depth: int64, brace_depth: int64) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slot_is_whitespace(slots.head) of {
            true -> unbraced_case_rhs_has_internal_semi(slots.tail, paren_depth, bracket_depth, brace_depth);
            false -> {
                tok: Token <- slots.head.token;
                next_paren: int64 <- case tok.kind == kinds.left_paren or tok.lexeme == "(" of {
                    true -> paren_depth + 1;
                    false -> case tok.kind == kinds.right_paren or tok.lexeme == ")" of {
                        true -> case paren_depth <= 0 of { true -> 0; false -> paren_depth - 1 };
                        false -> paren_depth
                    }
                };
                next_bracket: int64 <- case tok.kind == kinds.left_bracket or tok.lexeme == "[" of {
                    true -> bracket_depth + 1;
                    false -> case tok.kind == kinds.right_bracket or tok.lexeme == "]" of {
                        true -> case bracket_depth <= 0 of { true -> 0; false -> bracket_depth - 1 };
                        false -> bracket_depth
                    }
                };
                next_brace: int64 <- case tok.kind == kinds.left_brace or tok.lexeme == "{" of {
                    true -> brace_depth + 1;
                    false -> case tok.kind == kinds.right_brace or tok.lexeme == "}" of {
                        true -> case brace_depth <= 0 of { true -> 0; false -> brace_depth - 1 };
                        false -> brace_depth
                    }
                };
                case paren_depth == 0 and bracket_depth == 0 and brace_depth == 0 of {
                    true -> case tok.kind == kinds.semicolon or tok.lexeme == ";" of {
                        true -> case unbraced_case_semi_terminates_arm(slots.tail) of {
                            true -> (false, parser_ast@zero_location());
                            false -> (true, tok.location)
                        };
                        false -> case tok.kind == kinds.right_brace or tok.lexeme == "}" of {
                            true -> (false, parser_ast@zero_location());
                            false -> case has_case_arrow_before_semi_or_rbrace(slots, 0, 0, 0) of {
                                true -> (false, parser_ast@zero_location());
                                false -> unbraced_case_rhs_has_internal_semi(slots.tail, next_paren, next_bracket, next_brace)
                            }
                        }
                    };
                    false -> unbraced_case_rhs_has_internal_semi(slots.tail, next_paren, next_bracket, next_brace)
                }
            }
        }
    }
}

fn check_case_arm_arrow_rhs(after_arrow: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(after_arrow);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case trimmed.head.token.kind == kinds.left_brace or trimmed.head.token.lexeme == "{" of {
            true -> (false, parser_ast@zero_location());
            false -> unbraced_case_rhs_has_internal_semi(trimmed, 0, 0, 0)
        }
    }
}

// Walk tokens; inside `case … of { … }`, reject unbraced multi-statement / multi-line arm RHSs (E1064).
fn has_unbraced_multiline_case_arm_walk(slots: ListTokenSlot, after_of: bool, case_brace_depth: int64) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case slots.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case slot_is_whitespace(slots.head) of {
            true -> has_unbraced_multiline_case_arm_walk(slots.tail, after_of, case_brace_depth);
            false -> {
                tok: Token <- slots.head.token;
                case tok.kind == kinds.of_keyword or tok.lexeme == "of" of {
                    true -> has_unbraced_multiline_case_arm_walk(slots.tail, true, case_brace_depth);
                    false -> case after_of and (tok.kind == kinds.left_brace or tok.lexeme == "{") of {
                        true -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth + 1);
                        false -> case case_brace_depth > 0 of {
                            true -> case tok.kind == kinds.left_brace or tok.lexeme == "{" of {
                                true -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth + 1);
                                false -> case tok.kind == kinds.right_brace or tok.lexeme == "}" of {
                                    true -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth - 1);
                                    false -> case case_brace_depth == 1 and (tok.kind == kinds.right_arrow or tok.lexeme == "->") of {
                                        true -> {
                                            (bad: bool, bad_loc: { file: string, line: int64, column: int64, offset: int64 }) <- check_case_arm_arrow_rhs(slots.tail);
                                            case bad of {
                                                true -> (true, bad_loc);
                                                false -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth)
                                            }
                                        };
                                        false -> has_unbraced_multiline_case_arm_walk(slots.tail, false, case_brace_depth)
                                    }
                                }
                            };
                            false -> has_unbraced_multiline_case_arm_walk(slots.tail, false, 0)
                        }
                    }
                }
            }
        }
    }
}

fn has_unbraced_multiline_case_arm(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    has_unbraced_multiline_case_arm_walk(slots, false, 0)
}

// Case-arm / expression `-> sequence ... produces pure ... end` is not allowed; use `-> { ... }` for pure multi-step arms.
fn has_arrow_sequence_case_rhs(slots: ListTokenSlot) -> (bool, { file: string, line: int64, column: int64, offset: int64 }) {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    trimmed: ListTokenSlot <- skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location());
        false -> case trimmed.tail.is_nil of {
            true -> (false, parser_ast@zero_location());
            false -> case trimmed.head.token.kind == kinds.right_arrow or trimmed.head.token.lexeme == "->" of {
                true -> {
                    after_arrow: ListTokenSlot <- skip_leading_whitespace_slots(trimmed.tail);
                    case after_arrow.is_nil of {
                        true -> (false, parser_ast@zero_location());
                        false -> case after_arrow.head.token.kind == kinds.sequence_keyword or after_arrow.head.token.lexeme == "sequence" of {
                            true -> (true, after_arrow.head.token.location);
                            false -> has_arrow_sequence_case_rhs(trimmed.tail)
                        }
                    }
                };
                false -> has_arrow_sequence_case_rhs(trimmed.tail)
            }
        }
    }
}

fn parse_program(tokens: ListToken) -> ParseResult proc[DeviceIO] {
    reversed: ListToken <- reverse_tokens(lexer_runner@empty_token_list(), tokens);
    slots: ListTokenSlot <- tokens_to_slots(reversed);
    all_c: ListConstraint <- all_constraints();
    propagated: ListTokenSlot <- constraint_core@propagate_until_fixed(slots, all_c);
    (has_ffi_err: bool, ffi_err_loc: { file: string, line: int64, column: int64, offset: int64 }, ffi_err_msg: string) <- constraint_extract@find_malformed_ffi_surface(propagated);
    case has_ffi_err of {
        true -> parser_core@parse_err("E1080", ffi_err_loc, ffi_err_msg, "sect3");
        false -> {
            (has_proc_error: bool, err_loc: { file: string, line: int64, column: int64, offset: int64 }) <- has_proc_after_return_type(propagated);
            case has_proc_error of {
                true -> parser_core@parse_err("E3009", err_loc, "proc[...] is only allowed on sequence clauses directly after the sequence keyword, not on function return types", "sect9.3.1");
                false -> {
                    (has_reserved_bind: bool, reserved_bind_loc: { file: string, line: int64, column: int64, offset: int64 }, reserved_bind_name: string) <- has_reserved_keyword_binding(slots);
                    case has_reserved_bind of {
                        true -> parser_core@parse_err("E1058", reserved_bind_loc, concat(concat("'", reserved_bind_name), "' is a reserved keyword and cannot be used as a variable binding name; choose a different name"), "sect3");
                        false -> {
                            (has_reserved_field: bool, reserved_field_loc: { file: string, line: int64, column: int64, offset: int64 }, reserved_field_name: string) <- has_reserved_keyword_record_field(slots);
                            case has_reserved_field of {
                                true -> parser_core@parse_err("E1059", reserved_field_loc, concat(concat("'", reserved_field_name), "' is a reserved keyword and cannot be used as a record field name; choose a different name"), "sect3");
                                false -> {
                                    (has_unbalanced: bool, unbalanced_loc: { file: string, line: int64, column: int64, offset: int64 }, unbalanced_msg: string) <- has_unbalanced_braces(slots);
                                    case has_unbalanced of {
                                        true -> parser_core@parse_err("E1060", unbalanced_loc, unbalanced_msg, "sect3");
                                        false -> {
                                            (has_bind_colon_space: bool, bind_colon_loc: { file: string, line: int64, column: int64, offset: int64 }, bind_name: string) <- has_spaced_bind_colon(slots);
                                            case has_bind_colon_space of {
                                                true -> parser_core@parse_err("E1043", bind_colon_loc, concat(concat("variable declaration name '", bind_name), "' must be followed immediately by ':' with no whitespace"), "sect3");
                                                false -> {
                                                    (has_atom_space: bool, atom_loc: { file: string, line: int64, column: int64, offset: int64 }) <- has_spaced_atom_literal(slots);
                                                    case has_atom_space of {
                                                        true -> parser_core@parse_err("E1044", atom_loc, "atom literal ':' must be followed immediately by the atom name with no whitespace", "sect3");
                                                        false -> {
                                                            (missing_fn: bool, missing_fn_loc: { file: string, line: int64, column: int64, offset: int64 }, missing_fn_name: string) <- has_missing_fn_prefix(slots);
                                                            case missing_fn of {
                                                                true -> parser_core@parse_err("E1045", missing_fn_loc, concat(concat("function declaration '", missing_fn_name), "' is missing the 'fn' prefix; write 'fn <name>(...) -> <type> { ... }'"), "sect3.4");
                                                                false -> {
                                                                    (has_named_struct: bool, named_struct_loc: { file: string, line: int64, column: int64, offset: int64 }, named_struct_name: string) <- has_named_struct_declaration(slots);
                                                                    case has_named_struct of {
                                                                        true -> parser_core@parse_err("E1047", named_struct_loc, concat(concat("named struct declaration '", named_struct_name), "' is not allowed; declare records inline where the type is used"), "sect3.4.2");
                                                                        false -> {
                                                                            (has_type_alias: bool, type_alias_loc: { file: string, line: int64, column: int64, offset: int64 }, type_alias_name: string) <- has_named_type_alias_declaration(slots);
                                                                            case has_type_alias of {
                                                                                true -> parser_core@parse_err("E1047", type_alias_loc, concat(concat("named type alias declaration '", type_alias_name), "' is not allowed; declare types inline where the type is used"), "sect3.4.2");
                                                                                false -> {
                                                                                    (has_named_ctor: bool, named_ctor_loc: { file: string, line: int64, column: int64, offset: int64 }, named_ctor_name: string) <- has_named_struct_construction(slots);
                                                                                    case has_named_ctor of {
                                                                                        true -> parser_core@parse_err("E1061", named_ctor_loc, concat(concat("named struct construction '", named_ctor_name), "' is not allowed; use an anonymous record '{ field: … }' instead"), "sect3.4.2");
                                                                                        false -> {
                                                                                            (has_arrow_ident: bool, arrow_ident_loc: { file: string, line: int64, column: int64, offset: int64 }, arrow_ident_name: string) <- has_arrow_identifier_before_brace(slots);
                                                                                            case has_arrow_ident of {
                                                                                                true -> parser_core@parse_err("E1063", arrow_ident_loc, concat(concat("named construction '", arrow_ident_name), "' after '->' is not allowed; use an anonymous record '-> { field: … }' instead"), "sect3");
                                                                                                false -> {
                                                                                            (has_incomplete_list: bool, incomplete_list_loc: { file: string, line: int64, column: int64, offset: int64 }) <- has_incomplete_list_return_type(slots);
                                                                                            case has_incomplete_list of {
                                                                                                true -> parser_core@parse_err("E1062", incomplete_list_loc, "incomplete List return type: write '-> List[T, mem(S)]' with type arguments before the function body '{'", "sect3");
                                                                                                false -> {
                                                                                                    (has_record_bad_tail: bool, record_bad_tail_loc: { file: string, line: int64, column: int64, offset: int64 }, record_bad_tail_token: string) <- has_struct_record_invalid_last_item_follower(slots);
                                                                                                    case has_record_bad_tail of {
                                                                                                        true -> parser_core@parse_err("E1046", record_bad_tail_loc, concat(concat("unexpected '", record_bad_tail_token), "' after the last item in a struct/record; close it with '}'"), "sect3");
                                                                                                        false -> {
                                                                                                            (has_arrow_seq: bool, arrow_seq_loc: { file: string, line: int64, column: int64, offset: int64 }) <- has_arrow_sequence_case_rhs(slots);
                                                                                                            case has_arrow_seq of {
                                                                                                                true -> parser_core@parse_err("E1057", arrow_seq_loc, "sequence...produces pure...end cannot be the RHS of '->'; use a '{ ... }' block for pure multi-step case arms (spec §3.3.3 / §3.3.4)", "sect3.3.3");
                                                                                                                false -> {
                                                                                                                    (has_unbraced_multi: bool, unbraced_multi_loc: { file: string, line: int64, column: int64, offset: int64 }) <- has_unbraced_multiline_case_arm(slots);
                                                                                                                    case has_unbraced_multi of {
                                                                                                                        true -> parser_core@parse_err("E1064", unbraced_multi_loc, "multi-statement case arm must be wrapped in '{ ... }'; use braces when the arm contains ';' between expressions", "sect3.3.3");
                                                                                                                        false -> {
                                                                                                                    (has_sequence_err: bool, sequence_err_loc: { file: string, line: int64, column: int64, offset: int64 }, sequence_err_code: string, sequence_err_msg: string) <- has_sequence_keyword_error(slots);
                                                                                                                    case has_sequence_err of {
                                                                                                                        true -> parser_core@parse_err(sequence_err_code, sequence_err_loc, sequence_err_msg, "sect9.3.1");
                                                                                                                        false -> {
                                                                                                                            (has_missing_ret: bool, missing_ret_loc: { file: string, line: int64, column: int64, offset: int64 }, missing_ret_fn: string) <- has_missing_function_return_type(propagated);
                                                                                                                            case has_missing_ret of {
                                                                                                                                true -> parser_core@parse_err("E1042", missing_ret_loc, concat(concat("function '", missing_ret_fn), "' is missing a return type; write '-> <type>' before the function body"), "sect3.4");
                                                                                                                                false -> {
                                                                                                                                    program: Program <- constraint_extract@slots_to_program(propagated);
                                                                                                                                    result0: ParseResult <- constraint_extract@validate_required_statement_terminators(program);
                                                                                                                                    case result0.is_ok of {
                                                                                                                                        true -> {
                                                                                                                                            result0b: ParseResult <- constraint_extract@validate_no_illegal_trailing_semicolon(result0.program);
                                                                                                                                            case result0b.is_ok of {
                                                                                                                                                true -> {
                                                                                                                                                    result1: ParseResult <- constraint_extract@validate_no_single_element_tuples(result0b.program);
                                                                                                                                                    case result1.is_ok of {
                                                                                                                                                        true -> {
                                                                                                                                                            result2: ParseResult <- constraint_extract@validate_max_params(result1.program);
                                                                                                                                                            case result2.is_ok of {
                                                                                                                                                                true -> {
                                                                                                                                                                    result3: ParseResult <- constraint_extract@validate_max_tuple_decompose_bindings(result2.program);
                                                                                                                                                                    case result3.is_ok of {
                                                                                                                                                                        true -> {
                                                                                                                                                                            result4: ParseResult <- constraint_extract@validate_no_unused_scope_bindings(result3.program);
                                                                                                                                                                            case result4.is_ok of {
                                                                                                                                                                                true -> {
                                                                                                                                                                                    lifted: Program <- constraint_extract@lift_lambda_expressions(result4.program);
                                                                                                                                                                                    wrapped_prog: Program <- constraint_extract@wrap_lifted_lambda_hof_calls(lifted);
                                                                                                                                                                                    parser_core@parse_ok(wrapped_prog)
                                                                                                                                                                                };
                                                                                                                                                                                false -> result4
                                                                                                                                                                            }
                                                                                                                                                                        };
                                                                                                                                                                        false -> result3
                                                                                                                                                                    }
                                                                                                                                                                };
                                                                                                                                                                false -> result2
                                                                                                                                                            }
                                                                                                                                                        };
                                                                                                                                                        false -> result1
                                                                                                                                                    }
                                                                                                                                                };
                                                                                                                                                false -> result0b
                                                                                                                                            }
                                                                                                                                        };
                                                                                                                                        false -> result0
                                                                                                                                    }
                                                                                                                                }
                                                                                                                            }
                                                                                                                        }
                                                                                                                    }
                                                                                                                        }
                                                                                                                    }
                                                                                                                }
                                                                                                            }
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
