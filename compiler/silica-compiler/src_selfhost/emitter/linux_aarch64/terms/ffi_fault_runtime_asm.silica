// Phase 13 — Linux (glibc, AArch64) sigaltstack / sigaction guarded-FFI fault bridge.
// Ported from apple_silicon_mac: stack_t, struct sigaction, ucontext_t and siginfo_t use Linux layouts;
// SIGBUS is 7 on Linux (10 on Darwin); sa_flags = SA_SIGINFO (4) | SA_ONSTACK (0x08000000).
// Per-thread guarded TLS block layout (512 B, see ffi_guarded_runtime_asm.silica):
//   +0 depth, +8 actor ACB, +16 call_gen, +24 inside,
//   +32 fault_signal, +40 fault_addr, +48 fault_code, +56 fault_in_arena,
//   +64 sigjmp_buf (448 B).

export emit_ffi_fault_runtime_asm/0;

fn emit_ffi_fault_runtime_asm() -> string {
    bss: string <- "	.bss
	.p2align	3
silica_rt_ffi_altstack_mem:
	.zero	65536
silica_rt_sync_fault_handlers_installed:
	.zero	4
	.globl	silica_rt_fault_pc
silica_rt_fault_pc:
	.zero	8
silica_rt_fault_dlinfo:
	.zero	48
silica_rt_fault_hexbuf:
	.zero	32
silica_rt_fault_addr:
	.zero	8
silica_rt_fault_actor:
	.zero	8
silica_rt_fault_sbase:
	.zero	8
silica_rt_fault_ssize:
	.zero	8
	.globl	silica_rt_own_image_base
silica_rt_own_image_base:
	.zero	8
silica_rt_ffi_altstack_active:
	.zero	4
";
    text: string <- "	.text
	.globl	silica_rt_install_sync_fault_handlers
	.p2align	2
silica_rt_install_sync_fault_handlers:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
Lloh_ifh0:
	adrp	x8, silica_rt_sync_fault_handlers_installed
Lloh_ifh1:
	add	x8, x8, :lo12:silica_rt_sync_fault_handlers_installed
	ldr	w9, [x8]
	cbnz	w9, L_ifh_done
	mov	w9, #1
	str	w9, [x8]
	sub	sp, sp, #192
// Linux stack_t: ss_sp @0, ss_flags (int) @8, ss_size @16.
Lloh_as0:
	adrp	x9, silica_rt_ffi_altstack_mem
Lloh_as1:
	add	x9, x9, :lo12:silica_rt_ffi_altstack_mem
	str	x9, [sp]
	str	wzr, [sp, #8]
	mov	x9, #65536
	str	x9, [sp, #16]
	mov	x0, sp
	mov	x1, xzr
	bl	sigaltstack
Lloh_asf0:
	adrp	x9, silica_rt_ffi_altstack_active
Lloh_asf1:
	add	x9, x9, :lo12:silica_rt_ffi_altstack_active
	mov	w10, #1
	str	w10, [x9]
// Linux/glibc AArch64 struct sigaction (152 B at sp+32): sa_handler @0, sa_mask @8 (128 B),
// sa_flags @136, sa_restorer @144. Zero it, then set handler + SA_SIGINFO|SA_ONSTACK.
	add	x8, sp, #32
	mov	x9, #152
L_ifh_zero:
	str	xzr, [x8], #8
	subs	x9, x9, #8
	b.ne	L_ifh_zero
Lloh_h0:
	adrp	x8, silica_rt_sync_fault_handler
Lloh_h1:
	add	x8, x8, :lo12:silica_rt_sync_fault_handler
	str	x8, [sp, #32]
	mov	w9, #4
	movk	w9, #0x0800, lsl #16
	str	w9, [sp, #168]
	mov	w0, #11
	add	x1, sp, #32
	mov	x2, xzr
	bl	sigaction
	mov	w0, #7
	add	x1, sp, #32
	mov	x2, xzr
	bl	sigaction
	mov	w0, #4
	add	x1, sp, #32
	mov	x2, xzr
	bl	sigaction
	mov	w0, #8
	add	x1, sp, #32
	mov	x2, xzr
	bl	sigaction
	add	sp, sp, #192
L_ifh_done:
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
	.globl	silica_rt_ffi_fault_altstack_probed
	.p2align	2
silica_rt_ffi_fault_altstack_probed:
	.cfi_startproc
Lloh_ap0:
	adrp	x8, silica_rt_ffi_altstack_active
Lloh_ap1:
	add	x8, x8, :lo12:silica_rt_ffi_altstack_active
	ldr	w0, [x8]
	ret
	.cfi_endproc
	.globl	silica_rt_ffi_trial_arena_base
	.p2align	2
silica_rt_ffi_trial_arena_base:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x29, sp
	bl	silica_rt_tls_current_actor_get
	cbz	x0, L_tab_zero
	mov	x19, x0
	bl	silica_rt_ffi_arena_ensure
	cbz	x0, L_tab_zero
	ldr	x0, [x19, #352]
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
L_tab_zero:
	mov	x0, xzr
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
	.globl	silica_rt_sync_fault_handler
	.p2align	2
silica_rt_sync_fault_handler:
	.cfi_startproc
	stp	x24, x23, [sp, #-64]!
	stp	x22, x21, [sp, #16]
	stp	x20, x19, [sp, #32]
	stp	x29, x30, [sp, #48]
	add	x29, sp, #48
	mov	x22, x0
	mov	x23, x1
	mov	x24, x2
	adrp	x8, silica_rt_fault_pc
	add	x8, x8, :lo12:silica_rt_fault_pc
	cbz	x24, Lsfh_pc_done
// Linux AArch64 ucontext_t: uc_mcontext @176 inline; sigcontext.pc @176+264 = 440. siginfo_t si_addr @16.
	ldr	x9, [x24, #440]
	str	x9, [x8]
	ldr	x9, [x23, #16]
	adrp	x8, silica_rt_fault_addr
	add	x8, x8, :lo12:silica_rt_fault_addr
	str	x9, [x8]
	bl	silica_rt_tls_current_actor_get
	adrp	x8, silica_rt_fault_actor
	add	x8, x8, :lo12:silica_rt_fault_actor
	str	x0, [x8]
	cbz	x0, Lsfh_no_actor
	ldr	x9, [x0, #160]
	adrp	x8, silica_rt_fault_sbase
	add	x8, x8, :lo12:silica_rt_fault_sbase
	str	x9, [x8]
	ldr	x9, [x0, #184]
	adrp	x8, silica_rt_fault_ssize
	add	x8, x8, :lo12:silica_rt_fault_ssize
	str	x9, [x8]
Lsfh_no_actor:
	adrp	x0, silica_rt_sync_fault_handler
	add	x0, x0, :lo12:silica_rt_sync_fault_handler
	adrp	x1, silica_rt_fault_dlinfo
	add	x1, x1, :lo12:silica_rt_fault_dlinfo
	bl	dladdr
	adrp	x1, silica_rt_fault_dlinfo
	add	x1, x1, :lo12:silica_rt_fault_dlinfo
	ldr	x2, [x1, #8]
	adrp	x3, silica_rt_own_image_base
	add	x3, x3, :lo12:silica_rt_own_image_base
	str	x2, [x3]
// No diagnostic here: a fault inside a guarded FFI region is recovered just below and
// reported as an actor failure, so printing the site first would add a line that the
// caller never sees on a healthy recovery. The unrecoverable paths below still print it.
Lsfh_pc_done:
	mov	x0, x22
	mov	x1, x23
	bl	silica_rt_ffi_guarded_fault_handler_try
	cbnz	w0, L_sfh_done
	cmp	w22, #11
	b.ne	L_sfh_crash
	mov	x19, x23
	ldr	x19, [x19, #16]
	bl	silica_rt_tls_current_actor_get
	mov	x20, x0
	cbz	x20, L_sfh_crash
	ldr	x21, [x20, #160]
	cbz	x21, L_sfh_crash
	ldr	x22, [x20, #184]
	add	x22, x21, x22
	cmp	x19, x21
	b.lo	L_sfh_crash
	cmp	x19, x22
	b.hs	L_sfh_overflow
	bic	x0, x19, #0xfff
	mov	x1, #0x1000
	mov	w2, #3
	bl	mprotect
	cmp	w0, #0
	b.ne	L_sfh_unrecoverable
	ldr	x8, [x20, #160]
	bic	x9, x19, #0xfff
	add	x9, x9, #0x1000
	sub	x9, x9, x8
	ldr	x10, [x20, #168]
	cmp	x9, x10
	b.ls	L_sfh_stack_done
	str	x9, [x20, #168]
L_sfh_stack_done:
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
L_sfh_overflow:
	ldr	w9, [x20, #152]
	cbz	w9, L_sfh_crash
	str	wzr, [x20, #152]
	add	x0, x20, #80
	bl	silica_rt_cv_signal
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
L_sfh_unrecoverable:
	bl	silica_rt_print_fault_site
	mov	w0, #70
	bl	exit
L_sfh_crash:
	bl	silica_rt_print_fault_site
	mov	w0, #70
	bl	exit
L_sfh_done:
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
	.cfi_endproc
	.globl	silica_rt_ffi_guarded_fault_handler_try
	.p2align	2
silica_rt_ffi_guarded_fault_handler_try:
	.cfi_startproc
// X0=signum, X1=siginfo*
	stp	x21, x20, [sp, #-16]!
	stp	x19, x30, [sp, #-16]!
	mov	x21, x0
	mov	x19, x1
Lloh_gk0:
	adrp	x8, silica_guarded_ffi_pthread_key
Lloh_gk1:
	add	x8, x8, :lo12:silica_guarded_ffi_pthread_key
	ldr	x0, [x8]
// The key is zero until the first guarded region creates it. Reading a thread-specific
// value for key zero does NOT fail: on Darwin it returns a live pointer from a slot the C
// library reserves for itself. Without this check a fault raised before any guarded call
// took that pointer for the per-thread guarded state, wrote the fault record over the
// library's memory, and jumped through a sigjmp_buf made of unrelated bytes, which hung
// the process inside longjmp instead of reporting the fault and exiting.
	cbz	x0, L_gft_no
	bl	pthread_getspecific
	cbz	x0, L_gft_no
	mov	x20, x0
	ldr	x9, [x20, #24]
	cbz	x9, L_gft_no
	sxtw	x9, w21
	str	x9, [x20, #32]
	ldr	x9, [x19, #16]
	str	x9, [x20, #40]
	ldr	w10, [x19, #8]
	sxtw	x10, w10
	str	x10, [x20, #48]
	mov	x10, xzr
	ldr	x11, [x20, #8]
	cbz	x11, L_gft_store_arena
	ldr	x12, [x11, #352]
	ldr	x13, [x11, #360]
	cbz	x12, L_gft_store_arena
	cmp	x9, x12
	b.lo	L_gft_store_arena
	cmp	x9, x13
	b.hs	L_gft_store_arena
	mov	x10, #1
L_gft_store_arena:
	str	x10, [x20, #56]
	adrp	x0, silica_rt_fault_pc
	add	x0, x0, :lo12:silica_rt_fault_pc
	ldr	x0, [x0]
	cbz	x0, Lgft_do_jmp
	adrp	x1, silica_rt_fault_dlinfo
	add	x1, x1, :lo12:silica_rt_fault_dlinfo
	stp	x19, x20, [sp, #-16]!
	bl	dladdr
	ldp	x19, x20, [sp], #16
	cbz	w0, Lgft_do_jmp
	adrp	x1, silica_rt_fault_dlinfo
	add	x1, x1, :lo12:silica_rt_fault_dlinfo
	ldr	x2, [x1, #8]
	adrp	x3, silica_rt_own_image_base
	add	x3, x3, :lo12:silica_rt_own_image_base
	ldr	x3, [x3]
	cbz	x3, Lgft_do_jmp
// The fault image used to be compared against our own image, and a fault inside it was
// treated as not-a-foreign-fault and left unrecovered. That only distinguishes anything
// when the dangerous library is a separate dylib. The trials, and any static archive,
// link the foreign code into this image, so every guarded fault was declined and the
// process died instead of reporting reason_tag 5. Being inside the guarded window,
// which the depth and inside flags above establish, is what makes a fault ours.
	cmp	x2, x3
Lgft_do_jmp:
	add	x0, x20, #64
	mov	w1, #1
	bl	siglongjmp
L_gft_no:
	mov	x0, xzr
	ldp	x19, x30, [sp], #16
	ldp	x21, x20, [sp], #16
	ret
	.cfi_endproc
	.globl	silica_rt_ffi_guarded_fault_finish
	.p2align	2
silica_rt_ffi_guarded_fault_finish:
	.cfi_startproc
	stp	x21, x20, [sp, #-48]!
	stp	x29, x30, [sp, #16]
	str	x19, [sp, #32]
	add	x29, sp, #16
Lloh_gff0:
	adrp	x8, silica_guarded_ffi_pthread_key
Lloh_gff1:
	add	x8, x8, :lo12:silica_guarded_ffi_pthread_key
	ldr	x0, [x8]
// The key is zero until the first guarded region creates it. Reading a thread-specific
// value for key zero does NOT fail: on Darwin it returns a live pointer from a slot the C
// library reserves for itself. Without this check a fault raised before any guarded call
// took that pointer for the per-thread guarded state, wrote the fault record over the
// library's memory, and jumped through a sigjmp_buf made of unrelated bytes, which hung
// the process inside longjmp instead of reporting the fault and exiting.
	cbz	x0, L_gff_actor
	bl	pthread_getspecific
	mov	x20, x0
	cbz	x20, L_gff_actor
	str	xzr, [x20, #0]
	str	xzr, [x20, #8]
	str	xzr, [x20, #24]
L_gff_actor:
	bl	silica_rt_tls_current_actor_get
	mov	x19, x0
	cbnz	x19, L_gff_have_actor
	b	L_gff_process
L_gff_have_actor:
	mov	x0, x19
	bl	silica_rt_ffi_arena_reset
	add	x0, x19, #16
	bl	silica_rt_lock_lock
	mov	x8, #5
	str	x8, [x19, #336]
	str	wzr, [x19, #152]
	add	x0, x19, #80
	bl	silica_rt_cv_signal
	add	x0, x19, #16
	bl	silica_rt_lock_unlock
	ldr	x8, [x19, #272]
	cbnz	x8, L_gff_report_done
	mov	x0, x19
	bl	silica_rt_actor_deliver_exit
	mov	x20, x0
	mov	x0, x19
	bl	silica_rt_actor_deliver_unwind_report
	b	L_gff_after_report
L_gff_report_done:
	mov	x20, xzr
L_gff_after_report:
	mov	x0, x19
	bl	silica_rt_actor_signal_pending_call_deaths
	ldr	x20, [x19, #208]
	ldr	x21, [x19, #192]
	cbz	x21, L_gff_thread_exit
	mov	x0, x19
	bl	silica_rt_ffi_arena_teardown
	mov	x0, x19
	bl	silica_rt_child_table_free
	mov	x0, x19
	bl	silica_rt_actor_dealloc_region
	mov	x0, x19
	bl	free
	cbz	x20, L_gff_thread_exit
	mov	x9, #1
	str	x9, [x20, #56]
L_gff_thread_exit:
	mov	x0, xzr
	bl	pthread_exit
	b	L_gff_thread_exit
L_gff_process:
	mov	w0, #2
Lloh_gff_msg0:
	adrp	x1, L_silica_foreign_fault_msg
Lloh_gff_msg1:
	add	x1, x1, :lo12:L_silica_foreign_fault_msg
	mov	w2, #14
	bl	write
	mov	w0, #1
	bl	exit
	b	L_gff_process
	.cfi_endproc
	.section .rodata
L_silica_foreign_fault_msg:
	.asciz	\"foreign_fault\\n\"
	.text
	.section .rodata
	.p2align	2
Lpfs_pre:
	.asciz	\"[silica] fault at 0x\"
Lpfs_in:
	.asciz	\" in \"
Lpfs_plus:
	.asciz	\"+0x\"
Lpfs_eol:
	.asciz	\"\\n\"
Lpfs_nib:
	.asciz	\"0123456789abcdef\"
Lfss_pre:
	.asciz	\"  fault_pc: 0x\"
Lpfs_ad:
	.asciz	\"  addr=0x\"
Lpfs_ac:
	.asciz	\"  actor=0x\"
Lpfs_sb:
	.asciz	\"  sbase=0x\"
Lpfs_ss:
	.asciz	\"  ssize=0x\"
	.text
	.p2align	2
silica_rt_fault_puts:
	stp	x29, x30, [sp, #-32]!
	mov	x29, sp
	str	x19, [sp, #16]
	mov	x19, x0
	cbz	x19, Lfp_out
	mov	x1, #0
Lfp_len:
	ldrb	w2, [x19, x1]
	cbz	w2, Lfp_w
	add	x1, x1, #1
	b	Lfp_len
Lfp_w:
	cbz	x1, Lfp_out
	mov	x2, x1
	mov	x1, x19
	mov	x0, #2
	bl	write
Lfp_out:
	ldr	x19, [sp, #16]
	ldp	x29, x30, [sp], #32
	ret
	.p2align	2
silica_rt_fault_puthex:
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	mov	x19, x0
	adrp	x20, silica_rt_fault_hexbuf
	add	x20, x20, :lo12:silica_rt_fault_hexbuf
	adrp	x21, Lpfs_nib
	add	x21, x21, :lo12:Lpfs_nib
	mov	x22, #0
Lph_loop:
	cmp	x22, #16
	b.hs	Lph_w
	mov	x2, #60
	sub	x2, x2, x22, lsl #2
	lsr	x3, x19, x2
	and	x3, x3, #0xf
	ldrb	w4, [x21, x3]
	strb	w4, [x20, x22]
	add	x22, x22, #1
	b	Lph_loop
Lph_w:
	mov	x0, #2
	mov	x1, x20
	mov	x2, #16
	bl	write
	ldp	x21, x22, [sp, #32]
	ldp	x19, x20, [sp, #16]
	ldp	x29, x30, [sp], #48
	ret
	.globl	silica_rt_print_fault_site
	.p2align	2
silica_rt_print_fault_site:
	stp	x29, x30, [sp, #-48]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
	adrp	x19, silica_rt_fault_pc
	add	x19, x19, :lo12:silica_rt_fault_pc
	ldr	x20, [x19]
	cbz	x20, Lpfs_done
	adrp	x0, Lpfs_pre
	add	x0, x0, :lo12:Lpfs_pre
	bl	silica_rt_fault_puts
	mov	x0, x20
	bl	silica_rt_fault_puthex
	mov	x0, x20
	adrp	x1, silica_rt_fault_dlinfo
	add	x1, x1, :lo12:silica_rt_fault_dlinfo
	bl	dladdr
	cbz	w0, Lpfs_nl
	adrp	x21, silica_rt_fault_dlinfo
	add	x21, x21, :lo12:silica_rt_fault_dlinfo
	ldr	x22, [x21, #16]
	cbz	x22, Lpfs_nl
	adrp	x0, Lpfs_in
	add	x0, x0, :lo12:Lpfs_in
	bl	silica_rt_fault_puts
	mov	x0, x22
	bl	silica_rt_fault_puts
	ldr	x1, [x21, #24]
	cbz	x1, Lpfs_nl
	sub	x22, x20, x1
	adrp	x0, Lpfs_plus
	add	x0, x0, :lo12:Lpfs_plus
	bl	silica_rt_fault_puts
	mov	x0, x22
	bl	silica_rt_fault_puthex
Lpfs_nl:
	adrp	x0, Lpfs_ad
	add	x0, x0, :lo12:Lpfs_ad
	bl	silica_rt_fault_puts
	adrp	x0, silica_rt_fault_addr
	add	x0, x0, :lo12:silica_rt_fault_addr
	ldr	x0, [x0]
	bl	silica_rt_fault_puthex
	adrp	x0, Lpfs_ac
	add	x0, x0, :lo12:Lpfs_ac
	bl	silica_rt_fault_puts
	adrp	x0, silica_rt_fault_actor
	add	x0, x0, :lo12:silica_rt_fault_actor
	ldr	x0, [x0]
	bl	silica_rt_fault_puthex
	adrp	x0, Lpfs_sb
	add	x0, x0, :lo12:Lpfs_sb
	bl	silica_rt_fault_puts
	adrp	x0, silica_rt_fault_sbase
	add	x0, x0, :lo12:silica_rt_fault_sbase
	ldr	x0, [x0]
	bl	silica_rt_fault_puthex
	adrp	x0, Lpfs_ss
	add	x0, x0, :lo12:Lpfs_ss
	bl	silica_rt_fault_puts
	adrp	x0, silica_rt_fault_ssize
	add	x0, x0, :lo12:silica_rt_fault_ssize
