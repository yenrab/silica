    LDR X6, [X0, #16]
L_lat_loop:
    CBZ X1, L_lat_done
    ADD X6, X6, X2
    CMP X6, X3
    B.LT L_lat_step
    LDR X5, [X5, X3]
    MOV X6, #0
L_lat_step:
    SUB X1, X1, #1
    B L_lat_loop
L_lat_done:
    ADD X0, X5, X6
    RET
L_lat_oob:
    BL _abort

