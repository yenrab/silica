    // bool in W0 per AAPCS; widen to X for dest
    concat(concat("    MOV X0, X11\n    MOV X1, X10\n", asm_bl("_silica_rt_actor_cast")), mov_dest_from_x0_for_type(dest, sir_term_root_node(term).type_name))
}

