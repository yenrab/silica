L_str_26_d:
    .ascii "\t.section\t__TEXT,__text,regular,pure_instructions\n\t.globl\t_silica_rt_actor_deliver_exit   ; Phase C — §15.4.10 unified delivery\n\t.p2align\t2\n_silica_rt_actor_deliver_exit:          ; X0=child self; X0 out: 0 delivered, 1 drop (no sup / dead / OOM)\n\t.cfi_startproc\n\tstp\tx22, x21, [sp, #-48]!\n\tstp\tx20, x19, [sp, #16]\n\tstp\tx29, x30, [sp, #32]\n\tadd\tx29, sp, #32\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\t.cfi_offset w21, -40\n\t.cfi_offset w22, -48\n\tmov\tx19, x0\n\tldr\tx20, [x19, #192]\n\tcbz\tx20, Lde_nosup\n\tmov\tw0, #1\n\tmov\tw1, #32\n\tbl\t_calloc\n\tcbz\tx0, Lde_nosup\n\tmov\tx21, x0\n\tstr\tx19, [x21]\n\tldr\tx9, [x19, #336]\n\tstr\tx9, [x21, #8]\n\tstr\txzr, [x21, #16]\n\tldr\tx8, [x19, #200]\n\tstr\tx8, [x21, #24]\n\tadd\tx0, x20, #16\n\tbl\t_os_unfair_lock_lock\n\tldr\tw9, [x20, #152]\n\tcbz\tw9, Lde_dead\n\tldr\tw9, [x20, #248]\n\tcmp\tw9, #1024\n\tb.hs\tLde_abort\n\tmov\tw0, #1\n\tmov\tw1, #152\n\tbl\t_calloc\n\tcbz\tx0, Lde_dead\n\tmov\tx22, x0\n\tstr\tx21, [x22, #8]\n\tstr\twzr, [x22, #16]\n\tadd\tx0, x20, #232\n\tmov\tx1, x22\n\tbl\t_silica_rt_q_enqueue_locked\n\tldr\tw9, [x20, #248]\n\tadd\tw9, w9, #1\n\tstr\tw9, [x20, #248]\n\tadd\tx0, x20, #80\n\tbl\t_silica_rt_cv_signal\n\tadd\tx0, x20, #16\n\tbl\t_os_unfair_lock_unlock\n\tmov\tx0, #0\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\nLde_dead:\n\tmov\tx0, x21\n\tbl\t_free\n\tadd\tx0, x20, #16\n\tbl\t_os_unfair_lock_unlock\n\tmov\tx0, #1\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\nLde_nosup:\n\tmov\tx0, #1\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\nLde_abort:\n\tbl\t_abort\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_supervision_wait_and_drain_one ; Phase C trial accessor — behavior-only\n\t.p2align\t2\n_silica_rt_actor_supervision_wait_and_drain_one:\n\t.cfi_startproc\n; No args; returns X0 = failure payload pointer dequeued from self's supervision ingress, blocks until one is available.\n\tstp\tx22, x21, [sp, #-48]!\n\tstp\tx20, x19, [sp, #16]\n\tstp\tx29, x30, [sp, #32]\n\tadd\tx29, sp, #32\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\t.cfi_offset w21, -40\n\t.cfi_offset w22, -48\n\tbl\t_silica_rt_tls_current_actor_get\n\tmov\tx19, x0\n\tcbz\tx19, Lswd_null\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_lock\nLswd_try:\n\tadd\tx0, x19, #232\n\tbl\t_silica_rt_q_dequeue_locked\n\tcbz\tx0, Lswd_wait\n\tmov\tx20, x0\n\tldr\tw9, [x19, #248]\n\tsub\tw9, w9, #1\n\tstr\tw9, [x19, #248]\n\tldr\tx21, [x20, #8]\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_unlock\n; Phase E: mirror LBB1_free (mutex must not be held — maybe_restart may spawn / take table locks). X2 = reason_tag (e4b).\n\tcbz\tx21, Lswd_free_wrap\n\tldr\tx8, [x21]\n\tcbz\tx8, Lswd_free_wrap\n\tmov\tx0, x8\n\tmov\tx1, x19\n\tldr\tx2, [x21, #8]\n\tbl\t_silica_rt_supervisor_maybe_restart\nLswd_free_wrap:\n\tmov\tx0, x20\n\tbl\t_free\n\tmov\tx0, x21\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\nLswd_wait:\n; Phase E e4f: blocking pthread_cond_wait. Same rationale as in _silica_rt_actor_call /\n; actor_thread_main wait paths — the 1 ms timedwait was a missed-signal band-aid that drove\n; libpthread internal kwq malloc churn racing with new-actor TLS instantiation (mfm_alloc\n; SIGBUS). All paths that enqueue a failure (LBB1_free's _silica_rt_actor_deliver_exit, etc.)\n; signal sup#80 cond while holding sup#16 mutex, so plain cond_wait is correctly delivered.\n\tadd\tx0, x19, #80\n\tadd\tx1, x19, #16\n\tbl\t_silica_rt_cv_wait\n\tb\tLswd_try\nLswd_null:\n\tmov\tx0, #0\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_failure_reason_tag\n\t.p2align\t2\n_silica_rt_actor_failure_reason_tag:    ; X0=payload ptr -> X0=int64 reason_tag (0 :normal)\n\t.cfi_startproc\n\tcbz\tx0, Lfrt_zero\n\tldr\tx0, [x0, #8]\n\tret\nLfrt_zero:\n\tmov\tx0, #0\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_failure_reason_atom\n\t.p2align\t2\n_silica_rt_actor_failure_reason_atom:   ; X0=payload ptr -> X0=atom failure_reason variant\n\t.cfi_startproc\n\tcbz\tx0, Lfra_unknown\n\tldr\tx8, [x0, #8]\n\tcbz\tx8, Lfra_normal\n\tcmp\tx8, #2\n\tb.eq\tLfra_language_error\n\tcmp\tx8, #3\n\tb.eq\tLfra_memory_fault\n\tcmp\tx8, #4\n\tb.eq\tLfra_explicit\n\tcmp\tx8, #5\n\tb.eq\tLfra_foreign_fault\n\tb\tLfra_unknown\nLfra_normal:\n\tmov\tx0, #"
    .byte 0
    .p2align 3
