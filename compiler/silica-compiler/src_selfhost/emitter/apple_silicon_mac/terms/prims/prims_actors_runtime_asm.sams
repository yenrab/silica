layout;\n; macOS sysctl does not expose physical DRAM base per node — size is real (hw.memsize bytes). latency=0 = local self-\n; distance (ACPI SLIT-style relative units: same node as itself), not an OS picoseconds value.\n\tstr\txzr, [x0]\n\tstr\tx27, [x0, #8]\n\tstr\txzr, [x0, #16]\n\tmov\tx23, x0\n\tmov\tx0, #16\n\tbl\t_malloc\n\tcbz\tx0, L_topo_fail_zero\n\tstr\tx23, [x0]\n\tstr\txzr, [x0, #8]\n\tmov\tx23, x0\n\tmov\tx0, #24\n\tbl\t_malloc\n\tcbz\tx0, L_topo_fail_zero\n\tstr\txzr, [x0]\n\tstr\tx28, [x0, #8]\n\tstr\tx23, [x0, #16]\n\tmov\tx23, x0\n\tmov\tx0, #16\n\tbl\t_malloc\n\tcbz\tx0, L_topo_fail_zero\n\tstr\tx23, [x0]\n\tstr\txzr, [x0, #8]\n\tmov\tx26, x0\n\tuxtw\tx0, w19\n\tuxtw\tx1, w20\n\tuxtw\tx2, w21\n\tmov\tx3, x28\n\tbl\t_silica_rt_apple_build_cache_levels\n\tmov\tx25, x0\n\tmov\tx0, #24\n\tbl\t_malloc\n\tcbz\tx0, L_topo_fail_zero\n\tstr\tx22, [x0]\n\tstr\tx26, [x0, #8]\n\tstr\tx25, [x0, #16]\n\tb\tL_topo_epilogue\nL_topo_sysctl_fail:\n\tadd\tsp, sp, #16\nL_topo_fail_zero:\n; OOM / sysctl / zero-core failure: still return a non-NULL 24-byte record (cores, numa_nodes, cache_hierarchy\n; pointers all nil) so Silica callers can field-load and length(empty) without SIGSEGV. If malloc fails, return NULL.\n\tmov\tx0, #24\n\tbl\t_malloc\n\tcbz\tx0, L_topo_null_ret\n\tstp\txzr, xzr, [x0]\n\tstr\txzr, [x0, #16]\n\tb\tL_topo_epilogue\nL_topo_null_ret:\n\tmov\tx0, xzr\nL_topo_epilogue:\n\tldp\tx27, x28, [sp, #80]\n\tldp\tx25, x26, [sp, #64]\n\tldp\tx23, x24, [sp, #48]\n\tldp\tx21, x22, [sp, #32]\n\tldp\tx19, x20, [sp, #16]\n\tldp\tx29, x30, [sp], #96\n\tret\n\t.cfi_endproc\n\t.globl\t_silica_rt_get_core_capabilities\n\t.p2align\t2\n_silica_rt_get_core_capabilities:\n\t.cfi_startproc\n\tstp\tx29, x30, [sp, #-80]!\n\tstp\tx19, x20, [sp, #16]\n\tstp\tx21, x22, [sp, #32]\n\tstp\tx23, x24, [sp, #48]\n\tstp\tx25, x26, [sp, #64]\n\tmov\tx29, sp\n\tmov\tx28, x0\n\tsub\tsp, sp, #16\n\tmov\tw0, #4\n\tstr\tw0, [sp, #8]\n\tstr\twzr, [sp]\n\tadrp\tx0, L_hw_perf0_str@PAGE\n\