L_str_9_d:
    .ascii "\tadd\tx0, x20, #80\n\tbl\t_silica_rt_cv_signal\n\tadd\tx0, x20, #16\n\tbl\t_os_unfair_lock_unlock\n\tb\tLBB4_wait_start\nLBB4_dead_locked:\n\tadd\tx0, x20, #16\n\tbl\t_os_unfair_lock_unlock\n\tmov\tx0, x19\n\tbl\t_free\n\tmov\tx0, #0\n\tb\tLBB4_9\nLBB4_wait_start:\n\tadd\tx0, x19, #72\n\tbl\t_os_unfair_lock_lock\n\tldr\tw8, [x19, #136]\n\tcbnz\tw8, LBB4_8\nLBB4_7:                                 ; =>This Inner Loop Header: Depth=1\n; Phase E e4f: blocking pthread_cond_wait. Earlier 1 ms timedwait_relative_np was a missed-signal\n; band-aid that, under macOS arm64 with 3+ concurrent supervised actors, drove a libpthread\n; internal kwq malloc storm racing with new-actor TLS instantiation (mfm_alloc\n; KERN_PROTECTION_FAILURE SIGBUS in _calloc / _tlv_get_addr). All wake paths for the call\n; wrapper (worker reply, supervisor cascade kill+restart, etc.) hold wrapper#72 and signal\n; wrapper#24 before unlock, so a properly-locked plain wait is sufficient. We still check\n; reply_set on each wake to absorb spurious wakeups.\n\tadd\tx0, x19, #24\n\tadd\tx1, x19, #72\n\tbl\t_silica_rt_cv_wait\n\tldr\tw8, [x19, #136]\n\tcbz\tw8, LBB4_7\nLBB4_8:\n\tldr\tx20, [x19, #144]\n\tadd\tx0, x19, #72\n\tbl\t_os_unfair_lock_unlock\n; Phase E e4f: wrapper+72 (os_unfair_lock) and wrapper+24 (futex seq word) have no\n; out-of-line state, so freeing the wrapper buffer reclaims everything. No destroy call needed.\n\tmov\tx0, x19\n\tbl\t_free\n\tmov\tx0, x20\nLBB4_9:\n\tldp\tx29, x30, [sp, #32]             ; 16-byte Folded Reload\n\tldp\tx20, x19, [sp, #16]             ; 16-byte Folded Reload\n\tldp\tx22, x21, [sp], #48             ; 16-byte Folded Reload\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_call_registered ; -- Begin function silica_rt_actor_call_registered\n\t.p2align\t2\n_silica_rt_actor_call_registered:       ; @silica_rt_actor_call_registered\n\t.cfi_startproc\n; X0=atom registry key, X1=message. Resolve through the global PID registry, then tail-call actor_call.\n\tmov\tx11, x0\n\tmov\tx12, x1\n\tadrp\tx8, _silica_pid_registry_ref@PAGE\n\tldr\tx8, [x8, _silica_pid_registry_ref@PAGEOFF]\n\tcbz\tx8, LBB4r_not_found\n\tldr\tx9, [x8]\n\tcbz\tx9, LBB4r_not_found\n\tcmp\tx11, #0\n\tb.lt\tLBB4r_not_found\n\tcmp\tx11, #240\n\tb.ge\tLBB4r_not_found\n\tldr\tx10, [x9, x11, lsl #3]\n\tcmp\tx10, #1\n\tb.ne\tLBB4r_not_found\n\tadd\tx9, x9, #1920\n\tldr\tx0, [x9, x11, lsl #3]\n\tcbz\tx0, LBB4r_not_found\n\tmov\tx1, x12\n\tb\t_silica_rt_actor_call\nLBB4r_not_found:\n\tmov\tx0, #0\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_cast_registered ; -- Begin function silica_rt_actor_cast_registered\n\t.p2align\t2\n_silica_rt_actor_cast_registered:       ; @silica_rt_actor_cast_registered\n\t.cfi_startproc\n; X0=atom registry key, X1=message. Resolve through the global PID registry, then tail-call actor_cast.\n\tmov\tx11, x0\n\tmov\tx12, x1\n\tadrp\tx8, _silica_pid_registry_ref@PAGE\n\tldr\tx8, [x8, _silica_pid_registry_ref@PAGEOFF]\n\tcbz\tx8, LBB3r_not_found\n\tldr\tx9, [x8]\n\tcbz\tx9, LBB3r_not_found\n\tcmp\tx11, #0\n\tb.lt\tLBB3r_not_found\n\tcmp\tx11, #240\n\tb.ge\tLBB3r_not_found\n\tldr\tx10, [x9, x11, lsl #3]\n\tcmp\tx10, #1\n\tb.ne\tLBB3r_not_found\n\tadd\tx9, x9, #1920\n\tldr\tx0, [x9, x11, lsl #3]\n\tcbz\tx0, LBB3r_not_found\n\tmov\tx1, x12\n\tb\t_silica_rt_actor_cast\nLBB3r_not_found:\n\tmov\tx0, #0\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_cast_dangerous_registered ; -- Begin function silica_rt_actor_cast_dangerous_registered\n\t.p2align\t2\n_silica_rt_actor_cast_dangerous_registered:       ; @silica_rt_actor_cast_dangerous_registered\n\t.cfi_startproc\n; X0=atom registry key, X1=message. Resolve through the dangerous PID registry, then tail-call actor_cast.\n\tmov\tx11, x0\n\tmov\tx12, x1\n\tadrp\tx8, _silica_dangerous_pid_registry_ref@PAGE\n