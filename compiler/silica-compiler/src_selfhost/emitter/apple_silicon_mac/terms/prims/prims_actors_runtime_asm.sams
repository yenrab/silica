L_str_35_d:
    .ascii "\t.section\t__TEXT,__text,regular,pure_instructions\n\t.globl\t_silica_rt_cv_signal\n\t.p2align\t2\n_silica_rt_cv_signal:                   ; X0 = cv_addr (4-byte futex word). Caller must hold the lock paired with this CV.\n\t.cfi_startproc\n\tstp\tx29, x30, [sp, #-32]!\n\tstp\tx19, x20, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tmov\tx19, x0\n; bump seq (32-bit; wraparound after 4G signals is fine — only mismatch w/ waiter snapshot matters)\n\tldr\tw8, [x19]\n\tadd\tw8, w8, #1\n\tstr\tw8, [x19]\n; ___ulock_wake(UL_COMPARE_AND_WAIT_SHARED=3, cv_addr, 0).\n; bsd/sys/ulock.h: userland heap futex words use UL_COMPARE_AND_WAIT_SHARED (3).\n\tmov\tw0, #3\n\tmov\tx1, x19\n\tmov\tx2, #0\n\tbl\t___ulock_wake\n\tldp\tx19, x20, [sp, #16]\n\tldp\tx29, x30, [sp], #32\n\tret\n\t.cfi_endproc\n\t.globl\t_silica_rt_cv_wait\n\t.p2align\t2\n_silica_rt_cv_wait:                     ; X0 = cv_addr, X1 = lock_addr. Caller must hold lock; lock held on return.\n\t.cfi_startproc\n\tstp\tx29, x30, [sp, #-48]!\n\tstp\tx19, x20, [sp, #16]\n\tstp\tx21, x22, [sp, #32]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\t.cfi_offset w21, -40\n\t.cfi_offset w22, -48\n\tmov\tx19, x0                         ; cv_addr (callee-saved)\n\tmov\tx20, x1                         ; lock_addr (callee-saved)\n; snapshot seq (under lock)\n\tldr\tw22, [x19]\n; release lock\n\tmov\tx0, x20\n\tbl\t_os_unfair_lock_unlock\n; ___ulock_wait(UL_COMPARE_AND_WAIT_SHARED=3, cv_addr, snapshot, 0 = no timeout).\n\tmov\tw0, #3\n\tmov\tx1, x19\n\tmov\tx2, x22\n\tmov\tw3, #0\n\tbl\t___ulock_wait\n; re-acquire lock\n\tmov\tx0, x20\n\tbl\t_os_unfair_lock_lock\n\tldp\tx21, x22, [sp, #32]\n\tldp\tx19, x20, [sp, #16]\n\tldp\tx29, x30, [sp], #48\n\tret\n\t.cfi_endproc\n"
    .byte 0
    .p2align 3
