    .ascii "_silica_rt_pin_actor_to_performance_core: ; @silica_rt_pin_actor_to_performance_core\n\t.cfi_startproc\n; %bb.0: X0=actor_ref; pin to any P-core via affinity tag 0x50 ('P')\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tldr\tx0, [x0, #144]\n\tbl\t_pthread_mach_thread_np\n\tmov\tx20, x0\n\tsub\tsp, sp, #16\n\tmov\tw8, #0x50\n\tstr\tw8, [sp]\n\tmov\tx0, x20\n\tmov\tw1, #4\n\tmov\tx2, sp\n\tmov\tw3, #1\n\tbl\t_thread_policy_set\n\tadd\tsp, sp, #16\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_pin_actor_realtime   ; -- Begin function silica_rt_pin_actor_realtime\n\t.p2align\t2\n_silica_rt_pin_actor_realtime:          ; @silica_rt_pin_actor_realtime\n\t.cfi_startproc\n; %bb.0: X0=actor_ref; stub (realtime policy requires THREAD_TIME_CONSTRAINT_POLICY)\n\tmov\tx0, #0                          ; =0x0\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_remove_actor         ; -- Begin function silica_rt_remove_actor\n\t.p2align\t2\n_silica_rt_remove_actor:                ; @silica_rt_remove_actor\n\t.cfi_startproc\n; %bb.0: X0=actor_ref; set alive=0, signal cond to wake thread\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tmov\tx19, x0\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_lock\n\tstr\twzr, [x19, #152]\n\tadd\tx0, x19, #80\n\tbl\t_silica_rt_cv_signal\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_unlock\n\tmov\tx0, #0\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_register_actor_named ; -- Begin function silica_rt_register_actor_named\n\t.p2align\t2\n_silica_rt_register_actor_named:        ; @silica_rt_register_actor_named\n\t.cfi_startproc\n; X0=actor_ref, X1=atom registry key. Insert directly into the PID registry table.\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tmov\tx19, x0\n\tmov\tx20, x1\n\tadrp\tx8, _silica_pid_registry_ref@PAGE\n\tldr\tx8, [x8, _silica_pid_registry_ref@PAGEOFF]\n\tcbz\tx8, Lreg_named_done\n\tldr\tx9, [x8]\n\tcbz\tx9, Lreg_named_done\n\tcmp\tx20, #0\n\tb.lt\tLreg_named_done\n\tcmp\tx20, #240\n\tb.ge\tLreg_named_done\n\tmov\tx10, #1\n\tstr\tx10, [x9, x20, lsl #3]\n\tadd\tx9, x9, #1920\n\tstr\tx19, [x9, x20, lsl #3]\nLreg_named_done:\n\tmov\tx0, #0\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_register_dangerous_actor_named ; -- Begin function silica_rt_register_dangerous_actor_named\n\t.p2align\t2\n_silica_rt_register_dangerous_actor_named:        ; @silica_rt_register_dangerous_actor_named\n\t.cfi_startproc\n; X0=actor_ref, X1=atom registry key. Insert directly into the dangerous PID registry table.\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tmov\tx19, x0\n\tmov\tx20, x1\n\tadrp\tx8, _silica_dangerous_pid_registry_ref@PAGE\n\tldr\tx8, [x8, _silica_dangerous_pid_registry_ref@PAGEOFF]\n\tcbz\tx8, Lreg_danger_named_done\n\tldr\tx9, [x8]\n\tcbz\tx9, Lreg_danger_named_done\n\tcmp\tx20, #0\n\tb.lt\tLreg_danger_named_done\n\tcmp\tx20, #240\n\tb.ge\tLreg_danger_named_done\n\tmov\tx10, #1\n\tstr\tx10, [x9, x20, lsl #3]\n\tadd\tx9, x9, #1920\n\tstr\tx19, [x9, x20, lsl #3]\nLreg_danger_named_done:\n\tmov\tx0, #0\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_register_actor       ; -- Begin function silica_rt_register_actor\n\t.p2align\t2\n_silica_rt_register_actor:              ; @silica_rt_register_actor\n\t.cfi_startproc\n; Legacy unary register_actor(actor_ref). The global slot belongs to the PID registry actor;\n; named insertion is handled by _silica_rt_register_actor_named.\n\tmov\tx0, #0\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_get_registry_actor   ; -- Begin function silica_rt_get_registry_actor\n\t.p2align\t2\n_silica_rt_get_registry_actor:          ; @silica_rt_get_registry_actor\n\t.cfi_startproc\n; %bb.0: Returns actor_ref stored by register_actor (or 0 if not yet initialised). X0=actor_ref.\n\tadrp\tx0, _silica_pid_registry_ref@PAGE\n\tldr\tx0, [x0, _silica_pid_registry_ref@PAGEOFF]\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n; Phase E e4b: _silica_rt_actor_kill_abnormal — set pending exit reason_tag to 1 (abnormal) and stop the actor.\n; X0=actor_ref or atom registry key. Returns X0=0 (atom :ok). Used by trials to inject abnormal exits so :transient restart policy\n; (restart iff reason_tag != 0) can be exercised. Mutex protects the alive/reason_tag transition vs\n; deliver_exit reading [ACB+#336] from the actor's own thread.\n\t.globl\t_silica_rt_actor_kill_abnormal\n\t.p2align\t2\n_silica_rt_actor_kill_abnormal:\n\t.cfi_startproc\n\tstp\tx21, x20, [sp, #-48]!\n\tstp\tx29, x30, [sp, #16]\n\tstr\tx19, [sp, #32]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n; Accept atom target by resolving through PID registry (same table layout as call_registered/cast_registered).\n\tmov\tx11, x0\n\tcmp\tx11, #0\n\tb.lt\tLkab_use_direct\n\tcmp\tx11, #240\n\tb.ge\tLkab_use_direct\n\tadrp\tx8, _silica_pid_registry_ref@PAGE\n\tldr\tx8, [x8, _silica_pid_registry_ref@PAGEOFF]\n\tcbz\tx8, Lkab_not_found\n\tldr\tx9, [x8]\n\tcbz\tx9, Lkab_not_found\n\tldr\tx10, [x9, x11, lsl #3]\n\tcmp\tx10, #1\n\tb.ne\tLkab_not_found\n\tadd\tx9, x9, #1920\n\tldr\tx0, [x9, x11, lsl #3]\n\tcbz\tx0, Lkab_not_found\n\tb\tLkab_resolved\nLkab_use_direct:\n\tmov\tx0, x11\nLkab_resolved:\n\tmov\tx19, x0\n\tcbz\tx19, Lkab_not_found\n\tldr\tx20, [x19, #208]\n\tldr\tx21, [x19, #192]\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_lock\n\tmov\tx8, #1\n\tstr\tx8, [x19, #336]\n\tstr\twzr, [x19, #152]\n\tadd\tx0, x19, #80\n\tbl\t_silica_rt_cv_signal\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_unlock\n\tcmp\tx20, #4096\n\tb.lo\tLkab_not_found\n\tbl\t_silica_rt_tls_current_actor_get\n\tcmp\tx0, x19\n\tb.eq\tLkab_not_found\nLkab_wait_exit_done:\n\tldr\tx8, [x20, #56]\n\tcbz\tx8, Lkab_wait_exit_done\n\tcbz\tx21, Lkab_not_found\n\tmov\tx0, x21\n\tbl\t_silica_rt_supervisor_drain_ingress\nLkab_not_found:\n\tmov\tx0, #0\n\tldr\tx19, [sp, #32]\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx21, x20, [sp], #48\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_pin_actor_to_numa_node ; -- Begin function silica_rt_pin_actor_to_numa_node\n\t.p2align\t2\n_silica_rt_pin_actor_to_numa_node:      ; @silica_rt_pin_actor_to_numa_node\n\t.cfi_startproc\n; %bb.0: N/A on Apple Silicon (single NUMA domain)\n\tmov\tx0, #0                          ; =0x0\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_unpin_actor          ; -- Begin function silica_rt_unpin_actor\n\t.p2align\t2\n_silica_rt_unpin_actor:                 ; @silica_rt_unpin_actor\n\t.cfi_startproc\n; %bb.0: X0=actor_ref; clear affinity by setting tag=0\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tldr\tx0, [x0, #144]\n\tbl\t_pthread_mach_thread_np\n\tmov\tx20, x0\n\tsub\tsp, sp, #16\n\tstr\twzr, [sp]\n\tmov\tx0, x20\n\tmov\tw1, #4\n\tmov\tx2, sp\n\tmov\tw3, #1\n\tbl\t_thread_policy_set\n\tadd\tsp, sp, #16\n\tmov\tx0, #0\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_set_actor_priority   ; -- Begin function silica_rt_set_actor_priority\n\t.p2align\t2\n_silica_rt_set_actor_priority:          ; @silica_rt_set_actor_priority\n\t.cfi_startproc\n; %bb.0: X0=actor_ref X1=priority; map to pthread QoS class\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tmov\tx19, x1\n\tldr\tx0, [x0, #144]\n\tcmp\tx19, #3\n\tb.ge\tLBBsp_interactive\n\tcmp\tx19, #2\n\tb.eq\tLBBsp_initiated\n\tcmp\tx19, #1\n\tb.eq\tLBBsp_default\n\tcmp\tx19, #0\n\tb.eq\tLBBsp_utility\n\tmov\tw1, #0x09\n\tb\tLBBsp_set\nLBBsp_interactive:\n\tmov\tw1, #0x21\n\tb\tLBBsp_set\nLBBsp_initiated:\n\tmov\tw1, #0x19\n\tb\tLBBsp_set\nLBBsp_default:\n\tmov\tw1, #0x15\n\tb\tLBBsp_set\nLBBsp_utility:\n\tmov\tw1, #0x11\nLBBsp_set:\n\tmov\tw2, #0\n\tbl\t_pthread_set_qos_class_np\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n"
