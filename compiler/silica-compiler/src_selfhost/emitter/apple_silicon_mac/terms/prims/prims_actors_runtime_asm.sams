L_str_17_d:
    .ascii "\t.section\t__TEXT,__cstring,cstring_literals\n\t.p2align\t2\nL_silica_root_actor_exit:\n\t.asciz\t\"[silica] root actor exited (no supervisor)\\n\"\n\t.section\t__TEXT,__text,regular,pure_instructions\n\t.globl\t_silica_rt_migrate_actor        ; -- Begin function silica_rt_migrate_actor\n\t.p2align\t2\n_silica_rt_migrate_actor:               ; @silica_rt_migrate_actor\n\t.cfi_startproc\n; X0=actor_ref X1=target_core; sets thread affinity to target core\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tmov\tx19, x1\n\tldr\tx0, [x0, #144]\n\tbl\t_pthread_mach_thread_np\n\tmov\tx20, x0\n\tsub\tsp, sp, #16\n\tstr\tw19, [sp]\n\tmov\tx0, x20\n\tmov\tw1, #4\n\tmov\tx2, sp\n\tmov\tw3, #1\n\tbl\t_thread_policy_set\n\tadd\tsp, sp, #16\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_move_actor           ; -- Begin function silica_rt_move_actor\n\t.p2align\t2\n_silica_rt_move_actor:                  ; @silica_rt_move_actor\n\t.cfi_startproc\n; X0=actor_ref X1=from_core X2=to_core; migrate actor to target core\n\tstp\tx22, x21, [sp, #-48]!\n\tstp\tx20, x19, [sp, #16]\n\tstp\tx29, x30, [sp, #32]\n\tadd\tx29, sp, #32\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\t.cfi_offset w21, -40\n\t.cfi_offset w22, -48\n\tmov\tx19, x2\n\tldr\tx0, [x0, #144]\n\tbl\t_pthread_mach_thread_np\n\tmov\tx20, x0\n\tsub\tsp, sp, #16\n\tstr\tw19, [sp]\n\tmov\tx0, x20\n\tmov\tw1, #4\n\tmov\tx2, sp\n\tmov\tw3, #1\n\tbl\t_thread_policy_set\n\tadd\tsp, sp, #16\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n"
