L_str_18_d:
    .ascii "\t.section\t__TEXT,__text,regular,pure_instructions\n\t.globl\t_silica_rt_get_actor_memory_usage ; -- Begin function silica_rt_get_actor_memory_usage\n\t.p2align\t2\n_silica_rt_get_actor_memory_usage:      ; @silica_rt_get_actor_memory_usage\n\t.cfi_startproc\n; X0=actor_ref -> X0=bytes mapped in actor's growable region\n\tldr\tx0, [x0, #168]\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_region_alloc         ; -- Begin function silica_rt_region_alloc\n\t.p2align\t2\n_silica_rt_region_alloc:                ; @silica_rt_region_alloc\n\t.cfi_startproc\n; X0=size. Bump-allocates from current actor's mmap region.\n; Falls back to _malloc if not in actor context.\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tmov\tx19, x0\n\tbl\t_silica_rt_tls_current_actor_get\n\tmov\tx20, x0\n\tcbz\tx20, LBBra_fallback\n\tldr\tx8, [x20, #176]\n\tcbz\tx8, LBBra_fallback\n\tadd\tx9, x8, x19\n\tadd\tx9, x9, #7\n\tbic\tx9, x9, #7\n\tstr\tx9, [x20, #176]\n\tmov\tx0, x8\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\nLBBra_fallback:\n\tadd\tx0, x19, #16\n\tbl\t_malloc\n\tcbz\tx0, LBBra_oom\n\tadrp\tx8, _silica_rt_region_list@PAGE\n\tadd\tx8, x8, _silica_rt_region_list@PAGEOFF\n\tldr\tx9, [x8]\n\tstr\tx9, [x0]\n\tstr\tx19, [x0, #8]\n\tstr\tx0, [x8]\n\tadd\tx0, x0, #16\nLBBra_oom:\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n\t.globl\t_silica_rt_raw_alloc\n_silica_rt_raw_alloc:\n; X0=size. malloc with a [next][size] header, NOT linked into the global region\n; list. Region memory must be freeable by its owner; anything on that list can\n; only be freed by unwinding to a mark, which is scope-shaped and unsound here.\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\tmov\tx19, x0\n\tadd\tx0, x19, #16\n\tbl\t_malloc\n\tcbz\tx0, LBBrw_oom\n\tstr\txzr, [x0]\n\tstr\tx19, [x0, #8]\n\tadd\tx0, x0, #16\nLBBrw_oom:\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.globl\t_silica_rt_region_destroy\n_silica_rt_region_destroy:\n; X0=region handle. Frees every extension block on the [r+16] chain, then the\n; region header. Blocks come from _silica_rt_raw_alloc, so each malloc base is\n; payload-16. Null handle is a no-op so a moved-out region is safe to skip.\n\tcbz\tx0, LBBrd_ret\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\tstr\tx21, [sp, #-16]!\n\tmov\tx19, x0\n\tldr\tx20, [x19, #16]\nLBBrd_loop:\n\tcbz\tx20, LBBrd_hdr\n\tldr\tx21, [x20, #16]\n\tsub\tx0, x20, #16\n\tbl\t_free\n\tmov\tx20, x21\n\tb\tLBBrd_loop\nLBBrd_hdr:\n\tsub\tx0, x19, #16\n\tbl\t_free\n\tldr\tx21, [sp], #16\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\nLBBrd_ret:\n\tret\n\t.globl\t_silica_rt_region_mark\n_silica_rt_region_mark:\n\tadrp\tx16, _silica_rt_region_list@PAGE\n\tadd\tx16, x16, _silica_rt_region_list@PAGEOFF\n\tldr\tx16, [x16]\n\tret\n\t.globl\t_silica_rt_region_release_to\n_silica_rt_region_release_to:\n\tstp\tx29, x30, [sp, #-16]!\n\tstp\tx0, x1, [sp, #-16]!\n\tstp\tx19, x20, [sp, #-16]!\n\tstp\tx21, x22, [sp, #-16]!\n\tmov\tx21, x16\n\tadrp\tx19, _silica_rt_region_list@PAGE\n\tadd\tx19, x19, _silica_rt_region_list@PAGEOFF\n\tldr\tx20, [x19]\nLrrt_loop:\n\tcmp\tx20, x21\n\tb.eq\tLrrt_done\n\tcbz\tx20, Lrrt_done\n\tldr\tx1, [x20]\n\tstr\tx1, [x19]\n\tmov\tx0, x20\n\tmov\tx20, x1\n\tbl\t_free\n\tb\tLrrt_loop\nLrrt_done:\n\tstr\tx21, [x19]\n\tldp\tx21, x22, [sp], #16\n\tldp\tx19, x20, [sp], #16\n\tldp\tx0, x1, [sp], #16\n\tldp\tx29, x30, [sp], #16\n\tret\n\t.globl\t_silica_rt_region_list\n\t.comm\t_silica_rt_region_list,8,3\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_supervision_ingress_enqueue ; Phase B — synthetic exit / trial hook; bounded queue\n\t.p2align\t2\n_silica_rt_actor_supervision_ingress_enqueue:\n\t.cfi_startproc\n; X0=target actor_ref, X1=int64 payload → X0=:ok (0). Cast-shaped 152 B node; +8 = inline int64; +24 = 1 (trial; not heap payload).\n\tstp\tx22, x21, [sp, #-48]!\n\tstp\tx20, x19, [sp, #16]\n\tstp\tx29, x30, [sp, #32]\n\tadd\tx29, sp, #32\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\t.cfi_offset w21, -40\n\t.cfi_offset w22, -48\n\tmov\tx19, x0\n\tmov\tx21, x1\n\tcbz\tx19, Lsie_fail_nolock\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_lock\n\tldr\tw9, [x19, #248]\n\tcmp\tw9, #1024\n\tb.hs\tLsie_abort\n\tmov\tw0, #1\n\tmov\tw1, #152\n\tbl\t_calloc\n\tcbz\tx0, Lsie_unlock_fail\n\tmov\tx20, x0\n\tstr\tx21, [x20, #8]\n\tstr\twzr, [x20, #16]\n\tmov\tw9, #1\n\tstr\tw9, [x20, #24]\n\tadd\tx0, x19, #232\n\tmov\tx1, x20\n\tbl\t_silica_rt_q_enqueue_locked\n\tldr\tw9, [x19, #248]\n\tadd\tw9, w9, #1\n\tstr\tw9, [x19, #248]\n\tadd\tx0, x19, #80\n\tbl\t_silica_rt_cv_signal\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_unlock\n\tmov\tx0, #0\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\nLsie_unlock_fail:\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_unlock\nLsie_fail_nolock:\n\tmov\tx0, #0\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\nLsie_abort:\n\tbl\t_abort\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_recv           ; Phase B/C/G — ingress then standard; §15.4.8.6 DOWN only on standard\n\t.p2align\t2\n_silica_rt_actor_recv:                  ; @silica_rt_actor_recv\n\t.cfi_startproc\n; TLS current actor: dequeue next message (supervision ingress first, then standard mailbox). Return X0 = message node or 0.\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tbl\t_silica_rt_tls_current_actor_get\n\tmov\tx19, x0\n\tcbz\tx19, Lrecv_done_null\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_lock\n\tadd\tx0, x19, #232\n\tbl\t_silica_rt_q_dequeue_locked\n\tmov\tx20, x0\n\tcbz\tx20, Lrecv_try_std\n\tldr\tw9, [x19, #248]\n\tsub\tw9, w9, #1\n\tstr\tw9, [x19, #248]\n\tb\tLrecv_unlock_node\nLrecv_try_std:\n\tadd\tx0, x19, #128\n\tbl\t_silica_rt_q_dequeue_locked\n\tmov\tx20, x0\nLrecv_unlock_node:\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_unlock\n\tmov\tx0, x20\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\nLrecv_done_null:\n\tmov\tx0, #0\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_add_child      ; Explicit supervisor child registration\n\t.p2align\t2\n_silica_rt_actor_add_child:             ; @silica_rt_actor_add_child\n\t.cfi_startproc\n; X0=parent supervisor actor_ref, X1=child actor_ref -> X0=atom :ok.\n; Records the explicit parent/child relationship used by supervisor ingress teardown.\n\tcbz\tx0, Ladd_child_done\n\tcbz\tx1, Ladd_child_done\n\tstp\tx20, x19, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\tmov\tx19, x0\n\tmov\tx20, x1\n\tstr\tx19, [x20, #192]\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_lock\n\tldr\tx8, [x19, #216]\n\tstr\tx8, [x20, #224]\n\tstr\tx20, [x19, #216]\n\tadd\tx0, x19, #16\n\tbl\t_os_unfair_lock_unlock\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\nLadd_child_done:\n\tmov\tx0, #0\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_link           ; Phase G — §15.4.8.4–8.5\n\t.p2align\t2\n_silica_rt_actor_link:                  ; @silica_rt_actor_link\n\t.cfi_startproc\n; X0=target actor_ref -> X0=atom :ok (index 0). Idempotent link; dead target must enqueue exit (ingress if supervisor) — stub.\n\tmov\tx0, #0\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_monitor        ; Phase G — §15.4.8.6\n\t.p2align\t2\n_silica_rt_actor_monitor:               ; @silica_rt_actor_monitor\n\t.cfi_startproc\n; X0=target -> X0=monitor_ref. Real runtime: DOWN `(:down, ref, target, reason)` to standard mailbox only, not ingress.\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_demonitor      ; Phase G — §15.4.8.6–8.7\n\t.p2align\t2\n_silica_rt_actor_demonitor:             ; @silica_rt_actor_demonitor\n\t.cfi_startproc\n; X0=monitor_ref -> X0=atom :ok\n\tmov\tx0, #0\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n"
    .byte 0
    .p2align 3
