    .ascii "\t.section\t__TEXT,__text,regular,pure_instructions\n\t.globl\t_silica_rt_ensure_actor_tls_key\n\t.p2align\t2\n_silica_rt_ensure_actor_tls_key:\n\t.cfi_startproc\n\tstp\tx21, x20, [sp, #-32]!\n\tstp\tx29, x30, [sp, #16]\n\tadd\tx29, sp, #16\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w21, -32\n\t.cfi_offset w20, -24\n\tadrp\tx20, _silica_actor_tls_key_ready@PAGE\n\tadd\tx20, x20, _silica_actor_tls_key_ready@PAGEOFF\n\tldrb\tw8, [x20]\n\tcbnz\tw8, L_tlse_done\n\tadrp\tx0, _silica_actor_tls_init_lock@PAGE\n\tadd\tx0, x0, _silica_actor_tls_init_lock@PAGEOFF\n\tbl\t_os_unfair_lock_lock\n\tldrb\tw8, [x20]\n\tcbnz\tw8, L_tlse_unlock\n\tadrp\tx0, _silica_actor_pthread_key@PAGE\n\tadd\tx0, x0, _silica_actor_pthread_key@PAGEOFF\n\tmov\tx1, xzr\n\tbl\t_pthread_key_create\n\tcbnz\tw0, L_tlse_unlock\n\tmov\tw8, #1\n\tstrb\tw8, [x20]\nL_tlse_unlock:\n\tadrp\tx0, _silica_actor_tls_init_lock@PAGE\n\tadd\tx0, x0, _silica_actor_tls_init_lock@PAGEOFF\n\tbl\t_os_unfair_lock_unlock\nL_tlse_done:\n\tldp\tx29, x30, [sp, #16]\n\tldp\tx21, x20, [sp], #32\n\tret\n\t.cfi_endproc\n\t.globl\t_silica_rt_tls_current_actor_get\n\t.p2align\t2\n_silica_rt_tls_current_actor_get:\n\t.cfi_startproc\n\tstp\tx29, x30, [sp, #-16]!\n\tmov\tx29, sp\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\tbl\t_silica_rt_ensure_actor_tls_key\n\tadrp\tx8, _silica_actor_pthread_key@PAGE\n\tadd\tx8, x8, _silica_actor_pthread_key@PAGEOFF\n\tldr\tx0, [x8]\n\tbl\t_pthread_getspecific\n\tldp\tx29, x30, [sp], #16\n\tret\n\t.cfi_endproc\n\t.globl\t_silica_rt_tls_actor_set_from_x19\n\t.p2align\t2\n_silica_rt_tls_actor_set_from_x19:\n\t.cfi_startproc\n; Preserve ACB on the stack across pthread_setspecific without clobbering callee-saved x21.\n\tstp\tx29, x30, [sp, #-32]!\n\tmov\tx29, sp\n\tstr\tx19, [sp, #16]\n\tbl\t_silica_rt_ensure_actor_tls_key\n\tldr\tx1, [sp, #16]\n\tadrp\tx8, _silica_actor_pthread_key@PAGE\n\tadd\tx8, x8, _silica_actor_pthread_key@PAGEOFF\n\tldr\tx0, [x8]\n\tbl\t_pthread_setspecific\n\tldr\tx19, [sp, #16]\n\tldp\tx29, x30, [sp], #32\n\tret\n\t.cfi_endproc\n\t.p2align\t2\n_silica_rt_actor_init_region:           ; init growable stack region for actor\n\t.cfi_startproc\n; X0=actor_ptr. Reserves 1GB VA, maps first 8MB, stores region metadata at [160..184]. Supervision fields [192..224] unused here.\n; Also installs synchronous fault handlers (Phase 13) on first call.\n\tstp\tx22, x21, [sp, #-48]!\n\tstp\tx20, x19, [sp, #16]\n\tstp\tx29, x30, [sp, #32]\n\tadd\tx29, sp, #32\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\t.cfi_offset w21, -40\n\t.cfi_offset w22, -48\n\tmov\tx19, x0\nLloh_ir0:\n\tadrp\tx8, _silica_rt_sync_fault_handlers_installed@PAGE\nLloh_ir1:\n\tadd\tx8, x8, _silica_rt_sync_fault_handlers_installed@PAGEOFF\n\tldr\tw9, [x8]\n\tcbnz\tw9, LBBir_skip_handler\n\tbl\t_silica_rt_install_sync_fault_handlers\nLBBir_skip_handler:\n\tmov\tx0, #0\n\tmovz\tx1, #0x4000, lsl #16\n\tmov\tw2, #0\n\tmovz\tw3, #0x1002\n\tmov\tw4, #-1\n\tmov\tx5, #0\n\tbl\t_mmap\n\tcmn\tx0, #1\n\tb.eq\tLBBir_fail\n\tmov\tx20, x0\n\tmovz\tx1, #0x80, lsl #16\n\tmov\tw2, #3\n\tbl\t_mprotect\n\tstr\tx20, [x19, #160]\n\tmovz\tx8, #0x80, lsl #16\n\tstr\tx8, [x19, #168]\n\tadd\tx8, x20, #256\n\tstr\tx8, [x19, #176]\n\tmovz\tx8, #0x4000, lsl #16\n\tstr\tx8, [x19, #184]\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\nLBBir_fail:\n\tstr\txzr, [x19, #160]\n\tstr\txzr, [x19, #168]\n\tstr\txzr, [x19, #176]\n\tstr\txzr, [x19, #184]\n\tldp\tx29, x30, [sp, #32]\n\tldp\tx20, x19, [sp, #16]\n\tldp\tx22, x21, [sp], #48\n\tret\n\t.loh AdrpAdd\tLloh_ir0, Lloh_ir1\n\t.cfi_endproc\n                                        ; -- End function\n\t.p2align\t2\n_silica_rt_actor_dealloc_region:        ; release actor's growable stack region\n\t.cfi_startproc\n; X0=actor_ptr. munmap(region_base, total_size).\n\tstp\tx29, x30, [sp, #-16]!\n\tmov\tx29, sp\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\tldr\tx8, [x0, #184]\n\tldr\tx0, [x0, #160]\n\tcbz\tx0, LBBdr_skip\n\tmov\tx1, x8\n\tbl\t_munmap\nLBBdr_skip:\n\tldp\tx29, x30, [sp], #16\n\tret\n\t.cfi_endproc\n                                        ; -- End function\n"
