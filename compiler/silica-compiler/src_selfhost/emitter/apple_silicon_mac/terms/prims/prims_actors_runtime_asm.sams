n\tbl\t_os_unfair_lock_unlock\nLBBsigpend_done:\n\tldp\tx29, x30, [sp, #48]\n\tldp\tx20, x19, [sp, #32]\n\tldp\tx22, x21, [sp, #16]\n\tldp\tx24, x23, [sp], #64\n\tret\n                                        ; -- End function\n\t.globl\t_silica_rt_actor_call           ; -- Begin function silica_rt_actor_call\n\t.p2align\t2\n_silica_rt_actor_call:                  ; @silica_rt_actor_call\n\t.cfi_startproc\n; %bb.0:\n\tstp\tx22, x21, [sp, #-48]!           ; 16-byte Folded Spill\n\tstp\tx20, x19, [sp, #16]             ; 16-byte Folded Spill\n\tstp\tx29, x30, [sp, #32]             ; 16-byte Folded Spill\n\tadd\tx29, sp, #32\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\t.cfi_offset w21, -40\n\t.cfi_offset w22, -48\n\tmov\tx20, x0\n\tmov\tx0, #0                          ; =0x0\n\tcbz\tx20, LBB4_9\n; %bb.1:\n\tmov\tx21, x1\n; %bb.2:\n\tmov\tw22, #1                         ; =0x1\n\tmov\tw0, #1                          ; =0x1\n\tmov\tw1, #152                        ; =0x98\n\tbl\t_calloc\n\tcbz\tx0, LBB4_9\n; %bb.3:\n\tmov\tx19, x0\n\tstr\tx21, [x0, #8]\n\tstr\tw22, [x0, #16]\n; Phase E e4f: wrapper+72 is an os_unfair_lock (4 B) and wrapper+24 is a 4 B futex seq word.\n; Both are pre-zeroed by calloc; no init call required.\n\tadd\tx0, x20, #16\n\tbl\t_os_unfair_lock_lock\n\tldr\tw8, [x20, #152]\n\tcbz\tw8, LBB4_dead_locked\n\tadd\tx0, x20, #128\n\tmov\tx1, x19\n\tbl\t_silica_rt_q_enqueue_locked\n"
