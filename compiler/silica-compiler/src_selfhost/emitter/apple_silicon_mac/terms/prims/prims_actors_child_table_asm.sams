L_str_34_d:
    .ascii "Lmr_ofo:\n; Phase E e4f: pass row_ptr (x24) as X3 so the new child's actor_thread_main can flag\n; this row's exit_done on its own teardown; clear stale exit_done from prior incarnation.\n\tmov\tx0, x24\n\tmov\tx1, x20\n\tbl\t_silica_rt_supervisor_spawn_child_row_by_flavor\n\tb\tLmr_done\nLmr_ofa_kill:\n\tmov\tx25, #0\nLmr_ofa_kill_loop:\n\tcmp\tx25, x22\n\tb.hs\tLmr_ofa_spawn\n\tcmp\tx25, x23\n\tb.eq\tLmr_ofa_kill_next\n\tmov\tx26, x21\n\tmov\tx10, x25\nLmr_ofa_kill_walk_idx:\n\tcbz\tx10, Lmr_ofa_kill_at_idx\n\tldr\tx26, [x26, #80]\n\tsub\tx10, x10, #1\n\tb\tLmr_ofa_kill_walk_idx\nLmr_ofa_kill_at_idx:\n\tldr\tx27, [x26]\n\tcbz\tx27, Lmr_ofa_kill_next\n\tadd\tx0, x27, #16\n\tbl\t_os_unfair_lock_lock\n\tstr\twzr, [x27, #152]\n\tadd\tx0, x27, #80\n\tbl\t_silica_rt_cv_signal\n\tadd\tx0, x27, #16\n\tbl\t_os_unfair_lock_unlock\n; Phase E e4f: per-user-spec sequential stop — block here until this child's actor_thread_main\n; has fully unwound (ACB freed) and stamped row[+56]=1. Only then proceed to the next sibling,\n; so two children's teardowns never overlap (no concurrent libsystem_malloc cleanup races).\n; Reset the flag once observed so a future cascade restart targeting this row can re-arm.\nLmr_ofa_kill_wait:\n\tldr\tx8, [x26, #56]\n\tcbz\tx8, Lmr_ofa_kill_wait\n\tstr\txzr, [x26, #56]\nLmr_ofa_kill_next:\n\tadd\tx25, x25, #1\n\tb\tLmr_ofa_kill_loop\nLmr_ofa_spawn:\n\tmov\tx25, #0\nLmr_ofa_spawn_loop:\n; Phase E e4f: per-user-spec sequential start — spawn_linked itself spins on the new\n; child's ACB[+288] before returning, so iteration k cannot proceed until child k's\n; thread has finished its TLS init / first-schedule. Children come up in list order,\n; one at a time, after every cascaded stop has retired.\n\tcmp\tx25, x22\n\tb.hs\tLmr_done\n\tmov\tx26, x21\n\tmov\tx10, x25\nLmr_ofa_spawn_walk_idx:\n\tcbz\tx10, Lmr_ofa_spawn_at_idx\n\tldr\tx26, [x26, #80]\n\tsub\tx10, x10, #1\n\tb\tLmr_ofa_spawn_walk_idx\nLmr_ofa_spawn_at_idx:\n\tldr\tx8, [x26]\n\tcbz\tx8, Lmr_ofa_spawn_next\n\tmov\tx0, x26\n\tmov\tx1, x20\n\tbl\t_silica_rt_supervisor_spawn_child_row_by_flavor\nLmr_ofa_spawn_next:\n\tadd\tx25, x25, #1\n\tb\tLmr_ofa_spawn_loop\nLmr_rfo_kill:\n\tadd\tx25, x23, #1\nLmr_rfo_kill_loop:\n\tcmp\tx25, x22\n\tb.hs\tLmr_rfo_spawn\n\tmov\tx26, x21\n\tmov\tx10, x25\nLmr_rfo_kill_walk_idx:\n\tcbz\tx10, Lmr_rfo_kill_at_idx\n\tldr\tx26, [x26, #80]\n\tsub\tx10, x10, #1\n\tb\tLmr_rfo_kill_walk_idx\nLmr_rfo_kill_at_idx:\n\tldr\tx27, [x26]\n\tcbz\tx27, Lmr_rfo_kill_next\n\tadd\tx0, x27, #16\n\tbl\t_os_unfair_lock_lock\n\tstr\twzr, [x27, #152]\n\tadd\tx0, x27, #80\n\tbl\t_silica_rt_cv_signal\n\tadd\tx0, x27, #16\n\tbl\t_os_unfair_lock_unlock\n; Phase E e4f: per-user-spec sequential stop — wait for this child's actor_thread_main\n; to retire (row[+56]=1 set after its full ACB free) before signalling the next row.\n; No two cascaded teardowns ever overlap.\nLmr_rfo_kill_wait:\n\tldr\tx8, [x26, #56]\n\tcbz\tx8, Lmr_rfo_kill_wait\n\tmov\tx0, x20\n\tmov\tx1, x27\n\tbl\t_silica_rt_supervisor_drop_pending_exit\n\tstr\txzr, [x26, #56]\n; Tombstone the row only after the child has fully exited so Lmr_rfo_spawn does not run\n; with a stale child_ref in the slot.\n\tstr\txzr, [x26]\nLmr_rfo_kill_next:\n\tadd\tx25, x25, #1\n\tb\tLmr_rfo_kill_loop\nLmr_rfo_spawn:\n\tmov\tx25, x23\nLmr_rfo_spawn_loop:\n; Phase E e4f: per-user-spec sequential start — children come up in list order, one\n; at a time. spawn_linked blocks on each new child's ACB[+288] (set in actor_thread_main\n; right after TLS init / trampoline) so iteration k+1 can never run alongside iteration k.\n\tcmp\tx25, x22\n\tb.hs\tLmr_done\n\tmov\tx26, x21\n\tmov\tx10, x25\nLmr_rfo_spawn_walk_idx:\n\tcbz\tx10, Lmr_rfo_spawn_at_idx\n\tldr\tx26, [x26, #80]\n\tsub\tx10, x10, #1\n\tb\tLmr_rfo_spawn_walk_idx\nLmr_rfo_spawn_at_idx:\n\tmov\tx0, x26\n\tmov\tx1, x20\n\tbl\t_silica_rt_supervisor_spawn_child_row_by_flavor\nLmr_rfo_spawn_next:\n\tadd\tx25, x25, #1\n\tb\tLmr_rfo_spawn_loop\nLmr_next:\n\tadd\tx23, x23, #1\n\tb\tLmr_scan\nLmr_tombstone_done:\n\tstr\txzr, [x24]\n\tb\tLmr_done\nLmr_done:\n\tldp\tx29, x30, [sp, #80]\n\tldp\tx20, x19, [sp, #64]\n\tldp\tx22, x21, [sp, #48]\n\tldp\tx24, x23, [sp, #32]\n\tldp\tx26, x25, [sp, #16]\n\tldp\tx28, x27, [sp], #96\n\tret\n\t.cfi_endproc\n"
    .byte 0
    .p2align 3
