L_str_10_d:
    .ascii "\t.section\t__TEXT,__text,regular,pure_instructions\n; --- Phase E e3a Option B: linked-list child table ---\n; _silica_rt_child_table_free: X0=ACB* — walk nodes (+80 next), free each, clear anchors.\n; _silica_rt_child_table_ensure_min_cap: X0=ACB*, X1=min node count — X0=0 ok, 1 OOM. Appends 88 B nodes (80 B row + next) until count >= X1.\n\t.globl\t_silica_rt_child_table_free\n\t.p2align\t2\n_silica_rt_child_table_free:\n\t.cfi_startproc\n\tstp\tx20, x19, [sp, #-32]!\n\tstr\tx30, [sp, #16]\n\t.cfi_def_cfa wsp, 32\n\t.cfi_offset w20, -32\n\t.cfi_offset w19, -24\n\t.cfi_offset w30, -16\n\tmov\tx19, x0\n\tldr\tx8, [x19, #256]\nLct_free_loop:\n\tcbz\tx8, Lct_free_clear\n\tldr\tx20, [x8, #80]\n\tmov\tx0, x8\n\tbl\t_free\n\tmov\tx8, x20\n\tb\tLct_free_loop\nLct_free_clear:\n\tstr\txzr, [x19, #256]\n\tstr\txzr, [x19, #264]\n; Do not clear ACB[+272] (sync_failure_reported) — that flag outlives the child-table list.\n\tldr\tx30, [sp, #16]\n\tldp\tx20, x19, [sp], #32\n\tret\n\t.cfi_endproc\n\t.globl\t_silica_rt_child_table_ensure_min_cap\n\t.p2align\t2\n_silica_rt_child_table_ensure_min_cap:\n\t.cfi_startproc\n; X0=ACB* X1=min_nodes. Returns X0=0 success, 1 OOM.\n\tstp\tx26, x25, [sp, #-80]!\n\tstp\tx24, x23, [sp, #16]\n\tstp\tx22, x21, [sp, #32]\n\tstp\tx20, x19, [sp, #48]\n\tstp\tx29, x30, [sp, #64]\n\tadd\tx29, sp, #64\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w19, -32\n\t.cfi_offset w20, -24\n\t.cfi_offset w21, -40\n\t.cfi_offset w22, -32\n\t.cfi_offset w23, -56\n\t.cfi_offset w24, -48\n\t.cfi_offset w25, -72\n\t.cfi_offset w26, -64\n\tmov\tx19, x0\n\tmov\tx20, x1\n\tcmp\tx20, #0\n\tble\tLct_ens_ok\nLct_ens_retry:\n\tldr\tx21, [x19, #256]\n\tmov\tx22, #0\n\tmov\tx23, x21\nLct_count_loop:\n\tcbz\tx23, Lct_count_done\n\tadd\tx22, x22, #1\n\tldr\tx23, [x23, #80]\n\tb\tLct_count_loop\nLct_count_done:\n\tcmp\tx22, x20\n\tb.hs\tLct_ens_ok\n\tmov\tw0, #1\n\tmov\tw1, #88\n\tbl\t_calloc\n\tcbz\tx0, Lct_ens_fail\n\tmov\tx24, x0\n\tstr\txzr, [x24, #80]\n\tldr\tx21, [x19,