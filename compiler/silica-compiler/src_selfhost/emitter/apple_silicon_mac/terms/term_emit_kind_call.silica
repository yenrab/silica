            false -> false
        };
        false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name == "mul" of {
            true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "sub" of {
                true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).kind == 1
                    and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).right_expr)).kind == 1
                    and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).name == term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).right_expr)).name;
                false -> false
            };
            false -> false
        }
    };
    use_two_arg_gpr_reorder_add_second_first: bool <- len(rest_asm) > 0
        and two_arg_tail_rest
        and arg2_term_ok
        and (add_second_before_sub or mul_second_before_sub);
    // str_len_acc/count_a_acc/sum_digits_acc: arg1=substring sets MOV X1,#start clobbering acc(X1) before arg2 can use it.
    // Fix: emit arg2 (rest_asm) first to compute acc result into X1, save X1, emit substring arg1, restore X1.
    use_arg2_first_around_substring_arg1: bool <- len(rest_asm) > 0
        and two_arg_tail_rest
        and arg1_is_substring
        and arg1_reg == "X0"
        and arg2_reg == "X1";
    arg2_binding_for_reorder: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name == "user_call_rest" of {
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).inner)).kind == 1 of {
            true -> var@find_sp_binding_bare_or_percent_param(bound.outer_reg, term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).inner)).name);
            false -> ""
        };
        false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 1 of {
            true -> var@find_sp_binding_bare_or_percent_param(bound.outer_reg, term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name);
            false -> ""
        }
    };
    arg2_bound_in_x0_or_w0: bool <- arg2_binding_for_reorder == "X0" or arg2_binding_for_reorder == "W0";
    use_arg2_save_around_arg1_x0: bool <- len(rest_asm) > 0
        and two_arg_tail_rest
        and arg1_reg == "X0"
        and arg2_term_ok
        and arg2_bound_in_x0_or_w0;
    staged_arg_count: int64 <- 1 + term_user_call_helpers@simple_gpr_call_arg_count(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
    use_simple_gpr_parallel_stage: bool <- staged_arg_count <= 8
        and term_user_call_helpers@simple_gpr_call_arg_can_stage(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), bound.outer_reg)
        and term_user_call_helpers@simple_gpr_rest_can_stage(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), bound.outer_reg);
    args_asm: string <- case use_simple_gpr_parallel_stage of {
        true -> {
            first_sg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
            rest_sg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr);
            count_sg: int64 <- 1 + term_user_call_helpers@simple_gpr_call_arg_count(rest_sg);
            first_stage: string <- emit_simple_gpr_stage_chain(first_sg, bound, emit_child);
            rest_stage: string <- emit_simple_gpr_stage_chain(rest_sg, bound, emit_child);
            loads_sg: string <- term_user_call_helpers@emit_simple_gpr_stage_loads(0, count_sg);
            release_sg: string <- concat(concat("    ADD SP, SP, #", atom_table@int64_to_decimal_string(count_sg * 16)), "\n");
            concat(concat(concat(first_stage, rest_stage), loads_sg), release_sg)
        };
        false -> case len(rest_asm) > 0 of {
        true -> case use_two_arg_gpr_reorder of {
            true -> {
                save0: string <- "    STR X0, [SP, #-16]!\n";
                bridge: string <- "    LDR X0, [SP], #16\n";
                concat(concat(concat(concat(concat(save0, rest_asm), "\n"), bridge), arg1_asm), "\n")
            };
            false -> case use_two_arg_gpr_reorder_rem_first of {
                true -> {
                    rp: string <- reg_conventions@reg_prefix_for_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
                    arg1_gpr: string <- concat(rp, "0");
                    div_gpr: string <- concat(rp, "10");
                    mov_line: string <- concat(concat(concat(concat("    MOV ", arg1_gpr), ", "), div_gpr), "\n");
                    concat(concat(rest_asm, "\n"), mov_line)
                };
                false -> case use_two_arg_gpr_reorder_add_second_first of {
                    true -> concat(concat(rest_asm, "\n"), concat(arg1_asm, "\n"));
                    false -> case use_arg2_first_around_substring_arg1 of {
                        true -> concat(concat(concat(concat(rest_asm, "\n"), "    STR X1, [SP, #-16]!\n"), concat(arg1_asm, "\n")), "    LDR X1, [SP], #16\n");
                        false -> case use_arg2_save_around_arg1_x0 of {
                            true -> concat(concat(concat(concat(rest_asm, "\n"), "    STR X1, [SP, #-16]!\n"), concat(arg1_asm, "\n")), "    LDR X1, [SP], #16\n");
                            false -> concat(concat(arg1_asm, "\n"), concat(rest_asm, "\n"))
                        }
                    }
                }
            }
        };
        false -> concat(arg1_asm, "\n")
        }
    };
    dealloc_bytes_call: int64 <- arg_stack_bytes_before_call
        + sret_stack_bytes
        + case save_indirect_callee_around_args of { true -> 16; false -> 0 };
    dealloc_asm_call: string <- case dealloc_bytes_call > 0 of {
        true -> concat("\n    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(dealloc_bytes_call), ""));
        false -> ""
    };
    fuel: string <- case use_tail of {
        true -> recursion_support@emit_fuel_backedge_stub_comment();
        false -> ""
    };
    before_call: string <- case len(line_before_call_asm) > 0 of {
        true -> concat(line_before_call_asm, "\n");
        false -> ""
    };
    concat(fuel, concat(sret_setup, concat(callee_prep, concat(concat(concat(concat(args_asm, callee_reload_after_args), before_call), call_asm), dealloc_asm_call))))
}

// Root function body only: SIR kind 5 tail user call with enclosing function effects for frame release + barriers.
fn emit_function_tail_user_call_root(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, outer_reg: string, fn_effects: string, debug: bool, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
    emit_generic_user_call_asm_inner(term, dest, { bound_name: "", bound_reg: "", outer_reg: outer_reg, debug: debug }, emit_child, true, fn_effects, "", "")
}

// Same as emit_function_tail_user_call_root but BLR + stack cleanup instead of tail BR (e.g. main returning float must FCVTZS before RET).
fn emit_function_non_tail_user_call_root(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, outer_reg: string, fn_effects: string, debug: bool, line_before_call_asm: string, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
    emit_generic_user_call_asm_inner(term, dest, { bound_name: "", bound_reg: "", outer_reg: outer_reg, debug: debug }, emit_child, false, fn_effects, "[]", line_before_call_asm)
}
