// Register spill selection and let-RHS spill helpers for Apple Silicon term emission.

use atom_table;
use var;
use prims_record;
use prims_actors;
use string_parse;
use reg_conventions;
use term_sir_helpers;
use term_aggregate_helpers;

export spill_reg_chain_from_outer/1;
export next_frame_spill_slot/1;
export next_frame_region/2;
export frame_region_for/2;
export region_name_escapes/3;
export body_has_moving_call/1;
export let_owns_local_region/1;
export body_kind_census/1;
export emit_region_destroy_reg/1;
export agg_subtree_bytes/2;
export agg_offset_for/4;
export type_name_is_list_like/1;
export outer_for_aggregate_let_rhs/2;
export outer_append_id_ret_tuple_sret/3;
export compute_let_rhs_spill_reg/3;
export mov_spill_from_rhs/2;
export is_aggregate_make/1;
export outer_reg_keep_callee_saved/1;

fn spill_reg_chain_from_outer(outer_reg: string) -> string {
    case var@is_reg_bound(outer_reg, "X19") of {
        false -> "X19";
        true -> case var@is_reg_bound(outer_reg, "X20") of {
            false -> "X20";
            true -> case var@is_reg_bound(outer_reg, "X21") of {
                false -> "X21";
                true -> case var@is_reg_bound(outer_reg, "X22") of {
                    false -> "X22";
                    true -> case var@is_reg_bound(outer_reg, "X23") of {
                        false -> "X23";
                        true -> case var@is_reg_bound(outer_reg, "X24") of {
                            false -> "X24";
                            true -> case var@is_reg_bound(outer_reg, "X25") of {
                                false -> "X25";
                                true -> case var@is_reg_bound(outer_reg, "X26") of {
                                    false -> "X26";
                                    true -> case var@is_reg_bound(outer_reg, "X27") of {
                                        false -> "X27";
                                        true -> case var@is_reg_bound(outer_reg, "X28") of {
                                            false -> "X28";
                                        true -> ""
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn binding_name_matches_ref(binding_name: string, ref_name: string) -> boolean {
    case binding_name == ref_name of {
        true -> true;
        false -> case length_bytes(binding_name) > 0 and substring(binding_name, 0, 1) == "%" of {
            true -> substring(binding_name, 1, length_bytes(binding_name)) == ref_name;
            false -> case length_bytes(ref_name) > 0 and substring(ref_name, 0, 1) == "%" of {
                true -> binding_name == substring(ref_name, 1, length_bytes(ref_name));
                false -> false
            }
        }
    }
}

fn sir_term_references_binding(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, binding_name: string) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            // Kind 4/5 callees live in `.name`. Omitting them lets a later let steal the
            // register holding a function parameter, then BLR to garbage.
            local_ref: boolean <- case term_sir_helpers@sir_term_root_node(term).kind of {
                1 -> binding_name_matches_ref(binding_name, term_sir_helpers@sir_term_root_node(term).name);
                0 -> case term_sir_helpers@sir_term_root_node(term).type_name == "fn_ptr" of {
                    true -> binding_name_matches_ref(binding_name, term_sir_helpers@sir_term_root_node(term).value);
                    false -> false
                };
                4 -> binding_name_matches_ref(binding_name, term_sir_helpers@sir_term_root_node(term).name);
                5 -> binding_name_matches_ref(binding_name, term_sir_helpers@sir_term_root_node(term).name);
                _: int64 -> false
            };
            case local_ref of {
                true -> true;
                false -> case sir_term_references_binding(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), binding_name) of {
                    true -> true;
                    false -> sir_term_references_binding(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), binding_name)
                }
            }
        }
    }
}

fn find_equals_from_binding(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "=" of {
            true -> i;
            false -> find_equals_from_binding(s, i + 1)
        }
    }
}

fn outer_reg_has_live_binding_from(outer_reg: string, reg: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, start: int64) -> boolean {
    pipe: int64 <- var@find_pipe_from(outer_reg, start);
    case pipe < 0 of {
        true -> false;
        false -> {
            seg_start: int64 <- pipe + 1;
            next_pipe: int64 <- var@find_pipe_from(outer_reg, seg_start);
            seg_end: int64 <- case next_pipe < 0 of { true -> length_bytes(outer_reg); false -> next_pipe };
            segment: string <- substring(outer_reg, seg_start, seg_end);
            eq: int64 <- find_equals_from_binding(segment, 0);
            live_here: boolean <- case eq < 1 of {
                true -> false;
                false -> {
                    binding_name: string <- substring(segment, 0, eq);
                    binding_value: string <- substring(segment, eq + 1, length_bytes(segment));
                    binding_value == reg
                        and var@find_last_sp_binding(outer_reg, binding_name) == binding_value
                        and sir_term_references_binding(body, binding_name)
                }
            };
            case live_here of {
                true -> true;
                false -> case next_pipe < 0 of {
                    true -> false;
                    false -> outer_reg_has_live_binding_from(outer_reg, reg, body, next_pipe)
                }
            }
        }
    }
}

fn outer_reg_has_live_binding(outer_reg: string, reg: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    outer_reg_has_live_binding_from(outer_reg, reg, body, 0)
}

fn spill_reg_unavailable_for_body(outer_reg: string, reg: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    var@reg_reserved_as_sret_buffer(outer_reg, reg)
        or outer_reg_has_live_binding(outer_reg, reg, body)
}

fn spill_reg_chain_for_body(outer_reg: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case var@find_sp_binding(outer_reg, "_keep_cs") == "1" of {
        true -> "";
        false -> spill_reg_chain_for_body_liveness(outer_reg, body)
    }
}

fn spill_reg_chain_for_body_liveness(outer_reg: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case spill_reg_unavailable_for_body(outer_reg, "X19", body) of {
        false -> "X19";
        true -> case spill_reg_unavailable_for_body(outer_reg, "X20", body) of {
            false -> "X20";
            true -> case spill_reg_unavailable_for_body(outer_reg, "X21", body) of {
                false -> "X21";
                true -> case spill_reg_unavailable_for_body(outer_reg, "X22", body) of {
                    false -> "X22";
                    true -> case spill_reg_unavailable_for_body(outer_reg, "X23", body) of {
                        false -> "X23";
                        true -> case spill_reg_unavailable_for_body(outer_reg, "X24", body) of {
                            false -> "X24";
                            true -> case spill_reg_unavailable_for_body(outer_reg, "X25", body) of {
                                false -> "X25";
                                true -> case spill_reg_unavailable_for_body(outer_reg, "X26", body) of {
                                    false -> "X26";
                                    true -> case spill_reg_unavailable_for_body(outer_reg, "X27", body) of {
                                        false -> "X27";
                                        true -> case spill_reg_unavailable_for_body(outer_reg, "X28", body) of {
                                            false -> "X28";
                                        true -> ""
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Lets inside a case arm only see the arm remainder as the let's right_expr. A param
// used after the case join is live but does not appear in that remainder, so
// spill_reg_chain_for_body would reuse its callee-saved home. One flag is enough:
// per-register `|_keep.Xn=Xn` copies made emit of case-heavy units (constraint_runner)
// allocate tens of gigabytes.
fn outer_reg_keep_callee_saved(outer_reg: string) -> string {
    case var@find_sp_binding(outer_reg, "_keep_cs") == "1" of {
        true -> outer_reg;
        false -> concat(outer_reg, "|_keep_cs=1")
    }
}

fn is_float_scalar_type(type_name: string) -> boolean {
    type_name == "float64" or type_name == "float32" or type_name == "float16"
}

fn fp_prefix_for_type(type_name: string) -> string {
    case type_name == "float64" of {
        true -> "D";
        false -> case type_name == "float32" of {
            true -> "S";
            false -> "H"
        }
    }
}

fn fp_reg_for_type_index(type_name: string, idx: int64) -> string {
    concat(fp_prefix_for_type(type_name), atom_table@int64_to_decimal_string(idx))
}

fn fp_v_index_bound(outer_reg: string, idx: int64) -> boolean {
    s: string <- atom_table@int64_to_decimal_string(idx);
    var@is_reg_bound(outer_reg, concat("D", s)) or var@is_reg_bound(outer_reg, concat("S", s)) or var@is_reg_bound(outer_reg, concat("H", s))
}

fn fp_spill_reg_chain_from_outer(type_name: string, outer_reg: string) -> string {
    case fp_v_index_bound(outer_reg, 8) of {
        false -> fp_reg_for_type_index(type_name, 8);
        true -> case fp_v_index_bound(outer_reg, 9) of {
            false -> fp_reg_for_type_index(type_name, 9);
            true -> case fp_v_index_bound(outer_reg, 10) of {
                false -> fp_reg_for_type_index(type_name, 10);
                true -> case fp_v_index_bound(outer_reg, 11) of {
                    false -> fp_reg_for_type_index(type_name, 11);
                    true -> case fp_v_index_bound(outer_reg, 12) of {
                        false -> fp_reg_for_type_index(type_name, 12);
                        true -> case fp_v_index_bound(outer_reg, 13) of {
                            false -> fp_reg_for_type_index(type_name, 13);
                            true -> case fp_v_index_bound(outer_reg, 14) of {
                                false -> fp_reg_for_type_index(type_name, 14);
                                true -> case fp_v_index_bound(outer_reg, 15) of {
                                    false -> fp_reg_for_type_index(type_name, 15);
                                    true -> ""
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn is_caller_saved_fp(reg: string) -> boolean {
    case length_bytes(reg) < 2 of {
        true -> false;
        false -> {
            p: string <- substring(reg, 0, 1);
            case p == "D" or p == "S" or p == "H" of {
                false -> false;
                true -> {
                    n: int64 <- string_parse@string_to_int64(substring(reg, 1, length_bytes(reg)));
                    n >= 0 and n <= 7
                }
            }
        }
    }
}

// Parser joins list types with spaces (e.g. "List [int64, normal]"), not only "List[int64, normal]".

fn type_name_is_list_like(type_name: string) -> boolean {
    case length_bytes(type_name) >= 5 and substring(type_name, 0, 5) == "List[" of {
        true -> true;
        false -> case length_bytes(type_name) >= 6 and substring(type_name, 0, 6) == "List [" of {
            true -> true;
            false -> false
        }
    }
}

fn type_name_is_memory_handle_like(type_name: string) -> boolean {
    t: string <- prims_record@strip_spaces_rt(type_name);
    case length_bytes(t) >= 7 and substring(t, 0, 7) == "region(" of {
        true -> true;
        false -> case length_bytes(t) >= 4 and substring(t, 0, 4) == "buf(" of {
            true -> true;
            false -> case length_bytes(t) >= 4 and substring(t, 0, 4) == "ref(" of {
                true -> true;
                false -> case length_bytes(t) >= 5 and substring(t, 0, 5) == "ref?(" of {
                    true -> true;
                    false -> case length_bytes(t) >= 10 and substring(t, 0, 10) == ":none|ref(" of {
                        true -> true;
                        false -> length_bytes(t) >= 11 and substring(t, 0, 11) == "atomic_ref("
                    }
                }
            }
        }
    }
}

// A let whose tail returns the aggregate it just bound used to write that tuple straight into the
// caller's sret buffer via |_tuple_sret=X8. That is unsound. X8 is the AAPCS64 indirect-result
// register, so it is caller-saved and any intervening call destroys it -- _silica_rt_region_alloc
// loads into X8. When the tuple's operands themselves come from a call, as in `(n + 1, f)` where n
// and f were destructured from a recursive call, the store through X8 hit a dead pointer and
// faulted; the runtime's signal handler then longjmp'd and retried it forever, which presented as
// a hang rather than a crash.
//
// record_make was already excluded from this optimization for exactly this reason. tuple_make now
// takes the same route: with no _tuple_sret binding it allocates its own slab and heap-promotes,
// which is what every other tuple return already does. Callers are unaffected because they read
// the returned pointer out of X0 rather than their own X8 buffer.
//
// Do not reintroduce a caller-X8 fast path here without first proving no call can execute between
// function entry and the make.

fn outer_for_aggregate_let_rhs(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string) -> string {
    outer_reg
}

fn outer_append_id_ret_tuple_sret(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, partial_outer: string, closure_outer: string) -> string {
    partial_outer
}

// Types whose let RHS is a single GPR that must survive across device_io / BL (lists, strings, aggregates).
// Atom union types like `:less | :equal | :greater` have type_names starting with `:` and must also
// be spilled: they are returned in X0 (caller-saved) and can be clobbered by subsequent BL calls in
// the same sequence body.

fn let_rhs_type_spills_across_io(type_name: string) -> boolean {
    case type_name of {
        "int64" -> true;
        "i64" -> true;
        "uint64" -> true;
        "u64" -> true;
        "int32" -> true;
        "i32" -> true;
        "uint32" -> true;
        "u32" -> true;
        "int16" -> true;
        "i16" -> true;
        "uint16" -> true;
        "u16" -> true;
        "int8" -> true;
        "i8" -> true;
        "uint8" -> true;
        "u8" -> true;
        "char" -> true;
        "boolean" -> true;
        "bool" -> true;
        "i1" -> true;
        "atom" -> true;
        "actor_ref" -> true;
        "supervisor_ref" -> true;
        "string" -> true;
        "fn_ptr" -> true;
        _: string -> case var@type_name_is_function(type_name) of {
            true -> true;
            false -> case type_name_is_list_like(type_name) of {
            true -> true;
            false -> case reg_conventions@is_tuple_type(type_name) of {
                true -> true;
                false -> case length_bytes(type_name) >= 1 and substring(type_name, 0, 1) == "{" of {
                    true -> true;
                    false -> case length_bytes(type_name) >= 1 and substring(type_name, 0, 1) == ":" of {
                        true -> true;
                        false -> case type_name_is_memory_handle_like(type_name) of {
                            true -> true;
                            // Compiler-instantiated library type parameters use an uppercase
                            // identifier (ItemType, KeyType, AccType, ActorState, ...). They can
                            // specialize to any single-GPR value. Treating one as disposable
                            // scratch lets a later tuple/record projection overwrite it.
                            // Do not extend this rule to every unknown internal type: lifetime
                            // and other bookkeeping lets must not consume the finite X19-X28
                            // spill set.
                            false -> type_name_starts_uppercase(type_name)
                        }
                    }
                }
            }
            }
        }
    }
}

fn type_name_starts_uppercase(type_name: string) -> boolean {
    case length_bytes(type_name) == 0 of {
        true -> false;
        false -> case substring(type_name, 0, 1) of {
            "A" -> true; "B" -> true; "C" -> true; "D" -> true; "E" -> true;
            "F" -> true; "G" -> true; "H" -> true; "I" -> true; "J" -> true;
            "K" -> true; "L" -> true; "M" -> true; "N" -> true; "O" -> true;
            "P" -> true; "Q" -> true; "R" -> true; "S" -> true; "T" -> true;
            "U" -> true; "V" -> true; "W" -> true; "X" -> true; "Y" -> true;
            "Z" -> true;
            _: string -> false
        }
    }
}

fn is_caller_saved_gpr(reg: string) -> boolean {
    xreg: string <- case length_bytes(reg) > 1 and substring(reg, 0, 1) == "W" of {
        true -> concat("X", substring(reg, 1, length_bytes(reg)));
        false -> reg
    };
    case xreg == "X0" or xreg == "X1" or xreg == "X2" or xreg == "X3" of {
        true -> true;
        false -> case xreg == "X4" or xreg == "X5" or xreg == "X6" or xreg == "X7" of {
            true -> true;
            false -> case xreg == "X9" or xreg == "X10" or xreg == "X11" of {
                true -> true;
                false -> xreg == "X13" or xreg == "X14" or xreg == "X15"
            }
        }
    }
}

fn frame_spill_ref(spill_ref: string) -> boolean {
    length_bytes(spill_ref) > 7 and substring(spill_ref, 0, 7) == "[X29, #"
}

fn max_frame_spill_offset_from(outer_reg: string, start: int64) -> int64 {
    pipe: int64 <- var@find_pipe_from(outer_reg, start);
    case pipe < 0 of {
        true -> 0;
        false -> {
            seg_start: int64 <- pipe + 1;
            next_pipe: int64 <- var@find_pipe_from(outer_reg, seg_start);
            seg_end: int64 <- case next_pipe < 0 of { true -> length_bytes(outer_reg); false -> next_pipe };
            segment: string <- substring(outer_reg, seg_start, seg_end);
            eq: int64 <- find_equals_from_binding(segment, 0);
            // Aggregate REGION bindings (_va.<name>, _agg) also render as [X29,#-N]
            // but are assigned by node index, not by this running max. Counting them
            // here would push each sibling deeper and overflow the reservation.
            is_region_key: boolean <- eq > 0 and (substring(segment, 0, 4) == "_va." or substring(segment, 0, 4) == "_agg");
            here: int64 <- case eq < 1 or is_region_key of {
                true -> 0;
                false -> {
                    mem_ref: string <- substring(segment, eq + 1, length_bytes(segment));
                    case frame_spill_ref(mem_ref) of {
                        true -> {
                            off: int64 <- var@parse_x29_neg_offset_bytes(mem_ref);
                            case off > 0 of { true -> off; false -> 0 }
                        };
                        false -> 0
                    }
                }
            };
            rest: int64 <- case next_pipe < 0 of {
                true -> 0;
                false -> max_frame_spill_offset_from(outer_reg, next_pipe)
            };
            case here > rest of { true -> here; false -> rest }
        }
    }
}

// Allocate an nbytes aggregate region in the fixed frame instead of moving SP.
// Returns the region base as a frame memref ("[X29, #-96]"); element k lives at
// X29-(base-k), which tuple_flat_memref_at renders directly. Sized off the
// deepest offset already handed out, same discipline as next_frame_spill_slot.
// Bytes an entire subtree needs for aggregate regions.
//
// kind 7 is the case branch-list cons (inner = branch, right_expr = rest). Only
// ONE branch runs, so their regions overlap rather than stack -- max, not sum.
// Everything else stacks: a let's RHS aggregate stays live across the body, and
// True liveness for a let-bound aggregate: the pre-order position of the last
// VARIABLE use of `name` in the body, or -1 if it is never read. Shadowing by an
// inner let of the same name ends the range. Local copies of the register
// allocator's helpers -- emitter_core owns those and imports this module, so it
// cannot be imported back.
fn agg_name_is_read(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name: string) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term);
            case n.kind == 1 and n.name == name of {
                true -> true;
                false -> {
                    li: boolean <- agg_name_is_read(term_sir_helpers@sir_term_at(term, n.inner), name);
                    case li of {
                        true -> true;
                        false -> case n.kind == 2 and n.name == name of {
                            true -> false;
                            false -> agg_name_is_read(term_sir_helpers@sir_term_at(term, n.right_expr), name)
                        }
                    }
                }
            }
        }
    }
}

// Ownership escape test for a region binding (spec 3.247: handles are move-only).
// A region whose name appears inside a user call (kind 5) has been MOVED -- the
// callee owns it now and this scope must not also destroy it. Reads and
// alloc_ref/alloc_buf borrows leave ownership here.
fn rgn_has_prefix(nm: string, p: string) -> boolean {
    length_bytes(nm) >= length_bytes(p) and substring(nm, 0, length_bytes(p)) == p
}

fn rgn_is_moving_call(nm: string) -> boolean {
    case length_bytes(nm) == 0 of {
        true -> false;
        false -> (rgn_has_prefix(nm, "alloc_") or rgn_has_prefix(nm, "read_") or rgn_has_prefix(nm, "write_") or rgn_has_prefix(nm, "region_") or rgn_has_prefix(nm, "fresh_")) == false
    }
}

fn region_name_escapes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name: string, in_call: boolean) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term);
            case in_call and n.kind == 1 and n.name == name of {
                true -> true;
                false -> {
                    // A user call is kind 4 named for the callee (verified from SIR:
                    // "4:consume,1:%r,6:user_call_rest"), NOT kind 5. Memory prims
                    // alloc_*/read_*/write_* take a region by BORROW and do not move it.
                    deeper: boolean <- in_call or n.kind == 5 or (n.kind == 4 and rgn_is_moving_call(n.name));
                    li: boolean <- region_name_escapes(term_sir_helpers@sir_term_at(term, n.inner), name, deeper);
                    case li of {
                        true -> true;
                        false -> region_name_escapes(term_sir_helpers@sir_term_at(term, n.right_expr), name, deeper)
                    }
                }
            }
        }
    }
}

// Destroy a region held in `reg`, preserving X0/X1 (the scope's result) across it.
fn emit_region_destroy_reg(reg: string) -> string {
    case length_bytes(reg) == 0 of {
        true -> "";
        false -> case var@is_memory_ref(reg) of {
            true -> concat("    STP X0, X1, [SP, #-16]!\n", concat(var@emit_ldr_mem_ref("X0", reg), "\n    BL _silica_rt_region_destroy\n    LDP X0, X1, [SP], #16\n"));
            false -> concat("    STP X0, X1, [SP, #-16]!\n    MOV X0, ", concat(reg, "\n    BL _silica_rt_region_destroy\n    LDP X0, X1, [SP], #16\n"))
        }
    }
}

// True when this let binds a locally created region that never leaves the scope.
// TEMPORARY diagnostic: which node kinds actually appear in this body.
fn body_kind_census(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term.root < 0 of {
        true -> "";
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term);
            here: string <- concat(atom_table@int64_to_decimal_string(n.kind), concat(":", concat(n.name, ",")));
            concat(here, concat(body_kind_census(term_sir_helpers@sir_term_at(term, n.inner)), body_kind_census(term_sir_helpers@sir_term_at(term, n.right_expr))))
        }
    }
}

fn body_has_user_call(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term);
            case n.kind == 5 of {
                true -> true;
                false -> case body_has_user_call(term_sir_helpers@sir_term_at(term, n.inner)) of {
                    true -> true;
                    false -> body_has_user_call(term_sir_helpers@sir_term_at(term, n.right_expr))
                }
            }
        }
    }
}

// Any call that is not a borrow prim can move the region out of this scope.
// Matching the handle to a specific argument proved unreliable (main in
// compiler_addition/region_grow destroyed a region it had passed to fill, a double
// free), so this asks the name-independent question: does the scope contain ANY
// moving call at all?
fn body_has_moving_call(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term);
            case n.kind == 4 or n.kind == 5 of {
                true -> true;
                false -> case body_has_moving_call(term_sir_helpers@sir_term_at(term, n.inner)) of {
                    true -> true;
                    false -> body_has_moving_call(term_sir_helpers@sir_term_at(term, n.right_expr))
                }
            }
        }
    }
}

// True if `name` appears anywhere that is NOT a direct argument of a borrow prim.
// Storing it into an aggregate, returning it, or passing it on all count.
fn rgn_is_region_borrow_prim(nm: string) -> boolean {
    rgn_has_prefix(nm, "alloc_") or rgn_has_prefix(nm, "region_") or nm == "ref_in_region"
}

fn region_used_outside_borrow(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, name: string, in_borrow: boolean) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term);
            case n.kind == 1 and n.name == name and in_borrow == false of {
                true -> true;
                false -> {
                    b: boolean <- in_borrow or (n.kind == 6 and rgn_is_region_borrow_prim(n.name));
                    li: boolean <- region_used_outside_borrow(term_sir_helpers@sir_term_at(term, n.inner), name, b);
                    case li of {
                        true -> true;
                        false -> region_used_outside_borrow(term_sir_helpers@sir_term_at(term, n.right_expr), name, b)
                    }
                }
            }
        }
    }
}

fn let_owns_local_region(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
    case term_sir_helpers@sir_term_root_node(rhs).name == "alloc_region" of {
        false -> false;
        // Conservative: destroy only when the scope contains NO user call. A call is
        // the only way ownership moves on, and matching the handle to a specific
        // argument proved unreliable -- move_one and consume both destroyed the same
        // region, a double free (Trace/BPT trap). Missing a destroy leaks; emitting
        // one twice corrupts, so this errs toward the leak.
        // Destroy only when the handle is used EXCLUSIVELY as a borrow-prim argument
        // (alloc_ref/alloc_buf/alloc_rec/read_*/write_*). Any other appearance may
        // carry it out of the scope -- notably `{ region: r, ... }`, a record that is
        // then returned. Checking only for moving CALLS missed that, so the region was
        // freed while the returned tree still pointed into it (near-null tree.region
        // in wbt_map_smart_node_finish_alloc).
        true -> body_has_moving_call(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)) == false
                and region_used_outside_borrow(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term).name, false) == false
    }
}

fn agg_child_is_make(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> boolean {
    case idx < 0 of {
        true -> false;
        false -> {
            c: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, idx));
            c.kind == 6 and (c.name == "tuple_make" or c.name == "record_make")
        }
    }
}

// What survives a let into its body: only the RHS's RESULT aggregate. A make handed to a
// callee needs no room reserved here -- emit_rest_args and emit_simple_gpr_stage_one copy
// it into the region before the pointer leaves the frame, so the slab is dead once the
// call is staged and the body may reuse it. That promotion is what makes reuse safe:
// Silica moves rather than borrows, so without it a callee keeps a pointer into a frame
// slot the next sibling then overwrites -- two adjacent `m <- insert(m, k, (v, s))` lets
// shared one offset and the second value tuple replaced the first entry's.
// See trials/standard_data_structures/wbt_core/wbt_map_insert_tuple_value,
// wbt_delete_payload_shapes and wbt_map_tuple_value_escapes_frame.
fn agg_persist_bytes_let(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, let_idx: int64) -> int64 {
    case let_idx < 0 of {
        true -> 0;
        false -> {
            ln: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, let_idx));
            // Free at last use: if the binding is never read in the body, its region
            // dies with the RHS and the body can reuse the space. A make handed to a
            // callee no longer needs pinning here: emit_rest_args and
            // emit_simple_gpr_stage_one copy it into the region before the pointer
            // leaves the frame, so the slab is dead once the call is staged.
            case agg_name_is_read(term_sir_helpers@sir_term_at(term, ln.right_expr), ln.name) of {
                false -> 0;
                true -> agg_persist_bytes(term, ln.inner)
            }
        }
    }
}

fn agg_persist_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> int64 {
    case agg_child_is_make(term, idx) of {
        true -> {
            own: int64 <- term_aggregate_helpers@agg_shell_bytes(term_sir_helpers@sir_term_at(term, idx));
            case own < 16 of { true -> 16; false -> (own + 15) / 16 * 16 }
        };
        false -> 0
    }
}

// nested makes sit above their parent's shell.
fn agg_subtree_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> int64 {
    case idx < 0 of {
        true -> 0;
        false -> {
            n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, idx));
            own: int64 <- term_aggregate_helpers@agg_shell_bytes(term_sir_helpers@sir_term_at(term, idx));
            a: int64 <- agg_subtree_bytes(term, n.inner);
            b: int64 <- agg_subtree_bytes(term, n.right_expr);
            // Only case branches share: exactly one runs. Make ELEMENTS cannot --
            // a nested aggregate whose pointer is stored into the parent shell stays
            // live with the parent, and is not always heap-promoted first. Sharing
            // there corrupted 16 trials (rec_call_field, tuple3_nested_destr, ...).
            in_chain: boolean <- n.kind == 6 and (n.name == "tuple_make" or n.name == "record_make");
            share: boolean <- n.kind == 7 or (in_chain and agg_child_is_make(term, n.inner));
            case share of {
                true -> own + (case a > b of { true -> a; false -> b });
                false -> case n.kind == 2 of {
                    true -> {
                        pb: int64 <- agg_persist_bytes_let(term, idx);
                        tot: int64 <- pb + b;
                        own + (case a > tot of { true -> a; false -> tot })
                    };
                    false -> own + a + b
                }
            }
        }
    }
}

// Offset of `target`'s region, walking from the function body root. Returns -1 if
// the target is not in this subtree. Cost is O(nodes) per query: the descent
// visits each node once and the agg_subtree_bytes calls are on disjoint subtrees
// along a single path.
fn agg_offset_for(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64, target: int64, base: int64) -> int64 {
    case idx < 0 of {
        true -> 0 - 1;
        false -> case idx == target of {
            true -> base;
            false -> {
                n: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, idx));
                own: int64 <- term_aggregate_helpers@agg_shell_bytes(term_sir_helpers@sir_term_at(term, idx));
                cb: int64 <- base + own;
                l: int64 <- agg_offset_for(term, n.inner, target, cb);
                case l >= 0 of {
                    true -> l;
                    false -> {
                        in_chain_r: boolean <- n.kind == 6 and (n.name == "tuple_make" or n.name == "record_make");
                        share_r: boolean <- n.kind == 7 or (in_chain_r and agg_child_is_make(term, n.inner));
                        rb: int64 <- case share_r of {
                            true -> cb;
                            false -> case n.kind == 2 of {
                                true -> cb + agg_persist_bytes_let(term, idx);
                                false -> cb + agg_subtree_bytes(term, n.inner)
                            }
                        };
                        agg_offset_for(term, n.right_expr, target, rb)
                    }
                }
            }
        }
    }
}

// Region for THIS make, derived from its SIR node index rather than from mutable
// context. Sibling makes (e.g. two child specs passed to one call) share an
// outer_reg, so a context-derived base handed them the same address and they
// overwrote each other -- phase_a/phase_e supervisor faults. Node indices are
// unique, so prefix-summing make sizes below this node gives every make a
// distinct, non-overlapping region that still fits the agg_region_bytes total.
fn frame_region_for(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string) -> string {
    // Regions own the shallow end of the frame spill area, [0 .. _aggb], indexed
    // by SIR node so siblings never alias. Spill slots start below _aggb, so the
    // two allocators cannot overlap -- a short-circuit slot landed on a tuple's
    // element 0 when they shared the same offset space.
    broot: string <- var@find_sp_binding(outer_reg, "_broot");
    br: int64 <- case length_bytes(broot) > 0 of { true -> string_parse@string_to_int64(broot); false -> 0 - 1 };
    raw: int64 <- agg_offset_for(term, br, term.root, 0);
    prefix: int64 <- case raw >= 0 of { true -> raw; false -> 0 };
    own: int64 <- term_aggregate_helpers@agg_shell_bytes(term);
    need: int64 <- case own < 16 of { true -> 16; false -> (own + 15) / 16 * 16 };
    concat("[X29, #-", concat(atom_table@int64_to_decimal_string(prefix + need), "]"))
}

fn next_frame_region(outer_reg: string, nbytes: int64) -> string {
    off: int64 <- max_frame_spill_offset_from(outer_reg, 0);
    need: int64 <- case nbytes < 16 of { true -> 16; false -> (nbytes + 15) / 16 * 16 };
    concat("[X29, #-", concat(atom_table@int64_to_decimal_string(off + need), "]"))
}

fn agg_area_bytes(outer_reg: string) -> int64 {
    s: string <- var@find_sp_binding(outer_reg, "_aggb");
    raw: int64 <- case length_bytes(s) > 0 of { true -> string_parse@string_to_int64(s); false -> 0 };
    // Guard: type_interner_parse_ordered_map reserves 592 bytes yet this read
    // returned 7864320, producing a spill slot at [X29,#-7864336] -- outside the
    // frame and too large for a MOV immediate, so the file would not assemble.
    // A value far beyond any real frame is a bad read, not a big function; ignoring
    // it keeps slots inside the frame. The underlying parse still needs root-causing.
    case raw < 0 or raw > 262144 of {
        true -> 0;
        false -> raw
    }
}

fn next_frame_spill_slot(outer_reg: string) -> string {
    // enclosing_sp_binding re-appends the parent's [X29,#-N] on every nested
    // let, so a binding-count n jumped 1,2,4,6. STUR [x29,#-96] then landed
    // on the callee-saved save area (caller's X21). Address from the deepest
    // offset already used. See trials/codegen_regressions/frame_spill_x21.silica.
    raw: int64 <- max_frame_spill_offset_from(outer_reg, 0);
    ab: int64 <- agg_area_bytes(outer_reg);
    off: int64 <- case raw > ab of { true -> raw; false -> ab };
    n: int64 <- off / 16 + 1;
    concat("[X29, #-", concat(atom_table@int64_to_decimal_string(n * 16), "]"))
}

fn compute_let_rhs_spill_reg(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, rhs_reg: string, outer_reg: string) -> string {
    case is_float_scalar_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) of {
        true -> case is_caller_saved_fp(rhs_reg) of {
            true -> fp_spill_reg_chain_from_outer(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name, outer_reg);
            false -> ""
        };
        false -> case is_caller_saved_gpr(rhs_reg) of {
            false -> "";
            true -> case let_rhs_type_spills_across_io(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) of {
                true -> {
                    unused: string <- spill_reg_chain_from_outer(outer_reg);
                    case length_bytes(unused) > 0 of {
                        true -> unused;
                        false -> {
                            body_spill: string <- spill_reg_chain_for_body(outer_reg, term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
                            case length_bytes(body_spill) > 0 of {
                                true -> body_spill;
                                false -> next_frame_spill_slot(outer_reg)
                            }
                        }
                    }
                };
                false -> ""
            }
        }
    }
}

fn mov_spill_from_rhs(rhs_reg: string, spill_reg: string) -> string {
    rhs_p: string <- case length_bytes(rhs_reg) > 0 of { true -> substring(rhs_reg, 0, 1); false -> "" };
    spill_p: string <- case length_bytes(spill_reg) > 0 of { true -> substring(spill_reg, 0, 1); false -> "" };
    case spill_p == "[" of {
        true -> {
            src_mem: string <- case rhs_p == "D" or rhs_p == "S" or rhs_p == "H" of {
                true -> rhs_reg;
                false -> prims_actors@gpr_x_view(rhs_reg)
            };
            var@emit_str_mem_ref(src_mem, spill_reg)
        };
        false -> case rhs_p == "D" or rhs_p == "S" or rhs_p == "H" or spill_p == "D" or spill_p == "S" or spill_p == "H" of {
            true -> concat(concat(concat("    FMOV ", spill_reg), ", "), concat(rhs_reg, "\n"));
            false -> {
                src: string <- prims_actors@gpr_x_view(rhs_reg);
                concat(concat(concat("    MOV ", spill_reg), ", "), concat(src, "\n"))
            }
        }
    }
}

// Total stack bytes to deallocate for tuple-constructed call arguments.
// tuple_make allocates on SP; callers must restore SP after the call returns.

fn is_aggregate_make(t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term_sir_helpers@sir_term_root_node(t).kind == 6 of {
        false -> false;
        true -> term_sir_helpers@sir_term_root_node(t).name == "tuple_make" or term_sir_helpers@sir_term_root_node(t).name == "record_make"
    }
}

