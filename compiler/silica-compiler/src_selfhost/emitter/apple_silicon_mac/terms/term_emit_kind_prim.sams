    BL L_ss_bump_alloc
    CBZ X0, L_ss_ret
    MOV X15, X0
    MOV X9, #-1
    STR X9, [X15]
    ADD X9, X15, #24
    STR X9, [X15, #8]
    STR X11, [X15, #16]
    ADD X10, X8, X23
    MOV X12, X11
L_ss_cp:
    CBZ X12, L_ss_cp_done
    LDRB W13, [X10]
    STRB W13, [X9]
    ADD X9, X9, #1
    ADD X10, X10, #1
    SUB X12, X12, #1
    B L_ss_cp
L_ss_cp_done:
    STRB WZR, [X9]
    MOV X0, X15
L_ss_ret:
    LDP X15, X30, [SP, #48]
    LDP X23, X14, [SP, #32]
    LDP X21, X22, [SP, #16]
    LDP X19, X20, [SP], #80
    RET
L_ss_bump_alloc:
    STP X19, X30, [SP, #-32]!
    STP X20, X21, [SP, #16]
    ADD X0, X0, #7
    LSR X0, X0, #3
    LSL X19, X0, #3
    ADRP X20, L_ss_arena_ptr@PAGE
    ADD X20, X20, L_ss_arena_ptr@PAGEOFF
    LDR X21, [X20]
    CBZ X21, L_ss_bump_new
    ADRP X1, L_ss_arena_end@PAGE
    ADD X1, X1, L_ss_arena_end@PAGEOFF
    LDR X2, [X1]
    ADD X3, X21, X19
    CMP X3, X2
    B.HI L_ss_bump_new
    STR X3, [X20]
    MOV X0, X21
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_ss_bump_new:
    ADD X1, X19, #16
    MOVZ X2, #0x40, LSL #16
    CMP X1, X2
    CSEL X1, X1, X2, HI
    MOV X21, X1
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    CMN X0, #1
    B.EQ L_ss_bump_fail
    ADRP X2, L_ss_arena_head@PAGE
    ADD X2, X2, L_ss_arena_head@PAGEOFF
    LDR X3, [X2]
    STR X3, [X0]
    STR X21, [X0, #8]
    STR X0, [X2]
    ADD X1, X0, #16
    ADD X3, X1, X19
    STR X3, [X20]
    ADRP X2, L_ss_arena_end@PAGE
    ADD X2, X2, L_ss_arena_end@PAGEOFF
    ADD X3, X0, X21
    STR X3, [X2]
    MOV X0, X1
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_ss_bump_fail:
    MOV X0, #0
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_ss_arena_release:
    STP X19, X30, [SP, #-32]!
    STP X20, X21, [SP, #16]
    ADRP X20, L_ss_arena_head@PAGE
    ADD X20, X20, L_ss_arena_head@PAGEOFF
    LDR X19, [X20]
L_ss_rel_loop:
    CBZ X19, L_ss_rel_done
    LDR X21, [X19]
    LDR X1, [X19, #8]
    MOV X0, X19
    MOVZ X16, #73
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    MOV X19, X21
    B L_ss_rel_loop
L_ss_rel_done:
    STR XZR, [X20]
    ADRP X1, L_ss_arena_ptr@PAGE
    ADD X1, X1, L_ss_arena_ptr@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_ss_arena_end@PAGE
    ADD X1, X1, L_ss_arena_end@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_ss_ascii_key@PAGE
    ADD X1, X1, L_ss_ascii_key@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_ss_ascii_flag@PAGE
    ADD X1, X1, L_ss_ascii_flag@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_ss_cached_len@PAGE
    ADD X1, X1, L_ss_cached_len@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_ss_cur_key@PAGE
    ADD X1, X1, L_ss_cur_key@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_ss_cur_char@PAGE
    ADD X1, X1, L_ss_cur_char@PAGEOFF
    STR XZR, [X1]
    ADRP X1, L_ss_cur_byte@PAGE
    ADD X1, X1, L_ss_cur_byte@PAGEOFF
    STR XZR, [X1]
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
