L_length_bytes_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    CBZ X19, Llb_z
    LDR X1, [X19]
    MOV X2, #-1
    CMP X1, X2
    B.NE Llb_bad
    LDR X0, [X19, #16]
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_z:
    MOV X0, #0
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_bad:
    BRK #1

L_string_cmp_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lcmp_anull
    CBZ X20, Lcmp_gt
    LDR X1, [X19]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lcmp_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    CMP X1, X2
    B.NE Lcmp_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
Lcmp_n2_done:
    MOV X25, X22
    CMP X25, X24
    B.LS Lcmp_minok
    MOV X25, X24
Lcmp_minok:
    CBZ X25, Lcmp_len
    MOV X26, X21
    MOV X27, X23
Lcmp_cloop:
    LDRB W28, [X26], #1
    LDRB W1, [X27], #1
    CMP W28, W1
    B.LO Lcmp_lt
    B.HI Lcmp_gt
    SUBS X25, X25, #1
    B.NE Lcmp_cloop
Lcmp_len:
    CMP X22, X24
    B.EQ Lcmp_eq
    B.LO Lcmp_lt
    B Lcmp_gt
Lcmp_anull:
    CBZ X20, Lcmp_eq
Lcmp_lt:
    MOV W0, #-1
    B Lcmp_exit
Lcmp_gt:
    MOV W0, #1
    B Lcmp_exit
Lcmp_eq:
    MOV W0, #0
Lcmp_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Lcmp_bad:
    BRK #1

