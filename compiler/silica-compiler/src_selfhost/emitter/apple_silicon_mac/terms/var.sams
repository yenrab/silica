L_lph_new_chunk:
    ADD X0, X4, #8
    BL _silica_rt_region_alloc
    MOV X6, X0
    LDR X5, [SP]
    LDP X3, X4, [SP, #16]
    LDP X1, X2, [SP, #32]
    SUB X8, X4, X3
    ADD X10, X6, X8
    CBZ X5, L_lph_new_scalar
    MOV X12, #0
L_lph_new_agg:
    CMP X12, X3
    B.GE L_lph_new_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_new_agg
    B L_lph_new_stored
L_lph_new_scalar:
    CMP X3, #8
    B.EQ L_lph_ns8
    CMP X3, #4
    B.EQ L_lph_ns4
    CMP X3, #2
    B.EQ L_lph_ns2
