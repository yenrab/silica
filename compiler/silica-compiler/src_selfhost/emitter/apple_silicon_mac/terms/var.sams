    B L_lph_new_stored
L_lph_ns8:
    STR X1, [X10]
L_lph_new_stored:
    CBZ X2, L_lph_next_nil
    LDR X9, [X2, #8]
    STR X9, [X6, X4]
    B L_lph_alloc_handle
L_lph_next_nil:
    STR XZR, [X6, X4]
L_lph_alloc_handle:
