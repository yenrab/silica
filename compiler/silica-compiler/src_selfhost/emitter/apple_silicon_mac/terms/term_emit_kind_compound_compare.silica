 compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string, term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    join_cmp_rl(emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug }), emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug }))
}

fn emit_kind_compound_compare(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
// Comparisons (lt, gt, le, ge, eq, nq) have result type "bool" but operands determine reg size
                        is_cmp: bool <- term_sir_helpers@sir_term_root_node(term).type_name == "bool" and (term_sir_helpers@sir_term_root_node(term).name == "lt" or term_sir_helpers@sir_term_root_node(term).name == "gt" or term_sir_helpers@sir_term_root_node(term).name == "le" or term_sir_helpers@sir_term_root_node(term).name == "ge" or term_sir_helpers@sir_term_root_node(term).name == "eq" or term_sir_helpers@sir_term_root_node(term).name == "nq" or term_sir_helpers@sir_term_root_node(term).name == "is_nan" or term_sir_helpers@sir_term_root_node(term).name == "is_inf" or term_sir_helpers@sir_term_root_node(term).name == "is_finite");
                        prim_type: string <- case is_cmp of { true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name; false -> term_sir_helpers@sir_term_root_node(term).type_name };
                        is_float64: bool <- prim_type == "float64";
                        is_float32: bool <- prim_type == "float32";
                        is_float16: bool <- prim_type == "float16";
                        is_narrow: bool <- prim_type == "int32" or prim_type == "int16" or prim_type == "int8" or prim_type == "uint32" or prim_type == "uint16" or prim_type == "uint8";
                        is_string_prim: bool <- prim_type == "string" and term_sir_helpers@sir_term_root_node(term).name == "string_concat";
                        left_type_is_string: bool <- prim_type == "string";
                        cmp_is_eq: bool <- term_sir_helpers@sir_term_root_node(term).name == "eq";
                        cmp_is_nq: bool <- term_sir_helpers@sir_term_root_node(term).name == "nq";
                        cmp_is_lt: bool <- term_sir_helpers@sir_term_root_node(term).name == "lt";
                        cmp_is_gt: bool <- term_sir_helpers@sir_term_root_node(term).name == "gt";
                        cmp_is_le: bool <- term_sir_helpers@sir_term_root_node(term).name == "le";
                        cmp_is_ge: bool <- term_sir_helpers@sir_term_root_node(term).name == "ge";
                        right_val_0: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).value == "0";
                        right_val_1: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).value == "1";
                        left_kind: int64 <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind;
                        left_is_rp: bool <- left_kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj";
                        left_proj_off: int64 <- case left_is_rp of {
                            true -> term_aggregate_helpers@record_proj_chain_byte_offset(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                            false -> 0
                        };
                        left_proj_root: string <- case left_is_rp of {
                            true -> term_aggregate_helpers@record_proj_chain_root_var_name(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                            false -> ""
                        };
                        left_proj_base: string <- case left_is_rp of {
                            true -> var@find_last_sp_binding(bound.outer_reg, left_proj_root);
                            false -> ""
                        };
                        left_proj_n: int64 <- xreg_num(left_proj_base);
                        left_is_len: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "list_length";
                        left_arg_is_tail: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).name == "list_remove_head";
                        list_tail_var: string <- case left_is_len and left_arg_is_tail of {
                            true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).inner)).kind == 1 of {
                                true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).inner)).name;
                                false -> ""
                            };
                            false -> ""
                        };
                        list_tail_n: int64 <- xreg_num(var@find_last_sp_binding(bound.outer_reg, list_tail_var));
                        reg_prefix: string <- case is_float64 of {
                            true -> "D";
                            false -> case is_float32 of {
                                true -> "S";
                                false -> case is_float16 of {
                                    true -> "H";
                                    false -> case is_narrow of {
                                        true -> "W";
                                        false -> "X"
                                    }
                                }
                            }
                        };
                        left_reg: string <- case is_string_prim of { true -> "X0"; false -> case is_float64 or is_float32 or is_float16 of { true -> concat(reg_prefix, "1"); false -> concat(reg_prefix, "9") } };
                        right_reg: string <- case is_string_prim of { true -> "X1"; false -> case is_float64 or is_float32 or is_float16 of { true -> concat(reg_prefix, "2"); false -> concat(reg_prefix, "10") } };
                        is_unary_prim: bool <- term_sir_helpers@sir_term_root_node(term).name == "neg" or term_sir_helpers@sir_term_root_node(term).name == "bnot" or term_sir_helpers@sir_term_root_node(term).name == "is_nan" or term_sir_helpers@sir_term_root_node(term).name == "is_inf" or term_sir_helpers@sir_term_root_node(term).name == "is_finite";
                        case is_unary_prim of {
                            true -> {
                                // Unary negate_* / prim neg: operand in left_reg only (right_expr is dummy)
                                // Float neg must write back to left_reg (S1/D1/H1) so a following FCMP still sees the result in r1.
                                arg_asm: string <- case bound.debug of {
                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                // Float FNEG is emitted as FNEG <dest>, <r1> (see arithmetic.emit_fneg_*): operand stays in r1 (S1/D1/H1).
                                // Caller dest may be S0/D0 for print_float32/64; must not force dest=r1 or the helper reads the wrong reg.
                                op_asm: string <- prims@emit_prim_op(term, dest);
                                concat(concat(arg_asm, "\n"), op_asm)
                            };
                            false -> case bound.bound_name == "" of {
                            true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6 of {
                                true -> {
                                    // Both operands are prims: left prim loads into reg 0, right prim may use reg 0 (calls use X0 for args/result).
                                    // Must save left to stack before right eval; right can overwrite temp_reg (X0/D0/S0) via calls or nested prims.
                                    // Arithmetic expects left in r1, right in r2. For non-string: put right in right_reg, restore left to left_reg.
                                    // String concat expects X0=left, X1=right; keep original layout for is_string_prim.
                                    // Important: avoid using X0 as a scratch reg for integer prims because tuple_proj may use X0
                                    // as the tuple base pointer (function param), and clobbering it breaks subsequent projections.
                                    temp_reg: string <- case is_string_prim or is_float64 or is_float32 or is_float16 of {
                                        true -> concat(reg_prefix, "0");
                                        false -> left_reg
                                    };
                                    left_asm: string <- case bound.debug of {
                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    save_left: string <- case is_string_prim of {
                                        true -> "    STR X0, [SP, #-16]!\n";
                                        false -> case is_float64 or is_float32 or is_float16 of {
                                            true -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                            false -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n")
                                        }
                                    };
                                    right_asm: string <- case is_string_prim of {
                                        true -> case bound.debug of {
                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        false -> case bound.debug of {
                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        }
                                    };
                                    restore_left: string <- case is_string_prim of {
                                        true -> "    LDR X0, [SP], #16\n";
                                        false -> case is_float64 or is_float32 or is_float16 of {
                                            true -> concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                            false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                        }
                                    };
                                    op_asm: string <- prims@emit_prim_op(term, dest);
                                    part1: string <- concat(left_asm, "\n");
                                    part2: string <- concat(part1, save_left);
                                    part3: string <- concat(part2, right_asm);
                                    part4: string <- concat(part3, "\n");
                                    part5: string <- concat(part4, restore_left);
                                    concat(part5, op_asm)
                                };
                                false -> {
                                    left_is_prim: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6;
                                    right_is_prim: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6;
                                                                        args_pair_first: { first: string, second: string } <- case left_is_prim of {
                                        true -> {
                                            // Left is prim, right is var. Arithmetic expects left in r1, right in r2. For non-string: right to right_reg, left to left_reg (save/restore).
                                            right_asm: string <- case is_string_prim of {
                                                true -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                false -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                }
                                            };
                                            save_right: string <- concat(concat(concat("    STR ", right_reg), ", [SP, #-16]!\n"), "");
                                            left_asm: string <- case is_string_prim of {
                                                true -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                false -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                }
                                            };
                                            restore_right: string <- concat(concat(concat("    LDR ", right_reg), ", [SP], #16\n"), "");
                                            combined: string <- concat(concat(concat(concat(concat(concat(right_asm, "\n"), save_right), left_asm), "\n"), restore_right), "");
                                            { first: combined, second: "" }
                                        };
                                        false -> case right_is_prim of {
                                            true -> {
                                                // Left is var/call, right is prim. Arithmetic expects left in r1, right in r2.
                                                // Save left to stack; right to right_reg; restore left to left_reg.
                                                temp_reg: string <- concat(reg_prefix, "0");
                                                left_asm: string <- case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                save_left: string <- case is_string_prim of {
                                                    true -> "    STR X0, [SP, #-16]!\n";
                                                    false -> case is_float64 or is_float32 or is_float16 of {
                                                        true -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                                        false -> "    STR X0, [SP, #-16]!\n"
                                                    }
                                                };
                                                right_asm: string <- case is_string_prim of {
                                                    true -> case bound.debug of {
                                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    };
                                                    false -> case bound.debug of {
                                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    }
                                                };
                                                restore_left: string <- case is_string_prim of {
                                                    true -> "    LDR X0, [SP], #16\n";
                                                    false -> case is_float64 or is_float32 or is_float16 of {
                                                        true -> concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                                        false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                                    }
                                                };
                                                combined: string <- concat(concat(concat(concat(concat(concat(left_asm, "\n"), save_left), right_asm), "\n"), restore_left), "");
                                                { first: combined, second: "" }
                                            };
                                            false -> case (term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 0 or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1) and (term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 0 or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 1) of {
                                                true -> {
                                                    // Both operands are simple (var or const). Calls (kind 4) overwrite X9/X10; must use save/restore.
                                                    // Arithmetic expects left in r1, right in r2 (same as add/mul).
                                                    l: string <- case bound.debug of {
                                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    };
                                                    r: string <- case bound.debug of {
                                                        true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                        false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    };
                                                    // For float32/float64: emit right before left. Left writes to S1/D1 (left_reg),
                                                    // which may be the source register for the right var (if bound to S1/D1).
                                                    // Emitting right first preserves the right operand before left clobbers its source.
                                                    // For string_prim with left=const: loading literal into X0 (left_reg) clobbers right var if right is in X0.
                                                    // Emit right first (MOV X1, X0) to save right before loading left literal into X0.
                                                    case is_float32 or is_float64 or is_float16 or (is_string_prim and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 0) of {
                                                        true -> { first: concat(concat(concat(r, "\n"), l), "\n"), second: "" };
                                                        false -> { first: concat(concat(concat(l, "\n"), r), "\n"), second: "" }
                                                    }
                                                };
                                                false -> {
                                                    // Arithmetic expects left in r1, right in r2 (same as add/mul). For non-string: left to left_reg, right to right_reg.
                                                    // String concat expects X0=left, X1=right; keep original layout.
                                                    l: string <- case is_string_prim of {
                                                        true -> case bound.debug of {
                                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                        };
                                                        false -> case bound.debug of {
                                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                        }
                                                    };
                                                    r: string <- case is_string_prim of {
                                                        true -> case bound.debug of {
                                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                        };
                                                        false -> case bound.debug of {
                                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                        }
                                                    };
                                                    identity_moves: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 0 and (term_sir_helpers@sir_term_root_node(term).name == "and" or term_sir_helpers@sir_term_root_node(term).name == "or") of {
                                                        true -> case is_float64 or is_float32 or is_float16 of {
                                                            true -> concat(concat(concat(concat("    FMOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    FMOV ", left_reg), ", "), left_reg), ""));
                                                            false -> concat(concat(concat(concat("    MOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    MOV ", left_reg), ", "), left_reg), ""))
                                                        };
                                                        false -> ""
                                                    };
                                                    second_with_id: string <- case len(identity_moves) > 0 of {
                                                        true -> concat(concat(r, "\n"), identity_moves);
                                                        false -> r
                                                    };
                                                    // Left may be a call (kind 4): emit right first, save right_reg, then left, restore (right survives left's clobbers).
                                                    // If both operands are calls (e.g. fib(n-1)+fib(n-2)), right eval runs first and BLR leaves X0 = fib(n-2), not n — spill X0 before right, LDR X0 before left so fib(n-1) sees n.
                                                    // Right-only call: emit left first, then right; spill left_reg across BLR (AAPCS64 volatiles). See factorial n * factorial(n-1).
                                                    left_is_call: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 4;
                                                    right_is_call: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 4;
                                                    save_x0_before_right_when_both_calls: string <- case left_is_call and right_is_call of {
                                                        true -> case is_float64 or is_float32 or is_float16 of {
                                                            true -> "";
                                                            false -> case is_string_prim of {
                                                                true -> "    STR X0, [SP, #-16]!\n";
                                                                false -> "    STR X0, [SP, #-16]!\n"
                                                            }
                                                        };
                                                        false -> ""
                                                    };
                                                    restore_x0_before_left_when_both_calls: string <- case left_is_call and right_is_call of {
                                                        true -> case is_float64 or is_float32 or is_float16 of {
                                                            true -> "";
                                                            false -> case is_string_prim of {
                                                                true -> "    LDR X0, [SP], #16\n";
                                                                false -> "    LDR X0, [SP], #16\n"
                                                            }
                                                        };
                                                        false -> ""
                                                    };
                                                    save_right_after_restore_x0_both_calls: string <- case left_is_call and right_is_call of {
                                                        true -> case is_string_prim of {
                                                            true -> "    STR X1, [SP, #-16]!\n";
                                                            false -> concat(concat("    STR ", right_reg), ", [SP, #-16]!\n")
                                                        };
                                                        false -> ""
                                                    };
                                                    save_left_across_right_call: string <- case right_is_call of {
                                                        true -> case is_string_prim of {
                                                            true -> "    STR X0, [SP, #-16]!\n";
                                                            false -> concat(concat("    STR ", left_reg), ", [SP, #-16]!\n")
                                                        };
                                                        false -> ""
                                                    };
                                                    restore_left_across_right_call: string <- case right_is_call of {
                                                        true -> case is_string_prim of {
                                                            true -> "    LDR X0, [SP], #16\n";
                                                            false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                                        };
                                                        false -> ""
                                                    };
                                                    save_right: string <- case left_is_call of {
                                                        true -> case left_is_call and right_is_call of {
                                                            true -> "";
                                                            false -> case is_string_prim of {
                                                                true -> "    STR X1, [SP, #-16]!\n";
                                                                false -> concat(concat("    STR ", right_reg), ", [SP, #-16]!\n")
                                                            }
                                                        };
                                                        false -> ""
                                                    };
                                                    restore_right: string <- case left_is_call of {
                                                        true -> case is_string_prim of {
                                                            true -> "    LDR X1, [SP], #16\n";
                                                            false -> concat(concat("    LDR ", right_reg), ", [SP], #16\n")
                                                        };
                                                        false -> ""
                                                    };
                                                    first_combined: string <- case left_is_call of {
                                                        true -> {
                                                            fc0: string <- concat(save_x0_before_right_when_both_calls, second_with_id);
                                                            fc1: string <- concat(concat(concat(concat(concat(concat(fc0, "\n"), restore_x0_before_left_when_both_calls), "\n"), save_right_after_restore_x0_both_calls), "\n"), save_right);
                                                            concat(concat(concat(concat(fc1, l), "\n"), restore_right), "")
                                                        };
                                                        false -> case right_is_call of {
                                                            true -> concat(concat(concat(concat(concat(concat(l, "\n"), save_left_across_right_call), second_with_id), "\n"), restore_left_across_right_call), "");
                                                            false -> concat(concat(second_with_id, "\n"), l)
                                                        }
                                                    };
                                                    { first: first_combined, second: "" }
                                                }
                                            }
                                        }
                                    };
                                    join_cmp3(args_pair_first.first, args_pair_first.second, prims@emit_prim_op(term, dest))
                                }
                            };
                            false -> {
                                // bound.bound_name != "": inside let/function body. Use same layout as bound.bound_name=="": left->r1, right->r2.
                                // String concat expects X0=left, X1=right; keep original layout for is_string_prim.
                                left_is_prim: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6;
                                right_is_prim: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6;
                                bool_and_or_two_prims: bool <- right_is_prim and term_sir_helpers@sir_term_root_node(term).type_name == "bool" and (term_sir_helpers@sir_term_root_node(term).name == "and" or term_sir_helpers@sir_term_root_node(term).name == "or") and is_string_prim == false and is_float64 == false and is_float32 == false and is_float16 == false;
                                                                args_pair_left: { first: string, second: string } <- case left_is_prim of {
                                    true -> case bool_and_or_two_prims of {
                                        true -> {
                                            temp_reg: string <- left_reg;
                                            left_inner: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            save_left: string <- concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                            right_inner: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            restore_left: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                            combined: string <- concat(concat(concat(concat(concat(concat(left_inner, "\n"), save_left), right_inner), "\n"), restore_left), "");
                                            { first: combined, second: "" }
                                        };
                                        false -> case right_is_prim and is_string_prim == false and is_float64 == false and is_float32 == false and is_float16 == false of {
                                            true -> {
                                                temp_reg2: string <- left_reg;
                                                left_2p: string <- case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg2, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg2, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                save_l2: string <- concat(concat("    STR ", temp_reg2), ", [SP, #-16]!\n");
                                                right_2p: string <- case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                restore_l2: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                                comb_2p: string <- concat(concat(concat(concat(concat(concat(left_2p, "\n"), save_l2), right_2p), "\n"), restore_l2), "");
                                                { first: comb_2p, second: "" }
                                            };
                                            false -> {
                                                right_simple_for_left_prim: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 0 or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 1;
                                                // String concat keeps its left operand in X0, which a call in the right operand
                                                // destroys: the emitted code was `BL L_concat_helper` (left in X0), the call, then
                                                // `MOV X1, X0 / BL L_concat_helper`, so both operands became the right one. That is
                                                // half of why the selfhost emitted " 0 0" per atom instead of the atom's bytes.
                                                // See trials/codegen_regressions/concat_call_operand.silica.
                                                right_calls_for_left_prim: bool <- term_user_call_helpers@term_subterm_has_user_call(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
                                                preserve_left_for_right: bool <- right_simple_for_left_prim == false and (is_string_prim == false or right_calls_for_left_prim) and is_float64 == false and is_float32 == false and is_float16 == false;
                                                case preserve_left_for_right of {
                                                    true -> {
                                                        l: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug });
                                                        r: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: bound.debug });
                                                        save_left_np: string <- concat(concat("    STR ", left_reg), ", [SP, #-16]!\n");
                                                        restore_left_np: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                                        combined_np: string <- concat(concat(concat(concat(concat(concat(l, "\n"), save_left_np), r), "\n"), restore_left_np), "");
                                                        { first: combined_np, second: "" }
                                                    };
                                                    false -> case right_val_0 of {
                                                        true -> case left_is_rp and left_proj_n >= 0 of {
                                                            true -> { first: join_cmp_rl("    MOV X10, #0\n", emit_proj_x9(left_proj_n, left_proj_off)), second: "" };
                                                            false -> case left_is_len and left_arg_is_tail of {
                                                                true -> { first: join_cmp_rl("    MOV X10, #0\n", emit_list_len_of_tail(list_tail_n)), second: "" };
                                                                false -> { first: join_cmp_rl("    MOV X10, #0\n", emit_cmp_left_only(left_reg, bound, pools, emit_child, term)), second: "" }
                                                            }
                                                        };
                                                        false -> case right_val_1 of {
                                                            true -> case left_is_rp and left_proj_n >= 0 of {
                                                                true -> { first: join_cmp_rl("    MOV X10, #1\n", emit_proj_x9(left_proj_n, left_proj_off)), second: "" };
                                                                false -> { first: join_cmp_rl("    MOV X10, #1\n", emit_cmp_left_only(left_reg, bound, pools, emit_child, term)), second: "" }
                                                            };
                                                            false -> { first: emit_cmp_left_then_right(left_reg, right_reg, bound, pools, emit_child, term), second: "" }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    };
                                    false -> case right_is_prim of {
                                        true -> {
                                            temp_reg: string <- concat(reg_prefix, "0");
                                            l: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            save: string <- case is_string_prim of {
                                                true -> "    STR X0, [SP, #-16]!\n";
                                                false -> case is_float64 or is_float32 or is_float16 of {
                                                    true -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                                    false -> "    STR X0, [SP, #-16]!\n"
                                                }
                                            };
                                            r: string <- case is_string_prim of {
                                                true -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                false -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                }
                                            };
                                            restore: string <- case is_string_prim of {
                                                true -> "    LDR X0, [SP], #16\n";
                                                false -> case is_float64 or is_float32 or is_float16 of {
                                                    true -> concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                                    false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                                }
                                            };
                                            left_combined: string <- concat(concat(concat(concat(concat(concat(l, "\n"), save), r), "\n"), restore), "");
                                            { first: left_combined, second: "" }
                                        };
                                        false -> {
                                            // left->left_reg, right->right_reg (same as bound.bound_name=="") for arithmetic.
                                            l: string <- case is_string_prim of {
                                                true -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                false -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  left_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                }
                                            };
                                            r: string <- case is_string_prim of {
                                                true -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                false -> case bound.debug of {
                                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  right_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                }
                                            };
                                            // For float32/float64: emit right before left. Left writes to S1/D1 (left_reg),
                                            // which may be the source register for the right var. Emit right first to preserve it.
                                            // For string_prim with left=const: loading literal into X0 (left_reg) clobbers right var if right is in X0.
                                            // Emit right first (MOV X1, X0) to save right before loading left literal into X0.
                                            // When right operand is a call (kind 4), save/restore left_reg across it (AAPCS64: X9-X15 are caller-saved).
                                            left_is_call: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 4;
                                            right_is_call: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 4;
                                            // A call anywhere inside the right operand clobbers the left operand's register,
                                            // not just a call at its root, and string concat is no exception: its left operand
                                            // sits in X0, which every call returns into. `concat(one, rest(tail))` --
                                            // print_atom_inline:emit_rodata_entries -- emitted the left, then the call, then
                                            // MOV X1, X0 / BL L_concat_helper, so both operands became the call's result and
                                            // the fold collapsed to its base case "". That is why the selfhost emitted an
                                            // empty L_pa_table and no function bodies.
                                            // See trials/codegen_regressions/concat_fold_call.silica.
                                            right_calls_here: bool <- term_user_call_helpers@term_subterm_has_user_call(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
                                            case right_calls_here or right_is_call of {
                                                true -> {
                                                    save_left: string <- concat(concat("    STR ", left_reg), ", [SP, #-16]!\n");
                                                    restore_left: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                                    combined: string <- concat(concat(concat(concat(concat(concat(l, "\n"), save_left), r), "\n"), restore_left), "");
                                                    { first: combined, second: "" }
                                                };
                                                false -> case left_is_call and is_string_prim == false of {
                                                    true -> {
                                                        save_right: string <- concat(concat("    STR ", right_reg), ", [SP, #-16]!\n");
                                                        restore_right: string <- concat(concat("    LDR ", right_reg), ", [SP], #16\n");
                                                        combined: string <- concat(concat(concat(concat(concat(concat(r, "\n"), save_right), l), "\n"), restore_right), "");
                                                        { first: combined, second: "" }
                                                    };
                                                    false -> case is_float32 or is_float64 or is_float16 or (is_string_prim and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 0) of {
                                                        true -> { first: r, second: l };
                                                        false -> { first: emit_cmp_left_then_right(left_reg, right_reg, bound, pools, emit_child, term), second: "" }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                };
                                case left_type_is_string or is_float64 or is_float32 or is_float16 of {
                                    true -> join_cmp3(args_pair_left.first, args_pair_left.second, prims@emit_prim_op(term, dest));
                                    false -> case cmp_is_eq of {
                                        true -> join_operands_op(join_cmp3(args_pair_left.first, args_pair_left.second, ""), emit_gpr_cset(dest, "EQ"));
                                        false -> case cmp_is_nq of {
                                            true -> join_operands_op(join_cmp3(args_pair_left.first, args_pair_left.second, ""), emit_gpr_cset(dest, "NE"));
                                            false -> case cmp_is_lt of {
                                                true -> join_operands_op(join_cmp3(args_pair_left.first, args_pair_left.second, ""), emit_gpr_cset(dest, "LT"));
                                                false -> case cmp_is_gt of {
                                                    true -> join_operands_op(join_cmp3(args_pair_left.first, args_pair_left.second, ""), emit_gpr_cset(dest, "GT"));
                                                    false -> case cmp_is_le of {
                                                        true -> join_operands_op(join_cmp3(args_pair_left.first, args_pair_left.second, ""), emit_gpr_cset(dest, "LE"));
                                                        false -> case cmp_is_ge of {
                                                            true -> join_operands_op(join_cmp3(args_pair_left.first, args_pair_left.second, ""), emit_gpr_cset(dest, "GE"));
                                                            false -> join_cmp3(args_pair_left.first, args_pair_left.second, prims@emit_prim_op(term, dest))
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        }
}
