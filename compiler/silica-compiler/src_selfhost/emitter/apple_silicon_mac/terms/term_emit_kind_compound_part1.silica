// Compound kind emission part1 + flat aggregate stores (open-recursive via emit_child).

use atom_table;
use var;
use prims_tuple;
use prims_record;
use string_parse;
use reg_conventions;
use term_aggregate_helpers;
use term_child_spec;
use term_record_layout;
use term_sir_helpers;
use term_user_call_abi;
use term_emit_kind_compound_part2;

export emit_kind_compound_part1/6;

fn join_alloc_stores_tail(alloc: string, stores: string, tail: string) -> string {
    concat(alloc, concat(stores, tail))
}

fn emit_flat_tuple_stores(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, walk: { idx: int64, count: int64 }, sp_adjust: int64, byte_cursor: int64, store_base: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
    idx: int64 <- walk.idx;
    count: int64 <- walk.count;
    case idx < count - 1 and term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
        true -> {
            elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
            elem_is_agg: bool <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and (term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" or term_sir_helpers@sir_term_root_node(elem).name == "record_make");
            type_prefix: string <- reg_conventions@reg_prefix_for_type(term_sir_helpers@sir_term_root_node(elem).type_name);
            elem_prefix: string <- case elem_is_agg of {
                true -> "X";
                false -> case type_prefix == "X" and term_sir_helpers@sir_term_root_node(elem).kind == 0 and term_user_call_abi@const_value_dot_implies_float64(term_sir_helpers@sir_term_root_node(elem).type_name, term_sir_helpers@sir_term_root_node(elem).value) of {
                    true -> "D";
                    false -> type_prefix
                }
            };
            temp_reg: string <- concat(elem_prefix, "9");
            elem_asm: string <- case bound.debug of {
                true -> { emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                false -> emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
            };
            nested_bytes: int64 <- case elem_is_agg of {
                true -> term_aggregate_helpers@agg_alloc_inner(elem);
                false -> 0
            };
            new_adjust: int64 <- sp_adjust + nested_bytes;
            box_f32: bool <- count > 1 and elem_is_agg == false and reg_conventions@is_float32_type(term_sir_helpers@sir_term_root_node(elem).type_name);
            case box_f32 of {
                true -> {
                    store_asm: string <- term_aggregate_helpers@emit_flat_float32_boxed_pair(store_base, byte_cursor, temp_reg);
                    rest_asm: string <- emit_flat_tuple_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), { idx: idx + 1, count: count }, new_adjust, byte_cursor + 16, store_base, bound, pools, emit_child);
                    concat(concat(elem_asm, concat("\n", store_asm)), rest_asm)
                };
                false -> case elem_is_agg of {
                    true -> {
                        store_offset: int64 <- idx * 8 + sp_adjust;
                        promote_asm: string <- term_aggregate_helpers@tuple_elem_heap_promote(temp_reg, nested_bytes);
                        reclaim_nested: string <- case nested_bytes > 0 of {
                            true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(nested_bytes), "\n"));
                            false -> ""
                        };
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, store_offset))));
                        next_bc: int64 <- store_offset + 8;
                        rest_asm: string <- emit_flat_tuple_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), { idx: idx + 1, count: count }, sp_adjust, next_bc, store_base, bound, pools, emit_child);
                        concat(concat(elem_asm, concat("\n", concat(promote_asm, concat(reclaim_nested, store_asm)))), concat("\n", rest_asm))
                    };
                    false -> {
                        promote_var_asm: string <- term_aggregate_helpers@tuple_elem_heap_promote(temp_reg, term_aggregate_helpers@tuple_elem_var_aggregate_promote_bytes(elem, bound.bound_name));
                        reclaim_asm: string <- term_aggregate_helpers@tuple_elem_sret_reclaim(temp_reg, term_aggregate_helpers@let_user_call_tuple_sret_stack_bytes(elem, bound.outer_reg, bound.bound_name));
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, byte_cursor))));
                        rest_asm: string <- emit_flat_tuple_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), { idx: idx + 1, count: count }, new_adjust, byte_cursor + 8, store_base, bound, pools, emit_child);
                        concat(concat(elem_asm, concat("\n", concat(promote_var_asm, concat(reclaim_asm, store_asm)))), concat("\n", rest_asm))
                    }
                }
            }
        };
        false -> {
            elem_is_agg: bool <- term_sir_helpers@sir_term_root_node(term).kind == 6 and (term_sir_helpers@sir_term_root_node(term).name == "tuple_make" or term_sir_helpers@sir_term_root_node(term).name == "record_make");
            type_prefix2: string <- reg_conventions@reg_prefix_for_type(term_sir_helpers@sir_term_root_node(term).type_name);
            elem_prefix: string <- case elem_is_agg of {
                true -> "X";
                false -> case type_prefix2 == "X" and term_sir_helpers@sir_term_root_node(term).kind == 0 and term_user_call_abi@const_value_dot_implies_float64(term_sir_helpers@sir_term_root_node(term).type_name, term_sir_helpers@sir_term_root_node(term).value) of {
                    true -> "D";
                    false -> type_prefix2
                }
            };
            temp_reg: string <- concat(elem_prefix, "9");
            elem_asm: string <- case bound.debug of {
                true -> { emit_child(term,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                false -> emit_child(term,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
            };
            nested_bytes: int64 <- case elem_is_agg of {
                true -> term_aggregate_helpers@agg_alloc_inner(term);
                false -> 0
            };
            box_f32_last: bool <- count > 1 and elem_is_agg == false and reg_conventions@is_float32_type(term_sir_helpers@sir_term_root_node(term).type_name);
            case box_f32_last of {
                true -> concat(elem_asm, concat("\n", term_aggregate_helpers@emit_flat_float32_boxed_pair(store_base, byte_cursor, temp_reg)));
                false -> case elem_is_agg of {
                    true -> {
                        store_offset: int64 <- idx * 8 + sp_adjust;
                        promote_asm: string <- term_aggregate_helpers@tuple_elem_heap_promote(temp_reg, nested_bytes);
                        reclaim_nested: string <- case nested_bytes > 0 of {
                            true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(nested_bytes), "\n"));
                            false -> ""
                        };
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, store_offset))));
                        concat(elem_asm, concat("\n", concat(promote_asm, concat(reclaim_nested, store_asm))))
                    };
                    false -> {
                        promote_var_asm: string <- term_aggregate_helpers@tuple_elem_heap_promote(temp_reg, term_aggregate_helpers@tuple_elem_var_aggregate_promote_bytes(term, bound.bound_name));
                        reclaim_asm: string <- term_aggregate_helpers@tuple_elem_sret_reclaim(temp_reg, term_aggregate_helpers@let_user_call_tuple_sret_stack_bytes(term, bound.outer_reg, bound.bound_name));
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, byte_cursor))));
                        concat(elem_asm, concat("\n", concat(promote_var_asm, concat(reclaim_asm, store_asm))))
                    }
                }
            }
        }
    }
}



fn emit_flat_record_stores(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, R: string, sp_adjust: int64, field_prefix: int64, store_base: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        false -> "";
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind < 0 of {
            true -> {
                elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
                fname: string <- term_sir_helpers@sir_term_root_node(term).value;
                fty: string <- prims_record@find_field_type_in_record(R, fname);
                base_off: int64 <- prims_record@offset_bytes_before_field(R, fname);
                elem_is_agg: bool <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and (term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" or term_sir_helpers@sir_term_root_node(elem).name == "record_make");
                // Inline EVERY nested record literal into the outer slab, whatever its fields hold. This is the
                // layout every reader already assumes: offset_bytes_before_field and
                // record_type_value_flat_byte_size both recurse into a nested record field unconditionally, so
                // a field after one is placed as if it were inlined. Storing a pointer instead put one word
                // where several were expected AND leaked a pointer to a stack copy that dies with the frame,
                // so reading `outer.nested.field` yielded the nested record's address.
                // type_checker_core:parse_type_into_context returns
                //     { context: { env: ctx.env, interner: pr.interner }, id: pr.id, ok: pr.ok }
                // whose `context` holds a List and a record, so create_type_context handed that address to
                // prepend as a list handle -- the fault that stopped type checking.
                //
                // This is only affordable because strip_spaces_rt no longer rebuilds an already-stripped
                // string: placing fields this way asks for record_type_starts and flat sizes far more often,
                // and with the old quadratic strip the seed was OOM-killed emitting
                // parser/constraint_extract_expr.silica. That unit now costs the same 40s it did before.
                //
                // Records only: tuples keep a uniform 8-byte stride with heap-promoted pointers, which is what
                // the lexer's Token*/Lexer* returns need (see the rec_flat note in emit_flat_tuple_stores).
                // See trials/codegen_regressions/rec_nested_nonscalar.silica.
                inline_nested_rec: bool <- elem_is_agg and term_sir_helpers@sir_term_root_node(elem).name == "record_make";
                case inline_nested_rec of {
                    true -> emit_flat_record_stores(elem, fty, sp_adjust, field_prefix + base_off, store_base, bound, pools, emit_child);
                    false -> case term_sir_helpers@sir_term_root_node(elem).kind == 6 and term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" and prims_tuple@count_flat_elements(elem) == 2 of {
                        true -> {
                            e0_sf: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(elem, term_sir_helpers@sir_term_root_node(elem).inner);
                            e1w_sf: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(elem, term_sir_helpers@sir_term_root_node(elem).right_expr);
                            e1_sf: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case term_sir_helpers@sir_term_root_node(e1w_sf).kind == 6 and term_sir_helpers@sir_term_root_node(e1w_sf).name == "tuple_make" of {
                                true -> term_sir_helpers@sir_term_at(e1w_sf, term_sir_helpers@sir_term_root_node(e1w_sf).inner);
                                false -> e1w_sf
                            };
                            a0_sf: string <- case bound.debug of {
                                true -> { emit_child(e0_sf,  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(e0_sf,  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            off0_sf: int64 <- term_record_layout@record_store_offset_for_field(R, fname, field_prefix, base_off, sp_adjust);
                            st0_sf: string <- concat("    STR X9, ", concat(term_aggregate_helpers@tuple_flat_memref(store_base, off0_sf), "\n"));
                            a1_sf: string <- case bound.debug of {
                                true -> { emit_child(e1_sf,  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(e1_sf,  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            off1_sf: int64 <- off0_sf + 8;
                            st1_sf: string <- concat("    STR X10, ", concat(term_aggregate_helpers@tuple_flat_memref(store_base, off1_sf), "\n"));
                            concat(concat(concat(concat(a0_sf, "\n"), concat(st0_sf, concat(a1_sf, "\n"))), st1_sf), "\n")
                        };
                        false -> {
                            type_prefix: string <- reg_conventions@reg_prefix_for_type(fty);
                            elem_prefix: string <- case elem_is_agg of {
                                true -> "X";
                                false -> case type_prefix == "X" and term_sir_helpers@sir_term_root_node(elem).kind == 0 and term_user_call_abi@const_value_dot_implies_float64(term_sir_helpers@sir_term_root_node(elem).type_name, term_sir_helpers@sir_term_root_node(elem).value) of {
                                    true -> "D";
                                    false -> type_prefix
                                }
                            };
                            temp_reg: string <- concat(elem_prefix, "9");
                            elem_asm: string <- case bound.debug of {
                                true -> { emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            nested_bytes: int64 <- term_aggregate_helpers@record_field_nested_return_bytes(elem, fty, elem_is_agg);
                            new_adjust: int64 <- sp_adjust + nested_bytes;
                            store_offset: int64 <- term_record_layout@record_store_offset_for_field(R, fname, field_prefix, base_off, new_adjust);
                            copy_inline_struct_field: bool <- term_aggregate_helpers@record_field_inline_pointer_value(elem, fty);
                            store_asm: string <- case copy_inline_struct_field of {
                                true -> term_aggregate_helpers@emit_inline_record_field_copy_words(temp_reg, store_base, store_offset, 0, prims_record@record_type_value_flat_byte_size(fty) / 8);
                                false -> concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, store_offset))))
                            };
                            reclaim_asm: string <- term_aggregate_helpers@tuple_elem_sret_reclaim(temp_reg, term_aggregate_helpers@let_user_call_tuple_sret_stack_bytes(elem, bound.outer_reg, bound.bound_name));
                            concat(elem_asm, concat("\n", concat(reclaim_asm, store_asm)))
                        }
                    }
                }
            };
            false -> {
                elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
                fname: string <- term_sir_helpers@sir_term_root_node(term).value;
                fty: string <- prims_record@find_field_type_in_record(R, fname);
                base_off: int64 <- prims_record@offset_bytes_before_field(R, fname);
                elem_is_agg: bool <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and (term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" or term_sir_helpers@sir_term_root_node(elem).name == "record_make");
                // Inline EVERY nested record literal into the outer slab, whatever its fields hold. This is the
                // layout every reader already assumes: offset_bytes_before_field and
                // record_type_value_flat_byte_size both recurse into a nested record field unconditionally, so
                // a field after one is placed as if it were inlined. Storing a pointer instead put one word
                // where several were expected AND leaked a pointer to a stack copy that dies with the frame,
                // so reading `outer.nested.field` yielded the nested record's address.
                // type_checker_core:parse_type_into_context returns
                //     { context: { env: ctx.env, interner: pr.interner }, id: pr.id, ok: pr.ok }
                // whose `context` holds a List and a record, so create_type_context handed that address to
                // prepend as a list handle -- the fault that stopped type checking.
                //
                // This is only affordable because strip_spaces_rt no longer rebuilds an already-stripped
                // string: placing fields this way asks for record_type_starts and flat sizes far more often,
                // and with the old quadratic strip the seed was OOM-killed emitting
                // parser/constraint_extract_expr.silica. That unit now costs the same 40s it did before.
                //
                // Records only: tuples keep a uniform 8-byte stride with heap-promoted pointers, which is what
                // the lexer's Token*/Lexer* returns need (see the rec_flat note in emit_flat_tuple_stores).
                // See trials/codegen_regressions/rec_nested_nonscalar.silica.
                inline_nested_rec: bool <- elem_is_agg and term_sir_helpers@sir_term_root_node(elem).name == "record_make";
                case inline_nested_rec of {
                    true -> {
                        inner_asm: string <- emit_flat_record_stores(elem, fty, sp_adjust, field_prefix + base_off, store_base, bound, pools, emit_child);
                        rest_asm: string <- emit_flat_record_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), R, sp_adjust, field_prefix, store_base, bound, pools, emit_child);
                        concat(concat(inner_asm, "\n"), rest_asm)
                    };
                    false -> case term_sir_helpers@sir_term_root_node(elem).kind == 6 and term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" and prims_tuple@count_flat_elements(elem) == 2 of {
                        true -> {
                            e0: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(elem, term_sir_helpers@sir_term_root_node(elem).inner);
                            e1w: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(elem, term_sir_helpers@sir_term_root_node(elem).right_expr);
                            e1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case term_sir_helpers@sir_term_root_node(e1w).kind == 6 and term_sir_helpers@sir_term_root_node(e1w).name == "tuple_make" of {
                                true -> term_sir_helpers@sir_term_at(e1w, term_sir_helpers@sir_term_root_node(e1w).inner);
                                false -> e1w
                            };
                            a0: string <- case bound.debug of {
                                true -> { emit_child(e0,  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(e0,  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            off0: int64 <- term_record_layout@record_store_offset_for_field(R, fname, field_prefix, base_off, sp_adjust);
                            st0: string <- concat("    STR X9, ", concat(term_aggregate_helpers@tuple_flat_memref(store_base, off0), "\n"));
                            a1: string <- case bound.debug of {
                                true -> { emit_child(e1,  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(e1,  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            off1: int64 <- off0 + 8;
                            st1: string <- concat("    STR X10, ", concat(term_aggregate_helpers@tuple_flat_memref(store_base, off1), "\n"));
                            pair_asm: string <- concat(concat(concat(concat(a0, "\n"), concat(st0, concat(a1, "\n"))), st1), "\n");
                            rest_asm: string <- emit_flat_record_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), R, sp_adjust, field_prefix, store_base, bound, pools, emit_child);
                            concat(pair_asm, rest_asm)
                        };
                        false -> {
                            type_prefix: string <- reg_conventions@reg_prefix_for_type(fty);
                            elem_prefix: string <- case elem_is_agg of {
                                true -> "X";
                                false -> case type_prefix == "X" and term_sir_helpers@sir_term_root_node(elem).kind == 0 and term_user_call_abi@const_value_dot_implies_float64(term_sir_helpers@sir_term_root_node(elem).type_name, term_sir_helpers@sir_term_root_node(elem).value) of {
                                    true -> "D";
                                    false -> type_prefix
                                }
                            };
                            temp_reg: string <- concat(elem_prefix, "9");
                            elem_asm: string <- case bound.debug of {
                                true -> { emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                false -> emit_child(elem,  temp_reg, pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            nested_bytes: int64 <- term_aggregate_helpers@record_field_nested_return_bytes(elem, fty, elem_is_agg);
                            new_adjust: int64 <- sp_adjust + nested_bytes;
                            store_offset: int64 <- term_record_layout@record_store_offset_for_field(R, fname, field_prefix, base_off, new_adjust);
                            copy_inline_struct_field: bool <- term_aggregate_helpers@record_field_inline_pointer_value(elem, fty);
                            store_asm: string <- case copy_inline_struct_field of {
                                true -> term_aggregate_helpers@emit_inline_record_field_copy_words(temp_reg, store_base, store_offset, 0, prims_record@record_type_value_flat_byte_size(fty) / 8);
                                false -> concat("    STR ", concat(temp_reg, concat(", ", term_aggregate_helpers@tuple_flat_memref(store_base, store_offset))))
                            };
                            rest_asm: string <- emit_flat_record_stores(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), R, new_adjust, field_prefix, store_base, bound, pools, emit_child);
                            reclaim_asm: string <- term_aggregate_helpers@tuple_elem_sret_reclaim(temp_reg, term_aggregate_helpers@let_user_call_tuple_sret_stack_bytes(elem, bound.outer_reg, bound.bound_name));
                            concat(concat(elem_asm, concat("\n", concat(reclaim_asm, store_asm))), concat("\n", rest_asm))
                        }
                    }
                }
            }
        }
    }
}


fn emit_kind_compound_part1(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
case term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
    true -> {
                            count: int64 <- prims_tuple@count_flat_elements(term);
                            sret_base: string <- var@find_sp_binding(bound.outer_reg, "_tuple_sret");
                            outer_flat_bytes_tm: int64 <- term_aggregate_helpers@tuple_make_rec_flat_outer_alloc_bytes(term, count);
                            alloc_asm: string <- case len(sret_base) > 0 of {
                                true -> "";
                                false -> concat("    SUB SP, SP, #", concat(atom_table@int64_to_decimal_string(outer_flat_bytes_tm), "\n"))
                            };
                            nested_raw: int64 <- term_aggregate_helpers@flat_tuple_nested_alloc(term, count, 0);
                            // Value-flat tuple head (record_make, …): fields sit at the innermost SP after nested SUBs.
                            // flat_tuple_nested_alloc counts nested bytes for ADD SP — that points past the payload; heap
                            // promote then copied garbage (supervisor init / e4a).
                            rec_flat_tuple: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" and count >= 2;
                            nested_adjust: int64 <- case rec_flat_tuple of {
                                true -> 0;
                                false -> nested_raw
                            };
                            dest_ptr: string <- case len(dest) > 0 and substring(dest, 0, 1) == "W" of {
                                true -> concat("X", substring(dest, 1, len(dest)));
                                false -> dest
                            };
                            mov_asm: string <- case dest == "SP" of {
                                true -> "";
                                false -> case len(sret_base) > 0 of {
                                    true -> case nested_adjust == 0 of {
                                        true -> concat(concat("    MOV ", dest_ptr), concat(", ", sret_base));
                                        false -> concat("    ADD ", concat(dest_ptr, concat(", ", concat(sret_base, concat(", #", atom_table@int64_to_decimal_string(nested_adjust))))))
                                    };
                                    false -> case nested_adjust == 0 of {
                                        true -> concat(concat("    MOV ", dest_ptr), ", SP");
                                        false -> concat("    ADD ", concat(dest_ptr, concat(", SP, #", atom_table@int64_to_decimal_string(nested_adjust))))
                                    }
                                }
                            };
                            join_alloc_stores_tail(alloc_asm, emit_flat_tuple_stores(term, { idx: 0, count: count }, 0, 0, sret_base, bound, pools, emit_child), concat("\n", mov_asm))
                        };
    false -> case term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
    true -> {
                                count_r: int64 <- prims_record@count_record_fields(term_sir_helpers@sir_term_root_node(term).type_name);
                                Rm: string <- term_sir_helpers@sir_term_root_node(term).type_name;
                            // Outer SUB = shell + user-call padding reserved in this frame. Nested record_make/tuple_make
                            // self-SUB (exclude them — structs_addition/04); user-call returns are memcpy'd in
                            // (include them — wbt from_sorted_err). flat_record_total_alloc stays for dealloc/nested_adjust.
                            alloc_sz_r: int64 <- term_record_layout@record_make_stack_alloc_size(Rm) + term_aggregate_helpers@flat_record_sum_nested_reserved_in_outer(term);
                            // Ignore |_tuple_sret for record_make: always SUB SP + SP-relative stores. Tuple path may use X8
                            // safely when the make has no prior BL; record_make often follows region_alloc / other BL.
                            sret_base_r: string <- "";
                            alloc_asm_r: string <- concat("    SUB SP, SP, #", concat(atom_table@int64_to_decimal_string(alloc_sz_r), "\n"));
                            // Stores start already shifted past the reserved user-call area, because the shell sits ABOVE
                            // it: nested_adjust_r below places the returned base at SP + reserved + self-SUB'd makes.
                            // sp_adjust only tracks SP actually moving, which a memcpy'd user-call return never does, so
                            // starting at 0 shifted a field only from the reserving field onwards. Fields emitted EARLIER
                            // then landed below the shell base and the shell's own slot was never written, so reading the
                            // field back returned whatever the preceding call left on the stack. That is what fed the
                            // slots list into `declarations` in constraint_extract_decls:slots_to_program,
                            //     { declarations: decls, location: program_location_from_decls(decls) }
                            // whose declarations were later walked as if they were declarations. See
                            // trials/codegen_regressions/rec_call_field.silica.
                            hidden_child_tramp_r: string <- term_child_spec@emit_child_spec_hidden_trampoline_store(term, Rm);
                            nested_adjust_r: int64 <- term_aggregate_helpers@flat_record_sum_nested_inners(term);
                            dest_ptr_r: string <- case len(dest) > 0 and substring(dest, 0, 1) == "W" of {
                                true -> concat("X", substring(dest, 1, len(dest)));
                                false -> dest
                            };
                            mov_asm_r: string <- case dest == "SP" of {
                                true -> "";
                                false -> case len(sret_base_r) > 0 of {
                                    true -> case nested_adjust_r == 0 of {
                                        true -> concat(concat("    MOV ", dest_ptr_r), concat(", ", sret_base_r));
                                        false -> concat("    ADD ", concat(dest_ptr_r, concat(", ", concat(sret_base_r, concat(", #", atom_table@int64_to_decimal_string(nested_adjust_r))))))
                                    };
                                    false -> case nested_adjust_r == 0 of {
                                        true -> concat(concat("    MOV ", dest_ptr_r), ", SP");
                                        false -> concat("    ADD ", concat(dest_ptr_r, concat(", SP, #", atom_table@int64_to_decimal_string(nested_adjust_r))))
                                    }
                                }
                            };
                            join_alloc_stores_tail(alloc_asm_r, emit_flat_record_stores(term, Rm, term_aggregate_helpers@flat_record_sum_nested_reserved_in_outer(term), 0, sret_base_r, bound, pools, emit_child), concat(hidden_child_tramp_r, concat("\n", mov_asm_r)))
                        };
    false -> case term_sir_helpers@sir_term_root_node(term).name == "record_proj" of {
    true -> {
                            rp_var: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of { true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name; false -> "" };
                            // The chain may bottom out in a value rather than a variable (`slots.head.token.kind`
                            // roots at a list_head prim, kind 6). Evaluate that base into X0 instead of falling
                            // through to the variable path, which finds no slot and loads [SP, #0].
                            call_inner_rp: bool <- term_aggregate_helpers@record_proj_chain_base_is_value(term);
                            rp_base_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_aggregate_helpers@record_proj_chain_base_term(term);
                            call_inner_asm_rp: string <- case call_inner_rp of {
                                true -> case bound.debug of {
                                    true -> { emit_child(rp_base_term,  "X0", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                    false -> emit_child(rp_base_term,  "X0", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                false -> ""
                            };
                            chain_root: string <- term_aggregate_helpers@record_proj_chain_root_var_name(term);
                            rp_var_use: string <- case len(chain_root) > 0 of {
                                true -> chain_root;
                                false -> rp_var
                            };
                            va_key_rp: string <- concat("_va.", rp_var_use);
                            va_str_rp: string <- case len(rp_var_use) > 0 of { true -> var@find_sp_binding(bound.outer_reg, va_key_rp); false -> "" };
                            // Last, not first: a tuple destructuring registers the element's slab offset and then
                            // the register it was actually loaded into, so outer_reg holds `%r=[SP, #8]|%r=X21`.
                            // The offset points into a slab the callee already promoted to the heap and popped,
                            // so taking the first binding loads garbage. Variable loads and calls resolve the
                            // innermost binding for the same reason (see var@find_sp_binding_bare_or_percent_param).
                            var_binding_rp: string <- case len(rp_var_use) > 0 of { true -> var@find_last_sp_binding(bound.outer_reg, rp_var_use); false -> "" };
                            saved_ptr_reg_rp: string <- case len(rp_var_use) > 0 of { true -> var@find_last_sp_binding(bound.outer_reg, concat("_ptr.", rp_var_use)); false -> "" };
                            tuple_in_reg_rp: bool <- len(var_binding_rp) > 0 and var@is_memory_ref(var_binding_rp) == false;
                            // Spill slots arrive as bound_reg=[X29,#-N] before (or instead of) outer_reg sp bindings.
                            // Never feed a memory ref into reg_offset_for_byte — that yields LDR X0, [[X29,#-N], #0].
                            bound_mem_rp: bool <- rp_var_use == bound.bound_name and len(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg);
                            saved_ptr_mem_rp: bool <- len(saved_ptr_reg_rp) > 0 and var@is_memory_ref(saved_ptr_reg_rp);
                            mem_ref_src_rp: string <- case len(var_binding_rp) > 0 and var@is_memory_ref(var_binding_rp) of {
                                true -> var_binding_rp;
                                false -> case bound_mem_rp of {
                                    true -> bound.bound_reg;
                                    false -> case saved_ptr_mem_rp of { true -> saved_ptr_reg_rp; false -> "" }
                                }
                            };
                            mem_ref_binding_rp: bool <- len(mem_ref_src_rp) > 0;
                            mem_ref_load_rp: string <- case mem_ref_binding_rp of {
                                true -> concat(var@emit_ldr_mem_ref("X11", mem_ref_src_rp), "\n");
                                false -> ""
                            };
                            tuple_base_reg_raw_rp: string <- case call_inner_rp of {
                                true -> "X0";
                                false -> case mem_ref_binding_rp of {
                                    true -> "X11";
                                    false -> case rp_var_use == bound.bound_name and len(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg) == false of {
                                        true -> bound.bound_reg;
                                        false -> case len(saved_ptr_reg_rp) > 0 and var@is_memory_ref(saved_ptr_reg_rp) == false of {
                                            true -> saved_ptr_reg_rp;
                                            false -> case tuple_in_reg_rp of {
                                                true -> var_binding_rp;
                                                false -> ""
                                            }
                                        }
                                    }
                                }
                            };
                            reg_base_for_va_rp: bool <- len(tuple_base_reg_raw_rp) > 0 and substring(tuple_base_reg_raw_rp, 0, 1) == "X";
                            tuple_base_reg_rp: string <- case len(va_str_rp) > 0 of {
                                true -> case reg_base_for_va_rp of {
                                    true -> tuple_base_reg_raw_rp;
                                    false -> ""
                                };
                                false -> tuple_base_reg_raw_rp
                            };
                            // Remap X0 -> X11 for LDR addressing when binding still says X0 (call returned pointer in X0).
                            // If %v is already bound to X11, do not MOV X11, X0 — X0 may hold an unrelated value.
                            // When base is X0: MOV X11, X0 only for the first field (byte offset 0). Later fields use
                            // [X11, #off] — X11 still holds the struct after that first load; a second MOV from X0 would
                            // copy a stale value (e.g. list_length result) after X0 was clobbered.
                            base_rp_was_x0: bool <- len(tuple_base_reg_rp) > 0 and tuple_base_reg_rp == "X0";
                            effective_base_rp: string <- case base_rp_was_x0 of { true -> "X11"; false -> tuple_base_reg_rp };
                            byte_off: int64 <- term_aggregate_helpers@record_proj_chain_byte_offset(term);
                            va_adj_rp: int64 <- case len(va_str_rp) > 0 of {
                                true -> string_parse@string_to_int64(va_str_rp);
                                false -> 0
                            };
                            proj_mem_ref_rp: string <- case len(tuple_base_reg_rp) > 0 of {
                                true -> var@reg_offset_for_byte(effective_base_rp, byte_off + va_adj_rp);
                                false -> {
                                    sp_adj_rp: int64 <- case len(va_str_rp) > 0 of {
                                        true -> va_adj_rp;
                                        false -> {
                                            adj_str_rp: string <- var@find_sp_binding(bound.outer_reg, "_adj");
                                            case len(adj_str_rp) > 0 of { true -> string_parse@string_to_int64(adj_str_rp); false -> 0 }
                                        }
                                    };
                                    var@sp_offset_for_byte_adj(byte_off, sp_adj_rp)
                                }
                            };
                            proj_prefix_rp: string <- prims_tuple@ldr_prefix_for_type(term_sir_helpers@sir_term_root_node(term).type_name);
                            proj_dest_num_rp: string <- case len(dest) > 0 of { true -> substring(dest, 1, len(dest)); false -> "0" };
                            proj_ldr_reg_rp: string <- concat(proj_prefix_rp, proj_dest_num_rp);
                            preserve_base_rp: string <- case call_inner_rp of {
                                true -> "    MOV X11, X0\n";
                                false -> case base_rp_was_x0 of {
                                    true -> case byte_off == 0 of {
                                        true -> "    MOV X11, X0\n";
                                        false -> ""
                                    };
                                    false -> ""
                                }
                            };
                            root_rec_ty: string <- term_aggregate_helpers@record_proj_root_record_type(term);
                            root_rec_stripped: string <- prims_record@strip_spaces_rt(root_rec_ty);
                            use_add_for_embedded_substruct: bool <- len(root_rec_stripped) > 0 and prims_record@record_type_starts(root_rec_stripped) and reg_conventions@is_inline_struct_type(term_sir_helpers@sir_term_root_node(term).type_name);
                            // Supervisor reply get_child path stores the live child_ref in top-level `child`.
                            // Accesses written as `reply.child_info.child` should resolve to that same live ref.
                            supervisor_child_info_child_chain: bool <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj"
                                and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).value == "child_info" and term_sir_helpers@sir_term_root_node(term).value == "child"
                                and term_child_spec@is_supervisor_reply_record_type(root_rec_ty);
                            eff_byte_off: int64 <- case supervisor_child_info_child_chain of {
                                true -> prims_record@offset_bytes_before_field(root_rec_ty, "child");
                                false -> byte_off
                            };
                            add_imm_rp: int64 <- eff_byte_off + va_adj_rp;
                            add_imm_s_rp: string <- atom_table@int64_to_decimal_string(add_imm_rp);
                            proj_asm_rp: string <- case use_add_for_embedded_substruct of {
                                true -> concat(preserve_base_rp, concat("    ADD ", concat(proj_ldr_reg_rp, concat(", ", concat(effective_base_rp, concat(", #", concat(add_imm_s_rp, "\n")))))));
                                false -> concat(preserve_base_rp, concat("    LDR ", concat(proj_ldr_reg_rp, concat(", ", case len(tuple_base_reg_rp) > 0 of {
                                    true -> var@reg_offset_for_byte(effective_base_rp, add_imm_rp);
                                    false -> {
                                        sp_adj_eff: int64 <- case len(va_str_rp) > 0 of {
                                            true -> va_adj_rp;
                                            false -> {
                                                adj_str_eff: string <- var@find_sp_binding(bound.outer_reg, "_adj");
                                                case len(adj_str_eff) > 0 of { true -> string_parse@string_to_int64(adj_str_eff); false -> 0 }
                                            }
                                        };
                                        var@sp_offset_for_byte_adj(eff_byte_off, sp_adj_eff)
                                    }
                                }))))
                            };
                            concat(concat(call_inner_asm_rp, mem_ref_load_rp), proj_asm_rp)
                        };
    false -> case term_sir_helpers@sir_term_root_node(term).name == "tuple_proj" of {
    true -> {
                            tp_var: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of { true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name; false -> "" };
                            va_key: string <- concat("_va.", tp_var);
                            va_str: string <- case len(tp_var) > 0 of { true -> var@find_sp_binding(bound.outer_reg, va_key); false -> "" };
                            // Last, not first, for the same reason as the _ptr lookup below and as record_proj:
                            // every tuple destructure names its root %_td_0, so two destructures in one scope leave
                            // bound.outer_reg holding `%_td_0=X19|...|%_td_0=X23`. Taking the first match read fields
                            // out of the earlier tuple's pointer -- field 0 happened to be right only because it
                            // resolves through bound.bound_reg instead, which is why the wrong base showed up from
                            // field 1 onwards.
                            var_binding: string <- case len(tp_var) > 0 of { true -> var@find_last_sp_binding(bound.outer_reg, tp_var); false -> "" };
                            // Look up the saved tuple pointer using find_last_sp_binding to get the INNERMOST binding.
                            // When nested tuple decompositions reuse the same root variable (e.g. %_td_0 for both
                            // outer and inner destructuring), bound.outer_reg accumulates multiple _ptr.%_td_0=... entries.
                            // find_last_sp_binding returns the last (most recently added, innermost) occurrence,
                            // which is the correct register for the current scope rather than a stale outer binding.
                            saved_ptr_reg: string <- case len(tp_var) > 0 of { true -> var@find_last_sp_binding(bound.outer_reg, concat("_ptr.", tp_var)); false -> "" };
                            tuple_in_reg: bool <- len(var_binding) > 0 and var@is_memory_ref(var_binding) == false;
                            bound_mem_tp: bool <- tp_var == bound.bound_name and len(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg);
                            saved_ptr_mem_tp: bool <- len(saved_ptr_reg) > 0 and var@is_memory_ref(saved_ptr_reg);
                            mem_ref_src_tp: string <- case len(var_binding) > 0 and var@is_memory_ref(var_binding) of {
                                true -> var_binding;
                                false -> case bound_mem_tp of {
                                    true -> bound.bound_reg;
                                    false -> case saved_ptr_mem_tp of { true -> saved_ptr_reg; false -> "" }
                                }
                            };
                            mem_ref_load_tp: string <- case len(mem_ref_src_tp) > 0 of {
                                true -> concat(var@emit_ldr_mem_ref("X11", mem_ref_src_tp), "\n");
                                false -> ""
                            };
                            // Priority: real register bindings only. Spill slots load into X11 first (never
                            // pass [X29,#-N] to reg_offset_for_byte).
                            tuple_base_reg_raw: string <- case len(mem_ref_src_tp) > 0 of {
                                true -> "X11";
                                false -> case tp_var == bound.bound_name and len(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg) == false of {
                                    true -> bound.bound_reg;
                                    false -> case len(saved_ptr_reg) > 0 and var@is_memory_ref(saved_ptr_reg) == false of {
                                        true -> saved_ptr_reg;
                                        false -> case tuple_in_reg of {
                                            true -> var_binding;
                                            false -> ""
                                        }
                                    }
                                }
                            };
                            tuple_base_reg: string <- case len(va_str) > 0 of {
                                true -> "";
                                false -> tuple_base_reg_raw
                            };
                            base_was_x0: bool <- len(tuple_base_reg) > 0 and tuple_base_reg == "X0";
                            effective_base: string <- case base_was_x0 of { true -> "X11"; false -> tuple_base_reg };
                            proj_index: int64 <- string_parse@string_to_int64(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).value);
                            proj_byte_off: int64 <- prims_tuple@tuple_field_start_byte_offset(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name, proj_index);
                            box_tuple_layout: bool <- prims_tuple@tuple_type_uses_boxed_float32(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
                            // Flat tuple layout uses tuple_field_start_byte_offset for every tuple (aggregates are not all 8 bytes wide).
                            proj_mem_ref: string <- case len(tuple_base_reg) > 0 of {
                                true -> var@reg_offset_for_byte(effective_base, proj_byte_off);
                                false -> {
                                    sp_adj: int64 <- case len(va_str) > 0 of {
                                        true -> string_parse@string_to_int64(va_str);
                                        false -> {
                                            adj_str: string <- var@find_sp_binding(bound.outer_reg, "_adj");
                                            case len(adj_str) > 0 of { true -> string_parse@string_to_int64(adj_str); false -> 0 }
                                        }
                                    };
                                    var@sp_offset_for_byte_adj(proj_byte_off, sp_adj)
                                }
                            };
                            proj_prefix: string <- prims_tuple@ldr_prefix_for_type(term_sir_helpers@sir_term_root_node(term).type_name);
                            proj_dest_num: string <- case len(dest) > 0 of { true -> substring(dest, 1, len(dest)); false -> "0" };
                            proj_ldr_reg: string <- concat(proj_prefix, proj_dest_num);
                            // Same X0/X11 discipline as record_proj: only index 0 copies X0→X11; later indices use [X11,#off].
                            preserve_base: string <- case base_was_x0 of {
                                true -> case proj_index == 0 of {
                                    true -> "    MOV X11, X0\n";
                                    false -> ""
                                };
                                false -> ""
                            };
                            tuple_elem_cnt_proj: int64 <- prims_tuple@count_type_elements(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
                            float_indirect_box: bool <- box_tuple_layout and reg_conventions@is_float32_type(term_sir_helpers@sir_term_root_node(term).type_name) and tuple_elem_cnt_proj > 1;
                            proj_body_tp: string <- case box_tuple_layout of {
                                true -> case float_indirect_box of {
                                    true -> concat(preserve_base, concat(concat(concat("    LDR X11, ", proj_mem_ref), "\n    LDR "), concat(proj_ldr_reg, ", [X11, #0]\n")));
                                    false -> concat(preserve_base, concat("    LDR ", concat(proj_ldr_reg, concat(", ", proj_mem_ref))))
                                };
                                false -> concat(preserve_base, concat("    LDR ", concat(proj_ldr_reg, concat(", ", proj_mem_ref))))
                            };
                            concat(mem_ref_load_tp, proj_body_tp)
                        };
    false -> term_emit_kind_compound_part2@emit_kind_compound_part2(term, dest, bound, table, pools, emit_child)
}
}
}
}
}
