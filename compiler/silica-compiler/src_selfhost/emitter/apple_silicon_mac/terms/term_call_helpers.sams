.bss
.balign 8
.lcomm _silica_frame_depth, 8
.lcomm _silica_frame_max, 8
.lcomm _silica_fuel, 8
.lcomm _silica_saved_pc, 8

.text
    ; use atom_table, term_aggregate_helpers, recursion_support, term_reg_spill, control
.global term_call_helpers_dec_str
.global term_call_helpers_tuple_elem_sret_reclaim
.global term_call_helpers_flat_tuple_dealloc_size
.global term_call_helpers_call_tuple_args_dealloc_bytes
.global term_call_helpers_emit_fuel_backedge_stub_comment
.global term_call_helpers_is_aggregate_make
.global term_call_helpers_function_tail_frame_release
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



term_call_helpers_dec_str:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, X0
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o1349|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, atom_table_int64_to_decimal_string@PAGE
    ADD X9, X9, atom_table_int64_to_decimal_string@PAGEOFF
    BR X9


term_call_helpers_tuple_elem_sret_reclaim:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, X0
    STR X16, [SP, #-16]!
    MOV X16, X1
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o1461|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, term_aggregate_helpers_tuple_elem_sret_reclaim@PAGE
    ADD X9, X9, term_aggregate_helpers_tuple_elem_sret_reclaim@PAGEOFF
    BR X9


term_call_helpers_flat_tuple_dealloc_size:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    MOV X11, X0

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, X11
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o1713|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, term_aggregate_helpers_flat_tuple_dealloc_size@PAGE
    ADD X9, X9, term_aggregate_helpers_flat_tuple_dealloc_size@PAGEOFF
    BR X9


term_call_helpers_call_tuple_args_dealloc_bytes:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    MOV X11, X0

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, X11
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o1964|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, term_aggregate_helpers_call_tuple_args_dealloc_bytes@PAGE
    ADD X9, X9, term_aggregate_helpers_call_tuple_args_dealloc_bytes@PAGEOFF
    BR X9


term_call_helpers_emit_fuel_backedge_stub_comment:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    ; unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o2079|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, recursion_support_emit_fuel_backedge_stub_comment@PAGE
    ADD X9, X9, recursion_support_emit_fuel_backedge_stub_comment@PAGEOFF
    BR X9


term_call_helpers_is_aggregate_make:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    MOV X11, X0

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, X11
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o2316|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, term_reg_spill_is_aggregate_make@PAGE
    ADD X9, X9, term_reg_spill_is_aggregate_make@PAGEOFF
    BR X9


term_call_helpers_function_tail_frame_release:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, X0
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o2422|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, control_function_tail_frame_release@PAGE
    ADD X9, X9, control_function_tail_frame_release@PAGEOFF
    BR X9

L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #23
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

