// String literal pool: collect string constants for .rodata
// Emit .rodata section with L_str_N labels; const emitter uses ADRP+LDR for string pointers
// Uses .ascii directives with raw UTF-8 bytes for full Unicode support
// List-based deduplication with string equality (not BST) so Unicode/UTF-8 works correctly.
// Seed-legal: no named structs. Work tables carry next_index; export tables omit it.

use atom_table;

export build_string_literal_table/1;
export string_literal_value_to_index/2;
export emit_string_literal_rodata_section/1;
export module_uses_string_literal_pool/1;

// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    case nodes.is_nil of {
        true -> 0;
        false -> 1 + sir_term_nodes_len(nodes.tail)
    }
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}

fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            sir_term_node_at_from_head(nodes, n - 1 - idx)
        }
    }
}

fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn nil_str_literal_values() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- empty[string, mem(normal)]()
    produces
        pure result
    end
}

fn cons_str_literal_value(s: string, t: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- prepend[string, mem(normal)](s, t)
    produces
        pure result
    end
}

fn empty_str_work_table() -> { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } {
    sequence
        values: List[string, mem(normal)] <- nil_str_literal_values();
        result: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- { is_empty: true, values: values, next_index: 0 }
    produces
        pure result
    end
}

fn to_export_str_table(table: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, values: List[string, mem(normal)] } {
    result: { is_empty: boolean, values: List[string, mem(normal)] } <- { is_empty: table.is_empty, values: table.values };
    result
}

fn find_index_in_list(list: List[string, mem(normal)], value: string, pos: int64) -> int64 {
    sequence
        result: int64 <- case list of {
            []: List[string, mem(normal)] -> 0 - 1;
            [head: string, tail: List[string, mem(normal)]] -> case head == value of {
                true -> pos;
                false -> find_index_in_list(tail, value, pos + 1)
            };
            _: List[string, mem(normal)] -> 0 - 1
        }
    produces
        pure result
    end
}

fn add_str_value(table: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }, value: string) -> { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } proc[mem(normal)] {
    in_order: List[string, mem(normal)] <- reverse_str_values(table.values);
    existing: int64 <- find_index_in_list(in_order, value, 0);
    case existing >= 0 of {
        true -> table;
        false -> {
            new_values: List[string, mem(normal)] <- cons_str_literal_value(value, table.values);
            { is_empty: false, values: new_values, next_index: table.next_index + 1 }
        }
    }
}

fn string_literal_value_to_index(table: { is_empty: boolean, values: List[string, mem(normal)] }, value: string) -> int64 {
    sequence
        result: int64 <- case table.is_empty of {
            true -> 0 - 1;
            false -> {
                in_order: List[string, mem(normal)] <- reverse_str_values(table.values);
                find_index_in_list(in_order, value, 0)
            }
        }
    produces
        pure result
    end
}

fn collect_string_literal_from_term(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, table: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } {
    sequence
        result: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }
            <- case term.root < 0 of {
            true -> table;
            false -> {
                node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
                case node.kind of {
                    0 -> case node.type_name == "string" of {
                        true -> add_str_value(table, node.value);
                        false -> table
                    };
                    1 -> table;
                    2 -> {
                        t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(term, node.inner), table);
                        collect_string_literal_from_term(sir_term_at(term, node.right_expr), t1)
                    };
                    3 -> {
                        t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(term, node.inner), table);
                        collect_string_literal_from_case_branch_list(sir_term_at(term, node.right_expr), t1)
                    };
                    4 -> case node.name == "main.println" of {
                        true -> {
                            t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(term, node.inner), table);
                            add_str_value(t1, "\n")
                        };
                        false -> case node.name == "main.println_stderr" of {
                            true -> {
                                t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(term, node.inner), table);
                                add_str_value(t1, "\n")
                            };
                            false -> {
                                t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(term, node.inner), table);
                                collect_string_literal_from_term(sir_term_at(term, node.right_expr), t1)
                            }
                        }
                    };
                    5 -> case node.name == "main.println" of {
                        true -> {
                            t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(term, node.inner), table);
                            add_str_value(t1, "\n")
                        };
                        false -> case node.name == "main.println_stderr" of {
                            true -> {
                                t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(term, node.inner), table);
                                add_str_value(t1, "\n")
                            };
                            false -> {
                                t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(term, node.inner), table);
                                collect_string_literal_from_term(sir_term_at(term, node.right_expr), t1)
                            }
                        }
                    };
                    6 -> {
                        t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(term, node.inner), table);
                        collect_string_literal_from_term(sir_term_at(term, node.right_expr), t1)
                    };
                    _: int64 -> table
                }
            }
        }
    produces
        pure result
    end
}

fn collect_string_literal_from_case_branch(branch: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, table: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } {
    sequence
        result: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }
            <- case branch.root < 0 of {
            true -> table;
            false -> {
                node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(branch);
                case node.kind == 8 of {
                    true -> {
                        t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- case node.value == "string" of {
                            true -> add_str_value(table, node.name);
                            false -> table
                        };
                        t2: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(sir_term_at(branch, node.inner), t1);
                        collect_string_literal_from_term(sir_term_at(branch, node.right_expr), t2)
                    };
                    false -> collect_string_literal_from_term(branch, table)
                }
            }
        }
    produces
        pure result
    end
}

fn collect_string_literal_from_case_branch_list(seq: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, table: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } {
    sequence
        result: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }
            <- case seq.root < 0 of {
            true -> table;
            false -> {
                node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(seq);
                case node.kind == 7 of {
                    true -> {
                        t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_case_branch(sir_term_at(seq, node.inner), table);
                        collect_string_literal_from_case_branch_list(sir_term_at(seq, node.right_expr), t1)
                    };
                    false -> table
                }
            }
        }
    produces
        pure result
    end
}

fn collect_string_literal_from_functions_cons(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], table: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } {
    sequence
        t1: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_term(fns.head.body, table);
        result: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_functions(fns.tail, t1)
    produces
        pure result
    end
}

fn collect_string_literal_from_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], table: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } {
    case fns.is_nil of {
        true -> table;
        false -> collect_string_literal_from_functions_cons(fns, table)
    }
}

fn build_string_literal_table(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> { is_empty: boolean, values: List[string, mem(normal)] } {
    sequence
        empty: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- empty_str_work_table();
        collected: { is_empty: boolean, values: List[string, mem(normal)], next_index: int64 } <- collect_string_literal_from_functions(sir_module.functions, empty);
        result: { is_empty: boolean, values: List[string, mem(normal)] } <- to_export_str_table(collected)
    produces
        pure result
    end
}

fn rev_str_values_acc(values: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence
        result: List[string, mem(normal)] <- case values of {
            []: List[string, mem(normal)] -> acc;
            [head: string, tail: List[string, mem(normal)]] -> rev_str_values_acc(tail, cons_str_literal_value(head, acc));
            _: List[string, mem(normal)] -> acc
        }
    produces
        pure result
    end
}

fn reverse_str_values(values: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence
        result: List[string, mem(normal)] <- rev_str_values_acc(values, nil_str_literal_values())
    produces
        pure result
    end
}

fn escape_char_for_ascii(c: string) -> string {
    case c of {
        "\n" -> "\\n";
        "\t" -> "\\t";
        "\r" -> "\\r";
        "\x1b" -> "\\033";
        "\"" -> "\\\"";
        "\\" -> "\\\\";
        _: string -> c
    }
}

fn escape_string_for_ascii(content: string, pos: int64, acc: string) -> string {
    case pos >= length_bytes(content) of {
        true -> acc;
        false -> {
            c: string <- substring(content, pos, pos + 1);
            escaped: string <- escape_char_for_ascii(c);
            escape_string_for_ascii(content, pos + 1, concat(acc, escaped))
        }
    }
}

fn emit_string_literal_values_rodata_cons(head: string, tail: List[string, mem(normal)], index: int64) -> string {
    rest: string <- emit_string_literal_values_rodata(tail, index + 1);
    label_colon: string <- concat(concat(concat("L_str_", atom_table@int64_to_decimal_string(index)), ":"), "\n");
    indent: string <- concat(concat(concat(" ", " "), " "), " ");
    escaped: string <- escape_string_for_ascii(head, 0, "");
    ascii_line: string <- concat(concat(concat(indent, ".ascii \""), escaped), "\"\n");
    null_line: string <- concat(indent, ".byte 0");
    one: string <- concat(label_colon, concat(ascii_line, null_line));
    case length_bytes(rest) > 0 of {
        true -> concat(concat(one, "\n"), rest);
        false -> concat(one, "\n")
    }
}

fn emit_string_literal_values_rodata(values: List[string, mem(normal)], index: int64) -> string {
    sequence
        result: string <- case values of {
            []: List[string, mem(normal)] -> "";
            [head: string, tail: List[string, mem(normal)]] -> emit_string_literal_values_rodata_cons(head, tail, index);
            _: List[string, mem(normal)] -> ""
        }
    produces
        pure result
    end
}

fn emit_string_literal_rodata_section_nonempty(table: { is_empty: boolean, values: List[string, mem(normal)] }) -> string {
    sequence
        header: string <- ".section __TEXT,__rodata\n.align\t8\n";
        in_order: List[string, mem(normal)] <- reverse_str_values(table.values);
        body: string <- emit_string_literal_values_rodata(in_order, 0);
        result: string <- concat(header, body)
    produces
        pure result
    end
}

fn emit_string_literal_rodata_section(table: { is_empty: boolean, values: List[string, mem(normal)] }) -> string {
    case table.is_empty of {
        true -> "";
        false -> emit_string_literal_rodata_section_nonempty(table)
    }
}

fn module_uses_string_literal_pool(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    sequence
        table: { is_empty: boolean, values: List[string, mem(normal)] } <- build_string_literal_table(sir_module);
        result: boolean <- case table.is_empty of {
            true -> false;
            false -> true
        }
    produces
        pure result
    end
}
