// Boolean string rodata for print_bool inline emission
// Emits "true" and "false" strings used by print_bool_inline
// Labels: L_pb_true (4 bytes), L_pb_false (5 bytes), null-terminated

export emit_boolean_rodata_section/0;
export module_uses_booleans/1;
export module_uses_print_bool_var/1;

// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    case nodes.is_nil of {
        true -> 0;
        false -> 1 + sir_term_nodes_len(nodes.tail)
    }
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx <= 0 of {
        true -> nodes.head;
        false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
    }
}

fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    n: int64 <- sir_term_nodes_len(nodes);
    sir_term_node_at_from_head(nodes, n - 1 - idx)
}

fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    sir_term_node_at(term.nodes, term.root)
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

// True if the SIR module uses booleans (bool const or print_bool call).
fn module_uses_booleans(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    term_uses_booleans_in_functions(sir_module.functions)
}

fn term_uses_booleans_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_uses_booleans(fns.head.body) of {
            true -> true;
            false -> term_uses_booleans_in_functions(fns.tail)
        }
    }
}

fn term_uses_booleans(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            case node.kind of {
                0 -> node.type_name == "bool";
                2 -> case term_uses_booleans(sir_term_at(term, node.inner)) of {
                    true -> true;
                    false -> term_uses_booleans(sir_term_at(term, node.right_expr))
                };
                4 -> case node.name == "main.print_bool" of {
                    true -> true;
                    false -> term_uses_booleans(sir_term_at(term, node.inner))
                };
                6 -> case term_uses_booleans(sir_term_at(term, node.inner)) of {
                    true -> true;
                    false -> term_uses_booleans(sir_term_at(term, node.right_expr))
                };
                _: int64 -> false
            }
        }
    }
}

fn term_has_print_bool_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            case node.kind of {
                4 -> case node.name == "main.print_bool" of {
                    true -> sir_term_root_node(sir_term_at(term, node.inner)).kind != 0;
                    false -> term_has_print_bool_var(sir_term_at(term, node.inner))
                };
                2 -> case term_has_print_bool_var(sir_term_at(term, node.inner)) of {
                    true -> true;
                    false -> term_has_print_bool_var(sir_term_at(term, node.right_expr))
                };
                6 -> case term_has_print_bool_var(sir_term_at(term, node.inner)) of {
                    true -> true;
                    false -> term_has_print_bool_var(sir_term_at(term, node.right_expr))
                };
                _: int64 -> false
            }
        }
    }
}

fn print_bool_var_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_print_bool_var(fns.head.body) of {
            true -> true;
            false -> print_bool_var_in_functions(fns.tail)
        }
    }
}

fn module_uses_print_bool_var(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    print_bool_var_in_functions(sir_module.functions)
}

// Emit .section __TEXT,__rodata with L_pb_true and L_pb_false.
// "true" = 0x74, 0x72, 0x75, 0x65, 0
// "false" = 0x66, 0x61, 0x6c, 0x73, 0x65, 0
fn emit_boolean_rodata_section() -> string {
    header: string <- ".section __TEXT,__rodata\n.align\t8\n";
    true_label: string <- "L_pb_true:\n";
    true_bytes: string <- "    .byte 0x74, 0x72, 0x75, 0x65, 0\n";
    false_label: string <- "L_pb_false:\n";
    false_bytes: string <- "    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0\n";
    part1: string <- concat(concat(header, true_label), true_bytes);
    part2: string <- concat(false_label, false_bytes);
    concat(part1, part2)
}
