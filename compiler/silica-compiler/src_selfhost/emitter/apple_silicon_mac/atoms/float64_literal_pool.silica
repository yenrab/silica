// Float64 literal pool: collect float64 constants for .rodata
// Emit .rodata section with L_f64_N labels; const emitter uses LDR D for float64 values
// Seed-legal: no named structs. Work tables carry next_index; export tables omit it.

use compiler_maps;
use atom_table;

export build_float64_literal_table/1;
export float64_literal_value_to_index/2;
export emit_float64_literal_rodata_section/1;
export module_uses_float64_literal_pool/1;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    case nodes.is_nil of {
        true -> 0;
        false -> 1 + sir_term_nodes_len(nodes.tail)
    }
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}

fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            sir_term_node_at_from_head(nodes, n - 1 - idx)
        }
    }
}

fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn nil_f64_literal_values() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- empty[string, mem(normal)]()
    produces
        pure result
    end
}

fn cons_f64_literal_value(s: string, t: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- prepend[string, mem(normal)](s, t)
    produces
        pure result
    end
}

fn empty_f64_work_table() -> { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } {
    sequence
        index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- compiler_maps@empty_string_int64_map();
        values: List[string, mem(normal)] <- nil_f64_literal_values();
        result: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } <- { is_empty: true, index_map: index_map, values: values, next_index: 0 }
    produces
        pure result
    end
}

fn to_export_f64_table(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] } {
    result: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] } <- { is_empty: table.is_empty, index_map: table.index_map, values: table.values };
    result
}

fn add_f64_value(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 }, value: string) -> { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } proc[mem(normal)] {
    r: { map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, index: int64, inserted: boolean } <- compiler_maps@map_insert_or_get_index(table.index_map, value, table.next_index);
    new_values: List[string, mem(normal)] <- case r.inserted of {
        true -> cons_f64_literal_value(value, table.values);
        false -> table.values
    };
    new_next: int64 <- case r.inserted of {
        true -> table.next_index + 1;
        false -> table.next_index
    };
    { is_empty: false, index_map: r.map, values: new_values, next_index: new_next }
}

fn float64_literal_value_to_index(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, value: string) -> int64 {
    case table.is_empty of {
        true -> 0 - 1;
        false -> compiler_maps@map_index_of(table.index_map, value)
    }
}

fn value_has_dot_from(value: string, pos: int64, length: int64) -> bool {
    case pos >= length of {
        true -> false;
        false -> case substring(value, pos, pos + 1) == "." of {
            true -> true;
            false -> value_has_dot_from(value, pos + 1, length)
        }
    }
}

fn value_looks_like_float(value: string) -> bool {
    value_has_dot_from(value, 0, len(value))
}

fn is_float_const_f64(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
    case node.type_name == "float64" or node.type_name == "float" or node.type_name == "float32" of {
        true -> true;
        false -> node.type_name != "string" and node.type_name != "fn_ptr" and value_looks_like_float(node.value)
    }
}

fn collect_float64_literal_from_term(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } {
    sequence
        result: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 }
            <- case term.root < 0 of {
            true -> table;
            false -> {
            node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            case node.kind of {
                0 -> case is_float_const_f64(term) of {
                    true -> add_f64_value(table, node.value);
                    false -> table
                };
                1 -> table;
                2 -> {
                    t1: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } <- collect_float64_literal_from_term(sir_term_at(term, node.inner), table);
                    collect_float64_literal_from_term(sir_term_at(term, node.right_expr), t1)
                };
                4 -> {
                    t1: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } <- collect_float64_literal_from_term(sir_term_at(term, node.inner), table);
                    collect_float64_literal_from_term(sir_term_at(term, node.right_expr), t1)
                };
                5 -> {
                    t1: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } <- collect_float64_literal_from_term(sir_term_at(term, node.inner), table);
                    collect_float64_literal_from_term(sir_term_at(term, node.right_expr), t1)
                };
                6 -> {
                    t1: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } <- collect_float64_literal_from_term(sir_term_at(term, node.inner), table);
                    collect_float64_literal_from_term(sir_term_at(term, node.right_expr), t1)
                };
                _: int64 -> table
            }
            }
        }
    produces
        pure result
    end
}

fn collect_float64_literal_from_functions_cons(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } {
    sequence
        t1: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } <- collect_float64_literal_from_term(fns.head.body, table);
        result: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } <- collect_float64_literal_from_functions(fns.tail, t1)
    produces
        pure result
    end
}

fn collect_float64_literal_from_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 }) -> { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } {
    case fns.is_nil of {
        true -> table;
        false -> collect_float64_literal_from_functions_cons(fns, table)
    }
}

fn build_float64_literal_table(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] } {
    sequence
        empty: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } <- empty_f64_work_table();
        collected: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)], next_index: int64 } <- collect_float64_literal_from_functions(sir_module.functions, empty);
        result: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] } <- to_export_f64_table(collected)
    produces
        pure result
    end
}

fn rev_f64_values_acc(values: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence
        result: List[string, mem(normal)] <- case values of {
            []: List[string, mem(normal)] -> acc;
            [head: string, tail: List[string, mem(normal)]] -> rev_f64_values_acc(tail, cons_f64_literal_value(head, acc));
            _: List[string, mem(normal)] -> acc
        }
    produces
        pure result
    end
}

fn reverse_f64_values(values: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence
        result: List[string, mem(normal)] <- rev_f64_values_acc(values, nil_f64_literal_values())
    produces
        pure result
    end
}

fn emit_float64_literal_values_rodata_cons(head: string, tail: List[string, mem(normal)], index: int64) -> string {
    rest: string <- emit_float64_literal_values_rodata(tail, index + 1);
    label_colon: string <- concat(concat(concat("L_f64_", atom_table@int64_to_decimal_string(index)), ":"), "\n");
    single_line: string <- concat(concat("    .double ", head), "\n");
    one: string <- concat(label_colon, single_line);
    case len(rest) > 0 of {
        true -> concat(concat(one, "\n"), rest);
        false -> one
    }
}

fn emit_float64_literal_values_rodata(values: List[string, mem(normal)], index: int64) -> string {
    sequence
        result: string <- case values of {
            []: List[string, mem(normal)] -> "";
            [head: string, tail: List[string, mem(normal)]] -> emit_float64_literal_values_rodata_cons(head, tail, index);
            _: List[string, mem(normal)] -> ""
        }
    produces
        pure result
    end
}

fn emit_float64_literal_rodata_section_nonempty(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }) -> string {
    sequence
        header: string <- ".section __TEXT,__rodata\n.align\t8\n";
        in_order: List[string, mem(normal)] <- reverse_f64_values(table.values);
        body: string <- emit_float64_literal_values_rodata(in_order, 0);
        result: string <- concat(header, body)
    produces
        pure result
    end
}

fn emit_float64_literal_rodata_section(table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }) -> string {
    case table.is_empty of {
        true -> "";
        false -> emit_float64_literal_rodata_section_nonempty(table)
    }
}

fn module_uses_float64_literal_pool(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> bool {
    sequence
        table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] } <- build_float64_literal_table(sir_module);
        result: bool <- case table.is_empty of {
            true -> false;
            false -> true
        }
    produces
        pure result
    end
}
