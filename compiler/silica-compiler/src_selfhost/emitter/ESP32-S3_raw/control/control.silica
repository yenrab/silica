// Control flow: function prologue/epilogue for the Xtensa windowed ABI (ESP32-S3).
// Effect-aware: mem(atomic) gets a MEMW barrier at entry and exit (DMB ISH on AArch64, spec §9.1.1).
//
// Frame size and home offsets are assembler symbols (SFRAME, SFP, SVR_*) that emitter_core defines in
// front of the label once the body is known; see design_documents/ports/esp32s3_xtensa_port.md §3.

use emitter_effects;

export function_prologue/1;
export function_epilogue_with_frame/0;
export function_prologue_with_effects/2;
export function_epilogue_with_effects/1;
export function_tail_frame_release/1;

// Label and ENTRY. Every function must be 4-byte aligned: the assembler rejects an unaligned ENTRY.
// Incoming arguments arrive in a2-a7 (the caller's a10-a15); they are moved to the X0-X2 homes
// a10-a15 at once, which is where every emitter path expects parameters -- as X0-X2 on AArch64.
fn function_prologue(name: string) -> string {
    head: string <- concat("    .align 4\n", concat(name, ":\n    entry a1, SFRAME\n"));
    concat(head, "    mov a10, a2\n    mov a11, a3\n    mov a12, a4\n    mov a13, a5\n    mov a14, a6\n    mov a15, a7\n")
}

// Integer result: X0 (a10:a11) goes back in a2:a3, which the caller sees as its a10:a11.
fn function_epilogue_with_frame() -> string {
    "    mov a2, a10\n    mov a3, a11\n    retw\n"
}

fn has_atomic_effect(fn_effects: string) -> boolean {
    case emitter_effects@is_pure(fn_effects) of {
        true -> false;
        false -> emitter_effects@has_mem_atomic(fn_effects)
    }
}

fn function_prologue_with_effects(name: string, fn_effects: string) -> string {
    base: string <- function_prologue(name);
    case has_atomic_effect(fn_effects) of {
        true -> concat(base, "    memw\n");
        false -> base
    }
}

fn function_epilogue_with_effects(fn_effects: string) -> string {
    base: string <- function_epilogue_with_frame();
    case has_atomic_effect(fn_effects) of {
        true -> concat("    memw\n", base);
        false -> base
    }
}

// The windowed ABI has no tail transfer (ENTRY needs the rotation of a real CALLn), so there is no
// frame to release before one: emitter_core never takes the tail path on this target.
fn function_tail_frame_release(fn_effects: string) -> string {
    case has_atomic_effect(fn_effects) of {
        true -> "    memw\n";
        false -> ""
    }
}
