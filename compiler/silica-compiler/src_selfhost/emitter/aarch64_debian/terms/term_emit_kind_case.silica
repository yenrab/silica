// Case-kind term emission (open-recursive via emit_child).

use atom_table;
use var;
use term_aggregate_helpers;
use term_case_patterns;
use term_sir_helpers;

export emit_case_expression/5;

fn emit_case_one_branch_inner(branch: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, case_env: { scrut_t: string, scrut_reg: string, lit_reg: string, guard_reg: string, dest: string, done_l: string }, fail_l: string, entry_l: string, pattern_pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
    pkind: string <- term_sir_helpers@sir_term_root_node(branch).value;
    branch_node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(branch);
    // Case patterns only need literal/atom/string pools (not intN tables).
    (pat_asm: string, list_bind_asm: string, outer_for_branch: string) <- case pkind == "record" of {
        true -> term_case_patterns@emit_record_case_pattern_asm(branch, branch_node.type_name, case_env.scrut_reg, case_env.lit_reg, fail_l, bound.outer_reg, pattern_pools);
        false -> {
            chk: string <- term_case_patterns@emit_case_pattern_check(branch, case_env.scrut_t, case_env.scrut_reg, case_env.lit_reg, fail_l, pattern_pools, bound.outer_reg);
            (lb_asm: string, outer_l: string) <- case pkind == "list_cons" of {
                true -> term_case_patterns@emit_list_cons_pattern_loads(branch, case_env.scrut_reg, bound.outer_reg);
                false -> ("", bound.outer_reg)
            };
            (chk, lb_asm, outer_l)
        }
    };
    pat_full: string <- concat(pat_asm, list_bind_asm);
    br_bn: string <- case pkind == "bind" of {
        true -> case len(term_sir_helpers@sir_term_root_node(branch).name) > 1 of { true -> substring(term_sir_helpers@sir_term_root_node(branch).name, 1, len(term_sir_helpers@sir_term_root_node(branch).name)); false -> "" };
        false -> bound.bound_name
    };
    br_br: string <- case pkind == "bind" of {
        true -> case_env.scrut_reg;
        false -> bound.bound_reg
    };
    outer_body: string <- outer_for_branch;
    guard_asm: string <- case term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).inner).root < 0 of {
        true -> "";
        false -> {
            g_asm: string <- emit_child(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).inner), case_env.guard_reg, { bound_name: br_bn, bound_reg: br_br, outer_reg: outer_body, debug: false });
            g_nl: string <- concat(g_asm, "\n");
            cbz_mid: string <- concat(concat(concat(g_nl, "    CBZ "), case_env.guard_reg), ", ");
            concat(cbz_mid, concat(fail_l, "\n"))
        }
    };
    body_asm: string <- emit_child(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr), case_env.dest, { bound_name: br_bn, bound_reg: br_br, outer_reg: outer_body, debug: false });
    branch_stack_n: int64 <- term_aggregate_helpers@aggregate_callee_return_stack_bytes(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr));
    tuple_sret_branch: string <- var@find_sp_binding(bound.outer_reg, "_tuple_sret");
    // tuple_make can write directly into an enclosing aggregate return buffer
    // (actor behavior reply buffer, user-call sret, etc.). Keep the heap
    // promotion for the returned pointer, but only pop bytes that this branch
    // actually pushed on SP.
    branch_dealloc_n: int64 <- case len(tuple_sret_branch) > 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(branch, term_sir_helpers@sir_term_root_node(branch).right_expr)).name == "tuple_make" of {
        true -> 0;
        false -> branch_stack_n
    };
    branch_cleanup: string <- case case_env.dest == "X0" of {
        true -> case branch_stack_n > 0 of {
            true -> concat(term_aggregate_helpers@aggregate_return_heap_promote_x0(branch_stack_n), case branch_dealloc_n > 0 of {
                true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(branch_dealloc_n), "\n"));
                false -> ""
            });
            false -> ""
        };
        false -> ""
    };
    h0: string <- concat(entry_l, ":\n");
    h1: string <- concat(concat(h0, pat_full), guard_asm);
    h2: string <- concat(concat(concat(h1, body_asm), "\n"), branch_cleanup);
    br: string <- concat(concat("    B ", case_env.done_l), "\n");
    concat(h2, br)
}

fn emit_case_branch_seq(rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, case_seq: { scrut_t: string, scrut_reg: string, lit_reg: string, guard_reg: string, dest: string, done_l: string, fb_l: string, case_name: string }, idx: int64, pattern_pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
    case rest.root < 0 of {
        true -> "";
        false -> case term_sir_helpers@sir_term_root_node(rest).kind == 7 of {
            true -> {
                fail_l: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr)).kind < 0 of {
                    true -> case_seq.fb_l;
                    false -> term_case_patterns@case_emit_branch_entry_label(case_seq.case_name, idx + 1)
                };
                entry_l: string <- term_case_patterns@case_emit_branch_entry_label(case_seq.case_name, idx);
                inner_asm: string <- emit_case_one_branch_inner(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner), { scrut_t: case_seq.scrut_t, scrut_reg: case_seq.scrut_reg, lit_reg: case_seq.lit_reg, guard_reg: case_seq.guard_reg, dest: case_seq.dest, done_l: case_seq.done_l }, fail_l, entry_l, pattern_pools, bound, emit_child);
                tail_asm: string <- emit_case_branch_seq(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), { scrut_t: case_seq.scrut_t, scrut_reg: case_seq.scrut_reg, lit_reg: case_seq.lit_reg, guard_reg: case_seq.guard_reg, dest: case_seq.dest, done_l: case_seq.done_l, fb_l: case_seq.fb_l, case_name: case_seq.case_name }, idx + 1, pattern_pools, bound, emit_child);
                concat(inner_asm, tail_asm)
            };
            false -> ""
        }
    }
}

// Case scrutinee default: dest X0/X1 -> X2 so we do not use X0 (result). If bound.outer_reg already binds X2
// (e.g. let value <- 2; case cmd of { ... } with cmd in X1), use X3+ so loading the scrutinee does not clobber value.
// emit_child passes bound.bound_reg = body_bound: the register for the enclosing let's binding in the
// case body (e.g. let value <- 2 in case cmd -> body_bound is X2 where value lives). Default scrutinee X2
// would clobber that; use X3+ when body_bound is X2 or bound.outer_reg records X2.
// If bound.outer_reg binds X1 (e.g. |%extended=X1) but we would use scrutinee X1, a prior case may have loaded
// another list into X1 — use X3+ so the scrutinee load runs in a fresh reg and reloads the right pointer.

// Case scrutinee default: dest X0/X1 -> X2 so we do not use X0 (result). If bound.outer_reg already binds X2
// (e.g. let value <- 2; case cmd of { ... } with cmd in X1), use X3+ so loading the scrutinee does not clobber value.
// emit_child passes bound.bound_reg = body_bound: the register for the enclosing let's binding in the
// case body (e.g. let value <- 2 in case cmd -> body_bound is X2 where value lives). Default scrutinee X2
// would clobber that; use X3+ when body_bound is X2 or bound.outer_reg records X2.
// If bound.outer_reg binds X1 (e.g. |%extended=X1) but we would use scrutinee X1, a prior case may have loaded
// another list into X1 — use X3+ so the scrutinee load runs in a fresh reg and reloads the right pointer.
fn emit_case_expression(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, pattern_pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string) -> string {
    // Scrutinee register must not clobber AArch64 args still needed in branch bodies. X0/X1 are the first two
    // int64 params; placing the bool scrutinee in X1 when dest is X0 (return) breaks e.g. ack(m,n): CSET X1,EQ
    // overwrites n before the true branch can do n+1.
    scrut_reg: string <- term_case_patterns@emit_case_pick_scrut_reg(dest, bound.outer_reg, bound.bound_reg);
    lit_reg: string <- term_case_patterns@emit_case_lit_reg_for_scrut(scrut_reg);
    guard_reg: string <- term_case_patterns@emit_case_guard_reg_for_scrut(scrut_reg);
    scrut_asm: string <- emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), scrut_reg, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false });
    case_name: string <- term_sir_helpers@sir_term_root_node(term).name;
    done_l: string <- term_case_patterns@case_emit_done_label(case_name);
    fb_l: string <- term_case_patterns@case_emit_fb_label(case_name);
    branches_asm: string <- emit_case_branch_seq(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), { scrut_t: term_sir_helpers@sir_term_root_node(term).value, scrut_reg: scrut_reg, lit_reg: lit_reg, guard_reg: guard_reg, dest: dest, done_l: done_l, fb_l: fb_l, case_name: case_name }, 0, pattern_pools, bound, emit_child);
    fb_head: string <- concat(fb_l, ":\n    BL _silica_rt_case_clause\n");
    fb_tail: string <- concat(concat(concat("    MOV ", dest), ", #0\n    B "), concat(done_l, "\n"));
    fb_asm: string <- concat(fb_head, fb_tail);
    scr_nl: string <- concat(scrut_asm, "\n");
    scr_br: string <- concat(scr_nl, branches_asm);
    scr_fb: string <- concat(scr_br, fb_asm);
    done_lbl: string <- concat(done_l, ":\n");
    // Tuple-returning user-call scrutinees allocate a caller sret slab (SUB SP / MOV X8, SP).
    // Let-bound calls free that slab at let-end; case scrutinees must free after the case completes.
    scrut_sret_n: int64 <- term_aggregate_helpers@let_user_call_tuple_sret_stack_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
    sret_free: string <- case scrut_sret_n > 0 of {
        true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(scrut_sret_n), "\n"));
        false -> ""
    };
    concat(concat(scr_fb, done_lbl), sret_free)
}

// Stage GPR call args onto the stack (X16 temp). Parallel staging is inlined at the
// emit_generic_user_call_asm_inner call site. Full pools only for emit_child.
