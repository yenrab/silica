fn is_string_compare_prim_name(name: string) -> bool {
    name == "lt" or name == "gt" or name == "le" or name == "ge" or name == "eq" or name == "nq"
}

// Bool-result compares dispatch on operand type (sir_term_at(term, node.inner)); see prims@bool_result_compare_prim.
fn term_is_string_compare_prim(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
    case node.kind == 6 and is_string_compare_prim_name(node.name) of {
        false -> false;
        true -> case node.type_name == "bool" of {
            true -> sir_term_root_node(sir_term_at(term, node.inner)).type_name == "string";
            false -> node.type_name == "string"
        }
    }
}

fn term_has_string_compare(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    case term.root < 0 of {
