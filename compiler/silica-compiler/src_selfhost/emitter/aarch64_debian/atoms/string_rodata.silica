// String rodata: detect if module uses print_string or println with var arg (needs L_ps_helper).
// String literals themselves are emitted by string_literal_pool.


export module_uses_print_string_var/1;
export module_uses_print_string_stderr_var/1;

fn term_has_print_string_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    case term.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            case node.kind of {
            4 -> case node.name == "main.print_string" of {
                true -> sir_term_root_node(sir_term_at(term, node.inner)).kind != 0;
                false -> case node.name == "main.println" of {
                    true -> sir_term_root_node(sir_term_at(term, node.inner)).kind != 0;
                    false -> term_has_print_string_var(sir_term_at(term, node.inner))
                }
            };
            2 -> case term_has_print_string_var(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_print_string_var(sir_term_at(term, node.right_expr))
            };
            // Case / sequence / patterns: println/print_string often live only in arms — must recurse
            // or L_ps_helper is omitted while BL L_ps_helper is still emitted.
            3 -> case term_has_print_string_var(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_print_string_var(sir_term_at(term, node.right_expr))
            };
            5 -> case term_has_print_string_var(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_print_string_var(sir_term_at(term, node.right_expr))
            };
            6 -> case term_has_print_string_var(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_print_string_var(sir_term_at(term, node.right_expr))
            };
            7 -> case term_has_print_string_var(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_print_string_var(sir_term_at(term, node.right_expr))
            };
            8 -> case term_has_print_string_var(sir_term_at(term, node.inner)) of {
                true -> true;
                false -> term_has_print_string_var(sir_term_at(term, node.right_expr))
            };
            _: int64 -> false
            }
        }
    }
}

fn print_string_var_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_print_string_var(fns.head.body) of {
            true -> true;
            false -> print_string_var_in_functions(fns.tail)
        }
    }
}

fn module_uses_print_string_var(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> bool {
    print_string_var_in_functions(sir_module.functions)
}

