export module_uses_float16_print/1;
export emit_float16_helper_rodata/0;

// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    case nodes.is_nil of {
        true -> 0;
        false -> 1 + sir_term_nodes_len(nodes.tail)
    }
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx <= 0 of {
        true -> nodes.head;
        false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
    }
}

fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    n: int64 <- sir_term_nodes_len(nodes);
    sir_term_node_at_from_head(nodes, n - 1 - idx)
}

fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    sir_term_node_at(term.nodes, term.root)
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn term_has_float16_print(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    case term.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_root_node(term);
            case node.kind of {
                4 -> node.name == "main.print_float16";
                2 -> case term_has_float16_print(sir_term_at(term, node.inner)) of {
                    true -> true;
                    false -> term_has_float16_print(sir_term_at(term, node.right_expr))
                };
                6 -> case term_has_float16_print(sir_term_at(term, node.inner)) of {
                    true -> true;
                    false -> term_has_float16_print(sir_term_at(term, node.right_expr))
                };
                _: int64 -> false
            }
        }
    }
}

fn float16_print_in_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_float16_print(fns.head.body) of {
            true -> true;
            false -> float16_print_in_functions(fns.tail)
        }
    }
}

fn module_uses_float16_print(sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> bool {
    float16_print_in_functions(sir_module.functions)
}

fn emit_float16_helper_rodata() -> string {
    ".section __TEXT,__rodata\n.align\t4\nL_pf16_nan_str:\n    .ascii \"nan\"\nL_pf16_inf_str:\n    .ascii \"inf\"\nL_pf16_neg_inf_str:\n    .ascii \"-inf\"\n"
}
