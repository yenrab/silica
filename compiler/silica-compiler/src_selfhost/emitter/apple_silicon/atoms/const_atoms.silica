// Atom const emission: MOV dest, #index using atom table
// Atoms-only module: all code in this file is for atom support

use sir_ast;
use atom_table;

export emit_atom_const/3;

// Emit MOV dest, #index for atom const. Use first-added order (matches rodata / switch).
fn emit_atom_const(term: SIRTerm, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    index: int64 <- atom_table@lexeme_to_index_first_added_order(table, term.value);
    index_str: string <- case index >= 0 of {
        true -> atom_table@int64_to_decimal_string(index);
        false -> "0"
    };
    operand: string <- concat(concat(dest, ", #"), index_str);
    concat("    MOV ", operand)
}
