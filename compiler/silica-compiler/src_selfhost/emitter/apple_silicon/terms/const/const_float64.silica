// float64 const emission (SIRTerm kind 0, type float64)
// ADRP+LDR D from float64 literal pool

use sir_ast;
use atom_table;
use int64_literal_pool;
use float64_literal_pool;
use float32_literal_pool;
use reg_conventions;
use var;

export emit_const/7;

fn emit_const(term: SIRTerm, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, outer_reg: string) -> string {
    idx: int64 <- float64_literal_pool@float64_literal_value_to_index(float64_literal_table, term.value);
    label: string <- concat("L_f64_", atom_table@int64_to_decimal_string(idx));
    fpool: string <- var@find_sp_binding(outer_reg, "_fpool");
    ptr_reg: string <- case len(fpool) > 0 of {
        true -> fpool;
        false -> reg_conventions@float_scalar_literal_pool_ptr_reg(dest)
    };
    adrp: string <- concat(concat(concat(concat("    ADRP ", ptr_reg), ", "), concat(label, "@PAGE")), "\n");
    ldr: string <- concat(concat(concat(concat(concat("    LDR ", dest), ", ["), concat(ptr_reg, ", ")), concat(label, "@PAGEOFF")), "]");
    concat(adrp, ldr)
}
