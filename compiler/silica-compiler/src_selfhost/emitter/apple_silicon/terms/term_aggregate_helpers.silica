// Flat tuple/record layout, projection, and aggregate return helpers for term emission.

use atom_table;
use prims_checked_int64;
use prims_tuple;
use prims_record;
use reg_conventions;
use term_child_spec;
use term_record_layout;
use term_sir_helpers;
use term_user_call_abi;

export tuple_flat_memref/2;
export emit_flat_float32_boxed_pair/3;
export emit_reg_to_flat_qwords_memcpy_loop/5;
export tuple_make_rec_flat_outer_alloc_bytes/2;
export tuple_make_rec_flat_nested_trim_bytes/2;
export flat_record_sum_nested_reserved_in_outer/1;
export record_field_user_call_inline_return/2;
export record_field_inline_pointer_value/2;
export let_user_call_tuple_sret_stack_bytes/1;
export let_suppress_base_stack_overlay_rec_flat/2;
export let_suppressed_base_stack_fixup/1;
export record_proj_root_record_type/1;
export record_proj_chain_root_var_name/1;
export record_proj_chain_byte_offset/1;
export emit_inline_record_field_copy_words/5;
export aggregate_return_heap_promote_x0/1;
export call_tuple_args_dealloc_bytes/1;
export compute_inner_adj_bindings_record/5;
export compute_inner_adj_bindings/5;
export flat_tuple_total_alloc/1;
export agg_alloc_inner/1;
export flat_record_sum_nested_inners/1;
export record_field_nested_return_bytes/3;
export flat_record_total_alloc/1;
export flat_tuple_nested_alloc/3;
export flat_tuple_dealloc_size/1;
export aggregate_callee_return_stack_bytes/1;
export let_tail_aggregate_stack_bytes/1;

fn tuple_flat_memref(store_base: string, offset: int64) -> string {
    case len(store_base) > 0 of {
        true -> {
            p: string <- concat("[", store_base);
            q: string <- concat(p, ", #");
            r: string <- concat(q, atom_table@int64_to_decimal_string(offset));
            concat(r, "]")
        };
        false -> concat(concat("[SP, #", atom_table@int64_to_decimal_string(offset)), "]")
    }
}

// Multi-element tuples box float32: pointer slot at byte_cursor, value at byte_cursor+8 (consumer does LDR/LDR).

fn emit_flat_float32_boxed_pair(store_base: string, byte_cursor: int64, float_reg: string) -> string {
    val_off: int64 <- byte_cursor + 8;
    ptr_mr: string <- tuple_flat_memref(store_base, byte_cursor);
    val_mr: string <- tuple_flat_memref(store_base, val_off);
    add_ptr: string <- case len(store_base) > 0 of {
        true -> concat(concat(concat(concat(concat(concat("    ADD X10, ", store_base), ", #"), atom_table@int64_to_decimal_string(val_off)), "\n    STR X10, "), ptr_mr), "\n");
        false -> concat(concat(concat(concat("    ADD X10, SP, #", atom_table@int64_to_decimal_string(val_off)), "\n    STR X10, "), ptr_mr), "\n")
    };
    concat(add_ptr, concat(concat(concat(concat("    STR ", float_reg), ", "), val_mr), "\n"))
}

// Copy qword-aligned scalar fields from a stack record at src_reg into the flat tuple buffer (supervisor init:
// inline flags record so materialize sees strategy @+0, counts @+8/+16, list head @+24 — not a dangling stack pointer).

fn emit_reg_to_flat_qwords_memcpy_loop(i: int64, qwords: int64, src_reg: string, store_base: string, dest_base_off: int64) -> string {
    case i >= qwords of {
        true -> "";
        false -> {
            off: int64 <- i * 8;
            ld0: string <- concat("    LDR X12, [", src_reg);
            ld1: string <- concat(ld0, ", #");
            ld2: string <- concat(ld1, atom_table@int64_to_decimal_string(off));
            ld3: string <- concat(ld2, "]\n    STR X12, ");
            ld4: string <- concat(ld3, tuple_flat_memref(store_base, dest_base_off + off));
            ldr: string <- concat(ld4, "\n");
            concat(ldr, emit_reg_to_flat_qwords_memcpy_loop(i + 1, qwords, src_reg, store_base, dest_base_off))
        }
    }
}

// Walk tuple_make chain, emit each element value and store at [SP, ...] or [store_base, ...].
// byte_cursor = running offset for scalar fields (float32 in count>1 uses 16 bytes: ptr + value).
// idx/count/sp_adjust: legacy path for nested aggregate elements (idx*8 + sp_adjust).
// store_base: empty -> stack; non-empty -> sret / reply buffer register.

fn tuple_make_memcpy_record_flat_head(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 of {
        false -> false;
        true -> case term_sir_helpers@sir_term_root_node(term).name != "tuple_make" of {
            true -> false;
            false -> {
                c: int64 <- prims_tuple@count_flat_elements(term);
                case c >= 2 of {
                    false -> false;
                    true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make"
                }
            }
        }
    }
}


// True when emit_flat_tuple_stores uses memcpy for a scalar record at idx 0 (rec_flat tuple head).

fn tuple_make_scalar_rec_flat_first(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, count: int64) -> bool {
    case count < 2 of {
        true -> false;
        false -> case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
            true -> {
                first: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
                case term_sir_helpers@sir_term_root_node(first).kind == 6 and term_sir_helpers@sir_term_root_node(first).name == "record_make" of {
                    false -> false;
                    true -> prims_record@record_type_has_only_scalar_fields(term_sir_helpers@sir_term_root_node(first).type_name)
                }
            };
            false -> false
        }
    }
}

// Outer SUB SP bytes for tuple_make: flat pairing slots, widened when (record_make, …) memcpy head needs more.
// emit_flat_tuple_stores uses memcpy for any idx-0 record_make when arity ≥ 2 (`rec_flat`). Supervisors_phase_e
// init tuples embed a `{ strategy: atom , … }` record — atoms are non–value-flat leaves, but emit still memcpy-copies rsz bytes.

fn tuple_make_rec_flat_outer_alloc_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, count: int64) -> int64 {
    base: int64 <- prims_tuple@flat_alloc_size(count);
    case tuple_make_memcpy_record_flat_head(term) of {
        false -> base;
        true -> {
            rsz: int64 <- prims_record@record_type_value_flat_byte_size(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
            // Second field sits at byte offset rsz after memcpy; trailing slots are pointer-sized for flat tuple tails.
            need: int64 <- term_record_layout@stack_alloc_round16(rsz + 8 * (count - 1));
            case need > base of { true -> need; false -> base }
        }
    }
}

fn tuple_make_rec_flat_nested_trim_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, count: int64) -> int64 {
    case tuple_make_memcpy_record_flat_head(term) of {
        false -> 0;
        true -> term_record_layout@record_make_stack_alloc_size(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name)
    }
}

fn flat_record_sum_nested_reserved_in_outer(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        false -> 0;
        true -> case prims_record@record_type_has_only_scalar_fields(term_sir_helpers@sir_term_root_node(term).type_name) of {
            true -> 0;
            false -> {
                here: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make" and prims_tuple@count_flat_elements(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) == 2 of {
                    true -> 0;
                    false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 4 or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 5 of {
                        true -> term_user_call_abi@user_call_aggregate_return_alloc_bytes(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
                        false -> 0
                    }
                };
                rest: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind < 0 of {
                    true -> 0;
                    false -> flat_record_sum_nested_reserved_in_outer(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
                };
                here + rest
            }
        }
    }
}

fn record_field_user_call_inline_return(elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, fty: string) -> bool {
    reg_conventions@is_inline_struct_type(fty) and (term_sir_helpers@sir_term_root_node(elem).kind == 4 or term_sir_helpers@sir_term_root_node(elem).kind == 5)
}

fn record_field_inline_pointer_value(elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, fty: string) -> bool {
    case reg_conventions@is_inline_struct_type(fty) of {
        false -> false;
        true -> case term_sir_helpers@sir_term_root_node(elem).kind == 1 of {
            true -> true;
            false -> case term_sir_helpers@sir_term_root_node(elem).kind == 4 or term_sir_helpers@sir_term_root_node(elem).kind == 5 of {
                true -> true;
                false -> term_sir_helpers@sir_term_root_node(elem).kind == 6 and term_sir_helpers@sir_term_root_node(elem).name == "record_proj"
            }
        }
    }
}

fn let_user_call_tuple_sret_stack_bytes(rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case (term_sir_helpers@sir_term_root_node(rhs).kind == 4 or term_sir_helpers@sir_term_root_node(rhs).kind == 5) and reg_conventions@is_tuple_type(term_sir_helpers@sir_term_root_node(rhs).type_name) of {
        true -> term_user_call_abi@user_call_aggregate_return_alloc_bytes(term_sir_helpers@sir_term_root_node(rhs).type_name);
        false -> 0
    }
}

// Sequence/lowering nests lets (child; children; produces tuple). The terminal tuple_make is in
// right_expr of the innermost let; count its stack slab for outer let dealloc (see supervisors e4a init).

fn deepest_let_chain_leaf(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case term_sir_helpers@sir_term_root_node(term).kind == 2 of {
        true -> deepest_let_chain_leaf(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
        false -> term
    }
}

fn let_chain_has_later_record_make_rhs(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    case term_sir_helpers@sir_term_root_node(term).kind == 2 of {
        false -> false;
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" of {
            true -> true;
            false -> let_chain_has_later_record_make_rhs(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
        }
    }
}

// RHS stack record + nested lets → rec_flat tuple: leaf teardown + widen accounts for tuple slab; a full parent's
// base_stack ADD would double-pop (#48 duplicate). Omitting it entirely leaves SP 16 B low before callee LDP — use +16 fixup.
// Uses tuple_make_memcpy_record_flat_head (defined above).

fn let_suppress_base_stack_overlay_rec_flat(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, base_stack: int64) -> bool {
    case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 2 and base_stack > 0 of {
        false -> false;
        true -> {
            leaf: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- deepest_let_chain_leaf(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
            case let_chain_has_later_record_make_rhs(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)) of {
                true -> false;
                false -> tuple_make_memcpy_record_flat_head(leaf)
            }
        }
    }
}

fn let_suppressed_base_stack_fixup(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_make" and term_child_spec@is_child_spec_record_type(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name) of {
        true -> term_record_layout@record_make_stack_alloc_size(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
        false -> 16
    }
}

// Outermost aggregate type for record_proj chains rooted at a variable (value-flat substruct address; trial 04).

fn record_proj_root_record_type(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_proj" of {
        false -> "";
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of {
            true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name;
            false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj" of {
                true -> record_proj_root_record_type(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                false -> ""
            }
        }
    }
}

// s.end.x lowers to record_proj(x, inner: record_proj(end, inner: var s)) — resolve root var and full byte offset.

fn record_proj_chain_root_var_name(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_proj" of {
        false -> "";
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of {
            true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name;
            false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj" of {
                true -> record_proj_chain_root_var_name(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                false -> ""
            }
        }
    }
}

fn record_proj_chain_byte_offset(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_proj" of {
        false -> 0;
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 1 of {
            true -> prims_record@offset_bytes_before_field(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name, term_sir_helpers@sir_term_root_node(term).value);
            false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "record_proj" of {
                true -> {
                    pre: int64 <- record_proj_chain_byte_offset(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                    here: int64 <- prims_record@offset_bytes_before_field(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name, term_sir_helpers@sir_term_root_node(term).value);
                    pre + here
                };
                false -> 0
            }
        }
    }
}

fn aggregate_heap_copy_words_unrolled(word_idx: int64, words: int64) -> string {
    case word_idx >= words of {
        true -> "";
        false -> {
            off: int64 <- word_idx * 8;
            pair: string <- concat(concat(concat(concat("    LDR X3, [X1, #", atom_table@int64_to_decimal_string(off)), "]\n    STR X3, [X4, #"), atom_table@int64_to_decimal_string(off)), "]\n");
            concat(pair, aggregate_heap_copy_words_unrolled(word_idx + 1, words))
        }
    }
}

fn emit_inline_record_field_copy_words(src_reg: string, store_base: string, dest_off: int64, word_idx: int64, words: int64) -> string {
    case word_idx >= words of {
        true -> "";
        false -> {
            off: int64 <- word_idx * 8;
            dst: string <- tuple_flat_memref(store_base, dest_off + off);
            one: string <- concat(concat(concat(concat("    LDR X10, [", src_reg), concat(", #", atom_table@int64_to_decimal_string(off))), "]\n    STR X10, "), concat(dst, "\n"));
            concat(one, emit_inline_record_field_copy_words(src_reg, store_base, dest_off, word_idx + 1, words))
        }
    }
}

// After a stack-built aggregate is returned in X0, copy it to the heap before ADD SP
// dealloc so the caller keeps a valid pointer. X0 holds the source pointer on entry.

fn aggregate_return_heap_promote_x0(nbytes: int64) -> string {
    case nbytes <= 0 of {
        true -> "";
        false -> {
            words: int64 <- nbytes / 8;
            case words <= 0 of {
                true -> "";
                false -> {
                    copy_asm: string <- aggregate_heap_copy_words_unrolled(0, words);
                    concat(concat(concat(concat("    SUB SP, SP, #16\n    STR X0, [SP, #8]\n    MOV X0, #", atom_table@int64_to_decimal_string(nbytes)), "\n    BL _silica_rt_region_alloc\n    MOV X4, X0\n    LDR X1, [SP, #8]\n"), copy_asm), "    MOV X0, X4\n    ADD SP, SP, #16\n")
                }
            }
        }
    }
}



fn call_tuple_args_dealloc_bytes(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term.root < 0 of {
        true -> 0;
        false -> case term_sir_helpers@sir_term_root_node(term).name == "user_call_rest" of {
            true -> flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) + call_tuple_args_dealloc_bytes(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
            false -> flat_tuple_dealloc_size(term)
        }
    }
}


// For each tuple-typed element in a tuple_make chain, compute the inner adj value and
// encode as |_adj.{idx}={adj}| bindings.  adj_i = suffix_alloc_after_i + elem_i_nested.

fn compute_inner_adj_bindings_record(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64, count: int64, cumulative_alloc: int64, total_nested: int64) -> string {
    case idx < count - 1 and term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        true -> {
            elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
            eit: bool <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and (term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" or term_sir_helpers@sir_term_root_node(elem).name == "record_make");
            eta: int64 <- case eit of {
                true -> case term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" of {
                    true -> flat_tuple_total_alloc(elem);
                    false -> flat_record_total_alloc(elem)
                };
                false -> 0
            };
            nc: int64 <- cumulative_alloc + eta;
            binding: string <- case eit of {
                true -> case term_sir_helpers@sir_term_root_node(elem).name == "tuple_make" of {
                    true -> {
                        sa: int64 <- total_nested - nc;
                        ec: int64 <- prims_tuple@count_flat_elements(elem);
                        en: int64 <- flat_tuple_nested_alloc(elem, ec, 0);
                        ia: int64 <- sa + en;
                        concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                    };
                    false -> {
                        sa2: int64 <- total_nested - nc;
                        ec2: int64 <- prims_record@count_record_fields(term_sir_helpers@sir_term_root_node(elem).type_name);
                        en2: int64 <- flat_record_sum_nested_inners(elem);
                        ia2: int64 <- sa2 + en2;
                        concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia2))))
                    }
                };
                false -> ""
            };
            rest: string <- compute_inner_adj_bindings_record(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), idx + 1, count, nc, total_nested);
            concat(binding, rest)
        };
        false -> {
            eit: bool <- term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make";
            eta: int64 <- case eit of { true -> flat_record_total_alloc(term); false -> 0 };
            nc: int64 <- cumulative_alloc + eta;
            case eit of {
                true -> {
                    sa: int64 <- total_nested - nc;
                    ec: int64 <- prims_record@count_record_fields(term_sir_helpers@sir_term_root_node(term).type_name);
                    en: int64 <- flat_record_sum_nested_inners(term);
                    ia: int64 <- sa + en;
                    concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                };
                false -> ""
            }
        }
    }
}


fn compute_inner_adj_bindings(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64, count: int64, cumulative_alloc: int64, total_nested: int64) -> string {
    case idx < count - 1 and term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
        true -> {
            elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner);
            eit: bool <- term_sir_helpers@sir_term_root_node(elem).kind == 6 and term_sir_helpers@sir_term_root_node(elem).name == "tuple_make";
            eta: int64 <- case eit of { true -> flat_tuple_total_alloc(elem); false -> 0 };
            nc: int64 <- cumulative_alloc + eta;
            binding: string <- case eit of {
                true -> {
                    sa: int64 <- total_nested - nc;
                    ec: int64 <- prims_tuple@count_flat_elements(elem);
                    en: int64 <- flat_tuple_nested_alloc(elem, ec, 0);
                    ia: int64 <- sa + en;
                    concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                };
                false -> ""
            };
            rest: string <- compute_inner_adj_bindings(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), idx + 1, count, nc, total_nested);
            concat(binding, rest)
        };
        false -> {
            eit: bool <- term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make";
            eta: int64 <- case eit of { true -> flat_tuple_total_alloc(term); false -> 0 };
            nc: int64 <- cumulative_alloc + eta;
            case eit of {
                true -> {
                    sa: int64 <- total_nested - nc;
                    ec: int64 <- prims_tuple@count_flat_elements(term);
                    en: int64 <- flat_tuple_nested_alloc(term, ec, 0);
                    ia: int64 <- sa + en;
                    concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                };
                false -> ""
            }
        }
    }
}

// [SP,#off] or [Xn,#off] when store_base is non-empty (actor behavior sret buffer in X20).


// Total stack bytes allocated by a tuple_make tree (this tuple + all nested tuple elements).

fn flat_tuple_total_alloc(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
        true -> {
            my_count: int64 <- prims_tuple@count_flat_elements(term);
            my_size: int64 <- tuple_make_rec_flat_outer_alloc_bytes(term, my_count);
            nested_raw: int64 <- flat_tuple_nested_alloc(term, my_count, 0);
            trim: int64 <- tuple_make_rec_flat_nested_trim_bytes(term, my_count);
            nested_adj: int64 <- case nested_raw >= trim of { true -> nested_raw - trim; false -> 0 };
            my_size + nested_adj
        };
        false -> 0
    }
}

// True when emit_flat_tuple_stores memcpy-copies idx-0 record_make into the tuple outer slab (`rec_flat`, arity ≥ 2).


// True when emit_flat_tuple_stores memcpy-copies idx-0 record_make into the tuple outer slab (`rec_flat`, arity ≥ 2).

fn agg_alloc_inner(inner: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(inner).kind == 6 and term_sir_helpers@sir_term_root_node(inner).name == "tuple_make" of {
        true -> flat_tuple_total_alloc(inner);
        false -> case term_sir_helpers@sir_term_root_node(inner).kind == 6 and term_sir_helpers@sir_term_root_node(inner).name == "record_make" of {
            true -> flat_record_total_alloc(inner);
            false -> 0
        }
    }
}

// Sum agg_alloc_inner along a record_make chain (nested tuple/record in each field). No mutual tail with flat_record_total_alloc.
// Used for nested_adjust (ADD dest, SP, #N) and let dealloc — includes nested makes that self-SUB and user-call padding.


// Sum agg_alloc_inner along a record_make chain (nested tuple/record in each field). No mutual tail with flat_record_total_alloc.
// Used for nested_adjust (ADD dest, SP, #N) and let dealloc — includes nested makes that self-SUB and user-call padding.

fn flat_record_sum_nested_inners(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        false -> 0;
        true -> case prims_record@record_type_has_only_scalar_fields(term_sir_helpers@sir_term_root_node(term).type_name) of {
            true -> 0;
            false -> {
                // 2-element tuple fields are emitted inline in emit_flat_record_stores (no nested SUB).
                here: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make" and prims_tuple@count_flat_elements(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)) == 2 of {
                    true -> 0;
                    false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 4 or term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 5 of {
                        true -> term_user_call_abi@user_call_aggregate_return_alloc_bytes(term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name);
                        false -> agg_alloc_inner(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner))
                    }
                };
                rest: int64 <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind < 0 of {
                    true -> 0;
                    false -> flat_record_sum_nested_inners(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
                };
                here + rest
            }
        }
    }
}

// Bytes the outer record_make SUB must reserve below the shell: user-call aggregate returns that are
// memcpy'd into this frame (from_sorted_err). Nested record_make/tuple_make emit their own SUB —
// counting them here double-subtracts SP (structs_addition/04 hang).


// Bytes the outer record_make SUB must reserve below the shell: user-call aggregate returns that are
// memcpy'd into this frame (from_sorted_err). Nested record_make/tuple_make emit their own SUB —
// counting them here double-subtracts SP (structs_addition/04 hang).

fn record_field_nested_return_bytes(elem: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, fty: string, elem_is_agg: bool) -> int64 {
    case elem_is_agg of {
        true -> agg_alloc_inner(elem);
        false -> case record_field_user_call_inline_return(elem, fty) of {
            true -> term_user_call_abi@user_call_aggregate_return_alloc_bytes(fty);
            false -> 0
        }
    }
}


fn flat_record_total_alloc(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        true -> case prims_record@record_type_has_only_scalar_fields(term_sir_helpers@sir_term_root_node(term).type_name) of {
            true -> term_record_layout@record_make_stack_alloc_size(term_sir_helpers@sir_term_root_node(term).type_name);
            false -> {
                my_count: int64 <- prims_record@count_record_fields(term_sir_helpers@sir_term_root_node(term).type_name);
                case my_count < 1 of {
                    true -> 0;
                    false -> {
                        my_size: int64 <- term_record_layout@record_make_stack_alloc_size(term_sir_helpers@sir_term_root_node(term).type_name);
                        nested: int64 <- flat_record_sum_nested_inners(term);
                        my_size + nested
                    }
                }
            }
        };
        false -> 0
    }
}

// Walk record_make chain; R is the full inline record type string on each node.
// field_prefix: byte offset of this record's fields within an outer value-flat aggregate (trial 08 nested structs).


// Darwin AAPCS64: SP must be 16-byte aligned at BL boundaries; round stack slots up.

fn flat_tuple_nested_alloc(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, remaining: int64, acc: int64) -> int64 {
    case remaining <= 1 of {
        true -> case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
            true -> acc + flat_tuple_total_alloc(term);
            false -> case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
                true -> acc + flat_record_total_alloc(term);
                false -> acc
            }
        };
        false -> case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "tuple_make" of {
            true -> {
                elem_bytes: int64 <- agg_alloc_inner(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                flat_tuple_nested_alloc(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), remaining - 1, acc + elem_bytes)
            };
            false -> acc
        }
    }
}


fn flat_tuple_dealloc_size(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        true -> flat_record_total_alloc(term);
        false -> flat_tuple_total_alloc(term)
    }
}

// Stack bytes for let dealloc: tuple_make/record_make use flat layout on caller SP.
// Tuple-returning user calls: caller SUB/MOV X8 is paired in let emission (see base_stack_n),
// not here — case-branch bare calls use pass-through X8 and must stay at 0 (wbt weight_subtree).
// Record-returning user calls heap-promote in the callee — no caller sret slab.


// Stack bytes for let dealloc: tuple_make/record_make use flat layout on caller SP.
// Tuple-returning user calls: caller SUB/MOV X8 is paired in let emission (see base_stack_n),
// not here — case-branch bare calls use pass-through X8 and must stay at 0 (wbt weight_subtree).
// Record-returning user calls heap-promote in the callee — no caller sret slab.

fn aggregate_callee_return_stack_bytes(rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case reg_conventions@is_aggregate_struct_or_tuple_return_type(term_sir_helpers@sir_term_root_node(rhs).type_name) of {
        false -> 0;
        true -> case term_sir_helpers@sir_term_root_node(rhs).kind == 6 and (term_sir_helpers@sir_term_root_node(rhs).name == "tuple_make" or term_sir_helpers@sir_term_root_node(rhs).name == "record_make") of {
            true -> flat_tuple_dealloc_size(rhs);
            false -> case term_sir_helpers@sir_term_root_node(rhs).kind == 6 and prims_checked_int64@is_checked_int64_prim(term_sir_helpers@sir_term_root_node(rhs).name) of {
                true -> 16;
                false -> 0
            }
        }
    }
}

// Caller sret slab for a let-bound tuple-returning user call (paired with sret_alloc_bytes in
// emit_generic_user_call_asm_inner). Zero for pass-through / non-tuple.


// Caller sret slab for a let-bound tuple-returning user call (paired with sret_alloc_bytes in
// emit_generic_user_call_asm_inner). Zero for pass-through / non-tuple.

fn let_tail_aggregate_stack_bytes(tail: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case term_sir_helpers@sir_term_root_node(tail).kind == 2 of {
        true -> let_tail_aggregate_stack_bytes(term_sir_helpers@sir_term_at(tail, term_sir_helpers@sir_term_root_node(tail).right_expr));
        false -> case term_sir_helpers@sir_term_root_node(tail).kind == 6 and (term_sir_helpers@sir_term_root_node(tail).name == "record_make" or term_sir_helpers@sir_term_root_node(tail).name == "tuple_make") and reg_conventions@is_aggregate_struct_or_tuple_return_type(term_sir_helpers@sir_term_root_node(tail).type_name) of {
            true -> flat_tuple_dealloc_size(tail);
            false -> 0
        }
    }
}
