// String concatenation helper: non-MTE fallback for Apple Silicon (macOS ARM64).
// Per silica-specification §21.3: "If MTE is not available... runtime falls back to software-based
// bounds checking... Memory safety is maintained through compiler-generated bounds checks."
//
// L_concat_helper: X0 = ptr1, X1 = ptr2 (null-terminated UTF-8). Returns X0 = ptr to newly
// allocated concatenated string. Uses mmap syscall (no libc). No MTE instructions.
//
// Isolated module for vigorous testing. Targets: Apple Silicon, macOS ARM64.

export emit_string_concat_helper/0;

fn emit_string_concat_helper() -> string {
    "L_concat_helper:\n    STP X19, X20, [SP, #-48]!\n    STP X21, X22, [SP, #16]\n    STR X23, [SP, #32]\n    MOV X19, X0\n    MOV X20, X1\n    MOV X21, #0\nL_sc_len1:\n    LDRB W9, [X0]\n    CBZ W9, L_sc_len1_done\n    ADD X21, X21, #1\n    ADD X0, X0, #1\n    B L_sc_len1\nL_sc_len1_done:\n    MOV X0, X20\n    MOV X22, #0\nL_sc_len2:\n    LDRB W9, [X0]\n    CBZ W9, L_sc_len2_done\n    ADD X22, X22, #1\n    ADD X0, X0, #1\n    B L_sc_len2\nL_sc_len2_done:\n    ADD X0, X21, X22\n    ADD X0, X0, #1\n    MOV X1, X0\n    MOV X0, #0\n    MOV X2, #3\n    MOV X3, #0x1002\n    MOV X4, #-1\n    MOV X5, #0\n    MOVZ X16, #0xC5\n    MOVK X16, #0x200, LSL #16\n    SVC #0x80\n    MOV X23, X0\n    MOV X9, X23\n    MOV X10, X19\n    MOV X11, X21\nL_sc_cp1:\n    CBZ X11, L_sc_cp1_done\n    LDRB W12, [X10]\n    STRB W12, [X9]\n    ADD X9, X9, #1\n    ADD X10, X10, #1\n    SUB X11, X11, #1\n    B L_sc_cp1\nL_sc_cp1_done:\n    MOV X10, X20\n    MOV X11, X22\nL_sc_cp2:\n    CBZ X11, L_sc_cp2_done\n    LDRB W12, [X10]\n    STRB W12, [X9]\n    ADD X9, X9, #1\n    ADD X10, X10, #1\n    SUB X11, X11, #1\n    B L_sc_cp2\nL_sc_cp2_done:\n    STRB WZR, [X9]\n    MOV X0, X23\n    LDR X23, [SP, #32]\n    LDP X21, X22, [SP, #16]\n    LDP X19, X20, [SP], #48\n    RET"
}
