                                true -> case nested_adjust_r == 0 of {
                                    true -> concat(concat("    MOV ", dest_ptr_r), concat(", ", sret_base_r));
                                    false -> concat("    ADD ", concat(dest_ptr_r, concat(", ", concat(sret_base_r, concat(", #", atom_table@int64_to_decimal_string(nested_adjust_r))))))
                                };
                                false -> case nested_adjust_r == 0 of {
                                    true -> concat(concat("    MOV ", dest_ptr_r), ", SP");
                                    false -> concat("    ADD ", concat(dest_ptr_r, concat(", SP, #", atom_table@int64_to_decimal_string(nested_adjust_r))))
                                }
                            }
                        };
                        concat(alloc_asm_r, concat(stores_asm_r, case len(mov_asm_r) > 0 of { true -> concat("\n", mov_asm_r); false -> "" }))
                    end;
                    false -> case term.name == "record_proj" of {
                    true -> do
                        rp_var: string <- case term.inner.kind == 1 of { true -> term.inner.name; false -> "" };
                        call_inner_rp: bool <- term.inner.kind == 4 or term.inner.kind == 5;
                        call_inner_asm_rp: string <- case call_inner_rp of {
                            true -> case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(term.inner, "X0", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(term.inner, "X0", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            false -> ""
                        };
                        chain_root: string <- record_proj_chain_root_var_name(term);
                        rp_var_use: string <- case len(chain_root) > 0 of {
                            true -> chain_root;
                            false -> rp_var
                        };
                        va_key_rp: string <- concat("_va.", rp_var_use);
                        va_str_rp: string <- case len(rp_var_use) > 0 of { true -> var@find_sp_binding(bound.outer_reg, va_key_rp); false -> "" };
                        var_binding_rp: string <- case len(rp_var_use) > 0 of { true -> var@find_sp_binding(bound.outer_reg, rp_var_use); false -> "" };
                        saved_ptr_reg_rp: string <- case len(rp_var_use) > 0 of { true -> var@find_last_sp_binding(bound.outer_reg, concat("_ptr.", rp_var_use)); false -> "" };
                        tuple_in_reg_rp: bool <- len(var_binding_rp) > 0 and var@is_memory_ref(var_binding_rp) == false;
                        mem_ref_binding_rp: bool <- len(var_binding_rp) > 0 and var@is_memory_ref(var_binding_rp);
                        mem_ref_load_rp: string <- case mem_ref_binding_rp of {
                            true -> concat(concat("    LDR X11, ", var_binding_rp), "\n");
                            false -> ""
                        };
                        tuple_base_reg_raw_rp: string <- case call_inner_rp of {
                            true -> "X0";
                            false -> case mem_ref_binding_rp of {
                                true -> "X11";
                                false -> case rp_var_use == bound.bound_name and len(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg) == false of {
                                    true -> bound.bound_reg;
                                    false -> case len(saved_ptr_reg_rp) > 0 of {
                                        true -> saved_ptr_reg_rp;
                                        false -> case tuple_in_reg_rp of {
                                            true -> var_binding_rp;
                                            false -> case rp_var_use == bound.bound_name of { true -> bound.bound_reg; false -> "" }
                                        }
                                    }
                                }
                            }
                        };
                        reg_base_for_va_rp: bool <- len(tuple_base_reg_raw_rp) > 0 and substring(tuple_base_reg_raw_rp, 0, 1) == "X";
                        tuple_base_reg_rp: string <- case len(va_str_rp) > 0 of {
                            true -> case reg_base_for_va_rp of {
                                true -> tuple_base_reg_raw_rp;
                                false -> ""
                            };
                            false -> tuple_base_reg_raw_rp
                        };
                        // Remap X0 -> X11 for LDR addressing when binding still says X0 (call returned pointer in X0).
                        // If %v is already bound to X11, do not MOV X11, X0 — X0 may hold an unrelated value.
                        // When base is X0: MOV X11, X0 only for the first field (byte offset 0). Later fields use
                        // [X11, #off] — X11 still holds the struct after that first load; a second MOV from X0 would
                        // copy a stale value (e.g. list_length result) after X0 was clobbered.
                        base_rp_was_x0: bool <- len(tuple_base_reg_rp) > 0 and tuple_base_reg_rp == "X0";
                        effective_base_rp: string <- case base_rp_was_x0 of { true -> "X11"; false -> tuple_base_reg_rp };
                        byte_off: int64 <- record_proj_chain_byte_offset(term);
                        va_adj_rp: int64 <- case len(va_str_rp) > 0 of {
                            true -> string_parse@string_to_int64(va_str_rp);
                            false -> 0
                        };
                        proj_mem_ref_rp: string <- case len(tuple_base_reg_rp) > 0 of {
                            true -> var@reg_offset_for_byte(effective_base_rp, byte_off + va_adj_rp);
                            false -> do
                                sp_adj_rp: int64 <- case len(va_str_rp) > 0 of {
                                    true -> va_adj_rp;
                                    false -> do
                                        adj_str_rp: string <- var@find_sp_binding(bound.outer_reg, "_adj");
                                        case len(adj_str_rp) > 0 of { true -> string_parse@string_to_int64(adj_str_rp); false -> 0 }
                                    end
                                };
                                var@sp_offset_for_byte_adj(byte_off, sp_adj_rp)
                            end
                        };
                        proj_prefix_rp: string <- prims_tuple@ldr_prefix_for_type(term.type_name);
                        proj_dest_num_rp: string <- case len(dest) > 0 of { true -> substring(dest, 1, len(dest)); false -> "0" };
                        proj_ldr_reg_rp: string <- concat(proj_prefix_rp, proj_dest_num_rp);
                        preserve_base_rp: string <- case call_inner_rp of {
                            true -> "    MOV X11, X0\n";
                            false -> case base_rp_was_x0 of {
                                true -> case byte_off == 0 of {
                                    true -> "    MOV X11, X0\n";
                                    false -> ""
                                };
                                false -> ""
                            }
                        };
                        root_rec_ty: string <- record_proj_root_record_type(term);
                        root_rec_stripped: string <- prims_record@strip_spaces_rt(root_rec_ty);
                        use_add_for_embedded_substruct: bool <- len(root_rec_stripped) > 0 and prims_record@record_type_starts(root_rec_stripped) and reg_conventions@is_inline_struct_type(term.type_name);
                        // Supervisor reply get_child path stores the live child_ref in top-level `child`.
                        // Accesses written as `reply.child_info.child` should resolve to that same live ref.
                        supervisor_child_info_child_chain: bool <- term.inner.kind == 6 and term.inner.name == "record_proj"
                            and term.inner.value == "child_info" and term.value == "child"
                            and is_supervisor_reply_record_type(root_rec_ty);
                        eff_byte_off: int64 <- case supervisor_child_info_child_chain of {
                            true -> prims_record@offset_bytes_before_field(root_rec_ty, "child");
                            false -> byte_off
                        };
                        add_imm_rp: int64 <- eff_byte_off + va_adj_rp;
                        add_imm_s_rp: string <- atom_table@int64_to_decimal_string(add_imm_rp);
                        proj_asm_rp: string <- case use_add_for_embedded_substruct of {
                            true -> concat(preserve_base_rp, concat("    ADD ", concat(proj_ldr_reg_rp, concat(", ", concat(effective_base_rp, concat(", #", concat(add_imm_s_rp, "\n")))))));
                            false -> concat(preserve_base_rp, concat("    LDR ", concat(proj_ldr_reg_rp, concat(", ", case len(tuple_base_reg_rp) > 0 of {
                                true -> var@reg_offset_for_byte(effective_base_rp, add_imm_rp);
                                false -> do
                                    sp_adj_eff: int64 <- case len(va_str_rp) > 0 of {
                                        true -> va_adj_rp;
                                        false -> do
                                            adj_str_eff: string <- var@find_sp_binding(bound.outer_reg, "_adj");
                                            case len(adj_str_eff) > 0 of { true -> string_parse@string_to_int64(adj_str_eff); false -> 0 }
                                        end
                                    };
                                    var@sp_offset_for_byte_adj(eff_byte_off, sp_adj_eff)
                                end
                            }))))
                        };
                        concat(concat(call_inner_asm_rp, mem_ref_load_rp), proj_asm_rp)
                    end;
                    false -> case term.name == "tuple_proj" of {
                    true -> do
                        tp_var: string <- case term.inner.kind == 1 of { true -> term.inner.name; false -> "" };
                        va_key: string <- concat("_va.", tp_var);
                        va_str: string <- case len(tp_var) > 0 of { true -> var@find_sp_binding(bound.outer_reg, va_key); false -> "" };
                        var_binding: string <- case len(tp_var) > 0 of { true -> var@find_sp_binding(bound.outer_reg, tp_var); false -> "" };
                        // Look up the saved tuple pointer using find_last_sp_binding to get the INNERMOST binding.
                        // When nested tuple decompositions reuse the same root variable (e.g. %_td_0 for both
                        // outer and inner destructuring), bound.outer_reg accumulates multiple _ptr.%_td_0=... entries.
                        // find_last_sp_binding returns the last (most recently added, innermost) occurrence,
                        // which is the correct register for the current scope rather than a stale outer binding.
                        saved_ptr_reg: string <- case len(tp_var) > 0 of { true -> var@find_last_sp_binding(bound.outer_reg, concat("_ptr.", tp_var)); false -> "" };
                        tuple_in_reg: bool <- len(var_binding) > 0 and var@is_memory_ref(var_binding) == false;
                        // Priority order for the base register:
                        // 1. bound.bound_reg when tp_var == bound.bound_name and bound.bound_reg is a real register (most up-to-date)
                        // 2. saved_ptr_reg from _ptr. binding in bound.outer_reg (for function params and cross-scope refs)
                        // 3. var_binding from bound.outer_reg
                        // 4. bound.bound_reg fallback (even if memory ref) when tp_var == bound.bound_name
                        tuple_base_reg_raw: string <- case tp_var == bound.bound_name and len(bound.bound_reg) > 0 and var@is_memory_ref(bound.bound_reg) == false of {
                            true -> bound.bound_reg;
                            false -> case len(saved_ptr_reg) > 0 of {
                                true -> saved_ptr_reg;
                                false -> case tuple_in_reg of {
                                    true -> var_binding;
                                    false -> case tp_var == bound.bound_name of { true -> bound.bound_reg; false -> "" }
                                }
                            }
                        };
                        tuple_base_reg: string <- case len(va_str) > 0 of {
                            true -> "";
                            false -> tuple_base_reg_raw
                        };
                        base_was_x0: bool <- len(tuple_base_reg) > 0 and tuple_base_reg == "X0";
                        effective_base: string <- case base_was_x0 of { true -> "X11"; false -> tuple_base_reg };
                        proj_index: int64 <- string_parse@string_to_int64(term.right_expr.value);
                        proj_byte_off: int64 <- prims_tuple@tuple_field_start_byte_offset(term.inner.type_name, proj_index);
                        box_tuple_layout: bool <- prims_tuple@tuple_type_uses_boxed_float32(term.inner.type_name);
                        // Flat tuple layout uses tuple_field_start_byte_offset for every tuple (aggregates are not all 8 bytes wide).
                        proj_mem_ref: string <- case len(tuple_base_reg) > 0 of {
                            true -> var@reg_offset_for_byte(effective_base, proj_byte_off);
                            false -> do
                                sp_adj: int64 <- case len(va_str) > 0 of {
                                    true -> string_parse@string_to_int64(va_str);
                                    false -> do
                                        adj_str: string <- var@find_sp_binding(bound.outer_reg, "_adj");
                                        case len(adj_str) > 0 of { true -> string_parse@string_to_int64(adj_str); false -> 0 }
                                    end
                                };
                                var@sp_offset_for_byte_adj(proj_byte_off, sp_adj)
                            end
                        };
                        proj_prefix: string <- prims_tuple@ldr_prefix_for_type(term.type_name);
                        proj_dest_num: string <- case len(dest) > 0 of { true -> substring(dest, 1, len(dest)); false -> "0" };
                        proj_ldr_reg: string <- concat(proj_prefix, proj_dest_num);
                        // Same X0/X11 discipline as record_proj: only index 0 copies X0→X11; later indices use [X11,#off].
                        preserve_base: string <- case base_was_x0 of {
                            true -> case proj_index == 0 of {
                                true -> "    MOV X11, X0\n";
                                false -> ""
                            };
                            false -> ""
                        };
                        tuple_elem_cnt_proj: int64 <- prims_tuple@count_type_elements(term.inner.type_name);
                        float_indirect_box: bool <- box_tuple_layout and reg_conventions@is_float32_type(term.type_name) and tuple_elem_cnt_proj > 1;
                        case box_tuple_layout of {
                            true -> case float_indirect_box of {
                                true -> concat(preserve_base, concat(concat(concat("    LDR X11, ", proj_mem_ref), "\n    LDR "), concat(proj_ldr_reg, ", [X11, #0]\n")));
                                false -> concat(preserve_base, concat("    LDR ", concat(proj_ldr_reg, concat(", ", proj_mem_ref))))
                            };
                            false -> concat(preserve_base, concat("    LDR ", concat(proj_ldr_reg, concat(", ", proj_mem_ref))))
                        }
                    end;
                    false -> case term.type_name == "string" and (term.name == "string_substring" or term.name == "string_substring_until_char") and term.right_expr.kind == 6 of {
                    true -> do
                        arg1_asm: string <- case bound.debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, "X0", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                            false -> term_to_asm_opt_bound(term.inner, "X0", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                        };
                        arg2_asm: string <- case bound.debug of {
                            true -> do term_to_asm_opt_bound_debug(term.right_expr.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                            false -> term_to_asm_opt_bound(term.right_expr.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                        };
                        arg3_asm: string <- case bound.debug of {
                            true -> do term_to_asm_opt_bound_debug(term.right_expr.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                            false -> term_to_asm_opt_bound(term.right_expr.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                        };
                        op_asm: string <- prims@emit_prim_op(term, dest);
                        guarded_arg3: string <- concat("    STR X1, [SP, #-16]!\n", concat(arg3_asm, "\n    LDR X1, [SP], #16\n"));
                        concat(concat(concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n")), guarded_arg3), op_asm)
                    end;
                    false -> case prims_list@is_list_prim(term.name) of {
                    true -> case term.name == "list_nil" of {
                        true -> prims_list@emit_prim_op(term, dest);
                        false -> case term.name == "list_cons" of {
                            true -> do
                                // Emit tail (arg2) into X2 BEFORE head (arg1) into X1.
                                // Evaluating arg2 first ensures that variable references bound to X1
                                // (e.g. prepend(val, xs) where xs is in X1) are resolved before
                                // arg1 overwrites X1 with the new head value.
                                arg2_asm: string <- case bound.debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                    false -> term_to_asm_opt_bound(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                arg1_asm: string <- case bound.debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                    false -> term_to_asm_opt_bound(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                op_asm: string <- prims_list@emit_prim_op(term, dest);
                                cons_dealloc: int64 <- flat_tuple_dealloc_size(term.inner);
                                cons_dealloc_asm: string <- case cons_dealloc > 0 of {
                                    true -> concat("\n    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(cons_dealloc), "\n"));
                                    false -> ""
                                };
                                concat(concat(concat(concat(arg2_asm, "\n"), concat(arg1_asm, "\n")), "\n"), concat(op_asm, cons_dealloc_asm))
                            end;
                            false -> do
                                // list_length arg goes to X9 then MOV X0,X9 in prims_list (helper entry still uses X0);
                                // avoids losing the list pointer when X0 holds a prior int64 result (e.g. chained lets).
                                // list_head/remove_head use X9 for the same reason.
                                arg_dest: string <- "X9";
                                arg_asm: string <- case bound.debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.inner, arg_dest, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                    false -> term_to_asm_opt_bound(term.inner, arg_dest, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                op_asm: string <- prims_list@emit_prim_op(term, dest);
                                concat(concat(arg_asm, "\n"), op_asm)
                            end
                        }
                        }
                    ;
                    false -> case prims_memory@is_memory_prim(term.name) of {
                    true -> case term.name == "fresh_lifetime" of {
                        true -> prims@emit_prim_op(term, dest);
                        false -> case term.name == "alloc_region" or term.name == "canonical_arena_lookup" of {
                            true -> do
                                arg_asm: string <- case term.name == "canonical_arena_lookup" of {
                                    true -> case bound.debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                        false -> term_to_asm_opt_bound(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    false -> ""
                                };
                                op_asm: string <- prims@emit_prim_op(term, dest);
                                case term.name == "canonical_arena_lookup" of {
                                    true -> concat(concat(arg_asm, "\n"), op_asm);
                                    false -> op_asm
                                }
                            end;
                            false -> case term.name == "read_ref" of {
                            true -> do
                                arg_asm: string <- case bound.debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                    false -> term_to_asm_opt_bound(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                op_asm: string <- prims@emit_prim_op(term, dest);
                                concat(concat(arg_asm, "\n"), op_asm)
                            end;
                            false -> case term.name == "alloc_ref" or term.name == "alloc_rec" or term.name == "alloc_buf" or term.name == "write_ref" or term.name == "buf_load" or term.name == "read_buf" or term.name == "canonical_arena_same" or term.name == "ref_eq" or term.name == "ref_in_region" of {
                                true -> do
                                    arg1_asm: string <- case bound.debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                        false -> term_to_asm_opt_bound(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    arg2_asm: string <- case bound.debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    bounds_asm: string <- case term.name == "buf_load" or term.name == "read_buf" of {
                                        true -> prims_memory@emit_buf_bounds_check(term, bound.outer_reg, dest);
                                        false -> ""
                                    };
                                    op_asm: string <- prims@emit_prim_op(term, dest);
                                    // tuple_make for arg2 uses SUB SP; restore before later ops / return. write_ref leaves ref in X1; bindings expect ref in X2.
                                    tuple_stack_bytes: int64 <- flat_tuple_dealloc_size(term.right_expr);
                                    tuple_sp_restore: string <- case tuple_stack_bytes > 0 of {
                                        true -> concat("\n    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(tuple_stack_bytes), "\n"));
                                        false -> ""
                                    };
                                    write_ref_recover: string <- case term.name == "write_ref" of {
                                        true -> "\n    MOV X2, X1\n";
                                        false -> ""
                                    };
                                    after_op: string <- concat(op_asm, concat(tuple_sp_restore, write_ref_recover));
                                    part_a: string <- concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n"));
                                    part_b: string <- concat(concat(part_a, "\n"), bounds_asm);
                                    concat(part_b, after_op)
                                end;
                                false -> case term.name == "buf_store" of {
                                    true -> do
                                        // Emit arg1 (buf) to X1 before arg2 (idx/val tuple) to X2.
                                        // alloc_buf leaves the buffer pointer in X2; tuple_make ends with MOV X2, SP.
                                        // If we emitted the tuple first, X2 would be overwritten and the follow-up
                                        // buf load (e.g. MOV X1, X2) would pass the tuple pointer to buf_store.
                                        // Flat tuple emission uses per-element scratch temps (e.g. X9), not X1.
                                        arg1_asm: string <- case bound.debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                            false -> term_to_asm_opt_bound(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        arg2_asm: string <- case bound.debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                            false -> term_to_asm_opt_bound(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        op_asm: string <- prims_memory@emit_buf_store(term, dest, bound.outer_reg);
                                        // tuple_make did SUB SP (possibly multiple for nested tuple_make); restore SP before return / next ops.
                                        tuple_bytes: int64 <- flat_tuple_dealloc_size(term.right_expr);
                                        tuple_sp_adj: string <- concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(tuple_bytes), "\n"));
                                        // emit_buf_store leaves X1=buf; LDR X2,[X2] leaves X2=index. Bindings still expect buf in X2.
                                        recover_buf_reg: string <- "    MOV X2, X1\n";
                                        after_store: string <- concat(op_asm, concat("\n", concat(tuple_sp_adj, concat("\n", recover_buf_reg))));
                                        concat(concat(concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n")), "\n"), after_store)
                                    end;
                                    false -> prims@emit_prim_op(term, dest)
                                }
                            }
                            }
                        }
                    }
                    false -> case prims_collection_result@is_collection_result_prim(term.name) of {
                    true -> do
                        arg_asm: string <- case bound.debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                            false -> term_to_asm_opt_bound(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                        };
                        mov_arg: string <- "    MOV X0, X1\n";
                        op_asm: string <- prims_collection_result@emit_prim_op_with_table(term, dest, pools.table);
                        concat(concat(concat(arg_asm, "\n"), mov_arg), op_asm)
                    end;
                    false -> case prims_checked_int64@is_checked_int64_prim(term.name) of {
                    true -> do
                        arg1_asm: string <- case bound.debug of {
                            true -> do term_to_asm_opt_bound_debug(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                            false -> term_to_asm_opt_bound(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                        };
                        arg2_asm: string <- case prims_checked_int64@is_checked_int64_unary_prim(term.name) of {
                            true -> "";
                            false -> case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            }
                        };
                        op_asm: string <- prims_checked_int64@emit_prim_op(term, dest);
                        concat(concat(concat(concat(arg1_asm, "\n"), arg2_asm), "\n"), op_asm)
                    end;
                    false -> case prims_ordering_identity@is_ordering_identity_prim(term.name) of {
                    true -> case term.name == "ordering_identity_fresh_env" of {
                        true -> prims@emit_prim_op(term, dest);
                        false -> do
                            arg1_asm: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(term.inner, "X1", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            arg2_asm: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(term.right_expr, "X2", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            op_asm: string <- prims@emit_prim_op(term, dest);
                            concat(concat(concat(concat(arg1_asm, "\n"), concat(arg2_asm, "\n")), "\n"), op_asm)
                        end
                    };
                    false -> case prims_actors@is_actor_prim(term.name) of {
                        true -> case prims_actors@actor_prim_is_nullary(term.name) of {
                            true -> prims_actors@emit_prim_op(term, dest);
                            false -> case prims_actors@actor_prim_is_unary(term.name) of {
                                true -> do
                                    arg_asm_u: string <- case bound.debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.inner, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                        false -> term_to_asm_opt_bound(term.inner, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    op_asm_u: string <- prims_actors@emit_prim_op(term, dest);
                                    // Phase E e3b2/e4b: actor prim arg may be a record_make / tuple_make literal that did
                                    // SUB SP, SP, #N (e.g. start_child(spec_literal)). Restore SP after the runtime call so
                                    // the surrounding behavior fn's saved-register restore (LDP) reads the correct stack slots.
                                    unary_sp_bytes: int64 <- flat_tuple_dealloc_size(term.inner);
                                    unary_sp_restore: string <- case unary_sp_bytes > 0 of {
                                        true -> concat("\n    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(unary_sp_bytes), "\n"));
                                        false -> ""
                                    };
                                    concat(concat(arg_asm_u, "\n"), concat(op_asm_u, unary_sp_restore))
                                end;
                                false -> case prims_actors@actor_prim_is_ternary(term.name) of {
                                    true -> do
                                        left_asm_3: string <- case bound.debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.inner, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                            false -> term_to_asm_opt_bound(term.inner, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        hold_actor_3: string <- "    MOV X11, X9\n";
                                        right_asm_3: string <- case bound.debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.right_expr, "X10", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                            false -> term_to_asm_opt_bound(term.right_expr, "X10", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        tuple_bytes_3: int64 <- case len(var@find_sp_binding(bound.outer_reg, "_tuple_sret")) > 0 of {
                                            true -> 0;
                                            false -> flat_tuple_dealloc_size(term.right_expr)
                                        };
                                        op_asm_3: string <- prims_actors@emit_prim_op(term, dest);
                                        tuple_sp_restore_3: string <- case tuple_bytes_3 > 0 of {
                                            true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(tuple_bytes_3), "\n"));
                                            false -> ""
                                        };
                                        concat(concat(concat(concat(concat(concat(left_asm_3, "\n"), hold_actor_3), concat(right_asm_3, "\n")), op_asm_3), "\n"), tuple_sp_restore_3)
                                    end;
                                    false -> do
                                        left_asm_a: string <- case bound.debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.inner, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                            false -> term_to_asm_opt_bound(term.inner, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        spawn_three: bool <- (term.name == "spawn" or term.name == "spawn_dangerous" or term.name == "spawn_linked") and term.right_expr.kind == 6 and term.right_expr.name == "tuple_make";
                                        spawn_registered_tuple: bool <- (term.name == "spawn_registered" or term.name == "spawn_dangerous_registered") and term.right_expr.kind == 6 and term.right_expr.name == "tuple_make";
                                        actor_msg_binary: bool <- term.name == "send" or term.name == "actor_call" or term.name == "actor_call_registered" or term.name == "actor_cast" or term.name == "actor_cast_registered" or term.name == "actor_cast_dangerous_registered" or term.name == "supervisor_add_child";
                                        init_hold_spawn: string <- case spawn_three or spawn_registered_tuple or actor_msg_binary of { true -> "    MOV X11, X9\n"; false -> "" };
                                        right_asm_a: string <- case bound.debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.right_expr, "X10", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                            false -> term_to_asm_opt_bound(term.right_expr, "X10", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        tuple_bytes_a: int64 <- case len(var@find_sp_binding(bound.outer_reg, "_tuple_sret")) > 0 of {
                                            true -> 0;
                                            false -> flat_tuple_dealloc_size(term.right_expr)
                                        };
                                        op_asm_a: string <- prims_actors@emit_prim_op(term, dest);
                                        tuple_sp_restore_a: string <- case tuple_bytes_a > 0 of {
                                            true -> concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(tuple_bytes_a), "\n"));
                                            false -> ""
                                        };
                                        concat(concat(concat(concat(concat(concat(left_asm_a, "\n"), init_hold_spawn), concat(right_asm_a, "\n")), op_asm_a), "\n"), tuple_sp_restore_a)
                                    end
                                }
                            }
                        }
                        false -> case term.type_name == "int64" and (term.name == "string_length_bytes" or term.name == "string_length_chars") of {
                        true -> do
                            arg_asm: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(term.inner, "X0", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(term.inner, "X0", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            op_asm: string <- prims@emit_prim_op(term, dest);
                            concat(concat(arg_asm, "\n"), op_asm)
                        end;
                        false -> do
                    // Comparisons (lt, gt, le, ge, eq, nq) have result type "bool" but operands determine reg size
                    is_cmp: bool <- term.type_name == "bool" and (term.name == "lt" or term.name == "gt" or term.name == "le" or term.name == "ge" or term.name == "eq" or term.name == "nq" or term.name == "is_nan" or term.name == "is_inf" or term.name == "is_finite");
                    prim_type: string <- case is_cmp of { true -> term.inner.type_name; false -> term.type_name };
                    is_float64: bool <- prim_type == "float64";
                    is_float32: bool <- prim_type == "float32";
                    is_float16: bool <- prim_type == "float16";
                    is_narrow: bool <- prim_type == "int32" or prim_type == "int16" or prim_type == "int8" or prim_type == "uint32" or prim_type == "uint16" or prim_type == "uint8";
                    is_string_prim: bool <- prim_type == "string" and term.name == "string_concat";
                    reg_prefix: string <- case is_float64 of {
                        true -> "D";
                        false -> case is_float32 of {
                            true -> "S";
                            false -> case is_float16 of {
                                true -> "H";
                                false -> case is_narrow of {
                                    true -> "W";
                                    false -> "X"
                                }
                            }
                        }
                    };
                    left_reg: string <- case is_string_prim of { true -> "X0"; false -> case is_float64 or is_float32 or is_float16 of { true -> concat(reg_prefix, "1"); false -> concat(reg_prefix, "9") } };
                    right_reg: string <- case is_string_prim of { true -> "X1"; false -> case is_float64 or is_float32 or is_float16 of { true -> concat(reg_prefix, "2"); false -> concat(reg_prefix, "10") } };
                    is_unary_prim: bool <- term.name == "neg" or term.name == "bnot" or term.name == "is_nan" or term.name == "is_inf" or term.name == "is_finite";
                    case is_unary_prim of {
                        true -> do
                            // Unary negate_* / prim neg: operand in left_reg only (right_expr is dummy)
                            // Float neg must write back to left_reg (S1/D1/H1) so a following FCMP still sees the result in r1.
                            arg_asm: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            // Float FNEG is emitted as FNEG <dest>, <r1> (see arithmetic.emit_fneg_*): operand stays in r1 (S1/D1/H1).
                            // Caller dest may be S0/D0 for print_float32/64; must not force dest=r1 or the helper reads the wrong reg.
                            op_asm: string <- prims@emit_prim_op(term, dest);
                            concat(concat(arg_asm, "\n"), op_asm)
                        end;
                        false -> case bound.bound_name == "" of {
                        true -> case term.inner.kind == 6 and term.right_expr.kind == 6 of {
                            true -> do
                                // Both operands are prims: left prim loads into reg 0, right prim may use reg 0 (calls use X0 for args/result).
                                // Must save left to stack before right eval; right can overwrite temp_reg (X0/D0/S0) via calls or nested prims.
                                // Arithmetic expects left in r1, right in r2. For non-string: put right in right_reg, restore left to left_reg.
                                // String concat expects X0=left, X1=right; keep original layout for is_string_prim.
                                // Important: avoid using X0 as a scratch reg for integer prims because tuple_proj may use X0
                                // as the tuple base pointer (function param), and clobbering it breaks subsequent projections.
                                temp_reg: string <- case is_string_prim or is_float64 or is_float32 or is_float16 of {
                                    true -> concat(reg_prefix, "0");
                                    false -> left_reg
                                };
                                left_asm: string <- case bound.debug of {
                                    true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                    false -> term_to_asm_opt_bound(term.inner, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                save_left: string <- case is_string_prim of {
                                    true -> "    STR X0, [SP, #-16]!\n";
                                    false -> case is_float64 or is_float32 or is_float16 of {
                                        true -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                        false -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n")
                                    }
                                };
                                right_asm: string <- case is_string_prim of {
                                    true -> case bound.debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    };
                                    false -> case bound.debug of {
                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                    }
                                };
                                restore_left: string <- case is_string_prim of {
                                    true -> "    LDR X0, [SP], #16\n";
                                    false -> case is_float64 or is_float32 or is_float16 of {
                                        true -> concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                        false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                    }
                                };
                                op_asm: string <- prims@emit_prim_op(term, dest);
                                part1: string <- concat(left_asm, "\n");
                                part2: string <- concat(part1, save_left);
                                part3: string <- concat(part2, right_asm);
                                part4: string <- concat(part3, "\n");
                                part5: string <- concat(part4, restore_left);
                                concat(part5, op_asm)
                            end;
                            false -> do
                                left_is_prim: bool <- term.inner.kind == 6;
                                right_is_prim: bool <- term.right_expr.kind == 6;
                                (first_asm: string, second_asm: string) <- case left_is_prim of {
                                    true -> do
                                        // Left is prim, right is var. Arithmetic expects left in r1, right in r2. For non-string: right to right_reg, left to left_reg (save/restore).
                                        right_asm: string <- case is_string_prim of {
                                            true -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            false -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            }
                                        };
                                        save_right: string <- concat(concat(concat("    STR ", right_reg), ", [SP, #-16]!\n"), "");
                                        left_asm: string <- case is_string_prim of {
                                            true -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            false -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            }
                                        };
                                        restore_right: string <- concat(concat(concat("    LDR ", right_reg), ", [SP], #16\n"), "");
                                        combined: string <- concat(concat(concat(concat(concat(concat(right_asm, "\n"), save_right), left_asm), "\n"), restore_right), "");
                                        (combined, "")
                                    end;
                                    false -> case right_is_prim of {
                                        true -> do
                                            // Left is var/call, right is prim. Arithmetic expects left in r1, right in r2.
                                            // Save left to stack; right to right_reg; restore left to left_reg.
                                            temp_reg: string <- concat(reg_prefix, "0");
                                            left_asm: string <- case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.inner, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            save_left: string <- case is_string_prim of {
                                                true -> "    STR X0, [SP, #-16]!\n";
                                                false -> case is_float64 or is_float32 or is_float16 of {
                                                    true -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                                    false -> "    STR X0, [SP, #-16]!\n"
                                                }
                                            };
                                            right_asm: string <- case is_string_prim of {
                                                true -> case bound.debug of {
                                                    true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                    false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                false -> case bound.debug of {
                                                    true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                    false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                }
                                            };
                                            restore_left: string <- case is_string_prim of {
                                                true -> "    LDR X0, [SP], #16\n";
                                                false -> case is_float64 or is_float32 or is_float16 of {
                                                    true -> concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                                    false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                                }
                                            };
                                            combined: string <- concat(concat(concat(concat(concat(concat(left_asm, "\n"), save_left), right_asm), "\n"), restore_left), "");
                                            (combined, "")
                                        end;
                                        false -> case (term.inner.kind == 0 or term.inner.kind == 1) and (term.right_expr.kind == 0 or term.right_expr.kind == 1) of {
                                            true -> do
                                                // Both operands are simple (var or const). Calls (kind 4) overwrite X9/X10; must use save/restore.
                                                // Arithmetic expects left in r1, right in r2 (same as add/mul).
                                                l: string <- case bound.debug of {
                                                    true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                    false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                r: string <- case bound.debug of {
                                                    true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                    false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                // For float32/float64: emit right before left. Left writes to S1/D1 (left_reg),
                                                // which may be the source register for the right var (if bound to S1/D1).
                                                // Emitting right first preserves the right operand before left clobbers its source.
                                                // For string_prim with left=const: loading literal into X0 (left_reg) clobbers right var if right is in X0.
                                                // Emit right first (MOV X1, X0) to save right before loading left literal into X0.
                                                case is_float32 or is_float64 or is_float16 or (is_string_prim and term.inner.kind == 0) of {
                                                    true -> (concat(concat(concat(r, "\n"), l), "\n"), "");
                                                    false -> (concat(concat(concat(l, "\n"), r), "\n"), "")
                                                }
                                            end;
                                            false -> do
                                                // Arithmetic expects left in r1, right in r2 (same as add/mul). For non-string: left to left_reg, right to right_reg.
                                                // String concat expects X0=left, X1=right; keep original layout.
                                                l: string <- case is_string_prim of {
                                                    true -> case bound.debug of {
                                                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                        false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    };
                                                    false -> case bound.debug of {
                                                        true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                        false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    }
                                                };
                                                r: string <- case is_string_prim of {
                                                    true -> case bound.debug of {
                                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    };
                                                    false -> case bound.debug of {
                                                        true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                        false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                    }
                                                };
                                                identity_moves: string <- case term.inner.kind == 0 and term.right_expr.kind == 0 and (term.name == "and" or term.name == "or") of {
                                                    true -> case is_float64 or is_float32 or is_float16 of {
                                                        true -> concat(concat(concat(concat("    FMOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    FMOV ", left_reg), ", "), left_reg), ""));
                                                        false -> concat(concat(concat(concat("    MOV ", right_reg), ", "), concat(right_reg, "\n")), concat(concat(concat(concat("    MOV ", left_reg), ", "), left_reg), ""))
                                                    };
                                                    false -> ""
                                                };
                                                second_with_id: string <- case len(identity_moves) > 0 of {
                                                    true -> concat(concat(r, "\n"), identity_moves);
                                                    false -> r
                                                };
                                                // Left may be a call (kind 4): emit right first, save right_reg, then left, restore (right survives left's clobbers).
                                                // If both operands are calls (e.g. fib(n-1)+fib(n-2)), right eval runs first and BLR leaves X0 = fib(n-2), not n — spill X0 before right, LDR X0 before left so fib(n-1) sees n.
                                                // Right-only call: emit left first, then right; spill left_reg across BLR (AAPCS64 volatiles). See factorial n * factorial(n-1).
                                                left_is_call: bool <- term.inner.kind == 4;
                                                right_is_call: bool <- term.right_expr.kind == 4;
                                                save_x0_before_right_when_both_calls: string <- case left_is_call and right_is_call of {
                                                    true -> case is_float64 or is_float32 or is_float16 of {
                                                        true -> "";
                                                        false -> case is_string_prim of {
                                                            true -> "    STR X0, [SP, #-16]!\n";
                                                            false -> "    STR X0, [SP, #-16]!\n"
                                                        }
                                                    };
                                                    false -> ""
                                                };
                                                restore_x0_before_left_when_both_calls: string <- case left_is_call and right_is_call of {
                                                    true -> case is_float64 or is_float32 or is_float16 of {
                                                        true -> "";
                                                        false -> case is_string_prim of {
                                                            true -> "    LDR X0, [SP], #16\n";
                                                            false -> "    LDR X0, [SP], #16\n"
                                                        }
                                                    };
                                                    false -> ""
                                                };
                                                save_right_after_restore_x0_both_calls: string <- case left_is_call and right_is_call of {
                                                    true -> case is_string_prim of {
                                                        true -> "    STR X1, [SP, #-16]!\n";
                                                        false -> concat(concat("    STR ", right_reg), ", [SP, #-16]!\n")
                                                    };
                                                    false -> ""
                                                };
                                                save_left_across_right_call: string <- case right_is_call of {
                                                    true -> case is_string_prim of {
                                                        true -> "    STR X0, [SP, #-16]!\n";
                                                        false -> concat(concat("    STR ", left_reg), ", [SP, #-16]!\n")
                                                    };
                                                    false -> ""
                                                };
                                                restore_left_across_right_call: string <- case right_is_call of {
                                                    true -> case is_string_prim of {
                                                        true -> "    LDR X0, [SP], #16\n";
                                                        false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                                    };
                                                    false -> ""
                                                };
                                                save_right: string <- case left_is_call of {
                                                    true -> case left_is_call and right_is_call of {
                                                        true -> "";
                                                        false -> case is_string_prim of {
                                                            true -> "    STR X1, [SP, #-16]!\n";
                                                            false -> concat(concat("    STR ", right_reg), ", [SP, #-16]!\n")
                                                        }
                                                    };
                                                    false -> ""
                                                };
                                                restore_right: string <- case left_is_call of {
                                                    true -> case is_string_prim of {
                                                        true -> "    LDR X1, [SP], #16\n";
                                                        false -> concat(concat("    LDR ", right_reg), ", [SP], #16\n")
                                                    };
                                                    false -> ""
                                                };
                                                first_combined: string <- case left_is_call of {
                                                    true -> do
                                                        fc0: string <- concat(save_x0_before_right_when_both_calls, second_with_id);
                                                        fc1: string <- concat(concat(concat(concat(concat(concat(fc0, "\n"), restore_x0_before_left_when_both_calls), "\n"), save_right_after_restore_x0_both_calls), "\n"), save_right);
                                                        concat(concat(concat(concat(fc1, l), "\n"), restore_right), "")
                                                    end;
                                                    false -> case right_is_call of {
                                                        true -> concat(concat(concat(concat(concat(concat(l, "\n"), save_left_across_right_call), second_with_id), "\n"), restore_left_across_right_call), "");
                                                        false -> concat(concat(second_with_id, "\n"), l)
                                                    }
                                                };
                                                (first_combined, "")
                                            end
                                        }
                                    }
                                };
                                op_asm: string <- prims@emit_prim_op(term, dest);
                                concat(concat(concat(first_asm, "\n"), concat(second_asm, "\n")), op_asm)
                            end
                        };
                        false -> do
                            // bound.bound_name != "": inside let/function body. Use same layout as bound.bound_name=="": left->r1, right->r2.
                            // String concat expects X0=left, X1=right; keep original layout for is_string_prim.
                            left_is_prim: bool <- term.inner.kind == 6;
                            right_is_prim: bool <- term.right_expr.kind == 6;
                            bool_and_or_two_prims: bool <- right_is_prim and term.type_name == "bool" and (term.name == "and" or term.name == "or") and is_string_prim == false and is_float64 == false and is_float32 == false and is_float16 == false;
                            (left_asm: string, right_asm: string) <- case left_is_prim of {
                                true -> case bool_and_or_two_prims of {
                                    true -> do
                                        temp_reg: string <- left_reg;
                                        left_inner: string <- case bound.debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                            false -> term_to_asm_opt_bound(term.inner, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        save_left: string <- concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                        right_inner: string <- case bound.debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                            false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        restore_left: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                        combined: string <- concat(concat(concat(concat(concat(concat(left_inner, "\n"), save_left), right_inner), "\n"), restore_left), "");
                                        (combined, "")
                                    end;
                                    false -> case right_is_prim and is_string_prim == false and is_float64 == false and is_float32 == false and is_float16 == false of {
                                        true -> do
                                            temp_reg2: string <- left_reg;
                                            left_2p: string <- case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg2, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.inner, temp_reg2, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            save_l2: string <- concat(concat("    STR ", temp_reg2), ", [SP, #-16]!\n");
                                            right_2p: string <- case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            restore_l2: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                            comb_2p: string <- concat(concat(concat(concat(concat(concat(left_2p, "\n"), save_l2), right_2p), "\n"), restore_l2), "");
                                            (comb_2p, "")
                                        end;
                                        false -> do
                                            l: string <- case is_string_prim of {
                                                true -> case bound.debug of {
                                                    true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                    false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                false -> case bound.debug of {
                                                    true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                    false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                }
                                            };
                                            r: string <- case is_string_prim of {
                                                true -> case bound.debug of {
                                                    true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                    false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                };
                                                false -> case bound.debug of {
                                                    true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                    false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                                }
                                            };
                                            right_simple_for_left_prim: bool <- term.right_expr.kind == 0 or term.right_expr.kind == 1;
                                            preserve_left_for_right: bool <- right_simple_for_left_prim == false and is_string_prim == false and is_float64 == false and is_float32 == false and is_float16 == false;
                                            case preserve_left_for_right of {
                                                true -> do
                                                    save_left_np: string <- concat(concat("    STR ", left_reg), ", [SP, #-16]!\n");
                                                    restore_left_np: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                                    combined_np: string <- concat(concat(concat(concat(concat(concat(l, "\n"), save_left_np), r), "\n"), restore_left_np), "");
                                                    (combined_np, "")
                                                end;
                                                false -> (l, r)
                                            }
                                        end
                                    }
                                };
                                false -> case right_is_prim of {
                                    true -> do
                                        temp_reg: string <- concat(reg_prefix, "0");
                                        l: string <- case bound.debug of {
                                            true -> do term_to_asm_opt_bound_debug(term.inner, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                            false -> term_to_asm_opt_bound(term.inner, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        save: string <- case is_string_prim of {
                                            true -> "    STR X0, [SP, #-16]!\n";
                                            false -> case is_float64 or is_float32 or is_float16 of {
                                                true -> concat(concat("    STR ", temp_reg), ", [SP, #-16]!\n");
                                                false -> "    STR X0, [SP, #-16]!\n"
                                            }
                                        };
                                        r: string <- case is_string_prim of {
                                            true -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            false -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            }
                                        };
                                        restore: string <- case is_string_prim of {
                                            true -> "    LDR X0, [SP], #16\n";
                                            false -> case is_float64 or is_float32 or is_float16 of {
                                                true -> concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                                false -> concat(concat("    LDR ", left_reg), ", [SP], #16\n")
                                            }
                                        };
                                        left_combined: string <- concat(concat(concat(concat(concat(concat(l, "\n"), save), r), "\n"), restore), "");
                                        (left_combined, "")
                                    end;
                                    false -> do
                                        // left->left_reg, right->right_reg (same as bound.bound_name=="") for arithmetic.
                                        l: string <- case is_string_prim of {
                                            true -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            false -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.inner, left_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            }
                                        };
                                        r: string <- case is_string_prim of {
                                            true -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            false -> case bound.debug of {
                                                true -> do term_to_asm_opt_bound_debug(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                                false -> term_to_asm_opt_bound(term.right_expr, right_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            }
                                        };
                                        // For float32/float64: emit right before left. Left writes to S1/D1 (left_reg),
                                        // which may be the source register for the right var. Emit right first to preserve it.
                                        // For string_prim with left=const: loading literal into X0 (left_reg) clobbers right var if right is in X0.
                                        // Emit right first (MOV X1, X0) to save right before loading left literal into X0.
                                        // When right operand is a call (kind 4), save/restore left_reg across it (AAPCS64: X9-X15 are caller-saved).
                                        left_is_call: bool <- term.inner.kind == 4;
                                        right_is_call: bool <- term.right_expr.kind == 4;
                                        case right_is_call and is_string_prim == false of {
                                            true -> do
                                                save_left: string <- concat(concat("    STR ", left_reg), ", [SP, #-16]!\n");
                                                restore_left: string <- concat(concat("    LDR ", left_reg), ", [SP], #16\n");
                                                combined: string <- concat(concat(concat(concat(concat(concat(l, "\n"), save_left), r), "\n"), restore_left), "");
                                                (combined, "")
                                            end;
                                            false -> case left_is_call and is_string_prim == false of {
                                                true -> do
                                                    save_right: string <- concat(concat("    STR ", right_reg), ", [SP, #-16]!\n");
                                                    restore_right: string <- concat(concat("    LDR ", right_reg), ", [SP], #16\n");
                                                    combined: string <- concat(concat(concat(concat(concat(concat(r, "\n"), save_right), l), "\n"), restore_right), "");
                                                    (combined, "")
                                                end;
                                                false -> case is_float32 or is_float64 or is_float16 or (is_string_prim and term.inner.kind == 0) of {
                                                    true -> (r, l);
                                                    false -> (l, r)
                                                }
                                            }
                                        }
                                    end
                                }
                            };
                            op_asm: string <- prims@emit_prim_op(term, dest);
                            case len(right_asm) > 0 of {
                                true -> concat(concat(concat(left_asm, "\n"), concat(right_asm, "\n")), op_asm);
                                false -> concat(concat(left_asm, "\n"), op_asm)
                            }
                        end
                    }
                    }
                    end
                    }
                    }
                    }
                    }
                    }
                    }
                    }
                    }
                    }
                    }
                    }
                };
                _: int64 -> concat("    ; unsupported term kind ", "?")
                }
            }
            }
    produces
        pure result
    end
}

// Debug variant: prints bound.bound_name, bound.bound_reg, term structure for let and var at each recursion
// When bound.debug and let: traces rhs_reg (from compute_rhs_reg_top_level or compute_rhs_reg_in_let)
fn term_to_asm_opt_bound_debug(term: SIRTerm, dest: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string {
    sequence proc[DeviceIO]
        rhs_reg_trace: string <- case bound.debug and term.kind == 2 of {
            true -> do
                rhs_reg: string <- case len(bound.bound_name) > 0 and len(bound.bound_reg) > 0 of {
                    true -> let_dispatcher@compute_rhs_reg_in_let(term, dest, bound.bound_name, bound.bound_reg, bound.outer_reg);
                    false -> let_dispatcher@compute_rhs_reg_top_level(term, bound.bound_reg, dest)
                };
                branch: string <- case len(bound.bound_name) > 0 and len(bound.bound_reg) > 0 of { true -> "in_let"; false -> "top_level" };
                p1: string <- concat("  [TRACE let] rhs_reg=", rhs_reg);
                p2: string <- concat(p1, " branch=");
                p3: string <- concat(p2, branch);
                p4: string <- concat(p3, " bound.bound_name=");
                p5: string <- concat(p4, bound.bound_name);
                p6: string <- concat(p5, " term.name=");
                p7: string <- concat(p6, term.name);
                p8: string <- concat(p7, " bound.bound_reg=");
                p9: string <- concat(p8, bound.bound_reg);
                p10: string <- concat(p9, " term.inner.kind=");
                kind_str: string <- case term.inner.kind == 0 of { true -> "0(const)"; false -> "non-0" };
                concat(p10, kind_str)
            end;
            false -> ""
        };
        _: int64 <- case len(rhs_reg_trace) > 0 of {
            true -> do println(rhs_reg_trace); 0 end;
            false -> 0
        };
        msg: string <- case len(rhs_reg_trace) == 0 and bound.debug and term.kind == 2 of {
            true -> do
                p1: string <- concat("  [EMITTER let] bound.bound_name=", bound.bound_name);
                p2: string <- concat(p1, " bound.bound_reg=");
                p3: string <- concat(p2, bound.bound_reg);
                concat(p3, concat(" term.name=", term.name))
            end;
            false -> case bound.debug and term.kind == 1 of {
                true -> do
                    v1: string <- concat("  [EMITTER var] term.name=", term.name);
                    v2: string <- concat(v1, " dest=");
                    v3: string <- concat(v2, dest);
                    v4: string <- concat(v3, " bound.bound_name=");
                    v5: string <- concat(v4, bound.bound_name);
                    v6: string <- concat(v5, " bound.bound_reg=");
                    v7: string <- concat(v6, bound.bound_reg);
                    concat(v7, concat(" bound.outer_reg=", bound.outer_reg))
                end;
                false -> ""
            }
        };
        _: int64 <- case len(msg) > 0 of {
            true -> do println(msg); 0 end;
            false -> 0
        };
        prim_msg: string <- case bound.debug and term.kind == 6 of {
            true -> do
                p1: string <- concat("  [TRACE prim] ", term.name);
                p2: string <- concat(p1, " dest=");
                p3: string <- concat(p2, dest);
                p4: string <- concat(p3, " bound.bound_name=");
                p5: string <- concat(p4, bound.bound_name);
                p6: string <- concat(p5, " bound.bound_reg=");
                p7: string <- concat(p6, bound.bound_reg);
                left_is_prim: bool <- term.inner.kind == 6;
                right_is_prim: bool <- term.right_expr.kind == 6;
                bound_empty: bool <- len(bound.bound_name) == 0;
                sub_branch: string <- case left_is_prim of {
                    true -> case right_is_prim of { true -> "both_prims"; false -> "left_prim_right_var" };
                    false -> case right_is_prim of { true -> "left_var_right_prim"; false -> "both_vars" }
                };
                top_or_let: string <- case bound_empty of { true -> "top"; false -> "in_let" };
                p8: string <- concat(p7, " branch=");
                p9: string <- concat(p8, top_or_let);
                p10: string <- concat(p9, " sub=");
                p11: string <- concat(p10, sub_branch);
                p12: string <- concat(p11, " Lkind=");
                lk: string <- case term.inner.kind == 1 of { true -> term.inner.name; false -> "prim" };
                p13: string <- concat(p12, lk);
                p14: string <- concat(p13, " Rkind=");
                rk: string <- case term.right_expr.kind == 1 of { true -> term.right_expr.name; false -> "prim" };
                concat(p14, rk)
            end;
            false -> ""
        };
        _: int64 <- case len(prim_msg) > 0 of {
            true -> do println(prim_msg); 0 end;
            false -> 0
        };
        const_msg: string <- case bound.debug and term.kind == 0 of {
            true -> do
                p1: string <- concat("  [TRACE const] dest=", dest);
                p2: string <- concat(p1, " value=");
                concat(p2, term.value)
            end;
            false -> ""
        };
        _: int64 <- case len(const_msg) > 0 of {
            true -> do println(const_msg); 0 end;
            false -> 0
        };
        result: string <- term_to_asm_opt_bound(term, dest, pools, bound)
    produces
        pure result
    end
}

// For each tuple-typed element in a tuple_make chain, compute the inner adj value and
// encode as |_adj.{idx}={adj}| bindings.  adj_i = suffix_alloc_after_i + elem_i_nested.
fn compute_inner_adj_bindings_record(term: SIRTerm, idx: int64, count: int64, cumulative_alloc: int64, total_nested: int64) -> string {
    case idx < count - 1 and term.kind == 6 and term.name == "record_make" of {
        true -> do
            elem: SIRTerm <- term.inner;
            eit: bool <- elem.kind == 6 and (elem.name == "tuple_make" or elem.name == "record_make");
            eta: int64 <- case eit of {
                true -> case elem.name == "tuple_make" of {
                    true -> flat_tuple_total_alloc(elem);
                    false -> flat_record_total_alloc(elem)
                };
                false -> 0
            };
            nc: int64 <- cumulative_alloc + eta;
            binding: string <- case eit of {
                true -> case elem.name == "tuple_make" of {
                    true -> do
                        sa: int64 <- total_nested - nc;
                        ec: int64 <- prims_tuple@count_flat_elements(elem);
                        en: int64 <- flat_tuple_nested_alloc(elem, ec, 0);
                        ia: int64 <- sa + en;
                        concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                    end;
                    false -> do
                        sa2: int64 <- total_nested - nc;
                        ec2: int64 <- prims_record@count_record_fields(elem.type_name);
                        en2: int64 <- flat_record_sum_nested_inners(elem);
                        ia2: int64 <- sa2 + en2;
                        concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia2))))
                    end
                };
                false -> ""
            };
            rest: string <- compute_inner_adj_bindings_record(term.right_expr, idx + 1, count, nc, total_nested);
            concat(binding, rest)
        end;
        false -> do
            eit: bool <- term.kind == 6 and term.name == "record_make";
            eta: int64 <- case eit of { true -> flat_record_total_alloc(term); false -> 0 };
            nc: int64 <- cumulative_alloc + eta;
            case eit of {
                true -> do
                    sa: int64 <- total_nested - nc;
                    ec: int64 <- prims_record@count_record_fields(term.type_name);
                    en: int64 <- flat_record_sum_nested_inners(term);
                    ia: int64 <- sa + en;
                    concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                end;
                false -> ""
            }
        end
    }
}

fn compute_inner_adj_bindings(term: SIRTerm, idx: int64, count: int64, cumulative_alloc: int64, total_nested: int64) -> string {
    case idx < count - 1 and term.kind == 6 and term.name == "tuple_make" of {
        true -> do
            elem: SIRTerm <- term.inner;
            eit: bool <- elem.kind == 6 and elem.name == "tuple_make";
            eta: int64 <- case eit of { true -> flat_tuple_total_alloc(elem); false -> 0 };
            nc: int64 <- cumulative_alloc + eta;
            binding: string <- case eit of {
                true -> do
                    sa: int64 <- total_nested - nc;
                    ec: int64 <- prims_tuple@count_flat_elements(elem);
                    en: int64 <- flat_tuple_nested_alloc(elem, ec, 0);
                    ia: int64 <- sa + en;
                    concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                end;
                false -> ""
            };
            rest: string <- compute_inner_adj_bindings(term.right_expr, idx + 1, count, nc, total_nested);
            concat(binding, rest)
        end;
        false -> do
            eit: bool <- term.kind == 6 and term.name == "tuple_make";
            eta: int64 <- case eit of { true -> flat_tuple_total_alloc(term); false -> 0 };
            nc: int64 <- cumulative_alloc + eta;
            case eit of {
                true -> do
                    sa: int64 <- total_nested - nc;
                    ec: int64 <- prims_tuple@count_flat_elements(term);
                    en: int64 <- flat_tuple_nested_alloc(term, ec, 0);
                    ia: int64 <- sa + en;
                    concat("|_adj.", concat(atom_table@int64_to_decimal_string(idx), concat("=", atom_table@int64_to_decimal_string(ia))))
                end;
                false -> ""
            }
        end
    }
}

// [SP,#off] or [Xn,#off] when store_base is non-empty (actor behavior sret buffer in X20).
fn tuple_flat_memref(store_base: string, offset: int64) -> string {
    case len(store_base) > 0 of {
        true -> do
            p: string <- concat("[", store_base);
            q: string <- concat(p, ", #");
            r: string <- concat(q, atom_table@int64_to_decimal_string(offset));
            concat(r, "]")
        end;
        false -> concat(concat("[SP, #", atom_table@int64_to_decimal_string(offset)), "]")
    }
}

// Multi-element tuples box float32: pointer slot at byte_cursor, value at byte_cursor+8 (consumer does LDR/LDR).
fn emit_flat_float32_boxed_pair(store_base: string, byte_cursor: int64, float_reg: string) -> string {
    val_off: int64 <- byte_cursor + 8;
    ptr_mr: string <- tuple_flat_memref(store_base, byte_cursor);
    val_mr: string <- tuple_flat_memref(store_base, val_off);
    add_ptr: string <- case len(store_base) > 0 of {
        true -> concat(concat(concat(concat(concat(concat("    ADD X10, ", store_base), ", #"), atom_table@int64_to_decimal_string(val_off)), "\n    STR X10, "), ptr_mr), "\n");
        false -> concat(concat(concat(concat("    ADD X10, SP, #", atom_table@int64_to_decimal_string(val_off)), "\n    STR X10, "), ptr_mr), "\n")
    };
    concat(add_ptr, concat(concat(concat(concat("    STR ", float_reg), ", "), val_mr), "\n"))
}

// Copy qword-aligned scalar fields from a stack record at src_reg into the flat tuple buffer (supervisor init:
// inline flags record so materialize sees strategy @+0, counts @+8/+16, list head @+24 — not a dangling stack pointer).
fn emit_reg_to_flat_qwords_memcpy_loop(i: int64, qwords: int64, src_reg: string, store_base: string, dest_base_off: int64) -> string {
    case i >= qwords of {
        true -> "";
        false -> do
            off: int64 <- i * 8;
            ld0: string <- concat("    LDR X12, [", src_reg);
            ld1: string <- concat(ld0, ", #");
            ld2: string <- concat(ld1, atom_table@int64_to_decimal_string(off));
            ld3: string <- concat(ld2, "]\n    STR X12, ");
            ld4: string <- concat(ld3, tuple_flat_memref(store_base, dest_base_off + off));
            ldr: string <- concat(ld4, "\n");
            concat(ldr, emit_reg_to_flat_qwords_memcpy_loop(i + 1, qwords, src_reg, store_base, dest_base_off))
        end
    }
}

// Walk tuple_make chain, emit each element value and store at [SP, ...] or [store_base, ...].
// byte_cursor = running offset for scalar fields (float32 in count>1 uses 16 bytes: ptr + value).
// idx/count/sp_adjust: legacy path for nested aggregate elements (idx*8 + sp_adjust).
// store_base: empty -> stack; non-empty -> sret / reply buffer register.
fn emit_flat_tuple_stores(term: SIRTerm, idx: int64, count: int64, sp_adjust: int64, byte_cursor: int64, store_base: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string {
    case idx < count - 1 and term.kind == 6 and term.name == "tuple_make" of {
        true -> do
            elem: SIRTerm <- term.inner;
            elem_is_agg: bool <- elem.kind == 6 and (elem.name == "tuple_make" or elem.name == "record_make");
            type_prefix: string <- reg_conventions@reg_prefix_for_type(elem.type_name);
            elem_prefix: string <- case elem_is_agg of {
                true -> "X";
                false -> case type_prefix == "X" and elem.kind == 0 and value_has_dot(elem.value) of {
                    true -> "D";
                    false -> type_prefix
                }
            };
            temp_reg: string <- concat(elem_prefix, "9");
            elem_asm: string <- case bound.debug of {
                true -> do term_to_asm_opt_bound_debug(elem, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                false -> term_to_asm_opt_bound(elem, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
            };
            nested_bytes: int64 <- case elem_is_agg of {
                true -> agg_alloc_inner(elem);
                false -> 0
            };
            new_adjust: int64 <- sp_adjust + nested_bytes;
            box_f32: bool <- count > 1 and elem_is_agg == false and reg_conventions@is_float32_type(elem.type_name);
            case box_f32 of {
                true -> do
                    store_asm: string <- emit_flat_float32_boxed_pair(store_base, byte_cursor, temp_reg);
                    rest_asm: string <- emit_flat_tuple_stores(term.right_expr, idx + 1, count, new_adjust, byte_cursor + 16, store_base, pools, bound);
                    concat(concat(elem_asm, concat("\n", store_asm)), rest_asm)
                end;
                false -> case elem_is_agg of {
                    true -> do
                        rec_flat: bool <- elem.kind == 6 and elem.name == "record_make" and idx == 0 and count >= 2;
                        case rec_flat of {
                            true -> do
                                rec_R: string <- elem.type_name;
                                rsz: int64 <- prims_record@record_type_value_flat_byte_size(rec_R);
                                qw: int64 <- rsz / 8;
                                rec_sp_round: int64 <- record_make_stack_alloc_size(rec_R);
                                dest_base: int64 <- case len(store_base) > 0 of {
                                    true -> byte_cursor;
                                    false -> byte_cursor + rec_sp_round
                                };
                                memcpy_asm: string <- emit_reg_to_flat_qwords_memcpy_loop(0, qw, temp_reg, store_base, dest_base);
                                next_bc: int64 <- byte_cursor + rsz;
                                restore_rec_sp: string <- concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(rec_sp_round), "\n"));
                                rest_asm: string <- emit_flat_tuple_stores(term.right_expr, idx + 1, count, new_adjust, next_bc, store_base, pools, bound);
                                concat(concat(elem_asm, concat("\n", memcpy_asm)), concat(concat("\n", restore_rec_sp), concat("\n", rest_asm)))
                            end;
                            false -> do
                                store_offset: int64 <- idx * 8 + new_adjust;
                                store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", tuple_flat_memref(store_base, store_offset))));
                                next_bc: int64 <- store_offset + 8;
                                rest_asm: string <- emit_flat_tuple_stores(term.right_expr, idx + 1, count, new_adjust, next_bc, store_base, pools, bound);
                                concat(concat(elem_asm, concat("\n", store_asm)), concat("\n", rest_asm))
                            end
                        }
                    end;
                    false -> do
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", tuple_flat_memref(store_base, byte_cursor))));
                        rest_asm: string <- emit_flat_tuple_stores(term.right_expr, idx + 1, count, new_adjust, byte_cursor + 8, store_base, pools, bound);
                        concat(concat(elem_asm, concat("\n", store_asm)), concat("\n", rest_asm))
                    end
                }
            }
        end;
        false -> do
            elem_is_agg: bool <- term.kind == 6 and (term.name == "tuple_make" or term.name == "record_make");
            type_prefix2: string <- reg_conventions@reg_prefix_for_type(term.type_name);
            elem_prefix: string <- case elem_is_agg of {
                true -> "X";
                false -> case type_prefix2 == "X" and term.kind == 0 and value_has_dot(term.value) of {
                    true -> "D";
                    false -> type_prefix2
                }
            };
            temp_reg: string <- concat(elem_prefix, "9");
            elem_asm: string <- case bound.debug of {
                true -> do term_to_asm_opt_bound_debug(term, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                false -> term_to_asm_opt_bound(term, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
            };
            nested_bytes: int64 <- case elem_is_agg of {
                true -> agg_alloc_inner(term);
                false -> 0
            };
            new_adjust: int64 <- sp_adjust + nested_bytes;
            box_f32_last: bool <- count > 1 and elem_is_agg == false and reg_conventions@is_float32_type(term.type_name);
            case box_f32_last of {
                true -> concat(elem_asm, concat("\n", emit_flat_float32_boxed_pair(store_base, byte_cursor, temp_reg)));
                false -> case elem_is_agg of {
                    true -> do
                        store_offset: int64 <- idx * 8 + new_adjust;
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", tuple_flat_memref(store_base, store_offset))));
                        concat(elem_asm, concat("\n", store_asm))
                    end;
                    false -> do
                        store_asm: string <- concat("    STR ", concat(temp_reg, concat(", ", tuple_flat_memref(store_base, byte_cursor))));
                        concat(elem_asm, concat("\n", store_asm))
                    end
                }
            }
        end
    }
}

// Total stack bytes allocated by a tuple_make tree (this tuple + all nested tuple elements).
fn flat_tuple_total_alloc(term: SIRTerm) -> int64 {
    case term.kind == 6 and term.name == "tuple_make" of {
        true -> do
            my_count: int64 <- prims_tuple@count_flat_elements(term);
            my_size: int64 <- tuple_make_rec_flat_outer_alloc_bytes(term, my_count);
            nested_raw: int64 <- flat_tuple_nested_alloc(term, my_count, 0);
            trim: int64 <- tuple_make_rec_flat_nested_trim_bytes(term, my_count);
            nested_adj: int64 <- case nested_raw >= trim of { true -> nested_raw - trim; false -> 0 };
            my_size + nested_adj
        end;
        false -> 0
    }
}

// True when emit_flat_tuple_stores memcpy-copies idx-0 record_make into the tuple outer slab (`rec_flat`, arity ≥ 2).
fn tuple_make_memcpy_record_flat_head(term: SIRTerm) -> bool {
    case term.kind == 6 of {
        false -> false;
        true -> case term.name != "tuple_make" of {
            true -> false;
            false -> do
                c: int64 <- prims_tuple@count_flat_elements(term);
                case c >= 2 of {
                    false -> false;
                    true -> term.inner.kind == 6 and term.inner.name == "record_make"
                }
            end
        }
    }
}


// True when emit_flat_tuple_stores uses memcpy for a scalar record at idx 0 (rec_flat tuple head).
fn tuple_make_scalar_rec_flat_first(term: SIRTerm, count: int64) -> bool {
    case count < 2 of {
        true -> false;
        false -> case term.kind == 6 and term.name == "tuple_make" of {
            true -> do
                first: SIRTerm <- term.inner;
                case first.kind == 6 and first.name == "record_make" of {
                    false -> false;
                    true -> prims_record@record_type_has_only_scalar_fields(first.type_name)
                }
            end;
            false -> false
        }
    }
}

// Outer SUB SP bytes for tuple_make: flat pairing slots, widened when (record_make, …) memcpy head needs more.
// emit_flat_tuple_stores uses memcpy for any idx-0 record_make when arity ≥ 2 (`rec_flat`). Supervisors_phase_e
// init tuples embed a `{ strategy: atom , … }` record — atoms are non–value-flat leaves, but emit still memcpy-copies rsz bytes.
fn tuple_make_rec_flat_outer_alloc_bytes(term: SIRTerm, count: int64) -> int64 {
    base: int64 <- prims_tuple@flat_alloc_size(count);
    case tuple_make_memcpy_record_flat_head(term) of {
        false -> base;
        true -> do
            rsz: int64 <- prims_record@record_type_value_flat_byte_size(term.inner.type_name);
            // Second field sits at byte offset rsz after memcpy; trailing slots are pointer-sized for flat tuple tails.
            need: int64 <- stack_alloc_round16(rsz + 8 * (count - 1));
            case need > base of { true -> need; false -> base }
        end
    }
}

fn tuple_make_rec_flat_nested_trim_bytes(term: SIRTerm, count: int64) -> int64 {
    case tuple_make_memcpy_record_flat_head(term) of {
        false -> 0;
        true -> record_make_stack_alloc_size(term.inner.type_name)
    }
}

fn agg_alloc_inner(inner: SIRTerm) -> int64 {
    case inner.kind == 6 and inner.name == "tuple_make" of {
        true -> flat_tuple_total_alloc(inner);
        false -> case inner.kind == 6 and inner.name == "record_make" of {
            true -> flat_record_total_alloc(inner);
            false -> 0
        }
    }
}

// Sum agg_alloc_inner along a record_make chain (nested tuple/record in each field). No mutual tail with flat_record_total_alloc.
// Used for nested_adjust (ADD dest, SP, #N) and let dealloc — includes nested makes that self-SUB and user-call padding.
fn flat_record_sum_nested_inners(term: SIRTerm) -> int64 {
    case term.kind == 6 and term.name == "record_make" of {
        false -> 0;
        true -> case prims_record@record_type_has_only_scalar_fields(term.type_name) of {
            true -> 0;
            false -> do
                // 2-element tuple fields are emitted inline in emit_flat_record_stores (no nested SUB).
                here: int64 <- case term.inner.kind == 6 and term.inner.name == "tuple_make" and prims_tuple@count_flat_elements(term.inner) == 2 of {
                    true -> 0;
                    false -> case term.inner.kind == 4 or term.inner.kind == 5 of {
                        true -> user_call_aggregate_return_alloc_bytes(term.inner.type_name);
                        false -> agg_alloc_inner(term.inner)
                    }
                };
                rest: int64 <- case term.right_expr.kind < 0 of {
                    true -> 0;
                    false -> flat_record_sum_nested_inners(term.right_expr)
                };
                here + rest
            end
        }
    }
}

// Bytes the outer record_make SUB must reserve below the shell: user-call aggregate returns that are
// memcpy'd into this frame (from_sorted_err). Nested record_make/tuple_make emit their own SUB —
// counting them here double-subtracts SP (structs_addition/04 hang).
fn flat_record_sum_nested_reserved_in_outer(term: SIRTerm) -> int64 {
    case term.kind == 6 and term.name == "record_make" of {
        false -> 0;
        true -> case prims_record@record_type_has_only_scalar_fields(term.type_name) of {
            true -> 0;
            false -> do
                here: int64 <- case term.inner.kind == 6 and term.inner.name == "tuple_make" and prims_tuple@count_flat_elements(term.inner) == 2 of {
                    true -> 0;
                    false -> case term.inner.kind == 4 or term.inner.kind == 5 of {
                        true -> user_call_aggregate_return_alloc_bytes(term.inner.type_name);
                        false -> 0
                    }
                };
                rest: int64 <- case term.right_expr.kind < 0 of {
                    true -> 0;
                    false -> flat_record_sum_nested_reserved_in_outer(term.right_expr)
                };
                here + rest
            end
        }
    }
}

fn record_field_user_call_inline_return(elem: SIRTerm, fty: string) -> bool {
    reg_conventions@is_inline_struct_type(fty) and (elem.kind == 4 or elem.kind == 5)
}

fn record_field_inline_pointer_value(elem: SIRTerm, fty: string) -> bool {
    case reg_conventions@is_inline_struct_type(fty) of {
        false -> false;
        true -> case elem.kind == 1 of {
            true -> true;
            false -> case elem.kind == 4 or elem.kind == 5 of {
                true -> true;
                false -> elem.kind == 6 and elem.name == "record_proj"
            }
        }
    }
}

fn record_field_nested_return_bytes(elem: SIRTerm, fty: string, elem_is_agg: bool) -> int64 {
    case elem_is_agg of {
        true -> agg_alloc_inner(elem);
        false -> case record_field_user_call_inline_return(elem, fty) of {
            true -> user_call_aggregate_return_alloc_bytes(fty);
            false -> 0
        }
    }
}

fn flat_record_total_alloc(term: SIRTerm) -> int64 {
    case term.kind == 6 and term.name == "record_make" of {
        true -> case prims_record@record_type_has_only_scalar_fields(term.type_name) of {
            true -> record_make_stack_alloc_size(term.type_name);
            false -> do
                my_count: int64 <- prims_record@count_record_fields(term.type_name);
                case my_count < 1 of {
                    true -> 0;
                    false -> do
                        my_size: int64 <- record_make_stack_alloc_size(term.type_name);
                        nested: int64 <- flat_record_sum_nested_inners(term);
                        my_size + nested
                    end
                }
            end
        };
        false -> 0
    }
}

// Walk record_make chain; R is the full inline record type string on each node.
// field_prefix: byte offset of this record's fields within an outer value-flat aggregate (trial 08 nested structs).
fn emit_flat_record_stores(term: SIRTerm, R: string, sp_adjust: int64, field_prefix: int64, store_base: string, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: bool }) -> string {
    case term.kind == 6 and term.name == "record_make" of {
        false -> "";
        true -> case term.right_expr.kind < 0 of {
            true -> do
                elem: SIRTerm <- term.inner;
                fname: string <- term.value;
                fty: string <- prims_record@find_field_type_in_record(R, fname);
                base_off: int64 <- prims_record@offset_bytes_before_field(R, fname);
                elem_is_agg: bool <- elem.kind == 6 and (elem.name == "tuple_make" or elem.name == "record_make");
                inline_scalar_rec: bool <- elem_is_agg and elem.name == "record_make" and prims_record@record_type_has_only_scalar_fields(fty);
                case inline_scalar_rec of {
                    true -> emit_flat_record_stores(elem, fty, sp_adjust, field_prefix + base_off, store_base, pools, bound);
                    false -> case elem.kind == 6 and elem.name == "tuple_make" and prims_tuple@count_flat_elements(elem) == 2 of {
                        true -> do
                            e0_sf: SIRTerm <- elem.inner;
                            e1w_sf: SIRTerm <- elem.right_expr;
                            e1_sf: SIRTerm <- case e1w_sf.kind == 6 and e1w_sf.name == "tuple_make" of {
                                true -> e1w_sf.inner;
                                false -> e1w_sf
                            };
                            a0_sf: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(e0_sf, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(e0_sf, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            off0_sf: int64 <- record_store_offset_for_field(R, fname, field_prefix, base_off, sp_adjust);
                            st0_sf: string <- concat("    STR X9, ", concat(tuple_flat_memref(store_base, off0_sf), "\n"));
                            a1_sf: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(e1_sf, "X10", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(e1_sf, "X10", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            off1_sf: int64 <- off0_sf + 8;
                            st1_sf: string <- concat("    STR X10, ", concat(tuple_flat_memref(store_base, off1_sf), "\n"));
                            concat(concat(concat(concat(a0_sf, "\n"), concat(st0_sf, concat(a1_sf, "\n"))), st1_sf), "\n")
                        end;
                        false -> do
                            type_prefix: string <- reg_conventions@reg_prefix_for_type(fty);
                            elem_prefix: string <- case elem_is_agg of {
                                true -> "X";
                                false -> case type_prefix == "X" and elem.kind == 0 and value_has_dot(elem.value) of {
                                    true -> "D";
                                    false -> type_prefix
                                }
                            };
                            temp_reg: string <- concat(elem_prefix, "9");
                            elem_asm: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(elem, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(elem, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            nested_bytes: int64 <- record_field_nested_return_bytes(elem, fty, elem_is_agg);
                            new_adjust: int64 <- sp_adjust + nested_bytes;
                            store_offset: int64 <- record_store_offset_for_field(R, fname, field_prefix, base_off, new_adjust);
                            copy_inline_struct_field: bool <- record_field_inline_pointer_value(elem, fty);
                            store_asm: string <- case copy_inline_struct_field of {
                                true -> emit_inline_record_field_copy_words(temp_reg, store_base, store_offset, 0, prims_record@record_type_value_flat_byte_size(fty) / 8);
                                false -> concat("    STR ", concat(temp_reg, concat(", ", tuple_flat_memref(store_base, store_offset))))
                            };
                            concat(elem_asm, concat("\n", store_asm))
                        end
                    }
                }
            end;
            false -> do
                elem: SIRTerm <- term.inner;
                fname: string <- term.value;
                fty: string <- prims_record@find_field_type_in_record(R, fname);
                base_off: int64 <- prims_record@offset_bytes_before_field(R, fname);
                elem_is_agg: bool <- elem.kind == 6 and (elem.name == "tuple_make" or elem.name == "record_make");
                inline_scalar_rec: bool <- elem_is_agg and elem.name == "record_make" and prims_record@record_type_has_only_scalar_fields(fty);
                case inline_scalar_rec of {
                    true -> do
                        inner_asm: string <- emit_flat_record_stores(elem, fty, sp_adjust, field_prefix + base_off, store_base, pools, bound);
                        rest_asm: string <- emit_flat_record_stores(term.right_expr, R, sp_adjust, field_prefix, store_base, pools, bound);
                        concat(concat(inner_asm, "\n"), rest_asm)
                    end;
                    false -> case elem.kind == 6 and elem.name == "tuple_make" and prims_tuple@count_flat_elements(elem) == 2 of {
                        true -> do
                            e0: SIRTerm <- elem.inner;
                            e1w: SIRTerm <- elem.right_expr;
                            e1: SIRTerm <- case e1w.kind == 6 and e1w.name == "tuple_make" of {
                                true -> e1w.inner;
                                false -> e1w
                            };
                            a0: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(e0, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(e0, "X9", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            off0: int64 <- record_store_offset_for_field(R, fname, field_prefix, base_off, sp_adjust);
                            st0: string <- concat("    STR X9, ", concat(tuple_flat_memref(store_base, off0), "\n"));
                            a1: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(e1, "X10", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(e1, "X10", pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            off1: int64 <- off0 + 8;
                            st1: string <- concat("    STR X10, ", concat(tuple_flat_memref(store_base, off1), "\n"));
                            pair_asm: string <- concat(concat(concat(concat(a0, "\n"), concat(st0, concat(a1, "\n"))), st1), "\n");
                            rest_asm: string <- emit_flat_record_stores(term.right_expr, R, sp_adjust, field_prefix, store_base, pools, bound);
                            concat(pair_asm, rest_asm)
                        end;
                        false -> do
                            type_prefix: string <- reg_conventions@reg_prefix_for_type(fty);
                            elem_prefix: string <- case elem_is_agg of {
                                true -> "X";
                                false -> case type_prefix == "X" and elem.kind == 0 and value_has_dot(elem.value) of {
                                    true -> "D";
                                    false -> type_prefix
                                }
                            };
                            temp_reg: string <- concat(elem_prefix, "9");
                            elem_asm: string <- case bound.debug of {
                                true -> do term_to_asm_opt_bound_debug(elem, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) end;
                                false -> term_to_asm_opt_bound(elem, temp_reg, pools, { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                            };
                            nested_bytes: int64 <- record_field_nested_return_bytes(elem, fty, elem_is_agg);
                            new_adjust: int64 <- sp_adjust + nested_bytes;
                            store_offset: int64 <- record_store_offset_for_field(R, fname, field_prefix, base_off, new_adjust);
                            copy_inline_struct_field: bool <- record_field_inline_pointer_value(elem, fty);
                            store_asm: string <- case copy_inline_struct_field of {
                                true -> emit_inline_record_field_copy_words(temp_reg, store_base, store_offset, 0, prims_record@record_type_value_flat_byte_size(fty) / 8);
                                false -> concat("    STR ", concat(temp_reg, concat(", ", tuple_flat_memref(store_base, store_offset))))
                            };
                            rest_asm: string <- emit_flat_record_stores(term.right_expr, R, new_adjust, field_prefix, store_base, pools, bound);
                            concat(concat(elem_asm, concat("\n", store_asm)), concat("\n", rest_asm))
                        end
                    }
                }
            end
        }
    }
}

// Darwin AAPCS64: SP must be 16-byte aligned at BL boundaries; round stack slots up.
fn stack_alloc_round16(nbytes: int64) -> int64 {
    (nbytes + 15) / 16 * 16
}

// Sum nested tuple element allocations within a tuple_make chain of `count` elements.
fn flat_tuple_nested_alloc(term: SIRTerm, remaining: int64, acc: int64) -> int64 {
    case remaining <= 1 of {
        true -> case term.kind == 6 and term.name == "tuple_make" of {
            true -> acc + flat_tuple_total_alloc(term);
            false -> case term.kind == 6 and term.name == "record_make" of {
                true -> acc + flat_record_total_alloc(term);
                false -> acc
            }
        };
        false -> case term.kind == 6 and term.name == "tuple_make" of {
            true -> do
                elem_bytes: int64 <- agg_alloc_inner(term.inner);
                flat_tuple_nested_alloc(term.right_expr, remaining - 1, acc + elem_bytes)
            end;
            false -> acc
        }
    }
}

fn flat_tuple_dealloc_size(term: SIRTerm) -> int64 {
    case term.kind == 6 and term.name == "record_make" of {
        true -> flat_record_total_alloc(term);
        false -> flat_tuple_total_alloc(term)
    }
}

// Stack bytes for let dealloc: tuple_make/record_make use flat layout on caller SP.
// Tuple-returning user calls: caller SUB/MOV X8 is paired in let emission (see base_stack_n),
// not here — case-branch bare calls use pass-through X8 and must stay at 0 (wbt weight_subtree).
// Record-returning user calls heap-promote in the callee — no caller sret slab.
fn aggregate_callee_return_stack_bytes(rhs: SIRTerm) -> int64 {
    case reg_conventions@is_aggregate_struct_or_tuple_return_type(rhs.type_name) of {
        false -> 0;
        true -> case rhs.kind == 6 and (rhs.name == "tuple_make" or rhs.name == "record_make") of {
            true -> flat_tuple_dealloc_size(rhs);
            false -> case rhs.kind == 6 and prims_checked_int64@is_checked_int64_prim(rhs.name) of {
                true -> 16;
                false -> 0
            }
        }
    }
}

// Caller sret slab for a let-bound tuple-returning user call (paired with sret_alloc_bytes in
// emit_generic_user_call_asm_inner). Zero for pass-through / non-tuple.
fn let_user_call_tuple_sret_stack_bytes(rhs: SIRTerm) -> int64 {
    case (rhs.kind == 4 or rhs.kind == 5) and reg_conventions@is_tuple_type(rhs.type_name) of {
        true -> user_call_aggregate_return_alloc_bytes(rhs.type_name);
        false -> 0
    }
}

// Sequence/lowering nests lets (child; children; produces tuple). The terminal tuple_make is in
// right_expr of the innermost let; count its stack slab for outer let dealloc (see supervisors e4a init).
fn let_tail_aggregate_stack_bytes(tail: SIRTerm) -> int64 {
    case tail.kind == 2 of {
        true -> let_tail_aggregate_stack_bytes(tail.right_expr);
        false -> case tail.kind == 6 and (tail.name == "record_make" or tail.name == "tuple_make") and reg_conventions@is_aggregate_struct_or_tuple_return_type(tail.type_name) of {
            true -> flat_tuple_dealloc_size(tail);
            false -> 0
        }
    }
}

fn deepest_let_chain_leaf(term: SIRTerm) -> {
    case term.kind == 2 of {
        true -> deepest_let_chain_leaf(term.right_expr);
        false -> term
    }
}

fn let_chain_has_later_record_make_rhs(term: SIRTerm) -> bool {
    case term.kind == 2 of {
        false -> false;
        true -> case term.inner.kind == 6 and term.inner.name == "record_make" of {
            true -> true;
            false -> let_chain_has_later_record_make_rhs(term.right_expr)
        }
    }
}

// RHS stack record + nested lets → rec_flat tuple: leaf teardown + widen accounts for tuple slab; a full parent's
// base_stack ADD would double-pop (#48 duplicate). Omitting it entirely leaves SP 16 B low before callee LDP — use +16 fixup.
// Uses tuple_make_memcpy_record_flat_head (defined above).

fn let_suppress_base_stack_overlay_rec_flat(term: SIRTerm, base_stack: int64) -> bool {
    case term.right_expr.kind == 2 and base_stack > 0 of {
        false -> false;
        true -> do
            leaf: SIRTerm <- deepest_let_chain_leaf(term.right_expr);
            case let_chain_has_later_record_make_rhs(term.right_expr) of {
                true -> false;
                false -> tuple_make_memcpy_record_flat_head(leaf)
            }
        end
    }
}

fn let_suppressed_base_stack_fixup(term: SIRTerm) -> int64 {
    case term.inner.kind == 6 and term.inner.name == "record_make" and is_child_spec_record_type(term.inner.type_name) of {
        true -> record_make_stack_alloc_size(term.inner.type_name);
        false -> 16
    }
}

// Outermost aggregate type for record_proj chains rooted at a variable (value-flat substruct address; trial 04).
fn record_proj_root_record_type(term: SIRTerm) -> string {
    case term.kind == 6 and term.name == "record_proj" of {
        false -> "";
        true -> case term.inner.kind == 1 of {
            true -> term.inner.type_name;
            false -> case term.inner.kind == 6 and term.inner.name == "record_proj" of {
                true -> record_proj_root_record_type(term.inner);
                false -> ""
            }
        }
    }
}

// s.end.x lowers to record_proj(x, inner: record_proj(end, inner: var s)) — resolve root var and full byte offset.
fn record_proj_chain_root_var_name(term: SIRTerm) -> string {
    case term.kind == 6 and term.name == "record_proj" of {
        false -> "";
        true -> case term.inner.kind == 1 of {
            true -> term.inner.name;
            false -> case term.inner.kind == 6 and term.inner.name == "record_proj" of {
                true -> record_proj_chain_root_var_name(term.inner);
                false -> ""
            }
        }
    }
}

fn record_proj_chain_byte_offset(term: SIRTerm) -> int64 {
    case term.kind == 6 and term.name == "record_proj" of {
        false -> 0;
        true -> case term.inner.kind == 1 of {
            true -> prims_record@offset_bytes_before_field(term.inner.type_name, term.value);
            false -> case term.inner.kind == 6 and term.inner.name == "record_proj" of {
                true -> do
                    pre: int64 <- record_proj_chain_byte_offset(term.inner);
                    here: int64 <- prims_record@offset_bytes_before_field(term.inner.type_name, term.value);
                    pre + here
                end;
                false -> 0
            }
        }
    }
}

fn aggregate_heap_copy_words_unrolled(word_idx: int64, words: int64) -> string {
    case word_idx >= words of {
        true -> "";
        false -> do
            off: int64 <- word_idx * 8;
            pair: string <- concat(concat(concat(concat("    LDR X3, [X1, #", atom_table@int64_to_decimal_string(off)), "]\n    STR X3, [X4, #"), atom_table@int64_to_decimal_string(off)), "]\n");
            concat(pair, aggregate_heap_copy_words_unrolled(word_idx + 1, words))
        end
    }
}

fn emit_inline_record_field_copy_words(src_reg: string, store_base: string, dest_off: int64, word_idx: int64, words: int64) -> string {
    case word_idx >= words of {
        true -> "";
        false -> do
            off: int64 <- word_idx * 8;
            dst: string <- tuple_flat_memref(store_base, dest_off + off);
            one: string <- concat(concat(concat(concat("    LDR X10, [", src_reg), concat(", #", atom_table@int64_to_decimal_string(off))), "]\n    STR X10, "), concat(dst, "\n"));
            concat(one, emit_inline_record_field_copy_words(src_reg, store_base, dest_off, word_idx + 1, words))
        end
    }
}

// After a stack-built aggregate is returned in X0, copy it to the heap before ADD SP
// dealloc so the caller keeps a valid pointer. X0 holds the source pointer on entry.
fn aggregate_return_heap_promote_x0(nbytes: int64) -> string {
    case nbytes <= 0 of {
        true -> "";
        false -> do
            words: int64 <- nbytes / 8;
            case words <= 0 of {
                true -> "";
                false -> do
                    copy_asm: string <- aggregate_heap_copy_words_unrolled(0, words);
                    concat(concat(concat(concat("    SUB SP, SP, #16\n    STR X0, [SP, #8]\n    MOV X0, #", atom_table@int64_to_decimal_string(nbytes)), "\n    BL _silica_rt_region_alloc\n    MOV X4, X0\n    LDR X1, [SP, #8]\n"), copy_asm), "    MOV X0, X4\n    ADD SP, SP, #16\n")
                end
            }
        end
    }
}
