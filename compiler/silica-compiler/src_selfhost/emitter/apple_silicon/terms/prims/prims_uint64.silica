// uint64 (unsigned) prim emission: add, sub, mul, div, rem, lt, gt, le, ge, eq, ne, and, or, bor, band, bnot, shl, shr
// X registers, UDIV/UREM, unsigned comparison

use sir_ast;
use arithmetic;
use comparison;
use logical;
use bitwise;

export emit_prim_op/2;

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    case term.name of {
        "add" -> arithmetic@emit_add_op(dest, "X");
        "sub" -> arithmetic@emit_sub_op(dest, "X");
        "mul" -> arithmetic@emit_mul_op(dest, "X");
        "div" -> arithmetic@emit_udiv_op(dest, "X");
        "rem" -> arithmetic@emit_urem_op(dest, "X");
        "lt" -> comparison@emit_ult_op(dest, "X");
        "gt" -> comparison@emit_ugt_op(dest, "X");
        "le" -> comparison@emit_ule_op(dest, "X");
        "ge" -> comparison@emit_uge_op(dest, "X");
        "eq" -> comparison@emit_eq_op(dest, "X");
        "nq" -> comparison@emit_ne_op(dest, "X");
        "and" -> logical@emit_and_op(dest, "X");
        "or" -> logical@emit_or_op(dest, "X");
        "bor" -> bitwise@emit_bor_op(dest, "X");
        "band" -> bitwise@emit_band_op(dest, "X");
        "bnot" -> bitwise@emit_bnot_op(dest, "X");
        "shl" -> bitwise@emit_shl_op(dest, "X");
        "shr" -> bitwise@emit_shr_op(dest, "X");
        _: string -> concat("    ; unsupported uint64 prim: ", term.name)
    }
}
