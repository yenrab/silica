// Let dispatcher: compute rhs_reg by sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name
// Delegates to type-specific modules for register allocation

use let_float64;
use let_float32;
use let_float16;
use let_int64;
use let_narrow;
use let_tuple;
use reg_conventions;
use var;

export compute_rhs_reg_in_let/5;
export compute_rhs_reg_top_level/3;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    case nodes.is_nil of {
        true -> 0;
        false -> 1 + sir_term_nodes_len(nodes.tail)
    }
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx <= 0 of {
        true -> nodes.head;
        false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
    }
}

fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    n: int64 <- sir_term_nodes_len(nodes);
    sir_term_node_at_from_head(nodes, n - 1 - idx)
}

fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    sir_term_node_at(term.nodes, term.root)
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

// Lifted lambda / fn refs in let RHS lower to kind 0 `fn_ptr` (sir_generator expr_to_sir_with_expected),
// not a `fn(...)` type string. Treat like function values: materialize in dest (typically X0), never
// the int64 top-level X1 scratch — X1 may hold closure captures passed at call time.
fn let_rhs_is_fn_pointer_materialization(type_name: string) -> bool {
    case type_name == "fn_ptr" of {
        true -> true;
        false -> var@type_name_is_function(type_name)
    }
}

fn compute_rhs_reg_in_let(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound_name: string, bound_reg: string, outer_reg: string) -> string {
    case reg_conventions@is_tuple_type(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name) of {
        true -> let_tuple@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        false -> case let_rhs_is_fn_pointer_materialization(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name) of {
            true -> dest;
            false -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name of {
        "atom" -> dest;
        "float64" -> let_float64@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        "float32" -> let_float32@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        "float16" -> let_float16@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        "int64" -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).kind == 0 and dest == "X0" of {
            true -> case bound_reg == "X1" of {
                true -> "X2";
                false -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).kind == 4 of {
                    true -> dest;
                    false -> "X1"
                }
            };
            false -> let_int64@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg)
        };
        "uint64" -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).kind == 0 and dest == "X0" of {
            true -> case bound_reg == "X1" of {
                true -> "X2";
                false -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).right_expr)).kind == 4 of {
                    true -> dest;
                    false -> "X1"
                }
            };
            false -> let_int64@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg)
        };
        "int32" -> let_narrow@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        "int16" -> let_narrow@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        "int8" -> let_narrow@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        "uint32" -> let_narrow@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        "uint16" -> let_narrow@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        "uint8" -> let_narrow@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg);
        // and/or load operands into X9/X10; logical@emit_and_op uses dest for AND/CMP/CSET. When the let
        // result is ultimately in X0, use X0 directly instead of a higher scratch (e.g. X3) + MOV.
        "bool" -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).kind == 6 and (sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).name == "and" or sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).name == "or") and dest == "X0" of {
            true -> "X0";
            false -> let_int64@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg)
        };
        _: string -> let_int64@compute_rhs_reg_in_let(term, dest, bound_name, bound_reg, outer_reg)
            }
        }
    }
}

fn compute_rhs_reg_top_level(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, bound_reg: string, dest: string) -> string {
    case reg_conventions@is_tuple_type(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name) of {
        true -> let_tuple@compute_rhs_reg_top_level(term, bound_reg, dest);
        false -> case let_rhs_is_fn_pointer_materialization(sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name) of {
            true -> dest;
            false -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name of {
        "atom" -> dest;
        "float64" -> let_float64@compute_rhs_reg_top_level(term, bound_reg, dest);
        "float32" -> let_float32@compute_rhs_reg_top_level(term, bound_reg, dest);
        "float16" -> let_float16@compute_rhs_reg_top_level(term, bound_reg, dest);
        "int64" -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).kind == 0 and dest == "X0" of {
            true -> "X1";
            false -> let_int64@compute_rhs_reg_top_level(term, bound_reg, dest)
        };
        "uint64" -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).kind == 0 and dest == "X0" of {
            true -> "X1";
            false -> let_int64@compute_rhs_reg_top_level(term, bound_reg, dest)
        };
        "int32" -> let_narrow@compute_rhs_reg_top_level(term, bound_reg, dest);
        "int16" -> let_narrow@compute_rhs_reg_top_level(term, bound_reg, dest);
        "int8" -> let_narrow@compute_rhs_reg_top_level(term, bound_reg, dest);
        "uint32" -> let_narrow@compute_rhs_reg_top_level(term, bound_reg, dest);
        "uint16" -> let_narrow@compute_rhs_reg_top_level(term, bound_reg, dest);
        "uint8" -> let_narrow@compute_rhs_reg_top_level(term, bound_reg, dest);
        _: string -> let_int64@compute_rhs_reg_top_level(term, bound_reg, dest)
            }
        }
    }
}
