// Narrow int let: rhs_reg for int32, int16, int8, uint32, uint16, uint8
// W registers. Complex logic for call/let structure.

use sir_ast;

export compute_rhs_reg_in_let/5;
export compute_rhs_reg_top_level/3;

fn compute_rhs_reg_in_let(term: SIRTerm, dest: string, bound_name: string, bound_reg: string, outer_reg: string) -> string {
    case term.inner.kind != 0 and (term.right_expr.kind == 4 or (term.right_expr.kind == 1 and term.right_expr.name == term.name)) of {
        true -> dest;
        false -> case term.right_expr.kind == 4 of {
            true -> case term.right_expr.inner.kind == 6 and term.right_expr.inner.right_expr.kind == 1 and term.right_expr.inner.right_expr.name == term.name of {
                true -> "W2";
                false -> case term.right_expr.inner.kind == 6 and term.right_expr.inner.inner.kind == 1 and term.right_expr.inner.inner.name == term.name of {
                    true -> "W1";
                    false -> case bound_reg == "X0" of {
                        true -> case term.name == "%_" of { true -> "W0"; false -> "W1" };
                        false -> case bound_reg == "X1" of {
                            true -> "W2";
                            false -> case bound_reg == "W0" of {
                                true -> case term.name == "%_" of { true -> "W0"; false -> "W1" };
                                false -> case bound_reg == "W1" of { true -> "W2"; false -> "W0" }
                            }
                        }
                    }
                }
            };
            false -> case term.right_expr.kind == 2 of {
                true -> case term.right_expr.right_expr.kind == 4 and term.right_expr.right_expr.inner.kind == 6 and term.right_expr.right_expr.inner.inner.kind == 1 and term.right_expr.right_expr.inner.inner.name == term.name of {
                    true -> "W1";
                    false -> case bound_reg == "X0" of {
                        true -> case term.name == "%_" of { true -> "W0"; false -> "W1" };
                        false -> case bound_reg == "X1" of {
                            true -> "W2";
                            false -> case bound_reg == "W0" of {
                                true -> case term.name == "%_" of { true -> "W0"; false -> "W1" };
                                false -> case bound_reg == "W1" of { true -> "W2"; false -> "W0" }
                            }
                        }
                    }
                };
                false -> case bound_reg == "X0" of {
                    true -> case term.name == "%_" of { true -> "W0"; false -> "W1" };
                    false -> case bound_reg == "X1" of {
                        true -> "W2";
                        false -> case bound_reg == "W0" of {
                            true -> case term.name == "%_" of { true -> "W0"; false -> "W1" };
                            false -> case bound_reg == "W1" of { true -> "W2"; false -> "W0" }
                        }
                    }
                }
            }
        }
    }
}

fn compute_rhs_reg_top_level(term: SIRTerm, bound_reg: string, dest: string) -> string {
    case bound_reg == "" of {
        true -> "W1";
        false -> case bound_reg == "X1" of {
            true -> case term.right_expr.kind == 2 of {
                true -> case term.right_expr.right_expr.kind == 4 and term.right_expr.right_expr.inner.kind == 6 and term.right_expr.right_expr.inner.inner.kind == 1 and term.right_expr.right_expr.inner.inner.name == term.name of {
                    true -> "W1";
                    false -> "W0"
                };
                false -> "W0"
            };
            false -> "W0"
        }
    }
}
