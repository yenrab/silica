// Inline emission for print_float16. The argument arrives in H0.
// The helper widens to S0, handles NaN/Inf spellings, and delegates finite values to L_pf32_helper.

use sir_ast;
use atom_table;
use emitter_effects;

export emit_print_float16_var/3;
export emit_print_float16_helper/0;

fn emit_print_float16_var(term: SIRTerm, dest: string, _table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    body: string <- concat(comment_line, "    BL L_pf16_helper\n");
    mov_ret: string <- concat(concat("    MOV ", dest), ", #0\n");
    with_ret: string <- concat(body, mov_ret);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    }
}

fn emit_print_float16_helper() -> string {
    "L_pf16_helper:\n    STR Q0, [SP, #-16]!\n    STR Q1, [SP, #-16]!\n    STR Q2, [SP, #-16]!\n    STR X30, [SP, #-16]!\n    FCVT S0, H0\n    FCMP S0, S0\n    B.vs L_pf16_nan\n    FABS S1, S0\n    MOV W8, #0\n    MOVK W8, #0x7F80, LSL #16\n    FMOV S2, W8\n    FCMP S1, S2\n    B.eq L_pf16_inf\n    BL L_pf32_helper\n    B L_pf16_restore\nL_pf16_nan:\n    MOV X0, #1\n    ADRP X1, L_pf16_nan_str@PAGE\n    ADD X1, X1, L_pf16_nan_str@PAGEOFF\n    MOV X2, #3\n    MOV X16, #4\n    SVC #0x80\n    B L_pf16_restore\nL_pf16_inf:\n    FCMP S0, #0.0\n    B.mi L_pf16_neg_inf\n    MOV X0, #1\n    ADRP X1, L_pf16_inf_str@PAGE\n    ADD X1, X1, L_pf16_inf_str@PAGEOFF\n    MOV X2, #3\n    MOV X16, #4\n    SVC #0x80\n    B L_pf16_restore\nL_pf16_neg_inf:\n    MOV X0, #1\n    ADRP X1, L_pf16_neg_inf_str@PAGE\n    ADD X1, X1, L_pf16_neg_inf_str@PAGEOFF\n    MOV X2, #4\n    MOV X16, #4\n    SVC #0x80\nL_pf16_restore:\n    LDR X30, [SP], #16\n    LDR Q2, [SP], #16\n    LDR Q1, [SP], #16\n    LDR Q0, [SP], #16\n    RET"
}
