// User-call staging predicates and helpers (non-recursive with the term dispatcher).

use atom_table;
use var;
use term_sir_helpers;
use term_user_call_abi;

export term_subterm_has_user_call/1;
export call_arg2_tree_for_gpr_reorder_scan/1;
export simple_gpr_call_arg_can_stage/2;
export simple_gpr_rest_can_stage/2;
export simple_gpr_call_arg_count/1;
export emit_simple_gpr_stage_loads/2;

fn term_subterm_has_user_call(t: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> bool {
    case t.root < 0 of {
        true -> false;
        false -> case term_sir_helpers@sir_term_root_node(t).kind of {
            4 -> true;
            2 -> case term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).inner)) of {
                true -> true;
                false -> term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).right_expr))
            };
            3 -> case term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).inner)) of {
                true -> true;
                false -> term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).right_expr))
            };
            5 -> case term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).inner)) of {
                true -> true;
                false -> term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).right_expr))
            };
            6 -> case term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).inner)) of {
                true -> true;
                false -> term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).right_expr))
            };
            7 -> case term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).inner)) of {
                true -> true;
                false -> term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).right_expr))
            };
            8 -> case term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).inner)) of {
                true -> true;
                false -> term_subterm_has_user_call(term_sir_helpers@sir_term_at(t, term_sir_helpers@sir_term_root_node(t).right_expr))
            };
            _: int64 -> false
        }
    }
}

fn call_arg2_tree_for_gpr_reorder_scan(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name == "user_call_rest" of {
        true -> term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).inner);
        false -> term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)
    }
}

fn simple_gpr_call_arg_can_stage(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string) -> bool {
    case term_user_call_abi@user_call_arg_consumes_fp(term_sir_helpers@sir_term_root_node(term).type_name) of {
        true -> false;
        false -> case term_sir_helpers@sir_term_root_node(term).kind == 0 of {
            true -> true;
            false -> case term_sir_helpers@sir_term_root_node(term).kind == 1 of {
                false -> false;
                true -> {
                    binding: string <- var@find_sp_binding_bare_or_percent_param(outer_reg, term_sir_helpers@sir_term_root_node(term).name);
                    case len(binding) > 0 of {
                        true -> var@is_memory_ref(binding) == false;
                        false -> var@type_name_is_function(term_sir_helpers@sir_term_root_node(term).type_name)
                    }
                }
            }
        }
    }
}

fn simple_gpr_rest_can_stage(rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, outer_reg: string) -> bool {
    case rest.root < 0 of {
        true -> true;
        false -> case term_sir_helpers@sir_term_root_node(rest).name == "user_call_rest" of {
            true -> case simple_gpr_call_arg_can_stage(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).inner), outer_reg) of {
                false -> false;
                true -> simple_gpr_rest_can_stage(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr), outer_reg)
            };
            false -> simple_gpr_call_arg_can_stage(rest, outer_reg)
        }
    }
}

fn simple_gpr_call_arg_count(rest: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> int64 {
    case rest.root < 0 of {
        true -> 0;
        false -> case term_sir_helpers@sir_term_root_node(rest).name == "user_call_rest" of {
            true -> 1 + simple_gpr_call_arg_count(term_sir_helpers@sir_term_at(rest, term_sir_helpers@sir_term_root_node(rest).right_expr));
            false -> 1
        }
    }
}

fn emit_simple_gpr_stage_loads(arg_index: int64, arg_count: int64) -> string {
    case arg_index >= arg_count of {
        true -> "";
        false -> {
            offset: string <- atom_table@int64_to_decimal_string((arg_count - arg_index - 1) * 16);
            reg: string <- term_user_call_abi@user_call_abi_reg_digit(arg_index);
            load: string <- concat(concat(concat("    LDR X", reg), ", [SP, #"), concat(offset, "]\n"));
            concat(load, emit_simple_gpr_stage_loads(arg_index + 1, arg_count))
        }
    }
}

// A call whose arguments are register-resident scalar/function values is a
// parallel move, not a sequence of destructive MOVs. Stage every source before
// loading any ABI destination so cycles and fan-out (X0->X2 while X0 is also a
// destination) are correct for any argument count supported by X0-X7.

