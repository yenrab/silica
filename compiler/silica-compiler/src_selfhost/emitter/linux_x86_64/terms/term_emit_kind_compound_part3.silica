// Compound kind emission part3 (open-recursive via emit_child).

use atom_table;
use var;
use prims;
use prims_actors;
use term_aggregate_helpers;
use term_sir_helpers;
use term_emit_kind_compound_compare;
use term_user_call_helpers;
use x86_mem;
use x86_isa;

export emit_kind_compound_part3/5;

fn emit_kind_compound_part3(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, bound: { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }, pools: { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, emit_child: fn({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, string, { table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int64_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int16_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, int8_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, string_literal_table: { is_empty: boolean, values: List[string, mem(normal)] } }, { bound_name: string, bound_reg: string, outer_reg: string, debug: boolean }) -> string) -> string {
case prims_actors@is_actor_prim(term_sir_helpers@sir_term_root_node(term).name) of {
    true -> case prims_actors@actor_prim_is_nullary(term_sir_helpers@sir_term_root_node(term).name) of {
                                true -> prims_actors@emit_prim_op(term, dest);
                                false -> case prims_actors@actor_prim_is_unary(term_sir_helpers@sir_term_root_node(term).name) of {
                                    true -> {
                                        arg_asm_u: string <- case bound.debug of {
                                            true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                            false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                        };
                                        op_asm_u: string <- prims_actors@emit_prim_op(term, dest);
                                        // Phase E e3b2/e4b: actor prim arg may be a record_make / tuple_make literal that did
                                        // SUB SP, SP, #N (e.g. start_child(spec_literal)). Restore SP after the runtime call so
                                        // the surrounding behavior fn's saved-register restore (LDP) reads the correct stack slots.
                                        unary_sp_bytes: int64 <- term_aggregate_helpers@flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                                        unary_sp_restore: string <- case unary_sp_bytes > 0 of {
                                            true -> concat("\n", x86_isa@x86_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(unary_sp_bytes))));
                                            false -> ""
                                        };
                                        concat(concat(arg_asm_u, "\n"), concat(op_asm_u, unary_sp_restore))
                                    };
                                    false -> case prims_actors@actor_prim_is_ternary(term_sir_helpers@sir_term_root_node(term).name) of {
                                        true -> {
                                            left_asm_3: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            hold_actor_3: string <- x86_isa@x86_mov("X11", "X9");
                                            right_asm_3: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            tuple_bytes_3: int64 <- case length_bytes(var@find_sp_binding(bound.outer_reg, "_tuple_sret")) > 0 of {
                                                true -> 0;
                                                false -> term_aggregate_helpers@flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
                                            };
                                            op_asm_3: string <- prims_actors@emit_prim_op(term, dest);
                                            tuple_sp_restore_3: string <- case tuple_bytes_3 > 0 of {
                                                true -> x86_isa@x86_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(tuple_bytes_3)));
                                                false -> ""
                                            };
                                            concat(concat(concat(concat(concat(concat(left_asm_3, "\n"), hold_actor_3), concat(right_asm_3, "\n")), op_asm_3), "\n"), tuple_sp_restore_3)
                                        };
                                        false -> {
                                            left_asm_a: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X9", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            spawn_three: boolean <- (term_sir_helpers@sir_term_root_node(term).name == "spawn" or term_sir_helpers@sir_term_root_node(term).name == "spawn_dangerous" or term_sir_helpers@sir_term_root_node(term).name == "spawn_linked") and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name == "tuple_make";
                                            spawn_registered_tuple: boolean <- (term_sir_helpers@sir_term_root_node(term).name == "spawn_registered" or term_sir_helpers@sir_term_root_node(term).name == "spawn_dangerous_registered" or term_sir_helpers@sir_term_root_node(term).name == "spawn_registered_supervisor") and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name == "tuple_make";
                                            actor_msg_binary: boolean <- term_sir_helpers@sir_term_root_node(term).name == "send" or term_sir_helpers@sir_term_root_node(term).name == "actor_call" or term_sir_helpers@sir_term_root_node(term).name == "actor_call_registered" or term_sir_helpers@sir_term_root_node(term).name == "actor_cast" or term_sir_helpers@sir_term_root_node(term).name == "actor_cast_registered" or term_sir_helpers@sir_term_root_node(term).name == "actor_cast_dangerous_registered" or term_sir_helpers@sir_term_root_node(term).name == "supervisor_add_child";
                                            init_hold_spawn: string <- case spawn_three or spawn_registered_tuple or actor_msg_binary of { true -> x86_isa@x86_mov("X11", "X9"); false -> "" };
                                            right_asm_a: string <- case bound.debug of {
                                                true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                                false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr),  "X10", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                            };
                                            tuple_bytes_a: int64 <- case length_bytes(var@find_sp_binding(bound.outer_reg, "_tuple_sret")) > 0 of {
                                                true -> 0;
                                                false -> term_aggregate_helpers@flat_tuple_dealloc_size(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
                                            };
                                            // Every binary runtime prim reads its first operand back from X9 (prims_actors@
                                            // emit_runtime_binary: migrate_actor, pin_actor_to_core, set_actor_priority, add_child,
                                            // supervisor_get_child, ...). A computed right operand -- a prim staging its own left
                                            // operand, a let/case/tail call, or anything holding a user call -- goes through X9 on
                                            // its way to X10, so the actor_ref staged there is lost: migrate_actor(ref, 1 + i % 2)
                                            // handed the runtime 1 as the actor (actors_addition/migrate_actor_expression_core).
                                            // Hold X9 across the right operand the way term_emit_kind_compound_compare holds its
                                            // left operand across a call/complex right: a STR/LDR pair on SP. The spawn and message
                                            // prims keep their X11 hold, and a right operand that leaves a tuple on SP
                                            // (tuple_bytes_a > 0) cannot be bracketed this way.
                                            right_kind_a: int64 <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind;
                                            right_computed_a: boolean <- right_kind_a == 2 or right_kind_a == 3 or right_kind_a == 4 or right_kind_a == 5 or right_kind_a == 6 or term_user_call_helpers@term_subterm_has_user_call(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr));
                                            hold_left_a: boolean <- length_bytes(init_hold_spawn) == 0 and right_computed_a and tuple_bytes_a == 0;
                                            save_left_a: string <- case hold_left_a of { true -> x86_mem@x86_str("X9", "[SP, #-16]!"); false -> "" };
                                            restore_left_a: string <- case hold_left_a of { true -> x86_mem@x86_ldr("X9", "[SP], #16"); false -> "" };
                                            op_asm_a: string <- prims_actors@emit_prim_op(term, dest);
                                            tuple_sp_restore_a: string <- case tuple_bytes_a > 0 of {
                                                true -> x86_isa@x86_add("SP", "SP", concat("#", atom_table@int64_to_decimal_string(tuple_bytes_a)));
                                                false -> ""
                                            };
                                            concat(concat(concat(concat(concat(concat(left_asm_a, "\n"), init_hold_spawn), concat(save_left_a, concat(right_asm_a, concat("\n", restore_left_a)))), op_asm_a), "\n"), tuple_sp_restore_a)
                                        }
                                    }
                                }
                            };
    false -> case term_sir_helpers@sir_term_root_node(term).type_name == "int64" and (term_sir_helpers@sir_term_root_node(term).name == "string_length_bytes" or term_sir_helpers@sir_term_root_node(term).name == "string_length_chars") of {
    true -> {
                                arg_asm: string <- case bound.debug of {
                                    true -> { emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X0", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: true }) };
                                    false -> emit_child(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner),  "X0", pools,  { bound_name: bound.bound_name, bound_reg: bound.bound_reg, outer_reg: bound.outer_reg, debug: false })
                                };
                                op_asm: string <- prims@emit_prim_op(term, dest);
                                concat(concat(arg_asm, "\n"), op_asm)
                            };
    false -> term_emit_kind_compound_compare@emit_kind_compound_compare(term, dest, bound, pools, emit_child)
}
}
}
