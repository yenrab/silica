// ESP32-S3 port early app 08: unbounded recursion. On the host the process dies with SIGSEGV when
// the 8 MB stack is exhausted (status 139); on the board the runtime's stack-guard watchpoint raises
// a debug exception, which the fault path reports as status 139 with "exccause=1006 ... (stack guard".
// The output before the fault is empty on both.
fn down(n: int64) -> int64 {
    1 + down(n + 1)
}

fn main() -> int64 { down(0) }
