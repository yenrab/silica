                    true -> {
                        (sir_c: int64, sir_val: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) <- compile_to_sir_module(sorted_rem.head, prog, world, config_files, parsed, specialized_all);
                        case sir_c != 0 of {
                            true -> (sir_c, sir_ast@nil_sir_modules());
                            false -> gather_sirs_rev(sorted_rem.tail, parsed, config_files, specialized_all, sir_ast@cons_sir_module(sir_val, acc_rev))
                        }
                    }
                }
            }
        }

        }
    produces
        pure result
    end
}

fn sir_queue_any_need_actor_runtime(mods: List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)]) -> bool {
    case mods.is_nil of {
        true -> false;
        false -> case emitter_core@module_needs_actor_runtime(mods.head) of {
            true -> true;
            false -> sir_queue_any_need_actor_runtime(mods.tail)
        }
    }
}

fn emit_batch_with_exe_atom_table(paths: List[string, mem(normal)], sirs: List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)], exe_tbl: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- case paths.is_nil of {
            true -> 0;
            false -> case sirs.is_nil of {
                true -> 1;
                false -> {
                    _: int8 <- println("  Emitting...");
                    asm: string <- case debug_compile(paths.head) of {
                        true -> emitter_core@emit_module_with_atom_and_debug(sirs.head, exe_tbl, true);
                        false -> emitter_core@emit_module_with_atom_table(sirs.head, exe_tbl)
                    };
                    _: int8 <- build_output@write_assembly(paths.head, asm);
                    _: int64 <- announce_compiled_file(paths.head);
                    emit_batch_with_exe_atom_table(paths.tail, sirs.tail, exe_tbl)
                }
            }
        }
    produces
        pure result
    end
}

fn finish_multi_unit_emit(sorted_topo: List[string, mem(normal)], fwd_queue: List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)], exe_atom_tbl: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> int64 {
    sequence
        emit_c: int64 <- emit_batch_with_exe_atom_table(sorted_topo, fwd_queue, exe_atom_tbl);
        result: int64 <- case emit_c != 0 of {
            true -> emit_c;
            false -> {
                runtime_asm: string <- emitter_core@emit_actor_runtime_module_with_atom_table(exe_atom_tbl);
                build_output@write_runtime_assembly(runtime_asm)
            }
        }
    produces
        pure result
    end
}

// Two or more units: one merged atom table for the whole config (link-batch / process-image atom ids), then emit each .sams with that table.
fn compile_multi_unit_with_merged_atoms(sorted_topo: List[string, mem(normal)], parsed_all: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], config_files: List[string, mem(normal)]) -> int64 {
    sequence
        specialized_all: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- specialize_all_parsed(parsed_all);
        (gather_code: int64, rev_queue: List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)]) <- gather_sirs_rev(sorted_topo, parsed_all, config_files, specialized_all, sir_ast@nil_sir_modules());
        result: int64 <- case gather_code != 0 of {
            true -> gather_code;
            false -> {
                fwd_queue: List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)] <- reverse_sir_modules_into_forward(rev_queue, sir_ast@nil_sir_modules());
                finish_multi_unit_emit(sorted_topo, fwd_queue, atom_table@build_atom_table_executable(fwd_queue))
            }
        }
    produces
        pure result
    end
}


fn after_unit_compiled(rest: List[string, mem(normal)], unit_rt: bool) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
            _: int64 <- mark_needs_runtime_if(unit_rt);
            case rest.is_nil of {
                true -> finish_batch_artifacts();
                false -> {
                    _: int64 <- write_paths_file(compile_order_path(), rest);
                    _: int8 <- println("Unit compiled; exiting to reclaim memory before next unit...");
                    continue_exit_code()
                }
            }
        }
    produces
        pure result
    end
}

fn prepare_compile_order(sorted_files: List[string, mem(normal)], parsed_all: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], all_config_files: List[string, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
            case sorted_files.is_nil of {
                true -> finish_batch_artifacts();
                false -> {
                    _: int64 <- ffi_link_manifest@write_link_manifest_for_parsed(parsed_all);
                    case sorted_files.tail.is_nil of {
                        true -> {
                            (code: int64, unit_rt: bool) <- compile_one_sorted_unit(sorted_files.head, parsed_all, all_config_files);
                            case code != 0 of {
                                true -> code;
                                false -> after_unit_compiled(module_checker_core@empty_list_string(), unit_rt)
                            }
                        };
                        false -> {
                            _: int64 <- write_paths_file(compile_order_path(), sorted_files);
                            _: int8 <- println("Compile order ready; exiting to reclaim memory before unit compiles...");
                            continue_exit_code()
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}

fn resume_compile_order(order: List[string, mem(normal)], all_config_files: List[string, mem(normal)]) -> int64 {
    sequence
        result: int64 <- {
            case order.is_nil of {
                true -> finish_batch_artifacts();
                false -> {
                    (ok: bool, parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) <- parse_use_closure_work(
                        module_checker_core@cons_string(order.head, module_checker_core@empty_list_string()),
                        all_config_files,
                        module_checker_core@empty_parsed_files()
                    );
                    case ok of {
                        false -> 1;
                        true -> {
                            (code: int64, unit_rt: bool) <- compile_one_sorted_unit(order.head, parsed, all_config_files);
                            case code != 0 of {
                                true -> code;
                                false -> after_unit_compiled(order.tail, unit_rt)
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}

// Lex + parse one file, then compile with an empty module world (no cross-file `use`).
fn compile_file(filename: string) -> int64 {
    sequence proc[DeviceIO]
        _: int8 <- println("Parsing ");
        _: int8 <- print(filename);
        _: int8 <- println("...");
        _: int8 <- println("  Lexing...");
        tokens: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- lexer_runner@lexer_runner(filename);
        _: int8 <- println("  Parsing...");
        parse_result: { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- parser_runner@parse_program(tokens);
        result: int64 <- case parse_result.is_ok of {
            true -> {
                mod_nm: string <- module_checker_core@module_from_path(filename);
                empty_world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- type_checker_modules@empty_named_program_list();
                world_one: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- parser_ast@cons_named_program(mod_nm, parse_result.program, empty_world);
                empty_parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- module_checker_core@empty_parsed_files();
                parsed_one: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- module_checker_core@cons_parsed_file(filename, parse_result.program, empty_parsed);
                specialized_one: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- specialize_all_parsed(parsed_one);
                empty_cfg: List[string, mem(normal)] <- module_checker_core@empty_list_string();
                cfg_one: List[string, mem(normal)] <- module_checker_core@cons_string(filename, empty_cfg);
                (cf_code: int64, cf_rt: bool) <- compile_parsed_unit(filename, parse_result.program, world_one, cfg_one, parsed_one, specialized_one);
                case cf_code != 0 of {
                    true -> cf_code;
                    false -> {
                        _: int64 <- maybe_write_runtime_assembly(cf_rt);
                        0
                    }
                }
            };
            false -> {
                error_code: string <- case parse_result.error_code == "" of {
                    true -> "E1001";
                    false -> parse_result.error_code
                };
                spec_section: string <- case parse_result.spec_section == "" of {
                    true -> "sect3";
                    false -> parse_result.spec_section
                };
                _: int8 <- diagnostics_core@print_compiler_error("ParseError", error_code, parse_result.error_location, parse_result.error_message, spec_section);
                1
            }
        }
    produces
        pure result
    end
}

// Main: read config; multi-unit uses process-per-unit hygiene (silica.compile.order + exit 75).
fn main() -> int64 {
    sequence proc[DeviceIO]
        config_path: string <- "silica.config";
        config_exists: bool <- file_exists(config_path);
        content: string <- case config_exists of {
            true -> read_lines(config_path);
            false -> ""
        };
        // Stage empty acc before parse_config_lines: a nested empty_list_string() as a call
        // arg is evaluated after content/start are loaded and clobbers X0/X1 under current
        // user_call emission, leaving parse_config_lines with nil args.
        empty_files: List[string, mem(normal)] <- module_checker_core@empty_list_string();
        files_rev: List[string, mem(normal)] <- case len(content) > 0 of {
            true -> parse_config_lines(content, 0, empty_files);
            false -> empty_files
        };
        files: List[string, mem(normal)] <- reverse_list_string(files_rev);
        result: int64 <- case list_string_length(files) == 0 of {
            true -> {
                _: int8 <- println("Error: silica.config not found or empty. Create silica.config with one .silica file per line.");
                1
            };
            false -> {
                validation: int64 <- validate_config_files(files);
                case validation != 0 of {
                    true -> 1;
                    false -> {
                        order_exists: bool <- file_exists(compile_order_path());
                        case order_exists of {
                            true -> {
                                order_content: string <- read_lines(compile_order_path());
                                empty_order: List[string, mem(normal)] <- module_checker_core@empty_list_string();
                                order_rev: List[string, mem(normal)] <- case len(order_content) > 0 of {
                                    true -> parse_config_lines(order_content, 0, empty_order);
                                    false -> empty_order
                                };
                                order: List[string, mem(normal)] <- reverse_list_string(order_rev);
                                _: int8 <- println("Resuming compile order; units left: ");
                                _: int8 <- print_int64(list_string_length(order));
                                _: int8 <- println("");
                                resume_compile_order(order, files)
                            };
                            false -> {
                                _: int8 <- println("Files to compile: ");
                                _: int8 <- print_int64(list_string_length(files));
                                _: int8 <- println("");
                                // Stage empty acc: a nested empty_parsed_files() as a call arg clobbers the
                                // files pointer under current user_call emission.
                                empty_parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- module_checker_core@empty_parsed_files();
                                (ok_parse: bool, parsed_all: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) <- parse_all_files_recursive(files, empty_parsed);
                                case ok_parse of {
                                    false -> 1;
                                    true -> {
                                        (sort_ok: bool, sorted_files: List[string, mem(normal)]) <- topological_sort_from_parsed(files, parsed_all);
                                        case sort_ok of {
                                            false -> {
                                                _: int8 <- println("Error: cyclic module dependencies among files in silica.config");
                                                1
                                            };
                                            true -> prepare_compile_order(sorted_files, parsed_all, files)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}
