ing, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } {
    (found: bool, prog: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) <- parser_ast@find_named_program(mod_name, specialized_all);
    case found of {
        true -> prog;
        false -> trait_specialization@specialize_program(program)
    }
}

fn maybe_write_runtime_assembly(any_needs_runtime: bool) -> int64 {
    sequence
        result: int64 <- {
        case any_needs_runtime of {
            // Incremental / process-per-unit reclaim path: seed the fixed actor-runtime
            // atom prefix. An empty table embeds cmp #-1 and deadlocks pid-registry init.
            true -> {
                seeded_work: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)], next_index: int64 } <- atom_table@seed_actor_runtime_atoms();
                seeded: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] } <- atom_table@to_export_table(seeded_work);
                runtime_asm: string <- emitter_core@emit_actor_runtime_module_with_atom_table(seeded);
                build_output@write_runtime_assembly(runtime_asm)
            };
            false -> 0
        }
        }
    produces
        pure result
    end
}

fn write_paths_file_rec(path: string, paths: List[string, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        case paths.is_nil of {
            true -> 0;
            false -> {
                _: bool <- append_file(path, concat(paths.head, "\n"));
                write_paths_file_rec(path, paths.tail)
            }
        }
        }
    produces
        pure result
    end
}

fn write_paths_file(path: string, paths: List[string, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        delete_file(path);
        write_paths_file_rec(path, paths)
        }
    produces
        pure result
    end
}

fn mark_needs_runtime_if(needs: bool) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        case needs of {
            false -> 0;
            true -> {
                _: bool <- append_file(needs_runtime_marker_path(), "1\n");
                0
            }
        }
        }
    produces
        pure result
    end
}

fn finish_batch_artifacts() -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- {
        needs_rt: bool <- file_exists(needs_runtime_marker_path());
        _: int64 <- maybe_write_runtime_assembly(needs_rt);
        delete_file(compile_order_path());
        delete_file(needs_runtime_marker_path());
        println("Compilation complete.");
        0
        }
    produces
        pure result
    end
}

fn parsed_contains_path(parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], path: string) -> bool {
    case parsed.is_nil of {
        true -> false;
        false -> case parsed.head.path == path of {
            true -> true;
            false -> parsed_contains_path(parsed.tail, path)
        }
    }
}

fn path_for_module_in_config(mod_name: string, config: List[string, mem(normal)]) -> string {
    case config.is_nil of {
        true -> "";
        false -> case module_checker_core@module_from_path(config.head) == mod_name of {
            true -> config.head;
            false -> path_for_module_in_config(mod_name, config.tail)
        }
    }
}

fn resolve_use_names_to_config_paths(uses: List[string, mem(normal)], config: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case uses.is_nil of {
        true -> acc;
        false -> {
            p: string <- path_for_module_in_config(uses.head, config);
            next_acc: List[string, mem(normal)] <- case len(p) == 0 of {
                true -> acc;
                false -> list_string_cons_unique(p, acc)
            };
            resolve_use_names_to_config_paths(uses.tail, config, next_acc)
        }
    }
}

fn list_string_to_iface_strings(lst: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case lst.is_nil of {
        true -> module_iface@reverse_iface_string_list(acc);
        false -> list_string_to_iface_strings(lst.tail, module_iface@cons_iface_string_public(lst.head, acc))
    }
}

fn filter_use_paths_missing_iface(paths: List[string, mem(normal)], config: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence
        result: List[string, mem(normal)] <- case paths.is_nil of {
            true -> reverse_list_string(acc);
            false -> {
                // Phase 3: skip only when a fresh iface exists (stamp/hash/deps valid).
                cfg: List[string, mem(normal)] <- list_string_to_iface_strings(config, module_iface@empty_iface_string_list());
                has: bool <- module_iface@iface_usable_for_source(paths.head, cfg);
                case has of {
                    true -> filter_use_paths_missing_iface(paths.tail, config, acc);
                    false -> filter_use_paths_missing_iface(paths.tail, config, module_checker_core@cons_string(paths.head, acc))
                }
            }
        }
    produces
        pure result
    end
}

// Parse `work` paths and every transitive `use` target found in config (not the whole batch).
// Deps with a published `.iface` are not parsed (type-check imports them from iface instead).
fn parse_use_closure_work(work: List[string, mem(normal)], config: List[string, mem(normal)], acc: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> (bool, List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) {
    sequence proc[DeviceIO]
        result: (bool, List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) <- {
        case work.is_nil of {
            true -> (true, module_checker_core@reverse_parsed_files(acc, module_checker_core@empty_parsed_files()));
            false -> case parsed_contains_path(acc, work.head) of {
                true -> parse_use_closure_work(work.tail, config, acc);
                false -> {
                    println("Parsing ");
                    print(work.head);
                    println("...");
                    println("  Lexing...");
                    tokens: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- lexer_runner@lexer_runner(work.head);
                    println("  Parsing...");
                    parse_result: { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- parser_runner@parse_program(tokens);
                    case parse_result.is_ok of {
                        false -> {
                            error_code: string <- case parse_result.error_code == "" of {
                                true -> "E1001";
                                false -> parse_result.error_code
                            };
                            spec_section: string <- case parse_result.spec_section == "" of {
                                true -> "sect3";
                                false -> parse_result.spec_section
                            };
                            diagnostics_core@print_compiler_error("ParseError", error_code, parse_result.error_location, parse_result.error_message, spec_section);
                            (false, module_checker_core@empty_parsed_files())
                        };
                        true -> {
                            uses: List[string, mem(normal)] <- extract_use_modules_from_program(parse_result.program);
                            use_paths: List[string, mem(normal)] <- resolve_use_names_to_config_paths(uses, config, module_checker_core@empty_list_string());
                            use_paths_need_parse: List[string, mem(normal)] <- filter_use_paths_missing_iface(use_paths, config, module_checker_core@empty_list_string());
                            next_work: List[string, mem(normal)] <- append_list_string_hygiene(use_paths_need_parse, work.tail);
                            work_path: string <- work.head;
                            next_acc: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- module_checker_core@cons_parsed_file(work_path, parse_result.program, acc);
                            parse_use_closure_work(next_work, config, next_acc)
                        }
                    }
                }
            }
        }
        }
    produces
        pure result
    end
}

fn compile_one_sorted_unit(path: string, parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], all_config_files: List[string, mem(normal)]) -> (int64, bool) {
    sequence proc[DeviceIO]
        result: (int64, bool) <- {
        (found: bool, prog: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) <- module_checker_core@find_program_in_parsed(parsed, path);
        case found of {
            false -> {
                println("Error: internal parse table missing file");
                print(path);
                (1, false)
            };
            true -> {
                mod_name: string <- module_checker_core@module_from_path(path);
                use_names: List[string, mem(normal)] <- transitive_use_names_for_program(prog, parsed);
                empty_cache: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- type_checker_modules@empty_named_program_list();
                cache_uses: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- ensure_specialized_names(use_names, parsed, empty_cache);
                cache_self: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- ensure_specialized_path(path, parsed, cache_uses);
                world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- build_module_world(parsed, path);
                mangle_names: List[string, mem(normal)] <- list_string_cons_unique(mod_name, use_names);
                specialized_for_unit: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- filter_specialized_to_names(cache_self, mangle_names);
                compile_parsed_unit(path, prog, world, all_config_files, parsed, specialized_for_unit)
            }
        }
        }
    produces
        pure result
    end
}

fn parse_all_files_recursive(files: List[string, mem(normal)], acc: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> (bool, List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) {
    sequence proc[DeviceIO]
        result: (bool, List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) <- {
        case files.is_nil of {
            true -> (true, module_checker_core@reverse_parsed_files(acc, module_checker_core@empty_parsed_files()));
            false -> {
                println("Parsing ");
                print(files.head);
                println("...");
                println("  Lexing...");
                tokens: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- lexer_runner@lexer_runner(files.head);
                println("  Parsing...");
                parse_result: { is_ok: bool, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- parser_runner@parse_program(tokens);
                case parse_result.is_ok of {
                    false -> {
                        error_code: string <- case parse_result.error_code == "" of {
                            true -> "E1001";
                            false -> parse_result.error_code
                        };
                        spec_section: string <- case parse_result.spec_section == "" of {
                            true -> "sect3";
                            false -> parse_result.spec_section
                        };
                        diagnostics_core@print_compiler_error("ParseError", error_code, parse_result.error_location, parse_result.error_message, spec_section);
                        (false, module_checker_core@empty_parsed_files())
                    };
                    true -> {
                        file_path: string <- files.head;
                        rest_files: List[string, mem(normal)] <- files.tail;
                        next_acc: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- module_checker_core@cons_parsed_file(file_path, parse_result.program, acc);
                        parse_all_files_recursive(rest_files, next_acc)
                    }
                }
            }
        }

        }
    produces
        pure result
    end
}

fn list_string_length(lst: List[string, mem(normal)]) -> int64 {
    case lst.is_nil of {
        true -> 0;
        false -> 1 + list_string_length(lst.tail)
    }
}

// Parse config: split by newlines, skip empty and # lines, return list (order preserved)
fn parse_config_lines(content: string, start: int64, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case start >= len(content) of {
        true -> acc;
        false -> {
            line: string <- substring_until_char(content, start, '\n');
            line_len: int64 <- len(line);
            next_start: int64 <- start + line_len + 1;
            trimmed: string <- trim_leading(line);
            is_comment: bool <- starts_with(trimmed, "#");
            is_empty: bool <- len(trimmed) == 0;
            new_acc: List[string, mem(normal)] <- case is_comment of {
                true -> acc;
                false -> case is_empty of {
                    true -> acc;
                    false -> module_checker_core@cons_string(trimmed, acc)
                }
            };
            parse_config_lines(content, next_start, new_acc)
        }
    }
}

fn trim_leading(s: string) -> string {
    trim_leading_from(s, 0)
}

fn trim_leading_from(s: string, pos: int64) -> string {
    case pos >= len(s) of {
        true -> "";
        false -> case is_whitespace_at(s, pos) of {
            true -> trim_leading_from(s, pos + 1);
            false -> substring(s, pos, len(s))
        }
    }
}

fn is_whitespace_at(s: string, pos: int64) -> bool {
    c: string <- substring(s, pos, pos + 1);
    c == " " or c == "\t" or c == "\n" or c == "\r"
}

fn trim_trailing(s: string) -> string {
    trim_trailing_from(s, len(s) - 1)
}

fn trim_trailing_from(s: string, pos: int64) -> string {
    case pos < 0 of {
        true -> "";
        false -> case is_whitespace_at(s, pos) of {
            true -> trim_trailing_from(s, pos - 1);
            false -> substring(s, 0, pos + 1)
        }
    }
}

// Reverse a List[string, mem(normal)] (since we cons in reverse order during parse)
fn reverse_list_string(lst: List[string, mem(normal)]) -> List[string, mem(normal)] {
    reverse_list_string_acc(lst, module_checker_core@empty_list_string())
}

fn reverse_list_string_acc(lst: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case lst.is_nil of {
        true -> acc;
        // Stage head/tail/cons before the recursive call: a nested lst.tail plus cons(...)
        // as call args clobbers the cons result (field access loads offsets into X1).
        false -> {
            h: string <- lst.head;
            t: List[string, mem(normal)] <- lst.tail;
            new_acc: List[string, mem(normal)] <- module_checker_core@cons_string(h, acc);
            reverse_list_string_acc(t, new_acc)
        }
    }
}

// Check if list contains string (exact match)
fn list_contains(lst: List[string, mem(normal)], s: string) -> bool {
    case lst.is_nil of {
        true -> false;
        false -> case lst.head == s of {
            true -> true;
            false -> list_contains(lst.tail, s)
        }
    }
}

// Get file path for module from our file list (module name -> path)
fn path_for_module(files: List[string, mem(normal)], mod_name: string) -> string {
    case files.is_nil of {
        true -> "";
        false -> case module_checker_core@module_from_path(files.head) == mod_name of {
            true -> files.head;
            false -> path_for_module(files.tail, mod_name)
        }
    }
}

fn resolve_deps_to_paths(modules: List[string, mem(normal)], files: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case modules.is_nil of {
        true -> acc;
        false -> {
            path: string <- path_for_module(files, modules.head);
            new_acc: List[string, mem(normal)] <- case len(path) > 0 of {
                true -> module_checker_core@cons_string(path, acc);
                false -> acc
            };
            resolve_deps_to_paths(modules.tail, files, new_acc)
        }
    }
}

// { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } tag 2 = use; parameters.name holds each imported module (parser_ast.silica).
fn collect_use_modules_from_params(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case params.is_nil of {
        true -> acc;
        false -> collect_use_modules_from_params(params.tail, module_checker_core@cons_string(params.head.name, acc))
    }
}

fn collect_use_modules_from_decls(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> acc;
        false -> case decls.head.tag == 2 of {
            true -> collect_use_modules_from_decls(decls.tail, collect_use_modules_from_params(decls.head.parameters, acc));
            false -> collect_use_modules_from_decls(decls.tail, acc)
        }
    }
}

fn extract_use_modules_from_program(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> List[string, mem(normal)] {
    collect_use_modules_from_decls(program.declarations, module_checker_core@empty_list_string())
}

fn dep_paths_for_parsed_file(path: string, parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], config_files: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence
        (found: bool, prog: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) <- module_checker_core@find_program_in_parsed(parsed, path);
        result: List[string, mem(normal)] <- case found of {
            true -> resolve_deps_to_paths(transitive_use_names_for_program(prog, parsed), config_files, module_checker_core@empty_list_string());
            false -> module_checker_core@empty_list_string()
        }
    produces
        pure result
    end
}

// Edge: dependent must compile after prerequisite (both are config file paths).
// Per-unit node for Kahn's algorithm (in-degree = unmet prerequisites in config).

fn nil_dep_edge_list() -> List[{ dependent: string, prerequisite: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ dependent: string, prerequisite: string }, mem(normal)] <- empty[{ dependent: string, prerequisite: string }, mem(normal)]()
    produces
        pure result
    end
}

fn cons_dep_edge(edge: { dependent: string, prerequisite: string }, tail: List[{ dependent: string, prerequisite: string }, mem(normal)]) -> List[{ dependent: string, prerequisite: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ dependent: string, prerequisite: string }, mem(normal)] <- prepend[{ dependent: string, prerequisite: string }, mem(normal)](edge, tail)
    produces
        pure result
    end
}

fn nil_compile_unit_deps_list() -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ path: string, in_degree: int64 }, mem(normal)] <- empty[{ path: string, in_degree: int64 }, mem(normal)]()
    produces
        pure result
    end
}

fn cons_compile_unit_deps(entry: { path: string, in_degree: int64 }, tail: List[{ path: string, in_degree: int64 }, mem(normal)]) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ path: string, in_degree: int64 }, mem(normal)] <- prepend[{ path: string, in_degree: int64 }, mem(normal)](entry, tail)
    produces
        pure result
    end
}

fn reverse_compile_unit_deps_list(lst: List[{ path: string, in_degree: int64 }, mem(normal)], acc: List[{ path: string, in_degree: int64 }, mem(normal)]) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    case lst.is_nil of {
        true -> acc;
        false -> reverse_compile_unit_deps_list(lst.tail, cons_compile_unit_deps(lst.head, acc))
    }
}

fn cons_dep_edges_for_paths(dependent: string, prereq_paths: List[string, mem(normal)], acc: List[{ dependent: string, prerequisite: string }, mem(normal)]) -> List[{ dependent: string, prerequisite: string }, mem(normal)] {
    case prereq_paths.is_nil of {
        true -> acc;
        false -> cons_dep_edges_for_paths(dependent, prereq_paths.tail, cons_dep_edge({ dependent: dependent, prerequisite: prereq_paths.head }, acc))
    }
}

fn build_dep_edges_rev(config_files: List[string, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], acc: List[{ dependent: string, prerequisite: string }, mem(normal)]) -> List[{ dependent: string, prerequisite: string }, mem(normal)] {
    case config_files.is_nil of {
        true -> acc;
        false -> {
            dep_paths: List[string, mem(normal)] <- dep_paths_for_parsed_file(config_files.head, parsed, config_files);
            with_edges: List[{ dependent: string, prerequisite: string }, mem(normal)] <- cons_dep_edges_for_paths(config_files.head, dep_paths, acc);
            build_dep_edges_rev(config_files.tail, parsed, with_edges)
        }
    }
}

fn count_incoming_edges_for_path(edges: List[{ dependent: string, prerequisite: string }, mem(normal)], path: string) -> int64 {
    case edges.is_nil of {
        true -> 0;
        false -> case edges.head.dependent == path of {
            true -> 1 + count_incoming_edges_for_path(edges.tail, path);
            false -> count_incoming_edges_for_path(edges.tail, path)
        }
    }
}

fn build_compile_units_rev(config_files: List[string, mem(normal)], edges: List[{ dependent: string, prerequisite: string }, mem(normal)], acc: List[{ path: string, in_degree: int64 }, mem(normal)]) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    case config_files.is_nil of {
        true -> acc;
        false -> {
            in_deg: int64 <- count_incoming_edges_for_path(edges, config_files.head);
            entry: { path: string, in_degree: int64 } <- { path: config_files.head, in_degree: in_deg };
            build_compile_units_rev(config_files.tail, edges, cons_compile_unit_deps(entry, acc))
        }
    }
}

fn has_edge_from_to(edges: List[{ dependent: string, prerequisite: string }, mem(normal)], dependent: string, prerequisite: string) -> bool {
    case edges.is_nil of {
        true -> false;
        false -> case edges.head.dependent == dependent and edges.head.prerequisite == prerequisite of {
            true -> true;
            false -> has_edge_from_to(edges.tail, dependent, prerequisite)
        }
    }
}

fn remove_unit_from_dep_graph(graph: List[{ path: string, in_degree: int64 }, mem(normal)], path: string) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    case graph.is_nil of {
        true -> nil_compile_unit_deps_list();
        false -> case graph.head.path == path of {
            true -> graph.tail;
            false -> cons_compile_unit_deps(graph.head, remove_unit_from_dep_graph(graph.tail, path))
        }
    }
}

fn decrement_in_degrees_for_emit(graph: List[{ path: string, in_degree: int64 }, mem(normal)], edges: List[{ dependent: string, prerequisite: string }, mem(normal)], emitted_path: string) -> List[{ path: string, in_degree: int64 }, mem(normal)] {
    case graph.is_nil of {
        true -> nil_compile_unit_deps_list();
        false -> {
            new_in_degree: int64 <- case has_edge_from_to(edges, graph.head.path, emitted_path) of {
                true -> graph.head.in_degree - 1;
                false -> graph.head.in_degree
            };
            updated: { path: string, in_degree: int64 } <- { path: graph.head.path, in_degree: new_in_degree };
            cons_compile_unit_deps(updated, decrement_in_degrees_for_emit(graph.tail, edges, emitted_path))
        }
    }
}

fn take_first_zero_in_degree(graph: List[{ path: string, in_degree: int64 }, mem(normal)]) -> (string, List[{ path: string, in_degree: int64 }, mem(normal)]) {
    take_first_zero_in_degree_impl(graph, graph)
}

fn take_first_zero_in_degree_impl(scan: List[{ path: string, in_degree: int64 }, mem(normal)], full_graph: List[{ path: string, in_degree: int64 }, mem(normal)]) -> (string, List[{ path: string, in_degree: int64 }, mem(normal)]) {
    case scan.is_nil of {
        true -> ("", full_graph);
        false -> case scan.head.in_degree == 0 of {
            true -> {
                rest: List[{ path: string, in_degree: int64 }, mem(normal)] <- remove_unit_from_dep_graph(full_graph, scan.head.path);
                (scan.head.path, rest)
            };
            false -> take_first_zero_in_degree_impl(scan.tail, full_graph)
        }
    }
}

// Kahn's algorithm: O(V+E) over config files using AST-derived deps (no per-probe disk reads).
fn kahn_topological_sort(graph: List[{ path: string, in_degree: int64 }, mem(normal)], edges: List[{ dependent: string, prerequisite: string }, mem(normal)], result_rev: List[string, mem(normal)]) -> (bool, List[string, mem(normal)]) {
    case graph.is_nil of {
        true -> (true, reverse_list_string(result_rev));
        false -> {
            (ready_path: string, rest_graph: List[{ path: string, in_degree: int64 }, mem(normal)]) <- take_first_zero_in_degree(graph);
            case len(ready_path) == 0 of {
                true -> (false, result_rev);
                false -> {
                    updated: List[{ path: string, in_degree: int64 }, mem(normal)] <- decrement_in_degrees_for_emit(rest_graph, edges, ready_path);
                    kahn_topological_sort(updated, edges, module_checker_core@cons_string(ready_path, result_rev))
                }
            }
        }
    }
}

fn topological_sort_from_parsed(config_files: List[string, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> (bool, List[string, mem(normal)]) {
    sequence
        edges_rev: List[{ dependent: string, prerequisite: string }, mem(normal)] <- build_dep_edges_rev(config_files, parsed, nil_dep_edge_list());
        units_rev: List[{ path: string, in_degree: int64 }, mem(normal)] <- build_compile_units_rev(config_files, edges_rev, nil_compile_unit_deps_list());
        units: List[{ path: string, in_degree: int64 }, mem(normal)] <- reverse_compile_unit_deps_list(units_rev, nil_compile_unit_deps_list());
        result: (bool, List[string, mem(normal)]) <- kahn_topological_sort(units, edges_rev, module_checker_core@empty_list_string())
    produces
        pure result
    end
}

// Validate that all files listed in config exist; return 0 if ok, 1 if any missing
fn announce_compiling_file(filename: string) -> int64 {
    sequence proc[DeviceIO]
        _: int8 <- println("Compiling ");
        _: int8 <- print(filename);
        _: int8 <- println("...");
        result: int64 <- 0
    produces
        pure result
    end
}

fn announce_compiled_file(filename: string) -> int64 {
    sequence proc[DeviceIO]
        mod_name: string <- module_checker_core@module_from_path(filename);
        _: int8 <- println(concat("Finished compiling ", mod_name));
        result: int64 <- 0
    produces
        pure result
    end
}

fn validate_config_files(files: List[string, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- case files.is_nil of {
            true -> 0;
            false -> {
                exists: bool <- file_exists(files.head);
                case exists of {
                    true -> validate_config_files(files.tail);
                    false -> {
                        _: int8 <- println(concat("Error: File not found: ", files.head));
                        _: int8 <- println("Check silica.config - the file listed does not exist.");
                        1
                    }
                }
            }
        }
    produces
        pure result
    end
}

// Debug: print tokens (kind and lexeme) for string_test/string_simple tracing
fn debug_print_tokens(tokens: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    sequence
        result: int64 <- debug_print_tokens_acc(tokens)
    produces
        pure result
    end
}

fn debug_print_tokens_acc(tokens: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- case tokens.is_nil of {
            true -> 0;
            false -> {
                t: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- tokens.head;
                kind_label: string <- case t.kind == lexer_token_kind@token_kind_string_literal() of { true -> "string_literal"; false -> case t.kind == lexer_token_kind@token_kind_identifier() of { true -> "identifier"; false -> case t.kind == lexer_token_kind@token_kind_string_keyword() of { true -> "string_keyword"; false -> t.lexeme } } };
                _: unit <- println(concat(concat(concat("  [DEBUG LEX] kind=", kind_label), " lexeme="), t.lexeme));
                debug_print_tokens_acc(tokens.tail)
            }
        }
    produces
        pure result
    end
}

fn debug_print_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, indent: string) -> int64 {
    sequence proc[DeviceIO]
        node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
        result: int64 <- case node.kind < 0 of {
            true -> {
                _: unit <- println(concat(concat("  [DEBUG EXPR] ", indent), "DUMMY(kind<0)"));
                0
            };
            false -> case node.kind of {
                0 -> { _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "literal value="), node.value)); 0 };
                1 -> { _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "identifier name="), node.name)); 0 };
                4 -> {
                    _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "call name="), node.name));
                    _: int64 <- debug_print_expr(parser_ast@expr_at(expr, node.inner), concat(indent, "  arg1:"));
                    _: int64 <- debug_print_expr(parser_ast@expr_at(expr, node.right_expr), concat(indent, "  arg2:"));
                    0
                };
                6 -> {
                    _: unit <- println(concat(concat(concat(concat("  [DEBUG EXPR] ", indent), "let "), node.name), concat(": ", node.value)));
                    _: int64 <- debug_print_expr(parser_ast@expr_at(expr, node.inner), concat(indent, "  rhs:"));
                    _: int64 <- debug_print_expr(parser_ast@expr_at(expr, node.right_expr), concat(indent, "  body:"));
                    0
                };
                8 -> { _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "string_literal value="), node.value)); 0 };
                11 -> {
                    _: unit <- println(concat(concat("  [DEBUG EXPR] ", indent), "SEQUENCE_BLOCK"));
                    _: int64 <- debug_print_expr(parser_ast@expr_at(expr, node.inner), concat(indent, "  seq_body:"));
                    _: int64 <- debug_print_expr(parser_ast@expr_at(expr, node.right_expr), concat(indent, "  seq_result:"));
                    0
                };
                _: int64 -> {
                    _: unit <- println(concat(concat(concat(concat("  [DEBUG EXPR] ", indent), "OTHER kind name="), node.name), concat(" value=", node.value)));
                    _: int64 <- debug_print_expr(parser_ast@expr_at(expr, node.inner), concat(indent, "  inner:"));
                    _: int64 <- debug_print_expr(parser_ast@expr_at(expr, node.right_expr), concat(indent, "  right:"));
                    0
                }
            }
        }
    produces
        pure result
    end
}


fn filename_ends_with(path: string, suffix: string) -> bool {
    ls: int64 <- len(path);
    lf: int64 <- len(suffix);
    case ls < lf of {
        true -> false;
        false -> substring(path, ls - lf, ls) == suffix
    }
}

fn debug_compile(filename: string) -> bool {
    case filename_ends_with(filename, "dangerous_legacy_math.silica") of {
        true -> true;
        false -> case filename_ends_with(filename, "dangerous_legacy_math_meta.silica") of {
            true -> true;
            false -> filename_ends_with(filename, "dangerous_net.silica")
        }
    }
}

fn debug_walk_decls(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> int64 {
    sequence proc[DeviceIO]
        result: int64 <- case decls.is_nil of {
            true -> 0;
            false -> {
                _: unit <- println(concat("  decl name=", decls.head.name));
                _: int64 <- debug_print_expr(decls.head.body, "BODY>");
                debug_walk_decls(decls.tail)
            }
        }
    produces
        pure result
    end
}

// Module-check → SIR only (used for multi-unit silica.config: merge atoms, then emit with shared { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }).
fn compile_to_sir_module(filename: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, module_world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], config_files: List[string, mem(normal)], all_parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], specialized_all: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> (int64, { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) {
    sequence proc[DeviceIO]
        result: (int64, { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) <- {
        _: int64 <- announce_compiling_file(filename);
        println("  Module checking...");
        mc: int64 <- module_checker_core@module_checker_check_program(program, config_files, all_parsed, filename);
        case mc == 0 of {
            false -> (1, sir_ast@dummy_sir_module());
            true -> {
                println("  FFI metadata...");
                ffi_meta: int64 <- ffi_sidecar_loader@validate_program_sidecar_metadata(program);
                case ffi_meta == 0 of {
                    false -> (1, sir_ast@dummy_sir_module());
                    true -> {
                        println("  FFI placement...");
                        placement: int64 <- ffi_placement_checker@validate_program_ffi_placement(program);
                        case placement == 0 of {
                            false -> (1, sir_ast@dummy_sir_module());
                            true -> {
                                println("  Type checking...");
                                context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@create_type_context();
                                mod_name: string <- module_checker_core@module_from_path(filename);
                                world_with_self: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- parser_ast@cons_named_program(mod_name, program, module_world);
                                // Phase 2: load published ifaces for transitive `use` closure; inject stub
                                // Programs so TC/effects resolve exports without loading dep full ASTs.
                                use_names: List[string, mem(normal)] <- transitive_use_names_for_program(program, all_parsed);
                                use_names_iface: List[string, mem(normal)] <- list_string_to_iface_strings(use_names, module_iface@empty_iface_string_list());
                                config_iface: List[string, mem(normal)] <- list_string_to_iface_strings(config_files, module_iface@empty_iface_string_list());
                                dep_ifaces: List[{ module_name: string, source_path: string, export_trait: string, exports: List[{ name: string, arity: int64, decl_tag: int64, effects: string, type_surface: string }, mem(normal)], impls: List[{ name: string, arity: int64, decl_tag: int64, effects: string, type_surface: string }, mem(normal)] }, mem(normal)] <- module_iface@load_ifaces_for_module_names(use_names_iface, config_iface);
                                world_for_tc: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- module_iface@append_iface_stub_programs(world_with_self, dep_ifaces);
                                tc_out: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } } <- type_checker_modules@type_check_program_with_modules_outcome(program, mod_name, world_for_tc, context);
                                case tc_out.is_ok of {
                                    true -> {
                                        // Phase 1: publish module iface after successful type check (write-only).
                                        _: int64 <- module_iface@publish_module_iface(mod_name, filename, program, config_iface);
                                        println("  FFI ABI...");
                                        abi_st: int64 <- ffi_abi_checker@validate_program_ffi_abi(program);
                                        case abi_st == 0 of {
                                            false -> (1, sir_ast@dummy_sir_module());
                                            true -> {
                                                println("  FFI taint...");
                                                taint_st: int64 <- ffi_taint_checker@validate_program_ffi_taint(program);
                                                case taint_st == 0 of {
                                                    false -> (1, sir_ast@dummy_sir_module());
                                                    true -> {
                                                        println("  Trait checking...");
                                                        tr_code: int64 <- trait_checker_core@trait_checker_check_program(program);
                                                        case tr_code != 0 of {
                                                            true -> (1, sir_ast@dummy_sir_module());
                                                            false -> {
                                                                println("  Effect checking...");
                                                                effect_result: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- effect_checker_capabilities@check_program_effects(program, world_for_tc);
                                                                case effect_result.is_ok of {
                                                                    true -> {
                                                                        _: int64 <- case debug_compile(filename) of {
                                                                            true -> {
                                                                                println("  [DEBUG AST] decl-count walk:");
                                                                                debug_walk_decls(program.declarations);
                                                                                0
                                                                            };
                                                                            false -> 0
                                                                        };
                                                                        println("  Generating SIR...");
                                                                        specialized_program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } <- specialized_program_for_module(mod_name, program, specialized_all);
                                                                        // Same stub inject as TC: when a `use` dep was parse-skipped via iface,
                                                                        // specialized_all has no { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } for it and overload/trait link mangling
                                                                        // would emit unmangled names (link failure). Stubs carry export trait + impls.
                                                                        world_for_sir: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- module_iface@append_iface_stub_programs(specialized_all, dep_ifaces);
                                                                        mangled_program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } <- qualified_call_mangler@mangle_calls_in_program(specialized_program, world_for_sir);
                                                                        link_libs: List[string, mem(normal)] <- ffi_sidecar_loader@collect_program_link_libraries(program);
                                                                        sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] } <- sir_generator_core@emit_program_for_unit_with_link_libraries(mangled_program, tc_out.context, mod_name, link_libs);
                                                                        _: int64 <- case debug_compile(filename) of {
                                                                            true -> {
                                                                                println("  [DEBUG SIR]:");
                                                                                println(sir_ast@sir_module_to_text(sir_module));
                                                                                0
                                                                            };
                                                                            false -> 0
                                                                        };
                                                                        (0, sir_module)
                                                                    };
                                                                    false -> {
                                                                        effect_error_code: string <- case effect_result.error_code == "" of {
                                                                            true -> "E3000";
                                                                            false -> effect_result.error_code
                                                                        };
                                                                        effect_spec_section: string <- case effect_result.spec_section == "" of {
                                                                            true -> "sect9";
                                                                            false -> effect_result.spec_section
                                                                        };
                                                                        diagnostics_core@print_compiler_error("EffectError", effect_error_code, effect_result.error_location, effect_result.error_message, effect_spec_section);
                                                                        (1, sir_ast@dummy_sir_module())
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    };
                                    false -> {
                                        // Phase 1: do not leave a stale published iface after TC failure.
                                        _: int64 <- module_iface@unpublish_module_iface_at_path(filename);
                                        error_code: string <- case tc_out.error_code == "" of {
                                            true -> "E2000";
                                            false -> tc_out.error_code
                                        };
                                        spec_section: string <- case tc_out.spec_section == "" of {
                                            true -> "sect6";
                                            false -> tc_out.spec_section
                                        };
                                        diagnostics_core@print_compiler_error("TypeError", error_code, tc_out.error_location, tc_out.error_message, spec_section);
                                        (1, sir_ast@dummy_sir_module())
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        }
    produces
        pure result
    end
}

// Module-check, type-check, trait-check, effect-check, SIR, emit for one unit; module_world is other parsed units (spec §19).
fn compile_parsed_unit(filename: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, module_world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], config_files: List[string, mem(normal)], all_parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], specialized_all: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> (int64, bool) {
    sequence proc[DeviceIO]
        (sir_code: int64, sir_module: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) <- compile_to_sir_module(filename, program, module_world, config_files, all_parsed, specialized_all);
        result: (int64, bool) <- case sir_code != 0 of {
            true -> (sir_code, false);
            false -> {
                _: int8 <- println("  Emitting...");
                asm: string <- case debug_compile(filename) of {
                    true -> emitter_core@emit_module_with_atom_and_debug(sir_module, atom_table@build_atom_table(sir_module), true);
                    false -> emitter_core@emit_module(sir_module)
                };
                _: int8 <- build_output@write_assembly(filename, asm);
                _: int64 <- announce_compiled_file(filename);
                (0, emitter_core@module_needs_actor_runtime(sir_module))
            }
        }
    produces
        pure result
    end
}

// Reverse cons-built List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)] (newest at head) into forward topological order.
fn reverse_sir_modules_into_forward(lst: List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)], acc: List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)]) -> List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)] {
    case lst.is_nil of {
        true -> acc;
        false -> reverse_sir_modules_into_forward(lst.tail, sir_ast@cons_sir_module(lst.head, acc))
    }
}

// Walk sorted_topo; accumulate SIR in reverse (cons) for each unit, then caller reverses to match topo order.
fn gather_sirs_rev(sorted_rem: List[string, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], config_files: List[string, mem(normal)], specialized_all: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], acc_rev: List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }, mem(normal)]) -> (int64, List[{ module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ 