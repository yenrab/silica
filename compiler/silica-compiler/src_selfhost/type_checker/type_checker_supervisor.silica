// Supervisors Phase E (design_documents/supervisors_implementation_development_plan.md, §15.4.12–15.4.13.2):
// `impl … for Supervisor { fn init … }` must declare a return type that names the static child table
// and escalation fields the runtime uses for automatic restart (shared with module_checker export-trait
// validation — same string predicates).

use parser_ast;
use type_checker_core;
use type_checker_traits;
use type_checker_expressions_actors;

export supervisor_init_return_tuple_has_flags_and_children/1;
export supervisor_init_return_has_phase_e_declarative_fields/1;
export program_has_impl_for_supervisor/1;
export collect_supervisor_impl_types_csv/1;
export check_init_if_supervisor_impl_phase_e/2;
export check_supervisor_impl_has_init_phase_b/1;
export supervisor_walk_validate_child_spec_agent_type_atoms/1;
export supervisor_walk_validate_child_spec_flavor_atoms/1;
export supervisor_walk_validate_dangerous_flavor_constraints/2;
export validate_supervisor_init_body_literal_agent_types_if_needed/2;
export validate_supervisor_init_body_literal_flavor_if_needed/2;
export validate_supervisor_init_body_dangerous_flavor_constraints_if_needed/3;

fn supervisor_string_contains_from(h: string, needle: string, i: int64, nh: int64) -> bool {
    case i + nh > len(h) of {
        true -> false;
        false -> case substring(h, i, i + nh) == needle of {
            true -> true;
            false -> supervisor_string_contains_from(h, needle, i + 1, nh)
        }
    }
}

fn supervisor_string_contains(h: string, needle: string) -> bool {
    nh: int64 <- len(needle);
    case nh == 0 of {
        true -> true;
        false -> supervisor_string_contains_from(h, needle, 0, nh)
    }
}

// §15.4.13.1: tuple (flags, static children). Same top-level comma scan as module_checker / trait_checker.
fn supervisor_trait_top_level_comma_in_type(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case depth == 0 and substring(s, i, i + 1) == "," of {
            true -> i;
            false -> do
                c: string <- substring(s, i, i + 1);
                d2: int64 <- case c == "(" of {
                    true -> depth + 1;
                    false -> case c == ")" of {
                        true -> depth - 1;
                        false -> case c == "{" of {
                            true -> depth + 1;
                            false -> case c == "}" of {
                                true -> depth - 1;
                                false -> case c == "[" of {
                                    true -> depth + 1;
                                    false -> case c == "]" of {
                                        true -> depth - 1;
                                        false -> depth
                                    }
                                }
                            }
                        }
                    }
                };
                supervisor_trait_top_level_comma_in_type(s, i + 1, d2)
            end
        }
    }
}

fn supervisor_init_return_tuple_has_flags_and_children(ret: string) -> bool {
    t: string <- type_checker_traits@trim_type_text(ret);
    case len(t) < 2 of {
        true -> false;
        false -> case substring(t, 0, 1) == "(" and substring(t, len(t) - 1, len(t)) == ")" of {
            false -> false;
            true -> do
                inner: string <- type_checker_traits@trim_type_text(substring(t, 1, len(t) - 1));
                comma_at_top: int64 <- supervisor_trait_top_level_comma_in_type(inner, 0, 0);
                comma_at_top >= 0
            end
        }
    }
}

// §15.4.13.2 fields for Phase E static child table and escalation (substring match on parsed return type text).
// Return-type text arrives tokenized from the parser (token lexemes joined with spaces), so
// field annotations like `strategy :` carry a space before the colon (see SIR `required_fn` dump).
// The old checks used `name:` (no space) and never matched real trait text — hence the rewrite to
// the space-before-colon form that the parser actually produces.
fn supervisor_init_return_has_phase_e_declarative_fields(ret: string) -> bool {
    t: string <- type_checker_traits@trim_type_text(ret);
    case supervisor_string_contains(t, "strategy :") of {
        false -> false;
        true -> case supervisor_string_contains(t, "allowed_restart_count :") of {
            false -> false;
            true -> case supervisor_string_contains(t, "restarts_time_frame :") of {
                false -> false;
                true -> case supervisor_string_contains(t, "List [") or supervisor_string_contains(t, "List[") of {
                    false -> false;
                    true -> case supervisor_string_contains(t, ", normal") or supervisor_string_contains(t, ", mem") of {
                        false -> false;
                        true -> case supervisor_string_contains(t, "id :") of {
                            false -> false;
                            true -> case supervisor_string_contains(t, "agent_type : :worker | :supervisor") of {
                                false -> false;
                                true -> case supervisor_string_contains(t, "initial_state :") of {
                                    false -> false;
                                    true -> case supervisor_string_contains(t, "behavior :") of {
                                        false -> false;
                                        true -> case supervisor_string_contains(t, "restart :") of {
                                            false -> false;
                                            true -> case supervisor_string_contains(t, "shutdown :") of {
                                                false -> false;
                                                true -> supervisor_string_contains(t, "flavor :")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn for_supervisor_impl_suffix() -> string {
    " for Supervisor"
}

fn for_supervisor_phase_a_impl_suffix() -> string {
    " for SupervisorPhaseA"
}

fn string_ends_with_suffix(s: string, suf: string) -> bool {
    ls: int64 <- len(s);
    lf: int64 <- len(suf);
    case ls < lf of { true -> false; false -> substring(s, ls - lf, ls) == suf }
}

// Tag-6 marker: `impl ConcreteActorType for Supervisor;` (sir_generator/declarations/traits.silica).
fn program_has_impl_for_supervisor_loop(decls: ListDeclaration) -> bool {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 6 of {
            true -> do
                t: string <- type_checker_traits@trim_type_text(decls.head.return_type_name);
                case string_ends_with_suffix(t, for_supervisor_impl_suffix()) of {
                    true -> true;
                    false -> program_has_impl_for_supervisor_loop(decls.tail)
                }
            end;
            false -> program_has_impl_for_supervisor_loop(decls.tail)
        }
    }
}

fn program_has_impl_for_supervisor(decls: ListDeclaration) -> bool {
    program_has_impl_for_supervisor_loop(decls)
}

fn collect_supervisor_impl_types_csv_loop(decls: ListDeclaration, acc: string) -> string {
    case decls.is_nil of {
        true -> acc;
        false -> case decls.head.tag == 6 of {
            true -> do
                t: string <- type_checker_traits@trim_type_text(decls.head.return_type_name);
                case string_ends_with_suffix(t, for_supervisor_impl_suffix()) or string_ends_with_suffix(t, for_supervisor_phase_a_impl_suffix()) of {
                    true -> do
                        suffix_len: int64 <- case string_ends_with_suffix(t, for_supervisor_impl_suffix()) of {
                            true -> len(for_supervisor_impl_suffix());
                            false -> len(for_supervisor_phase_a_impl_suffix())
                        };
                        actor_ty: string <- substring(t, 0, len(t) - suffix_len);
                        next: string <- case len(acc) == 0 of {
                            true -> actor_ty;
                            false -> concat(concat(acc, ","), actor_ty)
                        };
                        collect_supervisor_impl_types_csv_loop(decls.tail, next)
                    end;
                    false -> collect_supervisor_impl_types_csv_loop(decls.tail, acc)
                }
            end;
            false -> collect_supervisor_impl_types_csv_loop(decls.tail, acc)
        }
    }
}

fn collect_supervisor_impl_types_csv(decls: ListDeclaration) -> string {
    collect_supervisor_impl_types_csv_loop(decls, "")
}

fn init_decl_has_one_parameter(decl: Declaration) -> bool {
    case decl.name == "init" of {
        false -> false;
        true -> case decl.parameters.is_nil of {
            true -> false;
            false -> decl.parameters.tail.is_nil
        }
    }
}

fn program_has_init_one_loop(decls: ListDeclaration) -> bool {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 0 and init_decl_has_one_parameter(decls.head) of {
            true -> true;
            false -> program_has_init_one_loop(decls.tail)
        }
    }
}

fn first_supervisor_impl_location_loop(decls: ListDeclaration) -> { file: string, line: int64, column: int64, offset: int64 } {
    case decls.is_nil of {
        true -> parser_ast@zero_location();
        false -> case decls.head.tag == 6 of {
            true -> do
                t: string <- type_checker_traits@trim_type_text(decls.head.return_type_name);
                case string_ends_with_suffix(t, for_supervisor_impl_suffix()) of {
                    true -> decls.head.location;
                    false -> first_supervisor_impl_location_loop(decls.tail)
                }
            end;
            false -> first_supervisor_impl_location_loop(decls.tail)
        }
    }
}

fn check_supervisor_impl_has_init_phase_b(decls: ListDeclaration) -> TypeCheckResult {
    case program_has_impl_for_supervisor(decls) of {
        false -> type_checker_core@type_check_ok();
        true -> case program_has_init_one_loop(decls) of {
            true -> type_checker_core@type_check_ok();
            false -> do
                loc: { file: string, line: int64, column: int64, offset: int64 } <- first_supervisor_impl_location_loop(decls);
                type_checker_core@type_check_err("E2092", loc, "impl T for Supervisor requires fn init/1; supervisor init is called only by spawn_registered_supervisor", "sect15.4.13")
            end
        }
    }
}

// When a module defines `impl T for Supervisor` and `fn init(state) -> ...`, the return type must
// name Phase E declarative `supervisor_flags` + `List[child_spec, mem(ρ)|…]` (or legacy `, normal`) fields
// (runtime static table and automatic restart per §15.4.13.1–2).
fn check_supervisor_init_return_type_phase_e_shape(decl: Declaration) -> TypeCheckResult {
    retn: string <- type_checker_traits@trim_type_text(decl.return_type_name);
    case len(retn) > 0 of {
        false -> type_checker_core@type_check_err("E2092", decl.return_type_location, "Supervisor init must declare return type (supervisor_flags, List[child_spec, mem(ρ) | …]); spec §15.4.13.1–§15.4.13.2 (supervisors plan Phase E)", "sect15.4.13.1");
        true -> case supervisor_init_return_tuple_has_flags_and_children(decl.return_type_name) of {
            false -> type_checker_core@type_check_err("E2092", decl.return_type_location, "Supervisor init must return a tuple (supervisor_flags, static child list) per spec §15.4.13.1 (supervisors plan Phase E)", "sect15.4.13.1");
            true -> case supervisor_init_return_has_phase_e_declarative_fields(decl.return_type_name) of {
                false -> type_checker_core@type_check_err("E2092", decl.return_type_location, "Supervisor init return type must include supervisor_flags (strategy, allowed_restart_count, restarts_time_frame) and child_spec fields (id, agent_type: :worker | :supervisor, initial_state, behavior, restart, shutdown, flavor: :plain | :dangerous) in List[..., mem(ρ) | …] or List[..., normal] for automatic restart (supervisors plan Phase B; spec §15.4.13.2)", "sect15.4.13.2");
                true -> type_checker_core@type_check_ok()
            }
        }
    }
}

fn check_init_if_supervisor_impl_phase_e(decl: Declaration, all_decls: ListDeclaration) -> TypeCheckResult {
    case program_has_impl_for_supervisor(all_decls) of {
        false -> type_checker_core@type_check_ok();
        true -> case decl.name == "init" of {
            false -> type_checker_core@type_check_ok();
            true -> case init_decl_has_one_parameter(decl) of {
                false -> type_checker_core@type_check_ok();
                true -> check_supervisor_init_return_type_phase_e_shape(decl)
            }
        }
    }
}

fn supervisor_child_spec_agent_type_initializer_ok(init_e: Expr) -> bool {
    case init_e.kind == 5 of {
        false -> false;
        true -> init_e.value == ":worker" or init_e.value == ":supervisor"
    }
}

// child_spec.agent_type must be a literal :worker or :supervisor (no other atoms, no variables).
fn supervisor_validate_record_field_agent_type(field_e: Expr) -> TypeCheckResult {
    case field_e.name == "agent_type" of {
        false -> type_checker_core@type_check_ok();
        true -> case field_e.inner.kind == 5 of {
            false -> type_checker_core@type_check_err(
                "E2093",
                field_e.location,
                "child_spec agent_type must be a literal :worker or :supervisor (§15.4.13.2 / supervisor child table)",
                "sect15.4.13.2"
            );
            true -> case supervisor_child_spec_agent_type_initializer_ok(field_e.inner) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err(
                    "E2093",
                    field_e.inner.location,
                    concat(concat("invalid child_spec agent_type ", field_e.inner.value), "; only :worker or :supervisor are allowed"),
                    "sect15.4.13.2"
                )
            }
        }
    }
}

// Walk an expression AST and validate every inline record field named agent_type used in supervisor child specs.
fn supervisor_walk_validate_child_spec_agent_type_atoms(expr: Expr) -> TypeCheckResult {
    case expr.kind < 0 of {
        true -> type_checker_core@type_check_ok();
        false -> do
            fld: TypeCheckResult <- case expr.kind == 21 of {
                true -> supervisor_validate_record_field_agent_type(expr);
                false -> type_checker_core@type_check_ok()
            };
            case fld.is_ok of {
                false -> fld;
                true -> case expr.kind == 991 of {
                    true -> supervisor_walk_validate_child_spec_agent_type_atoms(expr.inner);
                    false -> case expr.kind == 992 of {
                        true -> type_checker_core@type_check_ok();
                        false -> do
                            rin: TypeCheckResult <- supervisor_walk_validate_child_spec_agent_type_atoms(expr.inner);
                            case rin.is_ok of {
                                false -> rin;
                                true -> supervisor_walk_validate_child_spec_agent_type_atoms(expr.right_expr)
                            }
                        end
                    }
                }
            }
        end
    }
}

fn validate_supervisor_init_body_literal_agent_types_if_needed(decl: Declaration, all_decls: ListDeclaration) -> TypeCheckResult {
    case program_has_impl_for_supervisor(all_decls) of {
        false -> type_checker_core@type_check_ok();
        true -> case decl.name == "init" of {
            false -> type_checker_core@type_check_ok();
            true -> case init_decl_has_one_parameter(decl) of {
                false -> type_checker_core@type_check_ok();
                true -> supervisor_walk_validate_child_spec_agent_type_atoms(decl.body)
            }
        }
    }
}

fn supervisor_child_spec_flavor_initializer_ok(init_e: Expr) -> bool {
    case init_e.kind == 5 of {
        false -> false;
        true -> init_e.value == ":plain" or init_e.value == ":dangerous"
    }
}

fn supervisor_validate_record_field_flavor(field_e: Expr) -> TypeCheckResult {
    case field_e.name == "flavor" of {
        false -> type_checker_core@type_check_ok();
        true -> case field_e.inner.kind == 5 of {
            false -> type_checker_core@type_check_err(
                "E2094",
                field_e.location,
                "child_spec flavor must be a literal :plain or :dangerous (§15.4.13.2 / supervisor child table)",
                "sect15.4.13.2"
            );
            true -> case supervisor_child_spec_flavor_initializer_ok(field_e.inner) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err(
                    "E2094",
                    field_e.inner.location,
                    concat(concat("invalid child_spec flavor ", field_e.inner.value), "; only :plain or :dangerous are allowed"),
                    "sect15.4.13.2"
                )
            }
        }
    }
}

fn supervisor_walk_validate_child_spec_flavor_atoms(expr: Expr) -> TypeCheckResult {
    case expr.kind < 0 of {
        true -> type_checker_core@type_check_ok();
        false -> do
            fld: TypeCheckResult <- case expr.kind == 21 of {
                true -> supervisor_validate_record_field_flavor(expr);
                false -> type_checker_core@type_check_ok()
            };
            case fld.is_ok of {
                false -> fld;
                true -> case expr.kind == 991 of {
                    true -> supervisor_walk_validate_child_spec_flavor_atoms(expr.inner);
                    false -> case expr.kind == 992 of {
                        true -> type_checker_core@type_check_ok();
                        false -> do
                            rin: TypeCheckResult <- supervisor_walk_validate_child_spec_flavor_atoms(expr.inner);
                            case rin.is_ok of {
                                false -> rin;
                                true -> supervisor_walk_validate_child_spec_flavor_atoms(expr.right_expr)
                            }
                        end
                    }
                }
            }
        end
    }
}

fn validate_supervisor_init_body_literal_flavor_if_needed(decl: Declaration, all_decls: ListDeclaration) -> TypeCheckResult {
    case program_has_impl_for_supervisor(all_decls) of {
        false -> type_checker_core@type_check_ok();
        true -> case decl.name == "init" of {
            false -> type_checker_core@type_check_ok();
            true -> case init_decl_has_one_parameter(decl) of {
                false -> type_checker_core@type_check_ok();
                true -> supervisor_walk_validate_child_spec_flavor_atoms(decl.body)
            }
        }
    }
}

fn find_atom_field_in_record_chain(field_chain: Expr, field_name: string) -> string {
    case field_chain.kind == 21 of {
        false -> "";
        true -> case field_chain.name == field_name of {
            true -> case field_chain.inner.kind == 5 of {
                true -> field_chain.inner.value;
                false -> ""
            };
            false -> find_atom_field_in_record_chain(field_chain.right_expr, field_name)
        }
    }
}

fn find_fn_ref_name_in_record_chain(field_chain: Expr, field_name: string) -> string {
    case field_chain.kind == 21 of {
        false -> "";
        true -> case field_chain.name == field_name of {
            true -> case field_chain.inner.kind == 1 of {
                true -> field_chain.inner.name;
                false -> ""
            };
            false -> find_fn_ref_name_in_record_chain(field_chain.right_expr, field_name)
        }
    }
}

fn find_field_location_in_record_chain(field_chain: Expr, field_name: string) -> { file: string, line: int64, column: int64, offset: int64 } {
    case field_chain.kind == 21 of {
        false -> parser_ast@zero_location();
        true -> case field_chain.name == field_name of {
            true -> field_chain.location;
            false -> find_field_location_in_record_chain(field_chain.right_expr, field_name)
        }
    }
}

fn find_fn_return_type_in_decls(decls: ListDeclaration, fn_name: string) -> string {
    case decls.is_nil of {
        true -> "";
        false -> case decls.head.tag == 0 and decls.head.name == fn_name of {
            true -> decls.head.return_type_name;
            false -> find_fn_return_type_in_decls(decls.tail, fn_name)
        }
    }
}

fn starts_with_dangerous_prefix(s: string) -> bool {
    len(s) >= 11 and substring(s, 0, 11) == ":dangerous_"
}

fn validate_dangerous_child_spec_record(field_chain: Expr, decls: ListDeclaration) -> TypeCheckResult {
    flavor: string <- find_atom_field_in_record_chain(field_chain, "flavor");
    case flavor == ":dangerous" of {
        false -> type_checker_core@type_check_ok();
        true -> do
            id_val: string <- find_atom_field_in_record_chain(field_chain, "id");
            case starts_with_dangerous_prefix(id_val) of {
                false -> do
                    id_loc: { file: string, line: int64, column: int64, offset: int64 } <- find_field_location_in_record_chain(field_chain, "id");
                    type_checker_core@type_check_err(
                        "E2094",
                        id_loc,
                        concat(concat("child_spec with flavor :dangerous requires id starting with :dangerous_; got ", id_val), " (§15.4.13.2)"),
                        "sect15.4.13.2"
                    )
                end;
                true -> do
                    beh_fn_name: string <- find_fn_ref_name_in_record_chain(field_chain, "behavior");
                    case len(beh_fn_name) == 0 of {
                        true -> type_checker_core@type_check_ok();
                        false -> do
                            ret_type: string <- find_fn_return_type_in_decls(decls, beh_fn_name);
                            case len(ret_type) == 0 of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_expressions_actors@behavior_return_is_cast_only(ret_type) of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> do
                                        beh_loc: { file: string, line: int64, column: int64, offset: int64 } <- find_field_location_in_record_chain(field_chain, "behavior");
                                        type_checker_core@type_check_err(
                                            "E2095",
                                            beh_loc,
                                            "child_spec with flavor :dangerous requires a cast-type behavior returning (:no_reply, State); reply-type behaviors are not allowed for dangerous children (§15.4.13.2)",
                                            "sect15.4.13.2"
                                        )
                                    end
                                }
                            }
                        end
                    }
                end
            }
        end
    }
}

fn is_child_spec_record_chain(field_chain: Expr) -> bool {
    len(find_atom_field_in_record_chain(field_chain, "agent_type")) > 0
        and len(find_atom_field_in_record_chain(field_chain, "flavor")) > 0
}

fn supervisor_walk_validate_dangerous_flavor_constraints(expr: Expr, decls: ListDeclaration) -> TypeCheckResult {
    case expr.kind < 0 of {
        true -> type_checker_core@type_check_ok();
        false -> do
            cross: TypeCheckResult <- case expr.kind == 21 and expr.name == "id" of {
                true -> case is_child_spec_record_chain(expr) of {
                    true -> validate_dangerous_child_spec_record(expr, decls);
                    false -> type_checker_core@type_check_ok()
                };
                false -> type_checker_core@type_check_ok()
            };
            case cross.is_ok of {
                false -> cross;
                true -> case expr.kind == 991 of {
                    true -> supervisor_walk_validate_dangerous_flavor_constraints(expr.inner, decls);
                    false -> case expr.kind == 992 of {
                        true -> type_checker_core@type_check_ok();
                        false -> do
                            rin: TypeCheckResult <- supervisor_walk_validate_dangerous_flavor_constraints(expr.inner, decls);
                            case rin.is_ok of {
                                false -> rin;
                                true -> supervisor_walk_validate_dangerous_flavor_constraints(expr.right_expr, decls)
                            }
                        end
                    }
                }
            }
        end
    }
}

fn validate_supervisor_init_body_dangerous_flavor_constraints_if_needed(decl: Declaration, all_decls: ListDeclaration, decls_for_lookup: ListDeclaration) -> TypeCheckResult {
    case program_has_impl_for_supervisor(all_decls) of {
        false -> type_checker_core@type_check_ok();
        true -> case decl.name == "init" of {
            false -> type_checker_core@type_check_ok();
            true -> case init_decl_has_one_parameter(decl) of {
                false -> type_checker_core@type_check_ok();
                true -> supervisor_walk_validate_dangerous_flavor_constraints(decl.body, decls_for_lookup)
            }
        }
    }
}
