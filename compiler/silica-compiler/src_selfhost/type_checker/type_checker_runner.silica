// Type checker runner - type_check_program, orchestration
// Two-pass: add all declarations to symbol table, then check all bodies
// Handles tag 0 (functions), tag 1 (effects), tag 2 (use), tag 3 (export), tag 4 (module) via type_checker_modules.

use parser_ast;
use type_checker_core;
use type_checker_declarations_functions;
use type_checker_failure_reporter;
use type_checker_modules;
use type_checker_supervisor;

export type_check_program/2;
export type_check_program_with_module_world/4;
export type_check_program_with_world_bundle/4;
export module_world_typecheck_outcome/4;

// First pass: single-file (no imports). use/export/module decls are skipped except local functions and effects.
fn add_all_declarations(decls: ListDeclaration, context: TypeContext) -> TypeContext {
    case decls.is_nil of {
        true -> context;
        false -> case decls.head.tag of {
            0 -> {
                ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- type_checker_declarations_functions@add_function(decls.head, context);
                add_all_declarations(decls.tail, ctx)
            };
            1 -> {
                new_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- type_checker_core@add_effect_alias_symbol(context.env, decls.head.name, decls.head.declared_effects);
                ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- type_checker_core@type_context_with_env(context, new_env);
                add_all_declarations(decls.tail, ctx)
            };
            _: int64 -> add_all_declarations(decls.tail, context)
        }
    }
}

// Second pass: check all function bodies, stop on first error (`world` empty when no cross-module trait modules).
// `all_program_decls` is the full declaration list (needed for Supervisors Phase E: `impl … for Supervisor` + `init`).
fn check_all_declarations(decls: ListDeclaration, all_program_decls: ListDeclaration, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case decls.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case decls.head.tag of {
            0 -> {
                phe: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_supervisor@check_init_if_supervisor_impl_phase_e(decls.head, all_program_decls);
                case phe.is_ok of {
                    false -> phe;
                    true -> {
                        result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_declarations_functions@check_body(decls.head, context, world);
                        case result.is_ok of {
                            true -> {
                                sup_lit: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_supervisor@validate_supervisor_init_body_literal_agent_types_if_needed(decls.head, all_program_decls);
                                case sup_lit.is_ok of {
                                    false -> sup_lit;
                                    true -> {
                                        sup_flav: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_supervisor@validate_supervisor_init_body_literal_flavor_if_needed(decls.head, all_program_decls);
                                        case sup_flav.is_ok of {
                                            false -> sup_flav;
                                            true -> {
                                                sup_dang: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_supervisor@validate_supervisor_init_body_dangerous_flavor_constraints_if_needed(decls.head, all_program_decls, all_program_decls);
                                                case sup_dang.is_ok of {
                                                    false -> sup_dang;
                                                    true -> check_all_declarations(decls.tail, all_program_decls, context, world)
                                                }
                                            }
                                        }
                                    }
                                }
                            };
                            false -> result
                        }
                    }
                }
            };
            _: int64 -> check_all_declarations(decls.tail, all_program_decls, context, world)
        }
    }
}

// Type-check program (single compilation unit, no cross-module world). Skips use/export/module for symbol table.
fn type_check_program(program: Program, context: TypeContext) -> (TypeCheckResult, TypeContext) proc[DeviceIO] {
    fr: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_failure_reporter@check_failure_reporter_export_trait(program);
    case fr.is_ok of {
        false -> (fr, context);
        true -> {
            ctx_with_decls: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- add_all_declarations(program.declarations, context);
            sup_csv: string <- type_checker_supervisor@collect_supervisor_impl_types_csv(program.declarations);
            ctx_with_sup: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- type_checker_core@type_context_with_supervisor_types(ctx_with_decls, sup_csv);
            empty_world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)] <- parser_ast@empty_named_program_list();
            sup_init: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_supervisor@check_supervisor_impl_has_init_phase_b(program.declarations);
            case sup_init.is_ok of {
                false -> (sup_init, ctx_with_sup);
                true -> {
                    result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_all_declarations(program.declarations, program.declarations, ctx_with_sup, empty_world);
                    (result, ctx_with_sup)
                }
            }
        }
    }
}

// Multi-module: `current_module` is filename stem (e.g. main); `world` lists other modules' ASTs. Validates §19 use/export/module.
fn type_check_program_with_module_world(program: Program, current_module: string, world: ListNamedProgram, context: TypeContext) -> (TypeCheckResult, TypeContext) proc[DeviceIO] {
    type_checker_modules@type_check_program_with_modules(program, current_module, world, context)
}

fn type_check_program_with_world_bundle(program: Program, current_module: string, world: ListNamedProgram, context: TypeContext) -> TypeCheckWithContext proc[DeviceIO] {
    type_checker_modules@type_check_program_with_modules_world_bundle(program, current_module, world, context)
}

fn module_world_typecheck_outcome(program: Program, current_module: string, world: ListNamedProgram, context: TypeContext) -> ModuleTypecheckOutcome proc[DeviceIO] {
    type_checker_modules@type_check_program_with_modules_outcome(program, current_module, world, context)
}
