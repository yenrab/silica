L_sc_rel_loop:
    CBZ X19, L_sc_rel_done
    LDR X21, [X19]
    LDR X1, [X19, #8]
    MOV X0, X19
    MOVZ X16, #73
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    MOV X19, X21
