            true -> type_checker_expressions_print_negate@check_print_call(expr, "int32", expected_type, context, world, check_surface, check_typed);
            false -> case type_checker_expressions_helpers@expr_name(expr) == "print_int16" of {
                true -> type_checker_expressions_print_negate@check_print_call(expr, "int16", expected_type, context, world, check_surface, check_typed);
                false -> case type_checker_expressions_helpers@expr_name(expr) == "print_int8" of {
                    true -> type_checker_expressions_print_negate@check_print_call(expr, "int8", expected_type, context, world, check_surface, check_typed);
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint64" of {
                        true -> type_checker_expressions_print_negate@check_print_call(expr, "uint64", expected_type, context, world, check_surface, check_typed);
                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint32" of {
                            true -> type_checker_expressions_print_negate@check_print_call(expr, "uint32", expected_type, context, world, check_surface, check_typed);
                            false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint16" of {
                                true -> type_checker_expressions_print_negate@check_print_call(expr, "uint16", expected_type, context, world, check_surface, check_typed);
                                false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint8" of {
                                    true -> type_checker_expressions_print_negate@check_print_call(expr, "uint8", expected_type, context, world, check_surface, check_typed);
                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "print_bool" of {
                                        true -> {
                                            (arg_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "boolean", context, world);
                                            case arg_result.is_ok of {
                                                false -> arg_result;
                                                true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                    "boolean" -> type_checker_core@type_check_ok();
                                                    "atom" -> type_checker_core@type_check_ok();
                                                    "discard" -> type_checker_core@type_check_ok();
                                                    _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("print_bool expects boolean or atom result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                }
                                            }
                                        };
                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_atom" of {
                                            true -> {
                                                (arg_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "atom", context, world);
                                                case arg_result.is_ok of {
                                                    false -> arg_result;
                                                    true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                        "atom" -> type_checker_core@type_check_ok();
                                                        "discard" -> type_checker_core@type_check_ok();
                                                        _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("print_atom expects atom result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                    }
                                                }
                                            };
                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "atom_bits" of {
                                                true -> {
                                                    (ra, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "atom", context, world);
                                                    case ra.is_ok of {
                                                        false -> ra;
                                                        true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                            "int64" -> type_checker_core@type_check_ok();
                                                            "discard" -> type_checker_core@type_check_ok();
                                                            _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("atom_bits expects int64 result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                        }
                                                    }
                                                };
                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "actor_ref_bits" of {
                                                    true -> {
                                                        (rr, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "actor_ref", context, world);
                                                        case rr.is_ok of {
                                                            false -> rr;
                                                            true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                                "int64" -> type_checker_core@type_check_ok();
                                                                "discard" -> type_checker_core@type_check_ok();
                                                                _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("actor_ref_bits expects int64 result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                            }
                                                        }
                                                    };
                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "actor_ref_of_word" of {
                                                        true -> {
                                                            (rw, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "int64", context, world);
                                                            case rw.is_ok of {
                                                                false -> rw;
                                                                true -> case type_checker_expressions_helpers@expect_surf(context, expected_type) of {
                                                                    "actor_ref" -> type_checker_core@type_check_ok();
                                                                    "discard" -> type_checker_core@type_check_ok();
                                                                    _: string -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("actor_ref_of_word expects actor_ref result, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect6")
                                                                }
                                                            }
                                                        };
                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_float64" of {
                                                            true -> type_checker_expressions_print_negate@check_print_call(expr, "float64", expected_type, context, world, check_surface, check_typed);
                                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "print_float32" of {
                                                                true -> {
                                                                    (arg_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "float32", context, world);
                                                                    type_checker_expressions_float32_calls@check_print_float32_call(expr, expected_type, context, arg_result)
                                                                };
                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "print_float16" of {
                                                                    true -> {
                                                                        (arg_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "float16", context, world);
                                                                        type_checker_expressions_float32_calls@check_print_float32_call(expr, expected_type, context, arg_result)
                                                                    };
                                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "print_string" of {
                                                                        true -> type_checker_expressions_print_negate@check_print_call(expr, "string", expected_type, context, world, check_surface, check_typed);
                                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print" of {
                                                                        true -> type_checker_expressions_print_negate@check_print_call(expr, "string", expected_type, context, world, check_surface, check_typed);
                                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "println" of {
                                                                        true -> type_checker_expressions_print_negate@check_print_call(expr, "string", expected_type, context, world, check_surface, check_typed);
                                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_string_stderr" of {
                                                                            true -> type_checker_expressions_print_negate@check_print_call(expr, "string", expected_type, context, world, check_surface, check_typed);
                                                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "println_stderr" of {
                                                                                true -> type_checker_expressions_print_negate@check_print_call(expr, "string", expected_type, context, world, check_surface, check_typed);
                                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "read_lines" of {
                                                                                    true -> {
                                                                                        (rl, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                        type_checker_expressions_string_calls@check_read_lines_call(expr, expected_type, context, rl)
                                                                                    };
                                                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "file_exists" of {
                                                                                        true -> {
                                                                                            (fe, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                            type_checker_expressions_string_calls@check_file_exists_call(expr, expected_type, context, fe)
                                                                                        };
                                                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "delete_file" of {
                                                                                            true -> {
                                                                                                (df, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                                type_checker_expressions_string_calls@check_delete_file_call(expr, expected_type, context, df)
                                                                                            };
                                                                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "append_file" of {
                                                                                                true -> {
                                                                                                    (af1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                                    (af2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string", context, world);
                                                                                                    type_checker_expressions_string_calls@check_append_file_call(expr, expected_type, context, af1, af2)
                                                                                                };
                                                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "concat" of {
                                                                            true -> {
                                                                                (a1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                (a2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string", context, world);
                                                                                type_checker_expressions_string_calls@check_concatenate_call(expr, expected_type, context, a1, a2)
                                                                            };
                                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "concatenate" of {
                                                                                true -> {
                                                                                    (a1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                    (a2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string", context, world);
                                                                                    type_checker_expressions_string_calls@check_concatenate_call(expr, expected_type, context, a1, a2)
                                                                                };
                                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "substring" of {
                                                                                    true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                                                                                        true -> {
                                                                                            (s1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                            (s2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "int64", context, world);
                                                                                            (s3, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))), "int64", context, world);
                                                                                            type_checker_expressions_string_calls@check_substring_call(expr, expected_type, context, s1, s2, s3)
                                                                                        };
                                                                                        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "substring requires 3 arguments: (s: string, start: int64, end: int64)", "sect6")
                                                                                    };
                                                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "substring_until_char" of {
                                                                                        true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                                                                                            true -> {
                                                                                                (u1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                                (u2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "int64", context, world);
                                                                                                (u3, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))), "char", context, world);
                                                                                                type_checker_expressions_string_calls@check_substring_until_char_call(expr, expected_type, context, u1, u2, u3)
                                                                                            };
                                                                                            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "substring_until_char requires 3 arguments: (s: string, start: int64, char: char)", "sect6")
                                                                                        };
                                                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "length_bytes" of {
                                                                                            true -> {
                                                                                                (lb, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                                type_checker_expressions_string_calls@check_length_bytes_call(expr, expected_type, context, lb)
                                                                                            };
                                                                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "length_chars" of {
                                                                                                    true -> {
                                                                                                        (lc, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                                        type_checker_expressions_string_calls@check_length_chars_call(expr, expected_type, context, lc)
                                                                                                    };
                                                                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "starts_with" or type_checker_expressions_helpers@expr_name(expr) == "ends_with" or type_checker_expressions_helpers@expr_name(expr) == "contains" of {
                                                                                                        true -> {
                                                                                                            (p1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                                                                                                            (p2, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string", context, world);
                                                                                                            type_checker_expressions_string_calls@check_string_predicate_call(expr, expected_type, context, p1, p2)
                                                                                                        };
                                                                                                    false -> case type_checker_lists@is_list_primitive_name(type_checker_expressions_helpers@expr_name(expr)) of {
                                                                                                        true -> type_checker_expressions_control_and_data@check_list_primitive_call(expr, expected_type, context, world, check_surface, check_typed);
                                                                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "core_id" or type_checker_expressions_helpers@expr_name(expr) == "core_set" of {
                                                                                                            true -> type_checker_expressions_actor_spawn@check_spawn_affinity_constructor_call(expr, expected_type, context, world, check_surface, check_typed);
                                                                                                            false -> check_user(expr, expected_type, context, world, check_surface, check_typed)
                                                                                                        }
                                                                                                    }
                                                                                                    }
                                                                                                }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                    }
                                                                }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
