            false -> type_checker_core@type_check_err("E2005", case_loc, "malformed case branch list", "sect3")
        }
    }
}

fn check_case_boolean_exhaustive(branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, scrutinee_type: string, case_loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case scrutinee_type == "boolean" of {
        false -> type_checker_core@type_check_ok();
        true -> {
            cov: { has_true: int64, has_false: int64, has_wild: int64 } <- type_checker_tuple_decompose_helpers@case_scan_bool_coverage(branches, scrutinee_type);
            case type_checker_tuple_decompose_helpers@case_bool_coverage_ok(cov) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2005", case_loc, "case on boolean must cover true and false or include a wildcard branch (_ : boolean)", "sect3")
            }
        }
    }
}

