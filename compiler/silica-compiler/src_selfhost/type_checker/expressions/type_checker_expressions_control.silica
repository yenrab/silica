// Case and if expression checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_lists;
use type_checker_record_types;

export check_case_expression/6;
export check_if_expression/6;

fn expr_references_name(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, name: string) -> bool {
    case type_checker_expressions_helpers@expr_kind(e) < 0 of {
        true -> false;
        false -> case type_checker_expressions_helpers@expr_kind(e) of {
            0 -> false;
            1 -> type_checker_expressions_helpers@expr_name(e) == name;
            2 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name);
            3 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            4 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            5 -> false;
            6 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            7 -> false;
            8 -> false;
            9 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            10 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name);
            11 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            12 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name);
            13 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            19 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(e)), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(e)), name);
            20 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            _: int64 -> false
        }
    }
}

fn case_record_guard_refs_any(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pat_str: string, scrutinee_type: string) -> bool {
    inner: string <- type_checker_record_types@record_case_inner_body(pat_str);
    case_record_guard_refs_loop(branch, inner, scrutinee_type)
}

fn case_record_guard_refs_loop(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rem: string, scrutinee_type: string) -> bool {
    (seg: string, rest2: string) <- type_checker_record_types@record_case_field_step(rem);
    case length_bytes(seg) == 0 of {
        true -> false;
        false -> {
            (fname: string, sub: string) <- type_checker_record_types@record_field_segment_name_sub(seg);
            case length_bytes(fname) == 0 of {
                true -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                false -> {
                    fty: string <- type_checker_record_types@find_field_type_in_record(scrutinee_type, fname);
                    case length_bytes(fty) == 0 of {
                        true -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                        false -> {
                            spi: { is_valid: bool, pattern_kind: int64, bool_lit: bool, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string } <- type_checker_tuple_decompose_helpers@case_parse_record_field_subpat(sub, fty);
                            case spi.is_valid of {
                                false -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                                true -> case spi.pattern_kind of {
                                    2 -> case expr_references_name(type_checker_expressions_helpers@expr_child_inner(branch), spi.bind_name) of {
                                        true -> true;
                                        false -> case_record_guard_refs_loop(branch, rest2, scrutinee_type)
                                    };
                                    8 -> case case_record_guard_refs_any(branch, spi.bind_type, fty) of {
                                        true -> true;
                                        false -> case_record_guard_refs_loop(branch, rest2, scrutinee_type)
                                    };
                                    _: int64 -> case_record_guard_refs_loop(branch, rest2, scrutinee_type)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn case_list_cons_guard_ok_expr(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pi: { is_valid: bool, pattern_kind: int64, bool_lit: bool, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string }) -> bool {
    head_bound: bool <- length_bytes(pi.bind_name) > 0 and pi.bind_name != "_";
    tail_bound: bool <- length_bytes(pi.list_tail_name) > 0 and pi.list_tail_name != "_";
    case head_bound of {
        false -> case tail_bound of {
            false -> true;
            true -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(branch), pi.list_tail_name)
        };
        true -> case tail_bound of {
            false -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(branch), pi.bind_name);
            true -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(branch), pi.bind_name) or expr_references_name(type_checker_expressions_helpers@expr_child_inner(branch), pi.list_tail_name)
        }
    }
}

fn check_case_guard_invariant(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pi: { is_valid: bool, pattern_kind: int64, bool_lit: bool, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string }, scrutinee_type: string) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_tuple_decompose_helpers@case_pattern_has_named_binding(pi, scrutinee_type) of {
        true -> case pi.pattern_kind of {
            6 -> case case_list_cons_guard_ok_expr(branch, pi) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", type_checker_expressions_helpers@expr_loc(type_checker_expressions_helpers@expr_child_inner(branch)), "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            };
            8 -> case case_record_guard_refs_any(branch, pi.bind_type, scrutinee_type) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", type_checker_expressions_helpers@expr_loc(type_checker_expressions_helpers@expr_child_inner(branch)), "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            };
            _: int64 -> case expr_references_name(type_checker_expressions_helpers@expr_child_inner(branch), type_checker_tuple_decompose_helpers@case_pattern_binding_name(pi)) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", type_checker_expressions_helpers@expr_loc(type_checker_expressions_helpers@expr_child_inner(branch)), "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            }
        };
        false -> type_checker_core@type_check_err("E2014", type_checker_expressions_helpers@expr_loc(type_checker_expressions_helpers@expr_child_inner(branch)), "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
    }
}

fn check_case_branch_guard(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pi: { is_valid: bool, pattern_kind: int64, bool_lit: bool, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string }, ext_ctx: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, scrutinee_type: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, r