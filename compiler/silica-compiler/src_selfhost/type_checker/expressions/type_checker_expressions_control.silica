                rest: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- type_checker_expressions_helpers@expr_child_right(branches);
                r: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_one_case_branch(b, scrutinee_type, expected_type, context, world, check_surface, check_typed);
                case r.is_ok of {
                    false -> r;
                    true -> check_case_branch_list(rest, scrutinee_type, expected_type, context, case_loc, world, check_surface, check_typed)
