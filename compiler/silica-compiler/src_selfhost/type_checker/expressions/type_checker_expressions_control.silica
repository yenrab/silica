        false -> rc;
        true -> {
            (rt, _) <- check_typed(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), expected_type, context, world);
            case rt.is_ok of {
                false -> rt;
                true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))) < 0 of {
                    true -> type_checker_core@type_check_ok();
                    false -> {
                        (r, _) <- check_typed(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr)), expected_type, context, world);
                        r
                    }
                }
            }
        }
    }
}
