ss | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 of {
        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "call expects 2 arguments: (actor_ref, message) §16.1.1", "sect16");
