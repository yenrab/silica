    MOVK X16, #0x200, LSL #16
    SVC #0x80
    CMN X0, #1
    B.EQ L_sc_bump_fail
    ADRP X2, L_sc_arena_head@PAGE
    ADD X2, X2, L_sc_arena_head@PAGEOFF
    LDR X3, [X2]
    STR X3, [X0]
    STR X21, [X0, #8]
    STR X0, [X2]
    ADD X1, X0, #16
    ADD X3, X1, X19
    STR X3, [X20]
    ADRP X2, L_sc_arena_end@PAGE
    ADD X2, X2, L_sc_arena_end@PAGEOFF
    ADD X3, X0, X21
    STR X3, [X2]
    MOV X0, X1
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_sc_bump_fail:
    MOV X0, #0
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_sc_arena_mark:
    ADRP X16, L_sc_arena_ptr@PAGE
    ADD X16, X16, L_sc_arena_ptr@PAGEOFF
    LDR X16, [X16]
    ADRP X17, L_sc_arena_head@PAGE
    ADD X17, X17, L_sc_arena_head@PAGEOFF
    LDR X17, [X17]
    RET
L_sc_arena_release_to:
    STP X29, X30, [SP, #-16]!
    STP X0, X1, [SP, #-16]!
    STP X2, X3, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X16
    MOV X20, X17
    ADRP X3, L_sc_arena_head@PAGE
    ADD X3, X3, L_sc_arena_head@PAGEOFF
    LDR X2, [X3]
L_sc_rt_loop:
    CMP X2, X20
    B.EQ L_sc_rt_done
    CBZ X2, L_sc_rt_done
    LDR X0, [X2]
    STR X0, [X3]
    LDR X1, [X2, #8]
    MOV X0, X2
    MOVZ X16, #73
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    ADRP X3, L_sc_arena_head@PAGE
    ADD X3, X3, L_sc_arena_head@PAGEOFF
    LDR X2, [X3]
    B L_sc_rt_loop
L_sc_rt_done:
    ADRP X0, L_sc_arena_ptr@PAGE
    ADD X0, X0, L_sc_arena_ptr@PAGEOFF
    STR X19, [X0]
    CBZ X20, L_sc_rt_noend
    LDR X1, [X20, #8]
    ADD X1, X20, X1
    ADRP X0, L_sc_arena_end@PAGE
    ADD X0, X0, L_sc_arena_end@PAGEOFF
    STR X1, [X0]
    B L_sc_rt_caches
L_sc_rt_noend:
    ADRP X0, L_sc_arena_end@PAGE
    ADD X0, X0, L_sc_arena_end@PAGEOFF
    STR XZR, [X0]
L_sc_rt_caches:
    ADRP X0, L_sc_len_key@PAGE
    ADD X0, X0, L_sc_len_key@PAGEOFF
    STR XZR, [X0]
    ADRP X0, L_sc_len_val@PAGE
    ADD X0, X0, L_sc_len_val@PAGEOFF
    STR XZR, [X0]
    LDP X19, X20, [SP], #16
    LDP X2, X3, [SP], #16
    LDP X0, X1, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_sc_arena_release:
    STP X19, X30, [SP, #-32]!
    STP X20, X21, [SP, #16]
    ADRP X20, L_sc_arena_head@PAGE
    ADD X20, X20, L_sc_arena_head@PAGEOFF
