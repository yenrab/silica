    MOV X0, X1
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_sc_bump_fail:
    MOV X0, #0
    LDP X20, X21, [SP, #16]
    LDP X19, X30, [SP], #32
    RET
L_sc_arena_mark:
    ADRP X16, L_sc_arena_ptr@PAGE
