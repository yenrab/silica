ogram: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    // Module-qualified calls (spec §19.3.2): use first_at in this TU. Routing via
    // type_checker_core@call_name_is_module_qualified misclassified on bootstrap (deep builtin chain / stack).
    // Supervisors Phase A: `spawn` / `spawn_linked` are intrinsics (§15.4.8.3); module@spawn_linked must type-check like the unqualified form.
    case type_checker_expressions_user_call_helpers@first_at_in_expr_call_name(type_checker_expressions_helpers@expr_name(expr), 0) >= 0 of {
        true -> {
            base: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
            case base == "spawn" or base == "spawn_dangerous" or base == "spawn_registered" or base == "spawn_dangerous_registered" or base == "spawn_registered_supervisor" or base == "spawn_linked" or base == "call_supervisor" or base == "add_child" or base == "link" or base == "monitor" or base == "demonitor" or base == "supervision_ingress_enqueue" or base == "supervision_wait_and_drain_one" or base == "failure_reason_tag" or base == "failure_reason_atom" or base == "failure_agent_type" or base == "failure_release" or base == "start_child" or base == "child_table_first_ref" or base == "child_table_row_ref" or base == "kill_abnormal" or base == "wait_for_exit" or base == "get_registry_actor" or base == "get_pid_registry" or base == "call_registered" or base == "cast_registered" or base == "cast_dangerous_registered" of {
                true -> type_checker_expressions_actor_concurrency@check_actor_concurrency_call(expr, expected_type, context, world, check_surface, check_typed);
                false -> check_user_defined_call(expr, expected_type, context, world, check_surface, check_typed)
            }
        };
        false -> type_checker_expressions_call_builtins@check_call_builtins_dispatch(expr, expected_type, context, world, check_surface, check_typed, check_user_defined_call)
    }
}

// User-defined function call: lookup in symbol table, parse function type "(T1,T2) -> R", check args and result
// Top-level `->` only: parameter types may contain nested `fn(...) -> ...`; naive substring match on ` -> ` splits there first.

