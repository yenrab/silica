    case type_checker_expressions_user_call_helpers@list_param_length_call(decl.parameters) == type_checker_expressions_user_call_helpers@list_param_length_call(conc_decl_order) of {
        false -> type_checker_core@type_check_err("E2005", decl.location, "internal: call-site parameter type list length mismatch", "sect6");
        true -> {
            (pass1: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, ctx_callee: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) <- type_checker_callee_env@add_all_declarations_with_world(callee_prog.declarations, callee_prog.declarations, type_checker_core@create_type_context(), world, callee_mod_id);
            case pass1.is_ok of {
                false -> pass1;
                true -> {
                    dp: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@param_list_normalize(decl.parameters);
                    cp: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@param_list_normalize(conc_decl_order);
                    ctx_params: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } <- type_checker_core@add_params_concrete_loop1({ decl_params: dp, concrete_types: cp, base: ctx_callee });
                    ret_rec: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_expressions_user_call_resolve@validate_callsite_return_record_type(decl.return_type_name, decl.return_type_location);
                    case ret_rec.is_ok of {
                        false -> ret_rec;
                        true -> case decl.return_type_name == "unit" of {
                            true -> type_checker_core@type_check_err("E2006", decl.return_type_location, "unit is not a valid return type", "sect4");
                            false -> case type_checker_memory_regions@is_memory_region_type(decl.return_type_name) of {
                                true -> {
                                    mem_result: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_memory_regions@validate_memory_region_type(decl.return_type_name, decl.return_type_location);
                                    case mem_result.is_ok of {
                                        false -> mem_result;
                                        true -> {
                    (r, _) <- check_surface(decl.body, decl.return_type_name, ctx_params, world);
                    r
                }
                                    }
                                };
                                false -> {
                    (r, _) <- check_surface(decl.body, decl.return_type_name, ctx_params, world);
                    r
                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// §19.3.2: for `module@fn(args)`, resolve callee in `world` (includes the current module). Overloads share name/arity; pick by inferred first-argument type, then required trait signature (tag 7), then first tag-0 match.

fn check_user_call_result_user_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, return_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    exp_surf: string <- type_checker_expressions_helpers@expect_surf(context, expected_type);
    receiver_resolved_return: string <- type_checker_collections@resolve_constructor_call_formal(exp_surf, return_type);
    resolved_return: string <- type_checker_collections@resolve_accumulator_call_formal(exp_surf, receiver_resolved_return);
    constructor_module: string <- type_checker_collections@module_name_from_qualified_call(type_checker_expressions_helpers@expr_name(expr));
    registered_collection_constructor: bool <- type_checker_collections@is_collection_constructor_base_name(type_checker_expressions_helpers@expr_name(expr)) and type_checker_collections@is_registered_construction_module(constructor_module);
    ret_ids_match: bool <- type_checker_expressions_helpers@surface_type_matches_expected(context, resolved_return, expected_type);
    lists_match: bool <- type_checker_lists@list_types_compatible(exp_surf, resolved_return);
    case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
        true -> type_checker_core@type_check_ok();
        false -> case ret_ids_match or lists_match of {
            true -> type_checker_core@type_check_ok();
            false -> case type_checker_collections@is_collection_trait_type(exp_surf) of {
            true -> case type_checker_collections@collection_return_accepts_constructor(exp_surf, resolved_return, world) of {
                false -> type_checker_core@type_check_err("E2017", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat(type_checker_expressions_helpers@expr_name(expr), " return type does not witness declared collection type "), exp_surf), " (got "), concat(resolved_return, ")")), "sect4");
                true -> type_checker_core@type_check_ok()
            };
            false -> case registered_collection_constructor and type_checker_collections@runtime_record_accepts_constructor_return(exp_surf, resolved_return, world) of {
                true -> type_checker_core@type_check_ok();
                false -> case type_checker_lists@formal_type_accepts_actual(resolved_return, exp_surf, world) of {
                    true -> type_checker_core@type_check_ok();
                    false -> case type_checker_lists@formal_type_accepts_actual(exp_surf, resolved_return, world) of {
                        true -> type_checker_core@type_check_ok();
                        false -> case type_checker_lists@types_equal_strip(exp_surf, resolved_return) of {
                            true -> type_checker_core@type_check_ok();
                            false -> case type_checker_expressions_user_call_helpers@trim_leading_user_call(exp_surf) == "string" and type_checker_expressions_user_call_helpers@return_type_has_ptr_len_out_fields(resolved_return) of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_traits@actual_type_satisfies_trait_expectation(resolved_return, exp_surf, world) of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat(type_checker_expressions_helpers@expr_name(expr), " returns "), resolved_return), ", expected "), exp_surf), "sect6")
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }
}

fn check_user_call_args_recursive(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, params_inner: string, expected_type: int64, return_type: string, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], check_surface: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == -1 of {
        true -> case len(params_inner) == 0 of {
            true -> check_user_call_result_user_call(call_expr, expected_type, return_type, context, world);
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6")
        };
        false -> {
            (first_param: string, rest_params: string) <- type_checker_expressions_user_call_helpers@get_first_param_type(params_inner);
            case len(first_param) == 0 of {
                true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6");
                false -> {
                    arg_inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
                    formal_bind: string <- case type_checker_collections@is_collection_trait_type(type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                        true -> type_checker_expressions_helpers@expect_surf(context, expected_type);
                        false -> case type_checker_collections@bind_type_has_collection_runtime_fields(type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                            true -> type_checker_expressions_helpers@expect_surf(context, expected_type);
                            false -> case len(arg_inferred) > 0 of {
                                true -> arg_inferred;
                                false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
                            }
                        }
                    };
                    resolved_param: string <- type_checker_collections@resolve_constructor_call_formal(formal_bind, first_param);
                    (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), resolved_param, context, world);
                    case r1.is_ok of {
                        false -> r1;
                        true -> case len(rest_params) == 0 of {
                            true -> check_user_call_result_user_call(call_expr, expected_type, return_type, context, world);
                            false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == -1 of {
                                true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6");
                                false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 of {
                                    true -> case len(rest_params) == 0 of {
                                        true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6");
                                        false -> check_user_call_args_recursive(type_checker_expressions_helpers@expr_child_right(expr), rest_params, expected_type, return_type, context, call_expr, world, check_surface)
                                    };
                                    false -> {
                                        (second_param: string, rest_rest: string) <- type_checker_expressions_user_call_helpers@get_first_param_type(rest_params);
                                        case len(second_param) == 0 or len(rest_rest) > 0 of {
                                            true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(call_expr), concat(type_checker_expressions_helpers@expr_name(call_expr), " argument count mismatch"), "sect6");
                                            false -> {
                                                (r2, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), second_param, context, world);
                                                case r2.is_ok of {
                                                    false -> r2;
                                                    true -> check_user_call_result_user_call(call_expr, expected_type, return_type, context, world)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

