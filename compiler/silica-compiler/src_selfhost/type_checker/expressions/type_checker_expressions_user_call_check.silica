t: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    arg_inferred: string <- case type_checker_expressions_user_call_helpers@count_call_args_user_call(expr) > 0 of {
        true -> type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
        false -> ""
    };
    formal_bind: string <- case type_checker_collections@is_collection_trait_type(type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
        true -> type_checker_expressions_helpers@expect_surf(context, expected_type);
        false -> case type_checker_collections@bind_type_has_collection_runtime_fields(type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
            true -> type_checker_expressions_helpers@expect_surf(context, expected_type);
            false -> case len(arg_inferred) > 0 of {
                true -> arg_inferred;
                false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
            }
        }
    };
    params_from_receiver: string <- type_checker_collections@resolve_constructor_call_formal(formal_bind, params_inner);
    return_from_receiver: string <- type_checker_collections@resolve_constructor_call_formal(formal_bind, return_type);
    // Collection witnesses resolve ItemType/KeyType/ValueType from argument
    // one.  AccType is independent and is witnessed by the expected result
    // type.  When the result is discarded, infer it from the initial
    // accumulator (argument two) instead; discarding a fold result must not
    // erase the callback's concrete signature.
    // AccType in callee formals is witnessed by the call's expected result, or —
    // when the result is discarded / still the AccType placeholder (trait impl
    // bodies) — by the concrete initial-accumulator argument.
    acc_witness: string <- case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() or type_checker_core@surface_for_type_id(context, expected_type) == "AccType" of {
        true -> case type_checker_expressions_user_call_helpers@count_call_args_user_call(expr) >= 2 of {
            true -> {
                from_init: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@call_second_arg_expr(expr), context);
                case len(from_init) > 0 and from_init != "AccType" of {
                    true -> from_init;
                    false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
                }
            };
            false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
        };
        false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
    };
    params_use: string <- type_checker_collections@resolve_accumulator_call_formal(acc_witness, params_from_receiver);
    resolved_return: string <- type_checker_collections@resolve_accumulator_call_formal(acc_witness, return_from_receiver);
    at: int64 <- type_checker_expressions_user_call_helpers@first_at_in_expr_call_name(type_checker_expressions_helpers@expr_name(expr), 0);
    case at < 0 of {
        true -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world, check_surface);
        false -> {
            mod_id: string <- substring(type_checker_expressions_helpers@expr_name(expr), 0, at);
            fn_id: string <- substring(type_checker_expressions_helpers@expr_name(expr), at + 1, len(type_checker_expressions_helpers@expr_name(expr)));
            ac: int64 <- type_checker_expressions_user_call_helpers@count_call_args_user_call(expr);
            (pf: bool, pprog: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) <- parser_ast@find_named_program(mod_id, world);
            case pf of {
                false -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world, check_surface);
                true -> {
                    recv_ty: string <- case ac > 0 of {
                        true -> type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
                        false -> ""
                    };
                    (pfd: bool, callee_decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- type_checker_expressions_user_call_resolve@find_qualified_call_resolved_declaration(pprog, fn_id, type_checker_expressions_helpers@expr_value(expr), ac, recv_ty, type_checker_expressions_helpers@expect_surf(context, expected_type), world);
                    case pfd of {
                        false -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world, check_surface);
                        true -> case callee_decl.tag == 0 of {
                            false -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world, check_surface);
                                true -> case params_use != params_inner of {
                                true -> {
                                    chk_args: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_user_call_args_recursive(expr, params_use, expected_type, resolved_return, context, expr, world, check_surface);
                                    case chk_args.is_ok of {
                                        false -> chk_args;
                                        true -> check_user_call_result_user_call(expr, expected_type, resolved_return, context, world)
                                    }
                                };
                                false -> {
                                    // Collection bind types must witness ItemType/KeyType/ValueType inside
                                    // constructor formals (e.g. OrderedMap[...] <- wbt_map@empty({...})).
                                    col_ctx: string <- case type_checker_collections@is_collection_trait_type(type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                                        true -> type_checker_expressions_helpers@expect_surf(context, expected_type);
                                        false -> ""
                                    };
                                    params_lr: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@list_param_reverse_with_acc(callee_decl.parameters, parser_ast@nil_list_param());
                                    (inf_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, inf_left: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- type_checker_expressions_user_call_resolve@infer_trait_site_call_args_walk(expr, params_lr, context, world, expr, pprog, type_checker_expressions_user_call_resolve@trait_arg_walk_state(col_ctx, "", 0));
                                    case inf_ok.is_ok of {
                                        false -> inf_ok;
                                        true -> {
                                            params_inner_inf: string <- type_checker_expressions_user_call_helpers@inferred_types_concat_comma(inf_left);
                                            chk_args: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_user_call_args_recursive(expr, params_inner_inf, expected_type, return_type, context, expr, world, check_surface);
                                            case chk_args.is_ok of {
                                                false -> chk_args;
                                                true -> {
                                                    conc_decl: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@list_param_reverse_with_acc(inf_left, parser_ast@nil_list_param());
                                                    body_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_callsite_body_with_concrete_params(callee_decl, world, conc_decl, mod_id, pprog, check_surface, check_typed);
                                                    case body_ok.is_ok of {
                                                        false -> body_ok;
                                                        true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

