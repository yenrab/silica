// Capability: check identifier expression (Expr kind 1)
// Resolves name in symbol table, verifies type matches expected

use parser_ast;
use type_checker_core;
use type_checker_collections;
use type_checker_lists;
use type_checker_record_types;
use type_checker_tuple_decompose_helpers;
use type_checker_traits;

export check_expr/4;
export normalize_fn_type_idf/1;
export find_arrow_idf/5;
export function_types_compatible/2;

// §3.4 / §15.4.13.2: function-value types. The compiler builds call-site fn types as `(T1,T2) -> R`
// (see `build_function_type_for_decl_call`), while declared `fn(msg: T1, state: T2) -> R` annotations
// carry the `fn` keyword and parameter names. These must be unified in identifier type-checking so
// passing a plain `fn name` as a record-field or behavior-argument value type-checks.

fn trim_spaces_idf(s: string) -> string {
    trim_spaces_idf_from(s, 0)
}

fn trim_spaces_idf_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_spaces_idf_from(s, i + 1);
            false -> rtrim_spaces_idf(substring(s, i, len(s)))
        }
    }
}

fn rtrim_spaces_idf(s: string) -> string {
    rtrim_spaces_idf_from(s, len(s))
}

fn rtrim_spaces_idf_from(s: string, i: int64) -> string {
    case i <= 0 of {
        true -> "";
        false -> case substring(s, i - 1, i) == " " of {
            true -> rtrim_spaces_idf_from(s, i - 1);
            false -> substring(s, 0, i)
        }
    }
}

// Skip ASCII spaces only (matches trim_spaces_idf).
fn skip_spaces_idx_idf(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> i;
        false -> case substring(s, i, i + 1) == " " of {
            true -> skip_spaces_idx_idf(s, i + 1);
            false -> i
        }
    }
}

// Parser reconstructs function types with spaces between tokens (`fn (` not `fn(`); strip `fn` … `(` so arity lives only inside the parens.
fn strip_fn_keyword_prefix_idf(s: string) -> string {
    t: string <- trim_spaces_idf(s);
    case len(t) >= 2 and substring(t, 0, 2) == "fn" of {
        false -> t;
        true -> {
            after_kw: int64 <- skip_spaces_idx_idf(t, 2);
            case after_kw < len(t) and substring(t, after_kw, after_kw + 1) == "(" of {
                true -> substring(t, after_kw, len(t));
                false -> t
            }
        }
    }
}

// Find top-level "->" starting from i (paren/brace/bracket aware).
fn find_arrow_idf(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i + 1 >= len(s) of {
        true -> -1;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> find_arrow_idf(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> find_arrow_idf(s, i + 1, paren - 1, brace, bracket);
                    false -> case c == "{" of {
                        true -> find_arrow_idf(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> find_arrow_idf(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> find_arrow_idf(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> find_arrow_idf(s, i + 1, paren, brace, bracket - 1);
                                    false -> case paren == 0 and brace == 0 and bracket == 0 and substring(s, i, i + 2) == "->" of {
                                        true -> i;
                                        false -> find_arrow_idf(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Find first top-level comma (paren/brace/bracket aware).
fn find_comma_idf(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> find_comma_idf(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> find_comma_idf(s, i + 1, paren - 1, brace, bracket);
                    false -> case c == "{" of {
                        true -> find_comma_idf(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> find_comma_idf(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> find_comma_idf(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> find_comma_idf(s, i + 1, paren, brace, bracket - 1);
                                    false -> case c == "," and paren == 0 and brace == 0 and bracket == 0 of {
                                        true -> i;
                                        false -> find_comma_idf(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Find first top-level ":" (paren/brace/bracket aware).
fn find_colon_idf(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> find_colon_idf(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> find_colon_idf(s, i + 1, paren - 1, brace, bracket);
                    false -> case c == "{" of {
                        true -> find_colon_idf(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> find_colon_idf(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> find_colon_idf(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> find_colon_idf(s, i + 1, paren, brace, bracket - 1);
                                    false -> case c == ":" and paren == 0 and brace == 0 and bracket == 0 of {
                                        true -> i;
                                        false -> find_colon_idf(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// `name: T` → `T`; else returns input trimmed.
fn strip_param_name_idf(seg: string) -> string {
    t: string <- trim_spaces_idf(seg);
    colon: int64 <- find_colon_idf(t, 0, 0, 0, 0);
    case colon < 0 of {
        true -> t;
        false -> trim_spaces_idf(substring(t, colon + 1, len(t)))
    }
}

// Normalize `fn(a: T1, b: T2) -> R` / `fn (…) -> R` or `(T1,T2) -> R` → `(T1,T2) -> R` (names stripped). Outer declarations still count one formal per `Param`; inner arity is only for calls on function values.
fn normalize_fn_type_idf(s: string) -> string {
    stripped: string <- strip_fn_keyword_prefix_idf(s);
    t: string <- trim_spaces_idf(stripped);
    arrow: int64 <- find_arrow_idf(t, 0, 0, 0, 0);
    case arrow < 0 of {
        true -> t;
        false -> {
            params_part: string <- trim_spaces_idf(substring(t, 0, arrow));
            ret_part: string <- trim_spaces_idf(substring(t, arrow + 2, len(t)));
            params_inner: string <- case len(params_part) >= 2 and substring(params_part, 0, 1) == "(" and substring(params_part, len(params_part) - 1, len(params_part)) == ")" of {
                true -> trim_spaces_idf(substring(params_part, 1, len(params_part) - 1));
                false -> params_part
            };
            normalized_params: string <- normalize_param_list_idf(params_inner);
            concat(concat(concat("(", normalized_params), ") -> "), ret_part)
        }
    }
}

fn normalize_param_list_idf(inner: string) -> string {
    case len(inner) == 0 of {
        true -> "";
        false -> {
            comma: int64 <- find_comma_idf(inner, 0, 0, 0, 0);
            case comma < 0 of {
                true -> strip_param_name_idf(inner);
                false -> {
                    head: string <- strip_param_name_idf(substring(inner, 0, comma));
                    rest: string <- normalize_param_list_idf(trim_spaces_idf(substring(inner, comma + 1, len(inner))));
                    concat(concat(head, ","), rest)
                }
            }
        }
    }
}

fn function_types_compatible(resolved: string, expected: string) -> bool {
    a: string <- normalize_fn_type_idf(resolved);
    b: string <- normalize_fn_type_idf(expected);
    case a == b of {
        true -> true;
        false -> case type_checker_tuple_decompose_helpers@types_equal(a, b) of {
            true -> true;
            false -> {
                // Function results are covariant.  A comparator whose result is
                // the closed atom union :less|:equal|:greater is safe wherever
                // a helper accepts an arbitrary atom result for validation.
                (pa: string, ra: string) <- normalized_fn_params_ret(a);
                (pb: string, rb: string) <- normalized_fn_params_ret(b);
                same_params: bool <- type_checker_tuple_decompose_helpers@types_equal(pa, pb);
                resolved_is_atom_union: bool <- len(ra) > 0 and substring(ra, 0, 1) == ":";
                same_params and rb == "atom" and resolved_is_atom_union
            }
        }
    }
}

// Synthetic lifted lambda symbols (parser): "main.__lam0", etc.
fn is_lifted_lambda_symbol_name(m: string) -> bool {
    lifted_lam_sub_at(m, 0)
}

fn lifted_lam_sub_at(m: string, i: int64) -> bool {
    case i + 6 > len(m) of {
        true -> false;
        false -> case substring(m, i, i + 6) == ".__lam" of {
            true -> true;
            false -> lifted_lam_sub_at(m, i + 1)
        }
    }
}

fn normalized_fn_params_ret(norm: string) -> (string, string) {
    arrow: int64 <- find_arrow_idf(norm, 0, 0, 0, 0);
    case arrow < 0 of {
        true -> ("", "");
        false -> {
            raw_params: string <- trim_spaces_idf(substring(norm, 0, arrow));
            ret: string <- trim_spaces_idf(substring(norm, arrow + 2, len(norm)));
            inner: string <- case len(raw_params) >= 2 and substring(raw_params, 0, 1) == "(" and substring(raw_params, len(raw_params) - 1, len(raw_params)) == ")" of {
                true -> trim_spaces_idf(substring(raw_params, 1, len(raw_params) - 1));
                false -> raw_params
            };
            (inner, ret)
        }
    }
}

fn count_top_level_param_types(inner: string) -> int64 {
    case len(inner) == 0 of {
        true -> 0;
        false -> {
            comma: int64 <- find_comma_idf(inner, 0, 0, 0, 0);
            case comma < 0 of {
                true -> 1;
                false -> 1 + count_top_level_param_types(trim_spaces_idf(substring(inner, comma + 1, len(inner))))
            }
        }
    }
}

fn first_param_type_comma_rest(inner: string) -> (string, string) {
    case len(inner) == 0 of {
        true -> ("", "");
        false -> {
            comma: int64 <- find_comma_idf(inner, 0, 0, 0, 0);
            case comma < 0 of {
                true -> (trim_spaces_idf(inner), "");
                false -> {
                    f: string <- trim_spaces_idf(substring(inner, 0, comma));
                    r: string <- trim_spaces_idf(substring(inner, comma + 1, len(inner)));
                    (f, r)
                }
            }
        }
    }
}

fn param_types_prefix_match(li_res: string, li_exp: string, remaining: int64) -> bool {
    case remaining == 0 of {
        true -> true;
        false -> {
            (ar, r_res) <- first_param_type_comma_rest(li_res);
            (be, r_exp) <- first_param_type_comma_rest(li_exp);
            case type_checker_tuple_decompose_helpers@types_equal(ar, be) of {
                false -> false;
                true -> param_types_prefix_match(r_res, r_exp, remaining - 1)
            }
        }
    }
}

// Lifted lambdas appear as symbols with arity formals+captures; source annotations use callee arity only.
// Compare return types and require the resolved (implementation) param list to start with the expected param types.
fn function_types_compatible_lifted_implementation(resolved: string, expected: string) -> bool {
    a: string <- normalize_fn_type_idf(resolved);
    b: string <- normalize_fn_type_idf(expected);
    case find_arrow_idf(a, 0, 0, 0, 0) < 0 of {
        true -> false;
        false -> case find_arrow_idf(b, 0, 0, 0, 0) < 0 of {
            true -> false;
            false -> {
                (li_a, ret_a) <- normalized_fn_params_ret(a);
                (li_b, ret_b) <- normalized_fn_params_ret(b);
                case type_checker_tuple_decompose_helpers@types_equal(ret_a, ret_b) of {
                    false -> false;
                    true -> {
                        nb: int64 <- count_top_level_param_types(li_b);
                        na: int64 <- count_top_level_param_types(li_a);
                        case na >= nb of {
                            false -> false;
                            true -> param_types_prefix_match(li_a, li_b, nb)
                        }
                    }
                }
            }
        }
    }
}

fn first_at_in_identifier_name(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_identifier_name(s, i + 1)
        }
    }
}

fn lookup_symbol_found_identifier(env: ListSymbolEntry, name: string) -> (bool, string) {
    at: int64 <- first_at_in_identifier_name(name, 0);
    case at < 0 of {
        true -> type_checker_core@lookup_symbol_found(env, name);
        false -> lookup_symbol_found_identifier_module(env, substring(name, at + 1, len(name)), substring(name, 0, at))
    }
}

fn lookup_symbol_found_identifier_module(env: ListSymbolEntry, fn_name: string, required_module: string) -> (bool, string) {
    case env.is_nil of {
        true -> (false, "");
        false -> case env.head.name == fn_name and env.head.is_effect_alias == false and env.head.source_module == required_module of {
            true -> (true, env.head.type_name);
            false -> lookup_symbol_found_identifier_module(env.tail, fn_name, required_module)
        }
    }
}

// Check Expr kind 1 (identifier). Lookup in context.env, verify matches expected_type.
// Note: "true"/"false" identifiers are routed to boolean checker by type_checker_expressions dispatcher
fn check_expr(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult {
    case expected_type == "discard" of {
        true -> case expr.name == "performance_cores" or expr.name == "efficiency_cores" of {
            true -> type_checker_core@type_check_ok();
            false -> {
                (found: bool, _: string) <- lookup_symbol_found_identifier(context.env, expr.name);
                case found of { true -> type_checker_core@type_check_ok(); false -> type_checker_core@type_check_err("E2002", expr.location, concat("undefined identifier: ", expr.name), "sect6") }
            }
        };
        false -> {
            (found: bool, resolved_type: string) <- lookup_symbol_found_identifier(context.env, expr.name);
            case found of {
                false -> type_checker_core@type_check_err("E2002", expr.location, concat("undefined identifier: ", expr.name), "sect6");
                true -> case resolved_type of {
                    "int64" -> case expected_type of { "int64" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "int32" -> case expected_type of { "int32" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "int16" -> case expected_type of { "int16" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "int8" -> case expected_type of { "int8" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "uint64" -> case expected_type of { "uint64" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "uint32" -> case expected_type of { "uint32" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "uint16" -> case expected_type of { "uint16" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "uint8" -> case expected_type of { "uint8" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "boolean" -> case expected_type of { "boolean" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "unit" -> type_checker_core@type_check_err("E2006", expr.location, "unit is not a valid type for variables or parameters", "sect4");
                    "atom" -> case expected_type of { "atom" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    _: string -> case function_types_compatible(resolved_type, expected_type) of {
                        true -> type_checker_core@type_check_ok();
                        false -> case is_lifted_lambda_symbol_name(expr.name) and function_types_compatible_lifted_implementation(resolved_type, expected_type) of {
                            true -> type_checker_core@type_check_ok();
                            false -> case resolved_type == expected_type of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_record_types@record_type_starts(resolved_type) and type_checker_record_types@record_type_starts(expected_type) of {
                                    true -> case type_checker_tuple_decompose_helpers@types_equal(resolved_type, expected_type) of {
                                        true -> type_checker_core@type_check_ok();
                                        false -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6")
                                    };
                                    false -> case type_checker_lists@list_types_compatible(resolved_type, expected_type) of {
                                        true -> type_checker_core@type_check_ok();
                                        false -> case type_checker_collections@is_collection_trait_type(resolved_type) and type_checker_collections@collection_type_fits_concrete_record(resolved_type, expected_type, world) of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> case type_checker_collections@is_collection_trait_type(expected_type) and type_checker_collections@collection_type_fits_concrete_record(expected_type, resolved_type, world) of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> case type_checker_traits@actual_type_satisfies_trait_expectation(resolved_type, expected_type, world) of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6")
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
