fn context_after_sequence_body(body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } } {
    type_checker_expressions_bindings@context_after_sequence_body(body, context)
}

fn check_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) proc[DeviceIO] {
    case type_checker_expressions_helpers@expr_kind(expr) of {
        0 -> type_checker_expressions_literals@check_expr(expr, expected_type, context, world);
        1 -> case type_checker_expressions_control_and_data@is_true_or_false_identifier(expr) of {
            true -> boolean_type_checker_expressions@check_expr(expr, expected_type, context, world);
            false -> type_checker_expressions_identifiers@check_expr(expr, expected_type, context, world)
        };
        2 -> check_expr(type_checker_expressions_helpers@expr_child_inner(expr), expected_type, context, world);
        3 -> (type_checker_expressions_binary_ops@check_binary_op(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        4 -> (type_checker_expressions_user_calls@check_call(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        5 -> type_checker_expressions_atoms@check_expr(expr, expected_type, context, world);
        6 -> (type_checker_expressions_bindings@check_let(expr, expected_type, context, world, check_expr_surface, check_expr, type_checker_expressions_user_calls@check_collection_trait_let), context);
        7 -> boolean_type_checker_expressions@check_expr(expr, expected_type, context, world);
        8 -> (type_checker_expressions_string_calls@check_string_literal(expr, expected_type, context), context);
        9 -> (type_checker_expressions_control_and_data@check_tuple_literal_inline(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        10 -> (type_checker_expressions_control_and_data@check_tuple_decompose(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        11 -> (type_checker_expressions_bindings@check_sequence_block(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        12 -> (type_checker_expressions_binary_ops@check_unary_minus_forbidden(expr, context), context);
        13 -> (type_checker_expressions_control_and_data@check_case_expression(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        19 -> (type_checker_expressions_control_and_data@check_if_expression(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        20 -> (type_checker_expressions_control_and_data@check_list_literal(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        21 -> (type_checker_expressions_control_and_data@check_struct_literal_expr(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        22 -> (type_checker_expressions_control_and_data@check_field_access_expr(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        991 -> (type_checker_expressions_bindings@check_lambda_expression(expr, expected_type, context, world, check_expr_surface, check_expr), context);
        996 -> (type_checker_core@type_check_err("E1040", type_checker_expressions_helpers@expr_loc(expr), "expected ';' after this statement before the next statement", "sect3"), context);
        995 -> (type_checker_core@type_check_err("E1000", type_checker_expressions_helpers@expr_loc(expr), "There is an uncategorized syntactic defect in the code you are working on.", "sect3"), context);
        997 -> (type_checker_core@type_check_err("E1041", type_checker_expressions_helpers@expr_loc(expr), "the last expression in this block must not be followed by ';'", "sect3"), context);
        _: int64 -> (type_checker_core@type_check_ok(), context)
    }
}

