            case type_checker_record_types@record_type_starts(rec_expected) of {
                false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat("expected record type, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), ""), "sect3");
                true -> {
                    n_type: int64 <- type_checker_record_types@count_record_fields(rec_expected);
                    n_lit: int64 <- count_struct_chain_nodes(expr);
                    case n_type == n_lit of {
                        false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), "struct literal field count does not match record type", "sect3");
                        true -> check_struct_literal_chain(expr, rec_expected, context, world, check_surface, check_typed)
                    }
                }
            }
        }
    }
}

