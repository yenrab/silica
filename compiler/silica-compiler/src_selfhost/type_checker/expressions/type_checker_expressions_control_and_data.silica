// true/false as identifiers: lexer may emit identifier; treat as boolean literal (spec: boolean values)
fn is_true_or_false_identifier(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> bool {
    case len(type_checker_expressions_helpers@expr_name(expr)) of {
        4 -> case substring(type_checker_expressions_helpers@expr_name(expr), 0, 1) of {
            "t" -> case substring(type_checker_expressions_helpers@expr_name(expr), 1, 2) of {
                "r" -> case substring(type_checker_expressions_helpers@expr_name(expr), 2, 3) of {
                    "u" -> case substring(type_checker_expressions_helpers@expr_name(expr), 3, 4) of { "e" -> true; _: string -> false };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        5 -> case substring(type_checker_expressions_helpers@expr_name(expr), 0, 1) of {
            "f" -> case substring(type_checker_expressions_helpers@expr_name(expr), 1, 2) of {
                "a" -> case substring(type_checker_expressions_helpers@expr_name(expr), 2, 3) of {
                    "l" -> case substring(type_checker_expressions_helpers@expr_name(expr), 3, 4) of {
                        "s" -> case substring(type_checker_expressions_helpers@expr_name(expr), 4, 5) of { "e" -> true; _: string -> false };
                        _: string -> false
                    };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        _: int64 -> false
    }
}

