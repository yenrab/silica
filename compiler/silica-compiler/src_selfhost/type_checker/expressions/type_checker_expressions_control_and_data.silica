// Case/if/tuple/list/struct/field expression checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use parser_ast;
use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use type_checker_recursive_tuples;
use type_checker_lists;
use type_checker_collections;
use type_checker_expressions_actors;
use type_checker_supervisor;
use type_checker_record_types;
use type_checker_traits;
use type_checker_callee_env;
use type_checker_expressions_identifiers;
use type_checker_expressions_float32_calls;
use type_checker_expressions_string_calls;
use string_parse;
use instantiated_fn_name;
use type_checker_expressions_bindings;

export check_tuple_literal_inline/6;
export check_tuple_decompose/6;
export check_case_expression/6;
export check_if_expression/6;
export check_list_literal/6;
export check_list_primitive_call/6;
export check_struct_literal_expr/6;
export check_field_access_expr/6;
export is_true_or_false_identifier/1;

fn tuple_elem_type_for_check(field_type: string) -> string {
    case len(field_type) > 0 and substring(field_type, 0, 1) == ":" of {
        true -> "atom";
        false -> field_type
    }
}

// Tuple literal (kind 9): check against expected tuple type "(T1, T2)"
fn check_tuple_literal_inline(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], check_surface: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }), check_typed: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, int64, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    case len(type_checker_expressions_helpers@expect_surf(context, expected_type)) == 7 and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 0, 1) == "d" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 1, 2) == "i" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 2, 3) == "s" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 3, 4) == "c" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 4, 5) == "a" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 5, 6) == "r" and substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 6, 7) == "d" of {
        true -> type_checker_core@type_check_ok();
        false -> case len(type_checker_expressions_helpers@expect_surf(context, expected_type)) < 2 of {
            true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat("tuple literal requires tuple type, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect4");
            false -> case substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 0, 1) == "(" of {
                true -> case substring(type_checker_expressions_helpers@expect_surf(context, expected_type), len(type_checker_expressions_helpers@expect_surf(context, expected_type)) - 1, len(type_checker_expressions_helpers@expect_surf(context, expected_type))) == ")" of {
                    true -> {
                        inner: string <- substring(type_checker_expressions_helpers@expect_surf(context, expected_type), 1, len(type_checker_expressions_helpers@expect_surf(context, expected_type)) - 1);
                        comma_pos: int64 <- case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == 9 of {
                            true -> tuple_find_last_top_level_comma(inner);
                            false -> tuple_find_top_level_comma(inner, 0)
                        };
                        first_type_raw: string <- substring(inner, 0, comma_pos);
                        first_type: string <- tuple_trim_leading(first_type_raw);
                        first_type_wrapped: string <- case tuple_find_top_level_comma(first_type, 0) < len(first_type) of {
                            true -> concat(concat("(", first_type), ")");
                            false -> first_type
                        };
                        rest_start: int64 <- comma_pos + 1;
                        second_type_raw: string <- case rest_start < len(inner) of {
                            true -> substring(inner, rest_start, len(inner));
                            false -> ""
                        };
                        second_type: string <- tuple_trim_leading(second_type_raw);
                        second_type_wrapped: string <- case tuple_find_top_level_comma(second_type, 0) < len(second_type) of {
                            true -> concat(concat("(", second_type), ")");
                            false -> second_type
                        };
                        first_expect: string <- tuple_elem_type_for_check(first_type_wrapped);
                        second_expect: string <- tuple_elem_type_for_check(second_type_wrapped);
                        (first_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), first_expect, context, world);
                        case first_result.is_ok of {
                            false -> first_result;
                            true -> {
                                (second_result, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), second_expect, context, world);
                                second_result
                            }
                        }
                    };
                    false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat("tuple literal requires tuple type, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect4")
                };
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat("tuple literal requires tuple type, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect4")
            }
        }
    }
}

fn tuple_trim_leading(s: string) -> string {
    tuple_trim_leading_from(s, 0)
}

fn tuple_trim_leading_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> tuple_trim_leading_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

// Find first comma at top level (not inside parentheses). Handles nested tuples recursively.
fn tuple_find_top_level_comma(s: string, i: int64) -> int64 {
    tc_tuple_find_top_level_comma_from(s, i, 0, 0, 0)
}

// Top-level over paren/brace/bracket depth (all three must be 0 for a comma to split tuple components).
// Spec: `(A, B)` tuple may carry record or list components (`{...}`, `List[...]`) whose internal commas
// are not tuple separators (§3.3 / §15.4.13.2 for supervisor init return shape).
// Prefixed `tc_` to avoid collision with parser_tuples' paren-only variant under the bootstrap compiler's
// flat function namespace.
fn tc_tuple_find_top_level_comma_from(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> case paren <= 0 and brace == 0 and bracket == 0 of {
                        true -> len(s);
                        false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren - 1, brace, bracket)
                    };
                    false -> case c == "{" of {
                        true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket - 1);
                                    false -> case c == "," of {
                                        true -> case paren == 0 and brace == 0 and bracket == 0 of {
                                            true -> i;
                                            false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket)
                                        };
                                        false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Find last comma at top level (over paren/brace/bracket). For right-nested (a,(b,c)),
// inner has type (A,B), right_expr has type C; record/list components must not confuse the split.
fn tuple_find_last_top_level_comma(s: string) -> int64 {
    tc_tuple_find_last_top_level_comma_from(s, 0, 0, 0, 0, -1)
}

fn tc_tuple_find_last_top_level_comma_from(s: string, i: int64, paren: int64, brace: int64, bracket: int64, last: int64) -> int64 {
    case i >= len(s) of {
        true -> case last < 0 of { true -> len(s); false -> last };
        false -> {
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren + 1, brace, bracket, last);
                false -> case c == ")" of {
                    true -> case paren <= 0 and brace == 0 and bracket == 0 of {
                        true -> case last < 0 of { true -> len(s); false -> last };
                        false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren - 1, brace, bracket, last)
                    };
                    false -> case c == "{" of {
                        true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace + 1, bracket, last);
                        false -> case c == "}" of {
                            true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace - 1, bracket, last);
                            false -> case c == "[" of {
                                true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket + 1, last);
                                false -> case c == "]" of {
                                    true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket - 1, last);
                                    false -> case c == "," of {
                                        true -> case paren == 0 and brace == 0 and bracket == 0 of {
                                            true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, i);
                                            false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, last)
                                        };
                                        false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, last)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Whether expression mentions identifier `name` (for case guard rule §3.4: guard must depend on pattern bindings).
fn expr_references_name(e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, name: string) -> bool {
    case type_checker_expressions_helpers@expr_kind(e) < 0 of {
        true -> false;
        false -> case type_checker_expressions_helpers@expr_kind(e) of {
            0 -> false;
            1 -> type_checker_expressions_helpers@expr_name(e) == name;
            2 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name);
            3 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            4 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            5 -> false;
            6 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            7 -> false;
            8 -> false;
            9 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            10 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name);
            11 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            12 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name);
            13 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            19 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(e)), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(e)), name);
            20 -> expr_references_name(type_checker_expressions_helpers@expr_child_inner(e), name) or expr_references_name(type_checker_expressions_helpers@expr_child_right(e), name);
            _: int64 -> false
        }
    }
}

fn case_record_guard_refs_any(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, pat_str: string, scrutinee_type: string) -> bool {
    inner: string <- type_checker_record_types@record_case_inner_body(pat_str);
    case_record_guard_refs_loop(branch, inner, scrutinee_type)
}

fn case_record_guard_refs_loop(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rem: string, scrutinee_type: string) -> bool {
    (seg: string, rest2: string) <- type_checker_record_types@record_case_field_step(rem);
    case len(seg) == 0 of {
        true -> false;
        false -> {
            (fname: string, sub: string) <- type_checker_record_types@record_field_segment_name_sub(seg);
            case len(fname) == 0 of {
                true -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                false -> {
                    fty: string <- type_checker_record_types@find_field_type_in_record(scrutinee_type, fname);
                    case len(fty) == 0 of {
