                            (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), elem_res, context, world);
                            case r1.is_ok of {
                                false -> r1;
                                true -> {
                                    (r2, _) <- check_surface(type_checker_expressions_helpers@call_second_arg_expr(expr), list_t, context, world);
                                    case r2.is_ok of {
                                        false -> r2;
                                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> case type_checker_lists@list_types_compatible(type_checker_expressions_helpers@expect_surf(context, expected_type), list_t) of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> case type_checker_expressions_helpers@surface_type_matches_expected(context, list_t, expected_type) of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat("prepend returns ", list_t), ", expected "), type_checker_expressions_helpers@expect_surf(context, expected_type)), ""), "list")
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                };
                false -> case type_checker_expressions_helpers@expr_name(expr) == "remove_head" of {
                    true -> {
                        ac: int64 <- type_checker_lists@count_call_args_list(expr);
                        case ac == 1 of {
                            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "remove_head expects 1 argument", "list");
                            true -> {
                                (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), list_t, context, world);
                                case r1.is_ok of {
                                    false -> r1;
                                    true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                        true -> type_checker_core@type_check_ok();
                                        false -> case type_checker_lists@list_types_compatible(type_checker_expressions_helpers@expect_surf(context, expected_type), list_t) of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> case type_checker_expressions_helpers@surface_type_matches_expected(context, list_t, expected_type) of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat("remove_head returns ", list_t), ", expected "), type_checker_expressions_helpers@expect_surf(context, expected_type)), ""), "list")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    };
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "head" of {
                        true -> {
                            ac: int64 <- type_checker_lists@count_call_args_list(expr);
                            case ac == 1 of {
                                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "head expects 1 argument", "list");
                                true -> {
                                    (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), list_t, context, world);
                                    case r1.is_ok of {
                                        false -> r1;
                                        true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> case type_checker_expressions_helpers@surface_type_matches_expected(context, elem_res, expected_type) of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> case type_checker_lists@types_equal_strip(type_checker_expressions_helpers@expect_surf(context, expected_type), elem_res) of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat("head returns ", elem_res), ", expected "), type_checker_expressions_helpers@expect_surf(context, expected_type)), ""), "list")
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        };
                        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat("unknown list primitive: ", type_checker_expressions_helpers@expr_name(expr)), "list")
                    }
                }
            }
        }
    }
}

fn list_primitive_collectable_context_type(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) -> string {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    case node.name == "empty" of {
        true -> type_checker_core@surface_for_type_id(context, expected_type);
        false -> case node.name == "prepend" of {
            true -> type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@call_second_arg_expr(expr), context);
            false -> type_checker_tuple_decompose_helpers@infer_expr_type(parser_ast@expr_at(expr, node.inner), context)
        }
    }
}

