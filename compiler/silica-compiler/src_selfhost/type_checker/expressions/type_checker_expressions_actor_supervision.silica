// Actor link/monitor/supervision/cast/call/send built-in checking.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use parser_ast;
use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use type_checker_recursive_tuples;
use type_checker_lists;
use type_checker_collections;
use type_checker_expressions_actors;
use type_checker_supervisor;
use type_checker_record_types;
use type_checker_traits;
use type_checker_callee_env;
use type_checker_expressions_identifiers;
use type_checker_expressions_float32_calls;
use type_checker_expressions_string_calls;
use string_parse;
use instantiated_fn_name;
use type_checker_expressions_actor_spawn;

export actor_ref_supervisor_marker_name/1;
export check_actor_link_call/6;
export check_add_child_call/6;
export check_actor_monitor_call/6;
export check_actor_demonitor_call/6;
export check_supervision_ingress_enqueue_call/6;
export check_supervision_wait_and_drain_one_call/4;
export check_failure_reason_tag_call/6;
export check_failure_reason_atom_call/6;
export check_failure_agent_type_call/6;
export check_failure_release_call/6;
export check_start_child_call/6;
export check_child_table_first_ref_call/4;
export check_child_table_row_ref_call/6;
export check_kill_abnormal_call/6;
export check_wait_for_exit_call/4;
export check_actor_call_builtin/6;
export check_actor_call_registered_builtin/6;
export check_actor_cast_builtin/6;
export check_actor_cast_registered_builtin/6;
export check_actor_cast_dangerous_registered_builtin/6;
export check_actor_send_builtin/6;

