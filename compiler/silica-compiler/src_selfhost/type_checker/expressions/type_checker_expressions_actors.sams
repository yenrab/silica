L_length_bytes_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    CBZ X19, Llb_z
    LDR X1, [X19]
    MOV X2, #-1
    CMP X1, X2
    B.NE Llb_bad
    LDR X0, [X19, #16]
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_z:
    MOV X0, #0
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_bad:
    BRK #1

L_string_cmp_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lcmp_anull
    CBZ X20, Lcmp_gt
    LDR X1, [X19]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lcmp_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    CMP X1, X2
    B.NE Lcmp_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
Lcmp_n2_done:
    MOV X25, X22
    CMP X25, X24
    B.LS Lcmp_minok
    MOV X25, X24
Lcmp_minok:
    CBZ X25, Lcmp_len
    MOV X26, X21
    MOV X27, X23
Lcmp_cloop:
    LDRB W28, [X26], #1
    LDRB W1, [X27], #1
    CMP W28, W1
    B.LO Lcmp_lt
    B.HI Lcmp_gt
    SUBS X25, X25, #1
    B.NE Lcmp_cloop
Lcmp_len:
    CMP X22, X24
    B.EQ Lcmp_eq
    B.LO Lcmp_lt
    B Lcmp_gt
Lcmp_anull:
    CBZ X20, Lcmp_eq
Lcmp_lt:
    MOV W0, #-1
    B Lcmp_exit
Lcmp_gt:
    MOV W0, #1
    B Lcmp_exit
Lcmp_eq:
    MOV W0, #0
Lcmp_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Lcmp_bad:
    BRK #1

L_list_prepend_helper:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X1, X2, [SP, #-16]!
    STP X3, X4, [SP, #-16]!
    STR X5, [SP, #-16]!
    CBZ X2, L_lph_new_chunk
    LDR X6, [X2, #16]
    CBZ X6, L_lph_new_chunk
    LDR X7, [X2, #8]
    SUB X8, X6, X3
    ADD X10, X7, X8
    LDR X11, [SP]
    CBZ X11, L_lph_room_scalar
    MOV X12, #0
L_lph_room_agg:
    CMP X12, X3
    B.GE L_lph_room_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_room_agg
    B L_lph_room_stored
L_lph_room_scalar:
    CMP X3, #8
    B.EQ L_lph_rs8
    CMP X3, #4
    B.EQ L_lph_rs4
    CMP X3, #2
    B.EQ L_lph_rs2
    STRB W1, [X10]
    B L_lph_room_stored
L_lph_rs2:
    STRH W1, [X10]
    B L_lph_room_stored
L_lph_rs4:
    STR W1, [X10]
    B L_lph_room_stored
L_lph_rs8:
    STR X1, [X10]
L_lph_room_stored:
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDR X5, [SP], #16
    LDP X3, X4, [SP], #16
    LDP X1, X2, [SP], #16
    LDR X6, [X2]
    ADD X6, X6, #1
    STR X6, [X0]
    LDR X7, [X2, #8]
    STR X7, [X0, #8]
    LDR X8, [X2, #16]
    SUB X8, X8, X3
    STR X8, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lph_new_chunk:
    ADD X0, X4, #8
    BL _silica_rt_region_alloc
    MOV X6, X0
    LDR X5, [SP]
    LDP X3, X4, [SP, #16]
    LDP X1, X2, [SP, #32]
    SUB X8, X4, X3
    ADD X10, X6, X8
    CBZ X5, L_lph_new_scalar
    MOV X12, #0
L_lph_new_agg:
    CMP X12, X3
    B.GE L_lph_new_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_new_agg
    B L_lph_new_stored
L_lph_new_scalar:
    CMP X3, #8
    B.EQ L_lph_ns8
    CMP X3, #4
    B.EQ L_lph_ns4
    CMP X3, #2
    B.EQ L_lph_ns2
    STRB W1, [X10]
    B L_lph_new_stored
L_lph_ns2:
    STRH W1, [X10]
    B L_lph_new_stored
L_lph_ns4:
    STR W1, [X10]
    B L_lph_new_stored
L_lph_ns8:
    STR X1, [X10]
L_lph_new_stored:
    CBZ X2, L_lph_next_nil
    LDR X9, [X2, #8]
    STR X9, [X6, X4]
    B L_lph_alloc_handle
L_lph_next_nil:
    STR XZR, [X6, X4]
L_lph_alloc_handle:
    STP X6, X8, [SP, #-16]!
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDP X6, X8, [SP], #16
    LDR X5, [SP], #16
    LDP X3, X4, [SP], #16
    LDP X1, X2, [SP], #16
    CBZ X2, L_lph_len1
    LDR X9, [X2]
    ADD X9, X9, #1
    B L_lph_setlen
L_lph_len1:
    MOV X9, #1
L_lph_setlen:
    STR X9, [X0]
    STR X6, [X0, #8]
    STR X8, [X0, #16]
    LDP X29, X30, [SP], #16
    RET

L_list_tail_helper:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    LDR X3, [X0]
    LDR X4, [X0, #8]
    LDR X5, [X0, #16]
    ADD X6, X5, X1
    CMP X6, X2
    B.GE L_lth_next_chunk
    SUB X3, X3, #1
    CBZ X3, L_lth_nil
    STP X3, X4, [SP, #-16]!
    STP X6, XZR, [SP, #-16]!
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDP X6, XZR, [SP], #16
    LDP X3, X4, [SP], #16
    STR X3, [X0]
    STR X4, [X0, #8]
    STR X6, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lth_next_chunk:
    LDR X7, [X4, X2]
    CBZ X7, L_lth_nil
    SUB X3, X3, #1
    CBZ X3, L_lth_nil
    STP X3, X7, [SP, #-16]!
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDP X3, X7, [SP], #16
    STR X3, [X0]
    STR X7, [X0, #8]
    STR XZR, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lth_nil:
    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET

L_list_length_helper:
    CBZ X0, L_list_len_nil
    LDR X0, [X0]
    RET
L_list_len_nil:
    MOV X0, #0
    RET

L_list_at_helper:
    CBZ X0, L_lat_oob
    LDR X4, [X0]
    CMP X1, X4
    B.HS L_lat_oob
    LDR X5, [X0, #8]
    LDR X6, [X0, #16]
L_lat_loop:
    CBZ X1, L_lat_done
    ADD X6, X6, X2
    CMP X6, X3
    B.LT L_lat_step
    LDR X5, [X5, X3]
    MOV X6, #0
L_lat_step:
    SUB X1, X1, #1
    B L_lat_loop
L_lat_done:
    ADD X0, X5, X6
    RET
L_lat_oob:
    BL _abort

