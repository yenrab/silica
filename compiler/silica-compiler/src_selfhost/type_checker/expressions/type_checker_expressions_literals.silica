// Capability: check integer literal expression ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 0)
// Verifies literal type matches expected return type

use parser_ast;
use type_checker_core;
use type_checker_traits;
use type_checker_tuple_decompose_helpers;
use type_interner;

export check_expr/4;

fn literal_ok_for_kind(k: int64) -> bool {
    case k == type_interner@kind_int64() or k == type_interner@kind_int32() or k == type_interner@kind_int16() or k == type_interner@kind_int8() or k == type_interner@kind_uint64() or k == type_interner@kind_uint32() or k == type_interner@kind_uint16() or k == type_interner@kind_uint8() or k == type_interner@kind_float64() or k == type_interner@kind_float32() or k == type_interner@kind_float16() or k == type_interner@kind_discard() or k == type_interner@kind_atom() of {
        true -> true;
        false -> false
    }
}

// Check { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 0 (integer or float literal). expected_type is interned type id.
fn check_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } <- context.interner;
    k: int64 <- type_interner@node_kind(interner, expected_type);
    case literal_ok_for_kind(k) of {
        true -> (type_checker_core@type_check_ok(), context);
        false -> case k == type_interner@kind_char() of {
            true -> case len(node.value) >= 1 and substring(node.value, 0, 1) == "'" of {
                true -> (type_checker_core@type_check_ok(), context);
                false -> (type_checker_core@type_check_err("E2001", node.location, "char literal required, got numeric literal", "sect6"), context)
            };
            false -> case k == type_interner@kind_string() of {
                true -> case len(node.value) >= 1 and substring(node.value, 0, 1) == "\"" of {
                    true -> (type_checker_core@type_check_ok(), context);
                    false -> (type_checker_core@type_check_err("E2001", node.location, "string literal required, got numeric literal", "sect6"), context)
                };
                false -> case node.value == ")" of {
                    true -> (type_checker_core@type_check_ok(), context);
                    false -> {
                        lit_ty: string <- type_checker_tuple_decompose_helpers@infer_literal_type(node.value);
                        expect_surf: string <- type_checker_core@surface_for_type_id(context, expected_type);
                        case type_checker_traits@actual_type_satisfies_trait_expectation(lit_ty, expect_surf, world) of {
                            true -> (type_checker_core@type_check_ok(), context);
                            false -> case expect_surf == "AccType" or expect_surf == "ItemType" or expect_surf == "KeyType" or expect_surf == "ValueType" of {
                                true -> (type_checker_core@type_check_ok(), context);
                                false -> (type_checker_core@type_check_err("E2001", node.location, concat("literal requires integer or float return type, got ", case len(expect_surf) == 0 of { true -> "[EMPTY]"; false -> expect_surf }), "sect6"), context)
                            }
                        }
                    }
                }
            }
        }
    }
}
