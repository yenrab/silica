fn fn_type_witnesses_edge_target(fn_type: string, edge_type: string, node_type: string) -> bool {
    (ok: bool, param: string) <- parse_fn_unary_param_type(fn_type);
    case ok of {
        false -> false;
        true -> do
            edge: string <- strip_spaces_col(edge_type);
            node: string <- strip_spaces_col(node_type);
            param_ok: bool <- type_checker_lists@types_equal_strip(param, edge);
            case param_ok of {
                false -> false;
                true -> do
                    ret: string <- fn_return_after_arrow_col(fn_type);
                    type_checker_lists@types_equal_strip(ret, node)
                end
            }
        end
    }
}

