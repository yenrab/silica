                            false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor compare_weight type ", compare_weight_fn_type), " does not witness WeightedGraph weight type "), weight), ""), "sect4");
                            true -> type_checker_core@type_check_ok()
                        }
                    }
                }
            }
        }
    }
