fn is_ordered_set_type(s: string) -> bool {
    (ok: bool, _: string, _: string) <- parse_ordered_set_type(s);
    ok
}

fn is_ordered_map_type(s: string) -> bool {
    (ok: bool, _: string, _: string, _: string) <- parse_ordered_map_type(s);
    ok
}

fn is_heap_type(s: string) -> bool {
    (ok: bool, _: string, _: string) <- parse_heap_type(s);
    ok
}

fn is_directed_graph_type(s: string) -> bool {
    (ok: bool, _: string, _: string, _: string) <- parse_directed_graph_type(s);
    ok
}

fn is_search_tree_type(s: string) -> bool {
    (ok: bool, _: string, _: string) <- parse_search_tree_type(s);
    ok
}

fn is_undirected_graph_type(s: string) -> bool {
