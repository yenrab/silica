fn strip_all_spaces_col(s: string) -> string {
    strip_all_spaces_col_from(s, 0, "")
}

fn strip_all_spaces_col_from(s: string, i: int64, acc: string) -> string {
    case i >= len(s) of {
        true -> acc;
        false -> case substring(s, i, i + 1) == " " of {
            true -> strip_all_spaces_col_from(s, i + 1, acc);
            false -> strip_all_spaces_col_from(s, i + 1, concat(acc, substring(s, i, i + 1)))
        }
    }
}

fn strip_spaces_col(s: string) -> string {
    strip_spaces_col_from(s, 0, len(s) - 1)
}

fn strip_spaces_col_from(s: string, start: int64, end_inclusive: int64) -> string {
    case start > end_inclusive of {
        true -> "";
        false -> case substring(s, start, start + 1) == " " of {
            true -> strip_spaces_col_from(s, start + 1, end_inclusive);
            false -> case substring(s, end_inclusive, end_inclusive + 1) == " " of {
                true -> strip_spaces_col_from(s, start, end_inclusive - 1);
                false -> substring(s, start, end_inclusive + 1)
            }
        }
    }
}

fn starts_with_col(s: string, prefix: string) -> bool {
    case len(s) < len(prefix) of {
        true -> false;
        false -> substring(s, 0, len(prefix)) == prefix
    }
}

fn skip_spaces_index_col(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> i;
        false -> case substring(s, i, i + 1) == " " of {
            true -> skip_spaces_index_col(s, i + 1);
            false -> i
        }
    }
}

fn find_first_comma_depth0_col(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> find_first_comma_depth0_col(s, i + 1, depth + 1);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> find_first_comma_depth0_col(s, i + 1, depth - 1);
                    false -> case c == "," of {
                        true -> case depth == 0 of {
                            true -> i;
                            false -> find_first_comma_depth0_col(s, i + 1, depth)
                        };
                        false -> find_first_comma_depth0_col(s, i + 1, depth)
                    }
                }
            }
        end
    }
}

fn normalize_collection_bracket(prefix: string, s: string) -> string {
    plen: int64 <- len(prefix);
    case len(s) < plen of {
        true -> s;
        false -> case substring(s, 0, plen) == prefix of {
            false -> s;
            true -> do
                j: int64 <- skip_spaces_index_col(s, plen);
                case j >= len(s) of {
                    true -> s;
                    false -> case substring(s, j, j + 1) == "[" of {
                        true -> concat(prefix, concat("[", substring(s, j + 1, len(s))));
                        false -> s
                    }
                }
            end
        }
    }
}

fn collection_space_has_mem_form(space: string) -> bool {
    t: string <- strip_all_spaces_col(space);
    len(t) >= 6 and substring(t, 0, 4) == "mem(" and substring(t, len(t) - 1, len(t)) == ")"
}

fn parse_bracketed_collection_two(full: string, prefix: string) -> (bool, string, string, string, string) {
    t: string <- normalize_collection_bracket(prefix, strip_all_spaces_col(full));
    plen: int64 <- len(prefix);
    case len(t) < plen + 2 of {
        true -> (false, "", "", "", "");
        false -> case starts_with_col(t, concat(prefix, "[")) of {
            false -> (false, "", "", "", "");
            true -> case substring(t, len(t) - 1, len(t)) == "]" of {
                false -> (false, "", "", "", "");
                true -> do
                    inner: string <- substring(t, plen + 1, len(t) - 1);
                    inner_trim: string <- strip_spaces_col(inner);
                    comma_pos: int64 <- find_first_comma_depth0_col(inner_trim, 0, 0);
                    case comma_pos >= len(inner_trim) of {
                        true -> (false, "", "", "", "");
                        false -> do
                            p1: string <- strip_spaces_col(substring(inner_trim, 0, comma_pos));
                            p2: string <- strip_spaces_col(substring(inner_trim, comma_pos + 1, len(inner_trim)));
                            (true, p1, p2, "", "")
                        end
                    }
                end
            }
        }
    }
}

fn parse_bracketed_collection_three(full: string, prefix: string) -> (bool, string, string, string, string) {
    t: string <- normalize_collection_bracket(prefix, strip_all_spaces_col(full));
    plen: int64 <- len(prefix);
    case len(t) < plen + 2 of {
        true -> (false, "", "", "", "");
        false -> case starts_with_col(t, concat(prefix, "[")) of {
            false -> (false, "", "", "", "");
            true -> case substring(t, len(t) - 1, len(t)) == "]" of {
                false -> (false, "", "", "", "");
                true -> do
                    inner: string <- substring(t, plen + 1, len(t) - 1);
                    inner_trim: string <- strip_spaces_col(inner);
                    c1: int64 <- find_first_comma_depth0_col(inner_trim, 0, 0);
                    case c1 >= len(inner_trim) of {
                        true -> (false, "", "", "", "");
                        false -> do
                            rest1: string <- substring(inner_trim, c1 + 1, len(inner_trim));
                            c2: int64 <- find_first_comma_depth0_col(rest1, 0, 0);
                            case c2 >= len(rest1) of {
                                true -> (false, "", "", "", "");
                                false -> do
                                    p1: string <- strip_spaces_col(substring(inner_trim, 0, c1));
                                    p2: string <- strip_spaces_col(substring(rest1, 0, c2));
                                    p3: string <- strip_spaces_col(substring(rest1, c2 + 1, len(rest1)));
                                    (true, p1, p2, p3, "")
                                end
                            }
                        end
                    }
                end
            }
        }
    }
}

fn parse_bracketed_collection_four(full: string, prefix: string) -> (bool, string, string, string, string) {
    t: string <- normalize_collection_bracket(prefix, strip_all_spaces_col(full));
    plen: int64 <- len(prefix);
    case len(t) < plen + 2 of {
        true -> (false, "", "", "", "");
        false -> case starts_with_col(t, concat(prefix, "[")) of {
            false -> (false, "", "", "", "");
            true -> case substring(t, len(t) - 1, len(t)) == "]" of {
                false -> (false, "", "", "", "");
                true -> do
                    inner: string <- substring(t, plen + 1, len(t) - 1);
                    inner_trim: string <- strip_spaces_col(inner);
                    c1: int64 <- find_first_comma_depth0_col(inner_trim, 0, 0);
                    case c1 >= len(inner_trim) of {
                        true -> (false, "", "", "", "");
                        false -> do
                            rest1: string <- substring(inner_trim, c1 + 1, len(inner_trim));
                            c2: int64 <- find_first_comma_depth0_col(rest1, 0, 0);
                            case c2 >= len(rest1) of {
                                true -> (false, "", "", "", "");
                                false -> do
                                    rest2: string <- substring(rest1, c2 + 1, len(rest1));
                                    c3: int64 <- find_first_comma_depth0_col(rest2, 0, 0);
                                    case c3 >= len(rest2) of {
                                        true -> (false, "", "", "", "");
                                        false -> do
                                            p1: string <- strip_spaces_col(substring(inner_trim, 0, c1));
                                            p2: string <- strip_spaces_col(substring(rest1, 0, c2));
                                            p3: string <- strip_spaces_col(substring(rest2, 0, c3));
                                            p4: string <- strip_spaces_col(substring(rest2, c3 + 1, len(rest2)));
                                            (true, p1, p2, p3, p4)
                                        end
                                    }
                                end
                            }
                        end
                    }
                end
            }
        }
    }
}

fn parse_bracketed_collection(full: string, prefix: string, n_params: int64) -> (bool, string, string, string, string) {
    case n_params == 2 of {
        true -> parse_bracketed_collection_two(full, prefix);
        false -> case n_params == 3 of {
            true -> parse_bracketed_collection_three(full, prefix);
            false -> case n_params == 4 of {
                true -> parse_bracketed_collection_four(full, prefix);
                false -> (false, "", "", "", "")
            }
        }
    }
}

fn parse_ordered_set_type(full: string) -> (bool, string, string) {
    (ok: bool, item: string, space: string, _: string, _: string) <- parse_bracketed_collection(full, "OrderedSet", 2);
    case ok of { true -> (true, item, space); false -> (false, "", "") }
}

fn parse_ordered_map_type(full: string) -> (bool, string, string, string) {
    (ok: bool, key: string, value: string, space: string, _: string) <- parse_bracketed_collection(full, "OrderedMap", 3);
    case ok of { true -> (true, key, value, space); false -> (false, "", "", "") }
}

