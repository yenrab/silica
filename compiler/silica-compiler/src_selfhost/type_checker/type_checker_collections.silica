fn witness_matches_directed_graph_declaration(
    decl_type: string,
    node_fn_type: string,
    edge_fn_type: string,
    target_fn_type: string,
    location: { file: string, line: int64, column: int64, offset: int64 }
) -> TypeCheckResult {
    (ok: bool, node: string, edge: string, space: string) <- parse_directed_graph_type(decl_type);
    case ok of {
        false -> type_checker_core@type_check_err("E2017", location, concat(concat("invalid DirectedGraph type declaration: ", decl_type), ""), "sect4");
        true -> case collection_space_has_mem_form(space) of {
            false -> type_checker_core@type_check_err("E2015", location, concat(concat("DirectedGraph requires mem(Space): ", decl_type), ""), "sect4");
            true -> case fn_type_witnesses_item(node_fn_type, node) of {
                false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor compare_node type ", node_fn_type), " does not witness DirectedGraph node type "), node), ""), "sect4");
                true -> case fn_type_witnesses_item(edge_fn_type, edge) of {
                    false -> type_checker_core@type_check_err("E2017", location, concat(concat(concat(concat("constructor compare_edge type ", edge_fn_type), " does not witness DirectedGraph edge type "), edge), ""), "sect4");
