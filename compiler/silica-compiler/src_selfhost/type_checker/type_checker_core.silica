// Type checker core - type context, type-check result, symbol table
// Shared by type checker capabilities and runner.
// Seed-legal: inline records + List (no named struct / type alias).

use parser_ast;
use instantiated_fn_name;
use lexer_core;

export add_params_concrete_loop1/1;
export create_type_context/0;
export add_symbol/5;
export add_effect_alias_symbol/3;
export lookup_symbol/2;
export lookup_symbol_found/2;
export lookup_symbol_source_module/2;
export lookup_function_for_call/2;
export lookup_function_type_for_call/2;
export call_name_is_module_qualified/1;
export split_module_qualified_call_name/1;
export user_call_base_function_name/1;
export type_check_ok/0;
export type_check_err/5;
export empty_symbol_table/0;
export type_context_with_env/2;
export type_context_with_supervisor_types/2;
export lookup_supervisor_csv/1;
export type_name_in_supervisor_csv/2;
export module_typecheck_outcome_from_pair/2;

// SymbolEntry = { name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }
// ListSymbolEntry = List[<SymbolEntry>, mem(normal)]
// TypeContext = { env: List[<SymbolEntry>, mem(normal)] }
// TypeCheckResult = { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }
// TypeCheckWithContext = { result: <TypeCheckResult>, context: <TypeContext> }
// ModuleTypecheckOutcome = { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string, context: <TypeContext> }
// ParamConcreteEnv = { decl_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], concrete_types: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], base: <TypeContext> }

fn add_params_concrete_loop1(st: { decl_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], concrete_types: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], base: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } }) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } {
    case st.decl_params.is_nil of {
        true -> st.base;
        false -> case st.concrete_types.is_nil of {
            true -> st.base;
            false -> {
                new_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- add_symbol(st.base.env, st.decl_params.head.name, st.concrete_types.head.type_name, parser_ast@empty_effect_name_list(), "");
                add_params_concrete_loop1({
                    decl_params: st.decl_params.tail,
                    concrete_types: st.concrete_types.tail,
                    base: type_context_with_env(st.base, new_env)
                })
            }
        }
    }
}

fn module_typecheck_outcome_from_pair(r: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, c: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string, context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } } {
    {
        is_ok: r.is_ok,
        error_code: r.error_code,
        error_location: r.error_location,
        error_message: r.error_message,
        spec_section: r.spec_section,
        context: c
    }
}

fn empty_symbol_table() -> List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- empty[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)]()
    produces
        pure result
    end
}

fn create_type_context() -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } {
    env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- empty_symbol_table();
    env_with_false: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- add_symbol(env, "false", "boolean", parser_ast@empty_effect_name_list(), "");
    env_with_both: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- add_symbol(env_with_false, "true", "boolean", parser_ast@empty_effect_name_list(), "");
    { env: env_with_both }
}

// Replace env (let bindings, params, pattern bindings).
fn type_context_with_env(ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }, new_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)]) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } {
    { env: new_env }
}

// Phase E e3b: store supervisor CSV as a magic symbol in the env so struct shape stays unchanged.
fn type_context_with_supervisor_types(ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }, csv: string) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } {
    new_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- add_symbol(ctx.env, "__silica_e3b_sup_csv", csv, parser_ast@empty_effect_name_list(), "");
    { env: new_env }
}

fn lookup_supervisor_csv(ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }) -> string {
    lookup_symbol(ctx.env, "__silica_e3b_sup_csv")
}

fn csv_contains_loop(csv: string, t: string, i: int64, seg_start: int64) -> bool {
    case i >= len(csv) of {
        true -> substring(csv, seg_start, i) == t;
        false -> case substring(csv, i, i + 1) == "," of {
            true -> case substring(csv, seg_start, i) == t of {
                true -> true;
                false -> csv_contains_loop(csv, t, i + 1, i + 1)
            };
            false -> csv_contains_loop(csv, t, i + 1, seg_start)
        }
    }
}

fn type_name_in_supervisor_csv(t: string, csv: string) -> bool {
    case len(csv) == 0 of {
        true -> false;
        false -> csv_contains_loop(csv, t, 0, 0)
    }
}

fn add_symbol(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)], name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], source_module: string) -> List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] {
    sequence proc[mem(normal)]
        entry: { name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string } <- { name: name, type_name: type_name, declared_effects: declared_effects, is_effect_alias: false, source_module: source_module };
        result: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- prepend[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)](entry, env)
    produces
        pure result
    end
}

fn add_effect_alias_symbol(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)], name: string, effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] {
    sequence proc[mem(normal)]
        entry: { name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string } <- { name: name, type_name: "", declared_effects: effects, is_effect_alias: true, source_module: "" };
        result: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- prepend[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)](entry, env)
    produces
        pure result
    end
}

fn lookup_symbol(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)], name: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == name of {
            true -> env.head.type_name;
            false -> lookup_symbol(env.tail, name)
        }
    }
}

// Returns (found, type_name). Use when string comparison for "" is unreliable.
fn lookup_symbol_found(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)], name: string) -> (bool, string) {
    case env.is_nil of {
        true -> (false, "");
        false -> case env.head.name == name of {
            true -> (true, env.head.type_name);
            false -> lookup_symbol_found(env.tail, name)
        }
    }
}

// Defining Silica module for imported functions (spec §19.3); "" for locals and non-function symbols.
fn lookup_symbol_source_module(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)], name: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == name and env.head.is_effect_alias == false of {
            true -> env.head.source_module;
            false -> lookup_symbol_source_module(env.tail, name)
        }
    }
}

// First index of "@" in s, or -1 (spec §3.3.2 module@function call surface).
fn first_at_in_call_name(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_call_name(s, i + 1)
        }
    }
}

fn call_name_is_module_qualified(composite: string) -> bool {
    first_at_in_call_name(composite, 0) >= 0
}

// ("", name) if unqualified; else (module, function) for module@function.
fn split_module_qualified_call_name(composite: string) -> (string, string) {
    at: int64 <- first_at_in_call_name(composite, 0);
    case at < 0 of {
        true -> ("", composite);
        false -> (substring(composite, 0, at), substring(composite, at + 1, len(composite)))
    }
}

fn user_call_base_function_name(composite: string) -> string {
    at: int64 <- first_at_in_call_name(composite, 0);
    case at < 0 of {
        true -> composite;
        false -> substring(composite, at + 1, len(composite))
    }
}

// String return avoids (bool, string) tuple return ABI issues from proc[DeviceIO] callers (bootstrap on macOS).
fn lookup_fn_type_by_name_and_module(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)], fn_name: string, required_module: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case instantiated_fn_name@decl_name_matches(env.head.name, fn_name) and env.head.is_effect_alias == false of {
            true -> case len(required_module) == 0 of {
                true -> case env.head.source_module == "" of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module(env.tail, fn_name, required_module)
                };
                false -> case env.head.source_module == required_module of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module(env.tail, fn_name, required_module)
                }
            };
            false -> lookup_fn_type_by_name_and_module(env.tail, fn_name, required_module)
        }
    }
}

// Internal helper for callers that need (bool, string); prefer lookup_fn_type_by_name_and_module from proc callers.
fn lookup_fn_by_name_and_module(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)], fn_name: string, required_module: string) -> (bool, string) {
    ft: string <- lookup_fn_type_by_name_and_module(env, fn_name, required_module);
    case len(ft) == 0 of {
        true -> (false, "");
        false -> (true, ft)
    }
}

fn lookup_function_for_call(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)], composite_name: string) -> (bool, string) {
    ft: string <- lookup_function_type_for_call(env, composite_name);
    case len(ft) == 0 of {
        true -> (false, "");
        false -> (true, ft)
    }
}

fn lookup_function_type_for_call(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)], composite_name: string) -> string {
    at: int64 <- first_at_in_call_name(composite_name, 0);
    case at < 0 of {
        true -> lookup_fn_type_by_name_and_module(env, composite_name, "");
        false -> lookup_fn_type_by_name_and_module(env, substring(composite_name, at + 1, len(composite_name)), substring(composite_name, 0, at))
    }
}

fn type_check_ok() -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    { is_ok: true, error_code: "", error_location: parser_ast@zero_location(), error_message: "", spec_section: "" }
}

fn type_check_err(error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    { is_ok: false, error_code: error_code, error_location: error_location, error_message: error_message, spec_section: spec_section }
}
