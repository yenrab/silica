    LDR X10, [X20, #8]
    LDR X9, [SP], #16
    CMP X9, X10
    CSET X3, EQ
    CBZ X3, L_sc_o2728_done
    LDR X3, [SP]
    LDR X9, [X19, #16]
    STR X9, [SP, #-16]!
    LDR X10, [X20, #16]
