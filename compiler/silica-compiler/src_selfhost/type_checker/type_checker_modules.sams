    MOV X16, X1
    STR X16, [SP, #-16]!
    MOV X16, X2
    STR X16, [SP, #-16]!
    LDR X0, [SP, #32]
    LDR X1, [SP, #16]
    LDR X2, [SP, #0]
    ADD SP, SP, #48
