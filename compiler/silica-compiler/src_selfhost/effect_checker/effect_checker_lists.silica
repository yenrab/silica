{- List types and list primitives: memory space alignment for effect checking.
   Per design_documents/list_implementation_design.md §7, §9.3, §9.8:
   - List allocation / access requires mem(S) matching the memory space S in List[T, S].
   - sequence proc[mem(S)] must use the same S as every List[T, S] and list primitive
     instantiation in that block (static alignment; not subeffecting).
   Compiler-known primitives: empty, prepend, remove_head, length, map, filter, reduce.
-}

use parser_ast;
use lexer_core;
use effect_checker_core;

export is_list_primitive_fn/1;
export mem_effects_for_list_call/3;
export mem_effects_for_list_literal/2;
export mem_effects_from_case_pattern/2;
export extract_space_from_list_type_str/1;
export extract_space_from_generic_instantiation/1;
export mem_effects_from_fn_instantiation/3;
export first_mem_space_from_effects/1;
export check_list_mem_alignment_in_sequence/2;

fn is_list_primitive_fn(name: string) -> boolean {
    case name of {
        "empty" -> true;
        "prepend" -> true;
        "remove_head" -> true;
        "length" -> true;
        "map" -> true;
        "filter" -> true;
        "reduce" -> true;
        _: string -> false
    }
}

{- Try to read mem(S) from one generic-instantiation fragment (token, mem(...), or bare space name). -}
fn mem_space_from_instantiation_fragment(fragment: string) -> (boolean, string) {
    trimmed: string <- eff_strip_spaces_list(trim_leading_ws(fragment));
    case len(trimmed) == 0 of {
        true -> (false, "");
        false -> do
            bare: string <- unwrap_mem_param(trimmed);
            case effect_checker_core@is_valid_mem_parameter(bare) of {
                true -> (true, bare);
                false -> case effect_checker_core@is_valid_mem_parameter(trimmed) of {
                    true -> (true, trimmed);
                    false -> (false, "")
                }
            }
        end
    }
}

{- Generic call: value holds joined type args (e.g. "int64 normal", "int64,normal", "int64, int64, mem(normal)").
   Memory space S is the last depth-0 comma-separated arg, else the last whitespace-separated token.
   Parser strips `]` but not spaces before it, so joins can end with "… normal " — trim both ends before parsing. -}
fn extract_space_from_generic_instantiation(generic_value: string) -> (boolean, string) {
    case len(generic_value) == 0 of {
        true -> (false, "");
        false -> do
            trimmed: string <- eff_strip_spaces_list(trim_leading_ws(generic_value));
            case len(trimmed) == 0 of {
                true -> (false, "");
                false -> do
                    last_comma: int64 <- index_of_last_comma(trimmed);
                    case last_comma >= 0 of {
                        true -> do
                            tail: string <- eff_strip_spaces_list(trim_leading_ws(substring(trimmed, last_comma + 1, len(trimmed))));
                            (ok_tail: bool, space_tail: string) <- mem_space_from_instantiation_fragment(tail);
                            case ok_tail of {
                                true -> (true, space_tail);
                                false -> do
                                    first_comma: int64 <- index_of_first_comma(trimmed);
                                    case first_comma >= 0 of {
                                        true -> do
                                            after_first: string <- eff_strip_spaces_list(trim_leading_ws(substring(trimmed, first_comma + 1, len(trimmed))));
                                            mem_space_from_instantiation_fragment(after_first)
                                        end;
                                        false -> (false, "")
                                    }
                                end
                            }
                        end;
                        false -> do
                            last_sp: int64 <- last_space_index(trimmed);
                            case last_sp < 0 of {
                                true -> (false, "");
                                false -> mem_space_from_instantiation_fragment(substring(trimmed, last_sp + 1, len(trimmed)))
                            }
                        end
                    }
                end
            }
        end
    }
}

fn trim_leading_ws(s: string) -> string {
    trim_leading_from(s, 0)
}

fn trim_leading_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_leading_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

{- slot_lexemes_join can produce "List [int64, normal]"; find_list_bracket_start only sees "List[". -}
fn eff_strip_spaces_list_from(s: string, start: int64, end_inclusive: int64) -> string {
    case start > end_inclusive of {
        true -> "";
        false -> case substring(s, start, start + 1) == " " of {
            true -> eff_strip_spaces_list_from(s, start + 1, end_inclusive);
            false -> case substring(s, end_inclusive, end_inclusive + 1) == " " of {
                true -> eff_strip_spaces_list_from(s, start, end_inclusive - 1);
                false -> substring(s, start, end_inclusive + 1)
            }
        }
    }
}

fn eff_strip_spaces_list(s: string) -> string {
    eff_strip_spaces_list_from(s, 0, len(s) - 1)
}

fn eff_skip_spaces_index(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> i;
        false -> case substring(s, i, i + 1) == " " of {
            true -> eff_skip_spaces_index(s, i + 1);
            false -> i
        }
    }
}

fn eff_normalize_list_type_bracket(s: string) -> string {
    case len(s) < 6 of {
        true -> s;
        false -> case substring(s, 0, 4) == "List" of {
            true -> do
                j: int64 <- eff_skip_spaces_index(s, 4);
                case j >= len(s) of {
                    true -> s;
                    false -> case substring(s, j, j + 1) == "[" of {
                        true -> concat("List[", substring(s, j + 1, len(s)));
                        false -> s
                    }
                }
            end;
            false -> s
        }
    }
}

fn last_space_index(s: string) -> int64 {
    last_space_from(s, len(s) - 1)
}

fn last_space_from(s: string, i: int64) -> int64 {
    case i < 0 of {
        true -> -1;
        false -> case substring(s, i, i + 1) == " " of {
            true -> i;
            false -> last_space_from(s, i - 1)
        }
    }
}

fn find_list_bracket_start(s: string) -> int64 {
    find_list_bracket_from(s, 0)
}

{- Find start index of a list type: "List" then optional spaces then "[".
   slot_lexemes_join can produce "List [int64, normal]" (space before '['), so exact "List[" is not enough. -}
fn find_list_bracket_from(s: string, i: int64) -> int64 {
    case i + 4 > len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 4) == "List" of {
            true -> do
                j: int64 <- eff_skip_spaces_index(s, i + 4);
                case j >= len(s) of {
                    true -> find_list_bracket_from(s, i + 1);
                    false -> case substring(s, j, j + 1) == "[" of {
                        true -> i;
                        false -> find_list_bracket_from(s, i + 1)
                    }
                }
            end;
            false -> find_list_bracket_from(s, i + 1)
        }
    }
}

{- Index of the `]` that closes the `[` at open_idx (depth-balanced); -1 if missing or unbalanced. -}
fn find_matching_square_bracket_end_loop(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "[" of {
                true -> find_matching_square_bracket_end_loop(s, i + 1, depth + 1);
                false -> case c == "]" of {
                    true -> case depth == 1 of {
                        true -> i;
                        false -> find_matching_square_bracket_end_loop(s, i + 1, depth - 1)
                    };
                    false -> find_matching_square_bracket_end_loop(s, i + 1, depth)
                }
            }
        end
    }
}

fn find_matching_square_bracket_end(s: string, open_idx: int64) -> int64 {
    case open_idx < 0 of {
        true -> -1;
        false -> case open_idx >= len(s) of {
            true -> -1;
            false -> case substring(s, open_idx, open_idx + 1) == "[" of {
                true -> find_matching_square_bracket_end_loop(s, open_idx + 1, 1);
                false -> -1
            }
        }
    }
}

{- Parse List[T, S] from a type or pattern string; returns S when two parameters after List[.
   Accepts leading text (e.g. case pattern "[]: List[int64, normal]").
   Accepts List[...] embedded in larger types (e.g. tuple "( atom, List[int64, mem(normal)] )"). design §3.5, §9.8. -}
fn extract_space_from_list_type_str(type_str: string) -> (boolean, string) {
    norm: string <- eff_normalize_list_type_bracket(eff_strip_spaces_list(type_str));
    start: int64 <- find_list_bracket_start(norm);
    case start < 0 of {
        true -> (false, "");
        false -> do
            lbr: int64 <- eff_skip_spaces_index(norm, start + 4);
            case lbr >= len(norm) of {
                true -> (false, "");
                false -> case substring(norm, lbr, lbr + 1) == "[" of {
                    false -> (false, "");
                    true -> do
                        base: int64 <- lbr + 1;
                        inner_close: int64 <- find_matching_square_bracket_end(norm, lbr);
                        case inner_close < base of {
                            true -> (false, "");
                            false -> do
                                inner: string <- substring(norm, base, inner_close);
                                comma_idx: int64 <- index_of_first_comma(inner);
                                case comma_idx < 0 of {
                                    true -> (false, "");
                                    false -> do
                                        rest: string <- substring(inner, comma_idx + 1, len(inner));
                                        space: string <- eff_strip_spaces_list(trim_leading_ws(rest));
                                        bare: string <- unwrap_mem_param(space);
                                        case effect_checker_core@is_valid_mem_parameter(bare) of {
                                            true -> (true, bare);
                                            false -> case effect_checker_core@is_valid_mem_parameter(space) of {
                                                true -> (true, space);
                                                false -> (false, "")
                                            }
                                        }
                                    end
                                }
                            end
                        }
                    end
                }
            }
        end
    }
}

// Find first comma at depth 0; depth increases for (, [, {; decreases for ), ], }.
fn index_of_first_comma(s: string) -> int64 {
    index_of_first_comma_depth0(s, 0, 0)
}

fn index_of_last_comma(s: string) -> int64 {
    index_of_last_comma_depth0(s, 0, 0, -1)
}

fn index_of_last_comma_depth0(s: string, i: int64, depth: int64, last_at_depth0: int64) -> int64 {
    case i >= len(s) of {
        true -> last_at_depth0;
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> index_of_last_comma_depth0(s, i + 1, depth + 1, last_at_depth0);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> index_of_last_comma_depth0(s, i + 1, depth - 1, last_at_depth0);
                    false -> case c == "," of {
                        true -> case depth == 0 of {
                            true -> index_of_last_comma_depth0(s, i + 1, depth, i);
                            false -> index_of_last_comma_depth0(s, i + 1, depth, last_at_depth0)
                        };
                        false -> index_of_last_comma_depth0(s, i + 1, depth, last_at_depth0)
                    }
                }
            }
        end
    }
}

fn index_of_first_comma_depth0(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> index_of_first_comma_depth0(s, i + 1, depth + 1);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> index_of_first_comma_depth0(s, i + 1, depth - 1);
                    false -> case c == "," of {
                        true -> case depth == 0 of {
                            true -> i;
                            false -> index_of_first_comma_depth0(s, i + 1, depth)
                        };
                        false -> index_of_first_comma_depth0(s, i + 1, depth)
                    }
                }
            }
        end
    }
}

// Unwrap "mem(normal)" or "mem ( normal )" → "normal"; return input unchanged if not mem(...).
fn unwrap_mem_param(s: string) -> string {
    t: string <- eff_strip_spaces_list(s);
    case len(t) >= 5 of {
        true -> case substring(t, 0, 3) == "mem" of {
            true -> do
                j: int64 <- eff_skip_spaces_index(t, 3);
                case j < len(t) of {
                    true -> case substring(t, j, j + 1) == "(" of {
                        true -> do
                            k: int64 <- index_of_char_from(t, ")", j + 1);
                            case k > j of {
                                true -> eff_strip_spaces_list(substring(t, j + 1, k));
                                false -> t
                            }
                        end;
                        false -> t
                    };
                    false -> t
                }
            end;
            false -> t
        };
        false -> t
    }
}

fn index_of_char_from(s: string, ch: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == ch of {
            true -> i;
            false -> index_of_char_from(s, ch, i + 1)
        }
    }
}

fn contains_list_prefix(s: string) -> boolean {
    t: string <- eff_normalize_list_type_bracket(eff_strip_spaces_list(s));
    find_list_bracket_start(t) >= 0
}

{- mem(S) singleton for list operations at location loc. -}
fn mem_effect_singleton(space: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> ListEffectName {
    eff: EffectName <- EffectName { name: "mem", parameter: space, location: loc };
    parser_ast@cons_effect_name(eff, parser_ast@empty_effect_name_list())
}

{- Bracket text after a function name: `foo[mem(normal)]` -> `mem(normal)`. -}
fn bracket_instantiation_suffix(fn_name: string) -> string {
    lbr: int64 <- index_of_char_from(fn_name, "[", 0);
    case lbr < 0 of {
        true -> "";
        false -> do
            rbr: int64 <- index_of_char_from(fn_name, "]", lbr + 1);
            case rbr > lbr of {
                true -> substring(fn_name, lbr + 1, rbr);
                false -> ""
            }
        end
    }
}

{- mem(S) from call-site or definition bracket instantiation (`mem(normal)` or `int64, mem(normal)`). -}
fn mem_effects_from_generic_text(generic_text: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> ListEffectName {
    case len(generic_text) == 0 of {
        true -> parser_ast@empty_effect_name_list();
        false -> do
            (ok: bool, space: string) <- extract_space_from_generic_instantiation(generic_text);
            case ok of {
                true -> mem_effect_singleton(space, location);
                false -> do
                    bare: string <- unwrap_mem_param(eff_strip_spaces_list(generic_text));
                    case effect_checker_core@is_valid_mem_parameter(bare) of {
                        true -> mem_effect_singleton(bare, location);
                        false -> parser_ast@empty_effect_name_list()
                    }
                end
            }
        end
    }
}

fn mem_effects_from_fn_instantiation(generic_value: string, resolved_fn_name: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> ListEffectName {
    from_call: ListEffectName <- mem_effects_from_generic_text(generic_value, location);
    case effect_checker_core@effect_list_length(from_call) > 0 of {
        true -> from_call;
        false -> mem_effects_from_generic_text(bracket_instantiation_suffix(resolved_fn_name), location)
    }
}

fn mem_effects_for_list_call(fn_name: string, generic_value: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> ListEffectName {
    case is_list_primitive_fn(fn_name) of {
        false -> parser_ast@empty_effect_name_list();
        true -> do
            (ok: bool, space: string) <- extract_space_from_generic_instantiation(generic_value);
            case ok of {
                true -> mem_effect_singleton(space, location);
                false -> parser_ast@empty_effect_name_list()
            }
        end
    }
}

{- List literal / pattern annotation: mem(S) from List[T, S] text. -}
fn mem_effects_for_list_literal(type_str: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> ListEffectName {
    (ok: bool, space: string) <- extract_space_from_list_type_str(type_str);
    case ok of {
        true -> mem_effect_singleton(space, location);
        false -> parser_ast@empty_effect_name_list()
    }
}

fn mem_effects_from_case_pattern(pattern_text: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> ListEffectName {
    case pattern_text_may_contain_list(pattern_text) of {
        false -> parser_ast@empty_effect_name_list();
        true -> mem_effects_for_list_literal(pattern_text, location)
    }
}

{- First mem(...) parameter in an expanded effect list (sequence block). -}
fn first_mem_space_from_effects(effects: ListEffectName) -> string {
    case effects.is_nil of {
        true -> "";
        false -> case effects.head.name == "mem" of {
            true -> case effect_checker_core@is_empty_param(effects.head.parameter) of {
                false -> effects.head.parameter;
                true -> first_mem_space_from_effects(effects.tail)
            };
            false -> first_mem_space_from_effects(effects.tail)
        }
    }
}

fn pattern_text_may_contain_list(pat: string) -> boolean {
    contains_list_prefix(pat)
}

fn check_alignment_at_expr(expr: Expr, expected_space: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case len(expected_space) == 0 of {
        true -> effect_checker_core@effect_check_ok();
        false -> do
            case expr.kind == 20 of {
                true -> do
                    (ok: bool, sp: string) <- extract_space_from_list_type_str(expr.value);
                    case ok of {
                        false -> effect_checker_core@effect_check_ok();
                        true -> case sp == expected_space of {
                            true -> effect_checker_core@effect_check_ok();
                            false -> effect_checker_core@effect_check_err(
                                "E3011",
                                expr.location,
                                concat("List[T,S] memory space S mismatch: list type uses ", concat(sp, concat(" but sequence declares mem(", concat(expected_space, ") (list_implementation_design 9.8)")))),
                                "sect9.8"
                            )
                        }
                    }
                end;
                false -> case expr.kind == 6 of {
                    true -> do
                        case contains_list_prefix(expr.value) of {
                            false -> effect_checker_core@effect_check_ok();
                            true -> do
                                (ok2: bool, sp2: string) <- extract_space_from_list_type_str(expr.value);
                                case ok2 of {
                                    false -> effect_checker_core@effect_check_ok();
                                    true -> case sp2 == expected_space of {
                                        true -> effect_checker_core@effect_check_ok();
                                        false -> effect_checker_core@effect_check_err(
                                            "E3011",
                                            expr.location,
                                            concat("List memory space mismatch: binding type uses space ", concat(sp2, concat(" but sequence declares mem(", concat(expected_space, ")")))),
                                            "sect9.8"
                                        )
                                    }
                                }
                            end
                        }
                    end;
                    false -> case expr.kind == 4 of {
                        true -> do
                            case is_list_primitive_fn(expr.name) of {
                                false -> effect_checker_core@effect_check_ok();
                                true -> do
                                    (ok3: bool, sp3: string) <- extract_space_from_generic_instantiation(expr.value);
                                    case ok3 of {
                                        false -> effect_checker_core@effect_check_ok();
                                        true -> case sp3 == expected_space of {
                                            true -> effect_checker_core@effect_check_ok();
                                            false -> effect_checker_core@effect_check_err(
                                                "E3011",
                                                expr.location,
                                                concat("List primitive effect space mismatch for ", expr.name),
                                                "sect9.8"
                                            )
                                        }
                                    }
                                end
                            }
                        end;
                        false -> case expr.kind == 18 of {
                            true -> do
                                case pattern_text_may_contain_list(expr.value) of {
                                    false -> effect_checker_core@effect_check_ok();
                                    true -> do
                                        (ok4: bool, sp4: string) <- extract_space_from_list_type_str(expr.value);
                                        case ok4 of {
                                            false -> effect_checker_core@effect_check_ok();
                                            true -> case sp4 == expected_space of {
                                                true -> effect_checker_core@effect_check_ok();
                                                false -> effect_checker_core@effect_check_err(
                                                    "E3011",
                                                    expr.location,
                                                    concat("Case pattern list type memory space mismatch: ", concat(sp4, concat(" vs sequence mem(", concat(expected_space, ")")))),
                                                    "sect9.8"
                                                )
                                            }
                                        }
                                    end
                                }
                            end;
                            false -> effect_checker_core@effect_check_ok()
                        }
                    }
                }
            }
        end
    }
}

fn check_list_mem_alignment_in_sequence(seq_expr: Expr, expanded_declared: ListEffectName) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    expected: string <- first_mem_space_from_effects(expanded_declared);
    check_list_mem_alignment_walk(seq_expr, expected)
}

{- Walk body + produces of a sequence; skip nested kind 11 (checked separately). -}
fn check_list_mem_alignment_walk(expr: Expr, expected_space: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case expr.kind == 11 of {
        true -> effect_checker_core@effect_check_ok();
        false -> do
            at: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_alignment_at_expr(expr, expected_space);
            case at.is_ok of {
                false -> at;
                true -> check_list_mem_alignment_children(expr, expected_space)
            }
        end
    }
}

fn check_list_mem_alignment_children(expr: Expr, expected_space: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case expr.kind == 4 of {
        true -> do
            r1: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_list_mem_alignment_walk(expr.inner, expected_space);
            case r1.is_ok of {
                false -> r1;
                true -> check_list_mem_alignment_walk(expr.right_expr, expected_space)
            }
        end;
        false -> case expr.kind == 3 of {
            true -> do
                l3: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_list_mem_alignment_walk(expr.inner, expected_space);
                case l3.is_ok of {
                    false -> l3;
                    true -> check_list_mem_alignment_walk(expr.right_expr, expected_space)
                }
            end;
            false -> case expr.kind == 6 of {
                true -> do
                    r_in: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_list_mem_alignment_walk(expr.inner, expected_space);
                    case r_in.is_ok of {
                        false -> r_in;
                        true -> check_list_mem_alignment_walk(expr.right_expr, expected_space)
                    }
                end;
                false -> case expr.kind == 2 of {
                    true -> check_list_mem_alignment_walk(expr.inner, expected_space);
                    false -> case expr.kind == 10 of {
                        true -> do
                            t1: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_list_mem_alignment_walk(expr.inner, expected_space);
                            case t1.is_ok of {
                                false -> t1;
                                true -> check_list_mem_alignment_walk(expr.right_expr, expected_space)
                            }
                        end;
                        false -> case expr.kind == 13 of {
                            true -> do
                                cs: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_list_mem_alignment_walk(expr.inner, expected_space);
                                case cs.is_ok of {
                                    false -> cs;
                                    true -> check_case_branch_list_alignment(expr.right_expr, expected_space)
                                }
                            end;
                            false -> case expr.kind == 19 of {
                                true -> do
                                    i19: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_list_mem_alignment_walk(expr.inner, expected_space);
                                    case i19.is_ok of {
                                        false -> i19;
                                        true -> check_list_mem_alignment_walk(expr.right_expr, expected_space)
                                    }
                                end;
                                false -> case expr.kind == 20 of {
                                    true -> check_list_mem_alignment_walk(expr.inner, expected_space);
                                    false -> case expr.kind == 9 of {
                                        true -> check_list_literal_chain_alignment(expr, expected_space);
                                        false -> effect_checker_core@effect_check_ok()
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

{- Right-nested tuple/list literal chain (kind 9 or 20 nodes). -}
fn check_list_literal_chain_alignment(expr: Expr, expected_space: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case expr.kind == 20 of {
        true -> do
            at: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_alignment_at_expr(expr, expected_space);
            case at.is_ok of {
                false -> at;
                true -> check_list_mem_alignment_walk(expr.inner, expected_space)
            }
        end;
        false -> case expr.kind == 9 of {
            true -> do
                a1: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_list_mem_alignment_walk(expr.inner, expected_space);
                case a1.is_ok of {
                    false -> a1;
                    true -> check_list_literal_chain_alignment(expr.right_expr, expected_space)
                }
            end;
            false -> check_list_mem_alignment_walk(expr, expected_space)
        }
    }
}

{- kind 17: branch list; inner = kind 18; right_expr = next 17 or dummy. -}
fn check_case_branch_list_alignment(branches: Expr, expected_space: string) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case branches.kind == -1 of {
        true -> effect_checker_core@effect_check_ok();
        false -> case branches.kind == 17 of {
            true -> do
                one: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_list_mem_alignment_walk(branches.inner, expected_space);
                case one.is_ok of {
                    false -> one;
                    true -> check_case_branch_list_alignment(branches.right_expr, expected_space)
                }
            end;
            false -> check_list_mem_alignment_walk(branches, expected_space)
        }
    }
}
