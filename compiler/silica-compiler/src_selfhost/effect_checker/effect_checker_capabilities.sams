L_list_prepend_helper:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X1, X2, [SP, #-16]!
    STP X3, X4, [SP, #-16]!
    STR X5, [SP, #-16]!
    CBZ X2, L_lph_new_chunk
