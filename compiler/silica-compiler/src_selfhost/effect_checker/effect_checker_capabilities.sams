    CBZ X6, L_lph_new_chunk
    LDR X7, [X2, #8]
    SUB X8, X6, X3
    ADD X10, X7, X8
    LDR X11, [SP]
    CBZ X11, L_lph_room_scalar
    MOV X12, #0
L_lph_room_agg:
    CMP X12, X3
    B.GE L_lph_room_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
