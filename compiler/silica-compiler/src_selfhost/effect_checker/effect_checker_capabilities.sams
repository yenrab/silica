L_lph_room_stored:
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDR X5, [SP], #16
    LDP X3, X4, [SP], #16
    LDP X1, X2, [SP], #16
    LDR X6, [X2]
    ADD X6, X6, #1
    STR X6, [X0]
    LDR X7, [X2, #8]
    STR X7, [X0, #8]
    LDR X8, [X2, #16]
    SUB X8, X8, X3
    STR X8, [X0, #16]
    LDP X29, X30, [SP], #16
