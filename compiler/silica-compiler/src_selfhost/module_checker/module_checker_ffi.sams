.bss
.balign 8
.lcomm _silica_frame_depth, 8
.lcomm _silica_frame_max, 8
.lcomm _silica_fuel, 8
.lcomm _silica_saved_pc, 8

.text
    ; use parser_ast, diagnostics_core, type_checker_core
.global module_checker_ffi_validate_ffi_module_rules
.global module_checker_ffi_validate_export_item_ffi
.global module_checker_ffi_emit_ffi_wrapper_warnings
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



module_checker_ffi_dangerous_prefix:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

module_checker_ffi_is_dangerous_module_name:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0

    ; unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o1110|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, module_checker_ffi_dangerous_prefix@PAGE
    ADD X9, X9, module_checker_ffi_dangerous_prefix@PAGEOFF
    BLR X9
    MOV X20, X0
    MOV X0, X19
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X9, X12

    STR X9, [SP, #-16]!
    MOV X0, X20
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X10, X12

    LDR X9, [SP], #16

    CMP X9, X10
    CSET X3, GE
L_case_o1134_br_0:
    CMP W3, #0
    B.NE L_case_o1134_br_1
    MOV X0, #0
    B L_case_o1134_done
L_case_o1134_br_1:
    CMP W3, #1
    B.NE L_case_o1134_fb
    MOV X0, X19
    MOV X1, #0
    STP X0, X1, [SP, #-16]!
    MOV X0, X20
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X2, X12

    LDP X0, X1, [SP], #16
    BL L_substring_helper
    MOV X9, X0
    MOV X10, X20
    STP X0, X1, [SP, #-16]!
    MOV X0, X9
    MOV X1, X10
    BL L_string_cmp_helper
    CMP W0, #0
    CSET W12, EQ
    LDP X0, X1, [SP], #16
    MOV X0, X12

    B L_case_o1134_done
L_case_o1134_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o1134_done
L_case_o1134_done:

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

