// Post-type-check AST pass (Phase 0.4 #5 link-name mangling): rewrite qualified-call names so
// module@fn with multiple tag-0 overloads resolves to the mangled link name. Overload
// selection uses type_checker_expressions@find_tag0_decl_for_qualified_call with
// recv_type_for_trait_link_mangle (same trait-dispatch rules as the type checker).
//
// Walk:
//   - For each tag-0 declaration, add its parameters to a fresh env so infer_expr_type
//     can resolve param references during arg-type inference.
//   - Recurse into every Expr node. For kind==4 (call) with a qualified name, look up
//     the callee module in the world, infer the first argument's type, and call
//     overload_mangle@mangle_fn_part_if_overloaded. If no overloading exists the name
//     is returned unchanged, preserving behavior for non-trait code.
//   - For kind==6 (let binding), extend the env with `name: value` (value holds the
//     declared type text) before walking the body sub-expression.
//   - For kind==11 (sequence), walk the body as a binding chain (same env growth as
//     type_checker_expressions@context_after_sequence_body) so later calls see earlier binds.
//   - Unqualified calls in the same module use local_decls for overload mangling (stdlib internals).
//
// This pass runs in main.silica between type-check and SIR generation.

use parser_ast;
use type_checker_core;
use type_checker_tuple_decompose_helpers;
use type_checker_expressions;
use type_checker_lists;
use instantiated_fn_name;
use overload_mangle;

export mangle_calls_in_program/2;
export mangle_calls_in_named_programs/1;

// Explicit constructor helper: binding complex fields locally before the struct literal
// sidesteps the bootstrap compiler's structural-vs-Named inference for List-typed fields
// (the same workaround used in trait_specialization@clone_decl_with_first_param_type).
fn mk_expr(kind_v: int64, value_v: string, name_v: string, loc: { file: string, line: int64, column: int64, offset: int64 },
           inner_v: Expr, right_v: Expr,
           pb: ListTupleDecomposeBinding, se: ListEffectName) -> Expr {
    {
        kind: kind_v,
        value: value_v,
        name: name_v,
        location: loc,
        inner: inner_v,
        right_expr: right_v,
        pattern_bindings: pb,
        sequence_effects: se
    }
}

fn add_params_to_env(ps: ListParam, env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)]) -> List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] {
    case ps.is_nil of {
        true -> env;
        false -> {
            new_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- type_checker_core@add_symbol(env, ps.head.name, ps.head.type_name, parser_ast@empty_effect_name_list(), "");
            add_params_to_env(ps.tail, new_env)
        }
    }
}

fn extend_ctx_for_binding(ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }, bind_name: string, bind_type: string) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } {
    is_discard: bool <- bind_type == "unit" and bind_name == "_";
    case is_discard of {
        true -> ctx;
        false -> {
            extended_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- type_checker_core@add_symbol(ctx.env, bind_name, bind_type, parser_ast@empty_effect_name_list(), "");
            type_checker_core@type_context_with_env(ctx, extended_env)
        }
    }
}

// Returns the (possibly rewritten) name for a call. List primitives keep base name + value; user calls
// with generic instantiation compose brackets into the link name; qualified calls also apply overload mangling.
fn mangle_user_call_name(e: Expr, expected_ty: string, world: ListNamedProgram, ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }, local_decls: ListDeclaration) -> string {
    case e.kind == 4 of {
        false -> e.name;
        // Arg-chain pairs (extract_call_rest) use kind 4 with name "" — not user calls.
        // Postfix `impl ActorMessage {}` stores value "AM" on the pair; resolve_call_fn_name("", "AM")
        // would become "[AM]" → link symbol module__AM_ if we mangled here.
        true -> case len(e.name) == 0 of {
            true -> "";
            false -> case type_checker_lists@is_list_primitive_name(e.name) of {
            true -> e.name;
            false -> {
                (mod_part: string, fn_part: string) <- type_checker_core@split_module_qualified_call_name(e.name);
                instantiated: string <- instantiated_fn_name@resolve_call_fn_name(fn_part, e.value);
                callee_decls: ListDeclaration <- case len(mod_part) == 0 of {
                    true -> local_decls;
                    false -> {
                        (pf: bool, prog: Program) <- parser_ast@find_named_program(mod_part, world);
                        case pf of {
                            true -> prog.declarations;
                            false -> parser_ast@empty_list_decl()
                        }
                    }
                };
                ac: int64 <- overload_mangle@count_call_args_user_call(e);
                recv_inferred: string <- case ac > 0 of {
                    true -> type_checker_tuple_decompose_helpers@infer_expr_type(e.inner, ctx);
                    false -> ""
                };
                recv_ty: string <- type_checker_expressions@recv_type_for_trait_link_mangle(recv_inferred, callee_decls, world);
                new_fn: string <- overload_mangle@mangle_fn_part_if_overloaded(instantiated, ac, recv_ty, expected_ty, callee_decls, world);
                case len(mod_part) == 0 of {
                    true -> new_fn;
                    false -> concat(mod_part, concat("@", new_fn))
                }
            }
        }
        }
    }
}

// Walk a sequence body (let / tuple-decompose chain before `produces`).
fn walk_sequence_body(body: Expr, world: ListNamedProgram, ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }, local_decls: ListDeclaration) -> Expr {
    case body.kind == 6 of {
        true -> {
            new_inner: Expr <- walk_expr(body.inner, world, ctx, body.value, local_decls);
            extended: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- extend_ctx_for_binding(ctx, body.name, body.value);
            new_right: Expr <- walk_sequence_body(body.right_expr, world, extended, local_decls);
            mk_expr(body.kind, body.value, body.name, body.location, new_inner, new_right, body.pattern_bindings, body.sequence_effects)
        };
        false -> case body.kind == 10 of {
            true -> {
                new_inner: Expr <- walk_expr(body.inner, world, ctx, "", local_decls);
                extended: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- type_checker_tuple_decompose_helpers@add_bindings_to_context(ctx, body.pattern_bindings);
                new_right: Expr <- walk_sequence_body(body.right_expr, world, extended, local_decls);
                mk_expr(body.kind, body.value, body.name, body.location, new_inner, new_right, body.pattern_bindings, body.sequence_effects)
            };
            false -> walk_expr(body, world, ctx, "", local_decls)
        }
    }
}

// Walk an Expr tree. Rewrites call names in place-ish (returns a fresh node with the
// updated name) and recurses into inner and right_expr. Extends ctx for let bindings.
fn walk_expr(e: Expr, world: ListNamedProgram, ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }, expected_ty: string, local_decls: ListDeclaration) -> Expr {
    case e.kind < 0 of {
        true -> e;
        false -> {
            new_inner: Expr <- case e.kind == 11 of {
                true -> walk_sequence_body(e.inner, world, ctx, local_decls);
                false -> case e.kind == 6 of {
                    true -> walk_expr(e.inner, world, ctx, e.value, local_decls);
                    false -> walk_expr(e.inner, world, ctx, "", local_decls)
                }
            };
            new_right: Expr <- case e.kind == 11 of {
                true -> {
                    result_ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- type_checker_expressions@context_after_sequence_body(e.inner, ctx);
                    walk_expr(e.right_expr, world, result_ctx, expected_ty, local_decls)
                };
                false -> case e.kind == 6 of {
                    true -> {
                        extended: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- extend_ctx_for_binding(ctx, e.name, e.value);
                        walk_expr(e.right_expr, world, extended, "", local_decls)
                    };
                    false -> walk_expr(e.right_expr, world, ctx, "", local_decls)
                }
            };
            // Build a node with rewritten children so infer_expr_type on e.inner sees the
            // same argument (type doesn't depend on name); then compute the call-name rewrite.
            pre_e: Expr <- mk_expr(e.kind, e.value, e.name, e.location, new_inner, new_right, e.pattern_bindings, e.sequence_effects);
            call_expected: string <- case e.kind == 6 of {
                true -> e.value;
                false -> expected_ty
            };
            new_name: string <- mangle_user_call_name(pre_e, call_expected, world, ctx, local_decls);
            mk_expr(e.kind, e.value, new_name, e.location, new_inner, new_right, e.pattern_bindings, e.sequence_effects)
        }
    }
}

fn mangle_decl_body(d: Declaration, world: ListNamedProgram, base_ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }, local_decls: ListDeclaration) -> Declaration {
    case d.tag == 0 of {
        false -> d;
        true -> {
            env_with_params: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- add_params_to_env(d.parameters, base_ctx.env);
            decl_ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- type_checker_core@type_context_with_env(base_ctx, env_with_params);
            new_body: Expr <- walk_expr(d.body, world, decl_ctx, "", local_decls);
            params: ListParam <- d.parameters;
            eff: ListEffectName <- d.declared_effects;
            rtl: { file: string, line: int64, column: int64, offset: int64 } <- d.return_type_location;
            loc: { file: string, line: int64, column: int64, offset: int64 } <- d.location;
            {
                tag: d.tag,
                name: d.name,
                parameters: params,
                return_type_name: d.return_type_name,
                return_type_location: rtl,
                location: loc,
                body: new_body,
                declared_effects: eff
            }
        }
    }
}

fn mangle_decls(ds: ListDeclaration, world: ListNamedProgram, base_ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] }, local_decls: ListDeclaration) -> ListDeclaration {
    case ds.is_nil of {
        true -> parser_ast@empty_list_decl();
        false -> {
            head_new: Declaration <- mangle_decl_body(ds.head, world, base_ctx, local_decls);
            tail_new: ListDeclaration <- mangle_decls(ds.tail, world, base_ctx, local_decls);
            parser_ast@cons_declaration(head_new, tail_new)
        }
    }
}

fn mangle_calls_in_program(program: Program, world: ListNamedProgram) -> Program {
    base_ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- type_checker_core@create_type_context();
    new_decls: ListDeclaration <- mangle_decls(program.declarations, world, base_ctx, program.declarations);
    loc: { file: string, line: int64, column: int64, offset: int64 } <- program.location;
    { declarations: new_decls, location: loc }
}

// Rewrite every program in the world using the full world as the name-resolution target.
// Used when the compilation driver needs a self-consistent post-mangling world for a
// subsequent pass; individual compile_parsed_unit calls use mangle_calls_in_program.
fn mangle_calls_in_named_programs(world: ListNamedProgram) -> ListNamedProgram {
    case world.is_nil of {
        true -> world;
        false -> {
            new_prog: Program <- mangle_calls_in_program(world.head.program, world);
            parser_ast@cons_named_program(world.head.module_name, new_prog, mangle_calls_in_named_programs(world.tail))
        }
    }
}
