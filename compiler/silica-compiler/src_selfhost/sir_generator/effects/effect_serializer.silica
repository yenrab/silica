// Effect serialization: ListEffectName -> SIR text format string
// Converts parser AST effect lists to SIR effect set notation: "[]", "[device_io]", "[mem(normal), device_io]"
// Implements sir_design_spec §4.1 effect set syntax

use parser_ast;

export serialize_effects/1;

// Serialize a ListEffectName to SIR text format: "[e1, e2, ...]"
fn serialize_effects(effects: ListEffectName) -> string {
    case effects.is_nil of {
        true -> "[]";
        false -> concat("[", concat(serialize_effect_items(effects), "]"))
    }
}

// Serialize effect items as comma-separated list (no outer brackets)
fn serialize_effect_items(effects: ListEffectName) -> string {
    case effects.is_nil of {
        true -> "";
        false -> {
            head_str: string <- serialize_one_effect(effects.head);
            case effects.tail.is_nil of {
                true -> head_str;
                false -> concat(head_str, concat(", ", serialize_effect_items(effects.tail)))
            }
        }
    }
}

// Serialize a single EffectName: "device_io" or "mem(normal)"
// Use parameter == "" not len(parameter) == 0: bootstrap compiler len("") bug
fn serialize_one_effect(eff: EffectName) -> string {
    normalized: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- normalize_for_sir(eff);
    case normalized.parameter == "" of {
        true -> normalized.name;
        false -> concat(normalized.name, concat("(", concat(normalized.parameter, ")")))
    }
}

// Normalize legacy names before serialization (DeviceIO -> device_io)
fn normalize_for_sir(eff: EffectName) -> EffectName {
    case eff.name of {
        "DeviceIO" -> { name: "device_io", parameter: "", location: eff.location };
        _: string -> eff
    }
}
