    MOV X26, X21
    MOV X27, X23
Lcmp_cloop:
    LDRB W28, [X26], #1
    LDRB W1, [X27], #1
    CMP W28, W1
    B.LO Lcmp_lt
    B.HI Lcmp_gt
    SUBS X25, X25, #1
    B.NE Lcmp_cloop
Lcmp_len:
    CMP X22, X24
    B.EQ Lcmp_eq
    B.LO Lcmp_lt
    B Lcmp_gt
Lcmp_anull:
    CBZ X20, Lcmp_eq
Lcmp_lt:
    MOV W0, #-1
    B Lcmp_exit
Lcmp_gt:
    MOV W0, #1
    B Lcmp_exit
Lcmp_eq:
