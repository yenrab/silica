    CBZ X19, Llb_z
    LDR X1, [X19]
    MOV X2, #-1
    CMP X1, X2
    B.NE Llb_bad
    LDR X0, [X19, #16]
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_z:
    MOV X0, #0
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_bad:
