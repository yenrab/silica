    ADD X1, X19, #16
    MOVZ X2, #0x40, LSL #16
    CMP X1, X2
    CSEL X1, X1, X2, HI
    MOV X21, X1
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
