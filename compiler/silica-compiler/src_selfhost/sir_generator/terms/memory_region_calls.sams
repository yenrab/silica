L_string_eq_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Leq_anull
    CBZ X20, Leq_neq
    LDR X1, [X19]
    MOV X2, #-1
    CMP X1, X2
    B.NE Leq_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    CMP X1, X2
    B.NE Leq_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
Leq_n2_done:
    CMP X22, X24
    B.NE Leq_neq
    CBZ X22, Leq_yes
    MOV X25, X21
    MOV X26, X23
    MOV X27, X22
Leq_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Leq_neq
    SUBS X27, X27, #1
    B.NE Leq_cloop
Leq_yes:
    MOV W0, #1
    B Leq_exit
Leq_anull:
    CBZ X20, Leq_yes
    B Leq_neq
Leq_neq:
    MOV W0, #0
Leq_exit:
