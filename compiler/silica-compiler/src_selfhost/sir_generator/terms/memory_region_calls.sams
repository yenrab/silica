    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lcmp_anull
    CBZ X20, Lcmp_gt
    LDR X1, [X19]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lcmp_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    CMP X1, X2
    B.NE Lcmp_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
