.bss
.balign 8
.lcomm _silica_frame_depth, 8
.lcomm _silica_frame_max, 8
.lcomm _silica_fuel, 8
.lcomm _silica_saved_pc, 8

.text
    ; use parser_ast, sir_ast, terms_helpers, type_checker_record_types, type_checker_tuple_decompose_helpers
.global struct_terms_record_type_for_struct_literal
.global struct_terms_is_last_struct_literal_node
.global struct_terms_build_record_make_layer
.global struct_terms_build_record_proj_prim
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



struct_terms_record_type_for_struct_literal:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2

    MOV X16, X21
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o1911|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, type_checker_record_types_record_type_starts@PAGE
    ADD X9, X9, type_checker_record_types_record_type_starts@PAGEOFF
    BLR X9

    MOV X3, X0
L_case_o1906_br_0:
    CMP W3, #1
    B.NE L_case_o1906_br_1
    MOV X0, X21
    B L_case_o1906_done
L_case_o1906_br_1:
    CMP W3, #0
    B.NE L_case_o1906_fb
    MOV X16, X19
    STR X16, [SP, #-16]!
    MOV X16, X20
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o2024|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, terms_helpers_sir_infer_struct_literal_type@PAGE
    ADD X9, X9, terms_helpers_sir_infer_struct_literal_type@PAGEOFF
    BLR X9

    B L_case_o1906_done
L_case_o1906_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o1906_done
L_case_o1906_done:

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

struct_terms_is_last_struct_literal_node:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0

    MOV X16, X19
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o2961|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, parser_ast_expr_root_node@PAGE
    ADD X9, X9, parser_ast_expr_root_node@PAGEOFF
    BLR X9
    MOV X20, X0
    MOV X16, X19
    STR X16, [SP, #-16]!
    LDR X16, [X20, #64]
    STR X16, [SP, #-16]!
    LDR X0, [SP, #16]
    LDR X1, [SP, #0]
    ADD SP, SP, #32
    ; effects []|sir_rec:o3432|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, parser_ast_expr_at@PAGE
    ADD X9, X9, parser_ast_expr_at@PAGEOFF
    BLR X9
    MOV X21, X0
    MOV X16, X21
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o3875|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, parser_ast_expr_root_node@PAGE
    ADD X9, X9, parser_ast_expr_root_node@PAGEOFF
    BLR X9
    MOV X22, X0
    LDR X9, [X22, #0]
    MOV X10, #21
    CMP X9, X10
    CSET X0, NE
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

struct_terms_build_record_make_layer:     STP X29, X30, [SP, #-16]!
    MOV X29, SP

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X16, #6
    STR X16, [SP, #-16]!
    MOV X16, X0
    STR X16, [SP, #-16]!
    MOV X16, X1
    STR X16, [SP, #-16]!
    ADRP X16, L_str_0@PAGE
    ADD X16, X16, L_str_0@PAGEOFF
    STR X16, [SP, #-16]!
    MOV X16, X2
    STR X16, [SP, #-16]!
    MOV X16, X3
    STR X16, [SP, #-16]!
    LDR X0, [SP, #80]
    LDR X1, [SP, #64]
    LDR X2, [SP, #48]
    LDR X3, [SP, #32]
    LDR X4, [SP, #16]
    LDR X5, [SP, #0]
    ADD SP, SP, #96
    ; effects []|sir_rec:o4547|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, sir_ast_make_sir_term@PAGE
    ADD X9, X9, sir_ast_make_sir_term@PAGEOFF
    BR X9


struct_terms_build_record_proj_prim:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2

    MOV X16, #6
    STR X16, [SP, #-16]!
    MOV X16, X19
    STR X16, [SP, #-16]!
    MOV X16, X20
    STR X16, [SP, #-16]!
    ADRP X16, L_str_1@PAGE
    ADD X16, X16, L_str_1@PAGEOFF
    STR X16, [SP, #-16]!
    MOV X16, X21
    STR X16, [SP, #-16]!
    ; unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o5087|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, sir_ast_dummy_sir_term@PAGE
    ADD X9, X9, sir_ast_dummy_sir_term@PAGEOFF
    BLR X9

    MOV X16, X0
    STR X16, [SP, #-16]!
    LDR X0, [SP, #80]
    LDR X1, [SP, #64]
    LDR X2, [SP, #48]
    LDR X3, [SP, #32]
    LDR X4, [SP, #16]
    LDR X5, [SP, #0]
    ADD SP, SP, #96
    ADRP X9, sir_ast_make_sir_term@PAGE
    ADD X9, X9, sir_ast_make_sir_term@PAGEOFF
    BLR X9

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #23
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

