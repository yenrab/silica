// Ordering identity built-in calls to SIR prim terms (Layer 1 §7.2).

use sir_ast;
use types;
use type_checker_core;
use parser_ast;

export is_ordering_identity_builtin/1;
export build_ordering_identity_prim_from_sir/4;
export is_fn_bind_type/1;
export is_lifted_lambda_identifier/1;
export ordering_env_binding_name/1;
export context_has_ordering_env_binding/2;
export build_ordering_env_zero/0;
export build_ordering_env_init/1;
export build_ordering_env_zero/0;
export wrap_fn_let_with_ordering_env/6;
export prepare_fn_binding_context/4;
export build_fn_binding_lets/5;
export build_ordering_env_for_fn_operand/2;

fn is_ordering_identity_builtin(call_name: string) -> bool {
    call_name == "ordering_identity_fresh_env" or call_name == "ordering_identity_materialize" or call_name == "ordering_identity_same" or call_name == "ordering_identity_bundle_make"
}

fn is_fn_bind_type(type_str: string) -> bool {
    t: string <- type_str;
    case len(t) >= 3 and substring(t, 0, 3) == "fn(" of {
        true -> true;
        false -> case len(t) >= 4 and substring(t, 0, 4) == "fn (" of {
            true -> true;
            false -> false
        }
    }
}

fn is_lifted_lambda_identifier(name: string) -> bool {
    lifted_lambda_sub_at(name, 0)
}

fn lifted_lambda_sub_at(m: string, i: int64) -> bool {
    case i + 6 > len(m) of {
        true -> false;
        false -> case substring(m, i, i + 6) == ".__lam" of {
            true -> true;
            false -> lifted_lambda_sub_at(m, i + 1)
        }
    }
}

fn ordering_env_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__oid_env")
}

fn context_has_ordering_env_binding(context: TypeContext, bind_name: string) -> bool {
    env_name: string <- ordering_env_binding_name(bind_name);
    (found: bool, _: string) <- type_checker_core@lookup_symbol_found(context.env, env_name);
    found
}

fn build_ordering_env_zero() -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(0, "int64", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn build_ordering_env_init(use_fresh: bool) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case use_fresh of {
        true -> sir_ast@make_sir_term(6, "int64", "[]", "ordering_identity_fresh_env", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        false -> build_ordering_env_zero()
    }
}

fn rhs_is_lambda_identifier(rhs_expr: Expr) -> bool {
    case rhs_expr.kind == 1 of {
        true -> is_lifted_lambda_identifier(rhs_expr.name);
        false -> false
    }
}

fn needs_ordering_env_binding(bind_type: string, bind_name: string, rhs_expr: Expr) -> bool {
    case is_fn_bind_type(bind_type) of {
        false -> false;
        true -> case len(bind_name) == 1 and substring(bind_name, 0, 1) == "_" of {
            true -> false;
            false -> true
        }
    }
}

fn use_fresh_ordering_env_for_rhs(rhs_expr: Expr) -> bool {
    rhs_is_lambda_identifier(rhs_expr)
}

fn build_ordering_env_for_fn_operand(context: TypeContext, fn_expr: Expr) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case fn_expr.kind == 1 of {
        true -> case context_has_ordering_env_binding(context, fn_expr.name) of {
            true -> {
                env_name: string <- ordering_env_binding_name(fn_expr.name);
                prefixed: string <- concat("%", env_name);
                sir_ast@make_sir_term(1, "int64", "", prefixed, sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
            };
            false -> build_ordering_env_zero()
        };
        false -> build_ordering_env_zero()
    }
}

fn prepare_fn_binding_context(context: TypeContext, bind_name: string, bind_type: string, rhs_expr: Expr) -> TypeContext {
    case needs_ordering_env_binding(bind_type, bind_name, rhs_expr) of {
        false -> {
            new_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- type_checker_core@add_symbol(context.env, bind_name, bind_type, parser_ast@empty_effect_name_list(), "");
            type_checker_core@type_context_with_env(context, new_env)
        };
        true -> {
            env_name: string <- ordering_env_binding_name(bind_name);
            env_symbols: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- type_checker_core@add_symbol(context.env, env_name, "int64", parser_ast@empty_effect_name_list(), "");
            fn_symbols: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] <- type_checker_core@add_symbol(env_symbols, bind_name, bind_type, parser_ast@empty_effect_name_list(), "");
            type_checker_core@type_context_with_env(context, fn_symbols)
        }
    }
}

fn build_fn_binding_lets(bind_name: string, bind_type: string, rhs_expr: Expr, rhs_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, inner_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    bind_type_sir: string <- types@type_name_to_sir(bind_type);
    fn_prefixed: string <- concat("%", bind_name);
    fn_let: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(2, bind_type_sir, "", fn_prefixed, rhs_sir, inner_sir);
    case needs_ordering_env_binding(bind_type, bind_name, rhs_expr) of {
        false -> fn_let;
        true -> {
            env_name: string <- ordering_env_binding_name(bind_name);
            env_prefixed: string <- concat("%", env_name);
            env_init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_ordering_env_init(use_fresh_ordering_env_for_rhs(rhs_expr));
            sir_ast@make_sir_term(2, "int64", "", env_prefixed, env_init, fn_let)
        }
    }
}

fn wrap_fn_let_with_ordering_env(context: TypeContext, bind_name: string, bind_type: string, rhs_expr: Expr, rhs_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, inner_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> ({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, TypeContext) {
    new_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: bool, source_module: string }, mem(normal)] } <- prepare_fn_binding_context(context, bind_name, bind_type, rhs_expr);
    let_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_fn_binding_lets(bind_name, bind_type, rhs_expr, rhs_sir, inner_sir);
    (let_term, new_context)
}

fn build_ordering_identity_prim_from_sir(call_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    case call_name of {
        "ordering_identity_fresh_env" -> sir_ast@make_sir_term(6, sir_type, "[]", "ordering_identity_fresh_env", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "ordering_identity_materialize" -> sir_ast@make_sir_term(6, sir_type, "[]", "ordering_identity_make", arg1, arg2);
        "ordering_identity_same" -> sir_ast@make_sir_term(6, sir_type, "[]", "ordering_identity_same", arg1, arg2);
        "ordering_identity_bundle_make" -> sir_ast@make_sir_term(6, sir_type, "[]", "ordering_identity_bundle_make", arg1, arg2);
        _: string -> sir_ast@make_sir_term(6, sir_type, "[]", call_name, arg1, arg2)
    }
}
