// Term dispatcher facade: kind dispatch + open-recursion callbacks into specialists.

use actor_calls;
use atoms;
use boolean_terms;
use checked_int64_calls;
use collection_constructor_calls;
use collection_result_calls;
use identifiers;
use literals;
use memory_region_calls;
use negate_builtins;
use ordering_identity_calls;
use sir_ast;
use string_calls;
use string_literals;
use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_lists;
use type_checker_recursive_tuples;
use types;
use terms_helpers;
use terms_actor_lowering;
use terms_tuple_lowering;
use terms_sequence_lowering;
use terms_trait_call_lowering;
use terms_region_lowering;
use terms_user_call_lowering;
use terms_data_lowering;
use terms_case_lowering;

export expr_to_sir/2;
export expr_to_sir_with_expected/3;
export expr_to_sir_function_body/3;

fn expr_to_sir_in_let_body(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, bound_name: string, bound_type: string, expected_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    ek_rel: int64 <- type_checker_expressions_helpers@expr_kind(expr) - 13;
    case ek_rel == 0 of {
        true -> terms_case_lowering@case_expr_to_sir(context, expr, expected_type, bound_name, bound_type, true, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        false -> case type_checker_expressions_helpers@expr_kind(expr) of {
        0 -> literals@expr_to_sir_with_type(context, expr, terms_helpers@literal_type_for_expected(expected_type));
        1 -> case (len(expected_type) >= 2 and substring(expected_type, 0, 2) == "fn")
            or terms_helpers@sir_identifier_is_function(context, type_checker_expressions_helpers@expr_name(expr)) of {
            true -> sir_ast@make_sir_term(0, "fn_ptr", type_checker_expressions_helpers@expr_name(expr), "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
            false -> identifiers@expr_to_sir_with_bound(context, expr, bound_name, bound_type)
        };
        2 -> expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, expected_type);
        5 -> case type_checker_expressions_helpers@expr_value(expr) == ":none" and type_checker_recursive_tuples@is_ref_optional_type(expected_type) of {
            true -> sir_ast@make_sir_term(0, "ref_none", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
            false -> atoms@expr_to_sir(context, expr)
        };
        7 -> boolean_terms@expr_to_sir(context, expr);
        8 -> string_literals@expr_to_sir(context, expr);
        9 -> terms_tuple_lowering@expr_to_sir_tuple_inline(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        10 -> terms_tuple_lowering@expr_to_sir_tuple_decompose_in_body(context, expr, bound_name, bound_type, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        11 -> terms_sequence_lowering@lower_sequence_block_in_body(context, expr, bound_name, bound_type, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        20 -> case len(type_checker_expressions_helpers@expr_value(expr)) > 0 of {
            true -> terms_data_lowering@expr_list_literal_from_root(context, expr, true, bound_name, bound_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
            false -> terms_data_lowering@expr_list_literal_from_expected_type(context, expr, expected_type, true, bound_name, bound_type, expr_to_sir_with_expected, expr_to_sir_in_let_body)
        };
        21 -> terms_data_lowering@lower_struct_literal_expr(context, expr, expected_type, true, bound_name, bound_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        22 -> terms_data_lowering@lower_field_access_expr(context, expr, true, bound_name, bound_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        6 -> {
            case collection_constructor_calls@is_collection_constructor_let(type_checker_expressions_helpers@expr_value(expr), type_checker_expressions_helpers@expr_child_inner(expr)) of {
                true -> {
                    rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, type_checker_expressions_helpers@expr_value(expr));
                    bind_type: string <- types@type_name_to_sir(type_checker_expressions_helpers@expr_value(expr));
                    new_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- { env: terms_helpers@sir_env_add_symbol(context.env, type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr)) };
                    body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(new_context, type_checker_expressions_helpers@expr_child_right(expr), type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr), expected_type);
                    collection_constructor_calls@build_collection_constructor_lets(new_context, type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr), type_checker_expressions_helpers@expr_child_inner(expr), rhs, body)
                };
                false -> {
                    rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, type_checker_expressions_helpers@expr_value(expr));
                    bind_type: string <- types@type_name_to_sir(type_checker_expressions_helpers@expr_value(expr));
                    prefixed: string <- concat("%", type_checker_expressions_helpers@expr_name(expr));
                    new_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- { env: terms_helpers@sir_env_add_symbol(context.env, type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr)) };
                    body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(new_context, type_checker_expressions_helpers@expr_child_right(expr), type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr), expected_type);
                    sir_ast@make_sir_term(2, bind_type, "", prefixed, rhs, body)
                }
            }
        };
        3 -> {
            operand_type: string <- terms_helpers@sir_infer_binop_operand_type_for_sir(expr, context, expected_type);
            right_operand_type: string <- case terms_helpers@is_shift_op_lexeme(type_checker_expressions_helpers@expr_value(expr)) of { true -> "int64"; false -> operand_type };
            left: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, operand_type);
            right: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_right(expr), bound_name, bound_type, right_operand_type);
            terms_helpers@build_prim_for_type(type_checker_expressions_helpers@expr_value(expr), left, right, operand_type, short_circuit_label_id(expr))
        };
        4 -> {
            call_base: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
            case terms_helpers@is_float_special_const_name(call_base) of {
                true -> terms_helpers@build_float_special_const(call_base);
                false -> case terms_helpers@is_float_predicate_name(call_base) of {
                    true -> {
                        arg_fp: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, terms_helpers@float_predicate_arg_type(call_base));
                        terms_helpers@build_float_predicate_from_sir(call_base, arg_fp)
                    };
                    false -> case call_base == "spawn_registered_supervisor" of {
                true -> terms_actor_lowering@lower_spawn_registered_supervisor_expr(context, expr, true, bound_name, bound_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case call_base == "call_supervisor" of {
                    true -> terms_actor_lowering@lower_call_supervisor_expr(context, expr, true, bound_name, bound_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                    false -> case checked_int64_calls@is_checked_int64_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> terms_trait_call_lowering@build_checked_int64_call_in_body(context, expr, bound_name, bound_type, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case collection_result_calls@is_collection_result_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> terms_trait_call_lowering@build_collection_result_call_in_body(context, expr, bound_name, bound_type, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case ordering_identity_calls@is_ordering_identity_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> terms_trait_call_lowering@build_ordering_identity_call_in_body(context, expr, bound_name, bound_type, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case memory_region_calls@is_region_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> terms_region_lowering@build_region_prim_in_body(context, expr, bound_name, bound_type, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                    false -> case actor_calls@is_actor_sir_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                    true -> terms_actor_lowering@lower_actor_builtin_expr(context, expr, expected_type, true, bound_name, bound_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                    false -> case type_checker_lists@is_list_primitive_name(type_checker_expressions_helpers@expr_name(expr)) of {
                    true -> terms_data_lowering@build_list_primitive_from_expr(context, expr, expected_type, true, bound_name, bound_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "append_file" of {
                    true -> {
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, "string");
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), bound_name, bound_type, "string");
                        string_calls@build_append_file_from_sir(arg1, arg2)
                    };
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "concatenate" or type_checker_expressions_helpers@expr_name(expr) == "concat" of {
                    true -> {
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, "string");
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), bound_name, bound_type, "string");
                        string_calls@build_concatenate_from_sir(arg1, arg2)
                    };
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "starts_with" or type_checker_expressions_helpers@expr_name(expr) == "ends_with" or type_checker_expressions_helpers@expr_name(expr) == "contains" of {
                    true -> {
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, "string");
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), bound_name, bound_type, "string");
                        string_calls@build_string_predicate_from_sir(type_checker_expressions_helpers@expr_name(expr), arg1, arg2)
                    };
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "substring" of {
                        true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                        true -> {
                            arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, "string");
                            arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), bound_name, bound_type, "int64");
                            arg3: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))), bound_name, bound_type, "int64");
                            string_calls@build_substring_from_sir(arg1, arg2, arg3)
                        };
                            false -> sir_ast@dummy_sir_term();
                        };
                        false -> case type_checker_expressions_helpers@expr_name(expr) == "substring_until_char" of {
                            true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                                true -> {
                                    arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, "string");
                                    arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), bound_name, bound_type, "int64");
                                    arg3: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))), bound_name, bound_type, "char");
                                    string_calls@build_substring_until_char_from_sir(arg1, arg2, arg3)
                                };
                                false -> sir_ast@dummy_sir_term();
                            };
                            false -> case call_base == "bnot" of {
                                true -> {
                                    arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, "uint64");
                                    terms_helpers@build_bnot_from_sir(arg)
                                };
                                false -> case negate_builtins@is_negate_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                                true -> {
                                    arg_t: string <- negate_builtins@negate_arg_type(type_checker_expressions_helpers@expr_name(expr));
                                    arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, arg_t);
                                    negate_builtins@build_negate_from_sir(type_checker_expressions_helpers@expr_name(expr), arg)
                                };
                                false -> case terms_helpers@is_single_arg_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                                    true -> {
                                        arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(context, type_checker_expressions_helpers@expr_child_inner(expr), bound_name, bound_type, terms_helpers@arg_expected_type(type_checker_expressions_helpers@expr_name(expr), expected_type));
                                        terms_helpers@build_single_arg_call(context, expr, arg)
                                    };
                                    false -> terms_user_call_lowering@build_user_call_from_expr_in_body(context, expr, bound_name, bound_type, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body)
                                };
                            }
                            }
                        }
                    }
                }
                }
                }
                }
                    }
                }
                }
                }
                }
            }
                }
            }
            }
        };
        19 -> terms_case_lowering@if_expr_to_sir(context, expr, expected_type, bound_name, bound_type, true, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        _: int64 -> sir_ast@dummy_sir_term();
        }
    }
}

fn expr_to_sir_function_body(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case terms_helpers@root_body_is_tail_user_call(expr) of {
        true -> terms_user_call_lowering@build_user_call_from_expr_tail(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        false -> expr_to_sir_with_expected(context, expr, expected_type)
    }
}

fn expr_to_sir_with_expected(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    ek_rel: int64 <- type_checker_expressions_helpers@expr_kind(expr) - 13;
    case ek_rel == 0 of {
        true -> terms_case_lowering@case_expr_to_sir(context, expr, expected_type, "", "", false, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        false -> case type_checker_expressions_helpers@expr_kind(expr) of {
        0 -> literals@expr_to_sir_with_type(context, expr, terms_helpers@literal_type_for_expected(expected_type));
        1 -> case (len(expected_type) >= 2 and substring(expected_type, 0, 2) == "fn")
            or terms_helpers@sir_identifier_is_function(context, type_checker_expressions_helpers@expr_name(expr)) of {
            true -> sir_ast@make_sir_term(0, "fn_ptr", type_checker_expressions_helpers@expr_name(expr), "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
            false -> identifiers@expr_to_sir(context, expr)
        };
        2 -> expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), expected_type);
        5 -> case type_checker_expressions_helpers@expr_value(expr) == ":none" and type_checker_recursive_tuples@is_ref_optional_type(expected_type) of {
            true -> sir_ast@make_sir_term(0, "ref_none", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
            false -> atoms@expr_to_sir(context, expr)
        };
        7 -> boolean_terms@expr_to_sir(context, expr);
        8 -> string_literals@expr_to_sir(context, expr);
        9 -> terms_tuple_lowering@expr_to_sir_tuple_inline(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        10 -> terms_tuple_lowering@expr_to_sir_tuple_decompose(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        11 -> terms_sequence_lowering@lower_sequence_block_with_expected(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        20 -> case len(type_checker_expressions_helpers@expr_value(expr)) > 0 of {
            true -> terms_data_lowering@expr_list_literal_from_root(context, expr, false, "", "", expr_to_sir_with_expected, expr_to_sir_in_let_body);
            false -> terms_data_lowering@expr_list_literal_from_expected_type(context, expr, expected_type, false, "", "", expr_to_sir_with_expected, expr_to_sir_in_let_body)
        };
        21 -> terms_data_lowering@lower_struct_literal_expr(context, expr, expected_type, false, "", "", expr_to_sir_with_expected, expr_to_sir_in_let_body);
        22 -> terms_data_lowering@lower_field_access_expr(context, expr, false, "", "", expr_to_sir_with_expected, expr_to_sir_in_let_body);
        6 -> {
            case collection_constructor_calls@is_collection_constructor_let(type_checker_expressions_helpers@expr_value(expr), type_checker_expressions_helpers@expr_child_inner(expr)) of {
                true -> {
                    rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), type_checker_expressions_helpers@expr_value(expr));
                    bind_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- { env: terms_helpers@sir_env_add_symbol(context.env, type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr)) };
                    body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(bind_context, type_checker_expressions_helpers@expr_child_right(expr), type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr), expected_type);
                    collection_constructor_calls@build_collection_constructor_lets(bind_context, type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr), type_checker_expressions_helpers@expr_child_inner(expr), rhs, body)
                };
                false -> {
                    rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), type_checker_expressions_helpers@expr_value(expr));
                    bind_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- ordering_identity_calls@prepare_fn_binding_context(context, type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr), type_checker_expressions_helpers@expr_child_inner(expr));
                    body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_in_let_body(bind_context, type_checker_expressions_helpers@expr_child_right(expr), type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr), expected_type);
                    ordering_identity_calls@build_fn_binding_lets(type_checker_expressions_helpers@expr_name(expr), type_checker_expressions_helpers@expr_value(expr), type_checker_expressions_helpers@expr_child_inner(expr), rhs, body)
                }
            }
        };
        3 -> {
            operand_type: string <- terms_helpers@sir_infer_binop_operand_type_for_sir(expr, context, expected_type);
            right_operand_type: string <- case terms_helpers@is_shift_op_lexeme(type_checker_expressions_helpers@expr_value(expr)) of { true -> "int64"; false -> operand_type };
            left: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), operand_type);
            right: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_right(expr), right_operand_type);
            terms_helpers@build_prim_for_type(type_checker_expressions_helpers@expr_value(expr), left, right, operand_type, short_circuit_label_id(expr))
        };
        4 -> {
            call_base: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
            case terms_helpers@is_float_special_const_name(call_base) of {
                true -> terms_helpers@build_float_special_const(call_base);
                false -> case terms_helpers@is_float_predicate_name(call_base) of {
                    true -> {
                        arg_fp: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), terms_helpers@float_predicate_arg_type(call_base));
                        terms_helpers@build_float_predicate_from_sir(call_base, arg_fp)
                    };
                    false -> case call_base == "spawn_registered_supervisor" of {
                true -> terms_actor_lowering@lower_spawn_registered_supervisor_expr(context, expr, false, "", "", expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case call_base == "call_supervisor" of {
                true -> terms_actor_lowering@lower_call_supervisor_expr(context, expr, false, "", "", expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case checked_int64_calls@is_checked_int64_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> terms_trait_call_lowering@build_checked_int64_call(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case collection_result_calls@is_collection_result_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> terms_trait_call_lowering@build_collection_result_call(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case ordering_identity_calls@is_ordering_identity_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> terms_trait_call_lowering@build_ordering_identity_call(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case memory_region_calls@is_region_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> terms_region_lowering@build_region_prim(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body);
                false -> case actor_calls@is_actor_sir_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                    true -> terms_actor_lowering@lower_actor_builtin_expr(context, expr, expected_type, false, "", "", expr_to_sir_with_expected, expr_to_sir_in_let_body);
                    false -> case type_checker_lists@is_list_primitive_name(type_checker_expressions_helpers@expr_name(expr)) of {
                    true -> terms_data_lowering@build_list_primitive_from_expr(context, expr, expected_type, false, "", "", expr_to_sir_with_expected, expr_to_sir_in_let_body);
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "append_file" of {
                    true -> {
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), "string");
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string");
                        string_calls@build_append_file_from_sir(arg1, arg2)
                    };
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "concatenate" or type_checker_expressions_helpers@expr_name(expr) == "concat" of {
                    true -> {
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), "string");
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string");
                        string_calls@build_concatenate_from_sir(arg1, arg2)
                    };
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "starts_with" or type_checker_expressions_helpers@expr_name(expr) == "ends_with" or type_checker_expressions_helpers@expr_name(expr) == "contains" of {
                    true -> {
                        arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), "string");
                        arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "string");
                        string_calls@build_string_predicate_from_sir(type_checker_expressions_helpers@expr_name(expr), arg1, arg2)
                    };
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "substring" of {
                        true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                        true -> {
                            arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), "string");
                            arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "int64");
                            arg3: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))), "int64");
                            string_calls@build_substring_from_sir(arg1, arg2, arg3)
                        };
                            false -> sir_ast@dummy_sir_term();
                        };
                        false -> case type_checker_expressions_helpers@expr_name(expr) == "substring_until_char" of {
                            true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
                                true -> {
                                    arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), "string");
                                    arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)), "int64");
                                    arg3: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_right(expr))), "char");
                                    string_calls@build_substring_until_char_from_sir(arg1, arg2, arg3)
                                };
                                false -> sir_ast@dummy_sir_term();
                            };
                            false -> case call_base == "bnot" of {
                                true -> {
                                    arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), "uint64");
                                    terms_helpers@build_bnot_from_sir(arg)
                                };
                                false -> case negate_builtins@is_negate_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                                true -> {
                                    arg_t: string <- negate_builtins@negate_arg_type(type_checker_expressions_helpers@expr_name(expr));
                                    arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), arg_t);
                                    negate_builtins@build_negate_from_sir(type_checker_expressions_helpers@expr_name(expr), arg)
                                };
                                false -> case terms_helpers@is_single_arg_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                                    true -> {
                                        arg_type: string <- terms_helpers@arg_expected_type(type_checker_expressions_helpers@expr_name(expr), expected_type);
                                        arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- expr_to_sir_with_expected(context, type_checker_expressions_helpers@expr_child_inner(expr), arg_type);
                                        terms_helpers@build_single_arg_call(context, expr, arg)
                                    };
                                    false -> terms_user_call_lowering@build_user_call_from_expr(context, expr, expected_type, expr_to_sir_with_expected, expr_to_sir_in_let_body)
                                };
                            }
                            }
                        }
                    }
                }
                }
                }
                }
                    }
                }
                }
                }
                }
            }
                }
            }
            }
        };
        19 -> terms_case_lowering@if_expr_to_sir(context, expr, expected_type, "", "", false, expr_to_sir_with_expected, expr_to_sir_in_let_body);
        _: int64 -> sir_ast@dummy_sir_term();
        }
    }
}

// Convert { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } to SIR handle. Dispatches on kind. Uses int64 as default for literals/binary ops.
// Kind 0: integer literal -> const(type, value)
// Kind 1: identifier -> var(%name)
// Kind 2: parenthesized -> recurse on inner
// Kind 3: binary op -> prim(add/sub/etc)
// Kind 4: call -> call(callee, arg)
// Kind 5: atom literal -> const(atom, value)
// Kind 6: let binding -> let(name, type, rhs, body)

fn expr_to_sir(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    expr_to_sir_with_expected(context, expr, "int64")
}

// --- case expression ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 13) -> SIR kind 3; branch list kind 7; branch kind 8 ---

// Names the label the emitter needs to branch over a short-circuited `and` / `or` right operand.
// The source offset is unique per expression and is already used this way for recursion metadata.
fn short_circuit_label_id(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    concat("o", literals@int64_to_decimal_string(type_checker_expressions_helpers@expr_loc(expr).offset))
}
