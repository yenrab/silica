// Boolean literal expression to SIR term (Expr kind 7)
// Builds const(bool, "true") or const(bool, "false")

use parser_ast;
use type_checker_core;
use sir_ast;
use types;

export expr_to_sir/2;

// Build SIR const term for boolean literal (Expr kind 7)
fn expr_to_sir(context: TypeContext, expr: Expr) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(0, types@type_name_to_sir("boolean"), expr.value, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}
