    LDP X29, X30, [SP], #16
    RET
L_lth_nil:
    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET

L_list_length_helper:
    CBZ X0, L_list_len_nil
    LDR X0, [X0]
    RET
L_list_len_nil:
