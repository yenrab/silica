L_lph_room_stored:
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDR X5, [SP], #16
    LDP X3, X4, [SP], #16
    LDP X1, X2, [SP], #16
    LDR X6, [X2]
    ADD X6, X6, #1
    STR X6, [X0]
    LDR X7, [X2, #8]
    STR X7, [X0, #8]
    LDR X8, [X2, #16]
    SUB X8, X8, X3
    STR X8, [X0, #16]
    LDP X29, X30, [SP], #16
    RET
L_lph_new_chunk:
    ADD X0, X4, #8
    BL _silica_rt_region_alloc
    MOV X6, X0
    LDR X5, [SP]
    LDP X3, X4, [SP, #16]
    LDP X1, X2, [SP, #32]
    SUB X8, X4, X3
    ADD X10, X6, X8
    CBZ X5, L_lph_new_scalar
    MOV X12, #0
L_lph_new_agg:
    CMP X12, X3
    B.GE L_lph_new_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_new_agg
    B L_lph_new_stored
L_lph_new_scalar:
    CMP X3, #8
    B.EQ L_lph_ns8
    CMP X3, #4
    B.EQ L_lph_ns4
    CMP X3, #2
    B.EQ L_lph_ns2
