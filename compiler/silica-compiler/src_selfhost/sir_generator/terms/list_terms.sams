    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Leq_anull
    CBZ X20, Leq_neq
    LDR X1, [X19]
    MOV X2, #-1
    CMP X1, X2
    B.NE Leq_bad
    LDR X21, [X19, #8]
    LDR X22, [X19, #16]
    LDR X1, [X20]
    CMP X1, X2
    B.NE Leq_bad
    LDR X23, [X20, #8]
    LDR X24, [X20, #16]
