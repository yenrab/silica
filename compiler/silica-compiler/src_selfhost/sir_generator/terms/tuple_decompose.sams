L_list_prepend_helper:
    STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X1, X2, [SP, #-16]!
    STP X3, X4, [SP, #-16]!
    STR X5, [SP, #-16]!
    CBZ X2, L_lph_new_chunk
    LDR X6, [X2, #16]
    CBZ X6, L_lph_new_chunk
    LDR X7, [X2, #8]
    SUB X8, X6, X3
    ADD X10, X7, X8
    LDR X11, [SP]
    CBZ X11, L_lph_room_scalar
    MOV X12, #0
L_lph_room_agg:
    CMP X12, X3
    B.GE L_lph_room_stored
    LDR X13, [X1, X12]
    STR X13, [X10, X12]
    ADD X12, X12, #8
    B L_lph_room_agg
    B L_lph_room_stored
L_lph_room_scalar:
    CMP X3, #8
    B.EQ L_lph_rs8
    CMP X3, #4
    B.EQ L_lph_rs4
    CMP X3, #2
    B.EQ L_lph_rs2
    STRB W1, [X10]
    B L_lph_room_stored
L_lph_rs2:
    STRH W1, [X10]
    B L_lph_room_stored
L_lph_rs4:
    STR W1, [X10]
    B L_lph_room_stored
L_lph_rs8:
