fn find_struct_field_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field_name: string) -> (boolean, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    case node.kind == 21 of {
        false -> (false, expr);
        true -> case node.name == field_name of {
            true -> (true, parser_ast@expr_at(expr, node.inner));
            false -> find_struct_field_expr(parser_ast@expr_at(expr, node.right_expr), field_name)
        }
    }
}

fn sir_atom_const(value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(0, "atom", value, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn is_float_special_const_name(name: string) -> boolean {
    name == "float16_nan" or name == "float16_inf" or name == "float16_neg_inf" or name == "float32_nan" or name == "float32_inf" or name == "float32_neg_inf" or name == "float64_nan" or name == "float64_inf" or name == "float64_neg_inf"
}

fn float_special_const_type(name: string) -> string {
    case substring(name, 0, 7) == "float16" of {
        true -> "float16";
        false -> case substring(name, 0, 7) == "float32" of {
            true -> "float32";
            false -> "float64"
        }
    }
}

fn float_special_const_value(name: string) -> string {
    case name == "float16_nan" or name == "float32_nan" or name == "float64_nan" of {
        true -> "nan";
        false -> case name == "float16_neg_inf" or name == "float32_neg_inf" or name == "float64_neg_inf" of {
            true -> "-inf";
            false -> "inf"
        }
    }
}

fn build_float_special_const(name: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(0, float_special_const_type(name), float_special_const_value(name), "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn is_float_predicate_name(name: string) -> boolean {
    name == "float16_is_nan" or name == "float16_is_inf" or name == "float16_is_finite" or name == "float32_is_nan" or name == "float32_is_inf" or name == "float32_is_finite" or name == "float64_is_nan" or name == "float64_is_inf" or name == "float64_is_finite"
}

fn float_predicate_arg_type(name: string) -> string {
    case substring(name, 0, 7) == "float16" of {
        true -> "float16";
        false -> case substring(name, 0, 7) == "float32" of {
            true -> "float32";
            false -> "float64"
        }
    }
}

fn float_predicate_prim_name(name: string) -> string {
    case name == "float16_is_nan" or name == "float32_is_nan" or name == "float64_is_nan" of {
        true -> "is_nan";
        false -> case name == "float16_is_inf" or name == "float32_is_inf" or name == "float64_is_inf" of {
            true -> "is_inf";
            false -> "is_finite"
        }
    }
}

fn build_float_predicate_from_sir(name: string, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(6, "bool", "", float_predicate_prim_name(name), arg, sir_ast@dummy_sir_term())
}

fn build_bnot_from_sir(arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(6, "uint64", "", "bnot", arg, sir_ast@dummy_sir_term())
}

fn is_shift_op_lexeme(op: string) -> boolean {
    op == "shl" or op == "shr"
}

fn sir_int64_const(value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(0, "int64", value, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn sir_actor_ref_const(value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(0, "actor_ref", value, "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn sir_var(name: string, ty: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(1, ty, "", name, sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn sir_lookup_symbol_found(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string) -> (boolean, string) {
    case env.is_nil of {
        true -> (false, "");
        false -> case env.head.name == name of {
            true -> (true, env.head.type_name);
            false -> sir_lookup_symbol_found(env.tail, name)
        }
    }
}

fn sir_lookup_symbol_source_module(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == name and env.head.is_effect_alias == false of {
            true -> env.head.source_module;
            false -> sir_lookup_symbol_source_module(env.tail, name)
        }
    }
}

fn sir_term_nodes_len_local(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    case nodes.is_nil of {
        true -> 0;
        false -> 1 + sir_term_nodes_len_local(nodes.tail)
    }
}

fn sir_term_node_at_from_head_local(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx <= 0 of {
        true -> nodes.head;
        false -> sir_term_node_at_from_head_local(nodes.tail, idx - 1)
    }
}

fn sir_term_node_at_local(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    n: int64 <- sir_term_nodes_len_local(nodes);
    sir_term_node_at_from_head_local(nodes, n - 1 - idx)
}

fn sir_term_nodes_replace_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], list_pos: int64, new_node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, i: int64) -> List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)] <- case nodes.is_nil of {
            true -> empty[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]();
            false -> case i == list_pos of {
                true -> prepend[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](new_node, nodes.tail);
                false -> prepend[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes.head, sir_term_nodes_replace_at_from_head(nodes.tail, list_pos, new_node, i + 1))
            }
        }
    produces
        pure result
    end
}

// Update only the root node's value field; keep kind/name/child indices.

fn sir_term_with_root_value(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, new_value: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case term.root < 0 of {
        true -> term;
        false -> {
            n_len: int64 <- sir_term_nodes_len_local(term.nodes);
            root_node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- sir_term_node_at_local(term.nodes, term.root);
            new_node: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- { kind: root_node.kind, type_name: root_node.type_name, value: new_value, name: root_node.name, inner: root_node.inner, right_expr: root_node.right_expr };
            list_pos: int64 <- n_len - 1 - term.root;
            { nodes: sir_term_nodes_replace_at_from_head(term.nodes, list_pos, new_node, 0), root: term.root }
        }
    }
}

// Phase E e3b: tag spawn[linked] SIR prims with value \"[concurrency]|e3b:<StateT>\" so the AArch64 emitter
// can store _silica_supervisor_start_<T> into the child actor ACB (#280) when the behavior's state is a supervisor impl.
// e4a fix: also tag when state_t doesn't match but the module has exactly one supervisor impl,
// using the first supervisor type name from the CSV. This handles `spawn(0, sup_beh)` in supervisor modules.

fn sir_env_add_symbol(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string, type_name: string) -> List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] {
    sequence proc[mem(normal)]
        entry: { name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string } <- { name: name, type_name: type_name, declared_effects: parser_ast@empty_effect_name_list(), is_effect_alias: false, source_module: "" };
        result: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- prepend[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)](entry, env)
    produces
        pure result
    end
}

fn add_bindings_to_context(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, bindings: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } {
    case bindings.is_nil of {
        true -> context;
        false -> {
            b: { name: string, path: string, type_str: string } <- bindings.head;
            new_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- sir_env_add_symbol(context.env, b.name, b.type_str);
            add_bindings_to_context({ env: new_env }, bindings.tail)
        }
    }
}

fn extend_context_for_bind(ctx: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, name: string, ast_type: string) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } {
    { env: sir_env_add_symbol(ctx.env, name, ast_type) }
}

fn sir_find_top_arrow_from(s: string, i: int64, depth: int64) -> int64 {
    case i + 1 >= len(s) of {
        true -> -1;
        false -> case depth == 0 and substring(s, i, i + 2) == "->" of {
            true -> i;
            false -> {
                c: string <- substring(s, i, i + 1);
                d2: int64 <- case c == "(" or c == "[" or c == "{" of {
                    true -> depth + 1;
                    false -> case c == ")" or c == "]" or c == "}" of {
                        true -> depth - 1;
                        false -> depth
                    }
                };
                sir_find_top_arrow_from(s, i + 1, d2)
            }
        }
    }
}

fn sir_find_arrow_pos(s: string, i: int64) -> int64 {
    case i + 4 > len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 4) == " -> " of {
            true -> i;
            false -> sir_find_arrow_pos(s, i + 1)
        }
    }
}

fn sir_params_inner_from_func_type(func_type: string) -> string {
    arrow_pos: int64 <- sir_find_arrow_pos(func_type, 0);
    case arrow_pos < 0 of {
        true -> "";
        false -> {
            params_part: string <- substring(func_type, 0, arrow_pos);
            case len(params_part) < 2 of {
                true -> "";
                false -> substring(params_part, 1, len(params_part) - 1)
            }
        }
    }
}

// First formal parameter type from "(T1,T2,...) -> R" so call sites lower literals with the callee's type
// (e.g. float64 param + `2.718` inferring as float32 would load the wrong pool / reg class).

fn first_formal_param_type_from_scheme(func_type: string) -> string {
    inner: string <- sir_params_inner_from_func_type(func_type);
    case len(inner) == 0 of {
        true -> "";
        false -> case tuple_contains_comma(inner) of {
            true -> tuple_first_element_type(concat(concat("(", inner), ")"));
            false -> inner
        }
    }
}

// In-unit copy: cross-.ll return of string from type_checker_core lookup segfaults for module@fn (bootstrap macOS).

fn first_at_sir_call_name(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_sir_call_name(s, i + 1)
        }
    }
}

fn lookup_fn_type_by_name_and_module_sir(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], fn_name: string, required_module: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == fn_name and env.head.is_effect_alias == false of {
            true -> case len(required_module) == 0 of {
                true -> case env.head.source_module == "" of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module_sir(env.tail, fn_name, required_module)
                };
                false -> case env.head.source_module == required_module of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module_sir(env.tail, fn_name, required_module)
                }
            };
            false -> lookup_fn_type_by_name_and_module_sir(env.tail, fn_name, required_module)
        }
    }
}

fn lookup_function_type_for_call_sir(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], composite_name: string) -> string {
    at: int64 <- first_at_sir_call_name(composite_name, 0);
    case at < 0 of {
        true -> lookup_fn_type_by_name_and_module_sir(env, composite_name, "");
        false -> lookup_fn_type_by_name_and_module_sir(env, substring(composite_name, at + 1, len(composite_name)), substring(composite_name, 0, at))
    }
}


// SIR-local surface inference (simplified env). Does not use the type-checker interner.

fn sir_return_after_arrow_trim(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> sir_return_after_arrow_trim(s, i + 1);
            false -> case substring(s, i, i + 1) == ">" of {
                true -> sir_return_after_arrow_trim(s, i + 1);
                false -> substring(s, i, len(s))
            }
        }
    }
}

fn sir_parse_fn_return(func_type: string) -> string {
    arrow: int64 <- sir_find_top_arrow_from(func_type, 0, 0);
    case arrow < 0 of {
        true -> "";
        false -> sir_return_after_arrow_trim(substring(func_type, arrow + 2, len(func_type)), 0)
    }
}

fn sir_is_cmp_op(op: string) -> boolean {
    op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" or op == "and" or op == "or"
}

fn sir_infer_call_return(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    name: string <- type_checker_expressions_helpers@expr_name(expr);
    call_base: string <- type_checker_core@user_call_base_function_name(name);
    case call_base == "spawn" or call_base == "spawn_registered" of {
        true -> "actor_ref";
        false -> case call_base == "spawn_dangerous" or call_base == "spawn_dangerous_registered" of {
            true -> "dangerous_actor_ref";
            false -> case call_base == "spawn_registered_supervisor" of {
                true -> "supervisor_ref";
                false -> case call_base == "self" of {
                    true -> "actor_ref";
                    false -> case call_base == "cast" of {
                        true -> "boolean";
                        false -> case call_base == "send" or call_base == "link" or call_base == "demonitor" or call_base == "add_child" of {
                            true -> "atom";
                            false -> case call_base == "monitor" of {
                                true -> "monitor_ref";
                                false -> {
                                    typ: string <- lookup_function_type_for_call_sir(context.env, name);
                                    case len(typ) > 0 of {
                                        true -> sir_parse_fn_return(typ);
                                        false -> ""
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn sir_infer_tuple_chain(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    case type_checker_expressions_helpers@expr_kind(expr) == 9 of {
        true -> {
            first_type: string <- sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
            rest: string <- sir_infer_tuple_chain(context, type_checker_expressions_helpers@expr_child_right(expr));
            concat(first_type, concat(",", rest))
        };
        false -> sir_infer_expr_type(context, expr)
    }
}

fn sir_infer_expr_type(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> string {
    kind: int64 <- type_checker_expressions_helpers@expr_kind(expr);
    case kind of {
        0 -> type_checker_tuple_decompose_helpers@infer_literal_type(type_checker_expressions_helpers@expr_value(expr));
        1 -> {
            name: string <- type_checker_expressions_helpers@expr_name(expr);
            case name == "performance_cores" of {
                true -> "spawn_affinity_performance_cores";
                false -> case name == "efficiency_cores" of {
                    true -> "spawn_affinity_efficiency_cores";
                    false -> {
                        (found: boolean, ty: string) <- sir_lookup_symbol_found(context.env, name);
                        case found of { true -> ty; false -> "" }
                    }
                }
            }
        };
        2 -> sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
        3 -> {
            op: string <- type_checker_expressions_helpers@expr_value(expr);
            case sir_is_cmp_op(op) of {
                true -> "boolean";
                false -> sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr))
            }
        };
        4 -> sir_infer_call_return(context, expr);
        5 -> "atom";
        6 -> type_checker_expressions_helpers@expr_value(expr);
        7 -> "boolean";
        8 -> "string";
        12 -> sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr));
        20 -> {
            v: string <- type_checker_expressions_helpers@expr_value(expr);
            case len(v) > 0 of { true -> v; false -> "" }
        };
        9 -> concat("(", concat(sir_infer_tuple_chain(context, expr), ")"));
        13 -> sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_right(expr));
        19 -> sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr)));
        991 -> type_checker_expressions_helpers@expr_value(expr);
        992 -> type_checker_expressions_helpers@expr_value(expr);
        _: int64 -> ""
    }
}

fn sir_context_after_sequence_body(body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } {
    case type_checker_expressions_helpers@expr_kind(body) == 6 of {
        true -> {
            is_discard: boolean <- type_checker_expressions_helpers@expr_value(body) == "unit" and type_checker_expressions_helpers@expr_name(body) == "_";
            new_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- case is_discard of {
                true -> context;
                false -> { env: sir_env_add_symbol(context.env, type_checker_expressions_helpers@expr_name(body), type_checker_expressions_helpers@expr_value(body)) }
            };
            sir_context_after_sequence_body(type_checker_expressions_helpers@expr_child_right(body), new_context)
        };
        false -> case type_checker_expressions_helpers@expr_kind(body) == 10 of {
            true -> {
                rhs_type: string <- case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(body)) == 11 of {
                    true -> sir_infer_expr_type(sir_context_after_sequence_body(type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_inner(body)), context), type_checker_expressions_helpers@expr_child_right(type_checker_expressions_helpers@expr_child_inner(body)));
                    false -> sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(body))
                };
                rhs_trimmed: string <- type_checker_tuple_decompose_helpers@tuple_trim(rhs_type);
                tuple_for_fill: string <- case len(type_checker_expressions_helpers@expr_value(body)) > 0 of {
                    true -> type_checker_tuple_decompose_helpers@tuple_trim(type_checker_expressions_helpers@expr_value(body));
                    false -> rhs_trimmed
                };
                filled: List[{ name: string, path: string, type_str: string }, mem(normal)] <- type_checker_tuple_decompose_helpers@fill_empty_binding_types_from_rhs(type_checker_expressions_helpers@expr_pattern_bindings(body), tuple_for_fill);
                extended: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- add_bindings_to_context(context, filled);
                sir_context_after_sequence_body(type_checker_expressions_helpers@expr_child_right(body), extended)
            };
            false -> context
        }
    }
}

fn sir_infer_binop_operand_type_for_sir(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, enclosing_expected: string) -> string {
    op: string <- type_checker_expressions_helpers@expr_value(expr);
    case op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>" or op == ">>>" of {
        true -> "uint64";
        false -> case len(enclosing_expected) > 0 of {
            true -> enclosing_expected;
            false -> sir_infer_expr_type(context, type_checker_expressions_helpers@expr_child_inner(expr))
        }
    }
}

fn sir_case_extend_context_for_pattern(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, scrutinee_type: string, pat_str: string) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } {
    pi: { is_valid: boolean, pattern_kind: int64, bool_lit: boolean, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string } <- type_checker_tuple_decompose_helpers@case_parse_pattern(pat_str);
    case pi.is_valid of {
        false -> context;
        true -> case len(pi.bind_name) > 0 and pi.bind_name != "_" of {
            true -> { env: sir_env_add_symbol(context.env, pi.bind_name, case len(pi.bind_type) > 0 of { true -> pi.bind_type; false -> scrutinee_type }) };
            false -> case len(pi.list_tail_name) > 0 and pi.list_tail_name != "_" of {
                true -> { env: sir_env_add_symbol(context.env, pi.list_tail_name, case len(pi.list_tail_type) > 0 of { true -> pi.list_tail_type; false -> scrutinee_type }) };
                false -> context
            }
        }
    }
}

fn sir_type_text_is_function(type_text: string) -> boolean {
    case len(type_text) >= 3 and substring(type_text, 0, 3) == "fn(" of {
        true -> true;
        false -> case len(type_text) >= 2 and substring(type_text, 0, 1) == "(" of {
            // Top-level `->` only: tuple types like `(atom, fn(...) -> ...)` must not match.
            true -> sir_find_top_arrow_from(type_text, 1, 1) >= 0;
            false -> false
        }
    }
}

fn sir_identifier_is_function(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, name: string) -> boolean {
    sir_type_text_is_function(lookup_function_type_for_call_sir(context.env, name))
}

fn user_call_first_arg_expected_type(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, callee_name: string, inferred: string) -> string {
    case len(inferred) > 0 and type_checker_record_types@record_type_starts(inferred) of {
        true -> inferred;
        false -> {
            func_type: string <- lookup_function_type_for_call_sir(context.env, callee_name);
            case len(func_type) == 0 of {
                true -> inferred;
                false -> {
                    first_ty: string <- first_formal_param_type_from_scheme(func_type);
                    case len(first_ty) > 0 of {
                        true -> first_ty;
                        false -> inferred
                    }
                }
            }
        }
    }
}

fn user_call_expects_single_tuple_param(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, name: string) -> boolean {
    func_type: string <- lookup_function_type_for_call_sir(context.env, name);
    case len(func_type) == 0 of {
        true -> false;
        false -> {
            params_inner: string <- sir_params_inner_from_func_type(func_type);
            case len(params_inner) < 2 of {
                true -> false;
                false -> case substring(params_inner, 0, 1) == "(" and substring(params_inner, len(params_inner) - 1, len(params_inner)) == ")" of {
                    true -> tuple_contains_comma(substring(params_inner, 1, len(params_inner) - 1));
                    false -> false
                }
            }
        }
    }
}

fn literal_type_for_expected(expected_type: string) -> string {
    case expected_type of {
        "" -> "int64";
        "int32" -> "int32";
        "int16" -> "int16";
        "int8" -> "int8";
        "uint64" -> "uint64";
        "uint32" -> "uint32";
        "uint16" -> "uint16";
        "uint8" -> "uint8";
        "float64" -> "float64";
        "float32" -> "float32";
        "float16" -> "float16";
        "char" -> "char";
        _: string -> case len(expected_type) >= 2 and substring(expected_type, 0, 1) == "(" of {
            true -> literal_type_for_expected(tuple_first_element_type(expected_type));
            false -> "int64"
        }
    }
}

fn user_call_callee_sir_name(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, composite: string) -> string {
    (mod_part: string, fn_part: string) <- type_checker_core@split_module_qualified_call_name(composite);
    case len(mod_part) > 0 of {
        true -> concat(mod_part, concat("@", fn_part));
        false -> {
            src: string <- sir_lookup_symbol_source_module(context.env, fn_part);
            case len(src) > 0 of {
                true -> concat(src, concat("@", fn_part));
                false -> user_calls@qual_name(fn_part)
            }
        }
    }
}

fn call_params_tuple_for_sir(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, call_name: string) -> string {
    func_type: string <- lookup_function_type_for_call_sir(context.env, call_name);
    params: string <- sir_params_inner_from_func_type(func_type);
    case len(params) == 0 of {
        true -> "";
        false -> concat("(", concat(params, ")"))
    }
}

fn expected_or_inferred_call_arg_type(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, formal_type: string) -> string {
    inferred: string <- sir_infer_expr_type(context, expr);
    case len(inferred) > 0 of {
        true -> inferred;
        // Bare function identifiers are the important non-inferable case:
        // retain the signature formal so they lower as function addresses.
        false -> formal_type
    }
}

fn root_body_is_tail_user_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case type_checker_expressions_helpers@expr_kind(expr) == 4 of {
        false -> false;
        true -> case type_checker_lists@is_list_primitive_name(type_checker_expressions_helpers@expr_name(expr)) of {
            true -> false;
            false -> case memory_region_calls@is_region_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
            true -> false;
            false -> case actor_calls@is_actor_sir_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                true -> false;
                false -> case type_checker_expressions_helpers@expr_name(expr) == "append_file" of {
                true -> false;
                false -> case type_checker_expressions_helpers@expr_name(expr) == "concatenate" or type_checker_expressions_helpers@expr_name(expr) == "concat" of {
                true -> false;
                false -> case type_checker_expressions_helpers@expr_name(expr) == "starts_with" or type_checker_expressions_helpers@expr_name(expr) == "ends_with" or type_checker_expressions_helpers@expr_name(expr) == "contains" of {
                true -> false;
                false -> case type_checker_expressions_helpers@expr_name(expr) == "substring" of {
                    true -> false;
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "substring_until_char" of {
                        true -> false;
                        false -> case negate_builtins@is_negate_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                            true -> false;
                            false -> case is_single_arg_builtin(type_checker_expressions_helpers@expr_name(expr)) of {
                                true -> false;
                                false -> true
                            }
                        }
                    }
                }
                }
                }
                }
            }
        }
        }
    }
}

fn build_single_arg_call(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_name(expr) == "atom_bits" of {
        true -> atoms@build_atom_bits_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
        false -> case type_checker_expressions_helpers@expr_name(expr) == "actor_ref_bits" of {
            true -> atoms@build_actor_ref_bits_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
            false -> case type_checker_expressions_helpers@expr_name(expr) == "actor_ref_of_word" of {
                true -> atoms@build_actor_ref_of_word_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                false -> case type_checker_expressions_helpers@expr_name(expr) == "print_atom" of {
                    true -> atoms@build_print_atom_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                    false -> case type_checker_expressions_helpers@expr_name(expr) == "print_int32" of {
                        true -> int32_calls@build_print_int32_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint32" of {
                            true -> int32_calls@build_print_int32_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                            false -> case type_checker_expressions_helpers@expr_name(expr) == "print_int16" of {
                                true -> int16_calls@build_print_int16_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint16" of {
                                    true -> int16_calls@build_print_int16_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "print_int8" of {
                                        true -> int8_calls@build_print_int8_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_uint8" of {
                                            true -> int8_calls@build_print_int8_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "print_float32" or type_checker_expressions_helpers@expr_name(expr) == "print_float16" of {
                                                true -> float32_calls@build_print_float32_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "print_string" of {
                                                    true -> string_calls@build_print_string_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "println" of {
                                                        true -> string_calls@build_println_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "print_string_stderr" of {
                                                            true -> string_calls@build_print_string_stderr_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "println_stderr" of {
                                                                true -> string_calls@build_println_stderr_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "length_bytes" of {
                                                                    true -> string_calls@build_length_bytes_from_sir(arg);
                                                                    false -> case type_checker_expressions_helpers@expr_name(expr) == "length_chars" of {
                                                                        true -> string_calls@build_length_chars_from_sir(arg);
                                                                        false -> case type_checker_expressions_helpers@expr_name(expr) == "read_lines" of {
                                                                            true -> string_calls@build_read_lines_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                                                            false -> case type_checker_expressions_helpers@expr_name(expr) == "file_exists" of {
                                                                                true -> string_calls@build_file_exists_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                                                                false -> case type_checker_expressions_helpers@expr_name(expr) == "delete_file" of {
                                                                                    true -> string_calls@build_delete_file_from_sir(type_checker_expressions_helpers@expr_name(expr), arg);
                                                                                    false -> int64_calls@build_call_from_sir(type_checker_expressions_helpers@expr_name(expr), arg)
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn region_call_second_arg(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 4 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) == "" of {
        true -> type_checker_expressions_helpers@expr_child_inner(type_checker_expressions_helpers@expr_child_right(expr));
        false -> type_checker_expressions_helpers@expr_child_right(expr)
    }
}

fn is_single_arg_builtin(call_name: string) -> boolean {
    call_name == "atom_bits" or call_name == "actor_ref_bits" or call_name == "actor_ref_of_word" or call_name == "print_atom" or call_name == "print_int32" or call_name == "print_uint32" or call_name == "print_int16" or call_name == "print_uint16" or call_name == "print_int8" or call_name == "print_uint8" or call_name == "print_float16" or call_name == "print_float32" or call_name == "print_string" or call_name == "println" or call_name == "print_string_stderr" or call_name == "println_stderr" or call_name == "length_bytes" or call_name == "length_chars" or call_name == "len" or call_name == "print_int64" or call_name == "print_uint64" or call_name == "print_bool" or call_name == "print_float64" or call_name == "read_lines" or call_name == "file_exists" or call_name == "delete_file"
}

fn arg_expected_type(call_name: string, expected_type: string) -> string {
    case call_name of {
        "atom_bits" -> "atom";
        "actor_ref_bits" -> "actor_ref";
        "actor_ref_of_word" -> "int64";
        "concatenate" -> "string";
        "concat" -> "string";
        "substring" -> "string";
        "substring_until_char" -> "string";
        "print_string" -> "string";
        "println" -> "string";
        "print_string_stderr" -> "string";
        "println_stderr" -> "string";
        "length_bytes" -> "string";
        "length_chars" -> "string";
        "read_lines" -> "string";
        "file_exists" -> "string";
        "delete_file" -> "string";
        "append_file" -> "string";
        "print_int32" -> "int32";
        "print_uint32" -> "uint32";
        "print_int16" -> "int16";
        "print_uint16" -> "uint16";
        "print_int8" -> "int8";
        "print_uint8" -> "uint8";
        "print_uint64" -> "uint64";
        "print_float64" -> "float64";
        "print_float16" -> "float16";
        "print_float32" -> "float32";
        _: string -> expected_type
    }
}

fn build_prim_for_type(op_lexeme: string, left: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case expected_type of {
        "int32" -> int32_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "int16" -> int16_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "int8" -> int8_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "uint64" -> uint64_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "uint32" -> uint32_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "uint16" -> uint16_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "uint8" -> uint8_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "float64" -> float64_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "float32" -> float32_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        "float16" -> float16_binary_ops@build_prim_from_sir(op_lexeme, left, right);
        _: string -> int64_binary_ops@build_prim_from_sir(op_lexeme, left, right)
    }
}

fn tuple_first_element_type(tuple_type: string) -> string {
    elements: string <- tuple_inner_str(tuple_type);
    (first: string, _: string) <- tuple_split_first(elements);
    tuple_trim_ws(first)
}

fn tuple_rest_element_type(tuple_type: string) -> string {
    elements: string <- tuple_inner_str(tuple_type);
    (first: string, rest: string) <- tuple_split_first(elements);
    trimmed: string <- tuple_trim_ws(rest);
    case len(trimmed) == 0 of {
        true -> "";
        false -> case tuple_contains_comma(trimmed) of {
            true -> concat("(", concat(trimmed, ")"));
            false -> trimmed
        }
    }
}

fn tuple_inner_str(type_str: string) -> string {
    len_ts: int64 <- len(type_str);
    case len_ts < 2 of {
        true -> "";
        false -> case substring(type_str, 0, 1) == "(" of {
            true -> case substring(type_str, len_ts - 1, len_ts) == ")" of {
                true -> substring(type_str, 1, len_ts - 1);
                false -> ""
            };
            false -> ""
        }
    }
}

fn tuple_split_first(s: string) -> (string, string) {
    idx: int64 <- tuple_find_comma(s, 0);
    first: string <- substring(s, 0, idx);
    rest: string <- case idx < len(s) of {
        true -> substring(s, idx + 1, len(s));
        false -> ""
    };
    (first, rest)
}

fn tuple_find_comma(s: string, i: int64) -> int64 {
    tuple_find_comma_at_depth(s, i, 0)
}

// Top-level comma for tuple type splitting: count (), {}, [] so commas inside `{ a: T, b: U }` or `List[..., normal]` do not split `(flags, list)`.

fn tuple_find_comma_at_depth(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) of {
            "(" -> tuple_find_comma_at_depth(s, i + 1, depth + 1);
            ")" -> tuple_find_comma_at_depth(s, i + 1, depth - 1);
            "{" -> tuple_find_comma_at_depth(s, i + 1, depth + 1);
            "}" -> tuple_find_comma_at_depth(s, i + 1, depth - 1);
            "[" -> tuple_find_comma_at_depth(s, i + 1, depth + 1);
            "]" -> tuple_find_comma_at_depth(s, i + 1, depth - 1);
            "," -> case depth == 0 of {
                true -> i;
                false -> tuple_find_comma_at_depth(s, i + 1, depth)
            };
            _: string -> tuple_find_comma_at_depth(s, i + 1, depth)
        }
    }
}

fn tuple_contains_comma(s: string) -> boolean {
    tuple_contains_comma_at_depth(s, 0, 0)
}

// True iff a comma appears at nesting depth 0; ignores commas inside (), {}, [] (aligned with tuple_find_comma_at_depth).

fn tuple_contains_comma_at_depth(s: string, i: int64, depth: int64) -> boolean {
    case i >= len(s) of {
        true -> false;
        false -> case substring(s, i, i + 1) of {
            "(" -> tuple_contains_comma_at_depth(s, i + 1, depth + 1);
            ")" -> tuple_contains_comma_at_depth(s, i + 1, depth - 1);
            "{" -> tuple_contains_comma_at_depth(s, i + 1, depth + 1);
            "}" -> tuple_contains_comma_at_depth(s, i + 1, depth - 1);
            "[" -> tuple_contains_comma_at_depth(s, i + 1, depth + 1);
            "]" -> tuple_contains_comma_at_depth(s, i + 1, depth - 1);
            "," -> case depth == 0 of {
                true -> true;
                false -> tuple_contains_comma_at_depth(s, i + 1, depth)
            };
            _: string -> tuple_contains_comma_at_depth(s, i + 1, depth)
        }
    }
}

fn tuple_trim_ws(s: string) -> string {
    start: int64 <- tuple_trim_start(s, 0);
    len_s: int64 <- len(s);
    one_less: int64 <- len_s - 1;
    end_idx: int64 <- tuple_trim_end(s, one_less);
    case start <= end_idx of {
        true -> substring(s, start, end_idx + 1);
        false -> ""
    }
}

fn tuple_trim_start(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) == " " of {
            true -> tuple_trim_start(s, i + 1);
            false -> i
        }
    }
}

fn tuple_trim_end(s: string, i: int64) -> int64 {
    case i < 0 of {
        true -> -1;
        false -> case substring(s, i, i + 1) == " " of {
            true -> tuple_trim_end(s, i - 1);
            false -> i
        }
    }
}

