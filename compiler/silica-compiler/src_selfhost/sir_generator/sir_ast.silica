// SIR internal data structures (AST representation)
// SIR is held in memory; text .sir format is for debugging/export only

export SIRTerm/0;
export SIRFunction/0;
export ListSIRFunction/0;
export ListSirString/0;
export SIRExportItem/0;
export ListSIRExportItem/0;
export SIRModule/0;
export ListSIRModule/0;
export SIRSupervisorPhaseE/0;
export ListSIRSupervisorPhaseE/0;
export dummy_sir_term/0;
export dummy_sir_function/0;
export cons_sir_functions/2;
export nil_sir_functions/0;
export nil_sir_strings/0;
export cons_sir_string/2;
export sir_string_list_contains/2;
export dummy_export_item/0;
export nil_sir_exports/0;
export cons_sir_export/2;
export SIRRequiredMethodSig/0;
export ListSIRRequiredMethodSig/0;
export dummy_required_method_sig/0;
export nil_required_method_sigs/0;
export cons_required_method_sig/2;
export dummy_supervisor_phase_e/0;
export nil_supervisor_phase_e/0;
export cons_supervisor_phase_e/2;
export sir_supervisor_phase_e_rows_to_text/2;
export SIRForeignBinding/0;
export ListSIRForeignBinding/0;
export dummy_sir_foreign_binding/0;
export nil_sir_foreign_bindings/0;
export cons_sir_foreign_binding/2;
export dummy_sir_module/0;
export nil_sir_modules/0;
export cons_sir_module/2;

// Supervisors plan Phase E (supervisors_implementation_development_plan.md §15.4.12–15.4.13.2):
// concrete `impl T for Supervisor` + SIR of `init`'s return type (static child_spec / supervisor_flags used by
// runtime internal child table and automatic restart; pairs with `impl_supervisor T` in module text).
struct SIRSupervisorPhaseE {
    actor_type: string,
    init_return_sir: string,
    init_return_type_name: string
}

struct ListSIRSupervisorPhaseE {
    is_nil: bool,
    head: SIRSupervisorPhaseE,
    tail: ListSIRSupervisorPhaseE
}

// SIRTerm: kind 0=const, 1=var, 2=let, 3=case, 4=call, 5=tail_call, 6=prim,
//   tail_call: same slot layout as call (name=callee, inner/ right_expr=args, value=effects+|sir_rec:...)
//   7=case_branch_seq (inner=case_branch kind 8, right_expr=next seq or dummy),
//   8=case_branch (value=pattern kind bool|int|wild|bind, type_name=pattern type, name=payload, inner=guard, right_expr=body)
// const: type_name, value used; name="", inner=dummy, right_expr=dummy
// var: name used (%prefix); type_name="", value="", inner=dummy, right_expr=dummy
// prim: name=op (add/sub/etc), inner=left arg, right_expr=right arg
// call: name=callee, inner=arg, value=effect set
struct SIRTerm {
    kind: int64,
    type_name: string,
    value: string,
    name: string,
    inner: SIRTerm,
    right_expr: SIRTerm
}

struct SIRFunction {
    name: string,
    return_type: string,
    effects: string,
    body: SIRTerm,
    param_names: string,
    param_types: string
}

struct ListSIRFunction {
    is_nil: bool,
    head: SIRFunction,
    tail: ListSIRFunction
}

// §19.3: imported module names (from `use`), in source order across declarations
struct ListSirString {
    is_nil: bool,
    head: string,
    tail: ListSirString
}

// §19.2: export surface name/arity as in source
struct SIRExportItem {
    fn_name: string,
    arity: string
}

struct ListSIRExportItem {
    is_nil: bool,
    head: SIRExportItem,
    tail: ListSIRExportItem
}

// silica-specification §3.4.8: required trait method signatures (Declaration tag 7); no body in SIR
struct SIRRequiredMethodSig {
    name: string,
    param_names: string,
    param_types: string,
    return_type: string,
    effects: string
}

struct ListSIRRequiredMethodSig {
    is_nil: bool,
    head: SIRRequiredMethodSig,
    tail: ListSIRRequiredMethodSig
}

// FFI wrapper specification: raw foreign c_wrapper bindings (Declaration tag 9).
struct SIRForeignBinding {
    local_name: string,
    c_symbol: string,
    meta_path: string,
    return_type: string,
    param_names: string,
    param_types: string
}

struct ListSIRForeignBinding {
    is_nil: bool,
    head: SIRForeignBinding,
    tail: ListSIRForeignBinding
}

struct SIRModule {
    module_name: string,
    used_modules: ListSirString,
    exports: ListSIRExportItem,
    export_trait_names: ListSirString,
    marker_impl_types: ListSirString,
    // supervisor_implementation_development_plan.md Phases C–D: types named in `impl T for Supervisor;` (tag 6) for runtime supervisor metadata (§15.4.10–§15.4.13).
    supervisor_impl_types: ListSirString,
    // Phase E: per–actor-type SIR of `init` return (flags + static List[child_spec, …]) for internal child table / restart; empty when no `init` in unit.
    supervisor_phase_e: ListSIRSupervisorPhaseE,
    // supervisors plan Phase F (§15.4.13.4): actor types in `impl T for FailureReporter;` (tag 6) for root FailureReporter bootstrap / unwind delivery metadata.
    failure_reporter_impl_types: ListSirString,
    required_method_sigs: ListSIRRequiredMethodSig,
    // Runtime dependencies required by this SIR module. The emitter lowers calls to these runtimes, while build output/linking supplies each runtime definition once.
    runtime_dependencies: ListSirString,
    // FFI: module name prefix dangerous_*, sidecar paths (wrapper_meta + per-binding meta), raw foreign bindings.
    is_dangerous_module: bool,
    wrapper_meta_paths: ListSirString,
    foreign_bindings: ListSIRForeignBinding,
    link_libraries: ListSirString,
    functions: ListSIRFunction
}

// Ordered queue of compilation units’ SIR (silica.config batch atom index merge uses this shape).
struct ListSIRModule {
    is_nil: bool,
    head: SIRModule,
    tail: ListSIRModule
}

fn dummy_sir_term() -> SIRTerm {
    placeholder: SIRTerm <- SIRTerm { kind: -1, type_name: "", value: "", name: "", inner: placeholder, right_expr: placeholder };
    placeholder
}

fn dummy_sir_function() -> SIRFunction {
    SIRFunction { name: "", return_type: "", effects: "[]", body: dummy_sir_term(), param_names: "", param_types: "" }
}

fn cons_sir_functions(fn_val: SIRFunction, rest: ListSIRFunction) -> ListSIRFunction {
    ListSIRFunction { is_nil: false, head: fn_val, tail: rest }
}

fn nil_sir_functions() -> ListSIRFunction {
    ph: ListSIRFunction <- ListSIRFunction { is_nil: true, head: dummy_sir_function(), tail: ph };
    ph
}

fn nil_sir_strings() -> ListSirString {
    ph: ListSirString <- ListSirString { is_nil: true, head: "", tail: ph };
    ph
}

fn cons_sir_string(s: string, rest: ListSirString) -> ListSirString {
    ListSirString { is_nil: false, head: s, tail: rest }
}

fn sir_string_list_contains(items: ListSirString, needle: string) -> bool {
    case items.is_nil of {
        true -> false;
        false -> case items.head == needle of {
            true -> true;
            false -> sir_string_list_contains(items.tail, needle)
        }
    }
}

fn dummy_export_item() -> SIRExportItem {
    SIRExportItem { fn_name: "", arity: "" }
}

fn nil_sir_exports() -> ListSIRExportItem {
    ph: ListSIRExportItem <- ListSIRExportItem { is_nil: true, head: dummy_export_item(), tail: ph };
    ph
}

fn cons_sir_export(item: SIRExportItem, rest: ListSIRExportItem) -> ListSIRExportItem {
    ListSIRExportItem { is_nil: false, head: item, tail: rest }
}

fn dummy_required_method_sig() -> SIRRequiredMethodSig {
    SIRRequiredMethodSig { name: "", param_names: "", param_types: "", return_type: "", effects: "[]" }
}

fn nil_required_method_sigs() -> ListSIRRequiredMethodSig {
    ph: ListSIRRequiredMethodSig <- ListSIRRequiredMethodSig { is_nil: true, head: dummy_required_method_sig(), tail: ph };
    ph
}

fn cons_required_method_sig(item: SIRRequiredMethodSig, rest: ListSIRRequiredMethodSig) -> ListSIRRequiredMethodSig {
    ListSIRRequiredMethodSig { is_nil: false, head: item, tail: rest }
}

fn dummy_sir_foreign_binding() -> SIRForeignBinding {
    SIRForeignBinding { local_name: "", c_symbol: "", meta_path: "", return_type: "", param_names: "", param_types: "" }
}

fn nil_sir_foreign_bindings() -> ListSIRForeignBinding {
    ph: ListSIRForeignBinding <- ListSIRForeignBinding { is_nil: true, head: dummy_sir_foreign_binding(), tail: ph };
    ph
}

fn cons_sir_foreign_binding(item: SIRForeignBinding, rest: ListSIRForeignBinding) -> ListSIRForeignBinding {
    ListSIRForeignBinding { is_nil: false, head: item, tail: rest }
}

fn dummy_supervisor_phase_e() -> SIRSupervisorPhaseE {
    SIRSupervisorPhaseE { actor_type: "", init_return_sir: "", init_return_type_name: "" }
}

fn nil_supervisor_phase_e() -> ListSIRSupervisorPhaseE {
    ph: ListSIRSupervisorPhaseE <- ListSIRSupervisorPhaseE { is_nil: true, head: dummy_supervisor_phase_e(), tail: ph };
    ph
}

fn cons_supervisor_phase_e(item: SIRSupervisorPhaseE, rest: ListSIRSupervisorPhaseE) -> ListSIRSupervisorPhaseE {
    ListSIRSupervisorPhaseE { is_nil: false, head: item, tail: rest }
}

fn dummy_sir_module() -> SIRModule {
    SIRModule {
        module_name: "",
        used_modules: nil_sir_strings(),
        exports: nil_sir_exports(),
        export_trait_names: nil_sir_strings(),
        marker_impl_types: nil_sir_strings(),
        supervisor_impl_types: nil_sir_strings(),
        supervisor_phase_e: nil_supervisor_phase_e(),
        failure_reporter_impl_types: nil_sir_strings(),
        required_method_sigs: nil_required_method_sigs(),
        runtime_dependencies: nil_sir_strings(),
        is_dangerous_module: false,
        wrapper_meta_paths: nil_sir_strings(),
        foreign_bindings: nil_sir_foreign_bindings(),
        link_libraries: nil_sir_strings(),
        functions: nil_sir_functions()
    }
}

fn nil_sir_modules() -> ListSIRModule {
    ph: ListSIRModule <- ListSIRModule { is_nil: true, head: dummy_sir_module(), tail: ph };
    ph
}

fn cons_sir_module(mod_val: SIRModule, rest: ListSIRModule) -> ListSIRModule {
    ListSIRModule { is_nil: false, head: mod_val, tail: rest }
}

// Debug: convert SIR term/module to readable text (for debugging emitter branch logic)
export sir_term_to_text/1;
export sir_module_to_text/1;

fn sir_term_to_text(term: SIRTerm) -> string {
    case term.kind < 0 of {
        true -> "dummy";
        false -> case term.kind of {
            0 -> {
                c1: string <- concat("const(", term.type_name);
                c2: string <- concat(", ", term.value);
                concat(c1, concat(c2, ")"))
            };
            1 -> concat("var(", concat(term.name, ")"));
            2 -> {
                inner_t: string <- sir_term_to_text(term.inner);
                body_t: string <- sir_term_to_text(term.right_expr);
                part1: string <- concat("let(", term.name);
                part2: string <- concat(part1, concat(", ", inner_t));
                part3: string <- concat(part2, concat(", ", body_t));
                concat(part3, ")")
            };
            4 -> {
                arg_t: string <- sir_term_to_text(term.inner);
                c1: string <- concat("call(", term.name);
                c2: string <- concat(c1, concat(", ", arg_t));
                c3: string <- case term.right_expr.kind < 0 of {
                    true -> c2;
                    false -> concat(c2, concat(", ", sir_term_to_text(term.right_expr)))
                };
                concat(c3, ")")
            };
            5 -> {
                arg_t: string <- sir_term_to_text(term.inner);
                c1: string <- concat("tail_call(", term.name);
                c2: string <- concat(c1, concat(", ", arg_t));
                c3: string <- case term.right_expr.kind < 0 of {
                    true -> c2;
                    false -> concat(c2, concat(", ", sir_term_to_text(term.right_expr)))
                };
                concat(c3, ")")
            };
            6 -> {
                left_t: string <- sir_term_to_text(term.inner);
                right_t: string <- sir_term_to_text(term.right_expr);
                p1: string <- concat("prim(", term.name);
                p2: string <- concat(p1, concat(", ", left_t));
                p3: string <- concat(p2, concat(", ", right_t));
                concat(p3, ")")
            };
            3 -> {
                sct: string <- sir_term_to_text(term.inner);
                br: string <- sir_term_to_text(term.right_expr);
                p1: string <- concat("case(", term.type_name);
                p2: string <- concat(p1, concat(", ", term.value));
                p3: string <- concat(p2, concat(", ", sct));
                concat(p3, concat(", ", concat(br, ")")))
            };
            7 -> {
                b: string <- sir_term_to_text(term.inner);
                r: string <- sir_term_to_text(term.right_expr);
                concat(concat("case_seq(", b), concat(", ", concat(r, ")")))
            };
            8 -> {
                g: string <- sir_term_to_text(term.inner);
                bd: string <- sir_term_to_text(term.right_expr);
                p1: string <- concat("branch(", term.value);
                p2: string <- concat(p1, concat(", ", term.type_name));
                p3: string <- concat(p2, concat(", ", term.name));
                p4: string <- concat(p3, concat(", guard=", g));
                concat(p4, concat(", ", concat(bd, ")")))
            };
            _: int64 -> concat("term(kind=", "?)")
        }
    }
}

fn sir_function_to_text(fn_val: SIRFunction) -> string {
    body_str: string <- sir_term_to_text(fn_val.body);
    concat(concat(concat(concat(concat(concat("fn ", fn_val.name), " -> "), concat(fn_val.return_type, " ")), concat(fn_val.effects, " ")), "body: "), body_str)
}

fn sir_used_modules_to_text(uses: ListSirString, acc: string) -> string {
    case uses.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_used_modules_to_text(uses.tail, acc);
            case len(rest) > 0 of {
                true -> concat(concat(uses.head, ", "), rest);
                false -> uses.head
            }
        }
    }
}

fn sir_exports_to_text(exps: ListSIRExportItem, acc: string) -> string {
    case exps.is_nil of {
        true -> acc;
        false -> {
            one: string <- concat(concat(exps.head.fn_name, "/"), exps.head.arity);
            rest: string <- sir_exports_to_text(exps.tail, acc);
            case len(rest) > 0 of {
                true -> concat(concat(one, ", "), rest);
                false -> one
            }
        }
    }
}

fn sir_trait_exports_to_text(names: ListSirString, acc: string) -> string {
    case names.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_trait_exports_to_text(names.tail, acc);
            line: string <- concat("  export_trait ", concat(names.head, "\n"));
            case len(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

fn sir_marker_impls_to_text(types: ListSirString, acc: string) -> string {
    case types.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_marker_impls_to_text(types.tail, acc);
            line: string <- concat("  marker_impl ", concat(types.head, "\n"));
            case len(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

fn sir_supervisor_impls_to_text(types: ListSirString, acc: string) -> string {
    case types.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_supervisor_impls_to_text(types.tail, acc);
            line: string <- concat("  impl_supervisor ", concat(types.head, "\n"));
            case len(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

// Phase E: `init` return SIR for automatic restart / internal child table (one row per `impl T for Supervisor` marker).
fn sir_supervisor_phase_e_rows_to_text(rows: ListSIRSupervisorPhaseE, acc: string) -> string {
    case rows.is_nil of {
        true -> acc;
        false -> {
            r: SIRSupervisorPhaseE <- rows.head;
            p1: string <- concat("  supervisor_phase_e ", r.actor_type);
            p2: string <- concat(p1, " init_returns ");
            p3: string <- concat(p2, concat(r.init_return_sir, "\n"));
            rest: string <- sir_supervisor_phase_e_rows_to_text(rows.tail, acc);
            case len(rest) > 0 of {
                true -> concat(p3, rest);
                false -> p3
            }
        }
    }
}

fn sir_failure_reporter_impls_to_text(types: ListSirString, acc: string) -> string {
    case types.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_failure_reporter_impls_to_text(types.tail, acc);
            line: string <- concat("  impl_failure_reporter ", concat(types.head, "\n"));
            case len(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

fn sir_wrapper_meta_paths_to_text(paths: ListSirString, acc: string) -> string {
    case paths.is_nil of {
        true -> acc;
        false -> {
            rest: string <- sir_wrapper_meta_paths_to_text(paths.tail, acc);
            line: string <- concat("  wrapper_meta ", concat(paths.head, "\n"));
            case len(rest) > 0 of {
                true -> concat(line, rest);
                false -> line
            }
        }
    }
}

fn sir_foreign_bindings_to_text(bindings: ListSIRForeignBinding, acc: string) -> string {
    case bindings.is_nil of {
        true -> acc;
        false -> {
            b: SIRForeignBinding <- bindings.head;
            p1: string <- concat("  foreign_binding ", b.local_name);
            p2: string <- concat(p1, " ");
            p3: string <- concat(p2, b.c_symbol);
            p4: string <- concat(p3, " ");
            p5: string <- concat(p4, b.param_names);
            p6: string <- concat(p5, " ");
            p7: string <- concat(p6, b.param_types);
            p8: string <- concat(p7, " -> ");
            p9: string <- concat(p8, b.return_type);
            p10: string <- case len(b.meta_path) > 0 of {
                true -> concat(p9, concat(" meta=", b.meta_path));
                false -> p9
            };
            one: string <- concat(p10, "\n");
            rest: string <- sir_foreign_bindings_to_text(bindings.tail, acc);
            case len(rest) > 0 of {
                true -> concat(one, rest);
                false -> one
            }
        }
    }
}

fn sir_required_sigs_to_text(sigs: ListSIRRequiredMethodSig, acc: string) -> string {
    case sigs.is_nil of {
        true -> acc;
        false -> {
            s: SIRRequiredMethodSig <- sigs.head;
            p1: string <- concat("  required_fn ", s.name);
            p2: string <- concat(p1, " ");
            p3: string <- concat(p2, s.param_names);
            p4: string <- concat(p3, " ");
            p5: string <- concat(p4, s.param_types);
            p6: string <- concat(p5, " -> ");
            p7: string <- concat(p6, s.return_type);
            p8: string <- concat(p7, " ");
            one2: string <- concat(p8, concat(s.effects, "\n"));
            rest: string <- sir_required_sigs_to_text(sigs.tail, acc);
            case len(rest) > 0 of {
                true -> concat(one2, rest);
                false -> one2
            }
        }
    }
}

fn sir_module_to_text_acc(fns: ListSIRFunction, acc: string) -> string {
    case fns.is_nil of {
        true -> acc;
        false -> {
            fn_str: string <- sir_function_to_text(fns.head);
            rest: string <- sir_module_to_text_acc(fns.tail, acc);
            case len(rest) > 0 of {
                true -> concat(concat(fn_str, "\n"), rest);
                false -> fn_str
            }
        }
    }
}

fn sir_module_to_text(sir_module: SIRModule) -> string {
    header: string <- concat(concat("SIRModule ", sir_module.module_name), "\n");
    uses_line: string <- case sir_module.used_modules.is_nil of {
        true -> "";
        false -> concat(concat(" use ", sir_used_modules_to_text(sir_module.used_modules, "")), "\n")
    };
    exports_line: string <- case sir_module.exports.is_nil of {
        true -> "";
        false -> concat(concat("  export ", sir_exports_to_text(sir_module.exports, "")), "\n")
    };
    trait_exports_line: string <- case sir_module.export_trait_names.is_nil of {
        true -> "";
        false -> sir_trait_exports_to_text(sir_module.export_trait_names, "")
    };
    marker_line: string <- case sir_module.marker_impl_types.is_nil of {
        true -> "";
        false -> sir_marker_impls_to_text(sir_module.marker_impl_types, "")
    };
    sup_line: string <- case sir_module.supervisor_impl_types.is_nil of {
        true -> "";
        false -> sir_supervisor_impls_to_text(sir_module.supervisor_impl_types, "")
    };
    phe_line: string <- case sir_module.supervisor_phase_e.is_nil of {
        true -> "";
        false -> sir_supervisor_phase_e_rows_to_text(sir_module.supervisor_phase_e, "")
    };
    fr_line: string <- case sir_module.failure_reporter_impl_types.is_nil of {
        true -> "";
        false -> sir_failure_reporter_impls_to_text(sir_module.failure_reporter_impl_types, "")
    };
    req_line: string <- case sir_module.required_method_sigs.is_nil of {
        true -> "";
        false -> sir_required_sigs_to_text(sir_module.required_method_sigs, "")
    };
    rt_line: string <- case sir_module.runtime_dependencies.is_nil of {
        true -> "";
        false -> concat(concat("  runtime ", sir_used_modules_to_text(sir_module.runtime_dependencies, "")), "\n")
    };
    dangerous_line: string <- case sir_module.is_dangerous_module of {
        true -> "  dangerous_module true\n";
        false -> ""
    };
    wm_line: string <- case sir_module.wrapper_meta_paths.is_nil of {
        true -> "";
        false -> sir_wrapper_meta_paths_to_text(sir_module.wrapper_meta_paths, "")
    };
    fb_line: string <- case sir_module.foreign_bindings.is_nil of {
        true -> "";
        false -> sir_foreign_bindings_to_text(sir_module.foreign_bindings, "")
    };
    ll_line: string <- case sir_module.link_libraries.is_nil of {
        true -> "";
        false -> concat(concat("  link_library ", sir_used_modules_to_text(sir_module.link_libraries, "")), "\n")
    };
    funcs: string <- sir_module_to_text_acc(sir_module.functions, "");
    do
        part1: string <- concat(header, uses_line);
        part2: string <- concat(part1, exports_line);
        part3: string <- concat(part2, trait_exports_line);
        part4: string <- concat(part3, marker_line);
        part4b: string <- concat(part4, sup_line);
        part4b2: string <- concat(part4b, phe_line);
        part4c: string <- concat(part4b2, fr_line);
        part5: string <- concat(part4c, req_line);
        part6: string <- concat(part5, rt_line);
        part7: string <- concat(part6, dangerous_line);
        part8: string <- concat(part7, wm_line);
        part9: string <- concat(part8, fb_line);
        part10: string <- concat(part9, ll_line);
        concat(part10, funcs)
    end
}
