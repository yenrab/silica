.bss
.balign 8
.lcomm _silica_frame_depth, 8
.lcomm _silica_frame_max, 8
.lcomm _silica_fuel, 8
.lcomm _silica_saved_pc, 8

.text
    ; use parser_ast, sir_ast, diagnostics_core, type_checker_core
.global ffi_placement_checker_validate_program_ffi_placement
.global ffi_placement_checker_collect_spawn_behavior_names
.global ffi_placement_checker_collect_ffi_worker_names
