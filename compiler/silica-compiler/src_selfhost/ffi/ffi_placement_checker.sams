    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o1151_done
L_case_o1151_done:

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

