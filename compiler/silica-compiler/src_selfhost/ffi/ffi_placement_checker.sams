    BL L_substring_helper
    MOV X9, X0
    MOV X10, X20
    STP X0, X1, [SP, #-16]!
    MOV X0, X9
    MOV X1, X10
    BL L_string_cmp_helper
    CMP W0, #0
    CSET W12, EQ
    LDP X0, X1, [SP], #16
    MOV X0, X12

    B L_case_o1151_done
