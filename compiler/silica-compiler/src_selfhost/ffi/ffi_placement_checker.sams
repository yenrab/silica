    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



ffi_placement_checker_dangerous_prefix:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

ffi_placement_checker_is_dangerous_module_name:     STP X29, X30, [SP, #-16]!
    MOV X29, SP
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0

    ; unsupported term kind (dummy k)?
    STR X16, [SP, #-16]!
    LDR X0, [SP, #0]
    ADD SP, SP, #16
    ; effects []|sir_rec:o1127|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, ffi_placement_checker_dangerous_prefix@PAGE
    ADD X9, X9, ffi_placement_checker_dangerous_prefix@PAGEOFF
    BLR X9
    MOV X20, X0
    MOV X0, X19
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X9, X12

    STR X9, [SP, #-16]!
    MOV X0, X20
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X10, X12

    LDR X9, [SP], #16

    CMP X9, X10
    CSET X3, GE
L_case_o1151_br_0:
    CMP W3, #0
    B.NE L_case_o1151_br_1
    MOV X0, #0
    B L_case_o1151_done
L_case_o1151_br_1:
    CMP W3, #1
