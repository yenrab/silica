    STR X10, [SP, #-16]!
    MOV X0, X20
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X9, X12

    LDR X10, [SP], #16


    CMP X9, X10
    CSET X3, EQ
