.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #10
    STR X9, [SP, #0]
    MOV X9, #20
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    LDR X0, [SP, #0]
    MOV X19, X0
    LDR X1, [SP, #8]
    MOV X19, X1
    LDR X9, [SP, #0]
    LDR X10, [SP, #8]
    ADD X0, X9, X10
    ADD SP, SP, #16

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

