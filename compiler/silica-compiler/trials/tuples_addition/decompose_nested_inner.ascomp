.text
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV W9, #1
    STR W9, [SP, #0]
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #16]
    MOV X9, #42
    STR X9, [SP, #24]
    ADD X0, SP, #16
    MOV X1, X0
    LDR X2, [SP, #16]
    LDR X3, [SP, #24]
    LDR X2, [SP, #16]
    LDR W0, [SP, #0]
    LDR X0, [SP, #8]

    ADD SP, SP, #32

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello"
    .byte 0

