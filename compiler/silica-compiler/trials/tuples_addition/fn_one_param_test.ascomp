.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    ADRP X10, fn_one_param_test.__lam0@PAGE
    ADD X10, X10, fn_one_param_test.__lam0@PAGEOFF

    STR X10, [SP, #8]


    MOV X0, SP
    MOV X19, X0
    MOV X0, #1
    ADD SP, SP, #16

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

fn_one_param_test.__lam0:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

