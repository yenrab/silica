.text
.global main


mul_fn:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    MUL X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    ADRP X9, mul_fn@PAGE
    ADD X9, X9, mul_fn@PAGEOFF
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, SP
    MOV X19, X0
    LDR X0, [SP, #0]
    LDR X0, [SP, #8]
    LDR X17, [SP, #8]
    MOV X0, #6
    MOV X1, #7

    ; effects []|sir_rec:o264|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    BLR X17
    ADD SP, SP, #16

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x61, 0
