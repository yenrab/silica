.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    SUB SP, SP, #32
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #2
    STR X9, [SP, #8]
    MOV X9, #3
    STR X9, [SP, #16]
    MOV X0, SP
    MOV X19, X0
    MOV X0, SP
    MOV X19, X0
    MOV X12, X19
    LDR X0, [SP, #0]
    MOV X20, X0
    LDR X1, [SP, #8]
    MOV X20, X1
    LDR X2, [SP, #16]
    MOV X20, X2
    LDR X9, [SP, #0]
    LDR X10, [SP, #8]
    ADD X9, X9, X10
    MOV X10, X2
    ADD X0, X9, X10
    ADD SP, SP, #32

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

