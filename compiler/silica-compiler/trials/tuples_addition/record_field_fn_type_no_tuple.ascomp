.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #16
    ADRP X8, record_field_fn_type_no_tuple.__lam0@PAGE
    ADD X8, X8, record_field_fn_type_no_tuple.__lam0@PAGEOFF
    FMOV D9, X8

    STR D9, [SP, #0]
    MOV X0, SP
    MOV X19, X0
    MOV X0, #1
    ADD SP, SP, #16

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

record_field_fn_type_no_tuple.__lam0:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

