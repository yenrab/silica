.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    MOV X2, #0

    MOV X1, #0

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X19, X0
    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    MOV X9, X19
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X20, X0
    MOV X0, X20
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16
    MOV X19, X0
    MOV X0, #1
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X4, X0
    MOV X3, X2
    MOV X0, #0
L_list_len_loop:
    CBZ X4, L_list_len_done
    ADD X0, X0, #1
    ADD X5, X4, X3
    LDR X4, [X5]
    B L_list_len_loop
L_list_len_done:
    RET

.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x61, 0
