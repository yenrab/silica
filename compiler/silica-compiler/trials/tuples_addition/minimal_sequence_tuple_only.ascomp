.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    MOV X9, #1
    STR X9, [SP, #8]
    MOV X9, SP
    LDR X12, [X9, #0]
    STR X12, [SP, #0]
    LDR X12, [X9, #8]
    STR X12, [SP, #8]

    SUB SP, SP, #16
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #2
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #40]
    MOV X0, SP
    MOV X19, X0
    MOV X0, #1
    ADD SP, SP, #48

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x61, 0
atom_1:
    .byte  0x3a, 0x62, 0
