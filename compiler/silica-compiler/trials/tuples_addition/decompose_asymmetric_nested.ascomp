.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV W9, #1
    STR W9, [SP, #0]
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #16]
    MOV X9, #42
    STR X9, [SP, #24]
    ADD X0, SP, #16
    MOV X19, X0
    MOV X0, X19
    MOV X20, X0
    LDR X0, [SP, #16]
    MOV X21, X0
    LDR X0, [SP, #24]
    MOV X21, X0

    ADD SP, SP, #32

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello"
    .byte 0

