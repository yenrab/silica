.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    MOV X9, #0
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, SP
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16
    MOV X19, X0
    LDR X0, [X19, #0]
    MOV X20, X0
    LDR X1, [X19, #8]
    MOV X21, X1
    MOV X9, X20
    MOV X10, X21
    ADD X0, X9, X10
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

