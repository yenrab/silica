fn main() -> int64 {
    (flags, children) <- sequence proc[mem(normal)]
        flags_and_children: (
        {
            s: atom,
            n: int64
        },
        List[
            {
                id: atom,
                x: int64
            },
            mem(normal)
        ]
        ) <- ({s: :a, n: 1}, [{id: :b, x: 0}])
    produces
        pure flags_and_children
    end;
    1
}

