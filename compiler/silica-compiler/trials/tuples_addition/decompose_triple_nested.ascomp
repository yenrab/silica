.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    SUB SP, SP, #32
    MOV X9, #75
    STR X9, [SP, #0]
    SUB SP, SP, #16
    ADRP X10, L_f64_0@PAGE
    LDR D9, [X10, L_f64_0@PAGEOFF]
    STR D9, [SP, #0]
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #24]
    ADRP X9, L_str_1@PAGE
    ADD X9, X9, L_str_1@PAGEOFF
    STR X9, [SP, #32]
    ADD X0, SP, #16
    MOV X19, X0
    MOV X0, X19
    MOV X20, X0
    MOV X12, X20
    LDR X0, [SP, #16]
    MOV X21, X0
    LDR X1, [SP, #24]
    MOV X21, X1
    LDR X0, [SP, #32]
    MOV X21, X0

    ADD SP, SP, #48

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.0

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 2.0

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "world"
    .byte 0
L_str_1:
    .ascii "suffix"
    .byte 0

