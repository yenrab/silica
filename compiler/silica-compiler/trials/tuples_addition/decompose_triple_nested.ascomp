.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    SUB SP, SP, #32
    MOV X9, #75
    STR X9, [SP, #0]
    SUB SP, SP, #16
    ADRP X10, L_f64_0@PAGE
    LDR D9, [X10, L_f64_0@PAGEOFF]
    STR D9, [SP, #0]
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #24]
    ADRP X9, L_str_1@PAGE
    ADD X9, X9, L_str_1@PAGEOFF
    STR X9, [SP, #32]
    ADD X1, SP, #16
    MOV X19, X1
    MOV X0, X19
    MOV X20, X0
    MOV X12, X20
    LDR X0, [SP, #16]
    MOV X21, X0
    LDR X1, [SP, #24]
    MOV X21, X1
    LDR X2, [SP, #32]
    MOV X21, X2
    MOV X0, X2
    ; effects [device_io]
    BL L_ps_helper
    MOV X1, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    MOV X2, #0

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X1, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X1, #0

    MOV X1, #0
    ADD SP, SP, #48
    MOV W0, #13
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ps_helper:
    MOV X9, X0
    MOV X2, #0
L_ps_loop:
    LDRB W1, [X0]
    CBZ W1, L_ps_do_write
    ADD X2, X2, #1
    ADD X0, X0, #1
    B L_ps_loop
L_ps_do_write:
    MOV X0, #1
    MOV X1, X9
    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.0

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 2.0

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "world"
    .byte 0
L_str_1:
    .ascii "suffix"
    .byte 0
L_str_2:
    .ascii ""
    .byte 0
L_str_3:
    .ascii "\n"
    .byte 0

L_newline:
    .byte 10

