// Minimal repro: nested fn type inside tuple inside inline record type binding
fn main() -> int64 {
    x: {
        start: (int64, fn(msg: int64, state: int64) -> int64),
    } <- { start: (0, fn(msg: int64, state: int64) -> int64{ 0 }) };
    _used_x: {
        start: (int64, fn(msg: int64, state: int64) -> int64),
    } <- x;
    1
}
