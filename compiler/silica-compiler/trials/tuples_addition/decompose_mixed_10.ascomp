    LDR W2, [SP, #56]
    LDR X0, [SP, #64]
    MOV X20, X0
    LDR D0, [SP, #72]

    ADD SP, SP, #80

    FCVTZS W0, D0
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X29, X30, [SP], #16
    RET
