.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #16
    ADRP X9, minimal_head_generic_nested_fn_type.__lam0@PAGE
    ADD X9, X9, minimal_head_generic_nested_fn_type.__lam0@PAGEOFF
    STR X9, [SP, #0]
    MOV X0, SP
    MOV X19, X0
    MOV X0, #0
    ADD SP, SP, #16

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

minimal_head_generic_nested_fn_type.__lam0:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

