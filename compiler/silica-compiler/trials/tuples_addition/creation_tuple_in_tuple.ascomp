.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV W9, #1
    STR W9, [SP, #0]
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #16]
    ADRP X9, L_i64_0@PAGE
    LDR X9, [X9, L_i64_0@PAGEOFF]
    STR X9, [SP, #24]
    ADD X0, SP, #16
    MOV X19, X0
    SUB SP, SP, #32
    SUB SP, SP, #32
    MOV X9, #1
    STR X9, [SP, #0]
    ADRP X10, L_f64_0@PAGE
    LDR D9, [X10, L_f64_0@PAGEOFF]
    STR D9, [SP, #8]
    ADRP X9, L_str_1@PAGE
    ADD X9, X9, L_str_1@PAGEOFF
    STR X9, [SP, #16]
    MOV X9, SP
    STR X9, [SP, #32]
    ADRP X9, L_str_2@PAGE
    ADD X9, X9, L_str_2@PAGEOFF
    STR X9, [SP, #40]
    ADD X0, SP, #32
    MOV X20, X0
    MOV X0, #42
    ADD SP, SP, #64

    ADD SP, SP, #32

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 123456789012345

.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.0

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 2.0

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello 😱"
    .byte 0
L_str_1:
    .ascii "world 😱"
    .byte 0
L_str_2:
    .ascii " fdaewq5432k 😱"
    .byte 0

