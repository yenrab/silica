fn main() -> int64 {
    (flags, children) <- sequence proc[mem(normal)]
        flags_and_children: (
        {
            s: atom,
            n: int64
        },
        List[
            {
                start: (int64, fn(msg: int64, state: int64) -> int64),
            },
            mem(normal)
        ]
        ) <- ({s: :a, n: 0}, [{start: (0, fn(msg: int64, state: int64) -> int64{ 0 })}])
    produces
        pure flags_and_children
    end;
    1
}

