.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #2
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #16]
    MOV X9, #3
    STR X9, [SP, #24]
    ADD X9, SP, #16
    STR X9, [SP, #32]
    MOV X9, #4
    STR X9, [SP, #40]
    ADD X0, SP, #32
    MOV X19, X0
    MOV X0, X19
    MOV X20, X0
    LDR X0, [SP, #32]
    MOV X21, X0
    LDR X0, [SP, #40]
    MOV X21, X0

    ADD SP, SP, #48

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

