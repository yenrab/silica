.text
    ; use lib_base
.global ten


ten:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X10, #3


    STR X10, [SP, #-16]!
    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o158|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, seven@PAGE
    ADD X9, X9, seven@PAGEOFF
    BLR X9
    MOV X9, X0
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
