.text
    ; use lib_alpha, lib_math_utils_spec
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X0, #1
    MOV X1, #1

    ; effects []|sir_rec:o183|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, add@PAGE
    ADD X9, X9, add@PAGEOFF
    BLR X9
    ; unsupported term kind ?
    ADRP X9, bump@PAGE
    ADD X9, X9, bump@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
