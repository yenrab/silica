// Phase 5 step 5.4 — NodeIDBTreeSet root split, membership, and size.
use OrderedSet;
use btree_set_nodeid;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- {
            compare_item: compare_int64_atom
        };
        tree0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_set_nodeid@empty(functions);
        r1: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert(tree0, 4);
        r2: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert(r1.tree, 2);
        r3: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert(r2.tree, 6);
        r4: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert(r3.tree, 1);
        r5: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert(r4.tree, 3);
        r6: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert(r5.tree, 5);
        r7: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert(r6.tree, 7);
        r8: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert(r7.tree, 8);
        size_value: int64 <- OrderedSet@size(r8.tree);
        has1: int64 <- btree_set_nodeid@contains[int64, mem(normal)](r8.tree, 1);
        has4: int64 <- btree_set_nodeid@contains[int64, mem(normal)](r8.tree, 4);
        has8: int64 <- btree_set_nodeid@contains[int64, mem(normal)](r8.tree, 8);
        has9: int64 <- btree_set_nodeid@contains[int64, mem(normal)](r8.tree, 9);
        root_split: int64 <- case r8.tree.root_id of {
            1 -> 1;
            _: int64 -> 0
        };
        node_count_split: int64 <- case r8.tree.node_count of {
            3 -> 1;
            _: int64 -> 0
        };
        size_ok: int64 <- case size_value of {
            8 -> 1;
            _: int64 -> 0
        };
        failures: int64 <-
            ((1 - r1.inserted) * 1)
            + ((1 - r2.inserted) * 2)
            + ((1 - r3.inserted) * 4)
            + ((1 - r4.inserted) * 8)
            + ((1 - r5.inserted) * 16)
            + ((1 - r6.inserted) * 32)
            + ((1 - r7.inserted) * 64)
            + ((1 - r8.inserted) * 128)
            + ((1 - root_split) * 256)
            + ((1 - node_count_split) * 512)
            + ((1 - size_ok) * 1024)
            + ((1 - has1) * 4096)
            + ((1 - has4) * 8192)
            + ((1 - has8) * 16384)
            + (has9 * 32768)
    produces
        pure failures
    end
}
