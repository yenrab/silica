// Debug: contains via parameter pass (simulates insert receiving tree).
use btree_set_nodeid;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn handbuilt_tree_with_4() -> {
        root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    compare_item: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        empty_keys: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        keys: List[int64, mem(normal)] <- prepend[int64, mem(normal)](4, empty_keys);
        children: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: 0,
            key_count: 1,
            is_leaf: 1,
            keys: keys,
            children: children
        };
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)](root, empty_nodes);
        tree: {
                        root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            root_id: 0,
            node_count: 1,
            order: 8,
            nodes: nodes,
            compare_item: compare_int64_atom
        }
    produces
        pure tree
    end
}

fn contains_param(
    tree: {
                root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> int64 {
    btree_set_nodeid@contains[int64, mem(normal)](tree, key)
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        tree: {
                        root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- handbuilt_tree_with_4();
        missing: int64 <- contains_param(tree, 2);
        present: int64 <- contains_param(tree, 4);
        result: int64 <- missing + ((1 - present) * 2)
    produces
        pure result
    end
}
