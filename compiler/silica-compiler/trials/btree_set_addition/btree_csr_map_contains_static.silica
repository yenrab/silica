// Phase 8 steps 8.1–8.2 — CsrBTreeMap[int64, int64, mem(normal)] static construction
// for keys {1, 3, 5} mapped to values {10, 30, 50}.
use btree_csr_map;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_csr_map@from_static_sorted[int64, int64, mem(normal)]();
        validation: { ok: int64, error_code: int64 } <- btree_csr_map@validate[int64, int64, mem(normal)](tree);
        has1: int64 <- btree_csr_map@contains[int64, int64, mem(normal)](tree, 1);
        has3: int64 <- btree_csr_map@contains[int64, int64, mem(normal)](tree, 3);
        has5: int64 <- btree_csr_map@contains[int64, int64, mem(normal)](tree, 5);
        has4: int64 <- btree_csr_map@contains[int64, int64, mem(normal)](tree, 4);
        g1: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](tree, 1);
        g3: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](tree, 3);
        g5: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](tree, 5);
        g4: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](tree, 4);
        g1_val_ok: int64 <- case g1.value == 10 of { true -> 1; false -> 0 };
        g3_val_ok: int64 <- case g3.value == 30 of { true -> 1; false -> 0 };
        g5_val_ok: int64 <- case g5.value == 50 of { true -> 1; false -> 0 };
        failures: int64 <-
            fail_unless_zero(tree.node_count - 1) +
            (fail_unless_zero(tree.key_count_total - 3) * 2) +
            ((1 - validation.ok) * 4) +
            (fail_unless_one(has1) * 8) +
            (fail_unless_one(has3) * 16) +
            (fail_unless_one(has5) * 32) +
            (has4 * 64) +
            ((1 - g1.found) * 128) +
            (fail_unless_one(g1_val_ok) * 256) +
            ((1 - g3.found) * 512) +
            (fail_unless_one(g3_val_ok) * 1024) +
            ((1 - g5.found) * 2048) +
            (fail_unless_one(g5_val_ok) * 4096) +
            (g4.found * 8192)
    produces
        pure failures
    end
}
