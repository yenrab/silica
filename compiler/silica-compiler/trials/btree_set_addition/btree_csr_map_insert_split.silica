// Phase 8 step 8.4 — direct functional insert into CsrBTreeMap grows leaf into first split-root.
use csr_map_trait_bridge;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence
        tree0: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- csr_map_trait_bridge@empty_map();
        r1: { tree: { region: region(L1, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(L1, normal, int64, 3), node_key_count: buf(L1, normal, int64, 3), node_child_start: buf(L1, normal, int64, 3), node_child_count: buf(L1, normal, int64, 3), node_is_leaf: buf(L1, normal, int64, 3), keys: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8), children: buf(L1, normal, int64, 2), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64, replaced: int64 } <- csr_map_trait_bridge@insert_map(tree0, 4, 40);
        r2: { tree: { region: region(L1, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(L1, normal, int64, 3), node_key_count: buf(L1, normal, int64, 3), node_child_start: buf(L1, normal, int64, 3), node_child_count: buf(L1, normal, int64, 3), node_is_leaf: buf(L1, normal, int64, 3), keys: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8), children: buf(L1, normal, int64, 2), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64, replaced: int64 } <- csr_map_trait_bridge@insert_map(r1.tree, 2, 20);
        r3: { tree: { region: region(L1, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(L1, normal, int64, 3), node_key_count: buf(L1, normal, int64, 3), node_child_start: buf(L1, normal, int64, 3), node_child_count: buf(L1, normal, int64, 3), node_is_leaf: buf(L1, normal, int64, 3), keys: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8), children: buf(L1, normal, int64, 2), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64, replaced: int64 } <- csr_map_trait_bridge@insert_map(r2.tree, 6, 60);
        r4: { tree: { region: region(L1, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(L1, normal, int64, 3), node_key_count: buf(L1, normal, int64, 3), node_child_start: buf(L1, normal, int64, 3), node_child_count: buf(L1, normal, int64, 3), node_is_leaf: buf(L1, normal, int64, 3), keys: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8), children: buf(L1, normal, int64, 2), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64, replaced: int64 } <- csr_map_trait_bridge@insert_map(r3.tree, 1, 10);
        r5: { tree: { region: region(L1, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(L1, normal, int64, 3), node_key_count: buf(L1, normal, int64, 3), node_child_start: buf(L1, normal, int64, 3), node_child_count: buf(L1, normal, int64, 3), node_is_leaf: buf(L1, normal, int64, 3), keys: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8), children: buf(L1, normal, int64, 2), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64, replaced: int64 } <- csr_map_trait_bridge@insert_map(r4.tree, 3, 30);
        r6: { tree: { region: region(L1, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(L1, normal, int64, 3), node_key_count: buf(L1, normal, int64, 3), node_child_start: buf(L1, normal, int64, 3), node_child_count: buf(L1, normal, int64, 3), node_is_leaf: buf(L1, normal, int64, 3), keys: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8), children: buf(L1, normal, int64, 2), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64, replaced: int64 } <- csr_map_trait_bridge@insert_map(r5.tree, 5, 50);
        r7: { tree: { region: region(L1, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(L1, normal, int64, 3), node_key_count: buf(L1, normal, int64, 3), node_child_start: buf(L1, normal, int64, 3), node_child_count: buf(L1, normal, int64, 3), node_is_leaf: buf(L1, normal, int64, 3), keys: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8), children: buf(L1, normal, int64, 2), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64, replaced: int64 } <- csr_map_trait_bridge@insert_map(r6.tree, 7, 70);
        r8: { tree: { region: region(L1, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(L1, normal, int64, 3), node_key_count: buf(L1, normal, int64, 3), node_child_start: buf(L1, normal, int64, 3), node_child_count: buf(L1, normal, int64, 3), node_is_leaf: buf(L1, normal, int64, 3), keys: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8), children: buf(L1, normal, int64, 2), compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64, replaced: int64 } <- csr_map_trait_bridge@insert_map(r7.tree, 8, 80);
        validation: { ok: int64, error_code: int64 } <- csr_map_trait_bridge@validate_map(r8.tree);
        tree0_unchanged: int64 <- case tree0.root_id of { -1 -> 0; _: int64 -> 1 };
        failures: int64 <-
            (fail_unless_one(r8.inserted) * 1) +
            ((1 - validation.ok) * 2) +
            (fail_unless_zero(r8.tree.node_count - 3) * 4) +
            (fail_unless_zero(r8.tree.key_count_total - 8) * 8) +
            (tree0_unchanged * 16)
    produces
        pure failures
    end
}
