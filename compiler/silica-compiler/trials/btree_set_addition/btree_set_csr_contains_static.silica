// Phase 6 steps 6.2-6.3 — CsrBTreeSet[int64, mem(normal)] static membership for keys {1,3,5}.
use btree_set_csr;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[]
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- btree_set_csr@from_static_sorted[int64, mem(normal)]();
        validation: { ok: int64, error_code: int64 } <- btree_set_csr@validate[int64, mem(normal)](tree);
        has1: int64 <- btree_set_csr@contains[int64, mem(normal)](tree, 1);
        has3: int64 <- btree_set_csr@contains[int64, mem(normal)](tree, 3);
        has5: int64 <- btree_set_csr@contains[int64, mem(normal)](tree, 5);
        has4: int64 <- btree_set_csr@contains[int64, mem(normal)](tree, 4);
        failures: int64 <-
            fail_unless_zero(tree.node_count - 1) +
            (fail_unless_zero(tree.key_count_total - 3) * 2) +
            ((1 - validation.ok) * 4) +
            (fail_unless_one(has1) * 8) +
            (fail_unless_one(has3) * 16) +
            (fail_unless_one(has5) * 32) +
            (has4 * 64)
    produces
        pure failures
    end
}
