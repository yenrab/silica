// Phase 8 step 8.3 — finalize a split NodeIDBTreeMap into CsrBTreeMap and query it.
use btree_nodeid;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn do_inserts() -> { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, insert_failures: int64 } {
    sequence proc[mem(normal)]
        tree0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_nodeid@empty[int64, int64, mem(normal)]();
        r1: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <-
            btree_nodeid@insert[int64, int64, mem(normal)](tree0, 4, 40);
        r2: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <-
            btree_nodeid@insert[int64, int64, mem(normal)](r1.tree, 2, 20);
        r3: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <-
            btree_nodeid@insert[int64, int64, mem(normal)](r2.tree, 6, 60);
        r4: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <-
            btree_nodeid@insert[int64, int64, mem(normal)](r3.tree, 1, 10);
        r5: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <-
            btree_nodeid@insert[int64, int64, mem(normal)](r4.tree, 3, 30);
        r6: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <-
            btree_nodeid@insert[int64, int64, mem(normal)](r5.tree, 5, 50);
        r7: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <-
            btree_nodeid@insert[int64, int64, mem(normal)](r6.tree, 7, 70);
        r8: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <-
            btree_nodeid@insert[int64, int64, mem(normal)](r7.tree, 8, 80);
        insert_failures: int64 <-
            (fail_unless_one(r1.inserted) * 1) +
            (fail_unless_one(r2.inserted) * 2) +
            (fail_unless_one(r3.inserted) * 4) +
            (fail_unless_one(r4.inserted) * 8) +
            (fail_unless_one(r5.inserted) * 16) +
            (fail_unless_one(r6.inserted) * 32) +
            (fail_unless_one(r7.inserted) * 64) +
            (fail_unless_one(r8.inserted) * 128)
    produces
        pure { tree: r8.tree, insert_failures: insert_failures }
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        built: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, insert_failures: int64 } <- do_inserts();
        csr: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_nodeid@to_csr[int64, int64, mem(normal)](built.tree);
        validation_error: int64 <- btree_nodeid@validate_csr_error[int64, int64, mem(normal)](csr);
        has1: int64 <- btree_nodeid@contains_csr[int64, int64, mem(normal)](csr, 1);
        has4: int64 <- btree_nodeid@contains_csr[int64, int64, mem(normal)](csr, 4);
        has8: int64 <- btree_nodeid@contains_csr[int64, int64, mem(normal)](csr, 8);
        has9: int64 <- btree_nodeid@contains_csr[int64, int64, mem(normal)](csr, 9);
        g4: { found: int64, value: int64 } <- btree_nodeid@get_csr[int64, int64, mem(normal)](csr, 4);
        g8: { found: int64, value: int64 } <- btree_nodeid@get_csr[int64, int64, mem(normal)](csr, 8);
        g4_val_ok: int64 <- case g4.value == 40 of { true -> 1; false -> 0 };
        g8_val_ok: int64 <- case g8.value == 80 of { true -> 1; false -> 0 };
        failures: int64 <-
            built.insert_failures +
            (fail_unless_zero(csr.root_id) * 256) +
            (fail_unless_zero(csr.node_count - 3) * 512) +
            (fail_unless_zero(csr.key_count_total - 8) * 1024) +
            (fail_unless_zero(validation_error) * 2048) +
            (fail_unless_one(has1) * 4096) +
            (fail_unless_one(has4) * 8192) +
            (fail_unless_one(has8) * 16384) +
            (has9 * 32768) +
            ((1 - g4.found) * 65536) +
            (fail_unless_one(g4_val_ok) * 131072) +
            ((1 - g8.found) * 262144) +
            (fail_unless_one(g8_val_ok) * 524288)
    produces
        pure failures
    end
}
