use btree_set_nodeid;

fn main() -> int64 {
    sequence proc[mem(normal)]
        tree0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_set_nodeid@empty[int64, mem(normal)]();
        r1: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert[int64, mem(normal)](tree0, 4);
        r2: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)], compare_item: fn(int64, int64) -> :less | :equal | :greater }, inserted: int64 } <-
            btree_set_nodeid@insert[int64, mem(normal)](r1.tree, 2);
        failures: int64 <- ((1 - r1.inserted) * 1) + ((1 - r2.inserted) * 2)
    produces
        pure failures
    end
}
