// Phase 5 steps 5.2-5.3 — membership in a hand-built valid NodeIDBTreeSet[int64, mem(normal)] leaf tree.
use btree_set_nodeid;

fn compare_int64_atom(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn handbuilt_tree() -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    compare_item: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        empty_keys: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        key5: List[int64, mem(normal)] <- prepend[int64, mem(normal)](5, empty_keys);
        key35: List[int64, mem(normal)] <- prepend[int64, mem(normal)](3, key5);
        keys: List[int64, mem(normal)] <- prepend[int64, mem(normal)](1, key35);
        children: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: 0,
            key_count: 3,
            is_leaf: 1,
            keys: keys,
            children: children
        };
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)](root, empty_nodes);
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            root_id: 0,
            node_count: 1,
            order: 8,
            nodes: nodes,
            compare_item: compare_int64_atom
        }
    produces
        pure tree
    end
}

fn validation_failure() -> int64 {
    sequence proc[mem(normal)]
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- handbuilt_tree();
        validation: { ok: int64, error_code: int64 } <- btree_set_nodeid@validate[int64, mem(normal)](tree);
        failure: int64 <- 1 - validation.ok
    produces
        pure failure
    end
}

fn contains_1_failure() -> int64 {
    sequence proc[mem(normal)]
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- handbuilt_tree();
        has_key: int64 <- btree_set_nodeid@contains[int64, mem(normal)](tree, 1);
        failure: int64 <- 1 - has_key
    produces
        pure failure
    end
}

fn contains_3_failure() -> int64 {
    sequence proc[mem(normal)]
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- handbuilt_tree();
        has_key: int64 <- btree_set_nodeid@contains[int64, mem(normal)](tree, 3);
        failure: int64 <- 1 - has_key
    produces
        pure failure
    end
}

fn contains_5_failure() -> int64 {
    sequence proc[mem(normal)]
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- handbuilt_tree();
        has_key: int64 <- btree_set_nodeid@contains[int64, mem(normal)](tree, 5);
        failure: int64 <- 1 - has_key
    produces
        pure failure
    end
}

fn contains_4_failure() -> int64 {
    sequence proc[mem(normal)]
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- handbuilt_tree();
        has_key: int64 <- btree_set_nodeid@contains[int64, mem(normal)](tree, 4);
        failure: int64 <- has_key
    produces
        pure failure
    end
}

fn main() -> int64 {
    validation: int64 <- validation_failure();
    has1: int64 <- contains_1_failure();
    has3: int64 <- contains_3_failure();
    has5: int64 <- contains_5_failure();
    has4: int64 <- contains_4_failure();
    (validation * 1) + (has1 * 2) + (has3 * 4) + (has5 * 8) + (has4 * 16)
}
