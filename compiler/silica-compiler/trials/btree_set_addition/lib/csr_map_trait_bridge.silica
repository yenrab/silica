use btree_csr_map;

export empty_map/0;
export insert_map/3;
export validate_map/1;

fn empty_map() -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 1),
    node_key_count: buf(L1, normal, int64, 1),
    node_child_start: buf(L1, normal, int64, 1),
    node_child_count: buf(L1, normal, int64, 1),
    node_is_leaf: buf(L1, normal, int64, 1),
    keys: buf(L1, normal, int64, 7),
    values: buf(L1, normal, int64, 7),
    children: buf(L1, normal, int64, 8),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            values: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_csr_map@empty[int64, int64, mem(normal)]()
    produces
        pure tree
    end
}

fn insert_map(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        values: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64,
    value: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        values: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        result: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                values: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8),
                compare_key: fn(int64, int64) -> :less | :equal | :greater,
                compare_value: fn(int64, int64) -> :less | :equal | :greater
            },
            inserted: int64,
            replaced: int64
        } <- btree_csr_map@insert[int64, int64, mem(normal)](tree, key, value)
    produces
        pure result
    end
}

fn validate_map(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        values: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> { ok: int64, error_code: int64 } {
    sequence proc[mem(normal)]
        result: { ok: int64, error_code: int64 } <- btree_csr_map@validate[int64, int64, mem(normal)](tree)
    produces
        pure result
    end
}
