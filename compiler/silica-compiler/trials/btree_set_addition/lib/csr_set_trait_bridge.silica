use btree_set_csr;

export empty_set/0;
export insert_set/2;
export validate_set/1;
export contains_set/2;

fn empty_set() -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_item: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_set_csr@empty[int64, mem(normal)]()
    produces
        pure tree
    end
}

fn insert_set(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    inserted: int64
} {
    sequence proc[mem(normal)]
        result: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 3),
                node_key_count: buf(L1, normal, int64, 3),
                node_child_start: buf(L1, normal, int64, 3),
                node_child_count: buf(L1, normal, int64, 3),
                node_is_leaf: buf(L1, normal, int64, 3),
                keys: buf(L1, normal, int64, 8),
                children: buf(L1, normal, int64, 2),
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            inserted: int64
        } <- btree_set_csr@insert[int64, mem(normal)](tree, key)
    produces
        pure result
    end
}

fn validate_set(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> { ok: int64, error_code: int64 } {
    sequence proc[mem(normal)]
        result: { ok: int64, error_code: int64 } <- btree_set_csr@validate[int64, mem(normal)](tree)
    produces
        pure result
    end
}

fn contains_set(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> boolean {
    sequence proc[mem(normal)]
        found: int64 <- btree_set_csr@contains[int64, mem(normal)](tree, key);
        result: boolean <- case found of {
            0 -> false;
            _: int64 -> true
        }
    produces
        pure result
    end
}
