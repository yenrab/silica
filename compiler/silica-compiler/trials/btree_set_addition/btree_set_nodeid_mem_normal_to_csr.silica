// Phase 6 step 6.4 — insert {1,3,5} into NodeIDBTreeSet, finalize to CsrBTreeSet, verify membership.
use btree_set_nodeid_mem_normal;
use btree_set_csr_mem_normal;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        tree0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_set_nodeid_mem_normal@btree_set_nodeid_empty[int64, mem(normal)]();
        r1: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64 } <-
            btree_set_nodeid_mem_normal@btree_set_nodeid_insert[int64, mem(normal)](tree0, 1);
        r2: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64 } <-
            btree_set_nodeid_mem_normal@btree_set_nodeid_insert[int64, mem(normal)](r1.tree, 3);
        r3: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64 } <-
            btree_set_nodeid_mem_normal@btree_set_nodeid_insert[int64, mem(normal)](r2.tree, 5);
        csr: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- btree_set_nodeid_mem_normal@btree_set_nodeid_to_csr[int64, mem(normal)](r3.tree);
        validation: { ok: int64, error_code: int64 } <- btree_set_csr_mem_normal@btree_set_csr_validate[int64, mem(normal)](csr);
        has1: int64 <- btree_set_csr_mem_normal@btree_set_csr_contains[int64, mem(normal)](csr, 1);
        has3: int64 <- btree_set_csr_mem_normal@btree_set_csr_contains[int64, mem(normal)](csr, 3);
        has5: int64 <- btree_set_csr_mem_normal@btree_set_csr_contains[int64, mem(normal)](csr, 5);
        has4: int64 <- btree_set_csr_mem_normal@btree_set_csr_contains[int64, mem(normal)](csr, 4);
        failures: int64 <-
            (fail_unless_one(r1.inserted) * 1) +
            (fail_unless_one(r2.inserted) * 2) +
            (fail_unless_one(r3.inserted) * 4) +
            (fail_unless_one(csr.node_count) * 8) +
            ((1 - validation.ok) * 16) +
            (fail_unless_one(has1) * 32) +
            (fail_unless_one(has3) * 64) +
            (fail_unless_one(has5) * 128) +
            (has4 * 256)
    produces
        pure failures
    end
}
