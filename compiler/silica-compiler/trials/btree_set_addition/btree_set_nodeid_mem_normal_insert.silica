// Phase 5 step 5.4 — NodeIDBTreeSet[int64, mem(normal)] insertion status and duplicate handling.
use btree_set_nodeid_mem_normal;

fn main() -> int64 {
    sequence proc[mem(normal)]
        tree0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_set_nodeid_mem_normal@btree_set_nodeid_empty[int64, mem(normal)]();
        r1: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64 } <-
            btree_set_nodeid_mem_normal@btree_set_nodeid_insert[int64, mem(normal)](tree0, 4);
        r2: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64 } <-
            btree_set_nodeid_mem_normal@btree_set_nodeid_insert[int64, mem(normal)](r1.tree, 2);
        duplicate: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64 } <-
            btree_set_nodeid_mem_normal@btree_set_nodeid_insert[int64, mem(normal)](r2.tree, 4);
        failures: int64 <- ((1 - r1.inserted) * 1)
            + ((1 - r2.inserted) * 2)
            + (duplicate.inserted * 4)
    produces
        pure failures
    end
}
