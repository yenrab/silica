// Debug driver — three inserts {1,3,5} (Phase 6.4 prerequisite).
use btree_set_nodeid_mem_normal;

fn main() -> int64 {
    sequence proc[mem(normal)]
        tree0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_set_nodeid_mem_normal@btree_set_nodeid_empty[int64, mem(normal)]();
        r1: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64 } <-
            btree_set_nodeid_mem_normal@btree_set_nodeid_insert[int64, mem(normal)](tree0, 1);
        r2: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64 } <-
            btree_set_nodeid_mem_normal@btree_set_nodeid_insert[int64, mem(normal)](r1.tree, 3);
        r3: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64 } <-
            btree_set_nodeid_mem_normal@btree_set_nodeid_insert[int64, mem(normal)](r2.tree, 5);
        failures: int64 <- ((1 - r1.inserted) * 1) + ((1 - r2.inserted) * 2) + ((1 - r3.inserted) * 4)
    produces
        pure failures
    end
}
