// Phase 8 step 8.2 — CsrBTreeMap[int64, int64, mem(normal)] functional insert,
// replace_value semantics, and key lookup (get).
// Inserts {3→30, 1→10, 5→50}, then replaces 3→300, then queries all mappings.
// Also verifies the original empty map is not mutated (immutability contract).
use btree_csr_map;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_if_nonzero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[]
        tree0: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            values: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- btree_csr_map@empty[int64, int64, mem(normal)]();
        r1: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                values: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64,
            replaced: int64
        } <- btree_csr_map@insert[int64, int64, mem(normal)](tree0, 3, 30);
        r2: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                values: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64,
            replaced: int64
        } <- btree_csr_map@insert[int64, int64, mem(normal)](r1.tree, 1, 10);
        r3: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                values: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64,
            replaced: int64
        } <- btree_csr_map@insert[int64, int64, mem(normal)](r2.tree, 5, 50);
        r4: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                values: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64,
            replaced: int64
        } <- btree_csr_map@insert[int64, int64, mem(normal)](r3.tree, 3, 300);
        g1: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](r4.tree, 1);
        g3: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](r4.tree, 3);
        g5: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](r4.tree, 5);
        g4: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](r4.tree, 4);
        validation: { ok: int64, error_code: int64 } <- btree_csr_map@validate[int64, int64, mem(normal)](r4.tree);
        g1_val_ok: int64 <- case g1.value == 10 of { true -> 1; false -> 0 };
        g3_val_ok: int64 <- case g3.value == 300 of { true -> 1; false -> 0 };
        g5_val_ok: int64 <- case g5.value == 50 of { true -> 1; false -> 0 };
        tree0_unchanged: int64 <- case tree0.root_id of { -1 -> 0; _: int64 -> 1 };
        failures: int64 <-
            (fail_unless_one(r1.inserted) * 1) +
            (fail_if_nonzero(r1.replaced) * 2) +
            (fail_unless_one(r2.inserted) * 4) +
            (fail_unless_one(r3.inserted) * 8) +
            (fail_if_nonzero(r4.inserted) * 16) +
            (fail_unless_one(r4.replaced) * 32) +
            ((1 - validation.ok) * 64) +
            ((1 - g1.found) * 128) +
            (fail_unless_one(g1_val_ok) * 256) +
            ((1 - g3.found) * 512) +
            (fail_unless_one(g3_val_ok) * 1024) +
            ((1 - g5.found) * 2048) +
            (fail_unless_one(g5_val_ok) * 4096) +
            (g4.found * 8192) +
            (tree0_unchanged * 16384)
    produces
        pure failures
    end
}
