// Phase 8 step 8.2 — CsrBTreeMap[int64, int64, mem(normal)] functional insert,
// replace_value semantics, and key lookup (get).
// Inserts {3→30, 1→10, 5→50}, then replaces 3→300, then queries all mappings.
// Also verifies the original empty map is not mutated (immutability contract).
use OrderedMap;
use csr_map_trait_bridge;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_if_nonzero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence
        functions: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            compare_key: compare_int64_atom,
            compare_value: compare_int64_atom
        };
        tree0: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            values: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- csr_map_trait_bridge@empty_map();
        r1: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                values: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64,
            replaced: int64
        } <- csr_map_trait_bridge@insert_map(tree0, 3, 30);
        r2: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                values: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64,
            replaced: int64
        } <- csr_map_trait_bridge@insert_map(r1.tree, 1, 10);
        r3: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                values: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64,
            replaced: int64
        } <- csr_map_trait_bridge@insert_map(r2.tree, 5, 50);
        r4: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                values: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64,
            replaced: int64
        } <- csr_map_trait_bridge@insert_map(r3.tree, 3, 300);
        trait_map: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            values: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- {
            compare_key: functions.compare_key,
            compare_value: functions.compare_value,
            region: r4.tree.region,
            root_id: r4.tree.root_id,
            node_count: r4.tree.node_count,
            key_count_total: r4.tree.key_count_total,
            order: r4.tree.order,
            node_key_start: r4.tree.node_key_start,
            node_key_count: r4.tree.node_key_count,
            node_child_start: r4.tree.node_child_start,
            node_child_count: r4.tree.node_child_count,
            node_is_leaf: r4.tree.node_is_leaf,
            keys: r4.tree.keys,
            values: r4.tree.values,
            children: r4.tree.children
        };
        g1: { found: int64, value: int64 } <- OrderedMap@get(trait_map, 1);
        g3: { found: int64, value: int64 } <- OrderedMap@get(trait_map, 3);
        g5: { found: int64, value: int64 } <- OrderedMap@get(trait_map, 5);
        has4: boolean <- OrderedMap@contains_key(trait_map, 4);
        validation: { ok: int64, error_code: int64 } <- csr_map_trait_bridge@validate_map(r4.tree);
        g1_val_ok: int64 <- case g1.value == 10 of { true -> 1; false -> 0 };
        g3_val_ok: int64 <- case g3.value == 300 of { true -> 1; false -> 0 };
        g5_val_ok: int64 <- case g5.value == 50 of { true -> 1; false -> 0 };
        tree0_unchanged: int64 <- case tree0.root_id of { -1 -> 0; _: int64 -> 1 };
        failures: int64 <-
            (fail_unless_one(r1.inserted) * 1) +
            (fail_if_nonzero(r1.replaced) * 2) +
            (fail_unless_one(r2.inserted) * 4) +
            (fail_unless_one(r3.inserted) * 8) +
            (fail_if_nonzero(r4.inserted) * 16) +
            (fail_unless_one(r4.replaced) * 32) +
            ((1 - validation.ok) * 64) +
            ((1 - g1.found) * 128) +
            (fail_unless_one(g1_val_ok) * 256) +
            ((1 - g3.found) * 512) +
            (fail_unless_one(g3_val_ok) * 1024) +
            ((1 - g5.found) * 2048) +
            (fail_unless_one(g5_val_ok) * 4096) +
            (case has4 of { true -> 8192; false -> 0 }) +
            (tree0_unchanged * 16384)
    produces
        pure failures
    end
}
