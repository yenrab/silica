.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    MOV X1, #-4
    MOV X19, X1
    MOV X2, X19
L_case_o128_br_0:
    MOV X9, X2
    MOV X10, #0
    CMP X9, X10
    CSET X4, LT
    CBZ X4, L_case_o128_br_1
    MOV X9, X2
    MOV X10, #-1
    MUL X3, X9, X10
    MOV X20, X3
    MOV X9, X20
    MOV X10, #1
    ADD X0, X9, X10
    MOV X21, X0
    MOV X9, X21
    MOV X10, #2
    MUL X0, X9, X10
    B L_case_o128_done
L_case_o128_br_1:
    MOV X9, X2
    MOV X10, #0
    CMP X9, X10
    CSET X4, GE
    CBZ X4, L_case_o128_fb
    MOV X9, X2
    MOV X10, #3
    MUL X3, X9, X10
    MOV X20, X3
    MOV X9, X20
    MOV X10, #7
    ADD X0, X9, X10
    B L_case_o128_done
L_case_o128_fb:
    MOV X0, #0
    B L_case_o128_done
L_case_o128_done:

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
