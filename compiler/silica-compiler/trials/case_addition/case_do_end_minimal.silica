// Regression: case-branch RHS `-> do ... end` must parse as a real body, not stub/dummy.
fn helper(n: int64) -> int64 {
    case n of {
        0 -> 0;
        _: int64 -> do
            x: int64 <- n;
            y: int64 <- x;
            y
        end
    }
}

fn main() -> int64 {
    helper(7)
}
