.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X1, #1
    MOV X2, X1
L_case_o132_br_0:
    CMP W2, #1
    B.NE L_case_o132_br_1
    MOV X0, #1
    B L_case_o132_done
L_case_o132_br_1:
    CMP W2, #0
    B.NE L_case_o132_fb
    MOV X0, #0
    B L_case_o132_done
L_case_o132_fb:
    MOV X0, #0
    B L_case_o132_done
L_case_o132_done:

    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0

