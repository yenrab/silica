.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X1, #-7
    MOV X19, X1
    MOV X2, X19
L_case_o118_br_0:
    MOV X9, X2
    MOV X10, #0
    CMP X9, X10
    CSET X4, GT
    CBZ X4, L_case_o118_br_1
    MOV X9, X2
    MOV X10, #2
    MUL X0, X9, X10
    B L_case_o118_done
L_case_o118_br_1:
    MOV X9, X2
    MOV X10, #0
    CMP X9, X10
    CSET X4, LT
    CBZ X4, L_case_o118_br_2
    MOV X9, X2
    NEG X9, X9
    MOV X10, #2
    MUL X0, X9, X10
    B L_case_o118_done
L_case_o118_br_2:
    MOV X0, #0
    B L_case_o118_done
L_case_o118_fb:
    MOV X0, #0
    B L_case_o118_done
L_case_o118_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
