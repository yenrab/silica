.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X2, #1
L_case_o116_br_0:
    CMP W2, #1
    B.NE L_case_o116_br_1
    MOV X0, #1
    B L_case_o116_done
L_case_o116_br_1:
    CMP W2, #0
    B.NE L_case_o116_fb
    MOV X0, #0
    B L_case_o116_done
L_case_o116_fb:
    MOV X0, #0
    B L_case_o116_done
L_case_o116_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
