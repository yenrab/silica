.text
.global main


main.is_positive:     STP X29, X30, [SP, #-16]!

    MOV X9, X0
    MOV X10, #0


    CMP X9, X10
    CSET X0, GT
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X1, #8
    MOV X2, X1
L_case_o157_br_0:
    MOV X0, X2
    ; effects []|sir_rec:o189|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X8, main.is_positive@PAGE
    ADD X8, X8, main.is_positive@PAGEOFF
    BLR X8
    MOV X4, X0
    CBZ X4, L_case_o157_br_1
    MOV X9, X2
    MOV X10, #2
    MUL X0, X9, X10
    B L_case_o157_done
L_case_o157_br_1:
    MOV X0, #0
    B L_case_o157_done
L_case_o157_fb:
    MOV X0, #0
    B L_case_o157_done
L_case_o157_done:

    LDP X29, X30, [SP], #16
    RET
