// Spec §3.3.3: guarded branches with multi-line block bodies (expression blocks)
fn main() -> int64 {
    x: int64 <- -4;
    case x of {
        n: int64 if n < 0 -> {
            y: int64 <- n * -1;
            step: int64 <- y + 1;
            step * 2
        }
        n: int64 if n >= 0 -> {
            z: int64 <- n * 3;
            z + 7
        }
    }
}
