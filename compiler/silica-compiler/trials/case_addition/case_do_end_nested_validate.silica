fn cmp_fn(a: int64, b: int64) -> :less | :equal | :greater {
    :equal
}

fn validate(c: :less | :equal | :greater) -> atom {
    c
}

fn helper(n: int64) -> int64 {
    case n of {
        0 -> 0;
        _: int64 -> do
            node: int64 <- n;
            cmp: atom <- validate(cmp_fn(n, node));
            case cmp of {
                :equal -> 1;
                _: atom -> 0
            }
        end
    }
}

fn main() -> int64 {
    helper(1)
}
