.text
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X19, X1
    MOV X3, X19
L_case_o108_br_0:
    MOV X9, X3
    ADRP X10, L_str_0@PAGE
    ADD X10, X10, L_str_0@PAGEOFF
    STP X0, X1, [SP, #-16]!
    MOV X0, X9
    MOV X1, X10
    BL L_string_cmp_helper
    CMP W0, #0
    CSET W12, NE
    LDP X0, X1, [SP], #16
    MOV X5, X12

    CBZ X5, L_case_o108_br_1
    MOV X0, #1
    B L_case_o108_done
L_case_o108_br_1:
    MOV X0, #0
    B L_case_o108_done
L_case_o108_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o108_done
L_case_o108_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #21
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_string_cmp_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Lcmp_anull
    CBZ X20, Lcmp_gt
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lcmp_n1_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lcmp_n1_cstr
    LDR X21, [X0, #8]
    LDR X22, [X0, #16]
    MOV X2, #0x40000000
    CMP X22, X2
    B.HS Lcmp_n1_cstr
    B Lcmp_n1_done
Lcmp_n1_cstr:
    MOV X21, X0
    MOV X22, #0
    MOV X1, X0
Lcmp_n1l:
    LDRB W3, [X1], #1
    CBZ W3, Lcmp_n1_done
    ADD X22, X22, #1
    CMP X22, #0x100000
    B.LT Lcmp_n1l
Lcmp_n1_done:
    MOV X0, X20
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lcmp_n2_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lcmp_n2_cstr
    LDR X23, [X0, #8]
    LDR X24, [X0, #16]
    MOV X2, #0x40000000
    CMP X24, X2
    B.HS Lcmp_n2_cstr
    B Lcmp_n2_done
Lcmp_n2_cstr:
    MOV X23, X0
    MOV X24, #0
    MOV X1, X0
Lcmp_n2l:
    LDRB W3, [X1], #1
    CBZ W3, Lcmp_n2_done
    ADD X24, X24, #1
    CMP X24, #0x100000
    B.LT Lcmp_n2l
Lcmp_n2_done:
    MOV X25, X22
    CMP X25, X24
    B.LS Lcmp_minok
    MOV X25, X24
Lcmp_minok:
    CBZ X25, Lcmp_len
    MOV X26, X21
    MOV X27, X23
Lcmp_cloop:
    LDRB W28, [X26], #1
    LDRB W1, [X27], #1
    CMP W28, W1
    B.LO Lcmp_lt
    B.HI Lcmp_gt
    SUBS X25, X25, #1
    B.NE Lcmp_cloop
Lcmp_len:
    CMP X22, X24
    B.EQ Lcmp_eq
    B.LO Lcmp_lt
    B Lcmp_gt
Lcmp_anull:
    CBZ X20, Lcmp_eq
Lcmp_lt:
    MOV W0, #-1
    B Lcmp_exit
Lcmp_gt:
    MOV W0, #1
    B Lcmp_exit
Lcmp_eq:
    MOV W0, #0
Lcmp_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

