.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X19, X1
    MOV X2, X19
L_case_o108_br_0:
    MOV X9, X2
    ADRP X10, L_str_0@PAGE
    ADD X10, X10, L_str_0@PAGEOFF
    CMP X9, X10
    CSET X4, NE
    CBZ X4, L_case_o108_br_1
    MOV X0, #1
    B L_case_o108_done
L_case_o108_br_1:
    MOV X0, #0
    B L_case_o108_done
L_case_o108_fb:
    MOV X0, #0
    B L_case_o108_done
L_case_o108_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii ""
    .byte 0

