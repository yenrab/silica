// Spec §3.3.4: each branch is a block; effectful work in sequence proc[device_io] (print requires device_io)
fn main() -> atom {
    mode: string <- "verbose";
    case mode of {
        "verbose" -> {
            sequence proc[device_io]
                print_string("verbose");
                println("");
                print_int64(1);
                println("")
            produces
                pure :ok
            end
        }
        "quiet" -> {
            sequence proc[device_io]
                print_int64(0);
                println("")
            produces
                pure :ok
            end
        }
        _: string -> {
            sequence proc[device_io]
                print_string("default");
                println("")
            produces
                pure :ok
            end
        }
    }
}
