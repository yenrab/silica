.text
.global main


main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f64_0@PAGE
    LDR D0, [X0, L_f64_0@PAGEOFF]
    STR D0, [SP, #-16]!
    ADRP X0, L_f64_2@PAGE
    LDR D2, [X0, L_f64_2@PAGEOFF]
    ADRP X0, L_f64_1@PAGE
    LDR D1, [X0, L_f64_1@PAGEOFF]


    FMUL D2, D1, D2
    LDR D1, [SP], #16


    FADD D0, D1, D2
    FCVTZS W0, D0
    LDP X29, X30, [SP], #16
    RET
