fn main() -> atom {
    sequence proc[device_io]
        _: atom <- print_bool(float16_is_nan(float16_nan()));
        _: unit <- println("");
        _: atom <- print_float16(float16_nan());
        _: unit <- println("");
        _: atom <- print_bool(float16_is_nan(0.0 / 0.0));
        _: unit <- println("");
        _: atom <- print_float16(0.0 / 0.0);
        _: unit <- println("");
        _: atom <- print_bool(float16_is_inf(float16_inf()));
        _: unit <- println("");
        _: atom <- print_float16(float16_inf());
        _: unit <- println("");
        _: atom <- print_bool(float16_is_inf(float16_neg_inf()));
        _: unit <- println("");
        _: atom <- print_float16(float16_neg_inf());
        _: unit <- println("");
        _: atom <- print_bool(float16_is_inf(1.0 / 0.0));
        _: unit <- println("");
        _: atom <- print_float16(1.0 / 0.0);
        _: unit <- println("");
        _: atom <- print_bool(float16_is_inf((0.0 - 1.0) / 0.0));
        _: unit <- println("");
        _: atom <- print_float16((0.0 - 1.0) / 0.0);
        _: unit <- println("");
        _: atom <- print_bool(float16_is_inf((0.0 - 1.0) / 0.0));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_inf(1.0 / (0.0 / float16_neg_inf())));
        _: unit <- println("");
        _: atom <- print_float16(1.0 / (0.0 / float16_neg_inf()));
        _: unit <- println("");
        _: atom <- print_bool(float16_is_finite(1.0));
        _: unit <- println("");
        _: atom <- print_float16(1.0);
        _: unit <- println("");
        _: atom <- print_bool(float16_is_finite(float16_inf()) == false);
        _: unit <- println("");
        done: atom <- print_bool(float16_is_finite(float16_nan()) == false);
        _: unit <- println("")
    produces
        pure done
    end
}
