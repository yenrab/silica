fn main() -> atom {
    sequence proc[device_io]
        nan: float64 <- float64_nan();
        one: float64 <- 1.0;
        two: float64 <- 2.0;
        _: atom <- print_bool(float64_is_nan(nan + one));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan(one + nan));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan(nan - one));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan(one - nan));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan(nan * two));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan(two * nan));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan(nan / two));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan(two / nan));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan((nan + one) * two));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan((one + nan) / two));
        _: unit <- println("");
        _: atom <- print_bool(float64_is_nan(nan + float64_nan()));
        _: unit <- println("");
        done: atom <- print_bool(float64_is_nan((float64_nan() * nan) - float64_nan()));
        _: unit <- println("")
    produces
        pure done
    end
}
