.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X10, #5
    STR X10, [SP, #-16]!
    MOV X10, #4
    STR X10, [SP, #-16]!
    MOV X9, #2
    MOV X10, #3


    MUL X9, X9, X10
    LDR X10, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    MUL X0, X9, X10
    LDP X29, X30, [SP], #16
    RET
