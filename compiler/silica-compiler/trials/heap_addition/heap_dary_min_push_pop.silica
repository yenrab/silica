// Phase 9 step 9.3 — repeated pop on RegionDaryMinHeap[int64, mem(normal)] with D=4.
// Pushes {9, 2, 7, 1, 5}; pops 1, 2, 5, 7, 9.
use heap_dary_min;

fn push_five(heap0: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    arity: int64,
    values: buf(L1, normal, int64, 8)
}) -> {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    arity: int64,
    values: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]
        r1: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_dary_min@push[int64, mem(normal)](heap0, 9);
        r2: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_dary_min@push[int64, mem(normal)](r1.heap, 2);
        r3: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_dary_min@push[int64, mem(normal)](r2.heap, 7);
        r4: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_dary_min@push[int64, mem(normal)](r3.heap, 1);
        r5: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_dary_min@push[int64, mem(normal)](r4.heap, 5)
    produces
        pure r5.heap
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            arity: int64,
            values: buf(L1, normal, int64, 8)
        } <- heap_dary_min@empty[int64, mem(normal)]();
        heap1: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            arity: int64,
            values: buf(L1, normal, int64, 8)
        } <- push_five(heap0);
        top: { ok: int64, value: int64 } <- heap_dary_min@peek[int64, mem(normal)](heap1);
        validation: { ok: int64, error_code: int64 } <- heap_dary_min@validate[int64, mem(normal)](heap1);
        precheck: int64 <- case top.ok of {
            0 -> 1;
            _: int64 -> case top.value == 1 of {
                true -> case validation.ok of {
                    0 -> 3;
                    _: int64 -> 0
                };
                false -> 2
            }
        };
        result: int64 <- case precheck of {
            0 -> {
                pop1: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64, value: int64 } <-
                    heap_dary_min@pop[int64, mem(normal)](heap1);
                check1: int64 <- case pop1.ok of {
                    0 -> 4;
                    _: int64 -> case pop1.value == 1 of { true -> 0; false -> 5 }
                };
                case check1 of {
                    0 -> {
                        pop2: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64, value: int64 } <-
                            heap_dary_min@pop[int64, mem(normal)](pop1.heap);
                        check2: int64 <- case pop2.ok of {
                            0 -> 6;
                            _: int64 -> case pop2.value == 2 of { true -> 0; false -> 7 }
                        };
                        case check2 of {
                            0 -> {
                                pop3: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64, value: int64 } <-
                                    heap_dary_min@pop[int64, mem(normal)](pop2.heap);
                                check3: int64 <- case pop3.ok of {
                                    0 -> 8;
                                    _: int64 -> case pop3.value == 5 of { true -> 0; false -> 9 }
                                };
                                case check3 of {
                                    0 -> {
                                        pop4: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64, value: int64 } <-
                                            heap_dary_min@pop[int64, mem(normal)](pop3.heap);
                                        check4: int64 <- case pop4.ok of {
                                            0 -> 10;
                                            _: int64 -> case pop4.value == 7 of { true -> 0; false -> 11 }
                                        };
                                        case check4 of {
                                            0 -> {
                                                pop5: { heap: { region: region(L1, normal), len: int64, capacity: int64, arity: int64, values: buf(L1, normal, int64, 8) }, ok: int64, value: int64 } <-
                                                    heap_dary_min@pop[int64, mem(normal)](pop4.heap);
                                                check5: int64 <- case pop5.ok of {
                                                    0 -> 12;
                                                    _: int64 -> case pop5.value == 9 of { true -> 0; false -> 13 }
                                                };
                                                check5
                                            };
                                            err4: int64 -> err4
                                        }
                                    };
                                    err3: int64 -> err3
                                }
                            };
                            err2: int64 -> err2
                        }
                    };
                    err1: int64 -> err1
                }
            };
            err0: int64 -> err0
        }
    produces
        pure result
    end
}
