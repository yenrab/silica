// Phase 9 step 9.1 — empty RegionBinaryMinHeap[int64, mem(normal)].
use heap_binary_min;

fn main() -> int64 {
    sequence proc[mem(normal)]        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            values: buf(L1, normal, int64, 8)
        } <- heap_binary_min@empty[int64, mem(normal)]();
        heap_len: int64 <- heap0.len;
        empty_flag: int64 <- heap_binary_min@is_empty[int64, mem(normal)](heap0);
        full_flag: int64 <- heap_binary_min@is_full[int64, mem(normal)](heap0);
        top: { ok: int64, value: int64 } <- heap_binary_min@peek[int64, mem(normal)](heap0);
        validation: { ok: int64, error_code: int64 } <- heap_binary_min@validate[int64, mem(normal)](heap0);
        failures: int64 <-
            heap_len +
            ((1 - empty_flag) * 2) +
            (full_flag * 4) +
            (top.ok * 8) +
            ((1 - validation.ok) * 16)
    produces
        pure failures
    end
}
