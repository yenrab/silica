// Phase 9 step 9.1 — repeated pop on RegionBinaryMinHeap[int64, mem(normal)].
// Pushes {5, 3, 7, 1}; pops 1, 3, 5, 7.
use heap_binary_min;

fn push_four(heap0: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8)
}) -> {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]        r1: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push[int64, mem(normal)](heap0, 5);
        r2: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push[int64, mem(normal)](r1.heap, 3);
        r3: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push[int64, mem(normal)](r2.heap, 7);
        r4: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push[int64, mem(normal)](r3.heap, 1)
    produces
        pure r4.heap
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            values: buf(L1, normal, int64, 8)
        } <- heap_binary_min@empty[int64, mem(normal)]();
        heap1: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            values: buf(L1, normal, int64, 8)
        } <- push_four(heap0);
        pop1: {
            heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) },
            ok: int64,
            value: int64
        } <- heap_binary_min@pop[int64, mem(normal)](heap1);
        check1: int64 <- case pop1.ok of {
            0 -> 1;
            _: int64 -> case pop1.value == 1 of {
                true -> 0;
                false -> 2
            }
        };
        result: int64 <- case check1 of {
            0 -> {
                pop2: {
                    heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) },
                    ok: int64,
                    value: int64
                } <- heap_binary_min@pop[int64, mem(normal)](pop1.heap);
                check2: int64 <- case pop2.ok of {
                    0 -> 3;
                    _: int64 -> case pop2.value == 3 of {
                        true -> 0;
                        false -> 4
                    }
                };
                case check2 of {
                    0 -> {
                        pop3: {
                            heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) },
                            ok: int64,
                            value: int64
                        } <- heap_binary_min@pop[int64, mem(normal)](pop2.heap);
                        check3: int64 <- case pop3.ok of {
                            0 -> 5;
                            _: int64 -> case pop3.value == 5 of {
                                true -> 0;
                                false -> 6
                            }
                        };
                        case check3 of {
                            0 -> {
                                pop4: {
                                    heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) },
                                    ok: int64,
                                    value: int64
                                } <- heap_binary_min@pop[int64, mem(normal)](pop3.heap);
                                case pop4.ok of {
                                    0 -> 7;
                                    _: int64 -> case pop4.value == 7 of {
                                        true -> 0;
                                        false -> 8
                                    }
                                }
                            };
                            err3: int64 -> err3
                        }
                    };
                    err2: int64 -> err2
                }
            };
            err1: int64 -> err1
        }
    produces
        pure result
    end
}
