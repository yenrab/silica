// Phase 9 step 9.3 — invalid RegionDaryMinHeap[int64, mem(normal)] validation.
use heap_dary_min;

fn main() -> int64 {
    sequence proc[mem(normal)]
        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            arity: int64,
            values: buf(L1, normal, int64, 8)
        } <- heap_dary_min@empty[int64, mem(normal)]();
        r1: {
            heap: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                arity: int64,
                values: buf(L1, normal, int64, 8)
            },
            ok: int64
        } <- heap_dary_min@push[int64, mem(normal)](heap0, 5);
        r2: {
            heap: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                arity: int64,
                values: buf(L1, normal, int64, 8)
            },
            ok: int64
        } <- heap_dary_min@push[int64, mem(normal)](r1.heap, 1);
        _: atom <- write_buf(r2.heap.values, 1, 0);
        validation: { ok: int64, error_code: int64 } <- heap_dary_min@validate[int64, mem(normal)](r2.heap);
        code_ok: int64 <- case validation.error_code == 5 of {
            true -> 1;
            false -> 0
        };
        failures: int64 <- (validation.ok * 1) + ((1 - code_ok) * 2)
    produces
        pure failures
    end
}
