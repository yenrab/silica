// Phase 9 step 9.3 — empty RegionDaryMinHeap[int64, mem(normal)] with D=4.
use heap_dary_min;

fn main() -> int64 {
    sequence proc[mem(normal)]
        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            arity: int64,
            values: buf(L1, normal, int64, 8)
        } <- heap_dary_min@empty[int64, mem(normal)]();
        heap_len: int64 <- heap_dary_min@len[int64, mem(normal)](heap0);
        empty_flag: int64 <- heap_dary_min@is_empty[int64, mem(normal)](heap0);
        full_flag: int64 <- heap_dary_min@is_full[int64, mem(normal)](heap0);
        top: { ok: int64, value: int64 } <- heap_dary_min@peek[int64, mem(normal)](heap0);
        validation: { ok: int64, error_code: int64 } <- heap_dary_min@validate[int64, mem(normal)](heap0);
        arity_ok: int64 <- case heap0.arity == 4 of {
            true -> 1;
            false -> 0
        };
        failures: int64 <-
            heap_len +
            ((1 - empty_flag) * 2) +
            (full_flag * 4) +
            (top.ok * 8) +
            ((1 - validation.ok) * 16) +
            ((1 - arity_ok) * 32)
    produces
        pure failures
    end
}
