// Debug — four pushes then two pops.
use heap_binary_min;

fn main() -> int64 {
    sequence proc[]
        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            values: buf(L1, normal, int64, 8)
        } <- heap_binary_min@empty[int64, mem(normal)]();
        r1: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push[int64, mem(normal)](heap0, 5);
        r2: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push[int64, mem(normal)](r1.heap, 3);
        r3: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push[int64, mem(normal)](r2.heap, 7);
        r4: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push[int64, mem(normal)](r3.heap, 1);
        pop1: {
            heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) },
            ok: int64,
            value: int64
        } <- heap_binary_min@pop[int64, mem(normal)](r4.heap);
        pop2: {
            heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) },
            ok: int64,
            value: int64
        } <- heap_binary_min@pop[int64, mem(normal)](pop1.heap);
        failures: int64 <-
            ((1 - pop1.ok) * 1) +
            ((1 - case pop1.value == 1 of { true -> 1; false -> 0 }) * 2) +
            ((1 - pop2.ok) * 4) +
            ((1 - case pop2.value == 3 of { true -> 1; false -> 0 }) * 8)
    produces
        pure failures
    end
}
