// Phase 9 step 9.2 — repeated pop on RegionBinaryMinHeap[int64, int64, mem(normal)].
// Pushes priorities/values {(5,50), (3,30), (7,70), (1,10)};
// pops (1,10), (3,30), (5,50), (7,70).
use heap_binary_min;

fn push_four(heap0: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
} {
    sequence proc[]
        r1: { heap: { region: region(L1, normal), len: int64, capacity: int64, priorities: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push_priority_value[int64, int64, mem(normal)](heap0, 5, 50);
        r2: { heap: { region: region(L1, normal), len: int64, capacity: int64, priorities: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push_priority_value[int64, int64, mem(normal)](r1.heap, 3, 30);
        r3: { heap: { region: region(L1, normal), len: int64, capacity: int64, priorities: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push_priority_value[int64, int64, mem(normal)](r2.heap, 7, 70);
        r4: { heap: { region: region(L1, normal), len: int64, capacity: int64, priorities: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8) }, ok: int64 } <-
            heap_binary_min@push_priority_value[int64, int64, mem(normal)](r3.heap, 1, 10)
    produces
        pure r4.heap
    end
}

fn main() -> int64 {
    sequence proc[]
        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            priorities: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8)
        } <- heap_binary_min@empty[int64, int64, mem(normal)]();
        heap1: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            priorities: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8)
        } <- push_four(heap0);
        pop1: {
            heap: { region: region(L1, normal), len: int64, capacity: int64, priorities: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8) },
            ok: int64,
            priority: int64,
            value: int64
        } <- heap_binary_min@pop_priority_value[int64, int64, mem(normal)](heap1);
        check1: int64 <- case pop1.ok of {
            0 -> 1;
            _: int64 -> case pop1.priority == 1 of {
                true -> case pop1.value == 10 of {
                    true -> 0;
                    false -> 3
                };
                false -> 2
            }
        };
        result: int64 <- case check1 of {
            0 -> {
                pop2: {
                    heap: { region: region(L1, normal), len: int64, capacity: int64, priorities: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8) },
                    ok: int64,
                    priority: int64,
                    value: int64
                } <- heap_binary_min@pop_priority_value[int64, int64, mem(normal)](pop1.heap);
                check2: int64 <- case pop2.ok of {
                    0 -> 4;
                    _: int64 -> case pop2.priority == 3 of {
                        true -> case pop2.value == 30 of {
                            true -> 0;
                            false -> 6
                        };
                        false -> 5
                    }
                };
                case check2 of {
                    0 -> {
                        pop3: {
                            heap: { region: region(L1, normal), len: int64, capacity: int64, priorities: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8) },
                            ok: int64,
                            priority: int64,
                            value: int64
                        } <- heap_binary_min@pop_priority_value[int64, int64, mem(normal)](pop2.heap);
                        check3: int64 <- case pop3.ok of {
                            0 -> 7;
                            _: int64 -> case pop3.priority == 5 of {
                                true -> case pop3.value == 50 of {
                                    true -> 0;
                                    false -> 9
                                };
                                false -> 8
                            }
                        };
                        case check3 of {
                            0 -> {
                                pop4: {
                                    heap: { region: region(L1, normal), len: int64, capacity: int64, priorities: buf(L1, normal, int64, 8), values: buf(L1, normal, int64, 8) },
                                    ok: int64,
                                    priority: int64,
                                    value: int64
                                } <- heap_binary_min@pop_priority_value[int64, int64, mem(normal)](pop3.heap);
                                case pop4.ok of {
                                    0 -> 10;
                                    _: int64 -> case pop4.priority == 7 of {
                                        true -> case pop4.value == 70 of {
                                            true -> 0;
                                            false -> 12
                                        };
                                        false -> 11
                                    }
                                }
                            };
                            err3: int64 -> err3
                        }
                    };
                    err2: int64 -> err2
                }
            };
            err1: int64 -> err1
        }
    produces
        pure result
    end
}
