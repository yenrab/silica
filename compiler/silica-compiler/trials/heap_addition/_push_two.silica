use heap_binary_min;
fn main() -> int64 {
    sequence proc[mem(normal)]        h0: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) } <- heap_binary_min@empty[int64, mem(normal)]();
        r1: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <- heap_binary_min@push[int64, mem(normal)](h0, 5);
        r2: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8) }, ok: int64 } <- heap_binary_min@push[int64, mem(normal)](r1.heap, 3);
        result: int64 <- r1.ok + r2.ok
    produces
        pure result
    end
}
