// Phase 7 step 7.1-7.2 — empty NodeIDBTreeMap[int64, int64, mem(normal)] construction and query.
use btree_nodeid;

fn main() -> int64 {
    sequence proc[mem(normal)]
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_nodeid@empty[int64, int64, mem(normal)]();
        validation: { ok: int64, error_code: int64 } <- btree_nodeid@validate[int64, int64, mem(normal)](tree);
        absent_contains: int64 <- btree_nodeid@contains[int64, int64, mem(normal)](tree, 42);
        absent_get: { found: int64, value: int64 } <- btree_nodeid@get[int64, int64, mem(normal)](tree, 42);
        root_empty: int64 <- case tree.root_id of {
            -1 -> 1;
            _: int64 -> 0
        };
        node_count_empty: int64 <- case tree.node_count of {
            0 -> 1;
            _: int64 -> 0
        };
        order_ok: int64 <- case tree.order == 8 of {
            true -> 1;
            false -> 0
        };
        error_zero: int64 <- case validation.error_code of {
            0 -> 1;
            _: int64 -> 0
        };
        get_not_found: int64 <- case absent_get.found of {
            0 -> 1;
            _: int64 -> 0
        };
        failures: int64 <-
            (1 - root_empty) +
            ((1 - node_count_empty) * 2) +
            ((1 - order_ok) * 4) +
            (absent_contains * 8) +
            ((1 - validation.ok) * 16) +
            ((1 - error_zero) * 32) +
            ((1 - get_not_found) * 64)
    produces
        pure failures
    end
}
