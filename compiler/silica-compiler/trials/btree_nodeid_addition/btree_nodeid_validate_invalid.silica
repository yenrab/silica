// Phase 7 step 7.2 — invalid NodeIDBTreeMap[int64, int64, mem(normal)] validation case.
// Tests that a node with unsorted keys is rejected (error_code 5 = keys not sorted unique).
use btree_nodeid;

fn main() -> int64 {
    sequence proc[mem(normal)]
        empty_i64: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        key1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](1, empty_i64);
        unsorted_keys: List[int64, mem(normal)] <- prepend[int64, mem(normal)](2, key1);
        val1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](10, empty_i64);
        unsorted_vals: List[int64, mem(normal)] <- prepend[int64, mem(normal)](20, val1);
        root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: 0,
            key_count: 2,
            is_leaf: 1,
            keys: unsorted_keys,
            values: unsorted_vals,
            children: empty_i64
        };
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)](root, empty_nodes);
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: 0,
            node_count: 1,
            order: 8,
            nodes: nodes
        };
        validation: { ok: int64, error_code: int64 } <- btree_nodeid@validate[int64, int64, mem(normal)](tree);
        code_ok: int64 <- case validation.error_code == 5 of {
            true -> 1;
            false -> 0
        };
        failures: int64 <- (validation.ok * 1) + ((1 - code_ok) * 2)
    produces
        pure failures
    end
}
