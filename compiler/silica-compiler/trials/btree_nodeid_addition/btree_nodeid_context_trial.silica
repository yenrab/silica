// Phase 0.4 — context-resolved btree_nodeid calls (no call-site brackets on empty/insert).
use btree_nodeid;

fn main() -> int64 {
    sequence proc[mem(normal)]
        tree0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_nodeid@empty();
        r1: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- btree_nodeid@insert(tree0, 10, 100);
        get10: { found: int64, value: int64 } <- btree_nodeid@get(r1.tree, 10);
        failures: int64 <-
            (1 - r1.inserted) +
            ((1 - get10.found) * 2)
    produces
        pure failures
    end
}
