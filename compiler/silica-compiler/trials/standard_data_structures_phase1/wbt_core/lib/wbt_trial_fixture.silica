    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        scratch: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <-
            alloc_rec(r, (0, 0, 0, :none, :none));
        scratch_payload: (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(scratch);
        witness: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- {
            root: :none,
            compare_key: cmp,
            compare_value: cmp,
            region: r,
            specialization_key: 0,
            compare_key_ordering_bundle: 0,
            compare_value_ordering_bundle: 0
        };
        out: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- {
            root: wbt_map@smart_node(
                witness,
                50,
                5000,
                wbt_map@smart_node(witness, 10, 1000, witness.root, witness.root),
                wbt_map@smart_node(witness, 90, 9000, witness.root, witness.root)
            ),
            compare_key: cmp,
            compare_value: cmp,
            region: r,
            specialization_key: 0,
            compare_key_ordering_bundle: 0,
            compare_value_ordering_bundle: 0
        }
    produces
        pure out
    end
}
