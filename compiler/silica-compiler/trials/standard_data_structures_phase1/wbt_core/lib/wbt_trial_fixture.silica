// Trial-only §8A.2–§8A.3 fixtures (int64): malformed roots via alloc_rec; production nodes via smart_node.

use wbt_set;
use wbt_map;

export build_set_i64/2;
export build_map_i64/2;
export build_set_singleton_i64/3;
export build_map_singleton_i64/4;
export build_set_cached_size_i64/4;
export build_map_cached_size_i64/5;
export build_set_smart_leaf_i64/3;
export build_map_smart_leaf_i64/4;
export build_set_smart_left_heavy_i64/2;
export build_set_smart_balanced3_i64/2;
export build_map_smart_left_heavy_i64/2;
export build_map_smart_balanced3_i64/2;
export build_set_smart_top_i64/5;
export build_map_smart_top_i64/6;

fn build_set_i64(
    cmp: fn(int64, int64) -> :less | :equal | :greater,
    r: region(L, normal)
) -> {
    root: ref?(L, normal, rec),
    compare_item: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_item_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        n10: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (10, 1, :none, :none));
        n40: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (40, 1, :none, :none));
        n60: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (60, 1, :none, :none));
        n90: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (90, 1, :none, :none));
        n25: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (25, 3, n10, n40));
        n75: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (75, 3, n60, n90));
        root: ref(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (50, 7, n25, n75));
        out: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- {
            root: root,
            compare_item: cmp,
            region: r,
            specialization_key: 0,
            compare_item_ordering_bundle: 0
        }
    produces
        pure out
    end
}

fn build_map_i64(
    cmp: fn(int64, int64) -> :less | :equal | :greater,
    r: region(L, normal)
) -> {
    root: ref?(L, normal, rec),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L, normal),
    specialization_key: int64,
    compare_key_ordering_bundle: int64,
    compare_value_ordering_bundle: int64
} {
    sequence proc[mem(normal)]
        n10: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (10, 100, 1, :none, :none));
        n40: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (40, 400, 1, :none, :none));
        n60: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (60, 600, 1, :none, :none));
        n90: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (90, 900, 1, :none, :none));
        n25: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (25, 250, 3, n10, n40));
        n75: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (75, 750, 3, n60, n90));
        root: ref(L, normal, (int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(r, (50, 500, 7, n25, n75));
        out: {
            root: ref?(L, normal, rec),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_key_ordering_bundle: int64,
            compare_value_ordering_bundle: int64
        } <- {
            root: root,
            compare_key: cmp,
            compare_value: cmp,
            region: r,
            specialization_key: 0,
            compare_key_ordering_bundle: 0,
            compare_value_ordering_bundle: 0
        }
    produces
        pure out
    end
}

