// Layer 2 §8A.5: insert matrix covers a second payload shape (string singleton) and
// distinct specialization from int64. Multi-node string/tuple insert is deferred while
// non-scalar compare-on-descent remains unreliable in the current runtime.

use wbt_set;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence
        int_empty: {
            root: ref?(L, normal, rec),
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_i64 });
        str_empty: {
            root: ref?(L, normal, rec),
            compare_item: fn(string, string) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- wbt_set@empty({ compare_item: cmp_str });
        i1: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(int64, int64) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(int_empty, 7);
        s1: {
            set: {
                root: ref?(L, normal, rec),
                compare_item: fn(string, string) -> :less | :equal | :greater,
                region: region(L, normal),
                specialization_key: int64,
                compare_item_ordering_bundle: int64
            },
            inserted: boolean
        } <- wbt_set@insert(str_empty, "x");
        i_sz: int64 <- wbt_set@size(i1.set);
        s_sz: int64 <- wbt_set@size(s1.set);
        i_has: boolean <- wbt_set@contains(i1.set, 7);
        s_has: boolean <- wbt_set@contains(s1.set, "x");
        keys_distinct: boolean <- case i1.set.specialization_key != s1.set.specialization_key of {
            true -> true;
            false -> false
        }
    produces
        pure case i1.inserted of {
            false -> 1;
            true -> case s1.inserted of {
                false -> 2;
                true -> case i_sz == 1 of {
                    false -> 3;
                    true -> case s_sz == 1 of {
                        false -> 4;
                        true -> case i_has of {
                            false -> 5;
                            true -> case s_has of {
                                false -> 6;
                                true -> case keys_distinct of {
                                    false -> 7;
                                    true -> 0
                                }
                            }
                        }
                    }
                }
            }
        }
    end
}
