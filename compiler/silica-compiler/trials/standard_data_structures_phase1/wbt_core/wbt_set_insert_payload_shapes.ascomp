    CMP X22, X24
    B.EQ Lcmp_eq
    B.LO Lcmp_lt
    B Lcmp_gt
Lcmp_anull:
    CBZ X20, Lcmp_eq
Lcmp_lt:
    MOV W0, #-1
    B Lcmp_exit
Lcmp_gt:
    MOV W0, #1
    B Lcmp_exit
Lcmp_eq:
    MOV W0, #0
Lcmp_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

