// Layer 1 §7.9: merged constructor records carry materialized ordering-identity bundles.

use StubWbtSet;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        warm: region(L, normal) <- canonical_arena_lookup(1);
        s1: {
            stored_root: int64,
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- StubWbtSet@empty({ compare_item: cmp_i64 });
        s2: {
            stored_root: int64,
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L, normal),
            specialization_key: int64,
            compare_item_ordering_bundle: int64
        } <- StubWbtSet@empty({ compare_item: cmp_i64 });
        direct: int64 <- ordering_identity_materialize(cmp_i64);
        direct_bundle: int64 <- ordering_identity_bundle_make(direct, :min);
        same_bundle: boolean <- ordering_identity_same(s1.compare_item_ordering_bundle, s2.compare_item_ordering_bundle);
        matches_direct: boolean <- ordering_identity_same(s1.compare_item_ordering_bundle, direct_bundle);
        exit_code: int64 <- case same_bundle of {
            false -> 1;
            true -> case matches_direct of {
                true -> 0;
                false -> 2
            }
        }
    produces
        pure exit_code
    end
}
