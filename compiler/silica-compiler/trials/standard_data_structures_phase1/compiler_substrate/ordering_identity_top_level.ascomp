    MOV X0, #0
    B L_case_o139_done
L_case_o139_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    ADRP X1, ordering_identity_top_level_cmp_int64@PAGE
    ADD X1, X1, ordering_identity_top_level_cmp_int64@PAGEOFF
    MOV X2, #0

    MOV X0, X1
    MOV X1, X2
    BL _silica_rt_ordering_identity_make
    MOV X0, X0
    MOV X19, X0
    ADRP X1, ordering_identity_top_level_cmp_int64@PAGE
    ADD X1, X1, ordering_identity_top_level_cmp_int64@PAGEOFF
    MOV X2, #0

    MOV X0, X1
    MOV X1, X2
    BL _silica_rt_ordering_identity_make
    MOV X0, X0
    MOV X20, X0
    MOV X1, X19
    MOV X2, X20

    MOV X0, X1
    MOV X1, X2
    BL _silica_rt_ordering_identity_same
    MOV X0, X0
    MOV X21, X0
    MOV X2, X21
L_case_o533_br_0:
    CMP W2, #1
    B.NE L_case_o533_br_1
    MOV X0, #0
    B L_case_o533_done
L_case_o533_br_1:
    CMP W2, #0
    B.NE L_case_o533_fb
    MOV X0, #1
    B L_case_o533_done
L_case_o533_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o533_done
L_case_o533_done:
    MOV X22, X0
    MOV X0, X22
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #24
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

