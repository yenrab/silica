ordering_identity_top_level_cmp_int64:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    CMP X9, X10
    CSET X2, LT
L_case_o139_br_0:
    CMP W2, #1
    B.NE L_case_o139_br_1
    MOV X0, #21
    B L_case_o139_done
L_case_o139_br_1:
    CMP W2, #0
    B.NE L_case_o139_fb
    MOV X9, X19
    MOV X10, X20


    CMP X9, X10
    CSET X2, GT
L_case_o195_br_0:
    CMP W2, #1
    B.NE L_case_o195_br_1
    MOV X0, #22
    B L_case_o195_done
L_case_o195_br_1:
