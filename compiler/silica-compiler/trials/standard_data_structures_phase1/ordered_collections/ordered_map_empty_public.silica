// §9 Step 1: public OrderedMap[...] <- wbt_map@empty; size zero.

use wbt_map;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn cmp_str(a: string, b: string) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence
        map0: OrderedMap[int64, string, mem(normal)] <- wbt_map@empty({
            compare_key: cmp_i64,
            compare_value: cmp_str
        });
        sz: int64 <- wbt_map@size(map0)
    produces
        pure case sz == 0 of { true -> 0; false -> 1 }
    end
}
