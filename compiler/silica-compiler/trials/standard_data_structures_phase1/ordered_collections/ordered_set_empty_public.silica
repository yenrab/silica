// §10 Step 1: public OrderedSet[...] <- wbt_set@empty; size zero.

use wbt_set;

fn cmp_i64(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of { true -> :less; false -> case a == b of { true -> :equal; false -> :greater } }
}

fn main() -> int64 {
    sequence
        set0: OrderedSet[int64, mem(normal)] <- wbt_set@empty({ compare_item: cmp_i64 });
        sz: int64 <- wbt_set@size(set0)
    produces
        pure case sz == 0 of { true -> 0; false -> 1 }
    end
}
