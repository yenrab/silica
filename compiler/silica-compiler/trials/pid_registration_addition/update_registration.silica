// pid_register trial: inserting the same atom key a second time replaces the stored actor_ref.
// Uses the global PID registry (Option B): no local root; registry initialised by emitter injection.
//
// Expected output:
//   found
//   found

use pid_registry_actor;

fn worker_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        wa: actor_ref <- spawn(0, worker_beh);
        wb: actor_ref <- spawn(0, worker_beh);
        dummy: actor_ref <- spawn(0, worker_beh);
        reg: actor_ref <- pid_registry_actor@get_pid_registry();
        _: (atom, actor_ref) <- call(reg,
            { op: :insert, name: :counter, pid: wa } impl ActorMessage {});
        _: (atom, actor_ref) <- call(reg,
            { op: :insert, name: :counter, pid: wb } impl ActorMessage {});
        (r1: atom, _pid1: actor_ref) <- call(reg,
            { op: :lookup, name: :counter, pid: dummy } impl ActorMessage {});
        _: atom <- print_atom(r1);
        println("");
        _: (atom, actor_ref) <- call(reg,
            { op: :insert, name: :logger, pid: wa } impl ActorMessage {});
        _: (atom, actor_ref) <- call(reg,
            { op: :insert, name: :logger, pid: wb } impl ActorMessage {});
        (r2: atom, _pid2: actor_ref) <- call(reg,
            { op: :lookup, name: :logger, pid: dummy } impl ActorMessage {});
        _: atom <- print_atom(r2);
        println("");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
