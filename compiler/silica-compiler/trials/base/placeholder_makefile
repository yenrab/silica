# Empty trial suite — no .silica sources yet; integrate exits success (0 0 counts).
# Include from a trial Makefile after setting PLACEHOLDER_THIS_DIR to that directory.

PLACEHOLDER_THIS_DIR ?= $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
THIS_DIR := $(PLACEHOLDER_THIS_DIR)
TRIAL_DIR := $(notdir $(patsubst %/,%,$(PLACEHOLDER_THIS_DIR)))
MSG_PREFIX := $(TRIAL_DIR)/

.DEFAULT_GOAL := integrate
.PHONY: all integrate clean help silica.config

silica.config:
	@cd "$(THIS_DIR)" && : > silica.config

all: integrate

integrate: silica.config
	@echo "SKIP: $(MSG_PREFIX)placeholder (no .silica sources)"
	@printf '0 0\n' > "$(THIS_DIR).integrate_counts"

clean:
	@cd "$(THIS_DIR)" && rm -f silica.config .integrate_counts *.sams *.o
	@echo "✅ $(MSG_PREFIX)Clean complete"

help:
	@echo "$(TRIAL_DIR): placeholder trial directory (Phase 0 layout; sources added in later phases)"
