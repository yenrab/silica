.text
.global main


main.inner_sum:     STP X29, X30, [SP, #-16]!


    MOV X11, X0
    LDR X1, [X11, #0]
    MOV X11, X0
    LDR X2, [X11, #8]
    MOV X3, X1
    LDR X4, [X3, #0]
    LDR X5, [X3, #8]
    MOV X9, X4
    MOV X10, X5
    ADD X9, X9, X10
    MOV X10, X2
    ADD X0, X9, X10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV X1, #1
    STR X1, [SP, #0]
    MOV X1, #2
    STR X1, [SP, #8]
    MOV X1, SP
    STR X1, [SP, #16]
    MOV X1, #3
    STR X1, [SP, #24]
    ADD X0, SP, #16
    ADRP X8, main.inner_sum@PAGE
    ADD X8, X8, main.inner_sum@PAGEOFF
    BLR X8
    ADD SP, SP, #32
    LDP X29, X30, [SP], #16
    RET
