.text
.global main


inner_sum:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    MOV X11, X0

    MOV X0, X11
    MOV X19, X0
    LDR X0, [X19, #0]
    MOV X20, X0
    LDR X1, [X19, #8]
    MOV X21, X1
    MOV X2, X20
    MOV X22, X2
    LDR X0, [X22, #0]
    MOV X23, X0
    LDR X1, [X22, #8]
    MOV X24, X1
    MOV X9, X23
    MOV X10, X1
    ADD X9, X9, X10
    MOV X10, X21
    ADD X0, X9, X10
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    SUB SP, SP, #16
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #2
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #16]
    MOV X9, #3
    STR X9, [SP, #24]
    ADD X0, SP, #16
    ; unsupported term kind ?
    ADRP X9, inner_sum@PAGE
    ADD X9, X9, inner_sum@PAGEOFF
    BLR X9
    ADD SP, SP, #32
    LDP X29, X30, [SP], #16
    RET
