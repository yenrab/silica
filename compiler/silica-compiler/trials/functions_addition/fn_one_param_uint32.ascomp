.text
.global main


inc_u32:     STP X29, X30, [SP, #-16]!

    MOV W9, W0
    MOV W10, #1


    ADD W0, W9, W10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    ADRP X9, L_i64_0@PAGE
    LDR W0, [X9, L_i64_0@PAGEOFF]

    ; unsupported term kind ?
    ADRP X9, inc_u32@PAGE
    ADD X9, X9, inc_u32@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 100000

