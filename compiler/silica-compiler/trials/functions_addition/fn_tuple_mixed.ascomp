.text
.global main


main.first_of_pair:     STP X29, X30, [SP, #-16]!

    MOV X1, X0
    LDR W2, [X1, #0]
    LDR D0, [X1, #8]
    MOV W0, W2
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    MOV X1, #42
    STR X1, [SP, #0]
    ADRP X0, L_f64_0@PAGE
    LDR D1, [X0, L_f64_0@PAGEOFF]
    STR D1, [SP, #8]
    MOV X0, SP
    ADRP X8, main.first_of_pair@PAGE
    ADD X8, X8, main.first_of_pair@PAGEOFF
    BLR X8
    ADD SP, SP, #16
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 3.14

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 3.14

