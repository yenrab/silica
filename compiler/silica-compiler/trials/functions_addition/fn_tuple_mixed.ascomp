.text
.global main


main.first_of_pair:     STP X29, X30, [SP, #-16]!
    MOV X11, X0

    MOV X1, X11
    MOV X19, X1
    LDR W0, [X19, #0]
    LDR D0, [X19, #8]

    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    MOV W9, #42
    STR W9, [SP, #0]
    ADRP X10, L_f64_0@PAGE
    LDR D9, [X10, L_f64_0@PAGEOFF]
    STR D9, [SP, #8]
    MOV X0, SP
    ; unsupported term kind ?
    ADRP X9, main.first_of_pair@PAGE
    ADD X9, X9, main.first_of_pair@PAGEOFF
    BLR X9
    ADD SP, SP, #16
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 3.14

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 3.14

