.text
.global main


add:     STP X29, X30, [SP, #-16]!

    MOV W9, W0
    MOV W10, W1


    ADD W0, W9, W10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV W0, #1
    MOV X1, #2

    ; unsupported term kind ?
    ADRP X9, add@PAGE
    ADD X9, X9, add@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
