.text
.global main


main.add_pair:     STP X29, X30, [SP, #-16]!


    MOV X11, X0
    LDR X1, [X11, #0]
    MOV X11, X0
    LDR X2, [X11, #8]
    MOV X9, X1
    MOV X10, X2
    ADD X0, X9, X10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    MOV X1, #10
    STR X1, [SP, #0]
    MOV X1, #20
    STR X1, [SP, #8]
    MOV X0, SP
    ADRP X8, main.add_pair@PAGE
    ADD X8, X8, main.add_pair@PAGEOFF
    BLR X8
    ADD SP, SP, #16
    LDP X29, X30, [SP], #16
    RET
