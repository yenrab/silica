.text
.global main


add_pair:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X11, X0

    MOV X0, X11
    MOV X19, X0
    LDR X0, [X19, #0]
    MOV X20, X0
    LDR X1, [X19, #8]
    MOV X21, X1
    MOV X9, X20
    MOV X10, X1
    ADD X0, X9, X10
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #10
    STR X9, [SP, #0]
    MOV X9, #20
    STR X9, [SP, #8]
    MOV X0, SP
    ; unsupported term kind ?
    ADRP X9, add_pair@PAGE
    ADD X9, X9, add_pair@PAGEOFF
    BLR X9
    ADD SP, SP, #16
    LDP X29, X30, [SP], #16
    RET
