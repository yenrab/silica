.text
.global main


bundle:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X9, X0
    STR X9, [X8, #0]
    FMOV S9, S0
    ADD X10, X8, #16
    STR X10, [X8, #8]
    STR S9, [X8, #16]
    MOV X9, X1
    STR X9, [X8, #24]
    MOV X0, X8
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #32
    MOV X8, SP
    MOV X0, #7
    ADRP X9, L_f32_0@PAGE
    LDR S0, [X9, L_f32_0@PAGEOFF]
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF

    ; effects []|sir_rec:o193|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, bundle@PAGE
    ADD X9, X9, bundle@PAGEOFF
    BLR X9
    MOV X19, X0
    LDR X0, [X19, #0]
    MOV X20, X0
    LDR X11, [X19, #8]
    LDR S0, [X11, #0]
    LDR X0, [X19, #24]
    MOV X21, X0
    MOV X0, X20
    ; effects [device_io]
    BL L_pi_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    BL L_pf32_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, X21
    ; effects [device_io]
    BL L_ps_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #0
    ADD SP, SP, #32

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pi_helper:
    SUB SP, SP, #32
    MOV X10, SP
    ADD X10, X10, #24
    MOV X11, #0
    CMP X0, #0
    B.ge L_pi_pos
    MOV X11, #1
    NEG X0, X0
L_pi_pos:
    MOV X8, X10
    CMP X0, #0
    B.eq L_pi_zero
    MOV X9, #10
L_pi_loop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pi_loop
    B L_pi_maybe_neg
L_pi_zero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pi_maybe_neg:
    CBNZ X11, L_pi_prepend_minus
    B L_pi_do_write
L_pi_prepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pi_do_write:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    MOV X16, #4
    SVC #0x80
    ADD SP, SP, #32
    RET
L_pf32_helper:
    SUB SP, SP, #64
    STR S0, [SP, #0]
    FCMP S0, #0.0
    B.ge L_pf32_pos
    MOV X0, #1
    ADRP X1, L_pf32_minus@PAGE
    ADD X1, X1, L_pf32_minus@PAGEOFF
    MOV X2, #1
    MOV X16, #4
    SVC #0x80
    LDR S0, [SP, #0]
    FNEG S0, S0
    STR S0, [SP, #0]
L_pf32_pos:
    FCVTZS W0, S0
    MOV X10, SP
    ADD X10, X10, #48
    MOV X11, #0
    CMP X0, #0
    B.ge L_pf32_ipos
    MOV X11, #1
    NEG X0, X0
L_pf32_ipos:
    MOV X8, X10
    CMP X0, #0
    B.eq L_pf32_izero
    MOV X9, #10
L_pf32_iloop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pf32_iloop
    B L_pf32_imaybe_neg
L_pf32_izero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pf32_imaybe_neg:
    CBNZ X11, L_pf32_iprepend_minus
    B L_pf32_ido_int
L_pf32_iprepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pf32_ido_int:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    MOV X16, #4
    SVC #0x80
    LDR S0, [SP, #0]
    FRINTZ S1, S0
    FSUB S2, S0, S1
    ADRP X8, L_pf32_10@PAGE
    LDR S3, [X8, L_pf32_10@PAGEOFF]
    MOV X12, #7
    MOV X9, X10
    SUB X9, X9, #7
    MOV X8, X9
L_pf32_frac_loop:
    CBZ X12, L_pf32_frac_done
    FMUL S2, S2, S3
    FCVTZS W0, S2
    ADD X2, X0, #48
    STRB W2, [X8]
    ADD X8, X8, #1
    SCVTF S4, W0
    FSUB S2, S2, S4
    SUB X12, X12, #1
    FCMP S2, #0.0
    B.eq L_pf32_frac_done
    B L_pf32_frac_loop
L_pf32_frac_done:
    SUB X9, X9, #1
    MOV X1, #46
    STRB W1, [X9]
    SUB X2, X8, X9
    MOV X0, #1
    MOV X1, X9
    MOV X16, #4
    SVC #0x80
    ADD SP, SP, #64
    RET
L_ps_helper:
    MOV X9, X0
    MOV X2, #0
L_ps_loop:
    LDRB W1, [X0]
    CBZ W1, L_ps_do_write
    ADD X2, X2, #1
    ADD X0, X0, #1
    B L_ps_loop
L_ps_do_write:
    MOV X0, #1
    MOV X1, X9
    MOV X16, #4
    SVC #0x80
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0

.section __TEXT,__rodata
.align	4
L_pf32_10:
    .single 10.0
L_pf32_minus:
    .byte 0x2d, 0

.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.5

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 2.5

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "ok"
    .byte 0
L_str_1:
    .ascii ""
    .byte 0
L_str_2:
    .ascii "\n"
    .byte 0

L_newline:
    .byte 10

