.text
.global main


main.double:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X9, X0
    MOV X10, #2


    MUL X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #21
    ; unsupported term kind ?
    ADRP X9, main.double@PAGE
    ADD X9, X9, main.double@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
