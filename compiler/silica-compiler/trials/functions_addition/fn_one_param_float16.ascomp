.text
.global main


main.add_one_f16:     STP X29, X30, [SP, #-16]!

    MOV X9, X0
    MOV X10, #1.0


    ADD X0, X9, X10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #2.5
    ADRP X8, main.add_one_f16@PAGE
    ADD X8, X8, main.add_one_f16@PAGEOFF
    BLR X8
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 1.0

L_f64_1:
    .double 2.5

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 1.0

L_f32_1:
    .single 2.5

