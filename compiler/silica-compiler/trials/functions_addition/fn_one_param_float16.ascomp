.text
.global main


add_one_f16:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f32_0@PAGE
    LDR S2, [X0, L_f32_0@PAGEOFF]
    FCVT H2, S2

    FMOV H1, H0


    FADD H0, H1, H2
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    BL _silica_pid_registry_init
    ADRP X0, L_f32_1@PAGE
    LDR S0, [X0, L_f32_1@PAGEOFF]
    FCVT H0, S0

    ADRP X9, add_one_f16@PAGE
    ADD X9, X9, add_one_f16@PAGEOFF
    BLR X9
    FCVTZS W0, H0
    LDP X29, X30, [SP], #16
    RET
