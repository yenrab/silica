.text
.global main


main.id_string:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    MOV X0, X19
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    ; effects []|sir_rec:o70|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.id_string@PAGE
    ADD X9, X9, main.id_string@PAGEOFF
    BLR X9
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hello"
    .byte 0

