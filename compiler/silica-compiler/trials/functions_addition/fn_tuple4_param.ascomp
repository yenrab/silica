.text
.global main


sum_quad:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    MOV X11, X0

    MOV X0, X11
    MOV X19, X0
    MOV X12, X19
    LDR X0, [X19, #0]
    MOV X20, X0
    LDR X1, [X12, #8]
    MOV X21, X1
    LDR X2, [X12, #16]
    MOV X22, X2
    LDR X3, [X12, #24]
    MOV X23, X3
    MOV X9, X20
    MOV X10, X21
    ADD X9, X9, X10
    MOV X10, X22
    ADD X9, X9, X10
    MOV X10, X3
    ADD X0, X9, X10
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #32
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #2
    STR X9, [SP, #8]
    MOV X9, #3
    STR X9, [SP, #16]
    MOV X9, #4
    STR X9, [SP, #24]
    MOV X0, SP
    ; unsupported term kind ?
    ADRP X9, sum_quad@PAGE
    ADD X9, X9, sum_quad@PAGEOFF
    BLR X9
    ADD SP, SP, #32
    LDP X29, X30, [SP], #16
    RET
