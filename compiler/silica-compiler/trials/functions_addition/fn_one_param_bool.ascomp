.text
.global main


main.id_bool:     STP X29, X30, [SP, #-16]!


    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #1
    ; unsupported term kind ?
    ADRP X9, main.id_bool@PAGE
    ADD X9, X9, main.id_bool@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
