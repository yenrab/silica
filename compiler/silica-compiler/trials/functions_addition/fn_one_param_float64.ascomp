.text
.global main


add_one_f64:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f64_0@PAGE
    LDR D2, [X0, L_f64_0@PAGEOFF]
    FMOV D1, D0


    FADD D0, D1, D2
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f64_1@PAGE
    LDR D0, [X0, L_f64_1@PAGEOFF]
    ADRP X9, add_one_f64@PAGE
    ADD X9, X9, add_one_f64@PAGEOFF
    BLR X9
    FCVTZS W0, D0
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 1.0

L_f64_1:
    .double 2.718

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 1.0

L_f32_1:
    .single 2.718

