.text
.global main


inc_u64:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X9, X0
    MOV X10, #1


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_i64_0@PAGE
    LDR X0, [X0, L_i64_0@PAGEOFF]
    ; unsupported term kind ?
    ADRP X9, inc_u64@PAGE
    ADD X9, X9, inc_u64@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 1000000

