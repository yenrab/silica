.text
.global main


main.sum6:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X10, X5
    STR X10, [SP, #-16]!
    MOV X10, X4
    STR X10, [SP, #-16]!
    MOV X10, X3
    STR X10, [SP, #-16]!
    MOV X10, X2
    STR X10, [SP, #-16]!
    MOV X9, X19
    MOV X10, X20


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #1
    MOV X1, #2
    MOV X2, #3
    MOV X3, #4
    MOV X4, #5
    MOV X5, #6

    ; unsupported term kind ?
    ADRP X9, main.sum6@PAGE
    ADD X9, X9, main.sum6@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
