.bss
.balign 8
.lcomm _silica_frame_depth, 8
.lcomm _silica_frame_max, 8
.lcomm _silica_fuel, 8
.lcomm _silica_saved_pc, 8

.text
.global main

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



first_of_pair_with_fn:     STP X29, X30, [SP, #-16]!

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X17, X1

    MOV X1, X0

    ; effects []|sir_rec:o201|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    BR X17


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X1, #21
    MOV X19, X1
    MOV X0, #42
    ADRP X1, fn_param_binary_fn_type_capture.__lw0@PAGE
    ADD X1, X1, fn_param_binary_fn_type_capture.__lw0@PAGEOFF

    ; effects []|sir_rec:o262|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, first_of_pair_with_fn@PAGE
    ADD X9, X9, first_of_pair_with_fn@PAGEOFF
    BLR X9
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

fn_param_binary_fn_type_capture.__lam0:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X10, X2
    STR X10, [SP, #-16]!
    MOV X9, X20
    MOV X10, X19


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

fn_param_binary_fn_type_capture.__lw0:     STP X29, X30, [SP, #-16]!

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X0, X1
    MOV X1, X0
    MOV X2, #21

    ; effects []|sir_rec:o262|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, fn_param_binary_fn_type_capture.__lam0@PAGE
    ADD X9, X9, fn_param_binary_fn_type_capture.__lam0@PAGEOFF
    BR X9

