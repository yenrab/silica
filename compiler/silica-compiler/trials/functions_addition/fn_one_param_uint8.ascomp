.text
.global main


main.inc_u8:     STP X29, X30, [SP, #-16]!

    MOV W9, W0
    MOV W10, #1


    ADD W0, W9, W10
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV W0, #100
    ; unsupported term kind ?
    ADRP X9, main.inc_u8@PAGE
    ADD X9, X9, main.inc_u8@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
