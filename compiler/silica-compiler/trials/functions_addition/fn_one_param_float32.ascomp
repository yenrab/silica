.text
.global main


add_one_f32:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f32_0@PAGE
    LDR S2, [X0, L_f32_0@PAGEOFF]
    FMOV S1, S0


    FADD S0, S1, S2
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f32_1@PAGE
    LDR S0, [X0, L_f32_1@PAGEOFF]
    ADRP X9, add_one_f32@PAGE
    ADD X9, X9, add_one_f32@PAGEOFF
    BLR X9
    FCVTZS W0, S0
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 1.0

L_f64_1:
    .double 3.14

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 1.0

L_f32_1:
    .single 3.14

