.text
.global main


main.id_atom:     STP X29, X30, [SP, #-16]!


    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #0
    ADRP X8, main.id_atom@PAGE
    ADD X8, X8, main.id_atom@PAGEOFF
    BLR X8
    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
