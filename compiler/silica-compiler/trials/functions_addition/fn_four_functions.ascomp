.text
.global main


main.add:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.sub:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    SUB X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.mul:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    MUL X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.div:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    SDIV X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X0, #20
    MOV X1, #5

    ; effects []|sir_rec:o266|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.div@PAGE
    ADD X9, X9, main.div@PAGEOFF
    BLR X9
    MOV X10, X0
    STR X10, [SP, #-16]!
    MOV X0, #2
    MOV X1, #4

    ; effects []|sir_rec:o254|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.mul@PAGE
    ADD X9, X9, main.mul@PAGEOFF
    BLR X9
    MOV X10, X0
    STR X10, [SP, #-16]!
    STR X0, [SP, #-16]!
    MOV X0, #10
    MOV X1, #3

    ; effects []|sir_rec:o241|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.sub@PAGE
    ADD X9, X9, main.sub@PAGEOFF
    BLR X9
    MOV X10, X0
    LDR X0, [SP], #16

    STR X10, [SP, #-16]!

    MOV X0, #1
    MOV X1, #2

    ; effects []|sir_rec:o229|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.add@PAGE
    ADD X9, X9, main.add@PAGEOFF
    BLR X9
    MOV X9, X0
    LDR X10, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
