.text
.global main


main.nullary:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X0, #42
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    ; unsupported term kind (dummy k)?
    ; unsupported term kind ?
    ADRP X9, main.nullary@PAGE
    ADD X9, X9, main.nullary@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
