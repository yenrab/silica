module dangerous_legacy_math_add_twice;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_legacy_math_add_int64"
fn add_raw(left: int64, right: int64) -> int64;

fn add(left: int64, right: int64) -> int64 {
    add_raw(left, right)
}

fn result_sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        print_int64(msg);
        println("");
        next_state: int64 <- case state of {
            0 -> 1;
            1 -> {
                println("done");
                2
            };
            _: int64 -> state;
        }
    produces
        pure (:no_reply, next_state)
    end
}

fn ffi_worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        sum1: int64 <- add_raw(40, msg);
        sum2: int64 <- add_raw(10, 5);
        _: boolean <- cast(reply_to, sum1 impl ActorMessage {});
        _: boolean <- cast(reply_to, sum2 impl ActorMessage {})
    produces
        pure (:no_reply, reply_to)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sink_ref: actor_ref <- spawn(0, result_sink);
        worker_ref: actor_ref <- spawn(sink_ref, ffi_worker);
        _: boolean <- cast(worker_ref, 2 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
