// Supervisor + guarded FFI fault trial (cast_registered variant):
// Two statically materialized :dangerous children. Main uses cast_registered on each child id:
// the add worker reports 42 to a registered result sink; the fault worker triggers the guarded FFI fault.
// Integrate compares presorted .scout lines (banner details are covered by other trials).
// Lookup-by-ref casting is covered by dangerous_supervisor_guarded_restart.

module dangerous_supervisor_guarded_cast_registered;

use Supervisor;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_supervisor_trial_guarded_fault"
fn fault_raw() -> int64;

impl DangerousSupervisorGuardedCastRegisteredSup for Supervisor;

fn result_sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        print_int64(msg);
        println("");
        println("done")
    produces
        pure (:no_reply, state)
    end
}

fn dangerous_ffi_fault_worker(_msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger]
        _: int64 <- case true of {
            true -> {
                sequence proc[external_danger]
                produces
                    pure fault_raw()
                end
            };
            false -> 0
        }
    produces
        pure (:no_reply, reply_to)
    end
}

fn dangerous_ffi_add_worker(_msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        _: boolean <- cast_registered(:sup_result_sink, 42 impl ActorMessage {})
    produces
        pure (:no_reply, reply_to)
    end
}

fn init(_initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 60 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
        ] <- [
            {
                id: :dangerous_guarded_ffi_fault_worker,
                agent_type: :worker,
                initial_state: 0,
                behavior: dangerous_ffi_fault_worker,
                restart: :permanent,
                shutdown: 0,
                flavor: :dangerous
            },
            {
                id: :dangerous_guarded_ffi_add_worker,
                agent_type: :worker,
                initial_state: 0,
                behavior: dangerous_ffi_add_worker,
                restart: :permanent,
                shutdown: 0,
                flavor: :dangerous
            }
        ]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: actor_ref <- spawn_registered(0, result_sink, :sup_result_sink);
        _: supervisor_ref <- spawn_registered_supervisor(
            DangerousSupervisorGuardedCastRegisteredSup,
            0,
            :dangerous_sup_guarded_cast_registered
        );

        _: boolean <- cast_dangerous_registered(:dangerous_guarded_ffi_add_worker, 0 impl ActorMessage {});
        _: boolean <- cast_dangerous_registered(:dangerous_guarded_ffi_fault_worker, 0 impl ActorMessage {});

        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
