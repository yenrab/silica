link_library: "silica_text"

wrapper silica_text_echo {
    symbol: "silica_text_echo"
    result: "struct"
    error_domain: "dangerous_text"
    arguments: [
        { name: "text_ptr", lifetime: "borrowed", retain: false },
        { name: "text_len", role: "length", length_of: "text_ptr" }
    ]
}
