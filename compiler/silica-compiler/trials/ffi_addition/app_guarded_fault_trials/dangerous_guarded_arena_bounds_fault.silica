module dangerous_guarded_arena_bounds_fault;

wrapper_meta "dangerous_exposure_source/legacy/silica_legacy_math_wrapper.meta";

foreign c_wrapper "silica_ffi_arena_past_end"
fn arena_past_end_raw() -> int64;

fn fault_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[]
        _: int64 <- arena_past_end_raw()
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        worker_ref: actor_ref <- spawn(0, fault_worker);
        _: boolean <- cast(worker_ref, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
