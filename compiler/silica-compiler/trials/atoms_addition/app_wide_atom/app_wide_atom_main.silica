// Single entry TU. lib/app_wide_atom_lib.silica is linked into this executable via the Makefile (modules_addition style).
// silica.config batch merges atom tables across these TUs — one application image, same interned literals everywhere.
//
// `:app_wide_atom_twice_demo` is bound twice below: one lexical atom, multiple uses within the same app.
use app_wide_atom_lib;

fn main() -> atom {
    sequence proc[device_io]
        a: atom <- :app_wide_atom_in_main;
        _: int64 <- print_atom(a);
        b: atom <- app_wide_atom_lib@beta_marker();
        _: int64 <- print_atom(b);
        dup1: atom <- :app_wide_atom_twice_demo;
        _: int64 <- print_atom(dup1);
        dup2: atom <- :app_wide_atom_twice_demo;
        _: int64 <- print_atom(dup2)
        produces pure :ok end
}
