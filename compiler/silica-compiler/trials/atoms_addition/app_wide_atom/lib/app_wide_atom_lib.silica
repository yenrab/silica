// Library TU in the same application as app_wide_atom_main.silica. Atom literals referenced here merge
// into one process-image table for this silica.config batch (this linked executable only; not unrelated apps).
//
// `:app_wide_atom_from_lib` appears only lexically in this file; merged emission still includes every batch literal in each TU’s .sams.
export beta_marker/0;

fn beta_marker() -> atom {
    :app_wide_atom_from_lib
}
