// Trial 04: Nested Inline Structs
//
// Demonstrates:
// - Structs containing other inline struct types
// - Accessing nested fields
// - Creating complex data structures

fn create_rectangle() -> { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } {
    rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- {
        top_left: { x: 0, y: 10 },
        bottom_right: { x: 10, y: 0 }
    };
    rect
}

fn rectangle_area(rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } }) -> int64 {
    tl: { x: int64, y: int64 } <- rect.top_left;
    br: { x: int64, y: int64 } <- rect.bottom_right;

    width: int64 <- br.x - tl.x;
    height: int64 <- tl.y - br.y;

    width * height
}

fn create_person_with_address() -> { name: string, address: { street: string, city: string } } {
    person: { name: string, address: { street: string, city: string } } <- {
        name: "Bob",
        address: { street: "123 Main St", city: "Springfield" }
    };
    person
}

fn main() -> atom {
    rect: { top_left: { x: int64, y: int64 }, bottom_right: { x: int64, y: int64 } } <- create_rectangle();
    area: int64 <- rectangle_area(rect);

    person: { name: string, address: { street: string, city: string } } <- create_person_with_address();
    city: string <- person.address.city;

    :ok
}
