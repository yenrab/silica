// Trial 06: Inline Structs in Sequence Expressions
//
// Demonstrates:
// - Using structs within sequence blocks (with effects)
// - Struct mutation patterns (creating new instances with updated values)
// - Side effects while working with structs

fn update_and_print(p: { x: int64, y: int64 }) -> { x: int64, y: int64 } {
    sequence proc[device_io]
        // Update struct by creating a new instance
        updated: { x: int64, y: int64 } <- { x: p.x + 1, y: p.y + 1 };

        // We could print here if device_io is available
        // print_int(updated.x);

        produces updated
    end
}

fn process_points(points: List[{ x: int64, y: int64 }]) -> List[{ x: int64, y: int64 }] {
    sequence proc[device_io]
        // Process list of structs with effects
        result: List[{ x: int64, y: int64 }] <-
            case points of {
                (:nil) -> empty_list()
                (:cons, head, tail) -> {
                    updated_head: { x: int64, y: int64 } <- { x: head.x * 2, y: head.y * 2 };
                    rest: List[{ x: int64, y: int64 }] <- process_points(tail);
                    cons(updated_head, rest)
                }
            };

        produces result
    end
}

fn main() -> atom {
    sequence proc[device_io]
        // Create and update struct with sequence
        point: { x: int64, y: int64 } <- { x: 1, y: 2 };

        updated: { x: int64, y: int64 } <- update_and_print(point);

        // Create list and process
        empty: List[{ x: int64, y: int64 }] <- empty_list();
        p1: { x: int64, y: int64 } <- { x: 1, y: 1 };
        p2: { x: int64, y: int64 } <- { x: 2, y: 2 };
        list: List[{ x: int64, y: int64 }] <- cons(p1, cons(p2, empty));

        processed: List[{ x: int64, y: int64 }] <- process_points(list);

        produces :ok
    end
}
