.text
.global main


main.calculate_distance:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    LDR X9, [X11, #0]
    STR X9, [SP, #-16]!
    LDR X10, [X11, #0]
    LDR X9, [SP], #16
    MUL X0, X9, X10
    MOV X19, X0
    LDR X9, [X11, #8]
    STR X9, [SP, #-16]!
    LDR X10, [X11, #8]
    LDR X9, [SP], #16

    MUL X0, X9, X10
    MOV X20, X0
    MOV X9, X19
    MOV X10, X20
    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.move_point:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    SUB SP, SP, #16
    MOV X10, X1
    STR X10, [SP, #-16]!
    LDR X9, [X11, #0]
    LDR X10, [SP], #16


    ADD X9, X9, X10
    STR X9, [SP, #0]
    MOV X10, X2
    STR X10, [SP, #-16]!
    LDR X9, [X11, #8]
    LDR X10, [SP], #16


    ADD X9, X9, X10
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.describe_person:     STP X29, X30, [SP, #-16]!
    MOV X11, X0

    LDR X0, [X11, #0]
    MOV X19, X0
    LDR X0, [X11, #8]
    MOV X20, X0
    MOV X0, X19
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #3
    STR X9, [SP, #0]
    MOV X9, #4
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, SP
    ; effects []|sir_rec:o773|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.calculate_distance@PAGE
    ADD X9, X9, main.calculate_distance@PAGEOFF
    BLR X9
    MOV X19, X0
    SUB SP, SP, #16
    MOV X8, SP
    MOV X0, SP
    MOV X1, #5
    MOV X2, #6

    ; effects []|sir_rec:o860|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.move_point@PAGE
    ADD X9, X9, main.move_point@PAGEOFF
    BLR X9
    MOV X20, X0
    SUB SP, SP, #16
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #0]
    MOV X9, #30
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X21, X0
    MOV X0, X21
    ; effects []|sir_rec:o1016|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.describe_person@PAGE
    ADD X9, X9, main.describe_person@PAGEOFF
    BLR X9
    MOV X22, X0
    MOV X0, #0
    ADD SP, SP, #16

    ADD SP, SP, #16

    ADD SP, SP, #16

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "Alice"
    .byte 0

