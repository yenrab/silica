.text
.global main


main.sum_int64_list:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    STP X21, X22, [SP, #-16]!

    MOV X2, X19
L_case_o387_br_0:
    CMP X2, #0
    B.NE L_case_o387_br_1
    MOV X0, X20
    B L_case_o387_done
L_case_o387_br_1:
    CBZ X2, L_case_o387_br_2
    LDR X21, [X2, #8]
    LDR X1, [X2]
    MOV X0, X21
    MOV X9, X20
    MOV X10, X1


    ADD X1, X9, X10

    ; effects []|sir_rec:o503|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.sum_int64_list@PAGE
    ADD X9, X9, main.sum_int64_list@PAGEOFF
    BLR X9
    B L_case_o387_done
L_case_o387_br_2:
    MOV X0, X20
    B L_case_o387_done
L_case_o387_fb:
    MOV X0, #0
    B L_case_o387_done
L_case_o387_done:
    MOV X21, X0
    MOV X0, X21
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.build_row_with_two_lists:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!

    MOV X0, #0
    MOV X19, X0
    MOV X2, X19
    MOV X1, #1

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X20, X0
    MOV X2, X20
    MOV X1, #2

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X21, X0
    MOV X2, X21
    MOV X1, #3

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X22, X0
    MOV X0, #0
    MOV X23, X0
    MOV X2, X23
    MOV X1, #10

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X24, X0
    MOV X2, X24
    MOV X1, #40

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X25, X0
    SUB SP, SP, #32
    MOV X9, #7
    STR X9, [SP, #0]
    MOV X9, X22
    STR X9, [SP, #8]
    MOV X9, X25
    STR X9, [SP, #16]
    MOV X0, SP
    MOV X26, X0
    MOV X0, X26
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #32
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #32

    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.combined_sum:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    LDR X0, [X11, #8]
    MOV X1, #0

    ; effects []|sir_rec:o1770|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.sum_int64_list@PAGE
    ADD X9, X9, main.sum_int64_list@PAGEOFF
    BLR X9
    MOV X19, X0
    LDR X0, [X11, #16]
    MOV X1, #0

    ; effects []|sir_rec:o1818|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.sum_int64_list@PAGE
    ADD X9, X9, main.sum_int64_list@PAGEOFF
    BLR X9
    MOV X20, X0
    MOV X9, X19
    MOV X10, X20
    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #32
    MOV X8, SP
    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o2016|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.build_row_with_two_lists@PAGE
    ADD X9, X9, main.build_row_with_two_lists@PAGEOFF
    BLR X9
    MOV X19, X0
    MOV X0, X19
    ; effects []|sir_rec:o2048|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.combined_sum@PAGE
    ADD X9, X9, main.combined_sum@PAGEOFF
    BLR X9
    ADD SP, SP, #32

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X4, X0
    MOV X3, X2
    MOV X0, #0
L_list_len_loop:
    CBZ X4, L_list_len_done
    ADD X0, X0, #1
    ADD X5, X4, X3
    LDR X4, [X5]
    B L_list_len_loop
L_list_len_done:
    RET

.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

