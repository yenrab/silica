.text
.global main


main.increment_actor:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    LDR X2, [X1, #0]
L_case_o390_br_0:
    STR X2, [SP, #-16]!
    ADRP X3, L_str_0@PAGE
    ADD X3, X3, L_str_0@PAGEOFF
    MOV X0, X2
    MOV X1, X3
    BL L_string_eq_helper
    MOV W12, W0
    LDR X2, [SP], #16
    CMP W12, #0
    B.EQ L_case_o390_br_1
    SUB SP, SP, #16
    LDR X9, [X11, #0]
    STR X9, [SP, #-16]!
    LDR X10, [X1, #8]
    LDR X9, [SP], #16
    ADD X9, X9, X10
    STR X9, [SP, #0]
    LDR X9, [X11, #8]
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16

    B L_case_o390_done
L_case_o390_br_1:
    STR X2, [SP, #-16]!
    ADRP X3, L_str_1@PAGE
    ADD X3, X3, L_str_1@PAGEOFF
    MOV X0, X2
    MOV X1, X3
    BL L_string_eq_helper
    MOV W12, W0
    LDR X2, [SP], #16
    CMP W12, #0
    B.EQ L_case_o390_br_2
    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    LDR X9, [X11, #8]
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16

    B L_case_o390_done
L_case_o390_br_2:
    MOV X0, X11
    B L_case_o390_done
L_case_o390_fb:
    MOV X0, #0
    B L_case_o390_done
L_case_o390_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.respond_to_query:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    SUB SP, SP, #16
    ADRP X9, L_str_2@PAGE
    ADD X9, X9, L_str_2@PAGEOFF
    STR X9, [SP, #0]
    LDR X9, [X11, #0]
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    ADRP X9, L_str_3@PAGE
    ADD X9, X9, L_str_3@PAGEOFF
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    SUB SP, SP, #16
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #0]
    MOV X9, #5
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    SUB SP, SP, #16
    MOV X8, SP
    MOV X0, SP
    MOV X1, X19

    ; effects []|sir_rec:o1352|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.increment_actor@PAGE
    ADD X9, X9, main.increment_actor@PAGEOFF
    BLR X9
    MOV X20, X0
    SUB SP, SP, #16
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #0]
    MOV X9, #3
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X21, X0
    SUB SP, SP, #16
    MOV X8, SP
    MOV X0, X20
    MOV X1, X21

    ; effects []|sir_rec:o1540|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.increment_actor@PAGE
    ADD X9, X9, main.increment_actor@PAGEOFF
    BLR X9
    MOV X22, X0
    SUB SP, SP, #16
    MOV X8, SP
    MOV X0, X22
    ; effects []|sir_rec:o1619|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.respond_to_query@PAGE
    ADD X9, X9, main.respond_to_query@PAGEOFF
    BLR X9
    MOV X23, X0
    MOV X0, #0
    ADD SP, SP, #16

    ADD SP, SP, #16

    ADD SP, SP, #16

    ADD SP, SP, #16

    ADD SP, SP, #16

    ADD SP, SP, #16

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_string_eq_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Leq_anull
    CBZ X20, Leq_neq
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Leq_n1_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Leq_n1_cstr
    LDR X21, [X0, #8]
    LDR X22, [X0, #16]
    MOV X2, #0x40000000
    CMP X22, X2
    B.HS Leq_n1_cstr
    B Leq_n1_done
Leq_n1_cstr:
    MOV X21, X0
    MOV X22, #0
    MOV X1, X0
Leq_n1l:
    LDRB W3, [X1], #1
    CBZ W3, Leq_n1_done
    ADD X22, X22, #1
    CMP X22, #0x100000
    B.LT Leq_n1l
Leq_n1_done:
    MOV X0, X20
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Leq_n2_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Leq_n2_cstr
    LDR X23, [X0, #8]
    LDR X24, [X0, #16]
    MOV X2, #0x40000000
    CMP X24, X2
    B.HS Leq_n2_cstr
    B Leq_n2_done
Leq_n2_cstr:
    MOV X23, X0
    MOV X24, #0
    MOV X1, X0
Leq_n2l:
    LDRB W3, [X1], #1
    CBZ W3, Leq_n2_done
    ADD X24, X24, #1
    CMP X24, #0x100000
    B.LT Leq_n2l
Leq_n2_done:
    CMP X22, X24
    B.NE Leq_neq
    CBZ X22, Leq_yes
    MOV X25, X21
    MOV X26, X23
    MOV X27, X22
Leq_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Leq_neq
    SUBS X27, X27, #1
    B.NE Leq_cloop
Leq_yes:
    MOV W0, #1
    B Leq_exit
Leq_anull:
    CBZ X20, Leq_yes
    B Leq_neq
Leq_neq:
    MOV W0, #0
Leq_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "increment"
    .byte 0
L_str_1:
    .ascii "reset"
    .byte 0
L_str_2:
    .ascii "ok"
    .byte 0
L_str_3:
    .ascii "initial"
    .byte 0

