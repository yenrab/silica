.text
.global main


main.create_point_list:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    MOV X0, #0
    MOV X19, X0
    SUB SP, SP, #16
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #2
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X20, X0
    MOV X2, X19
    MOV X1, X20

    STP X1, X2, [SP, #-16]!
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    LDR X3, [X1, #0]
    STR X3, [X0, #0]
    LDR X3, [X1, #8]
    STR X3, [X0, #8]
    STR X2, [X0, #16]
    MOV X0, X0
    MOV X21, X0
    SUB SP, SP, #16
    MOV X9, #3
    STR X9, [SP, #0]
    MOV X9, #4
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X22, X0
    MOV X2, X21
    MOV X1, X22

    STP X1, X2, [SP, #-16]!
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    LDR X3, [X1, #0]
    STR X3, [X0, #0]
    LDR X3, [X1, #8]
    STR X3, [X0, #8]
    STR X2, [X0, #16]
    MOV X0, X0
    MOV X23, X0
    MOV X2, X23
    SUB SP, SP, #16
    MOV X9, #5
    STR X9, [SP, #0]
    MOV X9, #6
    STR X9, [SP, #8]
    MOV X1, SP

    STP X1, X2, [SP, #-16]!
    MOV X0, #24
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    LDR X3, [X1, #0]
    STR X3, [X0, #0]
    LDR X3, [X1, #8]
    STR X3, [X0, #8]
    STR X2, [X0, #16]
    MOV X0, X0

    ADD SP, SP, #16
    MOV X24, X0
    MOV X0, X24
    ADD SP, SP, #16

    ADD SP, SP, #16

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.sum_all_x_coordinates:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!

    MOV X2, X19
L_case_o1106_br_0:
    CMP X2, #0
    B.NE L_case_o1106_br_1
    MOV X0, #0
    B L_case_o1106_done
L_case_o1106_br_1:
    CBZ X2, L_case_o1106_br_2
    LDR X21, [X2, #16]
    MOV X22, X2
    MOV X0, X21
    MOV X0, X20
    STR X0, [SP, #-16]!
    LDR X10, [X22, #0]
    LDR X9, [SP], #16


    ADD X1, X9, X10

    ; effects []|sir_rec:o1281|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.sum_all_x_coordinates@PAGE
    ADD X9, X9, main.sum_all_x_coordinates@PAGEOFF
    BLR X9
    B L_case_o1106_done
L_case_o1106_br_2:
    MOV X0, #0
    B L_case_o1106_done
L_case_o1106_fb:
    MOV X0, #0
    B L_case_o1106_done
L_case_o1106_done:
    MOV X21, X0
    MOV X0, X21
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o1516|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.create_point_list@PAGE
    ADD X9, X9, main.create_point_list@PAGEOFF
    BLR X9
    MOV X19, X0
    MOV X0, X19
    MOV X1, #0

    ; effects []|sir_rec:o1559|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.sum_all_x_coordinates@PAGE
    ADD X9, X9, main.sum_all_x_coordinates@PAGEOFF
    BLR X9
    MOV X20, X0
    MOV X0, X20
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X4, X0
    MOV X3, X2
    MOV X0, #0
L_list_len_loop:
    CBZ X4, L_list_len_done
    ADD X0, X0, #1
    ADD X5, X4, X3
    LDR X4, [X5]
    B L_list_len_loop
L_list_len_done:
    RET

.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

