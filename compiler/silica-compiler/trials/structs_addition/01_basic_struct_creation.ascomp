.text
.global main


main.create_point:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #10
    STR X9, [SP, #0]
    MOV X9, #20
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.access_fields:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #5
    STR X9, [SP, #0]
    MOV X9, #15
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    LDR X0, [SP, #0]
    MOV X19, X0
    LDR X0, [SP, #8]
    MOV X20, X0
    MOV X9, X19
    MOV X10, X20
    ADD X0, X9, X10
    ADD SP, SP, #16

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #16
    MOV X8, SP
    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o551|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.create_point@PAGE
    ADD X9, X9, main.create_point@PAGEOFF
    BLR X9
    MOV X19, X0
    LDR X0, [X19, #0]
    MOV X20, X0
    LDR X0, [X19, #8]
    MOV X21, X0
    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o637|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.access_fields@PAGE
    ADD X9, X9, main.access_fields@PAGEOFF
    BLR X9
    MOV X22, X0
    MOV X0, #0
    ADD SP, SP, #16

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
