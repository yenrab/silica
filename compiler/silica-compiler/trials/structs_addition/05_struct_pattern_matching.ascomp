process_coordinate:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    MOV X2, X11
L_case_o600_br_0:
    LDR X0, [X2, #0]
    LDR X1, [X2, #8]
    MOV X9, X0
    MOV X10, #0


    CMP X9, X10
    CSET X4, GT
    CBZ X4, L_case_o600_br_1
    MOV X9, X0
    MOV X10, X1


    ADD X0, X9, X10
    B L_case_o600_done
L_case_o600_br_1:
    LDR X0, [X2, #0]
    LDR X1, [X2, #8]
    MOV X9, X1
    MOV X10, #0


    CMP X9, X10
    CSET X4, GT
    CBZ X4, L_case_o600_br_2
    MOV X9, X0
    MOV X10, X1


    ADD X0, X9, X10
    B L_case_o600_done
L_case_o600_br_2:
    LDR X0, [X2, #0]
    LDR X1, [X2, #8]
    MOV X9, X0
    MOV X10, X1


    MUL X0, X9, X10
    B L_case_o600_done
