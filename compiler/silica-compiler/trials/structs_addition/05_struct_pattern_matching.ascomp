main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    BL _silica_pid_registry_init
    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    MOV X9, #0
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    ; effects []|sir_rec:o893|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, check_origin@PAGE
    ADD X9, X9, check_origin@PAGEOFF
    BLR X9
    MOV X20, X0
    SUB SP, SP, #16
    MOV X9, #5
    STR X9, [SP, #0]
    MOV X9, #10
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X21, X0
    MOV X0, X21
