    BLR X9
    MOV X1, X0
    MOV X22, X1
    MOV X0, #2
    ADD SP, SP, #16

    ADD SP, SP, #16

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
