.text
.global main


main.check_origin:     STP X29, X30, [SP, #-16]!
    MOV X11, X0

    MOV X2, X11
L_case_o251_br_0:
    LDR X0, [X2, #0]
    MOV X3, #0
    CMP X0, X3
    B.NE L_case_o251_br_1
    LDR X0, [X2, #8]
    MOV X3, #0
    CMP X0, X3
    B.NE L_case_o251_br_1
    MOV X0, #1
    B L_case_o251_done
L_case_o251_br_1:
    MOV X0, #0
    B L_case_o251_done
L_case_o251_fb:
    MOV X0, #0
    B L_case_o251_done
L_case_o251_done:

    LDP X29, X30, [SP], #16
    RET

main.classify_point:     STP X29, X30, [SP, #-16]!
    MOV X11, X0

    MOV X2, X11
L_case_o382_br_0:
    LDR X0, [X2, #0]
    MOV X3, #0
    CMP X0, X3
    B.NE L_case_o382_br_1
    LDR X0, [X2, #8]
    MOV X3, #0
    CMP X0, X3
    B.NE L_case_o382_br_1
    MOV X0, #0
    B L_case_o382_done
L_case_o382_br_1:
    LDR X0, [X2, #0]
    MOV X3, #0
    CMP X0, X3
    B.NE L_case_o382_br_2
    MOV X0, #1
    B L_case_o382_done
L_case_o382_br_2:
    LDR X0, [X2, #8]
    MOV X3, #0
    CMP X0, X3
    B.NE L_case_o382_br_3
    MOV X0, #2
    B L_case_o382_done
L_case_o382_br_3:
    MOV X0, #3
    B L_case_o382_done
L_case_o382_fb:
    MOV X0, #0
    B L_case_o382_done
L_case_o382_done:

    LDP X29, X30, [SP], #16
    RET

main.process_coordinate:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    MOV X2, X11
L_case_o600_br_0:
    LDR X0, [X2, #0]
    LDR X1, [X2, #8]
    MOV X9, X0
    MOV X10, #0


    CMP X9, X10
    CSET X4, GT
    CBZ X4, L_case_o600_br_1
    MOV X9, X0
    MOV X10, X1


    ADD X0, X9, X10
    B L_case_o600_done
L_case_o600_br_1:
    LDR X0, [X2, #0]
    LDR X1, [X2, #8]
    MOV X9, X1
    MOV X10, #0


    CMP X9, X10
    CSET X4, GT
    CBZ X4, L_case_o600_br_2
    MOV X9, X0
    MOV X10, X1


    ADD X0, X9, X10
    B L_case_o600_done
L_case_o600_br_2:
    LDR X0, [X2, #0]
    LDR X1, [X2, #8]
    MOV X9, X0
    MOV X10, X1


    MUL X0, X9, X10
    B L_case_o600_done
L_case_o600_fb:
    MOV X0, #0
    B L_case_o600_done
L_case_o600_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    MOV X9, #0
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X19, X0
    MOV X0, SP
    ; effects []|sir_rec:o893|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.check_origin@PAGE
    ADD X9, X9, main.check_origin@PAGEOFF
    BLR X9
    MOV X19, X0
    SUB SP, SP, #16
    MOV X9, #5
    STR X9, [SP, #0]
    MOV X9, #10
    STR X9, [SP, #8]
    MOV X0, SP
    MOV X20, X0
    MOV X0, X20
    ; effects []|sir_rec:o998|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.classify_point@PAGE
    ADD X9, X9, main.classify_point@PAGEOFF
    BLR X9
    MOV X0, X20
    ; effects []|sir_rec:o1043|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.process_coordinate@PAGE
    ADD X9, X9, main.process_coordinate@PAGEOFF
    BLR X9
    MOV X1, X0
    MOV X21, X1
    MOV X0, #4
    ADD SP, SP, #16

    ADD SP, SP, #16

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
