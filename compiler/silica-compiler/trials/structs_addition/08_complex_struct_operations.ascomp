.text
.global main


main.segment_energy:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    LDR X9, [X11, #16]
    STR X9, [SP, #-16]!
    LDR X10, [X11, #0]
    LDR X9, [SP], #16
    SUB X0, X9, X10
    MOV X19, X0
    LDR X9, [X11, #24]
    STR X9, [SP, #-16]!
    LDR X10, [X11, #8]
    LDR X9, [SP], #16

    SUB X0, X9, X10
    MOV X20, X0
    MOV X9, X19
    MOV X10, X19
    MUL X9, X9, X10
    STR X9, [SP, #-16]!
    MOV X9, X20
    MOV X10, X20
    MUL X10, X9, X10
    LDR X9, [SP], #16

    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.merge_x_ranges:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    MOV X11, X0

    LDR X0, [X11, #0]
    MOV X19, X0
    LDR X0, [X11, #8]
    MOV X20, X0
    LDR X0, [X1, #0]
    MOV X21, X0
    LDR X0, [X1, #8]
    MOV X22, X0
    MOV X9, X19
    MOV X10, X21
    CMP X9, X10
    CSET X2, LT
L_case_o766_br_0:
    CMP W2, #1
    B.NE L_case_o766_br_1
    MOV X0, X19
    B L_case_o766_done
L_case_o766_br_1:
    CMP W2, #0
    B.NE L_case_o766_fb
    MOV X0, X21
    B L_case_o766_done
L_case_o766_fb:
    MOV X0, #0
    B L_case_o766_done
L_case_o766_done:
    MOV X23, X0
    MOV X9, X20
    MOV X10, X22
    CMP X9, X10
    CSET X2, LT
L_case_o865_br_0:
    CMP W2, #1
    B.NE L_case_o865_br_1
    MOV X0, X22
    B L_case_o865_done
L_case_o865_br_1:
    CMP W2, #0
    B.NE L_case_o865_fb
    MOV X0, X20
    B L_case_o865_done
L_case_o865_fb:
    MOV X0, #0
    B L_case_o865_done
L_case_o865_done:
    MOV X24, X0
    SUB SP, SP, #16
    MOV X9, X23
    STR X9, [SP, #0]
    MOV X9, X24
    STR X9, [SP, #8]
    MOV X0, SP
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.sum_segment_energies:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!

    MOV X2, X19
L_case_o1193_br_0:
    CMP X2, #0
    B.NE L_case_o1193_br_1
    MOV X0, X20
    B L_case_o1193_done
L_case_o1193_br_1:
    CBZ X2, L_case_o1193_br_2
    LDR X21, [X2, #32]
    MOV X22, X2
    STR X0, [SP, #-16]!
    MOV X9, X20
    STR X9, [SP, #-16]!
    MOV X0, X22
    ; effects []|sir_rec:o1563|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.segment_energy@PAGE
    ADD X9, X9, main.segment_energy@PAGEOFF
    BLR X9
    MOV X10, X0
    LDR X9, [SP], #16


    ADD X1, X9, X10

    LDR X0, [SP], #16
    MOV X0, X21
    ; effects []|sir_rec:o1525|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.sum_segment_energies@PAGE
    ADD X9, X9, main.sum_segment_energies@PAGEOFF
    BLR X9
    B L_case_o1193_done
