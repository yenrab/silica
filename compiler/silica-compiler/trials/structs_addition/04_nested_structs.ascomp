.text
.global main


main.create_rectangle:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #32
    MOV X9, #0
    STR X9, [SP, #0]
    MOV X9, #10
    STR X9, [SP, #8]
    MOV X9, #10
    STR X9, [SP, #16]
    MOV X9, #0
    STR X9, [SP, #24]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #32
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #32

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.rectangle_area:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X11, X0

    ADD X0, X11, #0
    MOV X19, X0
    ADD X0, X11, #16
    MOV X20, X0
    LDR X9, [X20, #0]
    STR X9, [SP, #-16]!
    LDR X10, [X19, #0]
    LDR X9, [SP], #16

    SUB X0, X9, X10
    MOV X21, X0
    LDR X9, [X19, #8]
    STR X9, [SP, #-16]!
    LDR X10, [X20, #8]
    LDR X9, [SP], #16

    SUB X0, X9, X10
    MOV X22, X0
    MOV X9, X21
    MOV X10, X22
    MUL X0, X9, X10
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.create_person_with_address:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #16
    ADRP X9, L_str_0@PAGE
    ADD X9, X9, L_str_0@PAGEOFF
    STR X9, [SP, #0]
    SUB SP, SP, #16
    ADRP X9, L_str_1@PAGE
    ADD X9, X9, L_str_1@PAGEOFF
    STR X9, [SP, #0]
    ADRP X9, L_str_2@PAGE
    ADD X9, X9, L_str_2@PAGEOFF
    STR X9, [SP, #8]
    MOV X9, SP
    STR X9, [SP, #24]
    ADD X0, SP, #16
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #32
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #32

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #32
    MOV X8, SP
    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o1149|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.create_rectangle@PAGE
    ADD X9, X9, main.create_rectangle@PAGEOFF
    BLR X9
    MOV X19, X0
    MOV X0, X19
    ; effects []|sir_rec:o1188|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.rectangle_area@PAGE
    ADD X9, X9, main.rectangle_area@PAGEOFF
    BLR X9
    MOV X20, X0
    SUB SP, SP, #32
    MOV X8, SP
    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o1286|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.create_person_with_address@PAGE
    ADD X9, X9, main.create_person_with_address@PAGEOFF
    BLR X9
    MOV X21, X0
    LDR X0, [X21, #16]
    MOV X22, X0
    MOV X0, #0
    ADD SP, SP, #32

    ADD SP, SP, #32

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "Bob"
    .byte 0
L_str_1:
    .ascii "123 Main St"
    .byte 0
L_str_2:
    .ascii "Springfield"
    .byte 0

