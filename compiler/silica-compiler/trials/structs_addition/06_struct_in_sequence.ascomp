.text
.global main


update_and_print:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

process_points:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
