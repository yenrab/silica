.bss
.balign 8
.lcomm _silica_frame_depth, 8
.lcomm _silica_frame_max, 8
.lcomm _silica_fuel, 8
.lcomm _silica_saved_pc, 8

.text
.global main

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



sum_items:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    MOV X2, X19
L_case_o304_br_0:
    CMP X2, #0
    B.NE L_case_o304_br_1
    MOV X0, #0
    B L_case_o304_done
L_case_o304_br_1:
    CBZ X2, L_case_o304_br_2
    LDR X20, [X2, #32]
    MOV X21, X2
    MOV X0, X20
    ; effects []|sir_rec:o539|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, sum_items@PAGE
    ADD X9, X9, sum_items@PAGEOFF
    BLR X9
    MOV X10, X0
    STR X10, [SP, #-16]!
    LDR X9, [X21, #16]
    LDR X10, [SP], #16


    ADD X0, X9, X10
    B L_case_o304_done
L_case_o304_br_2:
    MOV X0, #0
    B L_case_o304_done
L_case_o304_fb:
    MOV X0, #0
    B L_case_o304_done
L_case_o304_done:

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

calculate_order_total:     STP X29, X30, [SP, #-16]!
    MOV X11, X0

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    LDR X0, [X11, #8]
    ; effects []|sir_rec:o789|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, sum_items@PAGE
    ADD X9, X9, sum_items@PAGEOFF
    BR X9


create_item:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    SUB SP, SP, #32
    MOV X9, X19
    STR X9, [SP, #0]
    MOV X9, X1
    STR X9, [SP, #8]
    MOV X9, X2
    STR X9, [SP, #16]
    MOV X0, SP
    MOV X20, X0
    MOV X0, X20
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #32
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #32

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

create_order:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0

    SUB SP, SP, #32
    MOV X8, SP
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #100

    ; effects []|sir_rec:o1273|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, create_item@PAGE
    ADD X9, X9, create_item@PAGEOFF
    BLR X9
    MOV X20, X0
    SUB SP, SP, #32
    MOV X8, SP
    MOV X0, #2
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #150

    ; effects []|sir_rec:o1368|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, create_item@PAGE
    ADD X9, X9, create_item@PAGEOFF
    BLR X9
    MOV X21, X0
    MOV X2, #0

    MOV X1, X21

    STP X1, X2, [SP, #-16]!
    MOV X0, #40
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    LDR X3, [X1, #0]
    STR X3, [X0, #0]
    LDR X3, [X1, #8]
    STR X3, [X0, #8]
    LDR X3, [X1, #16]
    STR X3, [X0, #16]
    LDR X3, [X1, #24]
    STR X3, [X0, #24]
    STR X2, [X0, #32]
    MOV X2, X0

    MOV X1, X20

    STP X1, X2, [SP, #-16]!
    MOV X0, #40
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    LDR X3, [X1, #0]
    STR X3, [X0, #0]
    LDR X3, [X1, #8]
    STR X3, [X0, #8]
    LDR X3, [X1, #16]
    STR X3, [X0, #16]
    LDR X3, [X1, #24]
    STR X3, [X0, #24]
    STR X2, [X0, #32]
    MOV X0, X0
    MOV X22, X0
    MOV X0, X22
    ; effects []|sir_rec:o1761|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, sum_items@PAGE
    ADD X9, X9, sum_items@PAGEOFF
    BLR X9
    MOV X23, X0
    SUB SP, SP, #32
    MOV X9, X19
    STR X9, [SP, #0]
    MOV X9, X22
    STR X9, [SP, #8]
    MOV X9, X23
    STR X9, [SP, #16]
    MOV X0, SP
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #32
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #32

    ADD SP, SP, #32

    ADD SP, SP, #32

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

process_order:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X11, X0

    MOV X10, #200
    STR X10, [SP, #-16]!
    LDR X9, [X11, #16]
    LDR X10, [SP], #16


    CMP X9, X10
    CSET X2, GT
L_case_o2055_br_0:
    CMP W2, #1
    B.NE L_case_o2055_br_1
    SUB SP, SP, #32
    LDR X9, [X11, #0]
    STR X9, [SP, #0]
    ADRP X9, L_str_2@PAGE
    ADD X9, X9, L_str_2@PAGEOFF
    STR X9, [SP, #8]
    LDR X9, [X11, #16]
    STR X9, [SP, #16]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #32
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #32

    B L_case_o2055_done
L_case_o2055_br_1:
    CMP W2, #0
    B.NE L_case_o2055_fb
    SUB SP, SP, #32
    LDR X9, [X11, #0]
    STR X9, [SP, #0]
    ADRP X9, L_str_3@PAGE
    ADD X9, X9, L_str_3@PAGEOFF
    STR X9, [SP, #8]
    LDR X9, [X11, #16]
    STR X9, [SP, #16]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #32
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #32

    B L_case_o2055_done
L_case_o2055_fb:
    MOV X0, #0
    B L_case_o2055_done
L_case_o2055_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

count_items:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    STP X21, X22, [SP, #-16]!

    MOV X2, X19
L_case_o2708_br_0:
    CMP X2, #0
    B.NE L_case_o2708_br_1
    MOV X0, #0
    B L_case_o2708_done
L_case_o2708_br_1:
    CBZ X2, L_case_o2708_br_2
    LDR X20, [X2, #32]
    MOV X9, #1
    STR X9, [SP, #-16]!
    MOV X0, X20
    ; effects []|sir_rec:o2930|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, count_items@PAGE
    ADD X9, X9, count_items@PAGEOFF
    BLR X9
    MOV X10, X0
    LDR X9, [SP], #16


    ADD X0, X9, X10
    B L_case_o2708_done
L_case_o2708_br_2:
    MOV X0, #0
    B L_case_o2708_done
L_case_o2708_fb:
    MOV X0, #0
    B L_case_o2708_done
L_case_o2708_done:

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    SUB SP, SP, #32
    MOV X8, SP
    MOV X0, #1001
    ; effects []|sir_rec:o3168|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, create_order@PAGE
    ADD X9, X9, create_order@PAGEOFF
    BLR X9
    MOV X19, X0
    MOV X2, X19
L_case_o3193_br_0:
    LDR X0, [X2, #0]
    LDR X1, [X2, #8]
    LDR X2, [X2, #16]
    MOV X0, X1
    ; effects []|sir_rec:o3299|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, count_items@PAGE
    ADD X9, X9, count_items@PAGEOFF
    BLR X9
    MOV X3, X0
    MOV X20, X3
    MOV X0, X19
    ; effects []|sir_rec:o3343|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, calculate_order_total@PAGE
    ADD X9, X9, calculate_order_total@PAGEOFF
    BLR X9
    MOV X21, X0
    SUB SP, SP, #32
    MOV X8, SP
    MOV X0, X19
    ; effects []|sir_rec:o3447|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, process_order@PAGE
    ADD X9, X9, process_order@PAGEOFF
    BLR X9
    MOV X3, X0
    MOV X22, X3
    LDR X0, [X22, #16]
    ADD SP, SP, #32

    B L_case_o3193_done
L_case_o3193_fb:
    MOV X0, #0
    B L_case_o3193_done
L_case_o3193_done:

    ADD SP, SP, #32

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X4, X0
    MOV X3, X2
    MOV X0, #0
L_list_len_loop:
    CBZ X4, L_list_len_done
    ADD X0, X0, #1
    ADD X5, X4, X3
    LDR X4, [X5]
    B L_list_len_loop
L_list_len_done:
    RET

.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "Widget"
    .byte 0
L_str_1:
    .ascii "Gadget"
    .byte 0
L_str_2:
    .ascii "approved"
    .byte 0
L_str_3:
    .ascii "pending"
    .byte 0

