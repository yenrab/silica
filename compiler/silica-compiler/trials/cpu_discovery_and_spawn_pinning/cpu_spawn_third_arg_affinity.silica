// cpu_topology_implementation_plan Phase C: spawn(initial, behavior [, affinity]) with int64 and List[int64,normal] third arguments (§4.6 / §15.1.1).
// Deterministic I/O for .scout: call replies depend only on message + initial state.

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        a: actor_ref <- spawn(0, acc, 2);
        b: actor_ref <- spawn(100, acc, [0, 1]);
        ra: int64 <- call(a, 3 impl ActorMessage {});
        rb: int64 <- call(b, 5 impl ActorMessage {});
        print_int64(ra);
        println("");
        print_int64(rb);
        println("");
    produces
        pure :ok
    end
}
