// cpu_topology_implementation plan: nullary topology list helpers, get_cpu_topology, unary get_core_capabilities — parser + runtime-helper call shapes (spec §22.10 / appendix).
// Printed value is always 0 (lengths are multiplied by 0) so .scout is machine-independent.

fn ignore_cpu_topology(t: { cores: List[{ id: int64, core_type: atom, capabilities: List[string, normal], frequency_mhz: int64 }, normal], numa_nodes: List[{ id: int64, cores: List[int64, normal], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, normal] }, normal], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, normal] }, normal] } }) -> atom {
    :ok
}

fn ignore_core_info(c: { id: int64, core_type: atom, capabilities: List[string, normal], frequency_mhz: int64 }) -> atom {
    :ok
}

fn main() -> atom {
    sequence proc[concurrency, device_io, mem(normal)]
        ec: List[int64, normal] <- get_efficiency_cores();
        pc: List[int64, normal] <- get_performance_cores();
        top: { cores: List[{ id: int64, core_type: atom, capabilities: List[string, normal], frequency_mhz: int64 }, normal], numa_nodes: List[{ id: int64, cores: List[int64, normal], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, normal] }, normal], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64, normal] }, normal] } } <- get_cpu_topology();
        _: atom <- ignore_cpu_topology(top);
        ci: { id: int64, core_type: atom, capabilities: List[string, normal], frequency_mhz: int64 } <- get_core_capabilities(0);
        _: atom <- ignore_core_info(ci);
        z: int64 <- length[int64, normal](ec) * 0 + length[int64, normal](pc) * 0;
        print_int64(z);
    produces
        pure :ok
    end
}
