// Phase H fixture: intended checks once the emitter lowers `sequence proc[concurrency, …]` for main
// (today .sams stubs main — runtime calls below do not execute; use `make phase-h` for static asm checks).
// Target integrate output: see cpu_topology_phase_h_verify.scout — five printed lines (a..e) then `echo $?`
// (all 1 on Apple Silicon success; last line is process exit, `2` = :ok atom index with current emitter).

fn main() -> atom {
    sequence proc[concurrency, device_io, mem(normal)]
        sent_neg: { id: int64, core_type: atom, capabilities: List[string, normal], frequency_mhz: int64 } <- get_core_capabilities(-1);
        a: int64 <- case sent_neg.id < 0 of {
            true -> 1;
            false -> 0
        };
        print_int64(a);
        println("");
        sent_bad: { id: int64, core_type: atom, capabilities: List[string, normal], frequency_mhz: int64 } <- get_core_capabilities(999999);
        b: int64 <- case sent_bad.id < 0 of {
            true -> 1;
            false -> 0
        };
        print_int64(b);
        println("");
        top: { cores: List[{ id: int64, core_type: atom, capabilities: List[string,normal], frequency_mhz: int64 },normal], numa_nodes: List[{ id: int64, cores: List[int64,normal], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 },normal] },normal], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64,normal] },normal] } } <- get_cpu_topology();
        ncores: int64 <- length[{ id: int64, core_type: atom, capabilities: List[string, normal], frequency_mhz: int64 }, normal](top.cores);
        // Both lengths must use top before get_core_capabilities(0): emitter may hold topology ptr in X11; z overwrites that reg.
        nnuma: int64 <- length[{ id: int64, cores: List[int64, normal], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 }, normal] }, normal](top.numa_nodes);
        c: int64 <- case ncores > 0 of {
            true -> 1;
            false -> 0
        };
        print_int64(c);
        println("");
        z: { id: int64, core_type: atom, capabilities: List[string, normal], frequency_mhz: int64 } <- get_core_capabilities(0);
        d: int64 <- case z.id == 0 of {
            true -> 1;
            false -> 0
        };
        print_int64(d);
        println("");
        e: int64 <- case nnuma > 0 of {
            true -> 1;
            false -> 0
        };
        print_int64(e);
        println("");
    produces
        pure :ok
    end
}
