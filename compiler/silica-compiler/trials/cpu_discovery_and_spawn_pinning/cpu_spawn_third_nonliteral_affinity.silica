// Phase C: third spawn argument is a non-literal expression (still int64 affinity per current type checker).
// Exercises comma + full expr grammar in the placement slot without requiring placement-keyword typing.

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        r: actor_ref <- spawn(0, acc, 2 + 3);
        x: int64 <- call(r, 1 impl ActorMessage {});
        print_int64(x);
        println("");
    produces
        pure :ok
    end
}
