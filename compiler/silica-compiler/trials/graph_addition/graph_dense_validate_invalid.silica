// Phase 3 step 3.2 — invalid dense matrix validation: non-binary cell value (graph_representation_design.md §5.4).

use graph_dense_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@empty[mem(normal)](3);
        with01: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@set_edge[mem(normal)](graph, 0, 1);
        _: atom <- write_buf(with01.cells, 1, 2);
        valid: int64 <- graph_dense_directed@validate[mem(normal)](with01);
        failures: int64 <- valid
    produces
        pure failures
    end
}
