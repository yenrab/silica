// Phase 2 step 2.2 — CompressedSparseRowGraphDirected direct static constructor (graph_representation_design.md §4.6).
// Exit criteria: construct static CSR graphs and verify node_count and edge_count only.

use graph_csr_directed;

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        unweighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 2)
        } <- graph_csr_directed@from_static_edges[mem(normal)]();
        unweighted_node_count: int64 <- graph_csr_directed@node_count[mem(normal)](unweighted);
        unweighted_edge_count: int64 <- graph_csr_directed@edge_count[mem(normal)](unweighted);
        weighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 1),
            weights: buf(L1, normal, int64, 1)
        } <- graph_csr_directed@from_static_edges[int64, mem(normal)]();
        weighted_node_count: int64 <- graph_csr_directed@node_count[int64, mem(normal)](weighted);
        weighted_edge_count: int64 <- graph_csr_directed@edge_count[int64, mem(normal)](weighted);
        failures: int64 <-
            fail_unless_zero(unweighted_node_count - 3) +
            (fail_unless_zero(unweighted_edge_count - 2) * 2) +
            (fail_unless_zero(weighted_node_count - 3) * 4) +
            (fail_unless_zero(weighted_edge_count - 1) * 8)
    produces
        pure failures
    end
}
