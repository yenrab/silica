// Phase 4 step 4.2 — out-degree summaries on NodeIdAdjacencyGraphDirected[mem(normal)].
use graph_adj_directed;

fn fail_unless_zero(delta: int64) -> int64 {
    case delta of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        g0: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@empty[mem(normal)](3);
        g1: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@add_edge_slot0[mem(normal)](g0, 1);
        g2: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@add_edge_slot2[mem(normal)](g1, 0);
        graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@add_edge_slot2[mem(normal)](g2, 1);
        max_out: int64 <- graph_adj_directed@max_out_degree[mem(normal)](graph);
        total_out: int64 <- graph_adj_directed@total_out_degree_sum[mem(normal)](graph);
        edge_count: int64 <- graph_adj_directed@edge_count[mem(normal)](graph);
        d0: int64 <- graph_adj_directed@out_degree[mem(normal)](graph, 0);
        d1: int64 <- graph_adj_directed@out_degree[mem(normal)](graph, 1);
        d2: int64 <- graph_adj_directed@out_degree[mem(normal)](graph, 2);
        d9: int64 <- graph_adj_directed@out_degree[mem(normal)](graph, 9);
        failures: int64 <-
            (fail_unless_zero(max_out - 2) * 1) +
            (fail_unless_zero(total_out - 3) * 2) +
            (fail_unless_zero(edge_count - 3) * 4) +
            (fail_unless_zero(d0 - 1) * 8) +
            (d1 * 16) +
            (fail_unless_zero(d2 - 2) * 32) +
            (d9 * 64) +
            (fail_unless_zero(total_out - edge_count) * 128)
    produces
        pure failures
    end
}
