// Phase 3 step 3.3 -- invalid DenseBitsetGraph validation: set bit beyond node_count * node_count.

use graph_dense_bitset_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            words: buf(L1, normal, uint64, 4)
        } <- graph_dense_bitset_directed@empty[mem(normal)](5);
        one: uint64 <- 1;
        extra_bit: uint64 <- one shl 30;
        _: atom <- write_buf(graph.words, 0, extra_bit);
        valid: int64 <- graph_dense_bitset_directed@validate[mem(normal)](graph);
        failures: int64 <- valid
    produces
        pure failures
    end
}
