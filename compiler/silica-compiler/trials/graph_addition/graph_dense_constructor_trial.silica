// Phase 3 step 3.1 — DenseMatrixGraph empty + set_edge + edge presence (graph_representation_design.md §5.5).

use graph_dense_directed;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        unweighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@empty[mem(normal)](3);
        with01: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@set_edge[mem(normal)](unweighted, 0, 1);
        with012: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@set_edge[mem(normal)](with01, 1, 2);
        has01: int64 <- graph_dense_directed@has_edge[mem(normal)](with012, 0, 1);
        has12: int64 <- graph_dense_directed@has_edge[mem(normal)](with012, 1, 2);
        has02: int64 <- graph_dense_directed@has_edge[mem(normal)](with012, 0, 2);
        weighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@empty[int64, mem(normal)](3);
        weighted01: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@set_edge[int64, mem(normal)](weighted, 0, 1, 42);
        whas01: int64 <- graph_dense_directed@has_edge[int64, mem(normal)](weighted01, 0, 1);
        whas10: int64 <- graph_dense_directed@has_edge[int64, mem(normal)](weighted01, 1, 0);
        failures: int64 <-
            fail_unless_one(has01) +
            fail_unless_one(has12) * 2 +
            (has02 * 4) +
            fail_unless_one(whas01) * 8 +
            (whas10 * 16)
    produces
        pure failures
    end
}
