// Phase 1 step 1.5 — undirected unweighted flat bootstrap graph compiles and validates.
use graph_adj_undirected_unweighted_normal;

fn main() -> int64 {
    sequence proc[mem(normal)]
        g: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_undirected_unweighted_normal@graph_adj_undirected_unweighted_normal_empty(3);
        valid: int64 <- graph_adj_undirected_unweighted_normal@graph_adj_undirected_unweighted_normal_validate(g)
    produces
        pure case valid of {
            1 -> 0;
            _: int64 -> 1
        }
    end
}
