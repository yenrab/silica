// Phase 0.4 — context-resolved qualified calls (no call-site brackets on add_edge).
use graph_adj_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        g: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@empty[mem(normal)](3);
        initial_valid: int64 <- graph_adj_directed@validate[mem(normal)](g);
        added_graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@add_edge_slot0[mem(normal)](g, 1);
        after_valid: int64 <- graph_adj_directed@validate[mem(normal)](added_graph);
        failures: int64 <-
            (1 - initial_valid) +
            ((1 - after_valid) * 4)
    produces
        pure failures
    end
}
