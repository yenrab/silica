// Phase 2 steps 2.2–2.4 — static directed unweighted CSR graph.
use graph_csr_directed_unweighted_normal;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[]
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 2)
        } <- graph_csr_directed_unweighted_normal@graph_csr_directed_unweighted_normal_from_static_edges();
        node_count: int64 <- graph_csr_directed_unweighted_normal@graph_csr_directed_unweighted_normal_node_count(graph);
        edge_count: int64 <- graph_csr_directed_unweighted_normal@graph_csr_directed_unweighted_normal_edge_count(graph);
        valid: int64 <- graph_csr_directed_unweighted_normal@graph_csr_directed_unweighted_normal_validate(graph);
        has01: int64 <- graph_csr_directed_unweighted_normal@graph_csr_directed_unweighted_normal_has_edge(graph, 0, 1);
        has02: int64 <- graph_csr_directed_unweighted_normal@graph_csr_directed_unweighted_normal_has_edge(graph, 0, 2);
        out0: int64 <- graph_csr_directed_unweighted_normal@graph_csr_directed_unweighted_normal_out_degree(graph, 0);
        failures: int64 <-
            fail_unless_zero(node_count - 3) +
            (fail_unless_zero(edge_count - 2) * 2) +
            ((1 - valid) * 4) +
            ((1 - has01) * 8) +
            (has02 * 16) +
            ((1 - out0) * 32)
    produces
        pure failures
    end
}
