// Phase 4 step 4.1 — reachability on NodeIdAdjacencyGraphDirected[mem(normal)] after adding edge 0 -> 1.
use graph_adj_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        g: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@empty[mem(normal)](3);
        graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@add_edge_slot0[mem(normal)](g, 1);
        r01: int64 <- graph_adj_directed@reachable[mem(normal)](graph, 0, 1);
        r10: int64 <- graph_adj_directed@reachable[mem(normal)](graph, 1, 0);
        r02: int64 <- graph_adj_directed@reachable[mem(normal)](graph, 0, 2);
        r99: int64 <- graph_adj_directed@reachable[mem(normal)](graph, 9, 1);
        failures: int64 <-
            ((1 - r01) * 2) +
            (r10 * 4) +
            (r02 * 8) +
            (r99 * 16)
    produces
        pure failures
    end
}
