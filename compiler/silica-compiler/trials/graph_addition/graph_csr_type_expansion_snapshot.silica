// Phase 2 step 2.1 — CompressedSparseRowGraph inline type expansion snapshot (graph_representation_design.md §4.2, §4.3, §8.5).

use structure_registry;
use inline_type_expansion;

fn csr_family_name_at(index: int64) -> string {
    structure_registry@structure_family_name_at(index + 4)
}

fn csr_type_expansion_fail(name: string) -> int64 {
    got: string <- inline_type_expansion@expand_structure_inline_type_normal(name);
    case got == "" of {
        true -> 1;
        false -> 0
    }
}

fn csr_snapshot_failures_at(index: int64, failures: int64) -> int64 {
    case index >= 4 of {
        true -> failures;
        false -> {
            name: string <- csr_family_name_at(index);
            expand_fail: int64 <- csr_type_expansion_fail(name);
            csr_snapshot_failures_at(index + 1, failures + expand_fail)
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        fail: int64 <- csr_snapshot_failures_at(0, 0);
        _: atom <- print_string(csr_family_name_at(0));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(csr_family_name_at(0)));
        _: atom <- println("");
        _: atom <- print_string(csr_family_name_at(1));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(csr_family_name_at(1)));
        _: atom <- println("");
        _: atom <- print_string(csr_family_name_at(2));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(csr_family_name_at(2)));
        _: atom <- println("");
        _: atom <- print_string(csr_family_name_at(3));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(csr_family_name_at(3)));
        _: atom <- println("");
        _: atom <- print_int64(4);
        _: atom <- println("");
        fail
    produces
        pure fail
    end
}
