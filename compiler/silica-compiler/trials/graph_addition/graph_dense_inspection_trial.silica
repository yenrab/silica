// Phase 3 step 3.2 — dense inspection: out_degree, row traversal, has_edge, weight_at (graph_representation_design.md §5.4, §5.6).

use graph_dense_directed;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        unweighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@empty[mem(normal)](3);
        unweighted1: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@set_edge[mem(normal)](unweighted, 0, 1);
        unweighted2: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@set_edge[mem(normal)](unweighted1, 1, 2);
        weighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@empty[int64, mem(normal)](3);
        weighted1: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@set_edge[int64, mem(normal)](weighted, 0, 1, 42);
        out0_fail: int64 <- fail_unless_one(graph_dense_directed@out_degree[mem(normal)](unweighted2, 0));
        out2_fail: int64 <- fail_unless_zero(graph_dense_directed@out_degree[mem(normal)](unweighted2, 2));
        has01: int64 <- graph_dense_directed@has_edge[mem(normal)](unweighted2, 0, 1);
        has02: int64 <- graph_dense_directed@has_edge[mem(normal)](unweighted2, 0, 2);
        n00_fail: int64 <- fail_unless_zero(graph_dense_directed@neighbor_at[mem(normal)](unweighted2, 0, 0) - 1);
        n10_fail: int64 <- fail_unless_zero(graph_dense_directed@neighbor_at[mem(normal)](unweighted2, 1, 0) - 2);
        n20_fail: int64 <- fail_unless_zero(graph_dense_directed@neighbor_at[mem(normal)](unweighted2, 2, 0) + 1);
        w01_fail: int64 <- fail_unless_zero(graph_dense_directed@weight_at[int64, mem(normal)](weighted1, 0, 1) - 42);
        whas02: int64 <- graph_dense_directed@has_edge[int64, mem(normal)](weighted1, 0, 2);
        failures: int64 <-
            out0_fail +
            (out2_fail * 2) +
            ((1 - has01) * 4) +
            (has02 * 8) +
            (n00_fail * 16) +
            (n10_fail * 32) +
            (n20_fail * 64) +
            (w01_fail * 128) +
            (whas02 * 256)
    produces
        pure failures
    end
}
