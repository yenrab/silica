// Phase 3 steps 3.1–3.2 — directed weighted int64 DenseMatrixGraph.
use graph_dense_directed_weighted_int64_normal;

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[]
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- graph_dense_directed_weighted_int64_normal@graph_dense_directed_weighted_int64_normal_empty(3);
        initial_valid: int64 <- graph_dense_directed_weighted_int64_normal@graph_dense_directed_weighted_int64_normal_validate(graph);
        added: { ok: int64, graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } } <- graph_dense_directed_weighted_int64_normal@graph_dense_directed_weighted_int64_normal_set_edge_checked(graph, 0, 1, 42);
        added_graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- added.graph;
        after_valid: int64 <- graph_dense_directed_weighted_int64_normal@graph_dense_directed_weighted_int64_normal_validate(added_graph);
        has01: int64 <- graph_dense_directed_weighted_int64_normal@graph_dense_directed_weighted_int64_normal_has_edge(added_graph, 0, 1);
        has10: int64 <- graph_dense_directed_weighted_int64_normal@graph_dense_directed_weighted_int64_normal_has_edge(added_graph, 1, 0);
        out0: int64 <- graph_dense_directed_weighted_int64_normal@graph_dense_directed_weighted_int64_normal_out_degree(added_graph, 0);
        weight01: { ok: int64, value: int64 } <- graph_dense_directed_weighted_int64_normal@graph_dense_directed_weighted_int64_normal_weight_at_checked(added_graph, 0, 1);
        failures: int64 <-
            ((1 - initial_valid) * 1) +
            ((1 - added.ok) * 2) +
            ((1 - after_valid) * 4) +
            ((1 - has01) * 8) +
            (has10 * 16) +
            ((1 - out0) * 32) +
            ((1 - weight01.ok) * 64) +
            (fail_unless_zero(weight01.value - 42) * 128)
    produces
        pure failures
    end
}
