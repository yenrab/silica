// Phase 3 step 3.3 -- DenseBitsetGraph empty, set_edge, duplicate edge, checked invalid endpoint.

use graph_dense_bitset_directed;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn check_has_edge[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64, expected: int64, weight: int64) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    expected_saved: int64 <- expected;
    weight_saved: int64 <- weight;
    sequence proc[mem(normal)]
        actual: int64 <- graph_dense_bitset_directed@has_edge[mem(normal)](graph, from_saved, to_saved);
        fail: int64 <- case expected_saved of {
            0 -> actual;
            1 -> fail_unless_one(actual);
            _: int64 -> 1
        };
        weighted: int64 <- fail * weight_saved
    produces
        pure weighted
    end
}

fn check_edge_count(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, expected: int64, weight: int64) -> int64 {
    expected_saved: int64 <- expected;
    weight_saved: int64 <- weight;
    fail_unless_zero(graph.edge_count - expected_saved) * weight_saved
}

fn check_validate[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, weight: int64) -> int64 {
    weight_saved: int64 <- weight;
    sequence proc[mem(normal)]
        valid: int64 <- graph_dense_bitset_directed@validate[mem(normal)](graph);
        weighted: int64 <- fail_unless_one(valid) * weight_saved
    produces
        pure weighted
    end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            words: buf(L1, normal, uint64, 4)
        } <- graph_dense_bitset_directed@empty[mem(normal)](5);
        with01: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            words: buf(L1, normal, uint64, 4)
        } <- graph_dense_bitset_directed@set_edge[mem(normal)](graph, 0, 1);
        with44: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            words: buf(L1, normal, uint64, 4)
        } <- graph_dense_bitset_directed@set_edge[mem(normal)](with01, 4, 4);
        duplicate: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            words: buf(L1, normal, uint64, 4)
        } <- graph_dense_bitset_directed@set_edge[mem(normal)](with44, 0, 1);
        invalid: { ok: int64, graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            words: buf(L1, normal, uint64, 4)
        } } <- graph_dense_bitset_directed@set_edge_checked[mem(normal)](duplicate, 5, 0);
        c0: int64 <- check_has_edge[mem(normal)](invalid.graph, 0, 1, 1, 1);
        failures: int64 <- case c0 of {
            0 -> {
                c1: int64 <- check_has_edge[mem(normal)](invalid.graph, 4, 4, 1, 2);
                case c1 of {
                    0 -> {
                        c2: int64 <- check_has_edge[mem(normal)](invalid.graph, 1, 0, 0, 4);
                        case c2 of {
                            0 -> {
                                c3: int64 <- fail_unless_zero(invalid.ok) * 8;
                                case c3 of {
                                    0 -> {
                                        c4: int64 <- check_edge_count(invalid.graph, 2, 16);
                                        case c4 of {
                                            0 -> check_validate[mem(normal)](invalid.graph, 32);
                                            _: int64 -> c4
                                        }
                                    };
                                    _: int64 -> c3
                                }
                            };
                            _: int64 -> c2
                        }
                    };
                    _: int64 -> c1
                }
            };
            _: int64 -> c0
        }
    produces
        pure failures
    end
}
