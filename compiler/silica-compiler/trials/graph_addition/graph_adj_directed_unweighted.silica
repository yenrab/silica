// Phase 1 steps 1.1-1.4 — directed unweighted flat bootstrap NodeIdAdjacencyGraph.
use graph_adj_directed_unweighted_normal;
use graph_adj_list_helpers;

fn main() -> int64 {
    sequence proc[mem(normal)]
        g: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_empty(3);
        initial_valid: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_validate(g);
        added_graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_add_edge_slot0(g, 1);
        after_valid: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_validate(added_graph);
        bad_from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(9, added_graph.node_count);
        bad_to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(0, added_graph.node_count);
        bad_ok: int64 <- case bad_from_ok of {
            0 -> 0;
            1 -> bad_to_ok;
            _: int64 -> 0
        };
        has01: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_has_edge(added_graph, 0, 1);
        has10: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_has_edge(added_graph, 1, 0);
        out0: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_out_degree(added_graph, 0);
        added_ok: int64 <- case added_graph.edge_count - 1 of {
            0 -> 1;
            _: int64 -> 0
        };
        failures: int64 <-
            (1 - initial_valid) +
            ((1 - added_ok) * 2) +
            ((1 - after_valid) * 4) +
            (bad_ok * 8) +
            ((1 - has01) * 16) +
            (has10 * 32) +
            ((1 - out0) * 64)
    produces
        pure failures
    end
}
