// Phase 1 steps 1.1-1.4 — directed unweighted list-backed NodeIdAdjacencyGraph.
use graph_adj_directed_unweighted_normal;

fn main() -> int64 {
    sequence proc[mem(normal)]
        g: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
        } <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_empty(3);
        initial_valid: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_validate(g);
        added_checked: { ok: int64, graph: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
        } } <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_add_edge_checked(g, 0, 1);
        added_graph: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
        } <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_add_edge(g, 0, 1);
        after_valid: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_validate(added_graph);
        bad: { ok: int64, graph: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
        } } <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_add_edge_checked(added_graph, 9, 0);
        has01: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_has_edge(added_graph, 0, 1);
        has10: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_has_edge(added_graph, 1, 0);
        out0: int64 <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_out_degree(added_graph, 0);
        failures: int64 <-
            (1 - initial_valid) +
            ((1 - added_checked.ok) * 2) +
            ((1 - after_valid) * 4) +
            (bad.ok * 8) +
            ((1 - has01) * 16) +
            (has10 * 32) +
            ((1 - out0) * 64)
    produces
        pure failures
    end
}
