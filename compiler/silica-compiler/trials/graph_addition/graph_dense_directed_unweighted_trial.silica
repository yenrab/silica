// Phase 3 step 3.2 — DenseMatrixGraphDirected[mem(normal)] inspection and validation.
use graph_dense_directed;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- graph_dense_directed@empty[mem(normal)](3);
        initial_valid: int64 <- graph_dense_directed@validate[mem(normal)](graph);
        added: { ok: int64, graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } } <- graph_dense_directed@set_edge_checked[mem(normal)](graph, 0, 1);
        added_graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- added.graph;
        after_valid: int64 <- graph_dense_directed@validate[mem(normal)](added_graph);
        has01: int64 <- graph_dense_directed@has_edge[mem(normal)](added_graph, 0, 1);
        has10: int64 <- graph_dense_directed@has_edge[mem(normal)](added_graph, 1, 0);
        out0: int64 <- graph_dense_directed@out_degree[mem(normal)](added_graph, 0);
        failures: int64 <-
            ((1 - initial_valid) * 1) +
            ((1 - added.ok) * 2) +
            ((1 - after_valid) * 4) +
            ((1 - has01) * 8) +
            (has10 * 16) +
            ((1 - out0) * 32)
    produces
        pure failures
    end
}
