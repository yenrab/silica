// Phase 1 step 1.6 — NodeIdAdjacencyGraphDirected[int64, mem(normal)] flat bootstrap graph.
use graph_adj_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        g: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } <- graph_adj_directed@empty[int64, mem(normal)](3);
        valid: int64 <- graph_adj_directed@validate[int64, mem(normal)](g)
    produces
        pure case valid of {
            1 -> 0;
            _: int64 -> 1
        }
    end
}
