// Phase 2 step 2.4 — CSR inspection: out_degree, neighbor range traversal, has_edge, weight_at (graph_representation_design.md §4.7).

use graph_csr_directed;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        unweighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 2)
        } <- graph_csr_directed@from_static_edges[mem(normal)]();
        weighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 1),
            weights: buf(L1, normal, int64, 1)
        } <- graph_csr_directed@from_static_edges[int64, mem(normal)]();
        out0: int64 <- graph_csr_directed@out_degree[mem(normal)](unweighted, 0);
        out2: int64 <- graph_csr_directed@out_degree[mem(normal)](unweighted, 2);
        has01: int64 <- graph_csr_directed@has_edge[mem(normal)](unweighted, 0, 1);
        has02: int64 <- graph_csr_directed@has_edge[mem(normal)](unweighted, 0, 2);
        n00: int64 <- graph_csr_directed@neighbor_at[mem(normal)](unweighted, 0, 0);
        n10: int64 <- graph_csr_directed@neighbor_at[mem(normal)](unweighted, 1, 0);
        n20: int64 <- graph_csr_directed@neighbor_at[mem(normal)](unweighted, 2, 0);
        w01: int64 <- graph_csr_directed@weight_at[int64, mem(normal)](weighted, 0, 1);
        whas02: int64 <- graph_csr_directed@has_edge[int64, mem(normal)](weighted, 0, 2);
        failures: int64 <-
            fail_unless_one(out0) +
            (fail_unless_zero(out2) * 2) +
            ((1 - has01) * 4) +
            (has02 * 8) +
            (fail_unless_zero(n00 - 1) * 16) +
            (fail_unless_zero(n10 - 2) * 32) +
            (fail_unless_zero(n20 + 1) * 64) +
            (fail_unless_zero(w01 - 42) * 128) +
            (whas02 * 256)
    produces
        pure failures
    end
}
