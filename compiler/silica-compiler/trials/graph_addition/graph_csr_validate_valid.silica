// Phase 2 step 2.3 — positive CSR validation (graph_representation_design.md §4.4).

use graph_csr_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        unweighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 2)
        } <- graph_csr_directed@from_static_edges[mem(normal)]();
        weighted: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 1),
            weights: buf(L1, normal, int64, 1)
        } <- graph_csr_directed@from_static_edges[int64, mem(normal)]();
        unweighted_ok: int64 <- graph_csr_directed@validate[mem(normal)](unweighted);
        weighted_ok: int64 <- graph_csr_directed@validate[int64, mem(normal)](weighted);
        failures: int64 <- (1 - unweighted_ok) + ((1 - weighted_ok) * 2)
    produces
        pure failures
    end
}
