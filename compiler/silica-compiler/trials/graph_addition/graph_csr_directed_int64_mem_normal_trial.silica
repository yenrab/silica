// Phase 2 steps 2.2–2.4 — CompressedSparseRowGraphDirected[int64, mem(normal)] static CSR graph.
use graph_csr_directed_int64_mem_normal;

fn fail_unless_one(value: int64) -> int64 {
    case value of {
        1 -> 0;
        _: int64 -> 1
    }
}

fn fail_unless_zero(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[]
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 1),
            weights: buf(L1, normal, int64, 1)
        } <- graph_csr_directed_int64_mem_normal@graph_csr_directed_from_static_edges[int64, mem(normal)]();
        node_count: int64 <- graph_csr_directed_int64_mem_normal@graph_csr_directed_node_count[int64, mem(normal)](graph);
        edge_count: int64 <- graph_csr_directed_int64_mem_normal@graph_csr_directed_edge_count[int64, mem(normal)](graph);
        valid: int64 <- graph_csr_directed_int64_mem_normal@graph_csr_directed_validate[int64, mem(normal)](graph);
        has01: int64 <- graph_csr_directed_int64_mem_normal@graph_csr_directed_has_edge[int64, mem(normal)](graph, 0, 1);
        has02: int64 <- graph_csr_directed_int64_mem_normal@graph_csr_directed_has_edge[int64, mem(normal)](graph, 0, 2);
        out0: int64 <- graph_csr_directed_int64_mem_normal@graph_csr_directed_out_degree[int64, mem(normal)](graph, 0);
        weight01: { ok: int64, value: int64 } <- graph_csr_directed_int64_mem_normal@graph_csr_directed_weight_at_checked[int64, mem(normal)](graph, 0, 1);
        failures: int64 <-
            fail_unless_zero(node_count - 3) +
            (fail_unless_zero(edge_count - 1) * 2) +
            ((1 - valid) * 4) +
            ((1 - has01) * 8) +
            (has02 * 16) +
            ((1 - out0) * 32) +
            ((1 - weight01.ok) * 64) +
            (fail_unless_zero(weight01.value - 42) * 128)
    produces
        pure failures
    end
}
