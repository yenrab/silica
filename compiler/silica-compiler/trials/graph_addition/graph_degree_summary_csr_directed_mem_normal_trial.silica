// Phase 4 step 4.2 — out-degree summaries on CompressedSparseRowGraphDirected[mem(normal)] (edges 0 -> 1 -> 2).
use graph_csr_directed_mem_normal;

fn fail_unless_zero(delta: int64) -> int64 {
    case delta of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn main() -> int64 {
    sequence proc[]
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 2)
        } <- graph_csr_directed_mem_normal@graph_csr_directed_from_static_edges[mem(normal)]();
        edge_count: int64 <- graph_csr_directed_mem_normal@graph_csr_directed_edge_count[mem(normal)](graph);
        max_out: int64 <- graph_csr_directed_mem_normal@graph_csr_directed_max_out_degree[mem(normal)](graph);
        total_out: int64 <- graph_csr_directed_mem_normal@graph_csr_directed_total_out_degree_sum[mem(normal)](graph);
        d0: int64 <- graph_csr_directed_mem_normal@graph_csr_directed_out_degree[mem(normal)](graph, 0);
        d1: int64 <- graph_csr_directed_mem_normal@graph_csr_directed_out_degree[mem(normal)](graph, 1);
        d2: int64 <- graph_csr_directed_mem_normal@graph_csr_directed_out_degree[mem(normal)](graph, 2);
        failures: int64 <-
            (fail_unless_zero(edge_count - 2) * 1) +
            ((1 - max_out) * 2) +
            (fail_unless_zero(total_out - 2) * 4) +
            ((1 - d0) * 8) +
            ((1 - d1) * 16) +
            (d2 * 32) +
            (fail_unless_zero(total_out - edge_count) * 64)
    produces
        pure failures
    end
}
