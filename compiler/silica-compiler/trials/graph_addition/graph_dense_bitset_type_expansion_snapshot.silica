// Phase 3 step 3.3 -- DenseBitsetGraph inline type expansion snapshot.

use structure_registry;
use inline_type_expansion;

fn bitset_family_name_at(index: int64) -> string {
    structure_registry@structure_family_name_at(index + 12)
}

fn bitset_type_expansion_fail(name: string) -> int64 {
    got: string <- inline_type_expansion@expand_structure_inline_type_normal(name);
    case got == "" of {
        true -> 1;
        false -> 0
    }
}

fn bitset_snapshot_failures_at(index: int64, failures: int64) -> int64 {
    case index >= 2 of {
        true -> failures;
        false -> {
            name: string <- bitset_family_name_at(index);
            expand_fail: int64 <- bitset_type_expansion_fail(name);
            bitset_snapshot_failures_at(index + 1, failures + expand_fail)
        }
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        fail: int64 <- bitset_snapshot_failures_at(0, 0);
        _: atom <- print_string(bitset_family_name_at(0));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(bitset_family_name_at(0)));
        _: atom <- println("");
        _: atom <- print_string(bitset_family_name_at(1));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(bitset_family_name_at(1)));
        _: atom <- println("");
        _: atom <- print_int64(2);
        _: atom <- println("");
        fail
    produces
        pure fail
    end
}
