.text
.global main


main:     STP X29, X30, [SP, #-16]!

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_pi16_0@PAGE
    ADD X1, X1, L_pi16_0@PAGEOFF
    MOV X2, #2

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_pi16_0:
    .byte  0x34, 0x32, 0
