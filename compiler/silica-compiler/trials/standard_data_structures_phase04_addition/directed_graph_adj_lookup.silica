// Phase 1.2 — adjacency node lookup helpers (valid + invalid node id).
use graph_adj_directed;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn edge_target_int64(edge: int64) -> int64 {
    edge
}

fn list_int64_empty_score(lst: List[int64, mem(normal)]) -> int64 {
    case lst of {
        []: List[int64, mem(normal)] -> 1;
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: {
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- {
            compare_node: compare_int64_atom,
            compare_edge: compare_int64_atom,
            edge_target: edge_target_int64
        };
        graph0: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- graph_adj_directed@empty(functions, 3);
        node1: { ok: int64, value: { id: int64, neighbors: List[int64, mem(normal)] } } <-
            graph_adj_directed@find_node_checked(graph0, 1);
        invalid: { ok: int64, value: { id: int64, neighbors: List[int64, mem(normal)] } } <-
            graph_adj_directed@find_node_checked(graph0, 9);
        neighbors0: { ok: int64, value: List[int64, mem(normal)] } <-
            graph_adj_directed@neighbors_checked[int64, int64, mem(normal)](graph0, 0);
        result: int64 <- case node1.ok of {
            1 -> case node1.value.id of {
                1 -> case invalid.ok of {
                    0 -> case neighbors0.ok of {
                        1 -> list_int64_empty_score(neighbors0.value);
                        _: int64 -> 0
                    };
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        }
    produces
        pure result
    end
}
