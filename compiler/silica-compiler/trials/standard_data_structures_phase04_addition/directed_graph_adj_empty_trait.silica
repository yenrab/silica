// Phase 1.1 — empty directed unweighted adjacency graph via function-record constructor.
use DirectedGraph;
use graph_adj_directed;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn edge_target_int64(edge: int64) -> int64 {
    edge
}

fn list_int64_empty_score(lst: List[int64, mem(normal)]) -> int64 {
    case lst of {
        []: List[int64, mem(normal)] -> 1;
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    functions: {
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    } <- {
        compare_node: compare_int64_atom,
        compare_edge: compare_int64_atom,
        edge_target: edge_target_int64
    };
    graph0: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    } <- graph_adj_directed@empty(functions, 3);
    trait_node_count: int64 <- DirectedGraph@node_count(graph0);
    trait_edge_count: int64 <- DirectedGraph@edge_count(graph0);
    neighbors0: List[int64, mem(normal)] <- DirectedGraph@neighbors(graph0, 0);
    empty_neighbors: int64 <- list_int64_empty_score(neighbors0);
    case trait_node_count == 3 of {
        true -> case trait_edge_count == 0 of {
            true -> empty_neighbors;
            false -> 0
        };
        false -> 0
    }
}
