// Phase 9.2 — RegionBinaryMaxHeap constructor-record ABI and Heap trait smoke.
use Heap;
use heap_binary_max;

fn compare_item_int64(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence
        functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- {
            compare_item: compare_item_int64
        };
        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            values: buf(L1, normal, int64, 8),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- heap_binary_max@empty(functions);
        push1: {
            heap: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                values: buf(L1, normal, int64, 8),
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            ok: int64
        } <- heap_binary_max@max_heap_push(heap0, 3);
        push2: {
            heap: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                values: buf(L1, normal, int64, 8),
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            ok: int64
        } <- heap_binary_max@max_heap_push(push1.heap, 5);
        push3: {
            heap: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                values: buf(L1, normal, int64, 8),
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            ok: int64
        } <- heap_binary_max@max_heap_push(push2.heap, 4);
        top_direct: { ok: int64, value: int64 } <- heap_binary_max@max_heap_peek(push3.heap);
        top_trait: int64 <- Heap@peek(push3.heap);
        heap_len: int64 <- Heap@len(push3.heap);
        validation: { ok: int64, error_code: int64 } <- heap_binary_max@max_heap_validate(push3.heap);
        pop1: {
            heap: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                values: buf(L1, normal, int64, 8),
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            ok: int64,
            value: int64
        } <- heap_binary_max@max_heap_pop(push3.heap);
        result: int64 <- case push1.ok of {
            0 -> 10;
            _: int64 -> case push2.ok of {
                0 -> 11;
                _: int64 -> case push3.ok of {
                    0 -> 12;
                    _: int64 -> case heap_len of {
                        3 -> case top_direct.ok of {
                            0 -> 20;
                            _: int64 -> case top_direct.value of {
                                5 -> case top_trait of {
                                    5 -> case validation.ok of {
                                        1 -> case pop1.ok of {
                                            1 -> case pop1.value of {
                                                5 -> 1;
                                                other_pop_value: int64 -> other_pop_value + 80
                                            };
                                            _: int64 -> 70
                                        };
                                        _: int64 -> validation.error_code + 60
                                    };
                                    other_top_trait: int64 -> other_top_trait + 50
                                };
                                other_top: int64 -> other_top + 40
                            }
                        };
                        other_len: int64 -> other_len + 30
                    }
                }
            }
        }
    produces
        pure result
    end
}
