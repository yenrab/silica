// Phase 9.2 — RegionBinaryMinHeap priority/value constructor-record and PriorityQueue trait smoke.
use PriorityQueue;
use heap_binary_min;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence
        functions: {
            compare_priority: fn(int64, int64) -> :less | :equal | :greater,
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            compare_priority: compare_int64_atom,
            compare_item: compare_int64_atom
        };
        heap0: {
            compare_priority: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            priorities: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8)
        } <- heap_binary_min@priority_heap_empty(functions);
        push1: {
            compare_priority: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            priorities: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8)
        } <- heap_binary_min@priority_heap_push(heap0, 9, 90);
        push2: {
            compare_priority: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            priorities: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8)
        } <- heap_binary_min@priority_heap_push(push1, 3, 30);
        push3: {
            compare_priority: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            priorities: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8)
        } <- heap_binary_min@priority_heap_push(push2, 5, 50);
        top_priority: int64 <- PriorityQueue@peek_priority(push3);
        top_value: int64 <- PriorityQueue@peek_value(push3);
        top_direct: { ok: int64, priority: int64, value: int64 } <- heap_binary_min@priority_heap_peek(push3);
        validation: { ok: int64, error_code: int64 } <- heap_binary_min@priority_heap_validate(push3);
        pop1: {
            compare_priority: fn(int64, int64) -> :less | :equal | :greater,
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            priorities: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8)
        } <- heap_binary_min@priority_heap_pop(push3);
        next_priority: int64 <- PriorityQueue@peek_priority(pop1);
        result: int64 <- case push1.len of {
            1 -> case push2.len of {
                2 -> case push3.len of {
                    3 -> case top_priority of {
                        3 -> case top_value of {
                            30 -> case top_direct.ok of {
                                1 -> case top_direct.priority of {
                                    3 -> case top_direct.value of {
                                        30 -> case validation.ok of {
                                            1 -> case pop1.len of {
                                                2 -> case next_priority of {
                                                    5 -> {
                                                        next_value: int64 <- PriorityQueue@peek_value(pop1);
                                                        case next_value of {
                                                            50 -> 1;
                                                            other_next_value: int64 -> other_next_value + 100
                                                        }
                                                    };
                                                    other_next_priority: int64 -> other_next_priority + 90
                                                };
                                                other_pop_len: int64 -> other_pop_len + 80
                                            };
                                            _: int64 -> validation.error_code + 70
                                        };
                                        other_direct_value: int64 -> other_direct_value + 60
                                    };
                                    other_direct_priority: int64 -> other_direct_priority + 50
                                };
                                _: int64 -> 40
                            };
                            other_top_value: int64 -> other_top_value + 30
                        };
                        other_top_priority: int64 -> other_top_priority + 20
                    };
                    other_push3_len: int64 -> other_push3_len + 13
                };
                other_push2_len: int64 -> other_push2_len + 11
            };
            other_push1_len: int64 -> other_push1_len + 10
        }
    produces
        pure result
    end
}
