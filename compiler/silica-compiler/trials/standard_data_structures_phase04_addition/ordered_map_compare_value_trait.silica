// Phase 0.5 — OrderedMap nodeid compare_value delegates to captured fn (not hardcoded ordering).
use OrderedMap;
use btree_nodeid;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_value_reversed(left: int64, right: int64) -> :less | :equal | :greater {
    case left > right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            compare_key: compare_int64_atom,
            compare_value: compare_value_reversed
        };
        map: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_nodeid@empty(functions);
        val_cmp: atom <- OrderedMap@compare_value(map, 3, 5);
        result: int64 <- case val_cmp of {
            :greater -> 1;
            _: atom -> 0
        }
    produces
        pure result
    end
}
