use OrderedMap;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        tree: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            compare_key: compare_int64_atom,
            compare_value: compare_int64_atom,
            root_id: -1,
            node_count: 0,
            order: 8,
            nodes: nodes
        };
        key_cmp: atom <- OrderedMap@compare_key(tree, 3, 5);
        absent: boolean <- OrderedMap@contains_key(tree, 4);
        found: { found: int64, value: int64 } <- OrderedMap@get(tree, 4);
        result: int64 <- case key_cmp of {
            :less ->
                case absent of {
                    false -> found.found;
                    true -> 0
                };
            _: atom -> 98
        }
    produces
        pure result
    end
}
