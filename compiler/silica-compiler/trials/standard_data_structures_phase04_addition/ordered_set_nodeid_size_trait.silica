// Phase 0.5 — OrderedSet nodeid size uses item_count (leaf keys), not node_count.
use OrderedSet;
use btree_set_nodeid;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- { compare_item: compare_int64_atom };
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_set_nodeid@empty(functions);
        inserted: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            inserted: int64
        } <- btree_set_nodeid@insert(tree, 42);
        trait_size: int64 <- OrderedSet@size(inserted.tree);
        direct_size: int64 <- btree_set_nodeid@item_count(inserted.tree);
        result: int64 <- case trait_size == direct_size of {
            true -> case trait_size of {
                1 -> 1;
                _: int64 -> 0
            };
            false -> 0
        }
    produces
        pure result
    end
}
