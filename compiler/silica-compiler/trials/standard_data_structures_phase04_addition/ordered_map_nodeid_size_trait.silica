// Phase 7 — OrderedMap nodeid size uses item_count (entry totals), not node_count.
use OrderedMap;
use btree_nodeid;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            compare_key: compare_int64_atom,
            compare_value: compare_int64_atom
        };
        map0: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_nodeid@empty(functions);
        inner0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: map0.root_id,
            node_count: map0.node_count,
            order: map0.order,
            nodes: map0.nodes
        };
        inserted: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- btree_nodeid@insert[int64, int64, mem(normal)](inner0, 42, 420);
        map1: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            compare_key: map0.compare_key,
            compare_value: map0.compare_value,
            root_id: inserted.tree.root_id,
            node_count: inserted.tree.node_count,
            order: inserted.tree.order,
            nodes: inserted.tree.nodes
        };
        trait_size: int64 <- OrderedMap@size(map1);
        direct_size: int64 <- btree_nodeid@ordered_map_item_count(map1);
        result: int64 <- case trait_size == direct_size of {
            true -> case trait_size of {
                1 -> 1;
                _: int64 -> 0
            };
            false -> 0
        }
    produces
        pure result
    end
}
