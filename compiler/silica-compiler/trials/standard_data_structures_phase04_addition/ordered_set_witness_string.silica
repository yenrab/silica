// Phase 0.4 — OrderedSet[string, mem(normal)] constructor-record type witness (string ItemType).
use string_set_phase04;

fn compare_string(left: string, right: string) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    functions: { compare_item: fn(string, string) -> :less | :equal | :greater } <- { compare_item: compare_string };
    set0: OrderedSet[string, mem(normal)] <- string_set_phase04@empty(functions);
    0
}
