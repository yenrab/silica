fn cmp_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> :greater
    }
}

fn main() -> int64 {
    sequence
        rec: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- { compare_item: cmp_atom };
        f: fn(int64, int64) -> :less | :equal | :greater <- rec.compare_item;
        r: atom <- f(1, 2);
        result: int64 <- case r of { :less -> 3; :greater -> 5; _: atom -> 9 }
    produces
        pure result
    end
}
