// Phase 1.6 — weighted adjacency add_edge stores weight; weight_at_checked reads it back.
use graph_adj_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        graph0: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } <- graph_adj_directed@empty[int64, mem(normal)](3);
        graph1: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } <- graph_adj_directed@add_edge[int64, mem(normal)](graph0, 0, 2, 42);
        weight_result: { ok: int64, value: int64 } <-
            graph_adj_directed@weight_at_checked[int64, mem(normal)](graph1, 0, 2);
        result: int64 <- case graph1.edge_count of {
            1 -> case weight_result.ok of {
                1 -> case weight_result.value of {
                    42 -> 1;
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        }
    produces
        pure result
    end
}
