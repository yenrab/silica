use DirectedGraph;
use graph_phase04;

fn bool_score(value: boolean) -> int64 {
    case value of {
        true -> 1;
        false -> 0
    }
}

fn main() -> int64 {
    graph0: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 } <- graph_phase04@empty(3);
    graph1: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 } <- graph_phase04@add_edge(graph0, 0, 2);
    DirectedGraph@node_count(graph1) + DirectedGraph@edge_count(graph1) + bool_score(DirectedGraph@has_edge(graph1, 0, 2))
}

