use OrderedSet;
use btree_set_phase04;

fn compare_int64_atom(left: int64, right: int64) -> atom {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn bool_score(value: boolean) -> int64 {
    case value of {
        true -> 1;
        false -> 0
    }
}

fn main() -> int64 {
    functions: { compare_item: fn(int64, int64) -> atom } <- { compare_item: compare_int64_atom };
    set0: { compare_item: fn(int64, int64) -> atom } <- btree_set_phase04@empty(functions);
    set1: { compare_item: fn(int64, int64) -> atom } <- btree_set_phase04@insert(set0, 42);
    size_score: int64 <- OrderedSet@size(set1);
    contains_score: int64 <- bool_score(OrderedSet@contains(set1, 42));
    size_score + contains_score
}
