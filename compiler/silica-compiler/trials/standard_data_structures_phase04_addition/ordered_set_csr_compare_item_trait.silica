// Phase 0.5 — OrderedSet CSR compare_item delegates to captured fn stored in generated value.
use OrderedSet;
use btree_set_csr;

fn compare_item_reversed(left: int64, right: int64) -> :less | :equal | :greater {
    case left > right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence
        functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- { compare_item: compare_item_reversed };
        set: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_set_csr@empty(functions);
        item_cmp: atom <- OrderedSet@compare_item(set, 3, 5);
        result: int64 <- case item_cmp of {
            :greater -> 1;
            _: atom -> 0
        }
    produces
        pure result
    end
}
