// Phase 8 step 8.5 — OrderedMap CSR compare_value delegates to captured fn in generated value.
use OrderedMap;
use btree_csr_map;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn compare_value_reversed(left: int64, right: int64) -> :less | :equal | :greater {
    case left > right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence
        functions: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            compare_key: compare_int64_atom,
            compare_value: compare_value_reversed
        };
        map: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_csr_map@empty(functions);
        val_cmp: atom <- OrderedMap@compare_value(map, 3, 5);
        result: int64 <- case val_cmp of {
            :greater -> 1;
            _: atom -> 0
        }
    produces
        pure result
    end
}
