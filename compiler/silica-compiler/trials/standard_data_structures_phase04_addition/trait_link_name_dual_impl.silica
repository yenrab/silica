// Phase 0.4 #5 — trait link-name mangling: two concrete impl shapes → two mangled contains symbols.
use OrderedSet;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        simple: {
            compare_item: fn(int64, int64) -> :less | :equal | :greater,
            item_count: int64,
            has_first: int64,
            first_item: int64
        } <- {
            compare_item: compare_int64_atom,
            item_count: 1,
            has_first: 1,
            first_item: 7
        };
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        nodeid: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            compare_item: compare_int64_atom,
            root_id: -1,
            node_count: 0,
            order: 8,
            nodes: nodes
        };
        a: boolean <- OrderedSet@contains(simple, 7);
        b: boolean <- OrderedSet@contains(nodeid, 7);
        result: int64 <- case a of {
            true -> case b of { true -> 1; false -> 2 };
            false -> 3
        }
    produces
        pure result
    end
}
