// Phase 7 — OrderedMap find_value linear scan via captured compare_value.
use OrderedMap;
use btree_nodeid;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            compare_key: compare_int64_atom,
            compare_value: compare_int64_atom
        };
        map0: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_nodeid@empty(functions);
        inner0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: map0.root_id,
            node_count: map0.node_count,
            order: map0.order,
            nodes: map0.nodes
        };
        r1: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- btree_nodeid@insert[int64, int64, mem(normal)](inner0, 10, 100);
        r2: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- btree_nodeid@insert[int64, int64, mem(normal)](r1.tree, 20, 200);
        map2: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            compare_key: map0.compare_key,
            compare_value: map0.compare_value,
            root_id: r2.tree.root_id,
            node_count: r2.tree.node_count,
            order: r2.tree.order,
            nodes: r2.tree.nodes
        };
        found: { found: int64, key: int64 } <- OrderedMap@find_value(map2, 100);
        result: int64 <- case found.found of {
            0 -> 0;
            _: int64 -> case found.key of {
                10 -> 1;
                _: int64 -> 0
            }
        }
    produces
        pure result
    end
}
