// Phase 1.7 — directed adjacency validation rejects inconsistent edge_count.
use graph_adj_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        one_neighbor: List[int64, mem(normal)] <- prepend[int64, mem(normal)](2, empty_neighbors);
        bad_graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: 3,
            edge_count: 0,
            n0_neighbors: one_neighbor,
            n1_neighbors: empty_neighbors,
            n2_neighbors: empty_neighbors
        };
        valid: int64 <- graph_adj_directed@validate[mem(normal)](bad_graph);
        result: int64 <- case valid of {
            0 -> 1;
            _: int64 -> 0
        }
    produces
        pure result
    end
}
