// Phase 1.7 — directed adjacency validation passes for a constructed graph.
use graph_adj_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        graph0: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@empty[mem(normal)](3);
        graph1: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed@add_edge[mem(normal)](graph0, 0, 2);
        result: int64 <- graph_adj_directed@validate[mem(normal)](graph1)
    produces
        pure result
    end
}
