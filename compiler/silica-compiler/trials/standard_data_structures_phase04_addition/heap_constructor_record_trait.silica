// Phase 9.1 — Heap constructor record + trait dispatch on RegionBinaryMinHeap.
use Heap;
use heap_binary_min;

fn compare_item_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence
        functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- {
            compare_item: compare_item_atom
        };
        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            values: buf(L1, normal, int64, 8),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- heap_binary_min@empty(functions);
        push_result: {
            heap: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                values: buf(L1, normal, int64, 8),
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            ok: int64
        } <- heap_binary_min@min_heap_push(heap0, 7);
        cmp: atom <- Heap@compare_priority(push_result.heap, 1, 2);
        result: int64 <- case cmp of {
            :less -> Heap@len(push_result.heap) + Heap@peek(push_result.heap);
            _: atom -> 99
        }
    produces
        pure result
    end
}
