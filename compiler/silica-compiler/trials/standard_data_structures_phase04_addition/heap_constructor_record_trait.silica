use Heap;
use heap_phase04;

fn compare_priority_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    functions: { compare_priority: fn(int64, int64) -> :less | :equal | :greater } <- { compare_priority: compare_priority_atom };
    heap0: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 } <- heap_phase04@empty(functions);
    heap1: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 } <- heap_phase04@push(heap0, 7);
    cmp: atom <- Heap@compare_priority(heap1, 1, 2);
    case cmp of {
        :less -> Heap@len(heap1) + Heap@peek(heap1);
        _: atom -> 99
    }
}
