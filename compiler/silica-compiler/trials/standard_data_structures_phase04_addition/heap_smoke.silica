use heap_binary_min;

fn compare_item_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of { true -> :equal; false -> :greater }
    }
}

fn main() -> int64 {
    sequence
        functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- { compare_item: compare_item_atom };
        heap0: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8), compare_item: fn(int64, int64) -> :less | :equal | :greater } <- heap_binary_min@empty(functions);
        p1: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8), compare_item: fn(int64, int64) -> :less | :equal | :greater }, ok: int64 } <- heap_binary_min@min_heap_push(heap0, 9);
        p2: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int64, 8), compare_item: fn(int64, int64) -> :less | :equal | :greater }, ok: int64 } <- heap_binary_min@min_heap_push(p1.heap, 4);
        result: int64 <- p2.ok
    produces
        pure result
    end
}
