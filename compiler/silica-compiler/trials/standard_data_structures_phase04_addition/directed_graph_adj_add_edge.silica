// Phase 1.3 — directed edge addition on adjacency graph (valid edge, reverse absent, invalid endpoints).
use graph_adj_directed;
use graph_adj_list_helpers;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn edge_target_int64(edge: int64) -> int64 {
    edge
}

fn list_int64_empty_score(lst: List[int64, mem(normal)]) -> int64 {
    case lst of {
        []: List[int64, mem(normal)] -> 1;
        _: List[int64, mem(normal)] -> 0
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: {
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- {
            compare_node: compare_int64_atom,
            compare_edge: compare_int64_atom,
            edge_target: edge_target_int64
        };
        graph0: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- graph_adj_directed@empty(functions, 3);
        graph1: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- graph_adj_directed@add_edge[int64, int64, mem(normal)](graph0, 0, 2);
        forward_neighbors: { ok: int64, value: List[int64, mem(normal)] } <-
            graph_adj_directed@neighbors_checked[int64, int64, mem(normal)](graph1, 0);
        result: int64 <- case graph1.edge_count of {
            1 -> forward_neighbors.ok;
            _: int64 -> 0
        }
    produces
        pure result
    end
}
