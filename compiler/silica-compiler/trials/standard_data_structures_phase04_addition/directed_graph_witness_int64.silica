// Phase 1.1 — DirectedGraph[NodeId, Edge, mem(Space)] constructor-record type witness (int64).
use graph_adj_directed;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn edge_target_int64(edge: int64) -> int64 {
    edge
}

fn main() -> int64 {
    functions: {
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    } <- {
        compare_node: compare_int64_atom,
        compare_edge: compare_int64_atom,
        edge_target: edge_target_int64
    };
    graph0: DirectedGraph[int64, int64, mem(normal)] <- graph_adj_directed@empty(functions, 2);
    0
}
