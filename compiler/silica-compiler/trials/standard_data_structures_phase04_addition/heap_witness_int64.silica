// Phase 0.4 — Heap[Item, mem(Space)] constructor-record type witness (int64).
use heap_phase04;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    functions: { compare_priority: fn(int64, int64) -> :less | :equal | :greater } <- { compare_priority: compare_int64_atom };
    heap0: Heap[int64, mem(normal)] <- heap_phase04@empty(functions);
    0
}
