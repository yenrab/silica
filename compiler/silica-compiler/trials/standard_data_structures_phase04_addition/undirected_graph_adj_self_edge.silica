// Phase 1.5 — undirected adjacency self-edge stores once.
use graph_adj_undirected;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn edge_target_int64(edge: int64) -> int64 {
    edge
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: {
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- {
            compare_node: compare_int64_atom,
            compare_edge: compare_int64_atom,
            edge_target: edge_target_int64
        };
        graph0: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- graph_adj_undirected@empty(functions, 3);
        graph1: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- graph_adj_undirected@add_edge[int64, int64, mem(normal)](graph0, 1, 1);
        has_self: int64 <- graph_adj_undirected@has_edge[int64, int64, mem(normal)](graph1, 1, 1);
        out1: int64 <- graph_adj_undirected@out_degree[int64, int64, mem(normal)](graph1, 1);
        result: int64 <- case graph1.edge_count of {
            1 -> case has_self of {
                1 -> case out1 of {
                    1 -> 1;
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        }
    produces
        pure result
    end
}
