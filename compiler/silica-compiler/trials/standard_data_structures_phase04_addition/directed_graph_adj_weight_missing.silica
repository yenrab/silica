// Phase 1.6 — missing weighted edge returns ok=0 from weight_at_checked.
use graph_adj_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        graph0: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } <- graph_adj_directed@empty[int64, mem(normal)](3);
        weight_result: { ok: int64, value: int64 } <-
            graph_adj_directed@weight_at_checked[int64, mem(normal)](graph0, 0, 2);
        result: int64 <- case weight_result.ok of {
            0 -> 1;
            _: int64 -> 0
        }
    produces
        pure result
    end
}
