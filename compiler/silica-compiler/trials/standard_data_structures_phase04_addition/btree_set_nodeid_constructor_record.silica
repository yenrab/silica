use OrderedSet;
use btree_set_nodeid;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn bool_score(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- { compare_item: compare_int64_atom };
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- btree_set_nodeid@empty(functions);
        r1: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            inserted: int64
        } <- btree_set_nodeid@insert(tree, 42);
        found: boolean <- OrderedSet@contains(r1.tree, 42);
        absent: boolean <- OrderedSet@contains(r1.tree, 99);
        result: int64 <- bool_score(found) + bool_score(absent)
    produces
        pure result
    end
}
