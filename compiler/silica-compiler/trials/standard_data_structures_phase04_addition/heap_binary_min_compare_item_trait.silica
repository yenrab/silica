// Phase 9.1 — Heap compare_item delegates to captured fn (reversed ordering smoke).
use Heap;
use heap_binary_min;

fn compare_item_reversed(left: int64, right: int64) -> :less | :equal | :greater {
    case left > right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence
        functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- {
            compare_item: compare_item_reversed
        };
        heap0: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            values: buf(L1, normal, int64, 8),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- heap_binary_min@empty(functions);
        push1: {
            heap: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                values: buf(L1, normal, int64, 8),
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            ok: int64
        } <- heap_binary_min@min_heap_push(heap0, 3);
        push2: {
            heap: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                values: buf(L1, normal, int64, 8),
                compare_item: fn(int64, int64) -> :less | :equal | :greater
            },
            ok: int64
        } <- heap_binary_min@min_heap_push(push1.heap, 5);
        top: int64 <- Heap@peek(push2.heap);
        cmp: atom <- Heap@compare_priority(push2.heap, 3, 5);
        result: int64 <- case top of {
            5 -> case cmp of {
                :greater -> 1;
                _: atom -> 0
            };
            _: int64 -> 0
        }
    produces
        pure result
    end
}
