use btree_nodeid;

fn compare_int64_atom(left: int64, right: int64) -> atom {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: { compare_key: fn(int64, int64) -> atom, compare_value: fn(int64, int64) -> atom } <- {
            compare_key: compare_int64_atom,
            compare_value: compare_int64_atom
        };
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_nodeid@empty(functions);
        result: int64 <- btree_nodeid@contains_key(tree, 7)
    produces
        pure result
    end
}
