export empty/1;

fn empty(functions: { compare_item: fn(string, string) -> :less | :equal | :greater }) -> {
    compare_item: fn(string, string) -> :less | :equal | :greater,
    item_count: int64
} {
    result: { compare_item: fn(string, string) -> :less | :equal | :greater, item_count: int64 } <- {
        compare_item: functions.compare_item,
        item_count: 0
    };
    result
}
