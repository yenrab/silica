// Phase 7 — OrderedMap fold over nodeid map entries.
use OrderedMap;
use btree_nodeid;

fn compare_int64_atom(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn sum_values(acc: int64, key: int64, value: int64) -> int64 {
    acc + value
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        functions: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            compare_key: compare_int64_atom,
            compare_value: compare_int64_atom
        };
        map0: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_nodeid@empty(functions);
        inner0: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: map0.root_id,
            node_count: map0.node_count,
            order: map0.order,
            nodes: map0.nodes
        };
        r1: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- btree_nodeid@insert[int64, int64, mem(normal)](inner0, 1, 10);
        r2: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- btree_nodeid@insert[int64, int64, mem(normal)](r1.tree, 2, 20);
        map2: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            compare_key: map0.compare_key,
            compare_value: map0.compare_value,
            root_id: r2.tree.root_id,
            node_count: r2.tree.node_count,
            order: r2.tree.order,
            nodes: r2.tree.nodes
        };
        fold_ctx: { fold_step: fn(int64, int64, int64) -> int64 } <- { fold_step: sum_values };
        trait_sum: int64 <- OrderedMap@fold(map2, 0, fold_ctx);
        result: int64 <- case trait_sum of {
            30 -> 1;
            _: int64 -> 0
        }
    produces
        pure result
    end
}
