.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    ADRP X0, L_f32_0@PAGE
    LDR S0, [X0, L_f32_0@PAGEOFF]
    FCVT H0, S0
    FMOV H1, H0
    FNEG H1, H1
    ADRP X0, L_f32_1@PAGE
    LDR S2, [X0, L_f32_1@PAGEOFF]
    FCVT H2, S2

    FCMP H1, H2
    CSET W0, EQ
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #0

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pb_helper:
    CMP X0, #0
    B.eq L_pb_false_branch
    MOV X0, #1
    ADRP X1, L_pb_true@PAGE
    ADD X1, X1, L_pb_true@PAGEOFF
    MOV X2, #4
    MOV X16, #4
    SVC #0x80
    B L_pb_after
L_pb_false_branch:
    MOV X0, #1
    ADRP X1, L_pb_false@PAGE
    ADD X1, X1, L_pb_false@PAGEOFF
    MOV X2, #5
    MOV X16, #4
    SVC #0x80
L_pb_after:
    RET
.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0

.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 4.25

L_f64_1:
    .double -4.25

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 4.25

L_f32_1:
    .single -4.25

