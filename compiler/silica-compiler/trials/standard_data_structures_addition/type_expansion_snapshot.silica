        _: atom <- println("");
        _: atom <- print_string(structure_registry@structure_family_name_at(22));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(structure_registry@structure_family_name_at(22)));
        _: atom <- println("");
        _: atom <- print_string(structure_registry@structure_family_name_at(23));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(structure_registry@structure_family_name_at(23)));
        _: atom <- println("");
        count_line: int64 <- structure_registry@structure_family_count();
        _: atom <- print_int64(count_line);
        _: atom <- println("");
