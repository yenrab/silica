        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(structure_registry@structure_family_name_at(2)));
        _: atom <- println("");
        _: atom <- print_string(structure_registry@structure_family_name_at(3));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(structure_registry@structure_family_name_at(3)));
        _: atom <- println("");
        _: atom <- print_string(structure_registry@structure_family_name_at(4));
