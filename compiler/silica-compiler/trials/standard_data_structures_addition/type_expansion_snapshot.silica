// Phase 0 snapshot — registry listing and canonical inline type strings (stdout golden: .scout).
// Separate from list_addition (compiler-internal List runtime trials).

use structure_registry;
use inline_type_expansion;

fn snapshot_line_fail(name: string, got: string) -> int64 {
    case structure_registry@structure_family_is_registered(name) of {
        false -> 1;
        true -> case got == "" of {
            true -> 1;
            false -> case structure_registry@structure_family_design_doc(name) == "" of {
                true -> 1;
                _: string -> 0
            }
        }
    }
}

// Tail-recursive walk (same shape as recursive_function_addition/recursive_string_count_a.silica).
fn snapshot_failures_at_step(index: int64, failures: int64) -> int64 {
    name: string <- structure_registry@structure_family_name_at(index);
    got: string <- inline_type_expansion@expand_structure_inline_type_normal(name);
    snapshot_failures_at(index + 1, failures + snapshot_line_fail(name, got))
}

fn snapshot_failures_at(index: int64, failures: int64) -> int64 {
    case index >= structure_registry@structure_family_count() of {
        true -> failures;
        false -> snapshot_failures_at_step(index, failures)
    }
}

fn main() -> int64 {
    sequence proc[device_io]
        fail: int64 <- snapshot_failures_at(0, 0);
        _: atom <- print_string(structure_registry@structure_family_name_at(0));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(structure_registry@structure_family_name_at(0)));
        _: atom <- println("");
        _: atom <- print_string(structure_registry@structure_family_name_at(1));
        _: atom <- println("");
        _: atom <- print_string(inline_type_expansion@expand_structure_inline_type_normal(structure_registry@structure_family_name_at(1)));
        _: atom <- println("");
        _: atom <- print_string(structure_registry@structure_family_name_at(2));
