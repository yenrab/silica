// Statement separator regression: tuple parameter before record parameter must not
// be mistaken for a missing function return type.

fn forwarder(pair: (int64, int64), state: { sink: actor_ref }, msg: int64) -> (:no_reply, { sink: actor_ref }) {
    sequence proc[concurrency]
        _: boolean <- cast(state.sink, msg impl ActorMessage {})
    produces
        pure :ok
    end
    (:no_reply, state)
}
