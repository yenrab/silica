module app_spawn_dangerous_naming_fail;

fn ffi_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        next: int64 <- msg + state
    produces
        pure (:no_reply, next)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        worker_ref: dangerous_actor_ref <- spawn_dangerous(0, ffi_worker)
    produces
        pure 0
    end
}
