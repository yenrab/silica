module dangerous_taint_in_produces;

use dangerous_legacy_stub;

fn sink_behavior(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn ffi_worker_behavior(
    msg: int64,
    state: { pending: int64, reply_to: actor_ref }
) -> (:no_reply, { pending: int64, reply_to: actor_ref }) {
    sequence proc[external_danger]
        sum: int64 <- dangerous_legacy_stub@add(msg, state.pending)
    produces
        pure (:no_reply, { pending: sum, reply_to: state.reply_to })
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        reply_ref: actor_ref <- spawn(0, sink_behavior);
        worker_ref: actor_ref <- spawn({ pending: 0, reply_to: reply_ref }, ffi_worker_behavior)
    produces
        pure 0
    end
}
