module dangerous_spawn_registered_wrong_type;

use dangerous_legacy_stub;

fn ffi_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger]
        _: int64 <- dangerous_legacy_stub@add(msg, state)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        worker_ref: actor_ref <- spawn_dangerous_registered(0, ffi_worker, :dangerous_worker)
    produces
        pure 0
    end
}
