module dangerous_spawn_plain_bad;
use dangerous_legacy_stub;

fn ffi_worker_behavior(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger]
        _: int64 <- dangerous_legacy_stub@add(msg, state)
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency]
        worker_ref: actor_ref <- spawn(0, ffi_worker_behavior)
    produces
        pure 0
    end
}
