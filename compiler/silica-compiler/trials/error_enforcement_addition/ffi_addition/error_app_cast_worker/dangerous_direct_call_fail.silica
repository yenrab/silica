module dangerous_direct_call_fail;

use dangerous_legacy_stub;

fn ffi_worker_behavior(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[external_danger]
        _: int64 <- dangerous_legacy_stub@add(msg, state)
    produces
        pure (:no_reply, state)
    end
}

fn client_behavior(
    msg: int64,
    state: { worker: actor_ref }
) -> (:no_reply, { worker: actor_ref }) {
    _: int64 <- dangerous_legacy_stub@add(msg, 1);
    (:no_reply, state)
}

fn main() -> int64 {
    sequence proc[concurrency]
        worker_ref: dangerous_actor_ref <- spawn_dangerous(0, ffi_worker_behavior);
        client_ref: actor_ref <- spawn({ worker: worker_ref }, client_behavior)
    produces
        pure 0
    end
}
