// Supervisors plan Phase D (silica-specification.md §15.4.8.3): `spawn_linked` is a behavior-only
// intrinsic — the call site must be inside an actor behavior function so the runtime can resolve
// the current actor as the parent. Calling it from a non-behavior function (here `main` — no
// actor-self available) must fail type check with stable code E2091.

fn main() -> int64 {
    sequence proc[concurrency]
        child: actor_ref <- spawn_linked(0, main, :phase_d_noop)
    produces
        pure 0
    end
}
