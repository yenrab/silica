use btree_set_phase04;

fn compare_ok(left: int64, right: int64) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn main() -> int64 {
    set0: { compare_item: fn(int64, int64) -> :less | :equal | :greater } <- btree_set_phase04@empty({ compare_key: compare_ok });
    0
}
