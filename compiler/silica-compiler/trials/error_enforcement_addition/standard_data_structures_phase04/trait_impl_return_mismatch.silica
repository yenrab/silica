// Trait checker: impl fn return type must match required signature (E2092, spec §3.4.8).
export trait trait_impl_return_mismatch;
export size/1;

required {
    fn size(set: trait_impl_return_mismatch) -> int64;
}

impl fn size(set: { item_count: int64 }) -> boolean {
    true
}

fn main() -> int64 {
    0
}
