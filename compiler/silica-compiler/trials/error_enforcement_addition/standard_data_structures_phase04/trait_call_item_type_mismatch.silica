// Type checker: trait call item argument must match collection ItemType witness (E2017, spec §4).
export trait trait_call_item_type_mismatch;
export contains/2;

fn compare_string(left: string, right: string) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

required {
    fn contains(set: trait_call_item_type_mismatch, item: ItemType) -> boolean;
}

impl fn contains(
    set: { compare_item: fn(string, string) -> :less | :equal | :greater, item_count: int64 },
    item: string
) -> boolean {
    false
}

fn main() -> int64 {
    set0: { compare_item: fn(string, string) -> :less | :equal | :greater, item_count: int64 } <- {
        compare_item: compare_string,
        item_count: 0
    };
    trait_call_item_type_mismatch@contains(set0, 42)
}
