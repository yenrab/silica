// Error enforcement: function return List types must use mem(Space) (E2015).
fn empty_int64_list() -> List[int64] {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure xs
    end
}

fn main() -> int64 {
    empty_int64_list();
    0
}
