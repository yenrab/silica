// Phase 1 — invalid node id on add_edge_checked must return ok=0 (runtime enforcement, not compile failure).
use graph_adj_directed_unweighted_normal;

fn main() -> int64 {
    sequence proc[mem(normal)]
        g: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_empty(2);
        bad: { ok: int64, graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } } <- graph_adj_directed_unweighted_normal@graph_adj_directed_unweighted_normal_add_edge_checked(g, 2, 0);
        failures: int64 <- case bad.ok of {
            0 -> 0;
            _: int64 -> 1
        }
    produces
        pure failures
    end
}
