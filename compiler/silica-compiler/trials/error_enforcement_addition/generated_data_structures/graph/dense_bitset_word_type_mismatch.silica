// Error enforcement: DenseBitsetGraph words must be uint64 bit bags, not int64 cells.

use graph_dense_bitset_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        words: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            words: buf(L1, normal, int64, 4)
        } <- {
            region: r,
            node_count: 5,
            edge_count: 0,
            words: words
        };
        updated: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            words: buf(L1, normal, int64, 4)
        } <- graph_dense_bitset_directed@set_edge[mem(normal)](graph, 0, 1);
        result: int64 <- updated.edge_count
    produces
        pure result
    end
}
