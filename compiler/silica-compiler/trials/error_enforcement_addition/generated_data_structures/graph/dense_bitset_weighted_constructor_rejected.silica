// Error enforcement: DenseBitsetGraph is unweighted only; weighted constructor spelling must fail.

use graph_dense_bitset_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 4),
            weights: buf(L1, normal, int64, 4)
        } <- graph_dense_bitset_directed@empty[int64, mem(normal)](5);
        result: int64 <- graph.edge_count
    produces
        pure result
    end
}
