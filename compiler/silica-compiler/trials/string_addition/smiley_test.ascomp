.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X19, X1
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "🙂"
    .byte 0

