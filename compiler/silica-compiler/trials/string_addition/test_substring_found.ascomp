atom_12:
    .byte  0x3a, 0x6f, 0x6e, 0x65, 0x5f, 0x66, 0x6f, 0x72, 0x5f, 0x6f, 0x6e, 0x65, 0
atom_13:
    .byte  0x3a, 0x6f, 0x6e, 0x65, 0x5f, 0x66, 0x6f, 0x72, 0x5f, 0x61, 0x6c, 0x6c, 0
atom_14:
    .byte  0x3a, 0x72, 0x65, 0x73, 0x74, 0x5f, 0x66, 0x6f, 0x72, 0x5f, 0x6f, 0x6e, 0x65, 0
atom_15:
    .byte  0x3a, 0x69, 0x6e, 0x73, 0x65, 0x72, 0x74, 0
atom_16:
    .byte  0x3a, 0x6c, 0x6f, 0x6f, 0x6b, 0x75, 0x70, 0
atom_17:
    .byte  0x3a, 0x64, 0x65, 0x6c, 0x65, 0x74, 0x65, 0
atom_18:
    .byte  0x3a, 0x66, 0x6f, 0x75, 0x6e, 0x64, 0
atom_19:
    .byte  0x3a, 0x6e, 0x6f, 0x74, 0x5f, 0x66, 0x6f, 0x75, 0x6e, 0x64, 0
atom_20:
    .byte  0x3a, 0x75, 0x6e, 0x6b, 0x6e, 0x6f, 0x77, 0x6e, 0x5f, 0x6f, 0x70, 0
