.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    BL _silica_pid_registry_init
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X19, X1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X20, X1
    MOV X0, X19
    MOV X1, X20
    BL L_concat_helper
    MOV X21, X0
    MOV X0, X21
    ADRP X1, L_str_2@PAGE
    ADD X1, X1, L_str_2@PAGEOFF
    BL L_concat_helper
    MOV X22, X0
    MOV X1, X22
    ADRP X0, L_str_3@PAGE
    ADD X0, X0, L_str_3@PAGEOFF
    BL L_concat_helper
    MOV X23, X0
    MOV X0, X23
    ADRP X1, L_str_4@PAGE
    ADD X1, X1, L_str_4@PAGEOFF
    BL L_concat_helper
    MOV X24, X0
    MOV X0, X24
    ; effects [device_io]
    BL L_ps_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_5@PAGE
    ADD X1, X1, L_str_5@PAGEOFF
    MOV X2, #0

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0

    MOV X0, #2
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #21
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_ps_helper:
    MOV X9, X0
    MOV X2, #0
L_ps_loop:
    LDRB W1, [X0]
    CBZ W1, L_ps_do_write
    ADD X2, X2, #1
    ADD X0, X0, #1
    B L_ps_loop
L_ps_do_write:
    MOV X0, #1
    MOV X1, X9
    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    RET
L_concat_helper:
    STP X19, X20, [SP, #-48]!
    STP X21, X22, [SP, #16]
    STR X23, [SP, #32]
    MOV X19, X0
    MOV X20, X1
    MOV X21, #0
L_sc_len1:
    LDRB W9, [X0]
    CBZ W9, L_sc_len1_done
    ADD X21, X21, #1
    ADD X0, X0, #1
    B L_sc_len1
L_sc_len1_done:
    MOV X0, X20
    MOV X22, #0
L_sc_len2:
    LDRB W9, [X0]
    CBZ W9, L_sc_len2_done
    ADD X22, X22, #1
    ADD X0, X0, #1
    B L_sc_len2
L_sc_len2_done:
    ADD X0, X21, X22
    ADD X0, X0, #1
    MOV X1, X0
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    MOV X23, X0
    MOV X9, X23
    MOV X10, X19
    MOV X11, X21
L_sc_cp1:
    CBZ X11, L_sc_cp1_done
    LDRB W12, [X10]
    STRB W12, [X9]
    ADD X9, X9, #1
    ADD X10, X10, #1
    SUB X11, X11, #1
    B L_sc_cp1
L_sc_cp1_done:
    MOV X10, X20
    MOV X11, X22
L_sc_cp2:
    CBZ X11, L_sc_cp2_done
    LDRB W12, [X10]
    STRB W12, [X9]
    ADD X9, X9, #1
    ADD X10, X10, #1
    SUB X11, X11, #1
    B L_sc_cp2
L_sc_cp2_done:
    STRB WZR, [X9]
    MOV X0, X23
    LDR X23, [SP, #32]
    LDP X21, X22, [SP, #16]
    LDP X19, X20, [SP], #48
    RET
