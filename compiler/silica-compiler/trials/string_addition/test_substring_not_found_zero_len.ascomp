.text
.global main


main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    MOV X1, #0
    MOV X2, #0
    BL L_substring_helper

    ; effects [device_io]
    BL L_ps_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #0
    LDP X29, X30, [SP], #16
    RET
L_ps_helper:
    MOV X9, X0
    MOV X2, #0
L_ps_loop:
    LDRB W1, [X0]
    CBZ W1, L_ps_do_write
    ADD X2, X2, #1
    ADD X0, X0, #1
    B L_ps_loop
L_ps_do_write:
    MOV X0, #1
    MOV X1, X9
    MOV X16, #4
    SVC #0x80
    RET
L_substring_helper:
    STP X19, X20, [SP, #-64]!
    STP X21, X22, [SP, #16]
    STP X23, X14, [SP, #32]
    STR X15, [SP, #48]
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2
    CMP X20, #0
    CSEL X20, XZR, X20, LT
    CMP X21, #0
    CSEL X21, XZR, X21, LT
    MOV X9, X19
    MOV X22, #0
L_ss_len:
    LDRB W10, [X9]
    CBZ W10, L_ss_len_done
    ADD X22, X22, #1
    ADD X9, X9, #1
    B L_ss_len
L_ss_len_done:
    MOV X9, #0
    MOV X14, #0
L_ss_find_start:
    CMP X14, X20
    B.GE L_ss_start_found
    CMP X9, X22
    B.GE L_ss_start_found
    LDRB W10, [X19, X9]
    CMP W10, #0x80
    B.LO L_ss_adv1
    CMP W10, #0xC2
    B.LO L_ss_adv1
    CMP W10, #0xE0
    B.LO L_ss_adv2
    CMP W10, #0xF0
    B.LO L_ss_adv3
    CMP W10, #0xF8
    B.LO L_ss_adv4
L_ss_adv1:
    ADD X9, X9, #1
    ADD X14, X14, #1
    B L_ss_find_start
L_ss_adv2:
    SUB X18, X22, X9
    MOV X17, #2
    CMP X18, #2
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_start
L_ss_adv3:
    SUB X18, X22, X9
    MOV X17, #3
    CMP X18, #3
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_start
L_ss_adv4:
    SUB X18, X22, X9
    MOV X17, #4
    CMP X18, #4
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_start
L_ss_start_found:
    MOV X23, X9
L_ss_find_end:
    CMP X14, X21
    B.GE L_ss_end_found
    CMP X9, X22
    B.GE L_ss_end_found
    LDRB W10, [X19, X9]
    CMP W10, #0x80
    B.LO L_ss_eadv1
    CMP W10, #0xC2
    B.LO L_ss_eadv1
    CMP W10, #0xE0
    B.LO L_ss_eadv2
    CMP W10, #0xF0
    B.LO L_ss_eadv3
    CMP W10, #0xF8
    B.LO L_ss_eadv4
L_ss_eadv1:
    ADD X9, X9, #1
    ADD X14, X14, #1
    B L_ss_find_end
L_ss_eadv2:
    SUB X18, X22, X9
    MOV X17, #2
    CMP X18, #2
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_end
L_ss_eadv3:
    SUB X18, X22, X9
    MOV X17, #3
    CMP X18, #3
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_end
L_ss_eadv4:
    SUB X18, X22, X9
    MOV X17, #4
    CMP X18, #4
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_end
L_ss_end_found:
    CMP X23, X22
    CSEL X23, X22, X23, GT
    CMP X9, X23
    CSEL X9, X23, X9, LO
    CMP X9, X22
    CSEL X9, X22, X9, GT
    SUB X11, X9, X23
    CBZ X11, L_ss_empty
    ADD X0, X11, #1
    MOV X1, X0
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    MOV X15, X0
    MOV X9, X15
    ADD X10, X19, X23
    MOV X12, X11
L_ss_cp:
    CBZ X12, L_ss_cp_done
    LDRB W13, [X10]
    STRB W13, [X9]
    ADD X9, X9, #1
    ADD X10, X10, #1
    SUB X12, X12, #1
    B L_ss_cp
L_ss_cp_done:
    STRB WZR, [X9]
    MOV X0, X15
    B L_ss_ret
L_ss_empty:
    MOV X0, #1
    MOV X1, X0
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    STRB WZR, [X0]
L_ss_ret:
    LDR X15, [SP, #48]
    LDP X23, X14, [SP, #32]
    LDP X21, X22, [SP, #16]
    LDP X19, X20, [SP], #64
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "abc"
    .byte 0
L_str_1:
    .ascii ""
    .byte 0
L_str_2:
    .ascii "\n"
    .byte 0

L_newline:
    .byte 10

