.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    STR X0, [SP, #-16]!
    BL L_length_bytes_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X0, X12

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_length_bytes_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    CBZ X19, Llb_z
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Llb_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Llb_cstr
    LDR X21, [X0, #8]
    LDR X22, [X0, #16]
    MOV X2, #0x40000000
    CMP X22, X2
    B.HS Llb_cstr
    MOV X0, X22
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_cstr:
    MOV X21, X0
    MOV X22, #0
    MOV X1, X0
Llb_lp:
    LDRB W3, [X1], #1
    CBZ W3, Llb_done
    ADD X22, X22, #1
    CMP X22, #0x100000
    B.LT Llb_lp
Llb_done:
    MOV X0, X22
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Llb_z:
    MOV X0, #0
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

