// =============================================================================
// Phase B — Supervision ingress + scheduler ordering (synthetic ordering trial)
// supervisors_implementation_development_plan.md §4 Phase B; silica-spec §15.4.9, §16.2.7
//
// Exit criteria (authoritative):
//   Flood the supervisor’s *standard* mailbox; inject a *synthetic* exit notification
//   (or equivalent trusted-runtime hook); the supervisor behavior must observe the
//   exit path *before* processing any backlog `cast` traffic (ordering invariant).
//
// Intended protocol (when runtime + language surface are complete):
//   1) Start a supervisor actor that has supervision ingress allocated (e.g. after
//      `spawn_linked` / `Supervisor` trait init per §15.4.9.2).
//   2) From the test driver, enqueue many `cast(supervisor, tag_k)` messages so the
//      standard FIFO holds a backlog (flood).
//   3) Inject exactly one synthetic exit notification into the supervision ingress
//      (trusted runtime / trial hook — *not* a user `cast`). Alternatively terminate
//      the linked child via `remove_actor(child)` once the child `actor_ref` is
//      observable, which must enqueue the real exit notification (Phase C).
//   4) PASS: On the next scheduling turn(s), the behavior runs the ingress/exit
//      handler before any handler for the queued `cast` messages (drain ingress
//      before standard mailbox, §15.4.9.4).
//
// Observability (for a future `.scout` golden):
//   - Emit a deterministic line when handling an ingress exit notification (e.g.
//     "EXIT_INGRESS") before any line emitted for cast backlog (e.g. "CAST n").
//
// Harness notes:
//   - Synthetic injection is intentionally outside user Silica (runtime test API).
//   - Persisting `spawn_linked` child across messages requires supervisor state that
//     carries `actor_ref` (tuple/record state or `init`-spawned children); this file
//     uses the same single-invocation shape as phase_a_supervisor_spawn_linked.silica
//     as a *scaffold* until that surface is available — see comments in main.
//
// Do not compile this trial in automation until the above pieces land; integrate
// manually when ready (Makefile integrate / .scout).
// =============================================================================

use SupervisorPhaseA;

fn child_worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

// Supervisor behavior: Phase A-style scaffold (each invocation runs spawn_linked).
// For a real Phase B pass/fail signal, replace with one spawn + child_ref in state
// so casts only enqueue work and do not respawn children; then add match/case on
// supervision ingress vs ActorMessage (§15.4.9.3) when exit types are available.
fn parent_supervisor(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        child: actor_ref <- spawn_linked(0, child_worker, :phase_b_worker);
        sum: int64 <- call(child, msg impl ActorMessage {});
        print_string("sum: ");
        _: atom <- print_int64(sum);
        println("")
    produces
        pure (:reply, sum, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: actor_ref <- spawn(0, parent_supervisor);
        // --- Flood standard mailbox (casts) ------------------------------------
        // Each cast is async; with a persistent supervisor + child, these queue
        // behind each other in FIFO order. Expand/unroll to stress backlog depth.
        _: boolean <- cast(sup, 1 impl ActorMessage {});
        _: boolean <- cast(sup, 2 impl ActorMessage {});
        _: boolean <- cast(sup, 3 impl ActorMessage {});
        _: boolean <- cast(sup, 4 impl ActorMessage {});
        _: boolean <- cast(sup, 5 impl ActorMessage {});
        _: boolean <- cast(sup, 6 impl ActorMessage {});
        _: boolean <- cast(sup, 7 impl ActorMessage {});
        _: boolean <- cast(sup, 8 impl ActorMessage {});
        _: boolean <- cast(sup, 9 impl ActorMessage {});
        _: boolean <- cast(sup, 10 impl ActorMessage {});
        _: boolean <- cast(sup, 11 impl ActorMessage {});
        _: boolean <- cast(sup, 12 impl ActorMessage {});
        // --- Synthetic exit / child termination (harness insertion point) --------
        // Insert here (trial driver or runtime hook), *after* casts are queued:
        //   - _silica_rt_trial_inject_supervision_exit(supervisor, child_ref);  // synthetic
        //   - or remove_actor(child_ref) once child_ref is in scope (Phase C path)
        // Ordering assertion: supervisor must observe ingress exit before draining
        // the cast backlog above (§15.4.9.4).
        // -------------------------------------------------------------------------
        out: int64 <- call(sup, 40 impl ActorMessage {});
        print_int64(out);
        println("")
    produces
        pure out
    end
}
