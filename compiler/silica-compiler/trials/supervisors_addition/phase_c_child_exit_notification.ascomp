main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X9, #0
    ADRP X8, sup_beh@PAGE
    ADD X8, X8, sup_beh@PAGEOFF
    MOV X10, X8

    MOV X3, XZR
    MOV X0, X9
    MOV X1, X10
    MOV W2, WZR
    BL _silica_rt_actor_spawn

    MOV X19, X0
    MOV X9, X19
    MOV X10, #1
    MOV X0, X9
    MOV X1, X10
    BL _silica_rt_actor_call

    MOV X20, X0
    BL _silica_rt_wait_for_exit
    MOV X21, X0
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pi_helper:
    SUB SP, SP, #32
    MOV X10, SP
    ADD X10, X10, #24
    MOV X11, #0
    CMP X0, #0
    B.ge L_pi_pos
    MOV X11, #1
    NEG X0, X0
L_pi_pos:
    MOV X8, X10
    CMP X0, #0
    B.eq L_pi_zero
    MOV X9, #10
L_pi_loop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pi_loop
    B L_pi_maybe_neg
L_pi_zero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pi_maybe_neg:
    CBNZ X11, L_pi_prepend_minus
    B L_pi_do_write
L_pi_prepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pi_do_write:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    ADD SP, SP, #32
    RET
