    CMP X21, #0
    CSEL X21, XZR, X21, LT
    LDRB W10, [X19]
    CMP W10, #0xFF
    B.NE L_ss_lit_base
    LDR X8, [X19, #8]
    LDR X22, [X19, #16]
    B L_ss_len_done
L_ss_lit_base:
