sup_beh:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    MOV X19, X0
    MOV X21, X1
    MOV X20, X2

    MOV X9, #0
    MOV X11, X9
    ADRP X9, failer_a@PAGE
    ADD X9, X9, failer_a@PAGEOFF

    STR X9, [X20, #0]
    MOV X9, #18
    STR X9, [X20, #8]
    MOV X10, X20
    MOV X4, XZR
    MOV X0, X11
    LDR X1, [X10]
    LDR X2, [X10, #8]
    MOV X3, XZR
    BL _silica_rt_actor_spawn_linked

    MOV X22, X0
    MOV X9, #0
    MOV X11, X9
    ADRP X9, failer_b@PAGE
    ADD X9, X9, failer_b@PAGEOFF

    STR X9, [X20, #0]
    MOV X9, #19
    STR X9, [X20, #8]
    MOV X10, X20
    MOV X4, XZR
    MOV X0, X11
    LDR X1, [X10]
    LDR X2, [X10, #8]
    MOV X3, XZR
    BL _silica_rt_actor_spawn_linked

    MOV X23, X0
    MOV X9, #0
    MOV X11, X9
    ADRP X9, failer_c@PAGE
    ADD X9, X9, failer_c@PAGEOFF

    STR X9, [X20, #0]
    MOV X9, #20
    STR X9, [X20, #8]
    MOV X10, X20
    MOV X4, XZR
    MOV X0, X11
    LDR X1, [X10]
    LDR X2, [X10, #8]
    MOV X3, XZR
    BL _silica_rt_actor_spawn_linked

    MOV X24, X0
    MOV X9, X22
    MOV X0, X9
    BL _silica_rt_remove_actor
    BL _silica_rt_actor_supervision_wait_and_drain_one
    MOV X25, X0
    MOV X9, X25
    MOV X0, X9
    BL _silica_rt_actor_failure_release
    MOV X9, X23
    MOV X0, X9
    BL _silica_rt_remove_actor
    BL _silica_rt_actor_supervision_wait_and_drain_one
    MOV X26, X0
    MOV X9, X26
    MOV X0, X9
    BL _silica_rt_actor_failure_release
    MOV X9, X24
    MOV X0, X9
    BL _silica_rt_remove_actor
    BL _silica_rt_actor_supervision_wait_and_drain_one
    MOV X27, X0
    MOV X9, X27
    MOV X0, X9
    BL _silica_rt_actor_failure_release
    MOV X9, #15
    STR X9, [X20, #0]
    MOV X9, #0
    STR X9, [X20, #8]
    MOV X9, X21
    STR X9, [X20, #16]
    MOV X0, X20
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

f9_full_fr_beh:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X0, #0
    MOV X21, X0
    MOV X0, X21
    MOV X1, X19

    ; effects []|sir_rec:o2207|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, handle_report@PAGE
    ADD X9, X9, handle_report@PAGEOFF
    BLR X9
    SUB SP, SP, #32
    MOV X9, #15
    STR X9, [SP, #0]
    MOV X9, #0
    STR X9, [SP, #8]
    MOV X9, X20
    STR X9, [SP, #16]
    MOV X0, SP
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #32
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #32

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X9, #0
    ADRP X10, f9_full_fr_beh@PAGE
    ADD X10, X10, f9_full_fr_beh@PAGEOFF

    MOV X3, XZR
    MOV X0, X9
    MOV X1, X10
    MOV W2, WZR
    BL _silica_rt_actor_spawn

    MOV X19, X0
    MOV X9, X19
    SUB SP, SP, #16
    STR X9, [SP, #0]
    BL region_dump_limit
    BL _silica_rt_failure_reporter_set_dump_limit
    LDR X9, [SP, #0]
    ADD SP, SP, #16
    MOV X0, X9
    BL _silica_rt_failure_reporter_register
    MOV X9, #0
    ADRP X10, sup_beh@PAGE
    ADD X10, X10, sup_beh@PAGEOFF

    MOV X3, XZR
    MOV X0, X9
    MOV X1, X10
    MOV W2, WZR
    BL _silica_rt_actor_spawn

    MOV X20, X0
    MOV X9, X20
    MOV X10, #1
    MOV X0, X9
    MOV X1, X10
    BL _silica_rt_actor_cast

    MOV X21, X0
    BL _silica_rt_wait_for_exit
    MOV X22, X0
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_ps_helper_stderr:
    MOV X9, X0
    MOV X2, #0
L_ps_se_loop:
    LDRB W1, [X0]
    CBZ W1, L_ps_se_do_write
    ADD X2, X2, #1
    ADD X0, X0, #1
    B L_ps_se_loop
L_ps_se_do_write:
    MOV X0, #2
    MOV X1, X9
    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    RET
L_list_length_helper:
    MOV X4, X0
    MOV X3, X2
    MOV X0, #0
L_list_len_loop:
    CBZ X4, L_list_len_done
    ADD X0, X0, #1
    ADD X5, X4, X3
    LDR X4, [X5]
    B L_list_len_loop
L_list_len_done:
    RET

