.text
    ; use FailureReporter
    ; marker_impl F9FullDumpFr for FailureReporter
    ; supervisors Phase F: root FailureReporter metadata (impl_failure_reporter actor type; §15.4.13.4)
    ; impl_failure_reporter F9FullDumpFr
.global main


region_dump_limit:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X0, #2048
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

handle_report:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X0, X20
    ; effects [device_io]
    BL L_ps_helper_stderr
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #2
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #2
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0

    MOV X0, #2
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

failer_a:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    MOV X21, X1
    MOV X20, X2

    MOV X9, #15
    STR X9, [X20, #0]
    MOV X9, X19
    MOV X10, X21


    ADD X9, X9, X10
    STR X9, [X20, #8]
    MOV X9, X21
    MOV X10, X19


    ADD X9, X9, X10
    STR X9, [X20, #16]
    MOV X0, X20
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

failer_b:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    MOV X21, X1
    MOV X20, X2

    MOV X9, #15
    STR X9, [X20, #0]
    MOV X9, X19
