    MOV X0, X20
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

failer_c:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    MOV X21, X1
    MOV X20, X2

    MOV X9, #15
    STR X9, [X20, #0]
    MOV X9, X19
    MOV X10, X21


    ADD X9, X9, X10
    STR X9, [X20, #8]
    MOV X9, X21
    MOV X10, X19


    ADD X9, X9, X10
    STR X9, [X20, #16]
    MOV X0, X20
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
