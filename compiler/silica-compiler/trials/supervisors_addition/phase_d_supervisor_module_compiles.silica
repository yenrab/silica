// Phase D supervisor trial upgraded (Phase E task e1f) to the canonical init signature:
// impl PhaseDSup for Supervisor and fn init(state: ActorState) returning supervisor_flags
// paired with a List of child_spec entries (terminated by normal) must type-check, and the
// emitter must still record the impl_supervisor PhaseDSup runtime metadata (supervisors
// plan Phase D). Phase E consumes this init body to populate the static child table that
// the runtime walks in _silica_rt_supervisor_start (supervisors plan Phase E e2 and e3).

use Supervisor;

impl PhaseDSup for Supervisor;

fn phase_d_worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        normal
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 };
        child: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :phase_d_worker,
            agent_type: :worker,
            start: (0, phase_d_worker),
            restart: :permanent,
            shutdown: 0
        };
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            normal
        ] <- [child]
    produces
        pure (flags, children)
    end
}

fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- print_string("phase_d");
        _: atom <- println("")
    produces
        pure 0
    end
}
