// *** VERY IMPORTANT — NOT A PRODUCTION PATTERN ***
// Starting children and other logic shown in a supervisor's spawned behavior in this trial tree
// (for example `spawn_linked`, `start_child`, and related orchestration in the behavior body) is only for
// testing the runtime. Do not copy that style in production. In production, add supervised children through
// the supervisor `init` callback (declarative child list) and/or have other actors create children using
// the proper supported APIs — not by mirroring these trial-only behaviors.
//
// Phase E e4f (supervisors_implementation_development_plan.md §0): `:rest_for_one` cascade restart.
// Three supervised children in stable table order: one declarative from `init`, then two via `start_child`
// in `sup_beh` (same pattern as e4e — avoids multi-`child_spec` list literal codegen issues). Row indices are
// 0, 1, 2. When row **1** dies abnormally, runtime kills row **2** then respawns rows **1** and **2**; row **0**
// stays alive with the same initial state.
//
// `spec3` is bound only after the first `start_child(spec2)` so the two stack `child_spec` records cannot alias
// (see e4b register/stack note).
//
// Each worker has initial state slots 10, 20, 30 so `call(_, 1)` yields 11, 21, 31 before the failure. After two
// ingress drains (abnormal tag 1 then 0 on the cascade-killed child), row 0 still gives 11; respawned rows 1
// and 2 again give 21 and 31 (`child_table_row_ref` / table order §15.4.13.3). Row 0 uses `child_table_first_ref`
// (same as e4e) so the behavior does not keep an extra actor_ref live across drains — that pressure caused the
// emitter to pass a bogus handle to `failure_release` (integrate: lock corruption / bus error).
//
// Output sequence: `11, 21, 31, about_to_kill, after_kill, done` (same `main`/`done` pattern as e4e).
//
// Flake hunting (lldb): `br set -n _silica_rt_cv_wait`, run, `thread until` / single-step across `bl ___ulock_wait`.
// Do not insert a literal `nop` after that `bl` in the emitted asm — on arm64e it consistently SIGBUS here (PAC?).
// Stress A/B: plain ldr/str for reply (+144) / reply_set (+136) stayed 1000/1000 clean; dmb / stlr+ldar increased failures.

use Supervisor;

impl E4fSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        normal
    ]
) {
    sequence proc[mem(normal)]
        child: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4f_w1,
            agent_type: :worker,
            start: (10, worker),
            restart: :permanent,
            shutdown: 0
        };
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            normal
        ] <- [child]
    produces
        pure (
            { strategy: :rest_for_one, allowed_restart_count: 5, restarts_time_frame: 60 },
            children
        )
    end
}

fn sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        spec2: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4f_w2,
            agent_type: :worker,
            start: (20, worker),
            restart: :permanent,
            shutdown: 0
        };
        r1: actor_ref <- start_child(spec2);
        spec3: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4f_w3,
            agent_type: :worker,
            start: (30, worker),
            restart: :permanent,
            shutdown: 0
        };
        r2: actor_ref <- start_child(spec3);
        print_int64(call(child_table_first_ref(), 1 impl ActorMessage {})); println("");
        print_int64(call(r1, 1 impl ActorMessage {})); println("");
        print_int64(call(r2, 1 impl ActorMessage {})); println("");
        print_string("about_to_kill"); println("");
        _: atom <- kill_abnormal(r1);
        print_string("after_kill"); println("");
        _: atom <- print_string("done");
        _: atom <- println("")
    produces
        pure (:reply, 0, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: actor_ref <- spawn(0, sup_beh);
        _: int64 <- call(sup, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
