// Phase F5 (supervisors_implementation_development_plan.md §4 Phase F — subphase F5):
// **Path coverage + stderr fallback:** linked child death always runs `_silica_rt_actor_deliver_unwind_report`
// from `actor_thread_main` teardown (`LBB1_exit`) **after** `_silica_rt_actor_deliver_exit`, independent of whether
// ingress delivery succeeded (Phase C). When no root `FailureReporter` is registered (`register_failure_reporter`
// never called), `_silica_rt_root_failure_reporter == 0` and the unwind routine writes the formatted failure block
// to **stderr** (same buffer as the FR cast path). integrate captures `2>&1`, so the block appears in **stdout**.
//
// This trial does **not** call `register_failure_reporter`. Expected: Phase C-style ingress lines **plus** the
// `=== Silica Actor Failure ===` banner (and footer) merged into the capture.
//
// Compare: `phase_f_failure_reporter_cast_alignment.silica` registers an FR so unwind is cast to that actor when
// alive (stderr path skipped on success).
//
// `main` uses `wait_for_exit/0`. Integrate sends `exit` on stdin after the supervisor prints a full line `done`
// (see `run_integration_exit_after_marker.py`), so an immediate here-doc does not race a root **cast**. For a
// manual run, use `printf 'exit\\n' | …` (or type exit) after output settles if the root stays alive.

fn child_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        child: actor_ref <- spawn_linked(0, child_beh, :phase_f5_child);
        _: atom <- remove_actor(child);
        payload: int64 <- supervision_wait_and_drain_one();
        at: atom <- failure_agent_type(payload);
        _: atom <- print_atom(at);
        println("");
        tag: int64 <- failure_reason_tag(payload);
        print_int64(tag); println("");
        _: atom <- failure_release(payload);
        _: atom <- print_string("done");
        _: atom <- println("")
    produces
        pure (:reply, 0, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: actor_ref <- spawn(0, sup_beh);
        _: boolean <- cast(sup, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
