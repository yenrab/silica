// Phase E e4b-cap-breach (E6.1 — declarative only): same cap policy as before, but both `:transient`
// workers come from `init` (no `start_child`).

use Supervisor;

impl E4bCapBreach for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        c0: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4b_w0,
            agent_type: :worker,
            start: (0, worker),
            restart: :transient,
            shutdown: 0
        };
        c1: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4b_w1,
            agent_type: :worker,
            start: (0, worker),
            restart: :transient,
            shutdown: 0
        };
        nil: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- empty[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ]();
        tail: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- prepend[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ](c1, nil);
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- prepend[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ](c0, tail)
    produces
        pure (
            { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 5 },
            children
        )
    end
}

fn sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        ch1: actor_ref <- child_table_first_ref();
        print_string("about_to_call"); println("");
        a: int64 <- call(ch1, 100 impl ActorMessage {});
        print_int64(a); println("");
        print_string("about_to_remove"); println("");
        _: atom <- remove_actor(ch1);
        print_string("about_to_drain"); println("");
        p1: int64 <- supervision_wait_and_drain_one();
        t1: int64 <- failure_reason_tag(p1);
        print_int64(t1); println("");
        print_string("about_to_release"); println("");
        _: atom <- failure_release(p1);
        print_string("about_to_next_live_child"); println("");
        ch2: actor_ref <- child_table_first_ref();
        print_string("about_to_call_child"); println("");
        b: int64 <- call(ch2, 200 impl ActorMessage {});
        print_int64(b); println("");
        _: atom <- kill_abnormal(ch2);
        print_string("about_to_drain_one"); println("");
        p2: int64 <- supervision_wait_and_drain_one();
        exit_payload: int64 <- p2;
        t2: int64 <- failure_reason_tag(exit_payload);
        reason: atom <- failure_release(exit_payload);
        print_string("about_to_failure_reason_tag"); println("");
        print_int64(t2); println("");
        print_string("about_to_print_reason"); println("");
        print_atom(reason); println("");
        print_string("about_to_skip_child_call_after_cap_breach"); println("");
        print_string("about_to_cap_breach_tail"); println("")
    produces
        pure (:reply, 0, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: actor_ref <- spawn(0, sup_beh);
        _: int64 <- call(sup, 1 impl ActorMessage {});
        print_string("about_to_wait_for_exit"); println("");
        _: int64 <- wait_for_exit();
        print_string("about_to_print_done"); println("");
        print_string("done"); println("")
    produces
        pure 0
    end
}
