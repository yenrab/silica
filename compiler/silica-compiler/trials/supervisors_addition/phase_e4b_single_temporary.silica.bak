
use Supervisor;

impl E4aSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        child: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4a_worker,
            agent_type: :worker,
            start: (0, worker),
            restart: :temporary,
            shutdown: 0
        };
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- [child]
    produces
        // Inline flags record so tuple_make uses record_make + value-flat copy (materialize +0/+8/+16/+24).
        // A separate `flags` binding becomes a var in tuple_make and would store a stack pointer in the heap tuple.
        pure (
            { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 },
            children
        )
    end
}

fn sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        ch: actor_ref <- child_table_first_ref();
        a: int64 <- call(ch, 100 impl ActorMessage {});
        print_int64(a); println("");
        b: int64 <- call(ch, 200 impl ActorMessage {});
        print_int64(b); println("");
        _: atom <- remove_actor(ch);
        payload: int64 <- supervision_wait_and_drain_one();
        at: atom <- failure_agent_type(payload);
        _: atom <- print_atom(at); println("");
        tag: int64 <- failure_reason_tag(payload);
        print_int64(tag); println("");
        _: atom <- failure_release(payload);
        // A :temporary child is never restarted, so the first row should now be a tombstone.
        row0: int64 <- child_table_row_ref(0);
        _: atom <- case row0 == 0 of {
            true -> print_string("actor_not_found")
            false -> print_string("unexpected_restart")
        };
        _: atom <- println("");
        _: atom <- print_string("done");
        _: atom <- println("")
    produces
        pure (:reply, 0, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: actor_ref <- spawn(0, sup_beh);
        _: boolean <- cast(sup, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
