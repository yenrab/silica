// Phase E cap test (single supervisor, no explicit drain):
// with restart cap 0, one abnormal child death should exceed the root supervisor cap.

use Supervisor;

impl PhaseECapZeroNoDrainSup for Supervisor;

fn init(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 0, restarts_time_frame: 3600 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(msg: int64, state: int64) -> (:reply, int64, int64),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- [
            { id: :cap_leaf_worker, agent_type: :worker, initial_state: 7, behavior: noop_worker, restart: :permanent, shutdown: 0 },
            { id: :cap_pulser, agent_type: :worker, initial_state: 0, behavior: kill_worker_beh, restart: :permanent, shutdown: 0 }
        ]
    produces
        pure (flags, children)
    end
}

fn kill_worker_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        _: atom <- kill_abnormal(:cap_leaf_worker)
    produces
        pure (:reply, msg, state)
    end
}

fn noop_worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: supervisor_ref <- spawn_registered_supervisor(PhaseECapZeroNoDrainSup, 400, :phase_e_cap_zero_no_drain_sup);
        call_registered(:cap_pulser, 0 impl ActorMessage {});
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
