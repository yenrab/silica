// Phase I — supervisors_implementation_development_plan.md §4: blocking wait_for_exit/0 from main (stdin "exit"
// or first root supervisor death). Integrate sends the exit line via run_integration_binary.sh so main returns cleanly.

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
