use Supervisor;
use NestedTransientAbnormalChildSupervisor;

impl E4hNestedTransientAbnormalRoot for Supervisor;

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        child: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4h_nested_transient_abnormal_child_supervisor,
            agent_type: :nested_transient_abnormal_child_supervisor,
            start: (0, NestedTransientAbnormalChildSupervisor@nested_transient_abnormal_child_sup_beh),
            restart: :transient,
            shutdown: 0
        };
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- [child]
    produces
        pure (
            { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 },
            children
        )
    end
}

fn sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        child_sup: actor_ref <- child_table_first_ref();
        a: int64 <- call(child_sup, 100 impl ActorMessage {});
        print_int64(a); println("");
        b: int64 <- call(child_sup, 200 impl ActorMessage {});
        print_int64(b); println("");
        _: atom <- kill_abnormal(child_sup);
        payload: int64 <- supervision_wait_and_drain_one();
        at: atom <- failure_agent_type(payload);
        _: atom <- print_atom(at); println("");
        tag: int64 <- failure_reason_tag(payload);
        print_int64(tag); println("");
        _: atom <- failure_release(payload);
        child_sup2: actor_ref <- child_table_first_ref();
        c: int64 <- call(child_sup2, 300 impl ActorMessage {});
        print_int64(c); println("");
        _: atom <- print_string("nested_transient_abnormal_restart");
        _: atom <- println("");
        _: atom <- print_string("done");
        _: atom <- println("")
    produces
        pure (:reply, 0, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: actor_ref <- spawn(0, sup_beh);
        _: int64 <- call(sup, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
