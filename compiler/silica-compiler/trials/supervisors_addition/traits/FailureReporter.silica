/// FailureReporter trait — silica-specification.md §15.4.13.4 (`FailureReporter`).
/// Trial-local copy so supervisor trials can satisfy `impl … for FailureReporter` alongside
/// `export trait FailureReporter` metadata (implements §15.4.13.4 required method shapes).
///
/// Surface matches `type_checker_failure_reporter` / `module_checker` validation (canonical
/// parameter spelling: `string`, lowercase `bytes`; list form normalized after whitespace deletion).

export trait FailureReporter;

required {
    fn region_dump_limit() -> int;

    // `collect_params_loop` builds `ListParam` via `cons_param`, so `parameters.head` is the *last* formal in
    // source → put `report: string` after `region_dumps` so metadata matches spec order (§15.4.13.4).
    fn handle_report(dumps: List[(atom, bytes), mem(normal)], rep: string) -> :ok;
}
