use Supervisor;

export nested_transient_normal_child_sup_beh/2;

impl NestedTransientNormalChildSupervisor for Supervisor;

fn nested_transient_normal_child_worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        child: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4h_nested_transient_normal_worker,
            agent_type: :worker,
            start: (0, nested_transient_normal_child_worker),
            restart: :permanent,
            shutdown: 0
        };
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- [child]
    produces
        pure (
            { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 },
            children
        )
    end
}

fn nested_transient_normal_child_sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        worker_ref: actor_ref <- child_table_first_ref();
        result: int64 <- call(worker_ref, msg impl ActorMessage {})
    produces
        pure (:reply, result, state)
    end
}
