/// Supervisor trait — silica-specification.md §15.4.13 (Supervisor Trait).
/// Trial copy of stdlib `Supervisor.silica`, exercised by Phase D supervisor_module_compiles trial.
///
/// Required callback (§15.4.13.1): `init` takes the supervisor actor's state (`ActorState`) and
/// returns supervisor restart flags plus the static child list; the runtime spawns each entry via
/// `spawn_linked` (§15.4.8.3) and applies `supervisor_flags` (§15.4.13.2) — handled by Phase E.
///
/// Supporting shapes (§15.4.13.2 BNF) inlined in the signature below:
/// - `supervisor_flags`: `strategy`, `allowed_restart_count`, `restarts_time_frame` (seconds).
/// - `restart_strategy`: `:one_for_one` | `:one_for_all` | `:rest_for_one`.
/// - `child_spec`: `id`, `agent_type`, `start` (same pair as `spawn_linked`'s initial state and
///   behavior function, §15.4.8.3), `restart`, `shutdown` (0 = immediate; >0 = ms timeout).
///
/// Each child's behavior must use a single reply convention throughout (§15.1); the `start`
/// function type below uses the cast-only `(:no_reply, …)` form.

export trait Supervisor;
export init/1;

required {
    fn init(initial_supervisor_state: ActorState) -> (
        {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        },
        List[
            {
                id: atom,
                agent_type: atom,
                start: (
                    ActorState,
                    fn(msg: ActorMessage, state: ActorState) -> (:no_reply, ActorState)
                ),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
                | mem(normal_writeback)
                | mem(normal_writethrough)
                | mem(normal_noncacheable)
                | mem(atomic)
                | mem(device)
        ]
    );
}
