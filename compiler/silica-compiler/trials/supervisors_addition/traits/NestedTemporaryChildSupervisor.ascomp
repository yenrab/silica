.text
    ; use Supervisor
.global nested_temporary_child_sup_beh
    ; marker_impl NestedTemporaryChildSupervisor for Supervisor
    ; supervisors Phase D: runtime supervisor metadata follows (impl_supervisor actor types; §15.4.13)
    ; impl_supervisor NestedTemporaryChildSupervisor
    ; supervisors Phase E: declarative children / automatic restart (supervisor_phase_e init SIR; §15.4.12–§15.4.13.2)
    ; supervisor_phase_e NestedTemporaryChildSupervisor init_returns ({strategy : :one_for_one | :one_for_all | :rest_for_one , allowed_restart_count : int64 , restarts_time_frame : int64 },List [ { id : atom , agent_type : atom , start : ( int64 , fn ( msg : int64 , state : int64 ) -> ( :reply , int64 , int64 ) ) , restart : :permanent | :temporary | :transient , shutdown : int64 } , mem ( normal ) ])
    ; supervisors Phase E (e3b): per-impl start trampolines (calls init + materialize children)
.globl _silica_supervisor_start_NestedTemporaryChildSupervisor
.p2align 2
_silica_supervisor_start_NestedTemporaryChildSupervisor:
    STP X20, X19, [SP, #-32]!
    STP X29, X30, [SP, #16]
    ADD X29, SP, #16
    MOV X19, X0
    SUB SP, SP, #32
    MOV X8, SP
    LDR X0, [X19]
    BL init
    MOV X1, X0
    MOV X0, X19
    BL _silica_rt_supervisor_materialize_init_children
    ADD SP, SP, #32
    LDP X29, X30, [SP, #16]
    LDP X20, X19, [SP], #32
    RET


nested_temporary_child_worker:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    MOV X21, X1
    MOV X20, X2

    MOV X9, #8
    STR X9, [X20, #0]
    MOV X9, X19
    MOV X10, X21


    ADD X9, X9, X10
    STR X9, [X20, #8]
    MOV X9, X21
    STR X9, [X20, #16]
    MOV X0, X20
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

init:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #48
    MOV X9, #9
    STR X9, [SP, #0]
    MOV X9, #10
    STR X9, [SP, #8]
    MOV X9, #0
    STR X9, [SP, #16]
    ADRP X10, nested_temporary_child_worker@PAGE
    ADD X10, X10, nested_temporary_child_worker@PAGEOFF
    STR X10, [SP, #24]

    MOV X9, #2
    STR X9, [SP, #32]
    MOV X9, #0
    STR X9, [SP, #40]
    MOV X0, SP
    MOV X19, X0
    MOV X2, #0

    MOV X1, SP

    STP X1, X2, [SP, #-16]!
    MOV X0, #56
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    LDR X3, [X1, #0]
    STR X3, [X0, #0]
    LDR X3, [X1, #8]
    STR X3, [X0, #8]
    LDR X3, [X1, #16]
    STR X3, [X0, #16]
    LDR X3, [X1, #24]
    STR X3, [X0, #24]
    LDR X3, [X1, #32]
    STR X3, [X0, #32]
    LDR X3, [X1, #40]
    STR X3, [X0, #40]
    STR X2, [X0, #48]
    MOV X1, X0
    MOV X19, X1
    MOV X1, #0
    SUB SP, SP, #32
    SUB SP, SP, #32
    MOV X9, #5
    STR X9, [SP, #0]
    MOV X9, #3
    STR X9, [SP, #8]
    MOV X9, #5
    STR X9, [SP, #16]
    MOV X9, SP
    LDR X12, [X9, #0]
    STR X12, [SP, #0]
    LDR X12, [X9, #8]
    STR X12, [SP, #8]
    LDR X12, [X9, #16]
    STR X12, [SP, #16]

    ADD SP, SP, #32

    MOV X9, X19
    STR X9, [SP, #24]
    MOV X0, SP
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #64
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    LDR X3, [X1, #32]
    STR X3, [X4, #32]
    LDR X3, [X1, #40]
    STR X3, [X4, #40]
    LDR X3, [X1, #48]
    STR X3, [X4, #48]
    LDR X3, [X1, #56]
    STR X3, [X4, #56]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #64

    ADD SP, SP, #16

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

nested_temporary_child_sup_beh:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    MOV X21, X1
    MOV X20, X2

    BL _silica_rt_child_table_first_ref
    MOV X22, X0
    MOV X9, X22
    MOV X10, X19
    MOV X0, X9
    MOV X1, X10
    BL _silica_rt_actor_call

    MOV X23, X0
    MOV X9, #8
    STR X9, [X20, #0]
    MOV X9, X23
    STR X9, [X20, #8]
    MOV X9, X21
    STR X9, [X20, #16]
    MOV X0, X20
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X4, X0
    MOV X3, X2
    MOV X0, #0
L_list_len_loop:
    CBZ X4, L_list_len_done
    ADD X0, X0, #1
    ADD X5, X4, X3
    LDR X4, [X5]
    B L_list_len_loop
L_list_len_done:
    RET

