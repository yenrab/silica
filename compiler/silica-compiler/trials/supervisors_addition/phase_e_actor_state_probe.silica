// Phase E probe: `ActorState` as a literal param type on a Supervisor `init` impl.
// Per plan task e1e — §15.4.13.1 should accept the trait's marker verbatim in the impl.

use Supervisor;

impl PhaseESup for Supervisor;

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        f: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 };
        c: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :w,
            agent_type: :worker,
            start: (0, worker),
            restart: :permanent,
            shutdown: 0
        };
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- [c]
    produces
        pure (f, children)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- print_string("phase_e_actor_state_probe");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
