    ; use Supervisor
    ; marker_impl E4aSup for Supervisor
    ; supervisors Phase D: runtime supervisor metadata follows (impl_supervisor actor types; §15.4.13)
    ; impl_supervisor E4aSup
    ; supervisors Phase E: declarative children / automatic restart (supervisor_phase_e init SIR; §15.4.12–§15.4.13.2)
    ; supervisor_phase_e E4aSup init_returns ({strategy : :one_for_one | :one_for_all | :rest_for_one , allowed_restart_count : int64 , restarts_time_frame : int64 },List [ { id : atom , agent_type : atom , start : ( int64 , fn ( msg : int64 , state : int64 ) -> ( :reply , int64 , int64 ) ) , restart : :permanent | :temporary | :transient , shutdown : int64 } , mem ( normal ) ])
    ; supervisors Phase E (e3b): per-impl start trampolines (calls init + materialize children)
.globl _silica_supervisor_start_E4aSup
.p2align 2
_silica_supervisor_start_E4aSup:
    STP X20, X19, [SP, #-32]!
    STP X29, X30, [SP, #16]
    ADD X29, SP, #16
    MOV X19, X0
    SUB SP, SP, #32
    MOV X8, SP
    LDR X0, [X19]
    BL init
    MOV X1, X0
    MOV X0, X19
    BL _silica_rt_supervisor_materialize_init_children
    ADD SP, SP, #32
    LDP X29, X30, [SP, #16]
    LDP X20, X19, [SP], #32
    RET
.global main


