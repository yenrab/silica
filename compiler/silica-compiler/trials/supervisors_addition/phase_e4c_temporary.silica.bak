// Phase E e4c (E6.1 — declarative only): `:temporary` never-restart under `:one_for_one`.
//
// Three **declarative** `:temporary` workers in `init`. After each death the row is tombstoned;
// `child_table_first_ref()` skips tombstones and reaches the next live row — no `start_child`.

use Supervisor;

impl E4cSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        c0: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4c_w0,
            agent_type: :worker,
            start: (0, worker),
            restart: :temporary,
            shutdown: 0
        };
        c1: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4c_w1,
            agent_type: :worker,
            start: (0, worker),
            restart: :temporary,
            shutdown: 0
        };
        c2: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4c_w2,
            agent_type: :worker,
            start: (0, worker),
            restart: :temporary,
            shutdown: 0
        };
        nil: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- empty[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ]();
        t2: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- prepend[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ](c2, nil);
        t1: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- prepend[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ](c1, t2);
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- prepend[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ](c0, t1)
    produces
        pure (
            { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 },
            children
        )
    end
}

fn sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        ch1: actor_ref <- child_table_first_ref();
        a: int64 <- call(ch1, 100 impl ActorMessage {});
        print_int64(a); println("");
        _: atom <- remove_actor(ch1);
        p1: int64 <- supervision_wait_and_drain_one();
        t1: int64 <- failure_reason_tag(p1);
        print_int64(t1); println("");
        _: atom <- failure_release(p1);
        ch2: actor_ref <- child_table_first_ref();
        b: int64 <- call(ch2, 200 impl ActorMessage {});
        print_int64(b); println("");
        _: atom <- kill_abnormal(ch2);
        p2: int64 <- supervision_wait_and_drain_one();
        t2: int64 <- failure_reason_tag(p2);
        print_int64(t2); println("");
        _: atom <- failure_release(p2);
        ch3: actor_ref <- child_table_first_ref();
        c: int64 <- call(ch3, 700 impl ActorMessage {});
        print_int64(c); println("");
        _: atom <- print_string("done");
        _: atom <- println("")
    produces
        pure (:reply, 0, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: actor_ref <- spawn(0, sup_beh);
        _: int64 <- call(sup, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
