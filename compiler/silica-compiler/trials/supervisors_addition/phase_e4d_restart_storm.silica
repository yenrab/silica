// Phase E e4d (supervisors_implementation_development_plan.md §0): restart-storm escalation under
// `:one_for_one`. With `allowed_restart_count = 2` and a generous `restarts_time_frame = 60` so the
// window does not roll, the 3rd abnormal restart attempt MUST breach the cap and escalate (the
// supervisor's own `alive` flag is set to 0 in `_silica_rt_supervisor_maybe_restart`'s
// `Lmr_freq_escalate` block — see e3e and `prims_actors_child_table_asm.silica`).
//
// Three abnormal exits in a single supervisor invocation drive `restart_count` 0→1, 1→2, 2→3.
// The third increment trips `count > allowed (3 > 2)` ⇒ escalate: lock supervisor mutex, clear
// `alive`, signal cond, unlock, branch to `Lmr_done` without respawning the child. After
// `sup_beh` returns its reply to `main`, the actor loop reads `alive == 0` and exits; the
// supervisor's `_silica_rt_actor_deliver_exit` finds no parent and falls through to the
// `L_silica_root_actor_exit` stderr note (`[silica] root actor exited (no supervisor)`), which is
// the visible escalation marker in the .scout golden.
//
// `main` issues exactly one `call(sup, 1)` so we don't depend on post-escalation message delivery
// to a dead supervisor (which would hang on `cond_wait`).
//
// Register-allocator workaround: `term_emitter.silica` `spill_reg_chain_from_outer` only allocates
// X19..X28 in order with no stack-spill fallback. With msg/state/sret consuming X19/X20/X21, only
// X22..X28 = 7 callee-saved slots remain. Three named kill+drain cycles overflow, so this trial
// inlines `child_table_first_ref()` and `failure_reason_tag(p)` instead of binding `ch_i` / `t_i`.
// Live bindings reduce to a, p1, b, p2, c, p3 = 6.
//
// Per e4a, `call(sup, …)` needs a non-zero message because `_silica_rt_actor_call` returns
// immediately on null payloads via `cbz x1`.

use Supervisor;

impl E4dSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        child: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4d_worker,
            agent_type: :worker,
            start: (0, worker),
            restart: :permanent,
            shutdown: 0
        };
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- [child]
    produces
        pure (
            { strategy: :one_for_one, allowed_restart_count: 2, restarts_time_frame: 60 },
            children
        )
    end
}

fn sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        a: int64 <- call(child_table_first_ref(), 100 impl ActorMessage {});
        print_int64(a); println("");
        _: atom <- kill_abnormal(child_table_first_ref());
        p1: int64 <- supervision_wait_and_drain_one();
        print_int64(failure_reason_tag(p1)); println("");
        _: atom <- failure_release(p1);
        b: int64 <- call(child_table_first_ref(), 200 impl ActorMessage {});
        print_int64(b); println("");
        _: atom <- kill_abnormal(child_table_first_ref());
        p2: int64 <- supervision_wait_and_drain_one();
        print_int64(failure_reason_tag(p2)); println("");
        _: atom <- failure_release(p2);
        c: int64 <- call(child_table_first_ref(), 300 impl ActorMessage {});
        print_int64(c); println("");
        _: atom <- kill_abnormal(child_table_first_ref());
        p3: int64 <- supervision_wait_and_drain_one();
        print_int64(failure_reason_tag(p3)); println("");
        _: atom <- failure_release(p3);
        _: atom <- print_string("done");
        _: atom <- println("")
    produces
        pure (:reply, 0, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: actor_ref <- spawn(0, sup_beh);
        _: int64 <- call(sup, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
