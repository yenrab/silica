// Phase E e4e (E6.1 — declarative only): `:one_for_all` cascade restart.
// Two **declarative** `:permanent` workers in `init`; `child_table_row_ref(1)` addresses the second row.
//
// Output sequence: `100, 200, 1, 0, 300, done` (see plan §0 e4e).

use Supervisor;

impl E4eSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn init(initial_supervisor_state: ActorState) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        c0: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4e_w1,
            agent_type: :worker,
            start: (0, worker),
            restart: :permanent,
            shutdown: 0
        };
        c1: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :e4e_w2,
            agent_type: :worker,
            start: (0, worker),
            restart: :permanent,
            shutdown: 0
        };
        nil: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- empty[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ]();
        tail: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- prepend[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ](c1, nil);
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ] <- prepend[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:reply, int64, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            mem(normal)
        ](c0, tail)
    produces
        pure (
            { strategy: :one_for_all, allowed_restart_count: 10, restarts_time_frame: 60 },
            children
        )
    end
}

fn sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        c1: actor_ref <- child_table_first_ref();
        c2: actor_ref <- child_table_row_ref(1);
        a: int64 <- call(c1, 100 impl ActorMessage {});
        print_int64(a); println("");
        b: int64 <- call(c2, 200 impl ActorMessage {});
        print_int64(b); println("");
        _: atom <- kill_abnormal(c1);
        p1: int64 <- supervision_wait_and_drain_one();
        t1: int64 <- failure_reason_tag(p1);
        print_int64(t1); println("");
        _: atom <- failure_release(p1);
        p2: int64 <- supervision_wait_and_drain_one();
        t2: int64 <- failure_reason_tag(p2);
        print_int64(t2); println("");
        _: atom <- failure_release(p2);
        c1p: actor_ref <- child_table_first_ref();
        r: int64 <- call(c1p, 300 impl ActorMessage {});
        print_int64(r); println("");
        _: atom <- print_string("done");
        _: atom <- println("")
    produces
        pure (:reply, 0, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        sup: actor_ref <- spawn(0, sup_beh);
        _: int64 <- call(sup, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
