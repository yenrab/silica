# lldb symtab uses names without leading '_' (e.g. silica_supervisor_start_E4aSup)
br set -n silica_supervisor_start_E4aSup -C "thread info" -C "bt 30" -C "register read pc lr x0 x8 x19 x30" -C "continue"
br set -n silica_rt_supervisor_materialize_init_children -C "thread info" -C "bt 30" -C "register read pc lr x0 x8 x19 x21 x30" -C "continue"
br set -n silica_rt_actor_spawn_linked -C "thread info" -C "bt 30" -C "register read pc lr x0 x1 x2 x3 x19 x30" -C "continue"
br set -n silica_rt_region_alloc -C "thread info" -C "bt 12" -C "register read pc lr x0 x19 x30" -C "continue"
run
