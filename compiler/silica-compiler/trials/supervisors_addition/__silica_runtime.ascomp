	.p2align	2                               ; functional queue dequeue; caller holds queue's lock
_silica_rt_q_dequeue_locked:            ; X0 = &queue (pair: front, rear). Returns X0 = node or null.
	.cfi_startproc
	ldr	x1, [x0]
	cbnz	x1, Lqd_pop
	ldr	x1, [x0, #8]
	cbz	x1, Lqd_empty
	mov	x2, xzr
Lqd_rev:
	ldr	x3, [x1]
	str	x2, [x1]
	mov	x2, x1
	mov	x1, x3
	cbnz	x1, Lqd_rev
	str	x2, [x0]
	str	xzr, [x0, #8]
	mov	x1, x2
Lqd_pop:
	ldr	x3, [x1]
	str	x3, [x0]
	mov	x0, x1
	ret
Lqd_empty:
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
	.p2align	2                               ; functional queue enqueue; caller holds queue's lock
_silica_rt_q_enqueue_locked:            ; X0 = &queue (pair), X1 = node. Prepends to rear.
	.cfi_startproc
	ldr	x2, [x0, #8]
	str	x2, [x1]
	str	x1, [x0, #8]
	ret
	.cfi_endproc
