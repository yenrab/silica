	.p2align	2
_silica_rt_actor_supervision_wait_and_drain_one:
	.cfi_startproc
; No args; returns X0 = failure payload pointer dequeued from self's supervision ingress, blocks until one is available.
	stp	x22, x21, [sp, #-48]!
