	mov	x0, x21
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lswd_wait:
; Phase E e4f: blocking pthread_cond_wait. Same rationale as in _silica_rt_actor_call /
; actor_thread_main wait paths — the 1 ms timedwait was a missed-signal band-aid that drove
; libpthread internal kwq malloc churn racing with new-actor TLS instantiation (mfm_alloc
; SIGBUS). All paths that enqueue a failure (LBB1_free's _silica_rt_actor_deliver_exit, etc.)
; signal sup#80 cond while holding sup#16 mutex, so plain cond_wait is correctly delivered.
	add	x0, x19, #80
