// Phase E type-checker probe: exercises the canonical `init` return shape one feature at a time.
// §15.4.13.2 requires a tuple of (supervisor_flags, List[child_spec, normal]).

use Supervisor;

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn flags_only() -> {
    strategy: :one_for_one | :one_for_all | :rest_for_one,
    allowed_restart_count: int64,
    restarts_time_frame: int64
} {
    f: {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 };
    f
}

fn child_spec_only() -> {
    id: atom,
    agent_type: atom,
    start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
    restart: :permanent | :temporary | :transient,
    shutdown: int64
} {
    c: {
        id: atom,
        agent_type: atom,
        start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
        restart: :permanent | :temporary | :transient,
        shutdown: int64
    } <- {
        id: :w,
        agent_type: :worker,
        start: (0, worker),
        restart: :permanent,
        shutdown: 0
    };
    c
}

fn init_canonical(initial: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        },
        normal
    ]
) {
    sequence proc[mem(normal)]
        f: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 };
        c: {
            id: atom,
            agent_type: atom,
            start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
            restart: :permanent | :temporary | :transient,
            shutdown: int64
        } <- {
            id: :w,
            agent_type: :worker,
            start: (initial, worker),
            restart: :permanent,
            shutdown: 0
        };
        children: List[
            {
                id: atom,
                agent_type: atom,
                start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
                restart: :permanent | :temporary | :transient,
                shutdown: int64
            },
            normal
        ] <- [c]
    produces
        pure (f, children)
    end
}

fn flags_and_child() -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    {
        id: atom,
        agent_type: atom,
        start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
        restart: :permanent | :temporary | :transient,
        shutdown: int64
    }
) {
    f: {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    } <- { strategy: :one_for_one, allowed_restart_count: 3, restarts_time_frame: 5 };
    c: {
        id: atom,
        agent_type: atom,
        start: (int64, fn(msg: int64, state: int64) -> (:no_reply, int64)),
        restart: :permanent | :temporary | :transient,
        shutdown: int64
    } <- {
        id: :w,
        agent_type: :worker,
        start: (0, worker),
        restart: :permanent,
        shutdown: 0
    };
    (f, c)
}

fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- print_string("phase_e_probe")
    produces
        pure 0
    end
}
