// Phase F (supervisors plan Phase F — **F6**): root FailureReporter + **transport → typed `handle_report`**.
// `_silica_rt_actor_deliver_unwind_report` → bounded async `_silica_rt_actor_cast` (see `prims_actors_runtime_asm.silica`);
// the FR thread receives the NUL-terminated transport buffer as a **string** (cstr-compatible pointer) and invokes
// **`handle_report`** with **empty `region_dumps`** per §15.4.13.4 **(a)**. No synchronous `handle_report` from the
// exiting thread or supervisor C code.
//
// Standard mailbox: cast node payload at +8; behavior is invoked with X0 = payload. Unwind text fits Silica `string`
// (lead byte ≠ 0xFF → cstr path in length / substring helpers).
//
// Flow (inherits phase_c_child_exit_notification structure — adds spawn+register_failure_reporter first):
use FailureReporter;

impl TrialFr for FailureReporter;

fn region_dump_limit() -> int64 {
    sequence proc[device_io]
        _: atom <- println("")
    produces
        pure 0
    end
}

fn handle_report(dumps: List[(atom, bytes), normal], rep: string) -> :ok {
    sequence proc[device_io]
        _: atom <- print_string("F6_handle_report");
        _: atom <- println("")
    produces
        pure :ok
    end
}

fn child_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, msg + state, state)
}

fn trial_fr_beh(transport_report: string, state: int64) -> (:reply, int64, int64) {
    sequence proc[mem(normal)]
        no_dumps: List[(atom, bytes), normal] <- empty[(atom, bytes), normal]();
        _: atom <- handle_report(no_dumps, transport_report)
    produces
        pure (:reply, 0, state)
    end
}

fn sup_beh(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency, device_io]
        child: actor_ref <- spawn_linked(0, child_beh, :phase_f_child);
        _: atom <- remove_actor(child);
        payload: int64 <- supervision_wait_and_drain_one();
        at: atom <- failure_agent_type(payload);
        _: atom <- print_atom(at);
        println("");
        tag: int64 <- failure_reason_tag(payload);
        print_int64(tag); println("");
        _: atom <- failure_release(payload);
        _: atom <- print_string("done");
        _: atom <- println("")
    produces
        pure (:reply, 0, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        fr: actor_ref <- spawn(0, trial_fr_beh);
        _: atom <- register_failure_reporter(fr);
        sup: actor_ref <- spawn(0, sup_beh);
        _: boolean <- cast(sup, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
