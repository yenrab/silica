.text
    ; use Supervisor
.global main


worker:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, #8
    STR X9, [X8, #0]
    MOV X9, X20
    MOV X10, X19


    ADD X9, X9, X10
    STR X9, [X8, #8]
    MOV X0, X8
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

flags_only:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #32
    MOV X9, #5
    STR X9, [SP, #0]
    MOV X9, #3
    STR X9, [SP, #8]
    MOV X9, #5
    STR X9, [SP, #16]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #32
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #32

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

child_spec_only:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #48
    MOV X9, #9
    STR X9, [SP, #0]
    MOV X9, #10
    STR X9, [SP, #8]
    MOV X9, #0
    STR X9, [SP, #16]
    ADRP X10, worker@PAGE
    ADD X10, X10, worker@PAGEOFF
    STR X10, [SP, #24]

    MOV X9, #2
    STR X9, [SP, #32]
    MOV X9, #0
    STR X9, [SP, #40]
    MOV X0, SP
    MOV X19, X0
    MOV X0, X19
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #48
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    LDR X3, [X1, #16]
    STR X3, [X4, #16]
    LDR X3, [X1, #24]
    STR X3, [X4, #24]
    LDR X3, [X1, #32]
    STR X3, [X4, #32]
    LDR X3, [X1, #40]
    STR X3, [X4, #40]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #48

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

init_canonical:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0

    SUB SP, SP, #32
    MOV X9, #5
    STR X9, [SP, #0]
    MOV X9, #3
    STR X9, [SP, #8]
    MOV X9, #5
    STR X9, [SP, #16]
    MOV X0, SP
    MOV X20, X0
    SUB SP, SP, #48
    MOV X9, #9
    STR X9, [SP, #0]
    MOV X9, #10
    STR X9, [SP, #8]
    MOV X9, X19
    STR X9, [SP, #16]
    ADRP X10, worker@PAGE
    ADD X10, X10, worker@PAGEOFF
    STR X10, [SP, #24]

    MOV X9, #2
    STR X9, [SP, #32]
    MOV X9, #0
    STR X9, [SP, #40]
    MOV X0, SP
    MOV X20, X0
    MOV X2, #0

    MOV X1, X20

    STP X1, X2, [SP, #-16]!
    MOV X0, #56
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    LDR X3, [X1, #0]
    STR X3, [X0, #0]
    LDR X3, [X1, #8]
    STR X3, [X0, #8]
    LDR X3, [X1, #16]
    STR X3, [X0, #16]
    LDR X3, [X1, #24]
    STR X3, [X0, #24]
    LDR X3, [X1, #32]
    STR X3, [X0, #32]
    LDR X3, [X1, #40]
    STR X3, [X0, #40]
    STR X2, [X0, #48]
    MOV X0, X0
    MOV X21, X0
    MOV X1, #0
    SUB SP, SP, #16
    MOV X9, SP
    STR X9, [SP, #0]
    MOV X9, X21
    STR X9, [SP, #8]
    MOV X0, SP
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16

    ADD SP, SP, #48

    ADD SP, SP, #32

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

flags_and_child:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    SUB SP, SP, #32
    MOV X9, #5
    STR X9, [SP, #0]
    MOV X9, #3
    STR X9, [SP, #8]
    MOV X9, #5
    STR X9, [SP, #16]
    MOV X0, SP
    MOV X19, X0
    SUB SP, SP, #48
    MOV X9, #9
    STR X9, [SP, #0]
    MOV X9, #10
    STR X9, [SP, #8]
    MOV X9, #0
    STR X9, [SP, #16]
    ADRP X10, worker@PAGE
    ADD X10, X10, worker@PAGEOFF
    STR X10, [SP, #24]

    MOV X9, #2
    STR X9, [SP, #32]
    MOV X9, #0
    STR X9, [SP, #40]
    MOV X0, SP
    MOV X19, X0
    SUB SP, SP, #16
    MOV X9, SP
    STR X9, [SP, #0]
    MOV X9, X19
    STR X9, [SP, #8]
    MOV X0, SP
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #64

    ADD SP, SP, #32

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #13

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0

    BL _silica_rt_wait_for_exit
    MOV X19, X0
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X4, X0
    MOV X3, X2
    MOV X0, #0
L_list_len_loop:
    CBZ X4, L_list_len_done
    ADD X0, X0, #1
    ADD X5, X4, X3
    LDR X4, [X5]
    B L_list_len_loop
L_list_len_done:
    RET

.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x65, 0x66, 0x66, 0x69, 0x63, 0x69, 0x65, 0x6e, 0x63, 0x79, 0
atom_1:
    .byte  0x3a, 0x70, 0x65, 0x72, 0x66, 0x6f, 0x72, 0x6d, 0x61, 0x6e, 0x63, 0x65, 0
atom_2:
    .byte  0x3a, 0x70, 0x65, 0x72, 0x6d, 0x61, 0x6e, 0x65, 0x6e, 0x74, 0
atom_3:
    .byte  0x3a, 0x74, 0x72, 0x61, 0x6e, 0x73, 0x69, 0x65, 0x6e, 0x74, 0
atom_4:
    .byte  0x3a, 0x74, 0x65, 0x6d, 0x70, 0x6f, 0x72, 0x61, 0x72, 0x79, 0
atom_5:
    .byte  0x3a, 0x6f, 0x6e, 0x65, 0x5f, 0x66, 0x6f, 0x72, 0x5f, 0x6f, 0x6e, 0x65, 0
atom_6:
    .byte  0x3a, 0x6f, 0x6e, 0x65, 0x5f, 0x66, 0x6f, 0x72, 0x5f, 0x61, 0x6c, 0x6c, 0
atom_7:
    .byte  0x3a, 0x72, 0x65, 0x73, 0x74, 0x5f, 0x66, 0x6f, 0x72, 0x5f, 0x6f, 0x6e, 0x65, 0
atom_8:
    .byte  0x3a, 0x6e, 0x6f, 0x5f, 0x72, 0x65, 0x70, 0x6c, 0x79, 0
atom_9:
    .byte  0x3a, 0x77, 0
atom_10:
    .byte  0x3a, 0x77, 0x6f, 0x72, 0x6b, 0x65, 0x72, 0
atom_11:
    .byte  0x3a, 0x77, 0
atom_12:
    .byte  0x3a, 0x77, 0x6f, 0x72, 0x6b, 0x65, 0x72, 0
atom_13:
    .byte  0x3a, 0x77, 0
atom_14:
    .byte  0x3a, 0x77, 0x6f, 0x72, 0x6b, 0x65, 0x72, 0
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "phase_e_probe"
    .byte 0
L_str_1:
    .ascii ""
    .byte 0
L_str_2:
    .ascii "\n"
    .byte 0

L_newline:
    .byte 10

