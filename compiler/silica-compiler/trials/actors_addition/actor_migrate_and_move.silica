fn handler(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
    println("handler received message: ");
    print_int64(msg);
    println("");
    println("handler state: ");
    print_int64(state);
    println("");
    println("updated state: ");
    print_int64(state + msg);
    println("")
    produces
        pure (:no_reply, state + msg)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        ref: actor_ref <- spawn(0, handler);
        _: atom <- migrate_actor(ref, 2);
        _: atom <- move(ref, 2, 4);
        enqueued: boolean <- cast(ref, 42 impl ActorMessage {})
        //add println calls to give the cast a chance to complete
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("cast complete")
    produces
        pure 0
    end
}
