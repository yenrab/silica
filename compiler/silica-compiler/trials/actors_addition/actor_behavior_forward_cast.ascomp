.global main


sink:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X9, #21
    STR X9, [X8, #0]
    SUB SP, SP, #16
    MOV X10, X0
    STR X10, [SP, #-16]!
    LDR X9, [X1, #0]
    LDR X10, [SP], #16


    ADD X9, X9, X10
    STR X9, [SP, #0]
    MOV X9, SP
    STR X9, [X8, #24]
    ADD X0, X8, #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

forwarder:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
