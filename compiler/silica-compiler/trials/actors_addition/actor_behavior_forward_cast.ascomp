    LDR X9, [X21, #0]
    MOV X11, X9
    MOV X10, X19
    MOV X0, X11
    MOV X1, X10
    BL _silica_rt_actor_cast

    MOV X20, X0
    MOV X0, #2
    SUB SP, SP, #16
    MOV X9, #21
    STR X9, [SP, #0]
    MOV X9, X21
    STR X9, [SP, #8]
    MOV X0, SP
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    ADD SP, SP, #16

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    MOV X9, SP
    ADRP X10, sink@PAGE
    ADD X10, X10, sink@PAGEOFF

    MOV X12, X10
    MOV X0, X9
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    MOV X9, X0
    MOV X10, X12
    MOV X3, XZR
    MOV X0, X9
    MOV X1, X10
    MOV W2, WZR
    BL _silica_rt_actor_spawn
    ADD SP, SP, #16

    MOV X19, X0
    SUB SP, SP, #16
    MOV X9, X19
    STR X9, [SP, #0]
    MOV X9, SP
    ADRP X10, forwarder@PAGE
    ADD X10, X10, forwarder@PAGEOFF

    MOV X12, X10
    MOV X0, X9
    SUB SP, SP, #16
    STR X0, [SP, #8]
    MOV X0, #16
    BL _silica_rt_region_alloc
    MOV X4, X0
    LDR X1, [SP, #8]
    LDR X3, [X1, #0]
    STR X3, [X4, #0]
    LDR X3, [X1, #8]
    STR X3, [X4, #8]
    MOV X0, X4
    ADD SP, SP, #16
    MOV X9, X0
    MOV X10, X12
    MOV X3, XZR
    MOV X0, X9
    MOV X1, X10
    MOV W2, WZR
    BL _silica_rt_actor_spawn
    ADD SP, SP, #16

    MOV X20, X0
    MOV X9, X20
    MOV X11, X9
    MOV X10, #7
    MOV X0, X11
    MOV X1, X10
    BL _silica_rt_actor_cast

    MOV X21, X0
    MOV X0, #2
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
