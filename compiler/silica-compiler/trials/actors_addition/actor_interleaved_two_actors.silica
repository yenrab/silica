// Two actors; calls alternate A → B → A so mailboxes interleave but each actor stays FIFO.
// §15.1.2: (:reply, Reply, State); §16.1.1: call(actor_ref, message) -> Reply.

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    new_state: int64 <- msg + state;
    (:reply, new_state, new_state)
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        a: actor_ref <- spawn(0, acc);
        b: actor_ref <- spawn(0, acc);
        r1: int64 <- call(a, 1 impl ActorMessage {});
        print_int64(r1);
        println("");
        r2: int64 <- call(b, 10 impl ActorMessage {});
        print_int64(r2);
        println("");
        r3: int64 <- call(a, 2 impl ActorMessage {});
        print_int64(r3);
        println("");
    produces
        pure :ok
    end
}
