// Cast-only round-trip between Bob and Alice (no call() between them).
// main registers Alice on Bob with cast(bob_r, alice_r), then kicks Alice with (:kick).
// Bob handles peer=alice: prints "pong", casts (:done) back to Alice. Alice prints "kick" then "done".
// Alice prints done after the async round-trip completes; main waits for command-line exit.
// §16.1.2 cast.

fn alice(msg: atom, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: boolean <- case msg of {
            :kick -> {
                println("kick");
                true
            };
            :done -> {
                println("done");
                true
            };
            _: atom -> true
        }
    produces
        pure (:no_reply, state)
    end
}

fn bob(peer: actor_ref, state: int64) -> (:no_reply, int64) {
    sequence proc[concurrency, device_io]
        println("pong");
        _: boolean <- cast(peer, (:done) impl ActorMessage {})
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        bob_r: actor_ref <- spawn(0, bob);
        alice_r: actor_ref <- spawn(0, alice);
        _: boolean <- cast(bob_r, alice_r impl ActorMessage {});
        _: boolean <- cast(alice_r, (:kick) impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
