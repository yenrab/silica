// Three independent actors; main issues call() to each in order (first → second → third).
// §15.1.2: (:reply, reply_value, new_state); §16.1.1: call(actor_ref, message) -> Reply.

fn acc(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[device_io]
        println("Before state is");
        print_int64(state);
        println("");
        println("Received message");
        print_int64(msg);
        println("");
        new_state: int64 <- msg + state;
        println("New state is");
        print_int64(new_state);
        println("")
    produces
        pure (:reply, new_state, new_state)
    end
}

fn main() -> atom {
    sequence proc[concurrency]
        first: actor_ref <- spawn(0, acc);
        second: actor_ref <- spawn(0, acc);
        third: actor_ref <- spawn(0, acc);
        _: int64 <- call(first, 1 impl ActorMessage {});
        _: int64 <- call(second, 2 impl ActorMessage {});
        _: int64 <- call(third, 3 impl ActorMessage {})
    produces
        pure :ok
    end
}
