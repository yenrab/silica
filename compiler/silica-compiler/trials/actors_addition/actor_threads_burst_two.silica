// Observational: two cast-only actors each print the same tag many times in one message handler.
// If the runtime maps actors to different worker threads, those write() syscalls can interleave on stdout
// (lines of "A" and "B" mixed). A single global mailbox thread would tend to serialize.
// Trailing empty println() calls keep main busy so asynchronous casts can drain (cast is not synchronous).
// Lines before "_sync" are from actors; "_sync" prints after a delay block on the main path.
// §15.1.2: (:no_reply, State); §16.1.2: cast.

fn burst_a(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("A");
        println("A");
        println("A");
        println("A");
        println("A");
        println("A");
        new_st: int64 <- state + msg
    produces
        pure (:no_reply, new_st)
    end
}

fn burst_b(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("B");
        println("B");
        println("B");
        println("B");
        println("B");
        println("B");
        new_st: int64 <- state + msg
    produces
        pure (:no_reply, new_st)
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        a: actor_ref <- spawn(0, burst_a);
        b: actor_ref <- spawn(0, burst_b);
        _: boolean <- cast(a, 1 impl ActorMessage {});
        _: boolean <- cast(b, 1 impl ActorMessage {});
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("_sync")
    produces
        pure :ok
    end
}
