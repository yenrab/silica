// Alternating cast()s to two actors (one "A" or "B" line per message). Parallel workers can reorder lines
// relative to enqueue order; compare with actor_threads_burst_two (six prints per handler).
// Keep the cast count modest so mailboxes drain reliably; message uses 1 not 0.
// Trailing println("") gives the runtime time to run handlers before "_sync".
// §16.1.2: cast.

fn line_a(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("A");
        new_st: int64 <- state + msg
    produces
        pure (:no_reply, new_st)
    end
}

fn line_b(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        println("B");
        new_st: int64 <- state + msg
    produces
        pure (:no_reply, new_st)
    end
}

fn main() -> atom {
    sequence proc[concurrency, device_io]
        ar: actor_ref <- spawn(0, line_a);
        br: actor_ref <- spawn(0, line_b);
        _: boolean <- cast(ar, 1 impl ActorMessage {});
        _: boolean <- cast(br, 1 impl ActorMessage {});
        _: boolean <- cast(ar, 1 impl ActorMessage {});
        _: boolean <- cast(br, 1 impl ActorMessage {});
        _: boolean <- cast(ar, 1 impl ActorMessage {});
        _: boolean <- cast(br, 1 impl ActorMessage {});
        _: boolean <- cast(ar, 1 impl ActorMessage {});
        _: boolean <- cast(br, 1 impl ActorMessage {});
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("");
        println("_sync")
    produces
        pure :ok
    end
}
