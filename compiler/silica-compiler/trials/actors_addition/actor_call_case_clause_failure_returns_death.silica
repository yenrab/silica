fn case_reply(msg: int64, state: int64) -> (:reply, int64, int64) {
    value: int64 <- case msg of {
        1 -> 10;
        2 -> 20
    };

    (:reply, value, state)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        worker: actor_ref <- spawn(0, case_reply);
        result: int64 <- call(worker, 3 impl ActorMessage {});
        print_int64(result);
        println("");
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
