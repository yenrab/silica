	.globl	_silica_rt_region_alloc         ; -- Begin function silica_rt_region_alloc
	.p2align	2
_silica_rt_region_alloc:                ; @silica_rt_region_alloc
	.cfi_startproc
; X0=size. Bump-allocates from current actor's mmap region.
; Falls back to _malloc if not in actor context.
	stp	x20, x19, [sp, #-32]!
	stp	x29, x30, [sp, #16]
	add	x29, sp, #16
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	mov	x19, x0
Lloh_ra0:
	adrp	x0, _tl_current_actor@TLVPPAGE
Lloh_ra1:
	ldr	x0, [x0, _tl_current_actor@TLVPPAGEOFF]
	ldr	x8, [x0]
	blr	x8
	ldr	x20, [x0]
	cbz	x20, LBBra_fallback
	ldr	x8, [x20, #176]
	cbz	x8, LBBra_fallback
	add	x9, x8, x19
	add	x9, x9, #7
	bic	x9, x9, #7
	str	x9, [x20, #176]
	mov	x0, x8
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
LBBra_fallback:
	mov	x0, x19
	bl	_malloc
	ldp	x29, x30, [sp, #16]
	ldp	x20, x19, [sp], #32
	ret
	.loh AdrpLdr	Lloh_ra0, Lloh_ra1
	.cfi_endproc
