; X0=actor_ref X1=from_core X2=to_core; migrate actor to target core
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x2
	ldr	x0, [x0, #144]
	bl	_pthread_mach_thread_np
	mov	x20, x0
	sub	sp, sp, #16
	str	w19, [sp]
	mov	x0, x20
	mov	w1, #4
	mov	x2, sp
	mov	w3, #1
	bl	_thread_policy_set
	add	sp, sp, #16
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.cfi_endproc
                                        ; -- End function
	.p2align	2
_silica_rt_install_fault_handler:       ; install SIGSEGV handler (once)
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	sub	sp, sp, #16
Lloh_fh0:
	adrp	x8, _silica_rt_stack_fault_handler@PAGE
Lloh_fh1:
	add	x8, x8, _silica_rt_stack_fault_handler@PAGEOFF
	str	x8, [sp]
	str	wzr, [sp, #8]
	mov	w8, #0x40
	str	w8, [sp, #12]
	mov	w0, #11
	mov	x1, sp
	mov	x2, #0
	bl	_sigaction
	add	sp, sp, #16
	ldp	x29, x30, [sp], #16
	ret
	.loh AdrpAdd	Lloh_fh0, Lloh_fh1
	.cfi_endproc
                                        ; -- End function
	.p2align	2
_silica_rt_stack_fault_handler:         ; SIGSEGV handler for growable actor stacks
	.cfi_startproc
; X0=sig X1=siginfo_t* X2=ucontext_t*
; Checks if fault is in current actor's region and maps the page on demand.
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	ldr	x19, [x1, #24]
Lloh_sh0:
	adrp	x0, _tl_current_actor@TLVPPAGE
Lloh_sh1:
	ldr	x0, [x0, _tl_current_actor@TLVPPAGEOFF]
	ldr	x8, [x0]
	blr	x8
	ldr	x20, [x0]
	cbz	x20, LBBfh_crash
	ldr	x21, [x20, #160]
	cbz	x21, LBBfh_crash
	ldr	x22, [x20, #184]
	add	x22, x21, x22
	cmp	x19, x21
	b.lo	LBBfh_crash
	cmp	x19, x22
	b.hs	LBBfh_overflow
	bic	x0, x19, #0xfff
	mov	x1, #0x1000
	mov	w2, #3
	bl	_mprotect
	ldr	x8, [x20, #160]
	bic	x9, x19, #0xfff
	add	x9, x9, #0x1000
	sub	x9, x9, x8
	ldr	x10, [x20, #168]
	cmp	x9, x10
	b.ls	LBBfh_done
	str	x9, [x20, #168]
LBBfh_done:
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
LBBfh_overflow:
	str	wzr, [x20, #152]
	add	x0, x20, #80
	bl	_pthread_cond_signal
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
LBBfh_crash:
	mov	w0, #11
	bl	_signal
	mov	w0, #11
	bl	_raise
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.loh AdrpLdr	Lloh_sh0, Lloh_sh1
	.cfi_endproc
                                        ; -- End function
	.section	__DATA,__common
	.p2align	2
_silica_rt_fault_handler_installed:
