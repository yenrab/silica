.global main


step:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    MOV X19, X0
    MOV X21, X1
    MOV X20, X2

    MOV X9, X19
    MOV X10, X21


    ADD X0, X9, X10
    MOV X22, X0
    MOV X9, #0
    STR X9, [X20, #0]
    MOV X9, X22
    STR X9, [X20, #8]
    MOV X9, X22
    STR X9, [X20, #16]
    MOV X0, X20
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!

    MOV X9, #0
    ADRP X8, step@PAGE
    ADD X8, X8, step@PAGEOFF
    MOV X10, X8

    MOV X0, X9
    MOV X1, X10
    MOV W2, WZR
    BL _silica_rt_actor_spawn

    MOV X19, X0
    MOV X9, X19
    MOV X10, #1
    MOV X0, X9
    MOV X1, X10
    BL _silica_rt_actor_call

    MOV X20, X0
    MOV X9, X19
    MOV X10, #1
    MOV X0, X9
    MOV X1, X10
    BL _silica_rt_actor_call

    MOV X21, X0
