.tbss _tl_current_actor$tlv$init, 8, 3  ; @tl_current_actor

	.section	__DATA,__thread_vars,thread_local_variables
_tl_current_actor:
	.quad	__tlv_bootstrap
	.quad	0
	.quad	_tl_current_actor$tlv$init
	.section	__TEXT,__text,regular,pure_instructions
	.p2align	2
_silica_rt_actor_init_region:           ; init growable stack region for actor
	.cfi_startproc
; X0=actor_ptr. Reserves 1GB VA, maps first 8MB, stores metadata at [160..192].
; Also installs SIGSEGV handler on first call.
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x0
Lloh_ir0:
	adrp	x8, _silica_rt_fault_handler_installed@PAGE
Lloh_ir1:
	add	x8, x8, _silica_rt_fault_handler_installed@PAGEOFF
	ldr	w9, [x8]
	cbnz	w9, LBBir_skip_handler
	mov	w9, #1
	str	w9, [x8]
	bl	_silica_rt_install_fault_handler
LBBir_skip_handler:
	mov	x0, #0
	movz	x1, #0x4000, lsl #16
	mov	w2, #0
	movz	w3, #0x1002
	mov	w4, #-1
	mov	x5, #0
	bl	_mmap
	cmn	x0, #1
	b.eq	LBBir_fail
	mov	x20, x0
	movz	x1, #0x80, lsl #16
	mov	w2, #3
	bl	_mprotect
	str	x20, [x19, #160]
	movz	x8, #0x80, lsl #16
	str	x8, [x19, #168]
	add	x8, x20, #256
	str	x8, [x19, #176]
	movz	x8, #0x4000, lsl #16
	str	x8, [x19, #184]
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
LBBir_fail:
	str	xzr, [x19, #160]
	str	xzr, [x19, #168]
	str	xzr, [x19, #176]
	str	xzr, [x19, #184]
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.loh AdrpAdd	Lloh_ir0, Lloh_ir1
	.cfi_endproc
                                        ; -- End function
	.p2align	2
_silica_rt_actor_dealloc_region:        ; release actor's growable stack region
	.cfi_startproc
; X0=actor_ptr. munmap(region_base, total_size).
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	ldr	x8, [x0, #184]
	ldr	x0, [x0, #160]
	cbz	x0, LBBdr_skip
	mov	x1, x8
	bl	_munmap
LBBdr_skip:
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
                                        ; -- End function
