fn divide_by_message(msg: int32, state: int32) -> (:no_reply, int32) {
    (:no_reply, 42 / msg)
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        worker: actor_ref <- spawn(0, divide_by_message);
        _: boolean <- cast(worker, 0 impl ActorMessage {});
        println("done");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
