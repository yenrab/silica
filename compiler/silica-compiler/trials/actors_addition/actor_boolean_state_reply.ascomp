.text
.global main


id:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X20, X2

    MOV X9, #15
    STR X9, [X20, #0]
    MOV X9, X1
    STR X9, [X20, #8]
    MOV X9, X1
    STR X9, [X20, #16]
    MOV X0, X20
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X9, #0
    ADRP X10, id@PAGE
    ADD X10, X10, id@PAGEOFF

    MOV X3, XZR
    MOV X0, X9
    MOV X1, X10
    MOV W2, WZR
    BL _silica_rt_actor_spawn

    MOV X19, X0
    MOV X9, X19
    MOV X10, #0
    MOV X0, X9
    MOV X1, X10
    BL _silica_rt_actor_call

    MOV X20, X0
    MOV X0, X20
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0

    MOV X0, #2
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pb_helper:
    CMP X0, #0
    B.eq L_pb_false_branch
    MOV X0, #1
    ADRP X1, L_pb_true@PAGE
    ADD X1, X1, L_pb_true@PAGEOFF
    MOV X2, #4
    MOV X16, #4
    SVC #0x80
    B L_pb_after
L_pb_false_branch:
    MOV X0, #1
    ADRP X1, L_pb_false@PAGE
    ADD X1, X1, L_pb_false@PAGEOFF
    MOV X2, #5
    MOV X16, #4
    SVC #0x80
L_pb_after:
    RET
