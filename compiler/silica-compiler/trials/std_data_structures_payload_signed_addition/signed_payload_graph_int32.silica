// Phase 10.1 — int32 graph edge-data payload round trip.
use graph_adj_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        g0: { node_count: int64, edge_count: int64, n0_neighbors: List[{ to: int64, weight: int32 }, mem(normal)], n1_neighbors: List[{ to: int64, weight: int32 }, mem(normal)], n2_neighbors: List[{ to: int64, weight: int32 }, mem(normal)] } <- graph_adj_directed@empty[int32, mem(normal)](3);
        expected: int32 <- 120000;
        g1: { node_count: int64, edge_count: int64, n0_neighbors: List[{ to: int64, weight: int32 }, mem(normal)], n1_neighbors: List[{ to: int64, weight: int32 }, mem(normal)], n2_neighbors: List[{ to: int64, weight: int32 }, mem(normal)] } <- graph_adj_directed@add_edge[int32, mem(normal)](g0, 0, 1, expected);
        weight: int32 <- graph_adj_directed@weight_at[int32, mem(normal)](g1, 0, 1);
        valid: int64 <- graph_adj_directed@validate[int32, mem(normal)](g1);
        failures: int64 <- (1 - valid) + case weight == expected of { true -> 0; false -> 2 }
    produces pure failures end
}
