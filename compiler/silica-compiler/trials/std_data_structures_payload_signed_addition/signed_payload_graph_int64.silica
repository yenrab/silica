// Phase 10.1 — int64 graph edge-data payload round trip.
use graph_adj_directed;

fn main() -> int64 {
    sequence proc[mem(normal)]
        g0: { node_count: int64, edge_count: int64, n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)], n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)], n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)] } <- graph_adj_directed@empty[int64, mem(normal)](3);
        g1: { node_count: int64, edge_count: int64, n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)], n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)], n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)] } <- graph_adj_directed@add_edge[int64, mem(normal)](g0, 0, 1, 1200000);
        weight: int64 <- graph_adj_directed@weight_at[int64, mem(normal)](g1, 0, 1);
        valid: int64 <- graph_adj_directed@validate[int64, mem(normal)](g1);
        failures: int64 <- (1 - valid) + case weight == 1200000 of { true -> 0; false -> 2 }
    produces pure failures end
}
