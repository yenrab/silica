// Phase 10.1 — int8 heap element payload round trip.
use heap_binary_min;

fn main() -> int64 {
    sequence proc[mem(normal)]
        h0: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int8, 8) } <- heap_binary_min@empty[int8, mem(normal)]();
        expected: int8 <- 14;
        pushed: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int8, 8) }, ok: int64 } <- heap_binary_min@push[int8, mem(normal)](h0, expected);
        peeked: { ok: int64, value: int8 } <- heap_binary_min@peek[int8, mem(normal)](pushed.heap);
        popped: { heap: { region: region(L1, normal), len: int64, capacity: int64, values: buf(L1, normal, int8, 8) }, ok: int64, value: int8 } <- heap_binary_min@pop[int8, mem(normal)](pushed.heap);
        valid: { ok: int64, error_code: int64 } <- heap_binary_min@validate[int8, mem(normal)](popped.heap);
        failures: int64 <- (1 - pushed.ok) + (1 - peeked.ok) * 2 + case peeked.value == expected of { true -> 0; false -> 4 } + (1 - popped.ok) * 8 + case popped.value == expected of { true -> 0; false -> 16 } + (1 - valid.ok) * 32
    produces pure failures end
}
