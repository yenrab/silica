// Phase 10.1 — int16 map key and value payload round trip.
use btree_nodeid;

fn main() -> int64 {
    sequence proc[mem(normal)]
        t0: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int16, mem(normal)], values: List[int16, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] } <- btree_nodeid@empty[int16, int16, mem(normal)]();
        key: int16 <- 700;
        expected: int16 <- 2100;
        r: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int16, mem(normal)], values: List[int16, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <- btree_nodeid@insert[int16, int16, mem(normal)](t0, key, expected);
        contains_key: int64 <- btree_nodeid@contains[int16, int16, mem(normal)](r.tree, key);
        got: { found: int64, value: int16 } <- btree_nodeid@get[int16, int16, mem(normal)](r.tree, key);
        valid: { ok: int64, error_code: int64 } <- btree_nodeid@validate[int16, int16, mem(normal)](r.tree);
        failures: int64 <- (1 - r.inserted) + (1 - contains_key) * 2 + (1 - got.found) * 4 + case got.value == expected of { true -> 0; false -> 8 } + (1 - valid.ok) * 16
    produces pure failures end
}
