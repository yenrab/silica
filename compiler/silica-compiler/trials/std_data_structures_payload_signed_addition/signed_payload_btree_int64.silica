// Phase 10.1 — int64 map key and value payload round trip.
use btree_nodeid;

fn main() -> int64 {
    sequence proc[mem(normal)]
        t0: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] } <- btree_nodeid@empty[int64, int64, mem(normal)]();
        r: { tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, inserted: int64, replaced: int64 } <- btree_nodeid@insert[int64, int64, mem(normal)](t0, 700000, 2100000);
        contains_key: int64 <- btree_nodeid@contains[int64, int64, mem(normal)](r.tree, 700000);
        got: { found: int64, value: int64 } <- btree_nodeid@get[int64, int64, mem(normal)](r.tree, 700000);
        valid: { ok: int64, error_code: int64 } <- btree_nodeid@validate[int64, int64, mem(normal)](r.tree);
        failures: int64 <- (1 - r.inserted) + (1 - contains_key) * 2 + (1 - got.found) * 4 + case got.value == 2100000 of { true -> 0; false -> 8 } + (1 - valid.ok) * 16
    produces pure failures end
}
