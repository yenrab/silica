.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X10, #1
    STR X10, [SP, #-16]!
    ADRP X9, L_i64_0@PAGE
    LDR X9, [X9, L_i64_0@PAGEOFF]
    ADRP X10, L_i64_1@PAGE
    LDR X10, [X10, L_i64_1@PAGEOFF]


    ADD X9, X9, X10
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_i64_0:
    .quad 1000000000000000000

L_i64_1:
    .quad 2000000000000000000

