.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X10, #2
    STR X10, [SP, #-16]!
    MOV X9, #10
    MOV X10, #3


    SDIV X0, X9, X10
    MSUB X9, X0, X10, X9
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
