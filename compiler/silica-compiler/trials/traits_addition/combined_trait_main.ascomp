.text
    ; use Sizeable, Doubling
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X0, #11
    ; effects []|sir_rec:o70|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, size@PAGE
    ADD X9, X9, size@PAGEOFF
    BLR X9
    ; unsupported term kind ?
    ADRP X9, double@PAGE
    ADD X9, X9, double@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
