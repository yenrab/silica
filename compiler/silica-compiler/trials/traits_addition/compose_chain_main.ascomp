.text
    ; use Doubling, TextStat
.global main


main:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_str_0@PAGE
    ADD X0, X0, L_str_0@PAGEOFF
    ; effects []|sir_rec:o70|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, char_len@PAGE
    ADD X9, X9, char_len@PAGEOFF
    BLR X9
    ; unsupported term kind ?
    ADRP X9, double@PAGE
    ADD X9, X9, double@PAGEOFF
    BLR X9
    LDP X29, X30, [SP], #16
    RET
.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "ab"
    .byte 0

