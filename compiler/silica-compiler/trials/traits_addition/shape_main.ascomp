.text
    ; use Shape
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    STR X0, [SP, #-16]!
    SUB SP, SP, #16
    MOV X9, #3
    STR X9, [SP, #0]
    MOV X9, #4
    STR X9, [SP, #8]
    MOV X0, SP
    ; effects []|sir_rec:o60|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, double_area___width___int32___length___int32__@PAGE
    ADD X9, X9, double_area___width___int32___length___int32__@PAGEOFF
    BLR X9
    MOV W10, W0
    ADD SP, SP, #16
    LDR X0, [SP], #16

    STR W10, [SP, #-16]!

    MOV X0, #5
    ; effects []|sir_rec:o37|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, double_area__int32@PAGE
    ADD X9, X9, double_area__int32@PAGEOFF
    BLR X9
    MOV W9, W0
    LDR W10, [SP], #16


    ADD W0, W9, W10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
