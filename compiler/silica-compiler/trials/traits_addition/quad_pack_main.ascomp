.text
    ; use QuadPack
.global main


main:     STP X29, X30, [SP, #-16]!

    SUB SP, SP, #32
    MOV X9, #1
    STR X9, [SP, #0]
    MOV X9, #2
    STR X9, [SP, #8]
    MOV X9, #3
    STR X9, [SP, #16]
    MOV X9, #4
    STR X9, [SP, #24]
    MOV X0, SP
    ; unsupported term kind ?
    ADRP X9, corner_sum@PAGE
    ADD X9, X9, corner_sum@PAGEOFF
    BLR X9
    ADD SP, SP, #32
    LDP X29, X30, [SP], #16
    RET
