// silica:Section30_1_1 — requiredMethods: signatures only; impl supplies bodies.
// silica:Section3_2 — declaration includes trait_declaration | impl_declaration (see jsonld grammar.declaration).
// silica:Section3_2 — inlineRecordTypesAndStructLiterals: impl targets inline `{ field: Type, … }`, not named structs.

trait Describable {
    fn label(self) -> string
}

impl Describable for { id: int64, tag: string } {
    fn label(self) -> string {
        self.tag
    }
}

fn record_item(id: int64, tag: string) -> { id: int64, tag: string } {
    r: { id: int64, tag: string } <- { id: id, tag: tag };
    r
}

fn main() -> atom {
    item: { id: int64, tag: string } <- record_item(1, "alpha");
    _: string <- item.label();
    atom
}
