.text
    ; use Sizeable, Scalable, Doubling, Labeled, TwiceRaw
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!

    MOV X0, #11
    ; effects []|sir_rec:o140|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, size@PAGE
    ADD X9, X9, size@PAGEOFF
    BLR X9
    MOV X19, X0
    MOV X0, X19
    ; effects [device_io]
    BL L_pi_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #7
    ; effects []|sir_rec:o248|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, scale@PAGE
    ADD X9, X9, scale@PAGEOFF
    BLR X9
    MOV X20, X0
    MOV X0, X20
    ; effects [device_io]
    BL L_pi_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #3
    ; effects []|sir_rec:o356|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, double@PAGE
    ADD X9, X9, double@PAGEOFF
    BLR X9
    MOV X21, X0
    MOV X0, X21
    ; effects [device_io]
    BL L_pi_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #41
    ; effects []|sir_rec:o465|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, code_of@PAGE
    ADD X9, X9, code_of@PAGEOFF
    BLR X9
    MOV X22, X0
    MOV X0, X22
    ; effects [device_io]
    BL L_pi_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #5
    ; effects []|sir_rec:o575|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, total@PAGE
    ADD X9, X9, total@PAGEOFF
    BLR X9
    MOV X23, X0
    MOV X0, X23
    ; effects [device_io]
    BL L_pi_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, #0

    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pi_helper:
    SUB SP, SP, #32
    MOV X10, SP
    ADD X10, X10, #24
    MOV X11, #0
    CMP X0, #0
    B.ge L_pi_pos
    MOV X11, #1
    NEG X0, X0
L_pi_pos:
    MOV X8, X10
    CMP X0, #0
    B.eq L_pi_zero
    MOV X9, #10
L_pi_loop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pi_loop
    B L_pi_maybe_neg
L_pi_zero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pi_maybe_neg:
    CBNZ X11, L_pi_prepend_minus
    B L_pi_do_write
L_pi_prepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pi_do_write:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    MOV X16, #4
    SVC #0x80
    ADD SP, SP, #32
    RET
.section __TEXT,__rodata
.align	8
atom_0:
    .byte  0x3a, 0x6f, 0x6b, 0

.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii ""
    .byte 0
L_str_1:
    .ascii "\n"
    .byte 0

L_newline:
    .byte 10

