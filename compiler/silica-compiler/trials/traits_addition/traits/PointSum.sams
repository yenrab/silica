.text
.global pair_sum
    ; export_trait PointSum
    ; required_fn pair_sum a|b PointSum|PointSum -> int64 []


pair_sum:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, X20


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
