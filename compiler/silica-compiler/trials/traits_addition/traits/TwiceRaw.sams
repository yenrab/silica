.text
.global raw
.global total
    ; export_trait TwiceRaw
    ; required_fn raw n TwiceRaw -> int64 []


total:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    STR X0, [SP, #-16]!
    MOV X0, X19
    ; effects []|sir_rec:o168|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, raw@PAGE
    ADD X9, X9, raw@PAGEOFF
    BLR X9
    MOV X10, X0
    LDR X0, [SP], #16

    STR X10, [SP, #-16]!

    MOV X0, X19
    ; effects []|sir_rec:o150|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, raw@PAGE
    ADD X9, X9, raw@PAGEOFF
    BLR X9
    MOV X9, X0
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

raw:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!


    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
