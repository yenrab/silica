.text
    ; use Sizeable, Scalable
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    STR X0, [SP, #-16]!
    MOV X0, #4
    ; effects []|sir_rec:o73|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, scale@PAGE
    ADD X9, X9, scale@PAGEOFF
    BLR X9
    MOV X10, X0
    LDR X0, [SP], #16

    STR X10, [SP, #-16]!

    MOV X0, #3
    ; effects []|sir_rec:o54|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, size@PAGE
    ADD X9, X9, size@PAGEOFF
    BLR X9
    MOV X9, X0
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
