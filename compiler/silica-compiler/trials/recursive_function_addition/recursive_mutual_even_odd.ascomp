.text
.global main


main.even:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    MOV X9, X19
    MOV X10, #0


    CMP X9, X10
    CSET X2, EQ
L_case_o83_br_0:
    CMP W2, #1
    B.NE L_case_o83_br_1
    MOV X0, #1
    B L_case_o83_done
L_case_o83_br_1:
    CMP W2, #0
    B.NE L_case_o83_fb
    MOV X9, X19
    MOV X10, #1


    SUB X0, X9, X10
    ; effects []|sir_rec:o136|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.odd@PAGE
    ADD X9, X9, main.odd@PAGEOFF
    BLR X9
    B L_case_o83_done
L_case_o83_fb:
    MOV X0, #0
    B L_case_o83_done
L_case_o83_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main.odd:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    MOV X9, X19
    MOV X10, #0


    CMP X9, X10
    CSET X2, EQ
L_case_o188_br_0:
    CMP W2, #1
    B.NE L_case_o188_br_1
    MOV X0, #0
    B L_case_o188_done
L_case_o188_br_1:
    CMP W2, #0
    B.NE L_case_o188_fb
    MOV X9, X19
    MOV X10, #1


    SUB X0, X9, X10
    ; effects []|sir_rec:o241|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.even@PAGE
    ADD X9, X9, main.even@PAGEOFF
    BLR X9
    B L_case_o188_done
L_case_o188_fb:
    MOV X0, #0
    B L_case_o188_done
L_case_o188_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    STR X0, [SP, #-16]!
    MOV X0, #7
    ; effects []|sir_rec:o297|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.odd@PAGE
    ADD X9, X9, main.odd@PAGEOFF
    BLR X9
    MOV X10, X0
    LDR X0, [SP], #16

    STR X10, [SP, #-16]!

    MOV X0, #8
    ; effects []|sir_rec:o287|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, main.even@PAGE
    ADD X9, X9, main.even@PAGEOFF
    BLR X9
    MOV X9, X0
    LDR X10, [SP], #16


    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
