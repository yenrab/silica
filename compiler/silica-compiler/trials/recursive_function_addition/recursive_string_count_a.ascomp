.text
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


count_a_step:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    MOV X0, X19
    MOV X1, #0
    STR X1, [SP, #-16]!
    MOV X2, #1
    LDR X1, [SP], #16
    BL L_substring_helper
    MOV X20, X0
    MOV X2, X20
L_case_o189_br_0:
    STR X2, [SP, #-16]!
    ADRP X3, L_str_0@PAGE
    ADD X3, X3, L_str_0@PAGEOFF
    MOV X0, X2
    MOV X1, X3
    BL L_string_eq_helper
    MOV W12, W0
    LDR X2, [SP], #16
    CMP W12, #0
    B.EQ L_case_o189_br_1
    MOV X0, #1
    B L_case_o189_done
L_case_o189_br_1:
    MOV X0, #0
    B L_case_o189_done
L_case_o189_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o189_done
L_case_o189_done:
    MOV X21, X0
    MOV X9, X21
    STR X9, [SP, #-16]!
    MOV X0, X19
    MOV X1, #1
    STR X1, [SP, #-16]!
    MOV X0, X19
    STR X0, [SP, #-16]!
    BL L_length_chars_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X2, X12

    LDR X1, [SP], #16
    BL L_substring_helper
    ; effects []|sir_rec:o263|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, count_a_rec@PAGE
    ADD X9, X9, count_a_rec@PAGEOFF
    BLR X9
    MOV X10, X0
    LDR X9, [SP], #16

    ADD X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

count_a_rec:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0

    MOV X10, #0
    STR X10, [SP, #-16]!
    MOV X0, X19
    STR X0, [SP, #-16]!
    BL L_length_chars_helper
    MOV X12, X0
    LDR X0, [SP], #16
    MOV X9, X12

    LDR X10, [SP], #16


    CMP X9, X10
    CSET X2, EQ
L_case_o353_br_0:
    CMP W2, #1
    B.NE L_case_o353_br_1
    MOV X0, #0
    B L_case_o353_done
L_case_o353_br_1:
    CMP W2, #0
    B.NE L_case_o353_fb
    MOV X0, X19
    ; effects []|sir_rec:o420|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, count_a_step@PAGE
    ADD X9, X9, count_a_step@PAGEOFF
    BLR X9
    B L_case_o353_done
L_case_o353_fb:
    BL _silica_rt_case_clause
    MOV X0, #0
    B L_case_o353_done
L_case_o353_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    BL _silica_pid_registry_init
    ADRP X0, L_str_1@PAGE
    ADD X0, X0, L_str_1@PAGEOFF
    ; effects []|sir_rec:o482|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, count_a_rec@PAGE
    ADD X9, X9, count_a_rec@PAGEOFF
    BLR X9
    MOV X19, X0
    MOV X9, X19
    MOV X10, #1
    MUL X0, X9, X10
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #21
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_substring_helper:
    STP X19, X20, [SP, #-64]!
    STP X21, X22, [SP, #16]
    STP X23, X14, [SP, #32]
    STR X15, [SP, #48]
    MOV X19, X0
    MOV X20, X1
    MOV X21, X2
    CMP X20, #0
    CSEL X20, XZR, X20, LT
    CMP X21, #0
    CSEL X21, XZR, X21, LT
    LDRB W10, [X19]
    CMP W10, #0xFF
    B.NE L_ss_lit_base
    LDR X8, [X19, #8]
    LDR X22, [X19, #16]
    B L_ss_len_done
L_ss_lit_base:
    MOV X8, X19
    MOV X9, X19
    MOV X22, #0
L_ss_len:
    LDRB W10, [X9]
    CBZ W10, L_ss_len_done
    ADD X22, X22, #1
    ADD X9, X9, #1
    B L_ss_len
L_ss_len_done:
    MOV X9, #0
    MOV X14, #0
L_ss_find_start:
    CMP X14, X20
    B.GE L_ss_start_found
    CMP X9, X22
    B.GE L_ss_start_found
    LDRB W10, [X8, X9]
    CMP W10, #0x80
    B.LO L_ss_adv1
    CMP W10, #0xC2
    B.LO L_ss_adv1
    CMP W10, #0xE0
    B.LO L_ss_adv2
    CMP W10, #0xF0
    B.LO L_ss_adv3
    CMP W10, #0xF8
    B.LO L_ss_adv4
L_ss_adv1:
    ADD X9, X9, #1
    ADD X14, X14, #1
    B L_ss_find_start
L_ss_adv2:
    SUB X18, X22, X9
    MOV X17, #2
    CMP X18, #2
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_start
L_ss_adv3:
    SUB X18, X22, X9
    MOV X17, #3
    CMP X18, #3
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_start
L_ss_adv4:
    SUB X18, X22, X9
    MOV X17, #4
    CMP X18, #4
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_start
L_ss_start_found:
    MOV X23, X9
L_ss_find_end:
    CMP X14, X21
    B.GE L_ss_end_found
    CMP X9, X22
    B.GE L_ss_end_found
    LDRB W10, [X8, X9]
    CMP W10, #0x80
    B.LO L_ss_eadv1
    CMP W10, #0xC2
    B.LO L_ss_eadv1
    CMP W10, #0xE0
    B.LO L_ss_eadv2
    CMP W10, #0xF0
    B.LO L_ss_eadv3
    CMP W10, #0xF8
    B.LO L_ss_eadv4
L_ss_eadv1:
    ADD X9, X9, #1
    ADD X14, X14, #1
    B L_ss_find_end
L_ss_eadv2:
    SUB X18, X22, X9
    MOV X17, #2
    CMP X18, #2
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_end
L_ss_eadv3:
    SUB X18, X22, X9
    MOV X17, #3
    CMP X18, #3
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_end
L_ss_eadv4:
    SUB X18, X22, X9
    MOV X17, #4
    CMP X18, #4
    CSEL X17, X18, X17, LO
    ADD X9, X9, X17
    ADD X14, X14, #1
    B L_ss_find_end
L_ss_end_found:
    CMP X23, X22
    CSEL X23, X22, X23, GT
    CMP X9, X23
    CSEL X9, X23, X9, LO
    CMP X9, X22
    CSEL X9, X22, X9, GT
    SUB X11, X9, X23
    CBZ X11, L_ss_empty
    ADD X0, X11, #1
    MOV X1, X0
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    MOV X15, X0
    MOV X9, X15
    ADD X10, X8, X23
    MOV X12, X11
L_ss_cp:
    CBZ X12, L_ss_cp_done
    LDRB W13, [X10]
    STRB W13, [X9]
    ADD X9, X9, #1
    ADD X10, X10, #1
    SUB X12, X12, #1
    B L_ss_cp
L_ss_cp_done:
    STRB WZR, [X9]
    MOV X0, X15
    B L_ss_ret
L_ss_empty:
    MOV X0, #1
    MOV X1, X0
    MOV X0, #0
    MOV X2, #3
    MOV X3, #0x1002
    MOV X4, #-1
    MOV X5, #0
    MOVZ X16, #0xC5
    MOVK X16, #0x200, LSL #16
    SVC #0x80
    STRB WZR, [X0]
L_ss_ret:
    LDR X15, [SP, #48]
    LDP X23, X14, [SP, #32]
    LDP X21, X22, [SP, #16]
    LDP X19, X20, [SP], #64
    RET
L_length_chars_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    MOV X19, X0
    CBZ X19, Lch_z
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Lch_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Lch_cstr
    LDR X20, [X0, #8]
    LDR X21, [X0, #16]
    MOV X2, #0x40000000
    CMP X21, X2
    B.HS Lch_cstr
    B Lch_count
Lch_cstr:
    MOV X20, X0
    MOV X21, #0
    MOV X1, X0
Lch_lp:
    LDRB W3, [X1], #1
    CBZ W3, Lch_count
    ADD X21, X21, #1
    CMP X21, #0x100000
    B.LT Lch_lp
Lch_count:
    ADD X26, X20, X21
    MOV X25, X20
    MOV X24, #0
Lch_loop:
    CMP X25, X26
    B.GE Lch_done
    LDRB W1, [X25], #1
    AND W2, W1, #0xC0
    CMP W2, #0x80
    B.EQ Lch_loop
    ADD X24, X24, #1
    B Lch_loop
Lch_done:
    MOV X0, X24
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
Lch_z:
    MOV X0, #0
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

L_string_eq_helper:
    STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1
    CBZ X19, Leq_anull
    CBZ X20, Leq_neq
    MOV X0, X19
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Leq_n1_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Leq_n1_cstr
    LDR X21, [X0, #8]
    LDR X22, [X0, #16]
    MOV X2, #0x40000000
    CMP X22, X2
    B.HS Leq_n1_cstr
    B Leq_n1_done
Leq_n1_cstr:
    MOV X21, X0
    MOV X22, #0
    MOV X1, X0
Leq_n1l:
    LDRB W3, [X1], #1
    CBZ W3, Leq_n1_done
    ADD X22, X22, #1
    CMP X22, #0x100000
    B.LT Leq_n1l
Leq_n1_done:
    MOV X0, X20
    LDRB W1, [X0]
    CMP W1, #0xFF
    B.NE Leq_n2_cstr
    LDR X1, [X0]
    MOV X2, #-1
    CMP X1, X2
    B.NE Leq_n2_cstr
    LDR X23, [X0, #8]
    LDR X24, [X0, #16]
    MOV X2, #0x40000000
    CMP X24, X2
    B.HS Leq_n2_cstr
    B Leq_n2_done
Leq_n2_cstr:
    MOV X23, X0
    MOV X24, #0
    MOV X1, X0
Leq_n2l:
    LDRB W3, [X1], #1
    CBZ W3, Leq_n2_done
    ADD X24, X24, #1
    CMP X24, #0x100000
    B.LT Leq_n2l
Leq_n2_done:
    CMP X22, X24
    B.NE Leq_neq
    CBZ X22, Leq_yes
    MOV X25, X21
    MOV X26, X23
    MOV X27, X22
Leq_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Leq_neq
    SUBS X27, X27, #1
    B.NE Leq_cloop
Leq_yes:
    MOV W0, #1
    B Leq_exit
Leq_anull:
    CBZ X20, Leq_yes
    B Leq_neq
Leq_neq:
    MOV W0, #0
Leq_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

