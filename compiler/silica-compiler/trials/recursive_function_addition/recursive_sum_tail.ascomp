.bss
.balign 8
.lcomm _silica_frame_depth, 8
.lcomm _silica_frame_max, 8
.lcomm _silica_fuel, 8
.lcomm _silica_saved_pc, 8

.text
.global main

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



sum_to:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    MOV X19, X0
    MOV X20, X1

    MOV X9, X19
    MOV X10, #0


    CMP X9, X10
    CSET X2, LE
L_case_o111_br_0:
    CMP W2, #1
    B.NE L_case_o111_br_1
    MOV X0, X20
    B L_case_o111_done
L_case_o111_br_1:
    CMP W2, #0
    B.NE L_case_o111_fb
    MOV X9, X20
    MOV X10, X19


    ADD X1, X9, X10

    MOV X9, X19
    MOV X10, #1


    SUB X0, X9, X10
    ; effects []|sir_rec:o166|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, sum_to@PAGE
    ADD X9, X9, sum_to@PAGEOFF
    BLR X9
    B L_case_o111_done
L_case_o111_fb:
    MOV X0, #0
    B L_case_o111_done
L_case_o111_done:

    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    BL _silica_pid_registry_init
    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X0, #10
    MOV X1, #0

    ; effects []|sir_rec:o223|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X9, sum_to@PAGE
    ADD X9, X9, sum_to@PAGEOFF
    BR X9

