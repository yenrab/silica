.bss
.balign 8
.lcomm _silica_frame_depth, 8
.lcomm _silica_frame_max, 8
.lcomm _silica_fuel, 8
.lcomm _silica_saved_pc, 8

.text
.global main

    ; --- recursion phases (recursion_implementation.jsonld) ---
    ; p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges
    ; p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback

    ; p4 observability: frame -> (fn id, source id) map; filter trampoline frames

    ; p6 trampoline fallback (optional):
    ; _silica_trampoline_dispatch: load target from frame / BR X8
    ; never rely on unbounded native recursion for general calls



main.ack_nonzero:     STP X29, X30, [SP, #-16]!

    MOV X9, X1
    MOV X10, #0


    CMP X9, X10
    CSET X2, EQ
L_case_o241_br_0:
    CMP W2, #1
    B.NE L_case_o241_br_1
    MOV X9, X0
    MOV X10, #1


    SUB X0, X9, X10
    MOV X1, #1

    ; effects []|sir_rec:o274|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X8, main.ack@PAGE
    ADD X8, X8, main.ack@PAGEOFF
    BLR X8
    B L_case_o241_done
L_case_o241_br_1:
    CMP W2, #0
    B.NE L_case_o241_fb
    STR X0, [SP, #-16]!

    MOV X9, X1
    MOV X10, #1


    SUB X1, X9, X10

    ; effects []|sir_rec:o317|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X8, main.ack@PAGE
    ADD X8, X8, main.ack@PAGEOFF
    BLR X8
    MOV X1, X0

    LDR X0, [SP], #16
    MOV X9, X0
    MOV X10, #1


    SUB X0, X9, X10
    ; effects []|sir_rec:o306|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X8, main.ack@PAGE
    ADD X8, X8, main.ack@PAGEOFF
    BLR X8
    B L_case_o241_done
L_case_o241_fb:
    MOV X0, #0
    B L_case_o241_done
L_case_o241_done:

    LDP X29, X30, [SP], #16
    RET

main.ack:     STP X29, X30, [SP, #-16]!

    MOV X9, X0
    MOV X10, #0


    CMP X9, X10
    CSET X2, EQ
L_case_o383_br_0:
    CMP W2, #1
    B.NE L_case_o383_br_1
    MOV X9, X1
    MOV X10, #1


    ADD X0, X9, X10
    B L_case_o383_done
L_case_o383_br_1:
    CMP W2, #0
    B.NE L_case_o383_fb



    ; effects []|sir_rec:o440|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X8, main.ack_nonzero@PAGE
    ADD X8, X8, main.ack_nonzero@PAGEOFF
    BLR X8
    B L_case_o383_done
L_case_o383_fb:
    MOV X0, #0
    B L_case_o383_done
L_case_o383_done:

    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    ; p3 fuel: LDR X9,=_silica_fuel / SUBS / B.EQ _silica_yield (optional)
    MOV X0, #3
    MOV X1, #3

    ; effects []|sir_rec:o492|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline|sir_rec:p3_fuel_edge|sir_rec:p5_tail_call
    LDP X29, X30, [SP], #16

    ADRP X8, main.ack@PAGE
    ADD X8, X8, main.ack@PAGEOFF
    BR X8

