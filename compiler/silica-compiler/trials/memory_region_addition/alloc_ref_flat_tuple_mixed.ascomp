.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    MOV X0, SP
    MOV X0, #4112
    BL _silica_rt_region_alloc
    ADD X4, X0, #16
    STR X4, [X0]
    MOV X5, #4112
    ADD X4, X0, X5
    STR X4, [X0, #8]
    MOV X1, X0
    SUB SP, SP, #32
    MOV X9, #42
    STR X9, [SP, #0]
    MOV X9, #1
    STR X9, [SP, #8]
    ADRP X10, L_f64_0@PAGE
    LDR D9, [X10, L_f64_0@PAGEOFF]
    STR D9, [SP, #16]
    MOV X2, SP
    MOV X19, X2

    MOV X2, X19

    LDR X3, [X1]
    LDR X4, [X1, #8]
    ADD X5, X3, #8
    CMP X5, X4
    B.HI L_region_overflow
    MOV X4, X3
    STR X2, [X3]
    ADD X3, X3, #8
    STR X3, [X1]
    MOV X2, X4
    MOV X0, #0
    ADD SP, SP, #32

    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

L_region_overflow:
    BL _abort

.section __TEXT,__rodata
.align	8
L_pb_true:
    .byte 0x74, 0x72, 0x75, 0x65, 0
L_pb_false:
    .byte 0x66, 0x61, 0x6c, 0x73, 0x65, 0

.section __TEXT,__rodata
.align	8
L_f64_0:
    .double 2.718

.section __TEXT,__rodata
.align	4
L_f32_0:
    .single 2.718

