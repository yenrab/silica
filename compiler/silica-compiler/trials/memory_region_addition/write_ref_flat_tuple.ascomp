.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    MOV X0, SP
    MOV X0, #4112
    BL _silica_rt_region_alloc
    ADD X4, X0, #16
    STR X4, [X0]
    MOV X5, #4112
    ADD X4, X0, X5
    STR X4, [X0, #8]
    MOV X1, X0

    SUB SP, SP, #16
    MOV X9, #0
    STR X9, [SP, #0]
    MOV X9, #0
    STR X9, [SP, #8]
    MOV X2, SP

    LDR X3, [X1]
    LDR X4, [X1, #8]
    ADD X5, X3, #8
    CMP X5, X4
    B.HI L_region_overflow
    MOV X4, X3
    STR X2, [X3]
    ADD X3, X3, #8
    STR X3, [X1]
    MOV X2, X4
    ADD SP, SP, #16
    MOV X1, X2
    SUB SP, SP, #16
    MOV X9, #5
    STR X9, [SP, #0]
    MOV X9, #10
    STR X9, [SP, #8]
    MOV X2, SP

    STR X2, [X1]
    ADD SP, SP, #16

    MOV X2, X1
    MOV X1, X2
    LDR X0, [X1]
    MOV X19, X0
    MOV X0, #0
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

L_region_overflow:
    BL _abort

