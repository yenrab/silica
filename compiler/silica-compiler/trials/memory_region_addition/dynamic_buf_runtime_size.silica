// Trial: alloc_buf with a runtime-sized buf(L, Space, T, N), then write/read round-trip.
// Step 0.1 for standard data structures: dynamic buffer sizes in type positions.

fn main() -> int64 {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        capacity: int64 <- 12;
        index: int64 <- 7;
        buf: buf(L1, normal, int64, capacity) <- alloc_buf(r, capacity);
        _: atom <- write_buf(buf, index, 123);
        value: int64 <- read_buf(buf, index)
    produces
        pure value
    end
}
