.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    MOV X0, SP
    MOV X0, #4112
    BL _silica_rt_region_alloc
    ADD X4, X0, #16
    STR X4, [X0]
    MOV X5, #4112
    ADD X4, X0, X5
    STR X4, [X0, #8]
    MOV X1, X0
    MOV X0, #0
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

