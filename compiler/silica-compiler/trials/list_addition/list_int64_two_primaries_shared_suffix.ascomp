.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X2, #0

    MOV X1, #3

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X2, X0

    MOV X1, #2

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X2, X0
    MOV X1, #1

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X1, X0
    MOV X3, X2
L_case_o823_br_0:
    CMP X3, #0
    B.NE L_case_o823_br_1
    MOV X3, #0
    B L_case_o823_done
L_case_o823_br_1:
    CBZ X3, L_case_o823_br_2
    LDR X3, [X3]

    B L_case_o823_done
L_case_o823_br_2:
    MOV X3, #0
    B L_case_o823_done
L_case_o823_fb:
    MOV X3, #0
    B L_case_o823_done
L_case_o823_done:
    MOV X4, X1
L_case_o1020_br_0:
    CMP X4, #0
    B.NE L_case_o1020_br_1
    MOV X4, #0
    B L_case_o1020_done
L_case_o1020_br_1:
    CBZ X4, L_case_o1020_br_2
    LDR X4, [X4]

    B L_case_o1020_done
L_case_o1020_br_2:
    MOV X4, #0
    B L_case_o1020_done
L_case_o1020_fb:
    MOV X4, #0
    B L_case_o1020_done
L_case_o1020_done:
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #4

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, X3
    ; effects [device_io]
    BL L_pi_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_3@PAGE
    ADD X1, X1, L_str_3@PAGEOFF
    MOV X2, #5

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X0, X4
    ; effects [device_io]
    BL L_pi_helper
    MOV X0, #0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_1@PAGE
    ADD X1, X1, L_str_1@PAGEOFF
    MOV X2, #0

    MOV X16, #4
    SVC #0x80
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    MOV X16, #4
    SVC #0x80
    MOV X0, #0

    MOV X9, X3
    MOV X10, X4
    ADD X0, X9, X10

    LDP X29, X30, [SP], #16
    RET
L_pi_helper:
    SUB SP, SP, #32
    MOV X10, SP
    ADD X10, X10, #24
    MOV X11, #0
    CMP X0, #0
    B.ge L_pi_pos
    MOV X11, #1
    NEG X0, X0
L_pi_pos:
    MOV X8, X10
    CMP X0, #0
    B.eq L_pi_zero
    MOV X9, #10
L_pi_loop:
    UDIV X1, X0, X9
    MSUB X2, X1, X9, X0
    ADD X2, X2, #48
    SUB X8, X8, #1
    STRB W2, [X8]
    MOV X0, X1
    CBNZ X0, L_pi_loop
    B L_pi_maybe_neg
L_pi_zero:
    SUB X8, X8, #1
    MOV X1, #48
    STRB W1, [X8]
L_pi_maybe_neg:
    CBNZ X11, L_pi_prepend_minus
    B L_pi_do_write
L_pi_prepend_minus:
    SUB X8, X8, #1
    MOV X1, #45
    STRB W1, [X8]
L_pi_do_write:
    SUB X2, X10, X8
    MOV X0, #1
    MOV X1, X8
    MOV X16, #4
    SVC #0x80
    ADD SP, SP, #32
    RET
L_list_length_helper:
    MOV X1, X0
    MOV X0, #0
L_list_len_loop:
    CBZ X1, L_list_len_done
    ADD X0, X0, #1
    LDR X1, [X1, #8]
    B L_list_len_loop
L_list_len_done:
    RET


.section __TEXT,__rodata
.align	8
L_str_0:
    .ascii "hb: "
    .byte 0
L_str_1:
    .ascii ""
    .byte 0
L_str_2:
    .ascii "\n"
    .byte 0
L_str_3:
    .ascii " he: "
    .byte 0

L_newline:
    .byte 10

