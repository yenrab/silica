.text
.global main


main.sum_list:     STP X29, X30, [SP, #-16]!

    MOV X2, X0
L_case_o526_br_0:
    CMP X2, #0
    B.NE L_case_o526_br_1
    MOV X0, #0
    B L_case_o526_done
L_case_o526_br_1:
    CBZ X2, L_case_o526_br_2
    LDR X1, [X2]
    LDR X2, [X2, #8]
    MOV X9, X1
    STR X9, [SP, #-16]!
    MOV X0, X2
    ; effects []|sir_rec:o645|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X8, main.sum_list@PAGE
    ADD X8, X8, main.sum_list@PAGEOFF
    BLR X8
    MOV X10, X0
    LDR X9, [SP], #16


    ADD X0, X9, X10
    B L_case_o526_done
L_case_o526_br_2:
    MOV X0, #0
    B L_case_o526_done
L_case_o526_fb:
    MOV X0, #0
    B L_case_o526_done
L_case_o526_done:

    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!

    MOV X2, #0

    MOV X1, #3

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X2, X0

    MOV X1, #2

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X2, X0

    MOV X1, #1

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0

    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o880|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X8, main.sum_list@PAGE
    ADD X8, X8, main.sum_list@PAGEOFF
    BLR X8

    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X1, X0
    MOV X0, #0
L_list_len_loop:
    CBZ X1, L_list_len_done
    ADD X0, X0, #1
    LDR X1, [X1, #8]
    B L_list_len_loop
L_list_len_done:
    RET

