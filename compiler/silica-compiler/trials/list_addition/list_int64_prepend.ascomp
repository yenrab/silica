.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!

    MOV X2, #0

    MOV X1, #3

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X2, X0

    MOV X1, #2

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X19, X0
    MOV X2, X19
    MOV X1, #1

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X20, X0
    MOV X3, X20
L_case_o685_br_0:
    CMP X3, #0
    B.NE L_case_o685_br_1
    MOV X0, #0
    B L_case_o685_done
L_case_o685_br_1:
    CBZ X3, L_case_o685_br_2
    LDR X0, [X3]

    B L_case_o685_done
L_case_o685_br_2:
    MOV X0, #0
    B L_case_o685_done
L_case_o685_fb:
    MOV X0, #0
    B L_case_o685_done
L_case_o685_done:
    MOV X21, X0
    MOV X0, X21
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X4, X0
    MOV X3, X2
    MOV X0, #0
L_list_len_loop:
    CBZ X4, L_list_len_done
    ADD X0, X0, #1
    ADD X5, X4, X3
    LDR X4, [X5]
    B L_list_len_loop
L_list_len_done:
    RET

.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

