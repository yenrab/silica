.text
.global main


main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP X21, X22, [SP, #-16]!
    STP X23, X24, [SP, #-16]!
    STP X25, X26, [SP, #-16]!
    STP X27, X28, [SP, #-16]!

    MOV X0, #0
    MOV X19, X0
    MOV X2, X19
    MOV X1, #0

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X20, X0
    MOV X2, X20
    MOV X1, #1

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X21, X0
    MOV X2, X21
    MOV X1, #2

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X22, X0
    MOV X2, X22
    MOV X1, #3

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X23, X0
    MOV X2, X23
    MOV X1, #4

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X24, X0
    MOV X2, X24
    MOV X1, #5

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X25, X0
    MOV X2, X25
    MOV X1, #6

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X26, X0
    MOV X2, X26
    MOV X1, #7

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X27, X0
    MOV X2, X27
    MOV X1, #8

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _silica_rt_region_alloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X0, X0
    MOV X28, X0
    MOV X9, X28
    MOV X0, X9
    MOV X2, #8
    BL L_list_length_helper

    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X4, X0
    MOV X3, X2
    MOV X0, #0
L_list_len_loop:
    CBZ X4, L_list_len_done
    ADD X0, X0, #1
    ADD X5, X4, X3
    LDR X4, [X5]
    B L_list_len_loop
L_list_len_done:
    RET

.globl _silica_rt_region_alloc
.p2align 2
_silica_rt_region_alloc:
    B _malloc

