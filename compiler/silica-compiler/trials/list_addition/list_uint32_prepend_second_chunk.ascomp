.text
.global main


main:     STP X29, X30, [SP, #-16]!

    MOV X0, #0
    MOV X2, X0
    MOV X1, #0

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X1, X0
    MOV X2, X1
    MOV X1, #1

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X3, X0
    MOV X2, X3
    MOV X1, #2

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X4, X0
    MOV X2, X4
    MOV X1, #3

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X5, X0
    MOV X2, X5
    MOV X1, #4

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X6, X0
    MOV X2, X6
    MOV X1, #5

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X7, X0
    MOV X2, X7
    MOV X1, #6

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X9, X0
    MOV X2, X9
    MOV X1, #7

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X10, X0
    MOV X2, X10
    MOV X1, #8

    STP X1, X2, [SP, #-16]!
    MOV X0, #16
    BL _malloc
    LDP X1, X2, [SP], #16
    STR X1, [X0]
    STR X2, [X0, #8]
    MOV X11, X0
    MOV X9, X11
    MOV X0, X9
    BL L_list_length_helper

    LDP X29, X30, [SP], #16
    RET
L_list_length_helper:
    MOV X1, X0
    MOV X0, #0
L_list_len_loop:
    CBZ X1, L_list_len_done
    ADD X0, X0, #1
    LDR X1, [X1, #8]
    B L_list_len_loop
L_list_len_done:
    RET

