.text
.extern _silica_rt_ffi_guarded_enter
.extern _silica_rt_ffi_guarded_exit
.extern _silica_rt_ffi_guarded_setjmp
.extern _silica_rt_ffi_guarded_fault_finish
.extern _silica_rt_ffi_arena_bump
.global main


left32:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f32_0@PAGE
    LDR S0, [X0, L_f32_0@PAGEOFF]
    LDP X29, X30, [SP], #16
    RET

right32:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f32_1@PAGE
    LDR S0, [X0, L_f32_1@PAGEOFF]
    LDP X29, X30, [SP], #16
    RET

next32:     STP X29, X30, [SP, #-16]!

    ADRP X0, L_f32_2@PAGE
    LDR S2, [X0, L_f32_2@PAGEOFF]
    FMOV S1, S0


    FADD S0, S1, S2
    LDP X29, X30, [SP], #16
    RET

add_with_next32:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!

    FMOV S1, S0
    STR S1, [SP, #-16]!

    ; effects []|sir_rec:o177|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, next32@PAGE
    ADD X9, X9, next32@PAGEOFF
    BLR X9
    FMOV S2, S0
    LDR S1, [SP], #16


    FADD S0, S1, S2
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

main:     STP X29, X30, [SP, #-16]!
    STP X19, X20, [SP, #-16]!
    STP D8, D9, [SP, #-16]!
    STP D10, D11, [SP, #-16]!

    BL _silica_pid_registry_init
    BL _silica_dangerous_pid_registry_init
    ADRP X0, L_f32_3@PAGE
    LDR S0, [X0, L_f32_3@PAGEOFF]
    FMOV S8, S0
    ADRP X0, L_f32_4@PAGE
    LDR S0, [X0, L_f32_4@PAGEOFF]
    FMOV S9, S0
    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o350|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, left32@PAGE
    ADD X9, X9, left32@PAGEOFF
    BLR X9
    FMOV S1, S0
    STR S1, [SP, #-16]!
    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o361|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, right32@PAGE
    ADD X9, X9, right32@PAGEOFF
    BLR X9
    FMOV S2, S0
    LDR S1, [SP], #16

    FADD S1, S1, S2
    FMOV S2, S8
    FCMP S1, S2
    CSET W0, EQ
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #0
    MOV X19, X0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0

    ADRP X0, L_f32_0@PAGE
    LDR S0, [X0, L_f32_0@PAGEOFF]
    FMOV S10, S0
    FMOV S1, S10
    STR S1, [SP, #-16]!
    ; unsupported term kind (dummy k)?
    ; effects []|sir_rec:o491|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, right32@PAGE
    ADD X9, X9, right32@PAGEOFF
    BLR X9
    FMOV S2, S0
    LDR S1, [SP], #16

    FADD S1, S1, S2
    FMOV S2, S8
    FCMP S1, S2
    CSET W0, EQ
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #0
    MOV X20, X0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0

    FMOV S2, S9
    STR S2, [SP, #-16]!
    ADRP X0, L_f32_5@PAGE
    LDR S0, [X0, L_f32_5@PAGEOFF]
    ; effects []|sir_rec:o585|sir_rec:p1_frame|sir_rec:p2_lower|sir_rec:p4_src|sir_rec:p6_trampoline
    ADRP X9, add_with_next32@PAGE
    ADD X9, X9, add_with_next32@PAGEOFF
    BLR X9
    FMOV S1, S0
    LDR S2, [SP], #16

    FCMP S1, S2
    CSET W0, EQ
    ; effects [device_io]
    BL L_pb_helper
    MOV X0, #0
    MOV X21, X0
    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_str_0@PAGE
    ADD X1, X1, L_str_0@PAGEOFF
    MOV X2, #0

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0


    ; effects [device_io]
    MOV X0, #1
    ADRP X1, L_newline@PAGE
    ADD X1, X1, L_newline@PAGEOFF
    MOV X2, #1

    STP X19, X20, [SP, #-16]!
    MOV X16, #4
    SVC #0x80
    LDP X19, X20, [SP], #16
    MOV X0, #0

    MOV X0, X21
    LDP D10, D11, [SP], #16
    LDP D8, D9, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET
L_pa_helper:
    CMP X0, #0
    B.lt L_pa_oob
    CMP X0, #21
    B.ge L_pa_oob
    ADRP X9, L_pa_table@PAGE
    ADD X9, X9, L_pa_table@PAGEOFF
    LSL X10, X0, #4
    ADD X9, X9, X10
    LDR X1, [X9]
    LDR X2, [X9, #8]
    MOV X0, #1
    MOV X16, #4
    SVC #0x80
    MOV X0, #0
    RET
L_pa_oob:
    MOV X0, #0
    RET

L_pb_helper:
    CMP X0, #0
    B.eq L_pb_false_branch
    MOV X0, #1
    ADRP X1, L_pb_true@PAGE
    ADD X1, X1, L_pb_true@PAGEOFF
    MOV X2, #4
    MOV X16, #4
    SVC #0x80
    B L_pb_after
L_pb_false_branch:
    MOV X0, #1
    ADRP X1, L_pb_false@PAGE
    ADD X1, X1, L_pb_false@PAGEOFF
    MOV X2, #5
    MOV X16, #4
    SVC #0x80
L_pb_after:
    RET
