fn main() -> atom {
    sequence proc[device_io]
        nan: float32 <- float32_nan();
        one: float32 <- 1.0;
        two: float32 <- 2.0;
        _: atom <- print_bool(float32_is_nan(nan + one));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan(one + nan));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan(nan - one));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan(one - nan));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan(nan * two));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan(two * nan));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan(nan / two));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan(two / nan));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan((nan + one) * two));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan((one + nan) / two));
        _: unit <- println("");
        _: atom <- print_bool(float32_is_nan(nan + float32_nan()));
        _: unit <- println("");
        done: atom <- print_bool(float32_is_nan((float32_nan() * nan) - float32_nan()));
        _: unit <- println("")
    produces
        pure done
    end
}
