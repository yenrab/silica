        "schema:url": "../compiler-building-tools/silica-parser-code-generator.jsonld"
      }
    },
    {
      "@id": "compiler:PhaseD_TypeChecker",
      "@type": "compiler:PlanPhase",
      "rdfs:label": "Phase D — Type checker",
      "compiler:dependsOn": ["compiler:PhaseC_Parser", "compiler:PhaseA_ABI"],
      "compiler:primaryTasks": [
        "Type get_cpu_topology as cpu_topology and get_core_capabilities(core_id) as core_info per spec.",
        "Spawn third argument: uint64 or core_id(uint64) only.",
        "Support decomposition/access for cpu_topology and core_info where spec allows."
      ],
      "compiler:typicalSourcePaths": [
        "compiler/silica-compiler/src/type_checker/expressions/type_checker_expressions.silica",
        "compiler/silica-compiler/src/type_checker/expressions/type_checker_tuple_decompose_helpers.silica",
        "compiler/silica-compiler/src/type_checker/expressions/type_checker_expressions_actors.silica"
      ],
