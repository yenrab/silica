    {
      "@id": "silica:Section1",
      "@type": "SpecificationSection",
      "rdfs:label": "1. Introduction",
      "sectionNumber": 1,
      "subsections": [
        {"@id": "silica:Section1_1", "title": "Overview"},
        {"@id": "silica:Section1_2", "title": "Design Principles"},
        {"@id": "silica:Section1_3", "title": "LLM-Friendly Design Principles"},
        {"@id": "silica:Section1_4", "title": "Target Platform"},
        {"@id": "silica:Section1_5", "title": "Compiler Interface"},
        {"@id": "silica:Section1_6", "title": "Compiler Error Messages"}
      ]
    },
    {
      "@id": "silica:Section1_1",
      "@type": "Concept",
      "rdfs:label": "1.1 Overview",
      "description": "Silica is a functional systems programming language designed for AArch64 architectures. It emphasizes explicit effect tracking, message-passing concurrency through actors, and memory safety through region-based ownership without garbage collection.",
      "characteristics": [
        "Functional systems programming language",
        "Designed for AArch64 architectures",
        "Explicit effect tracking",
        "Message-passing concurrency through actors",
        "Memory safety through region-based ownership",
        "No garbage collection"
      ]
    },
    {
      "@id": "silica:Section1_2",
      "@type": "Concept",
      "rdfs:label": "1.2 Design Principles",
      "principles": [
        {
          "name":         "Explicit Effects",
          "description": "All side effects are tracked and declared on sequence blocks"
        },
        {
          "name": "Process Monad",
          "description": "Sequential computations represented as monadic processes"
        },
        {
          "name": "Actor-Based Concurrency",
          "description": "Message passing as primary concurrency mechanism; gen_server-style actors (runtime recv loop, behavior (Msg, State) -> State, sends inside behavior)"
        },
        {
          "name": "Region-Based Memory",
          "description": "Safe memory management without garbage collection"
        },
        {
          "name": "No Loops",
          "description": "Recursion only; runtime handles internal looping"
        },
        {
          "name": "AArch64-Native",
          "description": "First-class support for ARM hardware features"
        },
        {
          "name": "No Generics",
          "description": "Polymorphism achieved through traits, not generic type parameters"
        },
        {
          "name": "LLM-Friendly and Human-Readable",
          "description": "Syntax and semantics designed to be easily parseable by Large Language Models while remaining intuitive for human developers"
        }
      ]
    },
    {
      "@id": "silica:Section1_3",
      "@type": "Concept",
      "rdfs:label": "1.3 LLM-Friendly Design Principles",
      "description": "Silica is designed to be both LLM-friendly and human-readable",
      "designChoices": [
        {
          "@id": "silica:ExplicitTypeAnnotations",
          "name": "Explicit Type Annotations",
          "description": "Function parameters and return types are always explicit",
          "examples": [
            "fn add(x: int64, y: int64) -> int64",
            "value: int64 <- 42",
            "case x of { n: int64 -> n * 2 }",
            "_: int64 -> 0"
          ],
          "benefit": "Eliminates ambiguity for LLMs parsing code, while making types clear to human readers"
        },
        {
          "@id": "silica:UnambiguousSyntaxPatterns",
          "name": "Unambiguous Syntax Patterns",
          "description": "Distinct operators for different operations",
          "operators": {
            "<-": "binding/assignment (clear left-to-right flow)",
            "=": "type aliases and equality comparison",
            "->": "function types and case branches"
          },
          "examples": [
            "sequence proc[device_io, concurrency]",
            "sequence...produces pure...end for sequence blocks",
            "{...} for case expressions"
          ],
          "benefit": "Reduces parsing ambiguity and makes code structure immediately apparent"
        },
        {
          "@id": "silica:ConsistentNamingConventions",
          "name": "Consistent Naming Conventions",
          "conventions": {
            "PascalCase": "Type names (Point, OptionInt, ResultIntString)",
            "snake_case": "Function and variable names (add_numbers, my_value)",
            "lowercase": "Keywords (fn, trait, impl, …). The token struct is reserved; it does not begin a record type declaration. Record types are inline `{ field: Type, … }`; record values are struct literals (§3.3.7)."
          },
          "benefit": "Predictable patterns that LLMs can learn and apply consistently"
        },
        {
          "@id": "silica:ConcreteTypesOverGenerics",
          "name": "Concrete Types Over Generics",
          "description": "Instead of generic types, use concrete types",
          "examples": [
            "OptionInt, OptionString instead of Option<T>",
            "ResultIntString instead of Result<T, E>"
          ],
          "benefit": "Eliminates type inference ambiguity, making code more explicit and easier to parse"
        },
        {
          "@id": "silica:StructuredPatternMatching",
          "name": "Structured Pattern Matching",
          "description": "Pattern matching uses explicit type annotations",
          "examples": [
            "n: int64 if n > 0 -> ...",
            "_: int64 -> 0",
            "pattern if condition -> expression"
          ],
          "benefit": "Clear control flow that LLMs can analyze and humans can verify"
        },
        {
          "@id": "silica:ExplicitEffectTracking",
          "name": "Explicit Effect Tracking",
          "description": "All side effects are declared on sequence blocks; function declarations do not contain effect declarations",
          "example": "sequence proc[device_io, mem(normal)] ... produces pure result end",
          "benefit": "Makes side effects visible to both LLMs and humans, enabling better code analysis"
        },
        {
          "@id": "silica:ModuleAndImportClarity",
          "name": "Module and Import Clarity",
          "description": "Explicit module declarations and imports",
          "examples": [
            "use calculator;",
            "export add/2;"
          ],
          "benefit": "Makes dependencies explicit and traceable"
        }
      ]
    },
    {
      "@id": "silica:Section1_4",
      "@type": "Concept",
      "rdfs:label": "1.4 Target Platform",
      "description": "Silica targets AArch64 (64-bit ARM) architectures",
      "optionalSupport": [
        "Scalable Vector Extensions (SVE/SVE2)",
        "NEON vector instructions",
        "Memory Tagging Extensions (MTE)",
        "Pointer Authentication (PAC)"
      ]
    },
    {
      "@id": "silica:Section1_5",
      "@type": "Concept",
      "rdfs:label": "1.5 Compiler Interface",
      "commandLineUsage": "silica-comp [options] <input.silica> [output.bc]",
      "moduleSearchPathOptions": {
        "--search-path <path>": "Add directory to module search paths",
        "-I <path>": "Add directory to module search paths (alternative)",
        "canBeSpecifiedMultipleTimes": true,
        "default": "current directory (.)"
      },
      "examples": [
        "silica-comp main.silica",
        "silica-comp -I ./modules -I ./stdlib main.silica",
        "silica-comp -I modules -I stdlib main.silica app.bc"
      ]
    },
    {
      "@id": "silica:Section1_6",
      "@type": "Concept",
      "rdfs:label": "1.6 Compiler Error Messages",
      "description": "Silica compiler error messages are designed to be both LLM-parseable and human-readable",
      "errorMessageFormat": {
        "pattern": "❌ Compilation error: [ErrorType] error at [file]:[line]:[column] [[ErrorCode]]\n\n[Human-readable error description]\nSee specification: spec:[section]\n\n<!-- SILICA-ERROR-METADATA\n{...}\n-->",
        "components": {
          "humanReadable": [
            "Clear, natural language description of the error",
            "Specific location information (file, line, column)",
            "Reference to specification section using spec: prefix",
            "Emoji indicator (❌ for errors)"
          ],
          "llmParseable": [
            "Structured JSON metadata embedded in HTML comment",
            "Error code classification (e.g., E2000)",
            "Error type and severity level",
            "Location information with file, line, column, and offset",
            "Reference to specification section"
          ]
        }
      },
      "errorCategories": [
        {"name": "Lexical Errors", "description": "Invalid tokens, unterminated strings, etc."},
        {"name": "Syntax Errors", "description": "Invalid grammar, missing tokens, etc."},
        {"name": "Type Errors", "description": "Type mismatches, missing implementations, etc."},
        {"name": "Effect Errors", "description": "Missing effect declarations, invalid effect usage"},
        {"name": "Pattern Matching Errors", "description": "Non-exhaustive patterns, type mismatches"},
        {"name": "Module Errors", "description": "Missing imports, circular dependencies, etc."},
        {"name": "Lifetime Errors (E21xx)", "description": "Reference outlives region, region not in scope. See spec:§12.1.4."},
        {"name": "Region Isolation Errors (E21xx)", "description": "Region mismatch (ref(L1, ...) used with region(L2, ...) when L1 ≠ L2). See spec:§12.4.1."},
        {"name": "Bounds Errors (E21xx)", "description": "Buffer index out of bounds. See spec:§12.3.3."}
      ]
    },
    {
      "@id": "silica:Section2",
      "@type": "SpecificationSection",
      "rdfs:label": "2. Lexical Structure",
      "sectionNumber": 2,
      "subsections": [
        {"@id": "silica:Section2_1", "title": "Character Set"},
        {"@id": "silica:Section2_2", "title": "Tokens"},
        {"@id": "silica:Section2_3", "title": "Comments"},
        {"@id": "silica:Section2_4", "title": "Whitespace"},
        {"@id": "silica:Section2_5", "title": "Lexical Errors"}
      ],
      "references": [{"@id": "silica:ListLiterals"}]
    },
    {
      "@id": "silica:Section2_1",
      "@type": "Concept",
      "rdfs:label": "2.1 Character Set",
      "description": "Silica source code is UTF-8 encoded",
      "characterSet": {
        "keywords": "ASCII characters",
        "operators": "ASCII characters",
        "punctuation": "ASCII characters",
        "unicodeAllowed": ["string literals", "character literals", "comments", "atom literals"]
      }
    },
    {
      "@id": "silica:Section2_2",
      "@type": "Concept",
      "rdfs:label": "2.2 Tokens",
      "subsections": [
        {"@id": "silica:Keywords", "title": "Keywords"},
        {"@id": "silica:Identifiers", "title": "Identifiers"},
        {"@id": "silica:Literals", "title": "Literals"},
        {"@id": "silica:OperatorsAndPunctuation", "title": "Operators and Punctuation"}
      ]
    },
    {
      "@id": "silica:Keywords",
      "@type": "SyntaxElement",
      "rdfs:label": "Keywords",
      "description": "Reserved keywords in Silica",
      "keywords": [
        "actor", "actor_ref", "atom", "atomic", "boolean", "buf", "case", "cast",
        "char", "concurrency", "core_id", "core_set", "device_io", "effect", "efficiency_cores",
        "else", "end", "enum", "export", "false", "float16", "float32", "float64",
        "fn", "for", "from", "hot_swap", "if", "impl", "import", "int8",
        "int16", "int32", "int64", "lifetime", "mailbox", "mem", "module", "network_io", "normal", "not",
        "of", "performance_cores", "proc", "produces", "pub", "pure", "recv", "ref", "region", "register_rwr",
        "self", "send", "sequence", "spawn", "string", "struct", "trait", "true", "type",
        "underscore", "unit", "use", "where"
      ]
    },
    {
      "@id": "silica:Identifiers",
      "@type": "SyntaxElement",
      "rdfs:label": "Identifiers",
      "description": "Identifiers start with a letter or underscore, followed by letters, digits, or underscores",
      "grammar": "identifier ::= letter (letter | digit | \"_\")*",
      "examples": ["x", "value", "my_function", "_private", "actor_ref", "TypeName", "CONSTANT_VALUE"]
    },
    {
      "@id": "silica:Literals",
      "@type": "SyntaxElement",
      "rdfs:label": "Literals",
      "description": "Literal values in Silica",
      "types": [
        {
          "@id": "silica:IntegerLiterals",
          "name": "Integer Literals",
          "grammar": "integer_literal ::= decimal_literal | hex_literal | binary_literal",
          "examples": ["42", "0x2A", "0b101010"]
        },
        {
          "@id": "silica:FloatingPointLiterals",
          "name": "Floating-Point Literals",
          "grammar": "float_literal ::= decimal_float | scientific_float",
          "examples": ["3.14", "0.5", "1.0e10", "2.5E-3"]
        },
        {
          "@id": "silica:BooleanLiterals",
          "name": "Boolean Literals",
          "grammar": "boolean_literal ::= \"true\" | \"false\"",
          "examples": ["true", "false"]
        },
        {
          "@id": "silica:CharacterLiterals",
          "name": "Character Literals",
          "grammar": "character_literal ::= \"'\" character \"'\"",
          "escapeSequences": ["\\\\", "\\'", "\\\"", "\\n", "\\t", "\\r"]
        },
        {
          "@id": "silica:StringLiterals",
          "name": "String Literals",
          "grammar": "string_literal ::= \"\\\"\" {character | escape_sequence} \"\\\"\""
        },
        {
          "@id": "silica:UnitLiteral",
          "name": "Unit Literal",
          "grammar": "unit_literal ::= \"(\" \")\"",
          "example": "()"
        },
        {
          "@id": "silica:AtomLiterals",
          "name": "Atom Literals",
          "grammar": "atom_literal ::= \":\" atom_name",
          "atomNameRule": "All characters are acceptable in atom names except the start character ':'; any character not in the delimiter set is valid, including Unicode (emojis, accented letters, etc.)",
          "atomDelimiters": {
            "whitespace": ["space", "tab", "newline", "carriage return"],
            "grouping": ["(", ")", "{", "}", "[", "]", ","],
            "operators": ["+", "-", "*", "/", "%", "<", ">", "=", "!", ":", ";", ".", "|"],
            "other": ["&", "#", "?", "~", "^", "backtick", "backslash"]
          },
          "atomDelimiterNote": "@ is never used as an atom delimiter; @ is reserved for module@function qualified calls.",
          "examples": [":ok", ":error", ":not_found", ":ready", ":pending", ":done", ":🔥", ":café", ":_private"],
          "description": "Symbolic constants prefixed with colon, compared by identity, stored in compile-time atom table"
        }
      ]
    },
    {
      "@id": "silica:OperatorsAndPunctuation",
      "@type": "SyntaxElement",
      "rdfs:label": "Operators and Punctuation",
      "operators": {
        "arithmetic": ["+", "-", "*", "/", "%"],
        "comparison": ["==", "!=", "<", "<=", ">", ">="],
        "logical": ["and", "or", "not"],
        "assignmentAndBinding": ["<-", "=", "|"],
        "functionAndType": ["->", ":", "::"],
        "moduleFunction": ["@"],
        "groupingAndSeparation": ["(", ")", "[", "]", "{", "}", ",", ";", ".", "|"]
      }
    },
    {
      "@id": "silica:Section2_3",
      "@type": "Concept",
      "rdfs:label": "2.3 Comments",
      "types": [
        {
          "name": "Line Comments",
          "grammar": "line_comment ::= \"//\" {any_character_except_newline}",
          "example": "// This is a line comment"
        },
        {
          "name": "Block Comments",
          "grammar": "block_comment ::= \"{-\" {any_character} \"-}\"",
          "example": "{- This is a\n   block comment -}"
        }
      ],
      "note": "Comments are ignored by the lexer and have no effect on program semantics"
    },
    {
      "@id": "silica:Section2_4",
      "@type": "Concept",
      "rdfs:label": "2.4 Whitespace",
      "description": "Whitespace characters (spaces, tabs, newlines) are used to separate tokens but are otherwise ignored",
      "requirement": "At least one whitespace character or comment must separate adjacent tokens"
    },
    {
      "@id": "silica:Section2_5",
      "@type": "Concept",
      "rdfs:label": "2.5 Lexical Errors",
      "errorTypes": [
        "Invalid escape sequences in literals",
        "Unterminated string or character literals",
        "Invalid numeric literals (e.g., 0xGG)",
        "Reserved keywords used as identifiers"
      ]
    },
    {
      "@id": "silica:Section3",
      "@type": "SpecificationSection",
      "rdfs:label": "3. Syntax",
      "sectionNumber": 3,
      "description": "Syntax definitions using Extended Backus-Naur Form (EBNF)",
      "grammarNotation": {
        "{item}": "zero or more repetitions",
        "[item]": "optional item",
        "item | item": "alternatives",
        "\"terminal\"": "literal terminals",
        "nonterminal": "grammar rules"
      },
      "subsections": [
        {"@id": "silica:Section3_1", "title": "Grammar Notation"},
        {"@id": "silica:Section3_2", "title": "Program Structure"},
        {"@id": "silica:Section3_3", "title": "Expressions"},
        {"@id": "silica:Section3_4", "title": "Declarations"},
        {"@id": "silica:Section3_5", "title": "Patterns"},
        {"@id": "silica:Section3_6", "title": "Pattern Matching Semantics"},
        {"@id": "silica:Section3_7", "title": "Types"},
        {"@id": "silica:Section3_8", "title": "Effects"},
        {"@id": "silica:Section3_9", "title": "Operator Precedence and Associativity"}
      ]
    },
    {
      "@id": "silica:Section3_1",
      "@type": "Concept",
      "rdfs:label": "3.1 Grammar Notation",
      "description": "Extended Backus-Naur Form (EBNF) notation used throughout the specification",
      "notation": {
        "{item}": "zero or more repetitions",
        "[item]": "optional item",
        "item | item": "alternatives",
        "\"terminal\"": "literal terminals",
        "nonterminal": "grammar rules"
      }
    },
    {
      "@id": "silica:Section3_2",
      "@type": "Concept",
      "rdfs:label": "3.2 Program Structure",
      "grammar": {
        "program": "{declaration}",
        "declaration": "function_declaration | effect_declaration | import_declaration | export_declaration | trait_declaration | impl_declaration | module_declaration"
      },
      "inlineRecordTypesAndStructLiterals": "Aligned with silica-specification.md §3.2 and §3.4.2: there are no top-level type_declaration, type_alias_declaration, or enum_declaration forms that introduce a new user-defined type name. Record types are inline `{ field: Type, ... }`. Record values are struct literals only (§3.3.7): `{ field: expression, ... }` or `identifier { field: expression, ... }` where the grammar allows. The reserved keyword struct does not open a record type declaration.",
      "functionDeclarationRestriction": "Function declarations are only allowed at the top level of a program. Nested function declarations inside other function bodies are not permitted. Use function literals (lambdas) for nested computations.",
      "functionReturnSemantics": "User-defined functions return the result of the last expression in the function body. There is no return keyword; the value of the final expression is implicitly the return value.",
      "functionBodySemicolonRule": "No semicolon is required for the final expression in a function body. For example: fn main() -> int64 { 42 }"
    },
    {
      "@id": "silica:Section3_3",
      "@type": "Concept",
      "rdfs:label": "3.3 Expressions",
      "grammar": "expression ::= literal | identifier | atom_literal | \"(\" expression \")\" | expression binary_operator expression | unary_operator expression | function_call | function_literal | case_expression | sequence_expression | struct_literal | field_access | tuple_literal | constructor_call | cast_expression",
      "structLiteralNote": "struct_literal denotes inline record values only (see silica:StructLiterals). It is not a declaration form.",
      "subsections": [
        {"@id": "silica:FunctionCalls", "title": "Function Calls"},
        {"@id": "silica:CaseExpressions", "title": "Case Expressions"},
        {"@id": "silica:ListPatternMatching", "title": "List Pattern Matching"},
        {"@id": "silica:SequenceExpressions", "title": "Sequence Expressions"},
        {"@id": "silica:CaseGuardsIfKeyword", "title": "Case guards (only use of if)"},
        {"@id": "silica:FunctionLiterals", "title": "Function Literals"},
        {"@id": "silica:StructLiterals", "title": "Struct Literals"}
      ]
    },
    {
      "@id": "silica:StructLiterals",
      "@type": "SyntaxElement",
      "rdfs:label": "3.3.7 Struct Literals",
      "specSection": "3.3.7",
      "description": "Record values are written only as struct literals. There is no named struct Name { ... } declaration. Anonymous `{ field: expression, ... }` and, where permitted, `identifier { field: expression, ... }` are values, not declarations. See silica-specification.md §3.3.7 and §3.4.2.",
      "grammar": "struct_literal ::= \"{\" field_initializer {\",\" field_initializer} \"}\" | identifier \"{\" [field_initializer {\",\" field_initializer}] \"}\" ; field_initializer ::= identifier \":\" expression",
      "examples": ["{ x: 42, y: 23 }", "p: { x: int64, y: int64 } <- { x: 42, y: 23 }"]
    },
    {
      "@id": "silica:FunctionCalls",
      "@type": "SyntaxElement",
      "rdfs:label": "Function Calls",
      "grammar": "function_call ::= expression \"(\" [argument_list] \")\" | qualified_method_call",
      "qualifiedMethodCall": {
        "grammar": "qualified_method_call ::= identifier \"@\" identifier \"(\" [argument_list] \")\"",
        "description": "The @ operator discriminates between the module name and the function name for any function that exists in a different module than the one in which it is being used",
        "example": "ModuleName@function_name(args)"
      }
    },
    {
      "@id": "silica:CaseExpressions",
      "@type": "SyntaxElement",
      "rdfs:label": "Case Expressions",
      "grammar": "case_expression ::= \"case\" expression \"of\" \"{\" {case_branch} \"}\"",
      "caseBranch": "pattern [\"if\" expression] \"->\" expression \";\"",
      "ifKeywordRestriction": "The keyword `if` is valid only in this guard position after a pattern. Standalone if/if-else/if-then-else expressions are not Silica syntax; use case (e.g. case condition of { true -> ...; false -> ... }). See silica:CaseGuardsIfKeyword.",
      "features": [
        "Optional guard expressions",
        "Guard evaluated after pattern matching succeeds",
        "Branch taken only if guard evaluates to true",
        "Catch-all patterns must use declared types: _: type -> expression",
        "Exclusive surface use of the `if` keyword (see §3.3.5)"
      ],
      "exhaustivenessChecking": {
        "description": "Exhaustiveness checking considers both pattern coverage and guard conditions",
        "rules": [
          "Pattern Exhaustiveness: All possible values of the matched type must be covered by patterns",
          "Guard Exhaustiveness: For each pattern, guards must cover all possible cases, or a catch-all pattern must be provided",
          "Patterns without guards cover all values matching the pattern",
          "Patterns with guards only cover values that match both the pattern AND the guard condition",
          "Catch-all patterns cover all values not matched by previous patterns, regardless of guards"
        ]
      }
    },
    {
      "@id": "silica:CaseGuardsIfKeyword",
      "@type": "SyntaxElement",
      "rdfs:label": "3.3.5 Case guards — only use of if",
      "description": "Silica does not provide standalone if/if-else or if-then-else expressions. The keyword if appears only in case branch guards immediately after a pattern: pattern if guard_expression -> branch_body.",
      "restriction": "Independent if...else is not valid surface syntax; express branching with case (including case on a boolean).",
      "specSection": "3.3.5",
      "caseBranchGrammar": "pattern [\"if\" expression] \"->\" expression \";\"",
      "booleanBranchingExample": "case condition of { true -> e1; false -> e2 }"
    },
    {
      "@id": "silica:SequenceExpressions",
      "@type": "SyntaxElement",
      "rdfs:label": "Sequence Expressions",
      "grammar": "sequence_expression ::= \"sequence\" [\"proc\" \"[\" effect_list \"]\"] {statement} \"produces\" \"pure\" expression \"end\"",
      "statementGrammar": "statement ::= pattern \"<-\" expression \";\" | expression \";\"",
      "description": "A sequence block runs steps in order and returns a value. The produces keyword marks the result boundary; pure asserts the returned expression introduces no new effects. Effectful sequences must declare effects: sequence proc[effect_list].",
      "examples": [
        "sequence ... produces pure result end",
        "sequence proc[device_io, mem(normal)] ... produces pure ref end"
      ]
    },
    {
      "@id": "silica:Section4",
      "@type": "SpecificationSection",
      "rdfs:label": "4. Built-in Types",
      "sectionNumber": 4,
      "subsections": [
        {"@id": "silica:Section4_1", "title": "Primitive Types"},
        {"@id": "silica:Section4_2", "title": "Compound Types"},
        {"@id": "silica:Section4_3", "title": "Process Types"},
        {"@id": "silica:Section4_4", "title": "Region and Memory Types"},
        {"@id": "silica:Section4_5", "title": "Actor Types"},
        {"@id": "silica:Section4_6", "title": "Core Affinity Types"},
        {"@id": "silica:Section4_7", "title": "SIMD Vector Types"}
      ]
    },
    {
      "@id": "silica:Section4_1",
      "@type": "Concept",
      "rdfs:label": "4.1 Primitive Types",
      "types": [
        {"name": "unit", "description": "Unit type representing no value"},
        {"name": "boolean", "description": "Boolean type (true, false)"},
        {"name": "int8", "description": "8-bit signed integer"},
        {"name": "int16", "description": "16-bit signed integer"},
        {"name": "int32", "description": "32-bit signed integer"},
        {"name": "int64", "description": "64-bit signed integer"},
        {"name": "float16", "description": "16-bit floating-point"},
        {"name": "float32", "description": "32-bit floating-point"},
        {"name": "float64", "description": "64-bit floating-point"},
        {"name": "char", "description": "Character type"},
        {"name": "string", "description": "String type"},
        {"name": "atom", "description": "Symbolic constants prefixed with colon, compared by identity. All characters except atom delimiters (see Atom Literals) are valid in atom names, including Unicode such as emojis and accented letters."}
      ]
    },
    {
      "@id": "silica:Section4_2",
      "@type": "Concept",
      "rdfs:label": "4.2 Compound Types",
      "types": [
        {"name": "Function Types", "syntax": "T1 -> T2"},
        {"name": "Tuple Types", "syntax": "(T1, T2, ...)", "recursiveExtension": {"@id": "silica:RecursiveTupleTypes"}},
        {"name": "Record Types", "syntax": "{field1: T1, field2: T2}", "values": "Struct literals only: `{ field: expression, … }` or `name { field: expression, … }` per §3.3.7; no `struct Name { … }` type declaration (§3.4.2)."},
        {"name": "List Types", "syntax": "List[ElementType]", "reference": {"@id": "silica:ListType"}},
        {"name": "Variant Types", "syntax": "Constructor1 [Type1] | Constructor2 [Type2] | ..."}
      ]
    },
    {
      "@id": "silica:RecursiveTupleTypes",
      "@type": "Concept",
      "rdfs:label": "Recursive Tuple Types (Extension)",
      "description": "Tuple types may contain rec (self-reference) and ref?(R, Space, T) for optional region references. Base case :none. Construction via alloc_rec. See recursive_tuple_specification.md.",
      "keywords": ["rec", ":none"],
      "syntax": {
        "rec": "Self-reference; valid only inside tuple type",
        "refQuestion": "ref?(R, Space, T) = ref(R, Space, T) | :none",
        "allocRec": "alloc_rec(region, (value, ...)) -> ref(R, Space, tuple_type)"
      }
    },
    {
      "@id": "silica:Section4_3",
      "@type": "Concept",
      "rdfs:label": "4.3 Process Types",
      "sectionNumber": 4.3,
      "description": "Process types represent monadic computations",
      "syntax": "proc[Effects] ResultType",
      "examples": ["proc[] int", "proc[mem(normal)] ref(region, int)", "proc[concurrency] actor_ref(msg)"]
    },
    {
      "@id": "silica:Section4_4",
      "@type": "Concept",
      "rdfs:label": "4.4 Region and Memory Types",
      "sectionNumber": 4.4,
      "description": "Region types, reference types, buffer types, and atomic types. Lifetime identifiers (L) are obtained via fresh_lifetime(). Each distinct region allocation must use a distinct lifetime. Region allocation is permitted only within sequence blocks. When a region reference is returned from a sequence or function, the region is not deallocated at scope exit; its lifetime extends to the caller.",
      "types": ["lifetime", "region(L, Space)", "ref(L, Space, T)", "buf(L, Space, T, N)"],
      "lifetimeType": "Built-in type lifetime; values from fresh_lifetime()",
      "freshLifetime": "fresh_lifetime() -> lifetime returns unique lifetime per call",
      "allocationScope": "Region allocation only in sequence blocks",
      "memorySpaces": {
        "normal": "Normal memory (write-back cacheable, default)",
        "normal_writeback": "Normal memory with write-back caching (default normal)",
        "normal_writethrough": "Normal memory with write-through caching",
        "normal_noncacheable": "Normal memory, non-cacheable",
        "atomic": "Atomic memory region (for atomic operations)",
        "device": "Device memory (reserved for future driver library)"
      },
      "examples": ["region(L1, normal)", "region(L1, atomic)", "ref(L1, normal, int)", "buf(L1, normal, int, 1024)"]
    },
    {
      "@id": "silica:Section4_5",
      "@type": "Concept",
      "rdfs:label": "4.5 Actor Types",
      "sectionNumber": 4.5,
      "description": "Actor reference type for message-passing concurrency",
      "syntax": "actor_ref"
    },
    {
      "@id": "silica:Section4_6",
      "@type": "Concept",
      "rdfs:label": "4.6 Core Affinity Types",
      "sectionNumber": 4.6,
      "description": "Types for CPU core affinity in actor placement",
      "types": ["core_id", "core_set", "performance_cores", "efficiency_cores"]
    },
    {
      "@id": "silica:Section4_7",
      "@type": "Concept",
      "rdfs:label": "4.7 SIMD Vector Types",
      "sectionNumber": 4.7,
      "description": "NEON 128-bit and SVE scalable vector types for AArch64",
      "markerTraits": [
        {"name": "Vec128Element", "description": "Marker trait for NEON 128-bit vector elements"},
        {"name": "VecElement", "description": "Marker trait for SVE scalable vector elements"}
      ],
      "neonTypes": ["Vec128Int8", "Vec128Int16", "Vec128Int32", "Vec128Int64", "Vec128Float32", "Vec128Boolean"],
      "sveTypes": ["VecInt8", "VecInt16", "VecInt32", "VecInt64", "VecFloat16", "VecFloat32", "VecFloat64", "VecBoolean"],
      "svePredicateType": "Pred"
    },
    {
      "@id": "silica:Section8",
      "@type": "SpecificationSection",
      "rdfs:label": "8. Type System",
      "sectionNumber": 8,
      "description": "Type system including type equivalence, subtyping, and trait-based polymorphism",
      "keyConcepts": [
        {"@id": "silica:TypeEquivalence", "name": "Type Equivalence"},
        {"@id": "silica:SubtypingRules", "name": "Subtyping Rules"},
        {"@id": "silica:TraitBasedPolymorphism", "name": "Trait-Based Polymorphism"},
        {"@id": "silica:CollectableTrait", "name": "Collectable Trait"}
      ]
    },
    {
      "@id": "silica:TypeEquivalence",
      "@type": "Concept",
      "rdfs:label": "Type Equivalence",
      "description": "Types are equivalent only if they have the same name",
      "rule": "No structural subtyping - all types must match exactly",
      "example": "type MyInt = int64; type YourInt = int64; MyInt ≢ YourInt"
    },
    {
      "@id": "silica:SubtypingRules",
      "@type": "Concept",
      "rdfs:label": "Subtyping Rules",
      "description": "Silica has no structural subtyping - all types must match exactly",
      "polymorphism": "Polymorphism is achieved through traits, where types implementing the same trait can be used interchangeably in trait-constrained contexts"
    },
    {
      "@id": "silica:TraitBasedPolymorphism",
      "@type": "Concept",
      "rdfs:label": "Trait-Based Polymorphism",
      "description": "Polymorphism through independent trait implementations. Types provide implementations for required methods. Traits never compose with other traits; each is self-contained.",
      "providedMethods": "Fully implemented in the trait declaration. May call required methods via dynamic dispatch.",
      "requiredMethods": "Just signatures in the trait. Must be implemented by the type.",
      "example": "trait Display { provided { fn to_string(self) -> string { \"default\" } } }; impl Display for int64 { fn to_string(self) -> string { ... } };"
    },
    {
      "@id": "silica:Section9",
      "@type": "SpecificationSection",
      "rdfs:label": "9. Effect System",
      "sectionNumber": 9,
      "description": "Effect system for tracking side effects in type signatures",
      "keyConcepts": [
        "Explicit effect declarations",
        "Effect propagation through call chains",
        "Effect categories: device_io (print, file I/O, console read), network_io (network communications), hot_swap (code loading), register_rwr (direct device register access via mmap), concurrency, mem(normal)"
      ]
    },
    {
      "@id": "silica:Section15",
      "@type": "SpecificationSection",
      "rdfs:label": "15. Actor Model Semantics",
      "sectionNumber": 15,
      "description": "Actor model for message-passing concurrency (gen_server-style: runtime recv loop, behavior (Msg, State) -> State)",
      "keyConcepts": [
        "Actor creation with spawn()",
        "Runtime recv() between behavior invocations; user behavior may send/cast/reply (effects on sequence blocks)",
        "Actor references (actor_ref)",
        "Actor state management via behavior return value"
      ]
    },
    {
      "@id": "silica:Section16",
      "@type": "SpecificationSection",
      "rdfs:label": "16. Message Passing",
      "sectionNumber": 16,
      "description": "Message passing primitives and semantics",
      "keyConcepts": [
        "send() / cast() from behavior body or elsewhere (with effects)",
        "recv() runtime-internal only; behavior receives Msg as a parameter",
        "Mailbox semantics (FIFO per actor)",
        "Request-reply: message types may carry sender actor_ref for replies"
      ]
    },
    {
      "@id": "silica:Section19",
      "@type": "SpecificationSection",
      "rdfs:label": "19. Module System",
      "sectionNumber": 19,
      "description": "Module system for organizing code",
      "keyConcepts": [
        "module declarations",
        "import declarations (use module;)",
        "export declarations (export function/arity;)",
        "Module search paths"
      ]
    },
    {
      "@id": "silica:Section30",
      "@type": "SpecificationSection",
      "rdfs:label": "30. Advanced Type System",
      "sectionNumber": 30,
      "description": "Advanced type system features including independent traits with provided/required methods and multiple trait implementation",
      "subsections": [
        {"@id": "silica:Section30_1", "title": "Traits"},
        {"@id": "silica:Section30_1_1", "title": "Trait Definitions"},
        {"@id": "silica:Section30_1_2", "title": "Multiple Trait Implementation"},
        {"@id": "silica:Section30_1_3", "title": "Trait Method Calls"},
        {"@id": "silica:Section30_2", "title": "Trait-Based Polymorphism"}
      ]
    },
    {
      "@id": "silica:Section30_1",
      "@type": "Concept",
      "rdfs:label": "30.1 Traits",
      "description": "Traits are independent, reusable behavioral components. Each trait formally specifies provided methods (with implementations), required methods (signatures only), and detects conflicts when multiple traits are applied to the same type.",
      "mathematicalFoundation": "Traits follow mathematical trait theory from lambda calculus with traits. Each trait is a structured mapping from method names to implementations or specifications, supporting formal composition and conflict detection."
    },
    {
      "@id": "silica:Section30_1_1",
      "@type": "Concept",
      "rdfs:label": "30.1.1 Trait Definitions",
      "description": "Traits declare provided methods (with full implementation bodies) and required methods (signatures only). Provided methods may call required methods via dynamic dispatch.",
      "providedMethods": "Fully implemented methods with bodies. May call required methods at runtime. Can be overridden by implementations.",
      "requiredMethods": "Method signatures with no body. Must be implemented by types claiming the trait. Compile error if not provided.",
      "markerTraits": "Traits with no provided or required methods. Used for compile-time type checking only (e.g., ActorMessage, Collectable)."
    },
    {
      "@id": "silica:Section30_1_2",
      "@type": "Concept",
      "rdfs:label": "30.1.2 Multiple Trait Implementation",
      "description": "Types implement each trait separately via impl. Each trait is completely independent. Compiler error if two traits applied to the same type both provide/require the same method name.",
      "independence": "Traits never reference or inherit from other traits. No trait-to-trait composition.",
      "conflictDetection": "Compile-time error if multiple traits on same type have conflicting method names",
      "dynamicDispatch": "When provided methods call required methods, dispatch is resolved at runtime based on the actual implementation"
    },
    {
      "@id": "silica:Section30_1_3",
      "@type": "Concept",
      "rdfs:label": "30.1.3 Trait Method Calls",
      "description": "Trait methods are called using qualified names to explicitly specify which trait's version to invoke",
      "qualifiedCallSyntax": "TraitName.method_name(value, args...)",
      "directCallSyntax": "value.method_name(args...) when method name is unambiguous across all implemented traits"
    },
    {
      "@id": "silica:Section30_2",
      "@type": "Concept",
      "rdfs:label": "30.2 Trait-Based Polymorphism",
      "description": "Polymorphism is achieved through independent trait implementations on types. Each trait is a self-contained unit of behavior with no inter-trait dependencies.",
      "polymorphismMechanism": "Types implementing the same trait can be reasoned about through that trait's interface. Multiple independent traits can be applied to the same type, with compile-time conflict detection."
    },
    {
      "@id": "silica:CompilerErrorFormat",
      "@type": "Schema",
      "rdfs:label": "Compiler Error Format",
      "description": "Structured format for compiler error messages",
      "format": {
        "humanReadable": "❌ Compilation error: [ErrorType] error at [file]:[line]:[column] [[ErrorCode]]\n\n[Human-readable error description]\nSee specification: spec:[section]",
        "llmParseable": "<!-- SILICA-ERROR-METADATA\n{\n  \"@context\": \"https://aalang.dev/silica-dev/error/\",\n  \"errorCode\": \"[ErrorCode]\",\n  \"errorType\": \"[error|warning|info]\",\n  \"severity\": \"[error|warning|info]\",\n  \"location\": {\n    \"file\": \"[file]\",\n    \"line\": [line],\n    \"column\": [column],\n    \"offset\": [offset]\n  },\n  \"specification\": {\n    \"section\": \"[section]\"\n  }\n}\n-->"
      }
    },
    {
      "@id": "silica:GrammarNotation",
      "@type": "Concept",
      "rdfs:label": "Grammar Notation",
      "description": "Extended Backus-Naur Form (EBNF) notation used throughout the specification",
      "notation": {
        "{item}": "zero or more repetitions",
        "[item]": "optional item",
        "item | item": "alternatives",
        "\"terminal\"": "literal terminals",
        "nonterminal": "grammar rules"
      }
    },
    {
      "@id": "silica:PatternMatching",
      "@type": "Concept",
      "rdfs:label": "Pattern Matching",
      "description": "Pattern matching with exhaustiveness checking",
      "features": [
        "Case expressions with pattern matching",
        "Optional guard expressions",
        "Exhaustiveness checking",
        "Typed catch-all patterns"
      ],
      "exhaustivenessRules": {
        "patternExhaustiveness": "All possible values of the matched type must be covered by patterns",
        "guardExhaustiveness": "For each pattern, guards must cover all possible cases, or a catch-all pattern must be provided",
        "catchAllPattern": "Catch-all patterns (_: type) cover all values not matched by previous patterns"
      }
    },
    {
      "@id": "silica:EffectSystem",
      "@type": "Concept",
      "rdfs:label": "Effect System",
      "description": "Explicit effect tracking in type signatures",
      "effectCategories": [
        "device_io (print, read/write file, read console)",
        "network_io (network communications)",
        "hot_swap (code loading)",
        "register_rwr (direct device register access via mmap)",
        "concurrency",
        "mem(normal)"
      ],
      "syntax": "sequence proc[effect1, effect2, ...] ... produces pure result end",
      "declarationRule": "Effects are declared only on sequence blocks, not on function signatures. Function declarations do not contain effect declarations.",
      "example": "fn read_file(path: string) -> string { sequence proc[device_io, mem(normal)] ... produces pure content end }"
    },
    {
      "@id": "silica:ActorModel",
      "@type": "Concept",
      "rdfs:label": "Actor Model",
      "description": "Actor-based concurrency model (gen_server-style: runtime owns recv loop; behavior (Msg, State) -> State runs once per message and may send/cast/reply inside sequence blocks)",
      "primitives": [
        "spawn(initial_state, behavior_fn [, core_affinity]) - create actor with behavior (Msg, State) -> State",
        "send(actor_ref, message) -> atom - enqueue message (usable inside behavior with effects)",
        "recv() - runtime-internal only; retrieves next mailbox message between behavior calls",
        "cast(actor_ref, message) -> boolean - fire-and-forget enqueue (usable inside behavior with effects)"
      ],
      "types": [
        "actor_ref - reference to an actor",
        "ActorState trait - marker trait for actor state types",
        "ActorMessage trait - marker trait for message types"
      ]
    },
    {
      "@id": "silica:MemoryModel",
      "@type": "Concept",
      "rdfs:label": "Memory Model",
      "description": "Region-based memory management",
      "features": [
        "Region-based ownership",
        "No garbage collection",
        "Memory safety through static analysis",
        "Region annotations",
        "Region return lifetime extension: a region is not deallocated when a region reference is returned; its lifetime extends to the caller"
      ]
    },
    {
      "@id": "silica:ModuleSystem",
      "@type": "Concept",
      "rdfs:label": "Module System",
      "description": "Module system for code organization",
      "declarations": [
        "module name; - module declaration",
        "use module; - import declaration",
        "export function/arity; - export declaration"
      ],
      "searchPaths": {
        "default": "current directory (.)",
        "options": "--search-path <path> or -I <path>",
        "canBeSpecifiedMultipleTimes": true
      }
    },
    {
      "@id": "silica:TypeSystem",
      "@type": "Concept",
      "rdfs:label": "Type System",
      "description": "Type system with trait-based polymorphism",
      "features": [
        "No structural subtyping",
        "Type equivalence by name",
        "Trait-based polymorphism",
        "Multiple trait implementation",
        "Concrete types (no generics)"
      ]
    },
    {
      "@id": "silica:Traits",
      "@type": "Concept",
      "rdfs:label": "Traits",
      "description": "Trait system for polymorphism",
      "features": [
        "Trait declarations with trait keyword",
        "Trait implementations with impl keyword",
        "Multiple independent traits per type",
        "Qualified method calls for disambiguation",
        "Trait bounds in function signatures"
      ],
      "markerTraits": [
        {"name": "ActorState", "description": "Marker trait for types used as actor initial state"},
        {"name": "ActorMessage", "description": "Marker trait for types used as messages"}
      ]
    },
    {
      "@id": "silica:CollectableTrait",
      "@type": "Concept",
      "rdfs:label": "Collectable Trait",
      "description": "Marker trait indicating that a type can be collected in lists",
      "traitDefinition": "trait Collectable { }",
      "automaticImplementation": {
        "description": "The following types automatically implement Collectable without requiring explicit impl declarations",
        "primitiveTypes": ["unit", "boolean", "int8", "int16", "int32", "int64", "float16", "float32", "float64", "char", "string", "atom"],
        "functionTypes": "All function types of the form (T1 -> T2) where T1 and T2 are concrete types",
        "tupleTypes": "All tuple types of the form (T1, T2, ...) where all Ti are concrete types",
        "structTypes": "All inline record values (struct literals) automatically implement Collectable",
        "enumTypes": "All enum types automatically implement Collectable",
        "typeAliases": "Type aliases inherit Collectable from their underlying type",
        "listType": "List[ElementType] automatically implements Collectable for any ElementType"
      },
      "languageRule": "These automatic implementations are language rules, not explicit code. The compiler treats these types as Collectable by default. No explicit impl Collectable for ... declarations are needed or allowed for these built-in cases."
    },
    {
      "@id": "silica:ListType",
      "@type": "Concept",
      "rdfs:label": "List Type",
      "description": "Parameterized list type List[ElementType] where ElementType must implement Collectable",
      "syntax": "List[ElementType: Collectable]",
      "characteristics": [
        "Immutable - all operations return new lists",
        "Uses structural sharing for efficient head operations",
        "Element type must always be explicitly specified",
        "No type inference for lists",
        "Composed of sets of buffers sized to match vector processing units",
        "Non-primitive types stored as region references in buffers"
      ],
      "typeAnnotationRequirement": "All list variables and expressions must explicitly specify the element type using List[ElementType] syntax. The type List alone (without element type) is not valid.",
      "immutability": "Lists in Silica are immutable. All list operations return new lists rather than modifying existing lists. The language implementation uses structural sharing to make these operations efficient.",
      "headOperationsOnly": "All list modification operations work only on the head of the list. There are no operations to remove elements from the middle or end of a list.",
      "internalRepresentation": {
        "description": "Lists are composed of sets of buffers. The buffers are sized to match the vector processing units found on the target chip architecture (e.g., 128-bit or 256-bit buffers for NEON/SVE on AArch64).",
        "primitiveTypes": "Primitive types are stored directly in buffers",
        "nonPrimitiveTypes": "When a non-primitive type is stored in a list, a reference to a Silica region is placed in the buffer at the correct location relative to existing region references",
        "benefits": [
          "Enables efficient vectorized operations on list elements",
          "Aligns with AArch64 vector processing capabilities",
          "Optimizes memory layout for SIMD operations"
        ]
      },
      "typeCheckingRules": [
        "All elements in a list literal must have exactly the same type",
        "The explicit type annotation List[ElementType] must match the types of all elements exactly",
        "Mixing different types in a list literal is a compile-time error, even if both types implement Collectable",
        "The element type must implement Collectable"
      ]
    },
    {
      "@id": "silica:ListOperations",
      "@type": "Concept",
      "rdfs:label": "List Operations",
      "description": "Built-in operations for working with List[ElementType]",
      "operations": [
        {
          "name": "empty",
          "signature": "fn empty[ElementType: Collectable]() -> List[ElementType]",
          "description": "Create empty list with explicit element type"
        },
        {
          "name": "prepend",
          "signature": "fn prepend[ElementType: Collectable](item: ElementType, list: List[ElementType]) -> List[ElementType]",
          "description": "Prepend an element to the front of a list (returns new list). Uses structural sharing, does not copy existing elements."
        },
        {
          "name": "remove_head",
          "signature": "fn remove_head[ElementType: Collectable](list: List[ElementType]) -> List[ElementType]",
          "description": "Remove the head element from a list (returns new list). Uses structural sharing, does not copy remaining elements. Returns empty list if input list is empty."
        },
        {
          "name": "head",
          "signature": "fn head[ElementType: Collectable](list: List[ElementType]) -> ElementType",
          "description": "Get the head element of a list. Runtime error if list is empty."
        },
        {
          "name": "tail",
          "signature": "fn tail[ElementType: Collectable](list: List[ElementType]) -> List[ElementType]",
          "description": "Get the tail of a list (all elements except the head). Returns empty list if input list has 0 or 1 elements."
        },
        {
          "name": "reverse",
          "signature": "fn reverse[ElementType: Collectable](list: List[ElementType]) -> List[ElementType]",
          "description": "Reverse a list (returns new list with elements in reverse order)"
        },
        {
          "name": "length",
          "signature": "fn length[ElementType: Collectable](list: List[ElementType]) -> int64",
          "description": "Get list length"
        },
        {
          "name": "is_empty",
          "signature": "fn is_empty[ElementType: Collectable](list: List[ElementType]) -> boolean",
          "description": "Check if list is empty"
        }
      ]
    },
    {
      "@id": "silica:StringLengthOperations",
      "@type": "Concept",
      "rdfs:label": "String Length Operations",
      "description": "The only user-available functions for finding the length of strings in the silica-compiler",
      "operations": [
        {
          "name": "length_bytes",
          "signature": "fn length_bytes(s: string) -> int64",
          "description": "Return the byte length of a string (UTF-8 encoded size)"
        },
        {
          "name": "length_chars",
          "signature": "fn length_chars(s: string) -> int64",
          "description": "Return the character count of a string (number of Unicode scalar values)"
        }
      ]
    },
    {
      "@id": "silica:ListPatternMatching",
      "@type": "Concept",
      "rdfs:label": "List Pattern Matching",
      "description": "Pattern matching syntax for lists",
      "syntax": "case list_expression of { []: List[ElementType] -> expression; [head: ElementType, tail: List[ElementType]] -> expression; _: List[ElementType] -> expression; }",
      "rules": [
        "The ElementType in the pattern must match the list's element type exactly",
        "Pattern matching is exhaustive - all cases must be covered",
        "The head variable has type ElementType (the list's element type)",
        "The tail variable has type List[ElementType] with the same element type",
        "All patterns must explicitly specify List[ElementType] - List alone is not valid",
        "The non-empty pattern matches a list with at least one element, binding the first element to head and the remaining elements to tail"
      ]
    },
    {
      "@id": "silica:ListLiterals",
      "@type": "SyntaxElement",
      "rdfs:label": "List Literals",
      "description": "List literal syntax with explicit type annotation",
      "grammar": "list_literal ::= \"[\" [element_list] \"]\" \":\" \"List\" \"[\" element_type \"]\"",
      "examples": [
        "[]: List[string]",
        "[\"hello\", \"world\"]: List[string]",
        "[1, 2, 3]: List[int64]",
        "[fn(x: int64) -> int64 { x * 2 }]: List[(int64 -> int64)]"
      ],
      "typeChecking": "All elements in a list literal must have exactly the same type. The explicit type annotation List[ElementType] must match the types of all elements. Mixing different types in a list literal is a compile-time error."
    }
  ]
}
