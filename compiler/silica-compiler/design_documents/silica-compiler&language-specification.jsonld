    {
      "@id": "silica:CompilerFailureRules",
      "@type": "Concept",
      "rdfs:label": "Compiler Failure Rules (silica-specification-additional.md)",
      "description": "Anti-patterns that cause hard errors at compile time. The compiler must fail when any of these patterns are detected.",
      "sourceDocument": "silica-specification-additional.md",
      "rules": [
        {"rule": "3.1", "name": "Unused Bindings", "description": "A let binding whose variable is never used is a compile error", "errorMessage": "Unused binding: <name> — remove it or use it."},
        {"rule": "3.2", "name": "Duplicate Computation (CSE)", "description": "Computing the same expression twice in the same scope with the same inputs is a compile error", "errorMessage": "Duplicate computation: same expression appears twice — bind to a variable and reuse."},
        {"rule": "3.3", "name": "Redundant Algebraic Operations", "description": "Redundant operations (x * 1, x + 0, x * 0, x & 0, x | ~0, etc.) are compile errors", "errorMessage": "Redundant operation: <expr> — simplify to <simplified>."},
        {"rule": "3.4", "name": "Invariant Guards in Case Expressions", "description": "A guard that does not depend on any pattern bindings is a compile error", "errorMessage": "Guard does not depend on pattern bindings — move it before the case or restructure."},
        {"rule": "3.5", "name": "Loop-Invariant Code", "description": "An expression inside a loop that does not depend on any loop variables is a compile error", "errorMessage": "Loop-invariant expression — move outside the loop."},
        {"rule": "3.6", "name": "Constant Hoisting", "description": "A constant expression inside a loop body is a compile error", "errorMessage": "Constant expression in loop body — move outside the loop."},
        {"rule": "3.7", "name": "Redundant Constant Expressions", "description": "Literal constant expressions that can be simplified (e.g., 2 + 3 instead of 5) are compile errors", "errorMessage": "Redundant constant expression: <expr> — use <minimal>."},
        {"rule": "3.8", "name": "Strength Reduction", "description": "Multiplying by a literal power of two (e.g., x * 8) is a compile error; use shift instead", "errorMessage": "Multiply by power of two — use shift: <expr> → <shift_expr>."}
      ]
    },
    {
      "@id": "silica:SilicaLanguageSpecification",
