{
  "@context": {
    "@vocab": "https://schema.org/",
    "silica": "https://silica-lang.org/ns/recursion-impl#"
  },
  "@type": "TechArticle",
  "headline": "Recursion implementation: explicit frames, preemption, tail optimization",
  "description": "Structured plan for implementing recursion via explicit frame stacks, defunctionalized continuations, preemption checkpoints, and optional native tail-call optimization.",
  "about": {
    "@type": "Thing",
    "name": "Silica compiler runtime",
    "description": "Stack limits, allocation control, debuggability, preemptible recursion"
  },
  "hasPart": [
    {
      "@type": "HowTo",
      "name": "Phased implementation of recursion (explicit frames)",
      "totalTime": "P0M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Phase 1 — Core representation",
          "itemListElement": [
            {
              "@type": "HowToDirection",
              "position": 1,
              "text": "Define a process-local frame: callee identity, return PC or resume point, locals or pointers, optional defunctionalized continuation tag + payload."
            },
            {
              "@type": "HowToDirection",
              "position": 2,
              "text": "Define frame stack operations: push, pop, depth, max_depth with source-mapped overflow errors."
            },
            {
              "@type": "HowToDirection",
              "position": 3,
              "text": "Back the stack with a growable buffer or arena; reuse frame slots to limit allocation."
            },
            {
              "@type": "HowToDirection",
              "position": 4,
              "text": "Define saved execution state for preemption: frame pointer, PC, operand/temp registers as required by IR."
            }
          ]
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Phase 2 — Lowering and execution",
          "itemListElement": [
            {
              "@type": "HowToDirection",
              "position": 1,
              "text": "Lower recursive calls to explicit frame push and dispatch to target code."
            },
            {
              "@type": "HowToDirection",
              "position": 2,
              "text": "Lower returns to pop, merge result per IR, branch to resume PC."
            },
            {
              "@type": "HowToDirection",
              "position": 3,
              "text": "Use defunctionalized continuation states for post-recursive combine work."
            }
          ]
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Phase 3 — Preemption and fairness",
          "itemListElement": [
            {
              "@type": "HowToDirection",
              "position": 1,
              "text": "Attach reduction or fuel counter to the runnable unit; decrement per logical step or per N steps per policy."
            },
            {
              "@type": "HowToDirection",
              "position": 2,
              "text": "Check fuel on back-edges (tail calls, loop heads); yield when exhausted with full saved state."
            },
            {
              "@type": "HowToDirection",
              "position": 3,
              "text": "Validate worst-case run length between checks for tail-heavy code."
            }
          ]
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Phase 4 — Debugging and observability",
          "itemListElement": [
            {
              "@type": "HowToDirection",
              "position": 1,
              "text": "Map PC or IR node to source location for each frame."
            },
            {
              "@type": "HowToDirection",
              "position": 2,
              "text": "Format stack traces from explicit frames; filter internal trampoline frames if present."
            },
            {
              "@type": "HowToDirection",
              "position": 3,
              "text": "Optional dev-only push/pop tracing behind flags."
            }
          ]
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Phase 5 — Optimizations (optional)",
          "itemListElement": [
            {
              "@type": "HowToDirection",
              "position": 1,
              "text": "Emit native tail calls for provably tail-recursive sites; retain fuel checks on back-edges unless burst work is bounded."
            },
            {
              "@type": "HowToDirection",
              "position": 2,
              "text": "Profile and add shallow-recursion fast paths without changing semantics."
            }
          ]
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Phase 6 — Fallbacks",
          "itemListElement": [
            {
              "@type": "HowToDirection",
              "position": 1,
              "text": "If tail-call codegen is unavailable, use trampoline or frame VM without unbounded native recursion."
            }
          ]
        }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Design option ranking (preference, not mandatory build order)",
      "numberOfItems": 5,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Primary",
          "description": "Explicit frame stack plus interpreter dispatch loop; pooled or arena-backed."
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Refinement",
          "description": "Defunctionalized continuations (tag + payload); avoid heap closures on the default path."
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Optimization",
          "description": "Native tail calls where proven; keep preemption checkpoints on back-edges."
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Fallback",
          "description": "Trampoline only when needed; no per-step allocation."
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Avoid as default",
          "description": "Naive CPS with heap-allocated continuations."
        }
      ]
    }
  ],
  "silica:designGoals": [
    {
      "@type": "Thing",
      "name": "Stack limits",
      "description": "Flat native stack; explicit max frame depth."
    },
    {
      "@type": "Thing",
      "name": "Allocation",
      "description": "Arena or pool; rare growth; frame reuse."
    },
    {
      "@type": "Thing",
      "name": "Debuggability",
      "description": "Source-mapped frames; printable defunctionalized states."
    },
    {
      "@type": "Thing",
      "name": "Preemptibility",
      "description": "Serializable frames plus PC; fuel on back-edges."
    }
  ]
}
