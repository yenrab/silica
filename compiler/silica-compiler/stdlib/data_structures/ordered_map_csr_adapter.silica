use btree_csr_map;

export contains_key_csr/2;
export get_csr/2;
export size_csr/1;
export find_value_csr/2;
export fold_csr/3;

fn contains_key_csr(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> boolean {
    sequence
        found: int64 <- btree_csr_map@contains_key_csr(map, key);
        result: boolean <- case found of {
            0 -> false;
            _: int64 -> true
        }
    produces
        pure result
    end
}

fn get_csr(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> { found: int64, value: int64 } {
    sequence proc[mem(normal)]
        result: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](map, key)
    produces
        pure result
    end
}

fn size_csr(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    map.key_count_total
}

fn find_value_csr(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    value: int64
) -> { found: int64, key: int64 } {
    btree_csr_map@ordered_map_find_value(map, value)
}

fn fold_csr(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    init: int64,
    fold_ctx: { fold_step: fn(int64, int64, int64) -> int64 }
) -> int64 {
    btree_csr_map@ordered_map_fold(map, init, fold_ctx)
}
