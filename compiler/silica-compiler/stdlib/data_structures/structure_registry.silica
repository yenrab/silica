fn structure_family_design_doc(name: string) -> string {
    case structure_family_group(name) of {
        "graph" -> "graph_representation_design.md";
        "btree_set" -> "btree_set_design.md";
        "balanced_tree" -> "balanced_tree_and_heap_design.md";
        "heap" -> "balanced_tree_and_heap_design.md";
        _: string -> ""
    }
}

