// Phase 0 — design-document structure family registry (generator metadata only; no Silica emission).
// Registry keys use List-aligned bracket syntax (graph §2.11; btree set §4.1; balanced tree §2.6).
// Authority: graph_representation_design.md §§2.1–2.11, 8;
//   balanced_tree_and_heap_design.md §§2–3; btree_set_design.md §§4, 8–9.

export structure_family_count/0;
export structure_family_name_at/1;
export structure_family_is_registered/1;
export structure_family_group/1;
export structure_family_representation/1;
export structure_family_design_doc/1;
export structure_family_design_section/1;
export structure_family_memory_space/1;
export structure_family_directedness/1;
export structure_family_weightedness/1;
export structure_family_key_type/1;
export structure_family_capacity_constants/1;

// Families are listed by index via structure_family_name_at/1 (0 .. structure_family_count()-1).

fn structure_family_count() -> int64 {
    24
}

fn structure_family_name_at(index: int64) -> string {
    case index of {
        0 -> "NodeIdAdjacencyGraphDirected[mem(normal)]";
        1 -> "NodeIdAdjacencyGraphUndirected[mem(normal)]";
        2 -> "NodeIdAdjacencyGraphDirected[int64, mem(normal)]";
        3 -> "NodeIdAdjacencyGraphUndirected[int64, mem(normal)]";
        4 -> "CompressedSparseRowGraphDirected[mem(normal)]";
        5 -> "CompressedSparseRowGraphUndirected[mem(normal)]";
        6 -> "CompressedSparseRowGraphDirected[int64, mem(normal)]";
        7 -> "CompressedSparseRowGraphUndirected[int64, mem(normal)]";
        8 -> "DenseMatrixGraphDirected[mem(normal)]";
        9 -> "DenseMatrixGraphUndirected[mem(normal)]";
        10 -> "DenseMatrixGraphDirected[int64, mem(normal)]";
        11 -> "DenseMatrixGraphUndirected[int64, mem(normal)]";
        12 -> "DenseBitsetGraphDirected[mem(normal)]";
        13 -> "DenseBitsetGraphUndirected[mem(normal)]";
        14 -> "NodeIDBTreeSet[int64, mem(normal)]";
        15 -> "CsrBTreeSet[int64, mem(normal)]";
        16 -> "NodeIDBTree[int64, mem(normal)]";
        17 -> "NodeIDBTreeMap[int64, int64, mem(normal)]";
        18 -> "CsrBTree[int64, mem(normal)]";
        19 -> "CsrBTreeMap[int64, int64, mem(normal)]";
        20 -> "RegionBinaryMinHeap[int64, mem(normal)]";
        21 -> "RegionBinaryMaxHeap[int64, mem(normal)]";
        22 -> "RegionBinaryMinHeap[int64, int64, mem(normal)]";
        23 -> "RegionDaryMinHeap[int64, mem(normal)]";
        _: int64 -> ""
    }
}

fn structure_family_is_registered(name: string) -> bool {
    case name of {
        "NodeIdAdjacencyGraphDirected[mem(normal)]" -> true;
        "NodeIdAdjacencyGraphUndirected[mem(normal)]" -> true;
        "NodeIdAdjacencyGraphDirected[int64, mem(normal)]" -> true;
        "NodeIdAdjacencyGraphUndirected[int64, mem(normal)]" -> true;
        "CompressedSparseRowGraphDirected[mem(normal)]" -> true;
        "CompressedSparseRowGraphUndirected[mem(normal)]" -> true;
        "CompressedSparseRowGraphDirected[int64, mem(normal)]" -> true;
        "CompressedSparseRowGraphUndirected[int64, mem(normal)]" -> true;
        "DenseMatrixGraphDirected[mem(normal)]" -> true;
        "DenseMatrixGraphUndirected[mem(normal)]" -> true;
        "DenseMatrixGraphDirected[int64, mem(normal)]" -> true;
        "DenseMatrixGraphUndirected[int64, mem(normal)]" -> true;
        "DenseBitsetGraphDirected[mem(normal)]" -> true;
        "DenseBitsetGraphUndirected[mem(normal)]" -> true;
        "NodeIDBTreeSet[int64, mem(normal)]" -> true;
        "CsrBTreeSet[int64, mem(normal)]" -> true;
        "NodeIDBTree[int64, mem(normal)]" -> true;
        "NodeIDBTreeMap[int64, int64, mem(normal)]" -> true;
        "CsrBTree[int64, mem(normal)]" -> true;
        "CsrBTreeMap[int64, int64, mem(normal)]" -> true;
        "RegionBinaryMinHeap[int64, mem(normal)]" -> true;
        "RegionBinaryMaxHeap[int64, mem(normal)]" -> true;
        "RegionBinaryMinHeap[int64, int64, mem(normal)]" -> true;
        "RegionDaryMinHeap[int64, mem(normal)]" -> true;
        _: string -> false
    }
}

