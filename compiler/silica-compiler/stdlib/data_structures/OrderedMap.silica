    ordered_map_nodeid_adapter@find_value_nodeid(map, value)
}

impl fn fold(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    init: int64,
    fold_ctx: { fold_step: fn(int64, int64, int64) -> int64 }
) -> int64 {
    ordered_map_nodeid_adapter@fold_nodeid(map, init, fold_ctx)
}

impl fn compare_key(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- map.compare_key;
    cmp(left, right)
}

