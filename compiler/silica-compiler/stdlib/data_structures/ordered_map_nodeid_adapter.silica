use btree_nodeid;

export contains_key_nodeid/2;
export get_nodeid/2;
export size_nodeid/1;
export find_value_nodeid/2;
export fold_nodeid/3;

fn contains_key_nodeid(
    map: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> boolean {
    btree_nodeid@ordered_map_contains_key(map, key)
}

fn get_nodeid(
    map: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> { found: int64, value: int64 } {
    btree_nodeid@ordered_map_get(map, key)
}

fn size_nodeid(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    btree_nodeid@ordered_map_item_count(map)
}

fn find_value_nodeid(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    value: int64
) -> { found: int64, key: int64 } {
    btree_nodeid@ordered_map_find_value(map, value)
}

fn fold_nodeid(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    init: int64,
    fold_ctx: { fold_step: fn(int64, int64, int64) -> int64 }
) -> int64 {
    btree_nodeid@ordered_map_fold(map, init, fold_ctx)
}
