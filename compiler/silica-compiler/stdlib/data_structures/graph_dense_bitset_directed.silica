// DenseBitsetGraphDirected[mem(normal)] (graph_representation_design.md section 6).
// Generated-capacity implementation: WORD_COUNT = 4, supporting up to 16 nodes.

export empty[mem(normal)]/1;
export node_count[mem(normal)]/1;
export edge_count[mem(normal)]/1;
export set_edge[mem(normal)]/3;
export set_edge_checked[mem(normal)]/3;
export clear_edge[mem(normal)]/3;
export clear_edge_checked[mem(normal)]/3;
export has_edge[mem(normal)]/3;
export neighbor_at[mem(normal)]/3;
export out_degree[mem(normal)]/2;
export validate[mem(normal)]/1;

fn max_node_count() -> int64 {
    16
}

fn bit_capacity() -> int64 {
    256
}

fn graph_node_count_ok(count: int64) -> int64 {
    case count < 0 of {
        true -> 0;
        false -> case count <= max_node_count() of {
            true -> 1;
            false -> 0
        }
    }
}

fn node_id_in_range(node_id: int64, count: int64) -> int64 {
    case node_id < 0 of {
        true -> 0;
        false -> case node_id < count of {
            true -> 1;
            false -> 0
        }
    }
}

fn endpoints_ok(graph_node_count: int64, from_id: int64, to_id: int64) -> int64 {
    count_saved: int64 <- graph_node_count;
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    count_ok: int64 <- graph_node_count_ok(count_saved);
    case count_ok of {
        0 -> 0;
        1 -> {
            from_ok: int64 <- node_id_in_range(from_saved, count_saved);
            to_ok: int64 <- node_id_in_range(to_saved, count_saved);
            case from_ok of {
                0 -> 0;
                1 -> to_ok;
                _: int64 -> 0
            }
        };
        _: int64 -> 0
    }
}

fn bit_index_for(node_count_value: int64, from_id: int64, to_id: int64) -> int64 {
    from_id * node_count_value + to_id
}

fn word_index_for(bit_index: int64) -> int64 {
    bit_index / 64
}

fn bit_offset_for(bit_index: int64) -> int64 {
    bit_index % 64
}

fn mask_for_bit_offset(bit_offset: int64) -> uint64 {
    one: uint64 <- 1;
    one shl bit_offset
}

fn word_index_ok(word_index: int64) -> int64 {
    case word_index < 0 of {
        true -> 0;
        false -> case word_index < 4 of {
            true -> 1;
            false -> 0
        }
    }
}

fn read_word[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, word_index: int64) -> uint64 {
    index_saved: int64 <- word_index;
    sequence proc[mem(normal)]
        value: uint64 <- case word_index_ok(index_saved) of {
            0 -> 0;
            1 -> read_buf(graph.words, index_saved);
            _: int64 -> 0
        }
    produces
        pure value
    end
}

fn write_word[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, word_index: int64, value: uint64) -> atom {
    index_saved: int64 <- word_index;
    value_saved: uint64 <- value;
    sequence proc[mem(normal)]
        result: atom <- case word_index_ok(index_saved) of {
            0 -> 0;
            1 -> write_buf(graph.words, index_saved, value_saved);
            _: int64 -> 0
        }
    produces
        pure result
    end
}

fn bit_is_set_in_word(word: uint64, bit_offset: int64) -> int64 {
    mask: uint64 <- mask_for_bit_offset(bit_offset);
    present: uint64 <- (word band mask) shr bit_offset;
    case present == 0 of {
        true -> 0;
        false -> 1
    }
}

fn bit_is_set_at[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, bit_index: int64) -> int64 {
    bit_saved: int64 <- bit_index;
    case bit_saved < 0 of {
        true -> 0;
        false -> case bit_saved >= bit_capacity() of {
            true -> 0;
            false -> {
                word_index: int64 <- word_index_for(bit_saved);
                bit_offset: int64 <- bit_offset_for(bit_saved);
                word: uint64 <- read_word[mem(normal)](graph, word_index);
                bit_is_set_in_word(word, bit_offset)
            }
        }
    }
}

fn empty[mem(normal)](initial_node_count: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        words: buf(L1, normal, uint64, 4) <- alloc_buf(r, 4);
        zero: uint64 <- 0;
        _: atom <- write_buf(words, 0, zero);
        _: atom <- write_buf(words, 1, zero);
        _: atom <- write_buf(words, 2, zero);
        _: atom <- write_buf(words, 3, zero);
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            words: buf(L1, normal, uint64, 4)
        } <- {
            region: r,
            node_count: initial_node_count,
            edge_count: 0,
            words: words
        }
    produces
        pure graph
    end
}

fn node_count[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}) -> int64 {
    graph.node_count
}

fn edge_count[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}) -> int64 {
    graph.edge_count
}

fn set_edge[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    ok: int64 <- endpoints_ok(graph.node_count, from_saved, to_saved);
    case ok of {
        0 -> graph;
        1 -> set_edge_valid[mem(normal)](graph, from_saved, to_saved);
        _: int64 -> graph
    }
}

fn set_edge_valid[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
} {
    bit_index: int64 <- bit_index_for(graph.node_count, from_id, to_id);
    word_index: int64 <- word_index_for(bit_index);
    bit_offset: int64 <- bit_offset_for(bit_index);
    mask: uint64 <- mask_for_bit_offset(bit_offset);
    word: uint64 <- read_word[mem(normal)](graph, word_index);
    was_present: int64 <- bit_is_set_in_word(word, bit_offset);
    new_word: uint64 <- word bor mask;
    _: atom <- write_word[mem(normal)](graph, word_index, new_word);
    next_edge_count: int64 <- case was_present of {
        0 -> graph.edge_count + 1;
        _: int64 -> graph.edge_count
    };
    {
        region: graph.region,
        node_count: graph.node_count,
        edge_count: next_edge_count,
        words: graph.words
    }
}

fn set_edge_checked[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64) -> { ok: int64, graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
} } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    ok: int64 <- endpoints_ok(graph.node_count, from_saved, to_saved);
    updated: {
        region: region(L1, normal),
        node_count: int64,
        edge_count: int64,
        words: buf(L1, normal, uint64, 4)
    } <- set_edge[mem(normal)](graph, from_saved, to_saved);
    {
        ok: ok,
        graph: updated
    }
}

fn clear_edge[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    ok: int64 <- endpoints_ok(graph.node_count, from_saved, to_saved);
    case ok of {
        0 -> graph;
        1 -> clear_edge_valid[mem(normal)](graph, from_saved, to_saved);
        _: int64 -> graph
    }
}

fn clear_edge_valid[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
} {
    bit_index: int64 <- bit_index_for(graph.node_count, from_id, to_id);
    word_index: int64 <- word_index_for(bit_index);
    bit_offset: int64 <- bit_offset_for(bit_index);
    mask: uint64 <- mask_for_bit_offset(bit_offset);
    word: uint64 <- read_word[mem(normal)](graph, word_index);
    was_present: int64 <- bit_is_set_in_word(word, bit_offset);
    new_word: uint64 <- word band (bnot mask);
    _: atom <- write_word[mem(normal)](graph, word_index, new_word);
    next_edge_count: int64 <- case was_present of {
        0 -> graph.edge_count;
        _: int64 -> graph.edge_count - 1
    };
    {
        region: graph.region,
        node_count: graph.node_count,
        edge_count: next_edge_count,
        words: graph.words
    }
}

fn clear_edge_checked[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64) -> { ok: int64, graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
} } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    ok: int64 <- endpoints_ok(graph.node_count, from_saved, to_saved);
    updated: {
        region: region(L1, normal),
        node_count: int64,
        edge_count: int64,
        words: buf(L1, normal, uint64, 4)
    } <- clear_edge[mem(normal)](graph, from_saved, to_saved);
    {
        ok: ok,
        graph: updated
    }
}

fn has_edge[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    ok: int64 <- endpoints_ok(graph.node_count, from_saved, to_saved);
    case ok of {
        0 -> 0;
        1 -> {
            bit_index: int64 <- bit_index_for(graph.node_count, from_saved, to_saved);
            bit_is_set_at[mem(normal)](graph, bit_index)
        };
        _: int64 -> 0
    }
}

fn edge_if_to[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    case node_id_in_range(to_saved, graph.node_count) of {
        0 -> 0;
        1 -> has_edge[mem(normal)](graph, from_saved, to_saved);
        _: int64 -> 0
    }
}

fn add_edge_if_to[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, to_id: int64, total: int64) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    total_saved: int64 <- total;
    present: int64 <- edge_if_to[mem(normal)](graph, from_saved, to_saved);
    total_saved + present
}

fn add_edges_0_3[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, total: int64) -> int64 {
    from_saved: int64 <- from_id;
    total_saved: int64 <- total;
    t0: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 0, total_saved);
    t1: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 1, t0);
    t2: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 2, t1);
    add_edge_if_to[mem(normal)](graph, from_saved, 3, t2)
}

fn add_edges_4_7[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, total: int64) -> int64 {
    from_saved: int64 <- from_id;
    total_saved: int64 <- total;
    t4: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 4, total_saved);
    t5: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 5, t4);
    t6: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 6, t5);
    add_edge_if_to[mem(normal)](graph, from_saved, 7, t6)
}

fn add_edges_8_11[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, total: int64) -> int64 {
    from_saved: int64 <- from_id;
    total_saved: int64 <- total;
    t8: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 8, total_saved);
    t9: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 9, t8);
    t10: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 10, t9);
    add_edge_if_to[mem(normal)](graph, from_saved, 11, t10)
}

fn add_edges_12_15[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, total: int64) -> int64 {
    from_saved: int64 <- from_id;
    total_saved: int64 <- total;
    t12: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 12, total_saved);
    t13: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 13, t12);
    t14: int64 <- add_edge_if_to[mem(normal)](graph, from_saved, 14, t13);
    add_edge_if_to[mem(normal)](graph, from_saved, 15, t14)
}

fn out_degree[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64) -> int64 {
    from_saved: int64 <- from_id;
    count_ok: int64 <- graph_node_count_ok(graph.node_count);
    from_ok: int64 <- node_id_in_range(from_saved, graph.node_count);
    case count_ok of {
        0 -> 0;
        1 -> case from_ok of {
            0 -> 0;
            1 -> {
                a: int64 <- add_edges_0_3[mem(normal)](graph, from_saved, 0);
                b: int64 <- add_edges_4_7[mem(normal)](graph, from_saved, a);
                c: int64 <- add_edges_8_11[mem(normal)](graph, from_saved, b);
                add_edges_12_15[mem(normal)](graph, from_saved, c)
            };
            _: int64 -> 0
        };
        _: int64 -> 0
    }
}

fn neighbor_candidate(local_index: int64, present: int64, seen_before: int64, to_id: int64) -> int64 {
    case present of {
        0 -> -1;
        _: int64 -> case seen_before == local_index of {
            true -> to_id;
            false -> -1
        }
    }
}

fn first_non_negative(left: int64, right: int64) -> int64 {
    case left >= 0 of {
        true -> left;
        false -> right
    }
}

fn neighbor_state(seen: int64, found: int64) -> int64 {
    (seen * 32) + found + 1
}

fn neighbor_state_seen(state: int64) -> int64 {
    state / 32
}

fn neighbor_state_found(state: int64) -> int64 {
    (state % 32) - 1
}

fn neighbor_step[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, local_index: int64, to_id: int64, state: int64) -> int64 {
    from_saved: int64 <- from_id;
    local_saved: int64 <- local_index;
    to_saved: int64 <- to_id;
    state_saved: int64 <- state;
    seen_saved: int64 <- neighbor_state_seen(state_saved);
    found_saved: int64 <- neighbor_state_found(state_saved);
    case found_saved >= 0 of {
        true -> state_saved;
        false -> {
            present: int64 <- edge_if_to[mem(normal)](graph, from_saved, to_saved);
            candidate: int64 <- neighbor_candidate(local_saved, present, seen_saved, to_saved);
            next_found: int64 <- first_non_negative(candidate, found_saved);
            neighbor_state(seen_saved + present, next_found)
        }
    }
}

fn neighbor_steps_0_3[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, local_index: int64, state: int64) -> int64 {
    from_saved: int64 <- from_id;
    local_saved: int64 <- local_index;
    state_saved: int64 <- state;
    s0: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 0, state_saved);
    s1: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 1, s0);
    s2: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 2, s1);
    neighbor_step[mem(normal)](graph, from_saved, local_saved, 3, s2)
}

fn neighbor_steps_4_7[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, local_index: int64, state: int64) -> int64 {
    from_saved: int64 <- from_id;
    local_saved: int64 <- local_index;
    state_saved: int64 <- state;
    s4: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 4, state_saved);
    s5: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 5, s4);
    s6: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 6, s5);
    neighbor_step[mem(normal)](graph, from_saved, local_saved, 7, s6)
}

fn neighbor_steps_8_11[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, local_index: int64, state: int64) -> int64 {
    from_saved: int64 <- from_id;
    local_saved: int64 <- local_index;
    state_saved: int64 <- state;
    s8: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 8, state_saved);
    s9: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 9, s8);
    s10: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 10, s9);
    neighbor_step[mem(normal)](graph, from_saved, local_saved, 11, s10)
}

fn neighbor_steps_12_15[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, local_index: int64, state: int64) -> int64 {
    from_saved: int64 <- from_id;
    local_saved: int64 <- local_index;
    state_saved: int64 <- state;
    s12: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 12, state_saved);
    s13: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 13, s12);
    s14: int64 <- neighbor_step[mem(normal)](graph, from_saved, local_saved, 14, s13);
    neighbor_step[mem(normal)](graph, from_saved, local_saved, 15, s14)
}

fn neighbor_at[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, from_id: int64, local_index: int64) -> int64 {
    from_saved: int64 <- from_id;
    local_saved: int64 <- local_index;
    count_ok: int64 <- graph_node_count_ok(graph.node_count);
    from_ok: int64 <- node_id_in_range(from_saved, graph.node_count);
    case local_saved < 0 of {
        true -> -1;
        false -> case count_ok of {
            0 -> -1;
            1 -> case from_ok of {
                0 -> -1;
                1 -> {
                    s0: int64 <- neighbor_state(0, -1);
                    s1: int64 <- neighbor_steps_0_3[mem(normal)](graph, from_saved, local_saved, s0);
                    s2: int64 <- neighbor_steps_4_7[mem(normal)](graph, from_saved, local_saved, s1);
                    s3: int64 <- neighbor_steps_8_11[mem(normal)](graph, from_saved, local_saved, s2);
                    s4: int64 <- neighbor_steps_12_15[mem(normal)](graph, from_saved, local_saved, s3);
                    neighbor_state_found(s4)
                };
                _: int64 -> -1
            };
            _: int64 -> -1
        }
    }
}

fn popcount_nibble(n: uint64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> case n == 1 of {
            true -> 1;
            false -> case n == 2 of {
                true -> 1;
                false -> case n == 3 of {
                    true -> 2;
                    false -> case n == 4 of {
                        true -> 1;
                        false -> case n == 5 of {
                            true -> 2;
                            false -> case n == 6 of {
                                true -> 2;
                                false -> case n == 7 of {
                                    true -> 3;
                                    false -> case n == 8 of {
                                        true -> 1;
                                        false -> case n == 9 of {
                                            true -> 2;
                                            false -> case n == 10 of {
                                                true -> 2;
                                                false -> case n == 11 of {
                                                    true -> 3;
                                                    false -> case n == 12 of {
                                                        true -> 2;
                                                        false -> case n == 13 of {
                                                            true -> 3;
                                                            false -> case n == 14 of {
                                                                true -> 3;
                                                                false -> 4
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn nibble_at(word: uint64, shift: int64) -> uint64 {
    mask: uint64 <- 15;
    (word shr shift) band mask
}

fn add_popcount_nibble(word: uint64, shift: int64, total: int64) -> int64 {
    word_saved: uint64 <- word;
    shift_saved: int64 <- shift;
    total_saved: int64 <- total;
    total_saved + popcount_nibble(nibble_at(word_saved, shift_saved))
}

fn add_popcount_nibbles_0_3(word: uint64, total: int64) -> int64 {
    word_saved: uint64 <- word;
    total_saved: int64 <- total;
    t0: int64 <- add_popcount_nibble(word_saved, 0, total_saved);
    t1: int64 <- add_popcount_nibble(word_saved, 4, t0);
    t2: int64 <- add_popcount_nibble(word_saved, 8, t1);
    add_popcount_nibble(word_saved, 12, t2)
}

fn add_popcount_nibbles_4_7(word: uint64, total: int64) -> int64 {
    word_saved: uint64 <- word;
    total_saved: int64 <- total;
    t4: int64 <- add_popcount_nibble(word_saved, 16, total_saved);
    t5: int64 <- add_popcount_nibble(word_saved, 20, t4);
    t6: int64 <- add_popcount_nibble(word_saved, 24, t5);
    add_popcount_nibble(word_saved, 28, t6)
}

fn add_popcount_nibbles_8_11(word: uint64, total: int64) -> int64 {
    word_saved: uint64 <- word;
    total_saved: int64 <- total;
    t8: int64 <- add_popcount_nibble(word_saved, 32, total_saved);
    t9: int64 <- add_popcount_nibble(word_saved, 36, t8);
    t10: int64 <- add_popcount_nibble(word_saved, 40, t9);
    add_popcount_nibble(word_saved, 44, t10)
}

fn add_popcount_nibbles_12_15(word: uint64, total: int64) -> int64 {
    word_saved: uint64 <- word;
    total_saved: int64 <- total;
    t12: int64 <- add_popcount_nibble(word_saved, 48, total_saved);
    t13: int64 <- add_popcount_nibble(word_saved, 52, t12);
    t14: int64 <- add_popcount_nibble(word_saved, 56, t13);
    add_popcount_nibble(word_saved, 60, t14)
}

fn popcount_word(word: uint64) -> int64 {
    word_saved: uint64 <- word;
    a: int64 <- add_popcount_nibbles_0_3(word_saved, 0);
    b: int64 <- add_popcount_nibbles_4_7(word_saved, a);
    c: int64 <- add_popcount_nibbles_8_11(word_saved, b);
    add_popcount_nibbles_12_15(word_saved, c)
}

fn add_word_bit_count[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, word_index: int64, total: int64) -> int64 {
    index_saved: int64 <- word_index;
    total_saved: int64 <- total;
    word: uint64 <- read_word[mem(normal)](graph, index_saved);
    total_saved + popcount_word(word)
}

fn stored_bit_count[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}) -> int64 {
    t0: int64 <- add_word_bit_count[mem(normal)](graph, 0, 0);
    t1: int64 <- add_word_bit_count[mem(normal)](graph, 1, t0);
    t2: int64 <- add_word_bit_count[mem(normal)](graph, 2, t1);
    add_word_bit_count[mem(normal)](graph, 3, t2)
}

fn add_out_degree_if_node[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, node_id: int64, total: int64) -> int64 {
    node_saved: int64 <- node_id;
    total_saved: int64 <- total;
    total_saved + out_degree[mem(normal)](graph, node_saved)
}

fn add_out_degrees_0_3[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, total: int64) -> int64 {
    total_saved: int64 <- total;
    t0: int64 <- add_out_degree_if_node[mem(normal)](graph, 0, total_saved);
    t1: int64 <- add_out_degree_if_node[mem(normal)](graph, 1, t0);
    t2: int64 <- add_out_degree_if_node[mem(normal)](graph, 2, t1);
    add_out_degree_if_node[mem(normal)](graph, 3, t2)
}

fn add_out_degrees_4_7[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, total: int64) -> int64 {
    total_saved: int64 <- total;
    t4: int64 <- add_out_degree_if_node[mem(normal)](graph, 4, total_saved);
    t5: int64 <- add_out_degree_if_node[mem(normal)](graph, 5, t4);
    t6: int64 <- add_out_degree_if_node[mem(normal)](graph, 6, t5);
    add_out_degree_if_node[mem(normal)](graph, 7, t6)
}

fn add_out_degrees_8_11[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, total: int64) -> int64 {
    total_saved: int64 <- total;
    t8: int64 <- add_out_degree_if_node[mem(normal)](graph, 8, total_saved);
    t9: int64 <- add_out_degree_if_node[mem(normal)](graph, 9, t8);
    t10: int64 <- add_out_degree_if_node[mem(normal)](graph, 10, t9);
    add_out_degree_if_node[mem(normal)](graph, 11, t10)
}

fn add_out_degrees_12_15[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}, total: int64) -> int64 {
    total_saved: int64 <- total;
    t12: int64 <- add_out_degree_if_node[mem(normal)](graph, 12, total_saved);
    t13: int64 <- add_out_degree_if_node[mem(normal)](graph, 13, t12);
    t14: int64 <- add_out_degree_if_node[mem(normal)](graph, 14, t13);
    add_out_degree_if_node[mem(normal)](graph, 15, t14)
}

fn valid_edge_count[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}) -> int64 {
    a: int64 <- add_out_degrees_0_3[mem(normal)](graph, 0);
    b: int64 <- add_out_degrees_4_7[mem(normal)](graph, a);
    c: int64 <- add_out_degrees_8_11[mem(normal)](graph, b);
    add_out_degrees_12_15[mem(normal)](graph, c)
}

fn validate[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    words: buf(L1, normal, uint64, 4)
}) -> int64 {
    count_ok: int64 <- graph_node_count_ok(graph.node_count);
    case count_ok of {
        0 -> 0;
        1 -> {
            case graph.edge_count < 0 of {
                true -> 0;
                false -> {
                    valid_edges: int64 <- valid_edge_count[mem(normal)](graph);
                    stored_edges: int64 <- stored_bit_count[mem(normal)](graph);
                    no_extra_bits: int64 <- case stored_edges - valid_edges of {
                        0 -> 1;
                        _: int64 -> 0
                    };
                    count_matches: int64 <- case valid_edges - graph.edge_count of {
                        0 -> 1;
                        _: int64 -> 0
                    };
                    case no_extra_bits of {
                        0 -> 0;
                        1 -> count_matches;
                        _: int64 -> 0
                    }
                }
            }
        };
        _: int64 -> 0
    }
}
