export empty/1;
export insert/2;

fn empty(functions: { compare_item: fn(int64, int64) -> :less | :equal | :greater }) -> {
    compare_item: fn(int64, int64) -> :less | :equal | :greater,
    item_count: int64,
    has_first: int64,
    first_item: int64
} {
    result: { compare_item: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_first: int64, first_item: int64 } <- {
        compare_item: functions.compare_item,
        item_count: 0,
        has_first: 0,
        first_item: 0
    };
    result
}

fn insert(
    set: { compare_item: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_first: int64, first_item: int64 },
    item: int64
) -> { compare_item: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_first: int64, first_item: int64 } {
    case set.has_first of {
        0 -> {
            compare_item: set.compare_item,
            item_count: 1,
            has_first: 1,
            first_item: item
        };
        _: int64 -> {
            compare_item: set.compare_item,
            item_count: set.item_count,
            has_first: set.has_first,
            first_item: set.first_item
        }
    }
}
