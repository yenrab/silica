export trait WeightedGraph;
export weight_at/3;

required {
    fn weight_at(graph: WeightedGraph, from_id: int64, to_id: int64) -> { found: int64, weight: int64 };
}

impl fn weight_at(
    graph: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 },
    from_id: int64,
    to_id: int64
) -> { found: int64, weight: int64 } {
    case graph.edge_count > 0 and graph.first_from == from_id and graph.first_to == to_id of {
        true -> { found: 1, weight: 0 };
        false -> { found: 0, weight: 0 }
    }
}
