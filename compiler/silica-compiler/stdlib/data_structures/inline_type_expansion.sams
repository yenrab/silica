    CBZ W3, Leq_n2_done
    ADD X24, X24, #1
    CMP X24, #0x100000
    B.LT Leq_n2l
Leq_n2_done:
    CMP X22, X24
    B.NE Leq_neq
    CBZ X22, Leq_yes
    MOV X25, X21
    MOV X26, X23
    MOV X27, X22
Leq_cloop:
    LDRB W28, [X25], #1
    LDRB W0, [X26], #1
    CMP W28, W0
    B.NE Leq_neq
    SUBS X27, X27, #1
    B.NE Leq_cloop
Leq_yes:
    MOV W0, #1
    B Leq_exit
Leq_anull:
    CBZ X20, Leq_yes
    B Leq_neq
Leq_neq:
    MOV W0, #0
Leq_exit:
    LDP X27, X28, [SP], #16
    LDP X25, X26, [SP], #16
    LDP X23, X24, [SP], #16
    LDP X21, X22, [SP], #16
    LDP X19, X20, [SP], #16
    LDP X29, X30, [SP], #16
    RET

