export empty/1;
export push/2;

fn empty(functions: { compare_priority: fn(int64, int64) -> :less | :equal | :greater }) -> {
    compare_priority: fn(int64, int64) -> :less | :equal | :greater,
    item_count: int64,
    has_top: int64,
    top_item: int64
} {
    result: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 } <- {
        compare_priority: functions.compare_priority,
        item_count: 0,
        has_top: 0,
        top_item: 0
    };
    result
}

fn push(
    heap: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 },
    item: int64
) -> { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 } {
    case heap.has_top of {
        0 -> {
            compare_priority: heap.compare_priority,
            item_count: 1,
            has_top: 1,
            top_item: item
        };
        _: int64 -> {
            compare_priority: heap.compare_priority,
            item_count: heap.item_count + 1,
            has_top: heap.has_top,
            top_item: heap.top_item
        }
    }
}
