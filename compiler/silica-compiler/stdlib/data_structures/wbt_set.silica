                (node_key, _: int64, left: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node
            produces
                pure minimum_cmp(node_key, left, placeholder)
            end
        }
    }
}

fn maximum_subtree(
    subtree: ref?(L, normal, rec),
    placeholder: ItemType
) -> { status: :not_found | :found, item: ItemType } {
    case subtree of {
        :none -> { status: :not_found, item: placeholder };
        node_ref: ref(L, normal, (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (ItemType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (node_key, _: int64, _: ref?(L, normal, rec), right: ref?(L, normal, rec)) <- node
            produces
                pure maximum_cmp(node_key, right, placeholder)
            end
        }
    }
}

fn maximum(
    set: {
        root: ref?(L, normal, rec),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
