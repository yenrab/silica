// Layer 2 §16 steps 3–4 — Brodal–Okasaki queue: primitive skew-binomial forest (leaf module).
// Authority: brodal_okasaki_queue.md §4, §8. A forest is a digit list in increasing rank order
// where only the first two digits may share a rank. Skew insertion of a rank-0 tree is O(1);
// meld normalizes both forests (one carry each) and merges with ordinary links, O(log n).
// merge_checked rejects incompatible ordering identity, orientation, or arena BEFORE allocating
// anything (plan §16 step 4, §7.2 acceptance on the primitive path).
// Every exported function whose signature mentions ItemType takes the heap record first: the
// compiler resolves ItemType at a qualified call from the record's compare_item witness.

use brodal_okasaki_node;
use brodal_okasaki_link;

export ins_tree/3;
export normalize/2;
export merge/3;
export insert_tree0/3;
export merge_compatible/2;
export merge_checked/4;

fn push_existing(
    d: (int64, ref?(L, normal, rec)),
    rest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[(int64, ref?(L, normal, rec)), mem(normal)] <- prepend[(int64, ref?(L, normal, rec)), mem(normal)](d, rest)
    produces
        pure out
    end
}

fn singleton_forest(d: (int64, ref?(L, normal, rec))) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    push_existing(d, brodal_okasaki_node@empty_forest())
}

fn ins_tree_step(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d: (int64, ref?(L, normal, rec)),
    d2: (int64, ref?(L, normal, rec)),
    rest: List[(int64, ref?(L, normal, rec)), mem(normal)],
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    case brodal_okasaki_link@digit_rank(d) < brodal_okasaki_link@digit_rank(d2) of {
        true -> push_existing(d, forest);
        false -> ins_linked(heap, d, d2, rest)
    }
}

fn ins_linked(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d: (int64, ref?(L, normal, rec)),
    d2: (int64, ref?(L, normal, rec)),
    rest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence
        linked: (int64, ref?(L, normal, rec)) <- brodal_okasaki_link@link(heap, d, d2)
    produces
        pure ins_tree(heap, linked, rest)
    end
}

// Inserts a tree whose rank is at most the first rank of `forest` (a unique-rank forest).
fn ins_tree(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d: (int64, ref?(L, normal, rec)),
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    case forest of {
        []: List[(int64, ref?(L, normal, rec)), mem(normal)] -> singleton_forest(d);
        [d2: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)]] -> ins_tree_step(heap, d, d2, rest, forest)
    }
}

// Removes the optional leading duplicate rank by one link.
fn normalize(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    case forest of {
        []: List[(int64, ref?(L, normal, rec)), mem(normal)] -> forest;
        [d: (int64, ref?(L, normal, rec)), rest: List[(int64, ref?(L, normal, rec)), mem(normal)]] -> ins_tree(heap, d, rest)
    }
}

fn merge_step(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d1: (int64, ref?(L, normal, rec)),
    rest1: List[(int64, ref?(L, normal, rec)), mem(normal)],
    f1: List[(int64, ref?(L, normal, rec)), mem(normal)],
    d2: (int64, ref?(L, normal, rec)),
    rest2: List[(int64, ref?(L, normal, rec)), mem(normal)],
    f2: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence
        rank1: int64 <- brodal_okasaki_link@digit_rank(d1);
        rank2: int64 <- brodal_okasaki_link@digit_rank(d2)
    produces
        pure case rank1 < rank2 of {
            true -> push_existing(d1, merge_trees(heap, rest1, f2));
            false -> case rank2 < rank1 of {
                true -> push_existing(d2, merge_trees(heap, f1, rest2));
                false -> merge_equal(heap, d1, rest1, d2, rest2)
            }
        }
    end
}

fn merge_equal(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d1: (int64, ref?(L, normal, rec)),
    rest1: List[(int64, ref?(L, normal, rec)), mem(normal)],
    d2: (int64, ref?(L, normal, rec)),
    rest2: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence
        linked: (int64, ref?(L, normal, rec)) <- brodal_okasaki_link@link(heap, d1, d2);
        merged: List[(int64, ref?(L, normal, rec)), mem(normal)] <- merge_trees(heap, rest1, rest2)
    produces
        pure ins_tree(heap, linked, merged)
    end
}

fn merge_with_first(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d1: (int64, ref?(L, normal, rec)),
    rest1: List[(int64, ref?(L, normal, rec)), mem(normal)],
    f1: List[(int64, ref?(L, normal, rec)), mem(normal)],
    f2: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    case f2 of {
        []: List[(int64, ref?(L, normal, rec)), mem(normal)] -> f1;
        [d2: (int64, ref?(L, normal, rec)), rest2: List[(int64, ref?(L, normal, rec)), mem(normal)]] -> merge_step(heap, d1, rest1, f1, d2, rest2, f2)
    }
}

// Both inputs are unique-rank forests.
fn merge_trees(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    f1: List[(int64, ref?(L, normal, rec)), mem(normal)],
    f2: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    case f1 of {
        []: List[(int64, ref?(L, normal, rec)), mem(normal)] -> f2;
        [d1: (int64, ref?(L, normal, rec)), rest1: List[(int64, ref?(L, normal, rec)), mem(normal)]] -> merge_with_first(heap, d1, rest1, f1, f2)
    }
}

fn merge(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    f1: List[(int64, ref?(L, normal, rec)), mem(normal)],
    f2: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    merge_trees(heap, normalize(heap, f1), normalize(heap, f2))
}

fn insert_second(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d0: (int64, ref?(L, normal, rec)),
    d1: (int64, ref?(L, normal, rec)),
    rest1: List[(int64, ref?(L, normal, rec)), mem(normal)],
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    case rest1 of {
        []: List[(int64, ref?(L, normal, rec)), mem(normal)] -> push_existing(d0, forest);
        [d2: (int64, ref?(L, normal, rec)), rest2: List[(int64, ref?(L, normal, rec)), mem(normal)]] -> case brodal_okasaki_link@digit_rank(d1) == brodal_okasaki_link@digit_rank(d2) of {
            true -> push_skew(heap, d0, d1, d2, rest2);
            false -> push_existing(d0, forest)
        }
    }
}

fn push_skew(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d0: (int64, ref?(L, normal, rec)),
    d1: (int64, ref?(L, normal, rec)),
    d2: (int64, ref?(L, normal, rec)),
    rest2: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    sequence
        linked: (int64, ref?(L, normal, rec)) <- brodal_okasaki_link@skew_link(heap, d0, d1, d2)
    produces
        pure push_existing(linked, rest2)
    end
}

// Skew insertion of a rank-0 digit: one skew link when the first two ranks match, else prepend.
fn insert_tree0(
    heap: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    d0: (int64, ref?(L, normal, rec)),
    forest: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> List[(int64, ref?(L, normal, rec)), mem(normal)] {
    case forest of {
        []: List[(int64, ref?(L, normal, rec)), mem(normal)] -> singleton_forest(d0);
        [d1: (int64, ref?(L, normal, rec)), rest1: List[(int64, ref?(L, normal, rec)), mem(normal)]] -> insert_second(heap, d0, d1, rest1, forest)
    }
}

// Same exact ordering identity (comparator function value plus orientation), same orientation
// flag, and the same canonical arena.
fn merge_compatible(
    left: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    right: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> boolean {
    sequence
        same_order: boolean <- ordering_identity_same(left.compare_item_ordering_bundle, right.compare_item_ordering_bundle);
        same_arena: boolean <- canonical_arena_same(left.region, right.region)
    produces
        pure same_order and same_arena and (left.max_oriented == right.max_oriented)
    end
}

// Rejection happens before any link allocates; an incompatible pair returns the left forest.
fn merge_checked(
    left: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    f1: List[(int64, ref?(L, normal, rec)), mem(normal)],
    right: {
        root: ref?(L, normal, rec),
        count: int64,
        max_oriented: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    f2: List[(int64, ref?(L, normal, rec)), mem(normal)]
) -> { forest: List[(int64, ref?(L, normal, rec)), mem(normal)], compatible: boolean } {
    case merge_compatible(left, right) of {
        false -> { forest: f1, compatible: false };
        true -> { forest: merge(left, f1, f2), compatible: true }
    }
}
