export trait PriorityQueue;
export peek_priority/1;
export peek_value/1;

required {
    fn peek_priority(queue: PriorityQueue) -> int64;
    fn peek_value(queue: PriorityQueue) -> int64;
}

impl fn peek_priority(
    queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 }
) -> int64 {
    queue.top_item
}

impl fn peek_value(
    queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 }
) -> int64 {
    queue.top_item
}

fn priority_queue_read_value(values: buf(L1, normal, int64, 8), index: int64) -> int64 {
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    sequence proc[mem(normal)]
        value: int64 <- read_buf(values_saved, index_saved)
    produces
        pure value
    end
}

impl fn peek_priority(queue: {
    compare_priority: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    case queue.len of {
        0 -> 0;
        _: int64 -> priority_queue_read_value(queue.priorities, 0)
    }
}

impl fn peek_value(queue: {
    compare_priority: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    case queue.len of {
        0 -> 0;
        _: int64 -> priority_queue_read_value(queue.values, 0)
    }
}
