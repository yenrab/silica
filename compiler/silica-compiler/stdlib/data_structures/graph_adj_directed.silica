    weight: int8
) -> { node_count: int64, edge_count: int64, n0_neighbors: List[{ to: int64, weight: int8 }, mem(normal)], n1_neighbors: List[{ to: int64, weight: int8 }, mem(normal)], n2_neighbors: List[{ to: int64, weight: int8 }, mem(normal)] } {
    sequence proc[mem(normal)]
        edge: { to: int64, weight: int8 } <- { to: to_id, weight: weight };
        out: { node_count: int64, edge_count: int64, n0_neighbors: List[{ to: int64, weight: int8 }, mem(normal)], n1_neighbors: List[{ to: int64, weight: int8 }, mem(normal)], n2_neighbors: List[{ to: int64, weight: int8 }, mem(normal)] } <- case from_id of {
