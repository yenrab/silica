fn validate[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    graph_adj_list_helpers@graph_adj_validate_flat_unweighted_directed(
        graph.node_count,
        graph.edge_count,
        graph.n0_neighbors,
        graph.n1_neighbors,
        graph.n2_neighbors
    )
}

fn graph_adj_present(value: int64) -> int64 {
    case value of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn graph_adj_reach_01(graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    direct: int64 <- graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n0_neighbors, 1);
    via2_left: int64 <- graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n0_neighbors, 2);
    via2_right: int64 <- graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n2_neighbors, 1);
    case direct of {
        1 -> 1;
        _: int64 -> case via2_left of {
            1 -> via2_right;
            _: int64 -> 0
        }
    }
}

fn graph_adj_reach_02(graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    direct: int64 <- graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n0_neighbors, 2);
    case direct of {
        1 -> 1;
        _: int64 -> case graph_adj_reach_01(graph) of {
            1 -> graph_adj_reach_12(graph);
            _: int64 -> 0
        }
    }
}

