    n0_saved: List[{ to: int64, weight: int64 }, mem(normal)] <- graph.n0_neighbors;
    n1_saved: List[{ to: int64, weight: int64 }, mem(normal)] <- graph.n1_neighbors;
    n2_saved: List[{ to: int64, weight: int64 }, mem(normal)] <- graph.n2_neighbors;
    graph_adj_list_helpers@graph_adj_validate_flat_weighted_int64_directed(
        node_count_saved,
        edge_count_saved,
        n0_saved,
        n1_saved,
        n2_saved
    )
}

fn empty[int8, mem(normal)](initial_node_count: int64) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int8 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int8 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int8 }, mem(normal)]
} {
    sequence proc[mem(normal)]
        n0: List[{ to: int64, weight: int8 }, mem(normal)] <- empty[{ to: int64, weight: int8 }, mem(normal)]();
        n1: List[{ to: int64, weight: int8 }, mem(normal)] <- empty[{ to: int64, weight: int8 }, mem(normal)]();
        n2: List[{ to: int64, weight: int8 }, mem(normal)] <- empty[{ to: int64, weight: int8 }, mem(normal)]();
        graph: { node_count: int64, edge_count: int64, n0_neighbors: List[{ to: int64, weight: int8 }, mem(normal)], n1_neighbors: List[{ to: int64, weight: int8 }, mem(normal)], n2_neighbors: List[{ to: int64, weight: int8 }, mem(normal)] } <-
            { node_count: initial_node_count, edge_count: 0, n0_neighbors: n0, n1_neighbors: n1, n2_neighbors: n2 }
    produces pure graph end
}

fn add_edge[int8, mem(normal)](
    graph: { node_count: int64, edge_count: int64, n0_neighbors: List[{ to: int64, weight: int8 }, mem(normal)], n1_neighbors: List[{ to: int64, weight: int8 }, mem(normal)], n2_neighbors: List[{ to: int64, weight: int8 }, mem(normal)] },
    from_id: int64,
