    }
}

fn graph_adj_reach_21(graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    direct: int64 <- graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n2_neighbors, 1);
    via0_left: int64 <- graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n2_neighbors, 0);
    via0_right: int64 <- graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n0_neighbors, 1);
    case direct of {
        1 -> 1;
        _: int64 -> case via0_left of {
            1 -> via0_right;
            _: int64 -> 0
        }
    }
}

fn reachable[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    to_ok: int64 <- case to_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    safe_from: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> from_saved;
        _: int64 -> 0
    };
    safe_to: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> to_saved;
        _: int64 -> 0
    };
    same_node: int64 <- case from_saved - to_saved of {
        0 -> 1;
        _: int64 -> 0
    };
    path_count: int64 <- case safe_from of {
        0 -> case safe_to of {
            0 -> same_node;
            1 -> graph_adj_reach_01(graph);
            2 -> graph_adj_reach_02(graph);
            _: int64 -> 0
        };
        1 -> case safe_to of {
            0 -> graph_adj_reach_10(graph);
            1 -> same_node;
            2 -> graph_adj_reach_12(graph);
            _: int64 -> 0
        };
        2 -> case safe_to of {
            0 -> graph_adj_reach_20(graph);
            1 -> graph_adj_reach_21(graph);
            2 -> same_node;
            _: int64 -> 0
        };
        _: int64 -> 0
    };
    path_present: int64 <- graph_adj_present(path_count);
    path_present * endpoints_ok
}

fn max_out_degree_pair(a: int64, b: int64) -> int64 {
    case a >= b of {
        true -> a;
        false -> b
    }
}

fn max_out_degree[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    d0: int64 <- out_degree[mem(normal)](graph, 0);
    d1: int64 <- out_degree[mem(normal)](graph, 1);
    d2: int64 <- out_degree[mem(normal)](graph, 2);
    m01: int64 <- max_out_degree_pair(d0, d1);
    max_out_degree_pair(m01, d2)
}

fn total_out_degree_sum[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    d0: int64 <- out_degree[mem(normal)](graph, 0);
    d1: int64 <- out_degree[mem(normal)](graph, 1);
    d2: int64 <- out_degree[mem(normal)](graph, 2);
    d0 + d1 + d2
}

fn empty[int64, mem(normal)](initial_node_count: int64) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
} {
    count_saved: int64 <- initial_node_count;
    sequence proc[mem(normal)]
        n0_empty: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        n1_empty: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        n2_empty: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } <- {
            node_count: count_saved,
            edge_count: 0,
            n0_neighbors: n0_empty,
            n1_neighbors: n1_empty,
            n2_neighbors: n2_empty
        }
    produces
        pure graph
    end
}

fn node_count[int64, mem(normal)](graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
}) -> int64 {
    graph.node_count
}

fn edge_count[int64, mem(normal)](graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
}) -> int64 {
    graph.edge_count
}

fn int64_prepend_slot(
    old_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64,
    weight: int64
) -> List[{ to: int64, weight: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        to_saved: int64 <- to_id;
        weight_saved: int64 <- weight;
        updated: List[{ to: int64, weight: int64 }, mem(normal)] <- prepend[{ to: int64, weight: int64 }, mem(normal)]({ to: to_saved, weight: weight_saved }, old_neighbors)
    produces
        pure updated
    end
}

fn int64_neighbors_list(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64,
    empty_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
) -> List[{ to: int64, weight: int64 }, mem(normal)] {
    case node_id of {
        0 -> graph.n0_neighbors;
        1 -> graph.n1_neighbors;
        2 -> graph.n2_neighbors;
        _: int64 -> empty_neighbors
    }
}

fn add_edge_when_ok(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64,
    weight: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
} } {
    sequence
        from_saved: int64 <- from_id;
        to_saved: int64 <- to_id;
        weight_saved: int64 <- weight;
        ok: int64 <- case from_saved of {
            0 -> 1;
            1 -> 1;
            2 -> 1;
            _: int64 -> 0
        };
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)] <- case from_saved of {
            0 -> int64_prepend_slot(graph.n0_neighbors, to_saved, weight_saved);
            _: int64 -> graph.n0_neighbors
        };
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)] <- case from_saved of {
            1 -> int64_prepend_slot(graph.n1_neighbors, to_saved, weight_saved);
            _: int64 -> graph.n1_neighbors
        };
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)] <- case from_saved of {
            2 -> int64_prepend_slot(graph.n2_neighbors, to_saved, weight_saved);
            _: int64 -> graph.n2_neighbors
        };
        edge_count: int64 <- graph.edge_count + ok;
        updated: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } <- {
            node_count: graph.node_count,
            edge_count: edge_count,
            n0_neighbors: n0_neighbors,
            n1_neighbors: n1_neighbors,
            n2_neighbors: n2_neighbors
        };
        result: { ok: int64, graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } } <- { ok: ok, graph: updated }
    produces pure result end
}

fn add_edge_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64,
    weight: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
} } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    weight_saved: int64 <- weight;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    case endpoints_ok of {
        0 -> { ok: 0, graph: graph };
        1 -> add_edge_when_ok(graph, from_saved, to_saved, weight_saved);
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn add_edge[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64,
    weight: int64
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    weight_saved: int64 <- weight;
    sequence proc[mem(normal)]
        edge: { to: int64, weight: int64 } <- { to: to_saved, weight: weight_saved };
        out: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } <- case from_saved of {
            0 -> {
                node_count: graph.node_count,
                edge_count: graph.edge_count + 1,
                n0_neighbors: prepend[{ to: int64, weight: int64 }, mem(normal)](edge, graph.n0_neighbors),
                n1_neighbors: graph.n1_neighbors,
                n2_neighbors: graph.n2_neighbors
            };
            1 -> {
                node_count: graph.node_count,
                edge_count: graph.edge_count + 1,
                n0_neighbors: graph.n0_neighbors,
                n1_neighbors: prepend[{ to: int64, weight: int64 }, mem(normal)](edge, graph.n1_neighbors),
                n2_neighbors: graph.n2_neighbors
            };
            2 -> {
                node_count: graph.node_count,
                edge_count: graph.edge_count + 1,
                n0_neighbors: graph.n0_neighbors,
                n1_neighbors: graph.n1_neighbors,
                n2_neighbors: prepend[{ to: int64, weight: int64 }, mem(normal)](edge, graph.n2_neighbors)
            };
            _: int64 -> graph
        }
    produces pure out end
}

fn neighbors[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64
) -> List[{ to: int64, weight: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        node_saved: int64 <- node_id;
        result: { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } <- neighbors_checked[int64, mem(normal)](graph, node_saved)
    produces pure result.value end
}

fn neighbors_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } {
    node_saved: int64 <- node_id;
    in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(node_saved, graph.node_count);
    sequence proc[mem(normal)]
        empty_neighbors: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        neighbors: List[{ to: int64, weight: int64 }, mem(normal)] <- int64_neighbors_list(graph, node_saved, empty_neighbors);
        out: { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } <- case in_range of {
            0 -> { ok: 0, value: empty_neighbors };
            1 -> { ok: 1, value: neighbors };
            _: int64 -> { ok: 0, value: empty_neighbors }
        }
    produces
        pure out
    end
}

fn weight_list(
    neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> { found: int64, weight: int64 } {
    sequence proc[mem(normal)]
        to_saved: int64 <- to_id;
        result: { found: int64, weight: int64 } <- case neighbors of {
            []: List[{ to: int64, weight: int64 }, mem(normal)] -> { found: 0, weight: 0 };
            [h: { to: int64, weight: int64 }, _: List[{ to: int64, weight: int64 }, mem(normal)]] -> case h.to - to_saved of {
                0 -> { found: 1, weight: h.weight };
                _: int64 -> { found: 0, weight: 0 }
            }
        }
    produces pure result end
}

fn weight_at_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, value: int64 } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    neighbors_result: { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } <- neighbors_checked[int64, mem(normal)](graph, from_saved);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> {
            found_weight: { found: int64, weight: int64 } <- weight_list(neighbors_result.value, to_saved);
            case found_weight.found of {
                0 -> { ok: 0, value: 0 };
                1 -> { ok: 1, value: found_weight.weight };
                _: int64 -> { ok: 0, value: 0 }
            }
        };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn weight_at[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    found: { found: int64, weight: int64 } <- case from_id of {
        0 -> weight_list(graph.n0_neighbors, to_id);
        1 -> weight_list(graph.n1_neighbors, to_id);
        2 -> weight_list(graph.n2_neighbors, to_id);
        _: int64 -> { found: 0, weight: 0 }
    };
    found.weight
}

fn has_edge_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, value: int64 } {
    sequence
        from_saved: int64 <- from_id;
        to_saved: int64 <- to_id;
        weight_result: { ok: int64, value: int64 } <- weight_at_checked[int64, mem(normal)](graph, from_saved, to_saved);
        result: { ok: int64, value: int64 } <- case weight_result.ok of {
            0 -> { ok: 0, value: 0 };
            1 -> { ok: 1, value: 1 };
            _: int64 -> { ok: 0, value: 0 }
        }
    produces pure result end
}

fn has_edge[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- has_edge_checked[int64, mem(normal)](graph, from_id, to_id);
    result.value
}

fn out_degree_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: int64 } {
    neighbors_result: { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } <- neighbors_checked[int64, mem(normal)](graph, node_id);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: graph_adj_list_helpers@graph_adj_list_weighted_length(neighbors_result.value) };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn out_degree[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- out_degree_checked[int64, mem(normal)](graph, node_id);
    result.value
}

fn validate[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    }
) -> int64 {
