// Phase 1.1 — unweighted directed adjacency graph with constructor function record (empty/2).
fn build_empty_adj_unweighted_graph(
    graph_functions: {
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    initial_node_count: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    count_saved: int64 <- initial_node_count;
    sequence proc[mem(normal)]
        built_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            graph_adj_list_helpers@graph_adj_build_empty_nodes_unweighted(count_saved);
        graph: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- {
            node_count: count_saved,
            edge_count: 0,
            nodes: built_nodes,
            compare_node: graph_functions.compare_node,
            compare_edge: graph_functions.compare_edge,
            edge_target: graph_functions.edge_target
        }
    produces
        pure graph
    end
}

fn empty(
    graph_functions: {
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    initial_node_count: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    build_empty_adj_unweighted_graph(graph_functions, initial_node_count)
}

fn empty[int64, int64, mem(normal)](
    graph_functions: {
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    initial_node_count: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    build_empty_adj_unweighted_graph(graph_functions, initial_node_count)
}

fn default_adj_unweighted_node() -> { id: int64, neighbors: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
        default_node: { id: int64, neighbors: List[int64, mem(normal)] } <- {
            id: -1,
            neighbors: empty_neighbors
        }
    produces
        pure default_node
    end
}

fn build_adj_unweighted_node(
    node_id: int64,
    node_neighbors: List[int64, mem(normal)]
) -> { id: int64, neighbors: List[int64, mem(normal)] } {
    id_saved: int64 <- node_id;
    neighbors_saved: List[int64, mem(normal)] <- node_neighbors;
    sequence proc[mem(normal)]
        _: List[int64, mem(normal)] <- empty_int64_list();
        node: { id: int64, neighbors: List[int64, mem(normal)] } <- {
            id: id_saved,
            neighbors: neighbors_saved
        }
    produces
        pure node
    end
}

fn find_node_checked(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> { ok: int64, value: { id: int64, neighbors: List[int64, mem(normal)] } } {
    node_saved: int64 <- node_id;
    in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(node_saved, graph.node_count);
    default_node: { id: int64, neighbors: List[int64, mem(normal)] } <- default_adj_unweighted_node();
    lookup: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <-
        graph_adj_list_helpers@graph_adj_find_node_unweighted(graph.nodes, node_saved, default_node);
    case in_range of {
        0 -> { ok: 0, value: default_node };
        1 -> case lookup.found of {
            1 -> { ok: 1, value: lookup.node };
            _: int64 -> { ok: 0, value: default_node }
        };
        _: int64 -> { ok: 0, value: default_node }
    }
}

fn neighbors_checked[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> { ok: int64, value: List[int64, mem(normal)] } {
    node_saved: int64 <- node_id;
    node_result: { ok: int64, value: { id: int64, neighbors: List[int64, mem(normal)] } } <- find_node_checked(graph, node_saved);
    empty_neighbors: List[int64, mem(normal)] <- empty_int64_list();
    case node_result.ok of {
        0 -> { ok: 0, value: empty_neighbors };
        1 -> { ok: 1, value: node_result.value.neighbors };
        _: int64 -> { ok: 0, value: empty_neighbors }
    }
}

fn neighbors[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> List[int64, mem(normal)] {
    result: { ok: int64, value: List[int64, mem(normal)] } <- neighbors_checked[int64, int64, mem(normal)](graph, node_id);
    result.value
}

fn out_degree_checked[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> { ok: int64, value: int64 } {
    node_saved: int64 <- node_id;
    neighbors_result: { ok: int64, value: List[int64, mem(normal)] } <-
        neighbors_checked[int64, int64, mem(normal)](graph, node_saved);
    degree_value: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(neighbors_result.value);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: degree_value };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn out_degree[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> int64 {
    node_saved: int64 <- node_id;
    result: { ok: int64, value: int64 } <- out_degree_checked[int64, int64, mem(normal)](graph, node_saved);
    result.value
}

fn has_edge_checked[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, value: int64 } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    neighbors_result: { ok: int64, value: List[int64, mem(normal)] } <-
        neighbors_checked[int64, int64, mem(normal)](graph, from_saved);
    contains_value: int64 <- graph_adj_list_helpers@graph_adj_list_int64_contains(neighbors_result.value, to_saved);
    case endpoints_ok of {
        0 -> { ok: 0, value: 0 };
        1 -> case neighbors_result.ok of {
            0 -> { ok: 0, value: 0 };
            1 -> { ok: 1, value: contains_value };
            _: int64 -> { ok: 0, value: 0 }
        };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn has_edge[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    result: { ok: int64, value: int64 } <-
        has_edge_checked[int64, int64, mem(normal)](graph, from_saved, to_saved);
    result.value
}

fn add_edge_update_nodes_from0(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    updated_source: { id: int64, neighbors: List[int64, mem(normal)] }
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            graph_adj_list_helpers@graph_adj_tail_unweighted_or_empty(nodes);
        replaced: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](updated_source, tail1)
    produces
        pure replaced
    end
}

fn add_edge_update_nodes_from1(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    updated_source: { id: int64, neighbors: List[int64, mem(normal)] },
    default_node: { id: int64, neighbors: List[int64, mem(normal)] }
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            graph_adj_list_helpers@graph_adj_tail_unweighted_or_empty(nodes);
        tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            graph_adj_list_helpers@graph_adj_tail_unweighted_or_empty(tail1);
        head0: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <-
            graph_adj_list_helpers@graph_adj_find_node_unweighted_at0(nodes, default_node);
        with_updated: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](updated_source, tail2);
        replaced: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](head0.node, with_updated)
    produces
        pure replaced
    end
}

fn add_edge_update_nodes_from2(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    updated_source: { id: int64, neighbors: List[int64, mem(normal)] },
    default_node: { id: int64, neighbors: List[int64, mem(normal)] }
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            graph_adj_list_helpers@graph_adj_tail_unweighted_or_empty(nodes);
        empty_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]();
        head0: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <-
            graph_adj_list_helpers@graph_adj_find_node_unweighted_at0(nodes, default_node);
        head1: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <-
            graph_adj_list_helpers@graph_adj_find_node_unweighted_at0(tail1, default_node);
        tail_with_updated: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](updated_source, empty_nodes);
        with_head1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](head1.node, tail_with_updated);
        replaced: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](head0.node, with_head1)
    produces
        pure replaced
    end
}

fn add_edge_valid_adj_unweighted(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty_int64_list();
        n0_lookup: { found: int64, neighbors: List[int64, mem(normal)] } <-
            graph_adj_list_helpers@graph_adj_find_neighbors_unweighted(graph.nodes, 0, empty_neighbors);
        n1_lookup: { found: int64, neighbors: List[int64, mem(normal)] } <-
            graph_adj_list_helpers@graph_adj_find_neighbors_unweighted(graph.nodes, 1, empty_neighbors);
        n2_lookup: { found: int64, neighbors: List[int64, mem(normal)] } <-
            graph_adj_list_helpers@graph_adj_find_neighbors_unweighted(graph.nodes, 2, empty_neighbors);
        flat_graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: graph.node_count,
            edge_count: graph.edge_count,
            n0_neighbors: n0_lookup.neighbors,
            n1_neighbors: n1_lookup.neighbors,
            n2_neighbors: n2_lookup.neighbors
        };
        flat_updated: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- add_edge[mem(normal)](flat_graph, from_saved, to_saved);
        node0: { id: int64, neighbors: List[int64, mem(normal)] } <-
            build_adj_unweighted_node(0, flat_updated.n0_neighbors);
        node1: { id: int64, neighbors: List[int64, mem(normal)] } <-
            build_adj_unweighted_node(1, flat_updated.n1_neighbors);
        node2: { id: int64, neighbors: List[int64, mem(normal)] } <-
            build_adj_unweighted_node(2, flat_updated.n2_neighbors);
        empty_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]();
        updated_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- case graph.node_count of {
            0 -> empty_nodes;
            1 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                node0,
                empty_nodes
            );
            2 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                node0,
                prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                    node1,
                    empty_nodes
                )
            );
            3 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                node0,
                prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                    node1,
                    prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                        node2,
                        empty_nodes
                    )
                )
            );
            _: int64 -> graph.nodes
        };
        updated_graph: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- {
            node_count: graph.node_count,
            edge_count: flat_updated.edge_count,
            nodes: updated_nodes,
            compare_node: graph.compare_node,
            compare_edge: graph.compare_edge,
            edge_target: graph.edge_target
        }
    produces
        pure updated_graph
    end
}

fn add_edge[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    case endpoints_ok of {
        0 -> graph;
        1 -> add_edge_valid_adj_unweighted(graph, from_saved, to_saved);
        _: int64 -> graph
    }
}

fn add_edge_checked[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> {
    ok: int64,
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    }
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    updated_graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    } <- add_edge[int64, int64, mem(normal)](graph, from_saved, to_saved);
    {
        ok: endpoints_ok,
        graph: updated_graph
    }
}

fn validate[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    }
) -> int64 {
    graph_adj_list_helpers@graph_adj_validate_typed_directed_unweighted(
        graph.nodes,
        graph.node_count,
        graph.edge_count
    )
}
