            2 -> { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph.n0_neighbors, n1_neighbors: graph.n1_neighbors, n2_neighbors: prepend[{ to: int64, weight: int8 }, mem(normal)](edge, graph.n2_neighbors) };
