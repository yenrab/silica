fn from_static_sorted[int64, mem(normal)]() -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_item: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        node_key_start: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_key_count: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_child_start: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_child_count: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_is_leaf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        keys: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        children: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(node_key_start, 0, 0);
        _: atom <- write_buf(node_key_count, 0, 3);
        _: atom <- write_buf(node_child_start, 0, 0);
        _: atom <- write_buf(node_child_count, 0, 0);
        _: atom <- write_buf(node_is_leaf, 0, 1);
        _: atom <- write_buf(keys, 0, 1);
        _: atom <- write_buf(keys, 1, 3);
        _: atom <- write_buf(keys, 2, 5);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: 0,
            node_count: 1,
            key_count_total: 3,
            order: 8,
            node_key_start: node_key_start,
            node_key_count: node_key_count,
            node_child_start: node_child_start,
            node_child_count: node_child_count,
            node_is_leaf: node_is_leaf,
            keys: keys,
            children: children,
            compare_item: compare_int64_atom
        }
    produces
        pure tree
    end
}

// Linear scan through a leaf key range looking for key.
fn contains_key_at(
    keys_buf: buf(L1, normal, int64, 8),
    key: int64,
    i: int64,
    count: int64
) -> int64 {
    case i >= count of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_saved: int64 <- key;
                count_saved: int64 <- count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki == key_saved of {
                    true -> 1;
                    false -> contains_key_at(keys_buf_saved, key_saved, i_saved + 1, count_saved)
                }
            produces
                pure result
            end
        }
    }
}

fn contains_key_abs_at(
    keys_buf: buf(L1, normal, int64, 8),
    key: int64,
    i: int64,
    end_index: int64
) -> int64 {
    case i >= end_index of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_saved: int64 <- key;
                i_saved: int64 <- i;
                end_saved: int64 <- end_index;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki == key_saved of {
                    true -> 1;
                    false -> contains_key_abs_at(keys_buf_saved, key_saved, i_saved + 1, end_saved)
                }
            produces
                pure result
            end
        }
    }
}

fn contains_leaf_node(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    node_id: int64,
    key: int64
) -> int64 {
    sequence proc[mem(normal)]
        node_saved: int64 <- node_id;
        key_saved: int64 <- key;
        key_start: int64 <- read_buf(tree.node_key_start, node_saved);
        key_count: int64 <- read_buf(tree.node_key_count, node_saved);
        end_index: int64 <- key_start + key_count;
        result: int64 <- case node_saved of {
            0 -> contains_key_at(tree.keys, key_saved, 0, key_count);
            _: int64 -> contains_key_abs_at(tree.keys, key_saved, key_start, end_index)
        }
    produces
        pure result
    end
}

fn contains_split_root(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> int64 {
    sequence proc[mem(normal)]
        key_saved: int64 <- key;
        root_start: int64 <- read_buf(tree.node_key_start, 0);
        separator: int64 <- read_buf(tree.keys, root_start);
        result: int64 <- case key_saved == separator of {
            true -> 1;
            false -> {
                child_slot: int64 <- case key_saved < separator of {
                    true -> 0;
                    false -> 1
                };
                child_id: int64 <- read_buf(tree.children, child_slot);
                contains_leaf_node(tree, child_id, key_saved)
            }
        }
    produces
        pure result
    end
}

fn contains_bootstrap(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> int64 {
    case tree.node_count of {
        1 -> contains_key_at(tree.keys, key, 0, tree.key_count_total);
        3 -> contains_split_root(tree, key);
        _: int64 -> 0
    }
}

fn contains[int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> int64 {
    sequence
        root_saved: int64 <- tree.root_id;
        key_saved: int64 <- key;
        result: int64 <- case root_saved of {
            -1 -> 0;
            _: int64 -> contains_bootstrap(tree, key_saved)
        }
    produces
        pure result
    end
}

// Check that keys_buf[start+i] < keys_buf[start+i+1] for all keys in a slice.
// Returns 0 for sorted, 5 (keys not sorted) on first violation.
fn keys_sorted_at(
    keys_buf: buf(L1, normal, int64, 8),
    key_count: int64,
    i: int64
) -> int64 {
    case i + 1 >= key_count of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_count_saved: int64 <- key_count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                kj: int64 <- read_buf(keys_buf_saved, i_saved + 1);
                result: int64 <- case ki < kj of {
                    true -> keys_sorted_at(keys_buf_saved, key_count_saved, i_saved + 1);
                    false -> 5
                }
            produces
                pure result
            end
        }
    }
}

fn keys_sorted_abs_at(
    keys_buf: buf(L1, normal, int64, 8),
    i: int64,
    end_index: int64
) -> int64 {
    case i + 1 >= end_index of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                i_saved: int64 <- i;
                end_saved: int64 <- end_index;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                kj: int64 <- read_buf(keys_buf_saved, i_saved + 1);
                result: int64 <- case ki < kj of {
                    true -> keys_sorted_abs_at(keys_buf_saved, i_saved + 1, end_saved);
                    false -> 5
                }
            produces
                pure result
            end
        }
    }
}

fn keys_less_than_abs_at(
    keys_buf: buf(L1, normal, int64, 8),
    i: int64,
    end_index: int64,
    upper: int64
) -> int64 {
    case i >= end_index of {
        true -> 1;
        false -> {
            sequence proc[mem(normal)]
                current: int64 <- read_buf(keys_buf, i);
                result: int64 <- case current < upper of {
                    true -> keys_less_than_abs_at(keys_buf, i + 1, end_index, upper);
                    false -> 0
                }
            produces
                pure result
            end
        }
    }
}

fn keys_greater_than_abs_at(
    keys_buf: buf(L1, normal, int64, 8),
    i: int64,
    end_index: int64,
    lower: int64
) -> int64 {
    case i >= end_index of {
        true -> 1;
        false -> {
            sequence proc[mem(normal)]
                current: int64 <- read_buf(keys_buf, i);
                result: int64 <- case current > lower of {
                    true -> keys_greater_than_abs_at(keys_buf, i + 1, end_index, lower);
                    false -> 0
                }
            produces
                pure result
            end
        }
    }
}

fn validate_empty(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    case tree.root_id == -1 of {
        false -> 1;
        true -> case tree.key_count_total of {
            0 -> 0;
            _: int64 -> 1
        }
    }
}

fn validate_leaf_node(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    node_id: int64,
    expected_start: int64,
    expected_count: int64
) -> int64 {
    sequence proc[mem(normal)]
        node_saved: int64 <- node_id;
        expected_start_saved: int64 <- expected_start;
        expected_count_saved: int64 <- expected_count;
        key_start: int64 <- read_buf(tree.node_key_start, node_saved);
        key_count: int64 <- read_buf(tree.node_key_count, node_saved);
        child_count: int64 <- read_buf(tree.node_child_count, node_saved);
        is_leaf: int64 <- read_buf(tree.node_is_leaf, node_saved);
        start_err: int64 <- case key_start == expected_start_saved of { true -> 0; false -> 4 };
        count_err: int64 <- case key_count == expected_count_saved of { true -> 0; false -> 4 };
        leaf_err: int64 <- case is_leaf of { 1 -> 0; _: int64 -> 7 };
        child_err: int64 <- case child_count of { 0 -> 0; _: int64 -> 7 };
        cap_err: int64 <- case key_count <= 7 of { true -> 0; false -> 20 };
        end_index: int64 <- key_start + key_count;
        sorted_err: int64 <- case key_start of {
            0 -> keys_sorted_at(tree.keys, key_count, 0);
            _: int64 -> keys_sorted_abs_at(tree.keys, key_start, end_index)
        };
        result: int64 <- first_error(start_err, first_error(count_err, first_error(leaf_err, first_error(child_err, first_error(cap_err, sorted_err)))))
    produces
        pure result
    end
}

fn validate_single_leaf(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    case tree.root_id of {
        0 -> case tree.key_count_total == 0 of {
            true -> 1;
            false -> validate_leaf_node(tree, 0, 0, tree.key_count_total)
        };
        _: int64 -> 1
    }
}

fn validate_split_three(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    sequence proc[mem(normal)]
        root_start: int64 <- read_buf(tree.node_key_start, 0);
        root_count: int64 <- read_buf(tree.node_key_count, 0);
        root_child_start: int64 <- read_buf(tree.node_child_start, 0);
        root_child_count: int64 <- read_buf(tree.node_child_count, 0);
        root_is_leaf: int64 <- read_buf(tree.node_is_leaf, 0);
        left_id: int64 <- read_buf(tree.children, 0);
        right_id: int64 <- read_buf(tree.children, 1);
        left_start: int64 <- read_buf(tree.node_key_start, 1);
        left_count: int64 <- read_buf(tree.node_key_count, 1);
        left_child_count: int64 <- read_buf(tree.node_child_count, 1);
        left_is_leaf: int64 <- read_buf(tree.node_is_leaf, 1);
        right_start_meta: int64 <- read_buf(tree.node_key_start, 2);
        right_count: int64 <- read_buf(tree.node_key_count, 2);
        right_child_count: int64 <- read_buf(tree.node_child_count, 2);
        right_is_leaf: int64 <- read_buf(tree.node_is_leaf, 2);
        separator: int64 <- read_buf(tree.keys, 0);
        l0: int64 <- read_buf(tree.keys, 1);
        l1: int64 <- read_buf(tree.keys, 2);
        l2: int64 <- read_buf(tree.keys, 3);
        r0: int64 <- read_buf(tree.keys, 4);
        r1: int64 <- read_buf(tree.keys, 5);
        r2: int64 <- read_buf(tree.keys, 6);
        r3: int64 <- read_buf(tree.keys, 7);
        root_err: int64 <- case tree.root_id of { 0 -> 0; _: int64 -> 1 };
        root_shape_err: int64 <- case root_start == 0 of {
            true -> case root_count == 1 of {
                true -> case root_child_start == 0 of {
                    true -> case root_child_count == 2 of {
                        true -> case root_is_leaf of { 0 -> 0; _: int64 -> 7 };
                        false -> 7
                    };
                    false -> 7
                };
                false -> 4
            };
            false -> 4
        };
        child_id_err: int64 <- case left_id == 1 of {
            true -> case right_id == 2 of { true -> 0; false -> 3 };
            false -> 3
        };
        leaf_shape_err: int64 <- case left_start == 1 of {
            true -> case left_count == 3 of {
                true -> case left_child_count == 0 of {
                    true -> case left_is_leaf == 1 of {
                        true -> case right_start_meta == 4 of {
                            true -> case right_count == 4 of {
                                true -> case right_child_count == 0 of {
                                    true -> case right_is_leaf == 1 of { true -> 0; false -> 7 };
                                    false -> 7
                                };
                                false -> 4
                            };
                            false -> 4
                        };
                        false -> 7
                    };
                    false -> 7
                };
                false -> 4
            };
            false -> 4
        };
        occupancy_err: int64 <- case left_count >= 3 of {
            true -> case right_count >= 3 of {
                true -> 0;
                false -> 8
            };
            false -> 8
        };
        total_err: int64 <- case tree.key_count_total == 1 + left_count + right_count of {
            true -> 0;
            false -> 4
        };
        left_sorted_err: int64 <- case l0 < l1 of {
            true -> case l1 < l2 of { true -> 0; false -> 5 };
            false -> 5
        };
        right_sorted_err: int64 <- case r0 < r1 of {
            true -> case r1 < r2 of {
                true -> case r2 < r3 of { true -> 0; false -> 5 };
                false -> 5
            };
            false -> 5
        };
        left_range_err: int64 <- case l2 < separator of { true -> 0; false -> 10 };
        right_range_err: int64 <- case separator < r0 of { true -> 0; false -> 10 };
        result: int64 <- first_error(root_err, first_error(root_shape_err, first_error(child_id_err, first_error(leaf_shape_err, first_error(occupancy_err, first_error(total_err, first_error(left_sorted_err, first_error(right_sorted_err, first_error(left_range_err, right_range_err)))))))))
    produces
        pure result
    end
}

fn validate_nonempty(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    case tree.key_count_total > key_cap() of {
        true -> 20;
        false -> case tree.node_count of {
            1 -> validate_single_leaf(tree);
            3 -> validate_split_three(tree);
            _: int64 -> 4
        }
    }
}

fn validate_error(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    case tree.order == order() of {
        false -> 8;
        true -> case tree.node_count of {
            0 -> validate_empty(tree);
            _: int64 -> validate_nonempty(tree)
        }
    }
}

fn validate[int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> { ok: int64, error_code: int64 } {
    sequence
        err: int64 <- validate_error(tree);
        ok_value: int64 <- case err of {
            0 -> 1;
            _: int64 -> 0
        };
        result: { ok: int64, error_code: int64 } <- {
            ok: ok_value,
            error_code: err
        }
    produces
        pure result
    end
}

// Find the position in sorted keys k0..k(count-1) where key should be inserted.
// Returns the first index i where k[i] > key, or count if key belongs at the end.
// Inlined scan avoids a 9-parameter recursive helper (AArch64 allows at most 8 reg args).
fn csr_insert_pos(
    k0: int64,
    k1: int64,
    k2: int64,
    k3: int64,
    k4: int64,
    k5: int64,
    count: int64,
    key: int64
) -> int64 {
    case count <= 0 of {
        true -> 0;
        false -> case k0 > key of {
            true -> 0;
            false -> case count <= 1 of {
                true -> 1;
                false -> case k1 > key of {
                    true -> 1;
                    false -> case count <= 2 of {
                        true -> 2;
                        false -> case k2 > key of {
                            true -> 2;
                            false -> case count <= 3 of {
                                true -> 3;
                                false -> case k3 > key of {
                                    true -> 3;
                                    false -> case count <= 4 of {
                                        true -> 4;
                                        false -> case k4 > key of {
                                            true -> 4;
                                            false -> case count <= 5 of {
                                                true -> 5;
                                                false -> case k5 > key of {
                                                    true -> 5;
                                                    false -> count
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Per-index helpers for output key after inserting new_key at pos into k0..k5.
// Splitting by out_i avoids a 9-parameter generic function (AArch64 limit: 8 reg args).
// Rule: out_i < pos → k[out_i]; out_i == pos → new_key; out_i > pos → k[out_i-1].
fn csr_out_key_0(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 0 of { true -> new_key; false -> k0 }
}

fn csr_out_key_1(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 1 of { true -> new_key; false -> case pos < 1 of { true -> k0; false -> k1 } }
}

fn csr_out_key_2(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 2 of { true -> new_key; false -> case pos < 2 of { true -> k1; false -> k2 } }
}

fn csr_out_key_3(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 3 of { true -> new_key; false -> case pos < 3 of { true -> k2; false -> k3 } }
}

fn csr_out_key_4(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 4 of { true -> new_key; false -> case pos < 4 of { true -> k3; false -> k4 } }
}

fn csr_out_key_5(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 5 of { true -> new_key; false -> case pos < 5 of { true -> k4; false -> k5 } }
}

fn csr_out_key_6(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 6 of { true -> new_key; false -> k5 }
}

// Buffer-based insert helpers: read one key at a time to avoid register pressure
// when scanning or building output keys (k0..k5 no longer all live at once).
fn csr_insert_pos_from_buf(
    keys_buf: buf(L1, normal, int64, 8),
    i: int64,
    count: int64,
    key: int64
) -> int64 {
    case i >= count of {
        true -> i;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_saved: int64 <- key;
                count_saved: int64 <- count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki > key_saved of {
                    true -> i_saved;
                    false -> csr_insert_pos_from_buf(keys_buf_saved, i_saved + 1, count_saved, key_saved)
                }
            produces
                pure result
            end
        }
    }
}

fn csr_out_key_from_buf(
    keys_buf: buf(L1, normal, int64, 8),
    out_i: int64,
    new_key: int64,
    pos: int64
) -> int64 {
    case out_i == pos of {
        true -> new_key;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                out_i_saved: int64 <- out_i;
                pos_saved: int64 <- pos;
                src_i: int64 <- case out_i_saved < pos_saved of {
                    true -> out_i_saved;
                    false -> out_i_saved - 1
                };
                result: int64 <- read_buf(keys_buf_saved, src_i)
            produces
                pure result
            end
        }
    }
}

fn build_leaf_csr_skeleton(
    key_count: int64,
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_item: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        key_count_saved: int64 <- key_count;
        compare_item_saved: fn(int64, int64) -> :less | :equal | :greater <- source_tree.compare_item;
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        nks: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nkc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncs: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nil_buf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nk: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nc: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(nks, 0, 0);
        _: atom <- write_buf(nkc, 0, key_count_saved);
        _: atom <- write_buf(ncs, 0, 0);
        _: atom <- write_buf(ncc, 0, 0);
        _: atom <- write_buf(nil_buf, 0, 1);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: 0,
            node_count: 1,
            key_count_total: key_count_saved,
            order: 8,
            node_key_start: nks,
            node_key_count: nkc,
            node_child_start: ncs,
            node_child_count: ncc,
            node_is_leaf: nil_buf,
            keys: nk,
            children: nc,
            compare_item: compare_item_saved
        }
    produces
        pure tree
    end
}

fn fill_leaf_csr_insert_keys(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    old_keys: buf(L1, normal, int64, 8),
    new_key: int64,
    pos: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_item: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        old_keys_saved: buf(L1, normal, int64, 8) <- old_keys;
        new_key_saved: int64 <- new_key;
        pos_saved: int64 <- pos;
        o0: int64 <- csr_out_key_from_buf(old_keys_saved, 0, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 0, o0);
        o1: int64 <- csr_out_key_from_buf(old_keys_saved, 1, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 1, o1);
        o2: int64 <- csr_out_key_from_buf(old_keys_saved, 2, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 2, o2);
        o3: int64 <- csr_out_key_from_buf(old_keys_saved, 3, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 3, o3);
        o4: int64 <- csr_out_key_from_buf(old_keys_saved, 4, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 4, o4);
        o5: int64 <- csr_out_key_from_buf(old_keys_saved, 5, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 5, o5);
        o6: int64 <- csr_out_key_from_buf(old_keys_saved, 6, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 6, o6)
    produces
        pure tree
    end
}

// Build a new single-leaf tree by inserting new_key at pos into keys_buf[0..new_count-1].
// Writes output keys one slot at a time so v0..v6 are never all live simultaneously.
fn build_leaf_csr_insert(
    keys_buf: buf(L1, normal, int64, 8),
    new_key: int64,
    pos: int64,
    new_count: int64,
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_item: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence
        keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
        new_key_saved: int64 <- new_key;
        pos_saved: int64 <- pos;
        new_count_saved: int64 <- new_count;
        skeleton: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- build_leaf_csr_skeleton(new_count_saved, source_tree);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- fill_leaf_csr_insert_keys(skeleton, keys_buf_saved, new_key_saved, pos_saved)
    produces
        pure tree
    end
}

fn build_split_csr_from_insert(
    keys_buf: buf(L1, normal, int64, 8),
    new_key: int64,
    pos: int64,
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_item: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        keys_saved: buf(L1, normal, int64, 8) <- keys_buf;
        new_key_saved: int64 <- new_key;
        pos_saved: int64 <- pos;
        compare_item_saved: fn(int64, int64) -> :less | :equal | :greater <- source_tree.compare_item;
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        nks: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nkc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncs: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nil_buf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nk: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nc: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        v0: int64 <- csr_out_key_from_buf(keys_saved, 0, new_key_saved, pos_saved);
        v1: int64 <- csr_out_key_from_buf(keys_saved, 1, new_key_saved, pos_saved);
        v2: int64 <- csr_out_key_from_buf(keys_saved, 2, new_key_saved, pos_saved);
        v3: int64 <- csr_out_key_from_buf(keys_saved, 3, new_key_saved, pos_saved);
        v4: int64 <- csr_out_key_from_buf(keys_saved, 4, new_key_saved, pos_saved);
        v5: int64 <- csr_out_key_from_buf(keys_saved, 5, new_key_saved, pos_saved);
        v6: int64 <- csr_out_key_from_buf(keys_saved, 6, new_key_saved, pos_saved);
        v7: int64 <- csr_out_key_from_buf(keys_saved, 7, new_key_saved, pos_saved);
        _: atom <- write_buf(nks, 0, 0);
        _: atom <- write_buf(nkc, 0, 1);
        _: atom <- write_buf(ncs, 0, 0);
        _: atom <- write_buf(ncc, 0, 2);
        _: atom <- write_buf(nil_buf, 0, 0);
        _: atom <- write_buf(nks, 1, 1);
        _: atom <- write_buf(nkc, 1, 3);
        _: atom <- write_buf(ncs, 1, 0);
        _: atom <- write_buf(ncc, 1, 0);
        _: atom <- write_buf(nil_buf, 1, 1);
        _: atom <- write_buf(nks, 2, 4);
        _: atom <- write_buf(nkc, 2, 4);
        _: atom <- write_buf(ncs, 2, 0);
        _: atom <- write_buf(ncc, 2, 0);
        _: atom <- write_buf(nil_buf, 2, 1);
        _: atom <- write_buf(nk, 0, v3);
        _: atom <- write_buf(nk, 1, v0);
        _: atom <- write_buf(nk, 2, v1);
        _: atom <- write_buf(nk, 3, v2);
        _: atom <- write_buf(nk, 4, v4);
        _: atom <- write_buf(nk, 5, v5);
        _: atom <- write_buf(nk, 6, v6);
        _: atom <- write_buf(nk, 7, v7);
        _: atom <- write_buf(nc, 0, 1);
        _: atom <- write_buf(nc, 1, 2);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: 0,
            node_count: 3,
            key_count_total: 8,
            order: order(),
            node_key_start: nks,
            node_key_count: nkc,
            node_child_start: ncs,
            node_child_count: ncc,
            node_is_leaf: nil_buf,
            keys: nk,
            children: nc,
            compare_item: compare_item_saved
        }
    produces
        pure tree
    end
}

fn insert_split_leaf_csr(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64,
    old_count: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    inserted: int64
} {
    sequence
        key_saved: int64 <- key;
        old_count_saved: int64 <- old_count;
        keys_saved: buf(L1, normal, int64, 8) <- tree.keys;
        pos: int64 <- csr_insert_pos_from_buf(keys_saved, 0, old_count_saved, key_saved);
        new_tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- build_split_csr_from_insert(keys_saved, key_saved, pos, tree)
    produces
        pure { tree: new_tree, inserted: 1 }
    end
}

fn insert_leaf_keys_csr(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64,
    old_count: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    inserted: int64
} {
    sequence
        key_saved: int64 <- key;
        old_count_saved: int64 <- old_count;
        keys_saved: buf(L1, normal, int64, 8) <- tree.keys;
        pos: int64 <- csr_insert_pos_from_buf(keys_saved, 0, old_count_saved, key_saved);
        new_tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- build_leaf_csr_insert(keys_saved, key_saved, pos, old_count_saved + 1, tree)
    produces
        pure { tree: new_tree, inserted: 1 }
    end
}

// Allocate a fresh single-leaf CsrBTreeSet with key_count keys k0..k6.
// Only k0..k(key_count-1) are meaningful; the rest are written but ignored
// by contains and validate (which respect node_key_count).
fn build_leaf_csr(
    k0: int64,
    k1: int64,
    k2: int64,
    k3: int64,
    k4: int64,
    k5: int64,
    k6: int64,
    key_count: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_item: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        nks: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nkc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncs: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nil_buf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nk: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nc: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(nks, 0, 0);
        _: atom <- write_buf(nkc, 0, key_count);
        _: atom <- write_buf(ncs, 0, 0);
        _: atom <- write_buf(ncc, 0, 0);
        _: atom <- write_buf(nil_buf, 0, 1);
        _: atom <- write_buf(nk, 0, k0);
        _: atom <- write_buf(nk, 1, k1);
        _: atom <- write_buf(nk, 2, k2);
        _: atom <- write_buf(nk, 3, k3);
        _: atom <- write_buf(nk, 4, k4);
        _: atom <- write_buf(nk, 5, k5);
        _: atom <- write_buf(nk, 6, k6);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_item: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: 0,
            node_count: 1,
            key_count_total: key_count,
            order: order(),
            node_key_start: nks,
            node_key_count: nkc,
            node_child_start: ncs,
            node_child_count: ncc,
            node_is_leaf: nil_buf,
            keys: nk,
            children: nc,
            compare_item: compare_int64_atom
        }
    produces
        pure tree
    end
}

// Insert key into a non-empty CsrBTreeSet. The generated Phase 1 family grows
// a full leaf into the first split root shape; further growth is capacity-bound.
fn insert_nonempty_csr(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    inserted: int64
} {
    case tree.node_count of {
        1 -> {
            sequence proc[mem(normal)]
                key_saved: int64 <- key;
                old_count: int64 <- read_buf(tree.node_key_count, 0);
                has_key: int64 <- contains_key_at(tree.keys, key_saved, 0, old_count);
                result: {
                    tree: {
                        region: region(L1, normal),
                        root_id: int64,
                        node_count: int64,
                        key_count_total: int64,
                        order: int64,
                        node_key_start: buf(L1, normal, int64, 3),
                        node_key_count: buf(L1, normal, int64, 3),
                        node_child_start: buf(L1, normal, int64, 3),
                        node_child_count: buf(L1, normal, int64, 3),
                        node_is_leaf: buf(L1, normal, int64, 3),
                        keys: buf(L1, normal, int64, 8),
                        children: buf(L1, normal, int64, 2),
                        compare_item: fn(int64, int64) -> :less | :equal | :greater
                    },
                    inserted: int64
                } <- case has_key of {
                    1 -> { tree: tree, inserted: 0 };
                    _: int64 -> case old_count < 7 of {
                        true -> insert_leaf_keys_csr(tree, key_saved, old_count);
                        false -> case old_count == 7 of {
                            true -> insert_split_leaf_csr(tree, key_saved, old_count);
                            false -> { tree: tree, inserted: 0 }
                        }
                    }
                }
            produces
                pure result
            end
        };
        _: int64 -> { tree: tree, inserted: 0 }
    }
}

// Functional insert: returns a new CsrBTreeSet with key added in sorted order.
// The original tree is never modified. inserted=1 means the key was newly added;
// inserted=0 means it was already present or the generated CSR capacity is full.
fn insert[int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    inserted: int64
} {
    case tree.root_id of {
        -1 -> {
            sequence proc[mem(normal)]
                key_saved: int64 <- key;
                cmp_tree: {
                    region: region(L1, normal),
                    root_id: int64,
                    node_count: int64,
                    key_count_total: int64,
                    order: int64,
                    node_key_start: buf(L1, normal, int64, 3),
                    node_key_count: buf(L1, normal, int64, 3),
                    node_child_start: buf(L1, normal, int64, 3),
                    node_child_count: buf(L1, normal, int64, 3),
                    node_is_leaf: buf(L1, normal, int64, 3),
                    keys: buf(L1, normal, int64, 8),
                    children: buf(L1, normal, int64, 2),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater
                } <- tree;
                new_tree: {
                    region: region(L1, normal),
                    root_id: int64,
                    node_count: int64,
                    key_count_total: int64,
                    order: int64,
                    node_key_start: buf(L1, normal, int64, 3),
                    node_key_count: buf(L1, normal, int64, 3),
                    node_child_start: buf(L1, normal, int64, 3),
                    node_child_count: buf(L1, normal, int64, 3),
                    node_is_leaf: buf(L1, normal, int64, 3),
                    keys: buf(L1, normal, int64, 8),
                    children: buf(L1, normal, int64, 2),
                    compare_item: fn(int64, int64) -> :less | :equal | :greater
                } <- build_leaf_csr_skeleton(1, cmp_tree);
                _: atom <- write_buf(new_tree.keys, 0, key_saved)
            produces
                pure { tree: new_tree, inserted: 1 }
            end
        };
        _: int64 -> insert_nonempty_csr(tree, key)
    }
}
