// Shared list helpers for NodeIdAdjacencyGraph (graph_representation_design.md §3).

export graph_adj_node_id_in_range/2;
export graph_adj_list_int64_length/1;
export graph_adj_list_int64_contains/2;
export graph_adj_build_empty_nodes_unweighted/1;
export graph_adj_find_neighbors_unweighted/3;
export graph_adj_replace_node_unweighted/4;
export graph_adj_sum_neighbor_counts_unweighted/1;
export graph_adj_count_node_records_unweighted/1;
export graph_adj_build_empty_nodes_weighted/1;
export graph_adj_find_neighbors_weighted/3;
export graph_adj_replace_node_weighted/4;
export graph_adj_list_weighted_length/1;
export graph_adj_list_weighted_contains/2;
export graph_adj_list_weighted_weight_at/2;
export graph_adj_sum_neighbor_counts_weighted/1;
export graph_adj_count_node_records_weighted/1;

fn graph_adj_node_id_in_range_1(node_id: int64) -> int64 {
    case node_id of {
        0 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_node_id_in_range_2(node_id: int64) -> int64 {
    case node_id of {
        0 -> 1;
        1 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_node_id_in_range_3(node_id: int64) -> int64 {
    case node_id of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_node_id_in_range(node_id: int64, node_count: int64) -> int64 {
    case node_count of {
        0 -> 0;
        1 -> graph_adj_node_id_in_range_1(node_id);
        2 -> graph_adj_node_id_in_range_2(node_id);
        3 -> graph_adj_node_id_in_range_3(node_id);
        _: int64 -> 0
    }
}

fn graph_adj_int64_equal_delta(delta: int64) -> int64 {
    case delta of {
        0 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_int64_equal(lhs: int64, rhs: int64) -> int64 {
    delta: int64 <- lhs - rhs;
    graph_adj_int64_equal_delta(delta)
}

fn graph_adj_list_int64_nonempty(lst: List[int64, mem(normal)]) -> int64 {
    case lst of {
        []: List[int64, mem(normal)] -> 0;
        [_: int64, _: List[int64, mem(normal)]] -> 1
    }
}

fn graph_adj_tail_int64_or_empty(lst: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case lst of {
        []: List[int64, mem(normal)] -> lst;
        [_: int64, t: List[int64, mem(normal)]] -> t
    }
}

fn graph_adj_list_int64_length(lst: List[int64, mem(normal)]) -> int64 {
    t1: List[int64, mem(normal)] <- graph_adj_tail_int64_or_empty(lst);
    t2: List[int64, mem(normal)] <- graph_adj_tail_int64_or_empty(t1);
    has0: int64 <- graph_adj_list_int64_nonempty(lst);
    has1: int64 <- graph_adj_list_int64_nonempty(t1);
    has2: int64 <- graph_adj_list_int64_nonempty(t2);
    has0 + has1 + has2
}

fn graph_adj_list_int64_contains_at0_cons(h: int64, value: int64) -> int64 {
    graph_adj_int64_equal(h, value)
}

fn graph_adj_list_int64_contains_at0(lst: List[int64, mem(normal)], value: int64) -> int64 {
    case lst of {
        []: List[int64, mem(normal)] -> 0;
        [h: int64, _: List[int64, mem(normal)]] -> graph_adj_list_int64_contains_at0_cons(h, value)
    }
}

fn graph_adj_list_int64_contains_at1(lst: List[int64, mem(normal)], value: int64) -> int64 {
    t: List[int64, mem(normal)] <- graph_adj_tail_int64_or_empty(lst);
    graph_adj_list_int64_contains_at0(t, value)
}

fn graph_adj_list_int64_contains(lst: List[int64, mem(normal)], value: int64) -> int64 {
    case graph_adj_list_int64_contains_at0(lst, value) of {
        1 -> 1;
        _: int64 -> graph_adj_list_int64_contains_at1(lst, value)
    }
}

fn graph_adj_build_empty_nodes_unweighted(node_count: int64) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        shared_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        empty_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]();
        built: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- case node_count of {
            0 -> empty_nodes;
            1 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                empty_nodes
            );
            2 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: shared_empty },
                    empty_nodes
                )
            );
            3 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: shared_empty },
                    prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                        { id: 2, neighbors: shared_empty },
                        empty_nodes
                    )
                )
            );
            _: int64 -> empty_nodes
        }
    produces
        pure built
    end
}

fn graph_adj_find_neighbors_unweighted_at0(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    default_empty: List[int64, mem(normal)]
) -> { found: int64, neighbors: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        found: int64 <- case nodes of {
            []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0;
            [_: { id: int64, neighbors: List[int64, mem(normal)] }, _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] -> 1
        };
        neighbors: List[int64, mem(normal)] <- case nodes of {
            []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> default_empty;
            [h: { id: int64, neighbors: List[int64, mem(normal)] }, _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] -> h.neighbors
        };
        out: { found: int64, neighbors: List[int64, mem(normal)] } <- {
            found: found,
            neighbors: neighbors
        }
    produces
        pure out
    end
}

fn graph_adj_tail_unweighted_or_empty(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    case nodes of {
        []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> nodes;
        [_: { id: int64, neighbors: List[int64, mem(normal)] }, t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] -> t
    }
}

fn graph_adj_find_neighbors_unweighted_at1(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    default_empty: List[int64, mem(normal)]
) -> { found: int64, neighbors: List[int64, mem(normal)] } {
    default_saved: List[int64, mem(normal)] <- default_empty;
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
    graph_adj_find_neighbors_unweighted_at0(tail1, default_saved)
}

fn graph_adj_find_neighbors_unweighted_at2(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    default_empty: List[int64, mem(normal)]
) -> { found: int64, neighbors: List[int64, mem(normal)] } {
    default_saved: List[int64, mem(normal)] <- default_empty;
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
    tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(tail1);
    graph_adj_find_neighbors_unweighted_at0(tail2, default_saved)
}

fn graph_adj_find_neighbors_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    target_id: int64,
    default_empty: List[int64, mem(normal)]
) -> { found: int64, neighbors: List[int64, mem(normal)] } {
    default_saved: List[int64, mem(normal)] <- default_empty;
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
    tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(tail1);
    r0: { found: int64, neighbors: List[int64, mem(normal)] } <- graph_adj_find_neighbors_unweighted_at0(nodes, default_saved);
    r1: { found: int64, neighbors: List[int64, mem(normal)] } <- graph_adj_find_neighbors_unweighted_at0(tail1, default_saved);
    r2: { found: int64, neighbors: List[int64, mem(normal)] } <- graph_adj_find_neighbors_unweighted_at0(tail2, default_saved);
    found: int64 <- case target_id of {
        0 -> r0.found;
        1 -> r1.found;
        2 -> r2.found;
        _: int64 -> 0
    };
    neighbors: List[int64, mem(normal)] <- case target_id of {
        0 -> r0.neighbors;
        1 -> r1.neighbors;
        2 -> r2.neighbors;
        _: int64 -> default_saved
    };
    out: { found: int64, neighbors: List[int64, mem(normal)] } <- {
        found: found,
        neighbors: neighbors
    };
    out
}

fn graph_adj_replace_node_unweighted_step(
    h: { id: int64, neighbors: List[int64, mem(normal)] },
    t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[int64, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    case h.id - target_id of {
        0 -> graph_adj_replace_node_unweighted_step_match(new_node, t);
        _: int64 -> graph_adj_replace_node_unweighted_step_skip(h, t, target_id, new_node, default_if_empty)
    }
}

fn graph_adj_replace_node_unweighted_step_match(
    new_node: { id: int64, neighbors: List[int64, mem(normal)] },
    t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        replaced: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](new_node, t)
    produces
        pure replaced
    end
}

fn graph_adj_replace_node_unweighted_step_skip(
    h: { id: int64, neighbors: List[int64, mem(normal)] },
    t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[int64, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        replaced: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
            h,
            graph_adj_replace_node_unweighted(t, target_id, new_node, default_if_empty)
        )
    produces
        pure replaced
    end
}

fn graph_adj_replace_node_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[int64, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    case nodes of {
        []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> default_if_empty;
        [h: { id: int64, neighbors: List[int64, mem(normal)] }, t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] ->
            graph_adj_replace_node_unweighted_step(h, t, target_id, new_node, default_if_empty);
        _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> default_if_empty
    }
}

fn graph_adj_sum_neighbor_counts_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0;
        [h: { id: int64, neighbors: List[int64, mem(normal)] }, t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] ->
            graph_adj_list_int64_length(h.neighbors) + graph_adj_sum_neighbor_counts_unweighted(t);
        _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0
    }
}

fn graph_adj_count_node_records_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0;
        [_: { id: int64, neighbors: List[int64, mem(normal)] }, t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] ->
            1 + graph_adj_count_node_records_unweighted(t);
        _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0
    }
}

fn graph_adj_build_empty_nodes_weighted(node_count: int64) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        shared_empty: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        empty_nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]();
        built: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] <- case node_count of {
            0 -> empty_nodes;
            1 -> prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                empty_nodes
            );
            2 -> prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: shared_empty },
                    empty_nodes
                )
            );
            3 -> prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: shared_empty },
                    prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                        { id: 2, neighbors: shared_empty },
                        empty_nodes
                    )
                )
            );
            _: int64 -> empty_nodes
        }
    produces
        pure built
    end
}

fn graph_adj_find_neighbors_weighted_step(
    h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    default_empty: List[{ to: int64, weight: int64 }, mem(normal)]
) -> { found: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] } {
    case h.id - target_id of {
        0 -> { found: 1, neighbors: h.neighbors };
        _: int64 -> graph_adj_find_neighbors_weighted(t, target_id, default_empty)
    }
}

fn graph_adj_find_neighbors_weighted(
    nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    default_empty: List[{ to: int64, weight: int64 }, mem(normal)]
) -> { found: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] } {
    case nodes of {
        []: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> { found: 0, neighbors: default_empty };
        [h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]] ->
            graph_adj_find_neighbors_weighted_step(h, t, target_id, default_empty);
        _: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> { found: 0, neighbors: default_empty }
    }
}

fn graph_adj_replace_node_weighted_step(
    h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    case h.id - target_id of {
        0 -> graph_adj_replace_node_weighted_step_match(new_node, t);
        _: int64 -> graph_adj_replace_node_weighted_step_skip(h, t, target_id, new_node, default_if_empty)
    }
}

fn graph_adj_replace_node_weighted_step_match(
    new_node: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        replaced: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] <- prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](new_node, t)
    produces
        pure replaced
    end
}

fn graph_adj_replace_node_weighted_step_skip(
    h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        replaced: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] <- prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
            h,
            graph_adj_replace_node_weighted(t, target_id, new_node, default_if_empty)
        )
    produces
        pure replaced
    end
}

fn graph_adj_replace_node_weighted(
    nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    case nodes of {
        []: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> default_if_empty;
        [h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]] ->
            graph_adj_replace_node_weighted_step(h, t, target_id, new_node, default_if_empty);
        _: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> default_if_empty
    }
}

fn graph_adj_list_weighted_contains_cons(
    h: { to: int64, weight: int64 },
    t: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> int64 {
    case h.to - to_id of {
        0 -> 1;
        _: int64 -> graph_adj_list_weighted_contains(t, to_id)
    }
}

fn graph_adj_list_weighted_contains(
    lst: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> int64 {
    case lst of {
        []: List[{ to: int64, weight: int64 }, mem(normal)] -> 0;
        [h: { to: int64, weight: int64 }, t: List[{ to: int64, weight: int64 }, mem(normal)]] -> graph_adj_list_weighted_contains_cons(h, t, to_id);
        _: List[{ to: int64, weight: int64 }, mem(normal)] -> 0
    }
}

fn graph_adj_list_weighted_weight_at_cons(
    h: { to: int64, weight: int64 },
    t: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> { found: int64, weight: int64 } {
    case h.to - to_id of {
        0 -> { found: 1, weight: h.weight };
        _: int64 -> graph_adj_list_weighted_weight_at(t, to_id)
    }
}

fn graph_adj_list_weighted_weight_at(
    lst: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> { found: int64, weight: int64 } {
    case lst of {
        []: List[{ to: int64, weight: int64 }, mem(normal)] -> { found: 0, weight: 0 };
        [h: { to: int64, weight: int64 }, t: List[{ to: int64, weight: int64 }, mem(normal)]] -> graph_adj_list_weighted_weight_at_cons(h, t, to_id);
        _: List[{ to: int64, weight: int64 }, mem(normal)] -> { found: 0, weight: 0 }
    }
}

fn graph_adj_list_weighted_length(lst: List[{ to: int64, weight: int64 }, mem(normal)]) -> int64 {
    case lst of {
        []: List[{ to: int64, weight: int64 }, mem(normal)] -> 0;
        [_: { to: int64, weight: int64 }, t: List[{ to: int64, weight: int64 }, mem(normal)]] -> 1 + graph_adj_list_weighted_length(t);
        _: List[{ to: int64, weight: int64 }, mem(normal)] -> 0
    }
}

fn graph_adj_sum_neighbor_counts_weighted(
    nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> 0;
        [h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]] ->
            graph_adj_list_weighted_length(h.neighbors) + graph_adj_sum_neighbor_counts_weighted(t);
        _: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> 0
    }
}

fn graph_adj_count_node_records_weighted(
    nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> 0;
        [_: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]] ->
            1 + graph_adj_count_node_records_weighted(t);
        _: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> 0
    }
}
