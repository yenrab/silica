        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> { found: int64, value: int64 } {
    sequence
        result: { found: int64, value: int64 } <- case tree.root_id of {
            -1 -> { found: 0, value: 0 };
            _: int64 -> get_bootstrap(tree, key)
        }
    produces
        pure result
    end
}

// ── Validation ───────────────────────────────────────────────────────────────

fn validate_empty(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    case tree.root_id == -1 of {
        false -> 1;
        true -> case tree.key_count_total of {
            0 -> 0;
            _: int64 -> 1
        }
    }
}

fn validate_leaf_node(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    node_id: int64,
    expected_start: int64,
    expected_count: int64
) -> int64 {
    sequence proc[mem(normal)]
        node_saved: int64 <- node_id;
        expected_start_saved: int64 <- expected_start;
        expected_count_saved: int64 <- expected_count;
        key_start: int64 <- read_buf(tree.node_key_start, node_saved);
        key_count: int64 <- read_buf(tree.node_key_count, node_saved);
        child_count: int64 <- read_buf(tree.node_child_count, node_saved);
        is_leaf: int64 <- read_buf(tree.node_is_leaf, node_saved);
        start_err: int64 <- case key_start == expected_start_saved of { true -> 0; false -> 4 };
        count_err: int64 <- case key_count == expected_count_saved of { true -> 0; false -> 4 };
        leaf_err: int64 <- case is_leaf of { 1 -> 0; _: int64 -> 7 };
        child_err: int64 <- case child_count of { 0 -> 0; _: int64 -> 7 };
        cap_err: int64 <- case key_count <= 7 of { true -> 0; false -> 20 };
        end_index: int64 <- key_start + key_count;
        sorted_err: int64 <- case key_start of {
            0 -> keys_sorted_at(tree.keys, key_count, 0);
            _: int64 -> keys_sorted_abs_at(tree.keys, key_start, end_index)
        };
        result: int64 <- first_error(start_err, first_error(count_err, first_error(leaf_err, first_error(child_err, first_error(cap_err, sorted_err)))))
    produces
        pure result
    end
}

fn validate_single_leaf(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    case tree.root_id of {
        0 -> case tree.key_count_total == 0 of {
            true -> 1;
            false -> validate_leaf_node(tree, 0, 0, tree.key_count_total)
        };
        _: int64 -> 1
    }
}

fn validate_split_three(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    sequence proc[mem(normal)]
        root_start: int64 <- read_buf(tree.node_key_start, 0);
        root_count: int64 <- read_buf(tree.node_key_count, 0);
        root_child_start: int64 <- read_buf(tree.node_child_start, 0);
        root_child_count: int64 <- read_buf(tree.node_child_count, 0);
        root_is_leaf: int64 <- read_buf(tree.node_is_leaf, 0);
        left_id: int64 <- read_buf(tree.children, 0);
        right_id: int64 <- read_buf(tree.children, 1);
        left_start: int64 <- read_buf(tree.node_key_start, 1);
        left_count: int64 <- read_buf(tree.node_key_count, 1);
        left_child_count: int64 <- read_buf(tree.node_child_count, 1);
        left_is_leaf: int64 <- read_buf(tree.node_is_leaf, 1);
        right_start_meta: int64 <- read_buf(tree.node_key_start, 2);
        right_count: int64 <- read_buf(tree.node_key_count, 2);
        right_child_count: int64 <- read_buf(tree.node_child_count, 2);
        right_is_leaf: int64 <- read_buf(tree.node_is_leaf, 2);
        separator: int64 <- read_buf(tree.keys, 0);
        l0: int64 <- read_buf(tree.keys, 1);
        l1: int64 <- read_buf(tree.keys, 2);
        l2: int64 <- read_buf(tree.keys, 3);
        r0: int64 <- read_buf(tree.keys, 4);
        r1: int64 <- read_buf(tree.keys, 5);
        r2: int64 <- read_buf(tree.keys, 6);
        r3: int64 <- read_buf(tree.keys, 7);
        root_err: int64 <- case tree.root_id of { 0 -> 0; _: int64 -> 1 };
        root_shape_err: int64 <- case root_start == 0 of {
            true -> case root_count == 1 of {
                true -> case root_child_start == 0 of {
                    true -> case root_child_count == 2 of {
                        true -> case root_is_leaf of { 0 -> 0; _: int64 -> 7 };
                        false -> 7
                    };
                    false -> 7
                };
                false -> 4
            };
            false -> 4
        };
        child_id_err: int64 <- case left_id == 1 of {
            true -> case right_id == 2 of { true -> 0; false -> 3 };
            false -> 3
        };
        leaf_shape_err: int64 <- case left_start == 1 of {
            true -> case left_count == 3 of {
                true -> case left_child_count == 0 of {
                    true -> case left_is_leaf == 1 of {
                        true -> case right_start_meta == 4 of {
                            true -> case right_count == 4 of {
                                true -> case right_child_count == 0 of {
                                    true -> case right_is_leaf == 1 of { true -> 0; false -> 7 };
                                    false -> 7
                                };
                                false -> 4
                            };
                            false -> 4
                        };
                        false -> 7
                    };
                    false -> 7
                };
                false -> 4
            };
            false -> 4
        };
        occupancy_err: int64 <- case left_count >= 3 of {
            true -> case right_count >= 3 of {
                true -> 0;
                false -> 8
            };
            false -> 8
        };
        total_err: int64 <- case tree.key_count_total == 1 + left_count + right_count of {
            true -> 0;
            false -> 4
        };
        left_sorted_err: int64 <- case l0 < l1 of {
            true -> case l1 < l2 of { true -> 0; false -> 5 };
            false -> 5
        };
        right_sorted_err: int64 <- case r0 < r1 of {
            true -> case r1 < r2 of {
                true -> case r2 < r3 of { true -> 0; false -> 5 };
                false -> 5
            };
            false -> 5
        };
        left_range_err: int64 <- case l2 < separator of { true -> 0; false -> 10 };
        right_range_err: int64 <- case separator < r0 of { true -> 0; false -> 10 };
        result: int64 <- first_error(root_err, first_error(root_shape_err, first_error(child_id_err, first_error(leaf_shape_err, first_error(occupancy_err, first_error(total_err, first_error(left_sorted_err, first_error(right_sorted_err, first_error(left_range_err, right_range_err)))))))))
    produces
        pure result
    end
}

fn validate_nonempty(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    case tree.key_count_total > key_cap() of {
        true -> 20;
        false -> case tree.node_count of {
            1 -> validate_single_leaf(tree);
            3 -> validate_split_three(tree);
            _: int64 -> 4
        }
    }
}

fn validate_error(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> int64 {
    case tree.order == order() of {
        false -> 8;
        true -> case tree.node_count of {
            0 -> validate_empty(tree);
            _: int64 -> validate_nonempty(tree)
        }
    }
}

fn validate[int64, int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> { ok: int64, error_code: int64 } {
    sequence
        err: int64 <- validate_error(tree);
        ok_value: int64 <- case err of {
            0 -> 1;
            _: int64 -> 0
        };
        result: { ok: int64, error_code: int64 } <- {
            ok: ok_value,
            error_code: err
        }
    produces
        pure result
    end
}

// ── Insert ───────────────────────────────────────────────────────────────────

// Functional insert with replace_value semantics. Returns a new map; the
// caller's existing map is unmodified. inserted=1 means the key was newly added;
// replaced=1 means the key existed and its value was updated; both 0 means the
// generated KEY_CAP (8) was exhausted and the key was absent.
fn insert[int64, int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64,
    value: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    inserted: int64,
    replaced: int64
} {
    case tree.root_id of {
        -1 -> {
            sequence proc[mem(normal)]
                key_saved: int64 <- key;
                value_saved: int64 <- value;
                cmp_tree: {
                    region: region(L1, normal),
                    root_id: int64,
                    node_count: int64,
                    key_count_total: int64,
                    order: int64,
                    node_key_start: buf(L1, normal, int64, 3),
                    node_key_count: buf(L1, normal, int64, 3),
                    node_child_start: buf(L1, normal, int64, 3),
                    node_child_count: buf(L1, normal, int64, 3),
                    node_is_leaf: buf(L1, normal, int64, 3),
                    keys: buf(L1, normal, int64, 8),
                    values: buf(L1, normal, int64, 8),
                    children: buf(L1, normal, int64, 2),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater
                } <- tree;
                partial_tree: {
                    region: region(L1, normal),
                    root_id: int64,
                    node_count: int64,
                    key_count_total: int64,
                    order: int64,
                    node_key_start: buf(L1, normal, int64, 3),
                    node_key_count: buf(L1, normal, int64, 3),
                    node_child_start: buf(L1, normal, int64, 3),
                    node_child_count: buf(L1, normal, int64, 3),
                    node_is_leaf: buf(L1, normal, int64, 3),
                    keys: buf(L1, normal, int64, 8),
                    values: buf(L1, normal, int64, 8),
                    children: buf(L1, normal, int64, 2),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater
                } <- build_leaf_csr_map_skeleton(1, cmp_tree);
                _: atom <- write_buf(partial_tree.keys, 0, key_saved);
                _: atom <- write_buf(partial_tree.values, 0, value_saved);
                new_tree: {
                    region: region(L1, normal),
                    root_id: int64,
                    node_count: int64,
                    key_count_total: int64,
                    order: int64,
                    node_key_start: buf(L1, normal, int64, 3),
                    node_key_count: buf(L1, normal, int64, 3),
                    node_child_start: buf(L1, normal, int64, 3),
                    node_child_count: buf(L1, normal, int64, 3),
                    node_is_leaf: buf(L1, normal, int64, 3),
                    keys: buf(L1, normal, int64, 8),
                    values: buf(L1, normal, int64, 8),
                    children: buf(L1, normal, int64, 2),
                    compare_key: fn(int64, int64) -> :less | :equal | :greater,
                    compare_value: fn(int64, int64) -> :less | :equal | :greater
                } <- partial_tree
            produces
                pure { tree: new_tree, inserted: 1, replaced: 0 }
            end
        };
        _: int64 -> insert_nonempty_csr_map(tree, key, value)
    }
}

fn find_value_scan_at_index(
    ctx: { compare_value: fn(int64, int64) -> :less | :equal | :greater },
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    query: int64,
    index: int64,
    count: int64
) -> { found: int64, key: int64 } {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- ctx.compare_value;
    sequence proc[mem(normal)]
        keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
        values_buf_saved: buf(L1, normal, int64, 8) <- values_buf;
        query_saved: int64 <- query;
        index_saved: int64 <- index;
        count_saved: int64 <- count;
        key_at: int64 <- read_buf(keys_buf_saved, index_saved);
        val_at: int64 <- read_buf(values_buf_saved, index_saved);
        step_result: { found: int64, key: int64 } <- case cmp(val_at, query_saved) of {
            :equal -> { found: 1, key: key_at };
            _: atom -> find_value_scan_step(ctx, keys_buf_saved, values_buf_saved, query_saved, index_saved + 1, count_saved)
        }
    produces
        pure step_result
    end
}

fn find_value_scan_step(
    ctx: { compare_value: fn(int64, int64) -> :less | :equal | :greater },
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    query: int64,
    index: int64,
    count: int64
) -> { found: int64, key: int64 } {
    case index >= count of {
        true -> { found: 0, key: 0 };
        false -> find_value_scan_at_index(ctx, keys_buf, values_buf, query, index, count)
    }
}

fn find_value_scan(
    ctx: { compare_value: fn(int64, int64) -> :less | :equal | :greater },
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    query: int64,
    index: int64,
    count: int64
) -> { found: int64, key: int64 } {
    find_value_scan_step(ctx, keys_buf, values_buf, query, index, count)
}

fn fold_scan_at_index(
    ctx: { fold_step: fn(int64, int64, int64) -> int64 },
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    index: int64,
    count: int64,
    acc: int64
) -> int64 {
    step_fn: fn(int64, int64, int64) -> int64 <- ctx.fold_step;
    sequence proc[mem(normal)]
        keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
        values_buf_saved: buf(L1, normal, int64, 8) <- values_buf;
        index_saved: int64 <- index;
        count_saved: int64 <- count;
        acc_saved: int64 <- acc;
        key_at: int64 <- read_buf(keys_buf_saved, index_saved);
        val_at: int64 <- read_buf(values_buf_saved, index_saved);
        next_acc: int64 <- step_fn(acc_saved, key_at, val_at);
        step_result: int64 <- fold_scan_step(ctx, keys_buf_saved, values_buf_saved, index_saved + 1, count_saved, next_acc)
    produces
        pure step_result
    end
}

fn fold_scan_step(
    ctx: { fold_step: fn(int64, int64, int64) -> int64 },
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    index: int64,
    count: int64,
    acc: int64
) -> int64 {
    case index >= count of {
        true -> acc;
        false -> fold_scan_at_index(ctx, keys_buf, values_buf, index, count, acc)
    }
}

fn fold_scan(
    ctx: { fold_step: fn(int64, int64, int64) -> int64 },
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    index: int64,
    count: int64,
    acc: int64
) -> int64 {
    fold_scan_step(ctx, keys_buf, values_buf, index, count, acc)
}

fn ordered_map_find_value(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    query: int64
) -> { found: int64, key: int64 } {
    sequence
        ctx: { compare_value: fn(int64, int64) -> :less | :equal | :greater } <- { compare_value: map.compare_value };
        query_saved: int64 <- query;
        count_saved: int64 <- map.key_count_total;
        result: { found: int64, key: int64 } <- find_value_scan_step(ctx, map.keys, map.values, query_saved, 0, count_saved)
    produces
        pure result
    end
}

fn ordered_map_fold(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    init: int64,
    fold_ctx: { fold_step: fn(int64, int64, int64) -> int64 }
) -> int64 {
    sequence
        init_saved: int64 <- init;
        count_saved: int64 <- map.key_count_total;
        result: int64 <- fold_scan_step(fold_ctx, map.keys, map.values, 0, count_saved, init_saved)
    produces
        pure result
    end
}
