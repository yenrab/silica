// ── New-key insertion path ───────────────────────────────────────────────────

// Key is absent and old_count < key_cap(). Insert key+value in sorted position.
// Returns inserted=1, replaced=0.
fn insert_new_key_csr_map(
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    key: int64,
    value: int64,
    old_count: int64,
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    inserted: int64,
    replaced: int64
} {
    sequence
        keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
        values_buf_saved: buf(L1, normal, int64, 8) <- values_buf;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        old_count_saved: int64 <- old_count;
        new_tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- build_leaf_csr_map_insert(keys_buf_saved, values_buf_saved, key_saved, value_saved, old_count_saved, source_tree)
    produces
        pure { tree: new_tree, inserted: 1, replaced: 0 }
    end
}

// ── Non-empty insert dispatcher ──────────────────────────────────────────────

// Dispatches to replace or insert paths for single-leaf and split-root forms.
// Returns { tree: old, inserted: 0, replaced: 0 } when capacity is exhausted.
fn insert_nonempty_csr_map(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64,
    value: int64
) -> {
    tree: {
region: region(L1, normal),
root_id: int64,
node_count: int64,
key_count_total: int64,
order: int64,
node_key_start: buf(L1, normal, int64, 3),
node_key_count: buf(L1, normal, int64, 3),
node_child_start: buf(L1, normal, int64, 3),
node_child_count: buf(L1, normal, int64, 3),
node_is_leaf: buf(L1, normal, int64, 3),
keys: buf(L1, normal, int64, 8),
values: buf(L1, normal, int64, 8),
children: buf(L1, normal, int64, 2),
compare_key: fn(int64, int64) -> :less | :equal | :greater,
compare_value: fn(int64, int64) -> :less | :equal | :greater
},
    inserted: int64,
    replaced: int64
} {
    case tree.node_count of {
        1 -> {
            sequence proc[mem(normal)]
                key_saved: int64 <- key;
                value_saved: int64 <- value;
                keys_saved: buf(L1, normal, int64, 8) <- tree.keys;
                values_saved: buf(L1, normal, int64, 8) <- tree.values;
                old_count: int64 <- read_buf(tree.node_key_count, 0);
                key_pos: int64 <- find_key_pos(keys_saved, key_saved, 0, old_count);
                result: {
                    tree: {
region: region(L1, normal),
root_id: int64,
node_count: int64,
key_count_total: int64,
order: int64,
node_key_start: buf(L1, normal, int64, 3),
node_key_count: buf(L1, normal, int64, 3),
node_child_start: buf(L1, normal, int64, 3),
node_child_count: buf(L1, normal, int64, 3),
node_is_leaf: buf(L1, normal, int64, 3),
keys: buf(L1, normal, int64, 8),
values: buf(L1, normal, int64, 8),
children: buf(L1, normal, int64, 2),
compare_key: fn(int64, int64) -> :less | :equal | :greater,
compare_value: fn(int64, int64) -> :less | :equal | :greater
},
                    inserted: int64,
                    replaced: int64
                } <- case key_pos of {
                    -1 -> case old_count of {
                        7 -> insert_split_leaf_csr_map(tree, key_saved, value_saved, old_count);
                        _: int64 -> case old_count < 7 of {
                            true -> insert_new_key_csr_map(keys_saved, values_saved, key_saved, value_saved, old_count, tree);
                            false -> { tree: tree, inserted: 0, replaced: 0 }
                        }
                    };
                    _: int64 -> replace_val_csr_map(keys_saved, values_saved, key_pos, value_saved, old_count, tree)
                }
            produces
                pure result
            end
        };
        3 -> {
            sequence proc[mem(normal)]
                key_saved: int64 <- key;
                value_saved: int64 <- value;
                key_pos: int64 <- find_key_pos_split_root(tree, key_saved);
                result: {
                    tree: {
region: region(L1, normal),
root_id: int64,
node_count: int64,
key_count_total: int64,
order: int64,
node_key_start: buf(L1, normal, int64, 3),
node_key_count: buf(L1, normal, int64, 3),
node_child_start: buf(L1, normal, int64, 3),
node_child_count: buf(L1, normal, int64, 3),
node_is_leaf: buf(L1, normal, int64, 3),
keys: buf(L1, normal, int64, 8),
values: buf(L1, normal, int64, 8),
children: buf(L1, normal, int64, 2),
compare_key: fn(int64, int64) -> :less | :equal | :greater,
compare_value: fn(int64, int64) -> :less | :equal | :greater
},
                    inserted: int64,
                    replaced: int64
                } <- case key_pos of {
                    -1 -> { tree: tree, inserted: 0, replaced: 0 };
                    _: int64 -> replace_val_split_csr_map(tree, key_pos, value_saved)
                }
            produces
                pure result
            end
        };
        _: int64 -> { tree: tree, inserted: 0, replaced: 0 }
    }
}

// ── Contains ─────────────────────────────────────────────────────────────────

fn contains_bootstrap(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> int64 {
    case tree.node_count of {
        1 -> contains_key_at(tree.keys, key, 0, tree.key_count_total);
        3 -> contains_split_root(tree, key);
        _: int64 -> 0
    }
}

fn contains[int64, int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> int64 {
    sequence
        root_saved: int64 <- tree.root_id;
        key_saved: int64 <- key;
        result: int64 <- case root_saved of {
            -1 -> 0;
            _: int64 -> contains_bootstrap(tree, key_saved)
        }
    produces
        pure result
    end
}

// ── Get ──────────────────────────────────────────────────────────────────────

fn get_bootstrap(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> { found: int64, value: int64 } {
    case tree.node_count of {
        1 -> {
            sequence proc[mem(normal)]
                key_saved: int64 <- key;
                key_pos: int64 <- find_key_pos(tree.keys, key_saved, 0, tree.key_count_total);
                result: { found: int64, value: int64 } <- case key_pos of {
                    -1 -> { found: 0, value: 0 };
                    _: int64 -> {
                        sequence proc[mem(normal)]
                            v: int64 <- read_buf(tree.values, key_pos)
                        produces
                            pure { found: 1, value: v }
                        end
                    }
                }
            produces
                pure result
            end
        };
        3 -> get_split_root(tree, key);
        _: int64 -> { found: 0, value: 0 }
    }
}

fn get[int64, int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
