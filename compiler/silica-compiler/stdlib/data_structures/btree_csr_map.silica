// Copyright 2026 Lee Scott Barney — Apache License 2.0
// CsrBTreeMap[int64, int64, mem(normal)] (balanced_tree_and_heap_design.md §5.3).
// Module name: btree_csr_map  (design §8).
// Generated family: order 8, NODE_CAP=3, KEY_CAP=8, CHILD_CAP=2.
// Supports the Phase 1 leaf form and the first split root form.
// Duplicate-key policy: replace_value (design §3 recommended default).
// Immutable functional data structure: insert and replace both return a new value;
// the caller's existing map is never modified (structural-sharing principle).
//
// Reuses key-ordering and position helpers from btree_set_csr (copied verbatim):
//   contains_key_at, keys_sorted_at, csr_insert_pos_from, csr_insert_pos, csr_out_key.
// Adds: find_key_pos, val_at_or_new, build_leaf_csr_map, replace/insert helpers,
//   get, and the extended map type with a parallel values buffer.

export empty[int64, int64, mem(normal)]/0;
export empty/1;
export from_static_sorted[int64, int64, mem(normal)]/0;
export contains[int64, int64, mem(normal)]/2;
export contains_key_csr/2;
export get[int64, int64, mem(normal)]/2;
export insert[int64, int64, mem(normal)]/3;
export validate[int64, int64, mem(normal)]/1;
export ordered_map_find_value/2;
export ordered_map_fold/3;

fn order() -> int64 {
    8
}

fn node_cap() -> int64 {
    3
}

fn key_cap() -> int64 {
    8
}

fn child_cap() -> int64 {
    2
}

fn first_error(first: int64, second: int64) -> int64 {
    case first of {
        0 -> second;
        _: int64 -> first
    }
}

fn key_equal(left: int64, right: int64) -> int64 {
    case left == right of {
        true -> 1;
        false -> 0
    }
}

fn compare_int64_atom(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn empty[int64, int64, mem(normal)]() -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        node_key_start: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_key_count: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_child_start: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_child_count: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_is_leaf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        keys: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        values: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        children: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: -1,
            node_count: 0,
            key_count_total: 0,
            order: order(),
            node_key_start: node_key_start,
            node_key_count: node_key_count,
            node_child_start: node_child_start,
            node_child_count: node_child_count,
            node_is_leaf: node_is_leaf,
            keys: keys,
            values: values,
            children: children,
            compare_key: compare_int64_atom,
            compare_value: compare_int64_atom
        }
    produces
        pure tree
    end
}

