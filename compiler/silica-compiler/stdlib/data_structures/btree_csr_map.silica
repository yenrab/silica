} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        node_key_start: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_key_count: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_child_start: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_child_count: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_is_leaf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        keys: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        values: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        children: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: -1,
            node_count: 0,
            key_count_total: 0,
            order: order(),
            node_key_start: node_key_start,
            node_key_count: node_key_count,
            node_child_start: node_child_start,
            node_child_count: node_child_count,
            node_is_leaf: node_is_leaf,
            keys: keys,
            values: values,
            children: children,
            compare_key: map_functions.compare_key,
            compare_value: map_functions.compare_value
        }
    produces
        pure tree
    end
}

fn contains_key_csr(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> int64 {
    contains[int64, int64, mem(normal)](tree, key)
}

// Static example: keys {1, 3, 5} mapped to values {10, 30, 50}.
fn from_static_sorted[int64, int64, mem(normal)]() -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        node_key_start: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_key_count: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_child_start: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_child_count: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        node_is_leaf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        keys: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        values: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        children: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(node_key_start, 0, 0);
        _: atom <- write_buf(node_key_count, 0, 3);
        _: atom <- write_buf(node_child_start, 0, 0);
        _: atom <- write_buf(node_child_count, 0, 0);
        _: atom <- write_buf(node_is_leaf, 0, 1);
        _: atom <- write_buf(keys, 0, 1);
        _: atom <- write_buf(keys, 1, 3);
        _: atom <- write_buf(keys, 2, 5);
        _: atom <- write_buf(values, 0, 10);
        _: atom <- write_buf(values, 1, 30);
        _: atom <- write_buf(values, 2, 50);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: 0,
            node_count: 1,
            key_count_total: 3,
            order: 8,
            node_key_start: node_key_start,
            node_key_count: node_key_count,
            node_child_start: node_child_start,
            node_child_count: node_child_count,
            node_is_leaf: node_is_leaf,
            keys: keys,
            values: values,
            children: children,
            compare_key: compare_int64_atom,
            compare_value: compare_int64_atom
        }
    produces
        pure tree
    end
}

// ── Key-search helpers (copied verbatim from btree_set_csr) ──────────────────

fn contains_key_at(
    keys_buf: buf(L1, normal, int64, 8),
    key: int64,
    i: int64,
    count: int64
) -> int64 {
    case i >= count of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_saved: int64 <- key;
                count_saved: int64 <- count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki == key_saved of {
                    true -> 1;
                    false -> contains_key_at(keys_buf_saved, key_saved, i_saved + 1, count_saved)
                }
            produces
                pure result
            end
        }
    }
}

// Returns the buffer index of key in keys_buf[0..count-1], or -1 if absent.
fn find_key_pos(
    keys_buf: buf(L1, normal, int64, 8),
    key: int64,
    i: int64,
    count: int64
) -> int64 {
    case i >= count of {
        true -> -1;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_saved: int64 <- key;
                count_saved: int64 <- count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki == key_saved of {
                    true -> i;
                    false -> find_key_pos(keys_buf_saved, key_saved, i_saved + 1, count_saved)
                }
            produces
                pure result
            end
        }
    }
}
fn find_key_pos_abs_at(
    keys_buf: buf(L1, normal, int64, 8),
    key: int64,
    i: int64,
    end_index: int64
) -> int64 {
    case i >= end_index of {
        true -> -1;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_saved: int64 <- key;
                i_saved: int64 <- i;
                end_saved: int64 <- end_index;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki == key_saved of {
                    true -> i_saved;
                    false -> find_key_pos_abs_at(keys_buf_saved, key_saved, i_saved + 1, end_saved)
                }
            produces
                pure result
            end
        }
    }
}

fn contains_key_abs_at(
    keys_buf: buf(L1, normal, int64, 8),
    key: int64,
    i: int64,
    end_index: int64
) -> int64 {
    case i >= end_index of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_saved: int64 <- key;
                i_saved: int64 <- i;
                end_saved: int64 <- end_index;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki == key_saved of {
                    true -> 1;
                    false -> contains_key_abs_at(keys_buf_saved, key_saved, i_saved + 1, end_saved)
                }
            produces
                pure result
            end
        }
    }
}

fn contains_leaf_node(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    node_id: int64,
    key: int64
) -> int64 {
    sequence proc[mem(normal)]
        node_saved: int64 <- node_id;
        key_saved: int64 <- key;
        key_start: int64 <- read_buf(tree.node_key_start, node_saved);
        key_count: int64 <- read_buf(tree.node_key_count, node_saved);
        end_index: int64 <- key_start + key_count;
        result: int64 <- case node_saved of {
            0 -> contains_key_at(tree.keys, key_saved, 0, key_count);
            _: int64 -> contains_key_abs_at(tree.keys, key_saved, key_start, end_index)
        }
    produces
        pure result
    end
}

fn contains_split_root(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> int64 {
    sequence proc[mem(normal)]
        key_saved: int64 <- key;
        root_start: int64 <- read_buf(tree.node_key_start, 0);
        separator: int64 <- read_buf(tree.keys, root_start);
        result: int64 <- case key_saved == separator of {
            true -> 1;
            false -> {
                child_slot: int64 <- case key_saved < separator of {
                    true -> 0;
                    false -> 1
                };
                child_id: int64 <- read_buf(tree.children, child_slot);
                contains_leaf_node(tree, child_id, key_saved)
            }
        }
    produces
        pure result
    end
}

fn get_leaf_node(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    node_id: int64,
    key: int64
) -> { found: int64, value: int64 } {
    sequence proc[mem(normal)]
        node_saved: int64 <- node_id;
        key_saved: int64 <- key;
        key_start: int64 <- read_buf(tree.node_key_start, node_saved);
        key_count: int64 <- read_buf(tree.node_key_count, node_saved);
        end_index: int64 <- key_start + key_count;
        key_pos: int64 <- case node_saved of {
            0 -> find_key_pos(tree.keys, key_saved, 0, key_count);
            _: int64 -> find_key_pos_abs_at(tree.keys, key_saved, key_start, end_index)
        };
        result: { found: int64, value: int64 } <- case key_pos of {
            -1 -> { found: 0, value: 0 };
            _: int64 -> {
                sequence proc[mem(normal)]
                    v: int64 <- read_buf(tree.values, key_pos)
                produces
                    pure { found: 1, value: v }
                end
            }
        }
    produces
        pure result
    end
}

fn get_split_root(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> { found: int64, value: int64 } {
    sequence proc[mem(normal)]
        key_saved: int64 <- key;
        root_start: int64 <- read_buf(tree.node_key_start, 0);
        separator: int64 <- read_buf(tree.keys, root_start);
        result: { found: int64, value: int64 } <- case key_saved == separator of {
            true -> {
                sequence proc[mem(normal)]
                    v: int64 <- read_buf(tree.values, root_start)
                produces
                    pure { found: 1, value: v }
                end
            };
            false -> {
                child_slot: int64 <- case key_saved < separator of {
                    true -> 0;
                    false -> 1
                };
                child_id: int64 <- read_buf(tree.children, child_slot);
                get_leaf_node(tree, child_id, key_saved)
            }
        }
    produces
        pure result
    end
}

fn find_key_pos_split_root(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> int64 {
    sequence proc[mem(normal)]
        key_saved: int64 <- key;
        root_start: int64 <- read_buf(tree.node_key_start, 0);
        separator: int64 <- read_buf(tree.keys, root_start);
        result: int64 <- case key_saved == separator of {
            true -> root_start;
            false -> {
                child_slot: int64 <- case key_saved < separator of {
                    true -> 0;
                    false -> 1
                };
                child_id: int64 <- read_buf(tree.children, child_slot);
                key_start: int64 <- read_buf(tree.node_key_start, child_id);
                key_count: int64 <- read_buf(tree.node_key_count, child_id);
                end_index: int64 <- key_start + key_count;
                find_key_pos_abs_at(tree.keys, key_saved, key_start, end_index)
            }
        }
    produces
        pure result
    end
}


fn keys_sorted_at(
    keys_buf: buf(L1, normal, int64, 8),
    key_count: int64,
    i: int64
) -> int64 {
    case i + 1 >= key_count of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_count_saved: int64 <- key_count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                kj: int64 <- read_buf(keys_buf_saved, i_saved + 1);
                result: int64 <- case ki < kj of {
                    true -> keys_sorted_at(keys_buf_saved, key_count_saved, i_saved + 1);
                    false -> 5
                }
            produces
                pure result
            end
        }
    }
}

fn keys_sorted_abs_at(
    keys_buf: buf(L1, normal, int64, 8),
    i: int64,
    end_index: int64
) -> int64 {
    case i + 1 >= end_index of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                i_saved: int64 <- i;
                end_saved: int64 <- end_index;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                kj: int64 <- read_buf(keys_buf_saved, i_saved + 1);
                result: int64 <- case ki < kj of {
                    true -> keys_sorted_abs_at(keys_buf_saved, i_saved + 1, end_saved);
                    false -> 5
                }
            produces
                pure result
            end
        }
    }
}


// ── Insert-position helpers (copied verbatim from btree_set_csr) ─────────────

// Find the insertion position in sorted keys k0..k(count-1).
// Inlined scan avoids a 9-parameter recursive helper (AArch64 limit: 8 reg args).
fn csr_insert_pos(
    k0: int64,
    k1: int64,
    k2: int64,
    k3: int64,
    k4: int64,
    k5: int64,
    count: int64,
    key: int64
) -> int64 {
    case count <= 0 of {
        true -> 0;
        false -> case k0 > key of {
            true -> 0;
            false -> case count <= 1 of {
                true -> 1;
                false -> case k1 > key of {
                    true -> 1;
                    false -> case count <= 2 of {
                        true -> 2;
                        false -> case k2 > key of {
                            true -> 2;
                            false -> case count <= 3 of {
                                true -> 3;
                                false -> case k3 > key of {
                                    true -> 3;
                                    false -> case count <= 4 of {
                                        true -> 4;
                                        false -> case k4 > key of {
                                            true -> 4;
                                            false -> case count <= 5 of {
                                                true -> 5;
                                                false -> case k5 > key of {
                                                    true -> 5;
                                                    false -> count
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Per-index helpers for shifted insert output (keys or values).
// Rule: out_i < pos → arr[out_i]; out_i == pos → new_val; out_i > pos → arr[out_i-1].
// Splitting by out_i avoids a 9-parameter generic function (AArch64 limit: 8 reg args).
fn csr_out_key_0(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 0 of { true -> new_key; false -> k0 }
}

fn csr_out_key_1(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 1 of { true -> new_key; false -> case pos < 1 of { true -> k0; false -> k1 } }
}

fn csr_out_key_2(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 2 of { true -> new_key; false -> case pos < 2 of { true -> k1; false -> k2 } }
}

fn csr_out_key_3(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 3 of { true -> new_key; false -> case pos < 3 of { true -> k2; false -> k3 } }
}

fn csr_out_key_4(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 4 of { true -> new_key; false -> case pos < 4 of { true -> k3; false -> k4 } }
}

fn csr_out_key_5(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 5 of { true -> new_key; false -> case pos < 5 of { true -> k4; false -> k5 } }
}

fn csr_out_key_6(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 6 of { true -> new_key; false -> k5 }
}

// ── Replace helper: returns v[out_i] unless out_i == pos, then returns new_val.
// No shifting — used for replace_value where key count is unchanged.
// Each function only needs the value at the specific position, not all 8.
fn val_at_or_new_0(v0: int64, new_val: int64, pos: int64) -> int64 {
    case pos == 0 of { true -> new_val; false -> v0 }
}

fn val_at_or_new_1(v1: int64, new_val: int64, pos: int64) -> int64 {
    case pos == 1 of { true -> new_val; false -> v1 }
}

fn val_at_or_new_2(v2: int64, new_val: int64, pos: int64) -> int64 {
    case pos == 2 of { true -> new_val; false -> v2 }
}

fn val_at_or_new_3(v3: int64, new_val: int64, pos: int64) -> int64 {
    case pos == 3 of { true -> new_val; false -> v3 }
}

fn val_at_or_new_4(v4: int64, new_val: int64, pos: int64) -> int64 {
    case pos == 4 of { true -> new_val; false -> v4 }
}

fn val_at_or_new_5(v5: int64, new_val: int64, pos: int64) -> int64 {
    case pos == 5 of { true -> new_val; false -> v5 }
}

fn val_at_or_new_6(v6: int64, new_val: int64, pos: int64) -> int64 {
    case pos == 6 of { true -> new_val; false -> v6 }
}

fn val_at_or_new_7(v7: int64, new_val: int64, pos: int64) -> int64 {
    case pos == 7 of { true -> new_val; false -> v7 }
}

// Buffer-based helpers: read one slot at a time to avoid register pressure.
fn csr_insert_pos_from_buf(
    keys_buf: buf(L1, normal, int64, 8),
    i: int64,
    count: int64,
    key: int64
) -> int64 {
    case i >= count of {
        true -> i;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                key_saved: int64 <- key;
                count_saved: int64 <- count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki > key_saved of {
                    true -> i_saved;
                    false -> csr_insert_pos_from_buf(keys_buf_saved, i_saved + 1, count_saved, key_saved)
                }
            produces
                pure result
            end
        }
    }
}

fn csr_out_key_from_buf(
    keys_buf: buf(L1, normal, int64, 8),
    out_i: int64,
    new_key: int64,
    pos: int64
) -> int64 {
    case out_i == pos of {
        true -> new_key;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
                out_i_saved: int64 <- out_i;
                pos_saved: int64 <- pos;
                src_i: int64 <- case out_i_saved < pos_saved of {
                    true -> out_i_saved;
                    false -> out_i_saved - 1
                };
                result: int64 <- read_buf(keys_buf_saved, src_i)
            produces
                pure result
            end
        }
    }
}

fn val_at_or_new_from_buf(
    values_buf: buf(L1, normal, int64, 8),
    out_i: int64,
    new_val: int64,
    key_pos: int64
) -> int64 {
    case out_i == key_pos of {
        true -> new_val;
        false -> {
            sequence proc[mem(normal)]
                values_buf_saved: buf(L1, normal, int64, 8) <- values_buf;
                out_i_saved: int64 <- out_i;
                result: int64 <- read_buf(values_buf_saved, out_i_saved)
            produces
                pure result
            end
        }
    }
}

fn csr_out_value_from_buf(
    values_buf: buf(L1, normal, int64, 8),
    out_i: int64,
    new_val: int64,
    pos: int64
) -> int64 {
    case out_i == pos of {
        true -> new_val;
        false -> {
            sequence proc[mem(normal)]
                values_buf_saved: buf(L1, normal, int64, 8) <- values_buf;
                out_i_saved: int64 <- out_i;
                pos_saved: int64 <- pos;
                src_i: int64 <- case out_i_saved < pos_saved of {
                    true -> out_i_saved;
                    false -> out_i_saved - 1
                };
                result: int64 <- read_buf(values_buf_saved, src_i)
            produces
                pure result
            end
        }
    }
}

fn build_leaf_csr_map_skeleton(
    key_count: int64,
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        nks: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nkc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncs: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nil_buf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nk: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nv: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nc: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(nks, 0, 0);
        _: atom <- write_buf(nkc, 0, key_count);
        _: atom <- write_buf(ncs, 0, 0);
        _: atom <- write_buf(ncc, 0, 0);
        _: atom <- write_buf(nil_buf, 0, 1);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: 0,
            node_count: 1,
            key_count_total: key_count,
            order: 8,
            node_key_start: nks,
            node_key_count: nkc,
            node_child_start: ncs,
            node_child_count: ncc,
            node_is_leaf: nil_buf,
            keys: nk,
            values: nv,
            children: nc,
            compare_key: source_tree.compare_key,
            compare_value: source_tree.compare_value
        }
    produces
        pure tree
    end
}

fn fill_csr_map_insert_slots(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    old_keys: buf(L1, normal, int64, 8),
    old_values: buf(L1, normal, int64, 8),
    new_key: int64,
    new_val: int64,
    pos: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        old_keys_saved: buf(L1, normal, int64, 8) <- old_keys;
        old_values_saved: buf(L1, normal, int64, 8) <- old_values;
        new_key_saved: int64 <- new_key;
        new_val_saved: int64 <- new_val;
        pos_saved: int64 <- pos;
        o0: int64 <- csr_out_key_from_buf(old_keys_saved, 0, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 0, o0);
        u0: int64 <- csr_out_value_from_buf(old_values_saved, 0, new_val_saved, pos_saved);
        _: atom <- write_buf(tree.values, 0, u0);
        o1: int64 <- csr_out_key_from_buf(old_keys_saved, 1, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 1, o1);
        u1: int64 <- csr_out_value_from_buf(old_values_saved, 1, new_val_saved, pos_saved);
        _: atom <- write_buf(tree.values, 1, u1);
        o2: int64 <- csr_out_key_from_buf(old_keys_saved, 2, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 2, o2);
        u2: int64 <- csr_out_value_from_buf(old_values_saved, 2, new_val_saved, pos_saved);
        _: atom <- write_buf(tree.values, 2, u2);
        o3: int64 <- csr_out_key_from_buf(old_keys_saved, 3, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 3, o3);
        u3: int64 <- csr_out_value_from_buf(old_values_saved, 3, new_val_saved, pos_saved);
        _: atom <- write_buf(tree.values, 3, u3);
        o4: int64 <- csr_out_key_from_buf(old_keys_saved, 4, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 4, o4);
        u4: int64 <- csr_out_value_from_buf(old_values_saved, 4, new_val_saved, pos_saved);
        _: atom <- write_buf(tree.values, 4, u4);
        o5: int64 <- csr_out_key_from_buf(old_keys_saved, 5, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 5, o5);
        u5: int64 <- csr_out_value_from_buf(old_values_saved, 5, new_val_saved, pos_saved);
        _: atom <- write_buf(tree.values, 5, u5);
        o6: int64 <- csr_out_key_from_buf(old_keys_saved, 6, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 6, o6);
        u6: int64 <- csr_out_value_from_buf(old_values_saved, 6, new_val_saved, pos_saved);
        _: atom <- write_buf(tree.values, 6, u6);
        o7: int64 <- csr_out_key_from_buf(old_keys_saved, 7, new_key_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 7, o7);
        u7: int64 <- csr_out_value_from_buf(old_values_saved, 7, new_val_saved, pos_saved);
        _: atom <- write_buf(tree.values, 7, u7)
    produces
        pure tree
    end
}

fn fill_csr_map_replace_slots(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    old_keys: buf(L1, normal, int64, 8),
    old_values: buf(L1, normal, int64, 8),
    key_pos: int64,
    new_val: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        old_keys_saved: buf(L1, normal, int64, 8) <- old_keys;
        old_values_saved: buf(L1, normal, int64, 8) <- old_values;
        key_pos_saved: int64 <- key_pos;
        new_val_saved: int64 <- new_val;
        k0: int64 <- read_buf(old_keys_saved, 0);
        _: atom <- write_buf(tree.keys, 0, k0);
        v0: int64 <- val_at_or_new_from_buf(old_values_saved, 0, new_val_saved, key_pos_saved);
        _: atom <- write_buf(tree.values, 0, v0);
        k1: int64 <- read_buf(old_keys_saved, 1);
        _: atom <- write_buf(tree.keys, 1, k1);
        v1: int64 <- val_at_or_new_from_buf(old_values_saved, 1, new_val_saved, key_pos_saved);
        _: atom <- write_buf(tree.values, 1, v1);
        k2: int64 <- read_buf(old_keys_saved, 2);
        _: atom <- write_buf(tree.keys, 2, k2);
        v2: int64 <- val_at_or_new_from_buf(old_values_saved, 2, new_val_saved, key_pos_saved);
        _: atom <- write_buf(tree.values, 2, v2);
        k3: int64 <- read_buf(old_keys_saved, 3);
        _: atom <- write_buf(tree.keys, 3, k3);
        v3: int64 <- val_at_or_new_from_buf(old_values_saved, 3, new_val_saved, key_pos_saved);
        _: atom <- write_buf(tree.values, 3, v3);
        k4: int64 <- read_buf(old_keys_saved, 4);
        _: atom <- write_buf(tree.keys, 4, k4);
        v4: int64 <- val_at_or_new_from_buf(old_values_saved, 4, new_val_saved, key_pos_saved);
        _: atom <- write_buf(tree.values, 4, v4);
        k5: int64 <- read_buf(old_keys_saved, 5);
        _: atom <- write_buf(tree.keys, 5, k5);
        v5: int64 <- val_at_or_new_from_buf(old_values_saved, 5, new_val_saved, key_pos_saved);
        _: atom <- write_buf(tree.values, 5, v5);
        k6: int64 <- read_buf(old_keys_saved, 6);
        _: atom <- write_buf(tree.keys, 6, k6);
        v6: int64 <- val_at_or_new_from_buf(old_values_saved, 6, new_val_saved, key_pos_saved);
        _: atom <- write_buf(tree.values, 6, v6);
        k7: int64 <- read_buf(old_keys_saved, 7);
        _: atom <- write_buf(tree.keys, 7, k7);
        v7: int64 <- val_at_or_new_from_buf(old_values_saved, 7, new_val_saved, key_pos_saved);
        _: atom <- write_buf(tree.values, 7, v7)
    produces
        pure tree
    end
}

// Build a new single-leaf map by inserting new_key/new_val at pos into existing buffers.
fn build_leaf_csr_map_insert(
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    new_key: int64,
    new_val: int64,
    old_count: int64,
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence
        keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
        values_buf_saved: buf(L1, normal, int64, 8) <- values_buf;
        new_key_saved: int64 <- new_key;
        new_val_saved: int64 <- new_val;
        old_count_saved: int64 <- old_count;
        pos: int64 <- csr_insert_pos_from_buf(keys_buf_saved, 0, old_count_saved, new_key_saved);
        new_count: int64 <- old_count_saved + 1;
        pos_saved: int64 <- pos;
        skeleton: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- build_leaf_csr_map_skeleton(new_count, source_tree);
        result: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- fill_csr_map_insert_slots(skeleton, keys_buf_saved, values_buf_saved, new_key_saved, new_val_saved, pos_saved)
    produces
        pure result
    end
}

// Build a new single-leaf map with one value replaced at key_pos (keys unchanged).
fn build_leaf_csr_map_replace(
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    key_pos: int64,
    new_val: int64,
    key_count: int64,
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence
        keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
        values_buf_saved: buf(L1, normal, int64, 8) <- values_buf;
        new_val_saved: int64 <- new_val;
        key_pos_saved: int64 <- key_pos;
        key_count_saved: int64 <- key_count;
        skeleton: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- build_leaf_csr_map_skeleton(key_count_saved, source_tree);
        result: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- fill_csr_map_replace_slots(skeleton, keys_buf_saved, values_buf_saved, key_pos_saved, new_val_saved)
    produces
        pure result
    end
}

// ── Leaf-builder ─────────────────────────────────────────────────────────────

// Allocate a fresh single-leaf CsrBTreeMap skeleton with key_count keys k0..k6.
// Values buffer is allocated but left empty; call fill_csr_map_values next.
// Split from the original build_leaf_csr_map (which had 15 params > AArch64 limit of 8).
fn build_leaf_csr_keys(
    k0: int64,
    k1: int64,
    k2: int64,
    k3: int64,
    k4: int64,
    k5: int64,
    k6: int64,
    key_count: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        nks: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nkc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncs: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nil_buf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nk: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nv: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nc: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(nks, 0, 0);
        _: atom <- write_buf(nkc, 0, key_count);
        _: atom <- write_buf(ncs, 0, 0);
        _: atom <- write_buf(ncc, 0, 0);
        _: atom <- write_buf(nil_buf, 0, 1);
        _: atom <- write_buf(nk, 0, k0);
        _: atom <- write_buf(nk, 1, k1);
        _: atom <- write_buf(nk, 2, k2);
        _: atom <- write_buf(nk, 3, k3);
        _: atom <- write_buf(nk, 4, k4);
        _: atom <- write_buf(nk, 5, k5);
        _: atom <- write_buf(nk, 6, k6);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: 0,
            node_count: 1,
            key_count_total: key_count,
            order: order(),
            node_key_start: nks,
            node_key_count: nkc,
            node_child_start: ncs,
            node_child_count: ncc,
            node_is_leaf: nil_buf,
            keys: nk,
            values: nv,
            children: nc,
            compare_key: compare_int64_atom,
            compare_value: compare_int64_atom
        }
    produces
        pure tree
    end
}

// Fill the values buffer of a tree returned by build_leaf_csr_keys.
// Returns the same tree (struct fields unchanged; values buffer updated in-place).
fn fill_csr_map_values(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    v0: int64,
    v1: int64,
    v2: int64,
    v3: int64,
    v4: int64,
    v5: int64,
    v6: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        _: atom <- write_buf(tree.values, 0, v0);
        _: atom <- write_buf(tree.values, 1, v1);
        _: atom <- write_buf(tree.values, 2, v2);
        _: atom <- write_buf(tree.values, 3, v3);
        _: atom <- write_buf(tree.values, 4, v4);
        _: atom <- write_buf(tree.values, 5, v5);
        _: atom <- write_buf(tree.values, 6, v6)
    produces
        pure tree
    end
}

// ── Replace-value path ───────────────────────────────────────────────────────

// Key exists at key_pos; create a new map with the value at that position
// replaced by new_val. Key order is unchanged. Returns inserted=0, replaced=1.
fn replace_val_csr_map(
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    key_pos: int64,
    new_val: int64,
    old_count: int64,
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    inserted: int64,
    replaced: int64
} {
    sequence
        keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
        values_buf_saved: buf(L1, normal, int64, 8) <- values_buf;
        key_pos_saved: int64 <- key_pos;
        new_val_saved: int64 <- new_val;
        old_count_saved: int64 <- old_count;
        new_tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- build_leaf_csr_map_replace(keys_buf_saved, values_buf_saved, key_pos_saved, new_val_saved, old_count_saved, source_tree)
    produces
        pure { tree: new_tree, inserted: 0, replaced: 1 }
    end
}


fn build_split_csr_map_skeleton(
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        compare_key_saved: fn(int64, int64) -> :less | :equal | :greater <- source_tree.compare_key;
        compare_value_saved: fn(int64, int64) -> :less | :equal | :greater <- source_tree.compare_value;
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        nks: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nkc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncs: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nil_buf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nk: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nv: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nc: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(nks, 0, 0);
        _: atom <- write_buf(nkc, 0, 1);
        _: atom <- write_buf(ncs, 0, 0);
        _: atom <- write_buf(ncc, 0, 2);
        _: atom <- write_buf(nil_buf, 0, 0);
        _: atom <- write_buf(nks, 1, 1);
        _: atom <- write_buf(nkc, 1, 3);
        _: atom <- write_buf(ncs, 1, 0);
        _: atom <- write_buf(ncc, 1, 0);
        _: atom <- write_buf(nil_buf, 1, 1);
        _: atom <- write_buf(nks, 2, 4);
        _: atom <- write_buf(nkc, 2, 4);
        _: atom <- write_buf(ncs, 2, 0);
        _: atom <- write_buf(ncc, 2, 0);
        _: atom <- write_buf(nil_buf, 2, 1);
        _: atom <- write_buf(nc, 0, 1);
        _: atom <- write_buf(nc, 1, 2);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- {
            region: r,
            root_id: 0,
            node_count: 3,
            key_count_total: 8,
            order: order(),
            node_key_start: nks,
            node_key_count: nkc,
            node_child_start: ncs,
            node_child_count: ncc,
            node_is_leaf: nil_buf,
            keys: nk,
            values: nv,
            children: nc,
            compare_key: compare_key_saved,
            compare_value: compare_value_saved
        }
    produces
        pure tree
    end
}

fn fill_split_csr_map_insert_slots(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    old_keys: buf(L1, normal, int64, 8),
    old_values: buf(L1, normal, int64, 8),
    new_key: int64,
    new_val: int64,
    pos: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 3),
    node_key_count: buf(L1, normal, int64, 3),
    node_child_start: buf(L1, normal, int64, 3),
    node_child_count: buf(L1, normal, int64, 3),
    node_is_leaf: buf(L1, normal, int64, 3),
    keys: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    children: buf(L1, normal, int64, 2),
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        old_keys_saved: buf(L1, normal, int64, 8) <- old_keys;
        old_values_saved: buf(L1, normal, int64, 8) <- old_values;
        new_key_saved: int64 <- new_key;
        new_val_saved: int64 <- new_val;
        pos_saved: int64 <- pos;
        v0: int64 <- csr_out_key_from_buf(old_keys_saved, 0, new_key_saved, pos_saved);
        v1: int64 <- csr_out_key_from_buf(old_keys_saved, 1, new_key_saved, pos_saved);
        v2: int64 <- csr_out_key_from_buf(old_keys_saved, 2, new_key_saved, pos_saved);
        v3: int64 <- csr_out_key_from_buf(old_keys_saved, 3, new_key_saved, pos_saved);
        v4: int64 <- csr_out_key_from_buf(old_keys_saved, 4, new_key_saved, pos_saved);
        v5: int64 <- csr_out_key_from_buf(old_keys_saved, 5, new_key_saved, pos_saved);
        v6: int64 <- csr_out_key_from_buf(old_keys_saved, 6, new_key_saved, pos_saved);
        v7: int64 <- csr_out_key_from_buf(old_keys_saved, 7, new_key_saved, pos_saved);
        u0: int64 <- csr_out_value_from_buf(old_values_saved, 0, new_val_saved, pos_saved);
        u1: int64 <- csr_out_value_from_buf(old_values_saved, 1, new_val_saved, pos_saved);
        u2: int64 <- csr_out_value_from_buf(old_values_saved, 2, new_val_saved, pos_saved);
        u3: int64 <- csr_out_value_from_buf(old_values_saved, 3, new_val_saved, pos_saved);
        u4: int64 <- csr_out_value_from_buf(old_values_saved, 4, new_val_saved, pos_saved);
        u5: int64 <- csr_out_value_from_buf(old_values_saved, 5, new_val_saved, pos_saved);
        u6: int64 <- csr_out_value_from_buf(old_values_saved, 6, new_val_saved, pos_saved);
        u7: int64 <- csr_out_value_from_buf(old_values_saved, 7, new_val_saved, pos_saved);
        _: atom <- write_buf(tree.keys, 0, v3);
        _: atom <- write_buf(tree.keys, 1, v0);
        _: atom <- write_buf(tree.keys, 2, v1);
        _: atom <- write_buf(tree.keys, 3, v2);
        _: atom <- write_buf(tree.keys, 4, v4);
        _: atom <- write_buf(tree.keys, 5, v5);
        _: atom <- write_buf(tree.keys, 6, v6);
        _: atom <- write_buf(tree.keys, 7, v7);
        _: atom <- write_buf(tree.values, 0, u3);
        _: atom <- write_buf(tree.values, 1, u0);
        _: atom <- write_buf(tree.values, 2, u1);
        _: atom <- write_buf(tree.values, 3, u2);
        _: atom <- write_buf(tree.values, 4, u4);
        _: atom <- write_buf(tree.values, 5, u5);
        _: atom <- write_buf(tree.values, 6, u6);
        _: atom <- write_buf(tree.values, 7, u7)
    produces
        pure tree
    end
}

fn build_split_csr_map_from_insert(
    keys_buf: buf(L1, normal, int64, 8),
    values_buf: buf(L1, normal, int64, 8),
    new_key: int64,
    new_val: int64,
    pos: int64,
    source_tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    }
) -> {
region: region(L1, normal),
root_id: int64,
node_count: int64,
key_count_total: int64,
order: int64,
node_key_start: buf(L1, normal, int64, 3),
node_key_count: buf(L1, normal, int64, 3),
node_child_start: buf(L1, normal, int64, 3),
node_child_count: buf(L1, normal, int64, 3),
node_is_leaf: buf(L1, normal, int64, 3),
keys: buf(L1, normal, int64, 8),
values: buf(L1, normal, int64, 8),
children: buf(L1, normal, int64, 2),
compare_key: fn(int64, int64) -> :less | :equal | :greater,
compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence
        keys_buf_saved: buf(L1, normal, int64, 8) <- keys_buf;
        values_buf_saved: buf(L1, normal, int64, 8) <- values_buf;
        new_key_saved: int64 <- new_key;
        new_val_saved: int64 <- new_val;
        pos_saved: int64 <- pos;
        skeleton: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- build_split_csr_map_skeleton(source_tree);
        result: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 3),
            node_key_count: buf(L1, normal, int64, 3),
            node_child_start: buf(L1, normal, int64, 3),
            node_child_count: buf(L1, normal, int64, 3),
            node_is_leaf: buf(L1, normal, int64, 3),
            keys: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8),
            children: buf(L1, normal, int64, 2),
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater
        } <- fill_split_csr_map_insert_slots(skeleton, keys_buf_saved, values_buf_saved, new_key_saved, new_val_saved, pos_saved)
    produces
        pure result
    end
}

fn copy_split_csr_map_replace_value(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    abs_index: int64,
    new_val: int64
) -> {
region: region(L1, normal),
root_id: int64,
node_count: int64,
key_count_total: int64,
order: int64,
node_key_start: buf(L1, normal, int64, 3),
node_key_count: buf(L1, normal, int64, 3),
node_child_start: buf(L1, normal, int64, 3),
node_child_count: buf(L1, normal, int64, 3),
node_is_leaf: buf(L1, normal, int64, 3),
keys: buf(L1, normal, int64, 8),
values: buf(L1, normal, int64, 8),
children: buf(L1, normal, int64, 2),
compare_key: fn(int64, int64) -> :less | :equal | :greater,
compare_value: fn(int64, int64) -> :less | :equal | :greater
} {
    sequence proc[mem(normal)]
        abs_saved: int64 <- abs_index;
        new_val_saved: int64 <- new_val;
        compare_key_saved: fn(int64, int64) -> :less | :equal | :greater <- tree.compare_key;
        compare_value_saved: fn(int64, int64) -> :less | :equal | :greater <- tree.compare_value;
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        nks: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nkc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncs: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        ncc: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nil_buf: buf(L1, normal, int64, 3) <- alloc_buf(r, 3);
        nk: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nv: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        nc: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(nks, 0, read_buf(tree.node_key_start, 0));
        _: atom <- write_buf(nkc, 0, read_buf(tree.node_key_count, 0));
        _: atom <- write_buf(ncs, 0, read_buf(tree.node_child_start, 0));
        _: atom <- write_buf(ncc, 0, read_buf(tree.node_child_count, 0));
        _: atom <- write_buf(nil_buf, 0, read_buf(tree.node_is_leaf, 0));
        _: atom <- write_buf(nks, 1, read_buf(tree.node_key_start, 1));
        _: atom <- write_buf(nkc, 1, read_buf(tree.node_key_count, 1));
        _: atom <- write_buf(ncs, 1, read_buf(tree.node_child_start, 1));
        _: atom <- write_buf(ncc, 1, read_buf(tree.node_child_count, 1));
        _: atom <- write_buf(nil_buf, 1, read_buf(tree.node_is_leaf, 1));
        _: atom <- write_buf(nks, 2, read_buf(tree.node_key_start, 2));
        _: atom <- write_buf(nkc, 2, read_buf(tree.node_key_count, 2));
        _: atom <- write_buf(ncs, 2, read_buf(tree.node_child_start, 2));
        _: atom <- write_buf(ncc, 2, read_buf(tree.node_child_count, 2));
        _: atom <- write_buf(nil_buf, 2, read_buf(tree.node_is_leaf, 2));
        _: atom <- write_buf(nk, 0, read_buf(tree.keys, 0));
        _: atom <- write_buf(nk, 1, read_buf(tree.keys, 1));
        _: atom <- write_buf(nk, 2, read_buf(tree.keys, 2));
        _: atom <- write_buf(nk, 3, read_buf(tree.keys, 3));
        _: atom <- write_buf(nk, 4, read_buf(tree.keys, 4));
        _: atom <- write_buf(nk, 5, read_buf(tree.keys, 5));
        _: atom <- write_buf(nk, 6, read_buf(tree.keys, 6));
        _: atom <- write_buf(nk, 7, read_buf(tree.keys, 7));
        _: atom <- write_buf(nc, 0, read_buf(tree.children, 0));
        _: atom <- write_buf(nc, 1, read_buf(tree.children, 1));
        out0: int64 <- case abs_saved of { 0 -> new_val_saved; _: int64 -> read_buf(tree.values, 0) };
        _: atom <- write_buf(nv, 0, out0);
        out1: int64 <- case abs_saved of { 1 -> new_val_saved; _: int64 -> read_buf(tree.values, 1) };
        _: atom <- write_buf(nv, 1, out1);
        out2: int64 <- case abs_saved of { 2 -> new_val_saved; _: int64 -> read_buf(tree.values, 2) };
        _: atom <- write_buf(nv, 2, out2);
        out3: int64 <- case abs_saved of { 3 -> new_val_saved; _: int64 -> read_buf(tree.values, 3) };
        _: atom <- write_buf(nv, 3, out3);
        out4: int64 <- case abs_saved of { 4 -> new_val_saved; _: int64 -> read_buf(tree.values, 4) };
        _: atom <- write_buf(nv, 4, out4);
        out5: int64 <- case abs_saved of { 5 -> new_val_saved; _: int64 -> read_buf(tree.values, 5) };
        _: atom <- write_buf(nv, 5, out5);
        out6: int64 <- case abs_saved of { 6 -> new_val_saved; _: int64 -> read_buf(tree.values, 6) };
        _: atom <- write_buf(nv, 6, out6);
        out7: int64 <- case abs_saved of { 7 -> new_val_saved; _: int64 -> read_buf(tree.values, 7) };
        _: atom <- write_buf(nv, 7, out7);
        result: {
region: region(L1, normal),
root_id: int64,
node_count: int64,
key_count_total: int64,
order: int64,
node_key_start: buf(L1, normal, int64, 3),
node_key_count: buf(L1, normal, int64, 3),
node_child_start: buf(L1, normal, int64, 3),
node_child_count: buf(L1, normal, int64, 3),
node_is_leaf: buf(L1, normal, int64, 3),
keys: buf(L1, normal, int64, 8),
values: buf(L1, normal, int64, 8),
children: buf(L1, normal, int64, 2),
compare_key: fn(int64, int64) -> :less | :equal | :greater,
compare_value: fn(int64, int64) -> :less | :equal | :greater
} <- {
            region: r,
            root_id: tree.root_id,
            node_count: tree.node_count,
            key_count_total: tree.key_count_total,
            order: tree.order,
            node_key_start: nks,
            node_key_count: nkc,
            node_child_start: ncs,
            node_child_count: ncc,
            node_is_leaf: nil_buf,
            keys: nk,
            values: nv,
            children: nc,
            compare_key: compare_key_saved,
            compare_value: compare_value_saved
        }
    produces
        pure result
    end
}

fn insert_split_leaf_csr_map(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 3),
        node_key_count: buf(L1, normal, int64, 3),
        node_child_start: buf(L1, normal, int64, 3),
        node_child_count: buf(L1, normal, int64, 3),
        node_is_leaf: buf(L1, normal, int64, 3),
        keys: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8),
        children: buf(L1, normal, int64, 2),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64,
    value: int64,
    old_count: int64
) -> {
    tree: {
region: region(L1, normal),
root_id: int64,
node_count: int64,
key_count_total: int64,
order: int64,
node_key_start: buf(L1, normal, int64, 3),
node_key_count: buf(L1, normal, int64, 3),
node_child_start: buf(L1, normal, int64, 3),
node_child_count: buf(L1, normal, int64, 3),
node_is_leaf: buf(L1, normal, int64, 3),
keys: buf(L1, normal, int64, 8),
values: buf(L1, normal, int64, 8),
children: buf(L1, normal, int64, 2),
compare_key: fn(int64, int64) -> :less | :equal | :greater,
compare_value: fn(int64, int64) -> :less | :equal | :greater
},
    inserted: int64,
    replaced: int64
} {
    sequence
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        old_count_saved: int64 <- old_count;
        keys_saved: buf(L1, normal, int64, 8) <- tree.keys;
        values_saved: buf(L1, normal, int64, 8) <- tree.values;
        pos: int64 <- csr_insert_pos_from_buf(keys_saved, 0, old_count_saved, key_saved);
        new_tree: {
region: region(L1, normal),
root_id: int64,
node_count: int64,
key_count_total: int64,
order: int64,
node_key_start: buf(L1, normal, int64, 3),
node_key_count: buf(L1, normal, int64, 3),
node_child_start: buf(L1, normal, int64, 3),
node_child_count: buf(L1, normal, int64, 3),
node_is_leaf: buf(L1, normal, int64, 3),
keys: buf(L1, normal, int64, 8),
values: buf(L1, normal, int64, 8),
children: buf(L1, normal, int64, 2),
compare_key: fn(int64, int64) -> :less | :equal | :greater,
compare_value: fn(int64, int64) -> :less | :equal | :greater
} <- build_split_csr_map_from_insert(keys_saved, values_saved, key_saved, value_saved, pos, tree)
    produces
        pure { tree: new_tree, inserted: 1, replaced: 0 }
    end
}

