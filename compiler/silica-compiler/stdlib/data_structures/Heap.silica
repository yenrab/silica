export trait Heap;
export peek/1;
export len/1;
export compare_priority/3;

required {
    fn peek(heap: Heap) -> int64;
    fn len(heap: Heap) -> int64;
    fn compare_priority(heap: Heap, left: ItemType, right: ItemType) -> :less | :equal | :greater;
}

impl fn compare_priority(
    heap: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- heap.compare_priority;
    cmp(left, right)
}

impl fn peek(heap: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 }) -> int64 {
    heap.top_item
}

impl fn len(heap: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 }) -> int64 {
    heap.item_count
}

fn heap_read_value(values: buf(L1, normal, int64, 8), index: int64) -> int64 {
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    sequence proc[mem(normal)]
        value: int64 <- read_buf(values_saved, index_saved)
    produces
        pure value
    end
}

impl fn compare_priority(
    heap: {
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        values: buf(L1, normal, int64, 8),
        compare_item: fn(int64, int64) -> :less | :equal | :greater
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- heap.compare_item;
    cmp(left, right)
}

impl fn peek(heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8),
    compare_item: fn(int64, int64) -> :less | :equal | :greater
}) -> int64 {
    case heap.len of {
        0 -> 0;
        _: int64 -> {
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            heap_read_value(values_saved, 0)
        }
    }
}

impl fn len(heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8),
    compare_item: fn(int64, int64) -> :less | :equal | :greater
}) -> int64 {
    heap.len
}

impl fn compare_priority(
    heap: {
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        arity: int64,
        values: buf(L1, normal, int64, 8)
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- heap.compare_item;
    cmp(left, right)
}

impl fn peek(heap: {
    compare_item: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    arity: int64,
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    case heap.len of {
        0 -> 0;
        _: int64 -> {
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            heap_read_value(values_saved, 0)
        }
    }
}

impl fn len(heap: {
    compare_item: fn(int64, int64) -> :less | :equal | :greater,
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    arity: int64,
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    heap.len
}
