/// Supervisor trait for actor supervision and failure handling
///
/// A supervisor is responsible for monitoring other actors and handling their
/// termination. Supervisors spawn and manage child actors according to the
/// specification returned by the init function.

trait supervisor {
  /// Start and link the supervisor actor
  ///
  /// Starts a new supervisor actor and links it to the calling process.
  /// Returns the supervisor's actor reference.
  fn start_link() -> atom

  /// Initialize the supervisor and spawn child actors
  ///
  /// Called when the supervisor starts. This function spawns the supervised
  /// child actors and returns the supervisor specification that defines how
  /// those children should be managed.
  fn init() -> atom
}
