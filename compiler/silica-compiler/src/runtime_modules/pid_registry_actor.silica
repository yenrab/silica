// Global PID registry actor: wraps a pid_register_runtime association list as actor state.
//
// All record types are structural and written inline per §3.4.2 (no struct/type declarations).
//
// State type : List[{ name: atom, pid: actor_ref }, mem(normal)]
// Message type: { op: atom, name: atom, pid: actor_ref }
//   op == :insert  — add or update (name -> pid)
//   op == :lookup  — find name; reply (:found, ref) or (:not_found, dummy_ref)
//   op == :delete  — remove name from the list
//
// Reply type: (atom, actor_ref) for all operations.
//
// Startup: the emitter injects `BL _silica_pid_registry_init` at the start of every
// `main` that uses the actor runtime.  That stub calls init_pid_registry_get_ref here
// and stores the actor_ref in the runtime-global slot accessed by get_pid_registry().

use pid_register_runtime;

export registry_beh/2;
export init_pid_registry_get_ref/0;
export get_pid_registry/0;

fn registry_beh(msg: { op: atom, name: atom, pid: actor_ref }, state: List[{ name: atom, pid: actor_ref }, mem(normal)]) -> (:reply, (atom, actor_ref), List[{ name: atom, pid: actor_ref }, mem(normal)]) {
    sequence proc[concurrency, mem(normal)]
        result: (:reply, (atom, actor_ref), List[{ name: atom, pid: actor_ref }, mem(normal)]) <- case msg.op of {
            :insert -> do
                new_reg: List[{ name: atom, pid: actor_ref }, mem(normal)] <- pid_register_runtime@pid_reg_insert(state, msg.name, msg.pid);
                (:reply, (:ok, msg.pid), new_reg)
            end;
            :lookup -> do
                found: (atom, actor_ref) <- pid_register_runtime@pid_reg_lookup(state, msg.name);
                (:reply, found, state)
            end;
            :delete -> do
                new_reg: List[{ name: atom, pid: actor_ref }, mem(normal)] <- pid_register_runtime@pid_reg_delete(state, msg.name);
                (:reply, (:ok, msg.pid), new_reg)
            end;
            _: atom -> (:reply, (:unknown_op, msg.pid), state)
        }
    produces
        pure result
    end
}

// Spawns the registry actor with an empty association list as initial state.
// Called from the assembly stub _silica_pid_registry_init (injected by emitter into main).
// Returns the actor_ref so the stub can store it in _silica_pid_registry_ref.
fn init_pid_registry_get_ref() -> actor_ref {
    sequence proc[concurrency, mem(normal)]
        initial: List[{ name: atom, pid: actor_ref }, mem(normal)] <- pid_register_runtime@empty_reg();
        reg: actor_ref <- spawn(initial, registry_beh)
    produces
        pure reg
    end
}

// Retrieves the global registry actor_ref stored at program start.
// Use: call(get_pid_registry(), { op: :lookup, name: :my_svc, pid: dummy } impl ActorMessage {})
fn get_pid_registry() -> actor_ref {
    sequence proc[concurrency]
        ref: actor_ref <- get_registry_actor()
    produces
        pure ref
    end
}
