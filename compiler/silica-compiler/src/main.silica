// Main entry point for Phase 2 compiler
// Reads file list from silica.config, resolves dependencies, compiles each file in order

use lexer_runner;
use lexer_core;
use lexer_token_kind;
use parser_core;
use parser_runner;
use parser_ast;
use type_checker_core;
use type_checker_modules;
use effect_checker_core;
use effect_checker_capabilities;
use sir_generator_core;
use sir_ast;
use emitter_core;
use atom_table;
use build_output;
use diagnostics_core;
use module_checker_core;
use trait_checker_core;
use trait_specialization;
use qualified_call_mangler;
use ffi_sidecar_loader;
use ffi_placement_checker;
use ffi_taint_checker;
use ffi_abi_checker;
use ffi_link_manifest;

// --- Memory hygiene (multi-unit silica.config) --------------------------------
// Host allocations are not reclaimed when locals drop. Cut retained work between units:
//   * module world = transitive `use` closure only (not every config AST)
//   * specialize lazily into a process cache (once per module; never re-specialize)
//   * pass only the current unit's specialize slice into mangling
//   * write __silica_runtime.sams once at end of the batch
//   * process-scoped free: compile one topo unit per process, persist remaining paths in
//     silica.compile.order, exit 75 (EX_TEMPFAIL) so the Makefile re-invokes and the OS
//     reclaims the heap (required for large units such as wbt_map after a fat parse)

fn compile_order_path() -> string { "silica.compile.order" }
fn needs_runtime_marker_path() -> string { "silica.needs_runtime" }
fn continue_exit_code() -> int64 { 75 }

fn list_string_contains_hygiene(lst: ListString, s: string) -> bool {
    case lst.is_nil of {
        true -> false;
        false -> case lst.head == s of {
            true -> true;
            false -> list_string_contains_hygiene(lst.tail, s)
        }
    }
}

fn list_string_cons_unique(s: string, lst: ListString) -> ListString {
    case list_string_contains_hygiene(lst, s) of {
        true -> lst;
        false -> module_checker_core@cons_string(s, lst)
    }
}

fn append_list_string_hygiene(a: ListString, b: ListString) -> ListString {
    case a.is_nil of {
        true -> b;
        false -> module_checker_core@cons_string(a.head, append_list_string_hygiene(a.tail, b))
    }
}

fn find_parsed_path_for_module(mod_name: string, parsed: ListParsedFile) -> string {
    case parsed.is_nil of {
        true -> "";
        false -> case module_checker_core@module_from_path(parsed.head.path) == mod_name of {
            true -> parsed.head.path;
            false -> find_parsed_path_for_module(mod_name, parsed.tail)
        }
    }
}

fn transitive_use_names_work(work: ListString, parsed: ListParsedFile, acc: ListString) -> ListString {
    case work.is_nil of {
        true -> acc;
        false -> case list_string_contains_hygiene(acc, work.head) of {
            true -> transitive_use_names_work(work.tail, parsed, acc);
            false -> do
                path: string <- find_parsed_path_for_module(work.head, parsed);
                case len(path) == 0 of {
                    true -> transitive_use_names_work(work.tail, parsed, list_string_cons_unique(work.head, acc));
                    false -> do
                        (found: bool, prog: Program) <- module_checker_core@find_program_in_parsed(parsed, path);
                        direct: ListString <- case found of {
                            true -> extract_use_modules_from_program(prog);
                            false -> module_checker_core@empty_list_string()
                        };
                        with_name: ListString <- list_string_cons_unique(work.head, acc);
                        transitive_use_names_work(append_list_string_hygiene(direct, work.tail), parsed, with_name)
                    end
                }
            end
        }
    }
}

fn transitive_use_names_for_program(program: Program, parsed: ListParsedFile) -> ListString {
    transitive_use_names_work(extract_use_modules_from_program(program), parsed, module_checker_core@empty_list_string())
}

fn build_module_world_named(all: ListParsedFile, exclude_path: string, names: ListString) -> ListNamedProgram {
    case all.is_nil of {
        true -> type_checker_modules@empty_named_program_list();
        false -> case all.head.path == exclude_path of {
            true -> build_module_world_named(all.tail, exclude_path, names);
            false -> do
                mod_name: string <- module_checker_core@module_from_path(all.head.path);
                case list_string_contains_hygiene(names, mod_name) of {
                    true -> type_checker_modules@cons_named_program(
                        mod_name,
                        all.head.program,
                        build_module_world_named(all.tail, exclude_path, names)
                    );
                    false -> build_module_world_named(all.tail, exclude_path, names)
                }
            end
        }
    }
}

fn build_module_world_full(all: ListParsedFile, exclude_path: string) -> ListNamedProgram {
    case all.is_nil of {
        true -> type_checker_modules@empty_named_program_list();
        false -> case all.head.path == exclude_path of {
            true -> build_module_world_full(all.tail, exclude_path);
            false -> type_checker_modules@cons_named_program(
                module_checker_core@module_from_path(all.head.path),
                all.head.program,
                build_module_world_full(all.tail, exclude_path)
            )
        }
    }
}

fn build_module_world(all: ListParsedFile, exclude_path: string) -> ListNamedProgram {
    (found: bool, prog: Program) <- module_checker_core@find_program_in_parsed(all, exclude_path);
    case found of {
        false -> build_module_world_full(all, exclude_path);
        true -> do
            names: ListString <- transitive_use_names_for_program(prog, all);
            case names.is_nil of {
                true -> type_checker_modules@empty_named_program_list();
                false -> build_module_world_named(all, exclude_path, names)
            }
        end
    }
}

// Eager specialize of every config module — only for single-file / legacy callers.
fn specialize_all_parsed(parsed: ListParsedFile) -> ListNamedProgram {
    case parsed.is_nil of {
        true -> type_checker_modules@empty_named_program_list();
        false -> type_checker_modules@cons_named_program(
            module_checker_core@module_from_path(parsed.head.path),
            trait_specialization@specialize_program(parsed.head.program),
            specialize_all_parsed(parsed.tail)
        )
    }
}

fn ensure_specialized_module(mod_name: string, program: Program, cache: ListNamedProgram) -> (Program, ListNamedProgram) {
    (found: bool, prog: Program) <- parser_ast@find_named_program(mod_name, cache);
    case found of {
        true -> (prog, cache);
        false -> do
            specialized: Program <- trait_specialization@specialize_program(program);
            (specialized, type_checker_modules@cons_named_program(mod_name, specialized, cache))
        end
    }
}

fn ensure_specialized_path(path: string, parsed: ListParsedFile, cache: ListNamedProgram) -> ListNamedProgram {
    (found: bool, prog: Program) <- module_checker_core@find_program_in_parsed(parsed, path);
    case found of {
        false -> cache;
        true -> do
            mod_name: string <- module_checker_core@module_from_path(path);
            (_p: Program, next: ListNamedProgram) <- ensure_specialized_module(mod_name, prog, cache);
            next
        end
    }
}

fn ensure_specialized_names(names: ListString, parsed: ListParsedFile, cache: ListNamedProgram) -> ListNamedProgram {
    case names.is_nil of {
        true -> cache;
        false -> do
            path: string <- find_parsed_path_for_module(names.head, parsed);
            case len(path) == 0 of {
                true -> ensure_specialized_names(names.tail, parsed, cache);
                false -> ensure_specialized_names(names.tail, parsed, ensure_specialized_path(path, parsed, cache))
            }
        end
    }
}

fn filter_specialized_to_names(cache: ListNamedProgram, names: ListString) -> ListNamedProgram {
    case cache.is_nil of {
        true -> type_checker_modules@empty_named_program_list();
        false -> case list_string_contains_hygiene(names, cache.head.module_name) of {
            true -> type_checker_modules@cons_named_program(
                cache.head.module_name,
                cache.head.program,
                filter_specialized_to_names(cache.tail, names)
            );
            false -> filter_specialized_to_names(cache.tail, names)
        }
    }
}

fn union_use_names_for_paths(paths: ListString, parsed: ListParsedFile, acc: ListString) -> ListString {
    case paths.is_nil of {
        true -> acc;
        false -> do
            (found: bool, prog: Program) <- module_checker_core@find_program_in_parsed(parsed, paths.head);
            case found of {
                false -> union_use_names_for_paths(paths.tail, parsed, acc);
                true -> do
                    mod_name: string <- module_checker_core@module_from_path(paths.head);
                    with_self: ListString <- list_string_cons_unique(mod_name, acc);
                    uses: ListString <- transitive_use_names_for_program(prog, parsed);
                    merged: ListString <- append_list_string_hygiene(uses, with_self);
                    union_use_names_for_paths(paths.tail, parsed, merged)
                end
            }
        end
    }
}

fn trim_specialized_cache(cache: ListNamedProgram, remaining_paths: ListString, parsed: ListParsedFile) -> ListNamedProgram {
    needed: ListString <- union_use_names_for_paths(remaining_paths, parsed, module_checker_core@empty_list_string());
    filter_specialized_to_names(cache, needed)
}

fn specialized_program_for_module(mod_name: string, program: Program, specialized_all: ListNamedProgram) -> Program {
    (found: bool, prog: Program) <- parser_ast@find_named_program(mod_name, specialized_all);
    case found of {
        true -> prog;
        false -> trait_specialization@specialize_program(program)
    }
}

fn maybe_write_runtime_assembly(any_needs_runtime: bool) -> int64 proc[DeviceIO] {
    case any_needs_runtime of {
        // Incremental / process-per-unit reclaim path: still must seed the fixed
        // actor-runtime atom prefix (:insert/:lookup/:delete/…). An empty table
        // embeds cmp #-1 in __silica_runtime.sams and deadlocks pid-registry init.
        true -> do
            (seeded: AtomTable, _: int64) <- atom_table@seed_actor_runtime_atoms();
            build_output@write_runtime_assembly(emitter_core@emit_actor_runtime_module_with_atom_table(seeded))
        end;
        false -> 0
    }
}

fn write_paths_file_rec(path: string, paths: ListString) -> int64 proc[DeviceIO] {
    case paths.is_nil of {
        true -> 0;
        false -> do
            _: bool <- append_file(path, concat(paths.head, "\n"));
            write_paths_file_rec(path, paths.tail)
        end
    }
}

fn write_paths_file(path: string, paths: ListString) -> int64 proc[DeviceIO] {
    delete_file(path);
    write_paths_file_rec(path, paths)
}

fn mark_needs_runtime_if(needs: bool) -> int64 proc[DeviceIO] {
    case needs of {
        false -> 0;
        true -> do
            _: bool <- append_file(needs_runtime_marker_path(), "1\n");
            0
        end
    }
}

// Link manifest is written once on the initial full-parse process. Final process only emits runtime.
fn finish_batch_artifacts() -> int64 proc[DeviceIO] {
    needs_rt: bool <- file_exists(needs_runtime_marker_path());
    _: int64 <- maybe_write_runtime_assembly(needs_rt);
    delete_file(compile_order_path());
    delete_file(needs_runtime_marker_path());
    println("Compilation complete.");
    0
}

// In-process multi-unit path (matches error-enforcement goldens): parse once, compile all units,
// then write/validate the link manifest so E4034 lands after Finished compiling.
fn compile_all_parsed(sorted_files: ListString, parsed_all: ListParsedFile, all_config_files: ListString) -> int64 proc[DeviceIO] {
    case sorted_files.is_nil of {
        true -> do
            println("Compilation complete.");
            0
        end;
        false -> do
            compile_code: int64 <- compile_parsed_list(sorted_files, parsed_all, all_config_files);
            case compile_code != 0 of {
                true -> compile_code;
                false -> do
                    // Archive/manifest diagnostics (e.g. E4034) print here; goldens still expect
                    // the trailing "Compilation complete." line after those errors.
                    link_st: int64 <- ffi_link_manifest@write_link_manifest_for_parsed(parsed_all);
                    println("Compilation complete.");
                    link_st
                end
            }
        end
    }
}

// Large batches (e.g. src_selfhost) still use process-per-unit reclaim; small batches stay in-process
// so compiler stdout matches historical .golden_fail captures.
fn use_process_per_unit(sorted_files: ListString) -> bool {
    list_string_length(sorted_files) > 32
}

fn parsed_contains_path(parsed: ListParsedFile, path: string) -> bool {
    case parsed.is_nil of {
        true -> false;
        false -> case parsed.head.path == path of {
            true -> true;
            false -> parsed_contains_path(parsed.tail, path)
        }
    }
}

fn path_for_module_in_config(mod_name: string, config: ListString) -> string {
    case config.is_nil of {
        true -> "";
        false -> case module_checker_core@module_from_path(config.head) == mod_name of {
            true -> config.head;
            false -> path_for_module_in_config(mod_name, config.tail)
        }
    }
}

fn resolve_use_names_to_config_paths(uses: ListString, config: ListString, acc: ListString) -> ListString {
    case uses.is_nil of {
        true -> acc;
        false -> do
            p: string <- path_for_module_in_config(uses.head, config);
            next_acc: ListString <- case len(p) == 0 of {
                true -> acc;
                false -> list_string_cons_unique(p, acc)
            };
            resolve_use_names_to_config_paths(uses.tail, config, next_acc)
        end
    }
}

// Parse `work` paths and every transitive `use` target found in config (not the whole batch).
fn parse_use_closure_work(work: ListString, config: ListString, acc: ListParsedFile) -> (bool, ListParsedFile) proc[DeviceIO] {
    case work.is_nil of {
        true -> (true, reverse_parsed_files(acc, empty_parsed_files()));
        false -> case parsed_contains_path(acc, work.head) of {
            true -> parse_use_closure_work(work.tail, config, acc);
            false -> do
                println("Parsing ");
                print(work.head);
                println("...");
                println("  Lexing...");
                tokens: ListToken <- lexer_runner@lexer_runner(work.head);
                println("  Parsing...");
                parse_result: ParseResult <- parser_runner@parse_program(tokens);
                case parse_result.is_ok of {
                    false -> do
                        error_code: string <- case parse_result.error_code == "" of {
                            true -> "E1001";
                            false -> parse_result.error_code
                        };
                        spec_section: string <- case parse_result.spec_section == "" of {
                            true -> "sect3";
                            false -> parse_result.spec_section
                        };
                        diagnostics_core@print_compiler_error("ParseError", error_code, parse_result.error_location, parse_result.error_message, spec_section);
                        (false, empty_parsed_files())
                    end;
                    true -> do
                        uses: ListString <- extract_use_modules_from_program(parse_result.program);
                        use_paths: ListString <- resolve_use_names_to_config_paths(uses, config, module_checker_core@empty_list_string());
                        next_work: ListString <- append_list_string_hygiene(use_paths, work.tail);
                        parse_use_closure_work(next_work, config, cons_parsed_file(work.head, parse_result.program, acc))
                    end
                }
            end
        }
    }
}

fn compile_one_sorted_unit(path: string, parsed: ListParsedFile, all_config_files: ListString) -> (int64, bool) proc[DeviceIO] {
    (found: bool, prog: Program) <- module_checker_core@find_program_in_parsed(parsed, path);
    case found of {
        false -> do
            println("Error: internal parse table missing file");
            print(path);
            (1, false)
        end;
        true -> do
            mod_name: string <- module_checker_core@module_from_path(path);
            use_names: ListString <- transitive_use_names_for_program(prog, parsed);
            empty_cache: ListNamedProgram <- type_checker_modules@empty_named_program_list();
            cache_uses: ListNamedProgram <- ensure_specialized_names(use_names, parsed, empty_cache);
            cache_self: ListNamedProgram <- ensure_specialized_path(path, parsed, cache_uses);
            world: ListNamedProgram <- build_module_world(parsed, path);
            mangle_names: ListString <- list_string_cons_unique(mod_name, use_names);
            specialized_for_unit: ListNamedProgram <- filter_specialized_to_names(cache_self, mangle_names);
            compile_parsed_unit(path, prog, world, all_config_files, parsed, specialized_for_unit)
        end
    }
}

fn parse_all_files_recursive(files: ListString, acc: ListParsedFile) -> (bool, ListParsedFile) proc[DeviceIO] {
    case files.is_nil of {
        true -> (true, reverse_parsed_files(acc, empty_parsed_files()));
        false -> do
            println("Parsing ");
            print(files.head);
            println("...");
            println("  Lexing...");
            tokens: ListToken <- lexer_runner@lexer_runner(files.head);
            println("  Parsing...");
            parse_result: ParseResult <- parser_runner@parse_program(tokens);
            case parse_result.is_ok of {
                false -> do
                    error_code: string <- case parse_result.error_code == "" of {
                        true -> "E1001";
                        false -> parse_result.error_code
                    };
                    spec_section: string <- case parse_result.spec_section == "" of {
                        true -> "sect3";
                        false -> parse_result.spec_section
                    };
                    diagnostics_core@print_compiler_error("ParseError", error_code, parse_result.error_location, parse_result.error_message, spec_section);
                    (false, empty_parsed_files())
                end;
                true -> parse_all_files_recursive(files.tail, cons_parsed_file(files.head, parse_result.program, acc))
            }
        end
    }
}

fn list_string_length(lst: ListString) -> int64 {
    case lst.is_nil of {
        true -> 0;
        false -> 1 + list_string_length(lst.tail)
    }
}

// Parse config: split by newlines, skip empty and # lines, return list (order preserved)
fn parse_config_lines(content: string, start: int64, acc: ListString) -> ListString proc[DeviceIO] {
    case start >= len(content) of {
        true -> acc;
        false -> do
            line: string <- substring_until_char(content, start, '\n');
            line_len: int64 <- len(line);
            next_start: int64 <- start + line_len + 1;
            trimmed: string <- trim_leading(line);
            is_comment: bool <- starts_with(trimmed, "#");
            is_empty: bool <- len(trimmed) == 0;
            new_acc: ListString <- case is_comment of {
                true -> acc;
                false -> case is_empty of {
                    true -> acc;
                    false -> cons_string(trimmed, acc)
                }
            };
            parse_config_lines(content, next_start, new_acc)
        end
    }
}

fn trim_leading(s: string) -> string {
    trim_leading_from(s, 0)
}

fn trim_leading_from(s: string, pos: int64) -> string {
    case pos >= len(s) of {
        true -> "";
        false -> case is_whitespace_at(s, pos) of {
            true -> trim_leading_from(s, pos + 1);
            false -> substring(s, pos, len(s))
        }
    }
}

fn is_whitespace_at(s: string, pos: int64) -> bool {
    c: string <- substring(s, pos, pos + 1);
    c == " " or c == "\t" or c == "\n" or c == "\r"
}

fn trim_trailing(s: string) -> string {
    trim_trailing_from(s, len(s) - 1)
}

fn trim_trailing_from(s: string, pos: int64) -> string {
    case pos < 0 of {
        true -> "";
        false -> case is_whitespace_at(s, pos) of {
            true -> trim_trailing_from(s, pos - 1);
            false -> substring(s, 0, pos + 1)
        }
    }
}

// Reverse a ListString (since we cons in reverse order during parse)
fn reverse_list_string(lst: ListString) -> ListString {
    reverse_list_string_acc(lst, empty_list_string())
}

fn reverse_list_string_acc(lst: ListString, acc: ListString) -> ListString {
    case lst.is_nil of {
        true -> acc;
        false -> reverse_list_string_acc(lst.tail, cons_string(lst.head, acc))
    }
}

// Check if list contains string (exact match)
fn list_contains(lst: ListString, s: string) -> bool {
    case lst.is_nil of {
        true -> false;
        false -> case lst.head == s of {
            true -> true;
            false -> list_contains(lst.tail, s)
        }
    }
}

// Get file path for module from our file list (module name -> path)
fn path_for_module(files: ListString, mod_name: string) -> string {
    case files.is_nil of {
        true -> "";
        false -> case module_checker_core@module_from_path(files.head) == mod_name of {
            true -> files.head;
            false -> path_for_module(files.tail, mod_name)
        }
    }
}

fn resolve_deps_to_paths(modules: ListString, files: ListString, acc: ListString) -> ListString {
    case modules.is_nil of {
        true -> acc;
        false -> do
            path: string <- path_for_module(files, modules.head);
            new_acc: ListString <- case len(path) > 0 of {
                true -> module_checker_core@cons_string(path, acc);
                false -> acc
            };
            resolve_deps_to_paths(modules.tail, files, new_acc)
        end
    }
}

// Declaration tag 2 = use; parameters.name holds each imported module (parser_ast.silica).
fn collect_use_modules_from_params(params: ListParam, acc: ListString) -> ListString {
    case params.is_nil of {
        true -> acc;
        false -> collect_use_modules_from_params(params.tail, module_checker_core@cons_string(params.head.name, acc))
    }
}

fn collect_use_modules_from_decls(decls: ListDeclaration, acc: ListString) -> ListString {
    case decls.is_nil of {
        true -> acc;
        false -> case decls.head.tag == 2 of {
            true -> collect_use_modules_from_decls(decls.tail, collect_use_modules_from_params(decls.head.parameters, acc));
            false -> collect_use_modules_from_decls(decls.tail, acc)
        }
    }
}

fn extract_use_modules_from_program(program: Program) -> ListString {
    collect_use_modules_from_decls(program.declarations, module_checker_core@empty_list_string())
}

fn dep_paths_for_parsed_file(path: string, parsed: ListParsedFile, config_files: ListString) -> ListString {
    do
        (found: bool, prog: Program) <- module_checker_core@find_program_in_parsed(parsed, path);
        case found of {
            true -> resolve_deps_to_paths(extract_use_modules_from_program(prog), config_files, module_checker_core@empty_list_string());
            false -> module_checker_core@empty_list_string()
        }
    end
}

// Edge: dependent must compile after prerequisite (both are config file paths).
struct DepEdge {
    dependent: string,
    prerequisite: string
}

struct ListDepEdge {
    is_nil: bool,
    head: DepEdge,
    tail: ListDepEdge
}

// Per-unit node for Kahn's algorithm (in-degree = unmet prerequisites in config).
struct CompileUnitDeps {
    path: string,
    in_degree: int64
}

struct ListCompileUnitDeps {
    is_nil: bool,
    head: CompileUnitDeps,
    tail: ListCompileUnitDeps
}

fn nil_dep_edge_list() -> ListDepEdge {
    dummy_edge: DepEdge <- DepEdge { dependent: "", prerequisite: "" };
    nil_edges: ListDepEdge <- ListDepEdge { is_nil: true, head: dummy_edge, tail: nil_edges };
    nil_edges
}

fn cons_dep_edge(edge: DepEdge, tail: ListDepEdge) -> ListDepEdge {
    ListDepEdge { is_nil: false, head: edge, tail: tail }
}

fn nil_compile_unit_deps_list() -> ListCompileUnitDeps {
    dummy_entry: CompileUnitDeps <- CompileUnitDeps { path: "", in_degree: 0 };
    nil_list: ListCompileUnitDeps <- ListCompileUnitDeps { is_nil: true, head: dummy_entry, tail: nil_list };
    nil_list
}

fn cons_compile_unit_deps(entry: CompileUnitDeps, tail: ListCompileUnitDeps) -> ListCompileUnitDeps {
    ListCompileUnitDeps { is_nil: false, head: entry, tail: tail }
}

fn reverse_compile_unit_deps_list(lst: ListCompileUnitDeps, acc: ListCompileUnitDeps) -> ListCompileUnitDeps {
    case lst.is_nil of {
        true -> acc;
        false -> reverse_compile_unit_deps_list(lst.tail, cons_compile_unit_deps(lst.head, acc))
    }
}

fn cons_dep_edges_for_paths(dependent: string, prereq_paths: ListString, acc: ListDepEdge) -> ListDepEdge {
    case prereq_paths.is_nil of {
        true -> acc;
        false -> cons_dep_edges_for_paths(dependent, prereq_paths.tail, cons_dep_edge(DepEdge { dependent: dependent, prerequisite: prereq_paths.head }, acc))
    }
}

fn build_dep_edges_rev(config_files: ListString, parsed: ListParsedFile, acc: ListDepEdge) -> ListDepEdge {
    case config_files.is_nil of {
        true -> acc;
        false -> do
            dep_paths: ListString <- dep_paths_for_parsed_file(config_files.head, parsed, config_files);
            with_edges: ListDepEdge <- cons_dep_edges_for_paths(config_files.head, dep_paths, acc);
            build_dep_edges_rev(config_files.tail, parsed, with_edges)
        end
    }
}

fn count_incoming_edges_for_path(edges: ListDepEdge, path: string) -> int64 {
    case edges.is_nil of {
        true -> 0;
        false -> case edges.head.dependent == path of {
            true -> 1 + count_incoming_edges_for_path(edges.tail, path);
            false -> count_incoming_edges_for_path(edges.tail, path)
        }
    }
}

fn build_compile_units_rev(config_files: ListString, edges: ListDepEdge, acc: ListCompileUnitDeps) -> ListCompileUnitDeps {
    case config_files.is_nil of {
        true -> acc;
        false -> do
            in_deg: int64 <- count_incoming_edges_for_path(edges, config_files.head);
            entry: CompileUnitDeps <- CompileUnitDeps { path: config_files.head, in_degree: in_deg };
            build_compile_units_rev(config_files.tail, edges, cons_compile_unit_deps(entry, acc))
        end
    }
}

fn has_edge_from_to(edges: ListDepEdge, dependent: string, prerequisite: string) -> bool {
    case edges.is_nil of {
        true -> false;
        false -> case edges.head.dependent == dependent and edges.head.prerequisite == prerequisite of {
            true -> true;
            false -> has_edge_from_to(edges.tail, dependent, prerequisite)
        }
    }
}

fn remove_unit_from_dep_graph(graph: ListCompileUnitDeps, path: string) -> ListCompileUnitDeps {
    case graph.is_nil of {
        true -> nil_compile_unit_deps_list();
        false -> case graph.head.path == path of {
            true -> graph.tail;
            false -> cons_compile_unit_deps(graph.head, remove_unit_from_dep_graph(graph.tail, path))
        }
    }
}

fn decrement_in_degrees_for_emit(graph: ListCompileUnitDeps, edges: ListDepEdge, emitted_path: string) -> ListCompileUnitDeps {
    case graph.is_nil of {
        true -> nil_compile_unit_deps_list();
        false -> do
            new_in_degree: int64 <- case has_edge_from_to(edges, graph.head.path, emitted_path) of {
                true -> graph.head.in_degree - 1;
                false -> graph.head.in_degree
            };
            updated: CompileUnitDeps <- CompileUnitDeps { path: graph.head.path, in_degree: new_in_degree };
            cons_compile_unit_deps(updated, decrement_in_degrees_for_emit(graph.tail, edges, emitted_path))
        end
    }
}

fn take_first_zero_in_degree(graph: ListCompileUnitDeps) -> (string, ListCompileUnitDeps) {
    take_first_zero_in_degree_impl(graph, graph)
}

fn take_first_zero_in_degree_impl(scan: ListCompileUnitDeps, full_graph: ListCompileUnitDeps) -> (string, ListCompileUnitDeps) {
    case scan.is_nil of {
        true -> ("", full_graph);
        false -> case scan.head.in_degree == 0 of {
            true -> do
                rest: ListCompileUnitDeps <- remove_unit_from_dep_graph(full_graph, scan.head.path);
                (scan.head.path, rest)
            end;
            false -> take_first_zero_in_degree_impl(scan.tail, full_graph)
        }
    }
}

// Kahn's algorithm: O(V+E) over config files using AST-derived deps (no per-probe disk reads).
fn kahn_topological_sort(graph: ListCompileUnitDeps, edges: ListDepEdge, result_rev: ListString) -> (bool, ListString) {
    case graph.is_nil of {
        true -> (true, reverse_list_string(result_rev));
        false -> do
            (ready_path: string, rest_graph: ListCompileUnitDeps) <- take_first_zero_in_degree(graph);
            case len(ready_path) == 0 of {
                true -> (false, result_rev);
                false -> do
                    updated: ListCompileUnitDeps <- decrement_in_degrees_for_emit(rest_graph, edges, ready_path);
                    kahn_topological_sort(updated, edges, module_checker_core@cons_string(ready_path, result_rev))
                end
            }
        end
    }
}

fn topological_sort_from_parsed(config_files: ListString, parsed: ListParsedFile) -> (bool, ListString) {
    do
        edges_rev: ListDepEdge <- build_dep_edges_rev(config_files, parsed, nil_dep_edge_list());
        units_rev: ListCompileUnitDeps <- build_compile_units_rev(config_files, edges_rev, nil_compile_unit_deps_list());
        units: ListCompileUnitDeps <- reverse_compile_unit_deps_list(units_rev, nil_compile_unit_deps_list());
        kahn_topological_sort(units, edges_rev, module_checker_core@empty_list_string())
    end
}

// Validate that all files listed in config exist; return 0 if ok, 1 if any missing
fn announce_compiling_file(filename: string) -> int64 proc[DeviceIO] {
    println("Compiling ");
    print(filename);
    println("...");
    0
}

fn announce_compiled_file(filename: string) -> int64 proc[DeviceIO] {
    mod_name: string <- module_checker_core@module_from_path(filename);
    println(concat("Finished compiling ", mod_name));
    0
}

fn validate_config_files(files: ListString) -> int64 proc[DeviceIO] {
    case files.is_nil of {
        true -> 0;
        false -> do
            exists: bool <- file_exists(files.head);
            case exists of {
                true -> validate_config_files(files.tail);
                false -> do
                    println(concat("Error: File not found: ", files.head));
                    println("Check silica.config - the file listed does not exist.");
                    1
                end
            }
        end
    }
}

// Debug: print tokens (kind and lexeme) for string_test/string_simple tracing
fn debug_print_tokens(tokens: ListToken) -> int64 proc[DeviceIO] {
    do
        debug_print_tokens_acc(tokens)
    end
}

fn debug_print_tokens_acc(tokens: ListToken) -> int64 proc[DeviceIO] {
    case tokens.is_nil of {
        true -> 0;
        false -> do
            t: Token <- tokens.head;
            kind_label: string <- case t.kind == lexer_token_kind@token_kind_string_literal() of { true -> "string_literal"; false -> case t.kind == lexer_token_kind@token_kind_identifier() of { true -> "identifier"; false -> case t.kind == lexer_token_kind@token_kind_string_keyword() of { true -> "string_keyword"; false -> t.lexeme } } };
            _: unit <- println(concat(concat(concat("  [DEBUG LEX] kind=", kind_label), " lexeme="), t.lexeme));
            debug_print_tokens_acc(tokens.tail)
        end
    }
}

// Debug: print expr structure (kind, name, value) for body tracing
fn debug_print_expr(expr: Expr, indent: string) -> int64 proc[DeviceIO] {
    case expr.kind < 0 of {
        true -> do
            _: unit <- println(concat(concat("  [DEBUG EXPR] ", indent), "DUMMY(kind<0)"));
            0
        end;
        false -> case expr.kind of {
            0 -> do _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "literal value="), expr.value)); 0 end;
            1 -> do _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "identifier name="), expr.name)); 0 end;
            4 -> do
                _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "call name="), expr.name));
                _: int64 <- debug_print_expr(expr.inner, concat(indent, "  arg1:"));
                _: int64 <- debug_print_expr(expr.right_expr, concat(indent, "  arg2:"));
                0
            end;
            6 -> do
                _: unit <- println(concat(concat(concat(concat("  [DEBUG EXPR] ", indent), "let "), expr.name), concat(": ", expr.value)));
                _: int64 <- debug_print_expr(expr.inner, concat(indent, "  rhs:"));
                _: int64 <- debug_print_expr(expr.right_expr, concat(indent, "  body:"));
                0
            end;
            8 -> do _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "string_literal value="), expr.value)); 0 end;
            11 -> do
                _: unit <- println(concat(concat("  [DEBUG EXPR] ", indent), "SEQUENCE_BLOCK"));
                _: int64 <- debug_print_expr(expr.inner, concat(indent, "  seq_body:"));
                _: int64 <- debug_print_expr(expr.right_expr, concat(indent, "  seq_result:"));
                0
            end;
            _: int64 -> do
                _: unit <- println(concat(concat(concat(concat("  [DEBUG EXPR] ", indent), "OTHER kind name="), expr.name), concat(" value=", expr.value)));
                _: int64 <- debug_print_expr(expr.inner, concat(indent, "  inner:"));
                _: int64 <- debug_print_expr(expr.right_expr, concat(indent, "  right:"));
                0
            end
        }
    }
}
{-
    Use this function to enable debug compilation for a specific file.
    filename should be the full path to the file.
    Example:
    debug_compile("~/silica-compiler/trials/int64_addition/print_int64_expression.silica")
    will return true if the filename is "print_int64_expression.silica"
-}
fn filename_ends_with(path: string, suffix: string) -> bool {
    ls: int64 <- len(path);
    lf: int64 <- len(suffix);
    case ls < lf of {
        true -> false;
        false -> substring(path, ls - lf, ls) == suffix
    }
}

fn debug_compile(filename: string) -> bool {
    case filename_ends_with(filename, "dangerous_legacy_math.silica") of {
        true -> true;
        false -> case filename_ends_with(filename, "dangerous_legacy_math_meta.silica") of {
            true -> true;
            false -> filename_ends_with(filename, "dangerous_net.silica")
        }
    }
}

fn debug_walk_decls(decls: ListDeclaration) -> int64 proc[DeviceIO] {
    case decls.is_nil of {
        true -> 0;
        false -> do
            _: unit <- println(concat("  decl name=", decls.head.name));
            _: int64 <- debug_print_expr(decls.head.body, "BODY>");
            debug_walk_decls(decls.tail)
        end
    }
}

// Module-check → SIR only (used for multi-unit silica.config: merge atoms, then emit with shared AtomTable).
// specialized_all: trait-specialized programs for this unit and its `use` closure (lazy process cache).
fn compile_to_sir_module(filename: string, program: Program, module_world: ListNamedProgram, config_files: ListString, all_parsed: ListParsedFile, specialized_all: ListNamedProgram) -> (int64, SIRModule) proc[DeviceIO] {
    _: int64 <- announce_compiling_file(filename);
    println("  Module checking...");
    mc: int64 <- module_checker_core@module_checker_check_program(program, config_files, all_parsed, filename);
    case mc == 0 of {
        false -> (1, sir_ast@dummy_sir_module());
        true -> do
            println("  FFI metadata...");
            ffi_meta: int64 <- ffi_sidecar_loader@validate_program_sidecar_metadata(program);
            case ffi_meta == 0 of {
                false -> (1, sir_ast@dummy_sir_module());
                true -> do
                    println("  FFI placement...");
                    placement: int64 <- ffi_placement_checker@validate_program_ffi_placement(program);
                    case placement == 0 of {
                        false -> (1, sir_ast@dummy_sir_module());
                        true -> do
                            println("  Type checking...");
                            context: TypeContext <- type_checker_core@create_type_context();
                            mod_name: string <- module_checker_core@module_from_path(filename);
                            world_with_self: ListNamedProgram <- parser_ast@cons_named_program(mod_name, program, module_world);
                            tc_out: ModuleTypecheckOutcome <- type_checker_modules@type_check_program_with_modules_outcome(program, mod_name, world_with_self, context);
                            case tc_out.is_ok of {
                                true -> do
                                    println("  FFI ABI...");
                                    abi_st: int64 <- ffi_abi_checker@validate_program_ffi_abi(program);
                                    case abi_st == 0 of {
                                        false -> (1, sir_ast@dummy_sir_module());
                                        true -> do
                                            println("  FFI taint...");
                                            taint_st: int64 <- ffi_taint_checker@validate_program_ffi_taint(program);
                                            case taint_st == 0 of {
                                                false -> (1, sir_ast@dummy_sir_module());
                                                true -> do
                                                    println("  Trait checking...");
                                                    tr_code: int64 <- trait_checker_core@trait_checker_check_program(program);
                                                    case tr_code != 0 of {
                                                        true -> (1, sir_ast@dummy_sir_module());
                                                        false -> do
                                                            println("  Effect checking...");
                                                            effect_result: EffectCheckResult <- effect_checker_capabilities@check_program_effects(program, world_with_self);
                                                            case effect_result.is_ok of {
                                                                true -> do
                                                                    _: int64 <- case debug_compile(filename) of {
                                                                        true -> do
                                                                            println("  [DEBUG AST] decl-count walk:");
                                                                            debug_walk_decls(program.declarations);
                                                                            0
                                                                        end;
                                                                        false -> 0
                                                                    };
                                                                    println("  Generating SIR...");
                                                                    specialized_program: Program <- specialized_program_for_module(mod_name, program, specialized_all);
                                                                    mangled_program: Program <- qualified_call_mangler@mangle_calls_in_program(specialized_program, specialized_all);
                                                                    link_libs: ListSirString <- ffi_sidecar_loader@collect_program_link_libraries(program);
                                                                    sir_module: SIRModule <- sir_generator_core@emit_program_for_unit_with_link_libraries(mangled_program, tc_out.context, mod_name, link_libs);
                                                                    _: int64 <- case debug_compile(filename) of {
                                                                        true -> do
                                                                            println("  [DEBUG SIR]:");
                                                                            println(sir_ast@sir_module_to_text(sir_module));
                                                                            0
                                                                        end;
                                                                        false -> 0
                                                                    };
                                                                    (0, sir_module)
                                                                end;
                                                                false -> do
                                                                    effect_error_code: string <- case effect_result.error_code == "" of {
                                                                        true -> "E3000";
                                                                        false -> effect_result.error_code
                                                                    };
                                                                    effect_spec_section: string <- case effect_result.spec_section == "" of {
                                                                        true -> "sect9";
                                                                        false -> effect_result.spec_section
                                                                    };
                                                                    diagnostics_core@print_compiler_error("EffectError", effect_error_code, effect_result.error_location, effect_result.error_message, effect_spec_section);
                                                                    (1, sir_ast@dummy_sir_module())
                                                                end
                                                            }
                                                        end
                                                    }
                                                end
                                            }
                                        end
                                    }
                                end;
                                false -> do
                                    error_code: string <- case tc_out.error_code == "" of {
                                        true -> "E2000";
                                        false -> tc_out.error_code
                                    };
                                    spec_section: string <- case tc_out.spec_section == "" of {
                                        true -> "sect6";
                                        false -> tc_out.spec_section
                                    };
                                    diagnostics_core@print_compiler_error("TypeError", error_code, tc_out.error_location, tc_out.error_message, spec_section);
                                    (1, sir_ast@dummy_sir_module())
                                end
                            }
                        end
                    }
                end
            }
        end
    }
}

// Module-check, type-check, trait-check, effect-check, SIR, emit for one unit; module_world is other parsed units (spec §19).
fn compile_parsed_unit(filename: string, program: Program, module_world: ListNamedProgram, config_files: ListString, all_parsed: ListParsedFile, specialized_all: ListNamedProgram) -> (int64, bool) proc[DeviceIO] {
    do
        (sir_code: int64, sir_module: SIRModule) <- compile_to_sir_module(filename, program, module_world, config_files, all_parsed, specialized_all);
        case sir_code != 0 of {
            true -> (sir_code, false);
            false -> do
                println("  Emitting...");
                asm: string <- case debug_compile(filename) of {
                    true -> emitter_core@emit_module_with_atom_and_debug(sir_module, atom_table@build_atom_table(sir_module), true);
                    false -> emitter_core@emit_module(sir_module)
                };
                build_output@write_assembly(filename, asm);
                _: int64 <- announce_compiled_file(filename);
                (0, emitter_core@module_needs_actor_runtime(sir_module))
            end
        }
    end
}

// Reverse cons-built ListSIRModule (newest at head) into forward topological order.
fn reverse_sir_modules_into_forward(lst: ListSIRModule, acc: ListSIRModule) -> ListSIRModule {
    case lst.is_nil of {
        true -> acc;
        false -> reverse_sir_modules_into_forward(lst.tail, sir_ast@cons_sir_module(lst.head, acc))
    }
}

// Walk sorted_topo; accumulate SIR in reverse (cons) for each unit, then caller reverses to match topo order.
fn gather_sirs_rev(sorted_rem: ListString, parsed: ListParsedFile, config_files: ListString, specialized_all: ListNamedProgram, acc_rev: ListSIRModule) -> (int64, ListSIRModule) proc[DeviceIO] {
    case sorted_rem.is_nil of {
        true -> (0, acc_rev);
        false -> do
            (found: bool, prog: Program) <- module_checker_core@find_program_in_parsed(parsed, sorted_rem.head);
            world: ListNamedProgram <- build_module_world(parsed, sorted_rem.head);
            case found of {
                false -> do
                    println("Error: internal parse table missing file");
                    print(sorted_rem.head);
                    (1, sir_ast@nil_sir_modules())
                end;
                true -> do
                    (sir_c: int64, sir_val: SIRModule) <- compile_to_sir_module(sorted_rem.head, prog, world, config_files, parsed, specialized_all);
                    case sir_c != 0 of {
                        true -> (sir_c, sir_ast@nil_sir_modules());
                        false -> gather_sirs_rev(sorted_rem.tail, parsed, config_files, specialized_all, sir_ast@cons_sir_module(sir_val, acc_rev))
                    }
                end
            }
        end
    }
}

fn sir_queue_any_need_actor_runtime(mods: ListSIRModule) -> bool {
    case mods.is_nil of {
        true -> false;
        false -> case emitter_core@module_needs_actor_runtime(mods.head) of {
            true -> true;
            false -> sir_queue_any_need_actor_runtime(mods.tail)
        }
    }
}

fn emit_batch_with_exe_atom_table(paths: ListString, sirs: ListSIRModule, exe_tbl: AtomTable) -> int64 proc[DeviceIO] {
    case paths.is_nil of {
        true -> 0;
        false -> case sirs.is_nil of {
            true -> 1;
            false -> do
                println("  Emitting...");
                asm: string <- case debug_compile(paths.head) of {
                    true -> emitter_core@emit_module_with_atom_and_debug(sirs.head, exe_tbl, true);
                    false -> emitter_core@emit_module_with_atom_table(sirs.head, exe_tbl)
                };
                build_output@write_assembly(paths.head, asm);
                _: int64 <- announce_compiled_file(paths.head);
                emit_batch_with_exe_atom_table(paths.tail, sirs.tail, exe_tbl)
            end
        }
    }
}

// Two or more units: one merged atom table for the whole config (link-batch / process-image atom ids), then emit each .sams with that table.
fn compile_multi_unit_with_merged_atoms(sorted_topo: ListString, parsed_all: ListParsedFile, config_files: ListString) -> int64 proc[DeviceIO] {
    specialized_all: ListNamedProgram <- specialize_all_parsed(parsed_all);
    (gather_code: int64, rev_queue: ListSIRModule) <- gather_sirs_rev(sorted_topo, parsed_all, config_files, specialized_all, sir_ast@nil_sir_modules());
    case gather_code != 0 of {
        true -> gather_code;
        false -> do
            fwd_queue: ListSIRModule <- reverse_sir_modules_into_forward(rev_queue, sir_ast@nil_sir_modules());
            exe_atom_tbl: AtomTable <- atom_table@build_atom_table_executable(fwd_queue);
            emit_c: int64 <- emit_batch_with_exe_atom_table(sorted_topo, fwd_queue, exe_atom_tbl);
            case emit_c != 0 of {
                true -> emit_c;
                false -> build_output@write_runtime_assembly(emitter_core@emit_actor_runtime_module_with_atom_table(exe_atom_tbl))
            }
        end
    }
}

fn compile_parsed_list_incremental(sorted: ListString, parsed: ListParsedFile, all_config_files: ListString, specialized_cache: ListNamedProgram, any_needs_runtime: bool) -> int64 proc[DeviceIO] {
    case sorted.is_nil of {
        true -> do
            _: int64 <- maybe_write_runtime_assembly(any_needs_runtime);
            0
        end;
        false -> do
            (found: bool, prog: Program) <- module_checker_core@find_program_in_parsed(parsed, sorted.head);
            case found of {
                false -> do
                    println("Error: internal parse table missing file");
                    print(sorted.head);
                    1
                end;
                true -> do
                    mod_name: string <- module_checker_core@module_from_path(sorted.head);
                    use_names: ListString <- transitive_use_names_for_program(prog, parsed);
                    // Specialize once per module into the process cache (host cannot free; never re-specialize).
                    cache_uses: ListNamedProgram <- ensure_specialized_names(use_names, parsed, specialized_cache);
                    cache_self: ListNamedProgram <- ensure_specialized_path(sorted.head, parsed, cache_uses);
                    world: ListNamedProgram <- build_module_world(parsed, sorted.head);
                    mangle_names: ListString <- list_string_cons_unique(mod_name, use_names);
                    specialized_for_unit: ListNamedProgram <- filter_specialized_to_names(cache_self, mangle_names);
                    (code: int64, unit_rt: bool) <- compile_parsed_unit(sorted.head, prog, world, all_config_files, parsed, specialized_for_unit);
                    case code != 0 of {
                        true -> code;
                        false -> compile_parsed_list_incremental(sorted.tail, parsed, all_config_files, cache_self, any_needs_runtime or unit_rt)
                    }
                end
            }
        end
    }
}

// all_config_files: every path from silica.config (not the recursive suffix) — needed for `use` / module@ validation per unit.
fn compile_parsed_list(sorted: ListString, parsed: ListParsedFile, all_config_files: ListString) -> int64 proc[DeviceIO] {
    case sorted.is_nil of {
        true -> 0;
        false -> case sorted.tail.is_nil of {
            true -> do
                (found: bool, prog: Program) <- module_checker_core@find_program_in_parsed(parsed, sorted.head);
                case found of {
                    false -> do
                        println("Error: internal parse table missing file");
                        print(sorted.head);
                        1
                    end;
                    true -> do
                        empty_cache: ListNamedProgram <- type_checker_modules@empty_named_program_list();
                        cache1: ListNamedProgram <- ensure_specialized_path(sorted.head, parsed, empty_cache);
                        world: ListNamedProgram <- build_module_world(parsed, sorted.head);
                        (code: int64, unit_rt: bool) <- compile_parsed_unit(sorted.head, prog, world, all_config_files, parsed, cache1);
                        case code != 0 of {
                            true -> code;
                            false -> do
                                _: int64 <- maybe_write_runtime_assembly(unit_rt);
                                0
                            end
                        }
                    end
                }
            end;
            false -> compile_parsed_list_incremental(sorted, parsed, all_config_files, type_checker_modules@empty_named_program_list(), false)
        }
    }
}

// Lex + parse one file, then compile with an empty module world (no cross-file `use`).
fn compile_file(filename: string) -> int64 proc[DeviceIO] {
    println("Parsing ");
    print(filename);
    println("...");
    println("  Lexing...");
    tokens: ListToken <- lexer_runner@lexer_runner(filename);
    // Token debug disabled to reduce noise
    _: int64 <- case debug_compile(filename) of {
        true -> 0;
        false -> 0
    };
    println("  Parsing...");
    parse_result: ParseResult <- parser_runner@parse_program(tokens);
    _: int64 <- case debug_compile(filename) of {
        true -> 0;
        false -> 0
    };
    case parse_result.is_ok of {
        true -> do
            mod_nm: string <- module_checker_core@module_from_path(filename);
            world_one: ListNamedProgram <- parser_ast@cons_named_program(mod_nm, parse_result.program, type_checker_modules@empty_named_program_list());
            parsed_one: ListParsedFile <- cons_parsed_file(filename, parse_result.program, empty_parsed_files());
            specialized_one: ListNamedProgram <- specialize_all_parsed(parsed_one);
            (cf_code: int64, cf_rt: bool) <- compile_parsed_unit(filename, parse_result.program, world_one, cons_string(filename, empty_list_string()), parsed_one, specialized_one);
            case cf_code != 0 of {
                true -> cf_code;
                false -> do
                    _: int64 <- maybe_write_runtime_assembly(cf_rt);
                    0
                end
            }
        end;
        false -> do
            error_code: string <- case parse_result.error_code == "" of {
                true -> "E1001";
                false -> parse_result.error_code
            };
            spec_section: string <- case parse_result.spec_section == "" of {
                true -> "sect3";
                false -> parse_result.spec_section
            };
            diagnostics_core@print_compiler_error("ParseError", error_code, parse_result.error_location, parse_result.error_message, spec_section);
            1
        end
    }
}

// After compiling one unit: persist remaining order and either finish or ask the Makefile to re-exec.
fn after_unit_compiled(rest: ListString, unit_rt: bool) -> int64 proc[DeviceIO] {
    _: int64 <- mark_needs_runtime_if(unit_rt);
    case rest.is_nil of {
        true -> finish_batch_artifacts();
        false -> do
            _: int64 <- write_paths_file(compile_order_path(), rest);
            println("Unit compiled; exiting to reclaim memory before next unit...");
            continue_exit_code()
        end
    }
}

// First process: full parse + topo. Small batches compile in-process; large multi-unit batches
// exit 75 so each unit compiles in a fresh process (OS reclaim).
fn prepare_compile_order(sorted_files: ListString, parsed_all: ListParsedFile, all_config_files: ListString) -> int64 proc[DeviceIO] {
    case sorted_files.is_nil of {
        true -> finish_batch_artifacts();
        false -> case use_process_per_unit(sorted_files) of {
            false -> compile_all_parsed(sorted_files, parsed_all, all_config_files);
            true -> do
                link_st: int64 <- ffi_link_manifest@write_link_manifest_for_parsed(parsed_all);
                case link_st != 0 of {
                    true -> link_st;
                    false -> case sorted_files.tail.is_nil of {
                        true -> do
                            (code: int64, unit_rt: bool) <- compile_one_sorted_unit(sorted_files.head, parsed_all, all_config_files);
                            case code != 0 of {
                                true -> code;
                                false -> after_unit_compiled(module_checker_core@empty_list_string(), unit_rt)
                            }
                        end;
                        false -> do
                            _: int64 <- write_paths_file(compile_order_path(), sorted_files);
                            println("Compile order ready; exiting to reclaim memory before unit compiles...");
                            continue_exit_code()
                        end
                    }
                }
            end
        }
    }
}

// Resume process: parse only the next unit's use-closure, compile it, persist remaining order.
fn resume_compile_order(order: ListString, all_config_files: ListString) -> int64 proc[DeviceIO] {
    case order.is_nil of {
        true -> finish_batch_artifacts();
        false -> do
            (ok: bool, parsed: ListParsedFile) <- parse_use_closure_work(
                module_checker_core@cons_string(order.head, module_checker_core@empty_list_string()),
                all_config_files,
                empty_parsed_files()
            );
            case ok of {
                false -> 1;
                true -> do
                    (code: int64, unit_rt: bool) <- compile_one_sorted_unit(order.head, parsed, all_config_files);
                    case code != 0 of {
                        true -> code;
                        false -> after_unit_compiled(order.tail, unit_rt)
                    }
                end
            }
        end
    }
}

// Main: read config, parse, sort by deps, compile one unit per process (see memory hygiene).
fn main() -> int64 proc[DeviceIO] {
    config_path: string <- "silica.config";
    config_exists: bool <- file_exists(config_path);
    content: string <- case config_exists of {
        true -> read_lines(config_path);
        false -> ""
    };
    files_rev: ListString <- case len(content) > 0 of {
        true -> parse_config_lines(content, 0, empty_list_string());
        false -> empty_list_string()
    };
    files: ListString <- reverse_list_string(files_rev);
    case list_string_length(files) == 0 of {
        true -> do
            println("Error: silica.config not found or empty. Create silica.config with one .silica file per line.");
            1
        end;
        false -> do
            validation: int64 <- validate_config_files(files);
            case validation != 0 of {
                true -> 1;
                false -> do
                    // Small configs always compile in-process; drop any leftover reclaim-order
                    // file so a prior process-per-unit run cannot force "Resuming…" output.
                    _: bool <- case use_process_per_unit(files) of {
                        true -> false;
                        false -> do
                            delete_file(compile_order_path());
                            delete_file(needs_runtime_marker_path());
                            false
                        end
                    };
                    order_exists: bool <- file_exists(compile_order_path());
                    case order_exists of {
                        true -> do
                            order_content: string <- read_lines(compile_order_path());
                            order_rev: ListString <- case len(order_content) > 0 of {
                                true -> parse_config_lines(order_content, 0, empty_list_string());
                                false -> empty_list_string()
                            };
                            order: ListString <- reverse_list_string(order_rev);
                            println("Resuming compile order; units left: ");
                            print_int64(list_string_length(order));
                            println("");
                            resume_compile_order(order, files)
                        end;
                        false -> do
                            println("Files to compile: ");
                            print_int64(list_string_length(files));
                            println("");
                            (ok_parse: bool, parsed_all: ListParsedFile) <- parse_all_files_recursive(files, empty_parsed_files());
                            case ok_parse of {
                                false -> 1;
                                true -> do
                                    (sort_ok: bool, sorted_files: ListString) <- topological_sort_from_parsed(files, parsed_all);
                                    case sort_ok of {
                                        false -> do
                                            println("Error: cyclic module dependencies among files in silica.config");
                                            1
                                        end;
                                        true -> prepare_compile_order(sorted_files, parsed_all, files)
                                    }
                                end
                            }
                        end
                    }
                end
            }
        end
    }
}
