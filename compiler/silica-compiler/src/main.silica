// Main entry point for Phase 2 compiler
// Reads file list from silica.config, resolves dependencies, compiles each file in order

use lexer_runner;
use lexer_core;
use lexer_token_kind;
use parser_core;
use parser_runner;
use parser_ast;
use type_checker_core;
use type_checker_modules;
use effect_checker_core;
use effect_checker_capabilities;
use sir_generator_core;
use sir_ast;
use emitter_core;
use build_output;
use diagnostics_core;
use module_checker_core;

fn build_module_world(all: ListParsedFile, exclude_path: string) -> ListNamedProgram {
    case all.is_nil of {
        true -> type_checker_modules@empty_named_program_list();
        false -> case all.head.path == exclude_path of {
            true -> build_module_world(all.tail, exclude_path);
            false -> type_checker_modules@cons_named_program(
                module_from_path(all.head.path),
                all.head.program,
                build_module_world(all.tail, exclude_path)
            )
        }
    }
}

fn parse_all_files_recursive(files: ListString, acc: ListParsedFile) -> (bool, ListParsedFile) proc[DeviceIO] {
    case files.is_nil of {
        true -> (true, reverse_parsed_files(acc, empty_parsed_files()));
        false -> do
            println("Compiling ");
            print(files.head);
            println("...");
            println("  Lexing...");
            tokens: ListToken <- lexer_runner@lexer_runner(files.head);
            println("  Parsing...");
            parse_result: ParseResult <- parser_runner@parse_program(tokens);
            case parse_result.is_ok of {
                false -> do
                    error_code: string <- case parse_result.error_code == "" of {
                        true -> "E1001";
                        false -> parse_result.error_code
                    };
                    spec_section: string <- case parse_result.spec_section == "" of {
                        true -> "sect3";
                        false -> parse_result.spec_section
                    };
                    diagnostics_core@print_compiler_error("ParseError", error_code, parse_result.error_location, parse_result.error_message, spec_section);
                    (false, empty_parsed_files())
                end;
                true -> parse_all_files_recursive(files.tail, cons_parsed_file(files.head, parse_result.program, acc))
            }
        end
    }
}

// all_config_files: every path from silica.config (not the recursive suffix) — needed for `use` / module@ validation per unit.
fn compile_parsed_list(sorted: ListString, parsed: ListParsedFile, all_config_files: ListString) -> int64 proc[DeviceIO] {
    case sorted.is_nil of {
        true -> 0;
        false -> do
            (found: bool, prog: Program) <- find_program_in_parsed(parsed, sorted.head);
            world: ListNamedProgram <- build_module_world(parsed, sorted.head);
            code: int64 <- case found of {
                false -> do
                    println("Error: internal parse table missing file");
                    print(sorted.head);
                    1
                end;
                true -> compile_parsed_unit(sorted.head, prog, world, all_config_files, parsed)
            };
            case code != 0 of {
                true -> code;
                false -> compile_parsed_list(sorted.tail, parsed, all_config_files)
            }
        end
    }
}

fn list_string_length(lst: ListString) -> int64 {
    case lst.is_nil of {
        true -> 0;
        false -> 1 + list_string_length(lst.tail)
    }
}

// Parse config: split by newlines, skip empty and # lines, return list (order preserved)
fn parse_config_lines(content: string, start: int64, acc: ListString) -> ListString proc[DeviceIO] {
    case start >= len(content) of {
        true -> acc;
        false -> do
            line: string <- substring_until_char(content, start, '\n');
            line_len: int64 <- len(line);
            next_start: int64 <- start + line_len + 1;
            trimmed: string <- trim_leading(line);
            is_comment: bool <- starts_with(trimmed, "#");
            is_empty: bool <- len(trimmed) == 0;
            new_acc: ListString <- case is_comment of {
                true -> acc;
                false -> case is_empty of {
                    true -> acc;
                    false -> cons_string(trimmed, acc)
                }
            };
            parse_config_lines(content, next_start, new_acc)
        end
    }
}

fn trim_leading(s: string) -> string {
    trim_leading_from(s, 0)
}

fn trim_leading_from(s: string, pos: int64) -> string {
    case pos >= len(s) of {
        true -> "";
        false -> case is_whitespace_at(s, pos) of {
            true -> trim_leading_from(s, pos + 1);
            false -> substring(s, pos, len(s))
        }
    }
}

fn is_whitespace_at(s: string, pos: int64) -> bool {
    c: string <- substring(s, pos, pos + 1);
    c == " " or c == "\t" or c == "\n" or c == "\r"
}

fn trim_trailing(s: string) -> string {
    trim_trailing_from(s, len(s) - 1)
}

fn trim_trailing_from(s: string, pos: int64) -> string {
    case pos < 0 of {
        true -> "";
        false -> case is_whitespace_at(s, pos) of {
            true -> trim_trailing_from(s, pos - 1);
            false -> substring(s, 0, pos + 1)
        }
    }
}

// Reverse a ListString (since we cons in reverse order during parse)
fn reverse_list_string(lst: ListString) -> ListString {
    reverse_list_string_acc(lst, empty_list_string())
}

fn reverse_list_string_acc(lst: ListString, acc: ListString) -> ListString {
    case lst.is_nil of {
        true -> acc;
        false -> reverse_list_string_acc(lst.tail, cons_string(lst.head, acc))
    }
}

// Extract module names from "use mod1, mod2, mod3;" in content
fn extract_use_dependencies(content: string, start: int64, acc: ListString) -> ListString {
    case start >= len(content) - 4 of {
        true -> acc;
        false -> do
            chunk: string <- substring(content, start, len(content));
            found: bool <- starts_with(chunk, "use ");
            (new_acc, next_start) <- case found of {
                true -> do
                    dep_start: int64 <- start + 4;
                    use_chunk: string <- substring_until_char(content, dep_start, ';');
                    deps: ListString <- parse_comma_separated(use_chunk, 0, empty_list_string());
                    merged: ListString <- append_list_string(deps, acc);
                    next: int64 <- dep_start + len(use_chunk) + 1;
                    (merged, next)
                end;
                false -> (acc, start + 1)
            };
            extract_use_dependencies(content, next_start, new_acc)
        end
    }
}

fn parse_comma_separated(s: string, start: int64, acc: ListString) -> ListString {
    case start >= len(s) of {
        true -> acc;
        false -> do
            part: string <- substring_until_char(s, start, ',');
            trimmed: string <- trim_trailing(trim_leading(part));
            next_start: int64 <- start + len(part) + 1;
            new_acc: ListString <- case len(trimmed) > 0 of {
                true -> cons_string(trimmed, acc);
                false -> acc
            };
            parse_comma_separated(s, next_start, new_acc)
        end
    }
}

fn append_list_string(a: ListString, b: ListString) -> ListString {
    case a.is_nil of {
        true -> b;
        false -> cons_string(a.head, append_list_string(a.tail, b))
    }
}

// Check if list contains string (exact match)
fn list_contains(lst: ListString, s: string) -> bool {
    case lst.is_nil of {
        true -> false;
        false -> case lst.head == s of {
            true -> true;
            false -> list_contains(lst.tail, s)
        }
    }
}

// Get file path for module from our file list (module name -> path)
fn path_for_module(files: ListString, mod_name: string) -> string {
    case files.is_nil of {
        true -> "";
        false -> case module_from_path(files.head) == mod_name of {
            true -> files.head;
            false -> path_for_module(files.tail, mod_name)
        }
    }
}

// Get dependencies of file as list of file paths (only those in our config)
fn get_file_dependencies(files: ListString, file_path: string) -> ListString proc[DeviceIO] {
    content: string <- read_lines(file_path);
    use_deps: ListString <- extract_use_dependencies(content, 0, empty_list_string());
    resolve_deps_to_paths(use_deps, files, empty_list_string())
}

fn resolve_deps_to_paths(modules: ListString, files: ListString, acc: ListString) -> ListString {
    case modules.is_nil of {
        true -> acc;
        false -> do
            path: string <- path_for_module(files, modules.head);
            new_acc: ListString <- case len(path) > 0 of {
                true -> cons_string(path, acc);
                false -> acc
            };
            resolve_deps_to_paths(modules.tail, files, new_acc)
        end
    }
}

// Count how many of files dependencies are in the "remaining" list (not yet compiled)
fn count_unmet_deps(file: string, deps: ListString, remaining: ListString) -> int64 {
    case deps.is_nil of {
        true -> 0;
        false -> case list_contains(remaining, deps.head) of {
            true -> 1 + count_unmet_deps(file, deps.tail, remaining);
            false -> count_unmet_deps(file, deps.tail, remaining)
        }
    }
}

// Topological sort: return files in compile order (dependencies first)
fn topological_sort(files: ListString) -> ListString proc[DeviceIO] {
    remaining: ListString <- files;
    result: ListString <- empty_list_string();
    sorted_rev: ListString <- topological_sort_loop(files, remaining, result);
    reverse_list_string(sorted_rev)
}

// all_deps: for each file in files, its dependencies. We pass (files, deps) pairs.
// Simplified: we will compute deps on the fly. Actually we need to store deps per file.
// Simpler approach: repeatedly find a file with no deps in remaining, add to result, remove from remaining.
fn topological_sort_loop(files: ListString, remaining: ListString, result: ListString) -> ListString proc[DeviceIO] {
    case remaining.is_nil of {
        true -> result;
        false -> do
            (next, new_remaining) <- find_ready_file(remaining, files);
            case len(next) == 0 of {
                true -> result;
                false -> do
                    new_result: ListString <- cons_string(next, result);
                    topological_sort_loop(files, new_remaining, new_result)
                end
            }
        end
    }
}

// This is getting complex. Let me simplify: store (file, deps) as parallel lists.
// Actually, we need a different structure. Let me use a simpler algorithm:
// For each file in order, if it has deps that come after it in the list, we have a problem.
// Simpler: just compile in config order, but first sort so that files with no deps come first,
// then files that only depend on those, etc.

// Much simpler: collect all files with their deps. Then:
// 1. Find files with zero deps in our set -> add to result
// 2. Remove them from "remaining"
// 3. Repeat until remaining empty or we can't find any (cycle)

// We need to pass deps per file. Structure: ListString of files, and for each file we need its deps.
// Let me use a different approach: ListString of "file|dep1,dep2,dep3" - no, too hacky.

// Simpler: just compile in the order they appear in config. The user said "those with no dependencies
// compiled first" - so we need proper topological sort. Let me implement it properly.

// We need: for each file, get its deps. Store as parallel lists: files and dep_list where dep_list[i] is deps of files[i].
// But we don't have arrays. We have linked lists. So:
// files = [f1, f2, f3]
// deps = [d1, d2, d3] where d1 is ListString of deps of f1
// We need to get deps for file at index. With linked lists, we would need to traverse.

// Simpler: one recursive function that takes (files, remaining) and returns sorted order.
// find_ready(remaining): find first file in remaining whose deps are not in remaining
// If found: add to result, remove from remaining, recurse
// If not found and remaining not empty: cycle error

fn find_ready_file(remaining: ListString, all_files: ListString) -> (string, ListString) proc[DeviceIO] {
    find_ready_file_impl(remaining, remaining, all_files)
}

fn find_ready_file_impl(remaining: ListString, orig_remaining: ListString, all_files: ListString) -> (string, ListString) proc[DeviceIO] {
    case remaining.is_nil of {
        true -> ("", empty_list_string());
        false -> do
            file: string <- remaining.head;
            file_deps: ListString <- get_file_dependencies(all_files, file);
            unmet: int64 <- count_unmet_deps(file, file_deps, orig_remaining);
            case unmet == 0 of {
                true -> do
                    new_remaining: ListString <- remove_from_list(orig_remaining, file);
                    (file, new_remaining)
                end;
                false -> do
                    (next, new_remaining) <- find_ready_file_impl(remaining.tail, orig_remaining, all_files);
                    (next, new_remaining)
                end
            }
        end
    }
}

fn remove_from_list(lst: ListString, s: string) -> ListString {
    case lst.is_nil of {
        true -> empty_list_string();
        false -> case lst.head == s of {
            true -> lst.tail;
            false -> cons_string(lst.head, remove_from_list(lst.tail, s))
        }
    }
}

// Validate that all files listed in config exist; return 0 if ok, 1 if any missing
fn validate_config_files(files: ListString) -> int64 proc[DeviceIO] {
    case files.is_nil of {
        true -> 0;
        false -> do
            exists: bool <- file_exists(files.head);
            case exists of {
                true -> validate_config_files(files.tail);
                false -> do
                    println(concat("Error: File not found: ", files.head));
                    println("Check silica.config - the file listed does not exist.");
                    1
                end
            }
        end
    }
}

// Debug: print tokens (kind and lexeme) for string_test/string_simple tracing
fn debug_print_tokens(tokens: ListToken) -> int64 proc[DeviceIO] {
    do
        kinds: TokenKinds <- lexer_token_kind@token_kinds();
        debug_print_tokens_acc(tokens, kinds)
    end
}

fn debug_print_tokens_acc(tokens: ListToken, kinds: TokenKinds) -> int64 proc[DeviceIO] {
    case tokens.is_nil of {
        true -> 0;
        false -> do
            t: Token <- tokens.head;
            kind_label: string <- case t.kind == kinds.string_literal of { true -> "string_literal"; false -> case t.kind == kinds.identifier of { true -> "identifier"; false -> case t.kind == kinds.string_keyword of { true -> "string_keyword"; false -> t.lexeme } } };
            _: unit <- println(concat(concat(concat("  [DEBUG LEX] kind=", kind_label), " lexeme="), t.lexeme));
            debug_print_tokens_acc(tokens.tail, kinds)
        end
    }
}

// Debug: print expr structure (kind, name, value) for body tracing
fn debug_print_expr(expr: Expr, indent: string) -> int64 proc[DeviceIO] {
    case expr.kind < 0 of {
        true -> do
            _: unit <- println(concat(concat("  [DEBUG EXPR] ", indent), "DUMMY(kind<0)"));
            0
        end;
        false -> case expr.kind of {
            0 -> do _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "literal value="), expr.value)); 0 end;
            1 -> do _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "identifier name="), expr.name)); 0 end;
            4 -> do
                _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "call name="), expr.name));
                _: int64 <- debug_print_expr(expr.inner, concat(indent, "  arg1:"));
                _: int64 <- debug_print_expr(expr.right_expr, concat(indent, "  arg2:"));
                0
            end;
            6 -> do
                _: unit <- println(concat(concat(concat(concat("  [DEBUG EXPR] ", indent), "let "), expr.name), concat(": ", expr.value)));
                _: int64 <- debug_print_expr(expr.inner, concat(indent, "  rhs:"));
                _: int64 <- debug_print_expr(expr.right_expr, concat(indent, "  body:"));
                0
            end;
            8 -> do _: unit <- println(concat(concat(concat("  [DEBUG EXPR] ", indent), "string_literal value="), expr.value)); 0 end;
            11 -> do
                _: unit <- println(concat(concat("  [DEBUG EXPR] ", indent), "SEQUENCE_BLOCK"));
                _: int64 <- debug_print_expr(expr.inner, concat(indent, "  seq_body:"));
                _: int64 <- debug_print_expr(expr.right_expr, concat(indent, "  seq_result:"));
                0
            end;
            _: int64 -> do
                _: unit <- println(concat(concat(concat(concat("  [DEBUG EXPR] ", indent), "OTHER kind name="), expr.name), concat(" value=", expr.value)));
                _: int64 <- debug_print_expr(expr.inner, concat(indent, "  inner:"));
                _: int64 <- debug_print_expr(expr.right_expr, concat(indent, "  right:"));
                0
            end
        }
    }
}
{-
    Use this function to enable debug compilation for a specific file.
    filename should be the full path to the file.
    Example:
    debug_compile("~/silica-compiler/trials/int64_addition/print_int64_expression.silica")
    will return true if the filename is "print_int64_expression.silica"
-}
fn debug_compile(filename: string) -> bool {
    case filename of {
        _: string -> false
    }
}

fn debug_walk_decls(decls: ListDeclaration) -> int64 proc[DeviceIO] {
    case decls.is_nil of {
        true -> 0;
        false -> do
            _: unit <- println(concat("  decl name=", decls.head.name));
            _: int64 <- debug_print_expr(decls.head.body, "BODY>");
            debug_walk_decls(decls.tail)
        end
    }
}

// Type-check, effect-check, SIR, emit for one unit; module_world is other parsed units (spec §19).
// config_files: full silica.config path list — module checker validates `use` before type checking.
// all_parsed: every ParsedFile from this compile — module checker verifies cross-module exports (§19.2).
fn compile_parsed_unit(filename: string, program: Program, module_world: ListNamedProgram, config_files: ListString, all_parsed: ListParsedFile) -> int64 proc[DeviceIO] {
    println("  Module checking...");
    mc: int64 <- module_checker_core@module_checker_check_program(program, config_files, all_parsed);
    case mc == 0 of {
        false -> 1;
        true -> do
            println("  Type checking...");
            context: TypeContext <- type_checker_core@create_type_context();
            mod_name: string <- module_checker_core@module_from_path(filename);
            tc_out: ModuleTypecheckOutcome <- type_checker_modules@type_check_program_with_modules_outcome(program, mod_name, module_world, context);
            case tc_out.is_ok of {
                true -> do
                    println("  Effect checking...");
                    effect_result: EffectCheckResult <- effect_checker_capabilities@check_program_effects(program);
                    case effect_result.is_ok of {
                        true -> do
                            _: int64 <- case debug_compile(filename) of {
                                true -> do
                                    println("  [DEBUG AST] decl-count walk:");
                                    debug_walk_decls(program.declarations);
                                    0
                                end;
                                false -> 0
                            };
                            println("  Generating SIR...");
                            sir_module: SIRModule <- sir_generator_core@emit_program_for_unit(program, tc_out.context, mod_name);
                            _: int64 <- case debug_compile(filename) of {
                                true -> do
                                    println("  [DEBUG SIR]:");
                                    println(sir_ast@sir_module_to_text(sir_module));
                                    0
                                end;
                                false -> 0
                            };
                            println("  Emitting...");
                            asm: string <- case debug_compile(filename) of {
                                true -> emitter_core@emit_module_debug(sir_module, true);
                                false -> emitter_core@emit_module(sir_module)
                            };
                            build_output@write_assembly(filename, asm);
                            println(concat("Successfully built ", mod_name));
                            0
                        end;
                        false -> do
                            effect_error_code: string <- case effect_result.error_code == "" of {
                                true -> "E3000";
                                false -> effect_result.error_code
                            };
                            effect_spec_section: string <- case effect_result.spec_section == "" of {
                                true -> "sect9";
                                false -> effect_result.spec_section
                            };
                            diagnostics_core@print_compiler_error("EffectError", effect_error_code, effect_result.error_location, effect_result.error_message, effect_spec_section);
                            1
                        end
                    }
                end;
                false -> do
                    error_code: string <- case tc_out.error_code == "" of {
                        true -> "E2000";
                        false -> tc_out.error_code
                    };
                    spec_section: string <- case tc_out.spec_section == "" of {
                        true -> "sect6";
                        false -> tc_out.spec_section
                    };
                    diagnostics_core@print_compiler_error("TypeError", error_code, tc_out.error_location, tc_out.error_message, spec_section);
                    1
                end
            }
        end
    }
}

// Lex + parse one file, then compile with an empty module world (no cross-file `use`).
fn compile_file(filename: string) -> int64 proc[DeviceIO] {
    println("Compiling ");
    print(filename);
    println("...");
    println("  Lexing...");
    tokens: ListToken <- lexer_runner@lexer_runner(filename);
    // Token debug disabled to reduce noise
    _: int64 <- case debug_compile(filename) of {
        true -> 0;
        false -> 0
    };
    println("  Parsing...");
    parse_result: ParseResult <- parser_runner@parse_program(tokens);
    _: int64 <- case debug_compile(filename) of {
        true -> 0;
        false -> 0
    };
    case parse_result.is_ok of {
        true -> compile_parsed_unit(filename, parse_result.program, type_checker_modules@empty_named_program_list(), cons_string(filename, empty_list_string()), cons_parsed_file(filename, parse_result.program, empty_parsed_files()));
        false -> do
            error_code: string <- case parse_result.error_code == "" of {
                true -> "E1001";
                false -> parse_result.error_code
            };
            spec_section: string <- case parse_result.spec_section == "" of {
                true -> "sect3";
                false -> parse_result.spec_section
            };
            diagnostics_core@print_compiler_error("ParseError", error_code, parse_result.error_location, parse_result.error_message, spec_section);
            1
        end
    }
}

// Parse each file once, then compile in dependency order with the module world (spec §19).
fn compile_all_files(sorted_files: ListString) -> int64 proc[DeviceIO] {
    case sorted_files.is_nil of {
        true -> 0;
        false -> do
            (ok_parse: bool, parsed_all: ListParsedFile) <- parse_all_files_recursive(sorted_files, empty_parsed_files());
            case ok_parse of {
                false -> 1;
                true -> compile_parsed_list(sorted_files, parsed_all, sorted_files)
            }
        end
    }
}

// Main: read config, parse, sort by deps, compile
fn main() -> int64 proc[DeviceIO] {
    config_path: string <- "silica.config";
    config_exists: bool <- file_exists(config_path);
    content: string <- case config_exists of {
        true -> read_lines(config_path);
        false -> ""
    };
    files_rev: ListString <- case len(content) > 0 of {
        true -> parse_config_lines(content, 0, empty_list_string());
        false -> empty_list_string()
    };
    files: ListString <- reverse_list_string(files_rev);
    case list_string_length(files) == 0 of {
        true -> do
            println("Error: silica.config not found or empty. Create silica.config with one .silica file per line.");
            1
        end;
        false -> do
            validation: int64 <- validate_config_files(files);
            case validation != 0 of {
                true -> 1;
                false -> do
                    println("Files to compile: ");
                    print_int64(list_string_length(files));
                    println("");
                    sorted_files: ListString <- topological_sort(files);
                    compile_all_files(sorted_files)
                end
            }
        end
    }
}
