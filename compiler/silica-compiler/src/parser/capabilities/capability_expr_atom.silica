// Capability: atom literal as expression
// Atom literals (:ok, :error, etc.) as body_expr and operand

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes: 9 body_expr (shared), 12 operand (from expr_int64_ops), 17 atom_literal
// 7 left_brace, 8 right_brace from fn_decl (prev/next for body context)
fn role_body_expr() -> int64 { 9 }
fn role_operand() -> int64 { 12 }
fn role_atom_literal() -> int64 { 17 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> ListInt {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn constraints() -> ListConstraint {
    // atom_literal (as body_expr) -> next must be right_brace; prev must be left_brace
    c: Constraint <- Constraint { trigger_role: role_atom_literal(), next_token_roles: single_role(role_right_brace()), prev_token_roles: single_role(role_left_brace()), constraint_id: 17 };
    constraint_core@cons_constraint(c, constraint_core@empty_list_constraint())
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.atom_literal of {
        true -> three_roles(role_atom_literal(), role_body_expr(), role_operand());
        false -> constraint_core@empty_list_int()
    }
}
