// Capability: fn name ( ) -> type { body }
// Function declaration with empty params, return type, braces

use lexer_core;
use lexer_token_kind;
use constraint_core;
use capability_tuple_decompose;
use capability_case;
use capability_list;
use capability_trait;

export constraints/0;
export initial_roles/1;
export role_fn_keyword/0;
export role_fn_name/0;
export role_proc_keyword/0;
export role_left_bracket/0;
export role_right_bracket/0;
export role_effect_name/0;
export role_effect_param_rparen/0;

// Role codes for fn_decl (parser design §6)
// 1 fn_keyword, 2 fn_name, 3 left_paren, 4 right_paren, 5 right_arrow
// 6 type_name, 7 left_brace, 8 right_brace, 9 body_expr (shared with expr_literal)
// 17 proc_keyword, 18 left_bracket, 19 effect_name, 20 right_bracket, 21 effect_comma
// 22 effect_param_lparen, 23 effect_param_rparen, 24 effect_param_name
// 25 param_name, 26 param_colon, 27 param_type, 28 param_comma (user-defined fn params)

fn role_fn_keyword() -> int64 { 1 }
fn role_fn_name() -> int64 { 2 }
fn role_left_paren() -> int64 { 3 }
fn role_right_paren() -> int64 { 4 }
fn role_right_arrow() -> int64 { 5 }
fn role_type_name() -> int64 { 6 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_body_expr() -> int64 { 9 }
fn role_proc_keyword() -> int64 { 17 }
fn role_left_bracket() -> int64 { 18 }
fn role_effect_name() -> int64 { 19 }
fn role_right_bracket() -> int64 { 20 }
fn role_effect_comma() -> int64 { 21 }
fn role_effect_param_lparen() -> int64 { 22 }
fn role_effect_param_rparen() -> int64 { 23 }
fn role_effect_param_name() -> int64 { 24 }
fn role_tuple_type_lparen() -> int64 { 44 }
fn role_param_name() -> int64 { 25 }
fn role_param_colon() -> int64 { 26 }
fn role_param_type() -> int64 { 27 }
fn role_param_comma() -> int64 { 28 }
fn role_stmt_sep() -> int64 { 55 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> ListInt {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> ListInt {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn no_prev() -> ListInt {
    constraint_core@empty_list_int()
}

fn constraints() -> ListConstraint {
    c1: Constraint <- Constraint { trigger_role: role_fn_keyword(), next_token_roles: single_role(role_fn_name()), prev_token_roles: no_prev(), constraint_id: 1 };
    c2: Constraint <- Constraint { trigger_role: role_fn_name(), next_token_roles: single_role(role_left_paren()), prev_token_roles: single_role(role_fn_keyword()), constraint_id: 2 };
    c3: Constraint <- Constraint { trigger_role: role_left_paren(), next_token_roles: three_roles(role_right_paren(), role_param_name(), capability_tuple_decompose@role_td_lparen()), prev_token_roles: single_role(role_fn_name()), constraint_id: 3 };
    c4: Constraint <- Constraint { trigger_role: role_right_paren(), next_token_roles: single_role(role_right_arrow()), prev_token_roles: three_roles(role_left_paren(), role_param_type(), capability_tuple_decompose@role_td_rparen()), constraint_id: 4 };
    c5: Constraint <- Constraint { trigger_role: role_right_arrow(), next_token_roles: two_roles(role_type_name(), capability_list@role_list_type_kw()), prev_token_roles: single_role(role_right_paren()), constraint_id: 5 };
    // proc[...] only allowed on sequence clauses (spec §9.3.1); reject proc after return type
    // Required trait methods end with `-> type ;` instead of `{` (silica-specification §3.4.8).
    c6: Constraint <- Constraint { trigger_role: role_type_name(), next_token_roles: three_roles(role_left_brace(), role_tuple_type_lparen(), role_stmt_sep()), prev_token_roles: single_role(role_right_arrow()), constraint_id: 6 };
    c7: Constraint <- Constraint { trigger_role: role_left_brace(), next_token_roles: three_roles(role_body_expr(), role_right_brace(), capability_case@role_case_keyword()), prev_token_roles: three_roles(role_type_name(), role_right_bracket(), capability_list@role_list_type_rbracket()), constraint_id: 7 };
    c8: Constraint <- Constraint { trigger_role: role_body_expr(), next_token_roles: single_role(role_right_brace()), prev_token_roles: single_role(role_left_brace()), constraint_id: 8 };
    c9: Constraint <- Constraint { trigger_role: role_right_brace(), next_token_roles: no_prev(), prev_token_roles: two_roles(role_body_expr(), role_left_brace()), constraint_id: 9 };
    c10: Constraint <- Constraint { trigger_role: role_proc_keyword(), next_token_roles: single_role(role_left_bracket()), prev_token_roles: single_role(role_type_name()), constraint_id: 17 };
    c11: Constraint <- Constraint { trigger_role: role_left_bracket(), next_token_roles: single_role(role_effect_name()), prev_token_roles: single_role(role_proc_keyword()), constraint_id: 18 };
    c12: Constraint <- Constraint { trigger_role: role_effect_name(), next_token_roles: three_roles(role_right_bracket(), role_effect_comma(), role_effect_param_lparen()), prev_token_roles: two_roles(role_left_bracket(), role_effect_comma()), constraint_id: 19 };
    c13: Constraint <- Constraint { trigger_role: role_right_bracket(), next_token_roles: single_role(role_left_brace()), prev_token_roles: two_roles(role_effect_name(), role_effect_param_rparen()), constraint_id: 20 };
    c14: Constraint <- Constraint { trigger_role: role_effect_comma(), next_token_roles: single_role(role_effect_name()), prev_token_roles: two_roles(role_effect_name(), role_effect_param_rparen()), constraint_id: 21 };
    c15: Constraint <- Constraint { trigger_role: role_effect_param_lparen(), next_token_roles: single_role(role_effect_param_name()), prev_token_roles: single_role(role_effect_name()), constraint_id: 22 };
    c16: Constraint <- Constraint { trigger_role: role_effect_param_name(), next_token_roles: single_role(role_effect_param_rparen()), prev_token_roles: single_role(role_effect_param_lparen()), constraint_id: 23 };
    c17: Constraint <- Constraint { trigger_role: role_effect_param_rparen(), next_token_roles: two_roles(role_right_bracket(), role_effect_comma()), prev_token_roles: single_role(role_effect_param_name()), constraint_id: 24 };
    c18: Constraint <- Constraint { trigger_role: role_param_name(), next_token_roles: single_role(role_param_colon()), prev_token_roles: two_roles(role_left_paren(), role_param_comma()), constraint_id: 25 };
    c19: Constraint <- Constraint { trigger_role: role_param_colon(), next_token_roles: two_roles(role_param_type(), capability_list@role_list_type_kw()), prev_token_roles: single_role(role_param_name()), constraint_id: 26 };
    c20: Constraint <- Constraint { trigger_role: role_param_type(), next_token_roles: two_roles(role_right_paren(), role_param_comma()), prev_token_roles: single_role(role_param_colon()), constraint_id: 27 };
    c21: Constraint <- Constraint { trigger_role: role_param_comma(), next_token_roles: single_role(role_param_name()), prev_token_roles: single_role(role_param_type()), constraint_id: 28 };
    base: ListConstraint <- constraint_core@cons_constraint(c21, constraint_core@empty_list_constraint());
    with_c20: ListConstraint <- constraint_core@cons_constraint(c20, base);
    with_c19: ListConstraint <- constraint_core@cons_constraint(c19, with_c20);
    with_c18: ListConstraint <- constraint_core@cons_constraint(c18, with_c19);
    with_c17: ListConstraint <- constraint_core@cons_constraint(c17, with_c18);
    with_c16: ListConstraint <- constraint_core@cons_constraint(c16, with_c17);
    with_c15: ListConstraint <- constraint_core@cons_constraint(c15, with_c16);
    with_c14: ListConstraint <- constraint_core@cons_constraint(c14, with_c15);
    with_c13: ListConstraint <- constraint_core@cons_constraint(c13, with_c14);
    with_c12: ListConstraint <- constraint_core@cons_constraint(c12, with_c13);
    with_c11: ListConstraint <- constraint_core@cons_constraint(c11, with_c12);
    with_c10: ListConstraint <- constraint_core@cons_constraint(c10, with_c11);
    with_c9: ListConstraint <- constraint_core@cons_constraint(c9, with_c10);
    with_c8: ListConstraint <- constraint_core@cons_constraint(c8, with_c9);
    with_c7: ListConstraint <- constraint_core@cons_constraint(c7, with_c8);
    with_c6: ListConstraint <- constraint_core@cons_constraint(c6, with_c7);
    with_c5: ListConstraint <- constraint_core@cons_constraint(c5, with_c6);
    with_c4: ListConstraint <- constraint_core@cons_constraint(c4, with_c5);
    with_c3: ListConstraint <- constraint_core@cons_constraint(c3, with_c4);
    with_c2: ListConstraint <- constraint_core@cons_constraint(c2, with_c3);
    with_c1: ListConstraint <- constraint_core@cons_constraint(c1, with_c2);
    with_c1
}

fn is_type_keyword(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.int8_keyword or token_kind == kinds.int16_keyword or token_kind == kinds.int32_keyword or token_kind == kinds.int64_keyword or token_kind == kinds.uint8_keyword or token_kind == kinds.uint16_keyword or token_kind == kinds.uint32_keyword or token_kind == kinds.uint64_keyword or token_kind == kinds.float16_keyword or token_kind == kinds.float32_keyword or token_kind == kinds.float64_keyword or token_kind == kinds.bool_keyword or token_kind == kinds.char_keyword or token_kind == kinds.string_keyword or token_kind == kinds.bytes_keyword or token_kind == kinds.unit_keyword or token_kind == kinds.atom_keyword or token_kind == kinds.ref_keyword or token_kind == kinds.region_keyword or token_kind == kinds.buf_keyword or token_kind == kinds.atomic_keyword or token_kind == kinds.normal_keyword or token_kind == kinds.normal_writeback_keyword or token_kind == kinds.normal_writethrough_keyword or token_kind == kinds.normal_noncacheable_keyword or token_kind == kinds.device_keyword or token_kind == kinds.actor_ref_keyword or token_kind == kinds.dangerous_actor_ref_keyword or token_kind == kinds.supervisor_ref_keyword or token_kind == kinds.failure_reason_keyword
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.fn_keyword of {
        true -> single_role(role_fn_keyword());
        false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, token_kind) of {
            true -> constraint_core@cons_int(role_param_name(), four_roles(role_fn_name(), role_type_name(), role_effect_name(), role_effect_param_name()));
            false -> case is_type_keyword(kinds, token_kind) of {
                true -> two_roles(role_type_name(), role_param_type());
                false -> case token_kind == kinds.left_paren of {
                    true -> two_roles(role_left_paren(), role_effect_param_lparen());
                    false -> case token_kind == kinds.right_paren of {
                        true -> two_roles(role_right_paren(), role_effect_param_rparen());
                        false -> case token_kind == kinds.right_arrow of {
                            true -> single_role(role_right_arrow());
                            false -> case token_kind == kinds.proc_keyword of {
                                true -> single_role(role_proc_keyword());
                                false -> case token_kind == kinds.left_bracket of {
                                    true -> single_role(role_left_bracket());
                                    false -> case token_kind == kinds.right_bracket of {
                                        true -> single_role(role_right_bracket());
                                        false -> case token_kind == kinds.comma of {
                                            true -> two_roles(role_effect_comma(), role_param_comma());
                                            false -> case token_kind == kinds.colon of {
                                                true -> single_role(role_param_colon());
                                                false -> case token_kind == kinds.left_brace of {
                                                    true -> three_roles(role_left_brace(), capability_trait@role_required_block_lbrace(), capability_trait@role_provided_block_lbrace());
                                                    false -> case token_kind == kinds.right_brace of {
                                                        true -> single_role(role_right_brace());
                                                        false -> constraint_core@empty_list_int()
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
