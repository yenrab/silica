// Capability: int64/float64 operators, print_int64, print_float64, printString
// (print_float32 in capability_expr_float32)
// Arithmetic: +, -, *, /, %
// Comparison: <, >, <=, >=, ==, !=
// Function call: print_int64(expr), print_float64(expr), printString(string)
// Unary builtins: negate_<type>(expr) for int8–int64 and float16–float64 only (lexer kinds; see capability_expr_negate_builtin.silica)

use lexer_core;
use lexer_token_kind;
use constraint_core;
use capability_case;
use capability_list;

export constraints/0;
export initial_roles/1;

// Role codes (12-16, fn_decl uses 1-8, expr_literal uses 9-11)
// 233-234: module-qualified calls module@fn(args) (silica-specification §3.3.2)
fn role_operand() -> int64 { 12 }
fn role_op() -> int64 { 13 }
fn role_call_name() -> int64 { 14 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }
fn role_qual_module_name() -> int64 { 233 }
fn role_qual_at_sign() -> int64 { 234 }
// Matches capability_case.role_case_rhs_lparen (123); used only in qual_module prev set.
fn role_case_rhs_lparen_slot() -> int64 { 123 }
fn role_stmt_sep() -> int64 { 55 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
// Same code as capability_expr_float32.role_comma / comma in argument lists (spawn 3rd arg, etc.)
fn role_comma() -> int64 { 17 }

fn single_role(r: int64) -> ListInt {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> ListInt {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> ListInt {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> ListInt {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> ListInt {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn six_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64) -> ListInt {
    constraint_core@cons_int(r1, five_roles(r2, r3, r4, r5, r6))
}

fn seven_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64) -> ListInt {
    constraint_core@cons_int(r1, six_roles(r2, r3, r4, r5, r6, r7))
}

fn operand_next() -> ListInt {
    constraint_core@cons_int(role_op(), five_roles(role_right_brace(), role_call_rparen(), role_stmt_sep(), capability_case@role_case_of(), capability_case@role_case_branch_arrow()))
}

fn operand_prev() -> ListInt {
    constraint_core@cons_int(role_left_brace(), four_roles(role_op(), role_call_lparen(), role_stmt_sep(), capability_case@role_case_keyword()))
}

fn constraints() -> ListConstraint {
    // left_brace can be followed by operand, call_name, module qualifier (mod@fn), or case (extends fn_decl)
    c1: Constraint <- Constraint { trigger_role: role_left_brace(), next_token_roles: four_roles(role_operand(), role_call_name(), role_qual_module_name(), capability_case@role_case_keyword()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 20 };
    // right_brace can be preceded by operand or call_rparen (extends fn_decl)
    c2: Constraint <- Constraint { trigger_role: role_right_brace(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: two_roles(role_operand(), role_call_rparen()), constraint_id: 21 };
    // operand: in binary expr or call arg
    c3: Constraint <- Constraint { trigger_role: role_operand(), next_token_roles: operand_next(), prev_token_roles: operand_prev(), constraint_id: 22 };
    // op: between two operands; unary minus after case keyword uses op role with prev case_keyword
    c4: Constraint <- Constraint { trigger_role: role_op(), next_token_roles: single_role(role_operand()), prev_token_roles: two_roles(role_operand(), capability_case@role_case_keyword()), constraint_id: 23 };
    // qual_module_name: first identifier in mod@fn(...); prefixes include case scrutinee, branch RHS, and call arg lists (silica-spec §3.3.2).
    c_qual_m: Constraint <- Constraint { trigger_role: role_qual_module_name(), next_token_roles: single_role(role_qual_at_sign()), prev_token_roles: seven_roles(role_left_brace(), role_stmt_sep(), capability_case@role_case_keyword(), role_comma(), capability_case@role_case_branch_arrow(), role_call_lparen(), role_case_rhs_lparen_slot()), constraint_id: 27 };
    // qual_at_sign: must sit between module and function identifiers
    c_qual_at: Constraint <- Constraint { trigger_role: role_qual_at_sign(), next_token_roles: single_role(role_call_name()), prev_token_roles: single_role(role_qual_module_name()), constraint_id: 28 };
    // call_name: identifier in body, followed by ( or generic [; can follow left_brace, stmt_sep, case, comma, or @ in mod@fn (multi-arg calls and spawn placement: core_id(...), core_set[...](...))
    c5: Constraint <- Constraint { trigger_role: role_call_name(), next_token_roles: two_roles(role_call_lparen(), capability_list@role_call_gen_lbracket()), prev_token_roles: five_roles(role_left_brace(), role_stmt_sep(), capability_case@role_case_keyword(), role_comma(), role_qual_at_sign()), constraint_id: 24 };
    // call_lparen: after call_name or after ] closing generic type args
    c6: Constraint <- Constraint { trigger_role: role_call_lparen(), next_token_roles: single_role(role_operand()), prev_token_roles: two_roles(role_call_name(), capability_list@role_call_gen_rbracket()), constraint_id: 25 };
    // call_rparen: after operand, before right_brace, stmt_sep, or case branch arrow (guard)
    c7: Constraint <- Constraint { trigger_role: role_call_rparen(), next_token_roles: three_roles(role_right_brace(), role_stmt_sep(), capability_case@role_case_branch_arrow()), prev_token_roles: single_role(role_operand()), constraint_id: 26 };
    tail_qa: ListConstraint <- constraint_core@cons_constraint(c7, constraint_core@empty_list_constraint());
    tail_qat: ListConstraint <- constraint_core@cons_constraint(c_qual_at, tail_qa);
    tail_qm: ListConstraint <- constraint_core@cons_constraint(c_qual_m, tail_qat);
    tail_c6: ListConstraint <- constraint_core@cons_constraint(c6, tail_qm);
    tail_c5: ListConstraint <- constraint_core@cons_constraint(c5, tail_c6);
    tail_c4: ListConstraint <- constraint_core@cons_constraint(c4, tail_c5);
    tail_c3: ListConstraint <- constraint_core@cons_constraint(c3, tail_c4);
    tail_c2: ListConstraint <- constraint_core@cons_constraint(c2, tail_c3);
    constraint_core@cons_constraint(c1, tail_c2)
}

fn is_arithmetic_op(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.plus or token_kind == kinds.minus or token_kind == kinds.star or token_kind == kinds.slash or token_kind == kinds.percent
}

fn is_comparison_op(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.less_than or token_kind == kinds.greater_than or token_kind == kinds.less_equal or token_kind == kinds.greater_equal or token_kind == kinds.equal_equal or token_kind == kinds.bang_equal
}

fn is_op_token(kinds: TokenKinds, token_kind: int64) -> bool {
    is_arithmetic_op(kinds, token_kind) or is_comparison_op(kinds, token_kind) or token_kind == kinds.and_keyword or token_kind == kinds.or_keyword
}

fn initial_roles(token_kind: int64) -> ListInt {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case token_kind == kinds.integer_literal of {
        true -> single_role(role_operand());
        false -> case token_kind == kinds.float_literal of {
            true -> single_role(role_operand());
            false -> case token_kind == kinds.true_literal of {
                true -> single_role(role_operand());
                false -> case token_kind == kinds.false_literal of {
                    true -> single_role(role_operand());
                    false -> case token_kind == kinds.and_keyword of {
                        true -> single_role(role_op());
                        false -> case token_kind == kinds.or_keyword of {
                            true -> single_role(role_op());
                            false -> case token_kind == kinds.string_literal of {
                                true -> single_role(role_operand());
                                false -> case lexer_token_kind@is_identifier_lexeme_token(kinds, token_kind) of {
                                    true -> three_roles(role_qual_module_name(), role_call_name(), role_operand());
                                    false -> case token_kind == kinds.at_sign of {
                                        true -> single_role(role_qual_at_sign());
                                        false -> case is_op_token(kinds, token_kind) of {
                                            true -> single_role(role_op());
                                            false -> case token_kind == kinds.left_paren of {
                                                true -> two_roles(role_call_lparen(), role_operand());
                                                false -> case token_kind == kinds.right_paren of {
                                                    true -> two_roles(role_call_rparen(), role_operand());
                                                    false -> constraint_core@empty_list_int()
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
