// Parser AST types - Program, Declaration, Expr
// Shared by parser, type checker, and SIR generator

use lexer_core;

export Program/0;
export NamedProgram/0;
export ListNamedProgram/0;
export empty_named_program_list/0;
export cons_named_program/3;
export find_named_program/2;
export Declaration/0;
export ListDeclaration/0;
export Param/0;
export ListParam/0;
export Expr/0;
export TypeName/0;
export EffectName/0;
export ListEffectName/0;
export TupleDecomposeBinding/0;
export ListTupleDecomposeBinding/0;
export zero_location/0;
export dummy_expr/0;
export dummy_decl/0;
export empty_list_decl/0;
export cons_declaration/2;
export nil_list_param/0;
export cons_param/2;
export list_param_reverse_with_acc/2;
export build_infer_type_bucket/2;
export param_list_normalize/1;
export rebuild_param/3;
export rebuild_effect_name/3;
export rebuild_tuple_decompose_binding_list/1;
export rebuild_effect_name_list/1;
export rebuild_param_list_from_lambda_bindings/1;
export declaration_from_lambda_lift/8;
export append_param_list/2;
export declaration_with_body/2;
export rebuild_param_list/1;
export dummy_effect_name/0;
export empty_effect_name_list/0;
export cons_effect_name/2;
export nil_tuple_decompose_bindings/0;
export cons_tuple_decompose_binding/2;
export make_tuple_decompose_binding/3;
export as_list_tuple_decompose_bindings/1;
export TupleDecomposeResult/0;
export tuple_decompose_result_bindings/1;

// Tuple decomposition pattern element: name and type from the pattern annotation.
struct TupleDecomposeBinding {
    name: string,
    path: string,
    type_str: string
}

struct ListTupleDecomposeBinding {
    is_nil: bool,
    head: TupleDecomposeBinding,
    tail: ListTupleDecomposeBinding
}

struct Param {
    name: string,
    type_name: string,
    location: SourceLocation
}

struct ListParam {
    is_nil: bool,
    head: Param,
    tail: ListParam
}

struct EffectName {
    name: string,
    parameter: string,
    location: SourceLocation
}

struct ListEffectName {
    is_nil: bool,
    head: EffectName,
    tail: ListEffectName
}

// Expr: kind 0 = integer literal, 1 = identifier, 2 = parenthesized, 3 = binary op, 4 = call, 5 = atom literal, 6 = let binding, 7 = boolean literal, 8 = string literal, 9 = tuple literal, 10 = tuple decomposition, 11 = sequence block, 12 = illegal unary minus (-expr); inner = operand, -1 = dummy (defined first for Declaration)
// kind 991 = anonymous function / lambda expression: inner = body (`extract_function_body` shape); value = `(T1,T2) -> R` function type string (same shape as build_function_type); pattern_bindings = TupleDecomposeBinding chain mirroring ListParam (name + type_str per formal); right_expr = kind 992 dummy carrying only return type text in `value` for lifting; sequence_effects = optional proc effects from signature.
// kind 992 = function type written in expression/generic-arg/tuple position (opaque): value = reconstructed type source text from parser_tuples@extract_fn_type_from_slots (e.g. `fn (...) -> (...)`) so `(int64, fn(msg: ...) -> (...))` is not parsed as value-tuple stmts under `(msg:)`.
// kind 995 = parse error marker (uncategorized syntactic defect / ParseErrorDefault): inner = recovered AST; location = diagnostic site; value holds error code "E1000".
// kind 996 = parse error marker (missing `;` between statements): inner = recovered AST; location = diagnostic site (e.g. closing `end` of sequence); value holds error code "E1040".
// kind 997 = parse error marker (illegal `;` after the last expression in a block / sequence region): inner = tail statement AST; location = first `;` token; value "E1041".
// kind 4 call: value holds generic type arguments when present (lexeme-joined inner of [...] before (), e.g. "int64 normal"); empty when not a generic call.
// kind 20 = list literal [a, b, ...]: List[...]; value = full type annotation text (e.g. "List[int64, normal]"); inner/right_expr chain matches tuple kind 9 shape (right-nested pairs), inner nodes use kind 20 with value "".
// kind 21 = struct literal (inline record value, §3.3.7): right-nested chain like kind 9; each node has name = field name, inner = field initializer expr; right_expr = next kind-21 node or dummy; value unused (anonymous literals only).
// kind 22 = field access (§3.3.x): inner = base expression, name = field identifier; value unused.
// kind 13 = case expression: inner = scrutinee, right_expr = branch list (kind 17) or dummy if empty
// kind 17 = case branch list node: inner = one branch (kind 18), right_expr = next list node (kind 17) or dummy
// kind 18 = single case branch: value = pattern source text, inner = guard (dummy if absent), right_expr = rhs expression
// kind 19 = if expression: inner = condition, right_expr = kind 9 tuple (then branch, else branch; else may be dummy if omitted)
// For kind 10 (tuple decomposition): pattern_bindings holds the structured pattern; value is unused.
// For kind 11 (sequence block): inner = body (statements before produces), right_expr = result (pure expr); sequence_effects = declared effects from proc[ε]; location = closing `end` keyword (for diagnostics).
struct Expr {
    kind: int64,
    value: string,
    name: string,
    location: SourceLocation,
    inner: Expr,
    right_expr: Expr,
    pattern_bindings: ListTupleDecomposeBinding,
    sequence_effects: ListEffectName
}

struct TypeName {
    name: string,
    location: SourceLocation
}

// Declaration: tag 0 = function declaration, tag 1 = effect alias, tag 2 = use (imports: parameters = module names),
// tag 3 = export (parameters: name = function, type_name = arity lexeme), tag 4 = module (name = module identifier),
// tag 5 = export trait (name = trait identifier), tag 6 = trait marker impl `impl Type;` (return_type_name holds type source text),
// tag 7 = required trait method signature only (same fields as tag 0 but body is dummy; silica-specification §3.4.8),
// tag 8 = wrapper_meta (name = sidecar path string literal lexeme),
// tag 9 = foreign c_wrapper binding (name = local fn name, return_type_name = return type, parameters = fn params,
//       body.value = C symbol string literal lexeme, body.name = optional per-binding meta path lexeme or "")
struct Declaration {
    tag: int64,
    name: string,
    parameters: ListParam,
    return_type_name: string,
    return_type_location: SourceLocation,
    location: SourceLocation,
    body: Expr,
    declared_effects: ListEffectName
}

struct ListDeclaration {
    is_nil: bool,
    head: Declaration,
    tail: ListDeclaration
}

// Program: root node with list of declarations
struct Program {
    declarations: ListDeclaration,
    location: SourceLocation
}

// Multi-module compilation: one other unit (module name = file stem) for cross-module type and trait checks.
struct NamedProgram {
    module_name: string,
    program: Program
}

struct ListNamedProgram {
    is_nil: bool,
    head: NamedProgram,
    tail: ListNamedProgram
}

fn zero_location() -> SourceLocation {
    SourceLocation { file: "", line: 0, column: 0, offset: 0 }
}

fn nil_tuple_decompose_bindings() -> ListTupleDecomposeBinding {
    dummy: TupleDecomposeBinding <- TupleDecomposeBinding { name: "", path: "", type_str: "" };
    nil_placeholder: ListTupleDecomposeBinding <- ListTupleDecomposeBinding { is_nil: true, head: dummy, tail: nil_placeholder };
    nil_placeholder
}

fn cons_tuple_decompose_binding(b: TupleDecomposeBinding, rest: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    ListTupleDecomposeBinding { is_nil: false, head: b, tail: rest }
}

fn make_tuple_decompose_binding(name: string, path: string, type_str: string) -> TupleDecomposeBinding {
    TupleDecomposeBinding { name: name, path: path, type_str: type_str }
}

fn as_list_tuple_decompose_bindings(b: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    b
}

fn dummy_expr() -> Expr {
    placeholder: Expr <- Expr { kind: -1, value: "", name: "", location: zero_location(), inner: placeholder, right_expr: placeholder, pattern_bindings: nil_tuple_decompose_bindings(), sequence_effects: empty_effect_name_list() };
    placeholder
}

fn nil_list_param() -> ListParam {
    dummy_param: Param <- Param { name: "", type_name: "", location: zero_location() };
    nil_placeholder: ListParam <- ListParam { is_nil: true, head: dummy_param, tail: nil_placeholder };
    nil_placeholder
}

fn cons_param(p: Param, rest: ListParam) -> ListParam {
    ListParam { is_nil: false, head: p, tail: rest }
}

fn list_param_reverse_with_acc(front: ListParam, acc: ListParam) -> ListParam {
    case front.is_nil of {
        true -> acc;
        false -> do
            stepped: ListParam <- cons_param(front.head, acc);
            list_param_reverse_with_acc(front.tail, stepped)
        end
    }
}

fn build_infer_type_bucket(inferred: string, rest: ListParam) -> ListParam {
    cons_param(Param { name: "_", type_name: inferred, location: zero_location() }, rest)
}

fn param_list_normalize(p: ListParam) -> ListParam {
    case p.is_nil of {
        true -> nil_list_param();
        false -> do
            hd: Param <- p.head;
            tail_norm: ListParam <- param_list_normalize(p.tail);
            cons_param(hd, tail_norm)
        end
    }
}

// Nominal rebuild helpers for AST copies produced outside this module (bootstrap assigns structural record types there).
fn rebuild_param(name: string, type_name: string, location: SourceLocation) -> Param {
    Param { name: name, type_name: type_name, location: location }
}

fn rebuild_param_list(src: ListParam) -> ListParam {
    case src.is_nil of {
        true -> nil_list_param();
        false -> cons_param(rebuild_param(src.head.name, src.head.type_name, src.head.location), rebuild_param_list(src.tail))
    }
}

fn rebuild_effect_name(name: string, parameter: string, location: SourceLocation) -> EffectName {
    EffectName { name: name, parameter: parameter, location: location }
}

fn rebuild_tuple_decompose_binding_list(src: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    case src.is_nil of {
        true -> nil_tuple_decompose_bindings();
        false -> cons_tuple_decompose_binding(make_tuple_decompose_binding(src.head.name, src.head.path, src.head.type_str), rebuild_tuple_decompose_binding_list(src.tail))
    }
}

fn rebuild_param_list_from_lambda_bindings(bindings: ListTupleDecomposeBinding) -> ListParam {
    case bindings.is_nil of {
        true -> nil_list_param();
        false -> cons_param(rebuild_param(bindings.head.name, bindings.head.type_str, zero_location()), rebuild_param_list_from_lambda_bindings(bindings.tail))
    }
}

fn append_param_list(a: ListParam, b: ListParam) -> ListParam {
    case a.is_nil of {
        true -> b;
        false -> cons_param(a.head, append_param_list(a.tail, b))
    }
}

fn dummy_decl() -> Declaration {
    Declaration { tag: -1, name: "", parameters: nil_list_param(), return_type_name: "", return_type_location: zero_location(), location: zero_location(), body: dummy_expr(), declared_effects: empty_effect_name_list() }
}

fn empty_list_decl() -> ListDeclaration {
    nil_placeholder: ListDeclaration <- ListDeclaration { is_nil: true, head: dummy_decl(), tail: nil_placeholder };
    nil_placeholder
}

fn cons_declaration(head_decl: Declaration, tail: ListDeclaration) -> ListDeclaration {
    ListDeclaration { is_nil: false, head: head_decl, tail: tail }
}

fn dummy_effect_name() -> EffectName {
    EffectName { name: "", parameter: "", location: zero_location() }
}

fn empty_effect_name_list() -> ListEffectName {
    nil_placeholder: ListEffectName <- ListEffectName { is_nil: true, head: dummy_effect_name(), tail: nil_placeholder };
    nil_placeholder
}

fn cons_effect_name(eff: EffectName, list: ListEffectName) -> ListEffectName {
    ListEffectName { is_nil: false, head: eff, tail: list }
}

fn rebuild_effect_name_list(src: ListEffectName) -> ListEffectName {
    case src.is_nil of {
        true -> empty_effect_name_list();
        false -> cons_effect_name(rebuild_effect_name(src.head.name, src.head.parameter, src.head.location), rebuild_effect_name_list(src.tail))
    }
}

fn declaration_from_lambda_lift(name: string, pattern_bindings: ListTupleDecomposeBinding, capture_params: ListParam, ret_ty: string, ret_loc: SourceLocation, loc: SourceLocation, body: Expr, seq_eff: ListEffectName) -> Declaration {
    formals_lp: ListParam <- rebuild_param_list_from_lambda_bindings(rebuild_tuple_decompose_binding_list(pattern_bindings));
    params_lp: ListParam <- append_param_list(formals_lp, capture_params);
    effs: ListEffectName <- rebuild_effect_name_list(seq_eff);
    Declaration { tag: 0, name: name, parameters: params_lp, return_type_name: ret_ty, return_type_location: ret_loc, location: loc, body: body, declared_effects: effs }
}

fn declaration_with_body(decl: Declaration, body: Expr) -> Declaration {
    Declaration { tag: decl.tag, name: decl.name, parameters: rebuild_param_list(decl.parameters), return_type_name: decl.return_type_name, return_type_location: decl.return_type_location, location: decl.location, body: body, declared_effects: rebuild_effect_name_list(decl.declared_effects) }
}

fn empty_named_program_list() -> ListNamedProgram {
    dummy_prog: Program <- Program { declarations: empty_list_decl(), location: zero_location() };
    dummy: NamedProgram <- NamedProgram { module_name: "", program: dummy_prog };
    nil_lp: ListNamedProgram <- ListNamedProgram { is_nil: true, head: dummy, tail: nil_lp };
    nil_lp
}

fn cons_named_program(name: string, prog: Program, rest: ListNamedProgram) -> ListNamedProgram {
    ListNamedProgram { is_nil: false, head: NamedProgram { module_name: name, program: prog }, tail: rest }
}

fn find_named_program(name: string, world: ListNamedProgram) -> (bool, Program) {
    case world.is_nil of {
        true -> (false, Program { declarations: empty_list_decl(), location: zero_location() });
        false -> case world.head.module_name == name of {
            true -> (true, world.head.program);
            false -> find_named_program(name, world.tail)
        }
    }
}
