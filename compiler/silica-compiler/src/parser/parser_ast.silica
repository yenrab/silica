// Parser AST types - Program, Declaration, Expr
// Shared by parser, type checker, and SIR generator

use lexer_core;

export Program/0;
export Declaration/0;
export ListDeclaration/0;
export Param/0;
export ListParam/0;
export Expr/0;
export TypeName/0;
export EffectName/0;
export ListEffectName/0;
export TupleDecomposeBinding/0;
export ListTupleDecomposeBinding/0;
export zero_location/0;
export dummy_expr/0;
export dummy_decl/0;
export empty_list_decl/0;
export nil_list_param/0;
export cons_param/2;
export dummy_effect_name/0;
export empty_effect_name_list/0;
export cons_effect_name/2;
export nil_tuple_decompose_bindings/0;
export cons_tuple_decompose_binding/2;
export make_tuple_decompose_binding/3;
export as_list_tuple_decompose_bindings/1;
export TupleDecomposeResult/0;
export tuple_decompose_result_bindings/1;

// Tuple decomposition pattern element: name and type from the pattern annotation.
struct TupleDecomposeBinding {
    name: string,
    path: string,
    type_str: string
}

struct ListTupleDecomposeBinding {
    is_nil: bool,
    head: TupleDecomposeBinding,
    tail: ListTupleDecomposeBinding
}

struct Param {
    name: string,
    type_name: string,
    location: SourceLocation
}

struct ListParam {
    is_nil: bool,
    head: Param,
    tail: ListParam
}

struct EffectName {
    name: string,
    parameter: string,
    location: SourceLocation
}

struct ListEffectName {
    is_nil: bool,
    head: EffectName,
    tail: ListEffectName
}

// Expr: kind 0 = integer literal, 1 = identifier, 2 = parenthesized, 3 = binary op, 4 = call, 5 = atom literal, 6 = let binding, 7 = boolean literal, 8 = string literal, 9 = tuple literal, 10 = tuple decomposition, 11 = sequence block, 12 = illegal unary minus (-expr); inner = operand, -1 = dummy (defined first for Declaration)
// kind 996 = parse error marker (missing `;` between statements): inner = recovered AST; location = diagnostic site (e.g. closing `end` of sequence); value holds error code "E1040".
// kind 997 = parse error marker (illegal `;` after the last expression in a block / sequence region): inner = tail statement AST; location = first `;` token; value "E1041".
// kind 4 call: value holds generic type arguments when present (lexeme-joined inner of [...] before (), e.g. "int64 normal"); empty when not a generic call.
// kind 20 = list literal [a, b, ...]: List[...]; value = full type annotation text (e.g. "List[int64, normal]"); inner/right_expr chain matches tuple kind 9 shape (right-nested pairs), inner nodes use kind 20 with value "".
// kind 21 = struct literal (inline record value, §3.3.7): right-nested chain like kind 9; each node has name = field name, inner = field initializer expr; right_expr = next kind-21 node or dummy; value unused (anonymous literals only).
// kind 22 = field access (§3.3.x): inner = base expression, name = field identifier; value unused.
// kind 13 = case expression: inner = scrutinee, right_expr = branch list (kind 17) or dummy if empty
// kind 17 = case branch list node: inner = one branch (kind 18), right_expr = next list node (kind 17) or dummy
// kind 18 = single case branch: value = pattern source text, inner = guard (dummy if absent), right_expr = rhs expression
// kind 19 = if expression: inner = condition, right_expr = kind 9 tuple (then branch, else branch; else may be dummy if omitted)
// For kind 10 (tuple decomposition): pattern_bindings holds the structured pattern; value is unused.
// For kind 11 (sequence block): inner = body (statements before produces), right_expr = result (pure expr); sequence_effects = declared effects from proc[ε]; location = closing `end` keyword (for diagnostics).
struct Expr {
    kind: int64,
    value: string,
    name: string,
    location: SourceLocation,
    inner: Expr,
    right_expr: Expr,
    pattern_bindings: ListTupleDecomposeBinding,
    sequence_effects: ListEffectName
}

struct TypeName {
    name: string,
    location: SourceLocation
}

// Declaration: tag 0 = function declaration
struct Declaration {
    tag: int64,
    name: string,
    parameters: ListParam,
    return_type_name: string,
    return_type_location: SourceLocation,
    location: SourceLocation,
    body: Expr,
    declared_effects: ListEffectName
}

struct ListDeclaration {
    is_nil: bool,
    head: Declaration,
    tail: ListDeclaration
}

// Program: root node with list of declarations
struct Program {
    declarations: ListDeclaration,
    location: SourceLocation
}

fn zero_location() -> SourceLocation {
    SourceLocation { file: "", line: 0, column: 0, offset: 0 }
}

fn nil_tuple_decompose_bindings() -> ListTupleDecomposeBinding {
    dummy: TupleDecomposeBinding <- TupleDecomposeBinding { name: "", path: "", type_str: "" };
    nil_placeholder: ListTupleDecomposeBinding <- ListTupleDecomposeBinding { is_nil: true, head: dummy, tail: nil_placeholder };
    nil_placeholder
}

fn cons_tuple_decompose_binding(b: TupleDecomposeBinding, rest: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    ListTupleDecomposeBinding { is_nil: false, head: b, tail: rest }
}

fn make_tuple_decompose_binding(name: string, path: string, type_str: string) -> TupleDecomposeBinding {
    TupleDecomposeBinding { name: name, path: path, type_str: type_str }
}

fn as_list_tuple_decompose_bindings(b: ListTupleDecomposeBinding) -> ListTupleDecomposeBinding {
    b
}

fn dummy_expr() -> Expr {
    placeholder: Expr <- Expr { kind: -1, value: "", name: "", location: zero_location(), inner: placeholder, right_expr: placeholder, pattern_bindings: nil_tuple_decompose_bindings(), sequence_effects: empty_effect_name_list() };
    placeholder
}

fn nil_list_param() -> ListParam {
    dummy_param: Param <- Param { name: "", type_name: "", location: zero_location() };
    nil_placeholder: ListParam <- ListParam { is_nil: true, head: dummy_param, tail: nil_placeholder };
    nil_placeholder
}

fn cons_param(p: Param, rest: ListParam) -> ListParam {
    ListParam { is_nil: false, head: p, tail: rest }
}

fn dummy_decl() -> Declaration {
    Declaration { tag: -1, name: "", parameters: nil_list_param(), return_type_name: "", return_type_location: zero_location(), location: zero_location(), body: dummy_expr(), declared_effects: empty_effect_name_list() }
}

fn empty_list_decl() -> ListDeclaration {
    nil_placeholder: ListDeclaration <- ListDeclaration { is_nil: true, head: dummy_decl(), tail: nil_placeholder };
    nil_placeholder
}

fn dummy_effect_name() -> EffectName {
    EffectName { name: "", parameter: "", location: zero_location() }
}

fn empty_effect_name_list() -> ListEffectName {
    nil_placeholder: ListEffectName <- ListEffectName { is_nil: true, head: dummy_effect_name(), tail: nil_placeholder };
    nil_placeholder
}

fn cons_effect_name(eff: EffectName, list: ListEffectName) -> ListEffectName {
    ListEffectName { is_nil: false, head: eff, tail: list }
}
