// Phase 9 link manifest: step 1 emits silica.link; step 3 validates prebuilt archives exist.

use sir_ast;
use parser_ast;
use module_checker_core;
use ffi_sidecar_loader;
use build_output;
use diagnostics_core;

export write_link_manifest_for_parsed/1;

fn append_sir_string_at_end(items: ListSirString, s: string) -> ListSirString {
    case items.is_nil of {
        true -> sir_ast@cons_sir_string(s, sir_ast@nil_sir_strings());
        false -> sir_ast@cons_sir_string(items.head, append_sir_string_at_end(items.tail, s))
    }
}

fn append_sir_string_unique_end(items: ListSirString, s: string) -> ListSirString {
    case len(s) == 0 of {
        true -> items;
        false -> case sir_ast@sir_string_list_contains(items, s) of {
            true -> items;
            false -> append_sir_string_at_end(items, s)
        }
    }
}

fn merge_sir_strings_unique_end(acc: ListSirString, add: ListSirString) -> ListSirString {
    case add.is_nil of {
        true -> acc;
        false -> merge_sir_strings_unique_end(append_sir_string_unique_end(acc, add.head), add.tail)
    }
}

fn collect_closure_link_libraries(parsed: ListParsedFile, acc: ListSirString) -> ListSirString proc[DeviceIO] {
    case parsed.is_nil of {
        true -> acc;
        false -> do
            unit_libs: ListSirString <- ffi_sidecar_loader@collect_program_link_libraries(parsed.head.program);
            merged: ListSirString <- merge_sir_strings_unique_end(acc, unit_libs);
            collect_closure_link_libraries(parsed.tail, merged)
        end
    }
}

fn collect_closure_foreign_symbols(parsed: ListParsedFile, acc: ListSirString) -> ListSirString {
    case parsed.is_nil of {
        true -> acc;
        false -> do
            unit_syms: ListSirString <- ffi_sidecar_loader@collect_program_foreign_symbols(parsed.head.program);
            merged: ListSirString <- merge_sir_strings_unique_end(acc, unit_syms);
            collect_closure_foreign_symbols(parsed.tail, merged)
        end
    }
}

fn archive_path_for_link_library(lib_name: string) -> string {
    concat(concat("dangerous_exposure_source/lib/lib", lib_name), ".a")
}

fn link_manifest_line_link_library(lib_name: string) -> string {
    concat(concat("link_library: \"", lib_name), "\"\n")
}

fn link_manifest_line_archive(lib_name: string) -> string {
    concat(concat("archive: \"", archive_path_for_link_library(lib_name)), "\"\n")
}

fn link_manifest_line_symbol(sym: string) -> string {
    concat(concat("symbol: \"", sym), "\"\n")
}

fn link_manifest_text_for_libraries(libs: ListSirString) -> string {
    case libs.is_nil of {
        true -> "";
        false -> concat(link_manifest_line_link_library(libs.head), concat(link_manifest_line_archive(libs.head), link_manifest_text_for_libraries(libs.tail)))
    }
}

fn link_manifest_text_for_symbols(symbols: ListSirString) -> string {
    case symbols.is_nil of {
        true -> "";
        false -> concat(link_manifest_line_symbol(symbols.head), link_manifest_text_for_symbols(symbols.tail))
    }
}

fn build_link_manifest_text(link_libraries: ListSirString, symbols: ListSirString) -> string {
    concat(link_manifest_text_for_libraries(link_libraries), link_manifest_text_for_symbols(symbols))
}

fn closure_needs_link_manifest(link_libraries: ListSirString, symbols: ListSirString) -> bool {
    case link_libraries.is_nil of {
        false -> true;
        true -> case symbols.is_nil of {
            false -> true;
            true -> false
        }
    }
}

fn location_is_set(loc: SourceLocation) -> bool {
    case loc.line == 0 of {
        false -> true;
        true -> case len(loc.file) == 0 of {
            false -> true;
            true -> false
        }
    }
}

fn first_ffi_location_in_parsed(parsed: ListParsedFile) -> SourceLocation {
    case parsed.is_nil of {
        true -> parser_ast@zero_location();
        false -> do
            loc: SourceLocation <- ffi_sidecar_loader@first_foreign_or_meta_location_from_program(parsed.head.program);
            case location_is_set(loc) of {
                true -> loc;
                false -> first_ffi_location_in_parsed(parsed.tail)
            }
        end
    }
}

fn print_link_manifest_error(code: string, loc: SourceLocation, msg: string) -> int64 proc[DeviceIO] {
    _: int8 <- diagnostics_core@print_compiler_error("ModuleError", code, loc, msg, "sect14.2");
    1
}

fn validate_one_archive_exists(lib_name: string, loc: SourceLocation) -> int64 proc[DeviceIO] {
    path: string <- archive_path_for_link_library(lib_name);
    exists: bool <- file_exists(path);
    case exists of {
        false -> do
            p1: string <- concat("prebuilt library archive not found: ", path);
            msg: string <- concat(p1, " (spec 14.2)");
            print_link_manifest_error("E4034", loc, msg)
        end;
        true -> 0
    }
}

fn validate_archives_exist_loop(libs: ListSirString, loc: SourceLocation) -> int64 proc[DeviceIO] {
    case libs.is_nil of {
        true -> 0;
        false -> do
            st: int64 <- validate_one_archive_exists(libs.head, loc);
            case st != 0 of {
                true -> st;
                false -> validate_archives_exist_loop(libs.tail, loc)
            }
        end
    }
}

export write_link_manifest_for_parsed/1;

fn write_link_manifest_for_parsed(parsed: ListParsedFile) -> int64 proc[DeviceIO] {
    link_libraries: ListSirString <- collect_closure_link_libraries(parsed, sir_ast@nil_sir_strings());
    symbols: ListSirString <- collect_closure_foreign_symbols(parsed, sir_ast@nil_sir_strings());
    case closure_needs_link_manifest(link_libraries, symbols) of {
        false -> build_output@write_link_manifest("");
        true -> do
            diag_loc: SourceLocation <- first_ffi_location_in_parsed(parsed);
            arch_st: int64 <- validate_archives_exist_loop(link_libraries, diag_loc);
            case arch_st != 0 of {
                true -> arch_st;
                false -> do
                    manifest: string <- build_link_manifest_text(link_libraries, symbols);
                    build_output@write_link_manifest(manifest)
                end
            }
        end
    }
}
