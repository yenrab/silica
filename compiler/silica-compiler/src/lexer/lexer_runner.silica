// Main lexer runner - tokenizes an entire source file
// Returns a list of tokens from the file

// Import lexer modules
use lexer_core;
use lexer_token_kind;
use lexer_keywords;
use lexer_integer_literals;
use lexer_float_literals;
use lexer_atom_literals;
use lexer_string_literals;
use lexer_operators;
use lexer_comments;


// Export module function
export lexer_runner/1;


{-
- Represents a list of tokens as a linked structure: either nil (is_nil true, empty list) or a cons cell (is_nil false, head is the first Token, tail is the rest of the list).
- Used by the lexer runner to accumulate the result of tokenize: start with a nil ListToken and cons each token as it is read until EOF. The parser or other phases can then traverse the list to process tokens in order. Fits into the design as the concrete type for "list of Token" in the lexer output.
- Example: an empty token list is a ListToken with is_nil true (head and tail are unused or sentinel for the nil case).
- Example: a list containing one token t is a ListToken with is_nil false, head t, tail a nil ListToken.
- Example: a list of three tokens t1, t2, t3 is cons(t1, cons(t2, cons(t3, nil))).
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
struct ListToken {
    is_nil: bool,
    head: Token,
    tail: ListToken
}


{-
- Tokenizes source from the current lexer position to EOF: skips whitespace and line comments, then either emits an EOF token and returns it consed onto the accumulator, or reads one token (identifier/keyword, integer literal, arrow, grouping, or unknown-char), conses it onto the accumulator, and recurses. Returns the accumulated ListToken (tokens are in reverse of reading order; the last token read is at the head).
- Entry point for full-file tokenization: call with a fresh lexer and a nil ListToken; the function drives the lexer by dispatching on the current character to the appropriate reader (read_identifier, read_integer_literal, read_arrow, read_grouping_operator) and recurses until EOF. Fits into the design as the main loop that produces the token list for the parser.
- Example: lexer at EOF with tokens nil — returns ListToken with head eof token and tail nil (single eof in list).
- Example: lexer at "fn x" — skips whitespace (none), reads identifier "fn", conses it onto tokens, recurses; then reads "x", conses, recurses; then EOF, conses eof; result list has eof, "x", "fn" in head-to-tail order (reverse of read order).
- Example: lexer at "42 (" — reads integer "42", then "(", then EOF; result list includes integer_literal, left_paren, eof.
- Time: O(n), Ω(n), Θ(n) where n is the number of source characters (each character consumed or skipped once; one recursion per token). Space: O(t), Ω(1), Θ(t) for the ListToken chain (t = number of tokens) plus recursion depth.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn tokenize(lexer: Lexer, tokens: ListToken) -> ListToken proc[DeviceIO] {//this function is too deeply nested and needs to be refactored
    do
        // Skip whitespace and comments
        skipped: Lexer <- lexer_core@skip_whitespace(lexer);
        after_comments: Lexer <- case lexer_comments@is_line_comment_start(skipped) of {
            true -> lexer_comments@skip_line_comment(lexer_core@advance(lexer_core@advance(skipped)));
            false -> skipped
        };
        
        current: string <- lexer_core@peek_char(after_comments);
        
        {- DEBUG: Print peek_char result before pattern matching
        println("DEBUG peek_char pos=");
        print_int64(after_comments.position);
        println(" current=[");
        println(current);
        println("]");
        -}
        
        // Check for EOF: use len() to avoid reliance on string equality for "" (robust against
        // empty-string representation differences between substring result and literal "")
        is_empty: bool <- len(current) == 0;
        case is_empty of {
            true -> do
                kinds: TokenKinds <- lexer_token_kind@token_kinds();
                eof_location: SourceLocation <- lexer_core@current_location(after_comments);
                eof_token: Token <- lexer_core@make_token(kinds.eof, "", eof_location);
                ListToken { is_nil: false, head: eof_token, tail: tokens }
            end;
            false -> case current of {
                " " -> do
                    // Workaround: skip_whitespace sometimes doesn't skip space (bootstrap bug?)
                    advanced: Lexer <- lexer_core@advance(after_comments);
                    tokenize(advanced, tokens)
                end;
                "\t" -> do
                    advanced: Lexer <- lexer_core@advance(after_comments);
                    tokenize(advanced, tokens)
                end;
                "\n" -> do
                    advanced: Lexer <- lexer_core@advance(after_comments);
                    tokenize(advanced, tokens)
                end;
                "\r" -> do
                    advanced: Lexer <- lexer_core@advance(after_comments);
                    tokenize(advanced, tokens)
                end;
                _: string -> do
                    // Determine token type and read it
                    token_and_lexer: (Token, Lexer) <- case lexer_keywords@is_identifier_start(current) of {
                        true -> lexer_keywords@read_identifier(after_comments);
                        false -> case lexer_integer_literals@is_decimal_digit_char(current) of {
                            true -> lexer_float_literals@read_numeric_literal(after_comments);
                            false -> case current of {
                                ":" -> lexer_atom_literals@read_colon_or_atom_literal(after_comments);
                                "\"" -> lexer_string_literals@read_string_literal(after_comments);
                                "'" -> lexer_string_literals@read_char_literal(after_comments);
                                "-" -> lexer_operators@read_arrow(after_comments);
                                "(" -> lexer_operators@read_grouping_operator(after_comments, "(");
                                ")" -> lexer_operators@read_grouping_operator(after_comments, ")");
                                "{" -> lexer_operators@read_grouping_operator(after_comments, "{");
                                "}" -> lexer_operators@read_grouping_operator(after_comments, "}");
                                "[" -> lexer_operators@read_grouping_operator(after_comments, "[");
                                "]" -> lexer_operators@read_grouping_operator(after_comments, "]");
                                "," -> lexer_operators@read_grouping_operator(after_comments, ",");
                                ";" -> lexer_operators@read_grouping_operator(after_comments, ";");
                                "." -> lexer_operators@read_grouping_operator(after_comments, ".");
                                "@" -> lexer_operators@read_grouping_operator(after_comments, "@");
                                "+" -> lexer_operators@read_single_char_arithmetic(after_comments, "+");
                                "*" -> lexer_operators@read_single_char_arithmetic(after_comments, "*");
                                "/" -> lexer_operators@read_single_char_arithmetic(after_comments, "/");
                                "%" -> lexer_operators@read_single_char_arithmetic(after_comments, "%");
                                "<" -> lexer_operators@read_less_than(after_comments);
                                ">" -> lexer_operators@read_greater_than(after_comments);
                                "=" -> lexer_operators@read_equal(after_comments);
                                "!" -> lexer_operators@read_bang_equal(after_comments);
                                _: string -> do
                                    kinds: TokenKinds <- lexer_token_kind@token_kinds();
                                    error_location: SourceLocation <- lexer_core@current_location(after_comments);
                                    error_token: Token <- lexer_core@make_token(kinds.unknown_char, current, error_location);
                                    (error_token, lexer_core@advance(after_comments))
                                end
                            }
                        }
                    };
                    (token: Token, next_lexer: Lexer) <- token_and_lexer;
                    new_tokens: ListToken <- ListToken { is_nil: false, head: token, tail: tokens };
                    tokenize(next_lexer, new_tokens)
                end
            }
        }
    end
}


{-
- Returns a ListToken representing the empty token list (nil): a node with is_nil true and a placeholder head/tail so that the structure is valid but denotes "no tokens yet".
- Used as the initial accumulator when tokenizing: lexer_runner calls empty_token_list() and passes the result to tokenize(lexer, initial_tokens), which then conses tokens onto it until EOF. Callers that traverse the list should treat is_nil true as end-of-list and not follow tail. Fits into the design as the canonical empty ListToken.
- Example: initial_tokens <- empty_token_list(); tokenize(lexer, initial_tokens) — tokenize builds the list by consing onto this nil.
- Example: checking list emptiness by testing the result’s is_nil field; when true, the list has no tokens.
- Example: building a list manually by consing a token onto empty_token_list() to get a single-element list.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One ListToken node with placeholder fields; no recursion.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn empty_token_list() -> ListToken {
    dummy_token: Token <- Token { kind: 0, lexeme: "", location: SourceLocation { file: "", line: 0, column: 0, offset: 0 } };
    // For empty list, tail is never accessed (is_nil is true), so we can use a placeholder
    // Well create a self-referential structure by creating the list first, then updating
    nil_placeholder: ListToken <- ListToken { is_nil: true, head: dummy_token, tail: nil_placeholder };
    nil_placeholder
}


{-
- Reads the given file via DeviceIO, tokenizes its contents from start to EOF, and returns the resulting ListToken; the procedure performs read_lines(filename), builds a lexer, then tokenize(lexer, empty_token_list()).
- Top-level entry point for lexing a source file: call from a context that can run DeviceIO (e.g. main or a test runner). The file is read once, then the full token list is produced; the returned list is in reverse of source order (first token read is at the end of the list, EOF at the head). Fits into the design as the single function that turns a filename into a token list.
- Example: lexer_runner("main.silica") in a DeviceIO context reads main.silica and returns a ListToken containing all tokens plus an EOF token.
- Example: for an empty file, the result is a list whose first cons has the EOF token and whose tail is the empty_token_list().
- Example: for a file containing "fn x ( )", the result list includes fn_keyword, identifier "x", left_paren, right_paren, and EOF (order depends on cons structure).
- Time: O(n), Ω(n), Θ(n) where n is the file size in characters (read plus tokenize). Space: O(n + t), Ω(1), Θ(n + t) for file content and token list (t = number of tokens).
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn lexer_runner(filename: string) -> ListToken proc[DeviceIO] {
        // Read file content
        {-
        print("Reading file: ");
        println(filename);
        println("");
        -}
        source: string <- read_lines(filename);
        {-
        print("source: ");
        println(source);
        println("");
        -}
        // Create lexer
        lexer: Lexer <- lexer_core@new_lexer(source, filename);
        
        // DEBUG: Print lexer source
        {- 
        print("lexer source: ");
        println(lexer.source);
        println("");
        println("DEBUG lexer source length=");
        print_int64(len(lexer.source));
        println("");
        -}
        
        // Start with empty token list
        initial_tokens: ListToken <- empty_token_list();
        
        // Tokenize entire source (tokenize returns proc[DeviceIO], so we invoke it)
        result_tokens: ListToken <- tokenize(lexer, initial_tokens);
        result_tokens
}
