// Lexer-level classification for design_documents/recursion_implementation.jsonld (all phases).
// The JSON-LD describes runtime/IR (explicit frames, fuel, tail/fallback) — there are no new
// surface spellings for those phases. This module groups existing token kinds so lexer-adjacent
// tooling can filter tokens by phase-relevance without hardcoding kind numbers elsewhere.

use lexer_token_kind;

export token_kind_recursion_phase1_core_representation/2;
export token_kind_recursion_phase2_lowering_execution/2;
export token_kind_recursion_phase3_preemption_fairness/2;
export token_kind_recursion_phase4_debugging_observability/2;
export token_kind_recursion_phase5_optimizations/2;
export token_kind_recursion_phase6_fallbacks/2;
export token_kind_any_recursion_implementation_phase/2;


fn token_kind_recursion_phase1_core_representation(kinds: TokenKinds, k: int64) -> bool {
    // Phase 1 — core representation: callee/structure in source (fn), recursive types (rec).
    k == kinds.fn_keyword or k == kinds.rec_keyword
}

fn token_kind_recursion_phase2_lowering_execution(kinds: TokenKinds, k: int64) -> bool {
    // Phase 2 — lowering: calls, returns, and callee/parameter names.
    k == kinds.fn_keyword or k == kinds.return_keyword or k == kinds.left_paren or k == kinds.right_paren or k == kinds.identifier
}

fn token_kind_recursion_phase3_preemption_fairness(kinds: TokenKinds, k: int64) -> bool {
    // Phase 3 — runnable units (proc/effects), back-edges in source (return, case arms, if).
    k == kinds.proc_keyword or k == kinds.effect_keyword or k == kinds.return_keyword or k == kinds.case_keyword or k == kinds.of_keyword or k == kinds.if_keyword
}

fn token_kind_recursion_phase4_debugging_observability(kinds: TokenKinds, k: int64) -> bool {
    // Phase 4 — symbols and control points that appear in stack traces / spans.
    k == kinds.fn_keyword or k == kinds.return_keyword or k == kinds.identifier or k == kinds.case_keyword
}

fn token_kind_recursion_phase5_optimizations(kinds: TokenKinds, k: int64) -> bool {
    // Phase 5 — tail-oriented surface (return sites; fn defines callable boundaries).
    k == kinds.return_keyword or k == kinds.fn_keyword
}

fn token_kind_recursion_phase6_fallbacks(kinds: TokenKinds, k: int64) -> bool {
    // Phase 6 — same call/return surface whether lowered to trampoline or native TCO.
    k == kinds.fn_keyword or k == kinds.return_keyword or k == kinds.left_paren or k == kinds.right_paren
}

fn token_kind_any_recursion_implementation_phase(kinds: TokenKinds, k: int64) -> bool {
    token_kind_recursion_phase1_core_representation(kinds, k) or token_kind_recursion_phase2_lowering_execution(kinds, k) or token_kind_recursion_phase3_preemption_fairness(kinds, k) or token_kind_recursion_phase4_debugging_observability(kinds, k) or token_kind_recursion_phase5_optimizations(kinds, k) or token_kind_recursion_phase6_fallbacks(kinds, k)
}
