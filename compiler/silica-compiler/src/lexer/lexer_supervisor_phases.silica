// Lexer-level classification for design_documents/supervisors_implementation_development_plan.md.
// Phase B (supervision ingress + scheduler ordering): silica-spec §15.4.9, §16.2.2 — runtime drains
// the supervision ingress before the standard mailbox each turn. User code still uses the same
// message parameter, case/of, cast/call/send, spawn_linked, and link/monitor/demonitor surface
// spellings; there is no separate recv-from-ingress keyword.

use lexer_token_kind;

export token_kind_supervisor_phase_b_ingress_ordering/2;


fn token_kind_supervisor_phase_b_ingress_ordering(kinds: TokenKinds, k: int64) -> bool {
    k == kinds.spawn_keyword or k == kinds.spawn_linked_keyword or k == kinds.link_keyword or k == kinds.monitor_keyword or k == kinds.demonitor_keyword or k == kinds.cast_keyword or k == kinds.send_keyword or k == kinds.self_keyword or k == kinds.actor_keyword or k == kinds.actor_ref_keyword or k == kinds.case_keyword or k == kinds.of_keyword or k == kinds.recv_keyword
}
