// Keyword recognition for Silica lexer
// CPU topology Phase B (design_documents/cpu_topology_implementation_plan.jsonld): placement and §22.10 affinity builtins are covered in keyword_token_kind; no extra keywords added — spec introduces no additional spellings beyond these mappings.
// Recognizes all type keywords: int8, int16, int32, int64, float16, float32, float64, boolean (alias bool), char, string, unit
// Built-in negate_* names (signed int + float only). No negate_uint* keywords; those names are identifiers and fail as unknown functions (E2005) if called.
// Case expressions: case, of, if (pattern guards like `z: int64 if pred(z) -> ...`).
// Also recognizes fn/proc keywords and memory region keywords (region, ref, atomic, normal, buf, mem, normal_writeback, normal_writethrough, normal_noncacheable, device, lifetime)
// Lists (design_documents/list_implementation_design.md, silica-spec §list literals): `List` is a type keyword for `List[T, S]`, literals `[...]: List[...]`, and case patterns.
// Recursion (spec + design_documents/recursion_implementation.jsonld): surface code uses fn, calls, case, and optionally return; recursive tuple types use rec (silica-specification §recursive tuples). Runtime phases 1–6 (frames, lowering, fuel, traces, tail/fallback) are IR/runtime — no additional keywords in this file; see lexer_recursion_phases.silica for phase↔token-kind groupings of existing kinds.
// `struct` is reserved (silica-specification §2.2). Surface language uses inline record types `{ f: T, ... }` and struct literals `{ f: e, ... }` only (§3.4.2); no named `struct Name { ... }` declarations.
// Actors (silica-specification §2.2.1, §4.5, §15–16, §22.4, CPU affinity appendix): actor, actor_ref, spawn, send, cast, self, recv; pin_actor_to_*, unpin_actor, remove_actor, set_actor_priority; get_cpu_topology, get_*_cores, get_core_capabilities; effects concurrency; placement core_id, core_set (rejected for spawn — use uint64); performance_cores, efficiency_cores; impl/for for ActorMessage decls; device_io effect name (distinct from device).
// Modules (silica-specification §3.3.2, §3.4.4–3.4.5, §3.4.10, §19): `use` imports (`use a, b;`), `export` with name/arity (`export f/2;`), `module` for optional explicit module lines (`module name;`). Cross-module calls tokenize as identifier, `at_sign`, identifier, `(` … (`mod@fn(args)`); same-module calls are `identifier`, `(`, … . Slash and integer literals for arity are existing operator/literal kinds.
// Traits (silica-specification §2.2.1 `trait`, §3.4.8): trait files use `export trait Name;`, `required { ... }`, `provided { ... }`, and `impl fn` / `impl` type — no new punctuation; `trait`, `required`, and `provided` are dedicated keyword kinds.

// Import token kind enum
use lexer_token_kind;

// Import lexer core types
use lexer_core;

// Import boolean literal recognition
use boolean_lexer_literals;

// Export identifier reading functions
export is_identifier_start/1;
export is_identifier_char/1;
export read_identifier/1;
export read_identifier_chars/2;


{-
- Returns true if the string is one of the Silica type keywords (int8, int16, int32, int64, float16, float32, float64, boolean, char, string), and false otherwise.
- Used after reading an identifier so the lexer can decide whether to emit a type-keyword token or an identifier token. Fits into the design as the predicate that distinguishes type keywords from ordinary identifiers.
- Example: is_type_keyword("int32") returns true; the lexeme is recognized as a type keyword.
- Example: is_type_keyword("string") and is_type_keyword("char") return true; both are type keywords.
- Example: is_type_keyword("foo") and is_type_keyword("int") return false; "foo" is an identifier, "int" is not a valid type keyword (int8/int16/etc. are).
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over the string; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_type_keyword(s: string) -> bool {
    case s of {
        "int8" -> true;
        "int16" -> true;
        "int32" -> true;
        "int64" -> true;
        "uint8" -> true;
        "uint16" -> true;
        "uint32" -> true;
        "uint64" -> true;
        "float16" -> true;
        "float32" -> true;
        "float64" -> true;
        "boolean" -> true;
        "bool" -> true;
        "char" -> true;
        "string" -> true;
        "atom" -> true;
        "lifetime" -> true;
        "rec" -> true;
        "List" -> true;
        "actor_ref" -> true;
        _: string -> false
    }
}


{-
- Returns true if the string is exactly "fn", and false otherwise.
- Used after reading an identifier so the lexer can decide whether to emit the fn keyword token (function definition) or an identifier token. Fits into the design as the predicate that recognizes the function-introducer keyword.
- Example: is_fn_keyword("fn") returns true; the lexeme is the function keyword.
- Example: is_fn_keyword("foo") and is_fn_keyword("function") return false; they are identifiers, not the fn keyword.
- Example: is_fn_keyword("Fn") returns false; matching is exact, so only lowercase "fn" is recognized.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over the string; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_fn_keyword(s: string) -> bool {
    case s of {
        "fn" -> true;
        _: string -> false
    }
}


{-
- Maps a lexeme string to its token kind code: type keywords, unit, and fn map to their keyword kinds; any other string maps to the identifier kind.
- Used after reading an identifier so the lexer can build a token with the correct kind (e.g. make_token(keyword_token_kind(lexeme), lexeme, location)). Single place to centralize keyword-to-kind mapping; non-keywords get identifier. Fits into the design as the bridge from identifier lexemes to token kinds.
- Example: keyword_token_kind("int32") returns kinds.int32_keyword; the lexeme is a type keyword.
- Example: keyword_token_kind("fn") returns kinds.fn_keyword; the lexeme is the function keyword.
- Example: keyword_token_kind("foo") returns kinds.identifier; the lexeme is not a keyword so it is treated as an identifier.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single token_kinds() and case match; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn keyword_token_kind(s: string) -> int64 {
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    case s of {
        "string" -> kinds.string_keyword;
        "int8" -> kinds.int8_keyword;
        "int16" -> kinds.int16_keyword;
        "int32" -> kinds.int32_keyword;
        "int64" -> kinds.int64_keyword;
        "uint8" -> kinds.uint8_keyword;
        "uint16" -> kinds.uint16_keyword;
        "uint32" -> kinds.uint32_keyword;
        "uint64" -> kinds.uint64_keyword;
        "float16" -> kinds.float16_keyword;
        "float32" -> kinds.float32_keyword;
        "float64" -> kinds.float64_keyword;
        "boolean" -> kinds.bool_keyword;
        "bool" -> kinds.bool_keyword;
        "char" -> kinds.char_keyword;
        "unit" -> kinds.unit_keyword;
        "atom" -> kinds.atom_keyword;
        "fn" -> kinds.fn_keyword;
        "proc" -> kinds.proc_keyword;
        "effect" -> kinds.effect_keyword;
        "and" -> kinds.and_keyword;
        "or" -> kinds.or_keyword;
        "true" -> kinds.true_literal;
        "false" -> kinds.false_literal;
        "region" -> kinds.region_keyword;
        "ref" -> kinds.ref_keyword;
        "atomic" -> kinds.atomic_keyword;
        "normal" -> kinds.normal_keyword;
        "buf" -> kinds.buf_keyword;
        "mem" -> kinds.mem_keyword;
        "normal_writeback" -> kinds.normal_writeback_keyword;
        "normal_writethrough" -> kinds.normal_writethrough_keyword;
        "normal_noncacheable" -> kinds.normal_noncacheable_keyword;
        "device" -> kinds.device_keyword;
        "sequence" -> kinds.sequence_keyword;
        "produces" -> kinds.produces_keyword;
        "pure" -> kinds.pure_keyword;
        "end" -> kinds.end_keyword;
        "lifetime" -> kinds.lifetime_keyword;
        "case" -> kinds.case_keyword;
        "of" -> kinds.of_keyword;
        "if" -> kinds.if_keyword;
        "rec" -> kinds.rec_keyword;
        "return" -> kinds.return_keyword;
        "List" -> kinds.list_keyword;
        "negate_int8" -> kinds.negate_int8_keyword;
        "negate_int16" -> kinds.negate_int16_keyword;
        "negate_int32" -> kinds.negate_int32_keyword;
        "negate_int64" -> kinds.negate_int64_keyword;
        "negate_float16" -> kinds.negate_float16_keyword;
        "negate_float32" -> kinds.negate_float32_keyword;
        "negate_float64" -> kinds.negate_float64_keyword;
        "actor" -> kinds.actor_keyword;
        "actor_ref" -> kinds.actor_ref_keyword;
        "cast" -> kinds.cast_keyword;
        "spawn" -> kinds.spawn_keyword;
        "send" -> kinds.send_keyword;
        "struct" -> kinds.struct_keyword;
        "self" -> kinds.self_keyword;
        "recv" -> kinds.recv_keyword;
        "concurrency" -> kinds.concurrency_keyword;
        "mailbox" -> kinds.mailbox_keyword;
        "core_id" -> kinds.core_id_keyword;
        "core_set" -> kinds.core_set_keyword;
        "performance_cores" -> kinds.performance_cores_keyword;
        "efficiency_cores" -> kinds.efficiency_cores_keyword;
        "impl" -> kinds.impl_keyword;
        "for" -> kinds.for_keyword;
        "device_io" -> kinds.device_io_keyword;
        "pin_actor_to_core" -> kinds.pin_actor_to_core_keyword;
        "pin_actor_to_efficiency_core" -> kinds.pin_actor_to_efficiency_core_keyword;
        "pin_actor_to_performance_core" -> kinds.pin_actor_to_performance_core_keyword;
        "pin_actor_realtime" -> kinds.pin_actor_realtime_keyword;
        "unpin_actor" -> kinds.unpin_actor_keyword;
        "remove_actor" -> kinds.remove_actor_keyword;
        "set_actor_priority" -> kinds.set_actor_priority_keyword;
        "pin_actor_to_numa_node" -> kinds.pin_actor_to_numa_node_keyword;
        "get_cpu_topology" -> kinds.get_cpu_topology_keyword;
        "get_efficiency_cores" -> kinds.get_efficiency_cores_keyword;
        "get_performance_cores" -> kinds.get_performance_cores_keyword;
        "get_core_capabilities" -> kinds.get_core_capabilities_keyword;
        "module" -> kinds.module_keyword;
        "use" -> kinds.use_keyword;
        "export" -> kinds.export_keyword;
        "trait" -> kinds.trait_keyword;
        "required" -> kinds.required_keyword;
        "provided" -> kinds.provided_keyword;
        _: string -> kinds.identifier
    }
}


{-
- Returns true if the single-character string is a valid start of a Silica identifier: a letter (a–z, A–Z) or underscore; returns false otherwise (e.g. digits or symbols).
- Used by the lexer to detect when the current character can begin an identifier or keyword (e.g. before calling read_identifier). Digits cannot start an identifier; they are used for integer literals. Fits into the design as the predicate that gates identifier/keyword tokenization.
- Example: is_identifier_start("a") and is_identifier_start("Z") return true; letters can start identifiers.
- Example: is_identifier_start("_") returns true; underscore can start an identifier (e.g. "_private").
- Example: is_identifier_start("0") and is_identifier_start("+") return false; digits and operators do not start identifiers.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over one character; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_identifier_start(c: string) -> bool {
    case c of {
        "a" -> true;
        "b" -> true;
        "c" -> true;
        "d" -> true;
        "e" -> true;
        "f" -> true;
        "g" -> true;
        "h" -> true;
        "i" -> true;
        "j" -> true;
        "k" -> true;
        "l" -> true;
        "m" -> true;
        "n" -> true;
        "o" -> true;
        "p" -> true;
        "q" -> true;
        "r" -> true;
        "s" -> true;
        "t" -> true;
        "u" -> true;
        "v" -> true;
        "w" -> true;
        "x" -> true;
        "y" -> true;
        "z" -> true;
        "A" -> true;
        "B" -> true;
        "C" -> true;
        "D" -> true;
        "E" -> true;
        "F" -> true;
        "G" -> true;
        "H" -> true;
        "I" -> true;
        "J" -> true;
        "K" -> true;
        "L" -> true;
        "M" -> true;
        "N" -> true;
        "O" -> true;
        "P" -> true;
        "Q" -> true;
        "R" -> true;
        "S" -> true;
        "T" -> true;
        "U" -> true;
        "V" -> true;
        "W" -> true;
        "X" -> true;
        "Y" -> true;
        "Z" -> true;
        "_" -> true;
        _: string -> false
    }
}


{-
- Returns true if the single-character string is valid inside a Silica identifier: a letter (a–z, A–Z), underscore, or digit (0–9); returns false otherwise.
- Used when scanning the body of an identifier (e.g. in read_identifier_chars): after the first character (which must satisfy is_identifier_start), subsequent characters may be letters, underscores, or digits. Fits into the design as the predicate for continuing to consume identifier characters.
- Example: is_identifier_char("a") and is_identifier_char("_") return true; letters and underscore are allowed anywhere in an identifier.
- Example: is_identifier_char("9") returns true; digits are allowed after the first character (e.g. "x9", "var2").
- Example: is_identifier_char("+") and is_identifier_char(" ") return false; operators and spaces end the identifier.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One is_identifier_start and one digit case match; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_identifier_char(c: string) -> bool {
    is_start: bool <- is_identifier_start(c);
    is_digit: bool <- case c of {
        "0" -> true;
        "1" -> true;
        "2" -> true;
        "3" -> true;
        "4" -> true;
        "5" -> true;
        "6" -> true;
        "7" -> true;
        "8" -> true;
        "9" -> true;
        _: string -> false
    };
    is_start or is_digit
}


{-
- Advances the lexer past zero or more consecutive identifier characters (letters, digits, underscore) and returns the resulting lexer; stops at EOF or the first character that is not an identifier character.
- Used by read_identifier: the caller passes the lexer and the token start position; read_identifier_chars consumes the full identifier run, then the caller uses extract_lexeme(updated_lexer, start_pos) to get the lexeme and keyword_token_kind to get the token kind. start_pos is passed through for use by the caller. Does not build the token itself.
- Example: lexer at "foo123" — consumes "f","o","o","1","2","3", returns lexer past "3"; the next peek_char would be the character after the identifier.
- Example: lexer at "x" — consumes "x", then next character (e.g. space or EOF) is not identifier char so returns lexer past "x".
- Example: lexer at "" (EOF) or at "+" — no identifier characters consumed, returns lexer unchanged.
- Time: O(k), Ω(1), Θ(k) where k is the number of identifier characters consumed. Space: O(k), Ω(1), Θ(k) for recursion depth (or Θ(1) if tail-call optimized).
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn read_identifier_chars(lexer: Lexer, start_pos: int64) -> Lexer {
    current: string <- lexer_core@peek_char(lexer);
    case current of {
        "" -> lexer;
        _: string -> case is_identifier_char(current) of {
            true -> read_identifier_chars(lexer_core@advance(lexer), start_pos);
            false -> lexer
        }
    }
}


{-
- Reads one identifier or keyword from the current lexer position: consumes the run of identifier characters, extracts the lexeme, maps it to a token kind (keyword or identifier via keyword_token_kind), and returns the token and updated lexer.
- Entry point for identifier/keyword tokenization: the lexer calls this when is_identifier_start(peek_char(lexer)) is true. Uses read_identifier_chars to advance, extract_lexeme to get the source text, and keyword_token_kind so that "fn", type names, etc. get the correct kind. Fits into the design as the single function that produces an identifier or keyword token.
- Example: lexer at "foo" — read_identifier_chars advances past "foo", lexeme is "foo", keyword_token_kind yields identifier; result is (Token identifier "foo", lexer past "foo").
- Example: lexer at "fn" — lexeme "fn", kind is fn_keyword; result is (Token fn_keyword "fn", lexer past "fn").
- Example: lexer at "int32" — lexeme "int32", kind is int32_keyword; result is (Token int32_keyword "int32", lexer past "int32").
- Time: O(k), Ω(1), Θ(k) where k is the length of the identifier/keyword. Space: O(k), Ω(1), Θ(k) for read_identifier_chars and lexeme extraction.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_string_lexeme(s: string) -> bool {
    len(s) == 6 and substring(s, 0, 1) == "s" and substring(s, 1, 2) == "t" and substring(s, 2, 3) == "r" and substring(s, 3, 4) == "i" and substring(s, 4, 5) == "n" and substring(s, 5, 6) == "g"
}

fn read_identifier(lexer: Lexer) -> (Token, Lexer) {
    start_location: SourceLocation <- lexer_core@current_location(lexer);
    start_pos: int64 <- lexer.position;
    updated_lexer: Lexer <- read_identifier_chars(lexer, start_pos);
    lexeme: string <- lexer_core@extract_lexeme(updated_lexer, start_pos);
    kinds: TokenKinds <- lexer_token_kind@token_kinds();
    kw_kind: int64 <- keyword_token_kind(lexeme);
    kind: int64 <- case kw_kind == kinds.true_literal or kw_kind == kinds.false_literal of {
        true -> kw_kind;
        false -> case is_string_lexeme(lexeme) of {
            true -> kinds.string_keyword;
            false -> kw_kind
        }
    };
    token: Token <- lexer_core@make_token(kind, lexeme, start_location);
    (token, updated_lexer)
}
