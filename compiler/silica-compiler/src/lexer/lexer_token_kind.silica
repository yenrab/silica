// Token kind codes for the Silica lexer (stable IDs; see cpu_topology_implementation_plan.jsonld Phase B — topology/placement kinds 113–137).

// Export token_kinds function
export token_kinds/0;
export is_negate_builtin_kind/2;
export is_identifier_lexeme_token/2;
export is_actor_runtime_helper_kind/2;
export is_proc_list_effect_head_token/2;

// TokenKind type aliases - all token kinds are represented as int64 values
// Each token kind has a unique integer code

// Type alias for token kind
type TokenKind = int64;


{-
- Holds the unique integer codes for every token kind the lexer can produce: identifier, type keywords, fn_keyword, integer_literal, right_arrow, grouping (left/right paren and brace), and eof.
- Used by lexer modules that build tokens: call token_kinds() to get a TokenKinds instance, then use e.g. kinds.identifier or kinds.integer_literal as the kind argument to make_token. Centralizes all kind codes so the lexer and parser share the same numbering. Fits into the design as the single record of token kind constants.
- Example: make_token(kinds.identifier, "foo", loc) uses kinds.identifier as the token kind for identifiers.
- Example: make_token(kinds.integer_literal, "42", loc) uses kinds.integer_literal for number tokens.
- Example: make_token(kinds.eof, "", loc) uses kinds.eof for the end-of-file sentinel token.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
struct TokenKinds {
    identifier: int64,
    int8_keyword: int64,
    int16_keyword: int64,
    int32_keyword: int64,
    int64_keyword: int64,
    uint8_keyword: int64,
    uint16_keyword: int64,
    uint32_keyword: int64,
    uint64_keyword: int64,
    float16_keyword: int64,
    float32_keyword: int64,
    float64_keyword: int64,
    bool_keyword: int64,
    char_keyword: int64,
    string_keyword: int64,
    unit_keyword: int64,
    atom_keyword: int64,
    fn_keyword: int64,
    proc_keyword: int64,
    effect_keyword: int64,
    integer_literal: int64,
    float_literal: int64,
    string_literal: int64,
    char_literal: int64,
    atom_literal: int64,
    right_arrow: int64,
    left_paren: int64,
    right_paren: int64,
    left_brace: int64,
    right_brace: int64,
    left_bracket: int64,
    right_bracket: int64,
    comma: int64,
    plus: int64,
    minus: int64,
    star: int64,
    slash: int64,
    percent: int64,
    less_than: int64,
    greater_than: int64,
    less_equal: int64,
    greater_equal: int64,
    equal_equal: int64,
    bang_equal: int64,
    equal: int64,
    left_arrow: int64,
    colon: int64,
    semicolon: int64,
    unknown_char: int64,
    eof: int64,
    true_literal: int64,
    false_literal: int64,
    and_keyword: int64,
    or_keyword: int64,
    region_keyword: int64,
    ref_keyword: int64,
    atomic_keyword: int64,
    normal_keyword: int64,
    buf_keyword: int64,
    mem_keyword: int64,
    normal_writeback_keyword: int64,
    normal_writethrough_keyword: int64,
    normal_noncacheable_keyword: int64,
    device_keyword: int64,
    sequence_keyword: int64,
    produces_keyword: int64,
    pure_keyword: int64,
    end_keyword: int64,
    lifetime_keyword: int64,
    dot: int64,
    at_sign: int64,
    negate_int8_keyword: int64,
    negate_int16_keyword: int64,
    negate_int32_keyword: int64,
    negate_int64_keyword: int64,
    negate_float16_keyword: int64,
    negate_float32_keyword: int64,
    negate_float64_keyword: int64,
    case_keyword: int64,
    of_keyword: int64,
    if_keyword: int64,
    rec_keyword: int64,
    return_keyword: int64,
    list_keyword: int64,
    double_colon: int64,
    actor_keyword: int64,
    actor_ref_keyword: int64,
    supervisor_ref_keyword: int64,
    cast_keyword: int64,
    spawn_keyword: int64,
    spawn_registered_keyword: int64,
    spawn_registered_supervisor_keyword: int64,
    spawn_linked_keyword: int64,
    call_supervisor_keyword: int64,
    link_keyword: int64,
    monitor_keyword: int64,
    demonitor_keyword: int64,
    send_keyword: int64,
    self_keyword: int64,
    recv_keyword: int64,
    concurrency_keyword: int64,
    mailbox_keyword: int64,
    core_id_keyword: int64,
    core_set_keyword: int64,
    performance_cores_keyword: int64,
    efficiency_cores_keyword: int64,
    impl_keyword: int64,
    for_keyword: int64,
    device_io_keyword: int64,
    pin_actor_to_core_keyword: int64,
    pin_actor_to_efficiency_core_keyword: int64,
    pin_actor_to_performance_core_keyword: int64,
    pin_actor_realtime_keyword: int64,
    unpin_actor_keyword: int64,
    remove_actor_keyword: int64,
    register_actor_keyword: int64,
    set_actor_priority_keyword: int64,
    pin_actor_to_numa_node_keyword: int64,
    get_cpu_topology_keyword: int64,
    get_efficiency_cores_keyword: int64,
    get_performance_cores_keyword: int64,
    get_core_capabilities_keyword: int64,
    struct_keyword: int64,
    module_keyword: int64,
    use_keyword: int64,
    export_keyword: int64,
    trait_keyword: int64,
    required_keyword: int64,
    provided_keyword: int64,
    failure_reason_keyword: int64,
    // supervisors_implementation_development_plan.md Phase F (§15.4.13.4 FailureReporter) — `bytes` in handle_report / region_dumps
    bytes_keyword: int64,
    // supervisors_implementation_development_plan.md Phase G (§15.4.8.4–§15.4.8.7) — `monitor`/`demonitor` DOWN payload field type; spec tuple (:down, monitor_ref, actor_ref, failure_reason)
    monitor_ref_keyword: int64,
    // FFI wrapper specification (silica_ffi_wrapper_specification.md) — outbound foreign declarations
    foreign_keyword: int64,
    c_wrapper_keyword: int64,
    wrapper_meta_keyword: int64,
    meta_keyword: int64,
    external_danger_keyword: int64
}


{-
- Returns a TokenKinds instance with every token kind field set to its unique integer code (e.g. identifier 1, type keywords 10–20, fn_keyword 21, integer_literal 30, arrow and grouping 40–44, operators 45–57, eof 60).
- Used by the lexer (and parser) whenever a token is built: call token_kinds() once per token or once per scope, then use kinds.identifier, kinds.eof, etc. as the kind for make_token. Single source of truth for kind codes so all modules stay in sync. Fits into the design as the factory for TokenKinds.
- Example: kinds: TokenKinds <- token_kinds(); make_token(kinds.identifier, lexeme, loc) — builds an identifier token using the standard code.
- Example: token_kinds().integer_literal is 30; use it when emitting an integer literal token.
- Example: token_kinds().eof is 60; use it for the end-of-file token at the end of the token list.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single struct construction with literal fields; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn token_kinds() -> TokenKinds {
    TokenKinds {
        identifier: 1,
        int8_keyword: 10,
        int16_keyword: 11,
        int32_keyword: 12,
        int64_keyword: 13,
        uint8_keyword: 67,
        uint16_keyword: 68,
        uint32_keyword: 69,
        uint64_keyword: 70,
        float16_keyword: 14,
        float32_keyword: 15,
        float64_keyword: 16,
        bool_keyword: 17,
        char_keyword: 18,
        string_keyword: 19,
        unit_keyword: 20,
        atom_keyword: 24,
        fn_keyword: 21,
        proc_keyword: 22,
        effect_keyword: 23,
        integer_literal: 30,
        float_literal: 71,
        string_literal: 75,
        char_literal: 76,
        atom_literal: 31,
        right_arrow: 40,
        left_paren: 41,
        right_paren: 42,
        left_brace: 43,
        right_brace: 44,
        left_bracket: 61,
        right_bracket: 62,
        comma: 63,
        plus: 45,
        minus: 46,
        star: 47,
        slash: 48,
        percent: 49,
        less_than: 51,
        greater_than: 52,
        less_equal: 53,
        greater_equal: 54,
        equal_equal: 55,
        bang_equal: 56,
        equal: 57,
        left_arrow: 58,
        colon: 64,
        semicolon: 72,
        unknown_char: 59,
        eof: 60,
        true_literal: 65,
        false_literal: 66,
        and_keyword: 73,
        or_keyword: 74,
        region_keyword: 77,
        ref_keyword: 78,
        atomic_keyword: 79,
        normal_keyword: 80,
        buf_keyword: 81,
        mem_keyword: 82,
        normal_writeback_keyword: 83,
        normal_writethrough_keyword: 84,
        normal_noncacheable_keyword: 85,
        device_keyword: 86,
        sequence_keyword: 87,
        produces_keyword: 88,
        pure_keyword: 89,
        end_keyword: 90,
        lifetime_keyword: 91,
        dot: 93,
        at_sign: 95,
        negate_int8_keyword: 96,
        negate_int16_keyword: 97,
        negate_int32_keyword: 98,
        negate_int64_keyword: 99,
        negate_float16_keyword: 100,
        negate_float32_keyword: 101,
        negate_float64_keyword: 102,
        case_keyword: 103,
        of_keyword: 104,
        if_keyword: 105,
        rec_keyword: 106,
        return_keyword: 107,
        list_keyword: 108,
        double_colon: 109,
        actor_keyword: 110,
        actor_ref_keyword: 111,
        supervisor_ref_keyword: 153,
        cast_keyword: 112,
        spawn_keyword: 113,
        spawn_registered_keyword: 154,
        spawn_registered_supervisor_keyword: 155,
        spawn_linked_keyword: 145,
        call_supervisor_keyword: 156,
        link_keyword: 146,
        monitor_keyword: 147,
        demonitor_keyword: 148,
        send_keyword: 114,
        self_keyword: 115,
        recv_keyword: 116,
        concurrency_keyword: 117,
        mailbox_keyword: 118,
        core_id_keyword: 119,
        core_set_keyword: 120,
        performance_cores_keyword: 121,
        efficiency_cores_keyword: 122,
        impl_keyword: 123,
        for_keyword: 124,
        device_io_keyword: 125,
        pin_actor_to_core_keyword: 126,
        pin_actor_to_efficiency_core_keyword: 127,
        pin_actor_to_performance_core_keyword: 128,
        pin_actor_realtime_keyword: 129,
        unpin_actor_keyword: 130,
        remove_actor_keyword: 131,
        register_actor_keyword: 152,
        set_actor_priority_keyword: 132,
        pin_actor_to_numa_node_keyword: 133,
        get_cpu_topology_keyword: 134,
        get_efficiency_cores_keyword: 135,
        get_performance_cores_keyword: 136,
        get_core_capabilities_keyword: 137,
        struct_keyword: 138,
        module_keyword: 139,
        use_keyword: 140,
        export_keyword: 141,
        trait_keyword: 142,
        required_keyword: 143,
        provided_keyword: 144,
        failure_reason_keyword: 149,
        bytes_keyword: 150,
        monitor_ref_keyword: 151,
        foreign_keyword: 158,
        c_wrapper_keyword: 159,
        wrapper_meta_keyword: 160,
        meta_keyword: 161,
        external_danger_keyword: 157
    }
}

{- True for actor scheduling / topology runtime helpers (silica-spec §15.2, appendix CPU affinity).
   Parser initial_roles treats these like spawn/send: call target then operand. -}
fn is_actor_runtime_helper_kind(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.pin_actor_to_core_keyword or token_kind == kinds.pin_actor_to_efficiency_core_keyword or token_kind == kinds.pin_actor_to_performance_core_keyword or token_kind == kinds.pin_actor_realtime_keyword or token_kind == kinds.unpin_actor_keyword or token_kind == kinds.remove_actor_keyword or token_kind == kinds.register_actor_keyword or token_kind == kinds.set_actor_priority_keyword or token_kind == kinds.pin_actor_to_numa_node_keyword or token_kind == kinds.get_cpu_topology_keyword or token_kind == kinds.get_efficiency_cores_keyword or token_kind == kinds.get_performance_cores_keyword or token_kind == kinds.get_core_capabilities_keyword
}

{- True if token can start an effect in proc[effect, ...] (silica-spec §9.2.1).
   mem(...) uses mem_keyword; bare built-ins may be lexed as dedicated keywords (device_io, concurrency, …), not identifiers. -}
fn is_proc_list_effect_head_token(kinds: TokenKinds, token_kind: int64) -> bool {
    is_identifier_lexeme_token(kinds, token_kind) or token_kind == kinds.mem_keyword or token_kind == kinds.device_io_keyword or token_kind == kinds.concurrency_keyword or token_kind == kinds.mailbox_keyword or token_kind == kinds.atomic_keyword or token_kind == kinds.external_danger_keyword
}

fn is_negate_builtin_kind(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.negate_int8_keyword or token_kind == kinds.negate_int16_keyword or token_kind == kinds.negate_int32_keyword or token_kind == kinds.negate_int64_keyword or token_kind == kinds.negate_float16_keyword or token_kind == kinds.negate_float32_keyword or token_kind == kinds.negate_float64_keyword
}

fn is_identifier_lexeme_token(kinds: TokenKinds, token_kind: int64) -> bool {
    token_kind == kinds.identifier or is_negate_builtin_kind(kinds, token_kind)
}
