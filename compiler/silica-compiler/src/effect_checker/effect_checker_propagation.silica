{- Effect propagation.
   Traverses Expr trees to collect effects from function calls,
   computes effect set unions, and expands effect aliases.
   Implements spec §9.3.1 (Effect Propagation, Effect Set Union Algorithm).
   Memory region ops (alloc_region, alloc_ref, alloc_buf, read_ref, write_ref,
   read_buf, write_buf, buf_load, buf_store, alloc_rec, build, alloc_region_on_numa_node)
   require mem(Space) per spec §4.4, §22.1-22.3; alloc_ref/alloc_buf/alloc_rec into atomic space also require atomic (§17.1.2).
   List[T,S] literals and list primitives require mem(S) per list_implementation_design.md §9.3, §9.8.
   Struct literals (parser kind 21) and field access (kind 22) follow silica:StructLiterals / §3.3.7:
   effects are the union of subexpressions (field initializers; base expr for .field).
-}

use parser_ast;
use lexer_core;
use effect_checker_core;
use effect_checker_memory_regions;
use effect_checker_lists;
use type_checker_core;

export collect_expr_effects/2;
export collect_expr_effects_outside_sequence_blocks/2;
export resolve_call_effects/2;
export union_effect_lists/2;
export add_effect_if_absent/2;
export expand_effect_list/2;
export expand_single_effect/2;

// --- Effect collection from expressions ---

{- Traverse an Expr tree and collect the union of all effects from function calls.
   Expr kinds: 0=integer literal, 1=identifier, 2=parenthesized, 3=binary_op, 4=call, 5=atom literal, 6=let binding, 21=struct literal, 22=field access, -1=dummy.
   For calls (kind 4): resolve callee effects (region ops use binding_type for Space), union with arg subtree.
   For let bindings (kind 6): pass expr.value (binding type) when recursing into RHS for region op effect extraction.
   Pure expressions contribute no effects (spec §9.3.1). -}
fn collect_expr_effects(expr: Expr, ctx: EffectContext) -> ListEffectName {
    collect_expr_effects_with_binding(expr, ctx, "")
}

{- Effects from calls that appear outside any sequence block (kind 11).
   Used for function-body E3001: nested sequence proc[...] blocks declare their own
   effects; those must not be attributed to the enclosing function body. -}
fn collect_expr_effects_outside_sequence_blocks(expr: Expr, ctx: EffectContext) -> ListEffectName {
    collect_expr_effects_outside_sequence_blocks_with_binding(expr, ctx, "")
}

fn collect_expr_effects_outside_sequence_blocks_with_binding(expr: Expr, ctx: EffectContext, binding_type: string) -> ListEffectName {
    case expr.kind == 11 of {
        true -> parser_ast@empty_effect_name_list();
        false -> case expr.kind == 4 of {
            true -> do
                callee_effects: ListEffectName <- resolve_call_effects_with_binding(expr.name, ctx, expr.inner, binding_type, expr.location, expr.value);
                arg_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.inner, ctx, "");
                union_effect_lists(callee_effects, arg_effects)
            end;
            false -> case expr.kind == 3 of {
                true -> do
                    left_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.inner, ctx, "");
                    right_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.right_expr, ctx, "");
                    union_effect_lists(left_effects, right_effects)
                end;
                false -> case expr.kind == 6 of {
                    true -> do
                        rhs_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.inner, ctx, expr.value);
                        body_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.right_expr, ctx, "");
                        union_effect_lists(rhs_effects, body_effects)
                    end;
                    false -> case expr.kind == 2 of {
                        true -> collect_expr_effects_outside_sequence_blocks_with_binding(expr.inner, ctx, binding_type);
                        false -> case expr.kind == 10 of {
                            true -> do
                                rhs_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.inner, ctx, "");
                                body_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.right_expr, ctx, "");
                                union_effect_lists(rhs_effects, body_effects)
                            end;
                            false -> case expr.kind == 20 of {
                                true -> do
                                    lit_type_src: string <- case len(expr.value) > 0 of {
                                        true -> expr.value;
                                        false -> binding_type
                                    };
                                    lit_effects: ListEffectName <- effect_checker_lists@mem_effects_for_list_literal(lit_type_src, expr.location);
                                    rest_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.inner, ctx, "");
                                    union_effect_lists(lit_effects, rest_effects)
                                end;
                                false -> case expr.kind == 13 of {
                                    true -> do
                                        scrut_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.inner, ctx, "");
                                        branch_effects: ListEffectName <- collect_case_branch_list_effects_outside(expr.right_expr, ctx);
                                        union_effect_lists(scrut_effects, branch_effects)
                                    end;
                                    false -> case expr.kind == 21 of {
                                        true -> collect_struct_literal_chain_effects_outside(expr, ctx, binding_type);
                                        false -> case expr.kind == 22 of {
                                            true -> collect_expr_effects_outside_sequence_blocks_with_binding(expr.inner, ctx, binding_type);
                                            false -> parser_ast@empty_effect_name_list();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn collect_expr_effects_with_binding(expr: Expr, ctx: EffectContext, binding_type: string) -> ListEffectName {
    case expr.kind == 4 of {
        true -> do
            callee_effects: ListEffectName <- resolve_call_effects_with_binding(expr.name, ctx, expr.inner, binding_type, expr.location, expr.value);
            arg_effects: ListEffectName <- collect_expr_effects_with_binding(expr.inner, ctx, "");
            union_effect_lists(callee_effects, arg_effects)
        end;
        false -> case expr.kind == 3 of {
            true -> do
                left_effects: ListEffectName <- collect_expr_effects_with_binding(expr.inner, ctx, "");
                right_effects: ListEffectName <- collect_expr_effects_with_binding(expr.right_expr, ctx, "");
                union_effect_lists(left_effects, right_effects)
            end;
            false -> case expr.kind == 6 of {
                true -> do
                    rhs_effects: ListEffectName <- collect_expr_effects_with_binding(expr.inner, ctx, expr.value);
                    body_effects: ListEffectName <- collect_expr_effects_with_binding(expr.right_expr, ctx, "");
                    union_effect_lists(rhs_effects, body_effects)
                end;
                false -> case expr.kind == 2 of {
                    true -> collect_expr_effects_with_binding(expr.inner, ctx, binding_type);
                    false -> case expr.kind == 10 of {
                        true -> do
                            rhs_effects: ListEffectName <- collect_expr_effects_with_binding(expr.inner, ctx, "");
                            body_effects: ListEffectName <- collect_expr_effects_with_binding(expr.right_expr, ctx, "");
                            union_effect_lists(rhs_effects, body_effects)
                        end;
                        false -> case expr.kind == 11 of {
                            true -> do
                                body_effects: ListEffectName <- collect_expr_effects_with_binding(expr.inner, ctx, "");
                                result_effects: ListEffectName <- collect_expr_effects_with_binding(expr.right_expr, ctx, "");
                                union_effect_lists(body_effects, result_effects)
                            end;
                            false -> case expr.kind == 20 of {
                                true -> do
                                    lit_type_src: string <- case len(expr.value) > 0 of {
                                        true -> expr.value;
                                        false -> binding_type
                                    };
                                    lit_effects: ListEffectName <- effect_checker_lists@mem_effects_for_list_literal(lit_type_src, expr.location);
                                    rest_effects: ListEffectName <- collect_expr_effects_with_binding(expr.inner, ctx, "");
                                    union_effect_lists(lit_effects, rest_effects)
                                end;
                                false -> case expr.kind == 13 of {
                                    true -> do
                                        scrut_effects: ListEffectName <- collect_expr_effects_with_binding(expr.inner, ctx, "");
                                        branch_effects: ListEffectName <- collect_case_branch_list_effects(expr.right_expr, ctx);
                                        union_effect_lists(scrut_effects, branch_effects)
                                    end;
                                    false -> case expr.kind == 21 of {
                                        true -> collect_struct_literal_chain_effects(expr, ctx, binding_type);
                                        false -> case expr.kind == 22 of {
                                            true -> collect_expr_effects_with_binding(expr.inner, ctx, binding_type);
                                            false -> parser_ast@empty_effect_name_list();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// --- Struct literals (kind 21), §3.3.7 / silica:StructLiterals ---

{- Right-nested chain of kind-21 nodes: inner = field initializer, right_expr = next field or dummy.
   Union of effects from every field expression. -}
fn collect_struct_literal_chain_effects(expr: Expr, ctx: EffectContext, binding_type: string) -> ListEffectName {
    case expr.kind == -1 of {
        true -> parser_ast@empty_effect_name_list();
        false -> case expr.kind == 21 of {
            true -> do
                head_eff: ListEffectName <- collect_expr_effects_with_binding(expr.inner, ctx, binding_type);
                tail_eff: ListEffectName <- collect_struct_literal_chain_effects(expr.right_expr, ctx, binding_type);
                union_effect_lists(head_eff, tail_eff)
            end;
            false -> collect_expr_effects_with_binding(expr, ctx, binding_type)
        }
    }
}

fn collect_struct_literal_chain_effects_outside(expr: Expr, ctx: EffectContext, binding_type: string) -> ListEffectName {
    case expr.kind == -1 of {
        true -> parser_ast@empty_effect_name_list();
        false -> case expr.kind == 21 of {
            true -> do
                head_eff: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(expr.inner, ctx, binding_type);
                tail_eff: ListEffectName <- collect_struct_literal_chain_effects_outside(expr.right_expr, ctx, binding_type);
                union_effect_lists(head_eff, tail_eff)
            end;
            false -> collect_expr_effects_outside_sequence_blocks_with_binding(expr, ctx, binding_type)
        }
    }
}

{- Resolve the effects of a called function by name.
   Lookup order: region builtins (alloc_region, alloc_ref, etc.), user-defined, then other builtins.
   Unknown functions are treated as pure (empty effects). -}
fn resolve_call_effects(fn_name: string, ctx: EffectContext) -> ListEffectName {
    resolve_call_effects_with_binding(fn_name, ctx, parser_ast@dummy_expr(), "", parser_ast@zero_location(), "")
}

{- generic_value: kind-4 call value field (generic instantiation text), empty if none. -}
fn resolve_call_effects_with_binding(fn_name: string, ctx: EffectContext, first_arg: Expr, binding_type: string, location: SourceLocation, generic_value: string) -> ListEffectName {
    case effect_checker_lists@is_list_primitive_fn(fn_name) of {
        true -> effect_checker_lists@mem_effects_for_list_call(fn_name, generic_value, location);
        false -> case effect_checker_memory_regions@is_region_builtin_fn(fn_name) of {
            true -> do
                (handled: bool, region_effects: ListEffectName) <- effect_checker_memory_regions@get_region_call_effects(fn_name, first_arg, binding_type, location);
                case handled of {
                    true -> region_effects;
                    false -> parser_ast@empty_effect_name_list()
                }
            end;
            false -> do
                case type_checker_core@call_name_is_module_qualified(fn_name) of {
                    true -> do
                        base: string <- type_checker_core@user_call_base_function_name(fn_name);
                        (found_mq: bool, mq_effects: ListEffectName) <- effect_checker_core@lookup_fn_effects(ctx.fn_env, base);
                        case found_mq of {
                            true -> expand_effect_list(mq_effects, ctx.alias_env);
                            false -> do
                                (found_builtin_mq: bool, builtin_mq_effects: ListEffectName) <- effect_checker_core@builtin_fn_effects(base);
                                case found_builtin_mq of {
                                    true -> builtin_mq_effects;
                                    false -> parser_ast@empty_effect_name_list()
                                }
                            end
                        }
                    end;
                    false -> do
                        (found_user: bool, user_effects: ListEffectName) <- effect_checker_core@lookup_fn_effects(ctx.fn_env, fn_name);
                        case found_user of {
                            true -> expand_effect_list(user_effects, ctx.alias_env);
                            false -> do
                                (found_builtin: bool, builtin_effects: ListEffectName) <- effect_checker_core@builtin_fn_effects(fn_name);
                                case found_builtin of {
                                    true -> builtin_effects;
                                    false -> parser_ast@empty_effect_name_list()
                                }
                            end
                        }
                    end
                }
            end
        }
    }
}

{- kind 17 branch list: inner is kind 18 branch; right_expr is next 17 or dummy. -}
fn collect_single_case_branch_effects(branch: Expr, ctx: EffectContext) -> ListEffectName {
    case branch.kind == 18 of {
        true -> do
            pat_effects: ListEffectName <- effect_checker_lists@mem_effects_from_case_pattern(branch.value, branch.location);
            rhs_effects: ListEffectName <- collect_expr_effects_with_binding(branch.right_expr, ctx, "");
            union_effect_lists(pat_effects, rhs_effects)
        end;
        false -> collect_expr_effects_with_binding(branch, ctx, "")
    }
}

fn collect_case_branch_list_effects(branches: Expr, ctx: EffectContext) -> ListEffectName {
    case branches.kind == -1 of {
        true -> parser_ast@empty_effect_name_list();
        false -> case branches.kind == 17 of {
            true -> do
                one: ListEffectName <- collect_single_case_branch_effects(branches.inner, ctx);
                rest: ListEffectName <- collect_case_branch_list_effects(branches.right_expr, ctx);
                union_effect_lists(one, rest)
            end;
            false -> parser_ast@empty_effect_name_list()
        }
    }
}

fn collect_single_case_branch_effects_outside(branch: Expr, ctx: EffectContext) -> ListEffectName {
    case branch.kind == 18 of {
        true -> do
            pat_effects: ListEffectName <- effect_checker_lists@mem_effects_from_case_pattern(branch.value, branch.location);
            rhs_effects: ListEffectName <- collect_expr_effects_outside_sequence_blocks_with_binding(branch.right_expr, ctx, "");
            union_effect_lists(pat_effects, rhs_effects)
        end;
        false -> collect_expr_effects_outside_sequence_blocks_with_binding(branch, ctx, "")
    }
}

fn collect_case_branch_list_effects_outside(branches: Expr, ctx: EffectContext) -> ListEffectName {
    case branches.kind == -1 of {
        true -> parser_ast@empty_effect_name_list();
        false -> case branches.kind == 17 of {
            true -> do
                one: ListEffectName <- collect_single_case_branch_effects_outside(branches.inner, ctx);
                rest: ListEffectName <- collect_case_branch_list_effects_outside(branches.right_expr, ctx);
                union_effect_lists(one, rest)
            end;
            false -> parser_ast@empty_effect_name_list()
        }
    }
}

// --- Effect set union ---

{- Compute the union of two effect lists (no duplicates).
   For each effect in list_a, add to list_b if not already present.
   Normalizes effects before comparison. -}
fn union_effect_lists(list_a: ListEffectName, list_b: ListEffectName) -> ListEffectName {
    case list_a.is_nil of {
        true -> list_b;
        false -> do
            merged: ListEffectName <- add_effect_if_absent(list_b, effect_checker_core@normalize_effect(list_a.head));
            union_effect_lists(list_a.tail, merged)
        end
    }
}

{- Add an effect to the list if it is not already present (by equality after normalization). -}
fn add_effect_if_absent(list: ListEffectName, eff: EffectName) -> ListEffectName {
    case effect_checker_core@effect_list_contains(list, eff) of {
        true -> list;
        false -> parser_ast@cons_effect_name(eff, list)
    }
}

// --- Alias expansion ---

{- Expand all aliases in an effect list.
   Each effect that is a built-in alias or user-defined alias is replaced
   by its expansion. Built-in effects pass through unchanged. -}
fn expand_effect_list(effects: ListEffectName, alias_env: ListEffectEntry) -> ListEffectName {
    case effects.is_nil of {
        true -> parser_ast@empty_effect_name_list();
        false -> do
            expanded_head: ListEffectName <- expand_single_effect(effects.head, alias_env);
            expanded_tail: ListEffectName <- expand_effect_list(effects.tail, alias_env);
            union_effect_lists(expanded_head, expanded_tail)
        end
    }
}

{- Expand a single effect. If it is a built-in effect, return as singleton list.
   If it is a built-in alias, return its expansion.
   If it is a user-defined alias, return its expansion.
   Otherwise, return as singleton list (will be caught by validation). -}
fn expand_single_effect(eff: EffectName, alias_env: ListEffectEntry) -> ListEffectName {
    norm: EffectName <- effect_checker_core@normalize_effect(eff);
    case effect_checker_core@is_builtin_effect(norm) of {
        true -> parser_ast@cons_effect_name(norm, parser_ast@empty_effect_name_list());
        false -> case effect_checker_core@is_builtin_alias_name(norm.name) of {
            true -> do
                (found_alias: bool, alias_effects: ListEffectName) <- effect_checker_core@expand_builtin_alias(norm.name);
                case found_alias of {
                    true -> alias_effects;
                    false -> parser_ast@cons_effect_name(norm, parser_ast@empty_effect_name_list())
                }
            end;
            false -> do
                (found_user: bool, user_effects: ListEffectName) <- effect_checker_core@lookup_fn_effects(alias_env, norm.name);
                case found_user of {
                    true -> user_effects;
                    false -> parser_ast@cons_effect_name(norm, parser_ast@empty_effect_name_list())
                }
            end
        }
    }
}
