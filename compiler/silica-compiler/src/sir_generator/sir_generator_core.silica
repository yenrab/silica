// Core sir_generator infrastructure (base)
// Entry point: Program + TypeContext -> SIRModule (internal representation)
// Core+extensions pattern: orchestrates via dispatchers; no AST construct knowledge
// §19: module name (filename stem and/or explicit `module`), `use`, `export` recorded on SIRModule

use parser_ast;
use type_checker_core;
use sir_ast;
use dispatcher;
use traits;

export emit_program/2;
export emit_program_for_unit/3;

// Filename stem when known (§19.1.1); else "" to fall back on explicit `module` or "main"
fn module_name_for_sir(compilation_unit: string, decls: ListDeclaration) -> string {
    case len(compilation_unit) > 0 of {
        true -> compilation_unit;
        false -> do
            ex: string <- explicit_module_decl_name(decls);
            case len(ex) > 0 of {
                true -> ex;
                false -> "main"
            }
        end
    }
}

fn explicit_module_decl_name(decls: ListDeclaration) -> string {
    case decls.is_nil of {
        true -> "";
        false -> case decls.head.tag == 4 of {
            true -> decls.head.name;
            false -> explicit_module_decl_name(decls.tail)
        }
    }
}

fn append_sir_strings(a: ListSirString, b: ListSirString) -> ListSirString {
    case a.is_nil of {
        true -> b;
        false -> sir_ast@cons_sir_string(a.head, append_sir_strings(a.tail, b))
    }
}

fn params_to_used_modules(params: ListParam) -> ListSirString {
    case params.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> sir_ast@cons_sir_string(params.head.name, params_to_used_modules(params.tail))
    }
}

fn collect_used_modules(decls: ListDeclaration) -> ListSirString {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 2 of {
            true -> append_sir_strings(params_to_used_modules(decls.head.parameters), collect_used_modules(decls.tail));
            false -> collect_used_modules(decls.tail)
        }
    }
}

fn params_to_export_items(params: ListParam) -> ListSIRExportItem {
    case params.is_nil of {
        true -> sir_ast@nil_sir_exports();
        false -> do
            item: SIRExportItem <- SIRExportItem { fn_name: params.head.name, arity: params.head.type_name };
            sir_ast@cons_sir_export(item, params_to_export_items(params.tail))
        end
    }
}

fn append_sir_exports(a: ListSIRExportItem, b: ListSIRExportItem) -> ListSIRExportItem {
    case a.is_nil of {
        true -> b;
        false -> sir_ast@cons_sir_export(a.head, append_sir_exports(a.tail, b))
    }
}

fn collect_exports(decls: ListDeclaration) -> ListSIRExportItem {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_exports();
        false -> case decls.head.tag == 3 of {
            true -> append_sir_exports(params_to_export_items(decls.head.parameters), collect_exports(decls.tail));
            false -> collect_exports(decls.tail)
        }
    }
}

// Build SIR for a Program. Returns SIRModule (internal representation).
// Precondition: type checking has succeeded; AST has no dummy nodes in traversed paths.
// Uses compilation unit name "" (see emit_program_for_unit).
fn emit_program(program: Program, context: TypeContext) -> SIRModule proc[mem(normal)] {
    emit_program_for_unit(program, context, "")
}

fn sir_string_list_to_csv(list: ListSirString) -> string {
    case list.is_nil of {
        true -> "";
        false -> case list.tail.is_nil of {
            true -> list.head;
            false -> concat(concat(list.head, ","), sir_string_list_to_csv(list.tail))
        }
    }
}

fn emit_program_for_unit(program: Program, context: TypeContext, compilation_unit: string) -> SIRModule proc[mem(normal)] {
    sup_impls: ListSirString <- traits@collect_supervisor_impl_types(program.declarations);
    sup_csv: string <- sir_string_list_to_csv(sup_impls);
    ctx_emit: TypeContext <- type_checker_core@type_context_with_supervisor_types(context, sup_csv);
    fns: ListSIRFunction <- emit_declarations(program.declarations, ctx_emit, program.declarations);
    uses: ListSirString <- collect_used_modules(program.declarations);
    exps: ListSIRExportItem <- collect_exports(program.declarations);
    trait_names: ListSirString <- traits@collect_export_trait_names(program.declarations);
    marker_impls: ListSirString <- traits@collect_marker_impl_types(program.declarations);
    sup_phase_e: ListSIRSupervisorPhaseE <- traits@collect_supervisor_phase_e(program.declarations);
    fr_impls: ListSirString <- traits@collect_failure_reporter_impl_types(program.declarations);
    req_sigs: ListSIRRequiredMethodSig <- traits@collect_required_trait_method_sigs(program.declarations);
    nm: string <- module_name_for_sir(compilation_unit, program.declarations);
    SIRModule { module_name: nm, used_modules: uses, exports: exps, export_trait_names: trait_names, marker_impl_types: marker_impls, supervisor_impl_types: sup_impls, supervisor_phase_e: sup_phase_e, failure_reporter_impl_types: fr_impls, required_method_sigs: req_sigs, functions: fns }
}

// Traverse ListDeclaration; dispatcher delegates per Declaration.tag.
// Dummy results (name == "") are skipped (e.g. non-function declarations).
fn emit_declarations(decls: ListDeclaration, context: TypeContext, program_decls: ListDeclaration) -> ListSIRFunction proc[mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_functions();
        false -> do
            head_fn: SIRFunction <- dispatcher@emit_declaration(decls.head, context, program_decls);
            tail_fns: ListSIRFunction <- emit_declarations(decls.tail, context, program_decls);
            case len(head_fn.name) > 0 of {
                true -> sir_ast@cons_sir_functions(head_fn, tail_fns);
                false -> tail_fns
            }
        end
    }
}
