// Actor / concurrency builtins → SIR prim terms (silica-specification §4.5, §15–16; sir_design_spec §7.9).
// spawn, spawn_linked (supervisors Phase A §15.4.8.3), send per §7.9; actor_call, actor_cast, self and placement/runtime helpers use the same prim(kind 6) shape as region builtins.
//
// Phase F (cpu_topology_implementation_plan): get_cpu_topology and get_core_capabilities return named record types.
// They lower to a single kind-6 prim each: name = Silica builtin, type_name = structured return (cpu_topology / core_info),
// value = "[concurrency]", dummy inner/right for nullary or inner = lowered core_id for unary. This matches
// type_checker_expressions@actor_runtime_builtin_return_type and AArch64 emitter prims_actors (runtime returns opaque
// pointer in X0; Phase G fills heap layout). A two-step query+fill ABI would add SIR nodes here only if the ABI
// contract explicitly requires it.

use parser_ast;
use sir_ast;
use types;

export is_actor_sir_builtin/1;
export actor_call_second_arg/1;
export build_spawn_prim/4;
export build_spawn_linked_prim/5;
export build_send_prim/2;
export build_actor_call_prim/3;
export build_actor_cast_prim/2;
export build_self_prim/0;
export build_actor_runtime_prim/4;
export build_actor_runtime_prim_3/4;
export actor_runtime_sir_return_type/1;
export build_get_cpu_topology_prim/0;
export build_get_core_capabilities_prim/1;

// Parser: second argument is inner of right_expr when right is a kind-4 pair with empty name.
fn actor_call_second_arg(expr: Expr) -> Expr {
    case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
        true -> expr.right_expr.inner;
        false -> expr.right_expr
    }
}

fn is_actor_sir_builtin(name: string) -> bool {
    name == "spawn" or name == "spawn_linked" or name == "send" or name == "cast" or name == "call" or name == "self"
        or name == "pin_actor_to_core" or name == "pin_actor_to_efficiency_core" or name == "pin_actor_to_performance_core"
        or name == "pin_actor_realtime" or name == "remove_actor" or name == "pin_actor_to_numa_node"
        or name == "unpin_actor" or name == "set_actor_priority"
        or name == "get_cpu_topology" or name == "get_efficiency_cores" or name == "get_performance_cores"
        or name == "get_core_capabilities"
        or name == "get_actor_memory_usage"
        or name == "migrate_actor" or name == "move"
}

// SIR text type field for runtime helper return (mirrors type_checker_expressions@actor_runtime_builtin_return_type).
fn actor_runtime_sir_return_type(name: string) -> string {
    case name of {
        "pin_actor_to_core" -> "(int64,affinity_error)";
        "pin_actor_to_efficiency_core" -> "(int64,affinity_error)";
        "pin_actor_to_performance_core" -> "(int64,affinity_error)";
        "pin_actor_realtime" -> "(int64,affinity_error)";
        "remove_actor" -> "(int64,affinity_error)";
        "pin_actor_to_numa_node" -> "(int64,affinity_error)";
        "unpin_actor" -> "atom";
        "set_actor_priority" -> "atom";
        "get_cpu_topology" -> "{ cores: List[{ id: int64, core_type: atom, capabilities: List[string,normal], frequency_mhz: int64 },normal], numa_nodes: List[{ id: int64, cores: List[int64,normal], memory_ranges: List[{ start_address: int64, size: int64, latency: int64 },normal] },normal], cache_hierarchy: { levels: List[{ level: int64, size_kb: int64, line_size: int64, associativity: int64, shared_cores: List[int64,normal] },normal] } }";
        "get_efficiency_cores" -> "List[int64,normal]";
        "get_performance_cores" -> "List[int64,normal]";
        "get_core_capabilities" -> "{ id: int64, core_type: atom, capabilities: List[string,normal], frequency_mhz: int64 }";
        "get_actor_memory_usage" -> "i64";
        "migrate_actor" -> "atom";
        "move" -> "atom";
        _: string -> "unit"
    }
}

// spawn: §7.9 — [concurrency]; optional third arg packed as tuple_make(behavior, placement) in the right slot.
fn build_spawn_prim(init: SIRTerm, beh: SIRTerm, place: SIRTerm, three_args: bool) -> SIRTerm {
    right_slot: SIRTerm <- case three_args of {
        true -> SIRTerm { kind: 6, type_name: "unit", value: "", name: "tuple_make", inner: beh, right_expr: place };
        false -> beh
    };
    SIRTerm { kind: 6, type_name: "actor_ref", value: "[concurrency]", name: "spawn", inner: init, right_expr: right_slot }
}

// spawn_linked: §15.4.8.3 — same [concurrency] prim shape; name distinguishes runtime (supervisors_implementation_development_plan Phase A).
// 3-arg: right = tuple_make(behavior_fn_ptr, agent_type_term); 4-arg: tuple_make(tuple_make(behavior, agent_type), core_id).
fn build_spawn_linked_prim(init: SIRTerm, beh: SIRTerm, agent: SIRTerm, place: SIRTerm, four_args: bool) -> SIRTerm {
    beh_agent: SIRTerm <- SIRTerm { kind: 6, type_name: "unit", value: "", name: "tuple_make", inner: beh, right_expr: agent };
    right_slot: SIRTerm <- case four_args of {
        true -> SIRTerm { kind: 6, type_name: "unit", value: "", name: "tuple_make", inner: beh_agent, right_expr: place };
        false -> beh_agent
    };
    SIRTerm { kind: 6, type_name: "actor_ref", value: "[concurrency]", name: "spawn_linked", inner: init, right_expr: right_slot }
}

fn build_send_prim(ref_term: SIRTerm, message: SIRTerm) -> SIRTerm {
    SIRTerm { kind: 6, type_name: "unit", value: "[concurrency, mailbox]", name: "send", inner: ref_term, right_expr: message }
}

// Synchronous actor request; return type from type-checked expectation.
fn build_actor_call_prim(ref_term: SIRTerm, message: SIRTerm, return_ast_type: string) -> SIRTerm {
    sir_t: string <- types@type_name_to_sir(return_ast_type);
    SIRTerm { kind: 6, type_name: sir_t, value: "[concurrency, mailbox]", name: "actor_call", inner: ref_term, right_expr: message }
}

// Fire-and-forget mailbox delivery; Silica surface returns boolean (§16.1.2). Distinct from sir_design_spec §7.12 repr cast.
fn build_actor_cast_prim(ref_term: SIRTerm, message: SIRTerm) -> SIRTerm {
    SIRTerm { kind: 6, type_name: "bool", value: "[concurrency, mailbox]", name: "actor_cast", inner: ref_term, right_expr: message }
}

fn build_self_prim() -> SIRTerm {
    d: SIRTerm <- sir_ast@dummy_sir_term();
    SIRTerm { kind: 6, type_name: "actor_ref", value: "[concurrency]", name: "self", inner: d, right_expr: d }
}

// Runtime helpers (CPU affinity, topology, migration): prim name = Silica builtin, arity 0–3.
fn build_actor_runtime_prim(builtin_name: string, sir_ret: string, arg0: SIRTerm, arg1: SIRTerm, nargs: int64) -> SIRTerm {
    d: SIRTerm <- sir_ast@dummy_sir_term();
    case nargs of {
        0 -> SIRTerm { kind: 6, type_name: sir_ret, value: "[concurrency]", name: builtin_name, inner: d, right_expr: d };
        1 -> SIRTerm { kind: 6, type_name: sir_ret, value: "[concurrency]", name: builtin_name, inner: arg0, right_expr: d };
        2 -> SIRTerm { kind: 6, type_name: sir_ret, value: "[concurrency]", name: builtin_name, inner: arg0, right_expr: arg1 };
        _: int64 -> sir_ast@dummy_sir_term()
    }
}

fn build_actor_runtime_prim_3(builtin_name: string, sir_ret: string, arg0: SIRTerm, arg1: SIRTerm, arg2: SIRTerm) -> SIRTerm {
    packed: SIRTerm <- SIRTerm { kind: 6, type_name: "unit", value: "", name: "tuple_make", inner: arg1, right_expr: arg2 };
    SIRTerm { kind: 6, type_name: sir_ret, value: "[concurrency]", name: builtin_name, inner: arg0, right_expr: packed }
}

// Structured topology builtins: one prim, type_name = named record per type checker (Phase F).
fn build_get_cpu_topology_prim() -> SIRTerm {
    d: SIRTerm <- sir_ast@dummy_sir_term();
    ret: string <- actor_runtime_sir_return_type("get_cpu_topology");
    build_actor_runtime_prim("get_cpu_topology", ret, d, d, 0)
}

fn build_get_core_capabilities_prim(arg0: SIRTerm) -> SIRTerm {
    d: SIRTerm <- sir_ast@dummy_sir_term();
    ret: string <- actor_runtime_sir_return_type("get_core_capabilities");
    build_actor_runtime_prim("get_core_capabilities", ret, arg0, d, 1)
}
