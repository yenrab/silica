// Boolean literal expression to SIR term (Expr kind 7)
// Builds const(bool, "true") or const(bool, "false")

use parser_ast;
use type_checker_core;
use sir_ast;
use types;

export expr_to_sir/2;

// Build SIR const term for boolean literal (Expr kind 7)
fn expr_to_sir(context: TypeContext, expr: Expr) -> SIRTerm {
    SIRTerm { kind: 0, type_name: types@type_name_to_sir("boolean"), value: expr.value, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}
