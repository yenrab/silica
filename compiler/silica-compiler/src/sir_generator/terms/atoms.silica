// Atom literal expression to SIR term (Expr kind 5) and atom built-in calls
// Literal: const(atom, value); print_atom(atom) -> call(atom, main.print_atom, [arg], [device_io])

use parser_ast;
use type_checker_core;
use sir_ast;
use types;

export expr_to_sir/2;
export build_print_atom_from_sir/2;

fn qual_name(name: string) -> string {
    concat("main.", name)
}

// Build SIR const term for atom literal (Expr kind 5)
fn expr_to_sir(context: TypeContext, expr: Expr) -> SIRTerm {
    SIRTerm { kind: 0, type_name: types@type_name_to_sir("atom"), value: expr.value, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}

// Build SIR call term for print_atom(atom) -> atom (:ok on success, :fail on failure). Effect: device_io.
fn build_print_atom_from_sir(call_name: string, arg: SIRTerm) -> SIRTerm {
    callee: string <- qual_name(call_name);
    SIRTerm { kind: 4, type_name: "atom", value: "[device_io]", name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
}
