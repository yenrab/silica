// Function call expression to SIR term (Expr kind 4, extension)
// Built-in I/O: print_string(string) -> call(atom, main.print_string, [arg], [device_io])
// Built-in I/O: println(string) -> call(atom, main.println, [arg], [device_io]) - appends \n to string
// Stderr mirrors (silica §22-style device_io; fd 2): print_string_stderr, println_stderr
// concatenate/2: two string args (literals or bound vars) -> prim(string_concat, a, b) per sir_design_spec §7.10
// Effect set carried on SIRTerm.value per sir_design_spec §5.2.5

use sir_ast;
use types;

export build_print_string_from_sir/2;
export build_println_from_sir/2;
export build_print_string_stderr_from_sir/2;
export build_println_stderr_from_sir/2;
export build_concatenate_from_sir/2;
export build_substring_from_sir/3;
export build_substring_until_char_from_sir/3;
export build_length_bytes_from_sir/1;
export build_length_chars_from_sir/1;

fn qual_name(name: string) -> string {
    concat("main.", name)
}

// Effect sets for built-in functions (spec §7.11 Device I/O)
fn builtin_call_effects(call_name: string) -> string {
    case call_name of {
        "print_string" -> "[device_io]";
        "println" -> "[device_io]";
        "print_string_stderr" -> "[device_io]";
        "println_stderr" -> "[device_io]";
        _: string -> "[]"
    }
}

// Build SIR call term for print_string(string) -> atom. Effect: device_io.
fn build_print_string_from_sir(call_name: string, arg: SIRTerm) -> SIRTerm {
    case call_name == "print_string" of {
        true -> do
            callee: string <- qual_name(call_name);
            eff: string <- builtin_call_effects(call_name);
            SIRTerm { kind: 4, type_name: "atom", value: eff, name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
        end;
        false -> sir_ast@dummy_sir_term()
    }
}

// Build SIR call term for println(string) -> atom. Effect: device_io. Semantics: print string then \n.
fn build_println_from_sir(call_name: string, arg: SIRTerm) -> SIRTerm {
    case call_name == "println" of {
        true -> do
            callee: string <- qual_name(call_name);
            eff: string <- builtin_call_effects(call_name);
            SIRTerm { kind: 4, type_name: "atom", value: eff, name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
        end;
        false -> sir_ast@dummy_sir_term()
    }
}

fn build_print_string_stderr_from_sir(call_name: string, arg: SIRTerm) -> SIRTerm {
    case call_name == "print_string_stderr" of {
        true -> do
            callee: string <- qual_name(call_name);
            eff: string <- builtin_call_effects(call_name);
            SIRTerm { kind: 4, type_name: "atom", value: eff, name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
        end;
        false -> sir_ast@dummy_sir_term()
    }
}

fn build_println_stderr_from_sir(call_name: string, arg: SIRTerm) -> SIRTerm {
    case call_name == "println_stderr" of {
        true -> do
            callee: string <- qual_name(call_name);
            eff: string <- builtin_call_effects(call_name);
            SIRTerm { kind: 4, type_name: "atom", value: eff, name: callee, inner: arg, right_expr: sir_ast@dummy_sir_term() }
        end;
        false -> sir_ast@dummy_sir_term()
    }
}

// Build SIR prim term for concatenate(a: string, b: string) -> string. Per sir_design_spec §7.10: string_concat.
// Args can be string literals (const) or bound string variables (var).
fn build_concatenate_from_sir(arg1: SIRTerm, arg2: SIRTerm) -> SIRTerm {
    sir_type: string <- types@type_name_to_sir("string");
    SIRTerm { kind: 6, type_name: sir_type, value: "", name: "string_concat", inner: arg1, right_expr: arg2 }
}

// substring(s: string, start: int64, end: int64) -> string. Spec §5.3.2 String Manipulation.
// 3-arg prim: encoded as prim(string_substring, s, prim(string_substring_rest, start, end)).
fn build_substring_from_sir(arg1: SIRTerm, arg2: SIRTerm, arg3: SIRTerm) -> SIRTerm {
    sir_type: string <- types@type_name_to_sir("string");
    rest: SIRTerm <- SIRTerm { kind: 6, type_name: "int64", value: "", name: "string_substring_rest", inner: arg2, right_expr: arg3 };
    SIRTerm { kind: 6, type_name: sir_type, value: "", name: "string_substring", inner: arg1, right_expr: rest }
}

// substring_until_char(s: string, start: int64, char: char) -> string. Spec §5.3.2 String Manipulation.
// 3-arg prim: encoded as prim(string_substring_until_char, s, prim(string_substring_until_char_rest, start, char)).
fn build_substring_until_char_from_sir(arg1: SIRTerm, arg2: SIRTerm, arg3: SIRTerm) -> SIRTerm {
    sir_type: string <- types@type_name_to_sir("string");
    rest: SIRTerm <- SIRTerm { kind: 6, type_name: "char", value: "", name: "string_substring_until_char_rest", inner: arg2, right_expr: arg3 };
    SIRTerm { kind: 6, type_name: sir_type, value: "", name: "string_substring_until_char", inner: arg1, right_expr: rest }
}

// length_bytes(s: string) -> int64. Spec §silica:StringLengthOperations.
fn build_length_bytes_from_sir(arg: SIRTerm) -> SIRTerm {
    SIRTerm { kind: 6, type_name: "int64", value: "", name: "string_length_bytes", inner: arg, right_expr: sir_ast@dummy_sir_term() }
}

// length_chars(s: string) -> int64. Spec §silica:StringLengthOperations.
fn build_length_chars_from_sir(arg: SIRTerm) -> SIRTerm {
    SIRTerm { kind: 6, type_name: "int64", value: "", name: "string_length_chars", inner: arg, right_expr: sir_ast@dummy_sir_term() }
}
