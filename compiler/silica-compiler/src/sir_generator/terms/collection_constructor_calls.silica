// Layer 1 §7.5/§7.9: canonical arena injection and ordering-bundle materialization at collection constructor let-bindings.

use parser_ast;
use sir_ast;
use types;
use type_checker_core;
use type_checker_collections;
use type_checker_tuple_decompose_helpers;
use type_checker_record_types;
use memory_region_calls;
use struct_terms;
use literals;
use ordering_identity_calls;

export is_collection_constructor_let/2;
export build_collection_constructor_lets/6;

fn is_collection_constructor_let(bind_type: string, rhs_expr: Expr) -> bool {
    case rhs_expr.kind == 4 of {
        false -> false;
        true -> case type_checker_collections@is_collection_constructor_base_name(rhs_expr.name) of {
            false -> false;
            true -> case type_checker_collections@is_collection_trait_type(bind_type) of {
                true -> do
                    mod_name: string <- type_checker_collections@module_name_from_qualified_call(rhs_expr.name);
                    type_checker_collections@is_registered_construction_module(mod_name)
                end;
                false -> do
                    mod_name: string <- type_checker_collections@module_name_from_qualified_call(rhs_expr.name);
                    case type_checker_collections@is_registered_construction_module(mod_name) of {
                        false -> false;
                        true -> type_checker_collections@bind_type_has_collection_runtime_fields(bind_type)
                    }
                end
            }
        }
    }
}

fn spec_key_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__spec_key")
}

fn arena_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__arena")
}

fn raw_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__raw")
}

fn region_type_for_bind(bind_type: string) -> string {
    space: string <- type_checker_collections@collection_space_from_type(bind_type);
    case len(space) == 0 of {
        true -> "region(L, normal)";
        false -> do
            inner: string <- case len(space) >= 5 and substring(space, 0, 4) == "mem(" of {
                true -> substring(space, 4, len(space) - 1);
                false -> "normal"
            };
            concat(concat("region(L, ", inner), ")")
        end
    }
}

fn return_type_from_call(context: TypeContext, call_expr: Expr) -> string {
    inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(call_expr, context);
    case len(inferred) > 0 of {
        true -> inferred;
        false -> do
            (found: bool, fn_type: string) <- type_checker_core@lookup_symbol_found(context.env, call_expr.name);
            case found of {
                true -> extract_return_from_fn_type(fn_type);
                false -> ""
            }
        end
    }
}

fn extract_return_from_fn_type(fn_type: string) -> string {
    t: string <- fn_type;
    arrow: int64 <- find_arrow_in_fn_type(t, 0, 0);
    case arrow < 0 of {
        true -> "";
        false -> substring(t, arrow + 2, len(t))
    }
}

fn find_arrow_in_fn_type(s: string, i: int64, depth: int64) -> int64 {
    case i + 2 > len(s) of {
        true -> -1;
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "{" or c == "[" of {
                true -> find_arrow_in_fn_type(s, i + 1, depth + 1);
                false -> case c == ")" or c == "}" or c == "]" of {
                    true -> find_arrow_in_fn_type(s, i + 1, depth - 1);
                    false -> case depth == 0 and substring(s, i, i + 2) == "->" of {
                        true -> i;
                        false -> find_arrow_in_fn_type(s, i + 1, depth)
                    }
                }
            }
        end
    }
}

fn int64_const_sir(value: int64) -> SIRTerm {
    dec: string <- literals@int64_to_decimal_string(value);
    SIRTerm { kind: 0, type_name: "i64", value: dec, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}

fn atom_const_sir(lexeme: string) -> SIRTerm {
    SIRTerm { kind: 0, type_name: "atom", value: lexeme, name: "", inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}

fn var_ref_sir(prefixed: string, sir_type: string) -> SIRTerm {
    SIRTerm { kind: 1, type_name: sir_type, value: "", name: prefixed, inner: sir_ast@dummy_sir_term(), right_expr: sir_ast@dummy_sir_term() }
}

fn build_arena_lookup_sir(key_sir: SIRTerm, region_type: string) -> SIRTerm {
    memory_region_calls@build_region_prim_from_sir("canonical_arena_lookup", key_sir, sir_ast@dummy_sir_term(), region_type, "")
}

fn field_type_from_segment(seg: string) -> string {
    colon: int64 <- find_colon_in_segment(seg, 0, 0, 0);
    case colon < 0 of {
        true -> "";
        false -> substring(seg, colon + 1, len(seg))
    }
}

fn find_colon_in_segment(s: string, i: int64, depth: int64, paren: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "{" of {
                true -> find_colon_in_segment(s, i + 1, depth + 1, paren);
                false -> case c == "}" of {
                    true -> find_colon_in_segment(s, i + 1, depth - 1, paren);
                    false -> case c == "(" of {
                        true -> find_colon_in_segment(s, i + 1, depth, paren + 1);
                        false -> case c == ")" of {
                            true -> find_colon_in_segment(s, i + 1, depth, paren - 1);
                            false -> case c == ":" and depth == 0 and paren == 0 of {
                                true -> i;
                                false -> find_colon_in_segment(s, i + 1, depth, paren)
                            }
                        }
                    }
                }
            }
        end
    }
}

fn ordering_bundle_field_name(fn_field: string) -> string {
    concat(fn_field, "_ordering_bundle")
}

fn fn_field_projection(
    fn_field: string,
    fn_type: string,
    raw_ast_type: string,
    raw_var: string
) -> SIRTerm {
    base: SIRTerm <- var_ref_sir(raw_var, types@type_name_to_sir(raw_ast_type));
    struct_terms@build_record_proj_prim(types@type_name_to_sir(fn_type), fn_field, base)
}

fn bundle_side_binding_name(bind_name: string, fn_field: string) -> string {
    concat(concat(bind_name, "."), ordering_bundle_field_name(fn_field))
}

fn ordering_field_count_for_merge(bind_type: string, mod_name: string) -> int64 {
    from_bind: int64 <- type_checker_collections@constructor_ordering_field_count(bind_type);
    case from_bind > 0 of {
        true -> from_bind;
        false -> type_checker_collections@constructor_ordering_field_count_for_module(mod_name)
    }
}

fn ordering_field_at_for_merge(bind_type: string, mod_name: string, idx: int64) -> string {
    from_bind: int64 <- type_checker_collections@constructor_ordering_field_count(bind_type);
    case from_bind > 0 of {
        true -> type_checker_collections@constructor_ordering_field_at(bind_type, idx);
        false -> type_checker_collections@constructor_ordering_field_at_for_module(mod_name, idx)
    }
}

fn raw_reanchor_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__raw_anchor")
}

fn key_reanchor_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__key_anchor")
}

fn fn_side_binding_name(bind_name: string, fn_field: string) -> string {
    concat(concat(concat(bind_name, ".__fn_"), fn_field), "")
}

fn should_inject_ordering_bundles(bind_name: string) -> bool {
    case len(bind_name) == 1 and substring(bind_name, 0, 1) == "_" of {
        true -> false;
        false -> true
    }
}

fn record_literal_field_expr(record_expr: Expr, field_name: string) -> Expr {
    case record_expr.kind == 21 of {
        false -> parser_ast@dummy_expr();
        true -> case record_expr.name == field_name of {
            true -> record_expr.inner;
            false -> record_literal_field_expr(record_expr.right_expr, field_name)
        }
    }
}

fn build_fn_ordering_bundle_from_fn_ref(context: TypeContext, fn_ref: SIRTerm, fn_expr: Expr, orient_lexeme: string) -> SIRTerm {
    env_sir: SIRTerm <- ordering_identity_calls@build_ordering_env_for_fn_operand(context, fn_expr);
    fn_token: SIRTerm <- ordering_identity_calls@build_ordering_identity_prim_from_sir("ordering_identity_materialize", fn_ref, env_sir, "int64");
    orient: SIRTerm <- atom_const_sir(orient_lexeme);
    ordering_identity_calls@build_ordering_identity_prim_from_sir("ordering_identity_bundle_make", fn_token, orient, "int64")
}

fn wrap_bundle_side_lets(
    context: TypeContext,
    call_expr: Expr,
    bind_name: string,
    bind_type: string,
    mod_name: string,
    raw_ast_type: string,
    raw_var: string,
    orient_lexeme: string,
    field_idx: int64,
    field_count: int64,
    inner_sir: SIRTerm
) -> SIRTerm {
    case field_idx >= field_count of {
        true -> inner_sir;
        false -> do
            fname: string <- ordering_field_at_for_merge(bind_type, mod_name, field_idx);
            side_name: string <- bundle_side_binding_name(bind_name, fname);
            side_prefixed: string <- concat("%", side_name);
            fn_side_name: string <- fn_side_binding_name(bind_name, fname);
            fn_side_prefixed: string <- concat("%", fn_side_name);
            fn_type: string <- type_checker_record_types@find_field_type_in_record(raw_ast_type, fname);
            fn_type_sir: string <- types@type_name_to_sir(fn_type);
            fn_proj: SIRTerm <- fn_field_projection(fname, fn_type, raw_ast_type, raw_var);
            fn_ref: SIRTerm <- var_ref_sir(fn_side_prefixed, fn_type_sir);
            fn_expr: Expr <- record_literal_field_expr(call_expr.inner, fname);
            bundle_sir: SIRTerm <- build_fn_ordering_bundle_from_fn_ref(context, fn_ref, fn_expr, orient_lexeme);
            next: SIRTerm <- wrap_bundle_side_lets(context, call_expr, bind_name, bind_type, mod_name, raw_ast_type, raw_var, orient_lexeme, field_idx + 1, field_count, inner_sir);
            bundle_let: SIRTerm <- SIRTerm { kind: 2, type_name: "i64", value: "", name: side_prefixed, inner: bundle_sir, right_expr: next };
            SIRTerm { kind: 2, type_name: fn_type_sir, value: "", name: fn_side_prefixed, inner: fn_proj, right_expr: bundle_let }
        end
    }
}

fn merged_record_type_with_bundle_fields(
    bind_type: string,
    mod_name: string,
    field_idx: int64,
    field_count: int64
) -> string {
    case field_idx >= field_count of {
        true -> bind_type;
        false -> do
            fname: string <- ordering_field_at_for_merge(bind_type, mod_name, field_idx);
            bundle_name: string <- ordering_bundle_field_name(fname);
            with_field: string <- case len(type_checker_record_types@find_field_type_in_record(bind_type, bundle_name)) > 0 of {
                true -> bind_type;
                false -> concat(
                    substring(bind_type, 0, len(bind_type) - 1),
                    concat(", ", concat(bundle_name, ": int64}"))
                )
            };
            merged_record_type_with_bundle_fields(with_field, mod_name, field_idx + 1, field_count)
        end
    }
}

fn append_bundle_var_merge_layers(
    bind_name: string,
    bind_type: string,
    mod_name: string,
    field_idx: int64,
    field_count: int64,
    merged_ast_type: string,
    acc: SIRTerm
) -> SIRTerm {
    case field_idx >= field_count of {
        true -> acc;
        false -> do
            fname: string <- ordering_field_at_for_merge(bind_type, mod_name, field_idx);
            side_name: string <- bundle_side_binding_name(bind_name, fname);
            side_prefixed: string <- concat("%", side_name);
            bname: string <- ordering_bundle_field_name(fname);
            val: SIRTerm <- var_ref_sir(side_prefixed, "i64");
            sir_rt: string <- types@type_name_to_sir(merged_ast_type);
            next: SIRTerm <- struct_terms@build_record_make_layer(sir_rt, bname, val, acc);
            append_bundle_var_merge_layers(bind_name, bind_type, mod_name, field_idx + 1, field_count, merged_ast_type, next)
        end
    }
}

fn value_for_merge_field(
    field_name: string,
    field_type: string,
    raw_ast_type: string,
    raw_var: string,
    arena_var: string,
    key_var: string,
    region_type: string
) -> SIRTerm {
    case field_name == "region" of {
        true -> var_ref_sir(arena_var, types@type_name_to_sir(region_type));
        false -> case field_name == "specialization_key" of {
            true -> var_ref_sir(key_var, "i64");
            false -> fn_field_projection(field_name, field_type, raw_ast_type, raw_var)
        }
    }
}

fn build_merge_layers(
    remaining: string,
    raw_ast_type: string,
    merged_ast_type: string,
    raw_var: string,
    arena_var: string,
    key_var: string,
    region_type: string,
    acc: SIRTerm
) -> SIRTerm {
    case len(remaining) == 0 of {
        true -> acc;
        false -> build_merge_layers_step(remaining, raw_ast_type, merged_ast_type, raw_var, arena_var, key_var, region_type, acc)
    }
}

fn build_merge_layers_step(
    rem: string,
    raw_ast_type: string,
    merged_ast_type: string,
    raw_var: string,
    arena_var: string,
    key_var: string,
    region_type: string,
    acc: SIRTerm
) -> SIRTerm {
    (seg: string, rest: string) <- type_checker_record_types@record_case_field_step(rem);
    (fname: string, _: string) <- type_checker_record_types@record_field_segment_name_sub(seg);
    ftype: string <- field_type_from_segment(seg);
    val: SIRTerm <- value_for_merge_field(fname, ftype, raw_ast_type, raw_var, arena_var, key_var, region_type);
    sir_rt: string <- types@type_name_to_sir(merged_ast_type);
    next: SIRTerm <- struct_terms@build_record_make_layer(sir_rt, fname, val, acc);
    build_merge_layers(rest, raw_ast_type, merged_ast_type, raw_var, arena_var, key_var, region_type, next)
}

fn build_merged_record(
    bind_name: string,
    bind_type: string,
    mod_name: string,
    raw_ast_type: string,
    raw_var: string,
    arena_var: string,
    key_var: string,
    region_type: string,
    field_count: int64
) -> SIRTerm {
    inner: string <- type_checker_record_types@record_case_inner_body(raw_ast_type);
    merged_base_type: string <- case len(bind_type) > 0 and substring(bind_type, 0, 1) == "{" of {
        true -> bind_type;
        false -> raw_ast_type
    };
    merged_ast_type: string <- merged_record_type_with_bundle_fields(merged_base_type, mod_name, 0, field_count);
    // Record-make layers are emitted from outer to inner.  Seed the ordinary
    // field merge with bundle overrides as its tail so the computed bundle is
    // stored after the raw constructor field, not overwritten by it.
    bundle_overrides: SIRTerm <- append_bundle_var_merge_layers(
        bind_name,
        bind_type,
        mod_name,
        0,
        field_count,
        merged_ast_type,
        sir_ast@dummy_sir_term()
    );
    build_merge_layers(inner, raw_ast_type, merged_ast_type, raw_var, arena_var, key_var, region_type, bundle_overrides)
}

fn build_collection_constructor_lets(context: TypeContext, bind_name: string, bind_type: string, rhs_expr: Expr, rhs_sir: SIRTerm, inner_sir: SIRTerm) -> SIRTerm {
    mod_name: string <- type_checker_collections@module_name_from_qualified_call(rhs_expr.name);
    key: int64 <- type_checker_collections@collection_specialization_key(bind_type, mod_name);
    region_type: string <- region_type_for_bind(bind_type);
    bind_type_sir: string <- types@type_name_to_sir(bind_type);
    raw_ast_type: string <- return_type_from_call(context, rhs_expr);
    orient_lexeme: string <- type_checker_collections@constructor_orientation_atom_lexeme(mod_name);
    case len(raw_ast_type) == 0 of {
        true -> do
            prefixed_fn: string <- concat("%", bind_name);
            SIRTerm { kind: 2, type_name: bind_type_sir, value: "", name: prefixed_fn, inner: rhs_sir, right_expr: inner_sir }
        end;
        false -> do
            key_name: string <- spec_key_binding_name(bind_name);
            arena_name: string <- arena_binding_name(bind_name);
            raw_name: string <- raw_binding_name(bind_name);
            key_prefixed: string <- concat("%", key_name);
            arena_prefixed: string <- concat("%", arena_name);
            raw_prefixed: string <- concat("%", raw_name);
            bind_prefixed: string <- concat("%", bind_name);
            key_sir: SIRTerm <- int64_const_sir(key);
            arena_sir: SIRTerm <- build_arena_lookup_sir(var_ref_sir(key_prefixed, "i64"), region_type);
            inject_bundles: bool <- should_inject_ordering_bundles(bind_name);
            field_count_total: int64 <- ordering_field_count_for_merge(bind_type, mod_name);
            field_count: int64 <- case inject_bundles of {
                true -> field_count_total;
                false -> 0
            };
            merge_raw_var: string <- case inject_bundles of {
                true -> do
                    reanchor_name: string <- raw_reanchor_binding_name(bind_name);
                    concat("%", reanchor_name)
                end;
                false -> raw_prefixed
            };
            merge_key_var: string <- case inject_bundles of {
                true -> do
                    key_anchor_name: string <- key_reanchor_binding_name(bind_name);
                    concat("%", key_anchor_name)
                end;
                false -> key_prefixed
            };
            merged: SIRTerm <- build_merged_record(bind_name, bind_type, mod_name, raw_ast_type, merge_raw_var, arena_prefixed, merge_key_var, region_type, field_count);
            bind_let: SIRTerm <- SIRTerm { kind: 2, type_name: bind_type_sir, value: "", name: bind_prefixed, inner: merged, right_expr: inner_sir };
            bind_with_bundles: SIRTerm <- wrap_bundle_side_lets(context, rhs_expr, bind_name, bind_type, mod_name, raw_ast_type, merge_raw_var, orient_lexeme, 0, field_count, bind_let);
            bind_for_bundles: SIRTerm <- case inject_bundles of {
                true -> do
                    key_anchor_name: string <- key_reanchor_binding_name(bind_name);
                    key_anchor_prefixed: string <- concat("%", key_anchor_name);
                    key_reanchor_let: SIRTerm <- SIRTerm { kind: 2, type_name: "i64", value: "", name: key_anchor_prefixed, inner: var_ref_sir(key_prefixed, "i64"), right_expr: bind_with_bundles };
                    key_reanchor_let
                end;
                false -> bind_with_bundles
            };
            raw_body: SIRTerm <- case inject_bundles of {
                true -> do
                    reanchor_name: string <- raw_reanchor_binding_name(bind_name);
                    reanchor_prefixed: string <- concat("%", reanchor_name);
                    reanchor_let: SIRTerm <- SIRTerm { kind: 2, type_name: types@type_name_to_sir(raw_ast_type), value: "", name: reanchor_prefixed, inner: var_ref_sir(raw_prefixed, types@type_name_to_sir(raw_ast_type)), right_expr: bind_for_bundles };
                    SIRTerm { kind: 2, type_name: types@type_name_to_sir(raw_ast_type), value: "", name: raw_prefixed, inner: rhs_sir, right_expr: reanchor_let }
                end;
                false -> SIRTerm { kind: 2, type_name: types@type_name_to_sir(raw_ast_type), value: "", name: raw_prefixed, inner: rhs_sir, right_expr: bind_for_bundles }
            };
            raw_let: SIRTerm <- raw_body;
            arena_let: SIRTerm <- SIRTerm { kind: 2, type_name: types@type_name_to_sir(region_type), value: "", name: arena_prefixed, inner: arena_sir, right_expr: raw_let };
            SIRTerm { kind: 2, type_name: "i64", value: "", name: key_prefixed, inner: key_sir, right_expr: arena_let }
        end
    }
}
