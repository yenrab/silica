// Unique SIR / assembly link names when multiple tag-0 functions share the same name and arity
// (trait `impl fn` overloads). Call-site resolution mirrors the type checker’s qualified-call rules
// and Phase 0.4 #5 trait-dispatch concrete receiver resolution.

use parser_ast;
use type_checker_core;
use type_checker_traits;
use type_checker_tuple_decompose_helpers;
use type_checker_expressions;
use instantiated_fn_name;

export sir_fn_link_name/2;
export sir_resolve_qualified_callee_composite/4;
export mangle_fn_part_if_overloaded/6;
export type_slug_for_param_type/1;
export count_call_args_user_call/1;

fn qual_name_local(name: string) -> string {
    case name of {
        "m" -> "main";
        _: string -> name
    }
}

fn list_param_length_call(ps: ListParam) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> 1 + list_param_length_call(ps.tail)
    }
}

fn count_additional_call_args_user_call(er: Expr) -> int64 {
    case er.kind == -1 of {
        true -> 0;
        false -> case er.kind == 4 of {
            true -> 1 + count_additional_call_args_user_call(er.right_expr);
            false -> 0
        }
    }
}

fn count_call_args_user_call(expr: Expr) -> int64 {
    case expr.inner.kind == -1 of {
        true -> 0;
        false -> 1 + count_additional_call_args_user_call(expr.right_expr)
    }
}

// True when `name` is an exported trait in this decl list (tag 5).
fn trait_name_exported_mangle(decls: ListDeclaration, name: string) -> bool {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 5 and decls.head.name == name of {
            true -> true;
            false -> trait_name_exported_mangle(decls.tail, name)
        }
    }
}

// First-param type text (trimmed). ListParam is stored head=last formal; reverse to source order.
fn first_param_type_mangle(params: ListParam) -> string {
    source_params: ListParam <- parser_ast@list_param_reverse_with_acc(params, parser_ast@nil_list_param());
    case source_params.is_nil of {
        true -> "";
        false -> type_checker_traits@trim_type_text(source_params.head.type_name)
    }
}

// Provided-method templates (tag 0, Self-typed first param) are not link symbols after
// trait specialization: they are replaced by concrete clones or dropped when overridden.
// Iface stubs still inject the Self export as tag 0 alongside concrete impl stubs; counting
// that template as an overload falsely mangles call sites (e.g. ValueTrait@value override).
fn is_provided_method_template_mangle(d: Declaration, all_decls: ListDeclaration) -> bool {
    case d.tag == 0 of {
        false -> false;
        true -> case d.parameters.is_nil of {
            true -> false;
            false -> trait_name_exported_mangle(all_decls, first_param_type_mangle(d.parameters))
        }
    }
}

// Count linkable tag-0 declarations sharing the same operation base name and arity
// (Phase 0.4 overload set). Skips provided-method templates (see above).
fn count_tag0_same_name_arity(decls: ListDeclaration, fn_base: string, arity: int64) -> int64 {
    count_tag0_same_name_arity_scan(decls, decls, fn_base, arity)
}

fn count_tag0_same_name_arity_scan(scan: ListDeclaration, all_decls: ListDeclaration, fn_base: string, arity: int64) -> int64 {
    case scan.is_nil of {
        true -> 0;
        false -> case scan.head.tag == 0 of {
            true -> case instantiated_fn_name@fn_base_name_before_brackets(scan.head.name) == fn_base and list_param_length_call(scan.head.parameters) == arity of {
                true -> case is_provided_method_template_mangle(scan.head, all_decls) of {
                    true -> count_tag0_same_name_arity_scan(scan.tail, all_decls, fn_base, arity);
                    false -> 1 + count_tag0_same_name_arity_scan(scan.tail, all_decls, fn_base, arity)
                };
                false -> count_tag0_same_name_arity_scan(scan.tail, all_decls, fn_base, arity)
            };
            false -> count_tag0_same_name_arity_scan(scan.tail, all_decls, fn_base, arity)
        }
    }
}

fn link_name_from_decl(decl: Declaration, overload_count: int64) -> string {
    case overload_count <= 1 of {
        true -> instantiated_fn_name@link_name_to_asm_symbol(decl.name);
        false -> do
            ret_slug: string <- type_slug_for_param_type(decl.return_type_name);
            prefix: string <- instantiated_fn_name@link_name_to_asm_symbol(decl.name);
            case decl.parameters.is_nil of {
                true -> concat(prefix, concat("__ret_", ret_slug));
                false -> do
                    source_params: ListParam <- parser_ast@list_param_reverse_with_acc(decl.parameters, parser_ast@nil_list_param());
                    concat(prefix, concat("__", concat(type_slug_for_param_type(source_params.head.type_name), concat("__ret_", ret_slug))))
                end
            }
        end
    }
}

fn find_tag0_decl_for_qualified_call(decls: ListDeclaration, fn_name: string, arity: int64, recv_ty: string, expected_ty: string, world: ListNamedProgram) -> (bool, Declaration) {
    type_checker_expressions@find_tag0_decl_for_qualified_call(decls, fn_name, arity, recv_ty, expected_ty, world)
}

// Map type text to a conservative asm-safe slug (alphanumeric + underscore).
fn type_slug_char(c: string) -> string {
    case c of {
        "{" -> "_";
        "}" -> "_";
        ":" -> "_";
        "," -> "_";
        " " -> "_";
        "(" -> "_";
        ")" -> "_";
        "[" -> "_";
        "]" -> "_";
        "|" -> "_";
        "-" -> "_";
        "<" -> "_";
        ">" -> "_";
        "." -> "_";
        "\"" -> "_";
        "'" -> "_";
        _: string -> c
    }
}

fn type_slug_scan(s: string, i: int64, acc: string) -> string {
    case i >= len(s) of {
        true -> acc;
        false -> do
            ch: string <- substring(s, i, i + 1);
            mapped: string <- type_slug_char(ch);
            type_slug_scan(s, i + 1, concat(acc, mapped))
        end
    }
}

fn type_slug_for_param_type(t: string) -> string {
    raw: string <- type_checker_traits@trim_type_text(t);
    type_slug_scan(raw, 0, "")
}

// SIR / asm definition name for a tag-0 declaration within one compilation unit.
fn sir_fn_link_name(decl: Declaration, all_decls: ListDeclaration) -> string {
    case decl.tag == 0 of {
        false -> qual_name_local(decl.name);
        true -> do
            arity: int64 <- list_param_length_call(decl.parameters);
            fn_base: string <- instantiated_fn_name@fn_base_name_before_brackets(decl.name);
            n: int64 <- count_tag0_same_name_arity(all_decls, fn_base, arity);
            link_name_from_decl(decl, n)
        end
    }
}

fn mangle_fn_part_if_overloaded(fn_id: string, arity: int64, recv_ty: string, expected_ty: string, callee_decls: ListDeclaration, world: ListNamedProgram) -> string {
    fn_base: string <- instantiated_fn_name@fn_base_name_before_brackets(fn_id);
    n: int64 <- count_tag0_same_name_arity(callee_decls, fn_base, arity);
    resolved_recv: string <- type_checker_expressions@recv_type_for_trait_link_mangle(recv_ty, callee_decls, world);
    (df: bool, d: Declaration) <- find_tag0_decl_for_qualified_call(callee_decls, fn_id, arity, resolved_recv, expected_ty, world);
    case df of {
        true -> link_name_from_decl(d, n);
        false -> do
            (df2: bool, d2: Declaration) <- type_checker_expressions@find_function_decl_by_name_arity_call(callee_decls, fn_id, arity);
            case df2 of {
                true -> link_name_from_decl(d2, n);
                false -> fn_id
            }
        end
    }
}

// Rewrite module@fn when fn is overloaded in the callee module (must match sir_fn_link_name).
fn sir_resolve_qualified_callee_composite(world: ListNamedProgram, context: TypeContext, expr: Expr, composite: string) -> string {
    (mod_part: string, fn_part: string) <- type_checker_core@split_module_qualified_call_name(composite);
    case len(mod_part) == 0 of {
        true -> composite;
        false -> do
            (pf: bool, prog: Program) <- parser_ast@find_named_program(mod_part, world);
            case pf of {
                false -> composite;
                true -> do
                    ac: int64 <- count_call_args_user_call(expr);
                    recv_ty: string <- case ac > 0 of {
                        true -> do
                            inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                            type_checker_expressions@recv_type_for_trait_link_mangle(inferred, prog.declarations, world)
                        end;
                        false -> ""
                    };
                    fn2: string <- mangle_fn_part_if_overloaded(fn_part, ac, recv_ty, "", prog.declarations, world);
                    concat(mod_part, concat("@", fn2))
                end
            }
        end
    }
}
