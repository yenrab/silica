// FFI module rules (silica_ffi_wrapper_specification.md §3): dangerous_* naming, wrapper_meta paths,
// export surface for raw foreign bindings and adapter wrappers. Phase 3 — path rules only (no sidecar load).

use parser_ast;
use diagnostics_core;

export validate_ffi_module_rules/2;
export validate_export_item_ffi/5;
export emit_ffi_wrapper_warnings/1;

fn dangerous_prefix() -> string {
    "dangerous_"
}

fn is_dangerous_module_name(name: string) -> bool {
    pref: string <- dangerous_prefix();
    case len(name) >= len(pref) of {
        false -> false;
        true -> substring(name, 0, len(pref)) == pref
    }
}

fn sidecar_root_prefix() -> string {
    "dangerous_exposure_source/"
}

fn string_starts_with(s: string, prefix: string) -> bool {
    case len(s) >= len(prefix) of {
        false -> false;
        true -> substring(s, 0, len(prefix)) == prefix
    }
}

fn strip_string_literal_quotes(lexeme: string) -> string {
    case len(lexeme) >= 2 of {
        false -> lexeme;
        true -> case substring(lexeme, 0, 1) == "\"" of {
            false -> lexeme;
            true -> case substring(lexeme, len(lexeme) - 1, len(lexeme)) == "\"" of {
                false -> lexeme;
                true -> substring(lexeme, 1, len(lexeme) - 1)
            }
        }
    }
}

fn list_param_length_ffi(params: ListParam) -> int64 {
    case params.is_nil of {
        true -> 0;
        false -> 1 + list_param_length_ffi(params.tail)
    }
}

fn program_has_foreign_binding_loop(decls: ListDeclaration) -> bool {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 9 of {
            true -> true;
            false -> program_has_foreign_binding_loop(decls.tail)
        }
    }
}

fn program_has_wrapper_meta_loop(decls: ListDeclaration) -> bool {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 8 of {
            true -> true;
            false -> program_has_wrapper_meta_loop(decls.tail)
        }
    }
}

fn foreign_binding_has_meta(decl: Declaration) -> bool {
    case decl.tag == 9 of {
        false -> false;
        true -> len(decl.body.name) > 0
    }
}

fn all_foreign_bindings_have_meta_loop(decls: ListDeclaration) -> bool {
    case decls.is_nil of {
        true -> true;
        false -> case decls.head.tag == 9 of {
            true -> case foreign_binding_has_meta(decls.head) of {
                false -> false;
                true -> all_foreign_bindings_have_meta_loop(decls.tail)
            };
            false -> all_foreign_bindings_have_meta_loop(decls.tail)
        }
    }
}

fn first_foreign_binding_location_loop(decls: ListDeclaration) -> SourceLocation {
    case decls.is_nil of {
        true -> parser_ast@zero_location();
        false -> case decls.head.tag == 9 of {
            true -> decls.head.location;
            false -> first_foreign_binding_location_loop(decls.tail)
        }
    }
}

fn ffi_wrapper_warning_message(decl: Declaration) -> string {
    c_symbol: string <- strip_string_literal_quotes(decl.body.value);
    concat(
        "DANGER DANGER DANGER: this module uses FFI wrapper '",
        concat(
            decl.name,
            concat(
                "' for foreign symbol '",
                concat(
                    c_symbol,
                    "'. FFI breaks the Silica security model for this app and exposes the entire application to memory insecurity, ABI unsafety, undefined behavior, privilege-boundary collapse, and other security issues from the foreign code and wrapper boundary."
                )
            )
        )
    )
}

fn emit_ffi_wrapper_warnings_loop(decls: ListDeclaration) -> int64 proc[DeviceIO] {
    case decls.is_nil of {
        true -> 0;
        false -> case decls.head.tag == 9 of {
            true -> do
                msg: string <- ffi_wrapper_warning_message(decls.head);
                _: int8 <- diagnostics_core@print_compiler_warning("FFI_Warning", "W4001", decls.head.location, msg, "sect3");
                emit_ffi_wrapper_warnings_loop(decls.tail)
            end;
            false -> emit_ffi_wrapper_warnings_loop(decls.tail)
        }
    }
}

fn emit_ffi_wrapper_warnings(program: Program) -> int64 proc[DeviceIO] {
    emit_ffi_wrapper_warnings_loop(program.declarations)
}

fn validate_sidecar_path_lexeme(lexeme: string, loc: SourceLocation) -> (int64, string, SourceLocation, string, string) {
    path: string <- strip_string_literal_quotes(lexeme);
    case string_starts_with(path, sidecar_root_prefix()) of {
        false -> (1, "E4024", loc, "wrapper_meta and meta paths must be located under dangerous_exposure_source at the root of the Silica project.", "sect3.2");
        true -> (0, "", parser_ast@zero_location(), "", "")
    }
}

fn validate_wrapper_meta_paths_loop(decls: ListDeclaration) -> (int64, string, SourceLocation, string, string) {
    case decls.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case decls.head.tag == 8 of {
            true -> do
                (st: int64, ec: string, eloc: SourceLocation, emsg: string, espec: string) <- validate_sidecar_path_lexeme(decls.head.name, decls.head.location);
                case st == 0 of {
                    false -> (st, ec, eloc, emsg, espec);
                    true -> validate_wrapper_meta_paths_loop(decls.tail)
                }
            end;
            false -> validate_wrapper_meta_paths_loop(decls.tail)
        }
    }
}

fn validate_foreign_meta_paths_loop(decls: ListDeclaration) -> (int64, string, SourceLocation, string, string) {
    case decls.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case decls.head.tag == 9 of {
            true -> case len(decls.head.body.name) > 0 of {
                false -> validate_foreign_meta_paths_loop(decls.tail);
                true -> do
                    (st: int64, ec: string, eloc: SourceLocation, emsg: string, espec: string) <- validate_sidecar_path_lexeme(decls.head.body.name, decls.head.location);
                    case st == 0 of {
                        false -> (st, ec, eloc, emsg, espec);
                        true -> validate_foreign_meta_paths_loop(decls.tail)
                    }
                end
            };
            false -> validate_foreign_meta_paths_loop(decls.tail)
        }
    }
}

fn validate_use_dangerous_dependency_loop(params: ListParam) -> (int64, string, SourceLocation, string, string) {
    case params.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case is_dangerous_module_name(params.head.name) of {
            true -> (1, "E4021", params.head.location, "A module that imports or uses a dangerous_* module must use the dangerous_ prefix in its own module name.", "sect3.1");
            false -> validate_use_dangerous_dependency_loop(params.tail)
        }
    }
}

fn validate_use_dangerous_dependency_declarations_loop(decls: ListDeclaration) -> (int64, string, SourceLocation, string, string) {
    case decls.is_nil of {
        true -> (0, "", parser_ast@zero_location(), "", "");
        false -> case decls.head.tag == 2 of {
            true -> do
                (st: int64, ec: string, eloc: SourceLocation, emsg: string, espec: string) <- validate_use_dangerous_dependency_loop(decls.head.parameters);
                case st == 0 of {
                    false -> (st, ec, eloc, emsg, espec);
                    true -> validate_use_dangerous_dependency_declarations_loop(decls.tail)
                }
            end;
            false -> validate_use_dangerous_dependency_declarations_loop(decls.tail)
        }
    }
}

fn validate_ffi_metadata_and_naming(program: Program, module_name: string) -> (int64, string, SourceLocation, string, string) {
    (wm_st: int64, wm_ec: string, wm_loc: SourceLocation, wm_msg: string, wm_spec: string) <- validate_wrapper_meta_paths_loop(program.declarations);
    case wm_st == 0 of {
        false -> (wm_st, wm_ec, wm_loc, wm_msg, wm_spec);
        true -> do
            (fm_st: int64, fm_ec: string, fm_loc: SourceLocation, fm_msg: string, fm_spec: string) <- validate_foreign_meta_paths_loop(program.declarations);
            case fm_st == 0 of {
                false -> (fm_st, fm_ec, fm_loc, fm_msg, fm_spec);
                true -> do
                    has_foreign: bool <- program_has_foreign_binding_loop(program.declarations);
                    case has_foreign of {
                        true -> case is_dangerous_module_name(module_name) of {
                            false -> do
                                floc: SourceLocation <- first_foreign_binding_location_loop(program.declarations);
                                (1, "E4020", floc, "Modules that declare or expose foreign functions must use the dangerous_ prefix.", "sect3.1")
                            end;
                            true -> do
                                has_wm: bool <- program_has_wrapper_meta_loop(program.declarations);
                                case has_wm of {
                                    true -> (0, "", parser_ast@zero_location(), "", "");
                                    false -> case all_foreign_bindings_have_meta_loop(program.declarations) of {
                                        true -> (0, "", parser_ast@zero_location(), "", "");
                                        false -> do
                                            mloc: SourceLocation <- first_foreign_binding_location_loop(program.declarations);
                                            (1, "E4023", mloc, "A module that declares foreign c_wrapper bindings must declare wrapper_meta paths or a meta path on each foreign binding.", "sect3.2")
                                        end
                                    }
                                }
                            end
                        };
                        false -> (0, "", parser_ast@zero_location(), "", "")
                    }
                end
            }
        end
    }
}

fn validate_ffi_module_rules(program: Program, module_name: string) -> (int64, string, SourceLocation, string, string) {
    (ffi_st: int64, ffi_ec: string, ffi_loc: SourceLocation, ffi_msg: string, ffi_spec: string) <- validate_ffi_metadata_and_naming(program, module_name);
    case ffi_st == 0 of {
        false -> (ffi_st, ffi_ec, ffi_loc, ffi_msg, ffi_spec);
        true -> case is_dangerous_module_name(module_name) of {
            false -> validate_use_dangerous_dependency_declarations_loop(program.declarations);
            true -> (0, "", parser_ast@zero_location(), "", "")
        }
    }
}

fn foreign_binding_matches_export_loop(decls: ListDeclaration, fn_name: string, arity: int64) -> bool {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 9 of {
            true -> case decls.head.name == fn_name of {
                true -> case list_param_length_ffi(decls.head.parameters) == arity of {
                    true -> true;
                    false -> foreign_binding_matches_export_loop(decls.tail, fn_name, arity)
                };
                false -> foreign_binding_matches_export_loop(decls.tail, fn_name, arity)
            };
            false -> foreign_binding_matches_export_loop(decls.tail, fn_name, arity)
        }
    }
}

fn tag0_decl_matches_export_loop(decls: ListDeclaration, fn_name: string, arity: int64) -> (bool, Declaration) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 0 of {
            true -> case decls.head.name == fn_name of {
                true -> case list_param_length_ffi(decls.head.parameters) == arity of {
                    true -> (true, decls.head);
                    false -> tag0_decl_matches_export_loop(decls.tail, fn_name, arity)
                };
                false -> tag0_decl_matches_export_loop(decls.tail, fn_name, arity)
            };
            false -> tag0_decl_matches_export_loop(decls.tail, fn_name, arity)
        }
    }
}

fn decl_has_silica_body(decl: Declaration) -> bool {
    case decl.tag == 0 of {
        false -> false;
        true -> decl.body.kind >= 0
    }
}

fn validate_export_item_ffi(unit_decls: ListDeclaration, fn_name: string, arity: int64, export_loc: SourceLocation, module_name: string) -> (int64, string, SourceLocation, string, string) {
    case foreign_binding_matches_export_loop(unit_decls, fn_name, arity) of {
        true -> (1, "E4022", export_loc, "raw foreign c_wrapper bindings must not be exported to application code (spec 3.3)", "sect3.3");
        false -> case is_dangerous_module_name(module_name) of {
            false -> (0, "", parser_ast@zero_location(), "", "");
            true -> do
                (found: bool, fn_decl: Declaration) <- tag0_decl_matches_export_loop(unit_decls, fn_name, arity);
                case found of {
                    false -> (0, "", parser_ast@zero_location(), "", "");
                    true -> case decl_has_silica_body(fn_decl) of {
                        false -> (1, "E4025", export_loc, "exported function from a dangerous_* module must be a Silica adapter wrapper with a body (spec 3.3)", "sect3.3");
                        true -> (0, "", parser_ast@zero_location(), "", "")
                    }
                }
            end
        }
    }
}
