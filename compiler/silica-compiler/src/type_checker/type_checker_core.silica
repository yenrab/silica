// Type checker core - TypeContext, TypeCheckResult, symbol table
// Shared by type checker capabilities and runner

use parser_ast;
use lexer_core;

export TypeContext/0;
export ParamConcreteEnv/0;
export add_params_concrete_loop1/1;
export TypeCheckResult/0;
export TypeCheckWithContext/0;
export SymbolEntry/0;
export ListSymbolEntry/0;
export create_type_context/0;
export add_symbol/5;
export add_effect_alias_symbol/3;
export lookup_symbol/2;
export lookup_symbol_found/2;
export lookup_symbol_source_module/2;
export lookup_function_for_call/2;
export lookup_function_type_for_call/2;
export call_name_is_module_qualified/1;
export split_module_qualified_call_name/1;
export user_call_base_function_name/1;
export type_check_ok/0;
export type_check_err/5;
export empty_symbol_table/0;
export type_context_with_env/2;

// Symbol table: name -> type_name, declared_effects
struct SymbolEntry {
    name: string,
    type_name: string,
    declared_effects: ListEffectName,
    is_effect_alias: bool,
    source_module: string
}

struct ListSymbolEntry {
    is_nil: bool,
    head: SymbolEntry,
    tail: ListSymbolEntry
}

struct TypeContext {
    env: ListSymbolEntry
}

struct ParamConcreteEnv {
    decl_params: ListParam,
    concrete_types: ListParam,
    base: TypeContext
}

fn add_params_concrete_loop1(st: ParamConcreteEnv) -> TypeContext {
    case st.decl_params.is_nil of {
        true -> st.base;
        false -> case st.concrete_types.is_nil of {
            true -> st.base;
            false -> do
                new_env: ListSymbolEntry <- add_symbol(st.base.env, st.decl_params.head.name, st.concrete_types.head.type_name, parser_ast@empty_effect_name_list(), "");
                add_params_concrete_loop1(ParamConcreteEnv {
                    decl_params: st.decl_params.tail,
                    concrete_types: st.concrete_types.tail,
                    base: type_context_with_env(st.base, new_env)
                })
            end
        }
    }
}

struct TypeCheckResult {
    is_ok: bool,
    error_code: string,
    error_location: SourceLocation,
    error_message: string,
    spec_section: string
}

// Single return value for callers that cannot tuple-destructure (e.g. main.silica codegen).
struct TypeCheckWithContext {
    result: TypeCheckResult,
    context: TypeContext
}

// Flat copy of type-check outcome for main.silica: nested TypeCheckWithContext return could SIGSEGV
// after deep module type-check (bootstrap sret/stack); one struct level + scalar fields avoids that path.
struct ModuleTypecheckOutcome {
    is_ok: bool,
    error_code: string,
    error_location: SourceLocation,
    error_message: string,
    spec_section: string,
    context: TypeContext
}

export ModuleTypecheckOutcome/0;
export module_typecheck_outcome_from_pair/2;

fn module_typecheck_outcome_from_pair(r: TypeCheckResult, c: TypeContext) -> ModuleTypecheckOutcome {
    ModuleTypecheckOutcome {
        is_ok: r.is_ok,
        error_code: r.error_code,
        error_location: r.error_location,
        error_message: r.error_message,
        spec_section: r.spec_section,
        context: c
    }
}

fn dummy_symbol_entry() -> SymbolEntry {
    SymbolEntry { name: "", type_name: "", declared_effects: parser_ast@empty_effect_name_list(), is_effect_alias: false, source_module: "" }
}

fn empty_symbol_table() -> ListSymbolEntry {
    nil_placeholder: ListSymbolEntry <- ListSymbolEntry { is_nil: true, head: dummy_symbol_entry(), tail: nil_placeholder };
    nil_placeholder
}

fn create_type_context() -> TypeContext {
    env: ListSymbolEntry <- empty_symbol_table();
    env_with_false: ListSymbolEntry <- add_symbol(env, "false", "boolean", parser_ast@empty_effect_name_list(), "");
    env_with_both: ListSymbolEntry <- add_symbol(env_with_false, "true", "boolean", parser_ast@empty_effect_name_list(), "");
    TypeContext { env: env_with_both }
}

// Replace env (let bindings, params, pattern bindings).
fn type_context_with_env(ctx: TypeContext, new_env: ListSymbolEntry) -> TypeContext {
    TypeContext { env: new_env }
}

fn add_symbol(env: ListSymbolEntry, name: string, type_name: string, declared_effects: ListEffectName, source_module: string) -> ListSymbolEntry {
    entry: SymbolEntry <- SymbolEntry { name: name, type_name: type_name, declared_effects: declared_effects, is_effect_alias: false, source_module: source_module };
    ListSymbolEntry { is_nil: false, head: entry, tail: env }
}

fn add_effect_alias_symbol(env: ListSymbolEntry, name: string, effects: ListEffectName) -> ListSymbolEntry {
    entry: SymbolEntry <- SymbolEntry { name: name, type_name: "", declared_effects: effects, is_effect_alias: true, source_module: "" };
    ListSymbolEntry { is_nil: false, head: entry, tail: env }
}

fn lookup_symbol(env: ListSymbolEntry, name: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == name of {
            true -> env.head.type_name;
            false -> lookup_symbol(env.tail, name)
        }
    }
}

// Returns (found, type_name). Use when string comparison for "" is unreliable.
fn lookup_symbol_found(env: ListSymbolEntry, name: string) -> (bool, string) {
    case env.is_nil of {
        true -> (false, "");
        false -> case env.head.name == name of {
            true -> (true, env.head.type_name);
            false -> lookup_symbol_found(env.tail, name)
        }
    }
}

// Defining Silica module for imported functions (spec §19.3); "" for locals and non-function symbols.
fn lookup_symbol_source_module(env: ListSymbolEntry, name: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == name and env.head.is_effect_alias == false of {
            true -> env.head.source_module;
            false -> lookup_symbol_source_module(env.tail, name)
        }
    }
}

// First index of "@" in s, or -1 (spec §3.3.2 module@function call surface).
fn first_at_in_call_name(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_call_name(s, i + 1)
        }
    }
}

fn call_name_is_module_qualified(composite: string) -> bool {
    first_at_in_call_name(composite, 0) >= 0
}

// ("", name) if unqualified; else (module, function) for module@function.
fn split_module_qualified_call_name(composite: string) -> (string, string) {
    at: int64 <- first_at_in_call_name(composite, 0);
    case at < 0 of {
        true -> ("", composite);
        false -> (substring(composite, 0, at), substring(composite, at + 1, len(composite)))
    }
}

fn user_call_base_function_name(composite: string) -> string {
    at: int64 <- first_at_in_call_name(composite, 0);
    case at < 0 of {
        true -> composite;
        false -> substring(composite, at + 1, len(composite))
    }
}

// String return avoids (bool, string) tuple return ABI issues from proc[DeviceIO] callers (bootstrap on macOS).
fn lookup_fn_type_by_name_and_module(env: ListSymbolEntry, fn_name: string, required_module: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == fn_name and env.head.is_effect_alias == false of {
            true -> case len(required_module) == 0 of {
                true -> case env.head.source_module == "" of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module(env.tail, fn_name, required_module)
                };
                false -> case env.head.source_module == required_module of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module(env.tail, fn_name, required_module)
                }
            };
            false -> lookup_fn_type_by_name_and_module(env.tail, fn_name, required_module)
        }
    }
}

// Internal helper for callers that need (bool, string); prefer lookup_fn_type_by_name_and_module from proc callers.
fn lookup_fn_by_name_and_module(env: ListSymbolEntry, fn_name: string, required_module: string) -> (bool, string) {
    ft: string <- lookup_fn_type_by_name_and_module(env, fn_name, required_module);
    case len(ft) == 0 of {
        true -> (false, "");
        false -> (true, ft)
    }
}

fn lookup_function_for_call(env: ListSymbolEntry, composite_name: string) -> (bool, string) {
    ft: string <- lookup_function_type_for_call(env, composite_name);
    case len(ft) == 0 of {
        true -> (false, "");
        false -> (true, ft)
    }
}

fn lookup_function_type_for_call(env: ListSymbolEntry, composite_name: string) -> string {
    at: int64 <- first_at_in_call_name(composite_name, 0);
    case at < 0 of {
        true -> lookup_fn_type_by_name_and_module(env, composite_name, "");
        false -> lookup_fn_type_by_name_and_module(env, substring(composite_name, at + 1, len(composite_name)), substring(composite_name, 0, at))
    }
}

fn type_check_ok() -> TypeCheckResult {
    TypeCheckResult { is_ok: true, error_code: "", error_location: parser_ast@zero_location(), error_message: "", spec_section: "" }
}

fn type_check_err(error_code: string, error_location: SourceLocation, error_message: string, spec_section: string) -> TypeCheckResult {
    TypeCheckResult { is_ok: false, error_code: error_code, error_location: error_location, error_message: error_message, spec_section: spec_section }
}
