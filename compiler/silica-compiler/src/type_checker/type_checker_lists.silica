// List[T, S] typing helpers for the type checker (list_implementation_design.md §3.5, §7).
// Parsing surface strings; compatibility with legacy List[T]; generic call value "T S" or "T".

use parser_ast;

export ListEmptyPat/0;
export ListConsPat/0;
export parse_list_empty_case_pattern/1;
export parse_list_cons_case_pattern/1;
export is_list_primitive_name/1;
export format_list_type_from_parts/2;
export parse_generic_ts/1;
export parse_list_type_params/1;
export list_types_compatible/2;
export list_element_type_from_list_type/1;
export infer_list_primitive_return/1;
export count_call_args_list/1;
export types_equal_strip/2;

struct ListEmptyPat {
    ok: bool,
    list_type: string
}

struct ListConsPat {
    ok: bool,
    head_name: string,
    head_type: string,
    tail_name: string,
    tail_list_type: string
}

fn strip_spaces_list(s: string) -> string {
    strip_spaces_list_from(s, 0, len(s) - 1)
}

fn strip_spaces_list_from(s: string, start: int64, end_inclusive: int64) -> string {
    case start > end_inclusive of {
        true -> "";
        false -> case substring(s, start, start + 1) == " " of {
            true -> strip_spaces_list_from(s, start + 1, end_inclusive);
            false -> case substring(s, end_inclusive, end_inclusive + 1) == " " of {
                true -> strip_spaces_list_from(s, start, end_inclusive - 1);
                false -> substring(s, start, end_inclusive + 1)
            }
        }
    }
}

// Lexer/parser may join tokens with spaces anywhere ("int64 , mem ( normal )"). Match spec tuple types_equal.
fn strip_all_spaces_list(s: string) -> string {
    strip_all_spaces_list_from(s, 0, "")
}

fn strip_all_spaces_list_from(s: string, i: int64, acc: string) -> string {
    case i >= len(s) of {
        true -> acc;
        false -> case substring(s, i, i + 1) == " " of {
            true -> strip_all_spaces_list_from(s, i + 1, acc);
            false -> strip_all_spaces_list_from(s, i + 1, concat(acc, substring(s, i, i + 1)))
        }
    }
}

fn starts_with_list(s: string, prefix: string) -> bool {
    case len(s) < len(prefix) of {
        true -> false;
        false -> substring(s, 0, len(prefix)) == prefix
    }
}

// slot_lexemes_join may produce "List [int64, normal]" (space after List). parse_list_type_params requires "List[".
fn skip_spaces_index_list(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> i;
        false -> case substring(s, i, i + 1) == " " of {
            true -> skip_spaces_index_list(s, i + 1);
            false -> i
        }
    }
}

fn normalize_list_type_bracket(s: string) -> string {
    case len(s) < 6 of {
        true -> s;
        false -> case substring(s, 0, 4) == "List" of {
            true -> do
                j: int64 <- skip_spaces_index_list(s, 4);
                case j >= len(s) of {
                    true -> s;
                    false -> case substring(s, j, j + 1) == "[" of {
                        true -> concat("List[", substring(s, j + 1, len(s)));
                        false -> s
                    }
                }
            end;
            false -> s
        }
    }
}

// "List[int64, mem(normal)]" -> (true, "int64", "mem(normal)"); "List[int64]" -> (true, "int64", "")
fn parse_list_type_params(full: string) -> (bool, string, string) {
    t: string <- normalize_list_type_bracket(strip_all_spaces_list(full));
    case len(t) < 6 of {
        true -> (false, "", "");
        false -> case starts_with_list(t, "List[") of {
            false -> (false, "", "");
            true -> case substring(t, len(t) - 1, len(t)) == "]" of {
                false -> (false, "", "");
                true -> do
                    inner: string <- substring(t, 5, len(t) - 1);
                    inner_trim: string <- strip_spaces_list(inner);
                    comma_pos: int64 <- find_first_comma_depth0_list(inner_trim, 0, 0);
                    case comma_pos >= len(inner_trim) of {
                        true -> (true, inner_trim, "");
                        false -> do
                            elem: string <- strip_spaces_list(substring(inner_trim, 0, comma_pos));
                            space: string <- strip_spaces_list(substring(inner_trim, comma_pos + 1, len(inner_trim)));
                            (true, elem, space)
                        end
                    }
                end
            }
        }
    }
}

// Comma at depth 0; depth increases for [, (, {; decreases for ], ), }.
fn find_first_comma_depth0_list(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> find_first_comma_depth0_list(s, i + 1, depth + 1);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> find_first_comma_depth0_list(s, i + 1, depth - 1);
                    false -> case c == "," of {
                        true -> case depth == 0 of {
                            true -> i;
                            false -> find_first_comma_depth0_list(s, i + 1, depth)
                        };
                        false -> find_first_comma_depth0_list(s, i + 1, depth)
                    }
                }
            }
        end
    }
}

fn types_equal_strip(a: string, b: string) -> bool {
    strip_all_spaces_list(a) == strip_all_spaces_list(b)
}

// Surface memory space is mem(<space>); compare after stripping so mem(normal) matches the inner token form.
fn normalize_memory_space_for_list(s: string) -> string {
    t: string <- strip_spaces_list(s);
    case len(t) < 6 of {
        true -> t;
        false -> case substring(t, 0, 4) == "mem(" of {
            false -> t;
            true -> case substring(t, len(t) - 1, len(t)) == ")" of {
                false -> t;
                true -> strip_spaces_list(substring(t, 4, len(t) - 1))
            }
        }
    }
}

fn memory_spaces_equivalent_for_list(a: string, b: string) -> bool {
    types_equal_strip(normalize_memory_space_for_list(a), normalize_memory_space_for_list(b))
}

// Legacy List[T] matches List[T, S] when element types match. Ignore all spaces (token-join differences).
fn list_types_compatible(a: string, b: string) -> bool {
    case strip_all_spaces_list(a) == strip_all_spaces_list(b) of {
        true -> true;
        false -> do
            (ok_a: bool, ea: string, sa: string) <- parse_list_type_params(a);
            (ok_b: bool, eb: string, sb: string) <- parse_list_type_params(b);
            case ok_a of {
                false -> false;
                true -> case ok_b of {
                    false -> false;
                    true -> case types_equal_strip(ea, eb) of {
                        false -> false;
                        true -> case len(sa) == 0 of {
                            true -> true;
                            false -> case len(sb) == 0 of {
                                true -> true;
                                false -> memory_spaces_equivalent_for_list(sa, sb)
                            }
                        }
                    }
                }
            }
        end
    }
}

fn format_list_type_from_parts(elem: string, space: string) -> string {
    case len(strip_spaces_list(space)) == 0 of {
        true -> concat("List[", concat(strip_spaces_list(elem), "]"));
        false -> concat("List[", concat(strip_spaces_list(elem), concat(", ", concat(strip_spaces_list(space), "]"))))
    }
}

// slot_lexemes_join for `[int64, normal]` yields "int64 , normal" (comma is its own token). First-space split
// then leaves ", normal" as the mem param; strip a leading comma so format_list does not emit ", , ".
fn strip_leading_comma_spaces(s: string) -> string {
    t: string <- strip_spaces_list(s);
    case len(t) == 0 of {
        true -> t;
        false -> case substring(t, 0, 1) == "," of {
            true -> strip_spaces_list(substring(t, 1, len(t)));
            false -> t
        }
    }
}

// Generic call value: "int64 normal", "int64 , mem ( normal )", "{ x : int64 , y : int64 } , mem ( normal )", or single "int64"
// Split at top-level comma (depth-aware for {}, (), []) to separate element type from memory space.
fn parse_generic_ts(value: string) -> (string, string) {
    v: string <- strip_spaces_list(value);
    case len(v) == 0 of {
        true -> ("", "");
        false -> do
            comma_pos: int64 <- find_first_comma_depth0_list(v, 0, 0);
            case comma_pos >= len(v) of {
                true -> do
                    sp: int64 <- find_first_space_depth0_list(v, 0, 0);
                    case sp >= len(v) of {
                        true -> (v, "");
                        false -> (strip_spaces_list(substring(v, 0, sp)), strip_leading_comma_spaces(substring(v, sp + 1, len(v))))
                    }
                end;
                false -> (strip_spaces_list(substring(v, 0, comma_pos)), strip_leading_comma_spaces(substring(v, comma_pos + 1, len(v))))
            }
        end
    }
}

// Find first space at depth 0; depth increases for (, [, {; decreases for ), ], }.
fn find_first_space_depth0_list(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> find_first_space_depth0_list(s, i + 1, depth + 1);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> find_first_space_depth0_list(s, i + 1, depth - 1);
                    false -> case c == " " of {
                        true -> case depth == 0 of {
                            true -> i;
                            false -> find_first_space_depth0_list(s, i + 1, depth)
                        };
                        false -> find_first_space_depth0_list(s, i + 1, depth)
                    }
                }
            }
        end
    }
}

fn find_first_space_list(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) == " " of {
            true -> i;
            false -> find_first_space_list(s, i + 1)
        }
    }
}

fn is_list_primitive_name(name: string) -> bool {
    name == "empty" or name == "length" or name == "prepend" or name == "remove_head" or name == "head"
}

fn list_element_type_from_list_type(list_t: string) -> string {
    (ok: bool, elem: string, _: string) <- parse_list_type_params(list_t);
    case ok of { true -> elem; false -> "" }
}

fn infer_list_primitive_return(expr: Expr) -> string {
    case expr.kind == 4 of {
        false -> "";
        true -> do
            (elem: string, space: string) <- parse_generic_ts(expr.value);
            list_t: string <- format_list_type_from_parts(elem, space);
            case expr.name == "empty" of {
                true -> list_t;
                false -> case expr.name == "length" of {
                    true -> "int64";
                    false -> case expr.name == "prepend" of {
                        true -> list_t;
                        false -> case expr.name == "remove_head" of {
                            true -> list_t;
                            false -> case expr.name == "head" of {
                                true -> elem;
                                false -> ""
                            }
                        }
                    }
                }
            }
        end
    }
}

fn count_call_args_list(expr: Expr) -> int64 {
    case expr.inner.kind == -1 of {
        true -> 0;
        false -> case expr.right_expr.kind == -1 of {
            true -> 1;
            false -> case expr.right_expr.kind == 4 of {
                true -> 1 + count_call_args_list(expr.right_expr);
                false -> 2
            }
        }
    }
}

// `[]` alone (scrutinee supplies the List type) or `[]: List[...]` / `[ ] : List[...]`.
fn is_bare_empty_list_brackets(t: string) -> bool {
    s: string <- strip_spaces_list(t);
    case len(s) < 2 of {
        true -> false;
        false -> case substring(s, 0, 1) == "[" of {
            false -> false;
            true -> case substring(s, len(s) - 1, len(s)) == "]" of {
                false -> false;
                true -> do
                    inner: string <- substring(s, 1, len(s) - 1);
                    inner_nw: string <- strip_all_spaces_list(inner);
                    len(inner_nw) == 0
                end
            }
        }
    }
}

// []: List[...]
// slot_lexemes_join may produce "[ ] : List [ int64 , normal ]" (spaces between tokens).
// Handle both "[]" and "[ ]" for the empty-bracket prefix, and normalize the List type.
fn parse_list_empty_case_pattern(pat_str: string) -> ListEmptyPat {
    t: string <- strip_spaces_list(pat_str);
    case is_bare_empty_list_brackets(t) of {
        true -> ListEmptyPat { ok: true, list_type: "" };
        false -> case len(t) < 4 of {
            true -> ListEmptyPat { ok: false, list_type: "" };
            false -> case substring(t, 0, 1) == "[" of {
                false -> ListEmptyPat { ok: false, list_type: "" };
                true -> do
                    j_rb: int64 <- skip_spaces_index_list(t, 1);
                    case j_rb >= len(t) of {
                        true -> ListEmptyPat { ok: false, list_type: "" };
                        false -> case substring(t, j_rb, j_rb + 1) == "]" of {
                            false -> ListEmptyPat { ok: false, list_type: "" };
                            true -> do
                                j_col: int64 <- skip_spaces_index_list(t, j_rb + 1);
                                case j_col >= len(t) of {
                                    true -> ListEmptyPat { ok: false, list_type: "" };
                                    false -> case substring(t, j_col, j_col + 1) == ":" of {
                                        false -> ListEmptyPat { ok: false, list_type: "" };
                                        true -> do
                                            rest: string <- normalize_list_type_bracket(strip_all_spaces_list(substring(t, j_col + 1, len(t))));
                                            case starts_with_list(rest, "List[") of {
                                                false -> ListEmptyPat { ok: false, list_type: "" };
                                                true -> ListEmptyPat { ok: true, list_type: rest }
                                            }
                                        end
                                    }
                                }
                            end
                        }
                    }
                end
            }
        }
    }
}

fn parse_colon_binding_list(s: string) -> (bool, string, string) {
    colon: int64 <- case_find_colon_outside_string_list(s, 0, false);
    case colon < 0 of {
        true -> (false, "", "");
        false -> do
            name_raw: string <- strip_spaces_list(substring(s, 0, colon));
            typ_raw: string <- strip_spaces_list(substring(s, colon + 1, len(s)));
            case len(name_raw) == 0 or len(typ_raw) == 0 of {
                true -> (false, "", "");
                false -> (true, name_raw, typ_raw)
            }
        end
    }
}

fn case_flip_string_in(s: bool) -> bool {
    case s of { true -> false; false -> true }
}

fn case_find_colon_outside_string_list(s: string, i: int64, in_string: bool) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "\"" of {
            true -> case_find_colon_outside_string_list(s, i + 1, case_flip_string_in(in_string));
            false -> case in_string of {
                true -> case_find_colon_outside_string_list(s, i + 1, in_string);
                false -> case substring(s, i, i + 1) == ":" of {
                    true -> i;
                    false -> case_find_colon_outside_string_list(s, i + 1, false)
                }
            }
        }
    }
}

fn not_list_empty_prefix(t: string) -> bool {
    case len(t) < 2 of {
        true -> true;
        false -> substring(t, 0, 2) != "[]"
    }
}

// [h: T, tail: List[...]] — not []: ...
fn parse_list_cons_case_pattern(pat_str: string) -> ListConsPat {
    t: string <- strip_spaces_list(pat_str);
    case len(t) < 5 of {
        true -> ListConsPat { ok: false, head_name: "", head_type: "", tail_name: "", tail_list_type: "" };
        false -> case substring(t, 0, 1) == "[" of {
            false -> ListConsPat { ok: false, head_name: "", head_type: "", tail_name: "", tail_list_type: "" };
            true -> case not_list_empty_prefix(t) of {
                false -> ListConsPat { ok: false, head_name: "", head_type: "", tail_name: "", tail_list_type: "" };
                true -> case substring(t, len(t) - 1, len(t)) == "]" of {
                    false -> ListConsPat { ok: false, head_name: "", head_type: "", tail_name: "", tail_list_type: "" };
                    true -> do
                        inner: string <- substring(t, 1, len(t) - 1);
                        inner_trim: string <- strip_spaces_list(inner);
                        comma_pos: int64 <- find_first_comma_depth0_list(inner_trim, 0, 0);
                        case comma_pos >= len(inner_trim) of {
                            true -> ListConsPat { ok: false, head_name: "", head_type: "", tail_name: "", tail_list_type: "" };
                            false -> do
                                left: string <- strip_spaces_list(substring(inner_trim, 0, comma_pos));
                                right: string <- strip_spaces_list(substring(inner_trim, comma_pos + 1, len(inner_trim)));
                                (ok_l: bool, hn: string, ht: string) <- parse_colon_binding_list(left);
                                (ok_r: bool, tn: string, tt: string) <- parse_colon_binding_list(right);
                                case ok_l of {
                                    false -> ListConsPat { ok: false, head_name: "", head_type: "", tail_name: "", tail_list_type: "" };
                                    true -> case ok_r of {
                                        false -> ListConsPat { ok: false, head_name: "", head_type: "", tail_name: "", tail_list_type: "" };
                                        true -> do
                                            tt_n: string <- normalize_list_type_bracket(strip_all_spaces_list(tt));
                                            case starts_with_list(tt_n, "List[") of {
                                                false -> ListConsPat { ok: false, head_name: "", head_type: "", tail_name: "", tail_list_type: "" };
                                                true -> ListConsPat { ok: true, head_name: hn, head_type: ht, tail_name: tn, tail_list_type: tt_n }
                                            }
                                        end
                                    }
                                }
                            end
                        }
                    end
                }
            }
        }
    }
}
