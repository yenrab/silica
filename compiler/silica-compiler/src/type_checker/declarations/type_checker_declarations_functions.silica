// Capability: check function declaration (Declaration tag 0)
// Adds function to symbol table, checks body expression
// User-defined functions: store full function type (params -> return) for call resolution

use parser_ast;
use type_checker_core;
use type_checker_expressions;
use type_checker_memory_regions;
use type_checker_recursion;
use type_checker_expressions_actors;
use type_checker_record_types;

export add_function/2;
export check_body/2;
export build_function_type/1;

// Build function type string "(T1,T2) -> R" from declaration. ListParam order: head=last param, tail=earlier params.
fn param_types_str(params: ListParam) -> string {
    case params.is_nil of {
        true -> "";
        false -> case params.tail.is_nil of {
            true -> params.head.type_name;
            false -> concat(concat(param_types_str(params.tail), ","), params.head.type_name)
        }
    }
}

// Exported for module export surface (§19.2) and cross-module type checking.
fn build_function_type(decl: Declaration) -> string {
    params_str: string <- param_types_str(decl.parameters);
    case decl.parameters.is_nil of {
        true -> concat("() -> ", decl.return_type_name);
        false -> concat(concat(concat("(", params_str), ") -> "), decl.return_type_name)
    }
}

// Add function name with full function type (params -> return) for call resolution. Used for first pass (all decls).
fn add_function(decl: Declaration, context: TypeContext) -> TypeContext {
    func_type: string <- build_function_type(decl);
    new_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, decl.name, func_type, decl.declared_effects, "");
    TypeContext { env: new_env }
}

fn add_params_to_context_loop(params: ListParam, context: TypeContext) -> TypeContext {
    case params.is_nil of {
        true -> context;
        false -> do
            p: Param <- params.head;
            new_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, p.name, p.type_name, parser_ast@empty_effect_name_list(), "");
            add_params_to_context_loop(params.tail, type_checker_core@type_context_with_env(context, new_env))
        end
    }
}

fn add_params_to_context(decl: Declaration, context: TypeContext) -> TypeContext {
    add_params_to_context_loop(decl.parameters, context)
}

// Inline record param types `{ f: T, ... }` (§3.4.2): reject unbalanced `{` `}`.
fn validate_record_type_string(type_str: string, location: SourceLocation) -> TypeCheckResult {
    case type_checker_record_types@record_type_starts(type_str) of {
        false -> type_checker_core@type_check_ok();
        true -> case type_checker_record_types@record_type_braces_balanced(type_str) of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", location, "malformed inline record type (unbalanced braces)", "sect3.4.2")
        }
    }
}

// Validate each param type (memory region types must be valid). Return first error or ok.
fn validate_params_loop(params: ListParam) -> TypeCheckResult proc[DeviceIO] {
    case params.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> do
            rec_result: TypeCheckResult <- validate_record_type_string(params.head.type_name, params.head.location);
            case rec_result.is_ok of {
                false -> rec_result;
                true -> case type_checker_memory_regions@is_memory_region_type(params.head.type_name) of {
                    true -> do
                        mem_result: TypeCheckResult <- type_checker_memory_regions@validate_memory_region_type(params.head.type_name, params.head.location);
                        case mem_result.is_ok of {
                            false -> mem_result;
                            true -> validate_params_loop(params.tail)
                        }
                    end;
                    false -> validate_params_loop(params.tail)
                }
            }
        end
    }
}

// Check function body. Context must already include all declarations (for mutual recursion).
// Add parameters to context before checking body so param names are in scope.
// For proc return types (T proc[E]), the body's expected type is T. The parser stores return_type_name as T.
// Reject unit: not a valid return type per language design.
// Validate memory region return types (ref, region, buf) before checking body.
// Validate param types (memory region params) before checking body.
fn check_body(decl: Declaration, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    println(concat("[TC-DEBUG] check_body enter fn=", decl.name));
    params_result: TypeCheckResult <- validate_params_loop(decl.parameters);
    case params_result.is_ok of {
        false -> params_result;
        true -> check_body_after_params(decl, context)
    }
}

fn check_body_after_params(decl: Declaration, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    context_with_params: TypeContext <- add_params_to_context(decl, context);
    ret_rec: TypeCheckResult <- validate_record_type_string(decl.return_type_name, decl.return_type_location);
    case ret_rec.is_ok of {
        false -> ret_rec;
        true -> case decl.return_type_name == "unit" of {
        true -> type_checker_core@type_check_err("E2006", decl.return_type_location, "unit is not a valid return type", "sect4");
        false -> case type_checker_memory_regions@is_memory_region_type(decl.return_type_name) of {
            true -> check_body_memory_region_return(decl, context_with_params);
            false -> do
                println(concat("[TC-DEBUG] check_body_after_params check_expr fn=", decl.name));
                body_result: TypeCheckResult <- type_checker_expressions@check_expr(decl.body, decl.return_type_name, context_with_params);
                case body_result.is_ok of {
                    false -> body_result;
                    true -> do
                        rec_result: TypeCheckResult <- type_checker_recursion@recursion_analyze_body(decl.body, decl.name);
                        case rec_result.is_ok of {
                            false -> rec_result;
                            true -> type_checker_expressions_actors@check_behavior_no_self_recursion(decl)
                        }
                    end
                }
            end
        }
        }
    }
}

fn check_body_memory_region_return(decl: Declaration, context: TypeContext) -> TypeCheckResult proc[DeviceIO] {
    mem_result: TypeCheckResult <- type_checker_memory_regions@validate_memory_region_type(decl.return_type_name, decl.return_type_location);
    case mem_result.is_ok of {
        false -> mem_result;
        true -> do
            body_result: TypeCheckResult <- type_checker_expressions@check_expr(decl.body, decl.return_type_name, context);
            case body_result.is_ok of {
                false -> body_result;
                true -> do
                    rec_result: TypeCheckResult <- type_checker_recursion@recursion_analyze_body(decl.body, decl.name);
                    case rec_result.is_ok of {
                        false -> rec_result;
                        true -> type_checker_expressions_actors@check_behavior_no_self_recursion(decl)
                    }
                end
            }
        end
    }
}
