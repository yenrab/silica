// String call and literal type checking (print_string, string literal)
// Kept separate from core type checker for modular string support.
// Uses character-by-character comparison to avoid bootstrap string pattern-match issues.

use type_checker_core;

export check_print_string_result_type/2;
export check_string_literal/3;
export check_concatenate_call/5;
export check_substring_call/5;
export check_substring_until_char_call/5;
export check_length_bytes_call/3;
export check_length_chars_call/3;
export check_read_lines_call/3;
export check_file_exists_call/3;
export check_delete_file_call/3;
export check_append_file_call/4;

// Robust check: expected_type is "string" (avoids case pattern match on string literal)
fn is_string_type_name(s: string) -> bool {
    len(s) == 6 and substring(s, 0, 1) == "s" and substring(s, 1, 2) == "t" and substring(s, 2, 3) == "r" and substring(s, 3, 4) == "i" and substring(s, 4, 5) == "n" and substring(s, 5, 6) == "g"
}

// Robust check: expected_type is "discard"
fn is_discard_type_name(s: string) -> bool {
    len(s) == 7 and substring(s, 0, 1) == "d" and substring(s, 1, 2) == "i" and substring(s, 2, 3) == "s" and substring(s, 3, 4) == "c" and substring(s, 4, 5) == "a" and substring(s, 5, 6) == "r" and substring(s, 6, 7) == "d"
}

// Robust check: expected_type is "int64"
fn is_int64_type_name(s: string) -> bool {
    len(s) == 5 and substring(s, 0, 1) == "i" and substring(s, 1, 2) == "n" and substring(s, 2, 3) == "t" and substring(s, 3, 4) == "6" and substring(s, 4, 5) == "4"
}

// length_bytes(s: string) -> int64. Spec: silica:StringLengthOperations.
// Caller: arg1=expr.inner (string).
fn check_length_bytes_call(expr: Expr, expected_type: string, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case is_int64_type_name(expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> case is_discard_type_name(expected_type) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr.location, concat("length_bytes returns int64, got expected type ", expected_type), "sect6")
            }
        }
    }
}

// length_chars(s: string) -> int64. Spec: silica:StringLengthOperations.
// Caller: arg1=expr.inner (string).
fn check_length_chars_call(expr: Expr, expected_type: string, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case is_int64_type_name(expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> case is_discard_type_name(expected_type) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr.location, concat("length_chars returns int64, got expected type ", expected_type), "sect6")
            }
        }
    }
}

// print_string(string) -> atom. Validates expected_type is atom or discard.
// Caller must check expr.inner has type string before calling.
fn check_print_string_result_type(expected_type: string, location: SourceLocation) -> TypeCheckResult {
    case expected_type of {
        "atom" -> type_checker_core@type_check_ok();
        "discard" -> type_checker_core@type_check_ok();
        _: string -> type_checker_core@type_check_err("E2003", location, concat("print_string expects atom result, got ", expected_type), "sect6")
    }
}

// concatenate/2 (concat) - two string args, returns string. Args can be string literals or bound string variables.
// Caller passes arg1_result = check_expr(expr.inner, "string", context), arg2_result = check_expr(expr.right_expr, "string", context).
fn check_concatenate_call(expr: Expr, expected_type: string, arg1_result: TypeCheckResult, arg2_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case arg2_result.is_ok of {
            false -> arg2_result;
            true -> case is_string_type_name(expected_type) of {
                true -> type_checker_core@type_check_ok();
                false -> case is_discard_type_name(expected_type) of {
                    true -> type_checker_core@type_check_ok();
                    false -> type_checker_core@type_check_err("E2003", expr.location, concat("concatenate/2 returns string, got expected type ", expected_type), "sect6")
                }
            }
        }
    }
}

// substring(s: string, start: int64, end: int64) -> string. Spec: 5.3.2 String Manipulation. Character-based indices (UTF-8 code points).
// Caller: arg1=expr.inner (string), arg2=expr.right_expr.inner (int64), arg3=expr.right_expr.right_expr (int64).
fn check_substring_call(expr: Expr, expected_type: string, arg1_result: TypeCheckResult, arg2_result: TypeCheckResult, arg3_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case arg2_result.is_ok of {
            false -> arg2_result;
            true -> case arg3_result.is_ok of {
                false -> arg3_result;
                true -> case is_string_type_name(expected_type) of {
                    true -> type_checker_core@type_check_ok();
                    false -> case is_discard_type_name(expected_type) of {
                        true -> type_checker_core@type_check_ok();
                        false -> type_checker_core@type_check_err("E2003", expr.location, concat("substring returns string, got expected type ", expected_type), "sect6")
                    }
                }
            }
        }
    }
}

// substring_until_char(s: string, start: int64, char: char) -> string. Spec: 5.3.2 String Manipulation.
// Caller: arg1=expr.inner (string), arg2=expr.right_expr.inner (int64), arg3=expr.right_expr.right_expr (char).
fn check_substring_until_char_call(expr: Expr, expected_type: string, arg1_result: TypeCheckResult, arg2_result: TypeCheckResult, arg3_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case arg2_result.is_ok of {
            false -> arg2_result;
            true -> case arg3_result.is_ok of {
                false -> arg3_result;
                true -> case is_string_type_name(expected_type) of {
                    true -> type_checker_core@type_check_ok();
                    false -> case is_discard_type_name(expected_type) of {
                        true -> type_checker_core@type_check_ok();
                        false -> type_checker_core@type_check_err("E2003", expr.location, concat("substring_until_char returns string, got expected type ", expected_type), "sect6")
                    }
                }
            }
        }
    }
}

// Robust check: expected_type is "bool" or "boolean"
fn is_bool_type_name(s: string) -> bool {
    case s of {
        "bool" -> true;
        "boolean" -> true;
        _: string -> false
    }
}

// Robust check: expected_type is "atom"
fn is_atom_type_name(s: string) -> bool {
    len(s) == 4 and substring(s, 0, 1) == "a" and substring(s, 1, 2) == "t" and substring(s, 2, 3) == "o" and substring(s, 3, 4) == "m"
}

// read_lines(path: string) -> string. DeviceIO file intrinsic.
fn check_read_lines_call(expr: Expr, expected_type: string, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case is_string_type_name(expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> case is_discard_type_name(expected_type) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr.location, concat("read_lines returns string, got expected type ", expected_type), "sect6")
            }
        }
    }
}

// file_exists(path: string) -> bool. DeviceIO file intrinsic.
fn check_file_exists_call(expr: Expr, expected_type: string, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case is_bool_type_name(expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> case is_discard_type_name(expected_type) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2003", expr.location, concat("file_exists returns bool, got expected type ", expected_type), "sect6")
            }
        }
    }
}

// delete_file(path: string) -> bool (also accept atom/discard for statement use). DeviceIO file intrinsic.
fn check_delete_file_call(expr: Expr, expected_type: string, arg1_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case is_bool_type_name(expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> case is_atom_type_name(expected_type) of {
                true -> type_checker_core@type_check_ok();
                false -> case is_discard_type_name(expected_type) of {
                    true -> type_checker_core@type_check_ok();
                    false -> type_checker_core@type_check_err("E2003", expr.location, concat("delete_file returns bool, got expected type ", expected_type), "sect6")
                }
            }
        }
    }
}

// append_file(path: string, content: string) -> bool. DeviceIO file intrinsic.
fn check_append_file_call(expr: Expr, expected_type: string, arg1_result: TypeCheckResult, arg2_result: TypeCheckResult) -> TypeCheckResult {
    case arg1_result.is_ok of {
        false -> arg1_result;
        true -> case arg2_result.is_ok of {
            false -> arg2_result;
            true -> case is_bool_type_name(expected_type) of {
                true -> type_checker_core@type_check_ok();
                false -> case is_discard_type_name(expected_type) of {
                    true -> type_checker_core@type_check_ok();
                    false -> type_checker_core@type_check_err("E2003", expr.location, concat("append_file returns bool, got expected type ", expected_type), "sect6")
                }
            }
        }
    }
}

// String literal (Expr kind 8). Validates expected_type is string or discard.
fn check_string_literal(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult {
    case is_string_type_name(expected_type) of {
        true -> type_checker_core@type_check_ok();
        false -> case is_discard_type_name(expected_type) of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2001", expr.location, concat("string literal requires string type, got ", case expected_type of { "" -> "[EMPTY]"; _: string -> expected_type }), "sect6")
        }
    }
}
