// Float32 call type checking (print_float32)
// Follows pattern from print_float64; kept in separate file for modular float32 support.

use parser_ast;
use type_checker_core;

export check_print_float32_call/3;

// print_float32(float32) -> atom. Validates arg has type float32, expected_type is atom or discard.
// Caller passes arg_result = check_expr(expr.inner, "float32", context).
fn check_print_float32_call(expr: Expr, expected_type: string, arg_result: TypeCheckResult) -> TypeCheckResult {
    case arg_result.is_ok of {
        false -> arg_result;
        true -> case expected_type of {
            "atom" -> type_checker_core@type_check_ok();
            "discard" -> type_checker_core@type_check_ok();
            _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("print_float32 expects atom result, got ", expected_type), "sect6")
        }
    }
}
