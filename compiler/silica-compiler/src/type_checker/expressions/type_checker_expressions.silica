fn check_actor_concurrency_call(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    eff: string <- type_checker_core@user_call_base_function_name(expr.name);
    case is_actor_runtime_helper_name(eff) of {
        true -> check_actor_runtime_helper_call(expr, expected_type, context, world);
        false -> case eff == "recv" of {
            true -> type_checker_core@type_check_err("E2005", expr.location, "recv() is runtime-internal only; user code cannot call recv (§15.1.2)", "sect15");
            false -> case eff == "self" of {
                true -> check_actor_self_call(expr, expected_type, context);
                false -> case eff == "spawn" of {
                    true -> check_actor_spawn_call(expr, expected_type, context, world, "spawn", "actor_ref");
                    false -> case eff == "spawn_dangerous" of {
                        true -> check_actor_spawn_call(expr, expected_type, context, world, "spawn_dangerous", "dangerous_actor_ref");
                        false -> case eff == "spawn_registered" of {
                        true -> check_actor_spawn_registered_call(expr, expected_type, context, world);
                        false -> case eff == "spawn_registered_supervisor" of {
                            true -> check_spawn_registered_supervisor_call(expr, expected_type, context, world);
                            false -> case eff == "spawn_linked" of {
                                true -> check_actor_spawn_linked_call(expr, expected_type, context, world);
                                false -> case eff == "call_supervisor" of {
                                    true -> check_call_supervisor_builtin(expr, expected_type, context, world);
                                    false -> case eff == "link" of {
                            true -> check_actor_link_call(expr, expected_type, context, world);
                            false -> case eff == "add_child" of {
                                true -> check_add_child_call(expr, expected_type, context, world);
                                false -> case eff == "monitor" of {
                                    true -> check_actor_monitor_call(expr, expected_type, context, world);
                                    false -> case eff == "demonitor" of {
                                        true -> check_actor_demonitor_call(expr, expected_type, context, world);
                                    false -> case eff == "supervision_ingress_enqueue" of {
                                        true -> check_supervision_ingress_enqueue_call(expr, expected_type, context, world);
                                        false -> case eff == "supervision_wait_and_drain_one" of {
                                            true -> check_supervision_wait_and_drain_one_call(expr, expected_type, context, world);
                                            false -> case eff == "failure_reason_tag" of {
                                                true -> check_failure_reason_tag_call(expr, expected_type, context, world);
                                            false -> case eff == "failure_reason_atom" of {
                                                true -> check_failure_reason_atom_call(expr, expected_type, context, world);
                                                false -> case eff == "failure_agent_type" of {
                                                    true -> check_failure_agent_type_call(expr, expected_type, context, world);
                                                    false -> case eff == "failure_release" of {
                                                        true -> check_failure_release_call(expr, expected_type, context, world);
                                                        false -> case eff == "start_child" of {
                                                            true -> check_start_child_call(expr, expected_type, context, world);
                                                            false -> case eff == "child_table_first_ref" of {
                                                                true -> check_child_table_first_ref_call(expr, expected_type, context, world);
                                                                false -> case eff == "child_table_row_ref" of {
                                                                    true -> check_child_table_row_ref_call(expr, expected_type, context, world);
                                                                    false -> case eff == "kill_abnormal" of {
                                                                        true -> check_kill_abnormal_call(expr, expected_type, context, world);
                                                                        false -> case eff == "wait_for_exit" of {
                                                                            true -> check_wait_for_exit_call(expr, expected_type, context, world);
                                                                            false -> case eff == "call" of {
                                                                                true -> check_actor_call_builtin(expr, expected_type, context, world);
                                                                                false -> case eff == "call_registered" of {
                                                                                    true -> check_actor_call_registered_builtin(expr, expected_type, context, world);
                                                                                    false -> case eff == "cast" of {
                                                                                        true -> check_actor_cast_builtin(expr, expected_type, context, world);
                                                                                        false -> case eff == "cast_registered" of {
                                                                                            true -> check_actor_cast_registered_builtin(expr, expected_type, context, world);
                                                                                            false -> check_actor_send_builtin(expr, expected_type, context, world)
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }}
                                                }
                                            }
                                        }
                                    }
                                    }
                                }
                            }}
                                }
                            }
                        }
                        }
                    }
                }
            }
        }
    }
}

fn is_float_special_const_name(name: string) -> bool {
    name == "float16_nan" or name == "float16_inf" or name == "float16_neg_inf" or name == "float32_nan" or name == "float32_inf" or name == "float32_neg_inf" or name == "float64_nan" or name == "float64_inf" or name == "float64_neg_inf"
}

fn float_special_const_type(name: string) -> string {
    case substring(name, 0, 7) == "float16" of {
        true -> "float16";
        false -> case substring(name, 0, 7) == "float32" of {
            true -> "float32";
            false -> "float64"
        }
    }
}

fn is_float_predicate_name(name: string) -> bool {
    name == "float16_is_nan" or name == "float16_is_inf" or name == "float16_is_finite" or name == "float32_is_nan" or name == "float32_is_inf" or name == "float32_is_finite" or name == "float64_is_nan" or name == "float64_is_inf" or name == "float64_is_finite"
}

fn float_predicate_arg_type(name: string) -> string {
    case substring(name, 0, 7) == "float16" of {
        true -> "float16";
        false -> case substring(name, 0, 7) == "float32" of {
            true -> "float32";
            false -> "float64"
        }
    }
}

fn check_float_special_const_call(expr: Expr, expected_type: string) -> TypeCheckResult {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    ret: string <- float_special_const_type(expr.name);
    case ac == 0 of {
        false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " expects 0 arguments"), "sect6");
        true -> case expected_type == ret or expected_type == "discard" of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(expr.name, " returns "), ret), concat(", expected ", expected_type)), "sect6")
        }
    }
}

fn check_float_predicate_call(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    do
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 1 of {
        false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " expects 1 argument"), "sect6");
        true -> do
            arg_t: string <- float_predicate_arg_type(expr.name);
            r: TypeCheckResult <- check_expr(expr.inner, arg_t, context, world);
            case r.is_ok of {
                false -> r;
                true -> case expected_type == "bool" or expected_type == "boolean" or expected_type == "discard" of {
                    true -> type_checker_core@type_check_ok();
                    false -> type_checker_core@type_check_err("E2003", expr.location, concat(expr.name, concat(" returns bool, expected ", expected_type)), "sect6")
                }
            }
        end
    }
    end
}

fn check_call_builtins_dispatch(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case is_float_special_const_name(expr.name) of {
        true -> check_float_special_const_call(expr, expected_type);
        false -> case is_float_predicate_name(expr.name) of {
            true -> check_float_predicate_call(expr, expected_type, context, world);
            false -> case type_checker_memory_regions@is_region_builtin_call(expr.name) of {
        true -> check_region_builtin_call(expr, expected_type, context, world);
        false -> case is_actor_concurrency_builtin(expr.name) of {
            true -> check_actor_concurrency_call(expr, expected_type, context, world);
            false -> case expr.name == "negate_unit" of {
            true -> type_checker_core@type_check_err("E2003", expr.location, "negation is not supported for unit", "sect6");
            false -> case len(negate_builtin_arg_type(expr.name)) > 0 of {
                    true -> check_negate_call(expr, negate_builtin_arg_type(expr.name), expected_type, context, world);
                    false -> case expr.name == "print_int64" of {
        true -> check_print_call(expr, "int64", expected_type, context, world);
        false -> case expr.name == "print_int32" of {
            true -> check_print_call(expr, "int32", expected_type, context, world);
            false -> case expr.name == "print_int16" of {
                true -> check_print_call(expr, "int16", expected_type, context, world);
                false -> case expr.name == "print_int8" of {
                    true -> check_print_call(expr, "int8", expected_type, context, world);
                    false -> case expr.name == "print_uint64" of {
                        true -> check_print_call(expr, "uint64", expected_type, context, world);
                        false -> case expr.name == "print_uint32" of {
                            true -> check_print_call(expr, "uint32", expected_type, context, world);
                            false -> case expr.name == "print_uint16" of {
                                true -> check_print_call(expr, "uint16", expected_type, context, world);
                                false -> case expr.name == "print_uint8" of {
                                    true -> check_print_call(expr, "uint8", expected_type, context, world);
                                    false -> case expr.name == "print_bool" of {
                                        true -> do
                                            arg_result: TypeCheckResult <- check_expr(expr.inner, "boolean", context, world);
                                            case arg_result.is_ok of {
                                                false -> arg_result;
                                                true -> case expected_type of {
                                                    "boolean" -> type_checker_core@type_check_ok();
                                                    "atom" -> type_checker_core@type_check_ok();
                                                    "discard" -> type_checker_core@type_check_ok();
                                                    _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("print_bool expects boolean or atom result, got ", expected_type), "sect6")
                                                }
                                            }
                                        end;
                                        false -> case expr.name == "print_atom" of {
                                            true -> do
                                                arg_result: TypeCheckResult <- check_expr(expr.inner, "atom", context, world);
                                                case arg_result.is_ok of {
                                                    false -> arg_result;
                                                    true -> case expected_type of {
                                                        "atom" -> type_checker_core@type_check_ok();
                                                        "discard" -> type_checker_core@type_check_ok();
                                                        _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("print_atom expects atom result, got ", expected_type), "sect6")
                                                    }
                                                }
                                            end;
                                            false -> case expr.name == "atom_bits" of {
                                                true -> do
                                                    ra: TypeCheckResult <- check_expr(expr.inner, "atom", context, world);
                                                    case ra.is_ok of {
                                                        false -> ra;
                                                        true -> case expected_type of {
                                                            "int64" -> type_checker_core@type_check_ok();
                                                            "discard" -> type_checker_core@type_check_ok();
                                                            _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("atom_bits expects int64 result, got ", expected_type), "sect6")
                                                        }
                                                    }
                                                end;
                                                false -> case expr.name == "actor_ref_bits" of {
                                                    true -> do
                                                        rr: TypeCheckResult <- check_expr(expr.inner, "actor_ref", context, world);
                                                        case rr.is_ok of {
                                                            false -> rr;
                                                            true -> case expected_type of {
                                                                "int64" -> type_checker_core@type_check_ok();
                                                                "discard" -> type_checker_core@type_check_ok();
                                                                _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("actor_ref_bits expects int64 result, got ", expected_type), "sect6")
                                                            }
                                                        }
                                                    end;
                                                    false -> case expr.name == "actor_ref_of_word" of {
                                                        true -> do
                                                            rw: TypeCheckResult <- check_expr(expr.inner, "int64", context, world);
                                                            case rw.is_ok of {
                                                                false -> rw;
                                                                true -> case expected_type of {
                                                                    "actor_ref" -> type_checker_core@type_check_ok();
                                                                    "discard" -> type_checker_core@type_check_ok();
                                                                    _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("actor_ref_of_word expects actor_ref result, got ", expected_type), "sect6")
                                                                }
                                                            }
                                                        end;
                                                        false -> case expr.name == "print_float64" of {
                                                            true -> check_print_call(expr, "float64", expected_type, context, world);
                                                            false -> case expr.name == "print_float32" of {
                                                                true -> do
                                                                    arg_result: TypeCheckResult <- check_expr(expr.inner, "float32", context, world);
                                                                    type_checker_expressions_float32_calls@check_print_float32_call(expr, expected_type, arg_result)
                                                                end;
                                                                false -> case expr.name == "print_float16" of {
                                                                    true -> do
                                                                        arg_result: TypeCheckResult <- check_expr(expr.inner, "float16", context, world);
                                                                        type_checker_expressions_float32_calls@check_print_float32_call(expr, expected_type, arg_result)
                                                                    end;
                                                                    false -> case expr.name == "print_string" of {
                                                                        true -> check_print_call(expr, "string", expected_type, context, world);
                                                                        false -> case expr.name == "println" of {
                                                                        true -> check_print_call(expr, "string", expected_type, context, world);
                                                                        false -> case expr.name == "print_string_stderr" of {
                                                                            true -> check_print_call(expr, "string", expected_type, context, world);
                                                                            false -> case expr.name == "println_stderr" of {
                                                                                true -> check_print_call(expr, "string", expected_type, context, world);
                                                                                false -> case expr.name == "concat" of {
                                                                            true -> do
                                                                                a1: TypeCheckResult <- check_expr(expr.inner, "string", context, world);
                                                                                a2: TypeCheckResult <- check_expr(expr.right_expr.inner, "string", context, world);
                                                                                type_checker_expressions_string_calls@check_concatenate_call(expr, expected_type, a1, a2)
                                                                            end;
                                                                                false -> case expr.name == "concatenate" of {
                                                                                true -> do
                                                                                    a1: TypeCheckResult <- check_expr(expr.inner, "string", context, world);
                                                                                    a2: TypeCheckResult <- check_expr(expr.right_expr.inner, "string", context, world);
                                                                                    type_checker_expressions_string_calls@check_concatenate_call(expr, expected_type, a1, a2)
                                                                                end;
                                                                                false -> case expr.name == "substring" of {
                                                                                    true -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                                                                                        true -> do
                                                                                            s1: TypeCheckResult <- check_expr(expr.inner, "string", context, world);
                                                                                            s2: TypeCheckResult <- check_expr(expr.right_expr.inner, "int64", context, world);
                                                                                            s3: TypeCheckResult <- check_expr(expr.right_expr.right_expr.inner, "int64", context, world);
                                                                                            type_checker_expressions_string_calls@check_substring_call(expr, expected_type, s1, s2, s3)
                                                                                        end;
                                                                                        false -> type_checker_core@type_check_err("E2005", expr.location, "substring requires 3 arguments: (s: string, start: int64, end: int64)", "sect6")
                                                                                    };
                                                                                    false -> case expr.name == "substring_until_char" of {
                                                                                        true -> case expr.right_expr.kind == 4 and expr.right_expr.name == "" of {
                                                                                            true -> do
                                                                                                u1: TypeCheckResult <- check_expr(expr.inner, "string", context, world);
                                                                                                u2: TypeCheckResult <- check_expr(expr.right_expr.inner, "int64", context, world);
                                                                                                u3: TypeCheckResult <- check_expr(expr.right_expr.right_expr.inner, "char", context, world);
                                                                                                type_checker_expressions_string_calls@check_substring_until_char_call(expr, expected_type, u1, u2, u3)
                                                                                            end;
                                                                                            false -> type_checker_core@type_check_err("E2005", expr.location, "substring_until_char requires 3 arguments: (s: string, start: int64, char: char)", "sect6")
                                                                                        };
                                                                                        false -> case expr.name == "length_bytes" of {
                                                                                            true -> do
                                                                                                lb: TypeCheckResult <- check_expr(expr.inner, "string", context, world);
                                                                                                type_checker_expressions_string_calls@check_length_bytes_call(expr, expected_type, lb)
                                                                                            end;
                                                                                                    false -> case expr.name == "length_chars" of {
                                                                                                    true -> do
                                                                                                        lc: TypeCheckResult <- check_expr(expr.inner, "string", context, world);
                                                                                                        type_checker_expressions_string_calls@check_length_chars_call(expr, expected_type, lc)
                                                                                                    end;
                                                                                                    false -> case type_checker_lists@is_list_primitive_name(expr.name) of {
                                                                                                        true -> check_list_primitive_call(expr, expected_type, context, world);
                                                                                                        false -> case expr.name == "core_id" or expr.name == "core_set" of {
                                                                                                            true -> check_spawn_affinity_constructor_call(expr, expected_type, context, world);
                                                                                                            false -> check_user_defined_call(expr, expected_type, context, world)
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
            }
        }
        }
    }
    }
    }
    }
        }
    }
}

// Mirror of type_checker_core lookup_fn_type_by_name_and_module + lookup_function_type_for_call.
// Qualified calls: in-TU string return; also first_at for routing before check_call (must appear above check_call).
fn first_at_in_expr_call_name(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_expr_call_name(s, i + 1)
        }
    }
}

fn lookup_fn_type_by_name_and_module_local(env: ListSymbolEntry, fn_name: string, required_module: string) -> string {
    case env.is_nil of {
        true -> "";
        false -> case env.head.name == fn_name and env.head.is_effect_alias == false of {
            true -> case len(required_module) == 0 of {
                true -> case env.head.source_module == "" of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module_local(env.tail, fn_name, required_module)
                };
                false -> case env.head.source_module == required_module of {
                    true -> env.head.type_name;
                    false -> lookup_fn_type_by_name_and_module_local(env.tail, fn_name, required_module)
                }
            };
            false -> lookup_fn_type_by_name_and_module_local(env.tail, fn_name, required_module)
        }
    }
}

fn lookup_function_type_for_call_local(env: ListSymbolEntry, composite_name: string) -> string {
    at: int64 <- first_at_in_expr_call_name(composite_name, 0);
    case at < 0 of {
        true -> lookup_fn_type_by_name_and_module_local(env, composite_name, "");
        false -> lookup_fn_type_by_name_and_module_local(env, substring(composite_name, at + 1, len(composite_name)), substring(composite_name, 0, at))
    }
}

fn check_call(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    // Module-qualified calls (spec §19.3.2): use first_at in this TU. Routing via
    // type_checker_core@call_name_is_module_qualified misclassified on bootstrap (deep builtin chain / stack).
    // Supervisors Phase A: `spawn` / `spawn_linked` are intrinsics (§15.4.8.3); module@spawn_linked must type-check like the unqualified form.
    case first_at_in_expr_call_name(expr.name, 0) >= 0 of {
        true -> do
            base: string <- type_checker_core@user_call_base_function_name(expr.name);
            case base == "spawn" or base == "spawn_dangerous" or base == "spawn_registered" or base == "spawn_registered_supervisor" or base == "spawn_linked" or base == "call_supervisor" or base == "add_child" or base == "link" or base == "monitor" or base == "demonitor" or base == "supervision_ingress_enqueue" or base == "supervision_wait_and_drain_one" or base == "failure_reason_tag" or base == "failure_reason_atom" or base == "failure_agent_type" or base == "failure_release" or base == "start_child" or base == "child_table_first_ref" or base == "child_table_row_ref" or base == "kill_abnormal" or base == "wait_for_exit" or base == "get_registry_actor" or base == "get_pid_registry" or base == "call_registered" or base == "cast_registered" of {
                true -> check_actor_concurrency_call(expr, expected_type, context, world);
                false -> check_user_defined_call(expr, expected_type, context, world)
            }
        end;
        false -> check_call_builtins_dispatch(expr, expected_type, context, world)
    }
}

// User-defined function call: lookup in symbol table, parse function type "(T1,T2) -> R", check args and result
// Top-level `->` only: parameter types may contain nested `fn(...) -> ...`; naive substring match on ` -> ` splits there first.
fn outer_arrow_token_pos_call(func_type: string) -> int64 {
    type_checker_expressions_identifiers@find_arrow_idf(func_type, 0, 0, 0, 0)
}

fn trim_trailing_spaces_user_call_from(s: string, i: int64) -> string {
    case i <= 0 of {
        true -> "";
        false -> case substring(s, i - 1, i) == " " of {
            true -> trim_trailing_spaces_user_call_from(s, i - 1);
            false -> substring(s, 0, i)
        }
    }
}

fn trim_trailing_spaces_user_call(s: string) -> string {
    trim_trailing_spaces_user_call_from(s, len(s))
}

fn params_part_before_outer_arrow_call(func_type: string) -> string {
    arrow_at: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_at < 0 of {
        true -> "";
        false -> trim_trailing_spaces_user_call(trim_leading_user_call(substring(func_type, 0, arrow_at)))
    }
}

fn is_function_type_user_call(type_str: string) -> bool {
    outer_arrow_token_pos_call(type_str) >= 0
}

// Find first comma at depth 0 (top level). Respects parentheses, brackets, and braces in type strings
// so that a single tuple parameter like (int64, int64), ref(R, Space, T), or { x: int64, y: int64 } counts as 1 param.
fn find_top_level_comma_user_call(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) == "(" or substring(s, i, i + 1) == "[" or substring(s, i, i + 1) == "{" of {
            true -> find_top_level_comma_user_call(s, i + 1, depth + 1);
            false -> case substring(s, i, i + 1) == ")" or substring(s, i, i + 1) == "]" or substring(s, i, i + 1) == "}" of {
                true -> case depth <= 0 of {
                    true -> len(s);
                    false -> find_top_level_comma_user_call(s, i + 1, depth - 1)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> i;
                        false -> find_top_level_comma_user_call(s, i + 1, depth)
                    };
                    false -> find_top_level_comma_user_call(s, i + 1, depth)
                }
            }
        }
    }
}

fn trim_leading_user_call(s: string) -> string {
    trim_leading_user_call_from(s, 0)
}

fn trim_leading_user_call_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_leading_user_call_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

fn parse_function_param_count(func_type: string) -> int64 {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> 0;
        false -> do
            params_part: string <- params_part_before_outer_arrow_call(func_type);
            case len(params_part) < 1 of {
                true -> 0;
                false -> case substring(params_part, 0, 1) == "(" and substring(params_part, len(params_part) - 1, len(params_part)) == ")" of {
                    true -> do
                        inner: string <- trim_leading_user_call(substring(params_part, 1, len(params_part) - 1));
                        case len(inner) == 0 of {
                            true -> 0;
                            false -> parse_param_count_inner(inner)
                        }
                    end;
                    false -> do
                        inner_np: string <- trim_leading_user_call(params_part);
                        case len(inner_np) == 0 of {
                            true -> 0;
                            false -> parse_param_count_inner(inner_np)
                        }
                    end
                }
            }
        end
    }
}

fn parse_param_count_inner(inner: string) -> int64 {
    comma1: int64 <- find_top_level_comma_user_call(inner, 0, 0);
    case comma1 >= len(inner) of {
        true -> 1;
        false -> do
            rest: string <- trim_leading_user_call(substring(inner, comma1 + 1, len(inner)));
            case len(rest) == 0 of {
                true -> 2;
                false -> 1 + parse_param_count_inner(rest)
            }
        end
    }
}

fn parse_function_return_type(func_type: string) -> string {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> "";
        false -> trim_leading_user_call(substring(func_type, arrow_pos + 2, len(func_type)))
    }
}

fn get_params_inner_from_func_type(func_type: string) -> string {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> "";
        false -> do
            params_part: string <- params_part_before_outer_arrow_call(func_type);
            case len(params_part) < 1 of {
                true -> "";
                false -> case substring(params_part, 0, 1) == "(" and substring(params_part, len(params_part) - 1, len(params_part)) == ")" of {
                    true -> trim_leading_user_call(substring(params_part, 1, len(params_part) - 1));
                    false -> trim_leading_user_call(params_part)
                }
            }
        end
    }
}

fn get_first_param_type(params_inner: string) -> (string, string) {
    case len(params_inner) == 0 of {
        true -> ("", "");
        false -> do
            comma_pos: int64 <- find_top_level_comma_user_call(params_inner, 0, 0);
            case comma_pos >= len(params_inner) of {
                true -> (trim_leading_user_call(params_inner), "");
                false -> do
                    first: string <- trim_leading_user_call(substring(params_inner, 0, comma_pos));
                    rest: string <- trim_leading_user_call(substring(params_inner, comma_pos + 1, len(params_inner)));
                    (first, rest)
                end
            }
        end
    }
}

// Args after the first: kind-4 chain nodes only; anything else (non--1, non-4) does not add args (avoids counting 2 for a single-arg call when the tail is not dummy).
fn count_additional_call_args_user_call(er: Expr) -> int64 {
    case er.kind == -1 of {
        true -> 0;
        false -> case er.kind == 4 of {
            true -> 1 + count_additional_call_args_user_call(er.right_expr);
            false -> 0
        }
    }
}

fn count_call_args_user_call(expr: Expr) -> int64 {
    case expr.inner.kind == -1 of {
        true -> 0;
        false -> 1 + count_additional_call_args_user_call(expr.right_expr)
    }
}

// Local helper (same as type_checker_modules / type_checker_callee_env list_param_length). Avoid importing type_checker_modules (declarations_functions → … → expressions cycle).
fn list_param_length_call(ps: ListParam) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> 1 + list_param_length_call(ps.tail)
    }
}

// First tag-0 match with same name/arity (legacy fallback when receiver type is unknown or no overload fits).
fn find_function_decl_by_name_arity_call(decls: ListDeclaration, fn_name: string, arity: int64) -> (bool, Declaration) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 0 of {
            true -> case decls.head.name == fn_name and list_param_length_call(decls.head.parameters) == arity of {
                true -> (true, decls.head);
                false -> find_function_decl_by_name_arity_call(decls.tail, fn_name, arity)
            };
            false -> find_function_decl_by_name_arity_call(decls.tail, fn_name, arity)
        }
    }
}

fn qualified_call_first_arg_matches_decl(inferred: string, decl: Declaration, world: ListNamedProgram) -> bool {
    case decl.parameters.is_nil of {
        true -> false;
        false -> do
            expect: string <- type_checker_traits@trim_type_text(decl.parameters.head.type_name);
            act: string <- type_checker_traits@trim_type_text(inferred);
            case act == expect of {
                true -> true;
                false -> type_checker_traits@actual_type_satisfies_trait_expectation(act, expect, world)
            }
        end
    }
}

fn find_tag0_decl_for_qualified_call(decls: ListDeclaration, fn_name: string, arity: int64, recv_ty: string, world: ListNamedProgram) -> (bool, Declaration) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 0 of {
            true -> case decls.head.name == fn_name and list_param_length_call(decls.head.parameters) == arity of {
                true -> case len(recv_ty) == 0 of {
                    true -> (true, decls.head);
                    false -> case qualified_call_first_arg_matches_decl(recv_ty, decls.head, world) of {
                        true -> (true, decls.head);
                        false -> find_tag0_decl_for_qualified_call(decls.tail, fn_name, arity, recv_ty, world)
                    }
                };
                false -> find_tag0_decl_for_qualified_call(decls.tail, fn_name, arity, recv_ty, world)
            };
            false -> find_tag0_decl_for_qualified_call(decls.tail, fn_name, arity, recv_ty, world)
        }
    }
}

fn find_tag7_decl_for_qualified_call(decls: ListDeclaration, fn_name: string, arity: int64, recv_ty: string, world: ListNamedProgram) -> (bool, Declaration) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 7 of {
            true -> case decls.head.name == fn_name and list_param_length_call(decls.head.parameters) == arity of {
                true -> case len(recv_ty) == 0 of {
                    true -> (true, decls.head);
                    false -> case qualified_call_first_arg_matches_decl(recv_ty, decls.head, world) of {
                        true -> (true, decls.head);
                        false -> find_tag7_decl_for_qualified_call(decls.tail, fn_name, arity, recv_ty, world)
                    }
                };
                false -> find_tag7_decl_for_qualified_call(decls.tail, fn_name, arity, recv_ty, world)
            };
            false -> find_tag7_decl_for_qualified_call(decls.tail, fn_name, arity, recv_ty, world)
        }
    }
}

fn param_types_str_from_params(params: ListParam) -> string {
    case params.is_nil of {
        true -> "";
        false -> case params.tail.is_nil of {
            true -> params.head.type_name;
            false -> concat(concat(param_types_str_from_params(params.tail), ","), params.head.type_name)
        }
    }
}

fn build_function_type_for_decl_call(decl: Declaration) -> string {
    params_str: string <- param_types_str_from_params(decl.parameters);
    case decl.parameters.is_nil of {
        true -> concat("() -> ", decl.return_type_name);
        false -> concat(concat(concat("(", params_str), ") -> "), decl.return_type_name)
    }
}

fn inferred_types_concat_comma(bucket: ListParam) -> string {
    case bucket.is_nil of {
        true -> "";
        false -> case bucket.tail.is_nil of {
            true -> bucket.head.type_name;
            false -> concat(concat(bucket.head.type_name, ","), inferred_types_concat_comma(bucket.tail))
        }
    }
}

fn call_site_actual_matches_formal(inferred: string, formal: string, world: ListNamedProgram) -> bool {
    fin: string <- type_checker_traits@trim_type_text(inferred);
    fdecl: string <- type_checker_traits@trim_type_text(formal);
    case fin == fdecl of {
        true -> true;
        false -> case type_checker_tuple_decompose_helpers@types_equal(fin, fdecl) of {
            true -> true;
            false -> type_checker_traits@actual_type_satisfies_trait_expectation(fin, fdecl, world)
        }
    }
}

// Widen/narrow: integer literal infers as int64; impl may take int32 etc.
fn replace_int64_with_int32_in_type_text_loop(s: string, i: int64, out: string) -> string {
    case i >= len(s) of {
        true -> out;
        false -> case i + 5 <= len(s) and substring(s, i, i + 5) == "int64" of {
            true -> replace_int64_with_int32_in_type_text_loop(s, i + 5, concat(out, "int32"));
            false -> replace_int64_with_int32_in_type_text_loop(s, i + 1, concat(out, substring(s, i, i + 1)))
        }
    }
}

fn struct_literal_inferred_matches_impl_record(actual: string, impl_param: string) -> bool {
    a: string <- type_checker_traits@trim_type_text(actual);
    p: string <- type_checker_traits@trim_type_text(impl_param);
    case len(a) > 0 of {
        false -> false;
        true -> case substring(a, 0, 1) == "{" of {
            false -> false;
            true -> do
                relaxed: string <- replace_int64_with_int32_in_type_text_loop(a, 0, "");
                type_checker_tuple_decompose_helpers@types_equal(relaxed, p)
            end
        }
    }
}

fn dispatch_actual_fits_impl_parameter(actual: string, impl_param: string, world: ListNamedProgram) -> bool {
    case call_site_actual_matches_formal(actual, impl_param, world) of {
        true -> true;
        false -> do
            a: string <- type_checker_traits@trim_type_text(actual);
            p: string <- type_checker_traits@trim_type_text(impl_param);
            case a == "int64" of {
                true -> p == "int8" or p == "int16" or p == "int32" or p == "uint8" or p == "uint16" or p == "uint32";
                false -> struct_literal_inferred_matches_impl_record(actual, impl_param)
            }
        end
    }
}

// Tag-0 decl whose first parameter is not the trait Self type (skip e.g. provided fn double_area(s: Shape)).
fn impl_first_param_if_concrete_impl(trait_self: string, d: Declaration) -> string {
    case d.tag == 0 of {
        false -> "";
        true -> case d.parameters.is_nil of {
            true -> "";
            false -> do
                p0: string <- type_checker_traits@trim_type_text(d.parameters.head.type_name);
                ts: string <- type_checker_traits@trim_type_text(trait_self);
                case p0 == ts of {
                    true -> "";
                    false -> p0
                }
            end
        }
    }
}

fn gather_trait_dispatch_candidates_loop(decls: ListDeclaration, trait_self: string, inferred_actual: string, world: ListNamedProgram, cand0: string, cand_count: int64) -> (int64, string) {
    case decls.is_nil of {
        true -> (cand_count, cand0);
        false -> do
            conc: string <- impl_first_param_if_concrete_impl(trait_self, decls.head);
            case len(conc) == 0 of {
                true -> gather_trait_dispatch_candidates_loop(decls.tail, trait_self, inferred_actual, world, cand0, cand_count);
                false -> case dispatch_actual_fits_impl_parameter(inferred_actual, conc, world) of {
                    false -> gather_trait_dispatch_candidates_loop(decls.tail, trait_self, inferred_actual, world, cand0, cand_count);
                    true -> case cand_count == 0 of {
                        true -> gather_trait_dispatch_candidates_loop(decls.tail, trait_self, inferred_actual, world, conc, 1);
                        false -> case cand0 == conc of {
                            true -> gather_trait_dispatch_candidates_loop(decls.tail, trait_self, inferred_actual, world, cand0, cand_count);
                            false -> (-1, "")
                        }
                    }
                }
            }
        end
    }
}

fn infer_trait_dispatch_concrete_from_impls_status(trait_prog: Program, trait_self: string, inferred_actual: string, world: ListNamedProgram) -> (int64, string) {
    (cc: int64, ct: string) <- gather_trait_dispatch_candidates_loop(trait_prog.declarations, trait_self, inferred_actual, world, "", 0);
    case cc < 0 of {
        true -> (2, "");
        false -> case cc == 0 of {
            true -> (0, "");
            false -> (1, ct)
        }
    }
}

fn resolve_site_bucket_type_for_param(inferred: string, formal_ty: string, callee_mod: Program, loc: SourceLocation, call_name: string, world: ListNamedProgram) -> (TypeCheckResult, string) {
    case call_site_actual_matches_formal(inferred, formal_ty, world) of {
        true -> (type_checker_core@type_check_ok(), inferred);
        false -> do
            ft: string <- type_checker_traits@trim_type_text(formal_ty);
            (is_trait: bool, _: Program) <- type_checker_traits@find_program_declaring_trait(world, ft);
            case is_trait of {
                false -> (type_checker_core@type_check_err("E2003", loc, concat(concat(concat(concat(concat("argument type ", inferred), " does not match parameter type "), formal_ty), " for "), call_name), "sect6"), "");
                true -> do
                    (st: int64, conc: string) <- infer_trait_dispatch_concrete_from_impls_status(callee_mod, ft, inferred, world);
                    case st == 1 of {
                        true -> (type_checker_core@type_check_ok(), conc);
                        false -> case st == 2 of {
                            true -> (type_checker_core@type_check_err("E2003", loc, concat("ambiguous trait dispatch: multiple implementation parameter types match this argument for ", call_name), "sect6"), "");
                            false -> (type_checker_core@type_check_err("E2003", loc, concat("no concrete trait implementation matches this argument for ", call_name), "sect6"), "")
                        }
                    }
                end
            }
        end
    }
}

fn find_qualified_call_resolved_declaration(pprog: Program, fn_id: string, ac: int64, recv_ty: string, world: ListNamedProgram) -> (bool, Declaration) {
    (df0: bool, d0: Declaration) <- find_tag0_decl_for_qualified_call(pprog.declarations, fn_id, ac, recv_ty, world);
    case df0 of {
        true -> (true, d0);
        false -> do
            (df7: bool, d7: Declaration) <- find_tag7_decl_for_qualified_call(pprog.declarations, fn_id, ac, recv_ty, world);
            case df7 of {
                true -> (true, d7);
                false -> find_function_decl_by_name_arity_call(pprog.declarations, fn_id, ac)
            }
        end
    }
}

// Infer each actual's type; require it matches the corresponding formal (including trait formals). Returns types in source left-to-right order.
fn infer_trait_site_call_args_walk(expr: Expr, params_lr: ListParam, context: TypeContext, world: ListNamedProgram, call_expr: Expr, callee_mod: Program) -> (TypeCheckResult, ListParam) {
    case expr.inner.kind == -1 of {
        true -> case params_lr.is_nil of {
            true -> (type_checker_core@type_check_ok(), parser_ast@nil_list_param());
            false -> (type_checker_core@type_check_err("E2005", call_expr.location, concat(concat(call_expr.name, ": too few arguments for callee"), " (spec 6)"), "sect6"), parser_ast@nil_list_param())
        };
        false -> case params_lr.is_nil of {
            true -> (type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6"), parser_ast@nil_list_param());
            false -> do
                inferred: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                case len(inferred) == 0 of {
                    true -> (type_checker_core@type_check_err("E2005", expr.inner.location, "cannot infer concrete type for qualified call argument (needed to resolve trait-parameter body)", "sect6"), parser_ast@nil_list_param());
                    false -> do
                        (res_ty: TypeCheckResult, bucket_ty: string) <- resolve_site_bucket_type_for_param(inferred, params_lr.head.type_name, callee_mod, expr.inner.location, call_expr.name, world);
                        case res_ty.is_ok of {
                            false -> (res_ty, parser_ast@nil_list_param());
                            true -> case params_lr.tail.is_nil of {
                                true -> do
                                    extra: TypeCheckResult <- case expr.right_expr.kind == -1 of {
                                        true -> type_checker_core@type_check_ok();
                                        false -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6")
                                    };
                                    case extra.is_ok of {
                                        false -> (extra, parser_ast@nil_list_param());
                                        true -> (type_checker_core@type_check_ok(), parser_ast@build_infer_type_bucket(bucket_ty, parser_ast@nil_list_param()))
                                    }
                                end;
                                false -> case expr.right_expr.kind == 4 of {
                                    true -> do
                                        (rest_ok: TypeCheckResult, rest_inf: ListParam) <- infer_trait_site_call_args_walk(expr.right_expr, params_lr.tail, context, world, call_expr, callee_mod);
                                        case rest_ok.is_ok of {
                                            false -> (rest_ok, parser_ast@nil_list_param());
                                            true -> (type_checker_core@type_check_ok(), parser_ast@build_infer_type_bucket(bucket_ty, rest_inf))
                                        }
                                    end;
                                    false -> do
                                        (one_ok: TypeCheckResult, one_tail: ListParam) <- infer_one_flat_second_arg(expr.right_expr, params_lr.tail, context, world, call_expr, callee_mod);
                                        case one_ok.is_ok of {
                                            false -> (one_ok, parser_ast@nil_list_param());
                                            true -> (type_checker_core@type_check_ok(), parser_ast@build_infer_type_bucket(bucket_ty, one_tail))
                                        }
                                    end
                                }
                            }
                        }
                    end
                }
            end
        }
    }
}

fn infer_one_flat_second_arg(second_e: Expr, params_tail: ListParam, context: TypeContext, world: ListNamedProgram, call_expr: Expr, callee_mod: Program) -> (TypeCheckResult, ListParam) {
    case params_tail.is_nil of {
        true -> (type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6"), parser_ast@nil_list_param());
        false -> case params_tail.tail.is_nil of {
            false -> (type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6"), parser_ast@nil_list_param());
            true -> do
                inf2: string <- type_checker_tuple_decompose_helpers@infer_expr_type(second_e, context);
                case len(inf2) == 0 of {
                    true -> (type_checker_core@type_check_err("E2005", second_e.location, "cannot infer concrete type for qualified call argument (needed to resolve trait-parameter body)", "sect6"), parser_ast@nil_list_param());
                    false -> do
                        (res2: TypeCheckResult, bucket2: string) <- resolve_site_bucket_type_for_param(inf2, params_tail.head.type_name, callee_mod, second_e.location, call_expr.name, world);
                        case res2.is_ok of {
                            false -> (res2, parser_ast@nil_list_param());
                            true -> (type_checker_core@type_check_ok(), parser_ast@build_infer_type_bucket(bucket2, parser_ast@nil_list_param()))
                        }
                    end
                }
            end
        }
    }
}

fn validate_callsite_return_record_type(rt: string, loc: SourceLocation) -> TypeCheckResult {
    case type_checker_record_types@record_type_starts(rt) of {
        false -> type_checker_core@type_check_ok();
        true -> case type_checker_record_types@record_type_braces_balanced(rt) of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2003", loc, "malformed inline record type (unbalanced braces)", "sect3.4.2")
        }
    }
}

// Re-check callee body with formal parameters bound to inferred concrete types (trait dispatch / overloads inside the body).
// Pass-1 env must be the callee module's (use/export/local fns). The caller's env omits callee private helpers → E2005 on mod@-qualified calls.
fn check_callsite_body_with_concrete_params(decl: Declaration, world: ListNamedProgram, conc_decl_order: ListParam, callee_mod_id: string, callee_prog: Program) -> TypeCheckResult proc[DeviceIO] {
    case list_param_length_call(decl.parameters) == list_param_length_call(conc_decl_order) of {
        false -> type_checker_core@type_check_err("E2005", decl.location, "internal: call-site parameter type list length mismatch", "sect6");
        true -> do
            (pass1: TypeCheckResult, ctx_callee: TypeContext) <- type_checker_callee_env@add_all_declarations_with_world(callee_prog.declarations, type_checker_core@create_type_context(), world, callee_mod_id);
            case pass1.is_ok of {
                false -> pass1;
                true -> do
                    dp: ListParam <- parser_ast@param_list_normalize(decl.parameters);
                    cp: ListParam <- parser_ast@param_list_normalize(conc_decl_order);
                    ctx_params: TypeContext <- type_checker_core@add_params_concrete_loop1(ParamConcreteEnv { decl_params: dp, concrete_types: cp, base: ctx_callee });
                    ret_rec: TypeCheckResult <- validate_callsite_return_record_type(decl.return_type_name, decl.return_type_location);
                    case ret_rec.is_ok of {
                        false -> ret_rec;
                        true -> case decl.return_type_name == "unit" of {
                            true -> type_checker_core@type_check_err("E2006", decl.return_type_location, "unit is not a valid return type", "sect4");
                            false -> case type_checker_memory_regions@is_memory_region_type(decl.return_type_name) of {
                                true -> do
                                    mem_result: TypeCheckResult <- type_checker_memory_regions@validate_memory_region_type(decl.return_type_name, decl.return_type_location);
                                    case mem_result.is_ok of {
                                        false -> mem_result;
                                        true -> check_expr(decl.body, decl.return_type_name, ctx_params, world)
                                    }
                                end;
                                false -> check_expr(decl.body, decl.return_type_name, ctx_params, world)
                            }
                        }
                    }
                end
            }
        end
    }
}

// §19.3.2: for `module@fn(args)`, resolve callee in `world` (includes the current module). Overloads share name/arity; pick by inferred first-argument type, then required trait signature (tag 7), then first tag-0 match.
fn try_resolve_qualified_call_func_type(expr: Expr, world: ListNamedProgram, context: TypeContext) -> (bool, string) {
    at: int64 <- first_at_in_expr_call_name(expr.name, 0);
    case at < 0 of {
        true -> (false, "");
        false -> do
            mod_id: string <- substring(expr.name, 0, at);
            fn_id: string <- substring(expr.name, at + 1, len(expr.name));
            ac: int64 <- count_call_args_user_call(expr);
            (pf: bool, pprog: Program) <- parser_ast@find_named_program(mod_id, world);
            case pf of {
                false -> (false, "");
                true -> do
                    recv_ty: string <- case ac > 0 of {
                        true -> type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                        false -> ""
                    };
                    (df0: bool, d0: Declaration) <- find_tag0_decl_for_qualified_call(pprog.declarations, fn_id, ac, recv_ty, world);
                    case df0 of {
                        true -> (true, build_function_type_for_decl_call(d0));
                        false -> do
                            (df7: bool, d7: Declaration) <- find_tag7_decl_for_qualified_call(pprog.declarations, fn_id, ac, recv_ty, world);
                            case df7 of {
                                true -> (true, build_function_type_for_decl_call(d7));
                                false -> do
                                    (df: bool, ddecl: Declaration) <- find_function_decl_by_name_arity_call(pprog.declarations, fn_id, ac);
                                    case df of {
                                        true -> (true, build_function_type_for_decl_call(ddecl));
                                        false -> case ac == 0 of {
                                            true -> do
                                                (df1: bool, d1: Declaration) <- find_function_decl_by_name_arity_call(pprog.declarations, fn_id, 1);
                                                case df1 of {
                                                    true -> (true, build_function_type_for_decl_call(d1));
                                                    false -> (false, "")
                                                }
                                            end;
                                            false -> (false, "")
                                        }
                                    }
                                end
                            }
                        end
                    }
                end
            }
        end
    }
}

fn check_user_call_result_user_call(expr: Expr, expected_type: string, return_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult {
    case expected_type == "discard" of {
        true -> type_checker_core@type_check_ok();
        false -> case type_checker_lists@types_equal_strip(expected_type, return_type) of {
            true -> type_checker_core@type_check_ok();
            false -> case trim_leading_user_call(expected_type) == "string" and return_type_has_ptr_len_out_fields(return_type) of {
                true -> type_checker_core@type_check_ok();
                false -> case type_checker_traits@actual_type_satisfies_trait_expectation(return_type, expected_type, world) of {
                    true -> type_checker_core@type_check_ok();
                    false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat(expr.name, " returns "), return_type), ", expected "), expected_type), "sect6")
                }
            }
        }
    }
}

fn return_type_text_contains(s: string, needle: string) -> bool {
    case len(needle) == 0 of {
        true -> true;
        false -> case len(s) < len(needle) of {
            true -> false;
            false -> case substring(s, 0, len(needle)) == needle of {
                true -> true;
                false -> return_type_text_contains(substring(s, 1, len(s)), needle)
            }
        }
    }
}

fn return_type_has_ptr_len_out_fields(return_type: string) -> bool {
    ret: string <- trim_leading_user_call(return_type);
    case return_type_text_contains(ret, "text_ptr") of {
        true -> return_type_text_contains(ret, "text_len");
        false -> case return_type_text_contains(ret, "_ptr") of {
            true -> return_type_text_contains(ret, "_len");
            false -> false
        }
    }
}

fn params_inner_is_ptr_len_pair(params_inner: string) -> bool {
    (first_param: string, rest_params: string) <- get_first_param_type(params_inner);
    (second_param: string, rest_rest: string) <- get_first_param_type(rest_params);
    case len(rest_rest) > 0 of {
        true -> false;
        false -> trim_leading_user_call(first_param) == "uint8" and trim_leading_user_call(second_param) == "uint64"
    }
}

fn check_user_call_args_recursive(expr: Expr, params_inner: string, expected_type: string, return_type: string, context: TypeContext, call_expr: Expr, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case expr.inner.kind == -1 of {
        true -> case len(params_inner) == 0 of {
            true -> check_user_call_result_user_call(call_expr, expected_type, return_type, context, world);
            false -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6")
        };
        false -> do
            (first_param: string, rest_params: string) <- get_first_param_type(params_inner);
            case len(first_param) == 0 of {
                true -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6");
                false -> do
                    r1: TypeCheckResult <- check_expr(expr.inner, first_param, context, world);
                    case r1.is_ok of {
                        false -> r1;
                        true -> case len(rest_params) == 0 of {
                            true -> check_user_call_result_user_call(call_expr, expected_type, return_type, context, world);
                            false -> case expr.right_expr.kind == -1 of {
                                true -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6");
                                false -> case expr.right_expr.kind == 4 of {
                                    true -> case len(rest_params) == 0 of {
                                        true -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6");
                                        false -> check_user_call_args_recursive(expr.right_expr, rest_params, expected_type, return_type, context, call_expr, world)
                                    };
                                    false -> do
                                        (second_param: string, rest_rest: string) <- get_first_param_type(rest_params);
                                        case len(second_param) == 0 or len(rest_rest) > 0 of {
                                            true -> type_checker_core@type_check_err("E2005", call_expr.location, concat(call_expr.name, " argument count mismatch"), "sect6");
                                            false -> do
                                                r2: TypeCheckResult <- check_expr(expr.right_expr, second_param, context, world);
                                                case r2.is_ok of {
                                                    false -> r2;
                                                    true -> check_user_call_result_user_call(call_expr, expected_type, return_type, context, world)
                                                }
                                            end
                                        }
                                    end
                                }
                            }
                        }
                    }
                end
            }
        end
    }
}

fn check_user_defined_world_call_with_inference(expr: Expr, expected_type: string, context: TypeContext, params_inner: string, return_type: string, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    at: int64 <- first_at_in_expr_call_name(expr.name, 0);
    case at < 0 of {
        true -> check_user_call_args_recursive(expr, params_inner, expected_type, return_type, context, expr, world);
        false -> do
            mod_id: string <- substring(expr.name, 0, at);
            fn_id: string <- substring(expr.name, at + 1, len(expr.name));
            ac: int64 <- count_call_args_user_call(expr);
            (pf: bool, pprog: Program) <- parser_ast@find_named_program(mod_id, world);
            case pf of {
                false -> check_user_call_args_recursive(expr, params_inner, expected_type, return_type, context, expr, world);
                true -> do
                    recv_ty: string <- case ac > 0 of {
                        true -> type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                        false -> ""
                    };
                    (pfd: bool, callee_decl: Declaration) <- find_qualified_call_resolved_declaration(pprog, fn_id, ac, recv_ty, world);
                    case pfd of {
                        false -> check_user_call_args_recursive(expr, params_inner, expected_type, return_type, context, expr, world);
                        true -> case callee_decl.tag == 0 of {
                            false -> check_user_call_args_recursive(expr, params_inner, expected_type, return_type, context, expr, world);
                            true -> do
                                params_lr: ListParam <- parser_ast@list_param_reverse_with_acc(callee_decl.parameters, parser_ast@nil_list_param());
                                (inf_ok: TypeCheckResult, inf_left: ListParam) <- infer_trait_site_call_args_walk(expr, params_lr, context, world, expr, pprog);
                                case inf_ok.is_ok of {
                                    false -> inf_ok;
                                    true -> do
                                        params_inner_inf: string <- inferred_types_concat_comma(inf_left);
                                        chk_args: TypeCheckResult <- check_user_call_args_recursive(expr, params_inner_inf, expected_type, return_type, context, expr, world);
                                        case chk_args.is_ok of {
                                            false -> chk_args;
                                            true -> do
                                                conc_decl: ListParam <- parser_ast@list_param_reverse_with_acc(inf_left, parser_ast@nil_list_param());
                                                body_ok: TypeCheckResult <- check_callsite_body_with_concrete_params(callee_decl, world, conc_decl, mod_id, pprog);
                                                case body_ok.is_ok of {
                                                    false -> body_ok;
                                                    true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
                                                }
                                            end
                                        }
                                    end
                                }
                            end
                        }
                    }
                end
            }
        end
    }
}

fn check_user_defined_call(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    (rw: bool, ft_world: string) <- try_resolve_qualified_call_func_type(expr, world, context);
    resolved_type: string <- case rw of {
        true -> ft_world;
        false -> lookup_function_type_for_call_local(context.env, expr.name)
    };
    case len(resolved_type) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, concat("unknown or unsupported function: ", expr.name), "sect6");
        false -> case is_function_type_user_call(resolved_type) of {
            false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " is not a function"), "sect6");
            true -> check_user_defined_call_parsed(expr, expected_type, context, resolved_type, world, rw)
        }
    }
}

fn check_user_defined_call_parsed(expr: Expr, expected_type: string, context: TypeContext, func_type: string, world: ListNamedProgram, callee_type_from_world: bool) -> TypeCheckResult proc[DeviceIO] {
    func_type_canon: string <- type_checker_expressions_identifiers@normalize_fn_type_idf(func_type);
    expected_arg_count: int64 <- parse_function_param_count(func_type_canon);
    params_inner: string <- get_params_inner_from_func_type(func_type_canon);
    return_type: string <- parse_function_return_type(func_type_canon);
    arg_count: int64 <- count_call_args_user_call(expr);
    case callee_type_from_world of {
        true -> check_user_defined_world_call_with_inference(expr, expected_type, context, params_inner, return_type, world);
                false -> case arg_count != expected_arg_count of {
        true -> case expected_arg_count == 2 and arg_count == 1 and params_inner_is_ptr_len_pair(params_inner) of {
            true -> do
                r_str: TypeCheckResult <- check_expr(expr.inner, "string", context, world);
                case r_str.is_ok of {
                    false -> r_str;
                    true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
                }
            end;
            false -> case expected_arg_count == 1 of {
            true -> case arg_count == 2 of {
                true -> case len(params_inner) >= 2 of {
                    true -> case substring(params_inner, 0, 1) == "(" of {
                        true -> case substring(params_inner, len(params_inner) - 1, len(params_inner)) == ")" of {
                            true -> check_user_call_two_args_as_tuple(expr, params_inner, expected_type, return_type, context, world);
                            false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                        };
                        false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                    };
                    false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                };
                false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
            };
            false -> case expected_arg_count == 2 of {
                true -> case arg_count == 1 of {
                    true -> case expr.inner.kind == 9 of {
                        true -> check_user_call_one_tuple_as_two_args(expr, params_inner, expected_type, return_type, context, world);
                        false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                    };
                    false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
                };
                false -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6")
            }
            }
        };
        false -> check_user_call_args_recursive(expr, params_inner, expected_type, return_type, context, expr, world)
        }
    }
}

fn check_user_call_one_tuple_as_two_args(expr: Expr, params_inner: string, expected_type: string, return_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    (first_param: string, rest_params: string) <- get_first_param_type(params_inner);
    (second_param: string, _: string) <- get_first_param_type(rest_params);
    case len(first_param) == 0 or len(second_param) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6");
        false -> do
            tuple_type: string <- concat(concat(concat(concat("(", first_param), ","), second_param), ")");
            r1: TypeCheckResult <- check_expr(expr.inner, tuple_type, context, world);
            case r1.is_ok of {
                false -> r1;
                true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
            }
        end
    }
}

fn check_user_call_two_args_as_tuple(expr: Expr, tuple_param: string, expected_type: string, return_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    inner: string <- trim_leading_user_call(substring(tuple_param, 1, len(tuple_param) - 1));
    comma_pos: int64 <- find_top_level_comma_user_call(inner, 0, 0);
    case comma_pos >= len(inner) of {
        true -> type_checker_core@type_check_err("E2005", expr.location, concat(expr.name, " argument count mismatch"), "sect6");
        false -> do
            first_type: string <- trim_leading_user_call(substring(inner, 0, comma_pos));
            second_type: string <- trim_leading_user_call(substring(inner, comma_pos + 1, len(inner)));
            r1: TypeCheckResult <- check_expr(expr.inner, first_type, context, world);
            case r1.is_ok of {
                false -> r1;
                true -> do
                    r2: TypeCheckResult <- check_expr(expr.right_expr, second_type, context, world);
                    case r2.is_ok of {
                        false -> r2;
                        true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
                    }
                end
            }
        end
    }
}

// Let binding: name: type <- rhs; body. Check rhs has declared type, add to env, check body.
// Reject unit for named variables; allow _ : unit <- expr (discard pattern for expression statements).
// Memory region types (ref, region, buf) are validated before type checking.
fn check_let(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    bind_type: string <- expr.value;
    list_result: TypeCheckResult <- type_checker_lists@validate_list_type_declaration(bind_type, expr.location);
    case list_result.is_ok of {
        false -> list_result;
        true -> case type_checker_memory_regions@is_memory_region_type(bind_type) of {
            true -> check_let_memory_region(expr, expected_type, context, bind_type, world);
            false -> check_let_after_validation(expr, expected_type, context, bind_type, world)
        }
    }
}

fn check_let_memory_region(expr: Expr, expected_type: string, context: TypeContext, bind_type: string, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    mem_result: TypeCheckResult <- type_checker_memory_regions@validate_memory_region_type(bind_type, expr.location);
    case mem_result.is_ok of {
        false -> mem_result;
        true -> check_let_after_validation(expr, expected_type, context, bind_type, world)
    }
}

// When a let-binding creates an actor_ref from spawn (or dangerous_actor_ref from spawn_dangerous),
// record the behavior function type and enforce region move semantics (§12.1.5).
fn enrich_env_for_actor_spawn(env: ListSymbolEntry, var_name: string, bind_type: string, rhs: Expr, context: TypeContext) -> ListSymbolEntry {
    rhs_base: string <- type_checker_core@user_call_base_function_name(rhs.name);
    spawn_pair_ok: bool <- case bind_type == "actor_ref" and rhs_base == "spawn" of {
        true -> true;
        false -> bind_type == "dangerous_actor_ref" and rhs_base == "spawn_dangerous"
    };
    case rhs.kind == 4 and spawn_pair_ok of {
        true -> do
            beh_e: Expr <- type_checker_expressions_actors@spawn_behavior_expr(rhs);
            env1: ListSymbolEntry <- case beh_e.kind == 1 of {
                true -> do
                    (beh_found: bool, beh_type: string) <- type_checker_core@lookup_symbol_found(context.env, beh_e.name);
                    case beh_found of {
                        true -> do
                            env_beh: ListSymbolEntry <- type_checker_core@add_symbol(env, concat("__actor_beh__", var_name), beh_type, parser_ast@empty_effect_name_list(), "");
                            state_t: string <- type_checker_expressions_actors@parse_behavior_state_param_type(beh_type);
                            sup_csv: string <- type_checker_core@lookup_supervisor_csv(context);
                            case type_checker_core@type_name_in_supervisor_csv(state_t, sup_csv) or len(sup_csv) > 0 of {
                                true -> type_checker_core@add_symbol(env_beh, actor_ref_supervisor_marker_name(var_name), "boolean", parser_ast@empty_effect_name_list(), "");
                                false -> env_beh
                            }
                        end;
                        false -> env
                    }
                end;
                false -> env
            };
            state_e: Expr <- rhs.inner;
            case state_e.kind == 1 of {
                true -> do
                    (st_found: bool, st_type: string) <- type_checker_core@lookup_symbol_found(context.env, state_e.name);
                    case st_found and type_checker_memory_regions@is_memory_region_type(st_type) of {
                        true -> type_checker_core@add_symbol(env1, state_e.name, "moved_region", parser_ast@empty_effect_name_list(), "");
                        false -> env1
                    }
                end;
                false -> env1
            }
        end;
        false -> env
    }
}

// Lambda (kind 991): formals in pattern_bindings; value = synthesized `(T1,...) -> R`; right_expr kind 992 holds return type text.
// Body is checked in a context extended with formals on top of the current env so outer bindings remain visible (closure capture).
fn lambda_formal_bindings_valid(bindings: ListTupleDecomposeBinding, location: SourceLocation) -> TypeCheckResult {
    case bindings.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case len(bindings.head.type_str) == 0 of {
            true -> type_checker_core@type_check_err("E2006", location, "lambda parameter must have an explicit type", "sect4");
            false -> lambda_formal_bindings_valid(bindings.tail, location)
        }
    }
}

fn check_lambda_expression(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    formal_ok: TypeCheckResult <- lambda_formal_bindings_valid(expr.pattern_bindings, expr.location);
    case formal_ok.is_ok of {
        false -> formal_ok;
        true -> do
            ret_ty: string <- expr.right_expr.value;
            inner_ctx: TypeContext <- type_checker_tuple_decompose_helpers@add_bindings_to_context(context, expr.pattern_bindings);
            case expected_type == "discard" of {
                true -> check_expr(expr.inner, ret_ty, inner_ctx, world);
                false -> do
                    synth: string <- expr.value;
                    compat: bool <- type_checker_expressions_identifiers@function_types_compatible(synth, expected_type);
                    case compat of {
                        false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat("lambda type ", synth), concat(" is incompatible with context ", expected_type)), "sect6");
                        true -> check_expr(expr.inner, ret_ty, inner_ctx, world)
                    }
                end
            }
        end
    }
}

fn check_let_after_validation(expr: Expr, expected_type: string, context: TypeContext, bind_type: string, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case bind_type == "unit" of {
        true -> case expr.name == "_" of {
            true -> do
                rhs_result: TypeCheckResult <- check_expr(expr.inner, "discard", context, world);
                case rhs_result.is_ok of {
                    false -> rhs_result;
                    true -> do
                        body_result: TypeCheckResult <- check_expr(expr.right_expr, expected_type, context, world);
                        body_result
                    end
                }
            end;
            false -> type_checker_core@type_check_err("E2006", expr.location, "unit is not a valid type for variables or parameters", "sect4")
        };
        false -> do
            is_discard: bool <- len(expr.name) == 1 and substring(expr.name, 0, 1) == "_";
            rhs_expected: string <- case is_discard of { true -> "discard"; false -> bind_type };
            rhs_result: TypeCheckResult <- check_expr(expr.inner, rhs_expected, context, world);
            case rhs_result.is_ok of {
                false -> rhs_result;
                true -> do
                    base_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, expr.name, bind_type, parser_ast@empty_effect_name_list(), "");
                    new_env: ListSymbolEntry <- enrich_env_for_actor_spawn(base_env, expr.name, bind_type, expr.inner, context);
                    new_context: TypeContext <- type_checker_core@type_context_with_env(context, new_env);
                    body_result: TypeCheckResult <- check_expr(expr.right_expr, expected_type, new_context, world);
                    body_result
                end
            }
        end
    }
}

// Build context with all bindings from sequence body (let chain and tuple decomposes).
// The produces pure expr sees variables bound in the body.
fn context_after_sequence_body(body: Expr, context: TypeContext) -> TypeContext {
    case body.kind == 6 of {
        true -> do
            is_discard: bool <- body.value == "unit" and body.name == "_";
            new_context: TypeContext <- case is_discard of {
                true -> context;
                false -> do
                    base_env: ListSymbolEntry <- type_checker_core@add_symbol(context.env, body.name, body.value, parser_ast@empty_effect_name_list(), "");
                    enriched_env: ListSymbolEntry <- enrich_env_for_actor_spawn(base_env, body.name, body.value, body.inner, context);
                    type_checker_core@type_context_with_env(context, enriched_env)
                end
            };
            context_after_sequence_body(body.right_expr, new_context)
        end;
        false -> case body.kind == 10 of {
            true -> do
                extended: TypeContext <- type_checker_tuple_decompose_helpers@add_bindings_to_context(context, body.pattern_bindings);
                context_after_sequence_body(body.right_expr, extended)
            end;
            false -> context
        }
    }
}

// Sequence block (kind 11): sequence [proc[ε]] {statements} produces pure expr end
// inner = body (statements before produces), right_expr = result (pure expr); sequence_effects validated by effect checker
// The produces expr is in scope of all bindings from the body.
// Phase A lifetime analysis: when return type contains ref/buf, region must be returned (spec §12.1.4).
fn check_sequence_block(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    body_result: TypeCheckResult <- check_expr(expr.inner, "discard", context, world);
    case body_result.is_ok of {
        false -> body_result;
        true -> do
            result_context: TypeContext <- context_after_sequence_body(expr.inner, context);
            expr_result: TypeCheckResult <- check_expr(expr.right_expr, expected_type, result_context, world);
            case expr_result.is_ok of {
                false -> expr_result;
                true -> type_checker_memory_regions@check_sequence_return_lifetime(expected_type, expr.right_expr.location)
            }
        end
    }
}

// Parsed tuple types may spell atom slots as lexemes (:reply, :no_reply, :ok). For checking expressions, that field has type atom.
fn tuple_elem_type_for_check(field_type: string) -> string {
    case len(field_type) > 0 and substring(field_type, 0, 1) == ":" of {
        true -> "atom";
        false -> field_type
    }
}

// Tuple literal (kind 9): check against expected tuple type "(T1, T2)"
fn check_tuple_literal_inline(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case len(expected_type) == 7 and substring(expected_type, 0, 1) == "d" and substring(expected_type, 1, 2) == "i" and substring(expected_type, 2, 3) == "s" and substring(expected_type, 3, 4) == "c" and substring(expected_type, 4, 5) == "a" and substring(expected_type, 5, 6) == "r" and substring(expected_type, 6, 7) == "d" of {
        true -> type_checker_core@type_check_ok();
        false -> case len(expected_type) < 2 of {
            true -> type_checker_core@type_check_err("E2005", expr.location, concat("tuple literal requires tuple type, got ", expected_type), "sect4");
            false -> case substring(expected_type, 0, 1) == "(" of {
                true -> case substring(expected_type, len(expected_type) - 1, len(expected_type)) == ")" of {
                    true -> do
                        inner: string <- substring(expected_type, 1, len(expected_type) - 1);
                        comma_pos: int64 <- case expr.inner.kind == 9 of {
                            true -> tuple_find_last_top_level_comma(inner);
                            false -> tuple_find_top_level_comma(inner, 0)
                        };
                        first_type_raw: string <- substring(inner, 0, comma_pos);
                        first_type: string <- tuple_trim_leading(first_type_raw);
                        first_type_wrapped: string <- case tuple_find_top_level_comma(first_type, 0) < len(first_type) of {
                            true -> concat(concat("(", first_type), ")");
                            false -> first_type
                        };
                        rest_start: int64 <- comma_pos + 1;
                        second_type_raw: string <- case rest_start < len(inner) of {
                            true -> substring(inner, rest_start, len(inner));
                            false -> ""
                        };
                        second_type: string <- tuple_trim_leading(second_type_raw);
                        second_type_wrapped: string <- case tuple_find_top_level_comma(second_type, 0) < len(second_type) of {
                            true -> concat(concat("(", second_type), ")");
                            false -> second_type
                        };
                        first_expect: string <- tuple_elem_type_for_check(first_type_wrapped);
                        second_expect: string <- tuple_elem_type_for_check(second_type_wrapped);
                        first_result: TypeCheckResult <- check_expr(expr.inner, first_expect, context, world);
                        case first_result.is_ok of {
                            false -> first_result;
                            true -> do
                                second_result: TypeCheckResult <- check_expr(expr.right_expr, second_expect, context, world);
                                second_result
                            end
                        }
                    end;
                    false -> type_checker_core@type_check_err("E2005", expr.location, concat("tuple literal requires tuple type, got ", expected_type), "sect4")
                };
                false -> type_checker_core@type_check_err("E2005", expr.location, concat("tuple literal requires tuple type, got ", expected_type), "sect4")
            }
        }
    }
}

fn tuple_trim_leading(s: string) -> string {
    tuple_trim_leading_from(s, 0)
}

fn tuple_trim_leading_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> tuple_trim_leading_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

// Find first comma at top level (not inside parentheses). Handles nested tuples recursively.
fn tuple_find_top_level_comma(s: string, i: int64) -> int64 {
    tc_tuple_find_top_level_comma_from(s, i, 0, 0, 0)
}

// Top-level over paren/brace/bracket depth (all three must be 0 for a comma to split tuple components).
// Spec: `(A, B)` tuple may carry record or list components (`{...}`, `List[...]`) whose internal commas
// are not tuple separators (§3.3 / §15.4.13.2 for supervisor init return shape).
// Prefixed `tc_` to avoid collision with parser_tuples' paren-only variant under the bootstrap compiler's
// flat function namespace.
fn tc_tuple_find_top_level_comma_from(s: string, i: int64, paren: int64, brace: int64, bracket: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren + 1, brace, bracket);
                false -> case c == ")" of {
                    true -> case paren <= 0 and brace == 0 and bracket == 0 of {
                        true -> len(s);
                        false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren - 1, brace, bracket)
                    };
                    false -> case c == "{" of {
                        true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace + 1, bracket);
                        false -> case c == "}" of {
                            true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace - 1, bracket);
                            false -> case c == "[" of {
                                true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket + 1);
                                false -> case c == "]" of {
                                    true -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket - 1);
                                    false -> case c == "," of {
                                        true -> case paren == 0 and brace == 0 and bracket == 0 of {
                                            true -> i;
                                            false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket)
                                        };
                                        false -> tc_tuple_find_top_level_comma_from(s, i + 1, paren, brace, bracket)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        end
    }
}

// Find last comma at top level (over paren/brace/bracket). For right-nested (a,(b,c)),
// inner has type (A,B), right_expr has type C; record/list components must not confuse the split.
fn tuple_find_last_top_level_comma(s: string) -> int64 {
    tc_tuple_find_last_top_level_comma_from(s, 0, 0, 0, 0, -1)
}

fn tc_tuple_find_last_top_level_comma_from(s: string, i: int64, paren: int64, brace: int64, bracket: int64, last: int64) -> int64 {
    case i >= len(s) of {
        true -> case last < 0 of { true -> len(s); false -> last };
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "(" of {
                true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren + 1, brace, bracket, last);
                false -> case c == ")" of {
                    true -> case paren <= 0 and brace == 0 and bracket == 0 of {
                        true -> case last < 0 of { true -> len(s); false -> last };
                        false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren - 1, brace, bracket, last)
                    };
                    false -> case c == "{" of {
                        true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace + 1, bracket, last);
                        false -> case c == "}" of {
                            true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace - 1, bracket, last);
                            false -> case c == "[" of {
                                true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket + 1, last);
                                false -> case c == "]" of {
                                    true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket - 1, last);
                                    false -> case c == "," of {
                                        true -> case paren == 0 and brace == 0 and bracket == 0 of {
                                            true -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, i);
                                            false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, last)
                                        };
                                        false -> tc_tuple_find_last_top_level_comma_from(s, i + 1, paren, brace, bracket, last)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        end
    }
}

// Whether expression mentions identifier `name` (for case guard rule §3.4: guard must depend on pattern bindings).
fn expr_references_name(e: Expr, name: string) -> bool {
    case e.kind < 0 of {
        true -> false;
        false -> case e.kind of {
            0 -> false;
            1 -> e.name == name;
            2 -> expr_references_name(e.inner, name);
            3 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            4 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            5 -> false;
            6 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            7 -> false;
            8 -> false;
            9 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            10 -> expr_references_name(e.inner, name);
            11 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            12 -> expr_references_name(e.inner, name);
            13 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            19 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr.inner, name) or expr_references_name(e.right_expr.right_expr, name);
            20 -> expr_references_name(e.inner, name) or expr_references_name(e.right_expr, name);
            _: int64 -> false
        }
    }
}

fn case_record_guard_refs_any(branch: Expr, pat_str: string, scrutinee_type: string) -> bool {
    inner: string <- type_checker_record_types@record_case_inner_body(pat_str);
    case_record_guard_refs_loop(branch, inner, scrutinee_type)
}

fn case_record_guard_refs_loop(branch: Expr, rem: string, scrutinee_type: string) -> bool {
    (seg: string, rest2: string) <- type_checker_record_types@record_case_field_step(rem);
    case len(seg) == 0 of {
        true -> false;
        false -> do
            (fname: string, sub: string) <- type_checker_record_types@record_field_segment_name_sub(seg);
            case len(fname) == 0 of {
                true -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                false -> do
                    fty: string <- type_checker_record_types@find_field_type_in_record(scrutinee_type, fname);
                    case len(fty) == 0 of {
                        true -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                        false -> do
                            spi: CasePatternInfo <- type_checker_tuple_decompose_helpers@case_parse_record_field_subpat(sub, fty);
                            case spi.is_valid of {
                                false -> case_record_guard_refs_loop(branch, rest2, scrutinee_type);
                                true -> case spi.pattern_kind of {
                                    2 -> case expr_references_name(branch.inner, spi.bind_name) of {
                                        true -> true;
                                        false -> case_record_guard_refs_loop(branch, rest2, scrutinee_type)
                                    };
                                    8 -> case case_record_guard_refs_any(branch, spi.bind_type, fty) of {
                                        true -> true;
                                        false -> case_record_guard_refs_loop(branch, rest2, scrutinee_type)
                                    };
                                    _: int64 -> case_record_guard_refs_loop(branch, rest2, scrutinee_type)
                                }
                            }
                        end
                    }
                end
            }
        end
    }
}

fn case_list_cons_guard_ok_expr(branch: Expr, pi: CasePatternInfo) -> bool {
    head_bound: bool <- len(pi.bind_name) > 0 and pi.bind_name != "_";
    tail_bound: bool <- len(pi.list_tail_name) > 0 and pi.list_tail_name != "_";
    case head_bound of {
        false -> case tail_bound of {
            false -> true;
            true -> expr_references_name(branch.inner, pi.list_tail_name)
        };
        true -> case tail_bound of {
            false -> expr_references_name(branch.inner, pi.bind_name);
            true -> expr_references_name(branch.inner, pi.bind_name) or expr_references_name(branch.inner, pi.list_tail_name)
        }
    }
}

fn check_case_guard_invariant(branch: Expr, pi: CasePatternInfo, scrutinee_type: string) -> TypeCheckResult {
    case type_checker_tuple_decompose_helpers@case_pattern_has_named_binding(pi, scrutinee_type) of {
        true -> case pi.pattern_kind of {
            6 -> case case_list_cons_guard_ok_expr(branch, pi) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", branch.inner.location, "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            };
            8 -> case case_record_guard_refs_any(branch, pi.bind_type, scrutinee_type) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", branch.inner.location, "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            };
            _: int64 -> case expr_references_name(branch.inner, type_checker_tuple_decompose_helpers@case_pattern_binding_name(pi)) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2014", branch.inner.location, "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
            }
        };
        false -> type_checker_core@type_check_err("E2014", branch.inner.location, "Guard does not depend on pattern bindings — move it before the case or restructure.", "sect3")
    }
}

fn check_case_branch_guard(branch: Expr, pi: CasePatternInfo, ext_ctx: TypeContext, scrutinee_type: string, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case branch.inner.kind < 0 of {
        true -> type_checker_core@type_check_ok();
        false -> do
            g: TypeCheckResult <- check_expr(branch.inner, "boolean", ext_ctx, world);
            case g.is_ok of {
                false -> g;
                true -> check_case_guard_invariant(branch, pi, scrutinee_type)
            }
        end
    }
}

fn check_one_case_branch(branch: Expr, scrutinee_type: string, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case branch.kind == 18 of {
        false -> type_checker_core@type_check_err("E2005", branch.location, "malformed case branch", "sect3");
        true -> do
            pi: CasePatternInfo <- type_checker_tuple_decompose_helpers@case_parse_pattern(branch.value);
            case pi.is_valid of {
                false -> type_checker_core@type_check_err("E2005", branch.location, "invalid or unsupported case pattern", "sect3");
                true -> do
                    pat_list_r: TypeCheckResult <- type_checker_lists@validate_list_type_declaration(pi.bind_type, branch.location);
                    case pat_list_r.is_ok of {
                        false -> pat_list_r;
                        true -> do
                            tail_list_r: TypeCheckResult <- type_checker_lists@validate_list_type_declaration(pi.list_tail_type, branch.location);
                            case tail_list_r.is_ok of {
                                false -> tail_list_r;
                                true -> case type_checker_tuple_decompose_helpers@case_pattern_matches_scrutinee(pi, scrutinee_type) of {
                                    false -> type_checker_core@type_check_err("E2005", branch.location, "case pattern does not match scrutinee type", "sect3");
                                    true -> do
                                        ext_ctx: TypeContext <- type_checker_tuple_decompose_helpers@case_extend_context_for_pattern(context, scrutinee_type, branch.value);
                                        guard_r: TypeCheckResult <- check_case_branch_guard(branch, pi, ext_ctx, scrutinee_type, world);
                                        case guard_r.is_ok of {
                                            false -> guard_r;
                                            true -> check_expr(branch.right_expr, expected_type, ext_ctx, world)
                                        }
                                    end
                                }
                            }
                        end
                    }
                end
            }
        end
    }
}

fn check_case_branch_list(branches: Expr, scrutinee_type: string, expected_type: string, context: TypeContext, case_loc: SourceLocation, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case branches.kind == -1 of {
        true -> type_checker_core@type_check_ok();
        false -> case branches.kind == 17 of {
            true -> do
                b: Expr <- branches.inner;
                rest: Expr <- branches.right_expr;
                r: TypeCheckResult <- check_one_case_branch(b, scrutinee_type, expected_type, context, world);
                case r.is_ok of {
                    false -> r;
                    true -> check_case_branch_list(rest, scrutinee_type, expected_type, context, case_loc, world)
                }
            end;
            false -> type_checker_core@type_check_err("E2005", case_loc, "malformed case branch list", "sect3")
        }
    }
}

fn check_case_boolean_exhaustive(branches: Expr, scrutinee_type: string, case_loc: SourceLocation) -> TypeCheckResult {
    case scrutinee_type == "boolean" of {
        false -> type_checker_core@type_check_ok();
        true -> do
            cov: CaseBoolCoverage <- type_checker_tuple_decompose_helpers@case_scan_bool_coverage(branches, scrutinee_type);
            case type_checker_tuple_decompose_helpers@case_bool_coverage_ok(cov) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2005", case_loc, "case on boolean must cover true and false or include a wildcard branch (_ : boolean)", "sect3")
            }
        end
    }
}

fn check_case_expression(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case expr.right_expr.kind == -1 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, "case expression must have at least one branch", "sect3");
        false -> do
            scrutinee_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
            case len(scrutinee_type) == 0 of {
                true -> type_checker_core@type_check_err("E2005", expr.location, "cannot infer type of case scrutinee", "sect3");
                false -> do
                    rscr: TypeCheckResult <- check_expr(expr.inner, scrutinee_type, context, world);
                    case rscr.is_ok of {
                        false -> rscr;
                        true -> do
                            branches_r: TypeCheckResult <- check_case_branch_list(expr.right_expr, scrutinee_type, expected_type, context, expr.location, world);
                            case branches_r.is_ok of {
                                false -> branches_r;
                                true -> check_case_boolean_exhaustive(expr.right_expr, scrutinee_type, expr.location)
                            }
                        end
                    }
                end
            }
        end
    }
}

// true/false as identifiers: lexer may emit identifier; treat as boolean literal (spec: boolean values)
fn is_true_or_false_identifier(expr: Expr) -> bool {
    case len(expr.name) of {
        4 -> case substring(expr.name, 0, 1) of {
            "t" -> case substring(expr.name, 1, 2) of {
                "r" -> case substring(expr.name, 2, 3) of {
                    "u" -> case substring(expr.name, 3, 4) of { "e" -> true; _: string -> false };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        5 -> case substring(expr.name, 0, 1) of {
            "f" -> case substring(expr.name, 1, 2) of {
                "a" -> case substring(expr.name, 2, 3) of {
                    "l" -> case substring(expr.name, 3, 4) of {
                        "s" -> case substring(expr.name, 4, 5) of { "e" -> true; _: string -> false };
                        _: string -> false
                    };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        _: int64 -> false
    }
}

// List literal (kind 20): value = full List[T, S] on root; inner/right_expr chain like tuple kind 9.
fn check_list_literal(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    lit_t: string <- case len(expr.value) > 0 of {
        true -> expr.value;
        false -> expected_type
    };
    case len(lit_t) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, "list literal requires a typed binding (name: List[T, S] <- [...])", "list");
        false -> do
            case type_checker_lists@list_types_compatible(expected_type, lit_t) of {
                false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("list literal type ", lit_t), " does not match expected "), expected_type), ""), "list");
                true -> do
                    (_ok: bool, elem_t: string, _: string) <- type_checker_lists@parse_list_type_params(lit_t);
                    case expr.inner.kind == -1 of {
                        true -> type_checker_core@type_check_ok();
                        false -> check_list_elem_tree(expr, elem_t, context, world)
                    }
                end
            }
        end
    }
}

fn check_list_elem_tree(expr: Expr, elem_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case expr.kind == 20 of {
        true -> do
            r1: TypeCheckResult <- check_expr(expr.inner, elem_type, context, world);
            case r1.is_ok of {
                false -> r1;
                true -> case expr.right_expr.kind == -1 of {
                    true -> type_checker_core@type_check_ok();
                    false -> check_list_elem_tree(expr.right_expr, elem_type, context, world)
                }
            }
        end;
        false -> check_expr(expr, elem_type, context, world)
    }
}

// Compiler-known list primitives (list_implementation_design.md §7): empty, length, prepend, remove_head, head.
fn check_list_primitive_call(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    (elem: string, space: string) <- type_checker_lists@parse_generic_ts(expr.value);
    case len(elem) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, concat(concat("list primitive ", expr.name), " requires explicit generic type arguments [T, S] or [T]"), "list");
        false -> do
            list_t: string <- type_checker_lists@format_list_type_from_parts(elem, space);
            case expr.name == "empty" of {
                true -> do
                    ac: int64 <- type_checker_lists@list_empty_effective_arg_count(expr);
                    case ac == 0 of {
                        false -> type_checker_core@type_check_err("E2005", expr.location, "empty expects 0 arguments", "list");
                        true -> case expected_type == "discard" of {
                            true -> type_checker_core@type_check_ok();
                            false -> case type_checker_lists@list_types_compatible(expected_type, list_t) of {
                                true -> type_checker_core@type_check_ok();
                                false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("empty returns ", list_t), ", expected "), expected_type), ""), "list")
                            }
                        }
                    }
                end;
                false -> case expr.name == "length" of {
                    true -> do
                        ac: int64 <- type_checker_lists@count_call_args_list(expr);
                        case ac == 1 of {
                            false -> type_checker_core@type_check_err("E2005", expr.location, "length expects 1 argument", "list");
                            true -> do
                                r1: TypeCheckResult <- check_expr(expr.inner, list_t, context, world);
                                case r1.is_ok of {
                                    false -> r1;
                                    true -> case expected_type == "discard" of {
                                        true -> type_checker_core@type_check_ok();
                                        false -> case expected_type == "int64" of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat("length returns int64, expected ", expected_type), ""), "list")
                                        }
                                    }
                                }
                            end
                        }
                    end;
                    false -> case expr.name == "prepend" of {
                        true -> do
                            ac: int64 <- type_checker_lists@count_call_args_list(expr);
                            case ac == 2 of {
                                false -> type_checker_core@type_check_err("E2005", expr.location, "prepend expects 2 arguments (element, list)", "list");
                                true -> do
                                    r1: TypeCheckResult <- check_expr(expr.inner, elem, context, world);
                                    case r1.is_ok of {
                                        false -> r1;
                                        true -> do
                                            r2: TypeCheckResult <- check_expr(call_second_arg_expr(expr), list_t, context, world);
                                            case r2.is_ok of {
                                                false -> r2;
                                                true -> case expected_type == "discard" of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> case type_checker_lists@list_types_compatible(expected_type, list_t) of {
                                                        true -> type_checker_core@type_check_ok();
                                                        false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("prepend returns ", list_t), ", expected "), expected_type), ""), "list")
                                                    }
                                                }
                                            }
                                        end
                                    }
                                end
                            }
                        end;
                        false -> case expr.name == "remove_head" of {
                            true -> do
                                ac: int64 <- type_checker_lists@count_call_args_list(expr);
                                case ac == 1 of {
                                    false -> type_checker_core@type_check_err("E2005", expr.location, "remove_head expects 1 argument", "list");
                                    true -> do
                                        r1: TypeCheckResult <- check_expr(expr.inner, list_t, context, world);
                                        case r1.is_ok of {
                                            false -> r1;
                                            true -> case expected_type == "discard" of {
                                                true -> type_checker_core@type_check_ok();
                                                false -> case type_checker_lists@list_types_compatible(expected_type, list_t) of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("remove_head returns ", list_t), ", expected "), expected_type), ""), "list")
                                                }
                                            }
                                        }
                                    end
                                }
                            end;
                            false -> case expr.name == "head" of {
                                true -> do
                                    ac: int64 <- type_checker_lists@count_call_args_list(expr);
                                    case ac == 1 of {
                                        false -> type_checker_core@type_check_err("E2005", expr.location, "head expects 1 argument", "list");
                                        true -> do
                                            r1: TypeCheckResult <- check_expr(expr.inner, list_t, context, world);
                                            case r1.is_ok of {
                                                false -> r1;
                                                true -> case expected_type == "discard" of {
                                                    true -> type_checker_core@type_check_ok();
                                                    false -> case type_checker_lists@types_equal_strip(expected_type, elem) of {
                                                        true -> type_checker_core@type_check_ok();
                                                        false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("head returns ", elem), ", expected "), expected_type), ""), "list")
                                                    }
                                                }
                                            }
                                        end
                                    }
                                end;
                                false -> type_checker_core@type_check_err("E2005", expr.location, concat("unknown list primitive: ", expr.name), "list")
                            }
                        }
                    }
                }
            }
        end
    }
}

fn count_struct_chain_nodes(expr: Expr) -> int64 {
    case expr.kind == -1 or expr.kind == 999 of {
        true -> 0;
        false -> case expr.kind == 21 of {
            true -> 1 + count_struct_chain_nodes(expr.right_expr);
            false -> 0
        }
    }
}

fn check_struct_literal_discard_chain(expr: Expr, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case expr.kind == -1 or expr.kind == 999 of {
        true -> type_checker_core@type_check_ok();
        false -> case expr.kind == 21 of {
            false -> type_checker_core@type_check_err("E2005", expr.location, "ill-formed struct literal (expected kind 21)", "sect3");
            true -> do
                it: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
                case len(it) == 0 of {
                    true -> type_checker_core@type_check_err("E2005", expr.location, "cannot infer field expression type in struct literal", "sect3");
                    false -> do
                        r1: TypeCheckResult <- check_expr(expr.inner, it, context, world);
                        case r1.is_ok of {
                            false -> r1;
                            true -> check_struct_literal_discard_chain(expr.right_expr, context, world)
                        }
                    end
                }
            end
        }
    }
}

fn check_struct_literal_chain(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case expr.kind == -1 or expr.kind == 999 of {
        true -> type_checker_core@type_check_ok();
        false -> case expr.kind == 21 of {
            false -> type_checker_core@type_check_err("E2005", expr.location, "ill-formed struct literal (expected kind 21)", "sect3");
            true -> do
                ft: string <- type_checker_record_types@find_field_type_in_record(expected_type, expr.name);
                case len(ft) == 0 of {
                    true -> type_checker_core@type_check_err("E2003", expr.location, concat(concat("field ", expr.name), " is not part of the record type"), "sect3");
                    false -> do
                        r1: TypeCheckResult <- check_expr(expr.inner, ft, context, world);
                        case r1.is_ok of {
                            false -> r1;
                            true -> check_struct_literal_chain(expr.right_expr, expected_type, context, world)
                        }
                    end
                }
            end
        }
    }
}

fn check_struct_literal_expr(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case expected_type == "discard" of {
        true -> check_struct_literal_discard_chain(expr, context, world);
        false -> do
            exp_rec: string <- type_checker_record_types@expand_named_topology_type(expected_type);
            rec_expected: string <- case len(exp_rec) > 0 of { true -> exp_rec; false -> expected_type };
            case type_checker_record_types@record_type_starts(rec_expected) of {
                false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat("expected record type, got ", expected_type), ""), "sect3");
                true -> do
                    n_type: int64 <- type_checker_record_types@count_record_fields(rec_expected);
                    n_lit: int64 <- count_struct_chain_nodes(expr);
                    case n_type == n_lit of {
                        false -> type_checker_core@type_check_err("E2003", expr.location, "struct literal field count does not match record type", "sect3");
                        true -> check_struct_literal_chain(expr, rec_expected, context, world)
                    }
                end
            }
        end
    }
}

fn check_field_access_expr(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    base_t: string <- type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context);
    case len(base_t) == 0 of {
        true -> type_checker_core@type_check_err("E2005", expr.location, "cannot infer type of field access base", "sect3");
        false -> do
            exp_base: string <- type_checker_record_types@expand_named_topology_type(base_t);
            rec_base: string <- case len(exp_base) > 0 of { true -> exp_base; false -> base_t };
            case type_checker_record_types@record_type_starts(rec_base) of {
                false -> type_checker_core@type_check_err("E2005", expr.location, concat(concat("field access base must be record or topology type (cpu_topology, core_info, ...), got ", base_t), ""), "sect3");
                true -> do
                    ft: string <- type_checker_record_types@find_field_type_in_record(rec_base, expr.name);
                    case len(ft) == 0 of {
                        true -> type_checker_core@type_check_err("E2005", expr.location, concat(concat("no field ", expr.name), " on record type"), "sect3");
                        false -> do
                            rbase: TypeCheckResult <- check_expr(expr.inner, base_t, context, world);
                            case rbase.is_ok of {
                                false -> rbase;
                                true -> case expected_type == "discard" of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> case type_checker_tuple_decompose_helpers@types_equal(ft, expected_type) of {
                                        true -> type_checker_core@type_check_ok();
                                        false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat(concat(concat("field has type ", ft), ", expected "), expected_type), ""), "sect3")
                                    }
                                }
                            }
                        end
                    }
                end
            }
        end
    }
}

// Dispatch on Expr kind: 0=literal, 1=identifier, 2=parenthesized (recurse), 3=binary op, 4=call, 5=atom literal, 6=let binding, 7=boolean literal, 8=string literal, 12=unary minus (forbidden); 20=list literal; 21=struct literal; 22=field access; 991=lambda
fn check_expr(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case expr.kind of {
        0 -> type_checker_expressions_literals@check_expr(expr, expected_type, context, world);
        1 -> case is_true_or_false_identifier(expr) of {
            true -> boolean_type_checker_expressions@check_expr(expr, expected_type, context, world);
            false -> type_checker_expressions_identifiers@check_expr(expr, expected_type, context, world)
        };
        2 -> check_expr(expr.inner, expected_type, context, world);
        3 -> check_binary_op(expr, expected_type, context, world);
        4 -> check_call(expr, expected_type, context, world);
        5 -> type_checker_expressions_atoms@check_expr(expr, expected_type, context, world);
        6 -> check_let(expr, expected_type, context, world);
        7 -> boolean_type_checker_expressions@check_expr(expr, expected_type, context, world);
        8 -> case len(expected_type) == 6 and substring(expected_type, 0, 1) == "s" and substring(expected_type, 1, 2) == "t" and substring(expected_type, 2, 3) == "r" and substring(expected_type, 3, 4) == "i" and substring(expected_type, 4, 5) == "n" and substring(expected_type, 5, 6) == "g" of {
            true -> type_checker_core@type_check_ok();
            false -> case len(expected_type) == 7 and substring(expected_type, 0, 1) == "d" and substring(expected_type, 1, 2) == "i" and substring(expected_type, 2, 3) == "s" and substring(expected_type, 3, 4) == "c" and substring(expected_type, 4, 5) == "a" and substring(expected_type, 5, 6) == "r" and substring(expected_type, 6, 7) == "d" of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2001", expr.location, concat("string literal requires string type, got ", case expected_type of { "" -> "[EMPTY]"; _: string -> expected_type }), "sect6")
            }
        };
        9 -> check_tuple_literal_inline(expr, expected_type, context, world);
        10 -> check_tuple_decompose(expr, expected_type, context, world);
        11 -> check_sequence_block(expr, expected_type, context, world);
        12 -> check_unary_minus_forbidden(expr, context);
        13 -> check_case_expression(expr, expected_type, context, world);
        19 -> check_if_expression(expr, expected_type, context, world);
        20 -> check_list_literal(expr, expected_type, context, world);
        21 -> check_struct_literal_expr(expr, expected_type, context, world);
        22 -> check_field_access_expr(expr, expected_type, context, world);
        991 -> check_lambda_expression(expr, expected_type, context, world);
        996 -> type_checker_core@type_check_err("E1040", expr.location, "expected ';' after this statement before the next statement", "sect3");
        997 -> type_checker_core@type_check_err("E1041", expr.location, "the last expression in this block must not be followed by ';'", "sect3");
        _: int64 -> type_checker_core@type_check_ok()
    }
}

fn check_if_expression(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    rc: TypeCheckResult <- check_expr(expr.inner, "boolean", context, world);
    case rc.is_ok of {
        false -> rc;
        true -> do
            rt: TypeCheckResult <- check_expr(expr.right_expr.inner, expected_type, context, world);
            case rt.is_ok of {
                false -> rt;
                true -> case expr.right_expr.right_expr.kind < 0 of {
                    true -> type_checker_core@type_check_ok();
                    false -> check_expr(expr.right_expr.right_expr, expected_type, context, world)
                }
            }
        end
    }
}

// Tuple decomposition (kind 10): (pattern) <- rhs; body
// Structured pattern_bindings from AST. Bare identifiers get types from the RHS tuple; explicit `ident : type` must agree with RHS.
fn check_tuple_decompose(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    rhs_type: string <- case expr.inner.kind == 11 of {
        true -> type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner.right_expr, context_after_sequence_body(expr.inner.inner, context));
        false -> type_checker_tuple_decompose_helpers@infer_expr_type(expr.inner, context)
    };
    case len(rhs_type) < 2 or substring(rhs_type, 0, 1) != "(" of {
        true -> type_checker_core@type_check_err("E2005", expr.location, concat("tuple decomposition RHS must have tuple type, got ", case len(rhs_type) == 0 of { true -> "[unknown]"; false -> rhs_type }), "sect4");
        false -> do
            bindings: ListTupleDecomposeBinding <- expr.pattern_bindings;
            rhs_trimmed: string <- type_checker_tuple_decompose_helpers@tuple_trim(rhs_type);
            tuple_for_fill: string <- case len(expr.value) > 0 of {
                true -> type_checker_tuple_decompose_helpers@tuple_trim(expr.value);
                false -> rhs_trimmed
            };
            filled: ListTupleDecomposeBinding <- type_checker_tuple_decompose_helpers@fill_empty_binding_types_from_rhs(bindings, tuple_for_fill);
            valid_result: TypeCheckResult <- type_checker_tuple_decompose_helpers@pattern_bindings_valid(filled, expr.location);
            case valid_result.is_ok of {
                false -> valid_result;
                true -> check_tuple_decompose_after_valid(expr, expected_type, context, rhs_type, filled, world)
            }
        end
    }
}

fn check_tuple_decompose_after_valid(expr: Expr, expected_type: string, context: TypeContext, rhs_type: string, bindings: ListTupleDecomposeBinding, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    match_result: TypeCheckResult <- type_checker_tuple_decompose_helpers@pattern_types_match_rhs(bindings, rhs_type, expr.location);
    case match_result.is_ok of {
        false -> match_result;
        true -> do
            rhs_result: TypeCheckResult <- check_expr(expr.inner, rhs_type, context, world);
            case rhs_result.is_ok of {
                false -> rhs_result;
                true -> do
                    extended_context: TypeContext <- type_checker_tuple_decompose_helpers@add_bindings_to_context(context, bindings);
                    check_expr(expr.right_expr, expected_type, extended_context, world)
                end
            }
        end
    }
}
