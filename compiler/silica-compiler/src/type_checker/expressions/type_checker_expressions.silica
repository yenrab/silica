// Phase E e3b2: start_child(child_spec) -> actor_ref — supervisor-only dynamic child spawn (§15.4.13.3).
fn check_start_child_call(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case type_checker_expressions_actors@type_context_has_behavior_marker(context) of {
        false -> type_checker_core@type_check_err("E2091", expr.location, "start_child may only be called from within an actor behavior function (supervisors plan Phase E e3b2, spec sect15.4.13.3)", "sect15.4.13.3");
        true -> do
            ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
            case ac == 1 of {
                false -> type_checker_core@type_check_err("E2005", expr.location, "start_child expects 1 argument: (spec: child_spec record)", "sect15.4.13.3");
                true -> do
                    r0: TypeCheckResult <- check_expr(expr.inner, "discard", context, world);
                    case r0.is_ok of {
                        false -> r0;
                        true -> do
                            rw: TypeCheckResult <- type_checker_supervisor@supervisor_walk_validate_child_spec_agent_type_atoms(expr.inner);
                            case rw.is_ok of {
                                false -> rw;
                                true -> case expected_type == "actor_ref" or expected_type == "discard" of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2003", expr.location, concat("start_child returns actor_ref, expected ", expected_type), "sect15.4.13.3")
                                }
                            }
                        end
                    }
                end
            }
        end
    }
}

fn check_actor_message_satisfies_am(expr: Expr, msg_e: Expr, context: TypeContext) -> TypeCheckResult {
    has_postfix: bool <- type_checker_expressions_actors@call_has_impl_am_marker(expr);
    case has_postfix of {
        true -> type_checker_core@type_check_ok();
        false -> type_checker_core@type_check_err("E2005", msg_e.location, "message must satisfy ActorMessage (§16.3.2); use `expr impl ActorMessage {}`", "sect16")
    }
}

// cast/send/call accept actor_ref or dangerous_actor_ref as the target (same runtime handle; distinct types at bind sites).
fn check_actor_message_target(ref_e: Expr, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    ref_type: string <- type_checker_tuple_decompose_helpers@infer_expr_type(ref_e, context);
    case ref_type == "actor_ref" or ref_type == "dangerous_actor_ref" of {
        true -> type_checker_core@type_check_ok();
        false -> check_expr(ref_e, "actor_ref", context, world)
    }
}

fn check_actor_call_builtin(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 of {
        false -> type_checker_core@type_check_err("E2005", expr.location, "call expects 2 arguments: (actor_ref, message) §16.1.1", "sect16");
        true -> do
            r0: TypeCheckResult <- check_actor_message_target(expr.inner, context, world);
            case r0.is_ok of {
                false -> r0;
                true -> do
                    beh_type: string <- type_checker_expressions_actors@lookup_actor_behavior_type(expr, context);
                    msg_expected: string <- case len(beh_type) > 0 of {
                        true -> type_checker_expressions_actors@parse_behavior_msg_param_type(beh_type);
                        false -> "discard"
                    };
                    msg_e: Expr <- call_second_arg_expr(expr);
                    r1: TypeCheckResult <- check_expr(msg_e, msg_expected, context, world);
                    case r1.is_ok of {
                        false -> r1;
                        true -> do
                            am_check: TypeCheckResult <- check_actor_message_satisfies_am(expr, msg_e, context);
                            case am_check.is_ok of {
                                false -> am_check;
                                true -> do
                                    reply_type: string <- case len(beh_type) > 0 of {
                                        true -> type_checker_expressions_actors@parse_behavior_reply_type(beh_type);
                                        false -> ""
                                    };
                                    case len(reply_type) > 0 of {
                                        true -> case expected_type == reply_type or expected_type == "discard" of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> type_checker_core@type_check_err("E2003", expr.location, concat(concat("call returns ", reply_type), concat(", expected ", expected_type)), "sect16")
                                        };
                                        false -> type_checker_core@type_check_ok()
                                    }
                                end
                            }
                        end
                    }
                end
            }
        end
    }
}

fn check_actor_call_registered_builtin(expr: Expr, expected_type: string, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    ac: int64 <- type_checker_expressions_actors@count_chain_args(expr);
    case ac == 2 of {
        false -> type_checker_core@type_check_err("E2005", expr.location, "call_registered expects 2 arguments: (registered_name: atom, message) §16.1.1", "sect16");
        true -> do
            r0: TypeCheckResult <- check_expr(expr.inner, "atom", context, world);
            case r0.is_ok of {
                false -> r0;
                true -> do
                    msg_e: Expr <- call_second_arg_expr(expr);
                    r1: TypeCheckResult <- check_expr(msg_e, "discard", context, world);
                    case r1.is_ok of {
                        false -> r1;
                        true -> check_actor_message_satisfies_am(expr, msg_e, context)
                    }
                end
            }
        end
    }
}

