// Capability: check identifier expression (Expr kind 1)
// Resolves name in symbol table, verifies type matches expected

use parser_ast;
use type_checker_core;
use type_checker_lists;
use type_checker_record_types;
use type_checker_tuple_decompose_helpers;

export check_expr/3;

// Check Expr kind 1 (identifier). Lookup in context.env, verify matches expected_type.
// Note: "true"/"false" identifiers are routed to boolean checker by type_checker_expressions dispatcher
fn check_expr(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult {
    case expected_type == "discard" of {
        true -> case expr.name == "performance_cores" or expr.name == "efficiency_cores" of {
            true -> type_checker_core@type_check_ok();
            false -> do
                (found: bool, _: string) <- type_checker_core@lookup_symbol_found(context.env, expr.name);
                case found of { true -> type_checker_core@type_check_ok(); false -> type_checker_core@type_check_err("E2002", expr.location, concat("undefined identifier: ", expr.name), "sect6") }
            end
        };
        false -> do
            (found: bool, resolved_type: string) <- type_checker_core@lookup_symbol_found(context.env, expr.name);
            case found of {
                false -> type_checker_core@type_check_err("E2002", expr.location, concat("undefined identifier: ", expr.name), "sect6");
                true -> case resolved_type of {
                    "int64" -> case expected_type of { "int64" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "int32" -> case expected_type of { "int32" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "int16" -> case expected_type of { "int16" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "int8" -> case expected_type of { "int8" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "uint64" -> case expected_type of { "uint64" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "uint32" -> case expected_type of { "uint32" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "uint16" -> case expected_type of { "uint16" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "uint8" -> case expected_type of { "uint8" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "boolean" -> case expected_type of { "boolean" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    "unit" -> type_checker_core@type_check_err("E2006", expr.location, "unit is not a valid type for variables or parameters", "sect4");
                    "atom" -> case expected_type of { "atom" -> type_checker_core@type_check_ok(); _: string -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6") };
                    _: string -> case resolved_type == expected_type of {
                        true -> type_checker_core@type_check_ok();
                        false -> case type_checker_record_types@record_type_starts(resolved_type) and type_checker_record_types@record_type_starts(expected_type) of {
                            true -> case type_checker_tuple_decompose_helpers@types_equal(resolved_type, expected_type) of {
                                true -> type_checker_core@type_check_ok();
                                false -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6")
                            };
                            false -> case type_checker_lists@list_types_compatible(resolved_type, expected_type) of {
                                true -> type_checker_core@type_check_ok();
                                false -> type_checker_core@type_check_err("E2003", expr.location, concat("type mismatch: ", expr.name), "sect6")
                            }
                        }
                    }
                }
            }
        end
    }
}
