// Capability: check atom literal expression (Expr kind 5)
// Verifies atom literal type matches expected return type

use parser_ast;
use type_checker_core;

export check_expr/3;

// Check Expr kind 5 (atom literal). Expected type is function return type (e.g. "atom").
// Atom literals have type atom; must match expected.
fn check_expr(expr: Expr, expected_type: string, context: TypeContext) -> TypeCheckResult {
    case expected_type of {
        "atom" -> type_checker_core@type_check_ok();
        "discard" -> type_checker_core@type_check_ok();
        _: string -> type_checker_core@type_check_err("E2001", expr.location, concat("atom literal requires atom return type, got ", case expected_type of { "" -> "[EMPTY]"; _: string -> expected_type }), "sect6")
    }
}
