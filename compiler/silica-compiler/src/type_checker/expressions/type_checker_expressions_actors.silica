// Actor / concurrency builtins (silica-specification ?4.5 actor_ref, ?15 spawn, ?16 call/cast/send, self).
// String-only helpers and spawn signature validation; call sites use type_checker_expressions@check_expr.

use parser_ast;
use type_checker_core;

export count_chain_args/1;
export trim_leading_actor/1;
export behavior_return_is_call_only/1;
export behavior_return_is_cast_only/1;
export validate_spawn_behavior_function_type/3;
export parse_behavior_state_param_type/1;
export parse_behavior_reply_type/1;
export parse_behavior_msg_param_type/1;
export lookup_actor_behavior_type/2;
export spawn_init_expr/1;
export spawn_behavior_expr/1;
export spawn_placement_expr/1;
export call_has_impl_am_marker/1;
export supervisor_reply_record_type/0;
export check_behavior_no_self_recursion/1;
export is_actor_behavior_declaration/1;
export tc_in_behavior_marker_name/0;
export type_context_has_behavior_marker/1;
export tc_in_main_marker_name/0;
export type_context_has_main_marker/1;

// Mirrors count_call_args_user_call in type_checker_expressions.silica (call arg chain encoding).
fn count_chain_args(expr: Expr) -> int64 {
    case expr.inner.kind == -1 of {
        true -> 0;
        false -> case expr.right_expr.kind == -1 of {
            true -> 1;
            false -> case expr.right_expr.kind == 4 of {
                true -> 1 + count_chain_args(expr.right_expr);
                false -> 2
            }
        }
    }
}

fn trim_leading_actor_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_leading_actor_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

fn trim_leading_actor(s: string) -> string {
    trim_leading_actor_from(s, 0)
}

// ?15.1.1 / ?15.1.2: behavior returns (:reply, Reply, State) or (:no_reply, State).
// Tuple type strings preserve atom lexemes (e.g. :reply, :no_reply). Legacy checks also accept (atom, R, S) / (atom, S).
// Distinguish by arity: 3-element reply tuple = :reply; 2-element = :no_reply.
fn behavior_return_is_call_only(return_type: string) -> bool {
    t: string <- trim_leading_actor(return_type);
    case len(t) >= 8 of {
        false -> false;
        true -> substring(t, 0, 8) == "(:reply," or behavior_return_is_atom_3_tuple(t)
    }
}

fn behavior_return_is_atom_3_tuple(t: string) -> bool {
    case len(t) >= 6 of {
        false -> false;
        true -> case substring(t, 0, 6) == "(atom," of {
            true -> count_top_level_commas_actor(t, 1, 0, 0) == 2;
            false -> false
        }
    }
}

fn behavior_return_is_atom_2_tuple(t: string) -> bool {
    case len(t) >= 6 of {
        false -> false;
        true -> case substring(t, 0, 6) == "(atom," of {
            true -> count_top_level_commas_actor(t, 1, 0, 0) == 1;
            false -> false
        }
    }
}

fn count_top_level_commas_actor(s: string, i: int64, depth: int64, count: int64) -> int64 {
    case i >= len(s) of {
        true -> count;
        false -> case substring(s, i, i + 1) == "(" of {
            true -> count_top_level_commas_actor(s, i + 1, depth + 1, count);
            false -> case substring(s, i, i + 1) == ")" of {
                true -> case depth == 0 of {
                    true -> count;
                    false -> count_top_level_commas_actor(s, i + 1, depth - 1, count)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> count_top_level_commas_actor(s, i + 1, depth, count + 1);
                        false -> count_top_level_commas_actor(s, i + 1, depth, count)
                    };
                    false -> count_top_level_commas_actor(s, i + 1, depth, count)
                }
            }
        }
    }
}

fn behavior_return_is_cast_only(return_type: string) -> bool {
    t: string <- trim_leading_actor(return_type);
    case len(t) >= 11 of {
        false -> behavior_return_is_atom_2_tuple(t);
        true -> substring(t, 0, 11) == "(:no_reply," or behavior_return_is_atom_2_tuple(t)
    }
}

fn find_arrow_pos_actor(s: string, i: int64) -> int64 {
    case i + 4 > len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 4) == " -> " of {
            true -> i;
            false -> find_arrow_pos_actor(s, i + 1)
        }
    }
}

fn get_params_inner_actor(func_type: string) -> string {
    arrow_pos: int64 <- find_arrow_pos_actor(func_type, 0);
    case arrow_pos < 0 of {
        true -> "";
        false -> do
            params_part: string <- substring(func_type, 0, arrow_pos);
            case len(params_part) < 2 of {
                true -> "";
                false -> trim_leading_actor(substring(params_part, 1, len(params_part) - 1))
            }
        end
    }
}

fn find_top_level_comma_actor(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) == "(" or substring(s, i, i + 1) == "[" or substring(s, i, i + 1) == "{" of {
            true -> find_top_level_comma_actor(s, i + 1, depth + 1);
            false -> case substring(s, i, i + 1) == ")" or substring(s, i, i + 1) == "]" or substring(s, i, i + 1) == "}" of {
                true -> case depth <= 0 of {
                    true -> len(s);
                    false -> find_top_level_comma_actor(s, i + 1, depth - 1)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> i;
                        false -> find_top_level_comma_actor(s, i + 1, depth)
                    };
                    false -> find_top_level_comma_actor(s, i + 1, depth)
                }
            }
        }
    }
}

fn get_first_param_actor(params_inner: string) -> (string, string) {
    case len(params_inner) == 0 of {
        true -> ("", "");
        false -> do
            comma_pos: int64 <- find_top_level_comma_actor(params_inner, 0, 0);
            case comma_pos >= len(params_inner) of {
                true -> (trim_leading_actor(params_inner), "");
                false -> do
                    first: string <- trim_leading_actor(substring(params_inner, 0, comma_pos));
                    rest: string <- trim_leading_actor(substring(params_inner, comma_pos + 1, len(params_inner)));
                    (first, rest)
                end
            }
        end
    }
}

fn parse_function_return_actor(func_type: string) -> string {
    arrow_pos: int64 <- find_arrow_pos_actor(func_type, 0);
    case arrow_pos < 0 of {
        true -> "";
        false -> trim_leading_actor(substring(func_type, arrow_pos + 4, len(func_type)))
    }
}

// Second parameter type is the actor state (initial_state must match it). ?15.1.1.
fn parse_behavior_state_param_type(func_type: string) -> string {
    inner: string <- get_params_inner_actor(func_type);
    (_msg: string, after_msg: string) <- get_first_param_actor(inner);
    (state_t: string, tail: string) <- get_first_param_actor(after_msg);
    case len(trim_leading_actor(tail)) > 0 of {
        true -> "";
        false -> trim_leading_actor(state_t)
    }
}

// ?16: Extract the message parameter type (first param) from a behavior function type.
fn parse_behavior_msg_param_type(func_type: string) -> string {
    inner: string <- get_params_inner_actor(func_type);
    (msg_t: string, _rest: string) <- get_first_param_actor(inner);
    msg_t
}

fn validate_spawn_behavior_function_type(builtin_label: string, func_type: string, location: SourceLocation) -> TypeCheckResult {
    arrow_pos: int64 <- find_arrow_pos_actor(func_type, 0);
    case arrow_pos < 0 of {
        true -> type_checker_core@type_check_err("E2005", location, concat(concat(builtin_label, ": behavior must be a function type (Msg, State) -> (:reply, ...) or (:no_reply, ...)"), " ?15.1.1"), "sect15");
        false -> do
            inner: string <- get_params_inner_actor(func_type);
            (_msg_t: string, after_msg: string) <- get_first_param_actor(inner);
            case len(trim_leading_actor(after_msg)) == 0 of {
                true -> type_checker_core@type_check_err("E2005", location, concat(concat(builtin_label, ": behavior must take exactly two parameters (message, state)"), " ?15.1.1"), "sect15");
                false -> do
                    (_state_t: string, tail: string) <- get_first_param_actor(after_msg);
                    case len(trim_leading_actor(tail)) > 0 of {
                        true -> type_checker_core@type_check_err("E2005", location, concat(concat(builtin_label, ": behavior must take exactly two parameters (message, state)"), " ?15.1.1"), "sect15");
                        false -> do
                            ret: string <- parse_function_return_actor(func_type);
                            case behavior_return_is_call_only(ret) of {
                                true -> type_checker_core@type_check_ok();
                                false -> case behavior_return_is_cast_only(ret) of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> type_checker_core@type_check_err("E2005", location, concat(builtin_label, ": behavior return type must be (:reply, Reply, State) or (:no_reply, State) per ?15.1.2"), "sect15")
                                }
                            }
                        end
                    }
                end
            }
        end
    }
}

// spawn(init, behavior): inner = init, right_expr.kind==4, right_expr.inner = behavior (when 2 args).
fn spawn_init_expr(call_expr: Expr) -> Expr {
    call_expr.inner
}

fn spawn_behavior_expr(call_expr: Expr) -> Expr {
    call_expr.right_expr.inner
}

// Third argument when present: call_expr.right_expr.right_expr.inner
fn spawn_placement_expr(call_expr: Expr) -> Expr {
    call_expr.right_expr.right_expr.inner
}

// ?16.3.2: Check if a call's message argument has the postfix `impl ActorMessage {}` marker.
// The parser stores "AM" in the value field of the kind-4 pair node holding the message argument.
fn call_has_impl_am_marker(call_expr: Expr) -> bool {
    case call_expr.right_expr.kind == 4 of {
        true -> call_expr.right_expr.value == "AM";
        false -> false
    }
}

fn supervisor_reply_record_type() -> string {
    "{ tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: atom, child: actor_ref, restart: :permanent | :temporary | :transient },mem(normal)], count: int64, child_info: { id: atom, agent_type: atom, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom }"
}

// Look up the behavior function type for an actor_ref used in call/cast/send.
// At spawn, the type checker stores __actor_beh__<var> -> behavior_type in the env.
fn lookup_actor_behavior_type(call_expr: Expr, context: TypeContext) -> string {
    ref_e: Expr <- call_expr.inner;
    case ref_e.kind == 1 of {
        true -> do
            key: string <- concat("__actor_beh__", ref_e.name);
            (found: bool, beh_type: string) <- type_checker_core@lookup_symbol_found(context.env, key);
            case found of { true -> beh_type; false -> "" }
        end;
        false -> ""
    }
}

// ?16.1.1: Extract Reply type from behavior's (:reply, Reply, State) return.
fn parse_behavior_reply_type(func_type: string) -> string {
    ret: string <- parse_function_return_actor(func_type);
    t: string <- trim_leading_actor(ret);
    case behavior_return_is_call_only(t) of {
        false -> "";
        true -> do
            inner: string <- case len(t) >= 2 of {
                true -> substring(t, 1, len(t) - 1);
                false -> ""
            };
            case len(inner) == 0 of {
                true -> "";
                false -> do
                    first_comma: int64 <- find_top_level_comma_actor(inner, 0, 0);
                    case first_comma >= len(inner) of {
                        true -> "";
                        false -> do
                            after_first: string <- trim_leading_actor(substring(inner, first_comma + 1, len(inner)));
                            second_comma: int64 <- find_top_level_comma_actor(after_first, 0, 0);
                            case second_comma >= len(after_first) of {
                                true -> "";
                                false -> trim_leading_actor(substring(after_first, 0, second_comma))
                            }
                        end
                    }
                end
            }
        end
    }
}

// ?15.1.2: Behavior functions must not call themselves; the runtime owns the message loop.
fn body_has_self_call(e: Expr, name: string) -> bool {
    case e.kind < 0 of {
        true -> false;
        false -> case e.kind == 4 and e.name == name of {
            true -> true;
            false -> case body_has_self_call(e.inner, name) of {
                true -> true;
                false -> body_has_self_call(e.right_expr, name)
            }
        }
    }
}

fn check_behavior_no_self_recursion(decl: Declaration) -> TypeCheckResult {
    is_behavior: bool <- behavior_return_is_call_only(decl.return_type_name) or behavior_return_is_cast_only(decl.return_type_name);
    case is_behavior of {
        false -> type_checker_core@type_check_ok();
        true -> case body_has_self_call(decl.body, decl.name) of {
            true -> type_checker_core@type_check_err("E2005", decl.location, concat(concat("behavior function '", decl.name), "' must not be recursive (?15.1.2); the actor runtime owns the message loop"), "sect15");
            false -> type_checker_core@type_check_ok()
        }
    }
}

// Two-parameter function with behavior return tuple (?15.1.1–?15.1.2): body may use
// spawn_linked, link, monitor, demonitor (§15.4.8.3–§15.4.8.7; supervisors plan Phase D/G).
fn is_actor_behavior_declaration(decl: Declaration) -> bool {
    behavior_return_is_call_only(decl.return_type_name) or behavior_return_is_cast_only(decl.return_type_name)
}

// Type-checker-only env marker (not a language keyword); type_checker_declarations_functions adds it while checking behavior bodies.
fn tc_in_behavior_marker_name() -> string {
    "__silica_tc_in_behavior"
}

fn type_context_has_behavior_marker(ctx: TypeContext) -> bool {
    (found: bool, _: string) <- type_checker_core@lookup_symbol_found(ctx.env, tc_in_behavior_marker_name());
    found
}

// supervisors plan Phase I: wait_for_exit/0 is only legal in main's body — env marker during main type-check (like behavior).
fn tc_in_main_marker_name() -> string {
    "__silica_tc_in_main"
}

fn type_context_has_main_marker(ctx: TypeContext) -> bool {
    (found: bool, _: string) <- type_checker_core@lookup_symbol_found(ctx.env, tc_in_main_marker_name());
    found
}
