// Capability: check integer literal expression (Expr kind 0)
// Verifies literal type matches expected return type

use parser_ast;
use type_checker_core;
use type_checker_traits;
use type_checker_tuple_decompose_helpers;

export check_expr/4;

fn check_expr(expr: Expr, expected_type: int64, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult {
    // Exact char/string match only — type_id_eq_or_discard would treat discard as char/string
    // and reject numeric literals under discard (e.g. spawn_registered_supervisor init state).
    case type_checker_core@types_equal_type_ids(expected_type, type_checker_core@context_tid_char(context)) of {
        true -> case len(expr.value) >= 1 and substring(expr.value, 0, 1) == "'" of {
            true -> type_checker_core@type_check_ok();
            false -> type_checker_core@type_check_err("E2001", expr.location, "char literal required, got numeric literal", "sect6")
        };
        false -> case type_checker_core@types_equal_type_ids(expected_type, type_checker_core@context_tid_string(context)) of {
            true -> case len(expr.value) >= 1 and substring(expr.value, 0, 1) == "\"" of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2001", expr.location, "string literal required, got numeric literal", "sect6")
            };
            false -> case type_checker_core@type_id_accepts_numeric_literal(context, expected_type) of {
                true -> type_checker_core@type_check_ok();
                false -> case expr.value == ")" of {
                    true -> type_checker_core@type_check_ok();
                    false -> do
                        lit_ty: string <- type_checker_tuple_decompose_helpers@infer_literal_type(expr.value);
                        exp_surface: string <- type_checker_core@type_id_to_surface(context, expected_type);
                        case type_checker_traits@actual_type_satisfies_trait_expectation(lit_ty, exp_surface, world) of {
                            true -> type_checker_core@type_check_ok();
                            false -> type_checker_core@type_check_err("E2001", expr.location, concat("literal requires integer or float return type, got ", exp_surface), "sect6")
                        }
                    end
                }
            }
        }
    }
}
