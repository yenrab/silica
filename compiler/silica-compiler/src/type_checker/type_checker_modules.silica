// Cross-module type checking: use (§19.3), export (§19.2), explicit module (§19.1), import conflicts (§19.3.3).
// Caller passes every other compilation unit in `world`. `current_module` is this file's module name (filename stem), or "" to skip checks.

use parser_ast;
use type_checker_core;
use type_checker_declarations_functions;
use type_checker_failure_reporter;
use type_checker_supervisor;
use type_checker_callee_env;

export empty_named_program_list/0;
export cons_named_program/3;
export type_check_program_with_modules/4;
export type_check_program_with_modules_outcome/4;
export type_check_program_with_modules_world_bundle/4;

struct ModuleExportMark {
    export_key: string,
    from_module: string
}

struct ListModuleExportMark {
    is_nil: bool,
    head: ModuleExportMark,
    tail: ListModuleExportMark
}

fn empty_named_program_list() -> ListNamedProgram {
    parser_ast@empty_named_program_list()
}

fn cons_named_program(name: string, prog: Program, rest: ListNamedProgram) -> ListNamedProgram {
    parser_ast@cons_named_program(name, prog, rest)
}

fn empty_export_marks() -> ListModuleExportMark {
    dummy: ModuleExportMark <- ModuleExportMark { export_key: "", from_module: "" };
    nil_m: ListModuleExportMark <- ListModuleExportMark { is_nil: true, head: dummy, tail: nil_m };
    nil_m
}

fn cons_export_mark(key: string, mod: string, rest: ListModuleExportMark) -> ListModuleExportMark {
    ListModuleExportMark { is_nil: false, head: ModuleExportMark { export_key: key, from_module: mod }, tail: rest }
}

fn list_param_length(ps: ListParam) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> 1 + list_param_length(ps.tail)
    }
}

// Same parameter type list (trait `impl fn` overloads differ only by concrete first-arg types).
fn params_equal(a: ListParam, b: ListParam) -> bool {
    case a.is_nil of {
        true -> b.is_nil;
        false -> case b.is_nil of {
            true -> false;
            false -> case a.head.type_name == b.head.type_name of {
                true -> params_equal(a.tail, b.tail);
                false -> false
            }
        }
    }
}

fn export_key(fn_name: string, arity_lex: string) -> string {
    concat(concat(fn_name, "/"), arity_lex)
}

fn find_module_for_export_key(marks: ListModuleExportMark, key: string) -> string {
    case marks.is_nil of {
        true -> "";
        false -> case marks.head.export_key == key of {
            true -> marks.head.from_module;
            false -> find_module_for_export_key(marks.tail, key)
        }
    }
}

fn merge_export_items_cross_module(items: ListParam, mod: string, marks: ListModuleExportMark, err_loc: SourceLocation) -> (TypeCheckResult, ListModuleExportMark) {
    case items.is_nil of {
        true -> (type_checker_core@type_check_ok(), marks);
        false -> do
            key: string <- export_key(items.head.name, items.head.type_name);
            prev_mod: string <- find_module_for_export_key(marks, key);
            case prev_mod == "" of {
                true -> merge_export_items_cross_module(items.tail, mod, cons_export_mark(key, mod, marks), err_loc);
                false -> case prev_mod == mod of {
                    true -> merge_export_items_cross_module(items.tail, mod, marks, err_loc);
                    false -> (type_checker_core@type_check_err("E4001", err_loc, concat(concat(concat(concat(concat(concat("name conflict for exported ", key), ": modules "), prev_mod), " and "), mod), " (spec 19.3.3)"), "sect19.3.3"), marks)
                }
            }
        end
    }
}

fn accum_exports_cross_module(decls: ListDeclaration, mod: string, marks: ListModuleExportMark, err_loc: SourceLocation) -> (TypeCheckResult, ListModuleExportMark) {
    case decls.is_nil of {
        true -> (type_checker_core@type_check_ok(), marks);
        false -> case decls.head.tag == 3 of {
            true -> do
                (r1: TypeCheckResult, m1: ListModuleExportMark) <- merge_export_items_cross_module(decls.head.parameters, mod, marks, err_loc);
                case r1.is_ok of {
                    true -> accum_exports_cross_module(decls.tail, mod, m1, err_loc);
                    false -> (r1, m1)
                }
            end;
            false -> accum_exports_cross_module(decls.tail, mod, marks, err_loc)
        }
    }
}

fn check_use_conflicts_ordered(mod_names: ListParam, world: ListNamedProgram, marks: ListModuleExportMark, err_loc: SourceLocation) -> TypeCheckResult {
    case mod_names.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> do
            m: string <- mod_names.head.name;
            (found: bool, prog: Program) <- parser_ast@find_named_program(m, world);
            case found of {
                false -> type_checker_core@type_check_err("E4002", err_loc, concat(concat("unknown module in use: ", m), " (spec 19.3)"), "sect19.3");
                true -> do
                    (r2: TypeCheckResult, m2: ListModuleExportMark) <- accum_exports_cross_module(prog.declarations, m, marks, err_loc);
                    case r2.is_ok of {
                        true -> check_use_conflicts_ordered(mod_names.tail, world, m2, err_loc);
                        false -> r2
                    }
                end
            }
        end
    }
}

fn mark_has_export_key(marks: ListModuleExportMark, key: string) -> bool {
    case marks.is_nil of {
        true -> false;
        false -> case marks.head.export_key == key of {
            true -> true;
            false -> mark_has_export_key(marks.tail, key)
        }
    }
}

fn merge_export_items_duplicate_local(items: ListParam, marks: ListModuleExportMark, err_loc: SourceLocation) -> (TypeCheckResult, ListModuleExportMark) {
    case items.is_nil of {
        true -> (type_checker_core@type_check_ok(), marks);
        false -> do
            key: string <- export_key(items.head.name, items.head.type_name);
            case mark_has_export_key(marks, key) of {
                true -> (type_checker_core@type_check_err("E4013", err_loc, concat(concat("duplicate export ", key), " in module (spec 19.2.2)"), "sect19.2.2"), marks);
                false -> merge_export_items_duplicate_local(items.tail, cons_export_mark(key, "", marks), err_loc)
            }
        end
    }
}

fn accum_exports_local_duplicates(decls: ListDeclaration, marks: ListModuleExportMark, err_loc: SourceLocation) -> (TypeCheckResult, ListModuleExportMark) {
    case decls.is_nil of {
        true -> (type_checker_core@type_check_ok(), marks);
        false -> case decls.head.tag == 3 of {
            true -> do
                (r1: TypeCheckResult, m1: ListModuleExportMark) <- merge_export_items_duplicate_local(decls.head.parameters, marks, err_loc);
                case r1.is_ok of {
                    true -> accum_exports_local_duplicates(decls.tail, m1, err_loc);
                    false -> (r1, m1)
                }
            end;
            false -> accum_exports_local_duplicates(decls.tail, marks, err_loc)
        }
    }
}

fn validate_use_before_functions(decls: ListDeclaration, seen_function: bool) -> TypeCheckResult {
    case decls.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case decls.head.tag of {
            0 -> validate_use_before_functions(decls.tail, true);
            2 -> case seen_function of {
                true -> type_checker_core@type_check_err("E4005", decls.head.location, "use must appear before function definitions (spec 19.3.1)", "sect19.3.1");
                false -> validate_use_before_functions(decls.tail, false)
            };
            _: int64 -> validate_use_before_functions(decls.tail, seen_function)
        }
    }
}

fn validate_explicit_module_name(decls: ListDeclaration, expect: string) -> TypeCheckResult {
    case expect == "" of {
        true -> type_checker_core@type_check_ok();
        false -> validate_explicit_module_scan(decls, expect, 0, "", parser_ast@zero_location())
    }
}

fn validate_explicit_module_scan(decls: ListDeclaration, expect: string, count: int64, found_name: string, found_loc: SourceLocation) -> TypeCheckResult {
    case decls.is_nil of {
        true -> case count == 0 of {
            true -> type_checker_core@type_check_ok();
            false -> case found_name == expect of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E4006", found_loc, concat(concat(concat(concat("module declaration does not match file module name: expected ", expect), ", found "), found_name), " (spec 19.1.2)"), "sect19.1.2")
            }
        };
        false -> case decls.head.tag == 4 of {
            true -> case count > 0 of {
                true -> type_checker_core@type_check_err("E4007", decls.head.location, "duplicate module declaration in file (spec 19.1)", "sect19.1");
                false -> validate_explicit_module_scan(decls.tail, expect, 1, decls.head.name, decls.head.location)
            };
            false -> validate_explicit_module_scan(decls.tail, expect, count, found_name, found_loc)
        }
    }
}

fn validate_duplicate_function_definitions(decls: ListDeclaration) -> TypeCheckResult {
    validate_dup_fn_outer(decls, decls)
}

fn validate_dup_fn_outer(outer: ListDeclaration, all_decls: ListDeclaration) -> TypeCheckResult {
    case outer.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case outer.head.tag == 0 of {
            true -> do
                ar: int64 <- list_param_length(outer.head.parameters);
                case count_matching_functions(all_decls, outer.head.name, ar, outer.head.parameters) > 1 of {
                    true -> type_checker_core@type_check_err("E4015", outer.head.location, concat(concat("duplicate function definition ", outer.head.name), " with same arity"), "sect19.2");
                    false -> validate_dup_fn_outer(outer.tail, all_decls)
                }
            end;
            false -> validate_dup_fn_outer(outer.tail, all_decls)
        }
    }
}

fn count_matching_functions(decls: ListDeclaration, fn_name: string, arity: int64, params: ListParam) -> int64 {
    case decls.is_nil of {
        true -> 0;
        false -> case decls.head.tag == 0 and decls.head.name == fn_name and list_param_length(decls.head.parameters) == arity and params_equal(decls.head.parameters, params) of {
            true -> 1 + count_matching_functions(decls.tail, fn_name, arity, params);
            false -> count_matching_functions(decls.tail, fn_name, arity, params)
        }
    }
}

fn validate_module_program_surface(program: Program, current_module: string) -> TypeCheckResult {
    ord: TypeCheckResult <- validate_use_before_functions(program.declarations, false);
    case ord.is_ok of {
        false -> ord;
        true -> do
            modn: TypeCheckResult <- validate_explicit_module_name(program.declarations, current_module);
            case modn.is_ok of {
                false -> modn;
                true -> do
                    dupf: TypeCheckResult <- validate_duplicate_function_definitions(program.declarations);
                    case dupf.is_ok of {
                        false -> dupf;
                        true -> do
                            (dup_e: TypeCheckResult, _: ListModuleExportMark) <- accum_exports_local_duplicates(program.declarations, empty_export_marks(), program.location);
                            case dup_e.is_ok of {
                                false -> dup_e;
                                true -> type_checker_failure_reporter@check_failure_reporter_export_trait(program)
                            }
                        end
                    }
                end
            }
        end
    }
}

fn check_all_declarations_functions_only(decls: ListDeclaration, all_program_decls: ListDeclaration, context: TypeContext, world: ListNamedProgram) -> TypeCheckResult proc[DeviceIO] {
    case decls.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case decls.head.tag of {
            0 -> do
                phe: TypeCheckResult <- type_checker_supervisor@check_init_if_supervisor_impl_phase_e(decls.head, all_program_decls);
                case phe.is_ok of {
                    false -> phe;
                    true -> do
                        result: TypeCheckResult <- type_checker_declarations_functions@check_body(decls.head, context, world);
                        case result.is_ok of {
                            true -> do
                                sup_lit: TypeCheckResult <- type_checker_supervisor@validate_supervisor_init_body_literal_agent_types_if_needed(decls.head, all_program_decls);
                                case sup_lit.is_ok of {
                                    false -> sup_lit;
                                    true -> do
                                        sup_flav: TypeCheckResult <- type_checker_supervisor@validate_supervisor_init_body_literal_flavor_if_needed(decls.head, all_program_decls);
                                        case sup_flav.is_ok of {
                                            false -> sup_flav;
                                            true -> do
                                                sup_dang: TypeCheckResult <- type_checker_supervisor@validate_supervisor_init_body_dangerous_flavor_constraints_if_needed(decls.head, all_program_decls, all_program_decls);
                                                case sup_dang.is_ok of {
                                                    false -> sup_dang;
                                                    true -> check_all_declarations_functions_only(decls.tail, all_program_decls, context, world)
                                                }
                                            end
                                        }
                                    end
                                }
                            end;
                            false -> result
                        }
                    end
                }
            end;
            _: int64 -> check_all_declarations_functions_only(decls.tail, all_program_decls, context, world)
        }
    }
}

fn type_check_program_with_modules(program: Program, current_module: string, world: ListNamedProgram, context: TypeContext) -> (TypeCheckResult, TypeContext) proc[DeviceIO] {
    surface: TypeCheckResult <- validate_module_program_surface(program, current_module);
    case surface.is_ok of {
        false -> (surface, context);
        true -> do
            (pass1: TypeCheckResult, ctx1: TypeContext) <- type_checker_callee_env@add_all_declarations_with_world(program.declarations, program.declarations, context, world, current_module);
            case pass1.is_ok of {
                false -> (pass1, ctx1);
                true -> do
                    sup_csv: string <- type_checker_supervisor@collect_supervisor_impl_types_csv(program.declarations);
                    ctx_sup: TypeContext <- type_checker_core@type_context_with_supervisor_types(ctx1, sup_csv);
                    sup_init: TypeCheckResult <- type_checker_supervisor@check_supervisor_impl_has_init_phase_b(program.declarations);
                    case sup_init.is_ok of {
                        false -> (sup_init, ctx_sup);
                        true -> do
                            body: TypeCheckResult <- check_all_declarations_functions_only(program.declarations, program.declarations, ctx_sup, world);
                            (body, ctx_sup)
                        end
                    }
                end
            }
        end
    }
}

// Build ModuleTypecheckOutcome here: (pair + outcome) stay in this .ll. Also avoid
// type_checker_core@module_typecheck_outcome_from_pair (cross-.ll struct return).
fn module_typecheck_outcome_from_pair_here(r: TypeCheckResult, c: TypeContext) -> ModuleTypecheckOutcome {
    ModuleTypecheckOutcome {
        is_ok: r.is_ok,
        error_code: r.error_code,
        error_location: r.error_location,
        error_message: r.error_message,
        spec_section: r.spec_section,
        context: c
    }
}

fn type_check_program_with_modules_outcome(program: Program, current_module: string, world: ListNamedProgram, context: TypeContext) -> ModuleTypecheckOutcome proc[DeviceIO] {
    do
    (r: TypeCheckResult, c: TypeContext) <- type_check_program_with_modules(program, current_module, world, context);
    module_typecheck_outcome_from_pair_here(r, c)
    end
}

fn type_check_program_with_modules_world_bundle(program: Program, current_module: string, world: ListNamedProgram, context: TypeContext) -> TypeCheckWithContext proc[DeviceIO] {
    do
    (r: TypeCheckResult, c: TypeContext) <- type_check_program_with_modules(program, current_module, world, context);
    TypeCheckWithContext { result: r, context: c }
    end
}
