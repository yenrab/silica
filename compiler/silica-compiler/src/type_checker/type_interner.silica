struct TypeNode {
    kind: int64,
    a: int64,
    b: int64,
    c: int64,
    buf_size_is_name: boolean
}

struct ListTypeNode {
    is_nil: boolean,
    head: TypeNode,
    tail: ListTypeNode
}

struct KeyEntry {
    kind: int64,
    a: int64,
    b: int64,
    c: int64,
    buf_size_is_name: boolean,
    id: int64
}

struct ListKeyEntry {
    is_nil: boolean,
    head: KeyEntry,
    tail: ListKeyEntry
}

struct NameEntry {
    lexeme: string,
    id: int64
}

struct ListNameEntry {
    is_nil: boolean,
    head: NameEntry,
    tail: ListNameEntry
}

struct ListInt64Entry {
    is_nil: boolean,
    head: int64,
    tail: ListInt64Entry
}

struct ListStringEntry {
    is_nil: boolean,
    head: string,
    tail: ListStringEntry
}

struct FieldEntry {
    name: string,
    ty: int64
}

struct ListFieldEntry {
    is_nil: boolean,
    head: FieldEntry,
    tail: ListFieldEntry
}

// Exact surface string -> interned type id. Avoids re-parsing repeated inline
// structural annotations (dominant RAM cost when checking selfhost emitters).
struct SurfaceTypeCacheEntry {
    surface: string,
    type_id: int64
}

struct ListSurfaceTypeCacheEntry {
    is_nil: boolean,
    head: SurfaceTypeCacheEntry,
    tail: ListSurfaceTypeCacheEntry
}

struct TypeInterner {
    nodes: ListTypeNode,
    by_key: BstNode,
    names: ListNameEntry,
    name_lexemes: ListStringEntry,
    next_id: int64,
    seq_nil_id: int64,
    surface_cache: BstNode
}

struct TypeDagReplay {
    interner: TypeInterner,
    remap: ListInt64Entry
}

struct InternResult {
    interner: TypeInterner,
    id: int64
}

struct TypeInternParseResult {
    interner: TypeInterner,
    id: int64,
    ok: boolean
}

struct KeyLookupResult {
    id: int64,
    found: boolean
}

struct NameLookupResult {
    names: ListNameEntry,
    id: int64,
    found: boolean
}

struct IdListResult {
    interner: TypeInterner,
    ids: ListInt64Entry,
    ok: boolean
}

struct BracketArgsResult {
    interner: TypeInterner,
    args: ListInt64Entry,
    ok: boolean
}

struct SpaceUnwrapResult {
    id: int64,
    ok: boolean
}

struct DecimalParseResult {
    ok: boolean,
    value: int64
}



