// CompressedSparseRowGraph directed unweighted, memory space normal (graph_representation_design.md §4).
// Bootstrap static graph: 3 nodes, 2 directed edges: 0 -> 1, 1 -> 2.

use graph_adj_list_helpers;

export graph_csr_directed_unweighted_normal_from_static_edges/0;
export graph_csr_directed_unweighted_normal_node_count/1;
export graph_csr_directed_unweighted_normal_edge_count/1;
export graph_csr_directed_unweighted_normal_out_degree/2;
export graph_csr_directed_unweighted_normal_has_edge/3;
export graph_csr_directed_unweighted_normal_validate/1;

fn graph_csr_directed_unweighted_normal_from_static_edges() -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        offsets: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        neighbors: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(offsets, 0, 0);
        _: atom <- write_buf(offsets, 1, 1);
        _: atom <- write_buf(offsets, 2, 2);
        _: atom <- write_buf(offsets, 3, 2);
        _: atom <- write_buf(neighbors, 0, 1);
        _: atom <- write_buf(neighbors, 1, 2);
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 2)
        } <- {
            region: r,
            node_count: 3,
            edge_count: 2,
            offsets: offsets,
            neighbors: neighbors
        }
    produces
        pure graph
    end
}

fn graph_csr_directed_unweighted_normal_node_count(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    graph.node_count
}

fn graph_csr_directed_unweighted_normal_edge_count(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    graph.edge_count
}

fn graph_csr_directed_unweighted_normal_out_degree(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}, node_id: int64) -> int64 {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(node_id, graph.node_count) of {
        0 -> 0;
        1 -> graph_csr_directed_unweighted_normal_out_degree_static(node_id);
        _: int64 -> 0
    }
}

fn graph_csr_directed_unweighted_normal_out_degree_static(node_id: int64) -> int64 {
    case node_id of {
        0 -> 1;
        1 -> 1;
        2 -> 0;
        _: int64 -> 0
    }
}

fn graph_csr_directed_unweighted_normal_has_edge(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}, from_id: int64, to_id: int64) -> int64 {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(from_id, graph.node_count) of {
        0 -> 0;
        1 -> graph_csr_directed_unweighted_normal_has_edge_from_ok(graph, from_id, to_id);
        _: int64 -> 0
    }
}

fn graph_csr_directed_unweighted_normal_has_edge_from_ok(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}, from_id: int64, to_id: int64) -> int64 {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(to_id, graph.node_count) of {
        0 -> 0;
        1 -> graph_csr_directed_unweighted_normal_has_edge_checked(graph, from_id, to_id);
        _: int64 -> 0
    }
}

fn graph_csr_directed_unweighted_normal_has_edge_checked(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}, from_id: int64, to_id: int64) -> int64 {
    case from_id of {
        0 -> graph_csr_directed_unweighted_normal_has_from0(to_id);
        1 -> graph_csr_directed_unweighted_normal_has_from1(to_id);
        _: int64 -> 0
    }
}

fn graph_csr_directed_unweighted_normal_has_from0(to_id: int64) -> int64 {
    case to_id of {
        1 -> 1;
        _: int64 -> 0
    }
}

fn graph_csr_directed_unweighted_normal_has_from1(to_id: int64) -> int64 {
    case to_id of {
        2 -> 1;
        _: int64 -> 0
    }
}

fn graph_csr_directed_unweighted_normal_validate(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    case graph.node_count - 3 of {
        0 -> graph_csr_directed_unweighted_normal_validate_edge_count(graph);
        _: int64 -> 0
    }
}

fn graph_csr_directed_unweighted_normal_validate_edge_count(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    case graph.edge_count - 2 of {
        0 -> 1;
        _: int64 -> 0
    }
}
