export graph_adj_validate_typed_undirected_unweighted/3;
export graph_adj_validate_undirected_storage_edge_count/2;
export graph_adj_validate_typed_nodes_unweighted/2;

fn graph_adj_node_id_in_range_1(node_id: int64) -> int64 {
    case node_id of {
        0 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_node_id_in_range_2(node_id: int64) -> int64 {
    case node_id of {
        0 -> 1;
        1 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_node_id_in_range_3(node_id: int64) -> int64 {
    case node_id of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_node_id_in_range(node_id: int64, node_count: int64) -> int64 {
    case node_count of {
        0 -> 0;
        1 -> graph_adj_node_id_in_range_1(node_id);
        2 -> graph_adj_node_id_in_range_2(node_id);
        3 -> graph_adj_node_id_in_range_3(node_id);
        _: int64 -> 0
    }
}

fn graph_adj_int64_equal_delta(delta: int64) -> int64 {
    case delta of {
        0 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_int64_equal(lhs: int64, rhs: int64) -> int64 {
    delta: int64 <- lhs - rhs;
    graph_adj_int64_equal_delta(delta)
}

fn graph_adj_int64_nonneg(delta: int64) -> int64 {
    case delta of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> 1;
        4 -> 1;
        5 -> 1;
        6 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_list_int64_nonempty(lst: List[int64, mem(normal)]) -> int64 {
    case lst of {
        []: List[int64, mem(normal)] -> 0;
        [_: int64, _: List[int64, mem(normal)]] -> 1
    }
}

fn graph_adj_tail_int64_or_empty(lst: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case lst of {
        []: List[int64, mem(normal)] -> lst;
        [_: int64, t: List[int64, mem(normal)]] -> t
    }
}

fn graph_adj_list_int64_length(lst: List[int64, mem(normal)]) -> int64 {
    t1: List[int64, mem(normal)] <- graph_adj_tail_int64_or_empty(lst);
    t2: List[int64, mem(normal)] <- graph_adj_tail_int64_or_empty(t1);
    has0: int64 <- graph_adj_list_int64_nonempty(lst);
    has1: int64 <- graph_adj_list_int64_nonempty(t1);
    has2: int64 <- graph_adj_list_int64_nonempty(t2);
    has0 + has1 + has2
}

fn graph_adj_list_int64_contains_at0_cons(h: int64, value: int64) -> int64 {
    graph_adj_int64_equal(h, value)
}

fn graph_adj_list_int64_contains_at0(lst: List[int64, mem(normal)], value: int64) -> int64 {
    case lst of {
        []: List[int64, mem(normal)] -> 0;
        [h: int64, _: List[int64, mem(normal)]] -> graph_adj_list_int64_contains_at0_cons(h, value)
    }
}

fn graph_adj_list_int64_contains_at1(lst: List[int64, mem(normal)], value: int64) -> int64 {
    t: List[int64, mem(normal)] <- graph_adj_tail_int64_or_empty(lst);
    graph_adj_list_int64_contains_at0(t, value)
}

fn graph_adj_list_int64_contains(lst: List[int64, mem(normal)], value: int64) -> int64 {
    case graph_adj_list_int64_contains_at0(lst, value) of {
        1 -> 1;
        _: int64 -> graph_adj_list_int64_contains_at1(lst, value)
    }
}

fn graph_adj_build_empty_nodes_unweighted(node_count: int64) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        shared_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        empty_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]();
        built: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- case node_count of {
            0 -> empty_nodes;
            1 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                empty_nodes
            );
            2 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: shared_empty },
                    empty_nodes
                )
            );
            3 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: shared_empty },
                    prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                        { id: 2, neighbors: shared_empty },
                        empty_nodes
                    )
                )
            );
            _: int64 -> empty_nodes
        }
    produces
        pure built
    end
}

fn graph_adj_rebuild_nodes_unweighted_3(
    flat_graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_count: int64,
    fallback_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    count_saved: int64 <- node_count;
    sequence proc[mem(normal)]
        empty_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]();
        built: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- case count_saved of {
            0 -> empty_nodes;
            1 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: flat_graph.n0_neighbors },
                empty_nodes
            );
            2 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: flat_graph.n0_neighbors },
                prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: flat_graph.n1_neighbors },
                    empty_nodes
                )
            );
            3 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: flat_graph.n0_neighbors },
                prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: flat_graph.n1_neighbors },
                    prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                        { id: 2, neighbors: flat_graph.n2_neighbors },
                        empty_nodes
                    )
                )
            );
            _: int64 -> fallback_nodes
        }
    produces
        pure built
    end
}

fn graph_adj_find_neighbors_unweighted_at0(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    default_empty: List[int64, mem(normal)]
) -> { found: int64, neighbors: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        found: int64 <- case nodes of {
            []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0;
            [_: { id: int64, neighbors: List[int64, mem(normal)] }, _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] -> 1
        };
        neighbors: List[int64, mem(normal)] <- case nodes of {
            []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> default_empty;
            [h: { id: int64, neighbors: List[int64, mem(normal)] }, _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] -> h.neighbors
        };
        out: { found: int64, neighbors: List[int64, mem(normal)] } <- {
            found: found,
            neighbors: neighbors
        }
    produces
        pure out
    end
}

fn graph_adj_tail_unweighted_or_empty(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    case nodes of {
        []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> nodes;
        [_: { id: int64, neighbors: List[int64, mem(normal)] }, t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] -> t
    }
}

fn graph_adj_find_neighbors_unweighted_at1(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    default_empty: List[int64, mem(normal)]
) -> { found: int64, neighbors: List[int64, mem(normal)] } {
    default_saved: List[int64, mem(normal)] <- default_empty;
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
    graph_adj_find_neighbors_unweighted_at0(tail1, default_saved)
}

fn graph_adj_find_neighbors_unweighted_at2(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    default_empty: List[int64, mem(normal)]
) -> { found: int64, neighbors: List[int64, mem(normal)] } {
    default_saved: List[int64, mem(normal)] <- default_empty;
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
    tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(tail1);
    graph_adj_find_neighbors_unweighted_at0(tail2, default_saved)
}

fn graph_adj_find_neighbors_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    target_id: int64,
    default_empty: List[int64, mem(normal)]
) -> { found: int64, neighbors: List[int64, mem(normal)] } {
    default_saved: List[int64, mem(normal)] <- default_empty;
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
    tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(tail1);
    r0: { found: int64, neighbors: List[int64, mem(normal)] } <- graph_adj_find_neighbors_unweighted_at0(nodes, default_saved);
    r1: { found: int64, neighbors: List[int64, mem(normal)] } <- graph_adj_find_neighbors_unweighted_at0(tail1, default_saved);
    r2: { found: int64, neighbors: List[int64, mem(normal)] } <- graph_adj_find_neighbors_unweighted_at0(tail2, default_saved);
    found: int64 <- case target_id of {
        0 -> r0.found;
        1 -> r1.found;
        2 -> r2.found;
        _: int64 -> 0
    };
    neighbors: List[int64, mem(normal)] <- case target_id of {
        0 -> r0.neighbors;
        1 -> r1.neighbors;
        2 -> r2.neighbors;
        _: int64 -> default_saved
    };
    out: { found: int64, neighbors: List[int64, mem(normal)] } <- {
        found: found,
        neighbors: neighbors
    };
    out
}

fn graph_adj_find_node_unweighted_at0(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    default_node: { id: int64, neighbors: List[int64, mem(normal)] }
) -> { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } {
    case nodes of {
        []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> { found: 0, node: default_node };
        [h: { id: int64, neighbors: List[int64, mem(normal)] }, _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] -> { found: 1, node: h };
        _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> { found: 0, node: default_node }
    }
}

fn graph_adj_find_node_unweighted_at1(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    default_node: { id: int64, neighbors: List[int64, mem(normal)] }
) -> { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } {
    default_saved: { id: int64, neighbors: List[int64, mem(normal)] } <- default_node;
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
    graph_adj_find_node_unweighted_at0(tail1, default_saved)
}

fn graph_adj_find_node_unweighted_at2(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    default_node: { id: int64, neighbors: List[int64, mem(normal)] }
) -> { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } {
    default_saved: { id: int64, neighbors: List[int64, mem(normal)] } <- default_node;
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
    tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(tail1);
    graph_adj_find_node_unweighted_at0(tail2, default_saved)
}

fn graph_adj_find_node_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    target_id: int64,
    default_node: { id: int64, neighbors: List[int64, mem(normal)] }
) -> { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } {
    default_saved: { id: int64, neighbors: List[int64, mem(normal)] } <- default_node;
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
    tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(tail1);
    r0: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <- graph_adj_find_node_unweighted_at0(nodes, default_saved);
    r1: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <- graph_adj_find_node_unweighted_at0(tail1, default_saved);
    r2: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <- graph_adj_find_node_unweighted_at0(tail2, default_saved);
    found: int64 <- case target_id of {
        0 -> r0.found;
        1 -> r1.found;
        2 -> r2.found;
        _: int64 -> 0
    };
    node: { id: int64, neighbors: List[int64, mem(normal)] } <- case target_id of {
        0 -> r0.node;
        1 -> r1.node;
        2 -> r2.node;
        _: int64 -> default_saved
    };
    out: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <- {
        found: found,
        node: node
    };
    out
}

fn graph_adj_prepare_replace_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> {
    tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    r0_node: { id: int64, neighbors: List[int64, mem(normal)] },
    r1_node: { id: int64, neighbors: List[int64, mem(normal)] }
} {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        default_node: { id: int64, neighbors: List[int64, mem(normal)] } <- {
            id: -1,
            neighbors: empty_neighbors
        };
        t1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(nodes);
        t2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph_adj_tail_unweighted_or_empty(t1);
        r0: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <- graph_adj_find_node_unweighted_at0(nodes, default_node);
        r1: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <- graph_adj_find_node_unweighted_at0(t1, default_node);
        result: {
            tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            r0_node: { id: int64, neighbors: List[int64, mem(normal)] },
            r1_node: { id: int64, neighbors: List[int64, mem(normal)] }
        } <- {
            tail1: t1,
            tail2: t2,
            r0_node: r0.node,
            r1_node: r1.node
        }
    produces
        pure result
    end
}

fn graph_adj_replace_at2_unweighted(
    node0: { id: int64, neighbors: List[int64, mem(normal)] },
    node1: { id: int64, neighbors: List[int64, mem(normal)] },
    node2: { id: int64, neighbors: List[int64, mem(normal)] },
    empty_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    n0_saved: { id: int64, neighbors: List[int64, mem(normal)] } <- node0;
    n1_saved: { id: int64, neighbors: List[int64, mem(normal)] } <- node1;
    n2_saved: { id: int64, neighbors: List[int64, mem(normal)] } <- node2;
    sequence proc[mem(normal)]
        inner: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](n2_saved, empty_nodes);
        mid: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](n1_saved, inner);
        outer: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](n0_saved, mid)
    produces
        pure outer
    end
}

fn graph_adj_replace_node_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[int64, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] {
    new_node_saved: { id: int64, neighbors: List[int64, mem(normal)] } <- new_node;
    target_saved: int64 <- target_id;
    sequence proc[mem(normal)]
        default_saved: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- default_if_empty;
        empty_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]();
        prep: {
            tail1: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            tail2: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            r0_node: { id: int64, neighbors: List[int64, mem(normal)] },
            r1_node: { id: int64, neighbors: List[int64, mem(normal)] }
        } <- graph_adj_prepare_replace_unweighted(nodes);
        replaced: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- case target_saved of {
            0 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](new_node_saved, prep.tail1);
            1 -> prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](
                prep.r0_node,
                prepend[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)](new_node_saved, prep.tail2)
            );
            2 -> graph_adj_replace_at2_unweighted(prep.r0_node, prep.r1_node, new_node_saved, empty_nodes);
            _: int64 -> default_saved
        }
    produces
        pure replaced
    end
}

fn graph_adj_sum_neighbor_counts_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0;
        [h: { id: int64, neighbors: List[int64, mem(normal)] }, t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] ->
            graph_adj_list_int64_length(h.neighbors) + graph_adj_sum_neighbor_counts_unweighted(t);
        _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0
    }
}

fn graph_adj_count_node_records_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0;
        [_: { id: int64, neighbors: List[int64, mem(normal)] }, t: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)]] ->
            1 + graph_adj_count_node_records_unweighted(t);
        _: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] -> 0
    }
}

fn graph_adj_build_empty_nodes_weighted(node_count: int64) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        shared_empty: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        empty_nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]();
        built: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] <- case node_count of {
            0 -> empty_nodes;
            1 -> prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                empty_nodes
            );
            2 -> prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: shared_empty },
                    empty_nodes
                )
            );
            3 -> prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                { id: 0, neighbors: shared_empty },
                prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                    { id: 1, neighbors: shared_empty },
                    prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
                        { id: 2, neighbors: shared_empty },
                        empty_nodes
                    )
                )
            );
            _: int64 -> empty_nodes
        }
    produces
        pure built
    end
}

fn graph_adj_find_neighbors_weighted_step(
    h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    default_empty: List[{ to: int64, weight: int64 }, mem(normal)]
) -> { found: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] } {
    case h.id - target_id of {
        0 -> { found: 1, neighbors: h.neighbors };
        _: int64 -> graph_adj_find_neighbors_weighted(t, target_id, default_empty)
    }
}

fn graph_adj_find_neighbors_weighted(
    nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    default_empty: List[{ to: int64, weight: int64 }, mem(normal)]
) -> { found: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] } {
    case nodes of {
        []: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> { found: 0, neighbors: default_empty };
        [h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]] ->
            graph_adj_find_neighbors_weighted_step(h, t, target_id, default_empty);
        _: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> { found: 0, neighbors: default_empty }
    }
}

fn graph_adj_replace_node_weighted_step(
    h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    case h.id - target_id of {
        0 -> graph_adj_replace_node_weighted_step_match(new_node, t);
        _: int64 -> graph_adj_replace_node_weighted_step_skip(h, t, target_id, new_node, default_if_empty)
    }
}

fn graph_adj_replace_node_weighted_step_match(
    new_node: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        replaced: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] <- prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](new_node, t)
    produces
        pure replaced
    end
}

fn graph_adj_replace_node_weighted_step_skip(
    h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        replaced: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] <- prepend[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)](
            h,
            graph_adj_replace_node_weighted(t, target_id, new_node, default_if_empty)
        )
    produces
        pure replaced
    end
}

fn graph_adj_replace_node_weighted(
    nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)],
    target_id: int64,
    new_node: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] },
    default_if_empty: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] {
    case nodes of {
        []: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> default_if_empty;
        [h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]] ->
            graph_adj_replace_node_weighted_step(h, t, target_id, new_node, default_if_empty);
        _: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> default_if_empty
    }
}

fn graph_adj_list_weighted_contains_cons(
    h: { to: int64, weight: int64 },
    t: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> int64 {
    case h.to - to_id of {
        0 -> 1;
        _: int64 -> graph_adj_list_weighted_contains(t, to_id)
    }
}

fn graph_adj_list_weighted_contains(
    lst: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> int64 {
    case lst of {
        []: List[{ to: int64, weight: int64 }, mem(normal)] -> 0;
        [h: { to: int64, weight: int64 }, t: List[{ to: int64, weight: int64 }, mem(normal)]] -> graph_adj_list_weighted_contains_cons(h, t, to_id);
        _: List[{ to: int64, weight: int64 }, mem(normal)] -> 0
    }
}

fn graph_adj_list_weighted_weight_at_cons(
    h: { to: int64, weight: int64 },
    t: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> { found: int64, weight: int64 } {
    case h.to - to_id of {
        0 -> { found: 1, weight: h.weight };
        _: int64 -> graph_adj_list_weighted_weight_at(t, to_id)
    }
}

fn graph_adj_list_weighted_weight_at(
    lst: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> { found: int64, weight: int64 } {
    case lst of {
        []: List[{ to: int64, weight: int64 }, mem(normal)] -> { found: 0, weight: 0 };
        [h: { to: int64, weight: int64 }, t: List[{ to: int64, weight: int64 }, mem(normal)]] -> graph_adj_list_weighted_weight_at_cons(h, t, to_id);
        _: List[{ to: int64, weight: int64 }, mem(normal)] -> { found: 0, weight: 0 }
    }
}

fn graph_adj_list_weighted_length(lst: List[{ to: int64, weight: int64 }, mem(normal)]) -> int64 {
    case lst of {
        []: List[{ to: int64, weight: int64 }, mem(normal)] -> 0;
        [_: { to: int64, weight: int64 }, t: List[{ to: int64, weight: int64 }, mem(normal)]] -> 1 + graph_adj_list_weighted_length(t);
        _: List[{ to: int64, weight: int64 }, mem(normal)] -> 0
    }
}

fn graph_adj_sum_neighbor_counts_weighted(
    nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> 0;
        [h: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]] ->
            graph_adj_list_weighted_length(h.neighbors) + graph_adj_sum_neighbor_counts_weighted(t);
        _: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> 0
    }
}

fn graph_adj_count_node_records_weighted(
    nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> 0;
        [_: { id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, t: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)]] ->
            1 + graph_adj_count_node_records_weighted(t);
        _: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, mem(normal)] }, mem(normal)] -> 0
    }
}

fn graph_adj_validate_node_count_range(node_count: int64) -> int64 {
    case node_count of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_validate_int64_list_all_in_range(
    neighbors: List[int64, mem(normal)],
    node_count: int64
) -> int64 {
    node_count_saved: int64 <- node_count;
    case neighbors of {
        []: List[int64, mem(normal)] -> 1;
        [h: int64, t: List[int64, mem(normal)]] -> case graph_adj_node_id_in_range(h, node_count_saved) of {
            0 -> 0;
            1 -> graph_adj_validate_int64_list_all_in_range(t, node_count_saved);
            _: int64 -> 0
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn graph_adj_validate_weighted_int64_list_all_in_range(
    neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    node_count: int64
) -> int64 {
    node_count_saved: int64 <- node_count;
    case neighbors of {
        []: List[{ to: int64, weight: int64 }, mem(normal)] -> 1;
        [h: { to: int64, weight: int64 }, t: List[{ to: int64, weight: int64 }, mem(normal)]] ->
            case graph_adj_node_id_in_range(h.to, node_count_saved) of {
                0 -> 0;
                1 -> graph_adj_validate_weighted_int64_list_all_in_range(t, node_count_saved);
                _: int64 -> 0
            };
        _: List[{ to: int64, weight: int64 }, mem(normal)] -> 0
    }
}

fn graph_adj_validate_flat_directed_edge_count(
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
) -> int64 {
    node_count_saved: int64 <- node_count;
    edge_count_saved: int64 <- edge_count;
    n0_saved: List[int64, mem(normal)] <- n0_neighbors;
    n1_saved: List[int64, mem(normal)] <- n1_neighbors;
    n2_saved: List[int64, mem(normal)] <- n2_neighbors;
    l0: int64 <- graph_adj_list_int64_length(n0_saved);
    l1: int64 <- graph_adj_list_int64_length(n1_saved);
    l2: int64 <- graph_adj_list_int64_length(n2_saved);
    edge_total: int64 <- case node_count_saved of {
        0 -> 0;
        1 -> l0;
        2 -> l0 + l1;
        3 -> l0 + l1 + l2;
        _: int64 -> -1
    };
    graph_adj_int64_equal(edge_total, edge_count_saved)
}

fn graph_adj_validate_undirected_storage_edge_count(
    edge_count: int64,
    neighbor_total: int64
) -> int64 {
    edge_count_saved: int64 <- edge_count;
    neighbor_total_saved: int64 <- neighbor_total;
    low_delta: int64 <- neighbor_total_saved - edge_count_saved;
    high_delta: int64 <- edge_count_saved + edge_count_saved - neighbor_total_saved;
    low_ok: int64 <- graph_adj_int64_nonneg(low_delta);
    high_ok: int64 <- graph_adj_int64_nonneg(high_delta);
    case low_ok of {
        0 -> 0;
        1 -> high_ok;
        _: int64 -> 0
    }
}

fn graph_adj_validate_flat_undirected_edge_count(
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
) -> int64 {
    node_count_saved: int64 <- node_count;
    edge_count_saved: int64 <- edge_count;
    n0_saved: List[int64, mem(normal)] <- n0_neighbors;
    n1_saved: List[int64, mem(normal)] <- n1_neighbors;
    n2_saved: List[int64, mem(normal)] <- n2_neighbors;
    l0: int64 <- graph_adj_list_int64_length(n0_saved);
    l1: int64 <- graph_adj_list_int64_length(n1_saved);
    l2: int64 <- graph_adj_list_int64_length(n2_saved);
    neighbor_total: int64 <- case node_count_saved of {
        0 -> 0;
        1 -> l0;
        2 -> l0 + l1;
        3 -> l0 + l1 + l2;
        _: int64 -> -1
    };
    graph_adj_validate_undirected_storage_edge_count(edge_count_saved, neighbor_total)
}

fn graph_adj_validate_flat_weighted_int64_edge_count(
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
) -> int64 {
    node_count_saved: int64 <- node_count;
    edge_count_saved: int64 <- edge_count;
    n0_saved: List[{ to: int64, weight: int64 }, mem(normal)] <- n0_neighbors;
    n1_saved: List[{ to: int64, weight: int64 }, mem(normal)] <- n1_neighbors;
    n2_saved: List[{ to: int64, weight: int64 }, mem(normal)] <- n2_neighbors;
    l0: int64 <- graph_adj_list_weighted_length(n0_saved);
    l1: int64 <- graph_adj_list_weighted_length(n1_saved);
    l2: int64 <- graph_adj_list_weighted_length(n2_saved);
    edge_total: int64 <- case node_count_saved of {
        0 -> 0;
        1 -> l0;
        2 -> l0 + l1;
        3 -> l0 + l1 + l2;
        _: int64 -> -1
    };
    graph_adj_int64_equal(edge_total, edge_count_saved)
}

fn graph_adj_validate_expected_node_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    expected_id: int64,
    node_count: int64,
    default_node: { id: int64, neighbors: List[int64, mem(normal)] }
) -> int64 {
    expected_saved: int64 <- expected_id;
    node_count_saved: int64 <- node_count;
    lookup: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <-
        graph_adj_find_node_unweighted(nodes, expected_saved, default_node);
    case lookup.found of {
        0 -> 0;
        1 -> graph_adj_validate_int64_list_all_in_range(lookup.node.neighbors, node_count_saved);
        _: int64 -> 0
    }
}

fn graph_adj_validate_typed_nodes_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    node_count: int64
) -> int64 {
    node_count_saved: int64 <- node_count;
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        default_node: { id: int64, neighbors: List[int64, mem(normal)] } <- {
            id: -1,
            neighbors: empty_neighbors
        };
        need0: int64 <- case node_count_saved of {
            0 -> 0;
            _: int64 -> 1
        };
        need1: int64 <- case node_count_saved of {
            0 -> 0;
            1 -> 0;
            _: int64 -> 1
        };
        need2: int64 <- case node_count_saved of {
            3 -> 1;
            _: int64 -> 0
        };
        got0: int64 <- graph_adj_validate_expected_node_unweighted(nodes, 0, node_count_saved, default_node);
        got1: int64 <- graph_adj_validate_expected_node_unweighted(nodes, 1, node_count_saved, default_node);
        got2: int64 <- graph_adj_validate_expected_node_unweighted(nodes, 2, node_count_saved, default_node);
        ok0: int64 <- case need0 of {
            0 -> 1;
            1 -> got0;
            _: int64 -> 0
        };
        ok1: int64 <- case need1 of {
            0 -> 1;
            1 -> got1;
            _: int64 -> 0
        };
        ok2: int64 <- case need2 of {
            0 -> 1;
            1 -> got2;
            _: int64 -> 0
        };
        result: int64 <- case ok0 of {
            0 -> 0;
            1 -> case ok1 of {
                0 -> 0;
                1 -> ok2;
                _: int64 -> 0
            };
            _: int64 -> 0
        }
    produces
        pure result
    end
}

fn graph_adj_validate_typed_directed_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    node_count: int64,
    edge_count: int64
) -> int64 {
    nodes_saved: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes;
    node_count_saved: int64 <- node_count;
    edge_count_saved: int64 <- edge_count;
    nc_ok: int64 <- graph_adj_validate_node_count_range(node_count_saved);
    nodes_for_records: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes_saved;
    record_count: int64 <- graph_adj_count_node_records_unweighted(nodes_for_records);
    records_ok: int64 <- graph_adj_int64_equal(record_count, node_count_saved);
    nodes_for_validate: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes_saved;
    nodes_ok: int64 <- graph_adj_validate_typed_nodes_unweighted(nodes_for_validate, node_count_saved);
    nodes_for_sum: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes_saved;
    neighbor_total: int64 <- graph_adj_sum_neighbor_counts_unweighted(nodes_for_sum);
    edge_ok: int64 <- graph_adj_int64_equal(neighbor_total, edge_count_saved);
    case nc_ok of {
        0 -> 0;
        1 -> case records_ok of {
            0 -> 0;
            1 -> case nodes_ok of {
                0 -> 0;
                1 -> edge_ok;
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        _: int64 -> 0
    }
}

fn graph_adj_validate_typed_undirected_unweighted(
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    node_count: int64,
    edge_count: int64
) -> int64 {
    sequence proc[mem(normal)]
        pin: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        nodes_saved: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes;
        node_count_saved: int64 <- node_count;
        edge_count_saved: int64 <- edge_count;
        nc_ok: int64 <- graph_adj_validate_node_count_range(node_count_saved);
        nodes_for_records: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes_saved;
        record_count: int64 <- graph_adj_count_node_records_unweighted(nodes_for_records);
        records_ok: int64 <- graph_adj_int64_equal(record_count, node_count_saved);
        nodes_for_validate: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes_saved;
        nodes_ok: int64 <- graph_adj_validate_typed_nodes_unweighted(nodes_for_validate, node_count_saved);
        nodes_for_sum: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes_saved;
        neighbor_total: int64 <- graph_adj_sum_neighbor_counts_unweighted(nodes_for_sum);
        edge_ok: int64 <- graph_adj_validate_undirected_storage_edge_count(edge_count_saved, neighbor_total);
        result: int64 <- case nc_ok of {
            0 -> 0;
            1 -> case records_ok of {
                0 -> 0;
                1 -> case nodes_ok of {
                    0 -> 0;
                    1 -> edge_ok;
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        _: List[int64, mem(normal)] <- pin
    produces
        pure result
    end
}

fn graph_adj_validate_flat_unweighted_directed(
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
) -> int64 {
    node_count_saved: int64 <- node_count;
    edge_count_saved: int64 <- edge_count;
    n0_saved: List[int64, mem(normal)] <- n0_neighbors;
    n1_saved: List[int64, mem(normal)] <- n1_neighbors;
    n2_saved: List[int64, mem(normal)] <- n2_neighbors;
    nc_ok: int64 <- graph_adj_validate_node_count_range(node_count_saved);
    n0_ok: int64 <- graph_adj_validate_int64_list_all_in_range(n0_saved, node_count_saved);
    n1_ok: int64 <- graph_adj_validate_int64_list_all_in_range(n1_saved, node_count_saved);
    n2_ok: int64 <- graph_adj_validate_int64_list_all_in_range(n2_saved, node_count_saved);
    count_ok: int64 <- graph_adj_validate_flat_directed_edge_count(
        node_count_saved,
        edge_count_saved,
        n0_saved,
        n1_saved,
        n2_saved
    );
    case nc_ok of {
        0 -> 0;
        1 -> case n0_ok of {
            0 -> 0;
            1 -> case n1_ok of {
                0 -> 0;
                1 -> case n2_ok of {
                    0 -> 0;
                    1 -> count_ok;
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        _: int64 -> 0
    }
}

fn graph_adj_validate_flat_unweighted_undirected(
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
) -> int64 {
    node_count_saved: int64 <- node_count;
    edge_count_saved: int64 <- edge_count;
    n0_saved: List[int64, mem(normal)] <- n0_neighbors;
    n1_saved: List[int64, mem(normal)] <- n1_neighbors;
    n2_saved: List[int64, mem(normal)] <- n2_neighbors;
    nc_ok: int64 <- graph_adj_validate_node_count_range(node_count_saved);
    n0_ok: int64 <- graph_adj_validate_int64_list_all_in_range(n0_saved, node_count_saved);
    n1_ok: int64 <- graph_adj_validate_int64_list_all_in_range(n1_saved, node_count_saved);
    n2_ok: int64 <- graph_adj_validate_int64_list_all_in_range(n2_saved, node_count_saved);
    count_ok: int64 <- graph_adj_validate_flat_undirected_edge_count(
        node_count_saved,
        edge_count_saved,
        n0_saved,
        n1_saved,
        n2_saved
    );
    case nc_ok of {
        0 -> 0;
        1 -> case n0_ok of {
            0 -> 0;
            1 -> case n1_ok of {
                0 -> 0;
                1 -> case n2_ok of {
                    0 -> 0;
                    1 -> count_ok;
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        _: int64 -> 0
    }
}

fn graph_adj_validate_flat_weighted_int64_directed(
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
) -> int64 {
    node_count_saved: int64 <- node_count;
    edge_count_saved: int64 <- edge_count;
    n0_saved: List[{ to: int64, weight: int64 }, mem(normal)] <- n0_neighbors;
    n1_saved: List[{ to: int64, weight: int64 }, mem(normal)] <- n1_neighbors;
    n2_saved: List[{ to: int64, weight: int64 }, mem(normal)] <- n2_neighbors;
    nc_ok: int64 <- graph_adj_validate_node_count_range(node_count_saved);
    n0_ok: int64 <- graph_adj_validate_weighted_int64_list_all_in_range(n0_saved, node_count_saved);
    n1_ok: int64 <- graph_adj_validate_weighted_int64_list_all_in_range(n1_saved, node_count_saved);
    n2_ok: int64 <- graph_adj_validate_weighted_int64_list_all_in_range(n2_saved, node_count_saved);
    count_ok: int64 <- graph_adj_validate_flat_weighted_int64_edge_count(
        node_count_saved,
        edge_count_saved,
        n0_saved,
        n1_saved,
        n2_saved
    );
    case nc_ok of {
        0 -> 0;
        1 -> case n0_ok of {
            0 -> 0;
            1 -> case n1_ok of {
                0 -> 0;
                1 -> case n2_ok of {
                    0 -> 0;
                    1 -> count_ok;
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        _: int64 -> 0
    }
}
