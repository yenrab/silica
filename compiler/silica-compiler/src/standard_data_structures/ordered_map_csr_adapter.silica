use btree_csr_map;

export contains_key_csr/2;
export get_csr/2;

fn contains_key_csr(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        values: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> boolean {
    sequence
        found: int64 <- btree_csr_map@contains_key(map, key);
        result: boolean <- case found of {
            0 -> false;
            _: int64 -> true
        }
    produces
        pure result
    end
}

fn get_csr(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        values: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> { found: int64, value: int64 } {
    sequence proc[mem(normal)]
        result: { found: int64, value: int64 } <- btree_csr_map@get[int64, int64, mem(normal)](map, key)
    produces
        pure result
    end
}
