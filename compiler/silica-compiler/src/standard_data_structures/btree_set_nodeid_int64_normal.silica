fn btree_set_nodeid_int64_normal_insert_root_leaf(key: int64) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64
} {
    sequence proc[mem(normal)]
        root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            btree_set_nodeid_int64_normal_make_leaf_node(0, key);
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)](root, empty_nodes);
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: 0,
            node_count: 1,
            order: btree_set_nodeid_int64_normal_order(),
            nodes: nodes
        };
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64
        } <- { tree: tree, inserted: 1 }
    produces
        pure result
    end
}

fn btree_set_nodeid_int64_normal_split_child_found(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    parent: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    child: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    child_index: int64
) -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence proc[mem(normal)]
        promoted_key: int64 <- btree_set_nodeid_int64_normal_nth_int64(child.keys, 3);
        left_keys: List[int64, mem(normal)] <- btree_set_nodeid_int64_normal_take_int64(child.keys, 3);
        right_keys: List[int64, mem(normal)] <- btree_set_nodeid_int64_normal_drop_int64(child.keys, 4);
        empty_children: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        left_children_candidate: List[int64, mem(normal)] <- btree_set_nodeid_int64_normal_take_int64(child.children, 4);
        right_children_candidate: List[int64, mem(normal)] <- btree_set_nodeid_int64_normal_drop_int64(child.children, 4);
        left_children: List[int64, mem(normal)] <- case child.is_leaf of {
            1 -> empty_children;
            _: int64 -> left_children_candidate
        };
        right_children: List[int64, mem(normal)] <- case child.is_leaf of {
            1 -> empty_children;
            _: int64 -> right_children_candidate
        };
        left_key_count: int64 <- btree_set_nodeid_int64_normal_list_int64_length(left_keys);
        right_key_count: int64 <- btree_set_nodeid_int64_normal_list_int64_length(right_keys);
        left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: child.id,
            key_count: left_key_count,
            is_leaf: child.is_leaf,
            keys: left_keys,
            children: left_children
        };
        right_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: tree.node_count,
            key_count: right_key_count,
            is_leaf: child.is_leaf,
            keys: right_keys,
            children: right_children
        };
        parent_keys: List[int64, mem(normal)] <- btree_set_nodeid_int64_normal_insert_int64_at(parent.keys, child_index, promoted_key);
        parent_children: List[int64, mem(normal)] <- btree_set_nodeid_int64_normal_insert_int64_at(parent.children, child_index + 1, tree.node_count);
        parent_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: parent.id,
            key_count: parent.key_count + 1,
            is_leaf: 0,
            keys: parent_keys,
            children: parent_children
        };
        nodes_with_left: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            btree_set_nodeid_int64_normal_replace_node(tree.nodes, child.id, left_node);
        nodes_with_parent: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            btree_set_nodeid_int64_normal_replace_node(nodes_with_left, parent.id, parent_node);
        nodes_final: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            btree_set_nodeid_int64_normal_prepend_node(right_node, nodes_with_parent);
        result: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: tree.root_id,
            node_count: tree.node_count + 1,
            order: tree.order,
            nodes: nodes_final
        }
    produces
        pure result
    end
}

fn btree_set_nodeid_int64_normal_split_child(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    parent_id: int64,
    child_index: int64
) -> {
