        new_root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            btree_set_nodeid_int64_normal_make_internal_root(tree.node_count, tree.root_id);
        nodes_with_new_root: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            btree_set_nodeid_int64_normal_prepend_node(new_root, tree.nodes);
        tree_with_new_root: {
