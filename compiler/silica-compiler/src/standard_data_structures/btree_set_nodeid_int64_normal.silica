        true -> key_count;
        false -> do
            current: int64 <- btree_set_nodeid_int64_normal_nth_int64(keys, index);
            case key < current of {
                true -> index;
                false -> case current == key of {
                    true -> index;
                    false -> btree_set_nodeid_int64_normal_search_key_slot_by_index(keys, key, index + 1, key_count)
                }
            }
        end
    }
}

