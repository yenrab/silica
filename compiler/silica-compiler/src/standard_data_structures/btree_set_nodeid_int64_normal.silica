        } <- {
            root_id: new_root.id,
            node_count: tree.node_count + 1,
            order: tree.order,
            nodes: nodes_with_new_root
        };
        split_tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- btree_set_nodeid_int64_normal_split_child(tree_with_new_root, new_root.id, 0);
        inserted_tree: {
