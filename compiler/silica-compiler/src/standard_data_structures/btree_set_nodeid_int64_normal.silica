        head_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- head;
        tail_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tail;
        node_id_saved: int64 <- node_id;
        replacement_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- replacement;
        is_match: int64 <- case head_saved.id == node_id_saved of {
            true -> 1;
            false -> 0
        };
        result: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- case is_match of {
            1 -> btree_set_nodeid_int64_normal_prepend_node(replacement_saved, tail_saved);
            _: int64 -> btree_set_nodeid_int64_normal_prepend_node(head_saved, btree_set_nodeid_int64_normal_replace_node(tail_saved, node_id_saved, replacement_saved))
        }
    produces
        pure result
    end
}

