fn btree_set_nodeid_int64_normal_node_id_in_range(node_id: int64, node_count: int64) -> int64 {
    case node_id >= 0 of {
        false -> 0;
        true -> case node_id < node_count of {
            true -> 1;
            false -> 0
        }
    }
}

fn btree_set_nodeid_int64_normal_child_ids_valid(children: List[int64, mem(normal)], node_count: int64) -> int64 {
    case children of {
        []: List[int64, mem(normal)] -> 1;
        [head: int64, tail: List[int64, mem(normal)]] -> case btree_set_nodeid_int64_normal_node_id_in_range(head, node_count) == 1 of {
            true -> btree_set_nodeid_int64_normal_child_ids_valid(tail, node_count);
            false -> 0
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn btree_set_nodeid_int64_normal_node_basic_error(
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64,
    node_count: int64
) -> int64 {
    sequence proc[]
        node_id_saved: int64 <- node.id;
        key_count_saved: int64 <- node.key_count;
        is_leaf_saved: int64 <- node.is_leaf;
        keys_saved: List[int64, mem(normal)] <- node.keys;
        children_saved: List[int64, mem(normal)] <- node.children;
        root_saved: int64 <- root_id;
        node_count_saved: int64 <- node_count;
        key_len: int64 <- btree_set_nodeid_int64_normal_list_int64_length(keys_saved);
        child_len: int64 <- btree_set_nodeid_int64_normal_list_int64_length(children_saved);
        id_count: int64 <- btree_set_nodeid_int64_normal_node_id_count(all_nodes, node_id_saved);
        result: int64 <- case btree_set_nodeid_int64_normal_node_id_in_range(node_id_saved, node_count_saved) == 1 of {
            false -> 3;
            true -> case id_count == 1 of {
                false -> 2;
                true -> case key_len == key_count_saved of {
                    false -> 4;
                    true -> case key_count_saved <= btree_set_nodeid_int64_normal_max_keys() of {
                        false -> 8;
                        true -> case btree_set_nodeid_int64_normal_non_root_occupancy_ok(node_id_saved, root_saved, key_count_saved) == 1 of {
                            false -> 8;
                            true -> case btree_set_nodeid_int64_normal_keys_sorted_unique(keys_saved) == 1 of {
                                false -> 5;
                                true -> btree_set_nodeid_int64_normal_child_shape_error(is_leaf_saved, key_count_saved, children_saved, child_len, node_count_saved)
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}

fn btree_set_nodeid_int64_normal_non_root_occupancy_ok(node_id: int64, root_id: int64, key_count: int64) -> int64 {
    case node_id == root_id of {
        true -> 1;
        false -> case key_count >= btree_set_nodeid_int64_normal_min_keys_non_root() of {
            true -> 1;
            false -> 0
        }
    }
}

fn btree_set_nodeid_int64_normal_child_shape_error(
    is_leaf: int64,
    key_count: int64,
    children: List[int64, mem(normal)],
    child_len: int64,
    node_count: int64
) -> int64 {
    case is_leaf of {
        1 -> case child_len == 0 of {
            true -> 0;
            false -> 7
        };
        _: int64 -> case child_len == key_count + 1 of {
            false -> 7;
            true -> case btree_set_nodeid_int64_normal_child_ids_valid(children, node_count) == 1 of {
                true -> 0;
                false -> 3
            }
        }
    }
}

fn btree_set_nodeid_int64_normal_nodes_basic_error(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64,
    node_count: int64
) -> int64 {
    case nodes of {
        []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0;
        [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            btree_set_nodeid_int64_normal_nodes_basic_error_cons(head, tail, all_nodes, root_id, node_count);
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 4
    }
}

fn btree_set_nodeid_int64_normal_nodes_basic_error_cons(
    head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64,
    node_count: int64
) -> int64 {
    sequence proc[]
        tail_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tail;
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        node_count_saved: int64 <- node_count;
        head_err: int64 <- btree_set_nodeid_int64_normal_node_basic_error(head, all_nodes_saved, root_saved, node_count_saved);
        tail_err: int64 <- btree_set_nodeid_int64_normal_nodes_basic_error(tail_saved, all_nodes_saved, root_saved, node_count_saved);
        result: int64 <- btree_set_nodeid_int64_normal_first_error(head_err, tail_err)
    produces
        pure result
    end
