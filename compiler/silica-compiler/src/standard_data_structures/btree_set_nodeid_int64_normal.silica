        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        range_err: int64 <- case btree_set_nodeid_int64_normal_range_ok(all_nodes_saved, root_saved, 0, 0, 0, 0) == 1 of {
            true -> 0;
            false -> 10
        };
        result: int64 <- range_err
    produces
        pure result
    end
}

fn btree_set_nodeid_int64_normal_validate_error(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    case tree.order == btree_set_nodeid_int64_normal_order() of {
        false -> 8;
        true -> case tree.node_count of {
            0 -> btree_set_nodeid_int64_normal_validate_empty(tree);
            _: int64 -> btree_set_nodeid_int64_normal_validate_nonempty(tree)
        }
    }
}

fn btree_set_nodeid_int64_normal_validate(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> { ok: int64, error_code: int64 } {
    sequence proc[]
        err: int64 <- btree_set_nodeid_int64_normal_validate_error(tree);
        ok_value: int64 <- case err of {
            0 -> 1;
            _: int64 -> 0
        };
        result: { ok: int64, error_code: int64 } <- {
            ok: ok_value,
            error_code: err
        }
    produces
        pure result
    end
}
