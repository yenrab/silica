} {
    sequence proc[mem(normal)]
        parent_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            btree_set_nodeid_int64_normal_find_node(tree.nodes, parent_id);
        parent_found: int64 <- btree_set_nodeid_int64_normal_node_exists(tree.nodes, parent_id);
        child_id: int64 <- btree_set_nodeid_int64_normal_nth_int64(parent_result.children, child_index);
        child_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            btree_set_nodeid_int64_normal_find_node(tree.nodes, child_id);
        child_found: int64 <- btree_set_nodeid_int64_normal_node_exists(tree.nodes, child_id);
        result: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- case parent_found of {
            0 -> tree;
            _: int64 -> case child_found of {
                0 -> tree;
                _: int64 -> btree_set_nodeid_int64_normal_split_child_found(tree, parent_result, child_result, child_index)
            }
        }
    produces
