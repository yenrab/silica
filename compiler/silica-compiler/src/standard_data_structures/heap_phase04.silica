export empty/1;
export push/2;

fn empty(functions: { compare_priority: fn(int64, int64) -> atom }) -> {
    compare_priority: fn(int64, int64) -> atom
} {
    functions
}

fn push(
    heap: { compare_priority: fn(int64, int64) -> atom },
    item: int64
) -> { compare_priority: fn(int64, int64) -> atom } {
    heap
}
