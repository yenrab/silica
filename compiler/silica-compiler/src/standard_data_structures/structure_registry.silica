// Families are listed by index via structure_family_name_at/1 (0 .. structure_family_count()-1).

fn structure_family_count() -> int64 {
    24
}

fn structure_family_name_at(index: int64) -> string {
    case index of {
        0 -> "NodeIdAdjacencyGraphDirectedUnweighted";
        1 -> "NodeIdAdjacencyGraphUndirectedUnweighted";
        2 -> "NodeIdAdjacencyGraphDirectedWeightedInt64";
        3 -> "NodeIdAdjacencyGraphUndirectedWeightedInt64";
        4 -> "CompressedSparseRowGraphDirectedUnweighted";
        5 -> "CompressedSparseRowGraphUndirectedUnweighted";
        6 -> "CompressedSparseRowGraphDirectedWeightedInt64";
        7 -> "CompressedSparseRowGraphUndirectedWeightedInt64";
        8 -> "DenseMatrixGraphDirectedUnweighted";
        9 -> "DenseMatrixGraphUndirectedUnweighted";
        10 -> "DenseMatrixGraphDirectedWeightedInt64";
        11 -> "DenseMatrixGraphUndirectedWeightedInt64";
        12 -> "DenseBitsetGraphDirectedUnweighted";
        13 -> "DenseBitsetGraphUndirectedUnweighted";
        14 -> "NodeIDBTreeSetInt64";
        15 -> "CsrBTreeSetInt64";
        16 -> "NodeIDBTreeInt64";
        17 -> "NodeIDBTreeMapInt64ToInt64";
        18 -> "CsrBTreeInt64";
        19 -> "CsrBTreeMapInt64ToInt64";
        20 -> "RegionBinaryMinHeapInt64";
        21 -> "RegionBinaryMaxHeapInt64";
        22 -> "RegionBinaryMinHeapPriorityInt64ValueInt64";
        23 -> "RegionDaryMinHeapInt64";
        _: int64 -> ""
    }
}

