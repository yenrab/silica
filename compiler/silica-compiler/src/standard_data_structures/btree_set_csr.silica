fn insert_leaf_keys_csr(
    keys_buf: buf(L1, normal, int64, 7),
    key: int64,
    old_count: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    inserted: int64
} {
    sequence proc[mem(normal)]
        keys_saved: buf(L1, normal, int64, 7) <- keys_buf;
        key_saved: int64 <- key;
        old_count_saved: int64 <- old_count;
        k0: int64 <- read_buf(keys_saved, 0);
        k1: int64 <- read_buf(keys_saved, 1);
        k2: int64 <- read_buf(keys_saved, 2);
        k3: int64 <- read_buf(keys_saved, 3);
        k4: int64 <- read_buf(keys_saved, 4);
        k5: int64 <- read_buf(keys_saved, 5);
        pos: int64 <- csr_insert_pos(k0, k1, k2, k3, k4, k5, old_count_saved, key_saved);
        new_tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- case pos of {
            0 -> build_leaf_ins0(old_count_saved, key_saved, k0, k1, k2, k3, k4, k5);
            1 -> build_leaf_ins1(old_count_saved, k0, key_saved, k1, k2, k3, k4, k5);
            2 -> build_leaf_ins2(old_count_saved, k0, k1, key_saved, k2, k3, k4, k5);
            3 -> build_leaf_ins3(old_count_saved, k0, k1, k2, key_saved, k3, k4, k5);
            4 -> build_leaf_ins4(old_count_saved, k0, k1, k2, k3, key_saved, k4, k5);
            5 -> build_leaf_ins5(old_count_saved, k0, k1, k2, k3, k4, key_saved, k5);
            _: int64 -> build_leaf_ins6(old_count_saved, k0, k1, k2, k3, k4, k5, key_saved)
        }
        result: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64
        } <- wrap_insert_result(new_tree, 1)
    produces
        pure result
    end
}

// Allocate a fresh single-leaf CsrBTreeSet with key_count keys k0..k6.
// Only k0..k(key_count-1) are meaningful; the rest are written but ignored
// by contains and validate (which respect node_key_count).
fn build_leaf_csr(
    k0: int64,
    k1: int64,
    k2: int64,
    k3: int64,
    k4: int64,
    k5: int64,
    k6: int64,
    key_count: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 1),
    node_key_count: buf(L1, normal, int64, 1),
    node_child_start: buf(L1, normal, int64, 1),
    node_child_count: buf(L1, normal, int64, 1),
    node_is_leaf: buf(L1, normal, int64, 1),
    keys: buf(L1, normal, int64, 7),
    children: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]
        k0_saved: int64 <- k0;
        k1_saved: int64 <- k1;
        k2_saved: int64 <- k2;
        k3_saved: int64 <- k3;
        k4_saved: int64 <- k4;
        k5_saved: int64 <- k5;
        k6_saved: int64 <- k6;
        key_count_saved: int64 <- key_count;
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        node_key_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_key_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_is_leaf: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        keys: buf(L1, normal, int64, 7) <- alloc_buf(r, 7);
        children: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        _: atom <- write_buf(node_key_start, 0, 0);
        _: atom <- write_buf(node_key_count, 0, key_count_saved);
        _: atom <- write_buf(node_child_start, 0, 0);
        _: atom <- write_buf(node_child_count, 0, 0);
        _: atom <- write_buf(node_is_leaf, 0, 1);
        _: atom <- write_buf(keys, 0, k0_saved);
        _: atom <- write_buf(keys, 1, k1_saved);
        _: atom <- write_buf(keys, 2, k2_saved);
        _: atom <- write_buf(keys, 3, k3_saved);
        _: atom <- write_buf(keys, 4, k4_saved);
        _: atom <- write_buf(keys, 5, k5_saved);
        _: atom <- write_buf(keys, 6, k6_saved);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- {
            region: r,
            root_id: 0,
            node_count: 1,
            key_count_total: key_count_saved,
            order: 8,
            node_key_start: node_key_start,
            node_key_count: node_key_count,
            node_child_start: node_child_start,
            node_child_count: node_child_count,
            node_is_leaf: node_is_leaf,
            keys: keys,
            children: children
        }
    produces
        pure tree
    end
}

// Return tree with inserted flag (separate fn avoids stack copy in caller).
fn wrap_insert_result(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    inserted: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    inserted: int64
} {
    sequence proc[]
        result: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64
        } <- { tree: tree, inserted: inserted }
    produces
        pure result
    end
}

// Insert key into a non-empty single-leaf CsrBTreeSet.
fn insert_nonempty_csr(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    key: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    inserted: int64
} {
    sequence proc[]
        tree_saved: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- tree;
        key_saved: int64 <- key;
        keys_saved: buf(L1, normal, int64, 7) <- tree_saved.keys;
        has_key: int64 <- contains[int64, mem(normal)](tree_saved, key_saved);
        old_count: int64 <- tree_saved.key_count_total;
        at_cap: int64 <- case old_count >= 7 of { true -> 1; false -> 0 };
        can_insert: int64 <- case has_key + at_cap of { 0 -> 1; _: int64 -> 0 };
        result: {
            tree: {
                region: region(L1, normal),
                root_id: int64,
                node_count: int64,
                key_count_total: int64,
                order: int64,
                node_key_start: buf(L1, normal, int64, 1),
                node_key_count: buf(L1, normal, int64, 1),
                node_child_start: buf(L1, normal, int64, 1),
                node_child_count: buf(L1, normal, int64, 1),
                node_is_leaf: buf(L1, normal, int64, 1),
                keys: buf(L1, normal, int64, 7),
                children: buf(L1, normal, int64, 8)
            },
            inserted: int64
        } <- case can_insert of {
            0 -> wrap_insert_result(tree_saved, 0);
            _: int64 -> insert_leaf_keys_csr(keys_saved, key_saved, old_count)
        }
    produces
        pure result
    end
}

// Functional insert: returns a new CsrBTreeSet with key added in sorted order.
// The original tree is never modified. inserted=1 means the key was newly added;
// inserted=0 means it was already present or the bootstrap KEY_CAP (7) is full.
fn insert[int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    key: int64
) -> {
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    inserted: int64
} {
    case tree.root_id of {
        -1 -> {
            sequence proc[mem(normal)]
                key_saved: int64 <- key;
                new_tree: {
                    region: region(L1, normal),
                    root_id: int64,
                    node_count: int64,
                    key_count_total: int64,
                    order: int64,
                    node_key_start: buf(L1, normal, int64, 1),
                    node_key_count: buf(L1, normal, int64, 1),
                    node_child_start: buf(L1, normal, int64, 1),
                    node_child_count: buf(L1, normal, int64, 1),
                    node_is_leaf: buf(L1, normal, int64, 1),
                    keys: buf(L1, normal, int64, 7),
                    children: buf(L1, normal, int64, 8)
                } <- build_leaf_csr(key_saved, 0, 0, 0, 0, 0, 0, 1);
                result: {
                    tree: {
                        region: region(L1, normal),
                        root_id: int64,
                        node_count: int64,
                        key_count_total: int64,
                        order: int64,
                        node_key_start: buf(L1, normal, int64, 1),
                        node_key_count: buf(L1, normal, int64, 1),
                        node_child_start: buf(L1, normal, int64, 1),
                        node_child_count: buf(L1, normal, int64, 1),
                        node_is_leaf: buf(L1, normal, int64, 1),
                        keys: buf(L1, normal, int64, 7),
                        children: buf(L1, normal, int64, 8)
                    },
                    inserted: int64
                } <- wrap_insert_result(new_tree, 1)
            produces
                pure result
            end
        };
        _: int64 -> insert_nonempty_csr(tree, key)
    }
}
