// Copyright 2026 Lee Scott Barney — Apache License 2.0
// CsrBTreeSet[int64, mem(normal)] (btree_set_design.md §4.1).
// Bootstrap generated family: order 8, single-leaf, NODE_CAP=1, KEY_CAP=7.
// Immutable functional data structure: insert returns a new CsrBTreeSet value;
// old values remain valid (structural-sharing principle — no in-place mutation).

export empty[int64, mem(normal)]/0;
export from_static_sorted[int64, mem(normal)]/0;
export contains[int64, mem(normal)]/2;
export insert[int64, mem(normal)]/2;
export validate[int64, mem(normal)]/1;

fn order() -> int64 {
    8
}

fn node_cap() -> int64 {
    1
}

fn key_cap() -> int64 {
    7
}

fn child_cap() -> int64 {
    8
}

fn first_error(first: int64, second: int64) -> int64 {
    case first of {
        0 -> second;
        _: int64 -> first
    }
}

fn key_equal(left: int64, right: int64) -> int64 {
    case left == right of {
        true -> 1;
        false -> 0
    }
}

fn empty[int64, mem(normal)]() -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 1),
    node_key_count: buf(L1, normal, int64, 1),
    node_child_start: buf(L1, normal, int64, 1),
    node_child_count: buf(L1, normal, int64, 1),
    node_is_leaf: buf(L1, normal, int64, 1),
    keys: buf(L1, normal, int64, 7),
    children: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        node_key_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_key_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_is_leaf: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        keys: buf(L1, normal, int64, 7) <- alloc_buf(r, 7);
        children: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- {
            region: r,
            root_id: -1,
            node_count: 0,
            key_count_total: 0,
            order: order(),
            node_key_start: node_key_start,
            node_key_count: node_key_count,
            node_child_start: node_child_start,
            node_child_count: node_child_count,
            node_is_leaf: node_is_leaf,
            keys: keys,
            children: children
        }
    produces
        pure tree
    end
}

fn from_static_sorted[int64, mem(normal)]() -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 1),
    node_key_count: buf(L1, normal, int64, 1),
    node_child_start: buf(L1, normal, int64, 1),
    node_child_count: buf(L1, normal, int64, 1),
    node_is_leaf: buf(L1, normal, int64, 1),
    keys: buf(L1, normal, int64, 7),
    children: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        node_key_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_key_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_is_leaf: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        keys: buf(L1, normal, int64, 7) <- alloc_buf(r, 7);
        children: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        _: atom <- write_buf(node_key_start, 0, 0);
        _: atom <- write_buf(node_key_count, 0, 3);
        _: atom <- write_buf(node_child_start, 0, 0);
        _: atom <- write_buf(node_child_count, 0, 0);
        _: atom <- write_buf(node_is_leaf, 0, 1);
        _: atom <- write_buf(keys, 0, 1);
        _: atom <- write_buf(keys, 1, 3);
        _: atom <- write_buf(keys, 2, 5);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- {
            region: r,
            root_id: 0,
            node_count: 1,
            key_count_total: 3,
            order: 8,
            node_key_start: node_key_start,
            node_key_count: node_key_count,
            node_child_start: node_child_start,
            node_child_count: node_child_count,
            node_is_leaf: node_is_leaf,
            keys: keys,
            children: children
        }
    produces
        pure tree
    end
}

// Linear scan through the leaf key range looking for key.
// Returns 1 if found, 0 otherwise. Replaces the old hardcoded 3-key check.
fn contains_key_at(
    keys_buf: buf(L1, normal, int64, 7),
    key: int64,
    i: int64,
    count: int64
) -> int64 {
    case i >= count of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 7) <- keys_buf;
                key_saved: int64 <- key;
                count_saved: int64 <- count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki == key_saved of {
                    true -> 1;
                    false -> contains_key_at(keys_buf_saved, key_saved, i_saved + 1, count_saved)
                }
            produces
                pure result
            end
        }
    }
}

fn contains_bootstrap(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    key: int64
) -> int64 {
    case tree.node_count of {
        1 -> {
            sequence proc[mem(normal)]
                key_saved: int64 <- key;
                keys_saved: buf(L1, normal, int64, 7) <- tree.keys;
                key_count: int64 <- tree.key_count_total;
                result: int64 <- contains_key_at(keys_saved, key_saved, 0, key_count)
            produces
                pure result
            end
        };
        _: int64 -> 0
    }
}

fn contains[int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    key: int64
) -> int64 {
    sequence proc[]
        root_saved: int64 <- tree.root_id;
        key_saved: int64 <- key;
        result: int64 <- case root_saved of {
            -1 -> 0;
            _: int64 -> contains_bootstrap(tree, key_saved)
        }
    produces
        pure result
    end
}

// Check that keys_buf[i] < keys_buf[i+1] for all i in [0, key_count-2].
// Returns 0 for sorted, 5 (keys not sorted) on first violation.
fn keys_sorted_at(
    keys_buf: buf(L1, normal, int64, 7),
    key_count: int64,
    i: int64
) -> int64 {
    case i + 1 >= key_count of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 7) <- keys_buf;
                key_count_saved: int64 <- key_count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                kj: int64 <- read_buf(keys_buf_saved, i_saved + 1);
                result: int64 <- case ki < kj of {
                    true -> keys_sorted_at(keys_buf_saved, key_count_saved, i_saved + 1);
                    false -> 5
                }
            produces
                pure result
            end
        }
    }
}

fn validate_empty(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> int64 {
    case tree.root_id == -1 of {
        false -> 1;
        true -> case tree.key_count_total of {
            0 -> 0;
            _: int64 -> 1
        }
    }
}

// Validate the single root leaf node for any key count 1..key_cap().
fn validate_bootstrap_one(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> int64 {
    root_ok: int64 <- case tree.root_id of {
        0 -> 1;
        _: int64 -> 0
    };
    case root_ok of {
        0 -> 1;
        _: int64 -> case tree.key_count_total == 0 of {
            true -> 1;
            false -> case tree.key_count_total > 7 of {
                true -> 20;
                false -> {
                    sequence proc[mem(normal)]
                        result: int64 <- keys_sorted_at(tree.keys, tree.key_count_total, 0)
                    produces
                        pure result
                    end
                }
            }
        }
    }
}

fn validate_nonempty(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> int64 {
    count_ok: int64 <- case tree.node_count of {
        1 -> 1;
        _: int64 -> 0
    };
    total_ok: int64 <- case tree.key_count_total <= 7 of {
        true -> 1;
        false -> 0
    };
    case count_ok of {
        0 -> 4;
        _: int64 -> case total_ok of {
            0 -> 20;
            _: int64 -> validate_bootstrap_one(tree)
        }
    }
}

fn validate_error(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> int64 {
    case tree.order == order() of {
        false -> 8;
        true -> case tree.node_count of {
            0 -> validate_empty(tree);
            _: int64 -> validate_nonempty(tree)
        }
    }
}

fn validate[int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> { ok: int64, error_code: int64 } {
    sequence proc[]
        err: int64 <- validate_error(tree);
        ok_value: int64 <- case err of {
            0 -> 1;
            _: int64 -> 0
        };
        result: { ok: int64, error_code: int64 } <- {
            ok: ok_value,
            error_code: err
        }
    produces
        pure result
    end
}

// Find the position in sorted keys k0..k(count-1) where key should be inserted.
// Returns the first index i where k[i] > key, or count if key belongs at the end.
// Inlined scan avoids a 9-parameter recursive helper (AArch64 allows at most 8 reg args).
fn csr_insert_pos(
    k0: int64,
    k1: int64,
    k2: int64,
    k3: int64,
    k4: int64,
    k5: int64,
    count: int64,
    key: int64
) -> int64 {
    case count <= 0 of {
        true -> 0;
        false -> case k0 > key of {
            true -> 0;
            false -> case count <= 1 of {
                true -> 1;
                false -> case k1 > key of {
                    true -> 1;
                    false -> case count <= 2 of {
                        true -> 2;
                        false -> case k2 > key of {
                            true -> 2;
                            false -> case count <= 3 of {
                                true -> 3;
                                false -> case k3 > key of {
                                    true -> 3;
                                    false -> case count <= 4 of {
                                        true -> 4;
                                        false -> case k4 > key of {
                                            true -> 4;
                                            false -> case count <= 5 of {
                                                true -> 5;
                                                false -> case k5 > key of {
                                                    true -> 5;
                                                    false -> count
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Per-index helpers for output key after inserting new_key at pos into k0..k5.
// Splitting by out_i avoids a 9-parameter generic function (AArch64 limit: 8 reg args).
// Rule: out_i < pos → k[out_i]; out_i == pos → new_key; out_i > pos → k[out_i-1].
fn csr_out_key_0(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 0 of { true -> new_key; false -> k0 }
}

fn csr_out_key_1(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 1 of { true -> new_key; false -> case pos < 1 of { true -> k0; false -> k1 } }
}

fn csr_out_key_2(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 2 of { true -> new_key; false -> case pos < 2 of { true -> k1; false -> k2 } }
}

fn csr_out_key_3(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 3 of { true -> new_key; false -> case pos < 3 of { true -> k2; false -> k3 } }
}

fn csr_out_key_4(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 4 of { true -> new_key; false -> case pos < 4 of { true -> k3; false -> k4 } }
}

fn csr_out_key_5(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 5 of { true -> new_key; false -> case pos < 5 of { true -> k4; false -> k5 } }
}

fn csr_out_key_6(k0: int64, k1: int64, k2: int64, k3: int64, k4: int64, k5: int64, new_key: int64, pos: int64) -> int64 {
    case pos == 6 of { true -> new_key; false -> k5 }
}

// Buffer-based insert helpers: read one key at a time to avoid register pressure
// when scanning or building output keys (k0..k5 no longer all live at once).
fn csr_insert_pos_from_buf(
    keys_buf: buf(L1, normal, int64, 7),
    i: int64,
    count: int64,
    key: int64
) -> int64 {
    case i >= count of {
        true -> i;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 7) <- keys_buf;
                key_saved: int64 <- key;
                count_saved: int64 <- count;
                i_saved: int64 <- i;
                ki: int64 <- read_buf(keys_buf_saved, i_saved);
                result: int64 <- case ki > key_saved of {
                    true -> i_saved;
                    false -> csr_insert_pos_from_buf(keys_buf_saved, i_saved + 1, count_saved, key_saved)
                }
            produces
                pure result
            end
        }
    }
}

fn csr_out_key_from_buf(
    keys_buf: buf(L1, normal, int64, 7),
    out_i: int64,
    new_key: int64,
    pos: int64
) -> int64 {
    case out_i == pos of {
        true -> new_key;
        false -> {
            sequence proc[mem(normal)]
                keys_buf_saved: buf(L1, normal, int64, 7) <- keys_buf;
                out_i_saved: int64 <- out_i;
                pos_saved: int64 <- pos;
                src_i: int64 <- case out_i_saved < pos_saved of {
                    true -> out_i_saved;
                    false -> out_i_saved - 1
                };
                result: int64 <- read_buf(keys_buf_saved, src_i)
            produces
                pure result
            end
        }
    }
}

// Write all seven key slots after insert-at-pos shuffle in one function so nk
// is saved to a callee-saved register once and survives every csr_out_key_from_buf call.
fn fill_seven_csr_keys(
    nk: buf(L1, normal, int64, 7),
    keys_buf: buf(L1, normal, int64, 7),
    new_key: int64,
    pos: int64
) -> atom {
    sequence proc[mem(normal)]
        nk_saved: buf(L1, normal, int64, 7) <- nk;
        keys_saved: buf(L1, normal, int64, 7) <- keys_buf;
        new_key_saved: int64 <- new_key;
        pos_saved: int64 <- pos;
        o0: int64 <- csr_out_key_from_buf(keys_saved, 0, new_key_saved, pos_saved);
        _: atom <- write_buf(nk_saved, 0, o0);
        o1: int64 <- csr_out_key_from_buf(keys_saved, 1, new_key_saved, pos_saved);
        _: atom <- write_buf(nk_saved, 1, o1);
        o2: int64 <- csr_out_key_from_buf(keys_saved, 2, new_key_saved, pos_saved);
        _: atom <- write_buf(nk_saved, 2, o2);
        o3: int64 <- csr_out_key_from_buf(keys_saved, 3, new_key_saved, pos_saved);
        _: atom <- write_buf(nk_saved, 3, o3);
        o4: int64 <- csr_out_key_from_buf(keys_saved, 4, new_key_saved, pos_saved);
        _: atom <- write_buf(nk_saved, 4, o4);
        o5: int64 <- csr_out_key_from_buf(keys_saved, 5, new_key_saved, pos_saved);
        _: atom <- write_buf(nk_saved, 5, o5);
        o6: int64 <- csr_out_key_from_buf(keys_saved, 6, new_key_saved, pos_saved);
        result: atom <- write_buf(nk_saved, 6, o6)
    produces
        pure result
    end
}

// Write one output key slot after insert-at-pos shuffle. Isolated in its own
// function so nk is saved to a callee-saved register before csr_out_key_from_buf.
fn write_csr_key_at(
    nk: buf(L1, normal, int64, 7),
    keys_buf: buf(L1, normal, int64, 7),
    out_i: int64,
    new_key: int64,
    pos: int64
) -> atom {
    sequence proc[mem(normal)]
        nk_saved: buf(L1, normal, int64, 7) <- nk;
        keys_saved: buf(L1, normal, int64, 7) <- keys_buf;
        out_i_saved: int64 <- out_i;
        new_key_saved: int64 <- new_key;
        pos_saved: int64 <- pos;
        o: int64 <- csr_out_key_from_buf(keys_saved, out_i_saved, new_key_saved, pos_saved);
        result: atom <- write_buf(nk_saved, out_i_saved, o)
    produces
        pure result
    end
}

// Build a new single-leaf tree by inserting new_key at pos into keys_buf[0..new_count-1].
fn build_leaf_csr_insert(
    keys_buf: buf(L1, normal, int64, 7),
    new_key: int64,
    pos: int64,
    new_count: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 1),
    node_key_count: buf(L1, normal, int64, 1),
    node_child_start: buf(L1, normal, int64, 1),
    node_child_count: buf(L1, normal, int64, 1),
    node_is_leaf: buf(L1, normal, int64, 1),
    keys: buf(L1, normal, int64, 7),
    children: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]
        keys_buf_saved: buf(L1, normal, int64, 7) <- keys_buf;
        new_key_saved: int64 <- new_key;
        pos_saved: int64 <- pos;
        new_count_saved: int64 <- new_count;
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        nk: buf(L1, normal, int64, 7) <- alloc_buf(r, 7);
        nk_saved: buf(L1, normal, int64, 7) <- nk;
        _: atom <- fill_seven_csr_keys(nk_saved, keys_buf_saved, new_key_saved, pos_saved);
        nks: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        nkc: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        ncs: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        ncc: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        nil_buf: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        nc: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        _: atom <- write_buf(nks, 0, 0);
        _: atom <- write_buf(nkc, 0, new_count_saved);
        _: atom <- write_buf(ncs, 0, 0);
        _: atom <- write_buf(ncc, 0, 0);
        _: atom <- write_buf(nil_buf, 0, 1);
        r_saved: region(L1, normal) <- r;
        nks_saved: buf(L1, normal, int64, 1) <- nks;
        nkc_saved: buf(L1, normal, int64, 1) <- nkc;
        ncs_saved: buf(L1, normal, int64, 1) <- ncs;
        ncc_saved: buf(L1, normal, int64, 1) <- ncc;
        nil_buf_saved: buf(L1, normal, int64, 1) <- nil_buf;
        nc_saved: buf(L1, normal, int64, 8) <- nc;
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- {
            region: r_saved,
            root_id: 0,
            node_count: 1,
            key_count_total: new_count_saved,
            order: 8,
            node_key_start: nks_saved,
            node_key_count: nkc_saved,
            node_child_start: ncs_saved,
            node_child_count: ncc_saved,
            node_is_leaf: nil_buf_saved,
            keys: nk_saved,
            children: nc_saved
        }
    produces
        pure tree
    end
}

// Per-position leaf builders: old_count is arg0 so new_count is computed inside
// the helper after args are saved, avoiding emitter clobber of the count register.
fn build_leaf_ins0(
    old_count: int64,
    new_key: int64,
    k0: int64,
    k1: int64,
    k2: int64,
    k3: int64,
    k4: int64,
    k5: int64
) -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 1),
    node_key_count: buf(L1, normal, int64, 1),
    node_child_start: buf(L1, normal, int64, 1),
    node_child_count: buf(L1, normal, int64, 1),
    node_is_leaf: buf(L1, normal, int64, 1),
    keys: buf(L1, normal, int64, 7),
    children: buf(L1, normal, int64, 8)
} {
    sequence proc[]
        old_count_saved: int64 <- old_count;
        result: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- build_leaf_csr(new_key, k0, k1, k2, k3, k4, k5, old_count_saved + 1)
    produces
        pure result
    end
}

