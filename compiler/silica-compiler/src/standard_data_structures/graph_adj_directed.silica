fn add_edge_checked[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    updated_graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    } <- add_edge[mem(normal)](graph, from_saved, to_saved);
    { ok: endpoints_ok, graph: updated_graph }
}

fn add_edge[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    use0: int64 <- case from_saved of {
        0 -> endpoints_ok;
        _: int64 -> 0
    };
    use1: int64 <- case from_saved of {
        1 -> endpoints_ok;
        _: int64 -> 0
    };
    use2: int64 <- case from_saved of {
        2 -> endpoints_ok;
        _: int64 -> 0
    };
    sequence proc[mem(normal)]
        candidate0: List[int64, mem(normal)] <- prepend_slot(graph.n0_neighbors, to_saved);
        candidate1: List[int64, mem(normal)] <- prepend_slot(graph.n1_neighbors, to_saved);
        candidate2: List[int64, mem(normal)] <- prepend_slot(graph.n2_neighbors, to_saved);
        next_n0: List[int64, mem(normal)] <- case use0 of {
            0 -> graph.n0_neighbors;
            1 -> candidate0;
            _: int64 -> graph.n0_neighbors
        };
        next_n1: List[int64, mem(normal)] <- case use1 of {
            0 -> graph.n1_neighbors;
            1 -> candidate1;
            _: int64 -> graph.n1_neighbors
        };
        next_n2: List[int64, mem(normal)] <- case use2 of {
            0 -> graph.n2_neighbors;
            1 -> candidate2;
            _: int64 -> graph.n2_neighbors
        };
        next_edge_count: int64 <- case endpoints_ok of {
            0 -> graph.edge_count;
            1 -> graph.edge_count + 1;
            _: int64 -> graph.edge_count
        };
        updated: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: graph.node_count,
            edge_count: next_edge_count,
            n0_neighbors: next_n0,
            n1_neighbors: next_n1,
            n2_neighbors: next_n2
        }
    produces
        pure updated
    end
}

fn neighbors_checked[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: List[int64, mem(normal)] } {
    node_saved: int64 <- node_id;
    in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(node_saved, graph.node_count);
    empty_neighbors: List[int64, mem(normal)] <- empty_int64_list();
    neighbors: List[int64, mem(normal)] <- neighbors_list(
        graph,
        node_saved,
        empty_neighbors
    );
    case in_range of {
        0 -> { ok: 0, value: empty_neighbors };
        1 -> { ok: 1, value: neighbors };
        _: int64 -> { ok: 0, value: empty_neighbors }
    }
}

fn neighbors[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> List[int64, mem(normal)] {
    result: { ok: int64, value: List[int64, mem(normal)] } <- neighbors_checked[mem(normal)](graph, node_id);
    result.value
}

fn has_edge_checked[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, value: int64 } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    contains_value: int64 <- case from_saved of {
        0 -> graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n0_neighbors, to_saved);
        1 -> graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n1_neighbors, to_saved);
        2 -> graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n2_neighbors, to_saved);
        _: int64 -> 0
    };
    case endpoints_ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: contains_value };
        _: int64 -> { ok: 0, value: 0 }
    }
}

