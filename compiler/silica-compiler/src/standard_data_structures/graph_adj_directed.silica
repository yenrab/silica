    }
}

fn out_degree_checked[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: int64 } {
    node_saved: int64 <- node_id;
    in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(node_saved, graph.node_count);
    length_value: int64 <- case node_saved of {
        0 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n0_neighbors);
        1 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n1_neighbors);
        2 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n2_neighbors);
        _: int64 -> 0
    };
    case in_range of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: length_value };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn out_degree[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> int64 {
    node_saved: int64 <- node_id;
    case node_saved of {
        0 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n0_neighbors);
        1 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n1_neighbors);
        2 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n2_neighbors);
        _: int64 -> 0
    }
}

fn validate_edge_delta(edge_delta: int64) -> int64 {
    case edge_delta of {
        0 -> 1;
        _: int64 -> 0
    }
}

fn validate_counts(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    l0: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n0_neighbors);
    l1: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n1_neighbors);
    l2: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n2_neighbors);
    edge_total: int64 <- l0 + l1 + l2;
    edge_delta: int64 <- edge_total - graph.edge_count;
    case graph.node_count of {
        0 -> validate_edge_delta(edge_delta);
        1 -> validate_edge_delta(edge_delta);
        2 -> validate_edge_delta(edge_delta);
        3 -> validate_edge_delta(edge_delta);
        _: int64 -> 0
    }
}

fn validate[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    d0: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n0_neighbors);
    d1: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n1_neighbors);
    d2: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n2_neighbors);
    edge_total: int64 <- d0 + d1 + d2;
    edge_delta: int64 <- edge_total - graph.edge_count;
    case graph.node_count of {
        0 -> validate_edge_delta(edge_delta);
        1 -> validate_edge_delta(edge_delta);
        2 -> validate_edge_delta(edge_delta);
        3 -> validate_edge_delta(edge_delta);
        _: int64 -> 0
    }
}

fn reachable_via_mid(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64,
    mid_id: int64
) -> int64 {
    h0: int64 <- has_edge[mem(normal)](graph, from_id, mid_id);
    h1: int64 <- has_edge[mem(normal)](graph, mid_id, to_id);
    h0 * h1
}

fn reachable[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    to_ok: int64 <- case to_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    safe_from: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> from_saved;
        _: int64 -> 0
    };
    safe_to: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> to_saved;
        _: int64 -> 0
    };
    same_node: int64 <- case from_saved - to_saved of {
        0 -> 1;
        _: int64 -> 0
    };
    direct: int64 <- has_edge[mem(normal)](graph, safe_from, safe_to);
    path_count: int64 <- same_node + direct;
    path_present: int64 <- case path_count of {
        0 -> 0;
        _: int64 -> 1
    };
    path_present * endpoints_ok
}

fn max_out_degree_pair(a: int64, b: int64) -> int64 {
    case a - b of {
        0 -> a;
        _: int64 -> case b - a of {
            0 -> b;
            _: int64 -> a
        }
    }
}

fn max_out_degree[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    d0: int64 <- out_degree[mem(normal)](graph, 0);
    d1: int64 <- out_degree[mem(normal)](graph, 1);
    d2: int64 <- out_degree[mem(normal)](graph, 2);
    m01: int64 <- max_out_degree_pair(d0, d1);
    max_out_degree_pair(m01, d2)
}

fn total_out_degree_sum[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    d0: int64 <- out_degree[mem(normal)](graph, 0);
    d1: int64 <- out_degree[mem(normal)](graph, 1);
    d2: int64 <- out_degree[mem(normal)](graph, 2);
    d0 + d1 + d2
}

fn empty[int64, mem(normal)](initial_node_count: int64) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
} {
    sequence proc[mem(normal)]
        n0_empty: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        n1_empty: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        n2_empty: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } <- {
            node_count: initial_node_count,
            edge_count: 0,
            n0_neighbors: n0_empty,
            n1_neighbors: n1_empty,
            n2_neighbors: n2_empty
        }
    produces
        pure graph
    end
}

fn node_count[int64, mem(normal)](graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
}) -> int64 {
    graph.node_count
}

fn edge_count[int64, mem(normal)](graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
}) -> int64 {
    graph.edge_count
}

fn int64_prepend_slot(
    old_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64,
    weight: int64
) -> List[{ to: int64, weight: int64 }, mem(normal)] {
    sequence proc[mem(normal)]
        updated: List[{ to: int64, weight: int64 }, mem(normal)] <- prepend[{ to: int64, weight: int64 }, mem(normal)]({ to: to_id, weight: weight }, old_neighbors)
    produces
        pure updated
    end
}

fn int64_neighbors_list(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64,
    empty_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
) -> List[{ to: int64, weight: int64 }, mem(normal)] {
    case node_id of {
        0 -> graph.n0_neighbors;
        1 -> graph.n1_neighbors;
        2 -> graph.n2_neighbors;
        _: int64 -> empty_neighbors
    }
}

fn add_edge_when_ok(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64,
    weight: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
} } {
    case from_id of {
        0 -> {
            ok: 1,
            graph: {
                node_count: graph.node_count,
                edge_count: graph.edge_count + 1,
                n0_neighbors: int64_prepend_slot(graph.n0_neighbors, to_id, weight),
                n1_neighbors: graph.n1_neighbors,
                n2_neighbors: graph.n2_neighbors
            }
        };
        1 -> {
            ok: 1,
            graph: {
                node_count: graph.node_count,
                edge_count: graph.edge_count + 1,
                n0_neighbors: graph.n0_neighbors,
                n1_neighbors: int64_prepend_slot(graph.n1_neighbors, to_id, weight),
                n2_neighbors: graph.n2_neighbors
            }
        };
        2 -> {
            ok: 1,
            graph: {
                node_count: graph.node_count,
                edge_count: graph.edge_count + 1,
                n0_neighbors: graph.n0_neighbors,
                n1_neighbors: graph.n1_neighbors,
                n2_neighbors: int64_prepend_slot(graph.n2_neighbors, to_id, weight)
            }
        };
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn add_edge_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64,
    weight: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
} } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    weight_saved: int64 <- weight;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    case endpoints_ok of {
        0 -> { ok: 0, graph: graph };
        1 -> add_edge_when_ok(graph, from_saved, to_saved, weight_saved);
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn add_edge[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64,
    weight: int64
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
} {
    checked: { ok: int64, graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    } } <- add_edge_checked[int64, mem(normal)](graph, from_id, to_id, weight);
    checked.graph
}

fn neighbors[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64
) -> List[{ to: int64, weight: int64 }, mem(normal)] {
    result: { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } <- neighbors_checked[int64, mem(normal)](graph, node_id);
    result.value
}

fn neighbors_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } {
    sequence proc[mem(normal)]
        empty_neighbors: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(node_id, graph.node_count);
        neighbors: List[{ to: int64, weight: int64 }, mem(normal)] <- int64_neighbors_list(graph, node_id, empty_neighbors);
        out: { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } <- case in_range of {
            0 -> { ok: 0, value: empty_neighbors };
            1 -> { ok: 1, value: neighbors };
            _: int64 -> { ok: 0, value: empty_neighbors }
        }
    produces
        pure out
    end
}

fn weight_list(
    neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    to_id: int64
) -> { found: int64, weight: int64 } {
    case neighbors of {
        []: List[{ to: int64, weight: int64 }, mem(normal)] -> { found: 0, weight: 0 };
        [h: { to: int64, weight: int64 }, _: List[{ to: int64, weight: int64 }, mem(normal)]] -> case h.to - to_id of {
            0 -> { found: 1, weight: h.weight };
            _: int64 -> { found: 0, weight: 0 }
        }
    }
}

fn weight_at_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, value: int64 } {
    neighbors_result: { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } <- neighbors_checked[int64, mem(normal)](graph, from_id);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> {
            found_weight: { found: int64, weight: int64 } <- weight_list(neighbors_result.value, to_id);
            case found_weight.found of {
                0 -> { ok: 0, value: 0 };
                1 -> { ok: 1, value: found_weight.weight };
                _: int64 -> { ok: 0, value: 0 }
            }
        };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn weight_at[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- weight_at_checked[int64, mem(normal)](graph, from_id, to_id);
    result.value
}

fn has_edge_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, value: int64 } {
    weight_result: { ok: int64, value: int64 } <- weight_at_checked[int64, mem(normal)](graph, from_id, to_id);
    case weight_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: 1 };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn has_edge[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- has_edge_checked[int64, mem(normal)](graph, from_id, to_id);
    result.value
}

fn out_degree_checked[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: int64 } {
    neighbors_result: { ok: int64, value: List[{ to: int64, weight: int64 }, mem(normal)] } <- neighbors_checked[int64, mem(normal)](graph, node_id);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: graph_adj_list_helpers@graph_adj_list_weighted_length(neighbors_result.value) };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn out_degree[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    node_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- out_degree_checked[int64, mem(normal)](graph, node_id);
    result.value
}

fn validate[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    }
) -> int64 {
    case graph.node_count of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> 1;
        _: int64 -> 0
    }
}
