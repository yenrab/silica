// NodeIdAdjacencyGraphDirected[mem(normal)] and [int64, mem(normal)] (graph_representation_design.md §2.11).
// Bootstrap layout: fixed neighbor slots for node ids 0..2 (flat lists, emitter-safe).

use graph_adj_list_helpers;

export empty[mem(normal)]/1;
export node_count[mem(normal)]/1;
export edge_count[mem(normal)]/1;
export add_edge[mem(normal)]/3;
export add_edge_checked[mem(normal)]/3;
export add_edge_slot0[mem(normal)]/2;
export add_edge_slot1[mem(normal)]/2;
export add_edge_slot2[mem(normal)]/2;
export neighbors[mem(normal)]/2;
export neighbors_checked[mem(normal)]/2;
export out_degree[mem(normal)]/2;
export out_degree_checked[mem(normal)]/2;
export has_edge[mem(normal)]/3;
export has_edge_checked[mem(normal)]/3;
export validate[mem(normal)]/1;
export reachable[mem(normal)]/3;
export max_out_degree[mem(normal)]/1;
export total_out_degree_sum[mem(normal)]/1;

export empty[int64, mem(normal)]/1;
export node_count[int64, mem(normal)]/1;
export edge_count[int64, mem(normal)]/1;
export add_edge[int64, mem(normal)]/4;
export add_edge_checked[int64, mem(normal)]/4;
export neighbors[int64, mem(normal)]/2;
export neighbors_checked[int64, mem(normal)]/2;
export out_degree[int64, mem(normal)]/2;
export out_degree_checked[int64, mem(normal)]/2;
export has_edge[int64, mem(normal)]/3;
export has_edge_checked[int64, mem(normal)]/3;
export weight_at[int64, mem(normal)]/3;
export weight_at_checked[int64, mem(normal)]/3;
export validate[int64, mem(normal)]/1;

fn empty[mem(normal)](initial_node_count: int64) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    sequence proc[mem(normal)]
        n0_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n1_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n2_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: initial_node_count,
            edge_count: 0,
            n0_neighbors: n0_empty,
            n1_neighbors: n1_empty,
            n2_neighbors: n2_empty
        }
    produces
        pure graph
    end
}

fn node_count[mem(normal)](graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    graph.node_count
}

fn edge_count[mem(normal)](graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    graph.edge_count
}

fn empty_int64_list() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure empty_neighbors
    end
}

fn prepend_slot(
    old_neighbors: List[int64, mem(normal)],
    to_id: int64
) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        updated: List[int64, mem(normal)] <- prepend[int64, mem(normal)](to_id, old_neighbors)
    produces
        pure updated
    end
}

fn neighbors_list(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64,
    empty_neighbors: List[int64, mem(normal)]
) -> List[int64, mem(normal)] {
    case node_id of {
        0 -> graph.n0_neighbors;
        1 -> graph.n1_neighbors;
        2 -> graph.n2_neighbors;
        _: int64 -> empty_neighbors
    }
}

fn add_edge_slot0[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    sequence proc[mem(normal)]
        updated: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: graph.node_count,
            edge_count: graph.edge_count + 1,
            n0_neighbors: prepend_slot(graph.n0_neighbors, to_id),
            n1_neighbors: graph.n1_neighbors,
            n2_neighbors: graph.n2_neighbors
        }
    produces
        pure updated
    end
}

