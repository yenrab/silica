export trait OrderedMap;
export contains_key/2;
export get/2;
export compare_key/3;
export compare_value/3;

required {
    fn contains_key(map: OrderedMap, key: int64) -> boolean;
    fn get(map: OrderedMap, key: int64) -> { found: int64, value: int64 };
    fn compare_key(map: OrderedMap, left: int64, right: int64) -> :less | :equal | :greater;
    fn compare_value(map: OrderedMap, left: int64, right: int64) -> :less | :equal | :greater;
}

impl fn compare_key(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

impl fn compare_value(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

impl fn contains_key(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> boolean {
    false
}

impl fn get(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> { found: int64, value: int64 } {
    result: { found: int64, value: int64 } <- { found: 0, value: 0 };
    result
}
