export trait OrderedMap;
export contains_key/2;
export get/2;
export compare_key/3;
export compare_value/3;

required {
    fn contains_key(map: OrderedMap, key: int64) -> boolean;
    fn get(map: OrderedMap, key: int64) -> { found: int64, value: int64 };
    fn compare_key(map: OrderedMap, left: int64, right: int64) -> atom;
    fn compare_value(map: OrderedMap, left: int64, right: int64) -> atom;
}

