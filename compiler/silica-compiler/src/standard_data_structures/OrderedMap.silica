export trait OrderedMap;
export contains_key/2;
export get/2;
export compare_key/3;
export compare_value/3;

use ordered_map_nodeid_adapter;
use ordered_map_csr_adapter;

required {
    fn contains_key(map: OrderedMap, key: KeyType) -> boolean;
    fn get(map: OrderedMap, key: KeyType) -> { found: int64, value: ValueType };
    fn compare_key(map: OrderedMap, left: KeyType, right: KeyType) -> :less | :equal | :greater;
    fn compare_value(map: OrderedMap, left: ValueType, right: ValueType) -> :less | :equal | :greater;
}

impl fn compare_key(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- map.compare_key;
    cmp(left, right)
}

impl fn compare_value(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- map.compare_value;
    cmp(left, right)
}

impl fn contains_key(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> boolean {
    inner: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    } <- {
        root_id: map.root_id,
        node_count: map.node_count,
        order: map.order,
        nodes: map.nodes
    };
    ordered_map_nodeid_adapter@contains_key_nodeid(inner, key)
}

impl fn get(
    map: {
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> { found: int64, value: int64 } {
    inner: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    } <- {
        root_id: map.root_id,
        node_count: map.node_count,
        order: map.order,
        nodes: map.nodes
    };
    ordered_map_nodeid_adapter@get_nodeid(inner, key)
}

impl fn compare_key(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        values: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- map.compare_key;
    cmp(left, right)
}

impl fn compare_value(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        values: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- map.compare_value;
    cmp(left, right)
}

impl fn contains_key(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        values: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> boolean {
    ordered_map_csr_adapter@contains_key_csr(map, key)
}

impl fn get(
    map: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        values: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8),
        compare_key: fn(int64, int64) -> :less | :equal | :greater,
        compare_value: fn(int64, int64) -> :less | :equal | :greater
    },
    key: int64
) -> { found: int64, value: int64 } {
    ordered_map_csr_adapter@get_csr(map, key)
}
