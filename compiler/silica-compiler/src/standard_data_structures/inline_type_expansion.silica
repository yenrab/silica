fn expand_nodeid_btree_set_int64(space: string) -> string {
    case space of {
        "normal" -> "{ root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: bool, keys: List[int64, normal], children: List[int64, normal] }, normal] }";
        "normal_writethrough" -> "{ root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: bool, keys: List[int64, normal_writethrough], children: List[int64, normal_writethrough] }, normal_writethrough] }";
        "normal_noncacheable" -> "{ root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: bool, keys: List[int64, normal_noncacheable], children: List[int64, normal_noncacheable] }, normal_noncacheable] }";
        "atomic" -> "{ root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: bool, keys: List[int64, atomic], children: List[int64, atomic] }, atomic] }";
        _: string -> ""
    }
}

fn expand_csr_btree_set_int64(space: string) -> string {
    case space of {
        "normal" -> "{ region: region(R, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(R, normal, int64, NODE_CAP), node_key_count: buf(R, normal, int64, NODE_CAP), node_child_start: buf(R, normal, int64, NODE_CAP), node_child_count: buf(R, normal, int64, NODE_CAP), node_is_leaf: buf(R, normal, int64, NODE_CAP), keys: buf(R, normal, int64, KEY_CAP), children: buf(R, normal, int64, CHILD_CAP) }";
        "normal_writethrough" -> "{ region: region(R, normal_writethrough), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(R, normal_writethrough, int64, NODE_CAP), node_key_count: buf(R, normal_writethrough, int64, NODE_CAP), node_child_start: buf(R, normal_writethrough, int64, NODE_CAP), node_child_count: buf(R, normal_writethrough, int64, NODE_CAP), node_is_leaf: buf(R, normal_writethrough, int64, NODE_CAP), keys: buf(R, normal_writethrough, int64, KEY_CAP), children: buf(R, normal_writethrough, int64, CHILD_CAP) }";
        "normal_noncacheable" -> "{ region: region(R, normal_noncacheable), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(R, normal_noncacheable, int64, NODE_CAP), node_key_count: buf(R, normal_noncacheable, int64, NODE_CAP), node_child_start: buf(R, normal_noncacheable, int64, NODE_CAP), node_child_count: buf(R, normal_noncacheable, int64, NODE_CAP), node_is_leaf: buf(R, normal_noncacheable, int64, NODE_CAP), keys: buf(R, normal_noncacheable, int64, KEY_CAP), children: buf(R, normal_noncacheable, int64, CHILD_CAP) }";
        "atomic" -> "{ region: region(R, atomic), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(R, atomic, int64, NODE_CAP), node_key_count: buf(R, atomic, int64, NODE_CAP), node_child_start: buf(R, atomic, int64, NODE_CAP), node_child_count: buf(R, atomic, int64, NODE_CAP), node_is_leaf: buf(R, atomic, int64, NODE_CAP), keys: buf(R, atomic, int64, KEY_CAP), children: buf(R, atomic, int64, CHILD_CAP) }";
        _: string -> ""
    }
}

fn expand_nodeid_btree_int64(space: string) -> string {
    expand_nodeid_btree_set_int64(space)
}

fn expand_nodeid_btree_map_int64_to_int64(space: string) -> string {
    case space of {
        "normal" -> "{ root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: bool, keys: List[int64, normal], values: List[int64, normal], children: List[int64, normal] }, normal] }";
        "normal_writethrough" -> "{ root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: bool, keys: List[int64, normal_writethrough], values: List[int64, normal_writethrough], children: List[int64, normal_writethrough] }, normal_writethrough] }";
        "normal_noncacheable" -> "{ root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: bool, keys: List[int64, normal_noncacheable], values: List[int64, normal_noncacheable], children: List[int64, normal_noncacheable] }, normal_noncacheable] }";
        "atomic" -> "{ root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: bool, keys: List[int64, atomic], values: List[int64, atomic], children: List[int64, atomic] }, atomic] }";
        _: string -> ""
    }
}

fn expand_csr_btree_int64(space: string) -> string {
    case space of {
        "normal" -> "{ region: region(R, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(R, normal, int64, NODE_CAP), node_key_count: buf(R, normal, int64, NODE_CAP), node_child_start: buf(R, normal, int64, NODE_CAP), node_child_count: buf(R, normal, int64, NODE_CAP), node_is_leaf: buf(R, normal, int64, NODE_CAP), keys: buf(R, normal, int64, KEY_CAP), children: buf(R, normal, int64, CHILD_CAP) }";
