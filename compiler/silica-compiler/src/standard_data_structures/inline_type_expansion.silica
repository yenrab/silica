fn expand_region_binary_min_heap_int64(space: string) -> string {
    case space of {
        "normal" -> "{ region: region(R, normal), len: int64, capacity: int64, values: buf(R, normal, int64, CAP) }";
        "normal_writethrough" -> "{ region: region(R, normal_writethrough), len: int64, capacity: int64, values: buf(R, normal_writethrough, int64, CAP) }";
        "normal_noncacheable" -> "{ region: region(R, normal_noncacheable), len: int64, capacity: int64, values: buf(R, normal_noncacheable, int64, CAP) }";
        "atomic" -> "{ region: region(R, atomic), len: int64, capacity: int64, values: buf(R, atomic, int64, CAP) }";
        _: string -> ""
    }
}

fn expand_region_binary_max_heap_int64(space: string) -> string {
    expand_region_binary_min_heap_int64(space)
}

