    case space of {
        "normal" -> "{ region: region(R, normal), node_count: int64, edge_count: int64, present: buf(R, normal, int64, N_TIMES_N), weights: buf(R, normal, int64, N_TIMES_N) }";
        "normal_writethrough" -> "{ region: region(R, normal_writethrough), node_count: int64, edge_count: int64, present: buf(R, normal_writethrough, int64, N_TIMES_N), weights: buf(R, normal_writethrough, int64, N_TIMES_N) }";
