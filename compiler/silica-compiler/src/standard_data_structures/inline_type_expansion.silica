        "normal" -> "{ region: region(R, normal), len: int64, capacity: int64, arity: int64, values: buf(R, normal, int64, CAP) }";
        "normal_writethrough" -> "{ region: region(R, normal_writethrough), len: int64, capacity: int64, arity: int64, values: buf(R, normal_writethrough, int64, CAP) }";
