// Phase 0 — canonical inline structural type strings from design-document family names.
// Authority: graph_representation_design.md §8.5; balanced_tree_and_heap_design.md §2.1;
//   btree_set_design.md §9.2.

use structure_registry;

export expand_structure_inline_type/2;
export expand_structure_inline_type_normal/1;
export canonical_type_string_matches/2;

fn normalize_memory_space(space: string) -> string {
    case space of {
        "" -> "normal";
        _: string -> space
    }
}

// Expand using generator capacity constant names in buffer size positions (design-document form).
fn expand_structure_inline_type(family_name: string, memory_space: string) -> string {
    s: string <- normalize_memory_space(memory_space);
    case family_name of {
        "NodeIdAdjacencyGraphDirectedUnweighted" -> expand_adjacency_directed_unweighted(s);
        "NodeIdAdjacencyGraphUndirectedUnweighted" -> expand_adjacency_directed_unweighted(s);
        "NodeIdAdjacencyGraphDirectedWeightedInt64" -> expand_adjacency_directed_weighted_int64(s);
        "NodeIdAdjacencyGraphUndirectedWeightedInt64" -> expand_adjacency_directed_weighted_int64(s);
        "CompressedSparseRowGraphDirectedUnweighted" -> expand_csr_directed_unweighted(s);
        "CompressedSparseRowGraphUndirectedUnweighted" -> expand_csr_directed_unweighted(s);
        "CompressedSparseRowGraphDirectedWeightedInt64" -> expand_csr_directed_weighted_int64(s);
        "CompressedSparseRowGraphUndirectedWeightedInt64" -> expand_csr_directed_weighted_int64(s);
        "DenseMatrixGraphDirectedUnweighted" -> expand_dense_matrix_directed_unweighted(s);
        "DenseMatrixGraphUndirectedUnweighted" -> expand_dense_matrix_directed_unweighted(s);
        "DenseMatrixGraphDirectedWeightedInt64" -> expand_dense_matrix_directed_weighted_int64(s);
        "DenseMatrixGraphUndirectedWeightedInt64" -> expand_dense_matrix_directed_weighted_int64(s);
        "DenseBitsetGraphDirectedUnweighted" -> expand_dense_bitset_directed_unweighted(s);
        "DenseBitsetGraphUndirectedUnweighted" -> expand_dense_bitset_directed_unweighted(s);
        "NodeIDBTreeSetInt64" -> expand_nodeid_btree_set_int64(s);
        "CsrBTreeSetInt64" -> expand_csr_btree_set_int64(s);
        "NodeIDBTreeInt64" -> expand_nodeid_btree_int64(s);
        "NodeIDBTreeMapInt64ToInt64" -> expand_nodeid_btree_map_int64_to_int64(s);
        "CsrBTreeInt64" -> expand_csr_btree_int64(s);
        "CsrBTreeMapInt64ToInt64" -> expand_csr_btree_map_int64_to_int64(s);
        "RegionBinaryMinHeapInt64" -> expand_region_binary_min_heap_int64(s);
        "RegionBinaryMaxHeapInt64" -> expand_region_binary_max_heap_int64(s);
        "RegionBinaryMinHeapPriorityInt64ValueInt64" -> expand_region_binary_min_heap_priority_int64_value_int64(s);
        "RegionDaryMinHeapInt64" -> expand_region_dary_min_heap_int64(s);
        _: string -> ""
    }
}

fn expand_structure_inline_type_normal(family_name: string) -> string {
    expand_structure_inline_type(family_name, "normal")
}

fn expand_adjacency_directed_unweighted(space: string) -> string {
    case space of {
        "normal" -> "{ node_count: int64, edge_count: int64, nodes: List[{ id: int64, neighbors: List[int64, normal] }, normal] }";
        "normal_writethrough" -> "{ node_count: int64, edge_count: int64, nodes: List[{ id: int64, neighbors: List[int64, normal_writethrough] }, normal_writethrough] }";
        "normal_noncacheable" -> "{ node_count: int64, edge_count: int64, nodes: List[{ id: int64, neighbors: List[int64, normal_noncacheable] }, normal_noncacheable] }";
        "atomic" -> "{ node_count: int64, edge_count: int64, nodes: List[{ id: int64, neighbors: List[int64, atomic] }, atomic] }";
        _: string -> ""
    }
}

fn expand_adjacency_directed_weighted_int64(space: string) -> string {
    case space of {
        "normal" -> "{ node_count: int64, edge_count: int64, nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, normal] }, normal] }";
        "normal_writethrough" -> "{ node_count: int64, edge_count: int64, nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, normal_writethrough] }, normal_writethrough] }";
        "normal_noncacheable" -> "{ node_count: int64, edge_count: int64, nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, normal_noncacheable] }, normal_noncacheable] }";
        "atomic" -> "{ node_count: int64, edge_count: int64, nodes: List[{ id: int64, neighbors: List[{ to: int64, weight: int64 }, atomic] }, atomic] }";
        _: string -> ""
    }
}

fn expand_csr_directed_unweighted(space: string) -> string {
    case space of {
        "normal" -> "{ region: region(R, normal), node_count: int64, edge_count: int64, offsets: buf(R, normal, int64, N_PLUS_ONE), neighbors: buf(R, normal, int64, M) }";
        "normal_writethrough" -> "{ region: region(R, normal_writethrough), node_count: int64, edge_count: int64, offsets: buf(R, normal_writethrough, int64, N_PLUS_ONE), neighbors: buf(R, normal_writethrough, int64, M) }";
        "normal_noncacheable" -> "{ region: region(R, normal_noncacheable), node_count: int64, edge_count: int64, offsets: buf(R, normal_noncacheable, int64, N_PLUS_ONE), neighbors: buf(R, normal_noncacheable, int64, M) }";
        "atomic" -> "{ region: region(R, atomic), node_count: int64, edge_count: int64, offsets: buf(R, atomic, int64, N_PLUS_ONE), neighbors: buf(R, atomic, int64, M) }";
        _: string -> ""
    }
}

fn expand_csr_directed_weighted_int64(space: string) -> string {
    case space of {
        "normal" -> "{ region: region(R, normal), node_count: int64, edge_count: int64, offsets: buf(R, normal, int64, N_PLUS_ONE), neighbors: buf(R, normal, int64, M), weights: buf(R, normal, int64, M) }";
        "normal_writethrough" -> "{ region: region(R, normal_writethrough), node_count: int64, edge_count: int64, offsets: buf(R, normal_writethrough, int64, N_PLUS_ONE), neighbors: buf(R, normal_writethrough, int64, M), weights: buf(R, normal_writethrough, int64, M) }";
        "normal_noncacheable" -> "{ region: region(R, normal_noncacheable), node_count: int64, edge_count: int64, offsets: buf(R, normal_noncacheable, int64, N_PLUS_ONE), neighbors: buf(R, normal_noncacheable, int64, M), weights: buf(R, normal_noncacheable, int64, M) }";
        "atomic" -> "{ region: region(R, atomic), node_count: int64, edge_count: int64, offsets: buf(R, atomic, int64, N_PLUS_ONE), neighbors: buf(R, atomic, int64, M), weights: buf(R, atomic, int64, M) }";
        _: string -> ""
    }
}

