    case space of {
        "normal" -> "{ region: region(R, normal), root_id: int64, node_count: int64, key_count_total: int64, order: int64, node_key_start: buf(R, normal, int64, NODE_CAP), node_key_count: buf(R, normal, int64, NODE_CAP), node_child_start: buf(R, normal, int64, NODE_CAP), node_child_count: buf(R, normal, int64, NODE_CAP), node_is_leaf: buf(R, normal, int64, NODE_CAP), keys: buf(R, normal, int64, KEY_CAP), values: buf(R, normal, int64, KEY_CAP), children: buf(R, normal, int64, CHILD_CAP) }";
