        "normal" -> "{ region: region(R, normal), node_count: int64, edge_count: int64, words: buf(R, normal, int64, WORD_COUNT) }";
        "normal_writethrough" -> "{ region: region(R, normal_writethrough), node_count: int64, edge_count: int64, words: buf(R, normal_writethrough, int64, WORD_COUNT) }";
