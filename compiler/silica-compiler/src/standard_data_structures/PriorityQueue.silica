export trait PriorityQueue;
export peek_priority/1;
export peek_value/1;

required {
    fn peek_priority(queue: PriorityQueue) -> int64;
    fn peek_value(queue: PriorityQueue) -> int64;
}

impl fn peek_priority(
    queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 }
) -> int64 {
    queue.top_item
}

impl fn peek_value(
    queue: { compare_priority: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_top: int64, top_item: int64 }
) -> int64 {
    queue.top_item
}
