export trait SearchTree;
export contains_key/2;

required {
    fn contains_key(tree: SearchTree, key: int64) -> boolean;
}

impl fn contains_key(
    tree: { compare_item: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_first: int64, first_item: int64 },
    key: int64
) -> boolean {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- tree.compare_item;
    case tree.has_first of {
        0 -> false;
        _: int64 -> case cmp(tree.first_item, key) of {
            :equal -> true;
            _: atom -> false
        }
    }
}
