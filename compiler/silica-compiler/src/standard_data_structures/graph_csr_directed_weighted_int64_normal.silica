// CompressedSparseRowGraph directed weighted int64, memory space normal (graph_representation_design.md §4).
// Bootstrap static graph: 3 nodes, 1 directed weighted edge: 0 -> 1 (weight 42).

use graph_adj_list_helpers;

export graph_csr_directed_weighted_int64_normal_from_static_edges/0;
export graph_csr_directed_weighted_int64_normal_node_count/1;
export graph_csr_directed_weighted_int64_normal_edge_count/1;
export graph_csr_directed_weighted_int64_normal_out_degree/2;
export graph_csr_directed_weighted_int64_normal_has_edge/3;
export graph_csr_directed_weighted_int64_normal_weight_at_checked/3;
export graph_csr_directed_weighted_int64_normal_validate/1;

fn graph_csr_directed_weighted_int64_normal_from_static_edges() -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        offsets: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        neighbors: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        weights: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        _: atom <- write_buf(offsets, 0, 0);
        _: atom <- write_buf(offsets, 1, 1);
        _: atom <- write_buf(offsets, 2, 1);
        _: atom <- write_buf(offsets, 3, 1);
        _: atom <- write_buf(neighbors, 0, 1);
        _: atom <- write_buf(weights, 0, 42);
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 1),
            weights: buf(L1, normal, int64, 1)
        } <- {
            region: r,
            node_count: 3,
            edge_count: 1,
            offsets: offsets,
            neighbors: neighbors,
            weights: weights
        }
    produces
        pure graph
    end
}

fn graph_csr_directed_weighted_int64_normal_node_count(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    graph.node_count
}

fn graph_csr_directed_weighted_int64_normal_edge_count(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    graph.edge_count
}

fn graph_csr_directed_weighted_int64_normal_out_degree(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, node_id: int64) -> int64 {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(node_id, graph.node_count) of {
        0 -> 0;
        1 -> graph_csr_directed_weighted_int64_normal_out_degree_static(node_id);
        _: int64 -> 0
    }
}

fn graph_csr_directed_weighted_int64_normal_out_degree_static(node_id: int64) -> int64 {
    case node_id of {
        0 -> 1;
        1 -> 0;
        2 -> 0;
        _: int64 -> 0
    }
}

fn graph_csr_directed_weighted_int64_normal_weight_at_checked(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, from_id: int64, to_id: int64) -> { ok: int64, value: int64 } {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(from_id, graph.node_count) of {
        0 -> { ok: 0, value: 0 };
        1 -> graph_csr_directed_weighted_int64_normal_weight_at_from_ok(graph, from_id, to_id);
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn graph_csr_directed_weighted_int64_normal_weight_at_from_ok(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, from_id: int64, to_id: int64) -> { ok: int64, value: int64 } {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(to_id, graph.node_count) of {
        0 -> { ok: 0, value: 0 };
        1 -> graph_csr_directed_weighted_int64_normal_weight_at_valid(graph, from_id, to_id);
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn graph_csr_directed_weighted_int64_normal_weight_at_valid(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, from_id: int64, to_id: int64) -> { ok: int64, value: int64 } {
    case from_id of {
        0 -> graph_csr_directed_weighted_int64_normal_weight_from0(to_id);
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn graph_csr_directed_weighted_int64_normal_weight_from0(to_id: int64) -> { ok: int64, value: int64 } {
    case to_id of {
        1 -> { ok: 1, value: 42 };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn graph_csr_directed_weighted_int64_normal_has_edge(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, from_id: int64, to_id: int64) -> int64 {
    result: { ok: int64, value: int64 } <- graph_csr_directed_weighted_int64_normal_weight_at_checked(graph, from_id, to_id);
    case result.ok of {
        1 -> 1;
        _: int64 -> 0
    }
}

fn graph_csr_directed_weighted_int64_normal_validate(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    case graph.node_count - 3 of {
        0 -> graph_csr_directed_weighted_int64_normal_validate_edge_count(graph);
        _: int64 -> 0
    }
}

fn graph_csr_directed_weighted_int64_normal_validate_edge_count(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    case graph.edge_count - 1 of {
        0 -> 1;
        _: int64 -> 0
    }
}
