// (balanced_tree_and_heap_design.md §6.2–§6.7).
// Bootstrap generated family: CAP=8.

export empty[int64, mem(normal)]/0;
export len[int64, mem(normal)]/1;
export is_empty[int64, mem(normal)]/1;
export is_full[int64, mem(normal)]/1;
export peek[int64, mem(normal)]/1;
export push[int64, mem(normal)]/2;
export pop[int64, mem(normal)]/1;
export validate[int64, mem(normal)]/1;

export empty[int64, int64, mem(normal)]/0;
export len[int64, int64, mem(normal)]/1;
export is_empty[int64, int64, mem(normal)]/1;
export is_full[int64, int64, mem(normal)]/1;
export peek_priority[int64, int64, mem(normal)]/1;
export peek_value[int64, int64, mem(normal)]/1;
export push_priority_value[int64, int64, mem(normal)]/3;
export pop_priority_value[int64, int64, mem(normal)]/1;
export validate[int64, int64, mem(normal)]/1;

fn cap() -> int64 {
    8
}

fn parent_index(index: int64) -> int64 {
    (index - 1) / 2
}

fn left_child(index: int64) -> int64 {
    2 * index + 1
}

fn right_child(index: int64) -> int64 {
    2 * index + 2
}

fn swap_buf_values(
    values: buf(L1, normal, int64, 8),
    left_index: int64,
    right_index: int64
) -> atom {
    values_saved: buf(L1, normal, int64, 8) <- values;
    left_saved: int64 <- left_index;
    right_saved: int64 <- right_index;
    sequence proc[mem(normal)]
        left_value: int64 <- read_buf(values_saved, left_saved);
        right_value: int64 <- read_buf(values_saved, right_saved);
        _: atom <- write_buf(values_saved, left_saved, right_value);
        _: atom <- write_buf(values_saved, right_saved, left_value)
    produces
        pure :ok
    end
}

fn swap_priority_value_pair(
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    left_index: int64,
    right_index: int64
) -> atom {
    priorities_saved: buf(L1, normal, int64, 8) <- priorities;
    values_saved: buf(L1, normal, int64, 8) <- values;
    left_saved: int64 <- left_index;
    right_saved: int64 <- right_index;
    sequence proc[mem(normal)]
        left_priority: int64 <- read_buf(priorities_saved, left_saved);
        right_priority: int64 <- read_buf(priorities_saved, right_saved);
        left_value: int64 <- read_buf(values_saved, left_saved);
        right_value: int64 <- read_buf(values_saved, right_saved);
        _: atom <- write_buf(priorities_saved, left_saved, right_priority);
        _: atom <- write_buf(priorities_saved, right_saved, left_priority);
        _: atom <- write_buf(values_saved, left_saved, right_value);
        _: atom <- write_buf(values_saved, right_saved, left_value)
    produces
        pure :ok
    end
}

fn smallest_child_min(
    values: buf(L1, normal, int64, 8),
    index: int64,
    heap_len: int64
) -> int64 {
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    heap_len_saved: int64 <- heap_len;
    left: int64 <- left_child(index_saved);
    right: int64 <- right_child(index_saved);
    sequence proc[mem(normal)]
        index_value: int64 <- read_buf(values_saved, index_saved);
        smallest: int64 <- index_saved;
        smallest_after_left: int64 <- case left < heap_len_saved of {
            true -> {
                left_value: int64 <- read_buf(values_saved, left);
                case left_value < index_value of {
                    true -> left;
                    false -> smallest
                }
            };
            false -> smallest
        };
        smallest_value: int64 <- read_buf(values_saved, smallest_after_left);
        result: int64 <- case right < heap_len_saved of {
            true -> {
                right_value: int64 <- read_buf(values_saved, right);
                case right_value < smallest_value of {
                    true -> right;
                    false -> smallest_after_left
                }
            };
            false -> smallest_after_left
        }
    produces
        pure result
    end
}

fn sift_down_min_step_active(values: buf(L1, normal, int64, 8), index: int64, heap_len: int64) -> int64 {
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    heap_len_saved: int64 <- heap_len;
    smallest: int64 <- smallest_child_min(values_saved, index_saved, heap_len_saved);
    needs_swap: int64 <- case smallest == index_saved of {
        true -> 0;
        false -> 1
    };
    _: atom <- case needs_swap of {
        0 -> :ok;
        _: int64 -> swap_buf_values(values_saved, index_saved, smallest)
    };
    case needs_swap of {
        0 -> -1;
        _: int64 -> smallest
    }
}

fn sift_up_min_priority_step_nonroot(
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    index: int64
) -> int64 {
    priorities_saved: buf(L1, normal, int64, 8) <- priorities;
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    parent: int64 <- parent_index(index_saved);
    needs_swap: int64 <- sequence proc[mem(normal)]
        parent_priority: int64 <- read_buf(priorities_saved, parent);
        child_priority: int64 <- read_buf(priorities_saved, index_saved);
        swap_flag: int64 <- case parent_priority <= child_priority of {
            true -> 0;
            false -> 1
        }
    produces
        pure swap_flag
    end;
    _: atom <- case needs_swap of {
        0 -> :ok;
        _: int64 -> swap_priority_value_pair(priorities_saved, values_saved, parent, index_saved)
    };
    case needs_swap of {
        0 -> -1;
        _: int64 -> parent
    }
}

fn smallest_child_min_priority(
    priorities: buf(L1, normal, int64, 8),
    index: int64,
    heap_len: int64
) -> int64 {
    priorities_saved: buf(L1, normal, int64, 8) <- priorities;
    index_saved: int64 <- index;
    heap_len_saved: int64 <- heap_len;
    left: int64 <- left_child(index_saved);
    right: int64 <- right_child(index_saved);
    sequence proc[mem(normal)]
        index_priority: int64 <- read_buf(priorities_saved, index_saved);
        smallest: int64 <- index_saved;
        smallest_after_left: int64 <- case left < heap_len_saved of {
            true -> {
                left_priority: int64 <- read_buf(priorities_saved, left);
                case left_priority < index_priority of {
                    true -> left;
                    false -> smallest
                }
            };
            false -> smallest
        };
        smallest_priority: int64 <- read_buf(priorities_saved, smallest_after_left);
        result: int64 <- case right < heap_len_saved of {
            true -> {
                right_priority: int64 <- read_buf(priorities_saved, right);
                case right_priority < smallest_priority of {
                    true -> right;
                    false -> smallest_after_left
                }
            };
            false -> smallest_after_left
        }
    produces
        pure result
    end
}

fn sift_down_min_priority_step_active(
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    index: int64,
    heap_len: int64
) -> int64 {
    priorities_saved: buf(L1, normal, int64, 8) <- priorities;
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    heap_len_saved: int64 <- heap_len;
    smallest: int64 <- smallest_child_min_priority(priorities_saved, index_saved, heap_len_saved);
    needs_swap: int64 <- case smallest == index_saved of {
        true -> 0;
        false -> 1
    };
    _: atom <- case needs_swap of {
        0 -> :ok;
        _: int64 -> swap_priority_value_pair(priorities_saved, values_saved, index_saved, smallest)
    };
    case needs_swap of {
        0 -> -1;
        _: int64 -> smallest
    }
}

fn sift_up_min_step(values: buf(L1, normal, int64, 8), index: int64) -> int64 {
    case index of {
        -1 -> -1;
        0 -> -1;
        _: int64 -> sift_up_min_step_nonroot(values, index)
    }
}

fn sift_up_min_step_nonroot(values: buf(L1, normal, int64, 8), index: int64) -> int64 {
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    parent: int64 <- parent_index(index_saved);
    needs_swap: int64 <- sequence proc[mem(normal)]
        parent_value: int64 <- read_buf(values_saved, parent);
        child_value: int64 <- read_buf(values_saved, index_saved);
        swap_flag: int64 <- case parent_value <= child_value of {
            true -> 0;
            false -> 1
        }
    produces
        pure swap_flag
    end;
    _: atom <- case needs_swap of {
        0 -> :ok;
        _: int64 -> swap_buf_values(values_saved, parent, index_saved)
    };
    case needs_swap of {
        0 -> -1;
        _: int64 -> parent
    }
}

fn sift_up_min(values: buf(L1, normal, int64, 8), index: int64) -> atom {
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    i1: int64 <- sift_up_min_step(values_saved, index_saved);
    i2: int64 <- sift_up_min_step(values_saved, i1);
    i3: int64 <- sift_up_min_step(values_saved, i2);
    _: int64 <- sift_up_min_step(values_saved, i3);
    :ok
}

fn sift_down_min_step(values: buf(L1, normal, int64, 8), index: int64, heap_len: int64) -> int64 {
    case index of {
        -1 -> -1;
        _: int64 -> sift_down_min_step_active(values, index, heap_len)
    }
}

fn sift_down_min(values: buf(L1, normal, int64, 8), index: int64, heap_len: int64) -> atom {
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    heap_len_saved: int64 <- heap_len;
    i1: int64 <- sift_down_min_step(values_saved, index_saved, heap_len_saved);
    i2: int64 <- sift_down_min_step(values_saved, i1, heap_len_saved);
    i3: int64 <- sift_down_min_step(values_saved, i2, heap_len_saved);
    _: int64 <- sift_down_min_step(values_saved, i3, heap_len_saved);
    :ok
}

fn sift_up_min_priority_step(
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    index: int64
) -> int64 {
    case index of {
        -1 -> -1;
        0 -> -1;
        _: int64 -> sift_up_min_priority_step_nonroot(priorities, values, index)
    }
}

fn sift_up_min_priority(
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    index: int64
) -> atom {
    priorities_saved: buf(L1, normal, int64, 8) <- priorities;
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    i1: int64 <- sift_up_min_priority_step(priorities_saved, values_saved, index_saved);
    i2: int64 <- sift_up_min_priority_step(priorities_saved, values_saved, i1);
    i3: int64 <- sift_up_min_priority_step(priorities_saved, values_saved, i2);
    _: int64 <- sift_up_min_priority_step(priorities_saved, values_saved, i3);
    :ok
}

fn sift_down_min_priority_step(
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    index: int64,
    heap_len: int64
) -> int64 {
    case index of {
        -1 -> -1;
        _: int64 -> sift_down_min_priority_step_active(priorities, values, index, heap_len)
    }
}

fn sift_down_min_priority(
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8),
    index: int64,
    heap_len: int64
) -> atom {
    priorities_saved: buf(L1, normal, int64, 8) <- priorities;
    values_saved: buf(L1, normal, int64, 8) <- values;
    index_saved: int64 <- index;
    heap_len_saved: int64 <- heap_len;
    i1: int64 <- sift_down_min_priority_step(priorities_saved, values_saved, index_saved, heap_len_saved);
    i2: int64 <- sift_down_min_priority_step(priorities_saved, values_saved, i1, heap_len_saved);
    i3: int64 <- sift_down_min_priority_step(priorities_saved, values_saved, i2, heap_len_saved);
    _: int64 <- sift_down_min_priority_step(priorities_saved, values_saved, i3, heap_len_saved);
    :ok
}

fn check_heap_order_at(
    values: buf(L1, normal, int64, 8),
    heap_len: int64,
    index: int64
) -> int64 {
    case index >= heap_len of {
        true -> 0;
        false -> {
            values_saved: buf(L1, normal, int64, 8) <- values;
            index_saved: int64 <- index;
            parent: int64 <- parent_index(index_saved);
            sequence proc[mem(normal)]
                parent_value: int64 <- read_buf(values_saved, parent);
                child_value: int64 <- read_buf(values_saved, index_saved);
                order_ok: int64 <- case parent_value <= child_value of {
                    true -> 1;
                    false -> 0
                }
            produces
                pure case order_ok of {
                    0 -> 5;
                    _: int64 -> 0
                }
            end
        }
    }
}

fn check_priority_heap_order_at(
    priorities: buf(L1, normal, int64, 8),
    heap_len: int64,
    index: int64
) -> int64 {
    case index >= heap_len of {
        true -> 0;
        false -> {
            priorities_saved: buf(L1, normal, int64, 8) <- priorities;
            index_saved: int64 <- index;
            parent: int64 <- parent_index(index_saved);
            sequence proc[mem(normal)]
                parent_priority: int64 <- read_buf(priorities_saved, parent);
                child_priority: int64 <- read_buf(priorities_saved, index_saved);
                order_ok: int64 <- case parent_priority <= child_priority of {
                    true -> 1;
                    false -> 0
                }
            produces
                pure case order_ok of {
                    0 -> 5;
                    _: int64 -> 0
                }
            end
        }
    }
}

fn validate_heap_order(
    values: buf(L1, normal, int64, 8),
    heap_len: int64
) -> int64 {
    values_saved: buf(L1, normal, int64, 8) <- values;
    heap_len_saved: int64 <- heap_len;
    e1: int64 <- check_heap_order_at(values_saved, heap_len_saved, 1);
    case e1 of {
        0 -> {
            e2: int64 <- check_heap_order_at(values_saved, heap_len_saved, 2);
            case e2 of {
                0 -> {
                    e3: int64 <- check_heap_order_at(values_saved, heap_len_saved, 3);
                    case e3 of {
                        0 -> {
                            e4: int64 <- check_heap_order_at(values_saved, heap_len_saved, 4);
                            case e4 of {
                                0 -> {
                                    e5: int64 <- check_heap_order_at(values_saved, heap_len_saved, 5);
                                    case e5 of {
                                        0 -> {
                                            e6: int64 <- check_heap_order_at(values_saved, heap_len_saved, 6);
                                            case e6 of {
                                                0 -> check_heap_order_at(values_saved, heap_len_saved, 7);
                                                _: int64 -> e6
                                            }
                                        };
                                        _: int64 -> e5
                                    }
                                };
                                _: int64 -> e4
                            }
                        };
                        _: int64 -> e3
                    }
                };
                _: int64 -> e2
            }
        };
        _: int64 -> e1
    }
}

fn validate_priority_heap_order(
    priorities: buf(L1, normal, int64, 8),
    heap_len: int64
) -> int64 {
    priorities_saved: buf(L1, normal, int64, 8) <- priorities;
    heap_len_saved: int64 <- heap_len;
    e1: int64 <- check_priority_heap_order_at(priorities_saved, heap_len_saved, 1);
    case e1 of {
        0 -> {
            e2: int64 <- check_priority_heap_order_at(priorities_saved, heap_len_saved, 2);
            case e2 of {
                0 -> {
                    e3: int64 <- check_priority_heap_order_at(priorities_saved, heap_len_saved, 3);
                    case e3 of {
                        0 -> {
                            e4: int64 <- check_priority_heap_order_at(priorities_saved, heap_len_saved, 4);
                            case e4 of {
                                0 -> {
                                    e5: int64 <- check_priority_heap_order_at(priorities_saved, heap_len_saved, 5);
                                    case e5 of {
                                        0 -> {
                                            e6: int64 <- check_priority_heap_order_at(priorities_saved, heap_len_saved, 6);
                                            case e6 of {
                                                0 -> check_priority_heap_order_at(priorities_saved, heap_len_saved, 7);
                                                _: int64 -> e6
                                            }
                                        };
                                        _: int64 -> e5
                                    }
                                };
                                _: int64 -> e4
                            }
                        };
                        _: int64 -> e3
                    }
                };
                _: int64 -> e2
            }
        };
        _: int64 -> e1
    }
}

fn empty[int64, mem(normal)]() -> {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        values: buf(L1, normal, int64, 8) <- alloc_buf(r, cap());
        heap: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            values: buf(L1, normal, int64, 8)
        } <- {
            region: r,
            len: 0,
            capacity: cap(),
            values: values
        }
    produces
        pure heap
    end
}

fn len[int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    heap.len
}

fn is_empty[int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    case heap.len of {
        0 -> 1;
        _: int64 -> 0
    }
}

fn is_full[int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    case heap.len == heap.capacity of {
        true -> 1;
        false -> 0
    }
}

fn peek[int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8)
}) -> { ok: int64, value: int64 } {
    case heap.len of {
        0 -> { ok: 0, value: 0 };
        _: int64 -> {
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            top: int64 <- sequence proc[mem(normal)]
                value: int64 <- read_buf(values_saved, 0)
            produces
                pure value
            end;
            { ok: 1, value: top }
        }
    }
}

fn push[int64, mem(normal)](
    heap: {
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        values: buf(L1, normal, int64, 8)
    },
    value: int64
) -> {
    heap: {
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        values: buf(L1, normal, int64, 8)
    },
    ok: int64
} {
    case heap.len == heap.capacity of {
        true -> { heap: heap, ok: 0 };
        false -> {
            pushed_value: int64 <- value;
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            heap_len: int64 <- heap.len;
            heap_region: region(L1, normal) <- heap.region;
            heap_capacity: int64 <- heap.capacity;
            insert_index: int64 <- heap_len;
            result: {
                heap: {
                    region: region(L1, normal),
                    len: int64,
                    capacity: int64,
                    values: buf(L1, normal, int64, 8)
                },
                ok: int64
            } <- sequence proc[mem(normal)]
                _: atom <- write_buf(values_saved, insert_index, pushed_value);
                _: atom <- sift_up_min(values_saved, insert_index);
                updated: {
                    region: region(L1, normal),
                    len: int64,
                    capacity: int64,
                    values: buf(L1, normal, int64, 8)
                } <- {
                    region: heap_region,
                    len: heap_len + 1,
                    capacity: heap_capacity,
                    values: values_saved
                };
                push_result: {
                    heap: {
                        region: region(L1, normal),
                        len: int64,
                        capacity: int64,
                        values: buf(L1, normal, int64, 8)
                    },
                    ok: int64
                } <- { heap: updated, ok: 1 }
            produces
                pure push_result
            end;
            result
        }
    }
}

fn pop[int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8)
}) -> {
    heap: {
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        values: buf(L1, normal, int64, 8)
    },
    ok: int64,
    value: int64
} {
    case heap.len of {
        0 -> {
            heap_region: region(L1, normal) <- heap.region;
            heap_len: int64 <- heap.len;
            heap_capacity: int64 <- heap.capacity;
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            unchanged: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                values: buf(L1, normal, int64, 8)
            } <- {
                region: heap_region,
                len: heap_len,
                capacity: heap_capacity,
                values: values_saved
            };
            pop_result: {
                heap: {
                    region: region(L1, normal),
                    len: int64,
                    capacity: int64,
                    values: buf(L1, normal, int64, 8)
                },
                ok: int64,
                value: int64
            } <- {
                heap: unchanged,
                ok: 0,
                value: 0
            };
            pop_result
        };
        _: int64 -> {
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            heap_len: int64 <- heap.len;
            heap_region: region(L1, normal) <- heap.region;
            heap_capacity: int64 <- heap.capacity;
            last_index: int64 <- heap_len - 1;
            new_len: int64 <- heap_len - 1;
            min_value: int64 <- sequence proc[mem(normal)]
                top: int64 <- read_buf(values_saved, 0);
                tail: int64 <- read_buf(values_saved, last_index);
                _: atom <- write_buf(values_saved, 0, tail)
            produces
                pure top
            end;
            _: atom <- case new_len of {
                0 -> :ok;
                _: int64 -> sift_down_min(values_saved, 0, new_len)
            };
            updated: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                values: buf(L1, normal, int64, 8)
            } <- {
                region: heap_region,
                len: new_len,
                capacity: heap_capacity,
                values: values_saved
            };
            pop_result: {
                heap: {
                    region: region(L1, normal),
                    len: int64,
                    capacity: int64,
                    values: buf(L1, normal, int64, 8)
                },
                ok: int64,
                value: int64
            } <- {
                heap: updated,
                ok: 1,
                value: min_value
            };
            pop_result
        }
    }
}

fn validate_shape(
    heap: {
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        values: buf(L1, normal, int64, 8)
    }
) -> int64 {
    heap_len: int64 <- heap.len;
    heap_capacity: int64 <- heap.capacity;
    len_low_ok: int64 <- case heap_len of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> 1;
        4 -> 1;
        5 -> 1;
        6 -> 1;
        7 -> 1;
        8 -> 1;
        _: int64 -> 0
    };
    len_high_ok: int64 <- case heap_len <= heap_capacity of {
        true -> 1;
        false -> 0
    };
    expected_cap: int64 <- cap();
    cap_ok: int64 <- case heap_capacity == expected_cap of {
        true -> 1;
        false -> 0
    };
    case len_low_ok of {
        0 -> 1;
        _: int64 -> case len_high_ok of {
            0 -> 2;
            _: int64 -> case cap_ok of {
                0 -> 3;
                _: int64 -> 0
            }
        }
    }
}

fn validate[int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    values: buf(L1, normal, int64, 8)
}) -> { ok: int64, error_code: int64 } {
    sequence
        heap_len: int64 <- heap.len;
        values_buf: buf(L1, normal, int64, 8) <- heap.values;
        shape_error: int64 <- validate_shape(heap);
        order_error: int64 <- case shape_error of {
            0 -> validate_heap_order(values_buf, heap_len);
            _: int64 -> 0
        };
        err: int64 <- case shape_error of {
            0 -> order_error;
            _: int64 -> shape_error
        };
        ok_value: int64 <- case err of {
            0 -> 1;
            _: int64 -> 0
        };
        result: { ok: int64, error_code: int64 } <- {
            ok: ok_value,
            error_code: err
        }
    produces
        pure result
    end
}

fn empty[int64, int64, mem(normal)]() -> {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        priorities: buf(L1, normal, int64, 8) <- alloc_buf(r, cap());
        values: buf(L1, normal, int64, 8) <- alloc_buf(r, cap());
        heap: {
            region: region(L1, normal),
            len: int64,
            capacity: int64,
            priorities: buf(L1, normal, int64, 8),
            values: buf(L1, normal, int64, 8)
        } <- {
            region: r,
            len: 0,
            capacity: cap(),
            priorities: priorities,
            values: values
        }
    produces
        pure heap
    end
}

fn len[int64, int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    heap.len
}

fn is_empty[int64, int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    case heap.len of {
        0 -> 1;
        _: int64 -> 0
    }
}

fn is_full[int64, int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> int64 {
    case heap.len == heap.capacity of {
        true -> 1;
        false -> 0
    }
}

fn peek_priority[int64, int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> { ok: int64, value: int64 } {
    case heap.len of {
        0 -> { ok: 0, value: 0 };
        _: int64 -> {
            priorities_saved: buf(L1, normal, int64, 8) <- heap.priorities;
            top: int64 <- sequence proc[mem(normal)]
                value: int64 <- read_buf(priorities_saved, 0)
            produces
                pure value
            end;
            { ok: 1, value: top }
        }
    }
}

fn peek_value[int64, int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> { ok: int64, value: int64 } {
    case heap.len of {
        0 -> { ok: 0, value: 0 };
        _: int64 -> {
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            top: int64 <- sequence proc[mem(normal)]
                value: int64 <- read_buf(values_saved, 0)
            produces
                pure value
            end;
            { ok: 1, value: top }
        }
    }
}

fn push_priority_value[int64, int64, mem(normal)](
    heap: {
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        priorities: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8)
    },
    priority: int64,
    value: int64
) -> {
    heap: {
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        priorities: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8)
    },
    ok: int64
} {
    case heap.len == heap.capacity of {
        true -> { heap: heap, ok: 0 };
        false -> {
            pushed_priority: int64 <- priority;
            pushed_value: int64 <- value;
            priorities_saved: buf(L1, normal, int64, 8) <- heap.priorities;
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            heap_len: int64 <- heap.len;
            heap_region: region(L1, normal) <- heap.region;
            heap_capacity: int64 <- heap.capacity;
            insert_index: int64 <- heap_len;
            result: {
                heap: {
                    region: region(L1, normal),
                    len: int64,
                    capacity: int64,
                    priorities: buf(L1, normal, int64, 8),
                    values: buf(L1, normal, int64, 8)
                },
                ok: int64
            } <- sequence proc[mem(normal)]
                _: atom <- write_buf(priorities_saved, insert_index, pushed_priority);
                _: atom <- write_buf(values_saved, insert_index, pushed_value);
                _: atom <- sift_up_min_priority(priorities_saved, values_saved, insert_index);
                updated: {
                    region: region(L1, normal),
                    len: int64,
                    capacity: int64,
                    priorities: buf(L1, normal, int64, 8),
                    values: buf(L1, normal, int64, 8)
                } <- {
                    region: heap_region,
                    len: heap_len + 1,
                    capacity: heap_capacity,
                    priorities: priorities_saved,
                    values: values_saved
                };
                push_result: {
                    heap: {
                        region: region(L1, normal),
                        len: int64,
                        capacity: int64,
                        priorities: buf(L1, normal, int64, 8),
                        values: buf(L1, normal, int64, 8)
                    },
                    ok: int64
                } <- {
                    heap: updated,
                    ok: 1
                }
            produces
                pure push_result
            end;
            result
        }
    }
}

fn pop_priority_value[int64, int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> {
    heap: {
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        priorities: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8)
    },
    ok: int64,
    priority: int64,
    value: int64
} {
    case heap.len of {
        0 -> {
            heap_region: region(L1, normal) <- heap.region;
            heap_len: int64 <- heap.len;
            heap_capacity: int64 <- heap.capacity;
            priorities_saved: buf(L1, normal, int64, 8) <- heap.priorities;
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            unchanged: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                priorities: buf(L1, normal, int64, 8),
                values: buf(L1, normal, int64, 8)
            } <- {
                region: heap_region,
                len: heap_len,
                capacity: heap_capacity,
                priorities: priorities_saved,
                values: values_saved
            };
            pop_result: {
                heap: {
                    region: region(L1, normal),
                    len: int64,
                    capacity: int64,
                    priorities: buf(L1, normal, int64, 8),
                    values: buf(L1, normal, int64, 8)
                },
                ok: int64,
                priority: int64,
                value: int64
            } <- {
                heap: unchanged,
                ok: 0,
                priority: 0,
                value: 0
            };
            pop_result
        };
        _: int64 -> {
            priorities_saved: buf(L1, normal, int64, 8) <- heap.priorities;
            values_saved: buf(L1, normal, int64, 8) <- heap.values;
            heap_len: int64 <- heap.len;
            heap_region: region(L1, normal) <- heap.region;
            heap_capacity: int64 <- heap.capacity;
            last_index: int64 <- heap_len - 1;
            new_len: int64 <- heap_len - 1;
            popped: { priority: int64, value: int64 } <- sequence proc[mem(normal)]
                top_priority: int64 <- read_buf(priorities_saved, 0);
                top_value: int64 <- read_buf(values_saved, 0);
                _: atom <- swap_priority_value_pair(priorities_saved, values_saved, 0, last_index);
                pair: { priority: int64, value: int64 } <- {
                    priority: top_priority,
                    value: top_value
                }
            produces
                pure pair
            end;
            _: atom <- case new_len of {
                0 -> :ok;
                _: int64 -> sift_down_min_priority(priorities_saved, values_saved, 0, new_len)
            };
            updated: {
                region: region(L1, normal),
                len: int64,
                capacity: int64,
                priorities: buf(L1, normal, int64, 8),
                values: buf(L1, normal, int64, 8)
            } <- {
                region: heap_region,
                len: new_len,
                capacity: heap_capacity,
                priorities: priorities_saved,
                values: values_saved
            };
            pop_result: {
                heap: {
                    region: region(L1, normal),
                    len: int64,
                    capacity: int64,
                    priorities: buf(L1, normal, int64, 8),
                    values: buf(L1, normal, int64, 8)
                },
                ok: int64,
                priority: int64,
                value: int64
            } <- {
                heap: updated,
                ok: 1,
                priority: popped.priority,
                value: popped.value
            };
            pop_result
        }
    }
}

fn validate_priority_shape(
    heap: {
        region: region(L1, normal),
        len: int64,
        capacity: int64,
        priorities: buf(L1, normal, int64, 8),
        values: buf(L1, normal, int64, 8)
    }
) -> int64 {
    heap_len: int64 <- heap.len;
    heap_capacity: int64 <- heap.capacity;
    len_low_ok: int64 <- case heap_len of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> 1;
        4 -> 1;
        5 -> 1;
        6 -> 1;
        7 -> 1;
        8 -> 1;
        _: int64 -> 0
    };
    len_high_ok: int64 <- case heap_len <= heap_capacity of {
        true -> 1;
        false -> 0
    };
    expected_cap: int64 <- cap();
    cap_ok: int64 <- case heap_capacity == expected_cap of {
        true -> 1;
        false -> 0
    };
    case len_low_ok of {
        0 -> 1;
        _: int64 -> case len_high_ok of {
            0 -> 2;
            _: int64 -> case cap_ok of {
                0 -> 3;
                _: int64 -> 0
            }
        }
    }
}

fn validate[int64, int64, mem(normal)](heap: {
    region: region(L1, normal),
    len: int64,
    capacity: int64,
    priorities: buf(L1, normal, int64, 8),
    values: buf(L1, normal, int64, 8)
}) -> { ok: int64, error_code: int64 } {
    sequence
        heap_len: int64 <- heap.len;
        priorities_buf: buf(L1, normal, int64, 8) <- heap.priorities;
        shape_error: int64 <- validate_priority_shape(heap);
        order_error: int64 <- case shape_error of {
            0 -> validate_priority_heap_order(priorities_buf, heap_len);
            _: int64 -> 0
        };
        err: int64 <- case shape_error of {
            0 -> order_error;
            _: int64 -> shape_error
        };
        ok_value: int64 <- case err of {
            0 -> 1;
            _: int64 -> 0
        };
        result: { ok: int64, error_code: int64 } <- {
            ok: ok_value,
            error_code: err
        }
    produces
        pure result
    end
}
