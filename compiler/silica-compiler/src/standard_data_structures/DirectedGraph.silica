use graph_adj_list_helpers;
use graph_adj_directed;

export trait DirectedGraph;
export node_count/1;
export edge_count/1;
export neighbors/2;
export edge_target/1;
export has_edge/3;

required {
    fn node_count(graph: DirectedGraph) -> int64;
    fn edge_count(graph: DirectedGraph) -> int64;
    fn neighbors(graph: DirectedGraph, node_id: int64) -> List[int64, mem(normal)];
    fn edge_target(edge: int64) -> int64;
    fn has_edge(graph: DirectedGraph, from_id: int64, to_id: int64) -> boolean;
}

impl fn node_count(graph: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 }) -> int64 {
    graph.node_count
}

impl fn edge_count(graph: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 }) -> int64 {
    graph.edge_count
}

impl fn has_edge(
    graph: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 },
    from_id: int64,
    to_id: int64
) -> boolean {
    graph.edge_count > 0 and graph.first_from == from_id and graph.first_to == to_id
}

impl fn node_count(graph: {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
}) -> int64 {
    graph.node_count
}

impl fn edge_count(graph: {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
}) -> int64 {
    graph.edge_count
}

impl fn neighbors(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[int64, mem(normal)] <- graph_adj_directed@neighbors[int64, int64, mem(normal)](graph, node_id)
    produces
        pure result
    end
}

impl fn edge_target(edge: int64) -> int64 {
    edge
}

fn int64_to_boolean(value: int64) -> boolean {
    case value of {
        0 -> false;
        _: int64 -> true
    }
}

impl fn has_edge(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> boolean {
    sequence proc[mem(normal)]
        raw: int64 <- graph_adj_directed@has_edge[int64, int64, mem(normal)](graph, from_id, to_id);
        result: boolean <- int64_to_boolean(raw)
    produces
        pure result
    end
}
