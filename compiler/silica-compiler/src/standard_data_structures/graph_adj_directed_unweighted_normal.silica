) -> { ok: int64, value: int64 } {
    node_saved: int64 <- node_id;
    in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(node_saved, graph.node_count);
    length_value: int64 <- case node_saved of {
        0 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n0_neighbors);
        1 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n1_neighbors);
        2 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n2_neighbors);
        _: int64 -> 0
    };
    case in_range of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: length_value };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn graph_adj_directed_unweighted_normal_out_degree(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> int64 {
    node_saved: int64 <- node_id;
    case node_saved of {
        0 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n0_neighbors);
        1 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n1_neighbors);
        2 -> graph_adj_list_helpers@graph_adj_list_int64_length(graph.n2_neighbors);
        _: int64 -> 0
    }
}

fn graph_adj_directed_unweighted_normal_validate_edge_delta(edge_delta: int64) -> int64 {
    case edge_delta of {
        0 -> 1;
        _: int64 -> 0
    }
}

fn graph_adj_directed_unweighted_normal_validate_counts(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    l0: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n0_neighbors);
    l1: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n1_neighbors);
    l2: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n2_neighbors);
    edge_total: int64 <- l0 + l1 + l2;
    edge_delta: int64 <- edge_total - graph.edge_count;
    case graph.node_count of {
        0 -> graph_adj_directed_unweighted_normal_validate_edge_delta(edge_delta);
        1 -> graph_adj_directed_unweighted_normal_validate_edge_delta(edge_delta);
        2 -> graph_adj_directed_unweighted_normal_validate_edge_delta(edge_delta);
        3 -> graph_adj_directed_unweighted_normal_validate_edge_delta(edge_delta);
        _: int64 -> 0
    }
}

fn graph_adj_directed_unweighted_normal_validate(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    d0: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n0_neighbors);
    d1: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n1_neighbors);
    d2: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(graph.n2_neighbors);
    edge_total: int64 <- d0 + d1 + d2;
    edge_delta: int64 <- edge_total - graph.edge_count;
    case graph.node_count of {
        0 -> graph_adj_directed_unweighted_normal_validate_edge_delta(edge_delta);
        1 -> graph_adj_directed_unweighted_normal_validate_edge_delta(edge_delta);
        2 -> graph_adj_directed_unweighted_normal_validate_edge_delta(edge_delta);
        3 -> graph_adj_directed_unweighted_normal_validate_edge_delta(edge_delta);
        _: int64 -> 0
    }
}

fn graph_adj_directed_unweighted_normal_reachable_via_mid(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64,
    mid_id: int64
) -> int64 {
    h0: int64 <- graph_adj_directed_unweighted_normal_has_edge(graph, from_id, mid_id);
    h1: int64 <- graph_adj_directed_unweighted_normal_has_edge(graph, mid_id, to_id);
    h0 * h1
}

fn graph_adj_directed_unweighted_normal_reachable(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    to_ok: int64 <- case to_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    safe_from: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> from_saved;
        _: int64 -> 0
    };
    safe_to: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> to_saved;
        _: int64 -> 0
    };
    same_node: int64 <- case from_saved - to_saved of {
        0 -> 1;
        _: int64 -> 0
    };
    direct: int64 <- graph_adj_directed_unweighted_normal_has_edge(graph, safe_from, safe_to);
    path_count: int64 <- same_node + direct;
    path_present: int64 <- case path_count of {
        0 -> 0;
        _: int64 -> 1
    };
    path_present * endpoints_ok
}

fn graph_adj_directed_unweighted_normal_max_out_degree_pair(a: int64, b: int64) -> int64 {
    case a - b of {
        0 -> a;
        _: int64 -> case b - a of {
            0 -> b;
            _: int64 -> a
        }
    }
}

fn graph_adj_directed_unweighted_normal_max_out_degree(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    d0: int64 <- graph_adj_directed_unweighted_normal_out_degree(graph, 0);
    d1: int64 <- graph_adj_directed_unweighted_normal_out_degree(graph, 1);
    d2: int64 <- graph_adj_directed_unweighted_normal_out_degree(graph, 2);
    m01: int64 <- graph_adj_directed_unweighted_normal_max_out_degree_pair(d0, d1);
    graph_adj_directed_unweighted_normal_max_out_degree_pair(m01, d2)
}

fn graph_adj_directed_unweighted_normal_total_out_degree_sum(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    d0: int64 <- graph_adj_directed_unweighted_normal_out_degree(graph, 0);
    d1: int64 <- graph_adj_directed_unweighted_normal_out_degree(graph, 1);
    d2: int64 <- graph_adj_directed_unweighted_normal_out_degree(graph, 2);
    d0 + d1 + d2
}
