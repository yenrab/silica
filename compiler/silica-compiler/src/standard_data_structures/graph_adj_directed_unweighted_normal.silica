// NodeIdAdjacencyGraph directed unweighted, memory space normal (graph_representation_design.md §3).
// Bootstrap layout: fixed neighbor slots for node ids 0..2 (flat lists, emitter-safe).

use graph_adj_list_helpers;

export graph_adj_directed_unweighted_normal_empty/1;
export graph_adj_directed_unweighted_normal_node_count/1;
export graph_adj_directed_unweighted_normal_edge_count/1;
export graph_adj_directed_unweighted_normal_add_edge/3;
export graph_adj_directed_unweighted_normal_add_edge_checked/3;
export graph_adj_directed_unweighted_normal_add_edge_slot0/2;
export graph_adj_directed_unweighted_normal_add_edge_slot1/2;
export graph_adj_directed_unweighted_normal_add_edge_slot2/2;
export graph_adj_directed_unweighted_normal_neighbors/2;
export graph_adj_directed_unweighted_normal_neighbors_checked/2;
export graph_adj_directed_unweighted_normal_out_degree/2;
export graph_adj_directed_unweighted_normal_out_degree_checked/2;
export graph_adj_directed_unweighted_normal_has_edge/3;
export graph_adj_directed_unweighted_normal_has_edge_checked/3;
export graph_adj_directed_unweighted_normal_validate/1;
export graph_adj_directed_unweighted_normal_reachable/3;
export graph_adj_directed_unweighted_normal_max_out_degree/1;
export graph_adj_directed_unweighted_normal_total_out_degree_sum/1;

fn graph_adj_directed_unweighted_normal_empty(initial_node_count: int64) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    sequence proc[mem(normal)]
        n0_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n1_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n2_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: initial_node_count,
            edge_count: 0,
            n0_neighbors: n0_empty,
            n1_neighbors: n1_empty,
            n2_neighbors: n2_empty
        }
    produces
        pure graph
    end
}

fn graph_adj_directed_unweighted_normal_node_count(graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    graph.node_count
}

fn graph_adj_directed_unweighted_normal_edge_count(graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    graph.edge_count
}

fn graph_adj_directed_unweighted_normal_empty_int64_list() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure empty_neighbors
    end
}

fn graph_adj_directed_unweighted_normal_prepend_slot(
    old_neighbors: List[int64, mem(normal)],
    to_id: int64
) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        updated: List[int64, mem(normal)] <- prepend[int64, mem(normal)](to_id, old_neighbors)
    produces
        pure updated
    end
}

fn graph_adj_directed_unweighted_normal_neighbors_list(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64,
    empty_neighbors: List[int64, mem(normal)]
) -> List[int64, mem(normal)] {
    case node_id of {
        0 -> graph.n0_neighbors;
        1 -> graph.n1_neighbors;
        2 -> graph.n2_neighbors;
        _: int64 -> empty_neighbors
    }
}

fn graph_adj_directed_unweighted_normal_add_edge_slot0(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    sequence proc[mem(normal)]
        updated: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: graph.node_count,
            edge_count: graph.edge_count + 1,
            n0_neighbors: graph_adj_directed_unweighted_normal_prepend_slot(graph.n0_neighbors, to_id),
            n1_neighbors: graph.n1_neighbors,
            n2_neighbors: graph.n2_neighbors
        }
    produces
        pure updated
    end
}

