fn insert_in_leaf_not_found(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    key: int64,
    value: int64,
    insert_slot: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        insert_slot_saved: int64 <- insert_slot;
        node_id_saved: int64 <- node.id;
        node_keys_saved: List[int64, mem(normal)] <- node.keys;
        node_values_saved: List[int64, mem(normal)] <- node.values;
        node_children_saved: List[int64, mem(normal)] <- node.children;
        new_keys: List[int64, mem(normal)] <- insert_int64_at(node_keys_saved, insert_slot_saved, key_saved);
        new_vals: List[int64, mem(normal)] <- insert_int64_at(node_values_saved, insert_slot_saved, value_saved);
        new_key_count: int64 <- list_int64_length(new_keys);
        new_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: node_id_saved,
            key_count: new_key_count,
            is_leaf: 1,
            keys: new_keys,
            values: new_vals,
            children: node_children_saved
        };
        new_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            replace_node(tree.nodes, node_id_saved, new_node);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- wrap_tree_inserted(tree, new_nodes)
    produces
        pure result
    end
}

fn insert_in_leaf_found(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    key: int64,
    new_payload: int64,
    replace_slot: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        new_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            make_replaced_leaf_node(node, new_payload, replace_slot);
        new_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            replace_node(tree.nodes, node.id, new_node);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- wrap_tree_replaced(tree, new_nodes)
    produces
        pure result
    end
}

fn make_replaced_leaf_node(
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    new_payload: int64,
    replace_slot: int64
) -> { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        payload_value: int64 <- new_payload + 0;
        new_vals: List[int64, mem(normal)] <- replace_int64_at(node.values, replace_slot, payload_value);
        new_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: node.id,
            key_count: node.key_count,
            is_leaf: 1,
            keys: node.keys,
            values: new_vals,
            children: node.children
        }
    produces
        pure new_node
    end
}

fn insert_in_leaf(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        node_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- node;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        key_result: { found: int64, slot: int64 } <- search_key_list(node_saved.keys, key_saved);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case key_result.found of {
            1 -> insert_in_leaf_found(tree_saved, node_saved, key_saved, value, key_result.slot);
            _: int64 -> insert_in_leaf_not_found(tree_saved, node_saved, key_saved, value_saved, key_result.slot)
        }
    produces
        pure result
    end
}

fn replace_value_in_internal(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    value: int64,
    replace_slot: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        node_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- node;
        value_saved: int64 <- value;
        replace_slot_saved: int64 <- replace_slot;
        node_id_saved: int64 <- node_saved.id;
        node_key_count_saved: int64 <- node_saved.key_count;
        node_is_leaf_saved: int64 <- node_saved.is_leaf;
        node_keys_saved: List[int64, mem(normal)] <- node_saved.keys;
        node_values_saved: List[int64, mem(normal)] <- node_saved.values;
        node_children_saved: List[int64, mem(normal)] <- node_saved.children;
        new_vals: List[int64, mem(normal)] <- replace_int64_at(node_values_saved, replace_slot_saved, value_saved);
        new_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: node_id_saved,
            key_count: node_key_count_saved,
            is_leaf: node_is_leaf_saved,
            keys: node_keys_saved,
            values: new_vals,
            children: node_children_saved
        };
        new_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            replace_node(tree_saved.nodes, node_id_saved, new_node);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- wrap_tree_replaced(tree_saved, new_nodes)
    produces
        pure result
    end
}

fn insert_nonfull_after_split(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    parent_id: int64,
    key: int64,
    value: int64,
    original_index: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        parent_id_saved: int64 <- parent_id;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        original_index_saved: int64 <- original_index;
        parent_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_saved.nodes, parent_id_saved);
        parent_keys_saved: List[int64, mem(normal)] <- parent_result.keys;
        parent_children_saved: List[int64, mem(normal)] <- parent_result.children;
        pivot: int64 <- nth_int64(parent_keys_saved, original_index_saved);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case key_saved == pivot of {
            true -> replace_value_in_internal(tree_saved, parent_result, value_saved, original_index_saved);
            false -> {
                next_index: int64 <- case key_saved > pivot of {
                    true -> original_index_saved + 1;
                    false -> original_index_saved
                };
                child_id: int64 <- nth_int64(parent_children_saved, next_index);
                insert_nonfull(tree_saved, child_id, key_saved, value_saved)
            }
        }
    produces
        pure result
    end
}

fn insert_nonfull_child(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    key: int64,
    value: int64,
    search_index: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        node_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- node;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        search_index_saved: int64 <- search_index;
        node_id_saved: int64 <- node_saved.id;
        node_children_saved: List[int64, mem(normal)] <- node_saved.children;
        child_id: int64 <- nth_int64(node_children_saved, search_index_saved);
        child_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_saved.nodes, child_id);
        child_key_count_saved: int64 <- child_result.key_count;
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case child_key_count_saved == max_keys() of {
            true -> insert_nonfull_after_split(
                split_child(tree_saved, node_id_saved, search_index_saved),
                node_id_saved,
                key_saved,
                value_saved,
                search_index_saved
            );
            false -> insert_nonfull(tree_saved, child_id, key_saved, value_saved)
        }
    produces
        pure result
    end
}

fn insert_nonfull(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    node_id: int64,
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        node_id_saved: int64 <- node_id;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        node_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_saved.nodes, node_id_saved);
        node_found: int64 <- node_exists(tree_saved.nodes, node_id_saved);
        key_found: int64 <- search_key_list_found_at(node_result.keys, key_saved, 0);
        key_slot: int64 <- search_key_list_slot_at(node_result.keys, key_saved, 0);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case node_found of {
            0 -> { tree: tree_saved, inserted: 0, replaced: 0 };
            _: int64 -> case node_result.is_leaf of {
                1 -> insert_in_leaf(tree_saved, node_result, key_saved, value_saved);
                _: int64 -> case key_found of {
                    1 -> replace_value_in_internal(tree_saved, node_result, value_saved, key_slot);
                    _: int64 -> insert_nonfull_child(tree_saved, node_result, key_saved, value_saved, key_slot)
                }
            }
        }
    produces
        pure result
    end
}

fn insert_into_nonempty(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        root_saved: int64 <- tree.root_id;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        root_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_saved.nodes, root_saved);
        root_key_count: int64 <- root_result.key_count;
        max_k: int64 <- max_keys();
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case root_key_count == max_k of {
            true -> insert_split_root(tree_saved, key_saved, value_saved);
            false -> insert_nonfull(tree_saved, root_saved, key_saved, value_saved)
        }
    produces
        pure result
    end
}

fn insert_split_root(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        tree_node_count_saved: int64 <- tree_saved.node_count;
        tree_root_id_saved: int64 <- tree_saved.root_id;
        tree_order_saved: int64 <- tree_saved.order;
        tree_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tree_saved.nodes;
        new_root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            make_internal_root(tree_node_count_saved, tree_root_id_saved);
        new_root_id_saved: int64 <- new_root.id;
        nodes_with_new_root: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend_node(new_root, tree_nodes_saved);
        tree_with_new_root: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: new_root_id_saved,
            node_count: tree_node_count_saved + 1,
            order: tree_order_saved,
            nodes: nodes_with_new_root
        };
        split_tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- split_child(tree_with_new_root, new_root_id_saved, 0);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- insert_nonfull(split_tree, new_root_id_saved, key_saved, value_saved)
    produces
        pure result
    end
}

fn insert_root_leaf(
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            make_leaf_map_node(0, key, value);
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)](root, empty_nodes);
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: 0,
            node_count: 1,
            order: order(),
            nodes: nodes
        };
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- { tree: tree, inserted: 1, replaced: 0 }
    produces
        pure result
    end
}

