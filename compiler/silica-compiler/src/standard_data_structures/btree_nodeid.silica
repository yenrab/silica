            false -> 0
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn key_count_in_list_cons(head: int64, tail: List[int64, mem(normal)], key: int64) -> int64 {
    case head == key of {
        true -> 1 + key_count_in_list(tail, key);
        false -> key_count_in_list(tail, key)
    }
}

fn key_count_in_list(values: List[int64, mem(normal)], key: int64) -> int64 {
    case values of {
        []: List[int64, mem(normal)] -> 0;
        [head: int64, tail: List[int64, mem(normal)]] -> key_count_in_list_cons(head, tail, key);
        _: List[int64, mem(normal)] -> 0
    }
}

fn node_id_count(
