fn insert_into_split_root_child(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    key: int64,
    value: int64,
    child_index: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        child_index_saved: int64 <- child_index;
        child_id: int64 <- nth_int64(root_node.children, child_index_saved);
        child_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- find_node(tree_saved.nodes, child_id);
        key_result: { found: int64, slot: int64 } <- search_key_list(child_node.keys, key_saved);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case key_result.found of {
            1 -> split_root_child_found_direct(tree_saved, root_node, child_node, value_saved, key_result.slot);
            _: int64 -> case child_node.key_count == max_keys() of {
                true -> insert_nonfull_after_split(split_child(tree_saved, root_node.id, child_index_saved), root_node.id, key_saved, value_saved, child_index_saved);
                false -> split_root_child_not_found_direct(tree_saved, root_node, child_node, key_saved, value_saved, key_result.slot)
            }
        }
    produces
        pure result
    end
}

fn rebuild_split_root_with_child(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    child_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }
) -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence proc[mem(normal)]
        left_id: int64 <- nth_int64(root_node.children, 0);
        right_id: int64 <- nth_int64(root_node.children, 1);
        found_left: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- find_node(tree.nodes, left_id);
        found_right: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- find_node(tree.nodes, right_id);
        left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- case child_node.id == left_id of {
            true -> child_node;
            false -> found_left
        };
        right_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- case child_node.id == right_id of {
            true -> child_node;
            false -> found_right
        };
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- empty_node_list();
        with_right: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(right_node, empty_nodes);
        with_root: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(root_node, with_right);
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(left_node, with_root);
        result: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: tree.root_id,
            node_count: tree.node_count,
            order: tree.order,
            nodes: nodes
        }
    produces
        pure result
    end
}

fn split_root_child_found_direct(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    child_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    value: int64,
    slot: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        new_values: List[int64, mem(normal)] <- replace_int64_at(child_node.values, slot, value);
        new_child: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: child_node.id,
            key_count: child_node.key_count,
            is_leaf: child_node.is_leaf,
            keys: child_node.keys,
            values: new_values,
            children: child_node.children
        };
        new_tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- rebuild_split_root_with_child(tree, root_node, new_child);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- { tree: new_tree, inserted: 0, replaced: 1 }
    produces
        pure result
    end
}

fn split_root_child_not_found_direct(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    child_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    key: int64,
    value: int64,
    slot: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        new_keys: List[int64, mem(normal)] <- insert_int64_at(child_node.keys, slot, key);
        new_values: List[int64, mem(normal)] <- insert_int64_at(child_node.values, slot, value);
        new_key_count: int64 <- list_int64_length(new_keys);
        new_child: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: child_node.id,
            key_count: new_key_count,
            is_leaf: child_node.is_leaf,
            keys: new_keys,
            values: new_values,
            children: child_node.children
        };
        new_tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- rebuild_split_root_with_child(tree, root_node, new_child);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- { tree: new_tree, inserted: 1, replaced: 0 }
    produces
        pure result
    end
}

fn insert[int64, int64, mem(normal)](
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- find_node(tree_saved.nodes, tree_saved.root_id);
        root_key_found: int64 <- search_key_list_found_at(root_node.keys, key_saved, 0);
        root_key_slot: int64 <- search_key_list_slot_at(root_node.keys, key_saved, 0);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case tree_saved.root_id of {
            -1 -> insert_root_leaf(key_saved, value_saved);
            _: int64 -> case root_node.is_leaf == 1 of {
                true -> case root_key_found of {
                    1 -> insert_in_leaf_found(tree_saved, root_node, key_saved, value_saved, root_key_slot);
                    _: int64 -> case root_node.key_count == max_keys() of {
                        true -> insert_root_leaf_by_rebuild(tree_saved, key_saved, value_saved);
                        false -> insert_into_nonempty(tree_saved, key_saved, value_saved)
                    }
                };
                false -> case tree_saved.node_count == 3 of {
                    true -> insert_into_split_root_generated(tree_saved, key_saved, value_saved);
                    false -> insert_into_nonempty(tree_saved, key_saved, value_saved)
                }
            }
        }
    produces
        pure result
    end
}

fn node_id_in_range(node_id: int64, node_count: int64) -> int64 {
    case node_id >= 0 of {
        false -> 0;
        true -> case node_id < node_count of {
            true -> 1;
            false -> 0
        }
    }
}

fn child_ids_valid(children: List[int64, mem(normal)], node_count: int64) -> int64 {
    case children of {
        []: List[int64, mem(normal)] -> 1;
        [head: int64, tail: List[int64, mem(normal)]] -> case node_id_in_range(head, node_count) == 1 of {
            true -> child_ids_valid(tail, node_count);
            false -> 0
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn non_root_occupancy_ok(node_id: int64, root_id: int64, key_count: int64) -> int64 {
    case node_id == root_id of {
        true -> 1;
        false -> case key_count >= min_keys_non_root() of {
            true -> 1;
            false -> 0
        }
    }
}

fn child_shape_error(
    is_leaf: int64,
    key_count: int64,
    children: List[int64, mem(normal)],
    child_len: int64,
    node_count: int64
) -> int64 {
    case is_leaf of {
        1 -> case child_len == 0 of {
            true -> 0;
            false -> 7
        };
        _: int64 -> case child_len == key_count + 1 of {
            false -> 7;
            true -> case child_ids_valid(children, node_count) == 1 of {
                true -> 0;
                false -> 3
            }
        }
    }
}

fn node_basic_error(
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64,
    node_count: int64
) -> int64 {
    sequence
        node_id_saved: int64 <- node.id;
        key_count_saved: int64 <- node.key_count;
        is_leaf_saved: int64 <- node.is_leaf;
        keys_saved: List[int64, mem(normal)] <- node.keys;
        children_saved: List[int64, mem(normal)] <- node.children;
        root_saved: int64 <- root_id;
        node_count_saved: int64 <- node_count;
        key_len: int64 <- list_int64_length(keys_saved);
        id_count: int64 <- node_id_count(all_nodes, node_id_saved);
        result: int64 <- case node_id_in_range(node_id_saved, node_count_saved) == 1 of {
            false -> 3;
            true -> case id_count == 1 of {
                false -> 2;
                true -> case key_len == key_count_saved of {
                    false -> 4;
                    true -> case key_count_saved <= max_keys() of {
                        false -> 8;
                        true -> case non_root_occupancy_ok(node_id_saved, root_saved, key_count_saved) == 1 of {
                            false -> 8;
                            true -> case keys_sorted_unique(keys_saved) == 1 of {
                                false -> 5;
                                true -> case list_int64_length(node.values) == key_count_saved of {
                                    false -> 11;
                                    true -> child_shape_error_auto(is_leaf_saved, key_count_saved, children_saved, node_count_saved)
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}

fn child_shape_error_auto(
    is_leaf: int64,
    key_count: int64,
    children: List[int64, mem(normal)],
    node_count: int64
) -> int64 {
    sequence
        child_len: int64 <- list_int64_length(children);
        result: int64 <- child_shape_error(is_leaf, key_count, children, child_len, node_count)
    produces
        pure result
    end
}

fn nodes_basic_error(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64,
    node_count: int64
) -> int64 {
