fn search_key_slot_by_index(keys: List[int64, mem(normal)], key: int64, index: int64, key_count: int64) -> int64 {
    case index >= key_count of {
        true -> key_count;
        false -> {
            current: int64 <- nth_int64(keys, index);
            case key < current of {
                true -> index;
                false -> case current == key of {
                    true -> index;
                    false -> search_key_slot_by_index(keys, key, index + 1, key_count)
                }
            }
        }
    }
}

fn key_at_matches(keys: List[int64, mem(normal)], key: int64, index: int64) -> int64 {
    sequence
        current: int64 <- nth_int64(keys, index);
        result: int64 <- case current == key of {
            true -> 1;
            false -> 0
        }
    produces
        pure result
    end
}

fn contains_found_node(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    key_count: int64,
    is_leaf: int64,
    keys: List[int64, mem(normal)],
    children: List[int64, mem(normal)],
    key: int64
) -> int64 {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        key_count_saved: int64 <- key_count;
        is_leaf_saved: int64 <- is_leaf;
        keys_saved: List[int64, mem(normal)] <- keys;
        children_saved: List[int64, mem(normal)] <- children;
        key_saved: int64 <- key;
        key_found: int64 <- contains_key_by_index(keys_saved, key_saved, 0, key_count_saved);
        result: int64 <- case key_found of {
            0 -> case is_leaf_saved of {
                1 -> 0;
                _: int64 -> contains_descend(all_nodes_saved, key_count_saved, keys_saved, children_saved, key_saved)
            };
            _: int64 -> 1
        }
    produces
        pure result
    end
}

fn contains_descend(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    key_count: int64,
    keys: List[int64, mem(normal)],
    children: List[int64, mem(normal)],
    key: int64
) -> int64 {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        children_saved: List[int64, mem(normal)] <- children;
        key_saved: int64 <- key;
        key_slot: int64 <- search_key_slot_by_index(keys, key_saved, 0, key_count);
        child_id: int64 <- nth_int64(children_saved, key_slot);
        result: int64 <- contains_node(all_nodes_saved, child_id, key_saved)
    produces
        pure result
    end
}

fn contains_node_scan_cons(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    key: int64
) -> int64 {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        tail_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tail;
        node_id_saved: int64 <- node_id;
        key_saved: int64 <- key;
        result: int64 <- case head.id == node_id_saved of {
            true -> contains_found_node(all_nodes_saved, head.key_count, head.is_leaf, head.keys, head.children, key_saved);
            false -> contains_node_scan(all_nodes_saved, tail_saved, node_id_saved, key_saved)
        }
    produces
        pure result
    end
}

fn contains_node_scan(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    scan_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    key: int64
) -> int64 {
    sequence proc[mem(normal)]
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        node_id_saved: int64 <- node_id;
        key_saved: int64 <- key;
        result: int64 <- case scan_nodes of {
            []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0;
            [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
                contains_node_scan_cons(all_nodes_saved, head, tail, node_id_saved, key_saved);
            _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0
        }
    produces
        pure result
    end
}

fn contains_node(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    key: int64
) -> int64 {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        result: int64 <- contains_node_scan(all_nodes_saved, all_nodes_saved, node_id, key)
    produces
        pure result
    end
}

fn contains[int64, int64, mem(normal)](
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> int64 {
    sequence
        key_saved: int64 <- key;
        found: { found: int64, value: int64 } <- get[int64, int64, mem(normal)](tree, key_saved);
        result: int64 <- found.found
    produces
        pure result
    end
}

fn get_found_node(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    key_count: int64,
    is_leaf: int64,
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)],
    children: List[int64, mem(normal)],
    key: int64
) -> { found: int64, value: int64 } {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        key_count_saved: int64 <- key_count;
        is_leaf_saved: int64 <- is_leaf;
        keys_saved: List[int64, mem(normal)] <- keys;
        values_saved: List[int64, mem(normal)] <- values;
        children_saved: List[int64, mem(normal)] <- children;
        key_saved: int64 <- key;
        key_slot: int64 <- search_key_list_slot_at(keys_saved, key_saved, 0);
        key_found: int64 <- contains_key_by_index(keys_saved, key_saved, 0, key_count_saved);
        result: { found: int64, value: int64 } <- case key_found of {
            0 -> case is_leaf_saved of {
                1 -> { found: 0, value: 0 };
                _: int64 -> get_descend(all_nodes_saved, key_count_saved, keys_saved, values_saved, children_saved, key_saved)
            };
            _: int64 -> { found: 1, value: value_for_key(keys_saved, values_saved, key_saved) }
        }
    produces
        pure result
    end
}

fn value_for_key(
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)],
    key: int64
) -> int64 {
    case keys of {
        []: List[int64, mem(normal)] -> 0;
        [key_head: int64, key_tail: List[int64, mem(normal)]] -> case values of {
            []: List[int64, mem(normal)] -> 0;
            [value_head: int64, value_tail: List[int64, mem(normal)]] -> case key_head == key of {
                true -> value_head;
                false -> value_for_key(key_tail, value_tail, key)
            };
            _: List[int64, mem(normal)] -> 0
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn get_descend(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    key_count: int64,
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)],
    children: List[int64, mem(normal)],
    key: int64
) -> { found: int64, value: int64 } {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        children_saved: List[int64, mem(normal)] <- children;
        key_saved: int64 <- key;
        key_slot: int64 <- search_key_slot_by_index(keys, key_saved, 0, key_count);
        child_id: int64 <- nth_int64(children_saved, key_slot);
        result: { found: int64, value: int64 } <- get_node(all_nodes_saved, child_id, key_saved)
    produces
        pure result
    end
}

fn get_node_scan_cons(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    key: int64
) -> { found: int64, value: int64 } {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        tail_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tail;
        node_id_saved: int64 <- node_id;
        key_saved: int64 <- key;
        result: { found: int64, value: int64 } <- case head.id == node_id_saved of {
            true -> get_found_node(all_nodes_saved, head.key_count, head.is_leaf, head.keys, head.values, head.children, key_saved);
            false -> get_node_scan(all_nodes_saved, tail_saved, node_id_saved, key_saved)
        }
    produces
        pure result
    end
}

fn get_node_scan(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    scan_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    key: int64
) -> { found: int64, value: int64 } {
    sequence proc[mem(normal)]
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        node_id_saved: int64 <- node_id;
        key_saved: int64 <- key;
        result: { found: int64, value: int64 } <- case scan_nodes of {
            []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { found: 0, value: 0 };
            [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
                get_node_scan_cons(all_nodes_saved, head, tail, node_id_saved, key_saved);
            _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { found: 0, value: 0 }
        }
    produces
        pure result
    end
}

fn get_node(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    key: int64
) -> { found: int64, value: int64 } {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        key_saved: int64 <- key;
        result: { found: int64, value: int64 } <- get_node_scan(all_nodes_saved, all_nodes_saved, node_id, key_saved)
    produces
        pure result
    end
}

fn get_generated_split(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> { found: int64, value: int64 } {
    get_generated_split_nodes(tree.nodes, key)
}

fn get_position_node(
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    key: int64
) -> { found: int64, value: int64 } {
    sequence
        key_result: { found: int64, slot: int64 } <- search_key_list(node.keys, key);
        result: { found: int64, value: int64 } <- case key_result.found of {
            1 -> { found: 1, value: nth_int64(node.values, key_result.slot) };
            _: int64 -> { found: 0, value: 0 }
        }
    produces
        pure result
    end
}

fn get_generated_split_three(
    left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    right_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    key: int64
) -> { found: int64, value: int64 } {
    sequence
        left_result: { found: int64, value: int64 } <- get_position_node(left_node, key);
        root_result: { found: int64, value: int64 } <- get_position_node(root_node, key);
        right_result: { found: int64, value: int64 } <- get_position_node(right_node, key);
        result: { found: int64, value: int64 } <- case left_result.found of {
            1 -> left_result;
            _: int64 -> case root_result.found of {
                1 -> root_result;
                _: int64 -> right_result
            }
        }
    produces
        pure result
    end
}

fn get_generated_split_tail(
    left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    rest: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    key: int64
) -> { found: int64, value: int64 } {
    case rest of {
        [root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            case tail of {
                [right_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
                    get_generated_split_three(left_node, root_node, right_node, key);
                _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { found: 0, value: 0 }
            };
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { found: 0, value: 0 }
    }
}

fn get_generated_split_nodes(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    key: int64
) -> { found: int64, value: int64 } {
    case nodes of {
        [left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, rest: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            get_generated_split_tail(left_node, rest, key);
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { found: 0, value: 0 }
    }
}

fn get[int64, int64, mem(normal)](
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> { found: int64, value: int64 } {
    sequence
        nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tree.nodes;
        root_saved: int64 <- tree.root_id;
        key_saved: int64 <- key;
        result: { found: int64, value: int64 } <- case root_saved of {
            -1 -> { found: 0, value: 0 };
            _: int64 -> case tree.node_count == 3 of {
                true -> get_generated_split(tree, key_saved);
                false -> get_node(nodes_saved, root_saved, key_saved)
            }
        }
    produces
        pure result
    end
}

fn single_key_list(key: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        tail: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        values: List[int64, mem(normal)] <- prepend[int64, mem(normal)](key, tail)
    produces
        pure values
    end
}

fn single_child_list(child_id: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        tail: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        values: List[int64, mem(normal)] <- prepend[int64, mem(normal)](child_id, tail)
    produces
        pure values
    end
}

fn make_leaf_map_node(
    node_id: int64,
    key: int64,
    value: int64
) -> { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        value_saved: int64 <- value;
        keys: List[int64, mem(normal)] <- single_key_list(key);
        vals: List[int64, mem(normal)] <- single_key_list(value_saved);
        children: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: node_id,
            key_count: 1,
            is_leaf: 1,
            keys: keys,
            values: vals,
            children: children
        }
    produces
        pure node
    end
}

fn make_internal_root(
    node_id: int64,
    child_id: int64
) -> { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        keys: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        vals: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        children: List[int64, mem(normal)] <- single_child_list(child_id);
        node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: node_id,
            key_count: 0,
            is_leaf: 0,
            keys: keys,
            values: vals,
            children: children
        }
    produces
        pure node
    end
}

fn list_int64_length_all(values: List[int64, mem(normal)]) -> int64 {
    case values of {
        []: List[int64, mem(normal)] -> 0;
        [_: int64, tail: List[int64, mem(normal)]] -> 1 + list_int64_length_all(tail);
        _: List[int64, mem(normal)] -> 0
    }
}

fn keys_sorted_unique_all(values: List[int64, mem(normal)]) -> int64 {
    case values of {
        []: List[int64, mem(normal)] -> 1;
        [head: int64, tail: List[int64, mem(normal)]] -> keys_sorted_unique_all_after(head, tail);
        _: List[int64, mem(normal)] -> 0
    }
}

fn keys_sorted_unique_all_after(prev: int64, values: List[int64, mem(normal)]) -> int64 {
    case values of {
        []: List[int64, mem(normal)] -> 1;
        [head: int64, tail: List[int64, mem(normal)]] -> case prev < head of {
            true -> keys_sorted_unique_all_after(head, tail);
            false -> 0
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn append_int64(left: List[int64, mem(normal)], right: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case left of {
        []: List[int64, mem(normal)] -> right;
        [head: int64, tail: List[int64, mem(normal)]] -> append_int64_cons(head, tail, right);
        _: List[int64, mem(normal)] -> right
    }
}

fn append_int64_cons(head: int64, tail: List[int64, mem(normal)], right: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        rest: List[int64, mem(normal)] <- append_int64(tail, right);
        result: List[int64, mem(normal)] <- prepend_int64(head, rest)
    produces
        pure result
    end
}

fn make_leaf_map_node_from_entries(
    node_id: int64,
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)]
) -> { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        keys_saved: List[int64, mem(normal)] <- keys;
        values_saved: List[int64, mem(normal)] <- values;
        children: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        key_count_value: int64 <- list_int64_length_all(keys_saved);
        node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: node_id,
            key_count: key_count_value,
            is_leaf: 1,
            keys: keys_saved,
            values: values_saved,
            children: children
        }
    produces
        pure node
    end
}

fn make_internal_root_from_parts(
    key: int64,
    value: int64,
    left_id: int64,
    right_id: int64
) -> { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        keys: List[int64, mem(normal)] <- single_key_list(key);
        vals: List[int64, mem(normal)] <- single_key_list(value);
        right_tail: List[int64, mem(normal)] <- single_child_list(right_id);
        children: List[int64, mem(normal)] <- prepend_int64(left_id, right_tail);
        node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: 1,
            key_count: 1,
            is_leaf: 0,
            keys: keys,
            values: vals,
            children: children
        }
    produces
        pure node
    end
}

fn node_with_id(
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    node_id: int64
) -> { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } {
    sequence
        result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: node_id,
            key_count: node.key_count,
            is_leaf: node.is_leaf,
            keys: node.keys,
            values: node.values,
            children: node.children
        }
    produces
        pure result
    end
}

fn retag_split_nodes_third(
    first: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    second: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    third: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }
) -> List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        third_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- node_with_id(third, 2);
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- empty_node_list();
        with_third: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(third_node, empty_nodes);
        second_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- node_with_id(second, 1);
        with_second: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(second_node, with_third);
        first_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- node_with_id(first, 0);
        result: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(first_node, with_second)
    produces
        pure result
    end
}

fn retag_split_nodes_second(
    first: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    rest: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] {
    case rest of {
        [second: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            case tail of {
                [third: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
                    retag_split_nodes_third(first, second, third);
                _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> rest
            };
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> rest
    }
}

fn retag_split_nodes(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] {
    case nodes of {
        [first: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, rest: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            retag_split_nodes_second(first, rest);
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> nodes
    }
}

fn mid_index_for_count(count: int64) -> int64 {
    case count of {
        8 -> 3;
        9 -> 4;
        10 -> 4;
        11 -> 5;
        12 -> 5;
        13 -> 6;
        14 -> 6;
        _: int64 -> 7
    }
}

fn build_leaf_tree_from_sorted_entries(
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)]
) -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence proc[mem(normal)]
        root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            make_leaf_map_node_from_entries(0, keys, values);
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- empty_node_list();
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(root, empty_nodes);
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: 0,
            node_count: 1,
            order: order(),
            nodes: nodes
        }
    produces
        pure tree
    end
}

fn build_split_tree_from_sorted_entries(
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)]
) -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence proc[mem(normal)]
        key_count_value: int64 <- list_int64_length_all(keys);
        mid_index: int64 <- mid_index_for_count(key_count_value);
        separator_key: int64 <- nth_int64(keys, mid_index);
        separator_value: int64 <- nth_int64(values, mid_index);
        left_keys: List[int64, mem(normal)] <- take_int64(keys, mid_index);
        left_values: List[int64, mem(normal)] <- take_int64(values, mid_index);
        right_keys: List[int64, mem(normal)] <- drop_int64(keys, mid_index + 1);
        right_values: List[int64, mem(normal)] <- drop_int64(values, mid_index + 1);
        left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            make_leaf_map_node_from_entries(0, left_keys, left_values);
        root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            make_internal_root_from_parts(separator_key, separator_value, 0, 2);
        right_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            make_leaf_map_node_from_entries(2, right_keys, right_values);
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- empty_node_list();
        with_right: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(right_node, empty_nodes);
        with_root: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(root_node, with_right);
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- prepend_node(left_node, with_root);
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: 1,
            node_count: 3,
            order: order(),
            nodes: nodes
        }
    produces
        pure tree
    end
}

fn build_tree_from_sorted_entries(
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)]
) -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence
        key_count_value: int64 <- list_int64_length_all(keys);
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- case key_count_value <= max_keys() of {
            true -> build_leaf_tree_from_sorted_entries(keys, values);
            false -> build_split_tree_from_sorted_entries(keys, values)
        }
    produces
        pure tree
    end
}

fn sorted_insert_entry_found(
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)],
    slot: int64,
    value: int64
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)], inserted: int64, replaced: int64 } {
    sequence proc[mem(normal)]
        values_saved: List[int64, mem(normal)] <- values;
        slot_saved: int64 <- slot;
        value_saved: int64 <- value;
        updated_values: List[int64, mem(normal)] <- replace_int64_at(values_saved, slot_saved, value_saved);
        result: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)], inserted: int64, replaced: int64 } <- {
            keys: keys,
            values: updated_values,
            inserted: 0,
            replaced: 1
        }
    produces
        pure result
    end
}

fn sorted_insert_entry_not_found(
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)],
    slot: int64,
    key: int64,
    value: int64
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)], inserted: int64, replaced: int64 } {
    sequence proc[mem(normal)]
        slot_saved: int64 <- slot;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        updated_keys: List[int64, mem(normal)] <- insert_int64_at(keys, slot_saved, key_saved);
        updated_values: List[int64, mem(normal)] <- insert_int64_at(values, slot_saved, value_saved);
        result: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)], inserted: int64, replaced: int64 } <- {
            keys: updated_keys,
            values: updated_values,
            inserted: 1,
            replaced: 0
        }
    produces
        pure result
    end
}

fn sorted_insert_entry(
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)],
    key: int64,
    value: int64
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)], inserted: int64, replaced: int64 } {
    sequence
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        key_result: { found: int64, slot: int64 } <- search_key_list(keys, key_saved);
        result: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)], inserted: int64, replaced: int64 } <- case key_result.found of {
            1 -> sorted_insert_entry_found(keys, values, key_result.slot, value_saved);
            _: int64 -> sorted_insert_entry_not_found(keys, values, key_result.slot, key_saved, value_saved)
        }
    produces
        pure result
    end
}

fn sorted_add_node_entry(
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)],
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    index: int64
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    case index < node.key_count of {
        true -> {
            entry: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)], inserted: int64, replaced: int64 } <-
                sorted_insert_entry(keys, values, nth_int64(node.keys, index), nth_int64(node.values, index));
            { keys: entry.keys, values: entry.values }
        };
        false -> { keys: keys, values: values }
    }
}

fn sorted_add_node_entries(
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)],
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        e0: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- sorted_add_node_entry(keys, values, node, 0);
        e1: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- sorted_add_node_entry(e0.keys, e0.values, node, 1);
        e2: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- sorted_add_node_entry(e1.keys, e1.values, node, 2);
        e3: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- sorted_add_node_entry(e2.keys, e2.values, node, 3);
        e4: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- sorted_add_node_entry(e3.keys, e3.values, node, 4);
        e5: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- sorted_add_node_entry(e4.keys, e4.values, node, 5);
        e6: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- sorted_add_node_entry(e5.keys, e5.values, node, 6)
    produces
        pure e6
    end
}

fn sorted_entries_from_nodes(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    keys: List[int64, mem(normal)],
    values: List[int64, mem(normal)]
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    case nodes of {
        []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { keys: keys, values: values };
        [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] -> {
            current: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- sorted_add_node_entries(keys, values, head);
            sorted_entries_from_nodes(tail, current.keys, current.values)
        };
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { keys: keys, values: values }
    }
}

fn sorted_entries_from_tree(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        keys: List[int64, mem(normal)] <- empty_int64_list();
        values: List[int64, mem(normal)] <- empty_int64_list();
        entries: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- case tree.root_id of {
            -1 -> { keys: keys, values: values };
            _: int64 -> sorted_entries_from_nodes(tree.nodes, keys, values)
        }
    produces
        pure entries
    end
}

fn entries_from_leaf_node(
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    sequence
        entries: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- {
            keys: node.keys,
            values: node.values
        }
    produces
        pure entries
    end
}

fn entries_from_split_root(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        left_id: int64 <- nth_int64(root.children, 0);
        right_id: int64 <- nth_int64(root.children, 1);
        left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- find_node(all_nodes, left_id);
        right_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- find_node(all_nodes, right_id);
        separator_key: int64 <- nth_int64(root.keys, 0);
        separator_value: int64 <- nth_int64(root.values, 0);
        separator_right_keys: List[int64, mem(normal)] <- prepend_int64(separator_key, right_node.keys);
        separator_right_values: List[int64, mem(normal)] <- prepend_int64(separator_value, right_node.values);
        keys: List[int64, mem(normal)] <- append_int64(left_node.keys, separator_right_keys);
        values: List[int64, mem(normal)] <- append_int64(left_node.values, separator_right_values);
        entries: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- { keys: keys, values: values }
    produces
        pure entries
    end
}

fn entries_from_split_positions(
    left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    right_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        separator_key: int64 <- nth_int64(root_node.keys, 0);
        separator_value: int64 <- nth_int64(root_node.values, 0);
        separator_right_keys: List[int64, mem(normal)] <- prepend_int64(separator_key, right_node.keys);
        separator_right_values: List[int64, mem(normal)] <- prepend_int64(separator_value, right_node.values);
        keys: List[int64, mem(normal)] <- append_int64(left_node.keys, separator_right_keys);
        values: List[int64, mem(normal)] <- append_int64(left_node.values, separator_right_values);
        entries: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- { keys: keys, values: values }
    produces
        pure entries
    end
}

fn entries_from_split_position_tail(
    left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    rest: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        empty_keys: List[int64, mem(normal)] <- empty_int64_list();
        empty_values: List[int64, mem(normal)] <- empty_int64_list();
        entries: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- case rest of {
            [root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
                case tail of {
                    [right_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
                        entries_from_split_positions(left_node, root_node, right_node);
                    _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { keys: empty_keys, values: empty_values }
                };
            _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { keys: empty_keys, values: empty_values }
        }
    produces
        pure entries
    end
}

fn entries_from_split_position_nodes(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        empty_keys: List[int64, mem(normal)] <- empty_int64_list();
        empty_values: List[int64, mem(normal)] <- empty_int64_list();
        entries: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- case nodes of {
            [left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, rest: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
                entries_from_split_position_tail(left_node, rest);
            _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> { keys: empty_keys, values: empty_values }
        }
    produces
        pure entries
    end
}

fn entries_from_generated_tree(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        keys: List[int64, mem(normal)] <- empty_int64_list();
        values: List[int64, mem(normal)] <- empty_int64_list();
        root_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- find_node(tree.nodes, tree.root_id);
        entries: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- case tree.root_id of {
            -1 -> { keys: keys, values: values };
            _: int64 -> case tree.node_count of {
                1 -> entries_from_leaf_node(root_node);
                3 -> entries_from_split_position_nodes(tree.nodes);
                _: int64 -> sorted_entries_from_nodes(tree.nodes, keys, values)
            }
        }
    produces
        pure entries
    end
}

fn empty[int64, int64, mem(normal)]() -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence proc[mem(normal)]
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: -1,
            node_count: 0,
            order: order(),
            nodes: nodes
        }
    produces
        pure tree
    end
}

fn empty(map_functions: { compare_key: fn(int64, int64) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater }) -> {
    compare_key: fn(int64, int64) -> :less | :equal | :greater,
    compare_value: fn(int64, int64) -> :less | :equal | :greater,
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence proc[mem(normal)]
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        tree: {
            compare_key: fn(int64, int64) -> :less | :equal | :greater,
            compare_value: fn(int64, int64) -> :less | :equal | :greater,
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            compare_key: map_functions.compare_key,
            compare_value: map_functions.compare_value,
            root_id: -1,
            node_count: 0,
            order: order(),
            nodes: nodes
        }
    produces
        pure tree
    end
}

fn contains_key(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> int64 {
    contains[int64, int64, mem(normal)](tree, key)
}

fn split_child_found(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    parent: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    child: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    child_index: int64
) -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        parent_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- parent;
        child_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- child;
        child_index_saved: int64 <- child_index;
        tree_root_id_saved: int64 <- tree_saved.root_id;
        tree_node_count_saved: int64 <- tree_saved.node_count;
        tree_order_saved: int64 <- tree_saved.order;
        tree_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tree_saved.nodes;
        parent_id_saved: int64 <- parent_saved.id;
        parent_key_count_saved: int64 <- parent_saved.key_count;
        parent_keys_saved: List[int64, mem(normal)] <- parent_saved.keys;
        parent_values_saved: List[int64, mem(normal)] <- parent_saved.values;
        parent_children_saved: List[int64, mem(normal)] <- parent_saved.children;
        child_id_saved: int64 <- child_saved.id;
        child_is_leaf_saved: int64 <- child_saved.is_leaf;
        child_keys_saved: List[int64, mem(normal)] <- child_saved.keys;
        child_values_saved: List[int64, mem(normal)] <- child_saved.values;
        child_children_saved: List[int64, mem(normal)] <- child_saved.children;
        promoted_key: int64 <- nth_int64(child_keys_saved, 3);
        promoted_value: int64 <- nth_int64(child_values_saved, 3);
        left_keys: List[int64, mem(normal)] <- take_int64(child_keys_saved, 3);
        left_values: List[int64, mem(normal)] <- take_int64(child_values_saved, 3);
        right_keys: List[int64, mem(normal)] <- drop_int64(child_keys_saved, 4);
        right_values: List[int64, mem(normal)] <- drop_int64(child_values_saved, 4);
        empty_children: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        left_children_candidate: List[int64, mem(normal)] <- take_int64(child_children_saved, 4);
        right_children_candidate: List[int64, mem(normal)] <- drop_int64(child_children_saved, 4);
        left_children: List[int64, mem(normal)] <- case child_is_leaf_saved of {
            1 -> empty_children;
            _: int64 -> left_children_candidate
        };
        right_children: List[int64, mem(normal)] <- case child_is_leaf_saved of {
            1 -> empty_children;
            _: int64 -> right_children_candidate
        };
        left_key_count: int64 <- list_int64_length(left_keys);
        right_key_count: int64 <- list_int64_length(right_keys);
        left_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: child_id_saved,
            key_count: left_key_count,
            is_leaf: child_is_leaf_saved,
            keys: left_keys,
            values: left_values,
            children: left_children
        };
        right_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: tree_node_count_saved,
            key_count: right_key_count,
            is_leaf: child_is_leaf_saved,
            keys: right_keys,
            values: right_values,
            children: right_children
        };
        parent_keys: List[int64, mem(normal)] <- insert_int64_at(parent_keys_saved, child_index_saved, promoted_key);
        parent_values: List[int64, mem(normal)] <- insert_int64_at(parent_values_saved, child_index_saved, promoted_value);
        parent_children: List[int64, mem(normal)] <- insert_int64_at(parent_children_saved, child_index_saved + 1, tree_node_count_saved);
        parent_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: parent_id_saved,
            key_count: parent_key_count_saved + 1,
            is_leaf: 0,
            keys: parent_keys,
            values: parent_values,
            children: parent_children
        };
        nodes_with_left: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            replace_node(tree_nodes_saved, child_id_saved, left_node);
        nodes_with_parent: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            replace_node(nodes_with_left, parent_id_saved, parent_node);
        nodes_final: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend_node(right_node, nodes_with_parent);
        result: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: tree_root_id_saved,
            node_count: tree_node_count_saved + 1,
            order: tree_order_saved,
            nodes: nodes_final
        }
    produces
        pure result
    end
}

fn split_child(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    parent_id: int64,
    child_index: int64
) -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        parent_id_saved: int64 <- parent_id;
        child_index_saved: int64 <- child_index;
        tree_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tree_saved.nodes;
        parent_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_nodes_saved, parent_id_saved);
        parent_found: int64 <- node_exists(tree_nodes_saved, parent_id_saved);
        child_id: int64 <- nth_int64(parent_result.children, child_index_saved);
        child_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_nodes_saved, child_id);
        child_found: int64 <- node_exists(tree_nodes_saved, child_id);
        result: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- case parent_found of {
            0 -> tree_saved;
            _: int64 -> case child_found of {
                0 -> tree_saved;
                _: int64 -> split_child_found(tree_saved, parent_result, child_result, child_index_saved)
            }
        }
    produces
        pure result
    end
}

fn wrap_tree_inserted(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    new_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence
        new_tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: tree.root_id,
            node_count: tree.node_count,
            order: tree.order,
            nodes: new_nodes
        };
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- { tree: new_tree, inserted: 1, replaced: 0 }
    produces
        pure result
    end
}

