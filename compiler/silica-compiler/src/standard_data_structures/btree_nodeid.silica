fn search_key_list(values: List[int64, mem(normal)], key: int64) -> { found: int64, slot: int64 } {
    sequence
        found: int64 <- search_key_list_found_at(values, key, 0);
        slot: int64 <- search_key_list_slot_at(values, key, 0);
        result: { found: int64, slot: int64 } <- {
            found: found,
            slot: slot
        }
    produces
        pure result
    end
}

