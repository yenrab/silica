    end
}

fn validate_error(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    case tree.order == order() of {
        false -> 8;
        true -> case tree.node_count of {
            0 -> validate_empty(tree);
            _: int64 -> validate_nonempty(tree)
        }
    }
}

fn validate[int64, int64, mem(normal)](
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> { ok: int64, error_code: int64 } {
    sequence proc[]
        err: int64 <- validate_error(tree);
        ok_value: int64 <- case err of {
            0 -> 1;
            _: int64 -> 0
        };
        result: { ok: int64, error_code: int64 } <- {
            ok: ok_value,
            error_code: err
        }
    produces
        pure result
    end
}
