            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        node_id_saved: int64 <- node_id;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        node_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_saved.nodes, node_id_saved);
        node_found: int64 <- node_exists(tree_saved.nodes, node_id_saved);
        key_found: int64 <- search_key_list_found_at(node_result.keys, key_saved, 0);
        key_slot: int64 <- search_key_list_slot_at(node_result.keys, key_saved, 0);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case node_found of {
            0 -> { tree: tree_saved, inserted: 0, replaced: 0 };
            _: int64 -> case node_result.is_leaf of {
                1 -> insert_in_leaf(tree_saved, node_result, key_saved, value_saved);
                _: int64 -> case key_found of {
                    1 -> replace_value_in_internal(tree_saved, node_result, value_saved, key_slot);
                    _: int64 -> insert_nonfull_child(tree_saved, node_result, key_saved, value_saved, key_slot)
                }
            }
        }
    produces
        pure result
    end
}

fn insert_into_nonempty(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        root_saved: int64 <- tree.root_id;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        root_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_saved.nodes, root_saved);
        root_key_count: int64 <- root_result.key_count;
        max_k: int64 <- max_keys();
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case root_key_count == max_k of {
            true -> insert_split_root(tree_saved, key_saved, value_saved);
            false -> insert_nonfull(tree_saved, root_saved, key_saved, value_saved)
        }
    produces
        pure result
    end
}

fn insert_split_root(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        tree_node_count_saved: int64 <- tree_saved.node_count;
        tree_root_id_saved: int64 <- tree_saved.root_id;
        tree_order_saved: int64 <- tree_saved.order;
        tree_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tree_saved.nodes;
        new_root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            make_internal_root(tree_node_count_saved, tree_root_id_saved);
        new_root_id_saved: int64 <- new_root.id;
        nodes_with_new_root: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend_node(new_root, tree_nodes_saved);
        tree_with_new_root: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: new_root_id_saved,
            node_count: tree_node_count_saved + 1,
            order: tree_order_saved,
            nodes: nodes_with_new_root
        };
        split_tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- split_child(tree_with_new_root, new_root_id_saved, 0);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- insert_nonfull(split_tree, new_root_id_saved, key_saved, value_saved)
    produces
        pure result
    end
}

fn insert_root_leaf(
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        root: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            make_leaf_map_node(0, key, value);
        empty_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)](root, empty_nodes);
        tree: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- {
            root_id: 0,
            node_count: 1,
            order: order(),
            nodes: nodes
        };
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- { tree: tree, inserted: 1, replaced: 0 }
    produces
        pure result
    end
}

fn insert[int64, int64, mem(normal)](
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64,
    value: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case tree_saved.root_id of {
            -1 -> insert_root_leaf(key_saved, value_saved);
            _: int64 -> insert_into_nonempty(tree_saved, key_saved, value_saved)
        }
    produces
        pure result
    end
}

fn node_id_in_range(node_id: int64, node_count: int64) -> int64 {
    case node_id >= 0 of {
        false -> 0;
        true -> case node_id < node_count of {
            true -> 1;
            false -> 0
        }
    }
}

fn child_ids_valid(children: List[int64, mem(normal)], node_count: int64) -> int64 {
    case children of {
        []: List[int64, mem(normal)] -> 1;
        [head: int64, tail: List[int64, mem(normal)]] -> case node_id_in_range(head, node_count) == 1 of {
            true -> child_ids_valid(tail, node_count);
            false -> 0
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn non_root_occupancy_ok(node_id: int64, root_id: int64, key_count: int64) -> int64 {
    case node_id == root_id of {
        true -> 1;
        false -> case key_count >= min_keys_non_root() of {
            true -> 1;
            false -> 0
        }
    }
}

fn child_shape_error(
    is_leaf: int64,
    key_count: int64,
    children: List[int64, mem(normal)],
    child_len: int64,
    node_count: int64
) -> int64 {
    case is_leaf of {
        1 -> case child_len == 0 of {
            true -> 0;
            false -> 7
        };
        _: int64 -> case child_len == key_count + 1 of {
            false -> 7;
            true -> case child_ids_valid(children, node_count) == 1 of {
                true -> 0;
                false -> 3
            }
        }
    }
}

fn node_basic_error(
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64,
    node_count: int64
) -> int64 {
    sequence proc[]
        node_id_saved: int64 <- node.id;
        key_count_saved: int64 <- node.key_count;
        is_leaf_saved: int64 <- node.is_leaf;
        keys_saved: List[int64, mem(normal)] <- node.keys;
        children_saved: List[int64, mem(normal)] <- node.children;
        root_saved: int64 <- root_id;
        node_count_saved: int64 <- node_count;
        key_len: int64 <- list_int64_length(keys_saved);
        id_count: int64 <- node_id_count(all_nodes, node_id_saved);
        result: int64 <- case node_id_in_range(node_id_saved, node_count_saved) == 1 of {
            false -> 3;
            true -> case id_count == 1 of {
                false -> 2;
                true -> case key_len == key_count_saved of {
                    false -> 4;
                    true -> case key_count_saved <= max_keys() of {
                        false -> 8;
                        true -> case non_root_occupancy_ok(node_id_saved, root_saved, key_count_saved) == 1 of {
                            false -> 8;
                            true -> case keys_sorted_unique(keys_saved) == 1 of {
                                false -> 5;
                                true -> case list_int64_length(node.values) == key_count_saved of {
                                    false -> 11;
                                    true -> child_shape_error_auto(is_leaf_saved, key_count_saved, children_saved, node_count_saved)
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}

fn child_shape_error_auto(
    is_leaf: int64,
    key_count: int64,
    children: List[int64, mem(normal)],
    node_count: int64
) -> int64 {
    sequence proc[]
        child_len: int64 <- list_int64_length(children);
        result: int64 <- child_shape_error(is_leaf, key_count, children, child_len, node_count)
    produces
        pure result
    end
}

fn nodes_basic_error(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64,
    node_count: int64
) -> int64 {
    sequence proc[mem(normal)]
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        node_count_saved: int64 <- node_count;
        result: int64 <- case nodes of {
            []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0;
            [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
                nodes_basic_error_cons(head, tail, all_nodes_saved, root_saved, node_count_saved);
            _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 4
        }
    produces
        pure result
    end
}

fn nodes_basic_error_cons(
    head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64,
    node_count: int64
) -> int64 {
    sequence proc[]
        tail_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tail;
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        node_count_saved: int64 <- node_count;
        head_err: int64 <- node_basic_error(head, all_nodes_saved, root_saved, node_count_saved);
        tail_err: int64 <- nodes_basic_error(tail_saved, all_nodes_saved, root_saved, node_count_saved);
        result: int64 <- first_error(head_err, tail_err)
    produces
        pure result
    end
}

fn key_count_in_nodes(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    key: int64
) -> int64 {
    case nodes of {
        []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0;
        [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            key_count_in_list(head.keys, key) + key_count_in_nodes(tail, key);
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0
    }
}

fn node_keys_unique_global(
    keys: List[int64, mem(normal)],
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
) -> int64 {
    case keys of {
        []: List[int64, mem(normal)] -> 1;
        [head: int64, tail: List[int64, mem(normal)]] -> case key_count_in_nodes(all_nodes, head) == 1 of {
            true -> node_keys_unique_global(tail, all_nodes);
            false -> 0
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn all_keys_unique_global(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 1;
        [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            case node_keys_unique_global(head.keys, all_nodes) == 1 of {
                true -> all_keys_unique_global(tail, all_nodes);
                false -> 0
            };
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0
    }
}

fn child_id_count_in_list(children: List[int64, mem(normal)], target_id: int64) -> int64 {
    case children of {
        []: List[int64, mem(normal)] -> 0;
        [head: int64, tail: List[int64, mem(normal)]] -> case head == target_id of {
            true -> 1 + child_id_count_in_list(tail, target_id);
            false -> child_id_count_in_list(tail, target_id)
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn child_id_count_in_nodes(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    target_id: int64
) -> int64 {
    case nodes of {
        []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0;
        [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            child_id_count_in_list(head.children, target_id) + child_id_count_in_nodes(tail, target_id);
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0
    }
}

fn parent_count_error_for_node(
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64
) -> int64 {
    sequence proc[]
        parent_count: int64 <- child_id_count_in_nodes(all_nodes, node.id);
        result: int64 <- case node.id == root_id of {
            true -> case parent_count == 0 of {
                true -> 0;
                false -> 3
            };
            false -> case parent_count == 1 of {
                true -> 0;
                false -> 3
            }
        }
    produces
        pure result
    end
}

fn parent_count_error(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64
) -> int64 {
    case nodes of {
        []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0;
        [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            parent_count_error_cons(head, tail, all_nodes, root_id);
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 3
    }
}

fn parent_count_error_cons(
    head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64
) -> int64 {
    sequence proc[]
        tail_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tail;
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        head_err: int64 <- parent_count_error_for_node(head, all_nodes_saved, root_saved);
        tail_err: int64 <- parent_count_error(tail_saved, all_nodes_saved, root_saved);
        result: int64 <- first_error(head_err, tail_err)
    produces
        pure result
    end
}

fn first_leaf_depth(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    depth: int64
) -> int64 {
    sequence proc[mem(normal)]
        depth_saved: int64 <- depth;
        node_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(all_nodes, node_id);
        result: int64 <- case node_result.is_leaf of {
            1 -> depth_saved;
            _: int64 -> first_leaf_depth(all_nodes, nth_int64(node_result.children, 0), depth_saved + 1)
        }
    produces
        pure result
    end
}

fn leaf_depths_ok_children(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    children: List[int64, mem(normal)],
    depth: int64,
    expected: int64
) -> int64 {
    case children of {
        []: List[int64, mem(normal)] -> 1;
        [head: int64, tail: List[int64, mem(normal)]] -> leaf_depths_ok_children_cons(all_nodes, head, tail, depth, expected);
        _: List[int64, mem(normal)] -> 0
    }
}

fn leaf_depths_ok_children_cons(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    head: int64,
    tail: List[int64, mem(normal)],
    depth: int64,
    expected: int64
) -> int64 {
    sequence proc[]
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        tail_saved: List[int64, mem(normal)] <- tail;
        depth_saved: int64 <- depth;
        expected_saved: int64 <- expected;
        current_ok: int64 <- leaf_depths_ok(all_nodes_saved, head, depth_saved, expected_saved);
        result: int64 <- case current_ok == 1 of {
            true -> leaf_depths_ok_children(all_nodes_saved, tail_saved, depth_saved, expected_saved);
            false -> 0
        }
    produces
        pure result
    end
}

fn leaf_depths_ok(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    depth: int64,
    expected: int64
) -> int64 {
    sequence proc[mem(normal)]
        depth_saved: int64 <- depth;
        expected_saved: int64 <- expected;
        node_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(all_nodes, node_id);
        result: int64 <- case node_result.is_leaf of {
            1 -> case depth_saved == expected_saved of {
                true -> 1;
                false -> 0
            };
            _: int64 -> leaf_depths_ok_children(all_nodes, node_result.children, depth_saved + 1, expected_saved)
        }
    produces
        pure result
    end
}

fn key_in_bounds(key: int64, has_lower: int64, lower: int64, has_upper: int64, upper: int64) -> int64 {
    sequence proc[]
        lower_ok: int64 <- case has_lower of {
            0 -> 1;
            _: int64 -> case key > lower of {
                true -> 1;
                false -> 0
            }
        };
        upper_ok: int64 <- case has_upper of {
            0 -> 1;
            _: int64 -> case key < upper of {
                true -> 1;
                false -> 0
            }
        };
        result: int64 <- case lower_ok of {
            0 -> 0;
            _: int64 -> upper_ok
        }
    produces
        pure result
    end
}

fn keys_in_bounds(values: List[int64, mem(normal)], has_lower: int64, lower: int64, has_upper: int64, upper: int64) -> int64 {
    case values of {
        []: List[int64, mem(normal)] -> 1;
        [head: int64, tail: List[int64, mem(normal)]] -> keys_in_bounds_cons(head, tail, has_lower, lower, has_upper, upper);
        _: List[int64, mem(normal)] -> 0
    }
}

fn keys_in_bounds_cons(
    head: int64,
    tail: List[int64, mem(normal)],
    has_lower: int64,
    lower: int64,
    has_upper: int64,
    upper: int64
) -> int64 {
    sequence proc[]
        tail_saved: List[int64, mem(normal)] <- tail;
        has_lower_saved: int64 <- has_lower;
        lower_saved: int64 <- lower;
        has_upper_saved: int64 <- has_upper;
        upper_saved: int64 <- upper;
        key_ok: int64 <- key_in_bounds(head, has_lower_saved, lower_saved, has_upper_saved, upper_saved);
        result: int64 <- case key_ok == 1 of {
            true -> keys_in_bounds(tail_saved, has_lower_saved, lower_saved, has_upper_saved, upper_saved);
            false -> 0
        }
    produces
        pure result
    end
}

fn child_lower_has(node_index: int64, inherited_has_lower: int64) -> int64 {
    case node_index of {
        0 -> inherited_has_lower;
        _: int64 -> 1
    }
}

fn child_upper_has(node_index: int64, key_count: int64, inherited_has_upper: int64) -> int64 {
    case node_index == key_count of {
        true -> inherited_has_upper;
        false -> 1
    }
}

fn child_lower_value(keys: List[int64, mem(normal)], node_index: int64, inherited_lower: int64) -> int64 {
    case node_index of {
        0 -> inherited_lower;
        _: int64 -> nth_int64(keys, node_index - 1)
    }
}

fn child_upper_value(keys: List[int64, mem(normal)], node_index: int64, key_count: int64, inherited_upper: int64) -> int64 {
    case node_index == key_count of {
        true -> inherited_upper;
        false -> nth_int64(keys, node_index)
    }
}

fn range_ok_children(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    parent: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    child_index: int64,
    has_lower: int64,
    lower: int64,
    has_upper: int64,
    upper: int64
) -> int64 {
    case child_index > parent.key_count of {
        true -> 1;
        false -> case range_ok(
            all_nodes,
            nth_int64(parent.children, child_index),
            child_lower_has(child_index, has_lower),
            child_lower_value(parent.keys, child_index, lower),
            child_upper_has(child_index, parent.key_count, has_upper),
            child_upper_value(parent.keys, child_index, parent.key_count, upper)
        ) == 1 of {
            true -> range_ok_children(all_nodes, parent, child_index + 1, has_lower, lower, has_upper, upper);
            false -> 0
        }
    }
}

fn range_ok(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    has_lower: int64,
    lower: int64,
    has_upper: int64,
    upper: int64
) -> int64 {
    sequence proc[mem(normal)]
        has_lower_saved: int64 <- has_lower;
        lower_saved: int64 <- lower;
        has_upper_saved: int64 <- has_upper;
        upper_saved: int64 <- upper;
        node_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(all_nodes, node_id);
        node_found: int64 <- node_exists(all_nodes, node_id);
        result: int64 <- case node_found == 1 of {
            false -> 0;
            true -> case keys_in_bounds(node_result.keys, has_lower_saved, lower_saved, has_upper_saved, upper_saved) == 1 of {
                false -> 0;
                true -> case node_result.is_leaf of {
                    1 -> 1;
                    _: int64 -> range_ok_children(all_nodes, node_result, 0, has_lower_saved, lower_saved, has_upper_saved, upper_saved)
                }
            }
        }
    produces
        pure result
    end
}

fn validate_empty(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    case tree.root_id == -1 of {
        false -> 1;
        true -> case node_list_length(tree.nodes) == 0 of {
            true -> 0;
            false -> 4
        }
    }
}

fn validate_nonempty(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    sequence proc[]
        record_count: int64 <- node_list_length(tree.nodes);
        root_found: int64 <- node_exists(tree.nodes, tree.root_id);
        result: int64 <- case record_count == tree.node_count of {
            false -> 4;
            true -> case node_id_in_range(tree.root_id, tree.node_count) == 1 of {
                false -> 1;
                true -> case root_found == 1 of {
                    false -> 1;
                    true -> validate_nonempty_deep(tree.nodes, tree.root_id, tree.node_count)
                }
            }
        }
    produces
        pure result
    end
}

fn validate_nonempty_deep(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
