            replaced: int64
        } <- case key_result.found of {
            1 -> insert_in_leaf_found(tree_saved, node_saved, value_saved, key_result.slot);
            _: int64 -> insert_in_leaf_not_found(tree_saved, node_saved, key_saved, value_saved, key_result.slot)
