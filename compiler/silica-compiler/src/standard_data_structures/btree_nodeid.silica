fn insert_nonfull_after_split(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    parent_id: int64,
    key: int64,
    value: int64,
    original_index: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        parent_id_saved: int64 <- parent_id;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        original_index_saved: int64 <- original_index;
        parent_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_saved.nodes, parent_id_saved);
        parent_keys_saved: List[int64, mem(normal)] <- parent_result.keys;
        parent_children_saved: List[int64, mem(normal)] <- parent_result.children;
        pivot: int64 <- nth_int64(parent_keys_saved, original_index_saved);
        next_index: int64 <- case key_saved > pivot of {
            true -> original_index_saved + 1;
            false -> original_index_saved
        };
        child_id: int64 <- nth_int64(parent_children_saved, next_index);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- insert_nonfull(tree_saved, child_id, key_saved, value_saved)
    produces
        pure result
    end
}

fn insert_nonfull_child(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    key: int64,
    value: int64,
    search_index: int64
) -> {
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    inserted: int64,
    replaced: int64
} {
    sequence proc[mem(normal)]
        tree_saved: {
            root_id: int64,
            node_count: int64,
            order: int64,
            nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
        } <- tree;
        node_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- node;
        key_saved: int64 <- key;
        value_saved: int64 <- value;
        search_index_saved: int64 <- search_index;
        node_id_saved: int64 <- node_saved.id;
        node_children_saved: List[int64, mem(normal)] <- node_saved.children;
        child_id: int64 <- nth_int64(node_children_saved, search_index_saved);
        child_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(tree_saved.nodes, child_id);
        child_key_count_saved: int64 <- child_result.key_count;
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
            inserted: int64,
            replaced: int64
        } <- case child_key_count_saved == max_keys() of {
            true -> insert_nonfull_after_split(
                split_child(tree_saved, node_id_saved, search_index_saved),
                node_id_saved,
                key_saved,
                value_saved,
                search_index_saved
            );
            false -> insert_nonfull(tree_saved, child_id, key_saved, value_saved)
        }
    produces
        pure result
    end
}

