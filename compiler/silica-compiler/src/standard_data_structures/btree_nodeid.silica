        root_saved: int64 <- root_id;
        node_count_saved: int64 <- node_count;
        basic_err: int64 <- nodes_basic_error(all_nodes_saved, all_nodes_saved, root_saved, node_count_saved);
        result: int64 <- case basic_err of {
            0 -> validate_after_basic(all_nodes_saved, root_saved);
            _: int64 -> basic_err
        }
    produces
        pure result
    end
}

fn validate_after_basic(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
