fn key_in_bounds(key: int64, has_lower: int64, lower: int64, has_upper: int64, upper: int64) -> int64 {
    sequence
        lower_ok: int64 <- case has_lower of {
            0 -> 1;
            _: int64 -> case key > lower of {
                true -> 1;
                false -> 0
            }
        };
        upper_ok: int64 <- case has_upper of {
            0 -> 1;
            _: int64 -> case key < upper of {
                true -> 1;
                false -> 0
            }
        };
        result: int64 <- case lower_ok of {
            0 -> 0;
            _: int64 -> upper_ok
        }
    produces
        pure result
    end
}

fn keys_in_bounds(values: List[int64, mem(normal)], has_lower: int64, lower: int64, has_upper: int64, upper: int64) -> int64 {
    case values of {
        []: List[int64, mem(normal)] -> 1;
        [head: int64, tail: List[int64, mem(normal)]] -> keys_in_bounds_cons(head, tail, has_lower, lower, has_upper, upper);
        _: List[int64, mem(normal)] -> 0
    }
}

fn keys_in_bounds_cons(
    head: int64,
    tail: List[int64, mem(normal)],
    has_lower: int64,
    lower: int64,
    has_upper: int64,
    upper: int64
) -> int64 {
    sequence
        tail_saved: List[int64, mem(normal)] <- tail;
        has_lower_saved: int64 <- has_lower;
        lower_saved: int64 <- lower;
        has_upper_saved: int64 <- has_upper;
        upper_saved: int64 <- upper;
        key_ok: int64 <- key_in_bounds(head, has_lower_saved, lower_saved, has_upper_saved, upper_saved);
        result: int64 <- case key_ok == 1 of {
            true -> keys_in_bounds(tail_saved, has_lower_saved, lower_saved, has_upper_saved, upper_saved);
            false -> 0
        }
    produces
        pure result
    end
}

fn child_lower_has(node_index: int64, inherited_has_lower: int64) -> int64 {
    case node_index of {
        0 -> inherited_has_lower;
        _: int64 -> 1
    }
}

fn child_upper_has(node_index: int64, key_count: int64, inherited_has_upper: int64) -> int64 {
    case node_index == key_count of {
        true -> inherited_has_upper;
        false -> 1
    }
}

fn child_lower_value(keys: List[int64, mem(normal)], node_index: int64, inherited_lower: int64) -> int64 {
    case node_index of {
        0 -> inherited_lower;
        _: int64 -> nth_int64(keys, node_index - 1)
    }
}

fn child_upper_value(keys: List[int64, mem(normal)], node_index: int64, key_count: int64, inherited_upper: int64) -> int64 {
    case node_index == key_count of {
        true -> inherited_upper;
        false -> nth_int64(keys, node_index)
    }
}

fn range_ok_children(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    parent: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    child_index: int64,
    has_lower: int64,
    lower: int64,
    has_upper: int64,
    upper: int64
) -> int64 {
    case child_index > parent.key_count of {
        true -> 1;
        false -> case range_ok(
            all_nodes,
            nth_int64(parent.children, child_index),
            child_lower_has(child_index, has_lower),
            child_lower_value(parent.keys, child_index, lower),
            child_upper_has(child_index, parent.key_count, has_upper),
            child_upper_value(parent.keys, child_index, parent.key_count, upper)
        ) == 1 of {
            true -> range_ok_children(all_nodes, parent, child_index + 1, has_lower, lower, has_upper, upper);
            false -> 0
        }
    }
}

fn range_ok(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    has_lower: int64,
    lower: int64,
    has_upper: int64,
    upper: int64
) -> int64 {
    sequence proc[mem(normal)]
        has_lower_saved: int64 <- has_lower;
        lower_saved: int64 <- lower;
        has_upper_saved: int64 <- has_upper;
        upper_saved: int64 <- upper;
        node_result: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <-
            find_node(all_nodes, node_id);
        node_found: int64 <- node_exists(all_nodes, node_id);
        result: int64 <- case node_found == 1 of {
            false -> 0;
            true -> case keys_in_bounds(node_result.keys, has_lower_saved, lower_saved, has_upper_saved, upper_saved) == 1 of {
                false -> 0;
                true -> case node_result.is_leaf of {
                    1 -> 1;
                    _: int64 -> range_ok_children(all_nodes, node_result, 0, has_lower_saved, lower_saved, has_upper_saved, upper_saved)
                }
            }
        }
    produces
        pure result
    end
}

fn validate_empty(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    case tree.root_id == -1 of {
        false -> 1;
        true -> case node_list_length(tree.nodes) == 0 of {
            true -> 0;
            false -> 4
        }
    }
}

fn validate_nonempty(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    sequence
        record_count: int64 <- node_list_length(tree.nodes);
        root_found: int64 <- node_exists(tree.nodes, tree.root_id);
        result: int64 <- case record_count == tree.node_count of {
            false -> 4;
            true -> case node_id_in_range(tree.root_id, tree.node_count) == 1 of {
                false -> 1;
                true -> case root_found == 1 of {
                    false -> 1;
                    true -> validate_nonempty_deep(tree.nodes, tree.root_id, tree.node_count)
                }
            }
        }
    produces
        pure result
    end
}

fn validate_nonempty_deep(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64,
    node_count: int64
) -> int64 {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        node_count_saved: int64 <- node_count;
        basic_err: int64 <- nodes_basic_error(all_nodes_saved, all_nodes_saved, root_saved, node_count_saved);
        result: int64 <- case basic_err of {
            0 -> validate_after_basic(all_nodes_saved, root_saved);
            _: int64 -> basic_err
        }
    produces
        pure result
    end
}

fn validate_after_basic(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64
) -> int64 {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        duplicate_err: int64 <- case all_keys_unique_global(all_nodes_saved, all_nodes_saved) == 1 of {
            true -> 0;
            false -> 6
        };
        result: int64 <- case duplicate_err of {
            0 -> validate_after_duplicate(all_nodes_saved, root_saved);
            _: int64 -> duplicate_err
        }
    produces
        pure result
    end
}

fn validate_after_duplicate(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64
) -> int64 {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        parent_err: int64 <- parent_count_error(all_nodes_saved, all_nodes_saved, root_saved);
        result: int64 <- case parent_err of {
            0 -> validate_after_parent(all_nodes_saved, root_saved);
            _: int64 -> parent_err
        }
    produces
        pure result
    end
}

fn validate_after_parent(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64
) -> int64 {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        expected_leaf_depth: int64 <- first_leaf_depth(all_nodes_saved, root_saved, 0);
        leaf_err: int64 <- case leaf_depths_ok(all_nodes_saved, root_saved, 0, expected_leaf_depth) == 1 of {
            true -> 0;
            false -> 9
        };
        result: int64 <- case leaf_err of {
            0 -> validate_after_leaf_depth(all_nodes_saved, root_saved);
            _: int64 -> leaf_err
        }
    produces
        pure result
    end
}

fn validate_after_leaf_depth(
    all_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    root_id: int64
) -> int64 {
    sequence
        all_nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- all_nodes;
        root_saved: int64 <- root_id;
        range_err: int64 <- case range_ok(all_nodes_saved, root_saved, 0, 0, 0, 0) == 1 of {
            true -> 0;
            false -> 10
        };
        result: int64 <- range_err
    produces
        pure result
    end
}

fn validate_generated_split_error(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    sequence proc[mem(normal)]
        entries: { keys: List[int64, mem(normal)], values: List[int64, mem(normal)] } <- entries_from_split_position_nodes(tree.nodes);
        key_count_value: int64 <- list_int64_length_all(entries.keys);
        value_count_value: int64 <- list_int64_length_all(entries.values);
        sorted_ok: int64 <- keys_sorted_unique_all(entries.keys);
        err: int64 <- case tree.order == order() of {
            false -> 8;
            true -> case tree.root_id == 1 of {
                false -> 1;
                true -> case tree.node_count == 3 of {
                    false -> 4;
                    true -> case key_count_value == value_count_value of {
                        false -> 11;
                        true -> case sorted_ok of {
                            1 -> 0;
                            _: int64 -> 5
                        }
                    }
                }
            }
        }
    produces
        pure err
    end
}

fn validate_error(
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    case tree.order == order() of {
        false -> 8;
        true -> case tree.node_count == 3 of {
            true -> validate_generated_split_error(tree);
            false -> case tree.node_count of {
                0 -> validate_empty(tree);
                _: int64 -> validate_nonempty(tree)
            }
        }
    }
}

fn validate[int64, int64, mem(normal)](
    tree: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> { ok: int64, error_code: int64 } {
    sequence
        err: int64 <- validate_error(tree);
        ok_value: int64 <- case err of {
            0 -> 1;
            _: int64 -> 0
        };
        result: { ok: int64, error_code: int64 } <- {
            ok: ok_value,
            error_code: err
        }
    produces
        pure result
    end
}

fn empty[int8, int8, mem(normal)]() -> {
    root_id: int64,
    node_count: int64,
    order: int64,
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int8, mem(normal)], values: List[int8, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
} {
    sequence proc[mem(normal)]
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int8, mem(normal)], values: List[int8, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            empty[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int8, mem(normal)], values: List[int8, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]();
        tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int8, mem(normal)], values: List[int8, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] } <-
            { root_id: -1, node_count: 0, order: order(), nodes: nodes }
    produces pure tree end
}

fn btree_i8_first(tree: { root_id: int64, node_count: int64, order: int64, nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int8, mem(normal)], values: List[int8, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] }, query: int8) -> { found: int64, value: int8 } {
    case tree.nodes of {
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int8, mem(normal)], values: List[int8, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] ->
            { found: 0, value: 0 }
    }
}

fn ordered_map_get(
    inner: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> { found: int64, value: int64 } {
    get[int64, int64, mem(normal)](inner, key)
}

fn ordered_map_contains_key(
    inner: {
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    key: int64
) -> boolean {
    result: { found: int64, value: int64 } <- get[int64, int64, mem(normal)](inner, key);
    case result.found of {
        0 -> false;
        _: int64 -> true
    }
}
