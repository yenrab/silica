fn insert_int64_at_cons(head: int64, tail: List[int64, mem(normal)], index: int64, value: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        head_saved: int64 <- head;
        tail_saved: List[int64, mem(normal)] <- tail;
        value_saved: int64 <- value;
        next_index: int64 <- index - 1;
        rest: List[int64, mem(normal)] <- insert_int64_at(tail_saved, next_index, value_saved);
        result: List[int64, mem(normal)] <- prepend_int64(head_saved, rest)
    produces
        pure result
    end
}

fn prepend_int64(value: int64, values: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        updated: List[int64, mem(normal)] <- prepend[int64, mem(normal)](value, values)
    produces
        pure updated
    end
}

fn take_int64(values: List[int64, mem(normal)], count: int64) -> List[int64, mem(normal)] {
    case count <= 0 of {
        true -> empty_int64_list();
        false -> case values of {
            []: List[int64, mem(normal)] -> values;
            [head: int64, tail: List[int64, mem(normal)]] -> take_int64_cons(head, tail, count);
            _: List[int64, mem(normal)] -> empty_int64_list()
        }
    }
}

fn take_int64_cons(head: int64, tail: List[int64, mem(normal)], count: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        head_saved: int64 <- head;
        tail_saved: List[int64, mem(normal)] <- tail;
        next_count: int64 <- count - 1;
        rest: List[int64, mem(normal)] <- take_int64(tail_saved, next_count);
        result: List[int64, mem(normal)] <- prepend_int64(head_saved, rest)
    produces
        pure result
    end
}

fn drop_int64(values: List[int64, mem(normal)], count: int64) -> List[int64, mem(normal)] {
    case count <= 0 of {
        true -> values;
        false -> case values of {
            []: List[int64, mem(normal)] -> values;
            [_: int64, tail: List[int64, mem(normal)]] -> drop_int64(tail, count - 1);
            _: List[int64, mem(normal)] -> values
        }
    }
}

fn replace_int64_at(values: List[int64, mem(normal)], index: int64, new_value: int64) -> List[int64, mem(normal)] {
    case index <= 0 of {
        true -> case values of {
            []: List[int64, mem(normal)] -> empty_int64_list();
            [_: int64, tail: List[int64, mem(normal)]] -> prepend_int64(new_value, tail);
            _: List[int64, mem(normal)] -> empty_int64_list()
        };
        false -> case values of {
            []: List[int64, mem(normal)] -> values;
            [head: int64, tail: List[int64, mem(normal)]] -> replace_int64_at_tail(head, tail, index - 1, new_value);
            _: List[int64, mem(normal)] -> values
        }
    }
}

fn replace_int64_at_tail(head: int64, tail: List[int64, mem(normal)], next_index: int64, new_value: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        rest: List[int64, mem(normal)] <- replace_int64_at(tail, next_index, new_value);
        result: List[int64, mem(normal)] <- prepend_int64(head, rest)
    produces
        pure result
    end
}

fn search_key_list_found_cons(head: int64, tail: List[int64, mem(normal)], key: int64, index: int64) -> int64 {
    case head == key of {
        true -> 1;
        false -> case key < head of {
            true -> 0;
            false -> search_key_list_found_at(tail, key, index + 1)
        }
    }
}

