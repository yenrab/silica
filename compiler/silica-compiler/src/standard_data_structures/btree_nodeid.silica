fn node_list_length(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
) -> int64 {
    case nodes of {
        []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0;
        [_: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
            1 + node_list_length(tail);
        _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> 0
    }
}

fn nth_int64(values: List[int64, mem(normal)], index: int64) -> int64 {
    case values of {
        []: List[int64, mem(normal)] -> 0;
        [head: int64, tail: List[int64, mem(normal)]] -> nth_int64_cons(head, tail, index);
        _: List[int64, mem(normal)] -> 0
    }
}

fn nth_int64_cons(head: int64, tail: List[int64, mem(normal)], index: int64) -> int64 {
    sequence
        head_saved: int64 <- head;
        tail_saved: List[int64, mem(normal)] <- tail;
        index_saved: int64 <- index;
        result: int64 <- case index_saved == 0 of {
            true -> head_saved;
            false -> nth_int64(tail_saved, index_saved - 1)
        }
    produces
        pure result
    end
}

fn insert_int64_at(values: List[int64, mem(normal)], index: int64, value: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        value_saved: int64 <- value;
        result: List[int64, mem(normal)] <- case index <= 0 of {
            true -> prepend_int64(value_saved, values);
            false -> case values of {
                []: List[int64, mem(normal)] -> prepend_int64(value_saved, values);
                [head: int64, tail: List[int64, mem(normal)]] -> insert_int64_at_cons(head, tail, index, value_saved);
                _: List[int64, mem(normal)] -> prepend_int64(value_saved, values)
            }
        }
    produces
        pure result
    end
}

