// NodeIDBTreeMap[int64, int64, mem(normal)] (balanced_tree_and_heap_design.md §4.3).
// Bootstrap generated family: order 8, immutable list-backed B-tree map.
// Duplicate-key policy: replace_value.
// Reuses btree_set_nodeid.silica structure; the key difference is that the
// uniqueness pre-check is removed from insert — when a key already exists its
// value is replaced (inserted=0, replaced=1) rather than the insert being rejected.

// Phase 0.4: single int64 map instantiation per module (Collectable resolution at call sites).
export empty[int64, int64, mem(normal)]/0;
export empty/1;
export contains[int64, int64, mem(normal)]/2;
export get[int64, int64, mem(normal)]/2;
export insert[int64, int64, mem(normal)]/3;
export validate[int64, int64, mem(normal)]/1;
export ordered_map_get/2;
export ordered_map_contains_key/2;

fn order() -> int64 {
    8
}

fn max_keys() -> int64 {
    7
}

fn min_keys_non_root() -> int64 {
    3
}

fn first_error(first: int64, second: int64) -> int64 {
    case first of {
        0 -> second;
        _: int64 -> first
    }
}

fn key_equal(left: int64, right: int64) -> int64 {
    case left == right of {
        true -> 1;
        false -> 0
    }
}

fn key_less(left: int64, right: int64) -> int64 {
    case left < right of {
        true -> 1;
        false -> 0
    }
}

fn empty_int64_list() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        values: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure values
    end
}

