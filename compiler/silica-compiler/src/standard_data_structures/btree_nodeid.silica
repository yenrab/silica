fn find_node(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64
) -> { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        empty_keys: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        empty_values: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        empty_children: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        found: int64 <- node_exists(nodes, node_id);
        safe_id: int64 <- case found of {
            0 -> -1;
            _: int64 -> node_id
        };
        node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: safe_id,
            key_count: find_node_key_count(nodes, node_id),
            is_leaf: find_node_is_leaf(nodes, node_id),
            keys: find_node_keys(nodes, node_id, empty_keys),
            values: find_node_values(nodes, node_id, empty_values),
            children: find_node_children(nodes, node_id, empty_children)
        }
    produces
        pure node
    end
}

fn node_exists(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64
) -> int64 {
    case node_id_count(nodes, node_id) of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn prepend_node(
    node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
) -> List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        updated: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            prepend[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)](node, nodes)
    produces
        pure updated
    end
}

fn replace_node(
    nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    replacement: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }
) -> List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        nodes_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- nodes;
        node_id_saved: int64 <- node_id;
        replacement_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- replacement;
        result: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- case nodes_saved of {
            []: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> nodes_saved;
            [head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]] ->
                replace_node_cons(head, tail, node_id_saved, replacement_saved);
            _: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] -> nodes_saved
        }
    produces
        pure result
    end
}

fn replace_node_cons(
    head: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] },
    tail: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)],
    node_id: int64,
    replacement: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }
) -> List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] {
    sequence proc[]
        head_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- head;
        tail_saved: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- tail;
        node_id_saved: int64 <- node_id;
        replacement_saved: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- replacement;
        is_match: int64 <- case head_saved.id == node_id_saved of {
            true -> 1;
            false -> 0
        };
        result: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <- case is_match of {
            1 -> prepend_node(replacement_saved, tail_saved);
            _: int64 -> prepend_node(head_saved, replace_node(tail_saved, node_id_saved, replacement_saved))
        }
    produces
        pure result
    end
}

fn contains_key_by_index(keys: List[int64, mem(normal)], key: int64, index: int64, key_count: int64) -> int64 {
    case key_count <= 0 of {
        true -> 0;
        false -> contains_key_slot0(keys, key, key_count)
    }
}

fn contains_key_slot0(keys: List[int64, mem(normal)], key: int64, key_count: int64) -> int64 {
    case keys of {
        []: List[int64, mem(normal)] -> 0;
        [head: int64, tail: List[int64, mem(normal)]] -> case head == key of {
            true -> 1;
            false -> contains_key_slot1(tail, key, key_count)
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn contains_key_slot1(keys: List[int64, mem(normal)], key: int64, key_count: int64) -> int64 {
