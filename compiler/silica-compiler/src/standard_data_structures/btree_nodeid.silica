        new_key_count: int64 <- list_int64_length(new_keys);
        new_node: { id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] } <- {
            id: node_id_saved,
            key_count: new_key_count,
            is_leaf: 1,
            keys: new_keys,
            values: new_vals,
            children: node_children_saved
        };
        new_nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)] <-
            replace_node(tree.nodes, node_id_saved, new_node);
        result: {
            tree: {
                root_id: int64,
                node_count: int64,
                order: int64,
                nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], values: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
            },
