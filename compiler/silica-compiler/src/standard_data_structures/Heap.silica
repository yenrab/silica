export trait Heap;
export peek/1;
export len/1;
export compare_priority/3;

required {
    fn peek(heap: Heap) -> int64;
    fn len(heap: Heap) -> int64;
    fn compare_priority(heap: Heap, left: int64, right: int64) -> atom;
}

impl fn compare_priority(
    heap: { compare_priority: fn(int64, int64) -> atom },
    left: int64,
    right: int64
) -> atom {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

impl fn peek(heap: { compare_priority: fn(int64, int64) -> atom }) -> int64 {
    0
}

impl fn len(heap: { compare_priority: fn(int64, int64) -> atom }) -> int64 {
    0
}
