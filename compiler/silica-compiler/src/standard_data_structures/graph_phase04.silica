export empty/1;
export add_edge/3;

fn empty(node_count: int64) -> { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 } {
    graph: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 } <- {
        node_count: node_count,
        edge_count: 0,
        first_from: -1,
        first_to: -1
    };
    graph
}

fn add_edge(
    graph: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 },
    from_id: int64,
    to_id: int64
) -> { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 } {
    updated: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 } <- {
        node_count: graph.node_count,
        edge_count: graph.edge_count + 1,
        first_from: from_id,
        first_to: to_id
    };
    updated
}
