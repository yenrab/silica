// DenseMatrixGraph directed weighted int64, memory space normal (graph_representation_design.md §5).
// Bootstrap capacity: 3 nodes, 9 matrix cells.

use graph_adj_list_helpers;

export graph_dense_directed_weighted_int64_normal_empty/1;
export graph_dense_directed_weighted_int64_normal_node_count/1;
export graph_dense_directed_weighted_int64_normal_edge_count/1;
export graph_dense_directed_weighted_int64_normal_set_edge_checked/4;
export graph_dense_directed_weighted_int64_normal_has_edge/3;
export graph_dense_directed_weighted_int64_normal_weight_at_checked/3;
export graph_dense_directed_weighted_int64_normal_out_degree/2;
export graph_dense_directed_weighted_int64_normal_validate/1;

fn graph_dense_directed_weighted_int64_normal_empty(initial_node_count: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        present: buf(L1, normal, int64, 9) <- alloc_buf(r, 9);
        weights: buf(L1, normal, int64, 9) <- alloc_buf(r, 9);
        _: atom <- write_buf(present, 0, 0);
        _: atom <- write_buf(present, 1, 0);
        _: atom <- write_buf(present, 2, 0);
        _: atom <- write_buf(present, 3, 0);
        _: atom <- write_buf(present, 4, 0);
        _: atom <- write_buf(present, 5, 0);
        _: atom <- write_buf(present, 6, 0);
        _: atom <- write_buf(present, 7, 0);
        _: atom <- write_buf(present, 8, 0);
        _: atom <- write_buf(weights, 0, 0);
        _: atom <- write_buf(weights, 1, 0);
        _: atom <- write_buf(weights, 2, 0);
        _: atom <- write_buf(weights, 3, 0);
        _: atom <- write_buf(weights, 4, 0);
        _: atom <- write_buf(weights, 5, 0);
        _: atom <- write_buf(weights, 6, 0);
        _: atom <- write_buf(weights, 7, 0);
        _: atom <- write_buf(weights, 8, 0);
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- {
            region: r,
            node_count: initial_node_count,
            edge_count: 0,
            present: present,
            weights: weights
        }
    produces
        pure graph
    end
}

fn graph_dense_directed_weighted_int64_normal_node_count(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}) -> int64 {
    graph.node_count
}

fn graph_dense_directed_weighted_int64_normal_edge_count(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}) -> int64 {
    graph.edge_count
}

fn graph_dense_directed_weighted_int64_normal_index(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> int64 {
    from_id * graph.node_count + to_id
}

fn graph_dense_directed_weighted_int64_normal_set_edge_checked(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64, weight: int64) -> { ok: int64, graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
} } {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(from_id, graph.node_count) of {
        0 -> { ok: 0, graph: graph };
        1 -> graph_dense_directed_weighted_int64_normal_set_edge_from_ok(graph, from_id, to_id, weight);
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn graph_dense_directed_weighted_int64_normal_set_edge_from_ok(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64, weight: int64) -> { ok: int64, graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
} } {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(to_id, graph.node_count) of {
        0 -> { ok: 0, graph: graph };
        1 -> graph_dense_directed_weighted_int64_normal_set_edge_valid(graph, from_id, to_id, weight);
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn graph_dense_directed_weighted_int64_normal_set_edge_valid(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64, weight: int64) -> { ok: int64, graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
} } {
    sequence proc[mem(normal)]
        index: int64 <- graph_dense_directed_weighted_int64_normal_index(graph, from_id, to_id);
        _: atom <- write_buf(graph.present, index, 1);
        _: atom <- write_buf(graph.weights, index, weight);
        updated: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- {
            region: graph.region,
            node_count: graph.node_count,
            edge_count: graph.edge_count + 1,
            present: graph.present,
            weights: graph.weights
        }
    produces
        pure { ok: 1, graph: updated }
    end
}

fn graph_dense_directed_weighted_int64_normal_has_edge(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> int64 {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(from_id, graph.node_count) of {
        0 -> 0;
        1 -> graph_dense_directed_weighted_int64_normal_has_edge_from_ok(graph, from_id, to_id);
        _: int64 -> 0
    }
}

fn graph_dense_directed_weighted_int64_normal_has_edge_from_ok(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> int64 {
    case graph_adj_list_helpers@graph_adj_node_id_in_range(to_id, graph.node_count) of {
        0 -> 0;
        1 -> graph_dense_directed_weighted_int64_normal_has_edge_valid(graph, from_id, to_id);
        _: int64 -> 0
    }
}

fn graph_dense_directed_weighted_int64_normal_has_edge_valid(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> int64 {
    sequence proc[mem(normal)]
        index: int64 <- graph_dense_directed_weighted_int64_normal_index(graph, from_id, to_id);
        value: int64 <- read_buf(graph.present, index)
    produces
        pure value
    end
}

fn graph_dense_directed_weighted_int64_normal_weight_at_checked(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> { ok: int64, value: int64 } {
    case graph_dense_directed_weighted_int64_normal_has_edge(graph, from_id, to_id) of {
        0 -> { ok: 0, value: 0 };
        1 -> graph_dense_directed_weighted_int64_normal_weight_at_present(graph, from_id, to_id);
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn graph_dense_directed_weighted_int64_normal_weight_at_present(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> { ok: int64, value: int64 } {
    sequence proc[mem(normal)]
        index: int64 <- graph_dense_directed_weighted_int64_normal_index(graph, from_id, to_id);
        value: int64 <- read_buf(graph.weights, index)
    produces
        pure { ok: 1, value: value }
    end
}

fn graph_dense_directed_weighted_int64_normal_out_degree(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64) -> int64 {
    graph_dense_directed_weighted_int64_normal_has_edge(graph, from_id, 0)
    + graph_dense_directed_weighted_int64_normal_has_edge(graph, from_id, 1)
    + graph_dense_directed_weighted_int64_normal_has_edge(graph, from_id, 2)
}

fn graph_dense_directed_weighted_int64_normal_cell_ok(value: int64) -> int64 {
    case value of {
        0 -> 1;
        1 -> 1;
        _: int64 -> 0
    }
}

fn graph_dense_directed_weighted_int64_normal_validate(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}) -> int64 {
    case graph.node_count - 3 of {
        0 -> graph_dense_directed_weighted_int64_normal_validate_cells(graph);
        _: int64 -> 0
    }
}

fn graph_dense_directed_weighted_int64_normal_validate_cells(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}) -> int64 {
    sequence proc[mem(normal)]
        c0: int64 <- read_buf(graph.present, 0);
        c1: int64 <- read_buf(graph.present, 1);
        c2: int64 <- read_buf(graph.present, 2);
        c3: int64 <- read_buf(graph.present, 3);
        c4: int64 <- read_buf(graph.present, 4);
        c5: int64 <- read_buf(graph.present, 5);
        c6: int64 <- read_buf(graph.present, 6);
        c7: int64 <- read_buf(graph.present, 7);
        c8: int64 <- read_buf(graph.present, 8);
        bool_ok: int64 <-
            graph_dense_directed_weighted_int64_normal_cell_ok(c0)
            * graph_dense_directed_weighted_int64_normal_cell_ok(c1)
            * graph_dense_directed_weighted_int64_normal_cell_ok(c2)
            * graph_dense_directed_weighted_int64_normal_cell_ok(c3)
            * graph_dense_directed_weighted_int64_normal_cell_ok(c4)
            * graph_dense_directed_weighted_int64_normal_cell_ok(c5)
            * graph_dense_directed_weighted_int64_normal_cell_ok(c6)
            * graph_dense_directed_weighted_int64_normal_cell_ok(c7)
            * graph_dense_directed_weighted_int64_normal_cell_ok(c8);
        count: int64 <- c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8
    produces
        pure graph_dense_directed_weighted_int64_normal_validate_count(bool_ok, graph.edge_count, count)
    end
}

fn graph_dense_directed_weighted_int64_normal_validate_count(bool_ok: int64, edge_count: int64, count: int64) -> int64 {
    case bool_ok of {
        0 -> 0;
        1 -> graph_dense_directed_weighted_int64_normal_validate_edge_count(edge_count, count);
        _: int64 -> 0
    }
}

fn graph_dense_directed_weighted_int64_normal_validate_edge_count(edge_count: int64, count: int64) -> int64 {
    case edge_count - count of {
        0 -> 1;
        _: int64 -> 0
    }
}
