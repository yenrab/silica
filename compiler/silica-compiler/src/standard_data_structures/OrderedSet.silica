export trait OrderedSet;
export contains/2;
export size/1;
export compare_item/3;

required {
    fn contains(set: OrderedSet, item: int64) -> boolean;
    fn size(set: OrderedSet) -> int64;
    fn compare_item(set: OrderedSet, left: int64, right: int64) -> :less | :equal | :greater;
}

impl fn compare_item(
    set: { compare_item: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_first: int64, first_item: int64 },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- set.compare_item;
    cmp(left, right)
}

impl fn contains(
    set: { compare_item: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_first: int64, first_item: int64 },
    item: int64
) -> boolean {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- set.compare_item;
    case set.has_first of {
        0 -> false;
        _: int64 -> case cmp(set.first_item, item) of {
            :equal -> true;
            _: atom -> false
        }
    }
}

impl fn size(set: { compare_item: fn(int64, int64) -> :less | :equal | :greater, item_count: int64, has_first: int64, first_item: int64 }) -> int64 {
    set.item_count
}

impl fn compare_item(
    set: {
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    left: int64,
    right: int64
) -> :less | :equal | :greater {
    cmp: fn(int64, int64) -> :less | :equal | :greater <- set.compare_item;
    cmp(left, right)
}

impl fn contains(
    set: {
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    },
    item: int64
) -> boolean {
    false
}

impl fn size(
    set: {
        compare_item: fn(int64, int64) -> :less | :equal | :greater,
        root_id: int64,
        node_count: int64,
        order: int64,
        nodes: List[{ id: int64, key_count: int64, is_leaf: int64, keys: List[int64, mem(normal)], children: List[int64, mem(normal)] }, mem(normal)]
    }
) -> int64 {
    set.node_count
}
