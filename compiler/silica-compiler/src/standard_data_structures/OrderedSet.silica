export trait OrderedSet;
export contains/2;
export size/1;
export compare_item/3;

required {
    fn contains(set: OrderedSet, item: int64) -> boolean;
    fn size(set: OrderedSet) -> int64;
    fn compare_item(set: OrderedSet, left: int64, right: int64) -> atom;
}

impl fn compare_item(
    set: { compare_item: fn(int64, int64) -> atom },
    left: int64,
    right: int64
) -> atom {
    case left < right of {
        true -> :less;
        false -> case left == right of {
            true -> :equal;
            false -> :greater
        }
    }
}

impl fn contains(
    set: { compare_item: fn(int64, int64) -> atom },
    item: int64
) -> boolean {
    false
}

impl fn size(set: { compare_item: fn(int64, int64) -> atom }) -> int64 {
    0
}
