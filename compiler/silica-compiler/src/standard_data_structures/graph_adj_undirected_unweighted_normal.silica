// NodeIdAdjacencyGraph undirected unweighted, memory space normal (graph_representation_design.md §3).
// Bootstrap layout: fixed neighbor slots for node ids 0..2.

use graph_adj_list_helpers;

export graph_adj_undirected_unweighted_normal_empty/1;
export graph_adj_undirected_unweighted_normal_node_count/1;
export graph_adj_undirected_unweighted_normal_edge_count/1;
export graph_adj_undirected_unweighted_normal_add_edge/3;
export graph_adj_undirected_unweighted_normal_add_edge_checked/3;
export graph_adj_undirected_unweighted_normal_neighbors/2;
export graph_adj_undirected_unweighted_normal_neighbors_checked/2;
export graph_adj_undirected_unweighted_normal_out_degree/2;
export graph_adj_undirected_unweighted_normal_out_degree_checked/2;
export graph_adj_undirected_unweighted_normal_has_edge/3;
export graph_adj_undirected_unweighted_normal_has_edge_checked/3;
export graph_adj_undirected_unweighted_normal_validate/1;

fn graph_adj_undirected_unweighted_normal_empty(initial_node_count: int64) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: initial_node_count,
            edge_count: 0,
            n0_neighbors: empty_neighbors,
            n1_neighbors: empty_neighbors,
            n2_neighbors: empty_neighbors
        }
    produces
        pure graph
    end
}

fn graph_adj_undirected_unweighted_normal_node_count(graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    graph.node_count
}

fn graph_adj_undirected_unweighted_normal_edge_count(graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    graph.edge_count
}

fn graph_adj_undirected_unweighted_normal_prepend_slot(
    old_neighbors: List[int64, mem(normal)],
    to_id: int64
) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        updated: List[int64, mem(normal)] <- prepend[int64, mem(normal)](to_id, old_neighbors)
    produces
        pure updated
    end
}

fn graph_adj_undirected_unweighted_normal_neighbors_list(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64,
    empty_neighbors: List[int64, mem(normal)]
) -> List[int64, mem(normal)] {
    case node_id of {
        0 -> graph.n0_neighbors;
        1 -> graph.n1_neighbors;
        2 -> graph.n2_neighbors;
        _: int64 -> empty_neighbors
    }
}

fn graph_adj_undirected_unweighted_normal_add_directed_slot(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    case from_id of {
        0 -> {
            node_count: graph.node_count,
            edge_count: graph.edge_count,
            n0_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n0_neighbors, to_id),
            n1_neighbors: graph.n1_neighbors,
            n2_neighbors: graph.n2_neighbors
        };
        1 -> {
            node_count: graph.node_count,
            edge_count: graph.edge_count,
            n0_neighbors: graph.n0_neighbors,
            n1_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n1_neighbors, to_id),
            n2_neighbors: graph.n2_neighbors
        };
        2 -> {
            node_count: graph.node_count,
            edge_count: graph.edge_count,
            n0_neighbors: graph.n0_neighbors,
            n1_neighbors: graph.n1_neighbors,
            n2_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n2_neighbors, to_id)
        };
        _: int64 -> graph
    }
}

fn graph_adj_undirected_unweighted_normal_finish_add(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    finished: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    } <- {
        node_count: graph.node_count,
        edge_count: graph.edge_count + 1,
        n0_neighbors: graph.n0_neighbors,
        n1_neighbors: graph.n1_neighbors,
        n2_neighbors: graph.n2_neighbors
    };
    finished
}

fn graph_adj_undirected_unweighted_normal_add_from0(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    case to_id of {
        0 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n0_neighbors, 0), n1_neighbors: graph.n1_neighbors, n2_neighbors: graph.n2_neighbors } };
        1 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n0_neighbors, 1), n1_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n1_neighbors, 0), n2_neighbors: graph.n2_neighbors } };
        2 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n0_neighbors, 2), n1_neighbors: graph.n1_neighbors, n2_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n2_neighbors, 0) } };
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn graph_adj_undirected_unweighted_normal_add_from1(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    case to_id of {
        0 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n0_neighbors, 1), n1_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n1_neighbors, 0), n2_neighbors: graph.n2_neighbors } };
        1 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph.n0_neighbors, n1_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n1_neighbors, 1), n2_neighbors: graph.n2_neighbors } };
        2 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph.n0_neighbors, n1_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n1_neighbors, 2), n2_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n2_neighbors, 1) } };
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn graph_adj_undirected_unweighted_normal_add_from2(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    case to_id of {
        0 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n0_neighbors, 2), n1_neighbors: graph.n1_neighbors, n2_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n2_neighbors, 0) } };
        1 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph.n0_neighbors, n1_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n1_neighbors, 2), n2_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n2_neighbors, 1) } };
        2 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph.n0_neighbors, n1_neighbors: graph.n1_neighbors, n2_neighbors: graph_adj_undirected_unweighted_normal_prepend_slot(graph.n2_neighbors, 2) } };
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn graph_adj_undirected_unweighted_normal_add_edge_when_ok(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    case from_id of {
        0 -> graph_adj_undirected_unweighted_normal_add_from0(graph, to_id);
        1 -> graph_adj_undirected_unweighted_normal_add_from1(graph, to_id);
        2 -> graph_adj_undirected_unweighted_normal_add_from2(graph, to_id);
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn graph_adj_undirected_unweighted_normal_add_edge_checked(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_id, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_id, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    case endpoints_ok of {
        0 -> { ok: 0, graph: graph };
        1 -> graph_adj_undirected_unweighted_normal_add_edge_when_ok(graph, from_id, to_id);
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn graph_adj_undirected_unweighted_normal_add_edge(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    checked: { ok: int64, graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    } } <- graph_adj_undirected_unweighted_normal_add_edge_checked(graph, from_id, to_id);
    checked.graph
}

fn graph_adj_undirected_unweighted_normal_neighbors(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> List[int64, mem(normal)] {
    result: { ok: int64, value: List[int64, mem(normal)] } <- graph_adj_undirected_unweighted_normal_neighbors_checked(graph, node_id);
    result.value
}

fn graph_adj_undirected_unweighted_normal_neighbors_checked(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(node_id, graph.node_count);
        neighbors: List[int64, mem(normal)] <- graph_adj_undirected_unweighted_normal_neighbors_list(graph, node_id, empty_neighbors);
        out: { ok: int64, value: List[int64, mem(normal)] } <- case in_range of {
            0 -> { ok: 0, value: empty_neighbors };
            1 -> { ok: 1, value: neighbors };
            _: int64 -> { ok: 0, value: empty_neighbors }
        }
    produces
        pure out
    end
}

fn graph_adj_undirected_unweighted_normal_out_degree(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- graph_adj_undirected_unweighted_normal_out_degree_checked(graph, node_id);
    result.value
}

fn graph_adj_undirected_unweighted_normal_out_degree_checked(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: int64 } {
    neighbors_result: { ok: int64, value: List[int64, mem(normal)] } <- graph_adj_undirected_unweighted_normal_neighbors_checked(graph, node_id);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: graph_adj_list_helpers@graph_adj_list_int64_length(neighbors_result.value) };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn graph_adj_undirected_unweighted_normal_has_edge(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- graph_adj_undirected_unweighted_normal_has_edge_checked(graph, from_id, to_id);
    result.value
}

fn graph_adj_undirected_unweighted_normal_has_edge_checked(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, value: int64 } {
    neighbors_result: { ok: int64, value: List[int64, mem(normal)] } <- graph_adj_undirected_unweighted_normal_neighbors_checked(graph, from_id);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: graph_adj_list_helpers@graph_adj_list_int64_contains(neighbors_result.value, to_id) };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn graph_adj_undirected_unweighted_normal_validate(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    case graph.node_count of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> 1;
        _: int64 -> 0
    }
}
