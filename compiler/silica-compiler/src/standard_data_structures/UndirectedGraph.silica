export trait UndirectedGraph;
export node_count/1;
export edge_count/1;
export has_edge/3;

required {
    fn node_count(graph: UndirectedGraph) -> int64;
    fn edge_count(graph: UndirectedGraph) -> int64;
    fn has_edge(graph: UndirectedGraph, left_id: int64, right_id: int64) -> boolean;
}

impl fn node_count(graph: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 }) -> int64 {
    graph.node_count
}

impl fn edge_count(graph: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 }) -> int64 {
    graph.edge_count
}

impl fn has_edge(
    graph: { node_count: int64, edge_count: int64, first_from: int64, first_to: int64 },
    left_id: int64,
    right_id: int64
) -> boolean {
    graph.edge_count > 0 and (
        (graph.first_from == left_id and graph.first_to == right_id)
        or (graph.first_from == right_id and graph.first_to == left_id)
    )
}
