// NodeIdAdjacencyGraphUndirected[mem(normal)] (graph_representation_design.md §2.11).
// Bootstrap layout: fixed neighbor slots for node ids 0..2.

use graph_adj_list_helpers;

export empty[mem(normal)]/1;
export node_count[mem(normal)]/1;
export edge_count[mem(normal)]/1;
export add_edge[mem(normal)]/3;
export add_edge_checked[mem(normal)]/3;
export neighbors[mem(normal)]/2;
export neighbors_checked[mem(normal)]/2;
export out_degree[mem(normal)]/2;
export out_degree_checked[mem(normal)]/2;
export has_edge[mem(normal)]/3;
export has_edge_checked[mem(normal)]/3;
export validate[mem(normal)]/1;
export empty/2;
export empty[int64, int64, mem(normal)]/2;
export neighbors[int64, int64, mem(normal)]/2;
export neighbors_checked[int64, int64, mem(normal)]/2;
export add_edge[int64, int64, mem(normal)]/3;
export add_edge_checked[int64, int64, mem(normal)]/3;
export out_degree[int64, int64, mem(normal)]/2;
export out_degree_checked[int64, int64, mem(normal)]/2;
export has_edge[int64, int64, mem(normal)]/3;
export has_edge_checked[int64, int64, mem(normal)]/3;
export validate[int64, int64, mem(normal)]/1;

fn empty[mem(normal)](initial_node_count: int64) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    sequence proc[mem(normal)]
        n0_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n1_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n2_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        graph: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: initial_node_count,
            edge_count: 0,
            n0_neighbors: n0_empty,
            n1_neighbors: n1_empty,
            n2_neighbors: n2_empty
        }
    produces
        pure graph
    end
}

fn node_count[mem(normal)](graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    graph.node_count
}

fn edge_count[mem(normal)](graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
}) -> int64 {
    graph.edge_count
}

fn prepend_slot(
    old_neighbors: List[int64, mem(normal)],
    to_id: int64
) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        updated: List[int64, mem(normal)] <- prepend[int64, mem(normal)](to_id, old_neighbors)
    produces
        pure updated
    end
}

fn neighbors_list(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64,
    empty_neighbors: List[int64, mem(normal)]
) -> List[int64, mem(normal)] {
    case node_id of {
        0 -> graph.n0_neighbors;
        1 -> graph.n1_neighbors;
        2 -> graph.n2_neighbors;
        _: int64 -> empty_neighbors
    }
}

fn add_directed_slot(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    case from_id of {
        0 -> {
            node_count: graph.node_count,
            edge_count: graph.edge_count,
            n0_neighbors: prepend_slot(graph.n0_neighbors, to_id),
            n1_neighbors: graph.n1_neighbors,
            n2_neighbors: graph.n2_neighbors
        };
        1 -> {
            node_count: graph.node_count,
            edge_count: graph.edge_count,
            n0_neighbors: graph.n0_neighbors,
            n1_neighbors: prepend_slot(graph.n1_neighbors, to_id),
            n2_neighbors: graph.n2_neighbors
        };
        2 -> {
            node_count: graph.node_count,
            edge_count: graph.edge_count,
            n0_neighbors: graph.n0_neighbors,
            n1_neighbors: graph.n1_neighbors,
            n2_neighbors: prepend_slot(graph.n2_neighbors, to_id)
        };
        _: int64 -> graph
    }
}

fn finish_add(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    finished: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    } <- {
        node_count: graph.node_count,
        edge_count: graph.edge_count + 1,
        n0_neighbors: graph.n0_neighbors,
        n1_neighbors: graph.n1_neighbors,
        n2_neighbors: graph.n2_neighbors
    };
    finished
}

fn add_from0(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    case to_id of {
        0 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: prepend_slot(graph.n0_neighbors, 0), n1_neighbors: graph.n1_neighbors, n2_neighbors: graph.n2_neighbors } };
        1 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: prepend_slot(graph.n0_neighbors, 1), n1_neighbors: prepend_slot(graph.n1_neighbors, 0), n2_neighbors: graph.n2_neighbors } };
        2 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: prepend_slot(graph.n0_neighbors, 2), n1_neighbors: graph.n1_neighbors, n2_neighbors: prepend_slot(graph.n2_neighbors, 0) } };
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn add_from1(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    case to_id of {
        0 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: prepend_slot(graph.n0_neighbors, 1), n1_neighbors: prepend_slot(graph.n1_neighbors, 0), n2_neighbors: graph.n2_neighbors } };
        1 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph.n0_neighbors, n1_neighbors: prepend_slot(graph.n1_neighbors, 1), n2_neighbors: graph.n2_neighbors } };
        2 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph.n0_neighbors, n1_neighbors: prepend_slot(graph.n1_neighbors, 2), n2_neighbors: prepend_slot(graph.n2_neighbors, 1) } };
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn add_from2(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    case to_id of {
        0 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: prepend_slot(graph.n0_neighbors, 2), n1_neighbors: graph.n1_neighbors, n2_neighbors: prepend_slot(graph.n2_neighbors, 0) } };
        1 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph.n0_neighbors, n1_neighbors: prepend_slot(graph.n1_neighbors, 2), n2_neighbors: prepend_slot(graph.n2_neighbors, 1) } };
        2 -> { ok: 1, graph: { node_count: graph.node_count, edge_count: graph.edge_count + 1, n0_neighbors: graph.n0_neighbors, n1_neighbors: graph.n1_neighbors, n2_neighbors: prepend_slot(graph.n2_neighbors, 2) } };
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn add_edge_when_ok(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    case from_id of {
        0 -> add_from0(graph, to_id);
        1 -> add_from1(graph, to_id);
        2 -> add_from2(graph, to_id);
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn add_edge_checked[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, graph: {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    case endpoints_ok of {
        0 -> { ok: 0, graph: graph };
        1 -> add_edge_when_ok(graph, from_saved, to_saved);
        _: int64 -> { ok: 0, graph: graph }
    }
}

fn add_edge[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    checked: { ok: int64, graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    } } <- add_edge_checked[mem(normal)](graph, from_id, to_id);
    checked.graph
}

fn neighbors[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> List[int64, mem(normal)] {
    result: { ok: int64, value: List[int64, mem(normal)] } <- neighbors_checked[mem(normal)](graph, node_id);
    result.value
}

fn neighbors_checked[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(node_id, graph.node_count);
        neighbors: List[int64, mem(normal)] <- neighbors_list(graph, node_id, empty_neighbors);
        out: { ok: int64, value: List[int64, mem(normal)] } <- case in_range of {
            0 -> { ok: 0, value: empty_neighbors };
            1 -> { ok: 1, value: neighbors };
            _: int64 -> { ok: 0, value: empty_neighbors }
        }
    produces
        pure out
    end
}

fn out_degree[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- out_degree_checked[mem(normal)](graph, node_id);
    result.value
}

fn out_degree_checked[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    node_id: int64
) -> { ok: int64, value: int64 } {
    neighbors_result: { ok: int64, value: List[int64, mem(normal)] } <- neighbors_checked[mem(normal)](graph, node_id);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: graph_adj_list_helpers@graph_adj_list_int64_length(neighbors_result.value) };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn has_edge[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- has_edge_checked[mem(normal)](graph, from_id, to_id);
    result.value
}

fn has_edge_checked[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, value: int64 } {
    neighbors_result: { ok: int64, value: List[int64, mem(normal)] } <- neighbors_checked[mem(normal)](graph, from_id);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: graph_adj_list_helpers@graph_adj_list_int64_contains(neighbors_result.value, to_id) };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn validate_mirror_edge_int64(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64,
    tail: List[int64, mem(normal)]
) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    reverse_ok: int64 <- has_edge[mem(normal)](graph, to_saved, from_saved);
    case reverse_ok of {
        1 -> validate_mirror_int64_neighbors(graph, from_saved, tail);
        _: int64 -> 0
    }
}

fn validate_mirror_int64_neighbors(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    neighbors: List[int64, mem(normal)]
) -> int64 {
    from_saved: int64 <- from_id;
    case neighbors of {
        []: List[int64, mem(normal)] -> 1;
        [to_id: int64, tail: List[int64, mem(normal)]] -> case graph_adj_list_helpers@graph_adj_int64_equal(from_saved, to_id) of {
            1 -> validate_mirror_int64_neighbors(graph, from_saved, tail);
            _: int64 -> validate_mirror_edge_int64(graph, from_saved, to_id, tail)
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn validate_flat_undirected_mirror(
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    node_count_saved: int64 <- graph.node_count;
    edge_count_saved: int64 <- graph.edge_count;
    n0_saved: List[int64, mem(normal)] <- graph.n0_neighbors;
    n1_saved: List[int64, mem(normal)] <- graph.n1_neighbors;
    n2_saved: List[int64, mem(normal)] <- graph.n2_neighbors;
    graph_saved: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    } <- {
        node_count: node_count_saved,
        edge_count: edge_count_saved,
        n0_neighbors: n0_saved,
        n1_neighbors: n1_saved,
        n2_neighbors: n2_saved
    };
    slot0_ok: int64 <- case node_count_saved of {
        0 -> 1;
        _: int64 -> validate_mirror_int64_neighbors(graph_saved, 0, n0_saved)
    };
    slot1_ok: int64 <- case node_count_saved of {
        0 -> 1;
        1 -> 1;
        _: int64 -> validate_mirror_int64_neighbors(graph_saved, 1, n1_saved)
    };
    slot2_ok: int64 <- case node_count_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> validate_mirror_int64_neighbors(graph_saved, 2, n2_saved);
        _: int64 -> 0
    };
    case slot0_ok of {
        0 -> 0;
        1 -> case slot1_ok of {
            0 -> 0;
            1 -> slot2_ok;
            _: int64 -> 0
        };
        _: int64 -> 0
    }
}

fn validate[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    }
) -> int64 {
    node_count_saved: int64 <- graph.node_count;
    edge_count_saved: int64 <- graph.edge_count;
    n0_saved: List[int64, mem(normal)] <- graph.n0_neighbors;
    n1_saved: List[int64, mem(normal)] <- graph.n1_neighbors;
    n2_saved: List[int64, mem(normal)] <- graph.n2_neighbors;
    directed_ok: int64 <- graph_adj_list_helpers@graph_adj_validate_flat_unweighted_undirected(
        node_count_saved,
        edge_count_saved,
        n0_saved,
        n1_saved,
        n2_saved
    );
    case directed_ok of {
        0 -> 0;
        1 -> validate_flat_undirected_mirror({
            node_count: node_count_saved,
            edge_count: edge_count_saved,
            n0_neighbors: n0_saved,
            n1_neighbors: n1_saved,
            n2_neighbors: n2_saved
        });
        _: int64 -> 0
    }
}

fn empty_int64_list() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure empty_neighbors
    end
}

fn build_adj_unweighted_node(
    node_id: int64,
    node_neighbors: List[int64, mem(normal)]
) -> { id: int64, neighbors: List[int64, mem(normal)] } {
    id_saved: int64 <- node_id;
    neighbors_saved: List[int64, mem(normal)] <- node_neighbors;
    sequence proc[mem(normal)]
        _: List[int64, mem(normal)] <- empty_int64_list();
        node: { id: int64, neighbors: List[int64, mem(normal)] } <- {
            id: id_saved,
            neighbors: neighbors_saved
        }
    produces
        pure node
    end
}

fn default_adj_unweighted_node() -> { id: int64, neighbors: List[int64, mem(normal)] } {
    sequence proc[mem(normal)]
        empty_neighbors: List[int64, mem(normal)] <- empty_int64_list()
        default_node: { id: int64, neighbors: List[int64, mem(normal)] } <- {
            id: -1,
            neighbors: empty_neighbors
        }
    produces
        pure default_node
    end
}

fn build_empty_adj_unweighted_graph(
    graph_functions: {
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    initial_node_count: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    count_saved: int64 <- initial_node_count;
    sequence proc[mem(normal)]
        built_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            graph_adj_list_helpers@graph_adj_build_empty_nodes_unweighted(count_saved);
        graph: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- {
            node_count: count_saved,
            edge_count: 0,
            nodes: built_nodes,
            compare_node: graph_functions.compare_node,
            compare_edge: graph_functions.compare_edge,
            edge_target: graph_functions.edge_target
        }
    produces
        pure graph
    end
}

fn empty(
    graph_functions: {
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    initial_node_count: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    build_empty_adj_unweighted_graph(graph_functions, initial_node_count)
}

fn empty[int64, int64, mem(normal)](
    graph_functions: {
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    initial_node_count: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    build_empty_adj_unweighted_graph(graph_functions, initial_node_count)
}

fn find_node_checked(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> { ok: int64, value: { id: int64, neighbors: List[int64, mem(normal)] } } {
    node_saved: int64 <- node_id;
    in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(node_saved, graph.node_count);
    default_node: { id: int64, neighbors: List[int64, mem(normal)] } <- default_adj_unweighted_node();
    lookup: { found: int64, node: { id: int64, neighbors: List[int64, mem(normal)] } } <-
        graph_adj_list_helpers@graph_adj_find_node_unweighted(graph.nodes, node_saved, default_node);
    case in_range of {
        0 -> { ok: 0, value: default_node };
        1 -> case lookup.found of {
            1 -> { ok: 1, value: lookup.node };
            _: int64 -> { ok: 0, value: default_node }
        };
        _: int64 -> { ok: 0, value: default_node }
    }
}

fn neighbors_checked[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> { ok: int64, value: List[int64, mem(normal)] } {
    node_saved: int64 <- node_id;
    node_result: { ok: int64, value: { id: int64, neighbors: List[int64, mem(normal)] } } <- find_node_checked(graph, node_saved);
    empty_neighbors: List[int64, mem(normal)] <- empty_int64_list();
    case node_result.ok of {
        0 -> { ok: 0, value: empty_neighbors };
        1 -> { ok: 1, value: node_result.value.neighbors };
        _: int64 -> { ok: 0, value: empty_neighbors }
    }
}

fn neighbors[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> List[int64, mem(normal)] {
    result: { ok: int64, value: List[int64, mem(normal)] } <- neighbors_checked[int64, int64, mem(normal)](graph, node_id);
    result.value
}

fn out_degree_checked[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> { ok: int64, value: int64 } {
    neighbors_result: { ok: int64, value: List[int64, mem(normal)] } <-
        neighbors_checked[int64, int64, mem(normal)](graph, node_id);
    degree_value: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(neighbors_result.value);
    case neighbors_result.ok of {
        0 -> { ok: 0, value: 0 };
        1 -> { ok: 1, value: degree_value };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn out_degree[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    node_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- out_degree_checked[int64, int64, mem(normal)](graph, node_id);
    result.value
}

fn has_edge_checked[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> { ok: int64, value: int64 } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    neighbors_result: { ok: int64, value: List[int64, mem(normal)] } <-
        neighbors_checked[int64, int64, mem(normal)](graph, from_saved);
    contains_value: int64 <- graph_adj_list_helpers@graph_adj_list_int64_contains(neighbors_result.value, to_saved);
    case endpoints_ok of {
        0 -> { ok: 0, value: 0 };
        1 -> case neighbors_result.ok of {
            0 -> { ok: 0, value: 0 };
            1 -> { ok: 1, value: contains_value };
            _: int64 -> { ok: 0, value: 0 }
        };
        _: int64 -> { ok: 0, value: 0 }
    }
}

fn has_edge[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    result: { ok: int64, value: int64 } <- has_edge_checked[int64, int64, mem(normal)](graph, from_id, to_id);
    result.value
}

fn add_edge_update_from(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    node_result: { ok: int64, value: { id: int64, neighbors: List[int64, mem(normal)] } } <- find_node_checked(graph, from_saved);
    sequence proc[mem(normal)]
        updated_neighbors: List[int64, mem(normal)] <- prepend[int64, mem(normal)](to_saved, node_result.value.neighbors);
        new_node: { id: int64, neighbors: List[int64, mem(normal)] } <- {
            id: from_saved,
            neighbors: updated_neighbors
        };
        updated_nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <-
            graph_adj_list_helpers@graph_adj_replace_node_unweighted(graph.nodes, from_saved, new_node, graph.nodes);
        result: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- {
            node_count: graph.node_count,
            edge_count: graph.edge_count,
            nodes: updated_nodes,
            compare_node: graph.compare_node,
            compare_edge: graph.compare_edge,
            edge_target: graph.edge_target
        }
    produces
        pure result
    end
}

fn add_edge_valid_adj_unweighted(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    same_endpoint: int64 <- case from_saved == to_saved of {
        true -> 1;
        false -> 0
    };
    graph_with_from: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    } <- add_edge_update_from(graph, from_saved, to_saved);
    graph_with_both: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    } <- case same_endpoint of {
        1 -> graph_with_from;
        _: int64 -> add_edge_update_from(graph_with_from, to_saved, from_saved)
    };
    {
        node_count: graph_with_both.node_count,
        edge_count: graph_with_both.edge_count + 1,
        nodes: graph_with_both.nodes,
        compare_node: graph_with_both.compare_node,
        compare_edge: graph_with_both.compare_edge,
        edge_target: graph_with_both.edge_target
    }
}

fn add_edge[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> {
    node_count: int64,
    edge_count: int64,
    nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
    compare_node: fn(int64, int64) -> :less | :equal | :greater,
    compare_edge: fn(int64, int64) -> :less | :equal | :greater,
    edge_target: fn(int64) -> int64
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    case endpoints_ok of {
        0 -> graph;
        1 -> add_edge_valid_adj_unweighted(graph, from_saved, to_saved);
        _: int64 -> graph
    }
}

fn add_edge_checked[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64
) -> {
    ok: int64,
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    }
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    updated_graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    } <- add_edge[int64, int64, mem(normal)](graph, from_saved, to_saved);
    { ok: endpoints_ok, graph: updated_graph }
}

fn validate_mirror_edge_typed(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    to_id: int64,
    tail: List[int64, mem(normal)]
) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    reverse_ok: int64 <- has_edge[int64, int64, mem(normal)](graph, to_saved, from_saved);
    case reverse_ok of {
        1 -> validate_mirror_typed_neighbors(graph, from_saved, tail);
        _: int64 -> 0
    }
}

fn validate_mirror_typed_neighbors(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    },
    from_id: int64,
    neighbors: List[int64, mem(normal)]
) -> int64 {
    from_saved: int64 <- from_id;
    case neighbors of {
        []: List[int64, mem(normal)] -> 1;
        [to_id: int64, tail: List[int64, mem(normal)]] -> case graph_adj_list_helpers@graph_adj_int64_equal(from_saved, to_id) of {
            1 -> validate_mirror_typed_neighbors(graph, from_saved, tail);
            _: int64 -> validate_mirror_edge_typed(graph, from_saved, to_id, tail)
        };
        _: List[int64, mem(normal)] -> 0
    }
}

fn validate_typed_undirected_mirror(
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    }
) -> int64 {
    node_count_saved: int64 <- graph.node_count;
    edge_count_saved: int64 <- graph.edge_count;
    nodes_saved: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph.nodes;
    compare_node_saved: fn(int64, int64) -> :less | :equal | :greater <- graph.compare_node;
    compare_edge_saved: fn(int64, int64) -> :less | :equal | :greater <- graph.compare_edge;
    edge_target_saved: fn(int64) -> int64 <- graph.edge_target;
    graph_saved: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    } <- {
        node_count: node_count_saved,
        edge_count: edge_count_saved,
        nodes: nodes_saved,
        compare_node: compare_node_saved,
        compare_edge: compare_edge_saved,
        edge_target: edge_target_saved
    };
    n0: List[int64, mem(normal)] <- neighbors[int64, int64, mem(normal)](graph_saved, 0);
    n1: List[int64, mem(normal)] <- neighbors[int64, int64, mem(normal)](graph_saved, 1);
    n2: List[int64, mem(normal)] <- neighbors[int64, int64, mem(normal)](graph_saved, 2);
    slot0_ok: int64 <- case node_count_saved of {
        0 -> 1;
        _: int64 -> validate_mirror_typed_neighbors(graph_saved, 0, n0)
    };
    slot1_ok: int64 <- case node_count_saved of {
        0 -> 1;
        1 -> 1;
        _: int64 -> validate_mirror_typed_neighbors(graph_saved, 1, n1)
    };
    slot2_ok: int64 <- case node_count_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        3 -> validate_mirror_typed_neighbors(graph_saved, 2, n2);
        _: int64 -> 0
    };
    case slot0_ok of {
        0 -> 0;
        1 -> case slot1_ok of {
            0 -> 0;
            1 -> slot2_ok;
            _: int64 -> 0
        };
        _: int64 -> 0
    }
}

fn validate[int64, int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
        compare_node: fn(int64, int64) -> :less | :equal | :greater,
        compare_edge: fn(int64, int64) -> :less | :equal | :greater,
        edge_target: fn(int64) -> int64
    }
) -> int64 {
    sequence proc[mem(normal)]
        pin: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        nodes_saved: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- graph.nodes;
        node_count_saved: int64 <- graph.node_count;
        edge_count_saved: int64 <- graph.edge_count;
        nodes_for_records: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes_saved;
        nodes_for_validate: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes_saved;
        nodes_for_sum: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)] <- nodes_saved;
        nc_ok: int64 <- graph_adj_list_helpers@graph_adj_validate_node_count_range(node_count_saved);
        record_count: int64 <- graph_adj_list_helpers@graph_adj_count_node_records_unweighted(nodes_for_records);
        records_ok: int64 <- graph_adj_list_helpers@graph_adj_int64_equal(record_count, node_count_saved);
        nodes_ok: int64 <- graph_adj_list_helpers@graph_adj_validate_typed_nodes_unweighted(nodes_for_validate, node_count_saved);
        neighbor_total: int64 <- graph_adj_list_helpers@graph_adj_sum_neighbor_counts_unweighted(nodes_for_sum);
        edge_ok: int64 <- graph_adj_list_helpers@graph_adj_validate_undirected_storage_edge_count(
            edge_count_saved,
            neighbor_total
        );
        nc_ok_saved: int64 <- nc_ok;
        records_ok_saved: int64 <- records_ok;
        nodes_ok_saved: int64 <- nodes_ok;
        edge_ok_saved: int64 <- edge_ok;
        compare_node_saved: fn(int64, int64) -> :less | :equal | :greater <- graph.compare_node;
        compare_edge_saved: fn(int64, int64) -> :less | :equal | :greater <- graph.compare_edge;
        edge_target_saved: fn(int64) -> int64 <- graph.edge_target;
        graph_saved: {
            node_count: int64,
            edge_count: int64,
            nodes: List[{ id: int64, neighbors: List[int64, mem(normal)] }, mem(normal)],
            compare_node: fn(int64, int64) -> :less | :equal | :greater,
            compare_edge: fn(int64, int64) -> :less | :equal | :greater,
            edge_target: fn(int64) -> int64
        } <- {
            node_count: node_count_saved,
            edge_count: edge_count_saved,
            nodes: nodes_saved,
            compare_node: compare_node_saved,
            compare_edge: compare_edge_saved,
            edge_target: edge_target_saved
        };
        struct_ok: int64 <- case nc_ok_saved of {
            0 -> 0;
            1 -> case records_ok_saved of {
                0 -> 0;
                1 -> case nodes_ok_saved of {
                    0 -> 0;
                    1 -> edge_ok_saved;
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        result: int64 <- case struct_ok of {
            0 -> 0;
            1 -> validate_typed_undirected_mirror(graph_saved);
            _: int64 -> 0
        };
        _: List[int64, mem(normal)] <- pin
    produces
        pure result
    end
}
