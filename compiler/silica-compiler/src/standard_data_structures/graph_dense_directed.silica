}

fn set_edge[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64, weight: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    weight_saved: int64 <- weight;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    safe_from: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> from_saved;
        _: int64 -> 0
    };
    safe_to: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> to_saved;
        _: int64 -> 0
    };
    cell: int64 <- int64_index(graph, safe_from, safe_to);
    sequence proc[mem(normal)]
        previous_present: int64 <- case cell of {
            0 -> read_buf(graph.present, 0);
            1 -> read_buf(graph.present, 1);
            2 -> read_buf(graph.present, 2);
            3 -> read_buf(graph.present, 3);
            4 -> read_buf(graph.present, 4);
            5 -> read_buf(graph.present, 5);
            6 -> read_buf(graph.present, 6);
            7 -> read_buf(graph.present, 7);
            8 -> read_buf(graph.present, 8);
            _: int64 -> 0
        };
        _: atom <- case endpoints_ok of {
            0 -> 0;
            1 -> case cell of {
                0 -> write_buf(graph.present, 0, 1);
                1 -> write_buf(graph.present, 1, 1);
                2 -> write_buf(graph.present, 2, 1);
                3 -> write_buf(graph.present, 3, 1);
                4 -> write_buf(graph.present, 4, 1);
                5 -> write_buf(graph.present, 5, 1);
                6 -> write_buf(graph.present, 6, 1);
                7 -> write_buf(graph.present, 7, 1);
                8 -> write_buf(graph.present, 8, 1);
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        _: atom <- case endpoints_ok of {
            0 -> 0;
            1 -> case cell of {
                0 -> write_buf(graph.weights, 0, weight_saved);
                1 -> write_buf(graph.weights, 1, weight_saved);
                2 -> write_buf(graph.weights, 2, weight_saved);
                3 -> write_buf(graph.weights, 3, weight_saved);
                4 -> write_buf(graph.weights, 4, weight_saved);
                5 -> write_buf(graph.weights, 5, weight_saved);
                6 -> write_buf(graph.weights, 6, weight_saved);
                7 -> write_buf(graph.weights, 7, weight_saved);
                8 -> write_buf(graph.weights, 8, weight_saved);
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        next_edge_count: int64 <- case endpoints_ok of {
            0 -> graph.edge_count;
            1 -> case previous_present of {
                0 -> graph.edge_count + 1;
                _: int64 -> graph.edge_count
            };
            _: int64 -> graph.edge_count
        };
        updated: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- {
            region: graph.region,
            node_count: graph.node_count,
            edge_count: next_edge_count,
            present: graph.present,
            weights: graph.weights
        }
    produces
        pure updated
    end
}

fn set_edge_checked[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64, weight: int64) -> { ok: int64, graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
} } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    weight_saved: int64 <- weight;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    sequence
        updated_graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- set_edge[int64, mem(normal)](graph, from_saved, to_saved, weight_saved);
        out: { ok: int64, graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } } <- {
            ok: endpoints_ok,
            graph: updated_graph
        }
    produces
        pure out
    end
}

fn has_edge[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    to_ok: int64 <- case to_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    dim_ok: int64 <- case graph.node_count - 3 of {
        0 -> 1;
        _: int64 -> 0
    };
    cell: int64 <- int64_index(graph, from_saved, to_saved);
    sequence proc[mem(normal)]
        value: int64 <- case cell of {
            0 -> read_buf(graph.present, 0);
            1 -> read_buf(graph.present, 1);
            2 -> read_buf(graph.present, 2);
            3 -> read_buf(graph.present, 3);
            4 -> read_buf(graph.present, 4);
            5 -> read_buf(graph.present, 5);
            6 -> read_buf(graph.present, 6);
            7 -> read_buf(graph.present, 7);
            8 -> read_buf(graph.present, 8);
            _: int64 -> 0
        };
        result: int64 <- endpoints_ok * dim_ok * value
    produces
        pure result
    end
}

fn weight_at_checked[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> { ok: int64, value: int64 } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    to_ok: int64 <- case to_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    dim_ok: int64 <- case graph.node_count - 3 of {
        0 -> 1;
        _: int64 -> 0
    };
    cell: int64 <- int64_index(graph, from_saved, to_saved);
    sequence proc[mem(normal)]
        edge_present: int64 <- case cell of {
            0 -> read_buf(graph.present, 0);
            1 -> read_buf(graph.present, 1);
            2 -> read_buf(graph.present, 2);
            3 -> read_buf(graph.present, 3);
            4 -> read_buf(graph.present, 4);
            5 -> read_buf(graph.present, 5);
            6 -> read_buf(graph.present, 6);
            7 -> read_buf(graph.present, 7);
            8 -> read_buf(graph.present, 8);
            _: int64 -> 0
        };
        raw_weight: int64 <- case cell of {
            0 -> read_buf(graph.weights, 0);
            1 -> read_buf(graph.weights, 1);
            2 -> read_buf(graph.weights, 2);
            3 -> read_buf(graph.weights, 3);
            4 -> read_buf(graph.weights, 4);
            5 -> read_buf(graph.weights, 5);
            6 -> read_buf(graph.weights, 6);
            7 -> read_buf(graph.weights, 7);
            8 -> read_buf(graph.weights, 8);
            _: int64 -> 0
        };
        ok_out: int64 <- endpoints_ok * dim_ok * edge_present;
        value: int64 <- ok_out * raw_weight;
        out: { ok: int64, value: int64 } <- { ok: ok_out, value: value }
    produces
        pure out
    end
}

fn weight_at[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> int64 {
    checked: { ok: int64, value: int64 } <- weight_at_checked[int64, mem(normal)](graph, from_id, to_id);
    checked.value
}

fn out_degree[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64) -> int64 {
    from_saved: int64 <- from_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    dim_ok: int64 <- case graph.node_count - 3 of {
        0 -> 1;
        _: int64 -> 0
    };
    sequence proc[mem(normal)]
        p00: int64 <- read_buf(graph.present, 0);
        p01: int64 <- read_buf(graph.present, 1);
        p02: int64 <- read_buf(graph.present, 2);
        p10: int64 <- read_buf(graph.present, 3);
        p11: int64 <- read_buf(graph.present, 4);
        p12: int64 <- read_buf(graph.present, 5);
        p20: int64 <- read_buf(graph.present, 6);
        p21: int64 <- read_buf(graph.present, 7);
        p22: int64 <- read_buf(graph.present, 8);
        from_is_0: int64 <- case from_saved of {
            0 -> 1;
            _: int64 -> 0
        };
        from_is_1: int64 <- case from_saved of {
            1 -> 1;
            _: int64 -> 0
        };
        from_is_2: int64 <- case from_saved of {
            2 -> 1;
            _: int64 -> 0
        };
        row0_degree: int64 <- p00 + p01 + p02;
        row1_degree: int64 <- p10 + p11 + p12;
        row2_degree: int64 <- p20 + p21 + p22;
        degree: int64 <-
            (row0_degree * from_is_0) +
            (row1_degree * from_is_1) +
            (row2_degree * from_is_2);
        result: int64 <- from_ok * dim_ok * degree
    produces
        pure result
    end
}

fn neighbor_at_row0[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, local_index: int64) -> int64 {
    local_saved: int64 <- local_index;
    sequence proc[mem(normal)]
        r00: int64 <- read_buf(graph.present, 0);
        r01: int64 <- read_buf(graph.present, 1);
        r02: int64 <- read_buf(graph.present, 2);
        picked: int64 <- neighbor_pick_from_row(r00, r01, r02, local_saved)
    produces
        pure picked
    end
}

fn neighbor_at_row1[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, local_index: int64) -> int64 {
    local_saved: int64 <- local_index;
    sequence proc[mem(normal)]
        r10: int64 <- read_buf(graph.present, 3);
        r11: int64 <- read_buf(graph.present, 4);
        r12: int64 <- read_buf(graph.present, 5);
        picked: int64 <- neighbor_pick_from_row(r10, r11, r12, local_saved)
    produces
        pure picked
    end
}

fn neighbor_at_row2[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, local_index: int64) -> int64 {
    local_saved: int64 <- local_index;
    sequence proc[mem(normal)]
        r20: int64 <- read_buf(graph.present, 6);
        r21: int64 <- read_buf(graph.present, 7);
        r22: int64 <- read_buf(graph.present, 8);
        picked: int64 <- neighbor_pick_from_row(r20, r21, r22, local_saved)
    produces
        pure picked
    end
}

fn neighbor_at[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, local_index: int64) -> int64 {
    from_saved: int64 <- from_id;
    local_saved: int64 <- local_index;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    dim_ok: int64 <- case graph.node_count - 3 of {
        0 -> 1;
        _: int64 -> 0
    };
    picked: int64 <- case from_saved of {
        0 -> neighbor_at_row0[int64, mem(normal)](graph, local_saved);
        1 -> neighbor_at_row1[int64, mem(normal)](graph, local_saved);
        2 -> neighbor_at_row2[int64, mem(normal)](graph, local_saved);
        _: int64 -> -1
    };
    result: int64 <- case from_ok of {
        0 -> -1;
        1 -> case dim_ok of {
            0 -> -1;
            1 -> picked;
            _: int64 -> -1
        };
        _: int64 -> -1
    };
    result
}

fn int64_cell_ok(value: int64) -> int64 {
    case value of {
        0 -> 1;
        1 -> 1;
        _: int64 -> 0
    }
}

fn validate[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}) -> int64 {
    case graph.node_count - 3 of {
        0 -> int64_validate_cells(graph);
        _: int64 -> 0
    }
}

fn int64_validate_cells(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}) -> int64 {
    sequence proc[mem(normal)]
        c0: int64 <- read_buf(graph.present, 0);
        c1: int64 <- read_buf(graph.present, 1);
        c2: int64 <- read_buf(graph.present, 2);
        c3: int64 <- read_buf(graph.present, 3);
        c4: int64 <- read_buf(graph.present, 4);
        c5: int64 <- read_buf(graph.present, 5);
        c6: int64 <- read_buf(graph.present, 6);
        c7: int64 <- read_buf(graph.present, 7);
        c8: int64 <- read_buf(graph.present, 8);
        b0: int64 <- case c0 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b1: int64 <- case c1 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b2: int64 <- case c2 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b3: int64 <- case c3 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b4: int64 <- case c4 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b5: int64 <- case c5 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b6: int64 <- case c6 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b7: int64 <- case c7 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b8: int64 <- case c8 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        bad_count: int64 <- b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8;
        count: int64 <- c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8;
        valid: int64 <- case bad_count of {
            0 -> int64_validate_edge_count(graph.edge_count, count);
            _: int64 -> 0
        }
    produces
        pure valid
    end
}

fn int64_validate_edge_count(edge_count: int64, count: int64) -> int64 {
    case edge_count - count of {
        0 -> 1;
        _: int64 -> 0
    }
}
