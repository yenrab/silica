// DenseMatrixGraphDirected[mem(normal)] and [int64, mem(normal)] (graph_representation_design.md §2.11).
// Bootstrap capacity: 3 nodes, 9 matrix cells.

use graph_adj_list_helpers;

export empty[mem(normal)]/1;
export node_count[mem(normal)]/1;
export edge_count[mem(normal)]/1;
export set_edge[mem(normal)]/3;
export set_edge_checked[mem(normal)]/3;
export has_edge[mem(normal)]/3;
export neighbor_at[mem(normal)]/3;
export out_degree[mem(normal)]/2;
export validate[mem(normal)]/1;

export empty[int64, mem(normal)]/1;
export node_count[int64, mem(normal)]/1;
export edge_count[int64, mem(normal)]/1;
export set_edge[int64, mem(normal)]/4;
export set_edge_checked[int64, mem(normal)]/4;
export has_edge[int64, mem(normal)]/3;
export neighbor_at[int64, mem(normal)]/3;
export weight_at[int64, mem(normal)]/3;
export weight_at_checked[int64, mem(normal)]/3;
export out_degree[int64, mem(normal)]/2;
export validate[int64, mem(normal)]/1;

fn empty[mem(normal)](initial_node_count: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        cells: buf(L1, normal, int64, 9) <- alloc_buf(r, 9);
        _: atom <- write_buf(cells, 0, 0);
        _: atom <- write_buf(cells, 1, 0);
        _: atom <- write_buf(cells, 2, 0);
        _: atom <- write_buf(cells, 3, 0);
        _: atom <- write_buf(cells, 4, 0);
        _: atom <- write_buf(cells, 5, 0);
        _: atom <- write_buf(cells, 6, 0);
        _: atom <- write_buf(cells, 7, 0);
        _: atom <- write_buf(cells, 8, 0);
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- {
            region: r,
            node_count: initial_node_count,
            edge_count: 0,
            cells: cells
        }
    produces
        pure graph
    end
}

fn node_count[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}) -> int64 {
    graph.node_count
}

fn edge_count[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}) -> int64 {
    graph.edge_count
}

fn cell_index(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> int64 {
    from_id * graph.node_count + to_id
}

fn set_edge[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
} {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    safe_from: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> from_saved;
        _: int64 -> 0
    };
    safe_to: int64 <- case endpoints_ok of {
        0 -> 0;
        1 -> to_saved;
        _: int64 -> 0
    };
    cell: int64 <- cell_index(graph, safe_from, safe_to);
    sequence proc[mem(normal)]
        previous: int64 <- case cell of {
            0 -> read_buf(graph.cells, 0);
            1 -> read_buf(graph.cells, 1);
            2 -> read_buf(graph.cells, 2);
            3 -> read_buf(graph.cells, 3);
            4 -> read_buf(graph.cells, 4);
            5 -> read_buf(graph.cells, 5);
            6 -> read_buf(graph.cells, 6);
            7 -> read_buf(graph.cells, 7);
            8 -> read_buf(graph.cells, 8);
            _: int64 -> 0
        };
        _: atom <- case endpoints_ok of {
            0 -> 0;
            1 -> case cell of {
                0 -> write_buf(graph.cells, 0, 1);
                1 -> write_buf(graph.cells, 1, 1);
                2 -> write_buf(graph.cells, 2, 1);
                3 -> write_buf(graph.cells, 3, 1);
                4 -> write_buf(graph.cells, 4, 1);
                5 -> write_buf(graph.cells, 5, 1);
                6 -> write_buf(graph.cells, 6, 1);
                7 -> write_buf(graph.cells, 7, 1);
                8 -> write_buf(graph.cells, 8, 1);
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        next_edge_count: int64 <- case endpoints_ok of {
            0 -> graph.edge_count;
            1 -> case previous of {
                0 -> graph.edge_count + 1;
                _: int64 -> graph.edge_count
            };
            _: int64 -> graph.edge_count
        };
        updated: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- {
            region: graph.region,
            node_count: graph.node_count,
            edge_count: next_edge_count,
            cells: graph.cells
        }
    produces
        pure updated
    end
}

fn set_edge_checked[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> { ok: int64, graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
} } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(from_saved, graph.node_count);
    to_ok: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(to_saved, graph.node_count);
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    sequence
        updated_graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } <- set_edge[mem(normal)](graph, from_saved, to_saved);
        out: { ok: int64, graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            cells: buf(L1, normal, int64, 9)
        } } <- {
            ok: endpoints_ok,
            graph: updated_graph
        }
    produces
        pure out
    end
}

fn has_edge[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    to_ok: int64 <- case to_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    dim_ok: int64 <- case graph.node_count - 3 of {
        0 -> 1;
        _: int64 -> 0
    };
    cell: int64 <- cell_index(graph, from_saved, to_saved);
    sequence proc[mem(normal)]
        value: int64 <- case cell of {
            0 -> read_buf(graph.cells, 0);
            1 -> read_buf(graph.cells, 1);
            2 -> read_buf(graph.cells, 2);
            3 -> read_buf(graph.cells, 3);
            4 -> read_buf(graph.cells, 4);
            5 -> read_buf(graph.cells, 5);
            6 -> read_buf(graph.cells, 6);
            7 -> read_buf(graph.cells, 7);
            8 -> read_buf(graph.cells, 8);
            _: int64 -> 0
        };
        result: int64 <- endpoints_ok * dim_ok * value
    produces
        pure result
    end
}

fn out_degree[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}, from_id: int64) -> int64 {
    from_saved: int64 <- from_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    dim_ok: int64 <- case graph.node_count - 3 of {
        0 -> 1;
        _: int64 -> 0
    };
    sequence proc[mem(normal)]
        c00: int64 <- read_buf(graph.cells, 0);
        c01: int64 <- read_buf(graph.cells, 1);
        c02: int64 <- read_buf(graph.cells, 2);
        c10: int64 <- read_buf(graph.cells, 3);
        c11: int64 <- read_buf(graph.cells, 4);
        c12: int64 <- read_buf(graph.cells, 5);
        c20: int64 <- read_buf(graph.cells, 6);
        c21: int64 <- read_buf(graph.cells, 7);
        c22: int64 <- read_buf(graph.cells, 8);
        from_is_0: int64 <- case from_saved of {
            0 -> 1;
            _: int64 -> 0
        };
        from_is_1: int64 <- case from_saved of {
            1 -> 1;
            _: int64 -> 0
        };
        from_is_2: int64 <- case from_saved of {
            2 -> 1;
            _: int64 -> 0
        };
        row0_degree: int64 <- c00 + c01 + c02;
        row1_degree: int64 <- c10 + c11 + c12;
        row2_degree: int64 <- c20 + c21 + c22;
        degree: int64 <-
            (row0_degree * from_is_0) +
            (row1_degree * from_is_1) +
            (row2_degree * from_is_2);
        result: int64 <- from_ok * dim_ok * degree
    produces
        pure result
    end
}

fn neighbor_pick_from_row(
    c0: int64,
    c1: int64,
    c2: int64,
    local_index: int64
) -> int64 {
    not_c0: int64 <- 1 - c0;
    not_c1: int64 <- 1 - c1;
    not_c2: int64 <- 1 - c2;
    no_neighbor: int64 <- not_c0 * not_c1 * not_c2;
    first: int64 <- (c1 * not_c0) + (c2 * not_c0 * not_c1 * 2) + (no_neighbor * -1);
    second01: int64 <- c0 * c1;
    second02: int64 <- c0 * not_c1 * c2;
    second12: int64 <- not_c0 * c1 * c2;
    has_second: int64 <- second01 + second02 + second12;
    second_value: int64 <- second01 + (second02 * 2) + (second12 * 2);
    second: int64 <- second_value + ((1 - has_second) * -1);
    case local_index of {
        0 -> first;
        1 -> second;
        _: int64 -> -1
    }
}

fn neighbor_at_row0[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}, local_index: int64) -> int64 {
    local_saved: int64 <- local_index;
    sequence proc[mem(normal)]
        r00: int64 <- read_buf(graph.cells, 0);
        r01: int64 <- read_buf(graph.cells, 1);
        r02: int64 <- read_buf(graph.cells, 2);
        picked: int64 <- neighbor_pick_from_row(r00, r01, r02, local_saved)
    produces
        pure picked
    end
}

fn neighbor_at_row1[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}, local_index: int64) -> int64 {
    local_saved: int64 <- local_index;
    sequence proc[mem(normal)]
        r10: int64 <- read_buf(graph.cells, 3);
        r11: int64 <- read_buf(graph.cells, 4);
        r12: int64 <- read_buf(graph.cells, 5);
        picked: int64 <- neighbor_pick_from_row(r10, r11, r12, local_saved)
    produces
        pure picked
    end
}

fn neighbor_at_row2[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}, local_index: int64) -> int64 {
    local_saved: int64 <- local_index;
    sequence proc[mem(normal)]
        r20: int64 <- read_buf(graph.cells, 6);
        r21: int64 <- read_buf(graph.cells, 7);
        r22: int64 <- read_buf(graph.cells, 8);
        picked: int64 <- neighbor_pick_from_row(r20, r21, r22, local_saved)
    produces
        pure picked
    end
}

fn neighbor_at[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}, from_id: int64, local_index: int64) -> int64 {
    from_saved: int64 <- from_id;
    local_saved: int64 <- local_index;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    dim_ok: int64 <- case graph.node_count - 3 of {
        0 -> 1;
        _: int64 -> 0
    };
    picked: int64 <- case from_saved of {
        0 -> neighbor_at_row0[mem(normal)](graph, local_saved);
        1 -> neighbor_at_row1[mem(normal)](graph, local_saved);
        2 -> neighbor_at_row2[mem(normal)](graph, local_saved);
        _: int64 -> -1
    };
    result: int64 <- case from_ok of {
        0 -> -1;
        1 -> case dim_ok of {
            0 -> -1;
            1 -> picked;
            _: int64 -> -1
        };
        _: int64 -> -1
    };
    result
}

fn cell_ok(value: int64) -> int64 {
    case value of {
        0 -> 1;
        1 -> 1;
        _: int64 -> 0
    }
}

fn validate[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}) -> int64 {
    case graph.node_count - 3 of {
        0 -> validate_cells(graph);
        _: int64 -> 0
    }
}

fn validate_cells(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    cells: buf(L1, normal, int64, 9)
}) -> int64 {
    sequence proc[mem(normal)]
        c0: int64 <- read_buf(graph.cells, 0);
        c1: int64 <- read_buf(graph.cells, 1);
        c2: int64 <- read_buf(graph.cells, 2);
        c3: int64 <- read_buf(graph.cells, 3);
        c4: int64 <- read_buf(graph.cells, 4);
        c5: int64 <- read_buf(graph.cells, 5);
        c6: int64 <- read_buf(graph.cells, 6);
        c7: int64 <- read_buf(graph.cells, 7);
        c8: int64 <- read_buf(graph.cells, 8);
        b0: int64 <- case c0 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b1: int64 <- case c1 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b2: int64 <- case c2 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b3: int64 <- case c3 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b4: int64 <- case c4 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b5: int64 <- case c5 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b6: int64 <- case c6 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b7: int64 <- case c7 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        b8: int64 <- case c8 of { 0 -> 0; 1 -> 0; _: int64 -> 1 };
        bad_count: int64 <- b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8;
        count: int64 <- c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8;
        valid: int64 <- case bad_count of {
            0 -> validate_edge_count(graph.edge_count, count);
            _: int64 -> 0
        }
    produces
        pure valid
    end
}

fn validate_edge_count(edge_count: int64, count: int64) -> int64 {
    case edge_count - count of {
        0 -> 1;
        _: int64 -> 0
    }
}

fn empty[int64, mem(normal)](initial_node_count: int64) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        present: buf(L1, normal, int64, 9) <- alloc_buf(r, 9);
        weights: buf(L1, normal, int64, 9) <- alloc_buf(r, 9);
        _: atom <- write_buf(present, 0, 0);
        _: atom <- write_buf(present, 1, 0);
        _: atom <- write_buf(present, 2, 0);
        _: atom <- write_buf(present, 3, 0);
        _: atom <- write_buf(present, 4, 0);
        _: atom <- write_buf(present, 5, 0);
        _: atom <- write_buf(present, 6, 0);
        _: atom <- write_buf(present, 7, 0);
        _: atom <- write_buf(present, 8, 0);
        _: atom <- write_buf(weights, 0, 0);
        _: atom <- write_buf(weights, 1, 0);
        _: atom <- write_buf(weights, 2, 0);
        _: atom <- write_buf(weights, 3, 0);
        _: atom <- write_buf(weights, 4, 0);
        _: atom <- write_buf(weights, 5, 0);
        _: atom <- write_buf(weights, 6, 0);
        _: atom <- write_buf(weights, 7, 0);
        _: atom <- write_buf(weights, 8, 0);
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            present: buf(L1, normal, int64, 9),
            weights: buf(L1, normal, int64, 9)
        } <- {
            region: r,
            node_count: initial_node_count,
            edge_count: 0,
            present: present,
            weights: weights
        }
    produces
        pure graph
    end
}

fn node_count[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}) -> int64 {
    graph.node_count
}

fn edge_count[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}) -> int64 {
    graph.edge_count
}

fn int64_index(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    present: buf(L1, normal, int64, 9),
    weights: buf(L1, normal, int64, 9)
}, from_id: int64, to_id: int64) -> int64 {
    from_id * graph.node_count + to_id
}

fn write_int64_matrix_cell_0(
    graph: {
        region: region(L1, normal),
        node_count: int64,
        edge_count: int64,
        present: buf(L1, normal, int64, 9),
        weights: buf(L1, normal, int64, 9)
    },
    present_value: int64,
    weight_value: int64
) -> atom {
    sequence proc[mem(normal)]
        _: atom <- write_buf(graph.present, 0, present_value);
        _: atom <- write_buf(graph.weights, 0, weight_value);
        done: atom <- 0
    produces
        pure done
    end
}

