fn write_int64_matrix_cell_7(
    graph: {
        region: region(L1, normal),
        node_count: int64,
        edge_count: int64,
        present: buf(L1, normal, int64, 9),
        weights: buf(L1, normal, int64, 9)
    },
    present_value: int64,
    weight_value: int64
) -> atom {
    sequence proc[mem(normal)]
        _: atom <- write_buf(graph.present, 7, present_value);
        _: atom <- write_buf(graph.weights, 7, weight_value);
        done: atom <- 0
    produces
        pure done
    end
}

fn write_int64_matrix_cell_8(
    graph: {
        region: region(L1, normal),
