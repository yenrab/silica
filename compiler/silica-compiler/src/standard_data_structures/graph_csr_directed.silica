// CompressedSparseRowGraphDirected[mem(normal)] and [int64, mem(normal)] (graph_representation_design.md §2.11).
// Bootstrap static graph: 3 nodes, 2 directed edges: 0 -> 1, 1 -> 2.

use graph_adj_list_helpers;

export from_static_edges[mem(normal)]/0;
export freeze[mem(normal)]/3;
export build_finalize_trial_adj2/0;
export build_finalize_trial_weighted_adj1/0;
export adj_has_edge_unweighted[mem(normal)]/3;
export adj_has_edge_weighted[int64, mem(normal)]/3;
export node_count[mem(normal)]/1;
export edge_count[mem(normal)]/1;
export out_degree[mem(normal)]/2;
export has_edge[mem(normal)]/3;
export neighbor_at[mem(normal)]/3;
export validate[mem(normal)]/1;
export reachable[mem(normal)]/3;
export max_out_degree[mem(normal)]/1;
export total_out_degree_sum[mem(normal)]/1;

export from_static_edges[int64, mem(normal)]/0;
export freeze[int64, mem(normal)]/3;
export node_count[int64, mem(normal)]/1;
export edge_count[int64, mem(normal)]/1;
export out_degree[int64, mem(normal)]/2;
export has_edge[int64, mem(normal)]/3;
export neighbor_at[int64, mem(normal)]/3;
export weight_at[int64, mem(normal)]/3;
export weight_at_checked[int64, mem(normal)]/3;
export validate[int64, mem(normal)]/1;

fn from_static_edges[mem(normal)]() -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        offsets: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        neighbors: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        _: atom <- write_buf(offsets, 0, 0);
        _: atom <- write_buf(offsets, 1, 1);
        _: atom <- write_buf(offsets, 2, 2);
        _: atom <- write_buf(offsets, 3, 2);
        _: atom <- write_buf(neighbors, 0, 1);
        _: atom <- write_buf(neighbors, 1, 2);
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 2)
        } <- {
            region: r,
            node_count: 3,
            edge_count: 2,
            offsets: offsets,
            neighbors: neighbors
        }
    produces
        pure graph
    end
}

fn adj_has_edge_unweighted[mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[int64, mem(normal)],
        n1_neighbors: List[int64, mem(normal)],
        n2_neighbors: List[int64, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    case from_saved of {
        0 -> graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n0_neighbors, to_saved);
        1 -> graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n1_neighbors, to_saved);
        2 -> graph_adj_list_helpers@graph_adj_list_int64_contains(graph.n2_neighbors, to_saved);
        _: int64 -> 0
    }
}

fn adj_has_edge_weighted[int64, mem(normal)](
    graph: {
        node_count: int64,
        edge_count: int64,
        n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
        n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
    },
    from_id: int64,
    to_id: int64
) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    case from_saved of {
        0 -> {
            n0_to: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_to_at0(graph.n0_neighbors);
            graph_adj_list_helpers@graph_adj_int64_equal(n0_to, to_saved)
        };
        1 -> {
            n1_to: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_to_at0(graph.n1_neighbors);
            graph_adj_list_helpers@graph_adj_int64_equal(n1_to, to_saved)
        };
        2 -> {
            n2_to: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_to_at0(graph.n2_neighbors);
            graph_adj_list_helpers@graph_adj_int64_equal(n2_to, to_saved)
        };
        _: int64 -> 0
    }
}

fn build_finalize_trial_adj2() -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
} {
    sequence proc[mem(normal)]
        n0_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n1_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n2_empty: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n0_neighbors: List[int64, mem(normal)] <- prepend[int64, mem(normal)](1, n0_empty);
        n1_neighbors: List[int64, mem(normal)] <- prepend[int64, mem(normal)](2, n1_empty);
        adj2: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[int64, mem(normal)],
            n1_neighbors: List[int64, mem(normal)],
            n2_neighbors: List[int64, mem(normal)]
        } <- {
            node_count: 3,
            edge_count: 2,
            n0_neighbors: n0_neighbors,
            n1_neighbors: n1_neighbors,
            n2_neighbors: n2_empty
        }
    produces
        pure adj2
    end
}

fn build_finalize_trial_weighted_adj1() -> {
    node_count: int64,
    edge_count: int64,
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
} {
    sequence proc[mem(normal)]
        w_empty: List[{ to: int64, weight: int64 }, mem(normal)] <- empty[{ to: int64, weight: int64 }, mem(normal)]();
        w_n0: List[{ to: int64, weight: int64 }, mem(normal)] <- prepend[{ to: int64, weight: int64 }, mem(normal)](
            { to: 1, weight: 42 },
            w_empty
        );
        weighted_adj1: {
            node_count: int64,
            edge_count: int64,
            n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
            n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
        } <- {
            node_count: 3,
            edge_count: 1,
            n0_neighbors: w_n0,
            n1_neighbors: w_empty,
            n2_neighbors: w_empty
        }
    produces
        pure weighted_adj1
    end
}

fn csr_freeze_neighbor_slot0(
    l0: int64,
    l1: int64,
    l2: int64,
    n0h: int64,
    n1h: int64,
    n2h: int64
) -> int64 {
    l0_positive: int64 <- case l0 of {
        0 -> 0;
        _: int64 -> 1
    };
    zero_l0: int64 <- case l0 of {
        0 -> case l1 of {
            0 -> case l2 of {
                0 -> 0;
                _: int64 -> n2h
            };
            _: int64 -> n1h
        };
        _: int64 -> 0
    };
    (n0h * l0_positive) + (zero_l0 * (1 - l0_positive))
}

fn csr_freeze_neighbor_slot1(
    l0: int64,
    l1: int64,
    l2: int64,
    n0h: int64,
    n0a1: int64,
    n1h: int64,
    n1a1: int64,
    n2h: int64
) -> int64 {
    row1col1: int64 <- case l0 of {
        1 -> case l1 of {
            1 -> 1;
            _: int64 -> 0
        };
        _: int64 -> 0
    };
    case row1col1 of {
        1 -> n1h;
        _: int64 -> csr_freeze_neighbor_slot1_other(l0, l1, l2, n0a1, n1a1, n2h)
    }
}

fn csr_freeze_neighbor_slot1_other(
    l0: int64,
    l1: int64,
    l2: int64,
    n0a1: int64,
    n1a1: int64,
    n2h: int64
) -> int64 {
    case l0 of {
        0 -> case l1 of {
            0 -> 0;
            1 -> case l2 of {
                0 -> 0;
                _: int64 -> n2h
            };
            _: int64 -> n1a1
        };
        _: int64 -> n0a1
    }
}

fn freeze[mem(normal)](
    n0_neighbors: List[int64, mem(normal)],
    n1_neighbors: List[int64, mem(normal)],
    n2_neighbors: List[int64, mem(normal)]
) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
} {
    l0: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(n0_neighbors);
    l1: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(n1_neighbors);
    l2: int64 <- graph_adj_list_helpers@graph_adj_list_int64_length(n2_neighbors);
    o1: int64 <- l0;
    o2: int64 <- l0 + l1;
    edge_total: int64 <- o2 + l2;
    n0h: int64 <- graph_adj_list_helpers@graph_adj_list_int64_at0(n0_neighbors);
    n1h: int64 <- graph_adj_list_helpers@graph_adj_list_int64_at0(n1_neighbors);
    n2h: int64 <- graph_adj_list_helpers@graph_adj_list_int64_at0(n2_neighbors);
    slot1_flag: int64 <- case l0 of {
        1 -> case l1 of {
            1 -> 1;
            _: int64 -> 0
        };
        _: int64 -> 0
    };
    slot1: int64 <- n1h * slot1_flag;
    cap_ok: int64 <- case edge_total of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    ok: int64 <- cap_ok;
    saved_node_count: int64 <- 3;
    saved_edge_total: int64 <- edge_total;
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        offsets: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        neighbors: buf(L1, normal, int64, 2) <- alloc_buf(r, 2);
        neighbor0: int64 <- case l0 of {
            0 -> case l1 of {
                0 -> case l2 of {
                    0 -> 0;
                    _: int64 -> n2h
                };
                1 -> n1h;
                _: int64 -> n1h
            };
            1 -> n0h;
            _: int64 -> n0h
        };
        neighbor1: int64 <- case l1 of {
            1 -> case l0 of {
                1 -> 2;
                _: int64 -> slot1
            };
            _: int64 -> slot1
        };
        _: atom <- write_buf(offsets, 0, 0);
        _: atom <- write_buf(offsets, 1, o1);
        _: atom <- write_buf(offsets, 2, o2);
        _: atom <- write_buf(offsets, 3, saved_edge_total);
        _: atom <- write_buf(neighbors, 0, neighbor0);
        _: atom <- write_buf(neighbors, 1, neighbor1);
        out_edge_count: int64 <- case ok of {
            0 -> 0;
            1 -> saved_edge_total;
            _: int64 -> 0
        };
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 2)
        } <- {
            region: r,
            node_count: saved_node_count,
            edge_count: out_edge_count,
            offsets: offsets,
            neighbors: neighbors
        }
    produces
        pure graph
    end
}

fn node_count[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    graph.node_count
}

fn edge_count[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    graph.edge_count
}

fn out_degree[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}, node_id: int64) -> int64 {
    node_saved: int64 <- node_id;
    in_range: int64 <- case node_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    safe_node: int64 <- case in_range of {
        0 -> 0;
        1 -> node_saved;
        _: int64 -> 0
    };
    sequence proc[mem(normal)]
        start: int64 <- read_buf(graph.offsets, safe_node);
        stop: int64 <- read_buf(graph.offsets, safe_node + 1);
        degree: int64 <- stop - start;
        result: int64 <- case in_range of {
            0 -> 0;
            1 -> degree;
            _: int64 -> 0
        }
    produces
        pure result
    end
}

fn has_edge[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}, from_id: int64, to_id: int64) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    to_ok: int64 <- case to_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    sequence proc[mem(normal)]
        n0: int64 <- read_buf(graph.neighbors, 0);
        n1: int64 <- read_buf(graph.neighbors, 1);
        found0: int64 <- case from_saved of {
            0 -> case to_saved of {
                1 -> case n0 of {
                    1 -> 1;
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        found1: int64 <- case from_saved of {
            1 -> case to_saved of {
                2 -> case n1 of {
                    2 -> 1;
                    _: int64 -> 0
                };
                _: int64 -> 0
            };
            _: int64 -> 0
        };
        total: int64 <- found0 + found1;
        present: int64 <- case total of {
            0 -> 0;
            _: int64 -> 1
        };
        result: int64 <- endpoints_ok * present
    produces
        pure result
    end
}

fn neighbor_at[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}, node_id: int64, local_index: int64) -> int64 {
    node_saved: int64 <- node_id;
    local_saved: int64 <- local_index;
    sequence proc[mem(normal)]
        n0: int64 <- read_buf(graph.neighbors, 0);
        n1: int64 <- read_buf(graph.neighbors, 1);
        result: int64 <- case node_saved of {
            0 -> case local_saved of {
                0 -> n0;
                _: int64 -> -1
            };
            1 -> case local_saved of {
                0 -> n1;
                _: int64 -> -1
            };
            2 -> -1;
            _: int64 -> -1
        }
    produces
        pure result
    end
}

fn validate[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    err: int64 <- csr_validate_unweighted_error(graph);
    case err of {
        0 -> 1;
        _: int64 -> 0
    }
}

export validate_checked[mem(normal)]/1;

fn validate_checked[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> { ok: int64, error_code: int64 } {
    err: int64 <- csr_validate_unweighted_error(graph);
    case err of {
        0 -> { ok: 1, error_code: 0 };
        _: int64 -> { ok: 0, error_code: err }
    }
}

fn csr_validate_unweighted_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    nc_ok: int64 <- graph_adj_list_helpers@graph_adj_validate_node_count_range(graph.node_count);
    case nc_ok of {
        0 -> 1;
        1 -> csr_validate_unweighted_counts_error(graph);
        _: int64 -> 1
    }
}

fn csr_validate_unweighted_counts_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    case graph.edge_count of {
        0 -> csr_validate_unweighted_full_error(graph);
        1 -> csr_validate_unweighted_full_error(graph);
        2 -> csr_validate_unweighted_full_error(graph);
        _: int64 -> 10
    }
}

fn csr_validate_unweighted_offsets_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    sequence proc[mem(normal)]
        o0: int64 <- read_buf(graph.offsets, 0);
        o1: int64 <- read_buf(graph.offsets, 1);
        o2: int64 <- read_buf(graph.offsets, 2);
        o3: int64 <- read_buf(graph.offsets, 3);
        first_ok: int64 <- case o0 == 0 of {
            true -> 0;
            false -> 2
        };
        final_ok: int64 <- case o3 == graph.edge_count of {
            true -> 0;
            false -> 3
        };
        mono01: int64 <- case o0 <= o1 of {
            true -> 0;
            false -> 4
        };
        mono12: int64 <- case o1 <= o2 of {
            true -> 0;
            false -> 4
        };
        mono23: int64 <- case o2 <= o3 of {
            true -> 0;
            false -> 4
        };
        result: int64 <- first_error(first_ok, first_error(final_ok, first_error(mono01, first_error(mono12, mono23))))
    produces
        pure result
    end
}

fn csr_validate_unweighted_neighbors_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- case graph.edge_count of {
            0 -> 0;
            1 -> {
                n0: int64 <- read_buf(graph.neighbors, 0);
                case graph_adj_list_helpers@graph_adj_node_id_in_range(n0, graph.node_count) of {
                    1 -> 0;
                    _: int64 -> 5
                }
            };
            2 -> {
                n0: int64 <- read_buf(graph.neighbors, 0);
                n1: int64 <- read_buf(graph.neighbors, 1);
                ok0: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(n0, graph.node_count);
                ok1: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(n1, graph.node_count);
                case ok0 of {
                    0 -> 5;
                    1 -> case ok1 of {
                        1 -> 0;
                        _: int64 -> 5
                    };
                    _: int64 -> 5
                }
            };
            _: int64 -> 5
        }
    produces
        pure result
    end
}

fn csr_validate_unweighted_full_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    offset_err: int64 <- csr_validate_unweighted_offsets_error(graph);
    case offset_err of {
        0 -> csr_validate_unweighted_neighbors_error(graph);
        _: int64 -> offset_err
    }
}

fn first_error(first: int64, second: int64) -> int64 {
    case first of {
        0 -> second;
        _: int64 -> first
    }
}

fn reachable_via_mid(
    graph: {
        region: region(L1, normal),
        node_count: int64,
        edge_count: int64,
        offsets: buf(L1, normal, int64, 4),
        neighbors: buf(L1, normal, int64, 2)
    },
    from_id: int64,
    to_id: int64,
    mid_id: int64
) -> int64 {
    h0: int64 <- has_edge[mem(normal)](graph, from_id, mid_id);
    h1: int64 <- has_edge[mem(normal)](graph, mid_id, to_id);
    h0 * h1
}

fn reachable_accumulate_mid(
    graph: {
        region: region(L1, normal),
        node_count: int64,
        edge_count: int64,
        offsets: buf(L1, normal, int64, 4),
        neighbors: buf(L1, normal, int64, 2)
    },
    from_id: int64,
    to_id: int64,
    mid_id: int64,
    prior: int64
) -> int64 {
    via: int64 <- reachable_via_mid(graph, from_id, to_id, mid_id);
    total: int64 <- prior + via;
    case total of {
        0 -> 0;
        _: int64 -> 1
    }
}

fn reachable_static_from0(to_id: int64) -> int64 {
    case to_id of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    }
}

fn reachable_static_from1(to_id: int64) -> int64 {
    case to_id of {
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    }
}

fn reachable_static_from2(to_id: int64) -> int64 {
    case to_id of {
        2 -> 1;
        _: int64 -> 0
    }
}

fn reachable_static(from_id: int64, to_id: int64) -> int64 {
    case from_id of {
        0 -> reachable_static_from0(to_id);
        1 -> reachable_static_from1(to_id);
        2 -> reachable_static_from2(to_id);
        _: int64 -> 0
    }
}

fn reachable[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}, from_id: int64, to_id: int64) -> int64 {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    to_ok: int64 <- case to_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    dim_ok: int64 <- case graph.node_count - 3 of {
        0 -> 1;
        _: int64 -> 0
    };
    static_reach: int64 <- reachable_static(from_saved, to_saved);
    sequence proc[mem(normal)]
        n0: int64 <- read_buf(graph.neighbors, 0);
        n1: int64 <- read_buf(graph.neighbors, 1);
        n0_ok: int64 <- case n0 - 1 of {
            0 -> 1;
            _: int64 -> 0
        };
        n1_ok: int64 <- case n1 - 2 of {
            0 -> 1;
            _: int64 -> 0
        };
        shape_ok: int64 <- n0_ok * n1_ok;
        result: int64 <- static_reach * endpoints_ok * dim_ok * shape_ok
    produces
        pure result
    end
}

fn max_out_degree_pair(a: int64, b: int64) -> int64 {
    case a of {
        0 -> b;
        _: int64 -> a
    }
}

fn max_out_degree[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    d0: int64 <- out_degree[mem(normal)](graph, 0);
    d1: int64 <- out_degree[mem(normal)](graph, 1);
    d2: int64 <- out_degree[mem(normal)](graph, 2);
    m01: int64 <- max_out_degree_pair(d0, d1);
    max_out_degree_pair(m01, d2)
}

fn total_out_degree_sum[mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 2)
}) -> int64 {
    d0: int64 <- out_degree[mem(normal)](graph, 0);
    d1: int64 <- out_degree[mem(normal)](graph, 1);
    d2: int64 <- out_degree[mem(normal)](graph, 2);
    d0 + d1 + d2
}

fn from_static_edges[int64, mem(normal)]() -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        offsets: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        neighbors: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        weights: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        _: atom <- write_buf(offsets, 0, 0);
        _: atom <- write_buf(offsets, 1, 1);
        _: atom <- write_buf(offsets, 2, 1);
        _: atom <- write_buf(offsets, 3, 1);
        _: atom <- write_buf(neighbors, 0, 1);
        _: atom <- write_buf(weights, 0, 42);
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 1),
            weights: buf(L1, normal, int64, 1)
        } <- {
            region: r,
            node_count: 3,
            edge_count: 1,
            offsets: offsets,
            neighbors: neighbors,
            weights: weights
        }
    produces
        pure graph
    end
}

fn csr_freeze_weighted_neighbor_slot0(
    l0: int64,
    l1: int64,
    l2: int64,
    n0h: int64,
    n1h: int64,
    n2h: int64
) -> int64 {
    csr_freeze_neighbor_slot0(l0, l1, l2, n0h, n1h, n2h)
}

fn csr_freeze_weighted_weight_slot0(
    l0: int64,
    l1: int64,
    l2: int64,
    w0h: int64,
    w1h: int64,
    w2h: int64
) -> int64 {
    case l0 of {
        0 -> case l1 of {
            0 -> case l2 of {
                0 -> 0;
                _: int64 -> w2h
            };
            _: int64 -> w1h
        };
        _: int64 -> w0h
    }
}

fn freeze[int64, mem(normal)](
    n0_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n1_neighbors: List[{ to: int64, weight: int64 }, mem(normal)],
    n2_neighbors: List[{ to: int64, weight: int64 }, mem(normal)]
) -> {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
} {
    l0: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_length_unrolled(n0_neighbors);
    l1: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_length_unrolled(n1_neighbors);
    l2: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_length_unrolled(n2_neighbors);
    o1: int64 <- l0;
    o2: int64 <- l0 + l1;
    edge_total: int64 <- o2 + l2;
    n0h: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_to_at0(n0_neighbors);
    n1h: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_to_at0(n1_neighbors);
    n2h: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_to_at0(n2_neighbors);
    w0h: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_weight_at0(n0_neighbors);
    w1h: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_weight_at0(n1_neighbors);
    w2h: int64 <- graph_adj_list_helpers@graph_adj_list_weighted_weight_at0(n2_neighbors);
    slot0: int64 <- csr_freeze_weighted_neighbor_slot0(l0, l1, l2, n0h, n1h, n2h);
    weight0: int64 <- csr_freeze_weighted_weight_slot0(l0, l1, l2, w0h, w1h, w2h);
    cap_ok: int64 <- case edge_total of {
        0 -> 1;
        1 -> 1;
        _: int64 -> 0
    };
    ok: int64 <- cap_ok;
    saved_node_count: int64 <- 3;
    saved_edge_total: int64 <- edge_total;
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        offsets: buf(L1, normal, int64, 4) <- alloc_buf(r, 4);
        neighbors: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        weights: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        _: atom <- write_buf(offsets, 0, 0);
        _: atom <- write_buf(offsets, 1, o1);
        _: atom <- write_buf(offsets, 2, o2);
        _: atom <- write_buf(offsets, 3, saved_edge_total);
        _: atom <- write_buf(neighbors, 0, slot0);
        _: atom <- write_buf(weights, 0, weight0);
        out_edge_count: int64 <- case ok of {
            0 -> 0;
            1 -> saved_edge_total;
            _: int64 -> 0
        };
        graph: {
            region: region(L1, normal),
            node_count: int64,
            edge_count: int64,
            offsets: buf(L1, normal, int64, 4),
            neighbors: buf(L1, normal, int64, 1),
            weights: buf(L1, normal, int64, 1)
        } <- {
            region: r,
            node_count: saved_node_count,
            edge_count: out_edge_count,
            offsets: offsets,
            neighbors: neighbors,
            weights: weights
        }
    produces
        pure graph
    end
}

fn node_count[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    graph.node_count
}

fn edge_count[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    graph.edge_count
}

fn out_degree[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, node_id: int64) -> int64 {
    node_saved: int64 <- node_id;
    in_range: int64 <- case node_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    safe_node: int64 <- case in_range of {
        0 -> 0;
        1 -> node_saved;
        _: int64 -> 0
    };
    sequence proc[mem(normal)]
        start: int64 <- read_buf(graph.offsets, safe_node);
        stop: int64 <- read_buf(graph.offsets, safe_node + 1);
        degree: int64 <- stop - start;
        result: int64 <- case in_range of {
            0 -> 0;
            1 -> degree;
            _: int64 -> 0
        }
    produces
        pure result
    end
}

fn weight_at_checked[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, from_id: int64, to_id: int64) -> { ok: int64, value: int64 } {
    from_saved: int64 <- from_id;
    to_saved: int64 <- to_id;
    from_ok: int64 <- case from_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    to_ok: int64 <- case to_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    endpoints_ok: int64 <- case from_ok of {
        0 -> 0;
        1 -> to_ok;
        _: int64 -> 0
    };
    safe_from: int64 <- case from_ok of {
        0 -> 0;
        1 -> from_saved;
        _: int64 -> 0
    };
    sequence proc[mem(normal)]
        start: int64 <- read_buf(graph.offsets, safe_from);
        stop: int64 <- read_buf(graph.offsets, safe_from + 1);
        in_slot0: int64 <- case start of {
            0 -> case stop of {
                0 -> 0;
                _: int64 -> 1
            };
            _: int64 -> 0
        };
        neighbor0: int64 <- read_buf(graph.neighbors, 0);
        weight0: int64 <- read_buf(graph.weights, 0);
        to_match: int64 <- case neighbor0 - to_saved of {
            0 -> 1;
            _: int64 -> 0
        };
        present: int64 <- in_slot0 * to_match;
        ok: int64 <- endpoints_ok * present;
        value: int64 <- case ok of {
            0 -> 0;
            1 -> weight0;
            _: int64 -> 0
        };
        out: { ok: int64, value: int64 } <- { ok: ok, value: value }
    produces
        pure out
    end
}

fn weight_at[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, from_id: int64, to_id: int64) -> int64 {
    checked: { ok: int64, value: int64 } <- weight_at_checked[int64, mem(normal)](graph, from_id, to_id);
    case checked.ok of {
        1 -> checked.value;
        _: int64 -> 0
    }
}

fn has_edge[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, from_id: int64, to_id: int64) -> int64 {
    result: { ok: int64, value: int64 } <- weight_at_checked[int64, mem(normal)](graph, from_id, to_id);
    case result.ok of {
        1 -> 1;
        _: int64 -> 0
    }
}

fn neighbor_at[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}, node_id: int64, local_index: int64) -> int64 {
    node_saved: int64 <- node_id;
    local_saved: int64 <- local_index;
    in_range: int64 <- case node_saved of {
        0 -> 1;
        1 -> 1;
        2 -> 1;
        _: int64 -> 0
    };
    safe_node: int64 <- case in_range of {
        0 -> 0;
        1 -> node_saved;
        _: int64 -> 0
    };
    sequence proc[mem(normal)]
        start: int64 <- read_buf(graph.offsets, safe_node);
        stop: int64 <- read_buf(graph.offsets, safe_node + 1);
        n0: int64 <- read_buf(graph.neighbors, 0);
        result: int64 <- case in_range of {
            0 -> -1;
            1 -> case local_saved of {
                0 -> case start of {
                    0 -> case stop of {
                        0 -> -1;
                        _: int64 -> n0
                    };
                    _: int64 -> -1
                };
                _: int64 -> -1
            };
            _: int64 -> -1
        }
    produces
        pure result
    end
}

fn validate[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    err: int64 <- csr_validate_weighted_int64_error(graph);
    case err of {
        0 -> 1;
        _: int64 -> 0
    }
}

export validate_checked[int64, mem(normal)]/1;

fn validate_checked[int64, mem(normal)](graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> { ok: int64, error_code: int64 } {
    err: int64 <- csr_validate_weighted_int64_error(graph);
    case err of {
        0 -> { ok: 1, error_code: 0 };
        _: int64 -> { ok: 0, error_code: err }
    }
}

fn csr_validate_weighted_int64_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    nc_ok: int64 <- graph_adj_list_helpers@graph_adj_validate_node_count_range(graph.node_count);
    case nc_ok of {
        0 -> 1;
        1 -> csr_validate_weighted_edge_count_error(graph);
        _: int64 -> 1
    }
}

fn csr_validate_weighted_edge_count_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    case graph.edge_count of {
        1 -> csr_validate_weighted_int64_full_error(graph);
        _: int64 -> 6
    }
}

fn csr_validate_weighted_int64_offsets_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    sequence proc[mem(normal)]
        o0: int64 <- read_buf(graph.offsets, 0);
        o1: int64 <- read_buf(graph.offsets, 1);
        o2: int64 <- read_buf(graph.offsets, 2);
        o3: int64 <- read_buf(graph.offsets, 3);
        first_ok: int64 <- case o0 == 0 of {
            true -> 0;
            false -> 2
        };
        final_ok: int64 <- case o3 == graph.edge_count of {
            true -> 0;
            false -> 3
        };
        mono01: int64 <- case o0 <= o1 of {
            true -> 0;
            false -> 4
        };
        mono12: int64 <- case o1 <= o2 of {
            true -> 0;
            false -> 4
        };
        mono23: int64 <- case o2 <= o3 of {
            true -> 0;
            false -> 4
        };
        result: int64 <- first_error(first_ok, first_error(final_ok, first_error(mono01, first_error(mono12, mono23))))
    produces
        pure result
    end
}

fn csr_validate_weighted_int64_neighbors_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    sequence proc[mem(normal)]
        neighbor: int64 <- read_buf(graph.neighbors, 0);
        in_range: int64 <- graph_adj_list_helpers@graph_adj_node_id_in_range(neighbor, graph.node_count);
        result: int64 <- case in_range of {
            1 -> 0;
            _: int64 -> 5
        }
    produces
        pure result
    end
}

fn csr_validate_weighted_int64_full_error(graph: {
    region: region(L1, normal),
    node_count: int64,
    edge_count: int64,
    offsets: buf(L1, normal, int64, 4),
    neighbors: buf(L1, normal, int64, 1),
    weights: buf(L1, normal, int64, 1)
}) -> int64 {
    offset_err: int64 <- csr_validate_weighted_int64_offsets_error(graph);
    case offset_err of {
        0 -> csr_validate_weighted_int64_neighbors_error(graph);
        _: int64 -> offset_err
    }
}
