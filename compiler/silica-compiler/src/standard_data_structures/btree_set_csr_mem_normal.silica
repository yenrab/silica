// CsrBTreeSet[int64, mem(normal)] (btree_set_design.md §4.1).
// Bootstrap generated family: order 8, single-leaf static {1,3,5}, NODE_CAP=1.

export btree_set_csr_empty[int64, mem(normal)]/0;
export btree_set_csr_from_static_sorted[int64, mem(normal)]/0;
export btree_set_csr_contains[int64, mem(normal)]/2;
export btree_set_csr_validate[int64, mem(normal)]/1;

fn btree_set_csr_mem_normal_order() -> int64 {
    8
}

fn btree_set_csr_mem_normal_node_cap() -> int64 {
    1
}

fn btree_set_csr_mem_normal_key_cap() -> int64 {
    7
}

fn btree_set_csr_mem_normal_child_cap() -> int64 {
    8
}

fn btree_set_csr_mem_normal_first_error(first: int64, second: int64) -> int64 {
    case first of {
        0 -> second;
        _: int64 -> first
    }
}

fn btree_set_csr_mem_normal_key_equal(left: int64, right: int64) -> int64 {
    case left == right of {
        true -> 1;
        false -> 0
    }
}

fn btree_set_csr_empty[int64, mem(normal)]() -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 1),
    node_key_count: buf(L1, normal, int64, 1),
    node_child_start: buf(L1, normal, int64, 1),
    node_child_count: buf(L1, normal, int64, 1),
    node_is_leaf: buf(L1, normal, int64, 1),
    keys: buf(L1, normal, int64, 7),
    children: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        node_key_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_key_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_is_leaf: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        keys: buf(L1, normal, int64, 7) <- alloc_buf(r, 7);
        children: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- {
            region: r,
            root_id: -1,
            node_count: 0,
            key_count_total: 0,
            order: btree_set_csr_mem_normal_order(),
            node_key_start: node_key_start,
            node_key_count: node_key_count,
            node_child_start: node_child_start,
            node_child_count: node_child_count,
            node_is_leaf: node_is_leaf,
            keys: keys,
            children: children
        }
    produces
        pure tree
    end
}

fn btree_set_csr_from_static_sorted[int64, mem(normal)]() -> {
    region: region(L1, normal),
    root_id: int64,
    node_count: int64,
    key_count_total: int64,
    order: int64,
    node_key_start: buf(L1, normal, int64, 1),
    node_key_count: buf(L1, normal, int64, 1),
    node_child_start: buf(L1, normal, int64, 1),
    node_child_count: buf(L1, normal, int64, 1),
    node_is_leaf: buf(L1, normal, int64, 1),
    keys: buf(L1, normal, int64, 7),
    children: buf(L1, normal, int64, 8)
} {
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        node_key_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_key_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_start: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_child_count: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        node_is_leaf: buf(L1, normal, int64, 1) <- alloc_buf(r, 1);
        keys: buf(L1, normal, int64, 7) <- alloc_buf(r, 7);
        children: buf(L1, normal, int64, 8) <- alloc_buf(r, 8);
        _: atom <- write_buf(node_key_start, 0, 0);
        _: atom <- write_buf(node_key_count, 0, 3);
        _: atom <- write_buf(node_child_start, 0, 0);
        _: atom <- write_buf(node_child_count, 0, 0);
        _: atom <- write_buf(node_is_leaf, 0, 1);
        _: atom <- write_buf(keys, 0, 1);
        _: atom <- write_buf(keys, 1, 3);
        _: atom <- write_buf(keys, 2, 5);
        tree: {
            region: region(L1, normal),
            root_id: int64,
            node_count: int64,
            key_count_total: int64,
            order: int64,
            node_key_start: buf(L1, normal, int64, 1),
            node_key_count: buf(L1, normal, int64, 1),
            node_child_start: buf(L1, normal, int64, 1),
            node_child_count: buf(L1, normal, int64, 1),
            node_is_leaf: buf(L1, normal, int64, 1),
            keys: buf(L1, normal, int64, 7),
            children: buf(L1, normal, int64, 8)
        } <- {
            region: r,
            root_id: 0,
            node_count: 1,
            key_count_total: 3,
            order: 8,
            node_key_start: node_key_start,
            node_key_count: node_key_count,
            node_child_start: node_child_start,
            node_child_count: node_child_count,
            node_is_leaf: node_is_leaf,
            keys: keys,
            children: children
        }
    produces
        pure tree
    end
}

fn btree_set_csr_mem_normal_contains_bootstrap(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    key: int64
) -> int64 {
    shape_ok: int64 <- case tree.node_count of {
        1 -> case tree.key_count_total of {
            3 -> 1;
            _: int64 -> 0
        };
        _: int64 -> 0
    };
    sequence proc[mem(normal)]
        key_saved: int64 <- key;
        k0: int64 <- read_buf(tree.keys, 0);
        k1: int64 <- read_buf(tree.keys, 1);
        k2: int64 <- read_buf(tree.keys, 2);
        m0: int64 <- btree_set_csr_mem_normal_key_equal(k0, key_saved);
        m1: int64 <- btree_set_csr_mem_normal_key_equal(k1, key_saved);
        m2: int64 <- btree_set_csr_mem_normal_key_equal(k2, key_saved);
        present: int64 <- case m0 + m1 + m2 of {
            0 -> 0;
            _: int64 -> 1
        };
        result: int64 <- shape_ok * present
    produces
        pure result
    end
}

fn btree_set_csr_contains[int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    },
    key: int64
) -> int64 {
    sequence proc[]
        root_saved: int64 <- tree.root_id;
        key_saved: int64 <- key;
        result: int64 <- case root_saved of {
            -1 -> 0;
            _: int64 -> btree_set_csr_mem_normal_contains_bootstrap(tree, key_saved)
        }
    produces
        pure result
    end
}

fn btree_set_csr_mem_normal_validate_empty(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> int64 {
    case tree.root_id == -1 of {
        false -> 1;
        true -> case tree.key_count_total of {
            0 -> 0;
            _: int64 -> 1
        }
    }
}

fn btree_set_csr_mem_normal_validate_bootstrap_one(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> int64 {
    root_ok: int64 <- case tree.root_id of {
        0 -> 1;
        _: int64 -> 0
    };
    case root_ok of {
        0 -> 1;
        _: int64 -> case tree.key_count_total of {
            2 -> btree_set_csr_mem_normal_validate_two_keys(tree);
            3 -> 0;
            _: int64 -> 4
        }
    }
}

fn btree_set_csr_mem_normal_validate_two_keys(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> int64 {
    sequence proc[mem(normal)]
        k0: int64 <- read_buf(tree.keys, 0);
        k1: int64 <- read_buf(tree.keys, 1);
        result: int64 <- case k0 < k1 of {
            true -> 0;
            false -> 5
        }
    produces
        pure result
    end
}

fn btree_set_csr_mem_normal_validate_nonempty(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> int64 {
    count_ok: int64 <- case tree.node_count of {
        1 -> 1;
        _: int64 -> 0
    };
    total_ok: int64 <- case tree.key_count_total <= 7 of {
        true -> 1;
        false -> 0
    };
    case count_ok of {
        0 -> 4;
        _: int64 -> case total_ok of {
            0 -> 20;
            _: int64 -> btree_set_csr_mem_normal_validate_bootstrap_one(tree)
        }
    }
}

fn btree_set_csr_mem_normal_validate_error(
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> int64 {
    case tree.order == btree_set_csr_mem_normal_order() of {
        false -> 8;
        true -> case tree.node_count of {
            0 -> btree_set_csr_mem_normal_validate_empty(tree);
            _: int64 -> btree_set_csr_mem_normal_validate_nonempty(tree)
        }
    }
}

fn btree_set_csr_validate[int64, mem(normal)](
    tree: {
        region: region(L1, normal),
        root_id: int64,
        node_count: int64,
        key_count_total: int64,
        order: int64,
        node_key_start: buf(L1, normal, int64, 1),
        node_key_count: buf(L1, normal, int64, 1),
        node_child_start: buf(L1, normal, int64, 1),
        node_child_count: buf(L1, normal, int64, 1),
        node_is_leaf: buf(L1, normal, int64, 1),
        keys: buf(L1, normal, int64, 7),
        children: buf(L1, normal, int64, 8)
    }
) -> { ok: int64, error_code: int64 } {
    sequence proc[]
        err: int64 <- btree_set_csr_mem_normal_validate_error(tree);
        ok_value: int64 <- case err of {
            0 -> 1;
            _: int64 -> 0
        };
        result: { ok: int64, error_code: int64 } <- {
            ok: ok_value,
            error_code: err
        }
    produces
        pure result
    end
}
