// String prim emission: string_concat, string_substring, string_substring_until_char
// eq / nq: pointer (handle) compare; operands in X9, X10 per term_emitter (same as int64 compares).
// string_concat: X0 (arg1), X1 (arg2). BL L_concat_helper; result in X0.
// string_substring: X0 (s), X1 (start_char), X2 (end_char). Character-based indices. BL L_substring_helper; result in X0.
// string_substring_until_char: X0 (s), X1 (start), X2 (encoded char: len<<56|packed). BL L_substring_until_char_helper; result in X0.
// Helpers emitted by string_concat_mmap_nomte and string_substring_mmap_nomte when module uses them.
// sir_design_spec §7.10, sir_emitter_pattern_spec §9

use sir_ast;
use comparison;

export emit_prim_op/2;

fn emit_string_concat(dest: string) -> string {
    bl_line: string <- "    BL L_concat_helper";
    result_mov: string <- case dest == "X0" of {
        true -> "";
        false -> concat("\n", concat(concat(concat("    MOV ", dest), ", X0"), ""))
    };
    concat(bl_line, result_mov)
}

fn emit_string_substring(dest: string) -> string {
    bl_line: string <- "    BL L_substring_helper";
    result_mov: string <- case dest == "X0" of {
        true -> "";
        false -> concat("\n", concat(concat(concat("    MOV ", dest), ", X0"), ""))
    };
    concat(bl_line, result_mov)
}

fn emit_string_substring_until_char(dest: string) -> string {
    bl_line: string <- "    BL L_substring_until_char_helper";
    result_mov: string <- case dest == "X0" of {
        true -> "";
        false -> concat("\n", concat(concat(concat("    MOV ", dest), ", X0"), ""))
    };
    concat(bl_line, result_mov)
}

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    case term.name of {
        "eq" -> comparison@emit_eq_op(dest, "X");
        "nq" -> comparison@emit_ne_op(dest, "X");
        "string_concat" -> emit_string_concat(dest);
        "string_substring" -> emit_string_substring(dest);
        "string_substring_until_char" -> emit_string_substring_until_char(dest);
        _: string -> concat(concat("    ; unsupported string prim: ", term.name), "")
    }
}
