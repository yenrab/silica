// List prim emission: list_nil, list_cons, list_length, list_head, list_remove_head
// list_implementation_design.md §4–§9: chunk-based spine; immutable handles, mutable chunks.
//
// List handle (24 bytes, heap-allocated; pointer = 0 for nil):
//   [0..8)   = length  (int64, total list length)
//   [8..16)  = chunk_ptr (pointer to first data chunk)
//   [16..24) = cursor   (byte offset of first element within chunk data area)
//
// Data chunk (CDATA + 8 bytes, heap-allocated):
//   [0..CDATA)          = element slots (filled back-to-front per §9.5)
//   [CDATA..CDATA+8)    = next chunk pointer (0 = end of spine)
//
// CDATA = max(16, elem_slot_bytes).  Capacity = CDATA / elem_slot_bytes.
// Empty list: register value 0.  Chunks are mutable (new slots filled in place);
// elements once written are immutable.  Handles are immutable once created.

use sir_ast;
use reg_conventions;
use var;
use prims_tuple;
use prims_record;
use atom_table;

export is_list_prim/1;
export emit_prim_op/2;
export module_uses_list_prims/1;
export emit_list_helpers/0;
export emit_region_alloc_stub/0;
export list_element_payload_bytes/1;
export chunk_elem_slot_bytes/1;
export chunk_data_bytes/1;

fn is_list_prim(name: string) -> bool {
    name == "list_nil" or name == "list_cons" or name == "list_length" or name == "list_head" or name == "list_remove_head"
}

fn term_has_list_prim(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            6 -> case is_list_prim(term.name) of {
                true -> true;
                false -> case term_has_list_prim(term.inner) of {
                    true -> true;
                    false -> term_has_list_prim(term.right_expr)
                }
            };
            2 -> case term_has_list_prim(term.inner) of {
                true -> true;
                false -> term_has_list_prim(term.right_expr)
            };
            3 -> case term_has_list_prim(term.inner) of {
                true -> true;
                false -> term_has_list_prim(term.right_expr)
            };
            4 -> case term_has_list_prim(term.inner) of {
                true -> true;
                false -> term_has_list_prim(term.right_expr)
            };
            5 -> case term_has_list_prim(term.inner) of {
                true -> true;
                false -> term_has_list_prim(term.right_expr)
            };
            7 -> case term_has_list_prim(term.inner) of {
                true -> true;
                false -> term_has_list_prim(term.right_expr)
            };
            8 -> case term_has_list_prim(term.inner) of {
                true -> true;
                false -> term_has_list_prim(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn list_prim_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_list_prim(fns.head.body) of {
            true -> true;
            false -> list_prim_in_functions(fns.tail)
        }
    }
}

fn module_uses_list_prims(sir_module: SIRModule) -> bool {
    list_prim_in_functions(sir_module.functions)
}

// Comma at depth 0; depth increases for [, (, {; decreases for ], ), }.
fn find_first_comma_depth0_pb(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> do
            c: string <- substring(s, i, i + 1);
            case c == "(" or c == "[" or c == "{" of {
                true -> find_first_comma_depth0_pb(s, i + 1, depth + 1);
                false -> case c == ")" or c == "]" or c == "}" of {
                    true -> find_first_comma_depth0_pb(s, i + 1, depth - 1);
                    false -> case c == "," of {
                        true -> case depth == 0 of {
                            true -> i;
                            false -> find_first_comma_depth0_pb(s, i + 1, depth)
                        };
                        false -> find_first_comma_depth0_pb(s, i + 1, depth)
                    }
                }
            }
        end
    }
}

// Strips spaces so "List [ T , mem ]" becomes "List[T,mem]".
fn list_elem_type_from_list_t(list_t: string) -> string {
    t: string <- prims_record@strip_spaces_rt(list_t);
    case len(t) < 6 of {
        true -> "";
        false -> case substring(t, 0, 5) == "List[" of {
            false -> "";
            true -> case substring(t, len(t) - 1, len(t)) == "]" of {
                false -> "";
                true -> do
                    inner: string <- substring(t, 5, len(t) - 1);
                    inner_trim: string <- prims_record@strip_spaces_rt(inner);
                    comma: int64 <- find_first_comma_depth0_pb(inner_trim, 0, 0);
                    case comma >= len(inner_trim) of {
                        true -> inner_trim;
                        false -> prims_record@strip_spaces_rt(substring(inner_trim, 0, comma))
                    }
                end
            }
        }
    }
}

// Byte size of one element slot in a chunk.  Narrow scalars use their natural width
// so that multiple elements pack into the 128-bit data area.
fn element_type_is_child_spec_record(elem_t: string) -> bool {
    len(prims_record@find_field_type_in_record(elem_t, "id")) > 0
        and len(prims_record@find_field_type_in_record(elem_t, "agent_type")) > 0
        and len(prims_record@find_field_type_in_record(elem_t, "initial_state")) > 0
        and len(prims_record@find_field_type_in_record(elem_t, "behavior")) > 0
        and len(prims_record@find_field_type_in_record(elem_t, "restart")) > 0
        and len(prims_record@find_field_type_in_record(elem_t, "shutdown")) > 0
}

fn chunk_elem_slot_bytes(elem_t: string) -> int64 {
    case reg_conventions@is_inline_struct_type(elem_t) of {
        true -> do
            visible_bytes: int64 <- prims_record@record_type_list_cons_payload_bytes(elem_t);
            case element_type_is_child_spec_record(elem_t) of {
                true -> visible_bytes + 8;
                false -> visible_bytes
            }
        end;
        false -> case reg_conventions@is_tuple_type(elem_t) of {
            true -> prims_tuple@flat_alloc_size(prims_tuple@count_type_elements(elem_t));
            false -> case elem_t of {
                "int8"  -> 1;
                "uint8" -> 1;
                "int16" -> 2;
                "uint16" -> 2;
                "int32" -> 4;
                "uint32" -> 4;
                "float32" -> 4;
                _: string -> 8
            }
        }
    }
}

// Total data area per chunk (128-bit minimum, or elem_slot_bytes if element is larger).
fn chunk_data_bytes(elem_t: string) -> int64 {
    es: int64 <- chunk_elem_slot_bytes(elem_t);
    case es > 16 of {
        true -> es;
        false -> 16
    }
}

// Legacy export: flat byte size of one list element.
fn list_element_payload_bytes(elem_t: string) -> int64 {
    chunk_elem_slot_bytes(elem_t)
}

fn emit_list_nil(dest: string) -> string {
    concat(concat("    MOV ", dest), ", #0\n")
}

// X1 = head value (or ptr to aggregate), X2 = tail list handle (or 0).
// Emits: set up X3=elem_size, X4=chunk_data_size, BL L_list_prepend_helper.
fn emit_list_cons(term: SIRTerm, dest: string) -> string {
    et: string <- term.inner.type_name;
    es: int64 <- chunk_elem_slot_bytes(et);
    cd: int64 <- chunk_data_bytes(et);
    es_s: string <- atom_table@int64_to_decimal_string(es);
    cd_s: string <- atom_table@int64_to_decimal_string(cd);
    is_agg: bool <- reg_conventions@is_aggregate_struct_or_tuple_return_type(et);
    mov_es: string <- concat("    MOV X3, #", concat(es_s, "\n"));
    mov_cd: string <- concat("    MOV X4, #", concat(cd_s, "\n"));
    agg_flag: string <- case is_agg of {
        true -> "    MOV X5, #1\n";
        false -> "    MOV X5, #0\n"
    };
    bl: string <- "    BL L_list_prepend_helper\n";
    mov_d: string <- case dest == "X0" of {
        true -> "";
        false -> concat(concat("    MOV ", dest), ", X0\n")
    };
    concat(concat(concat(concat(mov_es, mov_cd), agg_flag), bl), mov_d)
}

// X9 = list handle pointer.  Dereference handle → chunk → cursor → element.
fn emit_list_head(term: SIRTerm, dest: string) -> string {
    load_chunk: string <- "    LDR X10, [X9, #8]\n";
    load_cursor: string <- "    LDR X11, [X9, #16]\n";
    addr: string <- "    ADD X10, X10, X11\n";
    case reg_conventions@is_aggregate_struct_or_tuple_return_type(term.type_name) of {
        true -> concat(concat(load_chunk, load_cursor), concat(addr, concat(concat("    MOV ", dest), ", X10\n")));
        false -> do
            ed: string <- case reg_conventions@is_narrow_type(term.type_name) of {
                true -> case len(dest) > 0 of {
                    true -> case substring(dest, 0, 1) == "X" of {
                        true -> concat("W", substring(dest, 1, len(dest)));
                        false -> dest
                    };
                    false -> dest
                };
                false -> dest
            };
            ld: string <- case reg_conventions@is_narrow_type(term.type_name) of {
                true -> case term.type_name of {
                    "int8" -> concat(concat("    LDRSB ", ed), ", [X10]\n");
                    "uint8" -> concat(concat("    LDRB ", ed), ", [X10]\n");
                    "int16" -> concat(concat("    LDRSH ", ed), ", [X10]\n");
                    "uint16" -> concat(concat("    LDRH ", ed), ", [X10]\n");
                    _: string -> concat(concat("    LDR ", ed), ", [X10]\n")
                };
                false -> concat(concat("    LDR ", dest), ", [X10]\n")
            };
            concat(concat(load_chunk, load_cursor), concat(addr, ld))
        end
    }
}

// X9 = list handle.  Produce tail handle via helper.
fn emit_list_remove_head(term: SIRTerm, dest: string) -> string {
    em: string <- list_elem_type_from_list_t(term.inner.type_name);
    et: string <- case len(em) == 0 of { true -> "int64"; false -> em };
    es: int64 <- chunk_elem_slot_bytes(et);
    cd: int64 <- chunk_data_bytes(et);
    es_s: string <- atom_table@int64_to_decimal_string(es);
    cd_s: string <- atom_table@int64_to_decimal_string(cd);
    setup: string <- concat("    MOV X0, X9\n", concat("    MOV X1, #", concat(es_s, concat("\n    MOV X2, #", concat(cd_s, "\n")))));
    bl: string <- "    BL L_list_tail_helper\n";
    mov_d: string <- case dest == "X0" of {
        true -> "";
        false -> concat(concat("    MOV ", dest), ", X0\n")
    };
    concat(concat(setup, bl), mov_d)
}

// X9 = list handle.  Length is memoized at handle[0].  O(1).
// Call helper: X0=handle → X0=length.  Helper returns 0 for nil handle.
fn emit_list_length(term: SIRTerm, dest: string) -> string {
    mov_arg: string <- "    MOV X0, X9\n";
    bl: string <- "    BL L_list_length_helper\n";
    mov_out: string <- case dest == "X0" of {
        true -> "";
        false -> concat(concat("    MOV ", dest), ", X0\n")
    };
    concat(concat(mov_arg, bl), mov_out)
}

// O(1) length helper: X0 = handle (or 0 for nil). Returns X0 = length.
fn emit_list_length_helper() -> string {
    "L_list_length_helper:\n    CBZ X0, L_list_len_nil\n    LDR X0, [X0]\n    RET\nL_list_len_nil:\n    MOV X0, #0\n    RET\n"
}

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    case term.name of {
        "list_nil" -> emit_list_nil(dest);
        "list_cons" -> emit_list_cons(term, dest);
        "list_length" -> emit_list_length(term, dest);
        "list_head" -> emit_list_head(term, dest);
        "list_remove_head" -> emit_list_remove_head(term, dest);
        _: string -> concat(concat("    ; unsupported list prim: ", term.name), "\n")
    }
}

// Module-level helper: L_list_prepend_helper
// X1 = head value (or pointer to aggregate), X2 = old handle (0=nil),
// X3 = elem_slot_bytes, X4 = chunk_data_bytes, X5 = is_aggregate (0 or 1).
// Returns X0 = new list handle.
fn emit_list_prepend_helper() -> string {
    concat(
    concat(
    concat(
    "L_list_prepend_helper:\n",
    concat(
    "    STP X29, X30, [SP, #-16]!\n    MOV X29, SP\n",
    concat(
    "    STP X1, X2, [SP, #-16]!\n    STP X3, X4, [SP, #-16]!\n    STR X5, [SP, #-16]!\n",
    concat(
    "    CBZ X2, L_lph_new_chunk\n",
    concat(
    "    LDR X6, [X2, #16]\n",
    "    CBZ X6, L_lph_new_chunk\n"
    ))))),
    concat(
    concat(
    "    LDR X7, [X2, #8]\n    SUB X8, X6, X3\n",
    concat(
    "    ADD X10, X7, X8\n",
    concat(
    "    LDR X11, [SP]\n    CBZ X11, L_lph_room_scalar\n",
    concat(
    "    MOV X12, #0\nL_lph_room_agg:\n    CMP X12, X3\n    B.GE L_lph_room_stored\n",
    concat(
    "    LDR X13, [X1, X12]\n    STR X13, [X10, X12]\n    ADD X12, X12, #8\n    B L_lph_room_agg\n",
    "    B L_lph_room_stored\n"
    ))))),
    concat(
    concat(
    "L_lph_room_scalar:\n    CMP X3, #8\n    B.EQ L_lph_rs8\n    CMP X3, #4\n    B.EQ L_lph_rs4\n",
    concat(
    "    CMP X3, #2\n    B.EQ L_lph_rs2\n    STRB W1, [X10]\n    B L_lph_room_stored\n",
    concat(
    "L_lph_rs2:\n    STRH W1, [X10]\n    B L_lph_room_stored\n",
    concat(
    "L_lph_rs4:\n    STR W1, [X10]\n    B L_lph_room_stored\n",
    "L_lph_rs8:\n    STR X1, [X10]\n"
    )))),
    concat(
    "L_lph_room_stored:\n",
    concat(
    "    MOV X0, #24\n    BL _silica_rt_region_alloc\n",
    concat(
    "    LDR X5, [SP], #16\n    LDP X3, X4, [SP], #16\n    LDP X1, X2, [SP], #16\n",
    concat(
    "    LDR X6, [X2]\n    ADD X6, X6, #1\n    STR X6, [X0]\n",
    concat(
    "    LDR X7, [X2, #8]\n    STR X7, [X0, #8]\n",
    concat(
    "    LDR X8, [X2, #16]\n    SUB X8, X8, X3\n    STR X8, [X0, #16]\n",
    "    LDP X29, X30, [SP], #16\n    RET\n"
    ))))))))),
    concat(
    concat(
    "L_lph_new_chunk:\n",
    concat(
    "    ADD X0, X4, #8\n    BL _silica_rt_region_alloc\n    MOV X6, X0\n",
    concat(
    "    LDR X5, [SP]\n    LDP X3, X4, [SP, #16]\n    LDP X1, X2, [SP, #32]\n",
    concat(
    "    SUB X8, X4, X3\n    ADD X10, X6, X8\n",
    concat(
    "    CBZ X5, L_lph_new_scalar\n",
    concat(
    "    MOV X12, #0\nL_lph_new_agg:\n    CMP X12, X3\n    B.GE L_lph_new_stored\n",
    concat(
    "    LDR X13, [X1, X12]\n    STR X13, [X10, X12]\n    ADD X12, X12, #8\n    B L_lph_new_agg\n",
    "    B L_lph_new_stored\n"
    ))))))),
    concat(
    concat(
    "L_lph_new_scalar:\n    CMP X3, #8\n    B.EQ L_lph_ns8\n    CMP X3, #4\n    B.EQ L_lph_ns4\n",
    concat(
    "    CMP X3, #2\n    B.EQ L_lph_ns2\n    STRB W1, [X10]\n    B L_lph_new_stored\n",
    concat(
    "L_lph_ns2:\n    STRH W1, [X10]\n    B L_lph_new_stored\n",
    concat(
    "L_lph_ns4:\n    STR W1, [X10]\n    B L_lph_new_stored\n",
    "L_lph_ns8:\n    STR X1, [X10]\n"
    )))),
    concat(
    "L_lph_new_stored:\n",
    concat(
    "    CBZ X2, L_lph_next_nil\n    LDR X9, [X2, #8]\n",
    concat(
    "    STR X9, [X6, X4]\n    B L_lph_alloc_handle\n",
    concat(
    "L_lph_next_nil:\n    STR XZR, [X6, X4]\n",
    concat(
    "L_lph_alloc_handle:\n    STP X6, X8, [SP, #-16]!\n",
    concat(
    "    MOV X0, #24\n    BL _silica_rt_region_alloc\n",
    concat(
    "    LDP X6, X8, [SP], #16\n",
    concat(
    "    LDR X5, [SP], #16\n    LDP X3, X4, [SP], #16\n    LDP X1, X2, [SP], #16\n",
    concat(
    "    CBZ X2, L_lph_len1\n    LDR X9, [X2]\n    ADD X9, X9, #1\n    B L_lph_setlen\n",
    concat(
    "L_lph_len1:\n    MOV X9, #1\n",
    concat(
    "L_lph_setlen:\n    STR X9, [X0]\n    STR X6, [X0, #8]\n    STR X8, [X0, #16]\n",
    "    LDP X29, X30, [SP], #16\n    RET\n"
    )))))))))))
    )))
}

// Module-level helper: L_list_tail_helper
// X0 = handle, X1 = elem_slot_bytes, X2 = chunk_data_bytes.
// Returns X0 = tail handle (or 0 for nil tail).
fn emit_list_tail_helper() -> string {
    concat(
    concat(
    "L_list_tail_helper:\n    STP X29, X30, [SP, #-16]!\n    MOV X29, SP\n",
    concat(
    "    LDR X3, [X0]\n    LDR X4, [X0, #8]\n    LDR X5, [X0, #16]\n",
    "    ADD X6, X5, X1\n"
    )),
    concat(
    concat(
    "    CMP X6, X2\n    B.GE L_lth_next_chunk\n",
    concat(
    "    SUB X3, X3, #1\n    CBZ X3, L_lth_nil\n",
    concat(
    "    STP X3, X4, [SP, #-16]!\n    STP X6, XZR, [SP, #-16]!\n",
    concat(
    "    MOV X0, #24\n    BL _silica_rt_region_alloc\n",
    concat(
    "    LDP X6, XZR, [SP], #16\n    LDP X3, X4, [SP], #16\n",
    "    STR X3, [X0]\n    STR X4, [X0, #8]\n    STR X6, [X0, #16]\n    LDP X29, X30, [SP], #16\n    RET\n"
    ))))),
    concat(
    "L_lth_next_chunk:\n    LDR X7, [X4, X2]\n    CBZ X7, L_lth_nil\n",
    concat(
    "    SUB X3, X3, #1\n    CBZ X3, L_lth_nil\n",
    concat(
    "    STP X3, X7, [SP, #-16]!\n    MOV X0, #24\n    BL _silica_rt_region_alloc\n",
    concat(
    "    LDP X3, X7, [SP], #16\n",
    concat(
    "    STR X3, [X0]\n    STR X7, [X0, #8]\n    STR XZR, [X0, #16]\n",
    "    LDP X29, X30, [SP], #16\n    RET\nL_lth_nil:\n    MOV X0, #0\n    LDP X29, X30, [SP], #16\n    RET\n"
    )))))
    ))
}

fn emit_list_helpers() -> string {
    concat(emit_list_prepend_helper(), concat("\n", concat(emit_list_tail_helper(), concat("\n", emit_list_length_helper()))))
}

// Lightweight _silica_rt_region_alloc that just forwards to _malloc.
// Used when actors are absent (the actor runtime provides its own
// region-aware implementation that supersedes this stub).
fn emit_region_alloc_stub() -> string {
    ".globl _silica_rt_region_alloc\n.p2align 2\n_silica_rt_region_alloc:\n    B _malloc\n"
}
