// Collection comparator result validation (Layer 1 §7.7).

use sir_ast;
use atom_table;

export is_collection_result_prim/1;
export emit_prim_op_with_table/3;

fn is_collection_result_prim(name: string) -> bool {
    name == "comparator_result_valid" or name == "comparator_result_validate"
}

fn atom_index_str(table: AtomTable, lexeme: string) -> string {
    atom_table@int64_to_decimal_string(atom_table@lexeme_to_index_first_added_order(table, lexeme))
}

fn cmpres_label_suffix(term: SIRTerm, dest: string, table: AtomTable) -> string {
    case term.inner.kind == 0 and term.inner.type_name == "atom" of {
        true -> do
            idx: string <- atom_index_str(table, term.inner.value);
            concat(concat(dest, "_"), idx)
        end;
        false -> dest
    }
}

fn emit_comparator_result_valid(term: SIRTerm, dest: string, table: AtomTable) -> string {
    label: string <- cmpres_label_suffix(term, dest, table);
    less_idx: string <- atom_index_str(table, ":less");
    equal_idx: string <- atom_index_str(table, ":equal");
    greater_idx: string <- atom_index_str(table, ":greater");
    p0: string <- concat("    CMP X0, #", less_idx);
    p1: string <- concat(p0, "\n    B.EQ L_cmpres_ok_");
    p2: string <- concat(p1, label);
    p3: string <- concat(p2, "\n    CMP X0, #");
    p4: string <- concat(p3, equal_idx);
    p5: string <- concat(p4, "\n    B.EQ L_cmpres_ok_");
    p6: string <- concat(p5, label);
    p7: string <- concat(p6, "\n    CMP X0, #");
    p8: string <- concat(p7, greater_idx);
    p9: string <- concat(p8, "\n    B.EQ L_cmpres_ok_");
    p10: string <- concat(p9, label);
    p11: string <- concat(p10, "\n    MOV X0, #0\n    B L_cmpres_done_");
    p12: string <- concat(p11, label);
    p13: string <- concat(p12, "\nL_cmpres_ok_");
    p14: string <- concat(p13, label);
    p15: string <- concat(p14, ":\n    MOV X0, #1\nL_cmpres_done_");
    concat(p15, concat(label, ":\n"))
}

fn emit_comparator_result_validate(term: SIRTerm, dest: string, table: AtomTable) -> string {
    label: string <- cmpres_label_suffix(term, dest, table);
    less_idx: string <- atom_index_str(table, ":less");
    equal_idx: string <- atom_index_str(table, ":equal");
    greater_idx: string <- atom_index_str(table, ":greater");
    invalid_idx: string <- atom_index_str(table, ":invalid_comparator_result");
    p0: string <- concat("    CMP X0, #", less_idx);
    p1: string <- concat(p0, "\n    B.EQ L_cmpval_done_");
    p2: string <- concat(p1, label);
    p3: string <- concat(p2, "\n    CMP X0, #");
    p4: string <- concat(p3, equal_idx);
    p5: string <- concat(p4, "\n    B.EQ L_cmpval_done_");
    p6: string <- concat(p5, label);
    p7: string <- concat(p6, "\n    CMP X0, #");
    p8: string <- concat(p7, greater_idx);
    p9: string <- concat(p8, "\n    B.EQ L_cmpval_done_");
    p10: string <- concat(p9, label);
    p11: string <- concat(p10, "\n    MOV X0, #");
    p12: string <- concat(p11, invalid_idx);
    p13: string <- concat(p12, "\nL_cmpval_done_");
    concat(p13, concat(label, ":\n"))
}

fn emit_prim_op_with_table(term: SIRTerm, dest: string, table: AtomTable) -> string {
    case term.name of {
        "comparator_result_valid" -> emit_comparator_result_valid(term, dest, table);
        "comparator_result_validate" -> emit_comparator_result_validate(term, dest, table);
        _: string -> concat(concat("    ; unsupported collection result prim: ", term.name), "\n")
    }
}
