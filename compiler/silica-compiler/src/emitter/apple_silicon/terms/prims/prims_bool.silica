// bool prim emission: and, or, eq, ne
// X registers (bool uses int64 width in SIR)

use sir_ast;
use comparison;
use logical;

export emit_prim_op/2;

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    case term.name of {
        "and" -> logical@emit_and_op(dest, "X");
        "or" -> logical@emit_or_op(dest, "X");
        "eq" -> comparison@emit_eq_op(dest, "X");
        "nq" -> comparison@emit_ne_op(dest, "X");
        _: string -> concat("    ; unsupported bool prim: ", term.name)
    }
}
