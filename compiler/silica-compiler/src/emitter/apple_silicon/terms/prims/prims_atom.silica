// Ordering compares between atom indices (compile-time ordering by first occurrence; silica-spec §4.1.7).
// Operands arrive in X9/X10 like other scalar compares (term_emitter is_cmp branch).

use sir_ast;
use comparison;

export emit_prim_op/2;

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    case term.name of {
        "lt" -> comparison@emit_lt_op(dest, "X");
        "gt" -> comparison@emit_gt_op(dest, "X");
        "le" -> comparison@emit_le_op(dest, "X");
        "ge" -> comparison@emit_ge_op(dest, "X");
        _: string -> concat("    ; unsupported atom prim: ", term.name)
    }
}
