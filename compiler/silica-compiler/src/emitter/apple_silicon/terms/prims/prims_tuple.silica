// Tuple prim emission: flat tuple layout
// sir_design_spec §7.6: tuple_make (T1, T2, ...) | (v1, v2, ...) | []
// Flat layout: single stack allocation, elements at [SP, #0], [SP, #8], ...
// SIR chain: tuple_make(e0, tuple_make(e1, ... tuple_make(eN-2, eN-1)))
// Emitter flattens this chain into one contiguous allocation.

use sir_ast;
use reg_conventions;
use atom_table;
use string_parse;

export emit_prim_op/2;
export count_tuple_allocations/1;
export count_flat_elements/1;
export count_type_elements/1;
export flat_alloc_size/1;
export flat_alloc_size_str/1;
export emit_flat_store/3;
export emit_flat_mov_dest/1;
export index_to_offset/1;
export ldr_prefix_for_type/1;

fn count_flat_elements(term: SIRTerm) -> int64 {
    type_count: int64 <- count_type_elements(term.type_name);
    case type_count < 2 and term.kind == 6 and term.name == "tuple_make" of {
        true -> count_chain_elements(term);
        false -> type_count
    }
}

fn count_chain_elements(term: SIRTerm) -> int64 {
    case term.kind == 6 and term.name == "tuple_make" of {
        true -> 1 + count_chain_elements(term.right_expr);
        false -> 1
    }
}

fn count_type_elements(type_name: string) -> int64 {
    case len(type_name) < 2 of {
        true -> 1;
        false -> case substring(type_name, 0, 1) == "(" of {
            true -> 1 + count_top_level_commas(substring(type_name, 1, len(type_name) - 1), 0, 0);
            false -> 1
        }
    }
}

fn count_top_level_commas(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> 0;
        false -> case substring(s, i, i + 1) of {
            "(" -> count_top_level_commas(s, i + 1, depth + 1);
            ")" -> count_top_level_commas(s, i + 1, depth - 1);
            "," -> case depth == 0 of {
                true -> 1 + count_top_level_commas(s, i + 1, depth);
                false -> count_top_level_commas(s, i + 1, depth)
            };
            _: string -> count_top_level_commas(s, i + 1, depth)
        }
    }
}

fn flat_alloc_size(count: int64) -> int64 {
    (count + 1) / 2 * 16
}

fn flat_alloc_size_str(count: int64) -> string {
    atom_table@int64_to_decimal_string(flat_alloc_size(count))
}

// Flat layout: one allocation per tuple chain
fn count_tuple_allocations(term: SIRTerm) -> int64 {
    case term.kind == 6 and term.name == "tuple_make" of {
        true -> 1;
        false -> 0
    }
}

fn store_for_type(type_name: string, reg_num: string, offset: string) -> string {
    prefix: string <- case reg_conventions@is_float64_type(type_name) of {
        true -> "D";
        false -> case reg_conventions@is_float32_type(type_name) of {
            true -> "S";
            false -> case reg_conventions@is_narrow_type(type_name) of {
                true -> "W";
                false -> "X"
            }
        }
    };
    reg: string <- concat(prefix, reg_num);
    concat(concat(concat(concat(concat("    STR ", reg), ", [SP, "), offset), "]"), "")
}

fn emit_flat_store(type_name: string, reg_num: string, idx: int64) -> string {
    store_for_type(type_name, reg_num, index_to_offset_int(idx))
}

fn emit_flat_mov_dest(dest: string) -> string {
    dest_ptr: string <- case len(dest) > 0 and substring(dest, 0, 1) == "W" of {
        true -> concat("X", substring(dest, 1, len(dest)));
        false -> dest
    };
    case dest == "SP" of {
        true -> "";
        false -> concat(concat("    MOV ", dest_ptr), ", SP")
    }
}

fn index_to_offset(idx_str: string) -> string {
    concat("#", atom_table@int64_to_decimal_string(string_parse@string_to_int64(idx_str) * 8))
}

fn index_to_offset_int(idx: int64) -> string {
    concat("#", atom_table@int64_to_decimal_string(idx * 8))
}

fn ldr_prefix_for_type(type_name: string) -> string {
    case reg_conventions@is_float64_type(type_name) of {
        true -> "D";
        false -> case reg_conventions@is_float32_type(type_name) of {
            true -> "S";
            false -> case reg_conventions@is_narrow_type(type_name) of {
                true -> "W";
                false -> "X"
            }
        }
    }
}

fn emit_tuple_proj(term: SIRTerm, dest: string) -> string {
    offset_str: string <- index_to_offset(term.right_expr.value);
    prefix: string <- ldr_prefix_for_type(term.type_name);
    dest_num: string <- case len(dest) > 0 of {
        true -> substring(dest, 1, len(dest));
        false -> "0"
    };
    ldr_reg: string <- concat(prefix, dest_num);
    concat(concat(concat(concat("    LDR ", ldr_reg), ", [SP, "), offset_str), "]")
}

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    case term.name of {
        "tuple_proj" -> emit_tuple_proj(term, dest);
        _: string -> concat(concat("    ; unsupported tuple prim: ", term.name), "")
    }
}
