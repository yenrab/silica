// float16 prim emission: negate (built-in negate_float16/1 -> prim neg). H registers, FNEG.
// Other float16 prims are not in the emitter yet.

use sir_ast;
use arithmetic;

export emit_prim_op/2;

fn dest_to_h_reg(dest: string) -> string {
    case dest of {
        "X0" -> "H0";
        "X1" -> "H1";
        "X2" -> "H2";
        "H0" -> "H0";
        "H1" -> "H1";
        "H2" -> "H2";
        _: string -> dest
    }
}

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    dest_reg: string <- dest_to_h_reg(dest);
    case term.name of {
        "neg" -> arithmetic@emit_fneg_h_op(dest_reg);
        _: string -> concat("    ; unsupported float16 prim: ", term.name)
    }
}
