// float16 prim emission: negate, compares, eq/ne. H registers; FCMP+CSET for bool results.

use sir_ast;
use arithmetic;
use comparison;

export emit_prim_op/2;

fn dest_to_h_reg(dest: string) -> string {
    case len(dest) > 0 and substring(dest, 0, 1) == "X" of {
        true -> concat("H", substring(dest, 1, len(dest)));
        false -> dest
    }
}

fn emit_prim_op(term: SIRTerm, dest: string) -> string {
    dest_reg: string <- dest_to_h_reg(dest);
    case term.name of {
        "neg" -> arithmetic@emit_fneg_h_op(dest_reg);
        "add" -> arithmetic@emit_fadd_h_op(dest_reg);
        "sub" -> arithmetic@emit_fsub_h_op(dest_reg);
        "mul" -> arithmetic@emit_fmul_h_op(dest_reg);
        "div" -> arithmetic@emit_fdiv_h_op(dest_reg);
        "lt" -> comparison@emit_fcmp_lt_op(dest_reg, "H");
        "gt" -> comparison@emit_fcmp_gt_op(dest_reg, "H");
        "le" -> comparison@emit_fcmp_le_op(dest_reg, "H");
        "ge" -> comparison@emit_fcmp_ge_op(dest_reg, "H");
        "eq" -> comparison@emit_fcmp_eq_op(dest_reg, "H");
        "nq" -> comparison@emit_fcmp_ne_op(dest_reg, "H");
        _: string -> concat("    ; unsupported float16 prim: ", term.name)
    }
}
