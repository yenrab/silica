// Inline emission for print_float64 built-in.
// Always uses L_pf64_helper: const loads from L_f64_N, var has arg in D0.

use sir_ast;
use atom_table;
use emitter_effects;

export emit_print_float64_var/3;
export emit_print_float64_helper/0;

fn emit_print_float64_var(term: SIRTerm, dest: string, _table: AtomTable) -> string {
    call_effects: string <- term.value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    bl_line: string <- "    BL L_pf64_helper\n";
    mov_ret: string <- concat(concat("    MOV ", dest), ", #0\n");
    with_comment: string <- concat(comment_line, bl_line);
    with_ret: string <- concat(with_comment, mov_ret);
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

// L_pf64_helper: D0 = float64 to print. Converts to string on stack, write(2).
// Integer part: FCVTZS, digit loop. Fractional part: frac*=10 loop (up to 15 digits).
fn emit_print_float64_helper() -> string {
    "L_pf64_helper:\n    SUB SP, SP, #64\n    STR D0, [SP, #0]\n    FCMP D0, #0.0\n    B.ge L_pf64_pos\n    MOV X0, #1\n    ADRP X1, L_pf64_minus@PAGE\n    ADD X1, X1, L_pf64_minus@PAGEOFF\n    MOV X2, #1\n    MOV X16, #4\n    SVC #0x80\n    LDR D0, [SP, #0]\n    FNEG D0, D0\n    STR D0, [SP, #0]\nL_pf64_pos:\n    FCVTZS X0, D0\n    MOV X10, SP\n    ADD X10, X10, #48\n    MOV X11, #0\n    CMP X0, #0\n    B.ge L_pf64_ipos\n    MOV X11, #1\n    NEG X0, X0\nL_pf64_ipos:\n    MOV X8, X10\n    CMP X0, #0\n    B.eq L_pf64_izero\n    MOV X9, #10\nL_pf64_iloop:\n    UDIV X1, X0, X9\n    MSUB X2, X1, X9, X0\n    ADD X2, X2, #48\n    SUB X8, X8, #1\n    STRB W2, [X8]\n    MOV X0, X1\n    CBNZ X0, L_pf64_iloop\n    B L_pf64_imaybe_neg\nL_pf64_izero:\n    SUB X8, X8, #1\n    MOV X1, #48\n    STRB W1, [X8]\nL_pf64_imaybe_neg:\n    CBNZ X11, L_pf64_iprepend_minus\n    B L_pf64_ido_int\nL_pf64_iprepend_minus:\n    SUB X8, X8, #1\n    MOV X1, #45\n    STRB W1, [X8]\nL_pf64_ido_int:\n    SUB X2, X10, X8\n    MOV X0, #1\n    MOV X1, X8\n    MOV X16, #4\n    SVC #0x80\n    LDR D0, [SP, #0]\n    FRINTZ D1, D0\n    FSUB D2, D0, D1\n    ADRP X8, L_pf64_10@PAGE\n    LDR D3, [X8, L_pf64_10@PAGEOFF]\n    MOV X12, #15\n    MOV X9, X10\n    SUB X9, X9, #15\n    MOV X8, X9\nL_pf64_frac_loop:\n    CBZ X12, L_pf64_frac_done\n    FMUL D2, D2, D3\n    FCVTZS X0, D2\n    ADD X2, X0, #48\n    STRB W2, [X8]\n    ADD X8, X8, #1\n    SCVTF D4, X0\n    FSUB D2, D2, D4\n    SUB X12, X12, #1\n    FCMP D2, #0.0\n    B.eq L_pf64_frac_done\n    B L_pf64_frac_loop\nL_pf64_frac_done:\n    SUB X9, X9, #1\n    MOV X1, #46\n    STRB W1, [X9]\n    SUB X2, X8, X9\n    MOV X0, #1\n    MOV X1, X9\n    MOV X16, #4\n    SVC #0x80\n    ADD SP, SP, #64\n    RET"
}
