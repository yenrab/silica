// Runtime helpers for FFI string in/out (Phase 8). Linked once per executable using foreign calls.

export emit_ffi_foreign_runtime_helpers/0;

fn emit_ffi_foreign_runtime_helpers() -> string {
    // All three helpers are heap-isolated: no stack-pointer manipulation visible to callers.
    //   _silica_rt_ffi_string_in:  X0 = Silica string handle -> X0 = malloc'd C-style buffer,
    //                              X1 = byte length, X2 = same as X0 (so caller can BL _free X2).
    //   _silica_rt_ffi_string_from_bytes: X0 = byte ptr, X1 = byte len -> X0 = malloc'd Silica
    //                              string handle (NUL-terminated), or 0 on OOM/empty.
    //   _silica_rt_ffi_string_out_and_free: X0 = sret heap ptr (32 bytes: tag@0, text_ptr@8,
    //                              text_len@16, error_code@24) -> X0 = malloc'd Silica string
    //                              handle (or 0 on tag != 0 / empty). Frees text_ptr field and
    //                              the sret heap block itself.
    helper_in: string <- "_silica_rt_ffi_string_in:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    STP X21, X22, [SP, #-16]!\n    MOV X19, X0\n    CBZ X19, L_ffi_in_empty\n    LDRB W9, [X19]\n    CMP W9, #0xFF\n    B.NE L_ffi_in_cstr\n    LDR X9, [X19]\n    MOV X10, #-1\n    CMP X9, X10\n    B.NE L_ffi_in_cstr\n    LDR X21, [X19, #8]\n    LDR X22, [X19, #16]\n    B L_ffi_in_have_src\nL_ffi_in_cstr:\n    MOV X21, X19\n    MOV X22, #0\n    MOV X9, X19\nL_ffi_in_clen:\n    LDRB W10, [X9], #1\n    CBZ W10, L_ffi_in_have_src\n    ADD X22, X22, #1\n    B L_ffi_in_clen\nL_ffi_in_empty:\n    MOV X21, #0\n    MOV X22, #0\nL_ffi_in_have_src:\n    ADD X0, X22, #1\n    BL _malloc\n    CBZ X0, L_ffi_in_oom\n    CBZ X22, L_ffi_in_done\n    MOV X9, X0\n    MOV X10, X21\n    MOV X11, X22\nL_ffi_in_cp:\n    LDRB W12, [X10], #1\n    STRB W12, [X9], #1\n    SUBS X11, X11, #1\n    B.NE L_ffi_in_cp\nL_ffi_in_done:\n    MOV X1, X22\n    MOV X2, X0\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nL_ffi_in_oom:\n    MOV X0, #0\n    MOV X1, #0\n    MOV X2, #0\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\n";
    helper_from: string <- "_silica_rt_ffi_string_from_bytes:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    MOV X19, X0\n    MOV X20, X1\n    CBZ X20, L_ffi_from_empty\n    ADD X0, X20, #1\n    BL _malloc\n    CBZ X0, L_ffi_from_empty\n    MOV X9, X0\n    MOV X10, X19\n    MOV X11, X20\nL_ffi_from_cp:\n    CBZ X11, L_ffi_from_nul\n    LDRB W12, [X10], #1\n    STRB W12, [X9], #1\n    SUB X11, X11, #1\n    B L_ffi_from_cp\nL_ffi_from_nul:\n    STRB WZR, [X9]\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nL_ffi_from_empty:\n    MOV X0, #0\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\n";
    helper_out: string <- "_silica_rt_ffi_string_out_and_free:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    CBZ X0, L_ffi_out_no_sret\n    MOV X19, X0\n    LDR X9, [X19, #0]\n    CBNZ X9, L_ffi_out_err\n    LDR X0, [X19, #8]\n    LDR X1, [X19, #16]\n    BL _silica_rt_ffi_string_from_bytes\n    MOV X20, X0\n    LDR X0, [X19, #8]\n    CBZ X0, L_ffi_out_no_cfree\n    BL _free\nL_ffi_out_no_cfree:\n    MOV X0, X19\n    BL _free\n    MOV X0, X20\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nL_ffi_out_err:\n    LDR X0, [X19, #8]\n    CBZ X0, L_ffi_out_err_skip\n    BL _free\nL_ffi_out_err_skip:\n    MOV X0, X19\n    BL _free\n    MOV X0, #0\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nL_ffi_out_no_sret:\n    MOV X0, #0\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\n";
    concat(concat(helper_in, helper_from), helper_out)
}
