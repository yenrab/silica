// Const dispatcher: case term.type_name -> type-specific emit
// String is handled in term_emitter (emit_string_const) - not dispatched here

use sir_ast;
use const_int64;
use const_uint64;
use const_float64;
use const_float32;
use const_bool;
use const_atom;
use const_unit;
use const_default;

export emit_const/6;

fn emit_const(term: SIRTerm, dest: string, table: AtomTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable) -> string {
    case term.type_name of {
        "int64" -> case len(dest) > 0 and substring(dest, 0, 1) == "S" of {
            true -> const_float32@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
            false -> case len(dest) > 0 and substring(dest, 0, 1) == "D" of {
                true -> const_float64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
                false -> const_int64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table)
            }
        };
        "uint64" -> const_uint64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
        "float64" -> const_float64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
        "float32" -> const_float32@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
        "float" -> const_float32@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
        "bool" -> const_bool@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
        "atom" -> const_atom@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
        "unit" -> const_unit@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
        "fn_ptr" -> do
            label: string <- term.value;
            // ADRP/ADD only accept X/W general-purpose regs, never D/S — load address in X8 then copy to dest.
            adrp: string <- concat(concat(concat("    ADRP X8, ", label), "@PAGE"), "\n");
            add_line: string <- concat(concat(concat("    ADD X8, X8, ", label), "@PAGEOFF"), "\n");
            core: string <- concat(adrp, add_line);
            case dest == "X8" of {
                true -> core;
                false -> do
                    d0: string <- substring(dest, 0, 1);
                    case d0 == "D" or d0 == "S" of {
                        true -> concat(core, concat(concat("    FMOV ", dest), ", X8\n"));
                        false -> concat(core, concat(concat("    MOV ", dest), ", X8\n"))
                    }
                end
            }
        end;
        _: string -> case len(dest) > 0 of {
            true -> case substring(dest, 0, 1) == "S" of {
                true -> const_float32@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
                false -> case substring(dest, 0, 1) == "D" of {
                    true -> const_float64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table);
                    false -> const_default@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table)
                }
            };
            false -> const_default@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table)
        }
    }
}
