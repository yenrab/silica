// call term emission (SIRTerm kind 4)
// sir_emitter_pattern_spec §7.4: call -> BLR callee; result in X0
// Effect-aware: barriers before/after effectful calls per spec §9.1.1 Effect-to-Barrier Mapping
//   device_io: no barriers (syscall-based; kernel handles ordering)
//   register_rwr: DSB SY before, ISB after (direct mmap device access)
//   mem(atomic): DMB ISH before and after (cross-core visibility)
// term_emitter emits arg to X0 before calling; this emits barriers + BLR

use sir_ast;
use emitter_effects;
use control;
use module_linkage;

export emit_call_body/3;
export emit_call_body_effects/4;
export emit_call_body_with_callee/3;
export emit_tail_call_body/3;

fn emit_call_body_effects(term: SIRTerm, dest: string, effect_value: string, outer_reg: string) -> string {
    call_effects: string <- effect_value;
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    callee: string <- module_linkage@asm_linkage_symbol_for_call(outer_reg, term.name);
    adrp_part: string <- concat(concat(concat("    ADRP X9, ", callee), "@PAGE"), "\n");
    add_part: string <- concat(concat(concat("    ADD X9, X9, ", callee), "@PAGEOFF"), "\n");
    adrp_line: string <- concat(concat(adrp_part, add_part), "    BLR X9");
    // No move when result already in dest: X0/W0 (int), D0 (float64), S0 (float32)
    result_mov: string <- case dest == "X0" of {
        true -> "";
        false -> case len(dest) > 0 of {
            true -> case substring(dest, 0, 1) == "W" or substring(dest, 0, 1) == "D" or substring(dest, 0, 1) == "S" or substring(dest, 0, 1) == "H" of {
                true -> "";
                false -> concat("\n", concat(concat(concat("    MOV ", dest), ", X0"), ""))
            };
            false -> ""
        }
    };
    with_comment: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(with_comment, concat(pre_barrier, concat("\n", adrp_line)));
        false -> concat(with_comment, adrp_line)
    };
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_pre, concat("\n", post_barrier));
        false -> with_pre
    };
    concat(with_post, result_mov)
}

fn emit_call_body(term: SIRTerm, dest: string, outer_reg: string) -> string {
    emit_call_body_effects(term, dest, term.value, outer_reg)
}

// Tail call (SIRTerm kind 5): args already in registers — release frame, then BR (no BLR / no return to this frame).
// recursion_implementation.md Phase 5: native tail transfer; fn_effects controls DMB+LDP like epilogue (atomic release).
fn emit_tail_call_body(term: SIRTerm, fn_effects: string, outer_reg: string) -> string {
    call_effects: string <- term.value;
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    callee: string <- module_linkage@asm_linkage_symbol_for_call(outer_reg, term.name);
    adrp_part: string <- concat(concat(concat("    ADRP X9, ", callee), "@PAGE"), "\n");
    add_part: string <- concat(concat(concat("    ADD X9, X9, ", callee), "@PAGEOFF"), "\n");
    br_line: string <- concat(concat(adrp_part, add_part), "    BR X9");
    frame_rel: string <- control@function_tail_frame_release(fn_effects);
    with_comment: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(with_comment, concat(pre_barrier, concat("\n", frame_rel)));
        false -> concat(with_comment, frame_rel)
    };
    concat(with_pre, concat("\n", br_line))
}

// Emit call with explicit callee symbol (e.g. silica_print_float64 for print_float64).
fn emit_call_body_with_callee(term: SIRTerm, dest: string, callee: string) -> string {
    call_effects: string <- term.value;
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    adrp_part: string <- concat(concat(concat("    ADRP X9, ", callee), "@PAGE"), "\n");
    add_part: string <- concat(concat(concat("    ADD X9, X9, ", callee), "@PAGEOFF"), "\n");
    adrp_line: string <- concat(concat(adrp_part, add_part), "    BLR X9");
    // No move when result already in dest: X0/W0 (int), D0/S0/H0 (float)
    result_mov: string <- case dest == "X0" of {
        true -> "";
        false -> case len(dest) > 0 of {
            true -> case substring(dest, 0, 1) == "W" or substring(dest, 0, 1) == "D" or substring(dest, 0, 1) == "S" or substring(dest, 0, 1) == "H" of {
                true -> "";
                false -> concat("\n", concat(concat(concat("    MOV ", dest), ", X0"), ""))
            };
            false -> ""
        }
    };
    with_comment: string <- case len(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    with_pre: string <- case len(pre_barrier) > 0 of {
        true -> concat(with_comment, concat(pre_barrier, concat("\n", adrp_line)));
        false -> concat(with_comment, adrp_line)
    };
    with_post: string <- case len(post_barrier) > 0 of {
        true -> concat(with_pre, concat("\n", post_barrier));
        false -> with_pre
    };
    concat(with_post, result_mov)
}
