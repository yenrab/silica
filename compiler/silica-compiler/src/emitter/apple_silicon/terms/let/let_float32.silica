// float32 let: rhs_reg computation for RHS type float32
// S registers: S0, S1, S2

use sir_ast;

export compute_rhs_reg_in_let/5;
export compute_rhs_reg_top_level/3;

fn compute_rhs_reg_in_let(term: SIRTerm, dest: string, bound_name: string, bound_reg: string, outer_reg: string) -> string {
    case term.inner.kind != 0 and (term.right_expr.kind == 4 or (term.right_expr.kind == 1 and term.right_expr.name == term.name)) of {
        true -> dest;
        false -> case bound_reg == "S0" of {
            true -> "S1";
            false -> case bound_reg == "S1" of {
                true -> "S2";
                false -> "S0"
            }
        }
    }
}

fn compute_rhs_reg_top_level(term: SIRTerm, bound_reg: string, dest: string) -> string {
    "S0"
}
