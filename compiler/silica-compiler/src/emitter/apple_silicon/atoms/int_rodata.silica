                false -> term_has_int32_signed_print_var(term.right_expr)
            };
            8 -> case term_has_int32_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int32_signed_print_var(term.right_expr)
            };
            6 -> case term_has_int32_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int32_signed_print_var(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn term_has_int16_signed_print_var(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            4 -> case term.name == "main.print_int16" of {
                true -> term.inner.kind != 0;
                false -> false
            };
            2 -> case term_has_int16_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int16_signed_print_var(term.right_expr)
            };
            3 -> case term_has_int16_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int16_signed_print_var(term.right_expr)
            };
            7 -> case term_has_int16_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int16_signed_print_var(term.right_expr)
            };
            8 -> case term_has_int16_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int16_signed_print_var(term.right_expr)
            };
            6 -> case term_has_int16_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int16_signed_print_var(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn term_has_int8_signed_print_var(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            4 -> case term.name == "main.print_int8" of {
                true -> term.inner.kind != 0;
                false -> false
            };
            2 -> case term_has_int8_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int8_signed_print_var(term.right_expr)
            };
            3 -> case term_has_int8_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int8_signed_print_var(term.right_expr)
            };
            7 -> case term_has_int8_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int8_signed_print_var(term.right_expr)
            };
            8 -> case term_has_int8_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int8_signed_print_var(term.right_expr)
            };
            6 -> case term_has_int8_signed_print_var(term.inner) of {
                true -> true;
                false -> term_has_int8_signed_print_var(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

fn signed_print_var_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_int64_signed_print_var(fns.head.body) of {
            true -> true;
            false -> case term_has_int32_signed_print_var(fns.head.body) of {
                true -> true;
                false -> case term_has_int16_signed_print_var(fns.head.body) of {
                    true -> true;
                    false -> case term_has_int8_signed_print_var(fns.head.body) of {
                        true -> true;
                        false -> signed_print_var_in_functions(fns.tail)
                    }
                }
            }
        }
    }
}

fn module_uses_signed_print_var(sir_module: SIRModule) -> bool {
    signed_print_var_in_functions(sir_module.functions)
}
