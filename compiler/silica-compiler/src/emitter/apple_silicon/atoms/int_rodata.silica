// Integer print rodata: collect unique int/uint literal values from print_int64/print_int32/print_int16/print_int8
// Emit .rodata section with L_pi_N, L_pi32_N, L_pi16_N, L_pi8_N labels for inline write(2) emission
// Uses .byte to avoid bootstrap compiler issues with escaped quotes in strings

use sir_ast;
use bst;
use atom_table;

export Int64PrintTable/0;
export Int32PrintTable/0;
export Int16PrintTable/0;
export Int8PrintTable/0;
export build_int64_print_table/1;
export build_int32_print_table/1;
export build_int16_print_table/1;
export build_int8_print_table/1;
export int64_value_to_index/2;
export int32_value_to_index/2;
export int16_value_to_index/2;
export int8_value_to_index/2;
export emit_int64_rodata_section/1;
export emit_int32_rodata_section/1;
export emit_int16_rodata_section/1;
export emit_int8_rodata_section/1;
export module_uses_int64_print/1;
export module_uses_int32_print/1;
export module_uses_int16_print/1;
export module_uses_int8_print/1;
export module_uses_int64_print_var/1;
export module_uses_int32_print_var/1;
export module_uses_int16_print_var/1;
export module_uses_int8_print_var/1;
export module_uses_uint64_print_var/1;
export module_uses_uint32_print_var/1;
export module_uses_uint16_print_var/1;
export module_uses_uint8_print_var/1;
export module_uses_signed_print_var/1;
export debug_int64_table_lookups/1;
export emit_one_value_string/3;

struct ListIntPrintValue {
    is_nil: bool,
    head: string,
    tail: ListIntPrintValue
}

struct Int64PrintTable {
    is_empty: bool,
    root: BstNode,
    values: ListIntPrintValue
}

struct Int32PrintTable {
    is_empty: bool,
    root: BstNode,
    values: ListIntPrintValue
}

struct Int16PrintTable {
    is_empty: bool,
    root: BstNode,
    values: ListIntPrintValue
}

struct Int8PrintTable {
    is_empty: bool,
    root: BstNode,
    values: ListIntPrintValue
}

fn nil_values() -> ListIntPrintValue {
    ph: ListIntPrintValue <- ListIntPrintValue { is_nil: true, head: "", tail: ph };
    ph
}

fn cons_value(s: string, t: ListIntPrintValue) -> ListIntPrintValue {
    ListIntPrintValue { is_nil: false, head: s, tail: t }
}

fn empty_int64_table() -> Int64PrintTable {
    Int64PrintTable { is_empty: true, root: bst@empty_node(), values: nil_values() }
}

fn empty_int32_table() -> Int32PrintTable {
    Int32PrintTable { is_empty: true, root: bst@empty_node(), values: nil_values() }
}

fn empty_int16_table() -> Int16PrintTable {
    Int16PrintTable { is_empty: true, root: bst@empty_node(), values: nil_values() }
}

fn empty_int8_table() -> Int8PrintTable {
    Int8PrintTable { is_empty: true, root: bst@empty_node(), values: nil_values() }
}

fn add_value_int64(table: Int64PrintTable, value: string, next_index: int64) -> (Int64PrintTable, int64) {
    case table.is_empty of {
        true -> do
            (root: BstNode, idx: int64) <- bst@bst_insert(bst@empty_node(), value, next_index);
            new_values: ListIntPrintValue <- case idx == next_index of {
                true -> cons_value(value, table.values);
                false -> table.values
            };
            (Int64PrintTable { is_empty: false, root: root, values: new_values }, idx)
        end;
        false -> do
            (new_root: BstNode, idx: int64) <- bst@bst_insert(table.root, value, next_index);
            new_values: ListIntPrintValue <- case idx == next_index of {
                true -> cons_value(value, table.values);
                false -> table.values
            };
            (Int64PrintTable { is_empty: false, root: new_root, values: new_values }, idx)
        end
    }
}

