fn int64_print_in_functions(fns: ListSIRFunction) -> bool {
    case fns.is_nil of {
        true -> false;
        false -> case term_has_int64_print(fns.head.body) of {
            true -> true;
            false -> int64_print_in_functions(fns.tail)
        }
    }
}

