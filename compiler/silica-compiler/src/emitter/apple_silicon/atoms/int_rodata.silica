fn int64_value_to_index(table: Int64PrintTable, value: string) -> int64 {
    case table.is_empty of {
        true -> 0 - 1;
        false -> bst@bst_lookup(table.root, value)
    }
}

fn debug_int64_values_acc(values: ListIntPrintValue, table: Int64PrintTable, pos: int64, acc: string) -> string {
    case values.is_nil of {
        true -> acc;
        false -> do
            v: string <- values.head;
            idx: int64 <- bst@bst_lookup(table.root, v);
            pos_str: string <- atom_table@int64_to_decimal_string(pos);
            idx_str: string <- atom_table@int64_to_decimal_string(idx);
            entry: string <- concat(concat(concat(concat(concat(concat(" val=", v), " pos="), pos_str), " lookup="), idx_str), ",");
            debug_int64_values_acc(values.tail, table, pos + 1, concat(acc, entry))
        end
    }
}

fn debug_int64_table_lookups(table: Int64PrintTable) -> string {
    case table.is_empty of {
        true -> "";
        false -> do
            in_order: ListIntPrintValue <- reverse_values(table.values);
            body: string <- debug_int64_values_acc(in_order, table, 0, "    ; DEBUG table:");
            struct_line: string <- concat(concat("    ; DEBUG bst struct: ", bst@bst_debug_structure(table.root)), "\n");
            lookup1: string <- concat(concat("    ; DEBUG bst ", bst@bst_debug_lookup_path(table.root, "1")), "\n");
            lookup2: string <- concat(concat("    ; DEBUG bst ", bst@bst_debug_lookup_path(table.root, "2")), "\n");
            cmp12: string <- concat(concat("    ; DEBUG bst ", bst@bst_debug_string_compare("1", "2")), "\n");
            cmp21: string <- concat(concat("    ; DEBUG bst ", bst@bst_debug_string_compare("2", "1")), "\n");
            concat(concat(concat(concat(concat(concat(body, "\n"), struct_line), concat(lookup1, lookup2)), cmp12), cmp21), "")
        end
    }
}

fn int32_value_to_index(table: Int32PrintTable, value: string) -> int64 {
    case table.is_empty of {
        true -> 0 - 1;
        false -> bst@bst_lookup(table.root, value)
