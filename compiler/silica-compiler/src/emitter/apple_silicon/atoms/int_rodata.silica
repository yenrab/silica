fn build_int64_print_table(sir_module: SIRModule) -> Int64PrintTable {
    (table: Int64PrintTable, _: int64) <- collect_int64_from_functions(sir_module.functions, empty_int64_table(), 0);
    table
}

fn build_int32_print_table(sir_module: SIRModule) -> Int32PrintTable {
    (table: Int32PrintTable, _: int64) <- collect_int32_from_functions(sir_module.functions, empty_int32_table(), 0);
