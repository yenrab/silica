fn collect_int64_from_functions(fns: ListSIRFunction, table: Int64PrintTable, next_index: int64) -> (Int64PrintTable, int64) {
    case fns.is_nil of {
        true -> (table, next_index);
        false -> do
            (t1: Int64PrintTable, i1: int64) <- collect_int64_from_term(fns.head.body, table, next_index);
            collect_int64_from_functions(fns.tail, t1, i1)
        end
    }
}

fn collect_int32_from_functions(fns: ListSIRFunction, table: Int32PrintTable, next_index: int64) -> (Int32PrintTable, int64) {
