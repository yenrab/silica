fn term_has_int64_print(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            4 -> term.name == "main.print_int64" or term.name == "main.print_uint64";
            2 -> case term_has_int64_print(term.inner) of {
                true -> true;
                false -> term_has_int64_print(term.right_expr)
            };
            3 -> case term_has_int64_print(term.inner) of {
                true -> true;
                false -> term_has_int64_print(term.right_expr)
            };
            7 -> case term_has_int64_print(term.inner) of {
                true -> true;
                false -> term_has_int64_print(term.right_expr)
            };
            8 -> case term_has_int64_print(term.inner) of {
                true -> true;
                false -> term_has_int64_print(term.right_expr)
            };
            6 -> case term_has_int64_print(term.inner) of {
                true -> true;
                false -> term_has_int64_print(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

