fn build_int8_print_table(sir_module: SIRModule) -> Int8PrintTable {
    (table: Int8PrintTable, _: int64) <- collect_int8_from_functions(sir_module.functions, empty_int8_table(), 0);
    table
}

fn emit_int64_rodata_section(table: Int64PrintTable) -> string {
    case table.is_empty of {
        true -> "";
        false -> do
            header: string <- ".section __TEXT,__rodata\n.align\t8\n";
            in_order: ListIntPrintValue <- reverse_values(table.values);
            body: string <- emit_int64_values_rodata(in_order, 0, "L_pi");
            concat(header, body)
        end
    }
}

fn emit_int32_rodata_section(table: Int32PrintTable) -> string {
    case table.is_empty of {
