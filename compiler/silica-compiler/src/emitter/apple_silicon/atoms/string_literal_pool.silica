// String literal pool: collect string constants for .rodata
// Emit .rodata section with L_str_N labels; const emitter uses ADRP+LDR for string pointers
// Uses .ascii directives with raw UTF-8 bytes for full Unicode support
// List-based deduplication with string equality (not BST) so Unicode/UTF-8 works correctly.

use sir_ast;
use atom_table;

export StringLiteralTable/0;
export build_string_literal_table/1;
export string_literal_value_to_index/2;
export emit_string_literal_rodata_section/1;
export module_uses_string_literal_pool/1;

struct ListStringLiteralValue {
    is_nil: bool,
    head: string,
    tail: ListStringLiteralValue
}

struct StringLiteralTable {
    is_empty: bool,
    values: ListStringLiteralValue
}

fn nil_str_literal_values() -> ListStringLiteralValue {
    ph: ListStringLiteralValue <- ListStringLiteralValue { is_nil: true, head: "", tail: ph };
    ph
}

fn cons_str_literal_value(s: string, t: ListStringLiteralValue) -> ListStringLiteralValue {
    ListStringLiteralValue { is_nil: false, head: s, tail: t }
}

fn empty_string_literal_table() -> StringLiteralTable {
    StringLiteralTable { is_empty: true, values: nil_str_literal_values() }
}

fn find_index_in_list(list: ListStringLiteralValue, value: string, pos: int64) -> int64 {
    case list.is_nil of {
        true -> 0 - 1;
        false -> case list.head == value of {
            true -> pos;
            false -> find_index_in_list(list.tail, value, pos + 1)
        }
    }
}

fn add_str_value(table: StringLiteralTable, value: string, next_index: int64) -> (StringLiteralTable, int64) {
    in_order: ListStringLiteralValue <- reverse_str_values(table.values);
    existing: int64 <- find_index_in_list(in_order, value, 0);
    case existing >= 0 of {
        true -> (table, existing);
        false -> do
            new_values: ListStringLiteralValue <- cons_str_literal_value(value, table.values);
            new_table: StringLiteralTable <- StringLiteralTable { is_empty: false, values: new_values };
            (new_table, next_index)
        end
    }
}

fn string_literal_value_to_index(table: StringLiteralTable, value: string) -> int64 {
    case table.is_empty of {
        true -> 0 - 1;
        false -> do
            in_order: ListStringLiteralValue <- reverse_str_values(table.values);
            find_index_in_list(in_order, value, 0)
        end
    }
}

// Case branch (kind 8): add string pattern text to pool; collect guard and body.
fn collect_string_literal_from_case_branch(branch: SIRTerm, table: StringLiteralTable, next_index: int64) -> (StringLiteralTable, int64) {
    case branch.kind < 0 of {
        true -> (table, next_index);
        false -> case branch.kind == 8 of {
            true -> do
                (t1: StringLiteralTable, i1: int64) <- case branch.value == "string" of {
                    true -> do
                        (tbl: StringLiteralTable, idx: int64) <- add_str_value(table, branch.name, next_index);
                        new_next: int64 <- case idx == next_index of { true -> next_index + 1; false -> next_index };
                        (tbl, new_next)
                    end;
                    false -> (table, next_index)
                };
                (t2: StringLiteralTable, i2: int64) <- collect_string_literal_from_term(branch.inner, t1, i1);
                collect_string_literal_from_term(branch.right_expr, t2, i2)
            end;
            false -> collect_string_literal_from_term(branch, table, next_index)
        }
    }
}

// Case branch list (kind 7): inner = branch, right_expr = rest of list or dummy.
fn collect_string_literal_from_case_branch_list(seq: SIRTerm, table: StringLiteralTable, next_index: int64) -> (StringLiteralTable, int64) {
    case seq.kind < 0 of {
        true -> (table, next_index);
        false -> case seq.kind == 7 of {
            true -> do
                (t1: StringLiteralTable, i1: int64) <- collect_string_literal_from_case_branch(seq.inner, table, next_index);
                collect_string_literal_from_case_branch_list(seq.right_expr, t1, i1)
            end;
            false -> (table, next_index)
        }
    }
}

fn collect_string_literal_from_term(term: SIRTerm, table: StringLiteralTable, next_index: int64) -> (StringLiteralTable, int64) {
    case term.kind < 0 of {
        true -> (table, next_index);
        false -> case term.kind of {
            0 -> case term.type_name == "string" of {
                true -> do
                    (t: StringLiteralTable, i: int64) <- add_str_value(table, term.value, next_index);
                    new_next: int64 <- case i == next_index of {
                        true -> next_index + 1;
                        false -> next_index
                    };
                    (t, new_next)
                end;
                false -> (table, next_index)
            };
            1 -> (table, next_index);
            2 -> do
                (t1: StringLiteralTable, i1: int64) <- collect_string_literal_from_term(term.inner, table, next_index);
                (t2: StringLiteralTable, i2: int64) <- collect_string_literal_from_term(term.right_expr, t1, i1);
                (t2, i2)
            end;
            3 -> do
                (t1: StringLiteralTable, i1: int64) <- collect_string_literal_from_term(term.inner, table, next_index);
                collect_string_literal_from_case_branch_list(term.right_expr, t1, i1)
            end;
            4 -> case term.name == "main.println" of {
                true -> do
                    (t1: StringLiteralTable, i1: int64) <- collect_string_literal_from_term(term.inner, table, next_index);
                    (t2: StringLiteralTable, i2: int64) <- add_str_value(t1, "\n", i1);
                    new_next: int64 <- case i2 == i1 of { true -> i1 + 1; false -> i1 };
                    (t2, new_next)
                end;
                false -> do
                    (t1: StringLiteralTable, i1: int64) <- collect_string_literal_from_term(term.inner, table, next_index);
                    collect_string_literal_from_term(term.right_expr, t1, i1)
                end
            };
            6 -> do
                (t1: StringLiteralTable, i1: int64) <- collect_string_literal_from_term(term.inner, table, next_index);
                (t2: StringLiteralTable, i2: int64) <- collect_string_literal_from_term(term.right_expr, t1, i1);
                (t2, i2)
            end;
            _: int64 -> (table, next_index)
        }
    }
}

fn collect_string_literal_from_functions(fns: ListSIRFunction, table: StringLiteralTable, next_index: int64) -> (StringLiteralTable, int64) {
    case fns.is_nil of {
        true -> (table, next_index);
        false -> do
            (t1: StringLiteralTable, i1: int64) <- collect_string_literal_from_term(fns.head.body, table, next_index);
            collect_string_literal_from_functions(fns.tail, t1, i1)
        end
    }
}

fn build_string_literal_table(sir_module: SIRModule) -> StringLiteralTable {
    (table: StringLiteralTable, _: int64) <- collect_string_literal_from_functions(sir_module.functions, empty_string_literal_table(), 0);
    table
}

fn rev_str_values_acc(values: ListStringLiteralValue, acc: ListStringLiteralValue) -> ListStringLiteralValue {
    case values.is_nil of {
        true -> acc;
        false -> rev_str_values_acc(values.tail, cons_str_literal_value(values.head, acc))
    }
}

fn reverse_str_values(values: ListStringLiteralValue) -> ListStringLiteralValue {
    rev_str_values_acc(values, nil_str_literal_values())
}

// Escape a single byte for use inside an assembler .ascii directive.
// Only assembler-interpreted characters need escaping; all other bytes
// (including multi-byte UTF-8 continuation bytes > 0x7F) pass through as-is.
fn escape_char_for_ascii(c: string) -> string {
    case c of {
        "\n" -> "\\n";
        "\t" -> "\\t";
        "\r" -> "\\r";
        "\"" -> "\\\"";
        "\\" -> "\\\\";
        _: string -> c
    }
}

fn escape_string_for_ascii(content: string, pos: int64, acc: string) -> string {
    case pos >= len(content) of {
        true -> acc;
        false -> do
            c: string <- substring(content, pos, pos + 1);
            escaped: string <- escape_char_for_ascii(c);
            escape_string_for_ascii(content, pos + 1, concat(acc, escaped))
        end
    }
}

fn emit_string_literal_values_rodata(values: ListStringLiteralValue, index: int64) -> string {
    case values.is_nil of {
        true -> "";
        false -> do
            rest: string <- emit_string_literal_values_rodata(values.tail, index + 1);
            label_colon: string <- concat(concat(concat("L_str_", atom_table@int64_to_decimal_string(index)), ":"), "\n");
            indent: string <- concat(concat(concat(" ", " "), " "), " ");
            escaped: string <- escape_string_for_ascii(values.head, 0, "");
            ascii_line: string <- concat(concat(concat(indent, ".ascii \""), escaped), "\"\n");
            null_line: string <- concat(indent, ".byte 0");
            one: string <- concat(label_colon, concat(ascii_line, null_line));
            case len(rest) > 0 of {
                true -> concat(concat(one, "\n"), rest);
                false -> concat(one, "\n")
            }
        end
    }
}

fn emit_string_literal_rodata_section(table: StringLiteralTable) -> string {
    case table.is_empty of {
        true -> "";
        false -> do
            header: string <- ".section __TEXT,__rodata\n.align\t8\n";
            in_order: ListStringLiteralValue <- reverse_str_values(table.values);
            body: string <- emit_string_literal_values_rodata(in_order, 0);
            concat(header, body)
        end
    }
}

fn module_uses_string_literal_pool(sir_module: SIRModule) -> bool {
    table: StringLiteralTable <- build_string_literal_table(sir_module);
    case table.is_empty of {
        true -> false;
        false -> true
    }
}
