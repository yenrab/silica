// Int64 literal pool: collect large integer constants (all widths) that don't fit MOV immediate
// Emit .rodata section with L_i64_N labels; const emitter uses LDR for large values

use sir_ast;
use bst;
use atom_table;
use constraints;
use string_parse;

export Int64LiteralTable/0;
export build_int64_literal_table/1;
export int64_literal_value_to_index/2;
export emit_int64_literal_rodata_section/1;
export module_uses_int64_literal_pool/1;

struct ListInt64LiteralValue {
    is_nil: bool,
    head: string,
    tail: ListInt64LiteralValue
}

struct Int64LiteralTable {
    is_empty: bool,
    root: BstNode,
    values: ListInt64LiteralValue
}

fn nil_literal_values() -> ListInt64LiteralValue {
    ph: ListInt64LiteralValue <- ListInt64LiteralValue { is_nil: true, head: "", tail: ph };
    ph
}

fn cons_literal_value(s: string, t: ListInt64LiteralValue) -> ListInt64LiteralValue {
    ListInt64LiteralValue { is_nil: false, head: s, tail: t }
}

fn empty_int64_literal_table() -> Int64LiteralTable {
    Int64LiteralTable { is_empty: true, root: bst@empty_node(), values: nil_literal_values() }
}

fn add_literal_value(table: Int64LiteralTable, value: string, next_index: int64) -> (Int64LiteralTable, int64) {
    case table.is_empty of {
        true -> do
            (root: BstNode, idx: int64) <- bst@bst_insert(bst@empty_node(), value, next_index);
            new_values: ListInt64LiteralValue <- case idx == next_index of {
                true -> cons_literal_value(value, table.values);
                false -> table.values
            };
            (Int64LiteralTable { is_empty: false, root: root, values: new_values }, idx)
        end;
        false -> do
            (new_root: BstNode, idx: int64) <- bst@bst_insert(table.root, value, next_index);
            new_values: ListInt64LiteralValue <- case idx == next_index of {
                true -> cons_literal_value(value, table.values);
                false -> table.values
            };
            (Int64LiteralTable { is_empty: false, root: new_root, values: new_values }, idx)
        end
    }
}

fn int64_literal_value_to_index(table: Int64LiteralTable, value: string) -> int64 {
    case table.is_empty of {
        true -> 0 - 1;
        false -> bst@bst_lookup(table.root, value)
    }
}

fn collect_int64_literal_from_term(term: SIRTerm, table: Int64LiteralTable, next_index: int64) -> (Int64LiteralTable, int64) {
    case term.kind < 0 of {
        true -> (table, next_index);
        false -> case term.kind of {
            0 -> case term.type_name == "int64" or term.type_name == "uint64"
                or term.type_name == "int32" or term.type_name == "uint32"
                or term.type_name == "int16" or term.type_name == "uint16"
                or term.type_name == "int8" or term.type_name == "uint8" of {
                true -> case constraints@fits_mov_imm(string_parse@string_to_int64(term.value)) of {
                    true -> (table, next_index);
                    false -> do
                        (t: Int64LiteralTable, i: int64) <- add_literal_value(table, term.value, next_index);
                        new_next: int64 <- case i == next_index of {
                            true -> next_index + 1;
                            false -> next_index
                        };
                        (t, new_next)
                    end
                };
                false -> (table, next_index)
            };
            1 -> (table, next_index);
            2 -> do
                (t1: Int64LiteralTable, i1: int64) <- collect_int64_literal_from_term(term.inner, table, next_index);
                (t2: Int64LiteralTable, i2: int64) <- collect_int64_literal_from_term(term.right_expr, t1, i1);
                (t2, i2)
            end;
            4 -> do
                (t1: Int64LiteralTable, i1: int64) <- collect_int64_literal_from_term(term.inner, table, next_index);
                collect_int64_literal_from_term(term.right_expr, t1, i1)
            end;
            5 -> do
                (t1: Int64LiteralTable, i1: int64) <- collect_int64_literal_from_term(term.inner, table, next_index);
                collect_int64_literal_from_term(term.right_expr, t1, i1)
            end;
            6 -> do
                (t1: Int64LiteralTable, i1: int64) <- collect_int64_literal_from_term(term.inner, table, next_index);
                (t2: Int64LiteralTable, i2: int64) <- collect_int64_literal_from_term(term.right_expr, t1, i1);
                (t2, i2)
            end;
            _: int64 -> (table, next_index)
        }
    }
}

fn collect_int64_literal_from_functions(fns: ListSIRFunction, table: Int64LiteralTable, next_index: int64) -> (Int64LiteralTable, int64) {
    case fns.is_nil of {
        true -> (table, next_index);
        false -> do
            (t1: Int64LiteralTable, i1: int64) <- collect_int64_literal_from_term(fns.head.body, table, next_index);
            collect_int64_literal_from_functions(fns.tail, t1, i1)
        end
    }
}

fn build_int64_literal_table(sir_module: SIRModule) -> Int64LiteralTable {
    (table: Int64LiteralTable, _: int64) <- collect_int64_literal_from_functions(sir_module.functions, empty_int64_literal_table(), 0);
    table
}

fn rev_literal_values_acc(values: ListInt64LiteralValue, acc: ListInt64LiteralValue) -> ListInt64LiteralValue {
    case values.is_nil of {
        true -> acc;
        false -> rev_literal_values_acc(values.tail, cons_literal_value(values.head, acc))
    }
}

fn reverse_literal_values(values: ListInt64LiteralValue) -> ListInt64LiteralValue {
    rev_literal_values_acc(values, nil_literal_values())
}

fn emit_int64_literal_values_rodata(values: ListInt64LiteralValue, index: int64) -> string {
    case values.is_nil of {
        true -> "";
        false -> do
            rest: string <- emit_int64_literal_values_rodata(values.tail, index + 1);
            label_colon: string <- concat(concat(concat("L_i64_", atom_table@int64_to_decimal_string(index)), ":"), "\n");
            quad_line: string <- concat(concat("    .quad ", values.head), "\n");
            one: string <- concat(label_colon, quad_line);
            case len(rest) > 0 of {
                true -> concat(concat(one, "\n"), rest);
                false -> one
            }
        end
    }
}

fn emit_int64_literal_rodata_section(table: Int64LiteralTable) -> string {
    case table.is_empty of {
        true -> "";
        false -> do
            header: string <- ".section __TEXT,__rodata\n.align\t8\n";
            in_order: ListInt64LiteralValue <- reverse_literal_values(table.values);
            body: string <- emit_int64_literal_values_rodata(in_order, 0);
            concat(header, body)
        end
    }
}

fn module_uses_int64_literal_pool(sir_module: SIRModule) -> bool {
    table: Int64LiteralTable <- build_int64_literal_table(sir_module);
    case table.is_empty of {
        true -> false;
        false -> true
    }
}
