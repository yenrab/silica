// Emitter core: SIRModule -> AArch64 assembly
// Entry point: orchestrates emission of SIR to assembly text

use sir_ast;
use term_emitter;
use control;
use emitter_effects;
use atom_table;
use atom_rodata;
use boolean_rodata;
use int_rodata;
use float64_rodata;
use float32_rodata;
use int64_literal_pool;
use float64_literal_pool;
use float32_literal_pool;
use string_literal_pool;
use print_int64_inline;
use print_bool_inline;
use print_float64_inline;
use print_float32_inline;
use print_string_inline;
use string_rodata;
use prims_string;
use string_concat_mmap_nomte;
use string_substring_mmap_nomte;
use string_length_mmap_nomte;
use string_eq_mmap_nomte;
use prims_memory;
use prims_list;
use prims_tuple;
use reg_conventions;
use prims_actors;
use prims_actors_runtime_asm;
use recursion_support;

export emit_module/1;
export emit_module_debug/2;

// Emit AArch64 assembly for a SIR module.
// Input: SIRModule (from sir_generator, post-optimization)
// Output: Assembly text as string
fn emit_module(sir_module: SIRModule) -> string proc[DeviceIO] {
    do
    header: string <- case recursion_support@module_uses_tail_calls(sir_module) of {
        true -> do
            bss: string <- recursion_support@emit_recursion_bss_section();
            p1: string <- recursion_support@emit_recursion_phase_header_comment();
            p4: string <- recursion_support@emit_stack_trace_hook_comment();
            p6: string <- recursion_support@emit_trampoline_fallback_stub();
            base: string <- asm_header(sir_module.module_name);
            concat(concat(concat(concat(concat(concat(bss, "\n"), base), "\n"), p1), concat("\n", concat(p4, concat("\n", p6)))), "\n")
        end;
        false -> asm_header(sir_module.module_name)
    };
    table: AtomTable <- atom_table@build_atom_table(sir_module);
    int64_table: Int64PrintTable <- int_rodata@build_int64_print_table(sir_module);
    int32_table: Int32PrintTable <- int_rodata@build_int32_print_table(sir_module);
    int16_table: Int16PrintTable <- int_rodata@build_int16_print_table(sir_module);
    int8_table: Int8PrintTable <- int_rodata@build_int8_print_table(sir_module);
    literal_table: Int64LiteralTable <- int64_literal_pool@build_int64_literal_table(sir_module);
    float64_literal_table: Float64LiteralTable <- float64_literal_pool@build_float64_literal_table(sir_module);
    float32_literal_table: Float32LiteralTable <- float32_literal_pool@build_float32_literal_table(sir_module);
    string_literal_table: StringLiteralTable <- string_literal_pool@build_string_literal_table(sir_module);
    funcs: string <- emit_functions(sir_module.functions, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, false);
    needs_region_overflow_helper: bool <- prims_memory@module_uses_region_allocation(sir_module);
    region_overflow_helper: string <- case needs_region_overflow_helper of {
        true -> concat("\n", prims_memory@emit_region_overflow_helper());
        false -> ""
    };
    needs_pi_helper: bool <- int_rodata@module_uses_signed_print_var(sir_module);
    needs_pu_helper: bool <- case int_rodata@module_uses_uint64_print_var(sir_module) of {
        true -> true;
        false -> case int_rodata@module_uses_uint32_print_var(sir_module) of {
            true -> true;
            false -> case int_rodata@module_uses_uint16_print_var(sir_module) of {
                true -> true;
                false -> int_rodata@module_uses_uint8_print_var(sir_module)
            }
        }
    };
    pi_helper: string <- case needs_pi_helper of {
        true -> concat("\n", print_int64_inline@emit_print_int64_helper());
        false -> ""
    };
    pu_helper: string <- case needs_pu_helper of {
        true -> concat("\n", print_int64_inline@emit_print_uint64_helper());
        false -> ""
    };
    needs_pb_helper: bool <- boolean_rodata@module_uses_print_bool_var(sir_module);
    pb_helper: string <- case needs_pb_helper of {
        true -> concat("\n", print_bool_inline@emit_print_bool_helper());
        false -> ""
    };
    needs_pf64_helper: bool <- float64_rodata@module_uses_float64_print(sir_module);
    pf64_helper: string <- case needs_pf64_helper of {
        true -> concat("\n", print_float64_inline@emit_print_float64_helper());
        false -> ""
    };
    needs_pf32_helper: bool <- float32_rodata@module_uses_float32_print(sir_module);
    pf32_helper: string <- case needs_pf32_helper of {
        true -> concat("\n", print_float32_inline@emit_print_float32_helper());
        false -> ""
    };
    needs_ps_helper: bool <- string_rodata@module_uses_print_string_var(sir_module);
    ps_helper: string <- case needs_ps_helper of {
        true -> concat("\n", print_string_inline@emit_print_string_helper());
        false -> ""
    };
    needs_concat_helper: bool <- string_rodata@module_uses_string_concat(sir_module);
    concat_helper: string <- case needs_concat_helper of {
        true -> concat("\n", string_concat_mmap_nomte@emit_string_concat_helper());
        false -> ""
    };
    needs_substring_helper: bool <- string_rodata@module_uses_string_substring(sir_module);
    substring_helper: string <- case needs_substring_helper of {
        true -> concat("\n", string_substring_mmap_nomte@emit_string_substring_helper());
        false -> ""
    };
    needs_substring_until_char_helper: bool <- string_rodata@module_uses_string_substring_until_char(sir_module);
    substring_until_char_helper: string <- case needs_substring_until_char_helper of {
        true -> concat("\n", string_substring_mmap_nomte@emit_string_substring_until_char_helper());
        false -> ""
    };
    needs_length_bytes_helper: bool <- string_rodata@module_uses_string_length_bytes(sir_module);
    length_bytes_helper: string <- case needs_length_bytes_helper of {
        true -> concat("\n", string_length_mmap_nomte@emit_length_bytes_helper());
        false -> ""
    };
    needs_length_chars_helper: bool <- string_rodata@module_uses_string_length_chars(sir_module);
    length_chars_helper: string <- case needs_length_chars_helper of {
        true -> concat("\n", string_length_mmap_nomte@emit_length_chars_helper());
        false -> ""
    };
    needs_string_eq_helper: bool <- string_rodata@module_uses_string_case_pattern(sir_module);
    string_eq_helper: string <- case needs_string_eq_helper of {
        true -> concat("\n", string_eq_mmap_nomte@emit_string_eq_helper());
        false -> ""
    };
    needs_list_length_helper: bool <- prims_list@module_uses_list_prims(sir_module);
    list_length_helper_asm: string <- case needs_list_length_helper of {
        true -> concat("\n", prims_list@emit_list_length_helper());
        false -> ""
    };
    needs_actor_rt_helper: bool <- prims_actors@module_uses_actor_prims(sir_module);
    actor_rt_helper_asm: string <- case needs_actor_rt_helper of {
        true -> concat("\n", prims_actors_runtime_asm@emit_actor_runtime_helpers());
        false -> ""
    };
    needs_region_alloc_stub: bool <- case needs_actor_rt_helper of {
        true -> false;
        false -> case needs_list_length_helper of {
            true -> true;
            false -> needs_region_overflow_helper
        }
    };
    region_alloc_stub_asm: string <- case needs_region_alloc_stub of {
        true -> concat("\n", prims_list@emit_region_alloc_stub());
        false -> ""
    };
    fwh_0: string <- concat(funcs, pi_helper);
    fwh_1: string <- concat(fwh_0, pu_helper);
    fwh_2: string <- concat(fwh_1, pb_helper);
    fwh_3: string <- concat(fwh_2, pf64_helper);
    fwh_4: string <- concat(fwh_3, pf32_helper);
    fwh_5: string <- concat(fwh_4, ps_helper);
    fwh_6: string <- concat(fwh_5, concat_helper);
    fwh_7: string <- concat(fwh_6, substring_helper);
    fwh_8: string <- concat(fwh_7, substring_until_char_helper);
    fwh_9: string <- concat(fwh_8, length_bytes_helper);
    fwh_10: string <- concat(fwh_9, length_chars_helper);
    fwh_11: string <- concat(fwh_10, string_eq_helper);
    fwh_11b: string <- concat(fwh_11, list_length_helper_asm);
    fwh_11c: string <- concat(fwh_11b, actor_rt_helper_asm);
    fwh_11d: string <- concat(fwh_11c, region_alloc_stub_asm);
    funcs_with_helper: string <- concat(fwh_11d, region_overflow_helper);
    atom_rodata_str: string <- atom_rodata@emit_atom_rodata_section(table);
    bool_rodata: string <- boolean_rodata@emit_boolean_rodata_section();
    int64_rodata_str: string <- int_rodata@emit_int64_rodata_section(int64_table);
    int32_rodata_str: string <- int_rodata@emit_int32_rodata_section(int32_table);
    int16_rodata_str: string <- int_rodata@emit_int16_rodata_section(int16_table);
    int8_rodata_str: string <- int_rodata@emit_int8_rodata_section(int8_table);
    code_part: string <- concat(concat(header, "\n"), funcs_with_helper);
    with_atom: string <- case len(atom_rodata_str) > 0 of {
        true -> concat(concat(code_part, "\n"), atom_rodata_str);
        false -> code_part
    };
    with_bool: string <- case boolean_rodata@module_uses_booleans(sir_module) of {
        true -> concat(concat(with_atom, "\n"), bool_rodata);
        false -> with_atom
    };
    with_int64: string <- case int_rodata@module_uses_int64_print(sir_module) of {
        true -> concat(concat(with_bool, "\n"), int64_rodata_str);
        false -> with_bool
    };
    with_int32: string <- case int_rodata@module_uses_int32_print(sir_module) of {
        true -> concat(concat(with_int64, "\n"), int32_rodata_str);
        false -> with_int64
    };
    with_int16: string <- case int_rodata@module_uses_int16_print(sir_module) of {
        true -> concat(concat(with_int32, "\n"), int16_rodata_str);
        false -> with_int32
    };
    with_int8: string <- case int_rodata@module_uses_int8_print(sir_module) of {
        true -> concat(concat(with_int16, "\n"), int8_rodata_str);
        false -> with_int16
    };
    float64_helper_rodata: string <- case needs_pf64_helper of {
        true -> concat("\n", float64_rodata@emit_float64_helper_rodata());
        false -> ""
    };
    float32_helper_rodata: string <- case needs_pf32_helper of {
        true -> concat("\n", float32_rodata@emit_float32_helper_rodata());
        false -> ""
    };
    with_float64_helper: string <- concat(with_int8, float64_helper_rodata);
    with_float32_helper: string <- concat(with_float64_helper, float32_helper_rodata);
    int64_literal_rodata: string <- int64_literal_pool@emit_int64_literal_rodata_section(literal_table);
    with_int64_literal: string <- case int64_literal_pool@module_uses_int64_literal_pool(sir_module) of {
        true -> concat(concat(with_float32_helper, "\n"), int64_literal_rodata);
        false -> with_float32_helper
    };
    float64_literal_rodata: string <- float64_literal_pool@emit_float64_literal_rodata_section(float64_literal_table);
    with_float64_literal: string <- case float64_literal_pool@module_uses_float64_literal_pool(sir_module) of {
        true -> concat(concat(with_int64_literal, "\n"), float64_literal_rodata);
        false -> with_int64_literal
    };
    float32_literal_rodata: string <- float32_literal_pool@emit_float32_literal_rodata_section(float32_literal_table);
    with_float32_literal: string <- case float32_literal_pool@module_uses_float32_literal_pool(sir_module) of {
        true -> concat(concat(with_float64_literal, "\n"), float32_literal_rodata);
        false -> with_float64_literal
    };
    string_literal_rodata: string <- string_literal_pool@emit_string_literal_rodata_section(string_literal_table);
    with_string_literal: string <- case string_literal_pool@module_uses_string_literal_pool(sir_module) of {
        true -> concat(concat(with_float32_literal, "\n"), string_literal_rodata);
        false -> with_float32_literal
    };
    newline_rodata: string <- case string_rodata@module_uses_println(sir_module) of {
        true -> concat("\n", print_string_inline@emit_newline_rodata());
        false -> ""
    };
    with_newline: string <- concat(with_string_literal, newline_rodata);
    with_newline
    end
}

// Emit with debug: when debug is true, term_emitter prints branch/register info to stderr
fn emit_module_debug(sir_module: SIRModule, debug: bool) -> string proc[DeviceIO] {
    do
    header: string <- case recursion_support@module_uses_tail_calls(sir_module) of {
        true -> do
            bss: string <- recursion_support@emit_recursion_bss_section();
            p1: string <- recursion_support@emit_recursion_phase_header_comment();
            p4: string <- recursion_support@emit_stack_trace_hook_comment();
            p6: string <- recursion_support@emit_trampoline_fallback_stub();
            base: string <- asm_header(sir_module.module_name);
            concat(concat(concat(concat(concat(concat(bss, "\n"), base), "\n"), p1), concat("\n", concat(p4, concat("\n", p6)))), "\n")
        end;
        false -> asm_header(sir_module.module_name)
    };
    table: AtomTable <- atom_table@build_atom_table(sir_module);
    int64_table: Int64PrintTable <- int_rodata@build_int64_print_table(sir_module);
    int32_table: Int32PrintTable <- int_rodata@build_int32_print_table(sir_module);
    int16_table: Int16PrintTable <- int_rodata@build_int16_print_table(sir_module);
    int8_table: Int8PrintTable <- int_rodata@build_int8_print_table(sir_module);
    literal_table: Int64LiteralTable <- int64_literal_pool@build_int64_literal_table(sir_module);
    float64_literal_table: Float64LiteralTable <- float64_literal_pool@build_float64_literal_table(sir_module);
    float32_literal_table: Float32LiteralTable <- float32_literal_pool@build_float32_literal_table(sir_module);
    string_literal_table: StringLiteralTable <- string_literal_pool@build_string_literal_table(sir_module);
    funcs: string <- emit_functions(sir_module.functions, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, debug);
    needs_region_overflow_helper: bool <- prims_memory@module_uses_region_allocation(sir_module);
    region_overflow_helper: string <- case needs_region_overflow_helper of {
        true -> concat("\n", prims_memory@emit_region_overflow_helper());
        false -> ""
    };
    needs_pi_helper: bool <- int_rodata@module_uses_signed_print_var(sir_module);
    needs_pu_helper: bool <- case int_rodata@module_uses_uint64_print_var(sir_module) of {
        true -> true;
        false -> case int_rodata@module_uses_uint32_print_var(sir_module) of {
            true -> true;
            false -> case int_rodata@module_uses_uint16_print_var(sir_module) of {
                true -> true;
                false -> int_rodata@module_uses_uint8_print_var(sir_module)
            }
        }
    };
    pi_helper: string <- case needs_pi_helper of {
        true -> concat("\n", print_int64_inline@emit_print_int64_helper());
        false -> ""
    };
    pu_helper: string <- case needs_pu_helper of {
        true -> concat("\n", print_int64_inline@emit_print_uint64_helper());
        false -> ""
    };
    needs_pb_helper: bool <- boolean_rodata@module_uses_print_bool_var(sir_module);
    pb_helper: string <- case needs_pb_helper of {
        true -> concat("\n", print_bool_inline@emit_print_bool_helper());
        false -> ""
    };
    needs_pf64_helper: bool <- float64_rodata@module_uses_float64_print(sir_module);
    pf64_helper: string <- case needs_pf64_helper of {
        true -> concat("\n", print_float64_inline@emit_print_float64_helper());
        false -> ""
    };
    needs_pf32_helper: bool <- float32_rodata@module_uses_float32_print(sir_module);
    pf32_helper: string <- case needs_pf32_helper of {
        true -> concat("\n", print_float32_inline@emit_print_float32_helper());
        false -> ""
    };
    needs_ps_helper: bool <- string_rodata@module_uses_print_string_var(sir_module);
    ps_helper: string <- case needs_ps_helper of {
        true -> concat("\n", print_string_inline@emit_print_string_helper());
        false -> ""
    };
    needs_concat_helper: bool <- string_rodata@module_uses_string_concat(sir_module);
    concat_helper: string <- case needs_concat_helper of {
        true -> concat("\n", string_concat_mmap_nomte@emit_string_concat_helper());
        false -> ""
    };
    needs_substring_helper: bool <- string_rodata@module_uses_string_substring(sir_module);
    substring_helper: string <- case needs_substring_helper of {
        true -> concat("\n", string_substring_mmap_nomte@emit_string_substring_helper());
        false -> ""
    };
    needs_substring_until_char_helper: bool <- string_rodata@module_uses_string_substring_until_char(sir_module);
    substring_until_char_helper: string <- case needs_substring_until_char_helper of {
        true -> concat("\n", string_substring_mmap_nomte@emit_string_substring_until_char_helper());
        false -> ""
    };
    needs_length_bytes_helper: bool <- string_rodata@module_uses_string_length_bytes(sir_module);
    length_bytes_helper: string <- case needs_length_bytes_helper of {
        true -> concat("\n", string_length_mmap_nomte@emit_length_bytes_helper());
        false -> ""
    };
    needs_length_chars_helper: bool <- string_rodata@module_uses_string_length_chars(sir_module);
    length_chars_helper: string <- case needs_length_chars_helper of {
        true -> concat("\n", string_length_mmap_nomte@emit_length_chars_helper());
        false -> ""
    };
    needs_string_eq_helper: bool <- string_rodata@module_uses_string_case_pattern(sir_module);
    string_eq_helper: string <- case needs_string_eq_helper of {
        true -> concat("\n", string_eq_mmap_nomte@emit_string_eq_helper());
        false -> ""
    };
    needs_list_length_helper: bool <- prims_list@module_uses_list_prims(sir_module);
    list_length_helper_asm: string <- case needs_list_length_helper of {
        true -> concat("\n", prims_list@emit_list_length_helper());
        false -> ""
    };
    needs_actor_rt_helper: bool <- prims_actors@module_uses_actor_prims(sir_module);
    actor_rt_helper_asm: string <- case needs_actor_rt_helper of {
        true -> concat("\n", prims_actors_runtime_asm@emit_actor_runtime_helpers());
        false -> ""
    };
    needs_region_alloc_stub: bool <- case needs_actor_rt_helper of {
        true -> false;
        false -> case needs_list_length_helper of {
            true -> true;
            false -> needs_region_overflow_helper
        }
    };
    region_alloc_stub_asm: string <- case needs_region_alloc_stub of {
        true -> concat("\n", prims_list@emit_region_alloc_stub());
        false -> ""
    };
    fwh_0: string <- concat(funcs, pi_helper);
    fwh_1: string <- concat(fwh_0, pu_helper);
    fwh_2: string <- concat(fwh_1, pb_helper);
    fwh_3: string <- concat(fwh_2, pf64_helper);
    fwh_4: string <- concat(fwh_3, pf32_helper);
    fwh_5: string <- concat(fwh_4, ps_helper);
    fwh_6: string <- concat(fwh_5, concat_helper);
    fwh_7: string <- concat(fwh_6, substring_helper);
    fwh_8: string <- concat(fwh_7, substring_until_char_helper);
    fwh_9: string <- concat(fwh_8, length_bytes_helper);
    fwh_10: string <- concat(fwh_9, length_chars_helper);
    fwh_11: string <- concat(fwh_10, string_eq_helper);
    fwh_11b: string <- concat(fwh_11, list_length_helper_asm);
    fwh_11c: string <- concat(fwh_11b, actor_rt_helper_asm);
    fwh_11d: string <- concat(fwh_11c, region_alloc_stub_asm);
    funcs_with_helper: string <- concat(fwh_11d, region_overflow_helper);
    atom_rodata_str: string <- atom_rodata@emit_atom_rodata_section(table);
    bool_rodata: string <- boolean_rodata@emit_boolean_rodata_section();
    int64_rodata_str: string <- int_rodata@emit_int64_rodata_section(int64_table);
    int32_rodata_str: string <- int_rodata@emit_int32_rodata_section(int32_table);
    int16_rodata_str: string <- int_rodata@emit_int16_rodata_section(int16_table);
    int8_rodata_str: string <- int_rodata@emit_int8_rodata_section(int8_table);
    code_part: string <- concat(concat(header, "\n"), funcs_with_helper);
    with_atom: string <- case len(atom_rodata_str) > 0 of {
        true -> concat(concat(code_part, "\n"), atom_rodata_str);
        false -> code_part
    };
    with_bool: string <- case boolean_rodata@module_uses_booleans(sir_module) of {
        true -> concat(concat(with_atom, "\n"), bool_rodata);
        false -> with_atom
    };
    with_int64: string <- case int_rodata@module_uses_int64_print(sir_module) of {
        true -> concat(concat(with_bool, "\n"), int64_rodata_str);
        false -> with_bool
    };
    with_int32: string <- case int_rodata@module_uses_int32_print(sir_module) of {
        true -> concat(concat(with_int64, "\n"), int32_rodata_str);
        false -> with_int64
    };
    with_int16: string <- case int_rodata@module_uses_int16_print(sir_module) of {
        true -> concat(concat(with_int32, "\n"), int16_rodata_str);
        false -> with_int32
    };
    with_int8: string <- case int_rodata@module_uses_int8_print(sir_module) of {
        true -> concat(concat(with_int16, "\n"), int8_rodata_str);
        false -> with_int16
    };
    float64_helper_rodata: string <- case needs_pf64_helper of {
        true -> concat("\n", float64_rodata@emit_float64_helper_rodata());
        false -> ""
    };
    float32_helper_rodata: string <- case needs_pf32_helper of {
        true -> concat("\n", float32_rodata@emit_float32_helper_rodata());
        false -> ""
    };
    with_float64_helper: string <- concat(with_int8, float64_helper_rodata);
    with_float32_helper: string <- concat(with_float64_helper, float32_helper_rodata);
    int64_literal_rodata: string <- int64_literal_pool@emit_int64_literal_rodata_section(literal_table);
    with_int64_literal: string <- case int64_literal_pool@module_uses_int64_literal_pool(sir_module) of {
        true -> concat(concat(with_float32_helper, "\n"), int64_literal_rodata);
        false -> with_float32_helper
    };
    float64_literal_rodata: string <- float64_literal_pool@emit_float64_literal_rodata_section(float64_literal_table);
    with_float64_literal: string <- case float64_literal_pool@module_uses_float64_literal_pool(sir_module) of {
        true -> concat(concat(with_int64_literal, "\n"), float64_literal_rodata);
        false -> with_int64_literal
    };
    float32_literal_rodata: string <- float32_literal_pool@emit_float32_literal_rodata_section(float32_literal_table);
    with_float32_literal: string <- case float32_literal_pool@module_uses_float32_literal_pool(sir_module) of {
        true -> concat(concat(with_float64_literal, "\n"), float32_literal_rodata);
        false -> with_float64_literal
    };
    string_literal_rodata: string <- string_literal_pool@emit_string_literal_rodata_section(string_literal_table);
    with_string_literal: string <- case string_literal_pool@module_uses_string_literal_pool(sir_module) of {
        true -> concat(concat(with_float32_literal, "\n"), string_literal_rodata);
        false -> with_float32_literal
    };
    newline_rodata: string <- case string_rodata@module_uses_println(sir_module) of {
        true -> concat("\n", print_string_inline@emit_newline_rodata());
        false -> ""
    };
    with_newline: string <- concat(with_string_literal, newline_rodata);
    with_newline
    end
}

fn asm_header(name: string) -> string {
    concat(".text\n", concat(concat(".global ", name), "\n"))
}

fn emit_functions(fns: ListSIRFunction, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, debug: bool) -> string proc[DeviceIO] {
    do
    case fns.is_nil of {
        true -> "";
        false -> do
            fn_asm: string <- emit_sir_function(fns.head, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, debug);
            rest_asm: string <- emit_functions(fns.tail, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, debug);
            case rest_asm == "" of {
                true -> fn_asm;
                false -> concat(concat(fn_asm, "\n"), rest_asm)
            }
        end
    }
    end
}

// AArch64 AAPCS64: int args X0-X7 (or W0-W7 for narrow), float64 D0-D7, float32 S0-S7
// param_type: use actual param type so tuple/string/pointer params get X (64-bit), not W
fn param_reg_for_index(i: int64, param_type: string) -> string {
    is_tuple: bool <- len(param_type) >= 2 and substring(param_type, 0, 1) == "(";
    is_string: bool <- param_type == "string";
    is_pointer: bool <- is_tuple or is_string;
    is_narrow: bool <- param_type == "int32" or param_type == "int16" or param_type == "int8" or param_type == "uint32" or param_type == "uint16" or param_type == "uint8" or param_type == "bool";
    is_float64: bool <- param_type == "float64";
    is_float32: bool <- param_type == "float32";
    prefix: string <- case is_float64 of {
        true -> "D";
        false -> case is_float32 of {
            true -> "S";
            false -> case is_pointer of {
                true -> "X";
                false -> case is_narrow of { true -> "W"; false -> "X" }
            }
        }
    };
    case i of {
        0 -> concat(prefix, "0");
        1 -> concat(prefix, "1");
        2 -> concat(prefix, "2");
        3 -> concat(prefix, "3");
        4 -> concat(prefix, "4");
        5 -> concat(prefix, "5");
        6 -> concat(prefix, "6");
        7 -> concat(prefix, "7");
        _: int64 -> concat(prefix, "0")
    }
}

fn param_type_at_index(param_types: string, idx: int64) -> string {
    pipe: int64 <- find_pipe_in_param_names(param_types, 0);
    case pipe < 0 of {
        true -> param_types;
        false -> case idx of {
            0 -> substring(param_types, 0, pipe);
            _: int64 -> param_type_at_index(substring(param_types, pipe + 1, len(param_types)), idx - 1)
        }
    }
}

fn bind_reg_for_param(idx: int64, ptype: string, string_shadow: bool, second_param_shadow: bool) -> string {
    reg: string <- param_reg_for_index(idx, ptype);
    first_in_x19: bool <- string_shadow and idx == 0 and (ptype == "string" or term_emitter@type_name_is_list_like(ptype));
    case first_in_x19 of {
        true -> "X19";
        false -> case second_param_shadow and idx == 1 of {
            true -> "X20";
            false -> reg
        }
    }
}

fn is_gpr64_param_type(ptype: string) -> bool {
    ptype == "int64" or ptype == "uint64"
}

// Count int64/uint64 parameters (pipe-separated param_types).
fn count_gpr64_params_from(param_types: string, acc: int64) -> int64 {
    case len(param_types) == 0 of {
        true -> acc;
        false -> do
            pipe: int64 <- find_pipe_in_param_names(param_types, 0);
            case pipe < 0 of {
                true -> case is_gpr64_param_type(param_types) of { true -> acc + 1; false -> acc };
                false -> do
                    head: string <- substring(param_types, 0, pipe);
                    rest: string <- substring(param_types, pipe + 1, len(param_types));
                    n: int64 <- case is_gpr64_param_type(head) of { true -> 1; false -> 0 };
                    count_gpr64_params_from(rest, acc + n)
                end
            }
        end
    }
}

fn count_gpr64_params(param_types: string) -> int64 {
    count_gpr64_params_from(param_types, 0)
}

// After MOV X12,X0 / MOV X13,X1 at function entry, var lookups use X12/X13 instead of ABI X0/X1.
// Use X12/X13 (not X9/X10): print_int64 helper (L_pi_helper) clobbers X9 and X10 across BL.
fn bind_reg_int64_abi_shadow(idx: int64, ptype: string, string_shadow: bool, second_param_shadow: bool) -> string {
    case is_gpr64_param_type(ptype) of {
        true -> case idx of {
            0 -> "X12";
            1 -> "X13";
            _: int64 -> param_reg_for_index(idx, ptype)
        };
        false -> bind_reg_for_param(idx, ptype, string_shadow, second_param_shadow)
    }
}

fn build_param_outer_reg_int64_abi_shadow_loop(param_names: string, param_types: string, idx: int64, acc: string, string_shadow: bool, second_param_shadow: bool) -> string {
    pipe: int64 <- find_pipe_in_param_names(param_names, 0);
    ptype: string <- param_type_at_index(param_types, idx);
    case pipe < 0 of {
        true -> case len(param_names) == 0 of {
            true -> acc;
            false -> do
                prefixed: string <- concat("%", param_names);
                br: string <- bind_reg_int64_abi_shadow(idx, ptype, string_shadow, second_param_shadow);
                sep: string <- case len(acc) == 0 of { true -> ""; false -> "|" };
                concat(acc, concat(sep, concat(prefixed, concat("=", br))))
            end
        };
        false -> do
            first: string <- substring(param_names, 0, pipe);
            rest: string <- case pipe + 1 < len(param_names) of { true -> substring(param_names, pipe + 1, len(param_names)); false -> "" };
            rest_types: string <- case pipe + 1 < len(param_types) of { true -> substring(param_types, pipe + 1, len(param_types)); false -> "" };
            prefixed: string <- concat("%", first);
            br: string <- bind_reg_int64_abi_shadow(idx, ptype, string_shadow, second_param_shadow);
            sep: string <- case len(acc) == 0 of { true -> ""; false -> "|" };
            part: string <- concat(sep, concat(prefixed, concat("=", br)));
            base: string <- case len(acc) == 0 of {
                true -> do
                    pt0: string <- param_type_at_index(param_types, 0);
                    case is_gpr64_param_type(pt0) of { true -> "X12"; false -> param_reg_for_index(0, pt0) }
                end;
                false -> acc
            };
            next_acc: string <- concat(base, part);
            build_param_outer_reg_int64_abi_shadow_loop(rest, rest_types, idx + 1, next_acc, string_shadow, second_param_shadow)
        end
    }
}

fn build_param_outer_reg_int64_abi_shadow(param_names: string, param_types: string, string_shadow: bool, second_param_shadow: bool) -> string {
    case len(param_names) == 0 of {
        true -> "";
        false -> do
            first_ptype: string <- param_type_at_index(param_types, 0);
            first_base: string <- case is_gpr64_param_type(first_ptype) of { true -> "X12"; false -> param_reg_for_index(0, first_ptype) };
            build_param_outer_reg_int64_abi_shadow_loop(param_names, param_types, 0, first_base, string_shadow, second_param_shadow)
        end
    }
}

fn emit_int64_abi_shadow_moves(param_types: string) -> string {
    c: int64 <- count_gpr64_params(param_types);
    case c >= 2 of {
        true -> "    MOV X12, X0\n    MOV X13, X1\n";
        false -> case c == 1 of {
            true -> "    MOV X12, X0\n";
            false -> ""
        }
    }
}

// True when we must copy ABI GPR args to X9/X10 before any device_io in the body (e.g. println before param uses).
fn needs_int64_abi_entry_shadow(fn_val: SIRFunction) -> bool {
    case fn_val.body.kind == 5 of {
        true -> false;
        false -> case first_param_x0_shadow_enabled(fn_val.param_types, fn_val.body.kind) of {
            true -> false;
            false -> do
                c: int64 <- count_gpr64_params(fn_val.param_types);
                case c >= 2 of {
                    true -> true;
                    false -> case c == 1 of {
                        true -> emitter_effects@has_device_io(fn_val.effects);
                        false -> false
                    }
                }
            end
        }
    }
}

// Reply triple: legacy parser string (atom, R, S) or source form (:reply, R, S); two top-level commas after '('.
fn count_top_level_commas_tuple_ty(s: string, i: int64, depth: int64, count: int64) -> int64 {
    case i >= len(s) of {
        true -> count;
        false -> case substring(s, i, i + 1) == "(" of {
            true -> count_top_level_commas_tuple_ty(s, i + 1, depth + 1, count);
            false -> case substring(s, i, i + 1) == ")" of {
                true -> case depth == 0 of {
                    true -> count;
                    false -> count_top_level_commas_tuple_ty(s, i + 1, depth - 1, count)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> count_top_level_commas_tuple_ty(s, i + 1, depth, count + 1);
                        false -> count_top_level_commas_tuple_ty(s, i + 1, depth, count)
                    };
                    false -> count_top_level_commas_tuple_ty(s, i + 1, depth, count)
                }
            }
        }
    }
}

fn behavior_return_is_atom_3_tuple(return_type: string) -> bool {
    case len(return_type) >= 6 of {
        false -> false;
        true -> case substring(return_type, 0, 6) == "(atom," of {
            true -> count_top_level_commas_tuple_ty(return_type, 1, 0, 0) == 2;
            false -> case len(return_type) >= 8 of {
                false -> false;
                true -> case substring(return_type, 0, 8) == "(:reply," of {
                    true -> count_top_level_commas_tuple_ty(return_type, 1, 0, 0) == 2;
                    false -> false
                }
            }
        }
    }
}

// Actor runtime passes X2 = sret pointer; store reply tuple there (not callee stack). Skip when first param uses X19 shadow (string or list; X20 may hold second param shadow).
fn use_actor_reply_sret_buffer(fn_val: SIRFunction) -> bool {
    case fn_val.body.kind == 5 of {
        true -> false;
        false -> case behavior_return_is_atom_3_tuple(fn_val.return_type) of {
            false -> false;
            true -> case first_param_x0_shadow_enabled(fn_val.param_types, fn_val.body.kind) of {
                true -> false;
                false -> true
            }
        }
    }
}

fn build_param_outer_reg_loop(param_names: string, param_types: string, idx: int64, acc: string, string_shadow: bool, second_param_shadow: bool) -> string {
    pipe: int64 <- find_pipe_in_param_names(param_names, 0);
    ptype: string <- param_type_at_index(param_types, idx);
    case pipe < 0 of {
        true -> case len(param_names) == 0 of {
            true -> acc;
            false -> do
                prefixed: string <- concat("%", param_names);
                br: string <- bind_reg_for_param(idx, ptype, string_shadow, second_param_shadow);
                sep: string <- case len(acc) == 0 of { true -> ""; false -> "|" };
                concat(acc, concat(sep, concat(prefixed, concat("=", br))))
            end
        };
        false -> do
            first: string <- substring(param_names, 0, pipe);
            rest: string <- case pipe + 1 < len(param_names) of { true -> substring(param_names, pipe + 1, len(param_names)); false -> "" };
            rest_types: string <- case pipe + 1 < len(param_types) of { true -> substring(param_types, pipe + 1, len(param_types)); false -> "" };
            prefixed: string <- concat("%", first);
            br: string <- bind_reg_for_param(idx, ptype, string_shadow, second_param_shadow);
            sep: string <- case len(acc) == 0 of { true -> ""; false -> "|" };
            part: string <- concat(sep, concat(prefixed, concat("=", br)));
            base: string <- case len(acc) == 0 of { true -> param_reg_for_index(0, ptype); false -> acc };
            next_acc: string <- concat(base, part);
            build_param_outer_reg_loop(rest, rest_types, idx + 1, next_acc, string_shadow, second_param_shadow)
        end
    }
}

fn find_pipe_in_param_names(s: string, start: int64) -> int64 {
    case start >= len(s) of {
        true -> -1;
        false -> case substring(s, start, start + 1) == "|" of {
            true -> start;
            false -> find_pipe_in_param_names(s, start + 1)
        }
    }
}

fn build_param_outer_reg(param_names: string, param_types: string, string_shadow: bool) -> string {
    case len(param_names) == 0 of {
        true -> "";
        false -> do
            first_ptype: string <- param_type_at_index(param_types, 0);
            first_reg: string <- param_reg_for_index(0, first_ptype);
            second_ps: bool <- second_param_shadow_enabled(param_types, string_shadow);
            build_param_outer_reg_loop(param_names, param_types, 0, first_reg, string_shadow, second_ps)
        end
    }
}

// First string or List[...] param arrives in X0; device_io and list prims clobber X0. Keep a stable copy in X19 for the body.
// Skip for tail-call bodies (kind 5): epilogue is not emitted so X19 save/restore would not match.
fn first_param_x0_shadow_enabled(param_types: string, body_kind: int64) -> bool {
    case body_kind == 5 of {
        true -> false;
        false -> case len(param_types) == 0 of {
            true -> false;
            false -> do
                p0: string <- param_type_at_index(param_types, 0);
                p0 == "string" or term_emitter@type_name_is_list_like(p0)
            end
        }
    }
}

// Second param saved to X20 when first param is a string shadow. X20 is already saved/restored
// by the STP/LDP pair. Enables acc or other GPR second params to survive BL calls in the body.
// Only for GPR-typed second params (not float64/float32 which use D/S registers).
fn second_param_shadow_enabled(param_types: string, string_shadow: bool) -> bool {
    case string_shadow of {
        true -> case find_pipe_in_param_names(param_types, 0) >= 0 of {
            true -> do
                second_type: string <- param_type_at_index(param_types, 1);
                case second_type == "float64" or second_type == "float32" of {
                    true -> false;
                    false -> true
                }
            end;
            false -> false
        };
        false -> false
    }
}

// Count non-discarded let bindings whose type is spill-eligible (not float, not unit).
// Used to decide how many callee-saved register pairs (X19–X28) to save in the prologue.
// Overcounting is harmless (a few extra STP/LDP instructions); undercounting corrupts the caller's callee-saved state.
fn count_spill_eligible_lets_in_term(term: SIRTerm) -> int64 {
    case term.kind < 0 of {
        true -> 0;
        false -> case term.kind of {
            2 -> do
                c: int64 <- case term.name != "%_" and term.name != "_" and term.type_name != "float64" and term.type_name != "float32" and term.type_name != "float16" and term.type_name != "unit" of {
                    true -> 1;
                    false -> 0
                };
                c + count_spill_eligible_lets_in_term(term.inner) + count_spill_eligible_lets_in_term(term.right_expr)
            end;
            3 -> count_spill_eligible_lets_in_term(term.inner) + count_spill_eligible_lets_in_term(term.right_expr);
            4 -> count_spill_eligible_lets_in_term(term.inner);
            5 -> count_spill_eligible_lets_in_term(term.inner) + count_spill_eligible_lets_in_term(term.right_expr);
            6 -> count_spill_eligible_lets_in_term(term.inner) + count_spill_eligible_lets_in_term(term.right_expr);
            7 -> count_spill_eligible_lets_in_term(term.inner) + count_spill_eligible_lets_in_term(term.right_expr);
            8 -> count_spill_eligible_lets_in_term(term.inner) + count_spill_eligible_lets_in_term(term.right_expr);
            _: int64 -> 0
        }
    }
}

// True when the body contains a BL-producing prim (actor helpers, list_length, list_cons).
// These clobber X0–X18 so any live value in caller-saved regs must be spilled to callee-saved regs.
fn body_has_bl_producing_prim(term: SIRTerm) -> bool {
    case term.kind < 0 of {
        true -> false;
        false -> case term.kind of {
            6 -> case prims_actors@is_actor_prim(term.name) or term.name == "list_length" or term.name == "list_cons" of {
                true -> true;
                false -> case body_has_bl_producing_prim(term.inner) of {
                    true -> true;
                    false -> body_has_bl_producing_prim(term.right_expr)
                }
            };
            2 -> case body_has_bl_producing_prim(term.inner) of {
                true -> true;
                false -> body_has_bl_producing_prim(term.right_expr)
            };
            3 -> case body_has_bl_producing_prim(term.inner) of {
                true -> true;
                false -> body_has_bl_producing_prim(term.right_expr)
            };
            4 -> body_has_bl_producing_prim(term.inner);
            5 -> case body_has_bl_producing_prim(term.inner) of {
                true -> true;
                false -> body_has_bl_producing_prim(term.right_expr)
            };
            7 -> case body_has_bl_producing_prim(term.inner) of {
                true -> true;
                false -> body_has_bl_producing_prim(term.right_expr)
            };
            8 -> case body_has_bl_producing_prim(term.inner) of {
                true -> true;
                false -> body_has_bl_producing_prim(term.right_expr)
            };
            _: int64 -> false
        }
    }
}

// STP/LDP X21,X22 when three or more spill-eligible lets exist.
fn needs_actor_ref_x21_x22_frame(fn_val: SIRFunction) -> bool {
    case fn_val.body.kind == 5 of {
        true -> false;
        false -> count_spill_eligible_lets_in_term(fn_val.body) >= 3
    }
}

// STP/LDP X23,X24 when five or more spill-eligible lets exist.
fn needs_callee_x23_x24_frame(fn_val: SIRFunction) -> bool {
    case fn_val.body.kind == 5 of {
        true -> false;
        false -> count_spill_eligible_lets_in_term(fn_val.body) >= 5
    }
}

// STP/LDP X25,X26 when seven or more spill-eligible lets exist.
fn needs_callee_x25_x26_frame(fn_val: SIRFunction) -> bool {
    case fn_val.body.kind == 5 of {
        true -> false;
        false -> count_spill_eligible_lets_in_term(fn_val.body) >= 7
    }
}

// STP/LDP X27,X28 when nine or more spill-eligible lets exist.
fn needs_callee_x27_x28_frame(fn_val: SIRFunction) -> bool {
    case fn_val.body.kind == 5 of {
        true -> false;
        false -> count_spill_eligible_lets_in_term(fn_val.body) >= 9
    }
}

// Extra STP/LDP X19,X20 pair so let RHS can spill from X0 to X19/X20 across BL calls.
// Pairs with term_emitter compute_let_rhs_spill_reg. Skipped when string shadow already uses STP X19,X20.
// Also triggered when the body has BL-producing prims (actor helpers, list_length, list_cons) so that
// functions without explicit concurrency/device_io effects still get callee-saved frames for list operations.
fn function_needs_callee_saved_x19_x20_frame(fn_val: SIRFunction) -> bool {
    case fn_val.body.kind == 5 of {
        true -> false;
        false -> case first_param_x0_shadow_enabled(fn_val.param_types, fn_val.body.kind) of {
            true -> false;
            false -> case use_actor_reply_sret_buffer(fn_val) of {
                true -> true;
                false -> case emitter_effects@has_concurrency(fn_val.effects) of {
                    true -> true;
                    false -> case emitter_effects@has_device_io(fn_val.effects) of {
                        true -> true;
                        false -> case reg_conventions@is_tuple_type(fn_val.return_type) of {
                            true -> true;
                            false -> fn_val.return_type == "int64" or fn_val.return_type == "uint64" or body_has_bl_producing_prim(fn_val.body)
                        }
                    }
                }
            }
        }
    }
}

fn emit_sir_function(fn_val: SIRFunction, table: AtomTable, int64_table: Int64PrintTable, int32_table: Int32PrintTable, int16_table: Int16PrintTable, int8_table: Int8PrintTable, literal_table: Int64LiteralTable, float64_literal_table: Float64LiteralTable, float32_literal_table: Float32LiteralTable, string_literal_table: StringLiteralTable, debug: bool) -> string proc[DeviceIO] {
    do
    entry_label: string <- entry_point_label(fn_val.name);
    eff_comment: string <- emitter_effects@fn_effect_annotation(fn_val.effects);
    prologue: string <- control@function_prologue_with_effects(entry_label, fn_val.effects);
    dest_reg: string <- case fn_val.return_type == "float32" of {
        true -> "S0";
        false -> case fn_val.return_type == "float64" of {
            true -> "D0";
            false -> case fn_val.return_type == "int32" or fn_val.return_type == "int16" or fn_val.return_type == "int8" or fn_val.return_type == "uint32" or fn_val.return_type == "uint16" or fn_val.return_type == "uint8" of {
                true -> concat("W", "0");
                false -> "X0"
            }
        }
    };
    string_shadow: bool <- first_param_x0_shadow_enabled(fn_val.param_types, fn_val.body.kind);
    second_param_shadow: bool <- second_param_shadow_enabled(fn_val.param_types, string_shadow);
    param_outer: string <- build_param_outer_reg(fn_val.param_names, fn_val.param_types, string_shadow);
    use_int64_abi_shadow: bool <- needs_int64_abi_entry_shadow(fn_val);
    param_outer_for_body: string <- case use_int64_abi_shadow of {
        true -> build_param_outer_reg_int64_abi_shadow(fn_val.param_names, fn_val.param_types, string_shadow, second_param_shadow);
        false -> param_outer
    };
    int64_abi_shadow_asm: string <- case use_int64_abi_shadow of {
        true -> emit_int64_abi_shadow_moves(fn_val.param_types);
        false -> ""
    };
    actor_sret_mov: string <- case use_actor_reply_sret_buffer(fn_val) of {
        true -> "    MOV X20, X2\n";
        false -> ""
    };
    param_outer_emit: string <- case use_actor_reply_sret_buffer(fn_val) of {
        true -> concat(param_outer_for_body, "|_tuple_sret=X20");
        false -> param_outer_for_body
    };
    shadow_prologue: string <- case string_shadow of {
        true -> case second_param_shadow of {
            true -> "    STP X19, X20, [SP, #-16]!\n    MOV X19, X0\n    MOV X20, X1\n";
            false -> "    STP X19, X20, [SP, #-16]!\n    MOV X19, X0\n"
        };
        false -> ""
    };
    callee_saved_frame: string <- case function_needs_callee_saved_x19_x20_frame(fn_val) of {
        true -> "    STP X19, X20, [SP, #-16]!\n";
        false -> ""
    };
    actor_x21_x22_frame: string <- case needs_actor_ref_x21_x22_frame(fn_val) of {
        true -> "    STP X21, X22, [SP, #-16]!\n";
        false -> ""
    };
    callee_x23_x24_frame: string <- case needs_callee_x23_x24_frame(fn_val) of {
        true -> "    STP X23, X24, [SP, #-16]!\n";
        false -> ""
    };
    callee_x25_x26_frame: string <- case needs_callee_x25_x26_frame(fn_val) of {
        true -> "    STP X25, X26, [SP, #-16]!\n";
        false -> ""
    };
    callee_x27_x28_frame: string <- case needs_callee_x27_x28_frame(fn_val) of {
        true -> "    STP X27, X28, [SP, #-16]!\n";
        false -> ""
    };
    prologue_full: string <- concat(prologue, concat(shadow_prologue, concat(callee_saved_frame, concat(actor_x21_x22_frame, concat(callee_x23_x24_frame, concat(callee_x25_x26_frame, concat(callee_x27_x28_frame, concat(int64_abi_shadow_asm, actor_sret_mov))))))));
    body: string <- case fn_val.body.kind == 5 of {
        true -> term_emitter@emit_function_tail_user_call_root(fn_val.body, dest_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, param_outer_emit, fn_val.effects, debug);
        false -> term_emitter@term_to_asm_debug_with_outer(fn_val.body, dest_reg, table, int64_table, int32_table, int16_table, int8_table, literal_table, float64_literal_table, float32_literal_table, string_literal_table, param_outer_emit, debug)
    };
    float_to_exit: string <- case fn_val.body.kind == 5 of {
        true -> "";
        false -> case main_returns_float64(fn_val.name, fn_val.return_type) of {
            true -> "    FCVTZS W0, D0\n";
            false -> case main_returns_float32(fn_val.name, fn_val.return_type) of {
                true -> "    FCVTZS W0, S0\n";
                false -> ""
            }
        }
    };
    tuple_ret_dealloc: string <- case fn_val.body.kind == 5 of {
        true -> "";
        false -> case reg_conventions@is_tuple_type(fn_val.return_type) of {
            true -> case use_actor_reply_sret_buffer(fn_val) of {
                true -> "";
                false -> do
                    tc: int64 <- prims_tuple@count_type_elements(fn_val.return_type);
                    ts: int64 <- prims_tuple@flat_alloc_size(tc);
                    concat("    ADD SP, SP, #", concat(atom_table@int64_to_decimal_string(ts), "\n"))
                end
            };
            false -> ""
        }
    };
    callee_saved_restore: string <- case function_needs_callee_saved_x19_x20_frame(fn_val) of {
        true -> "    LDP X19, X20, [SP], #16\n";
        false -> ""
    };
    actor_x21_x22_restore: string <- case needs_actor_ref_x21_x22_frame(fn_val) of {
        true -> "    LDP X21, X22, [SP], #16\n";
        false -> ""
    };
    callee_x23_x24_restore: string <- case needs_callee_x23_x24_frame(fn_val) of {
        true -> "    LDP X23, X24, [SP], #16\n";
        false -> ""
    };
    callee_x25_x26_restore: string <- case needs_callee_x25_x26_frame(fn_val) of {
        true -> "    LDP X25, X26, [SP], #16\n";
        false -> ""
    };
    callee_x27_x28_restore: string <- case needs_callee_x27_x28_frame(fn_val) of {
        true -> "    LDP X27, X28, [SP], #16\n";
        false -> ""
    };
    // Restore in reverse order of save: X27,X28 → X25,X26 → X23,X24 → X21,X22 → X19,X20
    epilogue: string <- case fn_val.body.kind == 5 of {
        true -> "";
        false -> case string_shadow of {
            true -> do
                ep_sh: string <- concat("    LDP X19, X20, [SP], #16\n", control@function_epilogue_with_effects(fn_val.effects));
                ep_sh_1: string <- concat(actor_x21_x22_restore, ep_sh);
                ep_sh_2: string <- concat(callee_x23_x24_restore, ep_sh_1);
                ep_sh_3: string <- concat(callee_x25_x26_restore, ep_sh_2);
                ep_sh_4: string <- concat(callee_x27_x28_restore, ep_sh_3);
                concat(tuple_ret_dealloc, ep_sh_4)
            end;
            false -> do
                ep_ns: string <- concat(callee_saved_restore, control@function_epilogue_with_effects(fn_val.effects));
                ep_ns_1: string <- concat(actor_x21_x22_restore, ep_ns);
                ep_ns_2: string <- concat(callee_x23_x24_restore, ep_ns_1);
                ep_ns_3: string <- concat(callee_x25_x26_restore, ep_ns_2);
                ep_ns_4: string <- concat(callee_x27_x28_restore, ep_ns_3);
                concat(tuple_ret_dealloc, ep_ns_4)
            end
        }
    };
    concat(concat(concat(eff_comment, "\n"), concat(prologue_full, "\n")), concat(concat(concat(body, "\n"), float_to_exit), epilogue))
    end
}

// True when main returns float64: emit FCVTZS W0, D0 so process exit code reflects computed value.
fn main_returns_float64(name: string, return_type: string) -> bool {
    case return_type == "float64" of {
        true -> case name of {
            "main" -> true;
            "main.main" -> true;
            "main.m" -> true;
            _: string -> false
        };
        false -> false
    }
}

// True when main returns float32: emit FCVTZS W0, S0 so process exit code reflects computed value.
fn main_returns_float32(name: string, return_type: string) -> bool {
    case return_type == "float32" of {
        true -> case name of {
            "main" -> true;
            "main.main" -> true;
            "main.m" -> true;
            _: string -> false
        };
        false -> false
    }
}

// Use "main" as label for main entry point; never emit main.main or main.m
fn entry_point_label(name: string) -> string {
    case name of {
        "main.main" -> "main";
        "main.m" -> "main";
        "main" -> "main";
        _: string -> name
    }
}
