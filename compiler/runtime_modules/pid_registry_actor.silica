// Global PID registry (process-wide actor_ref in _silica_pid_registry_ref; see prims_actors_runtime_asm).
//
// Architecture (design_documents/pid_registry_process_global_actor_gate.md):
//   - The slot table + overflow list live only inside this actor's behavior state.
//   - Application code obtains the registry solely via the get_pid_registry() primitive (same slot as
//     get_registry_actor; see emitter) and talks to it with messages.
//   - Table helpers below are intentionally not exported so nothing can bypass the actor API by linking another module.
//
// Message type: { op: atom, name: atom, pid: actor_ref }
// Reply type: (atom, actor_ref)
//
// Startup: emitter injects BL _silica_pid_registry_init at main entry (runtime asm); it spawns this
// behavior with empty_reg state and stores the actor_ref in _silica_pid_registry_ref.

export empty_reg/0;
export registry_beh/2;

// --- Private: dense direct table (cap 240) + List overflow (design_documents/atom_actor_registry_direct_index_design.md). ---

fn no_op_beh(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state)
}

fn pid_direct_cap() -> int64 {
    240
}

fn pid_reg_clear_cells(lo: int64, hi_exclusive: int64, occ: buf(L1, normal, int64, 240), stor: buf(L1, normal, int64, 240)) -> atom {
    sequence proc[mem(normal)]
        _: atom <- case hi_exclusive <= lo of {
            true -> :ok;
            false -> case hi_exclusive == lo + 1 of {
                true -> do
                    _: atom <- write_buf(occ, lo, 0);
                    write_buf(stor, lo, 0)
                end;
                false -> do
                    mid: int64 <- (lo + hi_exclusive) / 2;
                    _: atom <- pid_reg_clear_cells(lo, mid, occ, stor);
                    pid_reg_clear_cells(mid, hi_exclusive, occ, stor)
                end
            }
        }
    produces
        pure :ok
    end
}

fn empty_reg() ->
    {
        rg: region(L1, normal),
        occ: buf(L1, normal, int64, 240),
        stor: buf(L1, normal, int64, 240),
        overflow: List[{ name: atom, pid: actor_ref }, mem(normal)]
    }
{
    sequence proc[mem(normal)]
        L1: lifetime <- fresh_lifetime();
        r: region(L1, normal) <- alloc_region(normal);
        occ_buf: buf(L1, normal, int64, 240) <- alloc_buf(r, pid_direct_cap());
        stor_buf: buf(L1, normal, int64, 240) <- alloc_buf(r, pid_direct_cap());
        _: atom <- pid_reg_clear_cells(0, pid_direct_cap(), occ_buf, stor_buf);
        empty_ov: List[{ name: atom, pid: actor_ref }, mem(normal)] <- empty[{ name: atom, pid: actor_ref }, mem(normal)]();
        tbl: {
            rg: region(L1, normal),
            occ: buf(L1, normal, int64, 240),
            stor: buf(L1, normal, int64, 240),
            overflow: List[{ name: atom, pid: actor_ref }, mem(normal)]
        } <- { rg: r, occ: occ_buf, stor: stor_buf, overflow: empty_ov }
    produces
        pure tbl
    end
}

fn pid_overflow_insert_cons(
    h: { name: atom, pid: actor_ref },
    rest: List[{ name: atom, pid: actor_ref }, mem(normal)],
    name: atom,
    pid: actor_ref
) -> List[{ name: atom, pid: actor_ref }, mem(normal)]
{
    sequence proc[mem(normal)]
        r: List[{ name: atom, pid: actor_ref }, mem(normal)] <- case (h.name == name) of {
            true ->
                prepend[{ name: atom, pid: actor_ref }, mem(normal)](
                    { name: name, pid: pid },
                    rest
                );
            false ->
                prepend[{ name: atom, pid: actor_ref }, mem(normal)](
                    h,
                    pid_overflow_insert(rest, name, pid)
                )
        }
    produces
        pure r
    end
}

fn pid_overflow_insert(reg: List[{ name: atom, pid: actor_ref }, mem(normal)], name: atom, pid: actor_ref)
    -> List[{ name: atom, pid: actor_ref }, mem(normal)]
{
    sequence proc[mem(normal)]
        next: List[{ name: atom, pid: actor_ref }, mem(normal)] <- case reg of {
            []: List[{ name: atom, pid: actor_ref }, mem(normal)] ->
                prepend[{ name: atom, pid: actor_ref }, mem(normal)](
                    { name: name, pid: pid },
                    empty[{ name: atom, pid: actor_ref }, mem(normal)]()
                );
            [h: { name: atom, pid: actor_ref }, rest: List[{ name: atom, pid: actor_ref }, mem(normal)]] ->
                pid_overflow_insert_cons(h, rest, name, pid);
            _: List[{ name: atom, pid: actor_ref }, mem(normal)] ->
                empty[{ name: atom, pid: actor_ref }, mem(normal)]()
        }
    produces
        pure next
    end
}

fn pid_overflow_lookup_rec_cons(
    h: { name: atom, pid: actor_ref },
    rest: List[{ name: atom, pid: actor_ref }, mem(normal)],
    name: atom
) -> (boolean, actor_ref)
{
    sequence proc[mem(normal)]
        lr: (boolean, actor_ref) <- case (h.name == name) of {
            true -> (true, h.pid);
            false -> pid_overflow_lookup_rec(rest, name)
        }
    produces
        pure lr
    end
}

fn pid_overflow_lookup_rec(reg: List[{ name: atom, pid: actor_ref }, mem(normal)], name: atom) -> (boolean, actor_ref) {
    sequence proc[mem(normal)]
        lr: (boolean, actor_ref) <- case reg of {
            []: List[{ name: atom, pid: actor_ref }, mem(normal)] ->
                (false, actor_ref_of_word(0));
            [h: { name: atom, pid: actor_ref }, rest: List[{ name: atom, pid: actor_ref }, mem(normal)]] ->
                pid_overflow_lookup_rec_cons(h, rest, name);
            _: List[{ name: atom, pid: actor_ref }, mem(normal)] ->
                (false, actor_ref_of_word(0))
        }
    produces
        pure lr
    end
}

fn pid_overflow_lookup(reg: List[{ name: atom, pid: actor_ref }, mem(normal)], name: atom) -> (atom, actor_ref) {
    sequence proc[mem(normal)]
        p: (boolean, actor_ref) <- pid_overflow_lookup_rec(reg, name);
        (hit: boolean, found_ref: actor_ref) <- p;
        lr: (atom, actor_ref) <- case hit of {
            true -> (:found, found_ref);
            false -> (:not_found, actor_ref_of_word(0))
        }
    produces
        pure lr
    end
}

fn pid_overflow_delete_cons(
    h: { name: atom, pid: actor_ref },
    rest: List[{ name: atom, pid: actor_ref }, mem(normal)],
    name: atom
) -> List[{ name: atom, pid: actor_ref }, mem(normal)]
{
    sequence proc[mem(normal)]
        r: List[{ name: atom, pid: actor_ref }, mem(normal)] <- case (h.name == name) of {
            true -> rest;
            false ->
                prepend[{ name: atom, pid: actor_ref }, mem(normal)](
                    h,
                    pid_overflow_delete(rest, name)
                )
        }
    produces
        pure r
    end
}

fn pid_overflow_delete(reg: List[{ name: atom, pid: actor_ref }, mem(normal)], name: atom)
    -> List[{ name: atom, pid: actor_ref }, mem(normal)]
{
    sequence proc[mem(normal)]
        next: List[{ name: atom, pid: actor_ref }, mem(normal)] <- case reg of {
            []: List[{ name: atom, pid: actor_ref }, mem(normal)] ->
                empty[{ name: atom, pid: actor_ref }, mem(normal)]();
            [h: { name: atom, pid: actor_ref }, rest: List[{ name: atom, pid: actor_ref }, mem(normal)]] ->
                pid_overflow_delete_cons(h, rest, name);
            _: List[{ name: atom, pid: actor_ref }, mem(normal)] ->
                empty[{ name: atom, pid: actor_ref }, mem(normal)]()
        }
    produces
        pure next
    end
}

// --- Exported actor API: single `case atom_bits(msg.op) of` with int64 guards. Nested `case msg.op == …` or
//    `case msg.op of` lowers to a stub for this `(:reply, …)` return in the bootstrap compiler. Atom ids 23/27/29
//    are :insert / :lookup / :delete for this compilation unit (same as prior registry_beh cmp immediates). ---

fn registry_beh(msg: { op: atom, name: atom, pid: actor_ref }, state: {
        rg: region(L1, normal),
        occ: buf(L1, normal, int64, 240),
        stor: buf(L1, normal, int64, 240),
        overflow: List[{ name: atom, pid: actor_ref }, mem(normal)]
    }) -> (:reply, (atom, actor_ref), {
        rg: region(L1, normal),
        occ: buf(L1, normal, int64, 240),
        stor: buf(L1, normal, int64, 240),
        overflow: List[{ name: atom, pid: actor_ref }, mem(normal)]
    })
{
    sequence
        op_tag: int64 <- atom_bits(msg.op);
        reply: (:reply, (atom, actor_ref), {
            rg: region(L1, normal),
            occ: buf(L1, normal, int64, 240),
            stor: buf(L1, normal, int64, 240),
            overflow: List[{ name: atom, pid: actor_ref }, mem(normal)]
        }) <- case op_tag of {
            o: int64 if o == 23 -> {
                sequence proc[concurrency, mem(normal)]
                    id_in: int64 <- atom_bits(msg.name);
                    cap_in: int64 <- pid_direct_cap();
                    use_direct_in: bool <- id_in >= 0 and id_in < cap_in;
                    updated_in: {
                        rg: region(L1, normal),
                        occ: buf(L1, normal, int64, 240),
                        stor: buf(L1, normal, int64, 240),
                        overflow: List[{ name: atom, pid: actor_ref }, mem(normal)]
                    } <- case use_direct_in of {
                        true -> do
                            w_in: int64 <- actor_ref_bits(msg.pid);
                            _: atom <- write_buf(state.occ, id_in, 1);
                            _: atom <- write_buf(state.stor, id_in, w_in);
                            state
                        end;
                        false -> do
                            next_ov_in: List[{ name: atom, pid: actor_ref }, mem(normal)] <- pid_overflow_insert(state.overflow, msg.name, msg.pid);
                            { rg: state.rg, occ: state.occ, stor: state.stor, overflow: next_ov_in }
                        end
                    };
                    ok_pair_in: (atom, actor_ref) <- (:ok, msg.pid)
                produces
                    pure (:reply, ok_pair_in, updated_in)
                end
            }
            o: int64 if o == 27 -> {
                sequence proc[concurrency, mem(normal)]
                    id_lu: int64 <- atom_bits(msg.name);
                    cap_lu: int64 <- pid_direct_cap();
                    use_direct_lu: bool <- id_lu >= 0 and id_lu < cap_lu;
                    found_lu: (atom, actor_ref) <- case use_direct_lu of {
                        false -> pid_overflow_lookup(state.overflow, msg.name);
                        true -> do
                            mark_lu: int64 <- read_buf(state.occ, id_lu);
                            hit_lu: bool <- mark_lu == 1;
                            lr_lu: (atom, actor_ref) <- case hit_lu of {
                                false -> (:not_found, actor_ref_of_word(0));
                                true -> do
                                    w_lu: int64 <- read_buf(state.stor, id_lu);
                                    rf_lu: actor_ref <- actor_ref_of_word(w_lu);
                                    (:found, rf_lu)
                                end
                            };
                            lr_lu
                        end
                    }
                produces
                    pure (:reply, found_lu, state)
                end
            }
            o: int64 if o == 29 -> {
                sequence proc[concurrency, mem(normal)]
                    id_del: int64 <- atom_bits(msg.name);
                    cap_del: int64 <- pid_direct_cap();
                    use_direct_del: bool <- id_del >= 0 and id_del < cap_del;
                    pruned_del: {
                        rg: region(L1, normal),
                        occ: buf(L1, normal, int64, 240),
                        stor: buf(L1, normal, int64, 240),
                        overflow: List[{ name: atom, pid: actor_ref }, mem(normal)]
                    } <- case use_direct_del of {
                        false -> do
                            next_ov_del: List[{ name: atom, pid: actor_ref }, mem(normal)] <- pid_overflow_delete(state.overflow, msg.name);
                            { rg: state.rg, occ: state.occ, stor: state.stor, overflow: next_ov_del }
                        end;
                        true -> do
                            _: atom <- write_buf(state.occ, id_del, 0);
                            state
                        end
                    };
                    ok_pair_del: (atom, actor_ref) <- (:ok, msg.pid)
                produces
                    pure (:reply, ok_pair_del, pruned_del)
                end
            }
            _: int64 -> (:reply, (:unknown_op, msg.pid), state)
        }
    produces
        pure reply
    end
}
