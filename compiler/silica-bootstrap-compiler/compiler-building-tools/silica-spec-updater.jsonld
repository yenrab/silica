{
  "@context": {
    "@vocab": "https://aalang.dev/silica-spec-updater/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "ex": "https://aalang.dev/silica-spec-updater/example/"
  },
  "@graph": [
    {
      "@id": "ex:CopyrightNotice",
