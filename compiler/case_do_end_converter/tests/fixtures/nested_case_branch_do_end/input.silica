fn narrow_slot(slot_i: TokenSlot, slot_next: TokenSlot, constraint_list: ListConstraint) -> TokenSlot {
    case slot_has_single_role(slot_i) of {
        true -> do
            allowed: ListInt <- constraints_for_role(slot_role(slot_i), constraint_list);
            case allowed.is_nil of {
                true -> slot_next;
                false -> do
                    new_roles: ListInt <- intersect_roles(slot_next.possible_roles, allowed);
                    TokenSlot { token: slot_next.token, possible_roles: new_roles }
                end
            }
        end;
        false -> slot_next
    }
}
