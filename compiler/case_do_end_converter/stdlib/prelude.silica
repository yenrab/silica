// Silica Standard Library Prelude
// Commonly used imports that are available by default

// Re-export from option
use option;
export some/1, none/0, is_some/1, unwrap_or/2;

// Re-export from result
use result;
export Ok/1, Err/1, is_ok/1, is_err/1, unwrap/1, unwrap_err/1, unwrap_or/2, map/2, map_err/2, and_then/2;

// Re-export from io
use io;
export print/1, println/1, print_int/1;

// Re-export from vec
use vec;
export new/0, push/2, pop/1, get/2, len/1, is_empty/1, clear/1;

// Re-export from math
use math;
export abs/1, min/2, max/2;

// Re-export from string
use string;
export len/1, concat/2;
