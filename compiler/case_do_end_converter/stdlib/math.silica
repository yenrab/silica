// Silica Standard Library - Mathematical Functions
// Provides common mathematical operations and constants

export abs/1, min/2, max/2;

// Basic arithmetic functions
fn abs(x: int64) -> int64 {
    if x < 0 {
        -x
    } else {
        x
    }
}

fn min(a: int64, b: int64) -> int64 {
    if a < b {
        a
    } else {
        b
    }
}

fn max(a: int64, b: int64) -> int64 {
    if a > b {
        a
    } else {
        b
    }
}
