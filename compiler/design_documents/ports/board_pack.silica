// Display on SPI2 through FPC P2; shares GPIO0 with Point, GPIO10 with Right, GPIO45 with minidip B.
fn pin_display_cs() -> int64 {
    0
}

fn pin_display_dc() -> int64 {
    45
}

fn pin_display_spi_cs() -> int64 {
    10
}

fn pin_display_clk() -> int64 {
    46
}

fn pin_display_mosi() -> int64 {
    3
}

fn pin_minidip_a_clk() -> int64 {
    13
}

// IO1..IO3 as i = 1..3.
fn pin_minidip_a_io(i: int64) -> int64 {
    case i of {
        1 -> 14;
        2 -> 15;
        3 -> 16;
        _: int64 -> 0 - 1
    }
}

fn pin_minidip_b_clk() -> int64 {
    45
}

fn pin_minidip_b_io(i: int64) -> int64 {
    case i of {
        1 -> 17;
        2 -> 18;
        3 -> 12;
        _: int64 -> 0 - 1
    }
}
