// ESP32-S3 port app 18: "Hello from / Silica" on the ST7789 through the display device worker
// (device_lib/device_st7789), which drives the panel from the SPI2 peripheral and owns the GPIO,
// IO_MUX, SPI2 and SYSTEM windows. Same picture as asm_13_display_hello: black screen, white text
// centred on two lines, landscape; unlike asm_13 the worker's :init writes the frame black before
// it turns the display on, so nothing but black is ever shown before the text, and the whole run
// takes about a second where the bit-banged version took 26 s. Expected console: "text", status 0
// (the panel shows the text).
use device_st7789;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        d: device_actor_ref <- spawn_device(:unmapped, device_st7789@st7789_worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device(d, { op: :init, x: 0, y: 0, colour: 0, text: "" } impl ActorMessage {});
        _: boolean <- cast_device(d, { op: :text, x: 42, y: 88, colour: 65535, text: "Hello from" } impl ActorMessage {});
        _: boolean <- cast_device(d, { op: :text, x: 90, y: 124, colour: 65535, text: "Silica" } impl ActorMessage {});
        println("text");
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
