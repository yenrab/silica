// ESP32-S3 port app 16: a device worker prints on UART0 through peek and poke
// (silica_device_actor_specification.md §4.6 handshake; the driver is device_lib/device_esp32s3_uart).
// main only spawns the worker, casts it its work, and waits. The worker maps the window on :init.
// Expected console: "hello from a device worker", status 0.
use device_esp32s3_uart;

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        u: device_actor_ref <- spawn_device(:unmapped, device_esp32s3_uart@uart_worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device(u, { op: :init, byte: 0, text: "" } impl ActorMessage {});
        _: boolean <- cast_device(u, { op: :puts, byte: 0, text: "hello from a device worker\n" } impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
