// ESP32-S3 port app 17: the LED and a button through the GPIO device worker
// (device_lib/device_esp32s3_gpio). The worker lights LED1 (GPIO6), reads the Left button (GPIO21)
// after a 10-tick :hold (about 10 ms) so the pull-up has settled before the first read,
// and casts the level to a printer actor, then turns the LED off. Left idles at 0 (board_pack).
// Expected console: "left button 0", status 0.
use device_esp32s3_gpio;

fn printer(level: uint32, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- print_string("left button ");
        _: atom <- print_uint32(level);
        println("")
    produces
        pure (:no_reply, state)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        p: actor_ref <- spawn(0, printer, stack_policy(0, :keep_last_message));
        w: device_actor_ref <- spawn_device(:unmapped, device_esp32s3_gpio@gpio_worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast_device(w, { op: :init, pin: 0, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :output, pin: 6, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 6, level: 1, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :input_pullup, pin: 21, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :hold, pin: 0, level: 10, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :read, pin: 21, level: 0, reply_to: p } impl ActorMessage {});
        _: boolean <- cast_device(w, { op: :write, pin: 6, level: 0, reply_to: p } impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
