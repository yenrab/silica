// Case expression with guards test
fn is_positive(x: int64) -> boolean {
    x > 0
}

fn test_guards(x: int64) -> int64 {
    case x of {
        y: int64 if is_positive(y) -> y * 2;
        _: int64 -> 0             // Fallback
    }
}

fn main() -> int64 {
    test_guards(15)  // Should return 30 (15 * 2) - first guard matches
}
