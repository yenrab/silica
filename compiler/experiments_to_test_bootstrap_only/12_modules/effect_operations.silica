// Effect operations module
// Functions that use effects from effect_definitions module

// Import effect definitions
use effect_definitions;

// Function using I/O effect
export io_function/1;

fn io_function(message: string) -> int64 proc[io_effect] {
    do
        println(message);
        42
    end
}

// Function using memory effect
// Note: This is a placeholder since we don't have actual memory operations
// in the bootstrap compiler yet, but demonstrates the effect declaration
export memory_function/1;

fn memory_function(value: int64) -> int64 proc[memory_effect] {
    // In a real implementation, this would perform memory operations
    // For now, just return the value to demonstrate effect declaration
    value
}

// Function using combined I/O and memory effects
export io_memory_function/1;

fn io_memory_function(value: int64) -> int64 proc[io_memory_effect] {
    do
        print("Processing value: ");
        print_int64(value);
        println("");
        // In a real implementation, this would also perform memory operations
        value * 2
    end
}
