// Comprehensive File I/O Test
// Tests all I/O intrinsic functions
//
// WORKING FUNCTIONS (call runtime):
// - read_lines: calls silica_read_file, returns file content string
// - append_file: calls silica_write_file, returns success bool
// - file_exists: calls silica_read_file, returns existence bool
//
// PLACEHOLDER FUNCTIONS (return constants, need runtime impl):
// - delete_file: returns true
// - get_file_size: returns 0
// - create_directory: returns true
// - remove_directory: returns true
// - list_directory: returns ""
//
// BUG: Bootstrap compiler only generates LLVM for first I/O call in do block

fn main() -> int64 proc[DeviceIO] {
        // Test file reading (generates actual LLVM call to runtime)
        content:string <- read_lines("test.txt");
        print(content);
        println("");
        // Test file writing/appending (placeholder implementation)
        success1:bool <- append_file("test.txt", "Hello World!");
        print("success1: ");
        print_bool(success1);
        println("");

        print("Reading file using variable: ");
        file_name:string <- "test.txt";
        content2:string <- read_lines(file_name);
        print(content2);
        println("");

        // Test file operations
        exists:bool <- file_exists("test.txt");
        print("exists: ");
        print_bool(exists);
        println("");
        success2:bool <- delete_file("test.txt");
        size:int64 <- get_file_size("test.txt");
        print("size: ");
        print_int64(size);
        println("");

        // Test directory operations
        success3:bool <- create_directory("test_dir");
        print("success3: ");
        print_bool(success3);
        println("");
        success4:bool <- remove_directory("test_dir");
        listing:string <- list_directory(".");
        print("listing: ");
        println(listing);
        println("");
        0
}