// Test string_to_int64 function: string_to_int64(s: string) -> int64
// Converts integer-as-string to int64

fn main() -> int64 proc[DeviceIO] {
    do
        println("=== Testing string_to_int64 ===");

        n1: int64 <- string_to_int64("42");
        print_int64(n1);
        println("");

        n2: int64 <- string_to_int64("-123");
        print_int64(n2);
        println("");
        n3: int64 <- string_to_int64("0");
        print_int64(n3);
        println("");
        n4: int64 <- string_to_int64("  99  ");
        print_int64(n4);
        println("");
        println("Done");
        42
    end
}
