// Test int32 I/O operations
// Tests printing int32 values using print_int (with casting to int64)

fn test_int32_io() -> int64 proc[DeviceIO] {
    do
        print("Testing int32 I/O: ");
        println("");
        
        // Test various int32 values
        val1: int32 <- 42;
        val2: int32 <- 1000000;
        val3: int32 <- -500000;
        val4: int32 <- 2147483647;  // max int32
        val5: int32 <- -2147483648; // min int32
        
        print("int32 value 1: ");
        print_int32(val1);
        println("");
        
        print("int32 value 2: ");
        print_int32(val2);
        println("");
        
        print("int32 value 3: ");
        print_int32(val3);
        println("");
        
        print("int32 value 4 (max): ");
        print_int32(val4);
        println("");
        
        print("int32 value 5 (min): ");
        print_int32(val5);
        println("");
        
        0
    end
}

fn main() -> int64 proc[DeviceIO] {
    result: int64 <- test_int32_io();
    result
}
