// Test int8 I/O operations
// Tests printing int8 values using print_int (with casting to int64)

fn test_int8_io() -> int64 proc[DeviceIO] {
    do
        print("Testing int8 I/O: ");
        println("");
        
        // Test various int8 values
        val1: int8 <- 42;
        val2: int8 <- 100;
        val3: int8 <- -50;
        val4: int8 <- 127;   // max int8
        val5: int8 <- -128;  // min int8
        
        print("int8 value 1: ");
        print_int8(val1);
        println("");
        
        print("int8 value 2: ");
        print_int8(val2);
        println("");
        
        print("int8 value 3: ");
        print_int8(val3);
        println("");
        
        print("int8 value 4 (max): ");
        print_int8(val4);
        println("");
        
        print("int8 value 5 (min): ");
        print_int8(val5);
        println("");
        
        0
    end
}

fn main() -> int64 proc[DeviceIO] {
    result: int64 <- test_int8_io();
    result
}
