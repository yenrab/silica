-- Test executing function literals returned from functions
-- Demonstrates that functions can return function literals that are then called

-- Function that returns a multiplier function
fn make_multiplier(factor: int64) -> fn(int64) -> int64 {
    fn(x: int64) -> int64 { x * factor }
}

-- Function that returns an adder function
fn make_adder(base: int64) -> fn(int64) -> int64 {
    fn(x: int64) -> int64 { x + base }
}

-- Function that returns a conditional function
fn make_conditional(threshold: int64) -> fn(int64) -> int64 {
    fn(x: int64) -> int64 {
        case x > threshold of {
            true -> x * 2
            false -> x + threshold
        }
    }
}

-- Function that returns a function with captured variables
fn make_power_function(power: int64) -> fn(int64) -> int64 {
    fn(base: int64) -> int64 {
        case power of {
            2 -> base * base
            3 -> base * base * base
            _: int64 -> base
        }
    }
}

fn main() -> int64 {
    -- Test 1: Call a returned multiplier function
    doubler: fn(int64) -> int64 <- make_multiplier(2);
    result1: int64 <- doubler(5);  -- Should be 10 (5 * 2)

    -- Test 2: Call a returned adder function
    add_ten: fn(int64) -> int64 <- make_adder(10);
    result2: int64 <- add_ten(7);  -- Should be 17 (7 + 10)

    -- Test 3: Call a returned conditional function
    conditional_func: fn(int64) -> int64 <- make_conditional(10);
    result3a: int64 <- conditional_func(15);  -- Should be 30 (15 > 10, so 15 * 2)
    result3b: int64 <- conditional_func(5);   -- Should be 15 (5 <= 10, so 5 + 10)

    -- Test 4: Call a returned power function
    squarer: fn(int64) -> int64 <- make_power_function(2);
    cuber: fn(int64) -> int64 <- make_power_function(3);
    result4a: int64 <- squarer(4);  -- Should be 16 (4^2)
    result4b: int64 <- cuber(3);    -- Should be 27 (3^3)

    -- Test 5: Chain returned functions
    multiplier: fn(int64) -> int64 <- make_multiplier(3);
    adder: fn(int64) -> int64 <- make_adder(5);
    temp: int64 <- multiplier(4);     -- 4 * 3 = 12
    result5: int64 <- adder(temp);    -- 12 + 5 = 17

    -- Test 6: Function factory with different parameters
    mul_by_5: fn(int64) -> int64 <- make_multiplier(5);
    mul_by_7: fn(int64) -> int64 <- make_multiplier(7);
    result6a: int64 <- mul_by_5(6);   -- Should be 30 (6 * 5)
    result6b: int64 <- mul_by_7(4);   -- Should be 28 (4 * 7)

    -- Return sum of results to verify correctness
    result1 + result2 + result3a + result3b + result4a + result4b + result5 + result6a + result6b
}
