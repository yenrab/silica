// Complex interaction test
fn complex_interaction_test() -> int64 proc[DeviceIO] {
    // Get some values
    base_val:int64 <- return_int();
    is_even_val:boolean <- helper_is_even(base_val);

    // Process with mixed types helper
    processed:int64 <- helper_mixed_types(base_val, is_even_val, 'A');

    // Get conditional result
    // final_val:int64 <- helper_conditional_val(processed);
    final_flag:boolean <- helper_conditional_flag(processed);

    // Format result
    // result_str:string <- helper_format_result(final_val, final_flag);

    // Output results
    print_int64(base_val);
    print_bool(is_even_val);
    print_int64(processed);
    // print_int64(final_val);
    print_bool(final_flag);
    // print(result_str);
    0
}

// Return type test functions
fn test_int_returns() -> int64 {
    val: int64 <- return_int();
    take_int(val);
    0
}

fn test_bool_returns() -> int64 {
    val: boolean <- return_bool();
    take_bool(val);
    0
}

fn test_char_returns() -> int64 {
    val: char <- return_char();
    take_char(val);
    0
}

fn test_unit_returns() -> int64 {
    val: int64 <- return_unit();
    take_int(val);
    0
}

fn test_string_returns() -> int64 {
    val: string <- return_string();
    take_string(val);
    0
}

fn test_tuple_returns() -> int64 {
    val:(int64, boolean) <- return_tuple();
    dummy: int64 <- take_tuple(val);
    0
}

fn chain_helpers() -> int64 {
    val1: int64 <- return_int();
    val2: int64 <- helper_mixed_types(val1, true, 'x');
    // val3 <- helper_conditional_val(val2);
    // take_int(val3);
    0
}


