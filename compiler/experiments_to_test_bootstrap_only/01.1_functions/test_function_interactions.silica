// Include the basic tests
fn test_function_types_basic() -> int64 {
    dummy1: int64 <- take_int(123);
    dummy2: int64 <- take_bool(false);
    dummy3: int64 <- take_char('z');

    i:int64 <- return_int();
    b:boolean <- return_bool();
    c:char <- return_char();
    u:int64 <- return_unit();

    dummy4: int64 <- take_int(i);
    dummy5: int64 <- take_bool(b);
    dummy6: int64 <- take_char(c);
    0
}

fn test_function_types_complex() -> int64 {
    dummy1: int64 <- take_string("Direct string");
    dummy2: int64 <- take_tuple((123, false));

    s:string <- return_string();
    t:(int64, boolean) <- return_tuple();

    dummy3: int64 <- take_string(s);
    dummy4: int64 <- take_tuple(t);

    dummy5: int64 <- use_helpers();
    0
}

fn test_helper_functions_types() -> int64 {
    dummy1: int64 <- test_primitive_helpers();
    dummy2: int64 <- test_complex_helpers();
    dummy3: int64 <- test_nested_helpers();
    0
}

fn test_return_types() -> int64 proc[DeviceIO] {
    dummy1: int64 <- test_int_returns();
    dummy2: int64 <- test_bool_returns();
    dummy3: int64 <- test_char_returns();
    dummy4: int64 <- test_unit_returns();
    dummy5: int64 <- test_string_returns();
    dummy6: int64 <- test_tuple_returns();

    chained: int64 <- chain_helpers();
    print_int64(chained);
    0
}

