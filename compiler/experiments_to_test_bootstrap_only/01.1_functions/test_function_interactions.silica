// Test comprehensive function and helper function interactions with types

fn take_int(x: int64) -> int64 { x }
fn take_bool(b: boolean) -> int64 { case b of { true -> 1; false -> 0 } }
fn take_char(c: char) -> int64 { 0 }
fn return_int() -> int64 { 42 }
fn return_bool() -> boolean { true }
fn return_char() -> char { 'a' }
fn return_unit() -> int64 { 0 }
fn take_string(s: string) -> int64 { 0 }
fn take_tuple(t: (int64, boolean)) -> int64 { 0 }
fn return_string() -> string { "test" }
fn return_tuple() -> (int64, boolean) { (1, true) }


  // Helper functions with mixed parameter types
  fn helper_mixed_types(i: int64, b: boolean, c: char) -> int64 {
    case b of {
        true -> i + 1;
        false -> i - 1
    }
  }

// Helper function for even checking
fn helper_is_even(n: int64) -> boolean {
    n % 2 == 0
}

// Helper function that calls other helpers
fn helper_caller(x: int64) -> boolean {
    even: boolean <- helper_is_even(x);
    positive: boolean <- x > 0;
    even and positive
}

// Helper functions that return individual values (bootstrap compiler workaround)
// fn helper_conditional_val(n: int64) -> int64 {
//     case n > 10 of {
//         true -> n * 2;
//         false -> n + 10
//     }
// }

fn helper_conditional_flag(n: int64) -> boolean {
    n > 10
}

// Additional helper functions for primitive types
fn test_primitive_helpers() -> int64 {
    i: int64 <- return_int();
    b: boolean <- return_bool();
    c: char <- return_char();
    u: int64 <- return_unit();

    take_int(i);
    take_bool(b);
    take_char(c);

    0
}

fn test_complex_helpers() -> int64 {
    s:string <- return_string();
    t:(int64, boolean) <- return_tuple();

    dummy1: int64 <- take_string(s);
    dummy2: int64 <- take_tuple(t);

    0
}

fn test_nested_helpers() -> int64 {
    val: int64 <- return_int();
    result: int64 <- helper_mixed_types(val, helper_is_even(val), 'x');
    take_int(result);

    0
}

fn use_helpers() -> int64 {
    test_primitive_helpers();
    test_complex_helpers();
    test_nested_helpers();

    0
}

// Main processing functions
fn process_with_helpers() -> int64 proc[DeviceIO] {
    // Test helper with mixed types

    result1: int64 <- helper_mixed_types(5, true, 'x');
    print_int64(result1);  // Should print 6

    result2: int64 <- helper_mixed_types(5, false, 'y');
    print_int64(result2);  // Should print 4

    // Test helper caller
    caller_result1: boolean <- helper_caller(4);
    print_bool(caller_result1);  // true (4 is even and positive)

    caller_result2: boolean <- helper_caller(-2);
    print_bool(caller_result2);  // false (-2 is negative)

    caller_result3: boolean <- helper_caller(3);
    print_bool(caller_result3);  // false (3 is odd)

    0
}

fn process_conditional_returns() -> int64 proc[DeviceIO] {
    // val1 <- helper_conditional_val(15);
    flag1: boolean <- helper_conditional_flag(15);
    // print_int64(val1);   // 30
    print_bool(flag1); // true

    // val2 <- helper_conditional_val(5);
    flag2: boolean <- helper_conditional_flag(5);
    // print_int64(val2);   // 15
    print_bool(flag2); // false
    0
}

