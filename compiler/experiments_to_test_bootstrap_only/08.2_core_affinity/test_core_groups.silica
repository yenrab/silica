// Core Groups Test
// Tests performance_cores, efficiency_cores, and specific core targeting
// This will now use actual CPU topology detection instead of hardcoded heuristics

fn main() -> int64 proc[concurrency] {
    do
        // Test 1: Performance cores targeting
        // Actors that need high performance
        spawn(0, fn(msg: int64, state: int64) -> int64 {
            // Simulate CPU-intensive computation
            state + msg * msg
        }, performance_cores);

        spawn(10, fn(msg: int64, state: int64) -> int64 {
            // Real-time processing actor
            case msg of {
                value: int64 if value > 0 -> state;       // Primitive comparison
                _: int64 -> state + msg                                   // Fallback
            }
        }, performance_cores);

        // Test 2: Efficiency cores targeting
        // Background processing, power-conscious actors
        spawn(100, fn(msg: int64, state: int64) -> int64 {
            // Low-priority background work
            state + 1
        }, efficiency_cores);

        spawn(200, fn(msg: int64, state: int64) -> int64 {
            // Idle-time maintenance
            state + msg
        }, efficiency_cores);

        // Test 3: Specific core pinning
        // Actors that must run on exact cores
        spawn(1000, fn(msg: int64, state: int64) -> int64 {
            // GPU coordination - needs core 0
            state + msg
        }, 0);

        spawn(2000, fn(msg: int64, state: int64) -> int64 {
            // Network I/O - needs core 1
            state + msg
        }, 1);

        spawn(3000, fn(msg: int64, state: int64) -> int64 {
            // Storage I/O - needs core 2
            state + msg
        }, 2);

        // Test 4: Mixed core requirements
        // Demonstrates different affinity strategies in same system
        spawn(5000, fn(msg: int64, state: int64) -> int64 {
            // User interface - performance matters
            state + msg
        }, performance_cores);

        spawn(6000, fn(msg: int64, state: int64) -> int64 {
            // Background sync - efficiency matters
            state + msg
        }, efficiency_cores);

        spawn(7000, fn(msg: int64, state: int64) -> int64 {
            // General computation - any core fine
            state + msg
        }, any_core);

        0
    end
}
