// =================================================
// THE MAYBE MONAD - A COMPREHENSIVE EXAMPLE
// =================================================
// The Maybe monad (also called Option monad) represents computations
// that might fail or produce no result. It provides a way to:
//
// 1. Handle optional values safely
// 2. Chain operations that might fail
// 3. Avoid null pointer exceptions
// 4. Compose functions that return optional results
//
// Core operations:
// - pure/return: Wrap a value in the monad
// - bind/flatMap: Chain operations that return Maybe values
// - map: Transform the value if present
// =================================================

// =================================================
// MAYBE MONAD TRAIT DEFINITION
// =================================================

trait MaybeMonad {
    // Unit operation: pure(a) wraps a value
    fn pure(value: int64) -> Self;

    // Bind operation: chains computations that might fail
    fn bind(self: Self, f: (int64) -> Self) -> Self;

    // Map operation: transform value if present (derived from bind)
    fn map(self: Self, f: (int64) -> int64) -> Self {
        self.bind((x) -> Self::pure(f(x)))
    }

    // Check if value is present
    fn is_some(self: Self) -> bool;

    // Get the value (unsafe - only call if is_some() is true)
    fn unwrap(self: Self) -> int64;

    // Get value with default
    fn unwrap_or(self: Self, default: int64) -> int64 {
        if self.is_some() {
            self.unwrap()
        } else {
            default
        }
    }

    // Get value with default function
    fn unwrap_or_else(self: Self, default_fn: () -> int64) -> int64 {
        if self.is_some() {
            self.unwrap()
        } else {
            default_fn()
        }
    }

    // Monad law verification
    fn left_identity_law_holds(value: int64, f: (int64) -> Self) -> bool {
        let m = Self::pure(value);
        let bound = m.bind(f);
        let direct = f(value);
        bound.equals(direct)
    }

    fn right_identity_law_holds(self: Self) -> bool {
        let bound = self.bind((x) -> Self::pure(x));
        self.equals(bound)
    }

    // Equality for law verification
    fn equals(self: Self, other: Self) -> bool;
}

// =================================================
// MAYBE CONCRETE TYPE IMPLEMENTATION
// =================================================

// The Maybe type: either contains a value (Some) or nothing (None)
type MaybeInt = { is_present: bool, value: int64 };

impl MaybeMonad for MaybeInt {
    fn pure(value: int64) -> MaybeInt {
        MaybeInt { is_present: true, value: value }
    }

    fn bind(self: MaybeInt, f: (int64) -> MaybeInt) -> MaybeInt {
        if self.is_present {
            f(self.value)
        } else {
            MaybeInt { is_present: false, value: 0 }
        }
    }

    fn is_some(self: MaybeInt) -> bool {
        self.is_present
    }

    fn unwrap(self: MaybeInt) -> int64 {
        self.value  // Caller must ensure is_some() is true
    }

    fn equals(self: MaybeInt, other: MaybeInt) -> bool {
        if self.is_present && other.is_present {
            self.value == other.value
        } else if !self.is_present && !other.is_present {
            true
        } else {
            false
        }
    }
}

// =================================================
// MAYBE MONAD USAGE EXAMPLES
// =================================================

// Example 1: Safe division (handles division by zero)
fn safe_divide(numerator: int64, denominator: int64) -> MaybeInt {
    if denominator == 0 {
        MaybeInt { is_present: false, value: 0 }  // None
    } else {
        MaybeInt::pure(numerator / denominator)     // Some(result)
    }
}

// Example 2: Safe square root (handles negative numbers)
fn safe_sqrt(x: int64) -> MaybeInt {
    if x < 0 {
        MaybeInt { is_present: false, value: 0 }  // None
    } else {
        // Simplified integer square root approximation
        let mut result = 0;
        let mut i = 1;
        while i * i <= x {
            result = i;
            i = i + 1;
        }
        MaybeInt::pure(result)
    }
}

// Example 3: Chain multiple operations that might fail
fn complex_calculation(a: int64, b: int64, c: int64) -> MaybeInt {
    safe_divide(a, b)              // a/b
        .bind((x) -> safe_divide(x, c))  // (a/b)/c
        .bind((y) -> safe_sqrt(y))       // sqrt((a/b)/c)
        .map((z) -> z * 2)               // 2 * sqrt((a/b)/c)
}

// Example 4: Find first element matching a predicate
fn find_first_positive(numbers: MaybeInt, count: int64) -> MaybeInt {
    if count <= 0 {
        MaybeInt { is_present: false, value: 0 }
    } else {
        // Check current number
        if numbers.is_some() && numbers.unwrap() > 0 {
            numbers
        } else {
            // Recursively check next (simplified - would need a list in real implementation)
            find_first_positive(MaybeInt { is_present: false, value: 0 }, count - 1)
        }
    }
}

// Example 5: Configuration lookup with defaults
type Config = { database_url: MaybeInt, timeout: MaybeInt, retries: MaybeInt };

fn get_database_config(config: Config) -> int64 {
    config.database_url
        .unwrap_or(8080)  // Default port if not specified
}

fn get_timeout_config(config: Config) -> int64 {
    config.timeout
        .unwrap_or_else(() -> 30)  // Default 30 seconds if not specified
}

fn get_retries_config(config: Config) -> int64 {
    config.retries
        .unwrap_or(3)  // Default 3 retries if not specified
}

// =================================================
// DEMONSTRATION OF MONAD LAWS
// =================================================

fn demonstrate_maybe_monad_laws() -> int64 {
    // Test values
    let test_value = 42;
    let test_fn = (x) -> MaybeInt::pure(x * 2);

    // Left identity: pure(a).bind(f) ≡ f(a)
    let left_id_passes = MaybeInt::left_identity_law_holds(test_value, test_fn);

    // Right identity: m.bind(pure) ≡ m
    let some_value = MaybeInt::pure(10);
    let none_value = MaybeInt { is_present: false, value: 0 };
    let right_id_some_passes = some_value.right_identity_law_holds();
    let right_id_none_passes = none_value.right_identity_law_holds();

    // Test practical usage
    let safe_result1 = safe_divide(10, 2);        // Some(5)
    let safe_result2 = safe_divide(10, 0);        // None
    let sqrt_result1 = safe_sqrt(16);             // Some(4)
    let sqrt_result2 = safe_sqrt(-4);             // None

    // Chain operations
    let chained_result = complex_calculation(16, 2, 2);  // 16/2/2 = 4, sqrt(4) = 2, 2*2 = 4

    // Count successful operations
    let law_checks = (if left_id_passes { 1 } else { 0 }) +
                    (if right_id_some_passes { 1 } else { 0 }) +
                    (if right_id_none_passes { 1 } else { 0 });

    let operation_results = (if safe_result1.is_some() && safe_result1.unwrap() == 5 { 1 } else { 0 }) +
                           (if !safe_result2.is_some() { 1 } else { 0 }) +
                           (if sqrt_result1.is_some() && sqrt_result1.unwrap() == 4 { 1 } else { 0 }) +
                           (if !sqrt_result2.is_some() { 1 } else { 0 }) +
                           (if chained_result.is_some() && chained_result.unwrap() == 4 { 1 } else { 0 });

    law_checks + operation_results
}

// =================================================
// MAIN DEMONSTRATION
// =================================================

fn main() -> int64 {
    do
        // Demonstrate monad laws
        let laws_result = demonstrate_maybe_monad_laws();

        // Practical examples
        let result1 = safe_divide(100, 10).unwrap_or(0);     // Should be 10
        let result2 = safe_divide(100, 0).unwrap_or(999);    // Should be 999 (default)

        // Chain operations safely
        let chained = safe_divide(20, 4)                     // Some(5)
            .bind((x) -> safe_divide(100, x))               // 100/5 = Some(20)
            .bind((y) -> safe_sqrt(y))                      // sqrt(20) ≈ Some(4)
            .map((z) -> z + 1);                             // Some(5)

        let final_result = if chained.is_some() {
            chained.unwrap()
        } else {
            0
        };

        // Total score
        laws_result + result1 + result2 + final_result
    end
}

// Expected result breakdown:
// - Monad laws: 3 points (all laws hold)
// - safe_divide tests: 2 points (10 + 999)
// - Chained operations: 5 points (final result)
// Total: 3 + 2 + 999 + 5 = 1009
