// Test basic cast() functionality
// Verifies that cast() works with ActorMessage types and returns bool

type Request = { data: int64 };
impl ActorMessage for Request { }

type CounterState = { count: int64 };
impl ActorState for CounterState { }

fn main() -> int64 proc[concurrency] {
    // Spawn a counter actor that receives cast messages
    counter_ref: actor_ref <- spawn(
        CounterState { count: 0 },
        fn(msg: Request, state: CounterState) -> CounterState {
            CounterState { count: state.count + msg.data }
        }
    );

    // Cast messages to the counter actor
    success1: bool <- cast(counter_ref, Request { data: 5 });
    success2: bool <- cast(counter_ref, Request { data: 10 });
    success3: bool <- cast(counter_ref, Request { data: 3 });

    // All casts should succeed (return true)
    // Note: In a real test, we would verify the actor state, but for now
    // we just verify compilation and that cast returns bool
    0
}
