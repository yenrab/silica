// Example demonstrating full runtime pattern matching in case expressions
// Tests literal patterns (int64/bool), tuple patterns, and proper branching

fn test_tuple_decomposition() -> int64 {
    do
        // Test integer literal patterns
        result1:int64 <- case 42 of {
            42 -> 100;
            24 -> 200;
            _:int64 -> 0
        };

        // Test boolean literal patterns
        result2:int64 <- case true of {
            true -> 10;
            false -> 20;
            _:boolean -> 0
        };

        // Test tuple patterns (simplified - always matches first tuple pattern)
        person:(int64, int64, boolean) <- (42, 30, true);
        result3:int64 <- case person of {
            (x:int64, y:int64, z:boolean) -> 5;  // Tuple pattern matches
            _:(int64,int64,boolean) -> 0
        };

        // Return combination of results: 100 + 10 + 5 = 115
        result1 + result2 + result3
    end
}

// fn swap_pair(pair: (int64, int64)) -> (int64, int64) {
//     case pair of {
//         (a, b) -> (b, a)
//         _:(int64,int64) -> (0, 0)
//     }
// }

fn main() -> int64 {
    test_tuple_decomposition()
}
