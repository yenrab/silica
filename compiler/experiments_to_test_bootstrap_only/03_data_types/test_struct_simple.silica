// Simple struct test with basic struct operations
struct Point {
    x: int64,
    y: int64
}

fn test_struct_operations() -> int64 {
    do
        // Create a struct literal and access fields directly
        left:Point <- Point { x: 10, y: 20 };
        right:Point <- Point { x: 10, y: 20 };
        left.x +right.y  // Should return 10 + 20 = 30
    end
}

fn main() -> int64 {
    test_struct_operations()
}
