// Module: AST-like types for deep tuple decomp stress test
// Mimics parser_ast - Loc (SourceLocation), Expr, Decl, ListDecl
// Types from one module, used across others (cross-module type identity stress)

struct Loc {
    file: string,
    line: int64,
    col: int64
}

struct Expr {
    kind: int64,
    value: string,
    name: string,
    loc: Loc,
    inner: Expr
}

struct Decl {
    tag: int64,
    name: string,
    ret_type: string,
    loc: Loc,
    body: Expr
}

struct ListDecl {
    is_nil: bool,
    head: Decl,
    tail: ListDecl
}

fn zero_loc() -> Loc {
    Loc { file: "", line: 0, col: 0 }
}

fn dummy_expr() -> Expr {
    placeholder: Expr <- Expr { kind: -1, value: "", name: "", loc: zero_loc(), inner: placeholder };
    placeholder
}

fn dummy_decl() -> Decl {
    Decl { tag: -1, name: "", ret_type: "", loc: zero_loc(), body: dummy_expr() }
}

fn empty_list_decl() -> ListDecl {
    nil_placeholder: ListDecl <- ListDecl { is_nil: true, head: dummy_decl(), tail: nil_placeholder };
    nil_placeholder
}
