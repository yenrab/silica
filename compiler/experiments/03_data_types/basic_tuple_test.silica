// Basic tuple test without generics

fn test_basic_tuples() -> int64 {
    do
        // Create basic tuples
        pair:(int64, int64) <- (42, 24);
        triple:(int64, int64, int64) <- (1, 2, 3);
        
        // Return success
        42
    end
}

fn main() -> int64 {
    test_basic_tuples()
}
