// Test tuple types and expressions (without case expressions)

// Concrete tuple type aliases (generics not yet supported)
type IntBoolPair = (int64, boolean);
type IntTriple = (int64, int64, int64);

// Test tuple expressions and type aliases
fn test_tuple_types() -> int64 {
    do
        // Create tuples
        pair:(int64, boolean) <- (42, true);
        triple:(int64, int64, int64) <- (1, 2, 3);

        // Test that types work
        pair2:(int64, boolean) <- (100, false);
        triple2:(int64, int64, int64) <- (10, 20, 30);

        // Test tuple decomposition (pattern matching)
        (first: int64, second: int64, third: int64) <- triple;     // Decompose triple
        (int_val: int64, bool_val: boolean) <- pair;           // Decompose pair

        // Do some computation with decomposed values
        sum:int64 <- first + second + third;  // 1 + 2 + 3 = 6

        // Return the computed result directly
        sum + int_val  // 6 + 42 = 48
    end
}

fn main() -> int64 {
    test_tuple_types()
}
