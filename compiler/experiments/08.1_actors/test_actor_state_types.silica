// Test demonstrating that actor states can be various Silica types

fn main() -> int64 proc[concurrency] {
    // Integer literals as states
    spawn(0, fn(msg: int64, state: int64) -> int64 { state });        // i64 state
    spawn(42, fn(msg: int64, state: int64) -> int64 { state });       // i64 state
    spawn(-10, fn(msg: int64, state: int64) -> int64 { state });      // i64 state

    // Boolean literals converted to integers (0/1)
    spawn(true, fn(msg: int64, state: int64) -> int64 { state });     // i1 true -> i64 1
    spawn(false, fn(msg: int64, state: int64) -> int64 { state });    // i1 false -> i64 0

    0  // Return value
}
