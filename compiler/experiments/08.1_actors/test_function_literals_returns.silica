// Test function literals with different return types and expressions
// Demonstrates various return patterns in function literals

fn main() -> int64 {
    // Test 1: Function returning arithmetic expression
    arithmetic: fn(int64, int64) -> int64 <- fn(x: int64, y: int64) -> int64 {
        x + y * 2
    };

    // Test 2: Function with conditional return
    conditional: fn(int64) -> int64 <- fn(x: int64) -> int64 {
        case x > 0 of {
            true -> x
            false -> 0
        }
    };

    // Test 3: Function returning result of another expression
    complex: fn(int64, int64) -> int64 <- fn(a: int64, b: int64) -> int64 {
        sum:int64 <- a + b;
        product:int64 <- a * b;
        sum + product
    };

    // Test 4: Function literal with complex expression
    complex_expr: fn(int64, int64) -> int64 <- fn(a: int64, b: int64) -> int64 {
        // Complex expression with multiple operations
        temp:int64 <- a * b + 10;
        temp / 2 + a
    };

    // Test 5: Function with early return pattern
    early_return: fn(int64) -> int64 <- fn(x: int64) -> int64 {
        case x of {
            0 -> 0
            _ : int64 -> x
        }
    };

    // Return success - actual function execution not yet implemented
    0
}
