// Geometry operations module
// Demonstrates functions that accept trait-implementing types as parameters
// and call trait methods on those parameters

// Import types and traits
use geometry_types;
use geometry_traits;

// Export functions that work with trait-implementing types
export compute_area/1;
export double_area/1;
export compare_areas/2;

// Function that accepts any type implementing Shape trait and calls area()
fn compute_area(shape: Shape) -> int64 {
    shape.area()
}

// Function that accepts Shape and performs operations using the trait method
fn double_area(shape: Shape) -> int64 {
    area: int64 <- shape.area();
    area * 2
}

// Function that accepts two Shape-implementing types and compares their areas
fn compare_areas(shape1: Shape, shape2: Shape) -> int64 {
    area1: int64 <- shape1.area();
    area2: int64 <- shape2.area();
    area1 - area2
}
