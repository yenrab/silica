// Syntax Validation Test
// Minimal test to verify core affinity syntax compiles correctly

fn main() -> int64 proc[concurrency] {
    do
        // Test all core affinity syntax variants
        spawn(0, fn(msg: int64, state: int64) -> int64 { state }, any_core);
        spawn(1, fn(msg: int64, state: int64) -> int64 { state }, performance_cores);
        spawn(2, fn(msg: int64, state: int64) -> int64 { state }, efficiency_cores);
        spawn(3, fn(msg: int64, state: int64) -> int64 { state }, 0);
        spawn(4, fn(msg: int64, state: int64) -> int64 { state }, 1);
        spawn(5, fn(msg: int64, state: int64) -> int64 { state });  // No affinity

        0
    end
}
