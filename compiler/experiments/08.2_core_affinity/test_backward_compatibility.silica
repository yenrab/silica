// Backward Compatibility Test
// Ensures old spawn syntax still works with new core affinity features

// Test type for complex state
type ComplexState = { counter: int64, active: bool };

impl ActorState for ComplexState { }

fn main() -> int64 proc[concurrency] {
    do
        // Test 1: Original spawn syntax (2 parameters)
        // Should work and use default any_core load balancing
        spawn(0, fn(msg: int64, state: int64) -> int64 {
            state + msg
        });

        // Test 2: Multiple old-style spawns
        // Should all get load balanced automatically
        spawn(10, fn(msg: int64, state: int64) -> int64 {
            state * 2
        });

        spawn(20, fn(msg: int64, state: int64) -> int64 {
            state + 10
        });

        spawn(30, fn(msg: int64, state: int64) -> int64 {
            state - 5
        });

        // Test 3: Mix old and new syntax
        // Should work together seamlessly
        spawn(100, fn(msg: int64, state: int64) -> int64 {
            state + 1
        });  // Old syntax

        spawn(200, fn(msg: int64, state: int64) -> int64 {
            state + 2
        }, any_core);  // New syntax

        spawn(300, fn(msg: int64, state: int64) -> int64 {
            state + 3
        }, performance_cores);  // New syntax

        // Test 4: Complex behaviors with old syntax
        spawn(ComplexState { counter: 0, active: true }, fn(msg: int64, state: int64) -> int64 {
            // Complex state management still works
            state + msg
        });

        0
    end
}
